NSQ_SOURCE_LINE 00000001 "package File::ShareDir::Install; # git description: v0.13-6-g9916db6"
NSQ_SOURCE_LINE 00000002 "# ABSTRACT: Install shared files"
NSQ_SOURCE_LINE 00000003 ""
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "use Carp ();"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "use File::Spec;"
NSQ_SOURCE_LINE 00000010 "use IO::Dir;"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "our $VERSION = '0.14';"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "our @DIRS;"
NSQ_SOURCE_LINE 00000015 "our %ALREADY;"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "require Exporter;"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "our @ISA = qw( Exporter );"
NSQ_SOURCE_LINE 00000020 "our @EXPORT = qw( install_share delete_share );"
NSQ_SOURCE_LINE 00000021 "our @EXPORT_OK = qw( postamble install_share delete_share );"
NSQ_SOURCE_LINE 00000022 "our $INCLUDE_DOTFILES = 0;"
NSQ_SOURCE_LINE 00000023 "our $INCLUDE_DOTDIRS = 0;"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "#####################################################################"
NSQ_SOURCE_LINE 00000026 "sub install_share"
NSQ_SOURCE_LINE 00000027 "{"
NSQ_SOURCE_LINE 00000028 "    my $dir  = @_ ? pop : 'share';"
NSQ_SOURCE_LINE 00000029 "    my $type = @_ ? shift : 'dist';"
NSQ_SOURCE_LINE 00000030 "    unless ( defined $type and"
NSQ_SOURCE_LINE 00000031 "            ( $type =~ /^(module|dist)$/ ) ) {"
NSQ_SOURCE_LINE 00000032 "        Carp::confess \"Illegal or invalid share dir type '$type'\";"
NSQ_SOURCE_LINE 00000033 "    }"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "    if( $type eq 'dist' and @_ ) {"
NSQ_SOURCE_LINE 00000036 "        Carp::confess \"Too many parameters to install_share\";"
NSQ_SOURCE_LINE 00000037 "    }"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "    my $def = _mk_def( $type );"
NSQ_SOURCE_LINE 00000040 "    _add_module( $def, $_[0] );"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "    _add_dir( $def, $dir );"
NSQ_SOURCE_LINE 00000043 "}"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "#####################################################################"
NSQ_SOURCE_LINE 00000047 "sub delete_share"
NSQ_SOURCE_LINE 00000048 "{"
NSQ_SOURCE_LINE 00000049 "    my $dir  = @_ ? pop : '';"
NSQ_SOURCE_LINE 00000050 "    my $type = @_ ? shift : 'dist';"
NSQ_SOURCE_LINE 00000051 "    unless ( defined $type and"
NSQ_SOURCE_LINE 00000052 "            ( $type =~ /^(module|dist)$/ ) ) {"
NSQ_SOURCE_LINE 00000053 "        Carp::confess \"Illegal or invalid share dir type '$type'\";"
NSQ_SOURCE_LINE 00000054 "    }"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "    if( $type eq 'dist' and @_ ) {"
NSQ_SOURCE_LINE 00000057 "        Carp::confess \"Too many parameters to delete_share\";"
NSQ_SOURCE_LINE 00000058 "    }"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "    my $def = _mk_def( \"delete-$type\" );"
NSQ_SOURCE_LINE 00000061 "    _add_module( $def, $_[0] );"
NSQ_SOURCE_LINE 00000062 "    _add_dir( $def, $dir );"
NSQ_SOURCE_LINE 00000063 "}"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "#"
NSQ_SOURCE_LINE 00000068 "# Build a task definition"
NSQ_SOURCE_LINE 00000069 "sub _mk_def"
NSQ_SOURCE_LINE 00000070 "{"
NSQ_SOURCE_LINE 00000071 "    my( $type ) = @_;"
NSQ_SOURCE_LINE 00000072 "    return { type=>$type,"
NSQ_SOURCE_LINE 00000073 "             dotfiles => $INCLUDE_DOTFILES,"
NSQ_SOURCE_LINE 00000074 "             dotdirs => $INCLUDE_DOTDIRS"
NSQ_SOURCE_LINE 00000075 "           };"
NSQ_SOURCE_LINE 00000076 "}"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "#"
NSQ_SOURCE_LINE 00000079 "# Add the module to a task definition"
NSQ_SOURCE_LINE 00000080 "sub _add_module"
NSQ_SOURCE_LINE 00000081 "{"
NSQ_SOURCE_LINE 00000082 "    my( $def, $class ) =  @_;"
NSQ_SOURCE_LINE 00000083 "    if( $def->{type} =~ /module$/ ) {"
NSQ_SOURCE_LINE 00000084 "        my $module = _CLASS( $class );"
NSQ_SOURCE_LINE 00000085 "        unless ( defined $module ) {"
NSQ_SOURCE_LINE 00000086 "            Carp::confess \"Missing or invalid module name '$_[0]'\";"
NSQ_SOURCE_LINE 00000087 "        }"
NSQ_SOURCE_LINE 00000088 "        $def->{module} = $module;"
NSQ_SOURCE_LINE 00000089 "    }"
NSQ_SOURCE_LINE 00000090 "}"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "#"
NSQ_SOURCE_LINE 00000093 "# Add directories to a task definition"
NSQ_SOURCE_LINE 00000094 "# Save the definition"
NSQ_SOURCE_LINE 00000095 "sub _add_dir"
NSQ_SOURCE_LINE 00000096 "{"
NSQ_SOURCE_LINE 00000097 "    my( $def, $dir ) = @_;"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "    $dir = [ $dir ] unless ref $dir;"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "    my $del = 0;"
NSQ_SOURCE_LINE 00000102 "    $del = 1 if $def->{type} =~ /^delete-/;"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "    foreach my $d ( @$dir ) {"
NSQ_SOURCE_LINE 00000105 "        unless ( $del or (defined $d and -d $d) ) {"
NSQ_SOURCE_LINE 00000106 "            Carp::confess \"Illegal or missing directory '$d'\";"
NSQ_SOURCE_LINE 00000107 "        }"
NSQ_SOURCE_LINE 00000108 "        if( not $del and $ALREADY{ $d }++ ) {"
NSQ_SOURCE_LINE 00000109 "            Carp::confess \"Directory '$d' is already being installed\";"
NSQ_SOURCE_LINE 00000110 "        }"
NSQ_SOURCE_LINE 00000111 "        push @DIRS, { %$def };"
NSQ_SOURCE_LINE 00000112 "        $DIRS[-1]{dir} = $d;"
NSQ_SOURCE_LINE 00000113 "    }"
NSQ_SOURCE_LINE 00000114 "}"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "#####################################################################"
NSQ_SOURCE_LINE 00000118 "# Build the postamble section"
NSQ_SOURCE_LINE 00000119 "sub postamble"
NSQ_SOURCE_LINE 00000120 "{"
NSQ_SOURCE_LINE 00000121 "    my $self = shift;"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "    my @ret; # = $self->SUPER::postamble( @_ );"
NSQ_SOURCE_LINE 00000124 "    foreach my $def ( @DIRS ) {"
NSQ_SOURCE_LINE 00000125 "        push @ret, __postamble_share_dir( $self, $def );"
NSQ_SOURCE_LINE 00000126 "    }"
NSQ_SOURCE_LINE 00000127 "    return join \"\\n\", @ret;"
NSQ_SOURCE_LINE 00000128 "}"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "#####################################################################"
NSQ_SOURCE_LINE 00000131 "sub __postamble_share_dir"
NSQ_SOURCE_LINE 00000132 "{"
NSQ_SOURCE_LINE 00000133 "    my( $self, $def ) = @_;"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "    my $dir = $def->{dir};"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "    my( $idir );"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "    if( $def->{type} eq 'delete-dist' ) {"
NSQ_SOURCE_LINE 00000140 "        $idir = File::Spec->catdir( _dist_dir(), $dir );"
NSQ_SOURCE_LINE 00000141 "    }"
NSQ_SOURCE_LINE 00000142 "    elsif( $def->{type} eq 'delete-module' ) {"
NSQ_SOURCE_LINE 00000143 "        $idir = File::Spec->catdir( _module_dir( $def ), $dir );"
NSQ_SOURCE_LINE 00000144 "    }"
NSQ_SOURCE_LINE 00000145 "    elsif ( $def->{type} eq 'dist' ) {"
NSQ_SOURCE_LINE 00000146 "        $idir = _dist_dir();"
NSQ_SOURCE_LINE 00000147 "    }"
NSQ_SOURCE_LINE 00000148 "    else {                                  # delete-share and share"
NSQ_SOURCE_LINE 00000149 "        $idir = _module_dir( $def );"
NSQ_SOURCE_LINE 00000150 "    }"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "    my @cmds;"
NSQ_SOURCE_LINE 00000153 "    if( $def->{type} =~ /^delete-/ ) {"
NSQ_SOURCE_LINE 00000154 "        @cmds = \"\\$(RM_RF) $idir\";"
NSQ_SOURCE_LINE 00000155 "    }"
NSQ_SOURCE_LINE 00000156 "    else {"
NSQ_SOURCE_LINE 00000157 "        my $autodir = '$(INST_LIB)';"
NSQ_SOURCE_LINE 00000158 "        my $pm_to_blib = $self->oneliner(<<CODE, ['-MExtUtils::Install']);"
NSQ_SOURCE_LINE 00000159 "pm_to_blib({\\@ARGV}, '$autodir')"
NSQ_SOURCE_LINE 00000160 "CODE"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "        my $files = {};"
NSQ_SOURCE_LINE 00000163 "        _scan_share_dir( $files, $idir, $dir, $def );"
NSQ_SOURCE_LINE 00000164 "        @cmds = $self->split_command( $pm_to_blib,"
NSQ_SOURCE_LINE 00000165 "            map { ($self->quote_literal($_) => $self->quote_literal($files->{$_})) } sort keys %$files );"
NSQ_SOURCE_LINE 00000166 "    }"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "    my $r = join '', map { \"\\t\\$(NOECHO) $_\\n\" } @cmds;"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "#    use Data::Dumper;"
NSQ_SOURCE_LINE 00000171 "#    die Dumper $files;"
NSQ_SOURCE_LINE 00000172 "    # Set up the install"
NSQ_SOURCE_LINE 00000173 "    return \"config::\\n$r\";"
NSQ_SOURCE_LINE 00000174 "}"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "# Get the per-dist install directory."
NSQ_SOURCE_LINE 00000177 "# We depend on the Makefile for most of the info"
NSQ_SOURCE_LINE 00000178 "sub _dist_dir"
NSQ_SOURCE_LINE 00000179 "{"
NSQ_SOURCE_LINE 00000180 "    return File::Spec->catdir( '$(INST_LIB)',"
NSQ_SOURCE_LINE 00000181 "                                    qw( auto share dist ),"
NSQ_SOURCE_LINE 00000182 "                                    '$(DISTNAME)'"
NSQ_SOURCE_LINE 00000183 "                                  );"
NSQ_SOURCE_LINE 00000184 "}"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "# Get the per-module install directory"
NSQ_SOURCE_LINE 00000187 "# We depend on the Makefile for most of the info"
NSQ_SOURCE_LINE 00000188 "sub _module_dir"
NSQ_SOURCE_LINE 00000189 "{"
NSQ_SOURCE_LINE 00000190 "    my( $def ) = @_;"
NSQ_SOURCE_LINE 00000191 "    my $module = $def->{module};"
NSQ_SOURCE_LINE 00000192 "    $module =~ s/::/-/g;"
NSQ_SOURCE_LINE 00000193 "    return  File::Spec->catdir( '$(INST_LIB)',"
NSQ_SOURCE_LINE 00000194 "                                    qw( auto share module ),"
NSQ_SOURCE_LINE 00000195 "                                    $module"
NSQ_SOURCE_LINE 00000196 "                                  );"
NSQ_SOURCE_LINE 00000197 "}"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "sub _scan_share_dir"
NSQ_SOURCE_LINE 00000200 "{"
NSQ_SOURCE_LINE 00000201 "    my( $files, $idir, $dir, $def ) = @_;"
NSQ_SOURCE_LINE 00000202 "    my $dh = IO::Dir->new( $dir ) or die \"Unable to read $dir: $!\";"
NSQ_SOURCE_LINE 00000203 "    my $entry;"
NSQ_SOURCE_LINE 00000204 "    while( defined( $entry = $dh->read ) ) {"
NSQ_SOURCE_LINE 00000205 "        next if $entry =~ /(~|,v|#)$/;"
NSQ_SOURCE_LINE 00000206 "        my $full = File::Spec->catfile( $dir, $entry );"
NSQ_SOURCE_LINE 00000207 "        if( -f $full ) {"
NSQ_SOURCE_LINE 00000208 "            next if not $def->{dotfiles} and $entry =~ /^\\./;"
NSQ_SOURCE_LINE 00000209 "            $files->{ $full } = File::Spec->catfile( $idir, $entry );"
NSQ_SOURCE_LINE 00000210 "        }"
NSQ_SOURCE_LINE 00000211 "        elsif( -d $full ) {"
NSQ_SOURCE_LINE 00000212 "            if( $def->{dotdirs} ) {"
NSQ_SOURCE_LINE 00000213 "                next if $entry eq '.' or $entry eq '..' or"
NSQ_SOURCE_LINE 00000214 "                        $entry =~ /^\\.(svn|git|cvs)$/;"
NSQ_SOURCE_LINE 00000215 "            }"
NSQ_SOURCE_LINE 00000216 "            else {"
NSQ_SOURCE_LINE 00000217 "                next if $entry =~ /^\\./;"
NSQ_SOURCE_LINE 00000218 "            }"
NSQ_SOURCE_LINE 00000219 "            _scan_share_dir( $files, File::Spec->catdir( $idir, $entry ), $full, $def );"
NSQ_SOURCE_LINE 00000220 "        }"
NSQ_SOURCE_LINE 00000221 "    }"
NSQ_SOURCE_LINE 00000222 "}"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "#####################################################################"
NSQ_SOURCE_LINE 00000226 "# Cloned from Params::Util::_CLASS"
NSQ_SOURCE_LINE 00000227 "sub _CLASS ($) {"
NSQ_SOURCE_LINE 00000228 "    ("
NSQ_SOURCE_LINE 00000229 "        defined $_[0]"
NSQ_SOURCE_LINE 00000230 "        and"
NSQ_SOURCE_LINE 00000231 "        ! ref $_[0]"
NSQ_SOURCE_LINE 00000232 "        and"
NSQ_SOURCE_LINE 00000233 "        $_[0] =~ m/^[^\\W\\d]\\w*(?:::\\w+)*$/s"
NSQ_SOURCE_LINE 00000234 "    ) ? $_[0] : undef;"
NSQ_SOURCE_LINE 00000235 "}"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "1;"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "__END__"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "=pod"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "=head1 NAME"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "File::ShareDir::Install - Install shared files"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "=head1 VERSION"
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "version 0.14"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "    use ExtUtils::MakeMaker;"
NSQ_SOURCE_LINE 00000256 "    use File::ShareDir::Install;"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "    install_share 'share';"
NSQ_SOURCE_LINE 00000259 "    install_share dist => 'dist-share';"
NSQ_SOURCE_LINE 00000260 "    install_share module => 'My::Module' => 'other-share';"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "    WriteMakefile( ... );       # As you normally would"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "    package MY;"
NSQ_SOURCE_LINE 00000265 "    use File::ShareDir::Install qw(postamble);"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "File::ShareDir::Install allows you to install read-only data files from a"
NSQ_SOURCE_LINE 00000270 "distribution. It is a companion module to L<File::ShareDir>, which"
NSQ_SOURCE_LINE 00000271 "allows you to locate these files after installation."
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "It is a port of L<Module::Install::Share> to L<ExtUtils::MakeMaker> with the"
NSQ_SOURCE_LINE 00000274 "improvement of only installing the files you want; C<.svn>, C<.git> and other"
NSQ_SOURCE_LINE 00000275 "source-control junk will be ignored."
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "Please note that this module installs read-only data files; empty"
NSQ_SOURCE_LINE 00000278 "directories will be ignored."
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "=head1 EXPORT"
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "=head2 install_share"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "    install_share $dir;"
NSQ_SOURCE_LINE 00000285 "    install_share dist => $dir;"
NSQ_SOURCE_LINE 00000286 "    install_share module => $module, $dir;"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "Causes all the files in C<$dir> and its sub-directories to be installed"
NSQ_SOURCE_LINE 00000289 "into a per-dist or per-module share directory.  Must be called before"
NSQ_SOURCE_LINE 00000290 "C<WriteMakefile>."
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "The first 2 forms are equivalent; the files are installed in a per-distribution"
NSQ_SOURCE_LINE 00000293 "directory.  For example C</usr/lib/perl5/site_perl/auto/share/dist/My-Dist>.  The"
NSQ_SOURCE_LINE 00000294 "name of that directory can be recovered with L<File::ShareDir/dist_dir>."
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "The last form installs files in a per-module directory.  For example"
NSQ_SOURCE_LINE 00000297 "C</usr/lib/perl5/site_perl/auto/share/module/My-Dist-Package>.  The name of that"
NSQ_SOURCE_LINE 00000298 "directory can be recovered with L<File::ShareDir/module_dir>."
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "The parameter C<$dir> may be an array of directories."
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "The files will be installed when you run C<make install>.  However, the list"
NSQ_SOURCE_LINE 00000303 "of files to install is generated when Makefile.PL is run."
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "Note that if you make multiple calls to C<install_share> on different"
NSQ_SOURCE_LINE 00000306 "directories that contain the same filenames, the last of these calls takes"
NSQ_SOURCE_LINE 00000307 "precedence.  In other words, if you do:"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "    install_share 'share1';"
NSQ_SOURCE_LINE 00000310 "    install_share 'share2';"
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "And both C<share1> and C<share2> contain a file called C<info.txt>, the file"
NSQ_SOURCE_LINE 00000313 "C<share2/info.txt> will be installed into your C<dist_dir()>."
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "=head2 delete_share"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "    delete_share $list;"
NSQ_SOURCE_LINE 00000318 "    delete_share dist => $list;"
NSQ_SOURCE_LINE 00000319 "    delete_share module => $module, $list;"
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "Remove previously installed files or directories."
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "Unlike L</install_share>, the last parameter is a list of files or"
NSQ_SOURCE_LINE 00000324 "directories that were previously installed.  These files and directories will"
NSQ_SOURCE_LINE 00000325 "be deleted when you run C<make install>."
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "The parameter C<$list> may be an array of files or directories."
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "Deletion happens in-order along with installation.  This means that you may"
NSQ_SOURCE_LINE 00000330 "delete all previously installed files by putting the following at the top of"
NSQ_SOURCE_LINE 00000331 "your Makefile.PL."
NSQ_SOURCE_LINE 00000332 ""
NSQ_SOURCE_LINE 00000333 "    delete_share '.';"
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "You can also selectively remove some files from installation."
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "    install_share 'some-dir';"
NSQ_SOURCE_LINE 00000338 "    if( ... ) {"
NSQ_SOURCE_LINE 00000339 "        delete_share 'not-this-file.rc';"
NSQ_SOURCE_LINE 00000340 "    }"
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "=head2 postamble"
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "This function must be exported into the MY package.  You will normally do this"
NSQ_SOURCE_LINE 00000345 "with the following."
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "    package MY;"
NSQ_SOURCE_LINE 00000348 "    use File::ShareDir::Install qw( postamble );"
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "If you need to overload postamble, use the following."
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "    package MY;"
NSQ_SOURCE_LINE 00000353 "    use File::ShareDir::Install;"
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 "    sub postamble {"
NSQ_SOURCE_LINE 00000356 "        my $self = shift;"
NSQ_SOURCE_LINE 00000357 "        my @ret = File::ShareDir::Install::postamble( $self );"
NSQ_SOURCE_LINE 00000358 "        # ... add more things to @ret;"
NSQ_SOURCE_LINE 00000359 "        return join \"\\n\", @ret;"
NSQ_SOURCE_LINE 00000360 "    }"
NSQ_SOURCE_LINE 00000361 ""
NSQ_SOURCE_LINE 00000362 "=head1 CONFIGURATION"
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "Two variables control the handling of dot-files and dot-directories."
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "A dot-file has a filename that starts with a period (.).  For example"
NSQ_SOURCE_LINE 00000367 "C<.htaccess>. A dot-directory is a directory that starts with a"
NSQ_SOURCE_LINE 00000368 "period (.).  For example C<.config/>.  Not all filesystems support the use"
NSQ_SOURCE_LINE 00000369 "of dot-files."
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "=head2 $INCLUDE_DOTFILES"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "If set to a true value, dot-files will be copied.  Default is false."
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "=head2 $INCLUDE_DOTDIRS"
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "If set to a true value, the files inside dot-directories will be copied."
NSQ_SOURCE_LINE 00000378 "Known version control directories are still ignored.  Default is false."
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "=head2 Note"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "These variables only influence subsequent calls to C<install_share()>.  This allows"
NSQ_SOURCE_LINE 00000383 "you to control the behaviour for each directory."
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "For example:"
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "    $INCLUDE_DOTDIRS = 1;"
NSQ_SOURCE_LINE 00000388 "    install_share 'share1';"
NSQ_SOURCE_LINE 00000389 "    $INCLUDE_DOTFILES = 1;"
NSQ_SOURCE_LINE 00000390 "    $INCLUDE_DOTDIRS = 0;"
NSQ_SOURCE_LINE 00000391 "    install_share 'share2';"
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "The directory C<share1> will have files in its dot-directories installed,"
NSQ_SOURCE_LINE 00000394 "but not dot-files.  The directory C<share2> will have files in its dot-files"
NSQ_SOURCE_LINE 00000395 "installed, but dot-directories will be ignored."
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "L<File::ShareDir>, L<Module::Install>."
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "=head1 SUPPORT"
NSQ_SOURCE_LINE 00000402 ""
