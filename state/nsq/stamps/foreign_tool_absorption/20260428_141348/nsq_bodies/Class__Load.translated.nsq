NSQ_SOURCE_LINE 00000001 "use strict;"
NSQ_SOURCE_LINE 00000002 "use warnings;"
NSQ_SOURCE_LINE 00000003 "package Class::Load; # git description: v0.24-5-g22a44fd"
NSQ_SOURCE_LINE 00000004 "# ABSTRACT: A working (require \"Class::Name\") and more"
NSQ_SOURCE_LINE 00000005 "# KEYWORDS: class module load require use runtime"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "our $VERSION = '0.25';"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "use base 'Exporter';"
NSQ_SOURCE_LINE 00000010 "use Data::OptList 0.110 ();"
NSQ_SOURCE_LINE 00000011 "use Module::Implementation 0.04;"
NSQ_SOURCE_LINE 00000012 "use Module::Runtime 0.012 ();"
NSQ_SOURCE_LINE 00000013 "use Try::Tiny;"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "{"
NSQ_SOURCE_LINE 00000016 "    my $loader = Module::Implementation::build_loader_sub("
NSQ_SOURCE_LINE 00000017 "        implementations => [ 'XS', 'PP' ],"
NSQ_SOURCE_LINE 00000018 "        symbols         => ['is_class_loaded'],"
NSQ_SOURCE_LINE 00000019 "    );"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "    $loader->();"
NSQ_SOURCE_LINE 00000022 "}"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "our @EXPORT_OK = qw/load_class load_optional_class try_load_class is_class_loaded load_first_existing_class/;"
NSQ_SOURCE_LINE 00000025 "our %EXPORT_TAGS = ("
NSQ_SOURCE_LINE 00000026 "    all => \\@EXPORT_OK,"
NSQ_SOURCE_LINE 00000027 ");"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "our $ERROR;"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "sub load_class {"
NSQ_SOURCE_LINE 00000032 "    my $class   = shift;"
NSQ_SOURCE_LINE 00000033 "    my $options = shift;"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "    my ($res, $e) = try_load_class($class, $options);"
NSQ_SOURCE_LINE 00000036 "    return $class if $res;"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "    _croak($e);"
NSQ_SOURCE_LINE 00000039 "}"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "sub load_first_existing_class {"
NSQ_SOURCE_LINE 00000042 "    my $classes = Data::OptList::mkopt(\\@_)"
NSQ_SOURCE_LINE 00000043 "        or return;"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "    foreach my $class (@{$classes}) {"
NSQ_SOURCE_LINE 00000046 "        Module::Runtime::check_module_name($class->[0]);"
NSQ_SOURCE_LINE 00000047 "    }"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "    for my $class (@{$classes}) {"
NSQ_SOURCE_LINE 00000050 "        my ($name, $options) = @{$class};"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "        # We need to be careful not to pass an undef $options to this sub,"
NSQ_SOURCE_LINE 00000053 "        # since the XS version will blow up if that happens."
NSQ_SOURCE_LINE 00000054 "        return $name if is_class_loaded($name, ($options ? $options : ()));"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "        my ($res, $e) = try_load_class($name, $options);"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "        return $name if $res;"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "        my $file = Module::Runtime::module_notional_filename($name);"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "        next if $e =~ /^Can't locate \\Q$file\\E in \\@INC/;"
NSQ_SOURCE_LINE 00000063 "        next"
NSQ_SOURCE_LINE 00000064 "            if $options"
NSQ_SOURCE_LINE 00000065 "                && defined $options->{-version}"
NSQ_SOURCE_LINE 00000066 "                && $e =~ _version_fail_re($name, $options->{-version});"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "        _croak(\"Couldn't load class ($name) because: $e\");"
NSQ_SOURCE_LINE 00000069 "    }"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "    my @list = map {"
NSQ_SOURCE_LINE 00000072 "        $_->[0]"
NSQ_SOURCE_LINE 00000073 "            . ( $_->[1] && defined $_->[1]{-version}"
NSQ_SOURCE_LINE 00000074 "            ? \" (version >= $_->[1]{-version})\""
NSQ_SOURCE_LINE 00000075 "            : q{} )"
NSQ_SOURCE_LINE 00000076 "    } @{$classes};"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "    my $err"
NSQ_SOURCE_LINE 00000079 "        .= q{Can't locate }"
NSQ_SOURCE_LINE 00000080 "        . _or_list(@list)"
NSQ_SOURCE_LINE 00000081 "        . \" in \\@INC (\\@INC contains: @INC).\";"
NSQ_SOURCE_LINE 00000082 "    _croak($err);"
NSQ_SOURCE_LINE 00000083 "}"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "sub _version_fail_re {"
NSQ_SOURCE_LINE 00000086 "    my $name = shift;"
NSQ_SOURCE_LINE 00000087 "    my $vers = shift;"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "    return qr/\\Q$name\\E version \\Q$vers\\E required--this is only version/;"
NSQ_SOURCE_LINE 00000090 "}"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "sub _nonexistent_fail_re {"
NSQ_SOURCE_LINE 00000093 "    my $name = shift;"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "    my $file = Module::Runtime::module_notional_filename($name);"
NSQ_SOURCE_LINE 00000096 "    return qr/Can't locate \\Q$file\\E in \\@INC/;"
NSQ_SOURCE_LINE 00000097 "}"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "sub _or_list {"
NSQ_SOURCE_LINE 00000100 "    return $_[0] if @_ == 1;"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "    return join ' or ', @_ if @_ ==2;"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "    my $last = pop;"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "    my $list = join ', ', @_;"
NSQ_SOURCE_LINE 00000107 "    $list .= ', or ' . $last;"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "    return $list;"
NSQ_SOURCE_LINE 00000110 "}"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "sub load_optional_class {"
NSQ_SOURCE_LINE 00000113 "    my $class   = shift;"
NSQ_SOURCE_LINE 00000114 "    my $options = shift;"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "    Module::Runtime::check_module_name($class);"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "    my ($res, $e) = try_load_class($class, $options);"
NSQ_SOURCE_LINE 00000119 "    return 1 if $res;"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "    return 0"
NSQ_SOURCE_LINE 00000122 "        if $options"
NSQ_SOURCE_LINE 00000123 "            && defined $options->{-version}"
NSQ_SOURCE_LINE 00000124 "            && $e =~ _version_fail_re($class, $options->{-version});"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "    return 0"
NSQ_SOURCE_LINE 00000127 "        if $e =~ _nonexistent_fail_re($class);"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "    _croak($e);"
NSQ_SOURCE_LINE 00000130 "}"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "sub try_load_class {"
NSQ_SOURCE_LINE 00000133 "    my $class   = shift;"
NSQ_SOURCE_LINE 00000134 "    my $options = shift;"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "    Module::Runtime::check_module_name($class);"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "    local $@;"
NSQ_SOURCE_LINE 00000139 "    undef $ERROR;"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "    if (is_class_loaded($class)) {"
NSQ_SOURCE_LINE 00000142 "        # We need to check this here rather than in is_class_loaded() because"
NSQ_SOURCE_LINE 00000143 "        # we want to return the error message for a failed version check, but"
NSQ_SOURCE_LINE 00000144 "        # is_class_loaded just returns true/false."
NSQ_SOURCE_LINE 00000145 "        return 1 unless $options && defined $options->{-version};"
NSQ_SOURCE_LINE 00000146 "        return try {"
NSQ_SOURCE_LINE 00000147 "            $class->VERSION($options->{-version});"
NSQ_SOURCE_LINE 00000148 "            1;"
NSQ_SOURCE_LINE 00000149 "        }"
NSQ_SOURCE_LINE 00000150 "        catch {"
NSQ_SOURCE_LINE 00000151 "            _error($_);"
NSQ_SOURCE_LINE 00000152 "        };"
NSQ_SOURCE_LINE 00000153 "    }"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "    my $file = Module::Runtime::module_notional_filename($class);"
NSQ_SOURCE_LINE 00000156 "    # This says \"our diagnostics of the package"
NSQ_SOURCE_LINE 00000157 "    # say perl's INC status about the file being loaded are"
NSQ_SOURCE_LINE 00000158 "    # wrong\", so we delete it from %INC, so when we call require(),"
NSQ_SOURCE_LINE 00000159 "    # perl will *actually* try reloading the file."
NSQ_SOURCE_LINE 00000160 "    #"
NSQ_SOURCE_LINE 00000161 "    # If the file is already in %INC, it won't retry,"
NSQ_SOURCE_LINE 00000162 "    # And on 5.8, it won't fail either!"
NSQ_SOURCE_LINE 00000163 "    #"
NSQ_SOURCE_LINE 00000164 "    # The extra benefit of this trick, is it helps even on"
NSQ_SOURCE_LINE 00000165 "    # 5.10, as instead of dying with \"Compilation failed\","
NSQ_SOURCE_LINE 00000166 "    # it will die with the actual error, and that's a win-win."
NSQ_SOURCE_LINE 00000167 "    delete $INC{$file};"
NSQ_SOURCE_LINE 00000168 "    return try {"
NSQ_SOURCE_LINE 00000169 "        local $SIG{__DIE__} = 'DEFAULT';"
NSQ_SOURCE_LINE 00000170 "        if ($options && defined $options->{-version}) {"
NSQ_SOURCE_LINE 00000171 "            Module::Runtime::use_module($class, $options->{-version});"
NSQ_SOURCE_LINE 00000172 "        }"
NSQ_SOURCE_LINE 00000173 "        else {"
NSQ_SOURCE_LINE 00000174 "            Module::Runtime::require_module($class);"
NSQ_SOURCE_LINE 00000175 "        }"
NSQ_SOURCE_LINE 00000176 "        1;"
NSQ_SOURCE_LINE 00000177 "    }"
NSQ_SOURCE_LINE 00000178 "    catch {"
NSQ_SOURCE_LINE 00000179 "        _error($_);"
NSQ_SOURCE_LINE 00000180 "    };"
NSQ_SOURCE_LINE 00000181 "}"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "sub _error {"
NSQ_SOURCE_LINE 00000184 "    my $e = shift;"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "    $e =~ s/ at .+?Runtime\\.pm line [0-9]+\\.$//;"
NSQ_SOURCE_LINE 00000187 "    chomp $e;"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "    $ERROR = $e;"
NSQ_SOURCE_LINE 00000190 "    return 0 unless wantarray;"
NSQ_SOURCE_LINE 00000191 "    return 0, $ERROR;"
NSQ_SOURCE_LINE 00000192 "}"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "sub _croak {"
NSQ_SOURCE_LINE 00000195 "    require Carp;"
NSQ_SOURCE_LINE 00000196 "    local $Carp::CarpLevel = $Carp::CarpLevel + 2;"
NSQ_SOURCE_LINE 00000197 "    Carp::croak(shift);"
NSQ_SOURCE_LINE 00000198 "}"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "1;"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "__END__"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "=pod"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "=head1 NAME"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "Class::Load - A working (require \"Class::Name\") and more"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "=head1 VERSION"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "version 0.25"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "    use Class::Load ':all';"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "    try_load_class('Class::Name')"
NSQ_SOURCE_LINE 00000221 "        or plan skip_all => \"Class::Name required to run these tests\";"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "    load_class('Class::Name');"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "    is_class_loaded('Class::Name');"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "    my $baseclass = load_optional_class('Class::Name::MightExist')"
NSQ_SOURCE_LINE 00000228 "        ? 'Class::Name::MightExist'"
NSQ_SOURCE_LINE 00000229 "        : 'Class::Name::Default';"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "C<require EXPR> only accepts C<Class/Name.pm> style module names, not"
NSQ_SOURCE_LINE 00000234 "C<Class::Name>. How frustrating! For that, we provide"
NSQ_SOURCE_LINE 00000235 "C<load_class 'Class::Name'>."
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "It's often useful to test whether a module can be loaded, instead of throwing"
NSQ_SOURCE_LINE 00000238 "an error when it's not available. For that, we provide"
NSQ_SOURCE_LINE 00000239 "C<try_load_class 'Class::Name'>."
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "Finally, sometimes we need to know whether a particular class has been loaded."
NSQ_SOURCE_LINE 00000242 "Asking C<%INC> is an option, but that will miss inner packages and any class"
NSQ_SOURCE_LINE 00000243 "for which the filename does not correspond to the package name. For that, we"
NSQ_SOURCE_LINE 00000244 "provide C<is_class_loaded 'Class::Name'>."
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "=head2 load_class Class::Name, \\%options"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "C<load_class> will load C<Class::Name> or throw an error, much like C<require>."
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "If C<Class::Name> is already loaded (checked with C<is_class_loaded>) then it"
NSQ_SOURCE_LINE 00000253 "will not try to load the class. This is useful when you have inner packages"
NSQ_SOURCE_LINE 00000254 "which C<require> does not check."
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "The C<%options> hash currently accepts one key, C<-version>. If you specify a"
NSQ_SOURCE_LINE 00000257 "version, then this subroutine will call C<< Class::Name->VERSION("
NSQ_SOURCE_LINE 00000258 "$options{-version} ) >> internally, which will throw an error if the class's"
NSQ_SOURCE_LINE 00000259 "version is not equal to or greater than the version you requested."
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "This method will return the name of the class on success."
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "=head2 try_load_class Class::Name, \\%options -> (0|1, error message)"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "Returns 1 if the class was loaded, 0 if it was not. If the class was not"
NSQ_SOURCE_LINE 00000266 "loaded, the error will be returned as a second return value in list context."
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "Again, if C<Class::Name> is already loaded (checked with C<is_class_loaded>)"
NSQ_SOURCE_LINE 00000269 "then it will not try to load the class. This is useful when you have inner"
NSQ_SOURCE_LINE 00000270 "packages which C<require> does not check."
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "Like C<load_class>, you can pass a C<-version> in C<%options>. If the version"
NSQ_SOURCE_LINE 00000273 "is not sufficient, then this subroutine will return false."
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "=head2 is_class_loaded Class::Name, \\%options -> 0|1"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "This uses a number of heuristics to determine if the class C<Class::Name> is"
NSQ_SOURCE_LINE 00000278 "loaded. There heuristics were taken from L<Class::MOP>'s old pure-perl"
NSQ_SOURCE_LINE 00000279 "implementation."
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "Like C<load_class>, you can pass a C<-version> in C<%options>. If the version"
NSQ_SOURCE_LINE 00000282 "is not sufficient, then this subroutine will return false."
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "=head2 load_first_existing_class Class::Name, \\%options, ..."
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "This attempts to load the first loadable class in the list of classes"
NSQ_SOURCE_LINE 00000287 "given. Each class name can be followed by an options hash reference."
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "If any one of the classes loads and passes the optional version check, that"
NSQ_SOURCE_LINE 00000290 "class name will be returned. If I<none> of the classes can be loaded (or none"
NSQ_SOURCE_LINE 00000291 "pass their version check), then an error will be thrown."
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "If, when attempting to load a class, it fails to load because of a syntax"
NSQ_SOURCE_LINE 00000294 "error, then an error will be thrown immediately."
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "=head2 load_optional_class Class::Name, \\%options -> 0|1"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "C<load_optional_class> is a lot like C<try_load_class>, but also a lot like"
NSQ_SOURCE_LINE 00000299 "C<load_class>."
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "If the class exists, and it works, then it will return 1. If you specify a"
NSQ_SOURCE_LINE 00000302 "version in C<%options>, then the version check must succeed or it will return"
NSQ_SOURCE_LINE 00000303 "0."
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "If the class doesn't exist, and it appears to not exist on disk either, it"
NSQ_SOURCE_LINE 00000306 "will return 0."
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "If the class exists on disk, but loading from disk results in an error"
NSQ_SOURCE_LINE 00000309 "(e.g.: a syntax error), then it will C<croak> with that error."
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "This is useful for using if you want a fallback module system, i.e.:"
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "    my $class = load_optional_class($foo) ? $foo : $default;"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "That way, if $foo does exist, but can't be loaded due to error, you won't"
NSQ_SOURCE_LINE 00000316 "get the behaviour of it simply not existing."
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "=head1 CAVEATS"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "Because of some of the heuristics that this module uses to infer whether a"
NSQ_SOURCE_LINE 00000321 "module has been loaded, some false positives may occur in C<is_class_loaded>"
NSQ_SOURCE_LINE 00000322 "checks (which are also performed internally in other interfaces) -- if a class"
NSQ_SOURCE_LINE 00000323 "has started to be loaded but then dies, it may appear that it has already been"
NSQ_SOURCE_LINE 00000324 "loaded, which can cause other things to make the wrong decision."
NSQ_SOURCE_LINE 00000325 "L<Module::Runtime> doesn't have this issue, but it also doesn't do some things"
NSQ_SOURCE_LINE 00000326 "that this module does -- for example gracefully handle packages that have been"
NSQ_SOURCE_LINE 00000327 "defined inline in the same file as another package."
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "=over 4"
NSQ_SOURCE_LINE 00000332 ""
NSQ_SOURCE_LINE 00000333 "=item L<http://blog.fox.geek.nz/2010/11/searching-design-spec-for-ultimate.html>"
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "This blog post is a good overview of the current state of the existing modules"
NSQ_SOURCE_LINE 00000336 "for loading other modules in various ways."
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "=item L<http://blog.fox.geek.nz/2010/11/handling-optional-requirements-with.html>"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "This blog post describes how to handle optional modules with L<Class::Load>."
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "=item L<http://d.hatena.ne.jp/tokuhirom/20110202/1296598578>"
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "This Japanese blog post describes why L<DBIx::Skinny> now uses L<Class::Load>"
NSQ_SOURCE_LINE 00000345 "over its competitors."
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "=item L<Moose>, L<Jifty>, L<Prophet>, etc"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "This module was designed to be used anywhere you have"
NSQ_SOURCE_LINE 00000350 "C<if (eval \"require $module\"; 1)>, which occurs in many large projects."
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "=item L<Module::Runtime>"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "A leaner approach to loading modules"
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "=back"
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 "=head1 SUPPORT"
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 "Bugs may be submitted through L<the RT bug tracker|https://rt.cpan.org/Public/Dist/Display.html?Name=Class-Load>"
NSQ_SOURCE_LINE 00000361 "(or L<bug-Class-Load@rt.cpan.org|mailto:bug-Class-Load@rt.cpan.org>)."
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "There is also a mailing list available for users of this distribution, at"
NSQ_SOURCE_LINE 00000364 "L<http://lists.perl.org/list/moose.html>."
NSQ_SOURCE_LINE 00000365 ""
