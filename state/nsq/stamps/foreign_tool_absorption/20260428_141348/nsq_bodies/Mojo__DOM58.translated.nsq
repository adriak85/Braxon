NSQ_SOURCE_LINE 00000187 "sub val {"
NSQ_SOURCE_LINE 00000188 "  my $self = shift;"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "  # \"option\""
NSQ_SOURCE_LINE 00000191 "  return defined($self->{value}) ? $self->{value} : $self->text"
