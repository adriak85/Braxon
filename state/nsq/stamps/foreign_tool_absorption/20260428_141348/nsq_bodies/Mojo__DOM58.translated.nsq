NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "  # \"input\" (\"type=checkbox\" and \"type=radio\")"
NSQ_SOURCE_LINE 00000195 "  my $type = $self->{type} || '';"
NSQ_SOURCE_LINE 00000196 "  return defined $self->{value} ? $self->{value} : 'on'"
