NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "sub _fragment { _link(my $r = ['root', @_], [@_]); $r }"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "sub _link {"
NSQ_SOURCE_LINE 00000272 "  my ($parent, $children) = @_;"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "  # Link parent to children"
NSQ_SOURCE_LINE 00000275 "  for my $node (@$children) {"
