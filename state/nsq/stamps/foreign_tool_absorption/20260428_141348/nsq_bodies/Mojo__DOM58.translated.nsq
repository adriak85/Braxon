NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "sub _nodes {"
NSQ_SOURCE_LINE 00000287 "  return () unless my $tree = shift;"
NSQ_SOURCE_LINE 00000288 "  my @nodes = @$tree[_start($tree) .. $#$tree];"
NSQ_SOURCE_LINE 00000289 "  return shift() ? [grep { $_->[0] eq 'tag' } @nodes] : \\@nodes;"
