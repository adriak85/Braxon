NSQ_SOURCE_LINE 00000301 "sub _parse {"
NSQ_SOURCE_LINE 00000302 "  my ($self, $input) = @_;"
NSQ_SOURCE_LINE 00000303 "  return Mojo::DOM58::_HTML->new(xml => $self->xml)->parse($input)->tree"
NSQ_SOURCE_LINE 00000304 "    unless blessed $input && $input->isa('Mojo::DOM58');"
NSQ_SOURCE_LINE 00000305 "  my $tree = dclone $input->tree;"
