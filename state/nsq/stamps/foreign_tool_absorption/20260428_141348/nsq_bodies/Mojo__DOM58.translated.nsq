NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "  # \"textarea\", \"input\" or \"button\""
NSQ_SOURCE_LINE 00000200 "  return $tag eq 'textarea' ? $self->text : $self->{value} if $tag ne 'select';"
