NSQ_SOURCE_LINE 00000317 "sub _siblings {"
NSQ_SOURCE_LINE 00000318 "  my ($tree, $tags, $tail, $i) = @_;"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "  return defined $i ? undef : [] if $tree->[0] eq 'root';"
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "  my $nodes = _nodes(_parent($tree));"
NSQ_SOURCE_LINE 00000323 "  my $match = -1;"
NSQ_SOURCE_LINE 00000324 "  defined($match++) and $_ eq $tree and last for @$nodes;"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "  if ($tail) { splice @$nodes, 0, $match + 1 }"
NSQ_SOURCE_LINE 00000327 "  else       { splice @$nodes, $match, ($#$nodes + 1) - $match }"
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "  @$nodes = grep { $_->[0] eq 'tag' } @$nodes if $tags;"
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "  return defined $i ? $i == -1 && !@$nodes ? undef : $nodes->[$i] : $nodes;"
