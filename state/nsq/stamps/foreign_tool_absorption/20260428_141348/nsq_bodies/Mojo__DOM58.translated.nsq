NSQ_SOURCE_LINE 00000336 "sub _text {"
NSQ_SOURCE_LINE 00000337 "  my ($nodes, $xml, $all) = @_;"
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "  my $text = '';"
NSQ_SOURCE_LINE 00000340 "  while (my $node = shift @$nodes) {"
NSQ_SOURCE_LINE 00000341 "    my $type = $node->[0];"
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "    # Text"
NSQ_SOURCE_LINE 00000344 "    if ($type eq 'text' || $type eq 'cdata' || $type eq 'raw') {"
NSQ_SOURCE_LINE 00000345 "      $text .= $node->[1];"
NSQ_SOURCE_LINE 00000346 "    }"
NSQ_SOURCE_LINE 00000347 ""
NSQ_SOURCE_LINE 00000348 "    # Nested tag"
NSQ_SOURCE_LINE 00000349 "    elsif ($type eq 'tag' && $all) {"
NSQ_SOURCE_LINE 00000350 "      unshift @$nodes, @{_nodes($node)} if $xml || ($node->[1] ne 'script' && $node->[1] ne 'style');"
NSQ_SOURCE_LINE 00000351 "    }"
NSQ_SOURCE_LINE 00000352 "  }"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "  return $text;"
NSQ_SOURCE_LINE 00000355 "}"
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "sub _wrap {"
NSQ_SOURCE_LINE 00000358 "  my ($self, $content, $new) = @_;"
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 "  return $self if (my $tree = $self->tree)->[0] eq 'root' && !$content;"
NSQ_SOURCE_LINE 00000361 "  return $self if $tree->[0] ne 'root' && $tree->[0] ne 'tag' && $content;"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "  # Find innermost tag"
NSQ_SOURCE_LINE 00000364 "  my $current;"
NSQ_SOURCE_LINE 00000365 "  my $first = $new = $self->_parse($new);"
NSQ_SOURCE_LINE 00000366 "  $current = $first while $first = _nodes($first, 1)->[0];"
NSQ_SOURCE_LINE 00000367 "  return $self unless $current;"
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "  # Wrap content"
NSQ_SOURCE_LINE 00000370 "  if ($content) {"
NSQ_SOURCE_LINE 00000371 "    push @$current, @{_link($current, _nodes($tree))};"
NSQ_SOURCE_LINE 00000372 "    splice @$tree, _start($tree), $#$tree, @{_link($tree, _nodes($new))};"
NSQ_SOURCE_LINE 00000373 "    return $self;"
NSQ_SOURCE_LINE 00000374 "  }"
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "  # Wrap element"
NSQ_SOURCE_LINE 00000377 "  $self->_replace(_parent($tree), $tree, _nodes($new));"
NSQ_SOURCE_LINE 00000378 "  push @$current, @{_link($current, [$tree])};"
NSQ_SOURCE_LINE 00000379 "  return $self;"
NSQ_SOURCE_LINE 00000380 "}"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "1;"
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "=encoding utf8"
NSQ_SOURCE_LINE 00000385 ""
NSQ_SOURCE_LINE 00000386 "=head1 NAME"
NSQ_SOURCE_LINE 00000387 ""
NSQ_SOURCE_LINE 00000388 "Mojo::DOM58 - Minimalistic HTML/XML DOM parser with CSS selectors"
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "  use Mojo::DOM58;"
NSQ_SOURCE_LINE 00000393 ""
NSQ_SOURCE_LINE 00000394 "  # Parse"
NSQ_SOURCE_LINE 00000395 "  my $dom = Mojo::DOM58->new('<div><p id=\"a\">Test</p><p id=\"b\">123</p></div>');"
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "  # Find"
NSQ_SOURCE_LINE 00000398 "  say $dom->at('#b')->text;"
NSQ_SOURCE_LINE 00000399 "  say $dom->find('p')->map('text')->join(\"\\n\");"
NSQ_SOURCE_LINE 00000400 "  say $dom->find('[id]')->map(attr => 'id')->join(\"\\n\");"
NSQ_SOURCE_LINE 00000401 ""
NSQ_SOURCE_LINE 00000402 "  # Iterate"
NSQ_SOURCE_LINE 00000403 "  $dom->find('p[id]')->reverse->each(sub { say $_->{id} });"
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "  # Loop"
NSQ_SOURCE_LINE 00000406 "  for my $e ($dom->find('p[id]')->each) {"
NSQ_SOURCE_LINE 00000407 "    say $e->{id}, ':', $e->text;"
NSQ_SOURCE_LINE 00000408 "  }"
NSQ_SOURCE_LINE 00000409 ""
NSQ_SOURCE_LINE 00000410 "  # Modify"
NSQ_SOURCE_LINE 00000411 "  $dom->find('div p')->last->append('<p id=\"c\">456</p>');"
NSQ_SOURCE_LINE 00000412 "  $dom->at('#c')->prepend($dom->new_tag('p', id => 'd', '789'));"
NSQ_SOURCE_LINE 00000413 "  $dom->find(':not(p)')->map('strip');"
NSQ_SOURCE_LINE 00000414 ""
NSQ_SOURCE_LINE 00000415 "  # Render"
NSQ_SOURCE_LINE 00000416 "  say \"$dom\";"
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "L<Mojo::DOM58> is a minimalistic and relaxed pure-perl HTML/XML DOM parser based"
NSQ_SOURCE_LINE 00000421 "on L<Mojo::DOM>. It supports the L<HTML Living Standard|https://html.spec.whatwg.org/>"
NSQ_SOURCE_LINE 00000422 "and L<Extensible Markup Language (XML) 1.0|https://www.w3.org/TR/xml/>, and"
NSQ_SOURCE_LINE 00000423 "matching based on L<CSS3 selectors|https://www.w3.org/TR/selectors/>. It will"
NSQ_SOURCE_LINE 00000424 "even try to interpret broken HTML and XML, so you should not use it for"
NSQ_SOURCE_LINE 00000425 "validation."
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 "=head1 FORK INFO"
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 "L<Mojo::DOM58> is a fork of L<Mojo::DOM> and tracks features and fixes to stay"
NSQ_SOURCE_LINE 00000430 "closely compatible with upstream. It differs only in the standalone format and"
NSQ_SOURCE_LINE 00000431 "compatibility with Perl 5.8. Any bugs or patches not related to these changes"
NSQ_SOURCE_LINE 00000432 "should be reported directly to the L<Mojolicious> issue tracker."
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 "This release of L<Mojo::DOM58> is up to date with version C<9.40> of"
NSQ_SOURCE_LINE 00000435 "L<Mojolicious>."
NSQ_SOURCE_LINE 00000436 ""
NSQ_SOURCE_LINE 00000437 "=head1 NODES AND ELEMENTS"
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "When we parse an HTML/XML fragment, it gets turned into a tree of nodes."
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "  <!DOCTYPE html>"
NSQ_SOURCE_LINE 00000442 "  <html>"
NSQ_SOURCE_LINE 00000443 "    <head><title>Hello</title></head>"
NSQ_SOURCE_LINE 00000444 "    <body>World!</body>"
NSQ_SOURCE_LINE 00000445 "  </html>"
NSQ_SOURCE_LINE 00000446 ""
NSQ_SOURCE_LINE 00000447 "There are currently eight different kinds of nodes, C<cdata>, C<comment>,"
NSQ_SOURCE_LINE 00000448 "C<doctype>, C<pi>, C<raw>, C<root>, C<tag> and C<text>. Elements are nodes of"
NSQ_SOURCE_LINE 00000449 "the type C<tag>."
NSQ_SOURCE_LINE 00000450 ""
NSQ_SOURCE_LINE 00000451 "  root"
NSQ_SOURCE_LINE 00000452 "  |- doctype (html)"
NSQ_SOURCE_LINE 00000453 "  +- tag (html)"
NSQ_SOURCE_LINE 00000454 "     |- tag (head)"
NSQ_SOURCE_LINE 00000455 "     |  +- tag (title)"
NSQ_SOURCE_LINE 00000456 "     |     +- raw (Hello)"
NSQ_SOURCE_LINE 00000457 "     +- tag (body)"
NSQ_SOURCE_LINE 00000458 "        +- text (World!)"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "While all node types are represented as L<Mojo::DOM58> objects, some methods like"
NSQ_SOURCE_LINE 00000461 "L</\"attr\"> and L</\"namespace\"> only apply to elements."
NSQ_SOURCE_LINE 00000462 ""
NSQ_SOURCE_LINE 00000463 "=head1 HTML AND XML"
NSQ_SOURCE_LINE 00000464 ""
NSQ_SOURCE_LINE 00000465 "L<Mojo::DOM58> defaults to HTML semantics, that means all tags and attribute"
NSQ_SOURCE_LINE 00000466 "names are lowercased and selectors need to be lowercase as well."
NSQ_SOURCE_LINE 00000467 ""
NSQ_SOURCE_LINE 00000468 "  # HTML semantics"
NSQ_SOURCE_LINE 00000469 "  my $dom = Mojo::DOM58->new('<P ID=\"greeting\">Hi!</P>');"
NSQ_SOURCE_LINE 00000470 "  say $dom->at('p[id]')->text;"
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "If an XML declaration is found, the parser will automatically switch into XML"
NSQ_SOURCE_LINE 00000473 "mode and everything becomes case-sensitive."
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 "  # XML semantics"
NSQ_SOURCE_LINE 00000476 "  my $dom = Mojo::DOM58->new('<?xml version=\"1.0\"?><P ID=\"greeting\">Hi!</P>');"
NSQ_SOURCE_LINE 00000477 "  say $dom->at('P[ID]')->text;"
NSQ_SOURCE_LINE 00000478 ""
NSQ_SOURCE_LINE 00000479 "HTML or XML semantics can also be forced with the L</\"xml\"> method."
NSQ_SOURCE_LINE 00000480 ""
NSQ_SOURCE_LINE 00000481 "  # Force HTML semantics"
NSQ_SOURCE_LINE 00000482 "  my $dom = Mojo::DOM58->new->xml(0)->parse('<P ID=\"greeting\">Hi!</P>');"
NSQ_SOURCE_LINE 00000483 "  say $dom->at('p[id]')->text;"
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "  # Force XML semantics"
NSQ_SOURCE_LINE 00000486 "  my $dom = Mojo::DOM58->new->xml(1)->parse('<P ID=\"greeting\">Hi!</P>');"
NSQ_SOURCE_LINE 00000487 "  say $dom->at('P[ID]')->text;"
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 "=head1 SELECTORS"
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "L<Mojo::DOM58> uses a CSS selector engine based on L<Mojo::DOM::CSS>. All CSS"
NSQ_SOURCE_LINE 00000492 "selectors that make sense for a standalone parser are supported."
NSQ_SOURCE_LINE 00000493 ""
NSQ_SOURCE_LINE 00000494 "=over"
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "=item Z<>*"
NSQ_SOURCE_LINE 00000497 ""
NSQ_SOURCE_LINE 00000498 "Any element."
NSQ_SOURCE_LINE 00000499 ""
NSQ_SOURCE_LINE 00000500 "  my $all = $dom->find('*');"
NSQ_SOURCE_LINE 00000501 ""
NSQ_SOURCE_LINE 00000502 "=item E"
NSQ_SOURCE_LINE 00000503 ""
NSQ_SOURCE_LINE 00000504 "An element of type C<E>."
NSQ_SOURCE_LINE 00000505 ""
NSQ_SOURCE_LINE 00000506 "  my $title = $dom->at('title');"
NSQ_SOURCE_LINE 00000507 ""
NSQ_SOURCE_LINE 00000508 "=item E[foo]"
NSQ_SOURCE_LINE 00000509 ""
NSQ_SOURCE_LINE 00000510 "An C<E> element with a C<foo> attribute."
NSQ_SOURCE_LINE 00000511 ""
NSQ_SOURCE_LINE 00000512 "  my $links = $dom->find('a[href]');"
NSQ_SOURCE_LINE 00000513 ""
NSQ_SOURCE_LINE 00000514 "=item E[foo=\"bar\"]"
NSQ_SOURCE_LINE 00000515 ""
NSQ_SOURCE_LINE 00000516 "An C<E> element whose C<foo> attribute value is exactly equal to C<bar>."
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "  my $case_sensitive = $dom->find('input[type=\"hidden\"]');"
NSQ_SOURCE_LINE 00000519 "  my $case_sensitive = $dom->find('input[type=hidden]');"
NSQ_SOURCE_LINE 00000520 ""
NSQ_SOURCE_LINE 00000521 "=item E[foo=\"bar\" i]"
NSQ_SOURCE_LINE 00000522 ""
NSQ_SOURCE_LINE 00000523 "An C<E> element whose C<foo> attribute value is exactly equal to any"
NSQ_SOURCE_LINE 00000524 "(ASCII-range) case-permutation of C<bar>. Note that this selector is"
NSQ_SOURCE_LINE 00000525 "B<EXPERIMENTAL> and might change without warning!"
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 "  my $case_insensitive = $dom->find('input[type=\"hidden\" i]');"
NSQ_SOURCE_LINE 00000528 "  my $case_insensitive = $dom->find('input[type=hidden i]');"
NSQ_SOURCE_LINE 00000529 "  my $case_insensitive = $dom->find('input[class~=\"foo\" i]');"
NSQ_SOURCE_LINE 00000530 ""
NSQ_SOURCE_LINE 00000531 "This selector is part of"
NSQ_SOURCE_LINE 00000532 "L<Selectors Level 4|https://dev.w3.org/csswg/selectors-4>, which is still a work"
NSQ_SOURCE_LINE 00000533 "in progress."
NSQ_SOURCE_LINE 00000534 ""
NSQ_SOURCE_LINE 00000535 "=item E[foo=\"bar\" s]"
NSQ_SOURCE_LINE 00000536 ""
NSQ_SOURCE_LINE 00000537 "An C<E> element whose C<foo> attribute value is exactly and case-sensitively"
NSQ_SOURCE_LINE 00000538 "equal to C<bar>. Note that this selector is B<EXPERIMENTAL> and might change"
NSQ_SOURCE_LINE 00000539 "without warning!"
NSQ_SOURCE_LINE 00000540 ""
NSQ_SOURCE_LINE 00000541 "  my $case_sensitive = $dom->find('input[type=\"hidden\" s]');"
NSQ_SOURCE_LINE 00000542 ""
NSQ_SOURCE_LINE 00000543 "This selector is part of"
NSQ_SOURCE_LINE 00000544 "L<Selectors Level 4|https://dev.w3.org/csswg/selectors-4>, which is still a work"
NSQ_SOURCE_LINE 00000545 "in progress."
NSQ_SOURCE_LINE 00000546 ""
NSQ_SOURCE_LINE 00000547 "=item E[foo~=\"bar\"]"
NSQ_SOURCE_LINE 00000548 ""
NSQ_SOURCE_LINE 00000549 "An C<E> element whose C<foo> attribute value is a list of whitespace-separated"
NSQ_SOURCE_LINE 00000550 "values, one of which is exactly equal to C<bar>."
NSQ_SOURCE_LINE 00000551 ""
NSQ_SOURCE_LINE 00000552 "  my $foo = $dom->find('input[class~=\"foo\"]');"
NSQ_SOURCE_LINE 00000553 "  my $foo = $dom->find('input[class~=foo]');"
NSQ_SOURCE_LINE 00000554 ""
NSQ_SOURCE_LINE 00000555 "=item E[foo^=\"bar\"]"
NSQ_SOURCE_LINE 00000556 ""
NSQ_SOURCE_LINE 00000557 "An C<E> element whose C<foo> attribute value begins exactly with the string"
NSQ_SOURCE_LINE 00000558 "C<bar>."
NSQ_SOURCE_LINE 00000559 ""
NSQ_SOURCE_LINE 00000560 "  my $begins_with = $dom->find('input[name^=\"f\"]');"
NSQ_SOURCE_LINE 00000561 "  my $begins_with = $dom->find('input[name^=f]');"
NSQ_SOURCE_LINE 00000562 ""
NSQ_SOURCE_LINE 00000563 "=item E[foo$=\"bar\"]"
NSQ_SOURCE_LINE 00000564 ""
NSQ_SOURCE_LINE 00000565 "An C<E> element whose C<foo> attribute value ends exactly with the string"
NSQ_SOURCE_LINE 00000566 "C<bar>."
NSQ_SOURCE_LINE 00000567 ""
NSQ_SOURCE_LINE 00000568 "  my $ends_with = $dom->find('input[name$=\"o\"]');"
NSQ_SOURCE_LINE 00000569 "  my $ends_with = $dom->find('input[name$=o]');"
NSQ_SOURCE_LINE 00000570 ""
NSQ_SOURCE_LINE 00000571 "=item E[foo*=\"bar\"]"
NSQ_SOURCE_LINE 00000572 ""
NSQ_SOURCE_LINE 00000573 "An C<E> element whose C<foo> attribute value contains the substring C<bar>."
NSQ_SOURCE_LINE 00000574 ""
NSQ_SOURCE_LINE 00000575 "  my $contains = $dom->find('input[name*=\"fo\"]');"
NSQ_SOURCE_LINE 00000576 "  my $contains = $dom->find('input[name*=fo]');"
NSQ_SOURCE_LINE 00000577 ""
NSQ_SOURCE_LINE 00000578 "=item E[foo|=\"en\"]"
NSQ_SOURCE_LINE 00000579 ""
NSQ_SOURCE_LINE 00000580 "An C<E> element whose C<foo> attribute has a hyphen-separated list of values"
NSQ_SOURCE_LINE 00000581 "beginning (from the left) with C<en>."
NSQ_SOURCE_LINE 00000582 ""
NSQ_SOURCE_LINE 00000583 "  my $english = $dom->find('link[hreflang|=en]');"
NSQ_SOURCE_LINE 00000584 ""
NSQ_SOURCE_LINE 00000585 "=item E:root"
NSQ_SOURCE_LINE 00000586 ""
NSQ_SOURCE_LINE 00000587 "An C<E> element, root of the document."
NSQ_SOURCE_LINE 00000588 ""
NSQ_SOURCE_LINE 00000589 "  my $root = $dom->at(':root');"
NSQ_SOURCE_LINE 00000590 ""
NSQ_SOURCE_LINE 00000591 "=item E:nth-child(n)"
NSQ_SOURCE_LINE 00000592 ""
NSQ_SOURCE_LINE 00000593 "An C<E> element, the C<n-th> child of its parent."
NSQ_SOURCE_LINE 00000594 ""
NSQ_SOURCE_LINE 00000595 "  my $third = $dom->find('div:nth-child(3)');"
NSQ_SOURCE_LINE 00000596 "  my $odd   = $dom->find('div:nth-child(odd)');"
NSQ_SOURCE_LINE 00000597 "  my $even  = $dom->find('div:nth-child(even)');"
NSQ_SOURCE_LINE 00000598 "  my $top3  = $dom->find('div:nth-child(-n+3)');"
NSQ_SOURCE_LINE 00000599 ""
NSQ_SOURCE_LINE 00000600 "=item E:nth-last-child(n)"
NSQ_SOURCE_LINE 00000601 ""
NSQ_SOURCE_LINE 00000602 "An C<E> element, the C<n-th> child of its parent, counting from the last one."
NSQ_SOURCE_LINE 00000603 ""
NSQ_SOURCE_LINE 00000604 "  my $third    = $dom->find('div:nth-last-child(3)');"
NSQ_SOURCE_LINE 00000605 "  my $odd      = $dom->find('div:nth-last-child(odd)');"
NSQ_SOURCE_LINE 00000606 "  my $even     = $dom->find('div:nth-last-child(even)');"
NSQ_SOURCE_LINE 00000607 "  my $bottom3  = $dom->find('div:nth-last-child(-n+3)');"
NSQ_SOURCE_LINE 00000608 ""
NSQ_SOURCE_LINE 00000609 "=item E:nth-of-type(n)"
NSQ_SOURCE_LINE 00000610 ""
NSQ_SOURCE_LINE 00000611 "An C<E> element, the C<n-th> sibling of its type."
NSQ_SOURCE_LINE 00000612 ""
NSQ_SOURCE_LINE 00000613 "  my $third = $dom->find('div:nth-of-type(3)');"
NSQ_SOURCE_LINE 00000614 "  my $odd   = $dom->find('div:nth-of-type(odd)');"
NSQ_SOURCE_LINE 00000615 "  my $even  = $dom->find('div:nth-of-type(even)');"
NSQ_SOURCE_LINE 00000616 "  my $top3  = $dom->find('div:nth-of-type(-n+3)');"
NSQ_SOURCE_LINE 00000617 ""
NSQ_SOURCE_LINE 00000618 "=item E:nth-last-of-type(n)"
NSQ_SOURCE_LINE 00000619 ""
NSQ_SOURCE_LINE 00000620 "An C<E> element, the C<n-th> sibling of its type, counting from the last one."
NSQ_SOURCE_LINE 00000621 ""
NSQ_SOURCE_LINE 00000622 "  my $third    = $dom->find('div:nth-last-of-type(3)');"
NSQ_SOURCE_LINE 00000623 "  my $odd      = $dom->find('div:nth-last-of-type(odd)');"
NSQ_SOURCE_LINE 00000624 "  my $even     = $dom->find('div:nth-last-of-type(even)');"
NSQ_SOURCE_LINE 00000625 "  my $bottom3  = $dom->find('div:nth-last-of-type(-n+3)');"
NSQ_SOURCE_LINE 00000626 ""
NSQ_SOURCE_LINE 00000627 "=item E:first-child"
NSQ_SOURCE_LINE 00000628 ""
NSQ_SOURCE_LINE 00000629 "An C<E> element, first child of its parent."
NSQ_SOURCE_LINE 00000630 ""
NSQ_SOURCE_LINE 00000631 "  my $first = $dom->find('div p:first-child');"
NSQ_SOURCE_LINE 00000632 ""
NSQ_SOURCE_LINE 00000633 "=item E:last-child"
NSQ_SOURCE_LINE 00000634 ""
NSQ_SOURCE_LINE 00000635 "An C<E> element, last child of its parent."
NSQ_SOURCE_LINE 00000636 ""
NSQ_SOURCE_LINE 00000637 "  my $last = $dom->find('div p:last-child');"
NSQ_SOURCE_LINE 00000638 ""
NSQ_SOURCE_LINE 00000639 "=item E:first-of-type"
NSQ_SOURCE_LINE 00000640 ""
NSQ_SOURCE_LINE 00000641 "An C<E> element, first sibling of its type."
NSQ_SOURCE_LINE 00000642 ""
NSQ_SOURCE_LINE 00000643 "  my $first = $dom->find('div p:first-of-type');"
NSQ_SOURCE_LINE 00000644 ""
NSQ_SOURCE_LINE 00000645 "=item E:last-of-type"
NSQ_SOURCE_LINE 00000646 ""
NSQ_SOURCE_LINE 00000647 "An C<E> element, last sibling of its type."
NSQ_SOURCE_LINE 00000648 ""
NSQ_SOURCE_LINE 00000649 "  my $last = $dom->find('div p:last-of-type');"
NSQ_SOURCE_LINE 00000650 ""
NSQ_SOURCE_LINE 00000651 "=item E:only-child"
NSQ_SOURCE_LINE 00000652 ""
NSQ_SOURCE_LINE 00000653 "An C<E> element, only child of its parent."
NSQ_SOURCE_LINE 00000654 ""
NSQ_SOURCE_LINE 00000655 "  my $lonely = $dom->find('div p:only-child');"
NSQ_SOURCE_LINE 00000656 ""
NSQ_SOURCE_LINE 00000657 "=item E:only-of-type"
NSQ_SOURCE_LINE 00000658 ""
NSQ_SOURCE_LINE 00000659 "An C<E> element, only sibling of its type."
NSQ_SOURCE_LINE 00000660 ""
NSQ_SOURCE_LINE 00000661 "  my $lonely = $dom->find('div p:only-of-type');"
NSQ_SOURCE_LINE 00000662 ""
NSQ_SOURCE_LINE 00000663 "=item E:empty"
NSQ_SOURCE_LINE 00000664 ""
NSQ_SOURCE_LINE 00000665 "An C<E> element that has no children (including text nodes)."
NSQ_SOURCE_LINE 00000666 ""
NSQ_SOURCE_LINE 00000667 "  my $empty = $dom->find(':empty');"
NSQ_SOURCE_LINE 00000668 ""
NSQ_SOURCE_LINE 00000669 "=item E:any-link"
NSQ_SOURCE_LINE 00000670 ""
NSQ_SOURCE_LINE 00000671 "Alias for L</\"E:link\">. Note that this selector is B<EXPERIMENTAL> and might"
NSQ_SOURCE_LINE 00000672 "change without warning! This selector is part of"
NSQ_SOURCE_LINE 00000673 "L<Selectors Level 4|https://dev.w3.org/csswg/selectors-4>, which is still a"
NSQ_SOURCE_LINE 00000674 "work in progress."
NSQ_SOURCE_LINE 00000675 ""
NSQ_SOURCE_LINE 00000676 "=item E:link"
NSQ_SOURCE_LINE 00000677 ""
NSQ_SOURCE_LINE 00000678 "An C<E> element being the source anchor of a hyperlink of which the target is"
NSQ_SOURCE_LINE 00000679 "not yet visited (C<:link>) or already visited (C<:visited>). Note that"
NSQ_SOURCE_LINE 00000680 "L<Mojo::DOM58> is not stateful, therefore C<:any-link>, C<:link> and"
NSQ_SOURCE_LINE 00000681 "C<:visited> yield exactly the same results."
NSQ_SOURCE_LINE 00000682 ""
NSQ_SOURCE_LINE 00000683 "  my $links = $dom->find(':any-link');"
NSQ_SOURCE_LINE 00000684 "  my $links = $dom->find(':link');"
NSQ_SOURCE_LINE 00000685 "  my $links = $dom->find(':visited');"
NSQ_SOURCE_LINE 00000686 ""
NSQ_SOURCE_LINE 00000687 "=item E:visited"
NSQ_SOURCE_LINE 00000688 ""
NSQ_SOURCE_LINE 00000689 "Alias for L</\"E:link\">."
NSQ_SOURCE_LINE 00000690 ""
NSQ_SOURCE_LINE 00000691 "=item E:scope"
NSQ_SOURCE_LINE 00000692 ""
NSQ_SOURCE_LINE 00000693 "An C<E> element being a designated reference element. Note that this selector is B<EXPERIMENTAL> and might change"
NSQ_SOURCE_LINE 00000694 "without warning!"
NSQ_SOURCE_LINE 00000695 ""
NSQ_SOURCE_LINE 00000696 "  my $scoped = $dom->find('a:not(:scope > a)');"
NSQ_SOURCE_LINE 00000697 "  my $scoped = $dom->find('div :scope p');"
NSQ_SOURCE_LINE 00000698 "  my $scoped = $dom->find('~ p');"
NSQ_SOURCE_LINE 00000699 ""
NSQ_SOURCE_LINE 00000700 "This selector is part of L<Selectors Level 4|https://dev.w3.org/csswg/selectors-4>, which is still a work in progress."
NSQ_SOURCE_LINE 00000701 ""
NSQ_SOURCE_LINE 00000702 "=item E:checked"
NSQ_SOURCE_LINE 00000703 ""
NSQ_SOURCE_LINE 00000704 "A user interface element C<E> which is checked (for instance a radio-button or"
NSQ_SOURCE_LINE 00000705 "checkbox)."
NSQ_SOURCE_LINE 00000706 ""
NSQ_SOURCE_LINE 00000707 "  my $input = $dom->find(':checked');"
NSQ_SOURCE_LINE 00000708 ""
NSQ_SOURCE_LINE 00000709 "=item E.warning"
NSQ_SOURCE_LINE 00000710 ""
NSQ_SOURCE_LINE 00000711 "An C<E> element whose class is \"warning\"."
NSQ_SOURCE_LINE 00000712 ""
NSQ_SOURCE_LINE 00000713 "  my $warning = $dom->find('div.warning');"
NSQ_SOURCE_LINE 00000714 ""
NSQ_SOURCE_LINE 00000715 "=item E#myid"
NSQ_SOURCE_LINE 00000716 ""
NSQ_SOURCE_LINE 00000717 "An C<E> element with C<ID> equal to \"myid\"."
NSQ_SOURCE_LINE 00000718 ""
NSQ_SOURCE_LINE 00000719 "  my $foo = $dom->at('div#foo');"
NSQ_SOURCE_LINE 00000720 ""
NSQ_SOURCE_LINE 00000721 "=item E:not(s1, s2)"
NSQ_SOURCE_LINE 00000722 ""
NSQ_SOURCE_LINE 00000723 "An C<E> element that does not match either compound selector C<s1> or compound"
NSQ_SOURCE_LINE 00000724 "selector C<s2>. Note that support for compound selectors is B<EXPERIMENTAL> and"
NSQ_SOURCE_LINE 00000725 "might change without warning!"
NSQ_SOURCE_LINE 00000726 ""
NSQ_SOURCE_LINE 00000727 "  my $others = $dom->find('div p:not(:first-child, :last-child)');"
NSQ_SOURCE_LINE 00000728 ""
NSQ_SOURCE_LINE 00000729 "Support for compound selectors was added as part of"
NSQ_SOURCE_LINE 00000730 "L<Selectors Level 4|https://dev.w3.org/csswg/selectors-4>, which is still a work"
NSQ_SOURCE_LINE 00000731 "in progress."
NSQ_SOURCE_LINE 00000732 ""
NSQ_SOURCE_LINE 00000733 "=item E:is(s1, s2)"
NSQ_SOURCE_LINE 00000734 ""
NSQ_SOURCE_LINE 00000735 "An C<E> element that matches compound selector C<s1> and/or compound selector"
NSQ_SOURCE_LINE 00000736 "C<s2>. Note that this selector is B<EXPERIMENTAL> and might change without warning!"
NSQ_SOURCE_LINE 00000737 ""
NSQ_SOURCE_LINE 00000738 "  my $headers = $dom->find(':is(section, article, aside, nav) h1');"
NSQ_SOURCE_LINE 00000739 ""
NSQ_SOURCE_LINE 00000740 "This selector is part of"
NSQ_SOURCE_LINE 00000741 "L<Selectors Level 4|https://dev.w3.org/csswg/selectors-4>, which is still a work"
NSQ_SOURCE_LINE 00000742 "in progress."
NSQ_SOURCE_LINE 00000743 ""
NSQ_SOURCE_LINE 00000744 "=item E:has(rs1, rs2)"
NSQ_SOURCE_LINE 00000745 ""
NSQ_SOURCE_LINE 00000746 "An C<E> element, if either of the relative selectors C<rs1> or C<rs2>, when evaluated with C<E> as the :scope elements,"
NSQ_SOURCE_LINE 00000747 "match an element. Note that this selector is B<EXPERIMENTAL> and might change without warning!"
NSQ_SOURCE_LINE 00000748 ""
NSQ_SOURCE_LINE 00000749 "  my $link = $dom->find('a:has(> img)');"
NSQ_SOURCE_LINE 00000750 ""
NSQ_SOURCE_LINE 00000751 "This selector is part of L<Selectors Level 4|https://dev.w3.org/csswg/selectors-4>, which is still a work in progress."
NSQ_SOURCE_LINE 00000752 "Also be aware that this feature is currently marked C<at-risk>, so there is a high chance that it will get removed"
NSQ_SOURCE_LINE 00000753 "completely."
NSQ_SOURCE_LINE 00000754 ""
NSQ_SOURCE_LINE 00000755 "=item E:text(string_or_regex)"
NSQ_SOURCE_LINE 00000756 ""
NSQ_SOURCE_LINE 00000757 "An C<E> element containing text content that substring matches C<string_or_regex> case-insensitively or that regex"
NSQ_SOURCE_LINE 00000758 "matches C<string_or_regex>. For regular expressions use the format C<:text(/.../)>. Note that this selector is"
NSQ_SOURCE_LINE 00000759 "B<EXPERIMENTAL> and might change without warning!"
NSQ_SOURCE_LINE 00000760 ""
NSQ_SOURCE_LINE 00000761 "  # Substring match"
NSQ_SOURCE_LINE 00000762 "  my $login = $dom->find(':text(Log in)');"
NSQ_SOURCE_LINE 00000763 ""
NSQ_SOURCE_LINE 00000764 "  # Regex match"
NSQ_SOURCE_LINE 00000765 "  my $login = $dom->find(':text(/Log ?in/)');"
NSQ_SOURCE_LINE 00000766 ""
NSQ_SOURCE_LINE 00000767 "  # Regex match (case-insensitive)"
NSQ_SOURCE_LINE 00000768 "  my $login = $dom->find(':text(/(?i:Log ?in)/)');"
NSQ_SOURCE_LINE 00000769 ""
NSQ_SOURCE_LINE 00000770 "This is a custom selector for L<Mojo::DOM58> and not part of any spec."
NSQ_SOURCE_LINE 00000771 ""
NSQ_SOURCE_LINE 00000772 "=item A|E"
NSQ_SOURCE_LINE 00000773 ""
NSQ_SOURCE_LINE 00000774 "An C<E> element that belongs to the namespace alias C<A> from"
NSQ_SOURCE_LINE 00000775 "L<CSS Namespaces Module Level 3|https://www.w3.org/TR/css-namespaces-3/>."
NSQ_SOURCE_LINE 00000776 "Key/value pairs passed to selector methods are used to declare namespace"
NSQ_SOURCE_LINE 00000777 "aliases."
NSQ_SOURCE_LINE 00000778 ""
NSQ_SOURCE_LINE 00000779 "  my $elem = $dom->find('lq|elem', lq => 'http://example.com/q-markup');"
NSQ_SOURCE_LINE 00000780 ""
NSQ_SOURCE_LINE 00000781 "Using an empty alias searches for an element that belongs to no namespace."
NSQ_SOURCE_LINE 00000782 ""
NSQ_SOURCE_LINE 00000783 "  my $div = $dom->find('|div');"
NSQ_SOURCE_LINE 00000784 ""
NSQ_SOURCE_LINE 00000785 "=item E F"
NSQ_SOURCE_LINE 00000786 ""
NSQ_SOURCE_LINE 00000787 "An C<F> element descendant of an C<E> element."
NSQ_SOURCE_LINE 00000788 ""
NSQ_SOURCE_LINE 00000789 "  my $headlines = $dom->find('div h1');"
NSQ_SOURCE_LINE 00000790 ""
NSQ_SOURCE_LINE 00000791 "=item E E<gt> F"
NSQ_SOURCE_LINE 00000792 ""
NSQ_SOURCE_LINE 00000793 "An C<F> element child of an C<E> element."
NSQ_SOURCE_LINE 00000794 ""
NSQ_SOURCE_LINE 00000795 "  my $headlines = $dom->find('html > body > div > h1');"
NSQ_SOURCE_LINE 00000796 ""
NSQ_SOURCE_LINE 00000797 "=item E + F"
NSQ_SOURCE_LINE 00000798 ""
NSQ_SOURCE_LINE 00000799 "An C<F> element immediately preceded by an C<E> element."
NSQ_SOURCE_LINE 00000800 ""
NSQ_SOURCE_LINE 00000801 "  my $second = $dom->find('h1 + h2');"
NSQ_SOURCE_LINE 00000802 ""
NSQ_SOURCE_LINE 00000803 "=item E ~ F"
NSQ_SOURCE_LINE 00000804 ""
NSQ_SOURCE_LINE 00000805 "An C<F> element preceded by an C<E> element."
NSQ_SOURCE_LINE 00000806 ""
NSQ_SOURCE_LINE 00000807 "  my $second = $dom->find('h1 ~ h2');"
NSQ_SOURCE_LINE 00000808 ""
NSQ_SOURCE_LINE 00000809 "=item E, F, G"
NSQ_SOURCE_LINE 00000810 ""
NSQ_SOURCE_LINE 00000811 "Elements of type C<E>, C<F> and C<G>."
NSQ_SOURCE_LINE 00000812 ""
NSQ_SOURCE_LINE 00000813 "  my $headlines = $dom->find('h1, h2, h3');"
NSQ_SOURCE_LINE 00000814 ""
NSQ_SOURCE_LINE 00000815 "=item E[foo=bar][bar=baz]"
NSQ_SOURCE_LINE 00000816 ""
NSQ_SOURCE_LINE 00000817 "An C<E> element whose attributes match all following attribute selectors."
NSQ_SOURCE_LINE 00000818 ""
NSQ_SOURCE_LINE 00000819 "  my $links = $dom->find('a[foo^=b][foo$=ar]');"
NSQ_SOURCE_LINE 00000820 ""
NSQ_SOURCE_LINE 00000821 "=back"
NSQ_SOURCE_LINE 00000822 ""
NSQ_SOURCE_LINE 00000823 "=head1 OPERATORS"
NSQ_SOURCE_LINE 00000824 ""
NSQ_SOURCE_LINE 00000825 "L<Mojo::DOM58> overloads the following operators."
NSQ_SOURCE_LINE 00000826 ""
NSQ_SOURCE_LINE 00000827 "=head2 array"
NSQ_SOURCE_LINE 00000828 ""
NSQ_SOURCE_LINE 00000829 "  my @nodes = @$dom;"
NSQ_SOURCE_LINE 00000830 ""
NSQ_SOURCE_LINE 00000831 "Alias for L</\"child_nodes\">."
NSQ_SOURCE_LINE 00000832 ""
NSQ_SOURCE_LINE 00000833 "  # \"<!-- Test -->\""
NSQ_SOURCE_LINE 00000834 "  $dom->parse('<!-- Test --><b>123</b>')->[0];"
NSQ_SOURCE_LINE 00000835 ""
NSQ_SOURCE_LINE 00000836 "=head2 bool"
NSQ_SOURCE_LINE 00000837 ""
NSQ_SOURCE_LINE 00000838 "  my $bool = !!$dom;"
NSQ_SOURCE_LINE 00000839 ""
NSQ_SOURCE_LINE 00000840 "Always true."
NSQ_SOURCE_LINE 00000841 ""
NSQ_SOURCE_LINE 00000842 "=head2 hash"
NSQ_SOURCE_LINE 00000843 ""
NSQ_SOURCE_LINE 00000844 "  my %attrs = %$dom;"
NSQ_SOURCE_LINE 00000845 ""
NSQ_SOURCE_LINE 00000846 "Alias for L</\"attr\">."
NSQ_SOURCE_LINE 00000847 ""
NSQ_SOURCE_LINE 00000848 "  # \"test\""
NSQ_SOURCE_LINE 00000849 "  $dom->parse('<div id=\"test\">Test</div>')->at('div')->{id};"
NSQ_SOURCE_LINE 00000850 ""
NSQ_SOURCE_LINE 00000851 "=head2 stringify"
NSQ_SOURCE_LINE 00000852 ""
NSQ_SOURCE_LINE 00000853 "  my $str = \"$dom\";"
NSQ_SOURCE_LINE 00000854 ""
NSQ_SOURCE_LINE 00000855 "Alias for L</\"to_string\">."
NSQ_SOURCE_LINE 00000856 ""
NSQ_SOURCE_LINE 00000857 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000858 ""
NSQ_SOURCE_LINE 00000859 "L<Mojo::DOM58> implements the following functions, which can be imported"
NSQ_SOURCE_LINE 00000860 "individually."
NSQ_SOURCE_LINE 00000861 ""
NSQ_SOURCE_LINE 00000862 "=head2 tag_to_html"
NSQ_SOURCE_LINE 00000863 ""
NSQ_SOURCE_LINE 00000864 "  my $str = tag_to_html 'div', id => 'foo', 'safe content';"
NSQ_SOURCE_LINE 00000865 ""
NSQ_SOURCE_LINE 00000866 "Generate HTML/XML tag and render it right away. This is a significantly faster"
NSQ_SOURCE_LINE 00000867 "alternative to L</\"new_tag\"> for template systems that have to generate a lot"
NSQ_SOURCE_LINE 00000868 "of tags."
NSQ_SOURCE_LINE 00000869 ""
NSQ_SOURCE_LINE 00000870 "=head1 METHODS"
NSQ_SOURCE_LINE 00000871 ""
NSQ_SOURCE_LINE 00000872 "L<Mojo::DOM58> implements the following methods."
NSQ_SOURCE_LINE 00000873 ""
NSQ_SOURCE_LINE 00000874 "=head2 new"
NSQ_SOURCE_LINE 00000875 ""
NSQ_SOURCE_LINE 00000876 "  my $dom = Mojo::DOM58->new;"
NSQ_SOURCE_LINE 00000877 "  my $dom = Mojo::DOM58->new('<foo bar=\"baz\">I ♥ Mojo::DOM58!</foo>');"
NSQ_SOURCE_LINE 00000878 ""
NSQ_SOURCE_LINE 00000879 "Construct a new scalar-based L<Mojo::DOM58> object and L</\"parse\"> HTML/XML"
NSQ_SOURCE_LINE 00000880 "fragment if necessary."
NSQ_SOURCE_LINE 00000881 ""
NSQ_SOURCE_LINE 00000882 "=head2 new_tag"
NSQ_SOURCE_LINE 00000883 ""
NSQ_SOURCE_LINE 00000884 "  my $tag = Mojo::DOM58->new_tag('div');"
NSQ_SOURCE_LINE 00000885 "  my $tag = $dom->new_tag('div');"
NSQ_SOURCE_LINE 00000886 "  my $tag = $dom->new_tag('div', id => 'foo', hidden => undef);"
NSQ_SOURCE_LINE 00000887 "  my $tag = $dom->new_tag('div', 'safe content');"
NSQ_SOURCE_LINE 00000888 "  my $tag = $dom->new_tag('div', id => 'foo', 'safe content');"
NSQ_SOURCE_LINE 00000889 "  my $tag = $dom->new_tag('div', data => {mojo => 'rocks'}, 'safe content');"
NSQ_SOURCE_LINE 00000890 "  my $tag = $dom->new_tag('div', id => 'foo', sub { 'unsafe content' });"
NSQ_SOURCE_LINE 00000891 ""
NSQ_SOURCE_LINE 00000892 "Construct a new L<Mojo::DOM58> object for an HTML/XML tag with or without"
NSQ_SOURCE_LINE 00000893 "attributes and content. The C<data> attribute may contain a hash reference with"
NSQ_SOURCE_LINE 00000894 "key/value pairs to generate attributes from."
NSQ_SOURCE_LINE 00000895 ""
NSQ_SOURCE_LINE 00000896 "  # \"<br>\""
NSQ_SOURCE_LINE 00000897 "  $dom->new_tag('br');"
NSQ_SOURCE_LINE 00000898 ""
NSQ_SOURCE_LINE 00000899 "  # \"<div></div>\""
NSQ_SOURCE_LINE 00000900 "  $dom->new_tag('div');"
NSQ_SOURCE_LINE 00000901 ""
NSQ_SOURCE_LINE 00000902 "  # \"<div id=\"foo\" hidden></div>\""
NSQ_SOURCE_LINE 00000903 "  $dom->new_tag('div', id => 'foo', hidden => undef);"
NSQ_SOURCE_LINE 00000904 ""
NSQ_SOURCE_LINE 00000905 "  # \"<div>test &amp; 123</div>\""
NSQ_SOURCE_LINE 00000906 "  $dom->new_tag('div', 'test & 123');"
NSQ_SOURCE_LINE 00000907 ""
NSQ_SOURCE_LINE 00000908 "  # \"<div id=\"foo\">test &amp; 123</div>\""
NSQ_SOURCE_LINE 00000909 "  $dom->new_tag('div', id => 'foo', 'test & 123');"
NSQ_SOURCE_LINE 00000910 ""
NSQ_SOURCE_LINE 00000911 "  # \"<div data-foo=\"1\" data-bar=\"test\">test &amp; 123</div>\"\""
NSQ_SOURCE_LINE 00000912 "  $dom->new_tag('div', data => {foo => 1, Bar => 'test'}, 'test & 123');"
NSQ_SOURCE_LINE 00000913 ""
NSQ_SOURCE_LINE 00000914 "  # \"<div id=\"foo\">test & 123</div>\""
NSQ_SOURCE_LINE 00000915 "  $dom->new_tag('div', id => 'foo', sub { 'test & 123' });"
NSQ_SOURCE_LINE 00000916 ""
NSQ_SOURCE_LINE 00000917 "  # \"<div>Hello<b>Mojo!</b></div>\""
NSQ_SOURCE_LINE 00000918 "  $dom->parse('<div>Hello</div>')->at('div')"
NSQ_SOURCE_LINE 00000919 "    ->append_content($dom->new_tag('b', 'Mojo!'))->root;"
NSQ_SOURCE_LINE 00000920 ""
NSQ_SOURCE_LINE 00000921 "=head2 all_text"
NSQ_SOURCE_LINE 00000922 ""
NSQ_SOURCE_LINE 00000923 "  my $text = $dom->all_text;"
NSQ_SOURCE_LINE 00000924 ""
NSQ_SOURCE_LINE 00000925 "Extract text content from all descendant nodes of this element. For HTML documents C<script> and C<style> elements are"
NSQ_SOURCE_LINE 00000926 "excluded."
NSQ_SOURCE_LINE 00000927 ""
NSQ_SOURCE_LINE 00000928 "  # \"foo\\nbarbaz\\n\""
NSQ_SOURCE_LINE 00000929 "  $dom->parse(\"<div>foo\\n<p>bar</p>baz\\n</div>\")->at('div')->all_text;"
NSQ_SOURCE_LINE 00000930 ""
NSQ_SOURCE_LINE 00000931 "=head2 ancestors"
NSQ_SOURCE_LINE 00000932 ""
NSQ_SOURCE_LINE 00000933 "  my $collection = $dom->ancestors;"
NSQ_SOURCE_LINE 00000934 "  my $collection = $dom->ancestors('div ~ p');"
NSQ_SOURCE_LINE 00000935 ""
NSQ_SOURCE_LINE 00000936 "Find all ancestor elements of this node matching the CSS selector and return a"
NSQ_SOURCE_LINE 00000937 "L<collection|/\"COLLECTION METHODS\"> containing these elements as L<Mojo::DOM58>"
NSQ_SOURCE_LINE 00000938 "objects. All selectors listed in L</\"SELECTORS\"> are supported."
NSQ_SOURCE_LINE 00000939 ""
NSQ_SOURCE_LINE 00000940 "  # List tag names of ancestor elements"
NSQ_SOURCE_LINE 00000941 "  say $dom->ancestors->map('tag')->join(\"\\n\");"
NSQ_SOURCE_LINE 00000942 ""
NSQ_SOURCE_LINE 00000943 "=head2 append"
NSQ_SOURCE_LINE 00000944 ""
NSQ_SOURCE_LINE 00000945 "  $dom = $dom->append('<p>I ♥ Mojo::DOM58!</p>');"
NSQ_SOURCE_LINE 00000946 "  $dom = $dom->append(Mojo::DOM58->new);"
NSQ_SOURCE_LINE 00000947 ""
NSQ_SOURCE_LINE 00000948 "Append HTML/XML fragment to this node (for all node types other than C<root>)."
NSQ_SOURCE_LINE 00000949 ""
NSQ_SOURCE_LINE 00000950 "  # \"<div><h1>Test</h1><h2>123</h2></div>\""
NSQ_SOURCE_LINE 00000951 "  $dom->parse('<div><h1>Test</h1></div>')"
NSQ_SOURCE_LINE 00000952 "    ->at('h1')->append('<h2>123</h2>')->root;"
NSQ_SOURCE_LINE 00000953 ""
NSQ_SOURCE_LINE 00000954 "  # \"<p>Test 123</p>\""
NSQ_SOURCE_LINE 00000955 "  $dom->parse('<p>Test</p>')->at('p')"
NSQ_SOURCE_LINE 00000956 "    ->child_nodes->first->append(' 123')->root;"
NSQ_SOURCE_LINE 00000957 ""
NSQ_SOURCE_LINE 00000958 "=head2 append_content"
NSQ_SOURCE_LINE 00000959 ""
NSQ_SOURCE_LINE 00000960 "  $dom = $dom->append_content('<p>I ♥ Mojo::DOM58!</p>');"
NSQ_SOURCE_LINE 00000961 "  $dom = $dom->append_content(Mojo::DOM58->new);"
NSQ_SOURCE_LINE 00000962 ""
NSQ_SOURCE_LINE 00000963 "Append HTML/XML fragment (for C<root> and C<tag> nodes) or raw content to this"
NSQ_SOURCE_LINE 00000964 "node's content."
NSQ_SOURCE_LINE 00000965 ""
NSQ_SOURCE_LINE 00000966 "  # \"<div><h1>Test123</h1></div>\""
NSQ_SOURCE_LINE 00000967 "  $dom->parse('<div><h1>Test</h1></div>')"
NSQ_SOURCE_LINE 00000968 "    ->at('h1')->append_content('123')->root;"
NSQ_SOURCE_LINE 00000969 ""
NSQ_SOURCE_LINE 00000970 "  # \"<!-- Test 123 --><br>\""
NSQ_SOURCE_LINE 00000971 "  $dom->parse('<!-- Test --><br>')"
NSQ_SOURCE_LINE 00000972 "    ->child_nodes->first->append_content('123 ')->root;"
NSQ_SOURCE_LINE 00000973 ""
NSQ_SOURCE_LINE 00000974 "  # \"<p>Test<i>123</i></p>\""
NSQ_SOURCE_LINE 00000975 "  $dom->parse('<p>Test</p>')->at('p')->append_content('<i>123</i>')->root;"
NSQ_SOURCE_LINE 00000976 ""
NSQ_SOURCE_LINE 00000977 "=head2 at"
NSQ_SOURCE_LINE 00000978 ""
NSQ_SOURCE_LINE 00000979 "  my $result = $dom->at('div ~ p');"
NSQ_SOURCE_LINE 00000980 "  my $result = $dom->at('svg|line', svg => 'http://www.w3.org/2000/svg');"
NSQ_SOURCE_LINE 00000981 ""
NSQ_SOURCE_LINE 00000982 "Find first descendant element of this element matching the CSS selector and"
NSQ_SOURCE_LINE 00000983 "return it as a L<Mojo::DOM58> object, or C<undef> if none could be found. All"
NSQ_SOURCE_LINE 00000984 "selectors listed in L</\"SELECTORS\"> are supported."
NSQ_SOURCE_LINE 00000985 ""
NSQ_SOURCE_LINE 00000986 "  # Find first element with \"svg\" namespace definition"
NSQ_SOURCE_LINE 00000987 "  my $namespace = $dom->at('[xmlns\\:svg]')->{'xmlns:svg'};"
NSQ_SOURCE_LINE 00000988 ""
NSQ_SOURCE_LINE 00000989 "Trailing key/value pairs can be used to declare xml namespace aliases."
NSQ_SOURCE_LINE 00000990 ""
NSQ_SOURCE_LINE 00000991 "  # \"<rect />\""
NSQ_SOURCE_LINE 00000992 "  $dom->parse('<svg xmlns=\"http://www.w3.org/2000/svg\"><rect /></svg>')"
NSQ_SOURCE_LINE 00000993 "    ->at('svg|rect', svg => 'http://www.w3.org/2000/svg');"
NSQ_SOURCE_LINE 00000994 ""
NSQ_SOURCE_LINE 00000995 "=head2 attr"
NSQ_SOURCE_LINE 00000996 ""
NSQ_SOURCE_LINE 00000997 "  my $hash = $dom->attr;"
NSQ_SOURCE_LINE 00000998 "  my $foo  = $dom->attr('foo');"
NSQ_SOURCE_LINE 00000999 "  $dom     = $dom->attr({foo => 'bar'});"
NSQ_SOURCE_LINE 00001000 "  $dom     = $dom->attr(foo => 'bar');"
NSQ_SOURCE_LINE 00001001 ""
NSQ_SOURCE_LINE 00001002 "This element's attributes."
NSQ_SOURCE_LINE 00001003 ""
NSQ_SOURCE_LINE 00001004 "  # Remove an attribute"
NSQ_SOURCE_LINE 00001005 "  delete $dom->attr->{id};"
NSQ_SOURCE_LINE 00001006 ""
NSQ_SOURCE_LINE 00001007 "  # Attribute without value"
NSQ_SOURCE_LINE 00001008 "  $dom->attr(selected => undef);"
NSQ_SOURCE_LINE 00001009 ""
NSQ_SOURCE_LINE 00001010 "  # List id attributes"
NSQ_SOURCE_LINE 00001011 "  say $dom->find('*')->map(attr => 'id')->compact->join(\"\\n\");"
NSQ_SOURCE_LINE 00001012 ""
NSQ_SOURCE_LINE 00001013 "=head2 child_nodes"
NSQ_SOURCE_LINE 00001014 ""
NSQ_SOURCE_LINE 00001015 "  my $collection = $dom->child_nodes;"
NSQ_SOURCE_LINE 00001016 ""
NSQ_SOURCE_LINE 00001017 "Return a L<collection|/\"COLLECTION METHODS\"> containing all child nodes of this"
NSQ_SOURCE_LINE 00001018 "element as L<Mojo::DOM58> objects."
NSQ_SOURCE_LINE 00001019 ""
NSQ_SOURCE_LINE 00001020 "  # \"<p><b>123</b></p>\""
NSQ_SOURCE_LINE 00001021 "  $dom->parse('<p>Test<b>123</b></p>')->at('p')->child_nodes->first->remove;"
NSQ_SOURCE_LINE 00001022 ""
NSQ_SOURCE_LINE 00001023 "  # \"<!DOCTYPE html>\""
NSQ_SOURCE_LINE 00001024 "  $dom->parse('<!DOCTYPE html><b>123</b>')->child_nodes->first;"
NSQ_SOURCE_LINE 00001025 ""
NSQ_SOURCE_LINE 00001026 "  # \" Test \""
NSQ_SOURCE_LINE 00001027 "  $dom->parse('<b>123</b><!-- Test -->')->child_nodes->last->content;"
NSQ_SOURCE_LINE 00001028 ""
NSQ_SOURCE_LINE 00001029 "=head2 children"
NSQ_SOURCE_LINE 00001030 ""
NSQ_SOURCE_LINE 00001031 "  my $collection = $dom->children;"
NSQ_SOURCE_LINE 00001032 "  my $collection = $dom->children('div ~ p');"
NSQ_SOURCE_LINE 00001033 ""
NSQ_SOURCE_LINE 00001034 "Find all child elements of this element matching the CSS selector and return a"
NSQ_SOURCE_LINE 00001035 "L<collection|/\"COLLECTION METHODS\"> containing these elements as L<Mojo::DOM58>"
NSQ_SOURCE_LINE 00001036 "objects. All selectors listed in L</\"SELECTORS\"> are supported."
NSQ_SOURCE_LINE 00001037 ""
NSQ_SOURCE_LINE 00001038 "  # Show tag name of random child element"
NSQ_SOURCE_LINE 00001039 "  say $dom->children->shuffle->first->tag;"
NSQ_SOURCE_LINE 00001040 ""
NSQ_SOURCE_LINE 00001041 "=head2 content"
NSQ_SOURCE_LINE 00001042 ""
NSQ_SOURCE_LINE 00001043 "  my $str = $dom->content;"
NSQ_SOURCE_LINE 00001044 "  $dom    = $dom->content('<p>I ♥ Mojo::DOM58!</p>');"
NSQ_SOURCE_LINE 00001045 "  $dom    = $dom->content(Mojo::DOM58->new);"
NSQ_SOURCE_LINE 00001046 ""
NSQ_SOURCE_LINE 00001047 "Return this node's content or replace it with HTML/XML fragment (for C<root>"
NSQ_SOURCE_LINE 00001048 "and C<tag> nodes) or raw content."
NSQ_SOURCE_LINE 00001049 ""
NSQ_SOURCE_LINE 00001050 "  # \"<b>Test</b>\""
NSQ_SOURCE_LINE 00001051 "  $dom->parse('<div><b>Test</b></div>')->at('div')->content;"
NSQ_SOURCE_LINE 00001052 ""
NSQ_SOURCE_LINE 00001053 "  # \"<div><h1>123</h1></div>\""
NSQ_SOURCE_LINE 00001054 "  $dom->parse('<div><h1>Test</h1></div>')->at('h1')->content('123')->root;"
NSQ_SOURCE_LINE 00001055 ""
NSQ_SOURCE_LINE 00001056 "  # \"<p><i>123</i></p>\""
NSQ_SOURCE_LINE 00001057 "  $dom->parse('<p>Test</p>')->at('p')->content('<i>123</i>')->root;"
NSQ_SOURCE_LINE 00001058 ""
NSQ_SOURCE_LINE 00001059 "  # \"<div><h1></h1></div>\""
NSQ_SOURCE_LINE 00001060 "  $dom->parse('<div><h1>Test</h1></div>')->at('h1')->content('')->root;"
NSQ_SOURCE_LINE 00001061 ""
NSQ_SOURCE_LINE 00001062 "  # \" Test \""
NSQ_SOURCE_LINE 00001063 "  $dom->parse('<!-- Test --><br>')->child_nodes->first->content;"
NSQ_SOURCE_LINE 00001064 ""
NSQ_SOURCE_LINE 00001065 "  # \"<div><!-- 123 -->456</div>\""
NSQ_SOURCE_LINE 00001066 "  $dom->parse('<div><!-- Test -->456</div>')"
NSQ_SOURCE_LINE 00001067 "    ->at('div')->child_nodes->first->content(' 123 ')->root;"
NSQ_SOURCE_LINE 00001068 ""
NSQ_SOURCE_LINE 00001069 "=head2 descendant_nodes"
NSQ_SOURCE_LINE 00001070 ""
NSQ_SOURCE_LINE 00001071 "  my $collection = $dom->descendant_nodes;"
NSQ_SOURCE_LINE 00001072 ""
NSQ_SOURCE_LINE 00001073 "Return a L<collection|/\"COLLECTION METHODS\"> containing all descendant nodes of"
NSQ_SOURCE_LINE 00001074 "this element as L<Mojo::DOM58> objects."
NSQ_SOURCE_LINE 00001075 ""
NSQ_SOURCE_LINE 00001076 "  # \"<p><b>123</b></p>\""
NSQ_SOURCE_LINE 00001077 "  $dom->parse('<p><!-- Test --><b>123<!-- 456 --></b></p>')"
NSQ_SOURCE_LINE 00001078 "    ->descendant_nodes->grep(sub { $_->type eq 'comment' })"
NSQ_SOURCE_LINE 00001079 "    ->map('remove')->first;"
NSQ_SOURCE_LINE 00001080 ""
NSQ_SOURCE_LINE 00001081 "  # \"<p><b>test</b>test</p>\""
NSQ_SOURCE_LINE 00001082 "  $dom->parse('<p><b>123</b>456</p>')"
NSQ_SOURCE_LINE 00001083 "    ->at('p')->descendant_nodes->grep(sub { $_->type eq 'text' })"
NSQ_SOURCE_LINE 00001084 "    ->map(content => 'test')->first->root;"
NSQ_SOURCE_LINE 00001085 ""
NSQ_SOURCE_LINE 00001086 "=head2 find"
NSQ_SOURCE_LINE 00001087 ""
NSQ_SOURCE_LINE 00001088 "  my $collection = $dom->find('div ~ p');"
NSQ_SOURCE_LINE 00001089 "  my $collection = $dom->find('svg|line', svg => 'http://www.w3.org/2000/svg');"
NSQ_SOURCE_LINE 00001090 ""
NSQ_SOURCE_LINE 00001091 "Find all descendant elements of this element matching the CSS selector and"
NSQ_SOURCE_LINE 00001092 "return a L<collection|/\"COLLECTION METHODS\"> containing these elements as"
NSQ_SOURCE_LINE 00001093 "L<Mojo::DOM58> objects. All selectors listed in L</\"SELECTORS\"> are supported."
NSQ_SOURCE_LINE 00001094 ""
NSQ_SOURCE_LINE 00001095 "  # Find a specific element and extract information"
NSQ_SOURCE_LINE 00001096 "  my $id = $dom->find('div')->[23]{id};"
NSQ_SOURCE_LINE 00001097 ""
NSQ_SOURCE_LINE 00001098 "  # Extract information from multiple elements"
NSQ_SOURCE_LINE 00001099 "  my @headers = $dom->find('h1, h2, h3')->map('text')->each;"
NSQ_SOURCE_LINE 00001100 ""
NSQ_SOURCE_LINE 00001101 "  # Count all the different tags"
NSQ_SOURCE_LINE 00001102 "  my $hash = $dom->find('*')->reduce(sub { $a->{$b->tag}++; $a }, {});"
NSQ_SOURCE_LINE 00001103 ""
NSQ_SOURCE_LINE 00001104 "  # Find elements with a class that contains dots"
NSQ_SOURCE_LINE 00001105 "  my @divs = $dom->find('div.foo\\.bar')->each;"
NSQ_SOURCE_LINE 00001106 ""
NSQ_SOURCE_LINE 00001107 "Trailing key/value pairs can be used to declare xml namespace aliases."
NSQ_SOURCE_LINE 00001108 ""
NSQ_SOURCE_LINE 00001109 "  # \"<rect />\""
NSQ_SOURCE_LINE 00001110 "  $dom->parse('<svg xmlns=\"http://www.w3.org/2000/svg\"><rect /></svg>')"
NSQ_SOURCE_LINE 00001111 "    ->find('svg|rect', svg => 'http://www.w3.org/2000/svg')->first;"
NSQ_SOURCE_LINE 00001112 ""
NSQ_SOURCE_LINE 00001113 "=head2 following"
NSQ_SOURCE_LINE 00001114 ""
NSQ_SOURCE_LINE 00001115 "  my $collection = $dom->following;"
