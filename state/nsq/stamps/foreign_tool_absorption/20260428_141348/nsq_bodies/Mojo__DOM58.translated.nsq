NSQ_SOURCE_LINE 00001485 ""
NSQ_SOURCE_LINE 00001486 "  # \"<p><b>Test</b></p>\""
NSQ_SOURCE_LINE 00001487 "  $dom->parse('<p>Test</p>')->at('p')->child_nodes->first->wrap('<b>')->root;"
NSQ_SOURCE_LINE 00001488 ""
NSQ_SOURCE_LINE 00001489 "=head2 wrap_content"
NSQ_SOURCE_LINE 00001490 ""
NSQ_SOURCE_LINE 00001491 "  $dom = $dom->wrap_content('<div></div>');"
NSQ_SOURCE_LINE 00001492 "  $dom = $dom->wrap_content(Mojo::DOM58->new);"
NSQ_SOURCE_LINE 00001493 ""
NSQ_SOURCE_LINE 00001494 "Wrap HTML/XML fragment around this node's content (for C<root> and C<tag>"
NSQ_SOURCE_LINE 00001495 "nodes), placing it as the last children of the first innermost element."
NSQ_SOURCE_LINE 00001496 ""
NSQ_SOURCE_LINE 00001497 "  # \"<p><b>123Test</b></p>\""
NSQ_SOURCE_LINE 00001498 "  $dom->parse('<p>Test<p>')->at('p')->wrap_content('<b>123</b>')->root;"
NSQ_SOURCE_LINE 00001499 ""
NSQ_SOURCE_LINE 00001500 "  # \"<p><b>Test</b></p><p>123</p>\""
NSQ_SOURCE_LINE 00001501 "  $dom->parse('<b>Test</b>')->wrap_content('<p></p><p>123</p>');"
NSQ_SOURCE_LINE 00001502 ""
NSQ_SOURCE_LINE 00001503 "=head2 xml"
NSQ_SOURCE_LINE 00001504 ""
NSQ_SOURCE_LINE 00001505 "  my $bool = $dom->xml;"
NSQ_SOURCE_LINE 00001506 "  $dom     = $dom->xml($bool);"
NSQ_SOURCE_LINE 00001507 ""
NSQ_SOURCE_LINE 00001508 "Disable HTML semantics in parser and activate case-sensitivity, defaults to"
NSQ_SOURCE_LINE 00001509 "auto detection based on XML declarations."
NSQ_SOURCE_LINE 00001510 ""
NSQ_SOURCE_LINE 00001511 "=head1 COLLECTION METHODS"
NSQ_SOURCE_LINE 00001512 ""
NSQ_SOURCE_LINE 00001513 "Some L<Mojo::DOM58> methods return an array-based collection object based on"
NSQ_SOURCE_LINE 00001514 "L<Mojo::Collection>, which can either be accessed directly as an array"
NSQ_SOURCE_LINE 00001515 "reference, or with the following methods."
NSQ_SOURCE_LINE 00001516 ""
NSQ_SOURCE_LINE 00001517 "  # Chain methods"
NSQ_SOURCE_LINE 00001518 "  $collection->map(sub { ucfirst })->shuffle->each(sub {"
NSQ_SOURCE_LINE 00001519 "    my ($word, $num) = @_;"
NSQ_SOURCE_LINE 00001520 "    say \"$num: $word\";"
NSQ_SOURCE_LINE 00001521 "  });"
NSQ_SOURCE_LINE 00001522 ""
NSQ_SOURCE_LINE 00001523 "  # Access array directly to manipulate collection"
NSQ_SOURCE_LINE 00001524 "  $collection->[23] += 100;"
NSQ_SOURCE_LINE 00001525 "  say for @$collection;"
NSQ_SOURCE_LINE 00001526 ""
NSQ_SOURCE_LINE 00001527 "=head2 compact"
NSQ_SOURCE_LINE 00001528 ""
NSQ_SOURCE_LINE 00001529 "  my $new = $collection->compact;"
NSQ_SOURCE_LINE 00001530 ""
NSQ_SOURCE_LINE 00001531 "Create a new L<collection|/\"COLLECTION METHODS\"> with all elements that are"
NSQ_SOURCE_LINE 00001532 "defined and not an empty string."
NSQ_SOURCE_LINE 00001533 ""
NSQ_SOURCE_LINE 00001534 "  # $collection contains (0, 1, undef, 2, '', 3)"
NSQ_SOURCE_LINE 00001535 "  $collection->compact->join(', '); # \"0, 1, 2, 3\""
NSQ_SOURCE_LINE 00001536 ""
NSQ_SOURCE_LINE 00001537 "=head2 each"
NSQ_SOURCE_LINE 00001538 ""
NSQ_SOURCE_LINE 00001539 "  my @elements = $collection->each;"
NSQ_SOURCE_LINE 00001540 "  $collection  = $collection->each(sub {...});"
NSQ_SOURCE_LINE 00001541 ""
NSQ_SOURCE_LINE 00001542 "Evaluate callback for each element in collection or return all elements as a"
NSQ_SOURCE_LINE 00001543 "list if none has been provided. The element will be the first argument passed"
NSQ_SOURCE_LINE 00001544 "to the callback and is also available as C<$_>."
NSQ_SOURCE_LINE 00001545 ""
NSQ_SOURCE_LINE 00001546 "  # Make a numbered list"
NSQ_SOURCE_LINE 00001547 "  $collection->each(sub {"
NSQ_SOURCE_LINE 00001548 "    my ($e, $num) = @_;"
NSQ_SOURCE_LINE 00001549 "    say \"$num: $e\";"
NSQ_SOURCE_LINE 00001550 "  });"
NSQ_SOURCE_LINE 00001551 ""
NSQ_SOURCE_LINE 00001552 "=head2 first"
NSQ_SOURCE_LINE 00001553 ""
NSQ_SOURCE_LINE 00001554 "  my $first = $collection->first;"
NSQ_SOURCE_LINE 00001555 "  my $first = $collection->first(qr/foo/);"
NSQ_SOURCE_LINE 00001556 "  my $first = $collection->first(sub {...});"
NSQ_SOURCE_LINE 00001557 "  my $first = $collection->first($method);"
NSQ_SOURCE_LINE 00001558 "  my $first = $collection->first($method, @args);"
NSQ_SOURCE_LINE 00001559 ""
NSQ_SOURCE_LINE 00001560 "Evaluate regular expression/callback for, or call method on, each element in"
NSQ_SOURCE_LINE 00001561 "collection and return the first one that matched the regular expression, or for"
NSQ_SOURCE_LINE 00001562 "which the callback/method returned true. The element will be the first argument"
NSQ_SOURCE_LINE 00001563 "passed to the callback and is also available as C<$_>."
NSQ_SOURCE_LINE 00001564 ""
NSQ_SOURCE_LINE 00001565 "  # Longer version"
NSQ_SOURCE_LINE 00001566 "  my $first = $collection->first(sub { $_->$method(@args) });"
NSQ_SOURCE_LINE 00001567 ""
NSQ_SOURCE_LINE 00001568 "  # Find first value that contains the word \"mojo\""
NSQ_SOURCE_LINE 00001569 "  my $interesting = $collection->first(qr/mojo/i);"
NSQ_SOURCE_LINE 00001570 ""
NSQ_SOURCE_LINE 00001571 "  # Find first value that is greater than 5"
NSQ_SOURCE_LINE 00001572 "  my $greater = $collection->first(sub { $_ > 5 });"
NSQ_SOURCE_LINE 00001573 ""
NSQ_SOURCE_LINE 00001574 "=head2 flatten"
NSQ_SOURCE_LINE 00001575 ""
NSQ_SOURCE_LINE 00001576 "  my $new = $collection->flatten;"
NSQ_SOURCE_LINE 00001577 ""
NSQ_SOURCE_LINE 00001578 "Flatten nested collections/arrays recursively and create a new"
NSQ_SOURCE_LINE 00001579 "L<collection|/\"COLLECTION METHODS\"> with all elements."
NSQ_SOURCE_LINE 00001580 ""
NSQ_SOURCE_LINE 00001581 "  # $collection contains (1, [2, [3, 4], 5, [6]], 7)"
NSQ_SOURCE_LINE 00001582 "  $collection->flatten->join(', '); # \"1, 2, 3, 4, 5, 6, 7\""
NSQ_SOURCE_LINE 00001583 ""
NSQ_SOURCE_LINE 00001584 "=head2 grep"
NSQ_SOURCE_LINE 00001585 ""
NSQ_SOURCE_LINE 00001586 "  my $new = $collection->grep(qr/foo/);"
NSQ_SOURCE_LINE 00001587 "  my $new = $collection->grep(sub {...});"
NSQ_SOURCE_LINE 00001588 "  my $new = $collection->grep($method);"
NSQ_SOURCE_LINE 00001589 "  my $new = $collection->grep($method, @args);"
NSQ_SOURCE_LINE 00001590 ""
NSQ_SOURCE_LINE 00001591 "Evaluate regular expression/callback for, or call method on, each element in"
NSQ_SOURCE_LINE 00001592 "collection and create a new L<collection|/\"COLLECTION METHODS\"> with all"
NSQ_SOURCE_LINE 00001593 "elements that matched the regular expression, or for which the callback/method"
NSQ_SOURCE_LINE 00001594 "returned true. The element will be the first argument passed to the callback"
NSQ_SOURCE_LINE 00001595 "and is also available as C<$_>."
NSQ_SOURCE_LINE 00001596 ""
NSQ_SOURCE_LINE 00001597 "  # Longer version"
NSQ_SOURCE_LINE 00001598 "  my $new = $collection->grep(sub { $_->$method(@args) });"
NSQ_SOURCE_LINE 00001599 ""
NSQ_SOURCE_LINE 00001600 "  # Find all values that contain the word \"mojo\""
NSQ_SOURCE_LINE 00001601 "  my $interesting = $collection->grep(qr/mojo/i);"
NSQ_SOURCE_LINE 00001602 ""
NSQ_SOURCE_LINE 00001603 "  # Find all values that are greater than 5"
NSQ_SOURCE_LINE 00001604 "  my $greater = $collection->grep(sub { $_ > 5 });"
NSQ_SOURCE_LINE 00001605 ""
NSQ_SOURCE_LINE 00001606 "=head2 head"
NSQ_SOURCE_LINE 00001607 ""
NSQ_SOURCE_LINE 00001608 "  my $new = $collection->head(4);"
NSQ_SOURCE_LINE 00001609 "  my $new = $collection->head(-2);"
NSQ_SOURCE_LINE 00001610 ""
NSQ_SOURCE_LINE 00001611 "Create a new L<collection|/\"COLLECTION METHODS\"> with up to the specified"
NSQ_SOURCE_LINE 00001612 "number of elements from the beginning of the collection. A negative number will"
NSQ_SOURCE_LINE 00001613 "count from the end."
NSQ_SOURCE_LINE 00001614 ""
NSQ_SOURCE_LINE 00001615 "  # $collection contains ('A', 'B', 'C', 'D', 'E')"
NSQ_SOURCE_LINE 00001616 "  $collection->head(3)->join(' '); # \"A B C\""
NSQ_SOURCE_LINE 00001617 "  $collection->head(-3)->join(' '); # \"A B\""
NSQ_SOURCE_LINE 00001618 ""
NSQ_SOURCE_LINE 00001619 "=head2 join"
NSQ_SOURCE_LINE 00001620 ""
NSQ_SOURCE_LINE 00001621 "  my $stream = $collection->join;"
NSQ_SOURCE_LINE 00001622 "  my $stream = $collection->join(\"\\n\");"
NSQ_SOURCE_LINE 00001623 ""
NSQ_SOURCE_LINE 00001624 "Turn collection into string."
NSQ_SOURCE_LINE 00001625 ""
NSQ_SOURCE_LINE 00001626 "  # Join all values with commas"
NSQ_SOURCE_LINE 00001627 "  $collection->join(', ');"
NSQ_SOURCE_LINE 00001628 ""
NSQ_SOURCE_LINE 00001629 "=head2 last"
NSQ_SOURCE_LINE 00001630 ""
NSQ_SOURCE_LINE 00001631 "  my $last = $collection->last;"
NSQ_SOURCE_LINE 00001632 ""
NSQ_SOURCE_LINE 00001633 "Return the last element in collection."
NSQ_SOURCE_LINE 00001634 ""
NSQ_SOURCE_LINE 00001635 "=head2 map"
NSQ_SOURCE_LINE 00001636 ""
NSQ_SOURCE_LINE 00001637 "  my $new = $collection->map(sub {...});"
NSQ_SOURCE_LINE 00001638 "  my $new = $collection->map($method);"
NSQ_SOURCE_LINE 00001639 "  my $new = $collection->map($method, @args);"
NSQ_SOURCE_LINE 00001640 ""
NSQ_SOURCE_LINE 00001641 "Evaluate callback for, or call method on, each element in collection and create"
NSQ_SOURCE_LINE 00001642 "a new L<collection|/\"COLLECTION METHODS\"> from the results. The element will be"
NSQ_SOURCE_LINE 00001643 "the first argument passed to the callback and is also available as C<$_>."
NSQ_SOURCE_LINE 00001644 ""
NSQ_SOURCE_LINE 00001645 "  # Longer version"
NSQ_SOURCE_LINE 00001646 "  my $new = $collection->map(sub { $_->$method(@args) });"
NSQ_SOURCE_LINE 00001647 ""
NSQ_SOURCE_LINE 00001648 "  # Append the word \"mojo\" to all values"
NSQ_SOURCE_LINE 00001649 "  my $domified = $collection->map(sub { $_ . 'mojo' });"
NSQ_SOURCE_LINE 00001650 ""
NSQ_SOURCE_LINE 00001651 "=head2 reduce"
NSQ_SOURCE_LINE 00001652 ""
NSQ_SOURCE_LINE 00001653 "  my $result = $collection->reduce(sub {...});"
NSQ_SOURCE_LINE 00001654 "  my $result = $collection->reduce(sub {...}, $initial);"
NSQ_SOURCE_LINE 00001655 ""
NSQ_SOURCE_LINE 00001656 "Reduce elements in collection with callback, the first element will be used as"
NSQ_SOURCE_LINE 00001657 "initial value if none has been provided."
NSQ_SOURCE_LINE 00001658 ""
NSQ_SOURCE_LINE 00001659 "  # Calculate the sum of all values"
NSQ_SOURCE_LINE 00001660 "  my $sum = $collection->reduce(sub { $a + $b });"
NSQ_SOURCE_LINE 00001661 ""
NSQ_SOURCE_LINE 00001662 "  # Count how often each value occurs in collection"
NSQ_SOURCE_LINE 00001663 "  my $hash = $collection->reduce(sub { $a->{$b}++; $a }, {});"
NSQ_SOURCE_LINE 00001664 ""
NSQ_SOURCE_LINE 00001665 "=head2 reverse"
NSQ_SOURCE_LINE 00001666 ""
NSQ_SOURCE_LINE 00001667 "  my $new = $collection->reverse;"
NSQ_SOURCE_LINE 00001668 ""
NSQ_SOURCE_LINE 00001669 "Create a new L<collection|/\"COLLECTION METHODS\"> with all elements in reverse"
NSQ_SOURCE_LINE 00001670 "order."
NSQ_SOURCE_LINE 00001671 ""
NSQ_SOURCE_LINE 00001672 "=head2 slice"
NSQ_SOURCE_LINE 00001673 ""
NSQ_SOURCE_LINE 00001674 "  my $new = $collection->slice(4 .. 7);"
NSQ_SOURCE_LINE 00001675 ""
NSQ_SOURCE_LINE 00001676 "Create a new L<collection|/\"COLLECTION METHODS\"> with all selected elements."
NSQ_SOURCE_LINE 00001677 ""
NSQ_SOURCE_LINE 00001678 "  # $collection contains ('A', 'B', 'C', 'D', 'E')"
NSQ_SOURCE_LINE 00001679 "  $collection->slice(1, 2, 4)->join(' '); # \"B C E\""
NSQ_SOURCE_LINE 00001680 ""
NSQ_SOURCE_LINE 00001681 "=head2 shuffle"
NSQ_SOURCE_LINE 00001682 ""
NSQ_SOURCE_LINE 00001683 "  my $new = $collection->shuffle;"
NSQ_SOURCE_LINE 00001684 ""
NSQ_SOURCE_LINE 00001685 "Create a new L<collection|/\"COLLECTION METHODS\"> with all elements in random"
NSQ_SOURCE_LINE 00001686 "order."
NSQ_SOURCE_LINE 00001687 ""
NSQ_SOURCE_LINE 00001688 "=head2 size"
NSQ_SOURCE_LINE 00001689 ""
NSQ_SOURCE_LINE 00001690 "  my $size = $collection->size;"
NSQ_SOURCE_LINE 00001691 ""
NSQ_SOURCE_LINE 00001692 "Number of elements in collection."
NSQ_SOURCE_LINE 00001693 ""
NSQ_SOURCE_LINE 00001694 "=head2 sort"
NSQ_SOURCE_LINE 00001695 ""
NSQ_SOURCE_LINE 00001696 "  my $new = $collection->sort;"
NSQ_SOURCE_LINE 00001697 "  my $new = $collection->sort(sub {...});"
NSQ_SOURCE_LINE 00001698 ""
NSQ_SOURCE_LINE 00001699 "Sort elements based on return value of callback and create a new"
NSQ_SOURCE_LINE 00001700 "L<collection|/\"COLLECTION METHODS\"> from the results."
NSQ_SOURCE_LINE 00001701 ""
NSQ_SOURCE_LINE 00001702 "  # Sort values case-insensitive"
NSQ_SOURCE_LINE 00001703 "  my $case_insensitive = $collection->sort(sub { uc($a) cmp uc($b) });"
NSQ_SOURCE_LINE 00001704 ""
NSQ_SOURCE_LINE 00001705 "=head2 tail"
NSQ_SOURCE_LINE 00001706 ""
NSQ_SOURCE_LINE 00001707 "  my $new = $collection->tail(4);"
NSQ_SOURCE_LINE 00001708 "  my $new = $collection->tail(-2);"
NSQ_SOURCE_LINE 00001709 ""
NSQ_SOURCE_LINE 00001710 "Create a new L<collection|/\"COLLECTION METHODS\"> with up to the specified"
NSQ_SOURCE_LINE 00001711 "number of elements from the end of the collection. A negative number will count"
NSQ_SOURCE_LINE 00001712 "from the beginning."
NSQ_SOURCE_LINE 00001713 ""
NSQ_SOURCE_LINE 00001714 "  # $collection contains ('A', 'B', 'C', 'D', 'E')"
NSQ_SOURCE_LINE 00001715 "  $collection->tail(3)->join(' '); # \"C D E\""
NSQ_SOURCE_LINE 00001716 "  $collection->tail(-3)->join(' '); # \"D E\""
NSQ_SOURCE_LINE 00001717 ""
NSQ_SOURCE_LINE 00001718 "=head2 tap"
NSQ_SOURCE_LINE 00001719 ""
NSQ_SOURCE_LINE 00001720 "  $collection = $collection->tap(sub {...});"
NSQ_SOURCE_LINE 00001721 ""
NSQ_SOURCE_LINE 00001722 "Equivalent to L<Mojo::Base/\"tap\">."
NSQ_SOURCE_LINE 00001723 ""
NSQ_SOURCE_LINE 00001724 "=head2 to_array"
NSQ_SOURCE_LINE 00001725 ""
NSQ_SOURCE_LINE 00001726 "  my $array = $collection->to_array;"
NSQ_SOURCE_LINE 00001727 ""
NSQ_SOURCE_LINE 00001728 "Turn collection into array reference."
NSQ_SOURCE_LINE 00001729 ""
NSQ_SOURCE_LINE 00001730 "=head2 uniq"
NSQ_SOURCE_LINE 00001731 ""
NSQ_SOURCE_LINE 00001732 "  my $new = $collection->uniq;"
NSQ_SOURCE_LINE 00001733 "  my $new = $collection->uniq(sub {...});"
NSQ_SOURCE_LINE 00001734 "  my $new = $collection->uniq($method);"
NSQ_SOURCE_LINE 00001735 "  my $new = $collection->uniq($method, @args);"
NSQ_SOURCE_LINE 00001736 ""
NSQ_SOURCE_LINE 00001737 "Create a new L<collection|/\"COLLECTION METHODS\"> without duplicate elements,"
NSQ_SOURCE_LINE 00001738 "using the string representation of either the elements or the return value of"
NSQ_SOURCE_LINE 00001739 "the callback/method to decide uniqueness. Note that C<undef> and empty string"
NSQ_SOURCE_LINE 00001740 "are treated the same."
NSQ_SOURCE_LINE 00001741 ""
NSQ_SOURCE_LINE 00001742 "  # Longer version"
NSQ_SOURCE_LINE 00001743 "  my $new = $collection->uniq(sub { $_->$method(@args) });"
NSQ_SOURCE_LINE 00001744 ""
NSQ_SOURCE_LINE 00001745 "  # $collection contains ('foo', 'bar', 'bar', 'baz')"
NSQ_SOURCE_LINE 00001746 "  $collection->uniq->join(' '); # \"foo bar baz\""
NSQ_SOURCE_LINE 00001747 ""
NSQ_SOURCE_LINE 00001748 "  # $collection contains ([1, 2], [2, 1], [3, 2])"
NSQ_SOURCE_LINE 00001749 "  $collection->uniq(sub{ $_->[1] })->to_array; # \"[[1, 2], [2, 1]]\""
NSQ_SOURCE_LINE 00001750 ""
NSQ_SOURCE_LINE 00001751 "=head2 with_roles"
NSQ_SOURCE_LINE 00001752 ""
NSQ_SOURCE_LINE 00001753 "  $collection = $collection->with_roles('Mojo::Collection::Role::One');"
NSQ_SOURCE_LINE 00001754 ""
NSQ_SOURCE_LINE 00001755 "Equivalent to L<Mojo::Base/\"with_roles\">. Note that role support depends on"
NSQ_SOURCE_LINE 00001756 "L<Role::Tiny> (2.000001+)."
NSQ_SOURCE_LINE 00001757 ""
NSQ_SOURCE_LINE 00001758 "=head1 DEBUGGING"
NSQ_SOURCE_LINE 00001759 ""
NSQ_SOURCE_LINE 00001760 "You can set the C<MOJO_DOM58_CSS_DEBUG> environment variable to get some advanced diagnostics information printed to"
NSQ_SOURCE_LINE 00001761 "C<STDERR>."
NSQ_SOURCE_LINE 00001762 ""
NSQ_SOURCE_LINE 00001763 "  MOJO_DOM58_CSS_DEBUG=1"
NSQ_SOURCE_LINE 00001764 ""
NSQ_SOURCE_LINE 00001765 "=head1 BUGS"
NSQ_SOURCE_LINE 00001766 ""
NSQ_SOURCE_LINE 00001767 "Report issues related to the format of this distribution or Perl 5.8 support to"
