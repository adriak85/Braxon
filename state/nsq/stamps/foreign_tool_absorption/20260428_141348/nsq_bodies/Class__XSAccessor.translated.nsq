BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Class::XSAccessor;"
NSQ_SOURCE_LINE 00000002 "use 5.008;"
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 "use Carp qw/croak/;"
NSQ_SOURCE_LINE 00000006 "use Class::XSAccessor::Heavy;"
NSQ_SOURCE_LINE 00000007 "use XSLoader;"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "our $VERSION = '1.19';"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "XSLoader::load('Class::XSAccessor', $VERSION);"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "sub _make_hash {"
NSQ_SOURCE_LINE 00000014 "  my $ref = shift;"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "  if (ref ($ref)) {"
NSQ_SOURCE_LINE 00000017 "    if (ref($ref) eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000018 "      $ref = { map { $_ => $_ } @$ref }"
NSQ_SOURCE_LINE 00000019 "    } "
NSQ_SOURCE_LINE 00000020 "  } else {"
NSQ_SOURCE_LINE 00000021 "    $ref = { $ref, $ref };"
NSQ_SOURCE_LINE 00000022 "  }"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "  return $ref;"
NSQ_SOURCE_LINE 00000025 "}"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "sub import {"
NSQ_SOURCE_LINE 00000028 "  my $own_class = shift;"
NSQ_SOURCE_LINE 00000029 "  my ($caller_pkg) = caller();"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "  # Support both { getters => ... } and plain getters => ..."
NSQ_SOURCE_LINE 00000032 "  my %opts = ref($_[0]) eq 'HASH' ? %{$_[0]} : @_;"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "  $caller_pkg = $opts{class} if defined $opts{class};"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "  # TODO: Refactor. Move more duplicated code to ::Heavy"
NSQ_SOURCE_LINE 00000037 "  my $read_subs      = _make_hash($opts{getters} || {});"
NSQ_SOURCE_LINE 00000038 "  my $set_subs       = _make_hash($opts{setters} || {});"
NSQ_SOURCE_LINE 00000039 "  my $acc_subs       = _make_hash($opts{accessors} || {});"
NSQ_SOURCE_LINE 00000040 "  my $lvacc_subs     = _make_hash($opts{lvalue_accessors} || {});"
NSQ_SOURCE_LINE 00000041 "  my $pred_subs      = _make_hash($opts{predicates} || {});"
NSQ_SOURCE_LINE 00000042 "  my $ex_pred_subs   = _make_hash($opts{exists_predicates} || {});"
NSQ_SOURCE_LINE 00000043 "  my $def_pred_subs  = _make_hash($opts{defined_predicates} || {});"
NSQ_SOURCE_LINE 00000044 "  my $test_subs      = _make_hash($opts{__tests__} || {});"
NSQ_SOURCE_LINE 00000045 "  my $construct_subs = $opts{constructors} || [defined($opts{constructor}) ? $opts{constructor} : ()];"
NSQ_SOURCE_LINE 00000046 "  my $true_subs      = $opts{true} || [];"
NSQ_SOURCE_LINE 00000047 "  my $false_subs     = $opts{false} || [];"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "  foreach my $subtype ( [\"getter\", $read_subs],"
NSQ_SOURCE_LINE 00000050 "                        [\"setter\", $set_subs],"
NSQ_SOURCE_LINE 00000051 "                        [\"accessor\", $acc_subs],"
NSQ_SOURCE_LINE 00000052 "                        [\"lvalue_accessor\", $lvacc_subs],"
NSQ_SOURCE_LINE 00000053 "                        [\"test\", $test_subs],"
NSQ_SOURCE_LINE 00000054 "                        [\"ex_predicate\", $ex_pred_subs],"
NSQ_SOURCE_LINE 00000055 "                        [\"def_predicate\", $def_pred_subs],"
NSQ_SOURCE_LINE 00000056 "                        [\"def_predicate\", $pred_subs] )"
NSQ_SOURCE_LINE 00000057 "  {"
NSQ_SOURCE_LINE 00000058 "    my $subs = $subtype->[1];"
NSQ_SOURCE_LINE 00000059 "    foreach my $subname (keys %$subs) {"
NSQ_SOURCE_LINE 00000060 "      my $hashkey = $subs->{$subname};"
NSQ_SOURCE_LINE 00000061 "      _generate_method($caller_pkg, $subname, $hashkey, \\%opts, $subtype->[0]);"
NSQ_SOURCE_LINE 00000062 "    }"
NSQ_SOURCE_LINE 00000063 "  }"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "  foreach my $subtype ( [\"constructor\", $construct_subs],"
NSQ_SOURCE_LINE 00000066 "                        [\"true\", $true_subs],"
NSQ_SOURCE_LINE 00000067 "                        [\"false\", $false_subs] )"
NSQ_SOURCE_LINE 00000068 "  {"
NSQ_SOURCE_LINE 00000069 "    foreach my $subname (@{$subtype->[1]}) {"
NSQ_SOURCE_LINE 00000070 "      _generate_method($caller_pkg, $subname, \"\", \\%opts, $subtype->[0]);"
NSQ_SOURCE_LINE 00000071 "    }"
NSQ_SOURCE_LINE 00000072 "  }"
NSQ_SOURCE_LINE 00000073 "}"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "sub _generate_method {"
NSQ_SOURCE_LINE 00000076 "  my ($caller_pkg, $subname, $hashkey, $opts, $type) = @_;"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "  croak(\"Cannot use undef as a hash key for generating an XS $type accessor. (Sub: $subname)\")"
NSQ_SOURCE_LINE 00000079 "    if not defined $hashkey;"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "  $subname = \"${caller_pkg}::$subname\" if $subname !~ /::/;"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "  Class::XSAccessor::Heavy::check_sub_existence($subname) if not $opts->{replace};"
NSQ_SOURCE_LINE 00000084 "  no warnings 'redefine'; # don't warn about an explicitly requested redefine"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "  if ($type eq 'getter') {"
NSQ_SOURCE_LINE 00000087 "    newxs_getter($subname, $hashkey);"
NSQ_SOURCE_LINE 00000088 "  }"
NSQ_SOURCE_LINE 00000089 "  elsif ($type eq 'lvalue_accessor') {"
NSQ_SOURCE_LINE 00000090 "    newxs_lvalue_accessor($subname, $hashkey);"
NSQ_SOURCE_LINE 00000091 "  }"
NSQ_SOURCE_LINE 00000092 "  elsif ($type eq 'setter') {"
NSQ_SOURCE_LINE 00000093 "    newxs_setter($subname, $hashkey, $opts->{chained}||0);"
NSQ_SOURCE_LINE 00000094 "  }"
NSQ_SOURCE_LINE 00000095 "  elsif ($type eq 'def_predicate') {"
NSQ_SOURCE_LINE 00000096 "    newxs_defined_predicate($subname, $hashkey);"
NSQ_SOURCE_LINE 00000097 "  }"
NSQ_SOURCE_LINE 00000098 "  elsif ($type eq 'ex_predicate') {"
NSQ_SOURCE_LINE 00000099 "    newxs_exists_predicate($subname, $hashkey);"
NSQ_SOURCE_LINE 00000100 "  }"
NSQ_SOURCE_LINE 00000101 "  elsif ($type eq 'constructor') {"
NSQ_SOURCE_LINE 00000102 "    newxs_constructor($subname);"
NSQ_SOURCE_LINE 00000103 "  }"
NSQ_SOURCE_LINE 00000104 "  elsif ($type eq 'true') {"
NSQ_SOURCE_LINE 00000105 "    newxs_boolean($subname, 1);"
NSQ_SOURCE_LINE 00000106 "  }"
NSQ_SOURCE_LINE 00000107 "  elsif ($type eq 'false') {"
NSQ_SOURCE_LINE 00000108 "    newxs_boolean($subname, 0);"
NSQ_SOURCE_LINE 00000109 "  }"
NSQ_SOURCE_LINE 00000110 "  elsif ($type eq 'test') {"
NSQ_SOURCE_LINE 00000111 "    newxs_test($subname, $hashkey);"
NSQ_SOURCE_LINE 00000112 "  }"
NSQ_SOURCE_LINE 00000113 "  else {"
NSQ_SOURCE_LINE 00000114 "    newxs_accessor($subname, $hashkey, $opts->{chained}||0);"
NSQ_SOURCE_LINE 00000115 "  }"
NSQ_SOURCE_LINE 00000116 "}"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "1;"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "__END__"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "=head1 NAME"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "Class::XSAccessor - Generate fast XS accessors without runtime compilation"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "  package MyClass;"
NSQ_SOURCE_LINE 00000129 "  use Class::XSAccessor"
NSQ_SOURCE_LINE 00000130 "    replace     => 1,   # Replace existing methods (if any)"
NSQ_SOURCE_LINE 00000131 "    constructor => 'new',"
NSQ_SOURCE_LINE 00000132 "    getters     => {"
NSQ_SOURCE_LINE 00000133 "      get_foo => 'foo', # 'foo' is the hash key to access"
NSQ_SOURCE_LINE 00000134 "      get_bar => 'bar',"
NSQ_SOURCE_LINE 00000135 "    },"
NSQ_SOURCE_LINE 00000136 "    setters => {"
NSQ_SOURCE_LINE 00000137 "      set_foo => 'foo',"
NSQ_SOURCE_LINE 00000138 "      set_bar => 'bar',"
NSQ_SOURCE_LINE 00000139 "    },"
NSQ_SOURCE_LINE 00000140 "    accessors => {"
NSQ_SOURCE_LINE 00000141 "      foo => 'foo',"
NSQ_SOURCE_LINE 00000142 "      bar => 'bar',"
NSQ_SOURCE_LINE 00000143 "    },"
NSQ_SOURCE_LINE 00000144 "    # \"predicates\" is an alias for \"defined_predicates\""
NSQ_SOURCE_LINE 00000145 "    defined_predicates => {"
NSQ_SOURCE_LINE 00000146 "      defined_foo => 'foo',"
NSQ_SOURCE_LINE 00000147 "      defined_bar => 'bar',"
NSQ_SOURCE_LINE 00000148 "    },"
NSQ_SOURCE_LINE 00000149 "    exists_predicates => {"
NSQ_SOURCE_LINE 00000150 "      has_foo => 'foo',"
NSQ_SOURCE_LINE 00000151 "      has_bar => 'bar',"
NSQ_SOURCE_LINE 00000152 "    },"
NSQ_SOURCE_LINE 00000153 "    lvalue_accessors => { # see below"
NSQ_SOURCE_LINE 00000154 "      baz => 'baz', # ..."
NSQ_SOURCE_LINE 00000155 "    },"
NSQ_SOURCE_LINE 00000156 "    true  => [ 'is_token', 'is_whitespace' ],"
NSQ_SOURCE_LINE 00000157 "    false => [ 'significant' ];"
NSQ_SOURCE_LINE 00000158 "  "
NSQ_SOURCE_LINE 00000159 "  # The imported methods are implemented in fast XS."
NSQ_SOURCE_LINE 00000160 "  "
NSQ_SOURCE_LINE 00000161 "  # normal class code here."
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "As of version 1.05, some alternative syntax forms are available:"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "  package MyClass;"
NSQ_SOURCE_LINE 00000166 "  "
NSQ_SOURCE_LINE 00000167 "  # Options can be passed as a HASH reference, if preferred,"
NSQ_SOURCE_LINE 00000168 "  # which can also help Perl::Tidy to format the statement correctly."
NSQ_SOURCE_LINE 00000169 "  use Class::XSAccessor {"
NSQ_SOURCE_LINE 00000170 "     # If the name => key values are always identical,"
NSQ_SOURCE_LINE 00000171 "     # the following shorthand can be used."
NSQ_SOURCE_LINE 00000172 "     accessors => [ 'foo', 'bar' ],"
NSQ_SOURCE_LINE 00000173 "  };"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "Class::XSAccessor implements fast read, write and read/write accessors in XS."
NSQ_SOURCE_LINE 00000178 "Additionally, it can provide predicates such as C<has_foo()> for testing"
NSQ_SOURCE_LINE 00000179 "whether the attribute C<foo> exists in the object (which is different from"
NSQ_SOURCE_LINE 00000180 "\"is defined within the object\")."
NSQ_SOURCE_LINE 00000181 "It only works with objects that are implemented as ordinary hashes."
NSQ_SOURCE_LINE 00000182 "L<Class::XSAccessor::Array> implements the same interface for objects"
NSQ_SOURCE_LINE 00000183 "that use arrays for their internal representation."
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "Since version 0.10, the module can also generate simple constructors"
NSQ_SOURCE_LINE 00000186 "(implemented in XS). Simply supply the"
NSQ_SOURCE_LINE 00000187 "C<constructor =E<gt> 'constructor_name'> option or the"
NSQ_SOURCE_LINE 00000188 "C<constructors =E<gt> ['new', 'create', 'spawn']> option."
NSQ_SOURCE_LINE 00000189 "These constructors do the equivalent of the following Perl code:"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "  sub new {"
NSQ_SOURCE_LINE 00000192 "    my $class = shift;"
NSQ_SOURCE_LINE 00000193 "    return bless { @_ }, ref($class)||$class;"
NSQ_SOURCE_LINE 00000194 "  }"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "That means they can be called on objects and classes but will not"
NSQ_SOURCE_LINE 00000197 "clone objects entirely. Parameters to C<new()> are added to the"
NSQ_SOURCE_LINE 00000198 "object."
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "The XS accessor methods are between 3 and 4 times faster than typical"
NSQ_SOURCE_LINE 00000201 "pure-Perl accessors in some simple benchmarking."
NSQ_SOURCE_LINE 00000202 "The lower factor applies to the potentially slightly obscure"
NSQ_SOURCE_LINE 00000203 "C<sub set_foo_pp {$_[0]-E<gt>{foo} = $_[1]}>, so if you usually"
NSQ_SOURCE_LINE 00000204 "write clear code, a factor of 3.5 speed-up is a good estimate."
NSQ_SOURCE_LINE 00000205 "If in doubt, do your own benchmarking!"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "The method names may be fully qualified. The example in the synopsis could"
NSQ_SOURCE_LINE 00000208 "have been written as C<MyClass::get_foo> instead"
NSQ_SOURCE_LINE 00000209 "of C<get_foo>. This way, methods can be installed in classes other"
NSQ_SOURCE_LINE 00000210 "than the current class. See also: the C<class> option below."
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "By default, the setters return the new value that was set,"
NSQ_SOURCE_LINE 00000213 "and the accessors (mutators) do the same. This behaviour can be changed"
NSQ_SOURCE_LINE 00000214 "with the C<chained> option - see below. The predicates return a boolean."
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "Since version 1.01, C<Class::XSAccessor> can generate extremely simple methods which"
NSQ_SOURCE_LINE 00000217 "just return true or false (and always do so). If that seems like a"
NSQ_SOURCE_LINE 00000218 "really superfluous thing to you, then consider a large class hierarchy"
NSQ_SOURCE_LINE 00000219 "with interfaces such as L<PPI>. These methods are provided by the C<true>"
NSQ_SOURCE_LINE 00000220 "and C<false> options - see the synopsis."
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "C<defined_predicates> check whether a given object attribute is defined."
NSQ_SOURCE_LINE 00000223 "C<predicates> is an alias for C<defined_predicates> for compatibility with"
NSQ_SOURCE_LINE 00000224 "older versions of C<Class::XSAccessor>. C<exists_predicates> checks"
NSQ_SOURCE_LINE 00000225 "whether the given attribute exists in the object using C<exists>."
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "=head1 OPTIONS"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "In addition to specifying the types and names of accessors, additional options"
NSQ_SOURCE_LINE 00000230 "can be supplied which modify behaviour. The options are specified as key/value pairs"
NSQ_SOURCE_LINE 00000231 "in the same manner as the accessor declaration. For example:"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "  use Class::XSAccessor"
NSQ_SOURCE_LINE 00000234 "    getters => {"
NSQ_SOURCE_LINE 00000235 "      get_foo => 'foo',"
NSQ_SOURCE_LINE 00000236 "    },"
NSQ_SOURCE_LINE 00000237 "    replace => 1;"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "The list of available options is:"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "=head2 replace"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "Set this to a true value to prevent C<Class::XSAccessor> from"
NSQ_SOURCE_LINE 00000244 "complaining about replacing existing subroutines."
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "=head2 chained"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "Set this to a true value to change the return value of setters"
NSQ_SOURCE_LINE 00000249 "and mutators (when called with an argument)."
NSQ_SOURCE_LINE 00000250 "If C<chained> is enabled, the setters and accessors/mutators will"
NSQ_SOURCE_LINE 00000251 "return the object. Mutators called without an argument still"
NSQ_SOURCE_LINE 00000252 "return the value of the associated attribute."
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "As with the other options, C<chained> affects all methods generated"
NSQ_SOURCE_LINE 00000255 "in the same C<use Class::XSAccessor ...> statement."
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "=head2 class"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "By default, the accessors are generated in the calling class. The"
NSQ_SOURCE_LINE 00000260 "the C<class> option allows the target class to be specified."
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "=head1 LVALUES"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "Support for lvalue accessors via the keyword C<lvalue_accessors>"
NSQ_SOURCE_LINE 00000265 "was added in version 1.08. At this point, B<THEY ARE CONSIDERED HIGHLY"
NSQ_SOURCE_LINE 00000266 "EXPERIMENTAL>. Furthermore, their performance hasn't been benchmarked"
NSQ_SOURCE_LINE 00000267 "yet."
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "The following example demonstrates an lvalue accessor:"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "  package Address;"
NSQ_SOURCE_LINE 00000272 "  use Class::XSAccessor"
NSQ_SOURCE_LINE 00000273 "    constructor => 'new',"
NSQ_SOURCE_LINE 00000274 "    lvalue_accessors => { zip_code => 'zip' };"
NSQ_SOURCE_LINE 00000275 "  "
NSQ_SOURCE_LINE 00000276 "  package main;"
NSQ_SOURCE_LINE 00000277 "  my $address = Address->new(zip => 2);"
NSQ_SOURCE_LINE 00000278 "  print $address->zip_code, \"\\n\"; # prints 2"
NSQ_SOURCE_LINE 00000279 "  $address->zip_code = 76135; # <--- This is it!"
NSQ_SOURCE_LINE 00000280 "  print $address->zip_code, \"\\n\"; # prints 76135"
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "=head1 CAVEATS"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "Probably won't work for objects based on I<tied> hashes. But that's a strange thing to do anyway."
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "Scary code exploiting strange XS features."
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "If you think writing an accessor in XS should be a laughably simple exercise, then"
NSQ_SOURCE_LINE 00000289 "please contemplate how you could instantiate a new XS accessor for a new hash key"
NSQ_SOURCE_LINE 00000290 "that's only known at run-time. Note that compiling C code at run-time a la L<Inline::C|Inline::C>"
NSQ_SOURCE_LINE 00000291 "is a no go."
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "Threading. With version 1.00, a memory leak has been B<fixed>. Previously, a small amount of"
NSQ_SOURCE_LINE 00000294 "memory would leak if C<Class::XSAccessor>-based classes were loaded in a subthread without having"
NSQ_SOURCE_LINE 00000295 "been loaded in the \"main\" thread. If the subthread then terminated, a hash key and an int per"
NSQ_SOURCE_LINE 00000296 "associated method used to be lost. Note that this mattered only if classes were B<only> loaded"
NSQ_SOURCE_LINE 00000297 "in a sort of throw-away thread."
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "In the new implementation, as of 1.00, the memory will still not be released, in the same situation,"
NSQ_SOURCE_LINE 00000300 "but it will be recycled when the same class, or a similar class, is loaded again in B<any> thread."
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "=over"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "=item * L<Class::XSAccessor::Array>"
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "=item * L<AutoXS>"
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "=back"
