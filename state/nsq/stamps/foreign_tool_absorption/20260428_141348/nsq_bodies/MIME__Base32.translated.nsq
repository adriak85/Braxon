NSQ_SOURCE_LINE 00000001 "package MIME::Base32;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.008001;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "require Exporter;"
NSQ_SOURCE_LINE 00000008 "our @ISA       = qw(Exporter);"
NSQ_SOURCE_LINE 00000009 "our @EXPORT    = qw(encode_base32 decode_base32);"
NSQ_SOURCE_LINE 00000010 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000011 "    encode_rfc3548 decode_rfc3548 encode_09AV decode_09AV"
NSQ_SOURCE_LINE 00000012 "    encode_base32hex decode_base32hex"
NSQ_SOURCE_LINE 00000013 ");"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "our $VERSION = \"1.303\";"
NSQ_SOURCE_LINE 00000016 "$VERSION = eval $VERSION;"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "sub encode         { return encode_base32(@_) }"
NSQ_SOURCE_LINE 00000019 "sub encode_rfc3548 { return encode_base32(@_) }"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "sub encode_base32 {"
NSQ_SOURCE_LINE 00000022 "    my $arg = shift;"
NSQ_SOURCE_LINE 00000023 "    return '' unless defined($arg);    # mimic MIME::Base64"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "    $arg = unpack('B*', $arg);"
NSQ_SOURCE_LINE 00000026 "    $arg =~ s/(.....)/000$1/g;"
NSQ_SOURCE_LINE 00000027 "    my $l = length($arg);"
NSQ_SOURCE_LINE 00000028 "    if ($l & 7) {"
NSQ_SOURCE_LINE 00000029 "        my $e = substr($arg, $l & ~7);"
NSQ_SOURCE_LINE 00000030 "        $arg = substr($arg, 0, $l & ~7);"
NSQ_SOURCE_LINE 00000031 "        $arg .= \"000$e\" . '0' x (5 - length $e);"
NSQ_SOURCE_LINE 00000032 "    }"
NSQ_SOURCE_LINE 00000033 "    $arg = pack('B*', $arg);"
NSQ_SOURCE_LINE 00000034 "    $arg =~ tr|\\0-\\37|A-Z2-7|;"
NSQ_SOURCE_LINE 00000035 "    return $arg;"
NSQ_SOURCE_LINE 00000036 "}"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "sub decode         { return decode_base32(@_) }"
NSQ_SOURCE_LINE 00000039 "sub decode_rfc3548 { return decode_base32(@_) }"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "sub decode_base32 {"
NSQ_SOURCE_LINE 00000042 "    my $arg = uc(shift || '');    # mimic MIME::Base64"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "    $arg =~ tr|A-Z2-7|\\0-\\37|;"
NSQ_SOURCE_LINE 00000045 "    $arg = unpack('B*', $arg);"
NSQ_SOURCE_LINE 00000046 "    $arg =~ s/000(.....)/$1/g;"
NSQ_SOURCE_LINE 00000047 "    my $l = length $arg;"
NSQ_SOURCE_LINE 00000048 "    $arg = substr($arg, 0, $l & ~7) if $l & 7;"
NSQ_SOURCE_LINE 00000049 "    $arg = pack('B*', $arg);"
NSQ_SOURCE_LINE 00000050 "    return $arg;"
NSQ_SOURCE_LINE 00000051 "}"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "sub encode_09AV { return encode_base32hex(@_) }"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "sub encode_base32hex {"
NSQ_SOURCE_LINE 00000056 "    my $arg = shift;"
NSQ_SOURCE_LINE 00000057 "    return '' unless defined($arg);    # mimic MIME::Base64"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "    $arg = unpack('B*', $arg);"
NSQ_SOURCE_LINE 00000060 "    $arg =~ s/(.....)/000$1/g;"
NSQ_SOURCE_LINE 00000061 "    my $l = length($arg);"
NSQ_SOURCE_LINE 00000062 "    if ($l & 7) {"
NSQ_SOURCE_LINE 00000063 "        my $e = substr($arg, $l & ~7);"
NSQ_SOURCE_LINE 00000064 "        $arg = substr($arg, 0, $l & ~7);"
NSQ_SOURCE_LINE 00000065 "        $arg .= \"000$e\" . '0' x (5 - length $e);"
NSQ_SOURCE_LINE 00000066 "    }"
NSQ_SOURCE_LINE 00000067 "    $arg = pack('B*', $arg);"
NSQ_SOURCE_LINE 00000068 "    $arg =~ tr|\\0-\\37|0-9A-V|;"
NSQ_SOURCE_LINE 00000069 "    return $arg;"
NSQ_SOURCE_LINE 00000070 "}"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "sub decode_09AV { return decode_base32hex(@_) }"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "sub decode_base32hex {"
NSQ_SOURCE_LINE 00000075 "    my $arg = uc(shift || '');    # mimic MIME::Base64"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "    $arg =~ tr|0-9A-V|\\0-\\37|;"
NSQ_SOURCE_LINE 00000078 "    $arg = unpack('B*', $arg);"
NSQ_SOURCE_LINE 00000079 "    $arg =~ s/000(.....)/$1/g;"
NSQ_SOURCE_LINE 00000080 "    my $l = length($arg);"
NSQ_SOURCE_LINE 00000081 "    $arg = substr($arg, 0, $l & ~7) if $l & 7;"
NSQ_SOURCE_LINE 00000082 "    $arg = pack('B*', $arg);"
NSQ_SOURCE_LINE 00000083 "    return $arg;"
NSQ_SOURCE_LINE 00000084 "}"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "1;"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "=encoding utf8"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "=head1 NAME"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "MIME::Base32 - Base32 encoder and decoder"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "    #!/usr/bin/env perl"
NSQ_SOURCE_LINE 00000097 "    use strict;"
NSQ_SOURCE_LINE 00000098 "    use warnings;"
NSQ_SOURCE_LINE 00000099 "    use MIME::Base32;"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "    my $encoded = encode_base32('Aladdin: open sesame');"
NSQ_SOURCE_LINE 00000102 "    my $decoded = decode_base32($encoded);"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "This module is for encoding/decoding data much the way that L<MIME::Base64> does."
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "Prior to version 1.0, L<MIME::Base32> used the C<base32hex> (or C<[0-9A-V]>) encoding and"
NSQ_SOURCE_LINE 00000109 "decoding methods by default. If you need to maintain that behavior, please call"
NSQ_SOURCE_LINE 00000110 "C<encode_base32hex> or C<decode_base32hex> functions directly."
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "Now, in accordance with L<RFC-3548, Section 5|https://tools.ietf.org/html/rfc3548#section-5>,"
NSQ_SOURCE_LINE 00000113 "L<MIME::Base32> uses the C<encode_base32> and C<decode_base32> functions by default."
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "The following primary functions are provided:"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "=head2 decode"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "Synonym for C<decode_base32>"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "=head2 decode_rfc3548"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "Synonym for C<decode_base32>"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "=head2 decode_base32"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "    my $string = decode_base32($encoded_data);"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "Decode some encoded data back into a string of text or binary data."
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "=head2 decode_09AV"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "Synonym for C<decode_base32hex>"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "=head2 decode_base32hex"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "    my $string_or_binary_data = MIME::Base32::decode_base32hex($encoded_data);"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "Decode some encoded data back into a string of text or binary data."
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "=head2 encode"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "Synonym for C<encode_base32>"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "=head2 encode_rfc3548"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "Synonym for C<encode_base32>"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "=head2 encode_base32"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "    my $encoded = encode_base32(\"some string\");"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "Encode a string of text or binary data."
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "=head2 encode_09AV"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "Synonym for C<encode_base32hex>"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "=head2 encode_base32hex"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "    my $encoded = MIME::Base32::encode_base32hex(\"some string\");"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "Encode a string of text or binary data. This uses the C<hex> (or C<[0-9A-V]>) method."
NSQ_SOURCE_LINE 00000166 ""
