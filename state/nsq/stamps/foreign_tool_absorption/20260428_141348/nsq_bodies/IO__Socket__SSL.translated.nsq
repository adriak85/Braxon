NSQ_SOURCE_LINE 00000444 "}"
NSQ_SOURCE_LINE 00000445 ""
NSQ_SOURCE_LINE 00000446 "my $OPENSSL_LIST_SEPARATOR = $^O =~m{^(?:(dos|os2|mswin32|netware)|vms)$}i"
NSQ_SOURCE_LINE 00000447 "    ? $1 ? ';' : ',' : ':';"
NSQ_SOURCE_LINE 00000448 "my $CHECK_SSL_PATH = sub {"
NSQ_SOURCE_LINE 00000449 "    my %args = (@_ == 1) ? ('',@_) : @_;"
NSQ_SOURCE_LINE 00000450 "    for my $type (keys %args) {"
NSQ_SOURCE_LINE 00000451 "\tmy $path = $args{$type};"
NSQ_SOURCE_LINE 00000452 "\tif (!$type) {"
NSQ_SOURCE_LINE 00000453 "\t    delete $args{$type};"
NSQ_SOURCE_LINE 00000454 "\t    $type = (ref($path) || -d $path) ? 'SSL_ca_path' : 'SSL_ca_file';"
NSQ_SOURCE_LINE 00000455 "\t    $args{$type} = $path;"
NSQ_SOURCE_LINE 00000456 "\t}"
NSQ_SOURCE_LINE 00000457 ""
NSQ_SOURCE_LINE 00000458 "\tnext if ref($path) eq 'SCALAR' && ! $$path;"
NSQ_SOURCE_LINE 00000459 "\tif ($type eq 'SSL_ca_file') {"
NSQ_SOURCE_LINE 00000460 "\t    die \"SSL_ca_file $path can't be used: $!\""
NSQ_SOURCE_LINE 00000461 "\t\tif ! open(my $fh,'<',$path);"
NSQ_SOURCE_LINE 00000462 "\t} elsif ($type eq 'SSL_ca_path') {"
NSQ_SOURCE_LINE 00000463 "\t    $path = [ split($OPENSSL_LIST_SEPARATOR,$path) ] if !ref($path);"
NSQ_SOURCE_LINE 00000464 "\t    my @err;"
NSQ_SOURCE_LINE 00000465 "\t    for my $d (ref($path) ? @$path : $path) {"
NSQ_SOURCE_LINE 00000466 "\t\tif (! -d $d) {"
NSQ_SOURCE_LINE 00000467 "\t\t    push @err, \"SSL_ca_path $d does not exist\";"
NSQ_SOURCE_LINE 00000468 "\t\t} elsif (! opendir(my $dh,$d)) {"
NSQ_SOURCE_LINE 00000469 "\t\t    push @err, \"SSL_ca_path $d is not accessible: $!\""
NSQ_SOURCE_LINE 00000470 "\t\t} else {"
NSQ_SOURCE_LINE 00000471 "\t\t    @err = ();"
NSQ_SOURCE_LINE 00000472 "\t\t    last"
NSQ_SOURCE_LINE 00000473 "\t\t}"
NSQ_SOURCE_LINE 00000474 "\t    }"
NSQ_SOURCE_LINE 00000475 "\t    die \"@err\" if @err;"
NSQ_SOURCE_LINE 00000476 "\t}"
NSQ_SOURCE_LINE 00000477 "    }"
NSQ_SOURCE_LINE 00000478 "    return %args;"
NSQ_SOURCE_LINE 00000479 "};"
NSQ_SOURCE_LINE 00000480 ""
NSQ_SOURCE_LINE 00000481 ""
NSQ_SOURCE_LINE 00000482 "{"
NSQ_SOURCE_LINE 00000483 "    my %default_ca;"
NSQ_SOURCE_LINE 00000484 "    my $ca_detected; # 0: never detect, undef: need to (re)detect"
NSQ_SOURCE_LINE 00000485 "    my $openssldir;"
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "    sub default_ca {"
NSQ_SOURCE_LINE 00000488 "\tif (@_) {"
NSQ_SOURCE_LINE 00000489 "\t    # user defined default CA or reset"
NSQ_SOURCE_LINE 00000490 "\t    if ( @_ > 1 ) {"
NSQ_SOURCE_LINE 00000491 "\t\t%default_ca = @_;"
NSQ_SOURCE_LINE 00000492 "\t\t$ca_detected  = 0;"
NSQ_SOURCE_LINE 00000493 "\t    } elsif ( my $path = shift ) {"
NSQ_SOURCE_LINE 00000494 "\t\t%default_ca = $CHECK_SSL_PATH->($path);"
NSQ_SOURCE_LINE 00000495 "\t\t$ca_detected  = 0;"
NSQ_SOURCE_LINE 00000496 "\t    } else {"
NSQ_SOURCE_LINE 00000497 "\t\t$ca_detected = undef;"
NSQ_SOURCE_LINE 00000498 "\t    }"
NSQ_SOURCE_LINE 00000499 "\t}"
NSQ_SOURCE_LINE 00000500 "\treturn %default_ca if defined $ca_detected;"
NSQ_SOURCE_LINE 00000501 ""
NSQ_SOURCE_LINE 00000502 "\t# SSLEAY_DIR was 5 up to OpenSSL 1.1, then switched to 4 and got"
NSQ_SOURCE_LINE 00000503 "\t# renamed to OPENSSL_DIR. Unfortunately it is not exported as constant"
NSQ_SOURCE_LINE 00000504 "\t# by Net::SSLeay so we use the fixed number."
NSQ_SOURCE_LINE 00000505 "\t$openssldir ||="
NSQ_SOURCE_LINE 00000506 "\t    Net::SSLeay::SSLeay_version(5) =~m{^OPENSSLDIR: \"(.+)\"$} ? $1 :"
NSQ_SOURCE_LINE 00000507 "\t    Net::SSLeay::SSLeay_version(4) =~m{^OPENSSLDIR: \"(.+)\"$} ? $1 :"
NSQ_SOURCE_LINE 00000508 "\t    'cannot-determine-openssldir-from-ssleay-version';"
NSQ_SOURCE_LINE 00000509 ""
NSQ_SOURCE_LINE 00000510 "\t# (re)detect according to openssl crypto/cryptlib.h"
NSQ_SOURCE_LINE 00000511 "\tmy $dir = $ENV{SSL_CERT_DIR}"
NSQ_SOURCE_LINE 00000512 "\t    || ( $^O =~m{vms}i ? \"SSLCERTS:\":\"$openssldir/certs\" );"
NSQ_SOURCE_LINE 00000513 "\tif ( opendir(my $dh,$dir)) {"
NSQ_SOURCE_LINE 00000514 "\t    FILES: for my $f (  grep { m{^[a-f\\d]{8}(\\.\\d+)?$} } readdir($dh) ) {"
NSQ_SOURCE_LINE 00000515 "\t\topen( my $fh,'<',\"$dir/$f\") or next;"
NSQ_SOURCE_LINE 00000516 "\t\twhile (my $line = <$fh>) {"
NSQ_SOURCE_LINE 00000517 "\t\t    $line =~m{^-+BEGIN (X509 |TRUSTED |)CERTIFICATE-} or next;"
NSQ_SOURCE_LINE 00000518 "\t\t    $default_ca{SSL_ca_path} = $dir;"
NSQ_SOURCE_LINE 00000519 "\t\t    last FILES;"
NSQ_SOURCE_LINE 00000520 "\t\t}"
NSQ_SOURCE_LINE 00000521 "\t    }"
NSQ_SOURCE_LINE 00000522 "\t}"
NSQ_SOURCE_LINE 00000523 "\tmy $file = $ENV{SSL_CERT_FILE}"
NSQ_SOURCE_LINE 00000524 "\t    || ( $^O =~m{vms}i ? \"SSLCERTS:cert.pem\":\"$openssldir/cert.pem\" );"
NSQ_SOURCE_LINE 00000525 "\tif ( open(my $fh,'<',$file)) {"
NSQ_SOURCE_LINE 00000526 "\t    while (my $line = <$fh>) {"
NSQ_SOURCE_LINE 00000527 "\t\t$line =~m{^-+BEGIN (X509 |TRUSTED |)CERTIFICATE-} or next;"
NSQ_SOURCE_LINE 00000528 "\t\t$default_ca{SSL_ca_file} = $file;"
NSQ_SOURCE_LINE 00000529 "\t\tlast;"
NSQ_SOURCE_LINE 00000530 "\t    }"
NSQ_SOURCE_LINE 00000531 "\t}"
NSQ_SOURCE_LINE 00000532 ""
NSQ_SOURCE_LINE 00000533 "\t$default_ca{SSL_ca_file} = Mozilla::CA::SSL_ca_file() if ! %default_ca && do {"
NSQ_SOURCE_LINE 00000534 "\t\tlocal $SIG{__DIE__};"
NSQ_SOURCE_LINE 00000535 "\t\teval { require Mozilla::CA; 1 };"
NSQ_SOURCE_LINE 00000536 "\t    };"
NSQ_SOURCE_LINE 00000537 ""
NSQ_SOURCE_LINE 00000538 "\t$ca_detected = 1;"
NSQ_SOURCE_LINE 00000539 "\treturn %default_ca;"
NSQ_SOURCE_LINE 00000540 "    }"
NSQ_SOURCE_LINE 00000541 "}"
NSQ_SOURCE_LINE 00000542 ""
NSQ_SOURCE_LINE 00000543 ""
NSQ_SOURCE_LINE 00000544 "# Export some stuff"
NSQ_SOURCE_LINE 00000545 "# inet4|inet6|debug will be handled by myself, everything"
NSQ_SOURCE_LINE 00000546 "# else will be handled the Exporter way"
NSQ_SOURCE_LINE 00000547 "sub import {"
NSQ_SOURCE_LINE 00000548 "    my $class = shift;"
NSQ_SOURCE_LINE 00000549 ""
NSQ_SOURCE_LINE 00000550 "    my @export;"
NSQ_SOURCE_LINE 00000551 "    foreach (@_) {"
NSQ_SOURCE_LINE 00000552 "\tif ( /^inet4$/i ) {"
NSQ_SOURCE_LINE 00000553 "\t    # explicitly fall back to inet4"
NSQ_SOURCE_LINE 00000554 "\t    @ISA = 'IO::Socket::INET';"
NSQ_SOURCE_LINE 00000555 "\t    @caller_force_inet4 = caller(); # save for warnings for 'inet6' case"
NSQ_SOURCE_LINE 00000556 "\t} elsif ( /^inet6$/i ) {"
NSQ_SOURCE_LINE 00000557 "\t    # check if we have already ipv6 as base"
NSQ_SOURCE_LINE 00000558 "\t    if ( ! UNIVERSAL::isa( $class, 'IO::Socket::INET6')"
NSQ_SOURCE_LINE 00000559 "\t\tand ! UNIVERSAL::isa( $class, 'IO::Socket::IP' )) {"
NSQ_SOURCE_LINE 00000560 "\t\t# either we don't support it or we disabled it by explicitly"
NSQ_SOURCE_LINE 00000561 "\t\t# loading it with 'inet4'. In this case re-enable but warn"
NSQ_SOURCE_LINE 00000562 "\t\t# because this is probably an error"
NSQ_SOURCE_LINE 00000563 "\t\tif ( CAN_IPV6 ) {"
NSQ_SOURCE_LINE 00000564 "\t\t    @ISA = ( CAN_IPV6 );"
NSQ_SOURCE_LINE 00000565 "\t\t    warn \"IPv6 support re-enabled in __PACKAGE__, got disabled in file $caller_force_inet4[1] line $caller_force_inet4[2]\";"
NSQ_SOURCE_LINE 00000566 "\t\t} else {"
NSQ_SOURCE_LINE 00000567 "\t\t    die \"INET6 is not supported, install IO::Socket::IP\";"
NSQ_SOURCE_LINE 00000568 "\t\t}"
NSQ_SOURCE_LINE 00000569 "\t    }"
NSQ_SOURCE_LINE 00000570 "\t} elsif ( /^:?debug(\\d+)/ ) {"
NSQ_SOURCE_LINE 00000571 "\t    $DEBUG=$1;"
NSQ_SOURCE_LINE 00000572 "\t} else {"
NSQ_SOURCE_LINE 00000573 "\t    push @export,$_"
NSQ_SOURCE_LINE 00000574 "\t}"
NSQ_SOURCE_LINE 00000575 "    }"
NSQ_SOURCE_LINE 00000576 ""
NSQ_SOURCE_LINE 00000577 "    @_ = ( $class,@export );"
NSQ_SOURCE_LINE 00000578 "    goto &Exporter::import;"
NSQ_SOURCE_LINE 00000579 "}"
