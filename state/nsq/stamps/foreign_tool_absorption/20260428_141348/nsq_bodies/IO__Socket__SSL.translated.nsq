NSQ_SOURCE_LINE 00003837 "\t# hopefully short-time error"
NSQ_SOURCE_LINE 00003838 "\t$self->{cache}->put($_,{"
NSQ_SOURCE_LINE 00003839 "\t    soft_error => \"@soft_error\","
NSQ_SOURCE_LINE 00003840 "\t    expire => time()+10,"
NSQ_SOURCE_LINE 00003841 "\t}) for (@{$todo->{ids}});"
NSQ_SOURCE_LINE 00003842 ""
NSQ_SOURCE_LINE 00003843 "    # does nonce match the request and can the signature be verified"
NSQ_SOURCE_LINE 00003844 "    } elsif ( ! eval {"
NSQ_SOURCE_LINE 00003845 "\t$req = Net::SSLeay::d2i_OCSP_REQUEST($todo->{req});"
NSQ_SOURCE_LINE 00003846 "\tNet::SSLeay::OCSP_response_verify($self->{ssl},$resp,$req);"
NSQ_SOURCE_LINE 00003847 "    }) {"
NSQ_SOURCE_LINE 00003848 "\tif ($@) {"
