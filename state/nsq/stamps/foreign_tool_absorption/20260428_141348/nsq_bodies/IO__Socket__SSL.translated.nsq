NSQ_SOURCE_LINE 00004003 "#"
NSQ_SOURCE_LINE 00004004 "# Major versions"
NSQ_SOURCE_LINE 00004005 "#"
NSQ_SOURCE_LINE 00004006 "$trace_constants{SSL2_VERSION_MAJOR} = $trace_constants{SSL2_VERSION} >> 8;"
NSQ_SOURCE_LINE 00004007 "$trace_constants{SSL3_VERSION_MAJOR} = $trace_constants{SSL3_VERSION} >> 8;"
NSQ_SOURCE_LINE 00004008 ""
NSQ_SOURCE_LINE 00004009 "#"
NSQ_SOURCE_LINE 00004010 "# Mapping between trace constant and version string"
NSQ_SOURCE_LINE 00004011 "#"
NSQ_SOURCE_LINE 00004012 "my %tc_ver2s;"
NSQ_SOURCE_LINE 00004013 "for ("
NSQ_SOURCE_LINE 00004014 "    [ SSL2_VERSION    => \"SSLv2\" ],"
NSQ_SOURCE_LINE 00004015 "    [ SSL2_VERSION    => \"SSLv2\" ],"
NSQ_SOURCE_LINE 00004016 "    [ SSL3_VERSION    => \"SSLv3\" ],"
NSQ_SOURCE_LINE 00004017 "    [ TLS1_VERSION    => \"TLSv1.0\" ],"
NSQ_SOURCE_LINE 00004018 "    [ TLS1_1_VERSION  => \"TLSv1.1\" ],"
NSQ_SOURCE_LINE 00004019 "    [ TLS1_2_VERSION  => \"TLSv1.2\" ],"
NSQ_SOURCE_LINE 00004020 "    [ TLS1_3_VERSION  => \"TLSv1.3\" ],"
NSQ_SOURCE_LINE 00004021 "    [ DTLS1_VERSION   => \"DTLSv1.0\" ],"
NSQ_SOURCE_LINE 00004022 "    [ DTLS1_2_VERSION => \"DTLSv1.2\" ],"
NSQ_SOURCE_LINE 00004023 "    [ DTLS1_BAD_VER   => \"DTLSv1.0 (bad)\" ]"
NSQ_SOURCE_LINE 00004024 ") {"
NSQ_SOURCE_LINE 00004025 "    next if $trace_constants{$_->[0]} == -1;"
NSQ_SOURCE_LINE 00004026 "    $tc_ver2s{$trace_constants{$_->[0]}} = $_->[1];"
NSQ_SOURCE_LINE 00004027 "}"
NSQ_SOURCE_LINE 00004028 ""
NSQ_SOURCE_LINE 00004029 "my %tc_type2s;"
NSQ_SOURCE_LINE 00004030 "for ("
NSQ_SOURCE_LINE 00004031 "    [ SSL3_RT_HEADER             => \"TLS header\" ],"
NSQ_SOURCE_LINE 00004032 "    [ SSL3_RT_CHANGE_CIPHER_SPEC => \"TLS change cipher\" ],"
NSQ_SOURCE_LINE 00004033 "    [ SSL3_RT_ALERT              => \"TLS alert\" ],"
NSQ_SOURCE_LINE 00004034 "    [ SSL3_RT_HANDSHAKE          => \"TLS handshake\" ],"
NSQ_SOURCE_LINE 00004035 "    [ SSL3_RT_APPLICATION_DATA   => \"TLS app data\" ]"
NSQ_SOURCE_LINE 00004036 ") {"
NSQ_SOURCE_LINE 00004037 "    next if $trace_constants{$_->[0]} == -1;"
NSQ_SOURCE_LINE 00004038 "    $tc_type2s{$trace_constants{$_->[0]}} = $_->[1];"
NSQ_SOURCE_LINE 00004039 "}"
NSQ_SOURCE_LINE 00004040 ""
NSQ_SOURCE_LINE 00004041 "my %tc_msgtype2s;"
NSQ_SOURCE_LINE 00004042 "for("
NSQ_SOURCE_LINE 00004043 "    [ SSL2_MT_ERROR               => \"Error\" ],"
NSQ_SOURCE_LINE 00004044 "    [ SSL2_MT_CLIENT_HELLO        => \"Client hello\" ],"
NSQ_SOURCE_LINE 00004045 "    [ SSL2_MT_CLIENT_MASTER_KEY   => \"Client key\" ],"
NSQ_SOURCE_LINE 00004046 "    [ SSL2_MT_CLIENT_FINISHED     => \"Client finished\" ],"
NSQ_SOURCE_LINE 00004047 "    [ SSL2_MT_SERVER_HELLO        => \"Server hello\" ],"
NSQ_SOURCE_LINE 00004048 "    [ SSL2_MT_SERVER_VERIFY       => \"Server verify\" ],"
NSQ_SOURCE_LINE 00004049 "    [ SSL2_MT_SERVER_FINISHED     => \"Server finished\" ],"
NSQ_SOURCE_LINE 00004050 "    [ SSL2_MT_REQUEST_CERTIFICATE => \"Request CERT\" ],"
NSQ_SOURCE_LINE 00004051 "    [ SSL2_MT_REQUEST_CERTIFICATE => \"Client CERT\" ]"
NSQ_SOURCE_LINE 00004052 ") {"
NSQ_SOURCE_LINE 00004053 "    next if $trace_constants{$_->[0]} == -1;"
NSQ_SOURCE_LINE 00004054 "    $tc_msgtype2s{$trace_constants{SSL2_VERSION_MAJOR}, $trace_constants{$_->[0]}} = $_->[1];"
NSQ_SOURCE_LINE 00004055 "}"
NSQ_SOURCE_LINE 00004056 "for("
NSQ_SOURCE_LINE 00004057 "    [ SSL3_MT_HELLO_REQUEST        => \"Hello request\" ],"
NSQ_SOURCE_LINE 00004058 "    [ SSL3_MT_CLIENT_HELLO         => \"Client hello\" ],"
NSQ_SOURCE_LINE 00004059 "    [ SSL3_MT_SERVER_HELLO         => \"Server hello\" ],"
NSQ_SOURCE_LINE 00004060 "    [ SSL3_MT_NEWSESSION_TICKET    => \"Newsession Ticket\" ],"
NSQ_SOURCE_LINE 00004061 "    [ SSL3_MT_CERTIFICATE          => \"Certificate\" ],"
NSQ_SOURCE_LINE 00004062 "    [ SSL3_MT_SERVER_KEY_EXCHANGE  => \"Server key exchange\" ],"
NSQ_SOURCE_LINE 00004063 "    [ SSL3_MT_CLIENT_KEY_EXCHANGE  => \"Client key exchange\" ],"
NSQ_SOURCE_LINE 00004064 "    [ SSL3_MT_CERTIFICATE_REQUEST  => \"Request CERT\" ],"
NSQ_SOURCE_LINE 00004065 "    [ SSL3_MT_SERVER_DONE          => \"Server finished\" ],"
NSQ_SOURCE_LINE 00004066 "    [ SSL3_MT_CERTIFICATE_VERIFY   => \"CERT verify\" ],"
NSQ_SOURCE_LINE 00004067 "    [ SSL3_MT_FINISHED             => \"Finished\" ],"
NSQ_SOURCE_LINE 00004068 "    [ SSL3_MT_CERTIFICATE_STATUS   => \"Certificate Status\" ],"
NSQ_SOURCE_LINE 00004069 "    [ SSL3_MT_ENCRYPTED_EXTENSIONS => \"Encrypted Extensions\" ],"
NSQ_SOURCE_LINE 00004070 "    [ SSL3_MT_SUPPLEMENTAL_DATA    => \"Supplemental data\" ],"
NSQ_SOURCE_LINE 00004071 "    [ SSL3_MT_END_OF_EARLY_DATA    => \"End of early data\" ],"
NSQ_SOURCE_LINE 00004072 "    [ SSL3_MT_KEY_UPDATE           => \"Key update\" ],"
NSQ_SOURCE_LINE 00004073 "    [ SSL3_MT_NEXT_PROTO           => \"Next protocol\" ],"
NSQ_SOURCE_LINE 00004074 "    [ SSL3_MT_MESSAGE_HASH         => \"Message hash\" ]"
NSQ_SOURCE_LINE 00004075 ") {"
NSQ_SOURCE_LINE 00004076 "    next if $trace_constants{$_->[0]} == -1;"
NSQ_SOURCE_LINE 00004077 "    $tc_msgtype2s{$trace_constants{SSL3_VERSION_MAJOR}, $trace_constants{$_->[0]}} = $_->[1];"
NSQ_SOURCE_LINE 00004078 "}"
