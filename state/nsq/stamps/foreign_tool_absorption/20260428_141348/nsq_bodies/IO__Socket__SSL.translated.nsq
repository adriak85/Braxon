NSQ_SOURCE_LINE 00003906 "\t# probably configuration problem"
NSQ_SOURCE_LINE 00003907 "\t$self->{cache}->put($_,{"
NSQ_SOURCE_LINE 00003908 "\t    soft_error => \"@soft_error\","
NSQ_SOURCE_LINE 00003909 "\t    expire => time()+120,"
NSQ_SOURCE_LINE 00003910 "\t}) for (@{$todo->{ids}});"
NSQ_SOURCE_LINE 00003911 "    }"
NSQ_SOURCE_LINE 00003912 ""
NSQ_SOURCE_LINE 00003913 "    Net::SSLeay::OCSP_REQUEST_free($req) if $req;"
