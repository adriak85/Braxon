NSQ_SOURCE_LINE 00003871 "\t\tif (!$rv->[1]) {"
NSQ_SOURCE_LINE 00003872 "\t\t    # no error"
NSQ_SOURCE_LINE 00003873 "\t\t    $self->{cache}->put($rv->[0],$rv->[2]);"
NSQ_SOURCE_LINE 00003874 "\t\t} elsif ( $rv->[2]{statusType} =="
