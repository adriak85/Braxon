NSQ_SOURCE_LINE 00002669 ""
NSQ_SOURCE_LINE 00002670 "    if (my $ctx = $arg_hash->{'SSL_reuse_ctx'}) {"
NSQ_SOURCE_LINE 00002671 "\tif ($ctx->isa('IO::Socket::SSL::SSL_Context')) {"
NSQ_SOURCE_LINE 00002672 "\t    return $ctx if $ctx->{context};"
NSQ_SOURCE_LINE 00002673 "\t} elsif (eval { $ctx = ${*$ctx}{_SSL_ctx} }) {"
