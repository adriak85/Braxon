NSQ_SOURCE_LINE 00003824 "\t# hopefully short-time error"
NSQ_SOURCE_LINE 00003825 "\t$self->{cache}->put($_,{"
NSQ_SOURCE_LINE 00003826 "\t    soft_error => \"@soft_error\","
NSQ_SOURCE_LINE 00003827 "\t    expire => time()+10,"
NSQ_SOURCE_LINE 00003828 "\t}) for (@{$todo->{ids}});"
NSQ_SOURCE_LINE 00003829 "    # is the OCSP response status success"
NSQ_SOURCE_LINE 00003830 "    } elsif ("
NSQ_SOURCE_LINE 00003831 "\t( my $status = Net::SSLeay::OCSP_response_status($resp))"
NSQ_SOURCE_LINE 00003832 "\t    != Net::SSLeay::OCSP_RESPONSE_STATUS_SUCCESSFUL()"
NSQ_SOURCE_LINE 00003833 "    ){"
NSQ_SOURCE_LINE 00003834 "\t@soft_error = \"OCSP response failed: \"."
NSQ_SOURCE_LINE 00003835 "\t    Net::SSLeay::OCSP_response_status_str($status)."
