NSQ_SOURCE_LINE 00003766 "\t    next;"
NSQ_SOURCE_LINE 00003767 "\t};"
NSQ_SOURCE_LINE 00003768 "\tif (!($done = $cache->get($certid))) {"
NSQ_SOURCE_LINE 00003769 "\t    push @{ $todo{$uri}{ids} }, $certid;"
NSQ_SOURCE_LINE 00003770 "\t    push @{ $todo{$uri}{subj} }, $subj;"
NSQ_SOURCE_LINE 00003771 "\t} elsif ( $done->{hard_error} ) {"
NSQ_SOURCE_LINE 00003772 "\t    # one error is enough to fail validation"
NSQ_SOURCE_LINE 00003773 "\t    $hard_error = $done->{hard_error};"
NSQ_SOURCE_LINE 00003774 "\t    %todo = ();"
NSQ_SOURCE_LINE 00003775 "\t    last;"
NSQ_SOURCE_LINE 00003776 "\t} elsif ( $done->{soft_error} ) {"
NSQ_SOURCE_LINE 00003777 "\t    push @soft_error,$done->{soft_error};"
NSQ_SOURCE_LINE 00003778 "\t}"
NSQ_SOURCE_LINE 00003779 "    }"
NSQ_SOURCE_LINE 00003780 "    while ( my($uri,$v) = each %todo) {"
NSQ_SOURCE_LINE 00003781 "\tmy $ids = $v->{ids};"
NSQ_SOURCE_LINE 00003782 "\t$v->{req} = Net::SSLeay::i2d_OCSP_REQUEST("
NSQ_SOURCE_LINE 00003783 "\t    Net::SSLeay::OCSP_ids2req(@$ids));"
NSQ_SOURCE_LINE 00003784 "    }"
NSQ_SOURCE_LINE 00003785 "    $hard_error ||= '' if ! %todo;"
NSQ_SOURCE_LINE 00003786 "    return bless {"
NSQ_SOURCE_LINE 00003787 "\tssl => $ssl,"
NSQ_SOURCE_LINE 00003788 "\tcache => $cache,"
NSQ_SOURCE_LINE 00003789 "\tfailhard => $failhard,"
NSQ_SOURCE_LINE 00003790 "\thard_error => $hard_error,"
NSQ_SOURCE_LINE 00003791 "\tsoft_error => @soft_error ? join(\"; \",@soft_error) : undef,"
NSQ_SOURCE_LINE 00003792 "\ttodo => \\%todo,"
NSQ_SOURCE_LINE 00003793 "    },$class;"
NSQ_SOURCE_LINE 00003794 "}"
NSQ_SOURCE_LINE 00003795 ""
NSQ_SOURCE_LINE 00003796 "# return current result, e.g. '' for no error, else error"
NSQ_SOURCE_LINE 00003797 "# if undef we have no final result yet"
NSQ_SOURCE_LINE 00003798 "sub hard_error { return shift->{hard_error} }"
NSQ_SOURCE_LINE 00003799 "sub soft_error { return shift->{soft_error} }"
NSQ_SOURCE_LINE 00003800 ""
NSQ_SOURCE_LINE 00003801 "# return hash with uri => ocsp_request_data for open requests"
NSQ_SOURCE_LINE 00003802 "sub requests {"
NSQ_SOURCE_LINE 00003803 "    my $todo = shift()->{todo};"
