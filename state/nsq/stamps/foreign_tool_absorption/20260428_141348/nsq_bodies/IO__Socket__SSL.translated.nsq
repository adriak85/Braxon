NSQ_SOURCE_LINE 00002676 "\t}"
NSQ_SOURCE_LINE 00002677 "\tdie \"invalid context to reuse: $ctx\";"
NSQ_SOURCE_LINE 00002678 "    }"
NSQ_SOURCE_LINE 00002679 ""
NSQ_SOURCE_LINE 00002680 "    # common problem forgetting to set SSL_use_cert"
NSQ_SOURCE_LINE 00002681 "    # if client cert is given by user but SSL_use_cert is undef, assume that it"
NSQ_SOURCE_LINE 00002682 "    # should be set"
NSQ_SOURCE_LINE 00002683 "    if ( ! $is_server && ! defined $arg_hash->{SSL_use_cert}"
NSQ_SOURCE_LINE 00002684 "\t&& ( grep { $arg_hash->{$_} } qw(SSL_cert SSL_cert_file))"
NSQ_SOURCE_LINE 00002685 "\t&& ( grep { $arg_hash->{$_} } qw(SSL_key SSL_key_file)) ) {"
