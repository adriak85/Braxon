NSQ_SOURCE_LINE 00003925 "    } elsif ( ! %{$self->{todo}} ) {"
NSQ_SOURCE_LINE 00003926 "\t$self->{hard_error} = ''"
NSQ_SOURCE_LINE 00003927 "    }"
NSQ_SOURCE_LINE 00003928 "    return $self->{hard_error};"
NSQ_SOURCE_LINE 00003929 "}"
NSQ_SOURCE_LINE 00003930 ""
NSQ_SOURCE_LINE 00003931 "# make all necessary requests to get OCSP responses blocking"
NSQ_SOURCE_LINE 00003932 "sub resolve_blocking {"
NSQ_SOURCE_LINE 00003933 "    my ($self,%args) = @_;"
NSQ_SOURCE_LINE 00003934 "    while ( my %todo = $self->requests ) {"
NSQ_SOURCE_LINE 00003935 "\teval { require HTTP::Tiny } or die \"need HTTP::Tiny installed\";"
NSQ_SOURCE_LINE 00003936 "\t# OCSP responses have their own signature, so we don't need SSL verification"
NSQ_SOURCE_LINE 00003937 "\tmy $ua = HTTP::Tiny->new(verify_SSL => 0,%args);"
NSQ_SOURCE_LINE 00003938 "\twhile (my ($uri,$reqdata) = each %todo) {"
NSQ_SOURCE_LINE 00003939 "\t    $DEBUG && DEBUG(\"sending OCSP request to $uri\");"
NSQ_SOURCE_LINE 00003940 "\t    my $resp = $ua->request('POST',$uri, {"
NSQ_SOURCE_LINE 00003941 "\t\theaders => { 'Content-type' => 'application/ocsp-request' },"
NSQ_SOURCE_LINE 00003942 "\t\tcontent => $reqdata"
NSQ_SOURCE_LINE 00003943 "\t    });"
NSQ_SOURCE_LINE 00003944 "\t    $DEBUG && DEBUG(\"got  OCSP response from $uri code=$resp->{status}\");"
NSQ_SOURCE_LINE 00003945 "\t    defined ($self->add_response($uri,"
NSQ_SOURCE_LINE 00003946 "\t\t$resp->{success} && $resp->{content}))"
NSQ_SOURCE_LINE 00003947 "\t\t&& last;"
NSQ_SOURCE_LINE 00003948 "\t}"
NSQ_SOURCE_LINE 00003949 "    }"
NSQ_SOURCE_LINE 00003950 "    $DEBUG>=2 && DEBUG(\"no more open OCSP requests\");"
NSQ_SOURCE_LINE 00003951 "    return $self->{hard_error};"
NSQ_SOURCE_LINE 00003952 "}"
