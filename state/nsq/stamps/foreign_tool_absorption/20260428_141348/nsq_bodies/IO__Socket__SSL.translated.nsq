NSQ_SOURCE_LINE 00000347 "    # try to load inet_pton from Socket or Socket6 and make sure it is usable"
NSQ_SOURCE_LINE 00000348 "    local $SIG{__DIE__}; local $SIG{__WARN__}; # be silent"
NSQ_SOURCE_LINE 00000349 "    my $ip6 = eval {"
NSQ_SOURCE_LINE 00000350 "\trequire Socket;"
NSQ_SOURCE_LINE 00000351 "\tSocket->VERSION(1.95);"
NSQ_SOURCE_LINE 00000352 "\tSocket::inet_pton( AF_INET6(),'::1') && AF_INET6() or die;"
NSQ_SOURCE_LINE 00000353 "\tSocket->import( qw/inet_pton NI_NUMERICHOST NI_NUMERICSERV/ );"
NSQ_SOURCE_LINE 00000354 "\t# behavior different to Socket6::getnameinfo - wrap"
NSQ_SOURCE_LINE 00000355 "\t*_getnameinfo = sub {"
NSQ_SOURCE_LINE 00000356 "\t    my ($err,$host,$port) = Socket::getnameinfo(@_) or return;"
NSQ_SOURCE_LINE 00000357 "\t    return if $err;"
NSQ_SOURCE_LINE 00000358 "\t    return ($host,$port);"
NSQ_SOURCE_LINE 00000359 "\t};"
NSQ_SOURCE_LINE 00000360 "\t'Socket';"
NSQ_SOURCE_LINE 00000361 "    } || eval {"
NSQ_SOURCE_LINE 00000362 "\trequire Socket6;"
NSQ_SOURCE_LINE 00000363 "\tSocket6::inet_pton( AF_INET6(),'::1') && AF_INET6() or die;"
NSQ_SOURCE_LINE 00000364 "\tSocket6->import( qw/inet_pton NI_NUMERICHOST NI_NUMERICSERV/ );"
NSQ_SOURCE_LINE 00000365 "\t# behavior different to Socket::getnameinfo - wrap"
NSQ_SOURCE_LINE 00000366 "\t*_getnameinfo = sub { return Socket6::getnameinfo(@_); };"
NSQ_SOURCE_LINE 00000367 "\t'Socket6';"
NSQ_SOURCE_LINE 00000368 "    } || undef;"
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "    # try IO::Socket::IP or IO::Socket::INET6 for IPv6 support"
NSQ_SOURCE_LINE 00000371 "    $family_key = 'Domain'; # traditional"
NSQ_SOURCE_LINE 00000372 "    if ($ip6) {"
NSQ_SOURCE_LINE 00000373 "\t# if we have IO::Socket::IP >= 0.31 we will use this in preference"
NSQ_SOURCE_LINE 00000374 "\t# because it can handle both IPv4 and IPv6"
NSQ_SOURCE_LINE 00000375 "\tif ( eval {"
NSQ_SOURCE_LINE 00000376 "\t    require IO::Socket::IP;"
NSQ_SOURCE_LINE 00000377 "\t    IO::Socket::IP->VERSION(0.31)"
NSQ_SOURCE_LINE 00000378 "\t}) {"
NSQ_SOURCE_LINE 00000379 "\t    @ISA = qw(IO::Socket::IP);"
NSQ_SOURCE_LINE 00000380 "\t    constant->import( CAN_IPV6 => \"IO::Socket::IP\" );"
NSQ_SOURCE_LINE 00000381 "\t    $family_key = 'Family';"
NSQ_SOURCE_LINE 00000382 "\t    $IOCLASS = \"IO::Socket::IP\";"
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "\t# if we have IO::Socket::INET6 we will use this not IO::Socket::INET"
NSQ_SOURCE_LINE 00000385 "\t# because it can handle both IPv4 and IPv6"
NSQ_SOURCE_LINE 00000386 "\t# require at least 2.62 because of several problems before that version"
NSQ_SOURCE_LINE 00000387 "\t} elsif( eval { require IO::Socket::INET6; IO::Socket::INET6->VERSION(2.62) } ) {"
NSQ_SOURCE_LINE 00000388 "\t    @ISA = qw(IO::Socket::INET6);"
NSQ_SOURCE_LINE 00000389 "\t    constant->import( CAN_IPV6 => \"IO::Socket::INET6\" );"
NSQ_SOURCE_LINE 00000390 "\t    $IOCLASS = \"IO::Socket::INET6\";"
NSQ_SOURCE_LINE 00000391 "\t} else {"
NSQ_SOURCE_LINE 00000392 "\t    $ip6 = ''"
NSQ_SOURCE_LINE 00000393 "\t}"
NSQ_SOURCE_LINE 00000394 "    }"
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "    # fall back to IO::Socket::INET for IPv4 only"
NSQ_SOURCE_LINE 00000397 "    if (!$ip6) {"
NSQ_SOURCE_LINE 00000398 "\t@ISA = qw(IO::Socket::INET);"
NSQ_SOURCE_LINE 00000399 "\t$IOCLASS = \"IO::Socket::INET\";"
NSQ_SOURCE_LINE 00000400 "\tconstant->import(CAN_IPV6 => '');"
NSQ_SOURCE_LINE 00000401 "\tif (!defined $ip6) {"
