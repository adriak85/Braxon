NSQ_SOURCE_LINE 00001244 "\t\t# XXX not available in Net::SSLeay, propagate via r_err"
NSQ_SOURCE_LINE 00001245 "\t\t# Net::SSLeay::BIO_set_mem_eof_return($rbio, 0);"
NSQ_SOURCE_LINE 00001246 "\t\t$$r_err = $Net_SSLeay_ERROR_SSL;"
NSQ_SOURCE_LINE 00001247 "\t    } elsif ($!{EAGAIN} || $!{EWOULDBLOCK}) {"
NSQ_SOURCE_LINE 00001248 "\t\t# retry later"
NSQ_SOURCE_LINE 00001249 "\t    } else {"
NSQ_SOURCE_LINE 00001250 "\t\tgoto socket_error; # fatal"
NSQ_SOURCE_LINE 00001251 "\t    }"
NSQ_SOURCE_LINE 00001252 "\t}"
NSQ_SOURCE_LINE 00001253 "\treturn $rv;"
NSQ_SOURCE_LINE 00001254 ""
NSQ_SOURCE_LINE 00001255 "      socket_error:"
NSQ_SOURCE_LINE 00001256 "\t# unavailable - Net::SSLeay::BIO_set_mem_eof_return($rbio, 0);"
NSQ_SOURCE_LINE 00001257 "\t$$r_err = $Net_SSLeay_ERROR_SSL;"
NSQ_SOURCE_LINE 00001258 "\t$DEBUG>=2 && DEBUG(\"biosock error: $!\" );"
NSQ_SOURCE_LINE 00001259 "\treturn;"
NSQ_SOURCE_LINE 00001260 "    };"
