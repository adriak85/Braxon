NSQ_SOURCE_LINE 00004082 "#"
NSQ_SOURCE_LINE 00004083 ""
NSQ_SOURCE_LINE 00004084 "sub ossl_trace {"
NSQ_SOURCE_LINE 00004085 "    $DEBUG>=2 or return;"
NSQ_SOURCE_LINE 00004086 "    my ($direction, $ssl_ver, $content_type, $buf, $len, $ssl) = @_;"
NSQ_SOURCE_LINE 00004087 ""
NSQ_SOURCE_LINE 00004088 "    # Restore original $! value on return"
NSQ_SOURCE_LINE 00004089 "    local $!;"
NSQ_SOURCE_LINE 00004090 ""
NSQ_SOURCE_LINE 00004091 "    my $verstr = $tc_ver2s{$ssl_ver} || \"(version=$ssl_ver)\";"
NSQ_SOURCE_LINE 00004092 ""
NSQ_SOURCE_LINE 00004093 "    # Log progress for interesting records only (like Handshake or Alert), skip"
NSQ_SOURCE_LINE 00004094 "    # all raw record headers (content_type == SSL3_RT_HEADER or ssl_ver == 0)."
NSQ_SOURCE_LINE 00004095 "    # For TLS 1.3, skip notification of the decrypted inner Content-Type."
NSQ_SOURCE_LINE 00004096 ""
NSQ_SOURCE_LINE 00004097 "    if ($ssl_ver"
NSQ_SOURCE_LINE 00004098 "\t&& ($content_type != $trace_constants{SSL3_RT_HEADER})"
NSQ_SOURCE_LINE 00004099 "\t&& ($content_type != $trace_constants{SSL3_RT_INNER_CONTENT_TYPE})"
NSQ_SOURCE_LINE 00004100 "    ) {"
NSQ_SOURCE_LINE 00004101 ""
NSQ_SOURCE_LINE 00004102 "        # the info given when the version is zero is not that useful for us"
NSQ_SOURCE_LINE 00004103 "        $ssl_ver >>= 8;  # check the upper 8 bits only below */"
NSQ_SOURCE_LINE 00004104 ""
NSQ_SOURCE_LINE 00004105 "        # SSLv2 doesn't seem to have TLS record-type headers, so OpenSSL"
NSQ_SOURCE_LINE 00004106 "        # always pass-up content-type as 0. But the interesting message-type"
NSQ_SOURCE_LINE 00004107 "        # is at 'buf[0]'."
NSQ_SOURCE_LINE 00004108 ""
NSQ_SOURCE_LINE 00004109 "\tmy $tls_rt_name = ($ssl_ver == $trace_constants{SSL3_VERSION_MAJOR} && $content_type)"
NSQ_SOURCE_LINE 00004110 "\t    ? $tc_type2s{$content_type} || \"TLS Unknown (type=$content_type)\""
NSQ_SOURCE_LINE 00004111 "\t    : \"\";"
NSQ_SOURCE_LINE 00004112 ""
NSQ_SOURCE_LINE 00004113 "        my $msg_type;"
NSQ_SOURCE_LINE 00004114 "        my $msg_name;"
NSQ_SOURCE_LINE 00004115 "        if ($content_type == $trace_constants{SSL3_RT_CHANGE_CIPHER_SPEC}) {"
NSQ_SOURCE_LINE 00004116 "            $msg_type = unpack('c1', $buf);"
NSQ_SOURCE_LINE 00004117 "            $msg_name = \"Change cipher spec\";"
NSQ_SOURCE_LINE 00004118 "        } elsif ($content_type == $trace_constants{SSL3_RT_ALERT}) {"
NSQ_SOURCE_LINE 00004119 "            my @c = unpack('c2', $buf);"
NSQ_SOURCE_LINE 00004120 "            $msg_type = ($c[0] << 8) + $c[1];"
NSQ_SOURCE_LINE 00004121 "            $msg_name = eval { Net::SSLeay::alert_desc_string_long($msg_type) } || \"Unknown alert\";"
NSQ_SOURCE_LINE 00004122 "        } else {"
NSQ_SOURCE_LINE 00004123 "            $msg_type = unpack('c1', $buf);"
NSQ_SOURCE_LINE 00004124 "\t    $msg_name = $tc_msgtype2s{$ssl_ver, $msg_type} || \"Unknown (ssl_ver=$ssl_ver, msg=$msg_type)\";"
NSQ_SOURCE_LINE 00004125 "        }"
NSQ_SOURCE_LINE 00004126 "\tDEBUG(sprintf(\"* %s (%s), %s, %s (%d)\","
NSQ_SOURCE_LINE 00004127 "\t    $verstr, $direction ? \"OUT\" : \"IN\", $tls_rt_name, $msg_name, $msg_type));"
NSQ_SOURCE_LINE 00004128 "    }"
NSQ_SOURCE_LINE 00004129 ""
NSQ_SOURCE_LINE 00004130 "    #"
NSQ_SOURCE_LINE 00004131 "    # Here one might want to hexdump $buf (?)"
NSQ_SOURCE_LINE 00004132 "    #"
NSQ_SOURCE_LINE 00004133 "    # $DEBUG>=4 && printf STDERR \"%s\", hexdump($buf);"
NSQ_SOURCE_LINE 00004134 "}"
NSQ_SOURCE_LINE 00004135 ""
NSQ_SOURCE_LINE 00004136 ""
NSQ_SOURCE_LINE 00004137 "1;"
NSQ_SOURCE_LINE 00004138 ""
NSQ_SOURCE_LINE 00004139 "__END__"
BODY_END
