NSQ_SOURCE_LINE 00000432 "    my %const = ("
NSQ_SOURCE_LINE 00000433 "\tNID_CommonName => 13,"
NSQ_SOURCE_LINE 00000434 "\tGEN_DNS => 2,"
NSQ_SOURCE_LINE 00000435 "\tGEN_IPADD => 7,"
NSQ_SOURCE_LINE 00000436 "    );"
NSQ_SOURCE_LINE 00000437 "    while ( my ($name,$value) = each %const ) {"
NSQ_SOURCE_LINE 00000438 "\tno strict 'refs';"
NSQ_SOURCE_LINE 00000439 "\t*{$name} = UNIVERSAL::can( 'Net::SSLeay', $name ) || sub { $value };"
NSQ_SOURCE_LINE 00000440 "    }"
NSQ_SOURCE_LINE 00000441 ""
NSQ_SOURCE_LINE 00000442 "    *idn_to_ascii = \\&IO::Socket::SSL::PublicSuffix::idn_to_ascii;"
