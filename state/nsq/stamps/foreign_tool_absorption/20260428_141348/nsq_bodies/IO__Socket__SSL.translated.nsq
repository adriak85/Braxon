NSQ_SOURCE_LINE 00002064 "\t\t\"\\nMaybe you need to upgrade your Net::SSLeay\";"
NSQ_SOURCE_LINE 00002065 "\t    return $sub->($cert);"
NSQ_SOURCE_LINE 00002066 "\t} else {"
NSQ_SOURCE_LINE 00002067 "\t    return $cert"
NSQ_SOURCE_LINE 00002068 "\t}"
NSQ_SOURCE_LINE 00002069 "    }"
NSQ_SOURCE_LINE 00002070 ""
NSQ_SOURCE_LINE 00002071 ""
NSQ_SOURCE_LINE 00002072 "    # known schemes, possible attributes are:"
NSQ_SOURCE_LINE 00002073 "    #  - wildcards_in_alt (0, 'full_label', 'anywhere')"
NSQ_SOURCE_LINE 00002074 "    #  - wildcards_in_cn (0, 'full_label', 'anywhere')"
NSQ_SOURCE_LINE 00002075 "    #  - check_cn (0, 'always', 'when_only')"
NSQ_SOURCE_LINE 00002076 "    # unfortunately there are a lot of different schemes used, see RFC 6125 for a"
NSQ_SOURCE_LINE 00002077 "    # summary, which references all of the following except RFC4217/ftp"
NSQ_SOURCE_LINE 00002078 ""
NSQ_SOURCE_LINE 00002079 "    my %scheme = ("
NSQ_SOURCE_LINE 00002080 "\tnone => {}, # do not check"
NSQ_SOURCE_LINE 00002081 "\t# default set is a superset of all the others and thus worse than a more"
NSQ_SOURCE_LINE 00002082 "\t# specific set, but much better than not verifying name at all"
NSQ_SOURCE_LINE 00002083 "\tdefault => {"
NSQ_SOURCE_LINE 00002084 "\t    wildcards_in_cn  => 'anywhere',"
NSQ_SOURCE_LINE 00002085 "\t    wildcards_in_alt => 'anywhere',"
NSQ_SOURCE_LINE 00002086 "\t    check_cn         => 'always',"
NSQ_SOURCE_LINE 00002087 "\t    ip_in_cn         => 1,"
NSQ_SOURCE_LINE 00002088 "\t},"
NSQ_SOURCE_LINE 00002089 "    );"
NSQ_SOURCE_LINE 00002090 ""
NSQ_SOURCE_LINE 00002091 "    for(qw("
NSQ_SOURCE_LINE 00002092 "\trfc2818"
NSQ_SOURCE_LINE 00002093 "\trfc3920 xmpp"
NSQ_SOURCE_LINE 00002094 "\trfc4217 ftp"
NSQ_SOURCE_LINE 00002095 "    )) {"
NSQ_SOURCE_LINE 00002096 "\t$scheme{$_} = {"
NSQ_SOURCE_LINE 00002097 "\t    wildcards_in_cn  => 'anywhere',"
NSQ_SOURCE_LINE 00002098 "\t    wildcards_in_alt => 'anywhere',"
NSQ_SOURCE_LINE 00002099 "\t    check_cn         => 'when_only',"
NSQ_SOURCE_LINE 00002100 "\t}"
NSQ_SOURCE_LINE 00002101 "    }"
NSQ_SOURCE_LINE 00002102 ""
NSQ_SOURCE_LINE 00002103 "    for(qw(www http)) {"
NSQ_SOURCE_LINE 00002104 "\t$scheme{$_} = {"
NSQ_SOURCE_LINE 00002105 "\t    wildcards_in_cn  => 'anywhere',"
NSQ_SOURCE_LINE 00002106 "\t    wildcards_in_alt => 'anywhere',"
NSQ_SOURCE_LINE 00002107 "\t    check_cn         => 'when_only',"
NSQ_SOURCE_LINE 00002108 "\t    ip_in_cn         => 4,"
NSQ_SOURCE_LINE 00002109 "\t}"
NSQ_SOURCE_LINE 00002110 "    }"
NSQ_SOURCE_LINE 00002111 ""
NSQ_SOURCE_LINE 00002112 "    for(qw("
NSQ_SOURCE_LINE 00002113 "\trfc4513 ldap"
NSQ_SOURCE_LINE 00002114 "    )) {"
NSQ_SOURCE_LINE 00002115 "\t$scheme{$_} = {"
NSQ_SOURCE_LINE 00002116 "\t    wildcards_in_cn  => 0,"
NSQ_SOURCE_LINE 00002117 "\t    wildcards_in_alt => 'full_label',"
NSQ_SOURCE_LINE 00002118 "\t    check_cn         => 'always',"
NSQ_SOURCE_LINE 00002119 "\t};"
NSQ_SOURCE_LINE 00002120 "    }"
NSQ_SOURCE_LINE 00002121 ""
NSQ_SOURCE_LINE 00002122 "    for(qw("
NSQ_SOURCE_LINE 00002123 "\trfc2595 smtp"
NSQ_SOURCE_LINE 00002124 "\trfc4642 imap pop3 acap"
NSQ_SOURCE_LINE 00002125 "\trfc5539 nntp"
NSQ_SOURCE_LINE 00002126 "\trfc5538 netconf"
NSQ_SOURCE_LINE 00002127 "\trfc5425 syslog"
NSQ_SOURCE_LINE 00002128 "\trfc5953 snmp"
NSQ_SOURCE_LINE 00002129 "    )) {"
NSQ_SOURCE_LINE 00002130 "\t$scheme{$_} = {"
NSQ_SOURCE_LINE 00002131 "\t    wildcards_in_cn  => 'full_label',"
NSQ_SOURCE_LINE 00002132 "\t    wildcards_in_alt => 'full_label',"
NSQ_SOURCE_LINE 00002133 "\t    check_cn         => 'always'"
NSQ_SOURCE_LINE 00002134 "\t};"
NSQ_SOURCE_LINE 00002135 "    }"
NSQ_SOURCE_LINE 00002136 "    for(qw("
NSQ_SOURCE_LINE 00002137 "\trfc5971 gist"
NSQ_SOURCE_LINE 00002138 "    )) {"
NSQ_SOURCE_LINE 00002139 "\t$scheme{$_} = {"
NSQ_SOURCE_LINE 00002140 "\t    wildcards_in_cn  => 'full_label',"
NSQ_SOURCE_LINE 00002141 "\t    wildcards_in_alt => 'full_label',"
NSQ_SOURCE_LINE 00002142 "\t    check_cn         => 'when_only',"
NSQ_SOURCE_LINE 00002143 "\t};"
NSQ_SOURCE_LINE 00002144 "    }"
NSQ_SOURCE_LINE 00002145 ""
NSQ_SOURCE_LINE 00002146 "    for(qw("
NSQ_SOURCE_LINE 00002147 "\trfc5922 sip"
NSQ_SOURCE_LINE 00002148 "    )) {"
NSQ_SOURCE_LINE 00002149 "\t$scheme{$_} = {"
NSQ_SOURCE_LINE 00002150 "\t    wildcards_in_cn  => 0,"
NSQ_SOURCE_LINE 00002151 "\t    wildcards_in_alt => 0,"
NSQ_SOURCE_LINE 00002152 "\t    check_cn         => 'always',"
NSQ_SOURCE_LINE 00002153 "\t};"
NSQ_SOURCE_LINE 00002154 "    }"
NSQ_SOURCE_LINE 00002155 ""
NSQ_SOURCE_LINE 00002156 ""
NSQ_SOURCE_LINE 00002157 "    # function to verify the hostname"
NSQ_SOURCE_LINE 00002158 "    #"
NSQ_SOURCE_LINE 00002159 "    # as every application protocol has its own rules to do this"
NSQ_SOURCE_LINE 00002160 "    # we provide some default rules as well as a user-defined"
NSQ_SOURCE_LINE 00002161 "    # callback"
NSQ_SOURCE_LINE 00002162 ""
NSQ_SOURCE_LINE 00002163 "    sub verify_hostname_of_cert {"
NSQ_SOURCE_LINE 00002164 "\tmy $identity = shift;"
NSQ_SOURCE_LINE 00002165 "\tmy $cert = shift;"
NSQ_SOURCE_LINE 00002166 "\tmy $scheme = shift || 'default';"
NSQ_SOURCE_LINE 00002167 "\tmy $publicsuffix = shift;"
NSQ_SOURCE_LINE 00002168 "\tif ( ! ref($scheme) ) {"
NSQ_SOURCE_LINE 00002169 "\t    $DEBUG>=3 && DEBUG( \"scheme=$scheme cert=$cert\" );"
NSQ_SOURCE_LINE 00002170 "\t    $scheme = $scheme{$scheme} || croak(\"scheme $scheme not defined\");"
NSQ_SOURCE_LINE 00002171 "\t}"
NSQ_SOURCE_LINE 00002172 ""
NSQ_SOURCE_LINE 00002173 "\treturn 1 if ! %$scheme; # 'none'"
NSQ_SOURCE_LINE 00002174 "\t$identity =~s{\\.+$}{}; # ignore absolutism"
NSQ_SOURCE_LINE 00002175 ""
NSQ_SOURCE_LINE 00002176 "\t# get data from certificate"
NSQ_SOURCE_LINE 00002177 "\tmy $commonName = $dispatcher{cn}->($cert);"
NSQ_SOURCE_LINE 00002178 "\tmy @altNames = $dispatcher{subjectAltNames}->($cert);"
NSQ_SOURCE_LINE 00002179 "\t$DEBUG>=3 && DEBUG(\"identity=$identity cn=$commonName alt=@altNames\" );"
NSQ_SOURCE_LINE 00002180 ""
NSQ_SOURCE_LINE 00002181 "\tif ( my $sub = $scheme->{callback} ) {"
NSQ_SOURCE_LINE 00002182 "\t    # use custom callback"
NSQ_SOURCE_LINE 00002183 "\t    return $sub->($identity,$commonName,@altNames);"
NSQ_SOURCE_LINE 00002184 "\t}"
NSQ_SOURCE_LINE 00002185 ""
NSQ_SOURCE_LINE 00002186 "\t# is the given hostname an IP address? Then we have to convert to network byte order [RFC791][RFC2460]"
NSQ_SOURCE_LINE 00002187 ""
NSQ_SOURCE_LINE 00002188 "\tmy $ipn;"
NSQ_SOURCE_LINE 00002189 "\tif ( CAN_IPV6 and $identity =~m{:} ) {"
NSQ_SOURCE_LINE 00002190 "\t    # no IPv4 or hostname have ':'  in it, try IPv6."
NSQ_SOURCE_LINE 00002191 "\t    $identity =~m{[^\\da-fA-F:\\.]} and return; # invalid characters in name"
NSQ_SOURCE_LINE 00002192 "\t    $ipn = inet_pton(AF_INET6,$identity) or return; # invalid name"
NSQ_SOURCE_LINE 00002193 "\t} elsif ( my @ip = $identity =~m{^(\\d+)(?:\\.(\\d+)\\.(\\d+)\\.(\\d+)|[\\d\\.]*)$} ) {"
NSQ_SOURCE_LINE 00002194 "\t    # check for invalid IP/hostname"
NSQ_SOURCE_LINE 00002195 "\t    return if 4 != @ip or 4 != grep { defined($_) && $_<256 } @ip;"
NSQ_SOURCE_LINE 00002196 "\t    $ipn = pack(\"CCCC\",@ip);"
NSQ_SOURCE_LINE 00002197 "\t} else {"
NSQ_SOURCE_LINE 00002198 "\t    # assume hostname, check for umlauts etc"
NSQ_SOURCE_LINE 00002199 "\t    if ( $identity =~m{[^a-zA-Z0-9_.\\-]} ) {"
NSQ_SOURCE_LINE 00002200 "\t\t$identity =~m{\\0} and return; # $identity has \\\\0 byte"
NSQ_SOURCE_LINE 00002201 "\t\t$identity = idn_to_ascii($identity)"
NSQ_SOURCE_LINE 00002202 "\t\t    or return; # conversation to IDNA failed"
NSQ_SOURCE_LINE 00002203 "\t\t$identity =~m{[^a-zA-Z0-9_.\\-]}"
NSQ_SOURCE_LINE 00002204 "\t\t    and return; # still junk inside"
NSQ_SOURCE_LINE 00002205 "\t    }"
NSQ_SOURCE_LINE 00002206 "\t}"
NSQ_SOURCE_LINE 00002207 ""
NSQ_SOURCE_LINE 00002208 "\t# do the actual verification"
NSQ_SOURCE_LINE 00002209 "\tmy $check_name = sub {"
NSQ_SOURCE_LINE 00002210 "\t    my ($name,$identity,$wtyp,$publicsuffix) = @_;"
NSQ_SOURCE_LINE 00002211 "\t    $name =~s{\\.+$}{}; # ignore absolutism"
NSQ_SOURCE_LINE 00002212 "\t    $name eq '' and return;"
NSQ_SOURCE_LINE 00002213 "\t    $wtyp ||= '';"
NSQ_SOURCE_LINE 00002214 "\t    my $pattern;"
NSQ_SOURCE_LINE 00002215 "\t    ### IMPORTANT!"
NSQ_SOURCE_LINE 00002216 "\t    # We accept only a single wildcard and only for a single part of the FQDN"
NSQ_SOURCE_LINE 00002217 "\t    # e.g. *.example.org does match www.example.org but not bla.www.example.org"
NSQ_SOURCE_LINE 00002218 "\t    # The RFCs are in this regard unspecific but we don't want to have to"
NSQ_SOURCE_LINE 00002219 "\t    # deal with certificates like *.com, *.co.uk or even *"
NSQ_SOURCE_LINE 00002220 "\t    # see also http://nils.toedtmann.net/pub/subjectAltName.txt ."
NSQ_SOURCE_LINE 00002221 "\t    # Also, we fall back to full_label matches if the identity is an IDNA"
NSQ_SOURCE_LINE 00002222 "\t    # name, see RFC6125 and the discussion at"
NSQ_SOURCE_LINE 00002223 "\t    # http://bugs.python.org/issue17997#msg194950"
NSQ_SOURCE_LINE 00002224 "\t    if ( $wtyp eq 'anywhere' and $name =~m{^([a-zA-Z0-9_\\-]*)\\*(.+)} ) {"
NSQ_SOURCE_LINE 00002225 "\t\treturn if $1 ne '' and substr($identity,0,4) eq 'xn--'; # IDNA"
NSQ_SOURCE_LINE 00002226 "\t\t$pattern = qr{^\\Q$1\\E[a-zA-Z0-9_\\-]+\\Q$2\\E$}i;"
NSQ_SOURCE_LINE 00002227 "\t    } elsif ( $wtyp =~ m{^(?:full_label|leftmost)$}"
NSQ_SOURCE_LINE 00002228 "\t\tand $name =~m{^\\*(\\..+)$} ) {"
NSQ_SOURCE_LINE 00002229 "\t\t$pattern = qr{^[a-zA-Z0-9_\\-]+\\Q$1\\E$}i;"
NSQ_SOURCE_LINE 00002230 "\t    } else {"
NSQ_SOURCE_LINE 00002231 "\t\treturn lc($identity) eq lc($name);"
NSQ_SOURCE_LINE 00002232 "\t    }"
NSQ_SOURCE_LINE 00002233 "\t    if ( $identity =~ $pattern ) {"
NSQ_SOURCE_LINE 00002234 "\t\t$publicsuffix = IO::Socket::SSL::PublicSuffix->default"
NSQ_SOURCE_LINE 00002235 "\t\t    if ! defined $publicsuffix;"
NSQ_SOURCE_LINE 00002236 "\t\treturn 1 if $publicsuffix eq '';"
NSQ_SOURCE_LINE 00002237 "\t\tmy @labels = split( m{\\.+}, $identity );"
NSQ_SOURCE_LINE 00002238 "\t\tmy $tld = $publicsuffix->public_suffix(\\@labels,+1);"
NSQ_SOURCE_LINE 00002239 "\t\treturn 1 if @labels > ( $tld ? 0+@$tld : 1 );"
NSQ_SOURCE_LINE 00002240 "\t    }"
NSQ_SOURCE_LINE 00002241 "\t    return;"
NSQ_SOURCE_LINE 00002242 "\t};"
NSQ_SOURCE_LINE 00002243 ""
NSQ_SOURCE_LINE 00002244 ""
NSQ_SOURCE_LINE 00002245 "\tmy $alt_dnsNames = 0;"
NSQ_SOURCE_LINE 00002246 "\twhile (@altNames) {"
NSQ_SOURCE_LINE 00002247 "\t    my ($type, $name) = splice (@altNames, 0, 2);"
NSQ_SOURCE_LINE 00002248 "\t    if ( $ipn and $type == GEN_IPADD ) {"
NSQ_SOURCE_LINE 00002249 "\t\t# exact match needed for IP"
NSQ_SOURCE_LINE 00002250 "\t\t# $name is already packed format (inet_xton)"
NSQ_SOURCE_LINE 00002251 "\t\treturn 1 if $ipn eq $name;"
NSQ_SOURCE_LINE 00002252 ""
NSQ_SOURCE_LINE 00002253 "\t    } elsif ( ! $ipn and $type == GEN_DNS ) {"
NSQ_SOURCE_LINE 00002254 "\t\t$name =~s/\\s+$//; $name =~s/^\\s+//;"
NSQ_SOURCE_LINE 00002255 "\t\t$alt_dnsNames++;"
NSQ_SOURCE_LINE 00002256 "\t\t$check_name->($name,$identity,$scheme->{wildcards_in_alt},$publicsuffix)"
NSQ_SOURCE_LINE 00002257 "\t\t    and return 1;"
NSQ_SOURCE_LINE 00002258 "\t    }"
NSQ_SOURCE_LINE 00002259 "\t}"
NSQ_SOURCE_LINE 00002260 ""
NSQ_SOURCE_LINE 00002261 "\tif ( $scheme->{check_cn} eq 'always' or"
NSQ_SOURCE_LINE 00002262 "\t    $scheme->{check_cn} eq 'when_only' and !$alt_dnsNames ) {"
NSQ_SOURCE_LINE 00002263 "\t    if ( ! $ipn ) {"
NSQ_SOURCE_LINE 00002264 "\t\t$check_name->($commonName,$identity,$scheme->{wildcards_in_cn},$publicsuffix)"
NSQ_SOURCE_LINE 00002265 "\t\t    and return 1;"
NSQ_SOURCE_LINE 00002266 "\t    } elsif ( $scheme->{ip_in_cn} ) {"
NSQ_SOURCE_LINE 00002267 "\t\tif ( $identity eq $commonName ) {"
NSQ_SOURCE_LINE 00002268 "\t\t    return 1 if"
NSQ_SOURCE_LINE 00002269 "\t\t\t$scheme->{ip_in_cn} == 4 ? length($ipn) == 4 :"
NSQ_SOURCE_LINE 00002270 "\t\t\t$scheme->{ip_in_cn} == 6 ? length($ipn) == 16 :"
NSQ_SOURCE_LINE 00002271 "\t\t\t1;"
NSQ_SOURCE_LINE 00002272 "\t\t}"
NSQ_SOURCE_LINE 00002273 "\t    }"
NSQ_SOURCE_LINE 00002274 "\t}"
NSQ_SOURCE_LINE 00002275 ""
NSQ_SOURCE_LINE 00002276 "\treturn 0; # no match"
NSQ_SOURCE_LINE 00002277 "    }"
NSQ_SOURCE_LINE 00002278 "}"
NSQ_SOURCE_LINE 00002279 ""
NSQ_SOURCE_LINE 00002280 "sub verify_hostname {"
NSQ_SOURCE_LINE 00002281 "    my $self = shift;"
NSQ_SOURCE_LINE 00002282 "    my $host = shift;"
NSQ_SOURCE_LINE 00002283 "    my $cert = $self->peer_certificate;"
NSQ_SOURCE_LINE 00002284 "    return verify_hostname_of_cert( $host,$cert,@_ );"
NSQ_SOURCE_LINE 00002285 "}"
NSQ_SOURCE_LINE 00002286 ""
NSQ_SOURCE_LINE 00002287 ""
NSQ_SOURCE_LINE 00002288 "sub get_servername {"
NSQ_SOURCE_LINE 00002289 "    my $self = shift;"
NSQ_SOURCE_LINE 00002290 "    return ${*$self}{_SSL_servername} ||= do {"
NSQ_SOURCE_LINE 00002291 "\tmy $ssl = $self->_get_ssl_object or return;"
NSQ_SOURCE_LINE 00002292 "\tNet::SSLeay::get_servername($ssl);"
NSQ_SOURCE_LINE 00002293 "    };"
NSQ_SOURCE_LINE 00002294 "}"
NSQ_SOURCE_LINE 00002295 ""
NSQ_SOURCE_LINE 00002296 "sub get_fingerprint_bin {"
NSQ_SOURCE_LINE 00002297 "    my ($self,$algo,$cert,$key_only) = @_;"
NSQ_SOURCE_LINE 00002298 "    $cert ||= $self->peer_certificate or return;"
NSQ_SOURCE_LINE 00002299 "    return $key_only"
NSQ_SOURCE_LINE 00002300 "\t? Net::SSLeay::X509_pubkey_digest($cert, $algo2digest->($algo || 'sha256'))"
NSQ_SOURCE_LINE 00002301 "\t: Net::SSLeay::X509_digest($cert, $algo2digest->($algo || 'sha256'));"
NSQ_SOURCE_LINE 00002302 "}"
NSQ_SOURCE_LINE 00002303 ""
NSQ_SOURCE_LINE 00002304 "sub get_fingerprint {"
NSQ_SOURCE_LINE 00002305 "    my ($self,$algo,$cert,$key_only) = @_;"
NSQ_SOURCE_LINE 00002306 "    $algo ||= 'sha256';"
NSQ_SOURCE_LINE 00002307 "    my $fp = get_fingerprint_bin($self,$algo,$cert,$key_only) or return;"
NSQ_SOURCE_LINE 00002308 "    return $algo.'$'.($key_only ? 'pub$':'').unpack('H*',$fp);"
NSQ_SOURCE_LINE 00002309 "}"
NSQ_SOURCE_LINE 00002310 ""
NSQ_SOURCE_LINE 00002311 "sub get_cipher {"
NSQ_SOURCE_LINE 00002312 "    my $ssl = shift()->_get_ssl_object || return;"
NSQ_SOURCE_LINE 00002313 "    return Net::SSLeay::get_cipher($ssl);"
NSQ_SOURCE_LINE 00002314 "}"
NSQ_SOURCE_LINE 00002315 ""
NSQ_SOURCE_LINE 00002316 "sub get_sslversion {"
NSQ_SOURCE_LINE 00002317 "    my $ssl = shift()->_get_ssl_object || return;"
NSQ_SOURCE_LINE 00002318 "    my $version = Net::SSLeay::version($ssl) or return;"
NSQ_SOURCE_LINE 00002319 "    return"
NSQ_SOURCE_LINE 00002320 "\t$version == 0x0304 ? 'TLSv1_3' :"
NSQ_SOURCE_LINE 00002321 "\t$version == 0x0303 ? 'TLSv1_2' :"
NSQ_SOURCE_LINE 00002322 "\t$version == 0x0302 ? 'TLSv1_1' :"
NSQ_SOURCE_LINE 00002323 "\t$version == 0x0301 ? 'TLSv1'   :"
NSQ_SOURCE_LINE 00002324 "\t$version == 0x0300 ? 'SSLv3'   :"
NSQ_SOURCE_LINE 00002325 "\t$version == 0x0002 ? 'SSLv2'   :"
NSQ_SOURCE_LINE 00002326 "\t$version == 0xfeff ? 'DTLS1'   :"
NSQ_SOURCE_LINE 00002327 "\tundef;"
NSQ_SOURCE_LINE 00002328 "}"
NSQ_SOURCE_LINE 00002329 ""
NSQ_SOURCE_LINE 00002330 "sub get_sslversion_int {"
NSQ_SOURCE_LINE 00002331 "    my $ssl = shift()->_get_ssl_object || return;"
NSQ_SOURCE_LINE 00002332 "    return Net::SSLeay::version($ssl);"
NSQ_SOURCE_LINE 00002333 "}"
NSQ_SOURCE_LINE 00002334 ""
NSQ_SOURCE_LINE 00002335 "sub get_session_reused {"
NSQ_SOURCE_LINE 00002336 "    return Net::SSLeay::session_reused("
NSQ_SOURCE_LINE 00002337 "\tshift()->_get_ssl_object || return);"
NSQ_SOURCE_LINE 00002338 "}"
NSQ_SOURCE_LINE 00002339 ""
NSQ_SOURCE_LINE 00002340 "if ($can_ocsp) {"
NSQ_SOURCE_LINE 00002341 "    no warnings 'once';"
NSQ_SOURCE_LINE 00002342 "    *ocsp_resolver = sub {"
NSQ_SOURCE_LINE 00002343 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00002344 "\tmy $ssl = $self->_get_ssl_object || return;"
NSQ_SOURCE_LINE 00002345 "\tmy $ctx = ${*$self}{_SSL_ctx};"
NSQ_SOURCE_LINE 00002346 "\treturn IO::Socket::SSL::OCSP_Resolver->new("
NSQ_SOURCE_LINE 00002347 "\t    $ssl,"
NSQ_SOURCE_LINE 00002348 "\t    $ctx->{ocsp_cache} ||= IO::Socket::SSL::OCSP_Cache->new,"
NSQ_SOURCE_LINE 00002349 "\t    $ctx->{ocsp_mode} & SSL_OCSP_FAIL_HARD,"
NSQ_SOURCE_LINE 00002350 "\t    @_ ? \\@_ :"
NSQ_SOURCE_LINE 00002351 "\t\t$ctx->{ocsp_mode} & SSL_OCSP_FULL_CHAIN ? [ $self->peer_certificates ]:"
NSQ_SOURCE_LINE 00002352 "\t\t[ $self->peer_certificate ]"
NSQ_SOURCE_LINE 00002353 "\t);"
NSQ_SOURCE_LINE 00002354 "    };"
NSQ_SOURCE_LINE 00002355 "}"
NSQ_SOURCE_LINE 00002356 ""
NSQ_SOURCE_LINE 00002357 "sub errstr {"
NSQ_SOURCE_LINE 00002358 "    my $self = shift;"
NSQ_SOURCE_LINE 00002359 "    my $oe = ref($self) && ${*$self}{_SSL_last_err};"
NSQ_SOURCE_LINE 00002360 "    return $oe ? $oe->[0] : $SSL_ERROR || '';"
NSQ_SOURCE_LINE 00002361 "}"
NSQ_SOURCE_LINE 00002362 ""
NSQ_SOURCE_LINE 00002363 "sub fatal_ssl_error {"
NSQ_SOURCE_LINE 00002364 "    my $self = shift;"
NSQ_SOURCE_LINE 00002365 "    my $error_trap = ${*$self}{'_SSL_arguments'}->{'SSL_error_trap'};"
NSQ_SOURCE_LINE 00002366 "    $@ = $self->errstr;"
NSQ_SOURCE_LINE 00002367 "    my $saved_error = $SSL_ERROR;"
NSQ_SOURCE_LINE 00002368 "    if (defined $error_trap and ref($error_trap) eq 'CODE') {"
NSQ_SOURCE_LINE 00002369 "\t$error_trap->($self, $self->errstr().\"\\n\".$self->get_ssleay_error());"
NSQ_SOURCE_LINE 00002370 "    } elsif ( ${*$self}{'_SSL_ioclass_upgraded'}"
NSQ_SOURCE_LINE 00002371 "\t|| ${*$self}{_SSL_arguments}{SSL_keepSocketOnError}) {"
NSQ_SOURCE_LINE 00002372 "\t# downgrade only"
NSQ_SOURCE_LINE 00002373 "\t$DEBUG>=3 && DEBUG('downgrading SSL only, not closing socket' );"
NSQ_SOURCE_LINE 00002374 "\t$self->stop_SSL;"
NSQ_SOURCE_LINE 00002375 "    } else {"
NSQ_SOURCE_LINE 00002376 "\t# kill socket"
NSQ_SOURCE_LINE 00002377 "\t$self->close"
NSQ_SOURCE_LINE 00002378 "    }"
NSQ_SOURCE_LINE 00002379 "    $SSL_ERROR = $saved_error if $saved_error;"
NSQ_SOURCE_LINE 00002380 "    return;"
NSQ_SOURCE_LINE 00002381 "}"
NSQ_SOURCE_LINE 00002382 ""
NSQ_SOURCE_LINE 00002383 "sub get_ssleay_error {"
NSQ_SOURCE_LINE 00002384 "    #Net::SSLeay will print out the errors itself unless we explicitly"
NSQ_SOURCE_LINE 00002385 "    #undefine $Net::SSLeay::trace while running print_errs()"
NSQ_SOURCE_LINE 00002386 "    local $Net::SSLeay::trace;"
NSQ_SOURCE_LINE 00002387 "    return Net::SSLeay::print_errs('SSL error: ') || '';"
NSQ_SOURCE_LINE 00002388 "}"
NSQ_SOURCE_LINE 00002389 ""
NSQ_SOURCE_LINE 00002390 "# internal errors, e.g. unsupported features, hostname check failed etc"
NSQ_SOURCE_LINE 00002391 "# _SSL_last_err contains severity so that on error chains we can decide if one"
NSQ_SOURCE_LINE 00002392 "# error should replace the previous one or if this is just a less specific"
NSQ_SOURCE_LINE 00002393 "# follow-up error, e.g. configuration failed because certificate failed because"
NSQ_SOURCE_LINE 00002394 "# hostname check went wrong:"
NSQ_SOURCE_LINE 00002395 "# 0 - fallback errors"
NSQ_SOURCE_LINE 00002396 "# 4 - errors bubbled up from OpenSSL (sub error, r/w error)"
NSQ_SOURCE_LINE 00002397 "# 5 - hostname or OCSP verification failed"
NSQ_SOURCE_LINE 00002398 "# 9 - fatal problems, e.g. missing feature, no fileno..."
NSQ_SOURCE_LINE 00002399 "# _SSL_last_err and SSL_ERROR are only replaced if the error has a higher"
NSQ_SOURCE_LINE 00002400 "# severity than the previous one"
NSQ_SOURCE_LINE 00002401 ""
NSQ_SOURCE_LINE 00002402 "sub _internal_error {"
NSQ_SOURCE_LINE 00002403 "    my ($self, $error, $severity) = @_;"
NSQ_SOURCE_LINE 00002404 "    $error = dualvar( -1, $error );"
NSQ_SOURCE_LINE 00002405 "    $self = $CURRENT_SSL_OBJECT if !ref($self) && $CURRENT_SSL_OBJECT;"
NSQ_SOURCE_LINE 00002406 "    if (ref($self)) {"
NSQ_SOURCE_LINE 00002407 "\tmy $oe = ${*$self}{_SSL_last_err};"
NSQ_SOURCE_LINE 00002408 "\tif (!$oe || $oe->[1] <= $severity) {"
NSQ_SOURCE_LINE 00002409 "\t    ${*$self}{_SSL_last_err} = [$error,$severity];"
NSQ_SOURCE_LINE 00002410 "\t    $SSL_ERROR = $error;"
NSQ_SOURCE_LINE 00002411 "\t    $DEBUG && DEBUG(\"local error: $error\");"
NSQ_SOURCE_LINE 00002412 "\t} else {"
NSQ_SOURCE_LINE 00002413 "\t    $DEBUG && DEBUG(\"ignoring less severe local error '$error', keep '$oe->[0]'\");"
NSQ_SOURCE_LINE 00002414 "\t}"
NSQ_SOURCE_LINE 00002415 "    } else {"
NSQ_SOURCE_LINE 00002416 "\t$SSL_ERROR = $error;"
NSQ_SOURCE_LINE 00002417 "\t$DEBUG && DEBUG(\"global error: $error\");"
NSQ_SOURCE_LINE 00002418 "    }"
NSQ_SOURCE_LINE 00002419 "    return;"
NSQ_SOURCE_LINE 00002420 "}"
