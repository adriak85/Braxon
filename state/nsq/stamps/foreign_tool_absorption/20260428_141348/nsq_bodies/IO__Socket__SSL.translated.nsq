NSQ_SOURCE_LINE 00000620 "# we have callbacks associated with contexts, but have no way to access the"
NSQ_SOURCE_LINE 00000621 "# current SSL object from these callbacks. To work around this"
NSQ_SOURCE_LINE 00000622 "# CURRENT_SSL_OBJECT will be set before calling Net::SSLeay::{connect,accept}"
NSQ_SOURCE_LINE 00000623 "# and reset afterwards, so we have access to it inside _internal_error."
NSQ_SOURCE_LINE 00000624 "my $CURRENT_SSL_OBJECT;"
NSQ_SOURCE_LINE 00000625 ""
NSQ_SOURCE_LINE 00000626 "# You might be expecting to find a new() subroutine here, but that is"
NSQ_SOURCE_LINE 00000627 "# not how IO::Socket::INET works.  All configuration gets performed in"
NSQ_SOURCE_LINE 00000628 "# the calls to configure() and either connect() or accept()."
NSQ_SOURCE_LINE 00000629 ""
NSQ_SOURCE_LINE 00000630 "#Call to configure occurs when a new socket is made using"
NSQ_SOURCE_LINE 00000631 "#IO::Socket::INET.  Returns false (empty list) on failure."
NSQ_SOURCE_LINE 00000632 "sub configure {"
NSQ_SOURCE_LINE 00000633 "    my ($self, $arg_hash) = @_;"
NSQ_SOURCE_LINE 00000634 "    return _invalid_object() unless($self);"
NSQ_SOURCE_LINE 00000635 ""
NSQ_SOURCE_LINE 00000636 "    # force initial blocking"
NSQ_SOURCE_LINE 00000637 "    # otherwise IO::Socket::SSL->new might return undef if the"
NSQ_SOURCE_LINE 00000638 "    # socket is nonblocking and it fails to connect immediately"
NSQ_SOURCE_LINE 00000639 "    # for real nonblocking behavior one should create a nonblocking"
NSQ_SOURCE_LINE 00000640 "    # socket and later call connect explicitly"
NSQ_SOURCE_LINE 00000641 "    my $blocking = delete $arg_hash->{Blocking};"
NSQ_SOURCE_LINE 00000642 ""
NSQ_SOURCE_LINE 00000643 "    # because Net::HTTPS simple redefines blocking() to {} (e.g."
NSQ_SOURCE_LINE 00000644 "    # return undef) and IO::Socket::INET does not like this we"
NSQ_SOURCE_LINE 00000645 "    # set Blocking only explicitly if it was set"
NSQ_SOURCE_LINE 00000646 "    $arg_hash->{Blocking} = 1 if defined ($blocking);"
NSQ_SOURCE_LINE 00000647 ""
NSQ_SOURCE_LINE 00000648 "    $self->configure_SSL($arg_hash) || return;"
NSQ_SOURCE_LINE 00000649 ""
NSQ_SOURCE_LINE 00000650 "    if ($arg_hash->{$family_key} ||= $arg_hash->{Domain} || $arg_hash->{Family}) {"
NSQ_SOURCE_LINE 00000651 "\t# Hack to work around the problem that IO::Socket::IP defaults to"
NSQ_SOURCE_LINE 00000652 "\t# AI_ADDRCONFIG which creates problems if we have only the loopback"
NSQ_SOURCE_LINE 00000653 "\t# interface. If we already know the family this flag is more harmful"
NSQ_SOURCE_LINE 00000654 "\t# then useful."
NSQ_SOURCE_LINE 00000655 "\t$arg_hash->{GetAddrInfoFlags} = 0 if $IOCLASS eq 'IO::Socket::IP'"
NSQ_SOURCE_LINE 00000656 "\t\t&& ! defined $arg_hash->{GetAddrInfoFlags};"
NSQ_SOURCE_LINE 00000657 "    }"
NSQ_SOURCE_LINE 00000658 "    return $self->_internal_error(\"@ISA configuration failed\",0)"
NSQ_SOURCE_LINE 00000659 "\tif ! $self->SUPER::configure($arg_hash);"
NSQ_SOURCE_LINE 00000660 ""
NSQ_SOURCE_LINE 00000661 "    $self->blocking(0) if defined $blocking && !$blocking;"
NSQ_SOURCE_LINE 00000662 "    return $self;"
