NSQ_SOURCE_LINE 00003850 "\t} else {"
NSQ_SOURCE_LINE 00003851 "\t    my @err;"
NSQ_SOURCE_LINE 00003852 "\t    while ( my $err = Net::SSLeay::ERR_get_error()) {"
NSQ_SOURCE_LINE 00003853 "\t\tpush @soft_error, Net::SSLeay::ERR_error_string($err);"
NSQ_SOURCE_LINE 00003854 "\t    }"
NSQ_SOURCE_LINE 00003855 "\t    @soft_error = 'failed to verify OCSP response; subject: '."
NSQ_SOURCE_LINE 00003856 "\t\tjoin(\"; \",@{$todo->{subj}}) if ! @soft_error;"
NSQ_SOURCE_LINE 00003857 "\t}"
NSQ_SOURCE_LINE 00003858 "\t# configuration problem or we don't know the signer"
NSQ_SOURCE_LINE 00003859 "\t$self->{cache}->put($_,{"
