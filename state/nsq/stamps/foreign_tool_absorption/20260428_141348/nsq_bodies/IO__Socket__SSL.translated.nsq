NSQ_SOURCE_LINE 00003466 "package IO::Socket::SSL::Session_Cache;"
NSQ_SOURCE_LINE 00003467 "*DEBUG = *IO::Socket::SSL::DEBUG;"
NSQ_SOURCE_LINE 00003468 ""
NSQ_SOURCE_LINE 00003469 "# The cache is consisting of one list which contains all sessions and then"
NSQ_SOURCE_LINE 00003470 "# for each session key another list containing all sessions for same key."
NSQ_SOURCE_LINE 00003471 "# The order of the list is by use, i.e. last used are put on top."
NSQ_SOURCE_LINE 00003472 "# self.ghead points to the top of the global list while"
NSQ_SOURCE_LINE 00003473 "# self.shead{key} to the top of the session key specific list"
NSQ_SOURCE_LINE 00003474 "# All lists are cyclic"
NSQ_SOURCE_LINE 00003475 "# Each element in the list consists of an array with slots for ..."
NSQ_SOURCE_LINE 00003476 "use constant {"
NSQ_SOURCE_LINE 00003477 "    SESSION => 0,  # session object"
NSQ_SOURCE_LINE 00003478 "    KEY     => 1,  # key for object"
NSQ_SOURCE_LINE 00003479 "    GNEXT   => 2,  # next element in global list"
NSQ_SOURCE_LINE 00003480 "    GPREV   => 3,  # previous element in global list"
NSQ_SOURCE_LINE 00003481 "    SNEXT   => 4,  # next element for same session key"
NSQ_SOURCE_LINE 00003482 "    SPREV   => 5,  # previous element for same session key"
NSQ_SOURCE_LINE 00003483 "};"
NSQ_SOURCE_LINE 00003484 ""
NSQ_SOURCE_LINE 00003485 "sub new {"
NSQ_SOURCE_LINE 00003486 "    my ($class, $size) = @_;"
NSQ_SOURCE_LINE 00003487 "    $size>0 or return;"
NSQ_SOURCE_LINE 00003488 "    return bless {"
NSQ_SOURCE_LINE 00003489 "\troom  => $size,  # free space regarding to max size"
NSQ_SOURCE_LINE 00003490 "\tghead => undef,  # top of global list"
NSQ_SOURCE_LINE 00003491 "\tshead => {},     # top of key specific list"
NSQ_SOURCE_LINE 00003492 "    }, $class;"
NSQ_SOURCE_LINE 00003493 "}"
NSQ_SOURCE_LINE 00003494 ""
NSQ_SOURCE_LINE 00003495 "sub add_session {"
NSQ_SOURCE_LINE 00003496 "    my ($self, $key, $session) = @_;"
NSQ_SOURCE_LINE 00003497 ""
NSQ_SOURCE_LINE 00003498 "    # create new"
NSQ_SOURCE_LINE 00003499 "    my $v = [];"
NSQ_SOURCE_LINE 00003500 "    $v->[SESSION] = $session;"
NSQ_SOURCE_LINE 00003501 "    $v->[KEY] = $key;"
NSQ_SOURCE_LINE 00003502 "    $DEBUG>=3 && DEBUG(\"add_session($key,$session)\");"
NSQ_SOURCE_LINE 00003503 "    _add_entry($self,$v);"
NSQ_SOURCE_LINE 00003504 "}"
NSQ_SOURCE_LINE 00003505 ""
NSQ_SOURCE_LINE 00003506 "sub replace_session {"
NSQ_SOURCE_LINE 00003507 "    my ($self, $key, $session) = @_;"
NSQ_SOURCE_LINE 00003508 "    $self->del_session($key);"
NSQ_SOURCE_LINE 00003509 "    $self->add_session($key, $session);"
NSQ_SOURCE_LINE 00003510 "}"
NSQ_SOURCE_LINE 00003511 ""
NSQ_SOURCE_LINE 00003512 "sub del_session {"
NSQ_SOURCE_LINE 00003513 "    my ($self, $key, $session) = @_;"
NSQ_SOURCE_LINE 00003514 ""
NSQ_SOURCE_LINE 00003515 "    # find all sessions which match given key and session and add to @del"
NSQ_SOURCE_LINE 00003516 "    # if key is given scan only sessions for the key, else all sessions"
NSQ_SOURCE_LINE 00003517 "    my ($head,$inext) = $key"
NSQ_SOURCE_LINE 00003518 "\t? ($self->{shead}{$key},SNEXT) : ($self->{ghead},GNEXT);"
NSQ_SOURCE_LINE 00003519 "    my $v = $head;"
NSQ_SOURCE_LINE 00003520 "    my @del;"
NSQ_SOURCE_LINE 00003521 "    while ($v) {"
NSQ_SOURCE_LINE 00003522 "\tif (!$session) {"
NSQ_SOURCE_LINE 00003523 "\t    push @del,$v"
NSQ_SOURCE_LINE 00003524 "\t} elsif ($v->[SESSION] == $session) {"
NSQ_SOURCE_LINE 00003525 "\t    push @del, $v;"
NSQ_SOURCE_LINE 00003526 "\t    last;"
NSQ_SOURCE_LINE 00003527 "\t}"
NSQ_SOURCE_LINE 00003528 "\t$v = $v->[$inext];"
NSQ_SOURCE_LINE 00003529 "\tlast if $v == $head;"
NSQ_SOURCE_LINE 00003530 "    }"
NSQ_SOURCE_LINE 00003531 "    $DEBUG>=3 && DEBUG(\"del_session(\""
NSQ_SOURCE_LINE 00003532 "\t. ($key ? $key : \"undef\")"
NSQ_SOURCE_LINE 00003533 "\t. ($session ? \",$session) -> \" : \") -> \")"
NSQ_SOURCE_LINE 00003534 "\t.  (~~@del || 'none'));"
NSQ_SOURCE_LINE 00003535 "    for (@del) {"
NSQ_SOURCE_LINE 00003536 "\t_del_entry($self,$_);"
NSQ_SOURCE_LINE 00003537 "\tNet::SSLeay::SESSION_free($_->[SESSION]) if $_->[SESSION];"
NSQ_SOURCE_LINE 00003538 "\t@$_ = ();"
NSQ_SOURCE_LINE 00003539 "    }"
NSQ_SOURCE_LINE 00003540 "    return ~~@del;"
NSQ_SOURCE_LINE 00003541 "}"
NSQ_SOURCE_LINE 00003542 ""
NSQ_SOURCE_LINE 00003543 "sub get_session {"
NSQ_SOURCE_LINE 00003544 "    my ($self, $key, $session) = @_;"
NSQ_SOURCE_LINE 00003545 ""
NSQ_SOURCE_LINE 00003546 "    # find first session for key"
NSQ_SOURCE_LINE 00003547 "    # if $session is given further look for this specific one"
NSQ_SOURCE_LINE 00003548 "    my $v = $self->{shead}{$key};"
NSQ_SOURCE_LINE 00003549 "    if ($session) {"
NSQ_SOURCE_LINE 00003550 "\tmy $shead = $v;"
NSQ_SOURCE_LINE 00003551 "\twhile ($v) {"
NSQ_SOURCE_LINE 00003552 "\t    $DEBUG>=3 && DEBUG(\"check $session - $v->[SESSION]\");"
NSQ_SOURCE_LINE 00003553 "\t    last if $v->[SESSION] == $session;"
NSQ_SOURCE_LINE 00003554 "\t    $v = $v->[SNEXT];"
NSQ_SOURCE_LINE 00003555 "\t    $v = undef if $v == $shead; # session not found"
NSQ_SOURCE_LINE 00003556 "\t}"
NSQ_SOURCE_LINE 00003557 "    }"
NSQ_SOURCE_LINE 00003558 ""
NSQ_SOURCE_LINE 00003559 "    # mark as recent by moving to top so that it gets expired last"
NSQ_SOURCE_LINE 00003560 "    _touch_entry($self,$v) if $v;"
NSQ_SOURCE_LINE 00003561 ""
NSQ_SOURCE_LINE 00003562 "    $DEBUG>=3 && DEBUG(\"get_session($key\""
NSQ_SOURCE_LINE 00003563 "\t. ( $session ? \",$session) -> \" : \") -> \")"
NSQ_SOURCE_LINE 00003564 "\t. ($v? $v->[SESSION]:\"none\"));"
NSQ_SOURCE_LINE 00003565 "    return $v && $v->[SESSION];"
NSQ_SOURCE_LINE 00003566 "}"
NSQ_SOURCE_LINE 00003567 ""
NSQ_SOURCE_LINE 00003568 "sub _add_entry {"
NSQ_SOURCE_LINE 00003569 "    my ($self,$v) = @_;"
NSQ_SOURCE_LINE 00003570 ""
NSQ_SOURCE_LINE 00003571 "    # If there are already sessions for same key add to this list else create"
NSQ_SOURCE_LINE 00003572 "    # a new sublist for this key. Similar for global list."
NSQ_SOURCE_LINE 00003573 "    for("
NSQ_SOURCE_LINE 00003574 "\t[ SNEXT, SPREV, \\$self->{shead}{$v->[KEY]} ],"
NSQ_SOURCE_LINE 00003575 "\t[ GNEXT, GPREV, \\$self->{ghead} ],"
NSQ_SOURCE_LINE 00003576 "    ) {"
NSQ_SOURCE_LINE 00003577 "\tmy ($inext,$iprev,$rhead) = @$_;"
NSQ_SOURCE_LINE 00003578 "\tif ($$rhead) {"
NSQ_SOURCE_LINE 00003579 "\t    # add on top of list"
NSQ_SOURCE_LINE 00003580 "\t    $v->[$inext] = $$rhead;"
NSQ_SOURCE_LINE 00003581 "\t    $v->[$iprev] = ${$rhead}->[$iprev];"
NSQ_SOURCE_LINE 00003582 "\t    ${$rhead}->[$iprev][$inext] = $v;"
NSQ_SOURCE_LINE 00003583 "\t    ${$rhead}->[$iprev] = $v;"
NSQ_SOURCE_LINE 00003584 "\t    $$rhead = $v;"
NSQ_SOURCE_LINE 00003585 "\t} else {"
NSQ_SOURCE_LINE 00003586 "\t    # create a new list"
NSQ_SOURCE_LINE 00003587 "\t    $$rhead = $v->[$inext] = $v->[$iprev] = $v;"
NSQ_SOURCE_LINE 00003588 "\t}"
NSQ_SOURCE_LINE 00003589 "    }"
NSQ_SOURCE_LINE 00003590 ""
NSQ_SOURCE_LINE 00003591 "    $self->{room}--;"
NSQ_SOURCE_LINE 00003592 ""
NSQ_SOURCE_LINE 00003593 "    # drop old entries if necessary"
NSQ_SOURCE_LINE 00003594 "    if ($self->{room}<0) {"
NSQ_SOURCE_LINE 00003595 "\tmy $l = $self->{ghead}[GPREV];"
NSQ_SOURCE_LINE 00003596 "\t_del_entry($self,$l);"
NSQ_SOURCE_LINE 00003597 "\tNet::SSLeay::SESSION_free($l->[SESSION]) if $l->[SESSION];"
NSQ_SOURCE_LINE 00003598 "\t@$l = ();"
NSQ_SOURCE_LINE 00003599 "    }"
NSQ_SOURCE_LINE 00003600 "}"
NSQ_SOURCE_LINE 00003601 ""
NSQ_SOURCE_LINE 00003602 "sub _del_entry {"
NSQ_SOURCE_LINE 00003603 "    my ($self,$v) = @_;"
NSQ_SOURCE_LINE 00003604 "    # Remove element from both key specific list and global list"
NSQ_SOURCE_LINE 00003605 "    # If key specific list is then empty drop it from self.shead"
NSQ_SOURCE_LINE 00003606 "    for("
NSQ_SOURCE_LINE 00003607 "\t[ SNEXT, SPREV, \\$self->{shead}{$v->[KEY]} ],"
NSQ_SOURCE_LINE 00003608 "\t[ GNEXT, GPREV, \\$self->{ghead} ],"
NSQ_SOURCE_LINE 00003609 "    ) {"
NSQ_SOURCE_LINE 00003610 "\tmy ($inext,$iprev,$rhead) = @$_;"
NSQ_SOURCE_LINE 00003611 "\t$$rhead or return;"
NSQ_SOURCE_LINE 00003612 "\t$v->[$inext][$iprev] = $v->[$iprev];"
NSQ_SOURCE_LINE 00003613 "\t$v->[$iprev][$inext] = $v->[$inext];"
NSQ_SOURCE_LINE 00003614 "\tif ($v != $$rhead) {"
NSQ_SOURCE_LINE 00003615 "\t    # not removed from top of list"
NSQ_SOURCE_LINE 00003616 "\t} elsif ($v->[$inext] == $v) {"
NSQ_SOURCE_LINE 00003617 "\t    # was only element on list, drop list"
NSQ_SOURCE_LINE 00003618 "\t    if ($inext == SNEXT) {"
NSQ_SOURCE_LINE 00003619 "\t\tdelete $self->{shead}{$v->[KEY]};"
NSQ_SOURCE_LINE 00003620 "\t    } else {"
NSQ_SOURCE_LINE 00003621 "\t\t$$rhead = undef;"
NSQ_SOURCE_LINE 00003622 "\t    }"
NSQ_SOURCE_LINE 00003623 "\t} else {"
NSQ_SOURCE_LINE 00003624 "\t    # was top element, keep others"
NSQ_SOURCE_LINE 00003625 "\t    $$rhead = $v->[$inext];"
NSQ_SOURCE_LINE 00003626 "\t}"
NSQ_SOURCE_LINE 00003627 "    }"
NSQ_SOURCE_LINE 00003628 "    $self->{room}++;"
NSQ_SOURCE_LINE 00003629 "}"
NSQ_SOURCE_LINE 00003630 ""
NSQ_SOURCE_LINE 00003631 "sub _touch_entry {"
NSQ_SOURCE_LINE 00003632 "    my ($self,$v) = @_;"
NSQ_SOURCE_LINE 00003633 ""
NSQ_SOURCE_LINE 00003634 "    # Put element on top of both global list and key specific list"
NSQ_SOURCE_LINE 00003635 "    # so that it gets expired last when making space in the cache"
NSQ_SOURCE_LINE 00003636 "    for("
NSQ_SOURCE_LINE 00003637 "\t[ SNEXT, SPREV, \\$self->{shead}{$v->[KEY]} ],"
NSQ_SOURCE_LINE 00003638 "\t[ GNEXT, GPREV, \\$self->{ghead} ],"
NSQ_SOURCE_LINE 00003639 "    ) {"
NSQ_SOURCE_LINE 00003640 "\tmy ($inext,$iprev,$rhead) = @$_;"
NSQ_SOURCE_LINE 00003641 "\t$$rhead or die \"entry not in list ($inext)\"; # should not happen"
NSQ_SOURCE_LINE 00003642 "\tnext if $$rhead == $v; # already at top"
NSQ_SOURCE_LINE 00003643 ""
NSQ_SOURCE_LINE 00003644 "\t# remove from current position - like _del_entry"
NSQ_SOURCE_LINE 00003645 "\t$v->[$inext][$iprev] = $v->[$iprev];"
NSQ_SOURCE_LINE 00003646 "\t$v->[$iprev][$inext] = $v->[$inext];"
NSQ_SOURCE_LINE 00003647 ""
NSQ_SOURCE_LINE 00003648 "\t# add on top - like _add_entry"
NSQ_SOURCE_LINE 00003649 "\t$v->[$inext] = $$rhead;"
NSQ_SOURCE_LINE 00003650 "\t$v->[$iprev] = ${$rhead}->[$iprev];"
NSQ_SOURCE_LINE 00003651 "\t${$rhead}->[$iprev][$inext] = $v;"
NSQ_SOURCE_LINE 00003652 "\t${$rhead}->[$iprev] = $v;"
NSQ_SOURCE_LINE 00003653 "\t$$rhead = $v;"
NSQ_SOURCE_LINE 00003654 "    }"
NSQ_SOURCE_LINE 00003655 "}"
NSQ_SOURCE_LINE 00003656 ""
NSQ_SOURCE_LINE 00003657 "sub _dump {"
NSQ_SOURCE_LINE 00003658 "    my $self = shift;"
NSQ_SOURCE_LINE 00003659 ""
NSQ_SOURCE_LINE 00003660 "    my %v2i;"
NSQ_SOURCE_LINE 00003661 "    my $v = $self->{ghead};"
NSQ_SOURCE_LINE 00003662 "    while ($v) {"
NSQ_SOURCE_LINE 00003663 "\texists $v2i{$v} and die;"
NSQ_SOURCE_LINE 00003664 "\t$v2i{$v} = int(keys %v2i);"
NSQ_SOURCE_LINE 00003665 "\t$v = $v->[GNEXT];"
NSQ_SOURCE_LINE 00003666 "\tlast if $v == $self->{ghead};"
NSQ_SOURCE_LINE 00003667 "    }"
NSQ_SOURCE_LINE 00003668 ""
NSQ_SOURCE_LINE 00003669 "    my $out = \"room: $self->{room}\\nghead:\\n\";"
NSQ_SOURCE_LINE 00003670 "    $v = $self->{ghead};"
NSQ_SOURCE_LINE 00003671 "    while ($v) {"
NSQ_SOURCE_LINE 00003672 "\t$out .= sprintf(\" - [%d] <%d,%d> '%s' <%s>\\n\","
NSQ_SOURCE_LINE 00003673 "\t    $v2i{$v}, $v2i{$v->[GPREV]}, $v2i{$v->[GNEXT]},"
NSQ_SOURCE_LINE 00003674 "\t    $v->[KEY], $v->[SESSION]);"
NSQ_SOURCE_LINE 00003675 "\t$v = $v->[GNEXT];"
NSQ_SOURCE_LINE 00003676 "\tlast if $v == $self->{ghead};"
NSQ_SOURCE_LINE 00003677 "    }"
NSQ_SOURCE_LINE 00003678 "    $out .= \"shead:\\n\";"
NSQ_SOURCE_LINE 00003679 "    for my $key (sort keys %{$self->{shead}}) {"
NSQ_SOURCE_LINE 00003680 "\t$out .= \" - '$key'\\n\";"
NSQ_SOURCE_LINE 00003681 "\tmy $shead = $self->{shead}{$key};"
NSQ_SOURCE_LINE 00003682 "\tmy $v = $shead;"
NSQ_SOURCE_LINE 00003683 "\twhile ($v) {"
NSQ_SOURCE_LINE 00003684 "\t    $out .= sprintf(\"   - [%d] <%d,%d> '%s' <%s>\\n\","
NSQ_SOURCE_LINE 00003685 "\t\t$v2i{$v}, $v2i{$v->[SPREV]}, $v2i{$v->[SNEXT]},"
NSQ_SOURCE_LINE 00003686 "\t\t$v->[KEY], $v->[SESSION]);"
NSQ_SOURCE_LINE 00003687 "\t    $v = $v->[SNEXT];"
NSQ_SOURCE_LINE 00003688 "\t    last if $v == $shead;"
NSQ_SOURCE_LINE 00003689 "\t}"
NSQ_SOURCE_LINE 00003690 "    }"
NSQ_SOURCE_LINE 00003691 "    return $out;"
NSQ_SOURCE_LINE 00003692 "}"
NSQ_SOURCE_LINE 00003693 ""
NSQ_SOURCE_LINE 00003694 "sub DESTROY {"
NSQ_SOURCE_LINE 00003695 "    my $self = shift;"
NSQ_SOURCE_LINE 00003696 "    delete $self->{shead};"
NSQ_SOURCE_LINE 00003697 "    my $v = delete $self->{ghead};"
NSQ_SOURCE_LINE 00003698 "    while ($v) {"
NSQ_SOURCE_LINE 00003699 "\tNet::SSLeay::SESSION_free($v->[SESSION]) if $v->[SESSION];"
NSQ_SOURCE_LINE 00003700 "\tmy $next = $v->[GNEXT];"
NSQ_SOURCE_LINE 00003701 "\t@$v = ();"
NSQ_SOURCE_LINE 00003702 "\t$v = $next;"
NSQ_SOURCE_LINE 00003703 "    }"
NSQ_SOURCE_LINE 00003704 "}"
NSQ_SOURCE_LINE 00003705 ""
NSQ_SOURCE_LINE 00003706 ""
NSQ_SOURCE_LINE 00003707 ""
NSQ_SOURCE_LINE 00003708 "package IO::Socket::SSL::OCSP_Cache;"
NSQ_SOURCE_LINE 00003709 ""
NSQ_SOURCE_LINE 00003710 "sub new {"
NSQ_SOURCE_LINE 00003711 "    my ($class,$size) = @_;"
NSQ_SOURCE_LINE 00003712 "    return bless {"
NSQ_SOURCE_LINE 00003713 "\t'' => { _lru => 0, size => $size || 100 }"
NSQ_SOURCE_LINE 00003714 "    },$class;"
NSQ_SOURCE_LINE 00003715 "}"
NSQ_SOURCE_LINE 00003716 "sub get {"
NSQ_SOURCE_LINE 00003717 "    my ($self,$id) = @_;"
NSQ_SOURCE_LINE 00003718 "    my $e = $self->{$id} or return;"
NSQ_SOURCE_LINE 00003719 "    $e->{_lru} = $self->{''}{_lru}++;"
NSQ_SOURCE_LINE 00003720 "    if ( $e->{expire} && time()<$e->{expire}) {"
NSQ_SOURCE_LINE 00003721 "\tdelete $self->{$id};"
NSQ_SOURCE_LINE 00003722 "\treturn;"
NSQ_SOURCE_LINE 00003723 "    }"
NSQ_SOURCE_LINE 00003724 "    if ( $e->{nextUpdate} && time()<$e->{nextUpdate} ) {"
NSQ_SOURCE_LINE 00003725 "\tdelete $self->{$id};"
NSQ_SOURCE_LINE 00003726 "\treturn;"
NSQ_SOURCE_LINE 00003727 "    }"
NSQ_SOURCE_LINE 00003728 "    return $e;"
NSQ_SOURCE_LINE 00003729 "}"
NSQ_SOURCE_LINE 00003730 ""
NSQ_SOURCE_LINE 00003731 "sub put {"
NSQ_SOURCE_LINE 00003732 "    my ($self,$id,$e) = @_;"
NSQ_SOURCE_LINE 00003733 "    $self->{$id} = $e;"
NSQ_SOURCE_LINE 00003734 "    $e->{_lru} = $self->{''}{_lru}++;"
NSQ_SOURCE_LINE 00003735 "    my $del = keys(%$self) - $self->{''}{size};"
NSQ_SOURCE_LINE 00003736 "    if ($del>0) {"
NSQ_SOURCE_LINE 00003737 "\tmy @k = sort { $self->{$a}{_lru} <=> $self->{$b}{_lru} } keys %$self;"
NSQ_SOURCE_LINE 00003738 "\tdelete @{$self}{ splice(@k,0,$del) };"
NSQ_SOURCE_LINE 00003739 "    }"
NSQ_SOURCE_LINE 00003740 "    return $e;"
NSQ_SOURCE_LINE 00003741 "}"
NSQ_SOURCE_LINE 00003742 ""
NSQ_SOURCE_LINE 00003743 "package IO::Socket::SSL::OCSP_Resolver;"
NSQ_SOURCE_LINE 00003744 "*DEBUG = *IO::Socket::SSL::DEBUG;"
NSQ_SOURCE_LINE 00003745 ""
NSQ_SOURCE_LINE 00003746 "# create a new resolver"
NSQ_SOURCE_LINE 00003747 "# $ssl - the ssl object"
NSQ_SOURCE_LINE 00003748 "# $cache - OCSP_Cache object (put,get)"
NSQ_SOURCE_LINE 00003749 "# $failhard - flag if we should fail hard on OCSP problems"
NSQ_SOURCE_LINE 00003750 "# $certs - list of certs to verify"
NSQ_SOURCE_LINE 00003751 "sub new {"
NSQ_SOURCE_LINE 00003752 "    my ($class,$ssl,$cache,$failhard,$certs) = @_;"
NSQ_SOURCE_LINE 00003753 "    my (%todo,$done,$hard_error,@soft_error);"
NSQ_SOURCE_LINE 00003754 "    for my $cert (@$certs) {"
NSQ_SOURCE_LINE 00003755 "\t# skip entries which have no OCSP uri or where we cannot get a certid"
NSQ_SOURCE_LINE 00003756 "\t# (e.g. self-signed or where we don't have the issuer)"
NSQ_SOURCE_LINE 00003757 "\tmy $subj = Net::SSLeay::X509_NAME_oneline(Net::SSLeay::X509_get_subject_name($cert));"
NSQ_SOURCE_LINE 00003758 "\tmy $uri = Net::SSLeay::P_X509_get_ocsp_uri($cert) or do {"
NSQ_SOURCE_LINE 00003759 "\t    $DEBUG>2 && DEBUG(\"no URI for certificate $subj\");"
NSQ_SOURCE_LINE 00003760 "\t    push @soft_error,\"no ocsp_uri for $subj\";"
NSQ_SOURCE_LINE 00003761 "\t    next;"
NSQ_SOURCE_LINE 00003762 "\t};"
