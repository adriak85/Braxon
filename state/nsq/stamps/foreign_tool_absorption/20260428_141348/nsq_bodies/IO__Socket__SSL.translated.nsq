NSQ_SOURCE_LINE 00003877 "\t\t    push @soft_error,$rv->[1].\"; subject: \"."
NSQ_SOURCE_LINE 00003878 "\t\t\tjoin(\"; \",@{$todo->{subj}});"
NSQ_SOURCE_LINE 00003879 "\t\t    $self->{cache}->put($rv->[0],{"
NSQ_SOURCE_LINE 00003880 "\t\t\t%{$rv->[2]},"
NSQ_SOURCE_LINE 00003881 "\t\t\tsoft_error => \"@soft_error\","
NSQ_SOURCE_LINE 00003882 "\t\t\texpire => time()+120,"
NSQ_SOURCE_LINE 00003883 "\t\t    });"
NSQ_SOURCE_LINE 00003884 "\t\t} else {"
NSQ_SOURCE_LINE 00003885 "\t\t    # hard error"
NSQ_SOURCE_LINE 00003886 "\t\t    $self->{cache}->put($rv->[0],$rv->[2]);"
NSQ_SOURCE_LINE 00003887 "\t\t    push @hard_error, $rv->[1].\"; subject: \"."
NSQ_SOURCE_LINE 00003888 "\t\t\tjoin(\"; \",@{$todo->{subj}});"
NSQ_SOURCE_LINE 00003889 "\t\t}"
NSQ_SOURCE_LINE 00003890 "\t    } else {"
NSQ_SOURCE_LINE 00003891 "\t\tpush @miss,$rv->[0];"
NSQ_SOURCE_LINE 00003892 "\t    }"
NSQ_SOURCE_LINE 00003893 "\t}"
NSQ_SOURCE_LINE 00003894 "\tif (@miss && @found) {"
