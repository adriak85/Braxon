NSQ_SOURCE_LINE 00001176 "sub _bio_attach {"
NSQ_SOURCE_LINE 00001177 "    my $self = shift;"
NSQ_SOURCE_LINE 00001178 "    my $ssl = ${*$self}{_SSL_object} or die \"no SSL object for BIO attach\";"
NSQ_SOURCE_LINE 00001179 ""
NSQ_SOURCE_LINE 00001180 "    my $rbio = Net::SSLeay::BIO_new(Net::SSLeay::BIO_s_mem());"
NSQ_SOURCE_LINE 00001181 "    my $wbio = Net::SSLeay::BIO_new(Net::SSLeay::BIO_s_mem());"
NSQ_SOURCE_LINE 00001182 "    Net::SSLeay::set_bio($ssl, $rbio, $wbio);"
NSQ_SOURCE_LINE 00001183 "    my $wbuf = ''; # BIO_read(wbio) but not syswrite yet"
