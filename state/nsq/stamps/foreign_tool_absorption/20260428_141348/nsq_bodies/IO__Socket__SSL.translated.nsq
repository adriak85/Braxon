NSQ_SOURCE_LINE 00000403 "\t    constant->import(NI_NUMERICSERV => 2);"
NSQ_SOURCE_LINE 00000404 "\t}"
NSQ_SOURCE_LINE 00000405 "    }"
NSQ_SOURCE_LINE 00000406 ""
