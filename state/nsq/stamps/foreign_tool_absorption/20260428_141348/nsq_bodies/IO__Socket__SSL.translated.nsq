NSQ_SOURCE_LINE 00002760 "\t\t    \"Please specify hostname with SSL_verifycn_name and better set SSL_verifycn_scheme too.\\n\";"
NSQ_SOURCE_LINE 00002761 "\t\treturn $ok;"
