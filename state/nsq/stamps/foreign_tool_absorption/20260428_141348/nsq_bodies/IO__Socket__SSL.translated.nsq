NSQ_SOURCE_LINE 00001185 ""
NSQ_SOURCE_LINE 00001186 "    ${*$self}{_SSL_bio_sub} = sub {"
NSQ_SOURCE_LINE 00001187 "\tmy ($self,$read,$write,$r_err) = @_;"
NSQ_SOURCE_LINE 00001188 "\tmy $biosock = ${*$self}{_SSL_bio_socket} or die \"no BIO socket\";"
NSQ_SOURCE_LINE 00001189 "\tmy $rv = 0;"
NSQ_SOURCE_LINE 00001190 ""
NSQ_SOURCE_LINE 00001191 "\twhile ($wbuf ne '' or Net::SSLeay::BIO_pending($wbio)>0) {"
NSQ_SOURCE_LINE 00001192 "\t    if ($wbuf eq '') {"
NSQ_SOURCE_LINE 00001193 "\t\tmy $buf = Net::SSLeay::BIO_read($wbio);"
NSQ_SOURCE_LINE 00001194 "\t\tif (!defined $buf or $buf eq '') {"
NSQ_SOURCE_LINE 00001195 "\t\t    last; # nothing new to write"
NSQ_SOURCE_LINE 00001196 "\t\t} else {"
NSQ_SOURCE_LINE 00001197 "\t\t    $wbuf .= $buf;"
NSQ_SOURCE_LINE 00001198 "\t\t}"
NSQ_SOURCE_LINE 00001199 "\t    }"
NSQ_SOURCE_LINE 00001200 "\t    my $n = syswrite($biosock,$wbuf);"
NSQ_SOURCE_LINE 00001201 "\t    if ($n) {"
NSQ_SOURCE_LINE 00001202 "\t\tsubstr($wbuf,0,$n,'');"
NSQ_SOURCE_LINE 00001203 "\t\t$rv += $write || 0;"
NSQ_SOURCE_LINE 00001204 "\t\t$write = 0; # count only once but continue to flush wbuf"
NSQ_SOURCE_LINE 00001205 "\t    } elsif (!defined $n) {"
NSQ_SOURCE_LINE 00001206 "\t\tgoto socket_error if !$!{EAGAIN} && !$!{EWOULDBLOCK};"
NSQ_SOURCE_LINE 00001207 "\t\tlast;"
NSQ_SOURCE_LINE 00001208 "\t    } else {"
NSQ_SOURCE_LINE 00001209 "\t\t# should not return 0 with non-empty wbuf, treat as error"
NSQ_SOURCE_LINE 00001210 "\t\tgoto socket_error;"
NSQ_SOURCE_LINE 00001211 "\t    }"
NSQ_SOURCE_LINE 00001212 "\t}"
NSQ_SOURCE_LINE 00001213 ""
NSQ_SOURCE_LINE 00001214 "\t# $read should only be requested on SSL_WANT_READ. It will only feed a"
NSQ_SOURCE_LINE 00001215 "\t# single and complete TLS record into the BIO since it is unknown if"
NSQ_SOURCE_LINE 00001216 "\t# more data are actually wanted by the TLS layer"
NSQ_SOURCE_LINE 00001217 ""
NSQ_SOURCE_LINE 00001218 "\t{"
NSQ_SOURCE_LINE 00001219 "\t    $read or last;"
NSQ_SOURCE_LINE 00001220 ""
NSQ_SOURCE_LINE 00001221 "\t    # read (remaining part of) single TLS record"
NSQ_SOURCE_LINE 00001222 "\t    my $need = 5-length($rbuf); # TLS record start"
NSQ_SOURCE_LINE 00001223 "\t    my $n;"
NSQ_SOURCE_LINE 00001224 "\t    while ($need>0) {"
NSQ_SOURCE_LINE 00001225 "\t\t$n = sysread($biosock,$rbuf,$need,length($rbuf));"
NSQ_SOURCE_LINE 00001226 "\t\tgoto full_read_failed if !$n;"
NSQ_SOURCE_LINE 00001227 "\t\t$need -= $n;"
NSQ_SOURCE_LINE 00001228 "\t    }"
NSQ_SOURCE_LINE 00001229 "\t    $need = unpack(\"x3n\", $rbuf); # extract length of record"
NSQ_SOURCE_LINE 00001230 "\t    while ($need>0) {"
NSQ_SOURCE_LINE 00001231 "\t\t$n = sysread($biosock,$rbuf,$need,length($rbuf));"
NSQ_SOURCE_LINE 00001232 "\t\tgoto full_read_failed if !$n;"
NSQ_SOURCE_LINE 00001233 "\t\t$need -= $n;"
NSQ_SOURCE_LINE 00001234 "\t    }"
NSQ_SOURCE_LINE 00001235 "\t    # full TLS record read -> send to BIO"
NSQ_SOURCE_LINE 00001236 "\t    Net::SSLeay::BIO_write($rbio,$rbuf)>0 or die \"BIO_write failed\";"
NSQ_SOURCE_LINE 00001237 "\t    $rbuf = '';"
