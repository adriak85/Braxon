NSQ_SOURCE_LINE 00003861 "\t    expire => time()+120,"
NSQ_SOURCE_LINE 00003862 "\t}) for (@{$todo->{ids}});"
NSQ_SOURCE_LINE 00003863 ""
NSQ_SOURCE_LINE 00003864 "    # extract results from response"
NSQ_SOURCE_LINE 00003865 "    } elsif ( my @result ="
