NSQ_SOURCE_LINE 00002654 "sub new {"
NSQ_SOURCE_LINE 00002655 "    my $class = shift;"
NSQ_SOURCE_LINE 00002656 "    #DEBUG( \"$class @_\" );"
NSQ_SOURCE_LINE 00002657 "    my $arg_hash = (ref($_[0]) eq 'HASH') ? $_[0] : {@_};"
NSQ_SOURCE_LINE 00002658 ""
NSQ_SOURCE_LINE 00002659 "    my $is_server = $arg_hash->{SSL_server};"
NSQ_SOURCE_LINE 00002660 "    my %defaults = $is_server"
NSQ_SOURCE_LINE 00002661 "\t? (%DEFAULT_SSL_SERVER_ARGS, %$GLOBAL_SSL_ARGS, %$GLOBAL_SSL_SERVER_ARGS)"
NSQ_SOURCE_LINE 00002662 "\t: (%DEFAULT_SSL_CLIENT_ARGS, %$GLOBAL_SSL_ARGS, %$GLOBAL_SSL_CLIENT_ARGS);"
NSQ_SOURCE_LINE 00002663 "    if ( $defaults{SSL_reuse_ctx} ) {"
