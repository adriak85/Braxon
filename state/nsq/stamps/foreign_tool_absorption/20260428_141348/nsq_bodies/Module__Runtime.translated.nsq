BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Module::Runtime;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "# Don't \"use 5.006\" here, because Perl 5.15.6 will load feature.pm if"
NSQ_SOURCE_LINE 00000004 "# the version check is done that way."
NSQ_SOURCE_LINE 00000005 "BEGIN { require 5.006; }"
NSQ_SOURCE_LINE 00000006 "# Don't \"use warnings\" here, to avoid dependencies.  Do standardise the"
NSQ_SOURCE_LINE 00000007 "# warning status by lexical override; unfortunately the only safe bitset"
NSQ_SOURCE_LINE 00000008 "# to build in is the empty set, equivalent to \"no warnings\"."
NSQ_SOURCE_LINE 00000009 "BEGIN { ${^WARNING_BITS} = \"\"; }"
NSQ_SOURCE_LINE 00000010 "# Don't \"use strict\" here, to avoid dependencies."
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "our $VERSION = '0.018';"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "# Don't use Exporter here, to avoid dependencies."
NSQ_SOURCE_LINE 00000015 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000016 "    $module_name_rx is_module_name is_valid_module_name check_module_name"
NSQ_SOURCE_LINE 00000017 "    module_notional_filename require_module"
NSQ_SOURCE_LINE 00000018 "    use_module use_package_optimistically"
NSQ_SOURCE_LINE 00000019 "    $top_module_spec_rx $sub_module_spec_rx"
NSQ_SOURCE_LINE 00000020 "    is_module_spec is_valid_module_spec check_module_spec"
NSQ_SOURCE_LINE 00000021 "    compose_module_name"
NSQ_SOURCE_LINE 00000022 ");"
NSQ_SOURCE_LINE 00000023 "my %export_ok = map { ($_ => undef) } @EXPORT_OK;"
NSQ_SOURCE_LINE 00000024 "sub import {"
NSQ_SOURCE_LINE 00000025 "    my $me = shift;"
NSQ_SOURCE_LINE 00000026 "    my $callpkg = caller;"
NSQ_SOURCE_LINE 00000027 "    my $errs = \"\";"
NSQ_SOURCE_LINE 00000028 "    foreach(@_) {"
NSQ_SOURCE_LINE 00000029 "        if(exists $export_ok{$_}) {"
NSQ_SOURCE_LINE 00000030 "            # We would need to do \"no strict 'refs'\" here"
NSQ_SOURCE_LINE 00000031 "            # if we had enabled strict at file scope."
NSQ_SOURCE_LINE 00000032 "            if(/\\A\\$(.*)\\z/s) {"
NSQ_SOURCE_LINE 00000033 "                *{$callpkg.\"::\".$1} = \\$$1;"
NSQ_SOURCE_LINE 00000034 "            } else {"
NSQ_SOURCE_LINE 00000035 "                *{$callpkg.\"::\".$_} = \\&$_;"
NSQ_SOURCE_LINE 00000036 "            }"
NSQ_SOURCE_LINE 00000037 "        } else {"
NSQ_SOURCE_LINE 00000038 "            $errs .= \"\\\"$_\\\" is not exported by the $me module\\n\";"
NSQ_SOURCE_LINE 00000039 "        }"
NSQ_SOURCE_LINE 00000040 "    }"
NSQ_SOURCE_LINE 00000041 "    if($errs ne \"\") {"
NSQ_SOURCE_LINE 00000042 "        die sprintf \"%sCan't continue after import errors at %s line %u.\\n\","
NSQ_SOURCE_LINE 00000043 "            $errs, (caller)[1,2];"
NSQ_SOURCE_LINE 00000044 "    }"
NSQ_SOURCE_LINE 00000045 "}"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "# Logic duplicated from Params::Classify.  Duplicating it here avoids"
NSQ_SOURCE_LINE 00000048 "# an extensive and potentially circular dependency graph."
NSQ_SOURCE_LINE 00000049 "sub _is_string($) {"
NSQ_SOURCE_LINE 00000050 "    my($arg) = @_;"
NSQ_SOURCE_LINE 00000051 "    return defined($arg) && ref(\\$arg) eq \"SCALAR\";"
NSQ_SOURCE_LINE 00000052 "}"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "our $module_name_rx = qr{[A-Z_a-z][0-9A-Z_a-z]*(?:::[0-9A-Z_a-z]+)*};"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "my $qual_module_spec_rx ="
NSQ_SOURCE_LINE 00000057 "    qr{(?:/|::)[A-Z_a-z][0-9A-Z_a-z]*(?:(?:/|::)[0-9A-Z_a-z]+)*};"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "my $unqual_top_module_spec_rx ="
NSQ_SOURCE_LINE 00000060 "    qr{[A-Z_a-z][0-9A-Z_a-z]*(?:(?:/|::)[0-9A-Z_a-z]+)*};"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "our $top_module_spec_rx = qr{$qual_module_spec_rx|$unqual_top_module_spec_rx};"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "my $unqual_sub_module_spec_rx = qr{[0-9A-Z_a-z]+(?:(?:/|::)[0-9A-Z_a-z]+)*};"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "our $sub_module_spec_rx = qr{$qual_module_spec_rx|$unqual_sub_module_spec_rx};"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "sub is_module_name($) { _is_string($_[0]) && $_[0] =~ /\\A$module_name_rx\\z/o }"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "*is_valid_module_name = \\&is_module_name;"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "sub check_module_name($) {"
NSQ_SOURCE_LINE 00000073 "    unless(&is_module_name) {"
NSQ_SOURCE_LINE 00000074 "        die +(_is_string($_[0]) ? \"`$_[0]'\" : \"argument\")."
NSQ_SOURCE_LINE 00000075 "            \" is not a module name\\n\";"
NSQ_SOURCE_LINE 00000076 "    }"
NSQ_SOURCE_LINE 00000077 "}"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "sub module_notional_filename($) {"
NSQ_SOURCE_LINE 00000080 "    &check_module_name;"
NSQ_SOURCE_LINE 00000081 "    my($name) = @_;"
NSQ_SOURCE_LINE 00000082 "    $name =~ s{::}{/}g;"
NSQ_SOURCE_LINE 00000083 "    return $name.\".pm\";"
NSQ_SOURCE_LINE 00000084 "}"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "# Don't \"use constant\" here, to avoid dependencies."
NSQ_SOURCE_LINE 00000087 "BEGIN {"
NSQ_SOURCE_LINE 00000088 "    ## no critic (ValuesAndExpressions::ProhibitMismatchedOperators)"
NSQ_SOURCE_LINE 00000089 "    *_WORK_AROUND_HINT_LEAKAGE ="
NSQ_SOURCE_LINE 00000090 "        \"$]\" < 5.011 && !(\"$]\" >= 5.009004 && \"$]\" < 5.010001)"
NSQ_SOURCE_LINE 00000091 "            ? sub(){1} : sub(){0};"
NSQ_SOURCE_LINE 00000092 "    *_WORK_AROUND_BROKEN_MODULE_STATE = \"$]\" < 5.009 ? sub(){1} : sub(){0};"
NSQ_SOURCE_LINE 00000093 "}"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "BEGIN {"
NSQ_SOURCE_LINE 00000096 "    if(_WORK_AROUND_BROKEN_MODULE_STATE) {"
NSQ_SOURCE_LINE 00000097 "        eval <<'END_CODE' or die $@; ## no critic (BuiltinFunctions::ProhibitStringyEval)"
NSQ_SOURCE_LINE 00000098 "            sub Module::Runtime::__GUARD__::DESTROY {"
NSQ_SOURCE_LINE 00000099 "                delete $INC{$_[0]->[0]} if @{$_[0]};"
NSQ_SOURCE_LINE 00000100 "            }"
NSQ_SOURCE_LINE 00000101 "            1;"
NSQ_SOURCE_LINE 00000102 "END_CODE"
NSQ_SOURCE_LINE 00000103 "    }"
NSQ_SOURCE_LINE 00000104 "}"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "sub require_module($) {"
NSQ_SOURCE_LINE 00000107 "    # Localise %^H to work around [perl #68590], where the bug exists"
NSQ_SOURCE_LINE 00000108 "    # and this is a satisfactory workaround.  The bug consists of"
NSQ_SOURCE_LINE 00000109 "    # %^H state leaking into each required module, polluting the"
NSQ_SOURCE_LINE 00000110 "    # module's lexical state."
NSQ_SOURCE_LINE 00000111 "    local %^H if _WORK_AROUND_HINT_LEAKAGE;"
NSQ_SOURCE_LINE 00000112 "    if(_WORK_AROUND_BROKEN_MODULE_STATE) {"
NSQ_SOURCE_LINE 00000113 "        my $notional_filename = &module_notional_filename;"
NSQ_SOURCE_LINE 00000114 "        my $guard = bless([ $notional_filename ],"
NSQ_SOURCE_LINE 00000115 "            \"Module::Runtime::__GUARD__\");"
NSQ_SOURCE_LINE 00000116 "        my $result = CORE::require($notional_filename);"
NSQ_SOURCE_LINE 00000117 "        pop @$guard;"
NSQ_SOURCE_LINE 00000118 "        return $result;"
NSQ_SOURCE_LINE 00000119 "    } else {"
NSQ_SOURCE_LINE 00000120 "        return scalar(CORE::require(&module_notional_filename));"
NSQ_SOURCE_LINE 00000121 "    }"
NSQ_SOURCE_LINE 00000122 "}"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "sub use_module($;$) {"
NSQ_SOURCE_LINE 00000125 "    my($name, $version) = @_;"
NSQ_SOURCE_LINE 00000126 "    require_module($name);"
NSQ_SOURCE_LINE 00000127 "    $name->VERSION($version) if @_ >= 2;"
NSQ_SOURCE_LINE 00000128 "    return $name;"
NSQ_SOURCE_LINE 00000129 "}"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "my $FILE = __FILE__;"
NSQ_SOURCE_LINE 00000132 "sub use_package_optimistically($;$) {"
NSQ_SOURCE_LINE 00000133 "    my($name, $version) = @_;"
NSQ_SOURCE_LINE 00000134 "    my $fn = module_notional_filename($name);"
NSQ_SOURCE_LINE 00000135 "    eval {"
NSQ_SOURCE_LINE 00000136 "        local $SIG{__DIE__};"
NSQ_SOURCE_LINE 00000137 "        require_module($name);"
NSQ_SOURCE_LINE 00000138 "        1;"
NSQ_SOURCE_LINE 00000139 "    } or do {"
NSQ_SOURCE_LINE 00000140 "        die $@ if ("
NSQ_SOURCE_LINE 00000141 "            $@ !~ /\\ACan't locate \\Q$fn\\E .+ at \\Q$FILE\\E line/s ||"
NSQ_SOURCE_LINE 00000142 "            $@ =~ /^Compilation\\ failed\\ in\\ require\\ at\\ \\Q$FILE\\E\\ line/xm"
NSQ_SOURCE_LINE 00000143 "        );"
NSQ_SOURCE_LINE 00000144 "    };"
NSQ_SOURCE_LINE 00000145 "    $name->VERSION($version) if @_ >= 2;"
NSQ_SOURCE_LINE 00000146 "    return $name;"
NSQ_SOURCE_LINE 00000147 "}"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "sub is_module_spec($$) {"
NSQ_SOURCE_LINE 00000150 "    my($prefix, $spec) = @_;"
NSQ_SOURCE_LINE 00000151 "    return _is_string($spec) && ("
NSQ_SOURCE_LINE 00000152 "        $prefix ? $spec =~ /\\A$sub_module_spec_rx\\z/o"
NSQ_SOURCE_LINE 00000153 "                : $spec =~ /\\A$top_module_spec_rx\\z/o"
NSQ_SOURCE_LINE 00000154 "    );"
NSQ_SOURCE_LINE 00000155 "}"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "*is_valid_module_spec = \\&is_module_spec;"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "sub check_module_spec($$) {"
NSQ_SOURCE_LINE 00000160 "    unless(&is_module_spec) {"
NSQ_SOURCE_LINE 00000161 "        die +(_is_string($_[1]) ? \"`$_[1]'\" : \"argument\")."
NSQ_SOURCE_LINE 00000162 "            \" is not a module specification\\n\";"
NSQ_SOURCE_LINE 00000163 "    }"
NSQ_SOURCE_LINE 00000164 "}"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "sub compose_module_name($$) {"
NSQ_SOURCE_LINE 00000167 "    my($prefix, $spec) = @_;"
NSQ_SOURCE_LINE 00000168 "    check_module_name($prefix) if defined $prefix;"
NSQ_SOURCE_LINE 00000169 "    &check_module_spec;"
NSQ_SOURCE_LINE 00000170 "    if($spec =~ s{\\A(?:/|::)}{}) {"
NSQ_SOURCE_LINE 00000171 "        # OK"
NSQ_SOURCE_LINE 00000172 "    } else {"
NSQ_SOURCE_LINE 00000173 "        $spec = $prefix.\"::\".$spec if defined $prefix;"
NSQ_SOURCE_LINE 00000174 "    }"
NSQ_SOURCE_LINE 00000175 "    $spec =~ s{/}{::}g;"
NSQ_SOURCE_LINE 00000176 "    return $spec;"
NSQ_SOURCE_LINE 00000177 "}"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "1;"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "__END__"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "=pod"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "=for :stopwords Andrew Main (Zefram) Main, Graham Knop"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "=head1 NAME"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "Module::Runtime - runtime module handling"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "    use Module::Runtime qw("
NSQ_SOURCE_LINE 00000196 "        $module_name_rx is_module_name check_module_name"
NSQ_SOURCE_LINE 00000197 "        module_notional_filename require_module);"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "    if($module_name =~ /\\A$module_name_rx\\z/o) { ..."
NSQ_SOURCE_LINE 00000200 "    if(is_module_name($module_name)) { ..."
NSQ_SOURCE_LINE 00000201 "    check_module_name($module_name);"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "    $notional_filename = module_notional_filename($module_name);"
NSQ_SOURCE_LINE 00000204 "    require_module($module_name);"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "    use Module::Runtime qw(use_module use_package_optimistically);"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "    $bi = use_module(\"Math::BigInt\", 1.31)->new(\"1_234\");"
NSQ_SOURCE_LINE 00000209 "    $widget = use_package_optimistically(\"Local::Widget\")->new;"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "    use Module::Runtime qw("
NSQ_SOURCE_LINE 00000212 "        $top_module_spec_rx $sub_module_spec_rx"
NSQ_SOURCE_LINE 00000213 "        is_module_spec check_module_spec"
NSQ_SOURCE_LINE 00000214 "        compose_module_name);"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "    if($spec =~ /\\A$top_module_spec_rx\\z/o) { ..."
NSQ_SOURCE_LINE 00000217 "    if($spec =~ /\\A$sub_module_spec_rx\\z/o) { ..."
NSQ_SOURCE_LINE 00000218 "    if(is_module_spec(\"Standard::Prefix\", $spec)) { ..."
NSQ_SOURCE_LINE 00000219 "    check_module_spec(\"Standard::Prefix\", $spec);"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "    $module_name = compose_module_name(\"Standard::Prefix\", $spec);"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "The functions exported by this module deal with runtime handling of"
NSQ_SOURCE_LINE 00000226 "Perl modules, which are normally handled at compile time.  This module"
NSQ_SOURCE_LINE 00000227 "avoids using any other modules, so that it can be used in low-level"
NSQ_SOURCE_LINE 00000228 "infrastructure."
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "The parts of this module that work with module names apply the same syntax"
NSQ_SOURCE_LINE 00000231 "that is used for barewords in Perl source.  In principle this syntax"
NSQ_SOURCE_LINE 00000232 "can vary between versions of Perl, and this module applies the syntax of"
NSQ_SOURCE_LINE 00000233 "the Perl on which it is running.  In practice the usable syntax hasn't"
NSQ_SOURCE_LINE 00000234 "changed yet.  There's some intent for Unicode module names to be supported"
NSQ_SOURCE_LINE 00000235 "in the future, but this hasn't yet amounted to any consistent facility."
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "The functions of this module whose purpose is to load modules include"
NSQ_SOURCE_LINE 00000238 "workarounds for three old Perl core bugs regarding C<require>.  These"
NSQ_SOURCE_LINE 00000239 "workarounds are applied on any Perl version where the bugs exist, except"
NSQ_SOURCE_LINE 00000240 "for a case where one of the bugs cannot be adequately worked around in"
NSQ_SOURCE_LINE 00000241 "pure Perl."
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "=head2 Module name syntax"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "The usable module name syntax has not changed from Perl 5.000 up to"
NSQ_SOURCE_LINE 00000246 "Perl 5.19.8.  The syntax is composed entirely of ASCII characters."
NSQ_SOURCE_LINE 00000247 "From Perl 5.6 onward there has been some attempt to allow the use of"
NSQ_SOURCE_LINE 00000248 "non-ASCII Unicode characters in Perl source, but it was fundamentally"
NSQ_SOURCE_LINE 00000249 "broken (like the entirety of Perl 5.6's Unicode handling) and remained"
NSQ_SOURCE_LINE 00000250 "pretty much entirely unusable until it got some attention in the Perl"
NSQ_SOURCE_LINE 00000251 "5.15 series.  Although Unicode is now consistently accepted by the"
NSQ_SOURCE_LINE 00000252 "parser in some places, it remains broken for module names.  Furthermore,"
NSQ_SOURCE_LINE 00000253 "there has not yet been any work on how to map Unicode module names into"
NSQ_SOURCE_LINE 00000254 "filenames, so in that respect also Unicode module names are unusable."
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "The module name syntax is, precisely: the string must consist of one or"
NSQ_SOURCE_LINE 00000257 "more segments separated by C<::>; each segment must consist of one or more"
NSQ_SOURCE_LINE 00000258 "identifier characters (ASCII alphanumerics plus \"_\"); the first character"
NSQ_SOURCE_LINE 00000259 "of the string must not be a digit.  Thus \"C<IO::File>\", \"C<warnings>\","
NSQ_SOURCE_LINE 00000260 "and \"C<foo::123::x_0>\" are all valid module names, whereas \"C<IO::>\""
NSQ_SOURCE_LINE 00000261 "and \"C<1foo::bar>\" are not.  C<'> separators are not permitted by this"
NSQ_SOURCE_LINE 00000262 "module, though they remain usable in Perl source, being translated to"
NSQ_SOURCE_LINE 00000263 "C<::> in the parser."
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "=head2 Core bugs worked around"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "The first bug worked around is core bug [perl #68590], which causes"
NSQ_SOURCE_LINE 00000268 "lexical state in one file to leak into another that is C<require>d/C<use>d"
NSQ_SOURCE_LINE 00000269 "from it.  This bug is present from Perl 5.6 up to Perl 5.10, and is"
NSQ_SOURCE_LINE 00000270 "fixed in Perl 5.11.0.  From Perl 5.9.4 up to Perl 5.10.0 no satisfactory"
NSQ_SOURCE_LINE 00000271 "workaround is possible in pure Perl.  The workaround means that modules"
NSQ_SOURCE_LINE 00000272 "loaded via this module don't suffer this pollution of their lexical"
NSQ_SOURCE_LINE 00000273 "state.  Modules loaded in other ways, or via this module on the Perl"
NSQ_SOURCE_LINE 00000274 "versions where the pure Perl workaround is impossible, remain vulnerable."
NSQ_SOURCE_LINE 00000275 "The module L<Lexical::SealRequireHints> provides a complete workaround"
NSQ_SOURCE_LINE 00000276 "for this bug."
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "The second bug worked around causes some kinds of failure in module"
NSQ_SOURCE_LINE 00000279 "loading, principally compilation errors in the loaded module, to be"
NSQ_SOURCE_LINE 00000280 "recorded in C<%INC> as if they were successful, so later attempts to load"
NSQ_SOURCE_LINE 00000281 "the same module immediately indicate success.  This bug is present up"
NSQ_SOURCE_LINE 00000282 "to Perl 5.8.9, and is fixed in Perl 5.9.0.  The workaround means that a"
NSQ_SOURCE_LINE 00000283 "compilation error in a module loaded via this module won't be cached as"
NSQ_SOURCE_LINE 00000284 "a success.  Modules loaded in other ways remain liable to produce bogus"
NSQ_SOURCE_LINE 00000285 "C<%INC> entries, and if a bogus entry exists then it will mislead this"
NSQ_SOURCE_LINE 00000286 "module if it is used to re-attempt loading."
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "The third bug worked around causes the wrong context to be seen at"
NSQ_SOURCE_LINE 00000289 "file scope of a loaded module, if C<require> is invoked in a location"
NSQ_SOURCE_LINE 00000290 "that inherits context from a higher scope.  This bug is present up to"
NSQ_SOURCE_LINE 00000291 "Perl 5.11.2, and is fixed in Perl 5.11.3.  The workaround means that"
NSQ_SOURCE_LINE 00000292 "a module loaded via this module will always see the correct context."
NSQ_SOURCE_LINE 00000293 "Modules loaded in other ways remain vulnerable."
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "=head1 REGULAR EXPRESSIONS"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "These regular expressions do not include any anchors, so to check"
NSQ_SOURCE_LINE 00000298 "whether an entire string matches a syntax item you must supply the"
NSQ_SOURCE_LINE 00000299 "anchors yourself."
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "=over"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "=item $module_name_rx"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "Matches a valid Perl module name in bareword syntax."
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "=item $top_module_spec_rx"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "Matches a module specification for use with"
NSQ_SOURCE_LINE 00000310 "L<\"compose_module_name\"|/compose_module_name(PREFIX, SPEC)>."
NSQ_SOURCE_LINE 00000311 "where no prefix is being used."
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "=item $sub_module_spec_rx"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "Matches a module specification for use with"
NSQ_SOURCE_LINE 00000316 "L<\"compose_module_name\"|/compose_module_name(PREFIX, SPEC)>,"
NSQ_SOURCE_LINE 00000317 "where a prefix is being used."
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "=back"
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "=head2 Basic module handling"
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "=over"
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "=item is_module_name(ARG)"
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "Returns a truth value indicating whether I<ARG> is a plain string"
NSQ_SOURCE_LINE 00000330 "satisfying Perl module name syntax as described for L</$module_name_rx>."
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "=item is_valid_module_name(ARG)"
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "Deprecated alias for L<\"is_module_name\"|/is_module_name(ARG)>."
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "=item check_module_name(ARG)"
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "Check whether I<ARG> is a plain string"
NSQ_SOURCE_LINE 00000339 "satisfying Perl module name syntax as described for L</$module_name_rx>."
NSQ_SOURCE_LINE 00000340 "Return normally if it is, or C<die> if it is not."
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "=item module_notional_filename(NAME)"
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "Generates a notional relative filename for a module, which is used in"
NSQ_SOURCE_LINE 00000345 "some Perl core interfaces."
NSQ_SOURCE_LINE 00000346 "The I<NAME> is a string, which should be a valid module name (one or"
NSQ_SOURCE_LINE 00000347 "more C<::>-separated segments).  If it is not a valid name, the function"
NSQ_SOURCE_LINE 00000348 "C<die>s."
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "The notional filename for the named module is generated and returned."
NSQ_SOURCE_LINE 00000351 "This filename is always in Unix style, with C</> directory separators"
NSQ_SOURCE_LINE 00000352 "and a C<.pm> suffix.  This kind of filename can be used as an argument to"
NSQ_SOURCE_LINE 00000353 "C<require>, and is the key that appears in C<%INC> to identify a module,"
NSQ_SOURCE_LINE 00000354 "regardless of actual local filename syntax."
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "=item require_module(NAME)"
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 "This is essentially the bareword form of C<require>, in runtime form."
NSQ_SOURCE_LINE 00000359 "The I<NAME> is a string, which should be a valid module name (one or"
NSQ_SOURCE_LINE 00000360 "more C<::>-separated segments).  If it is not a valid name, the function"
NSQ_SOURCE_LINE 00000361 "C<die>s."
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "The module specified by I<NAME> is loaded, if it hasn't been already,"
NSQ_SOURCE_LINE 00000364 "in the manner of the bareword form of C<require>.  That means that a"
NSQ_SOURCE_LINE 00000365 "search through C<@INC> is performed, and a byte-compiled form of the"
NSQ_SOURCE_LINE 00000366 "module will be used if available."
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 "The return value is as for C<require>.  That is, it is the value returned"
NSQ_SOURCE_LINE 00000369 "by the module itself if the module is loaded anew, or C<1> if the module"
NSQ_SOURCE_LINE 00000370 "was already loaded."
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "=back"
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "=head2 Structured module use"
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "=over"
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 "=item use_module(NAME[, VERSION])"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "This is essentially C<use> in runtime form, but without the importing"
NSQ_SOURCE_LINE 00000381 "feature (which is fundamentally a compile-time thing).  The I<NAME> is"
NSQ_SOURCE_LINE 00000382 "handled just like in C<require_module> above: it must be a module name,"
NSQ_SOURCE_LINE 00000383 "and the named module is loaded as if by the bareword form of C<require>."
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "If a I<VERSION> is specified, the C<VERSION> method of the loaded module is"
NSQ_SOURCE_LINE 00000386 "called with the specified I<VERSION> as an argument.  This normally serves to"
NSQ_SOURCE_LINE 00000387 "ensure that the version loaded is at least the version required.  This is"
NSQ_SOURCE_LINE 00000388 "the same functionality provided by the I<VERSION> parameter of C<use>."
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "On success, the name of the module is returned.  This is unlike"
NSQ_SOURCE_LINE 00000391 "L<\"require_module\"|/require_module(NAME)>, and is done so that the entire call"
NSQ_SOURCE_LINE 00000392 "to L<\"use_module\"|/use_module(NAME[, VERSION])> can be used as a class name to"
NSQ_SOURCE_LINE 00000393 "call a constructor, as in the example in the synopsis."
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "=item use_package_optimistically(NAME[, VERSION])"
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "This is an analogue of L<\"use_module\"|/use_module(NAME[, VERSION])> for"
NSQ_SOURCE_LINE 00000398 "the situation where there is"
NSQ_SOURCE_LINE 00000399 "uncertainty as to whether a package/class is defined in its own module"
NSQ_SOURCE_LINE 00000400 "or by some other means.  It attempts to arrange for the named package to"
NSQ_SOURCE_LINE 00000401 "be available, either by loading a module or by doing nothing and hoping."
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "An attempt is made to load the named module (as if by the bareword form"
NSQ_SOURCE_LINE 00000404 "of C<require>).  If the module cannot be found then it is assumed that"
NSQ_SOURCE_LINE 00000405 "the package was actually already loaded by other means, and no error"
NSQ_SOURCE_LINE 00000406 "is signaled.  That's the optimistic bit."
NSQ_SOURCE_LINE 00000407 ""
NSQ_SOURCE_LINE 00000408 "I<Warning:> this optional module loading is liable to cause unreliable"
NSQ_SOURCE_LINE 00000409 "behaviour, including security problems.  It interacts especially badly"
NSQ_SOURCE_LINE 00000410 "with having C<.> in C<@INC>, which was the default state of affairs in"
NSQ_SOURCE_LINE 00000411 "Perls prior to 5.25.11.  If a package is actually defined by some means"
NSQ_SOURCE_LINE 00000412 "other than a module, then applying this function to it causes a spurious"
NSQ_SOURCE_LINE 00000413 "attempt to load a module that is expected to be non-existent.  If a"
NSQ_SOURCE_LINE 00000414 "module actually exists under that name then it will be unintentionally"
NSQ_SOURCE_LINE 00000415 "loaded.  If C<.> is in C<@INC> and this code is ever run with the current"
NSQ_SOURCE_LINE 00000416 "directory being one writable by a malicious user (such as F</tmp>), then"
NSQ_SOURCE_LINE 00000417 "the malicious user can easily cause the victim to run arbitrary code, by"
NSQ_SOURCE_LINE 00000418 "creating a module file under the predictable spuriously-loaded name in the"
NSQ_SOURCE_LINE 00000419 "writable directory.  Generally, optional module loading should be avoided."
NSQ_SOURCE_LINE 00000420 ""
NSQ_SOURCE_LINE 00000421 "This is mostly the same operation that is performed by the L<base> pragma"
NSQ_SOURCE_LINE 00000422 "to ensure that the specified base classes are available.  The behaviour"
NSQ_SOURCE_LINE 00000423 "of L<base> was simplified in version 2.18, and later improved in version"
NSQ_SOURCE_LINE 00000424 "2.20, and on both occasions this function changed to match."
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 "If a I<VERSION> is specified, the C<VERSION> method of the loaded package is"
NSQ_SOURCE_LINE 00000427 "called with the specified I<VERSION> as an argument.  This normally serves"
NSQ_SOURCE_LINE 00000428 "to ensure that the version loaded is at least the version required."
NSQ_SOURCE_LINE 00000429 "On success, the name of the package is returned.  These aspects of the"
NSQ_SOURCE_LINE 00000430 "function work just like L<\"use_module\"|/use_module(NAME[, VERSION])>."
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 "=back"
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 "=head2 Module name composition"
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 "=over"
NSQ_SOURCE_LINE 00000437 ""
NSQ_SOURCE_LINE 00000438 "=item is_module_spec(PREFIX, SPEC)"
NSQ_SOURCE_LINE 00000439 ""
NSQ_SOURCE_LINE 00000440 "Returns a truth value indicating"
NSQ_SOURCE_LINE 00000441 "whether I<SPEC> is valid input for"
NSQ_SOURCE_LINE 00000442 "L<\"compose_module_name\"|/compose_module_name(PREFIX, SPEC)>."
NSQ_SOURCE_LINE 00000443 "See below for what that entails.  Whether a I<PREFIX> is supplied affects"
NSQ_SOURCE_LINE 00000444 "the validity of I<SPEC>, but the exact value of the prefix is unimportant,"
NSQ_SOURCE_LINE 00000445 "so this function treats I<PREFIX> as a truth value."
NSQ_SOURCE_LINE 00000446 ""
NSQ_SOURCE_LINE 00000447 "=item is_valid_module_spec(PREFIX, SPEC)"
NSQ_SOURCE_LINE 00000448 ""
NSQ_SOURCE_LINE 00000449 "Deprecated alias for L<\"is_module_spec\"|/is_module_spec(PREFIX, SPEC)>."
NSQ_SOURCE_LINE 00000450 ""
NSQ_SOURCE_LINE 00000451 "=item check_module_spec(PREFIX, SPEC)"
NSQ_SOURCE_LINE 00000452 ""
NSQ_SOURCE_LINE 00000453 "Check whether I<SPEC> is valid input for"
NSQ_SOURCE_LINE 00000454 "L<\"compose_module_name\"|/compose_module_name(PREFIX, SPEC)>."
NSQ_SOURCE_LINE 00000455 "Return normally if it is, or C<die> if it is not."
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "=item compose_module_name(PREFIX, SPEC)"
NSQ_SOURCE_LINE 00000458 ""
NSQ_SOURCE_LINE 00000459 "This function is intended to make it more convenient for a user to specify"
NSQ_SOURCE_LINE 00000460 "a Perl module name at runtime.  Users have greater need for abbreviations"
NSQ_SOURCE_LINE 00000461 "and context-sensitivity than programmers, and Perl module names get a"
NSQ_SOURCE_LINE 00000462 "little unwieldy.  I<SPEC> is what the user specifies, and this function"
NSQ_SOURCE_LINE 00000463 "translates it into a module name in standard form, which it returns."
NSQ_SOURCE_LINE 00000464 ""
NSQ_SOURCE_LINE 00000465 "I<SPEC> has syntax approximately that of a standard module name: it"
NSQ_SOURCE_LINE 00000466 "should consist of one or more name segments, each of which consists"
NSQ_SOURCE_LINE 00000467 "of one or more identifier characters.  However, C</> is permitted as a"
NSQ_SOURCE_LINE 00000468 "separator, in addition to the standard C<::>.  The two separators are"
NSQ_SOURCE_LINE 00000469 "entirely interchangeable."
NSQ_SOURCE_LINE 00000470 ""
NSQ_SOURCE_LINE 00000471 "Additionally, if I<PREFIX> is not C<undef> then it must be a module"
NSQ_SOURCE_LINE 00000472 "name in standard form, and it is prefixed to the user-specified name."
NSQ_SOURCE_LINE 00000473 "The user can inhibit the prefix addition by starting I<SPEC> with a"
NSQ_SOURCE_LINE 00000474 "separator (either C</> or C<::>)."
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 "=back"
NSQ_SOURCE_LINE 00000477 ""
NSQ_SOURCE_LINE 00000478 "=head1 BUGS"
NSQ_SOURCE_LINE 00000479 ""
NSQ_SOURCE_LINE 00000480 "On Perl versions 5.7.2 to 5.8.8, if C<require> is overridden by the"
NSQ_SOURCE_LINE 00000481 "C<CORE::GLOBAL> mechanism, it is likely to break the heuristics used by"
NSQ_SOURCE_LINE 00000482 "L<\"use_package_optimistically\"|/use_package_optimistically(NAME[, VERSION])>,"
NSQ_SOURCE_LINE 00000483 "making it signal an error for a missing"
NSQ_SOURCE_LINE 00000484 "module rather than assume that it was already loaded.  From Perl 5.8.9"
NSQ_SOURCE_LINE 00000485 "onward, and on 5.7.1 and earlier, this module can avoid being confused"
NSQ_SOURCE_LINE 00000486 "by such an override.  On the affected versions, a C<require> override"
NSQ_SOURCE_LINE 00000487 "might be installed by L<Lexical::SealRequireHints>, if something requires"
NSQ_SOURCE_LINE 00000488 "its bugfix but for some reason its XS implementation isn't available."
NSQ_SOURCE_LINE 00000489 ""
NSQ_SOURCE_LINE 00000490 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000491 ""
NSQ_SOURCE_LINE 00000492 "=over 4"
NSQ_SOURCE_LINE 00000493 ""
