BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "# ABSTRACT: Report errors from perspective of caller of a \"clan\" of modules"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "##"
NSQ_SOURCE_LINE 00000004 "## Based on Carp.pm from Perl 5.005_03."
NSQ_SOURCE_LINE 00000005 "## Last modified 22-May-2016 by Kent Fredric."
NSQ_SOURCE_LINE 00000006 "## Should be reasonably backwards compatible."
NSQ_SOURCE_LINE 00000007 "##"
NSQ_SOURCE_LINE 00000008 "## This module is free software and can"
NSQ_SOURCE_LINE 00000009 "## be used, modified and redistributed"
NSQ_SOURCE_LINE 00000010 "## under the same terms as Perl itself."
NSQ_SOURCE_LINE 00000011 "##"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "@DB::args = ();    # Avoid warning \"used only once\" in Perl 5.003"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "package Carp::Clan; # git description: v6.07-8-g8b5dba6"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "use strict;"
NSQ_SOURCE_LINE 00000018 "use overload ();"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "# Original comments by Andy Wardley <abw@kfs.org> 09-Apr-1998."
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "# The $Max(EvalLen|(Arg(Len|Nums)) variables are used to specify how"
NSQ_SOURCE_LINE 00000023 "# the eval text and function arguments should be formatted when printed."
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "our $MaxEvalLen = 0;     # How much eval '...text...' to show. 0 = all."
NSQ_SOURCE_LINE 00000026 "our $MaxArgLen  = 64;    # How much of each argument to print. 0 = all."
NSQ_SOURCE_LINE 00000027 "our $MaxArgNums = 8;     # How many arguments to print.        0 = all."
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "our $Verbose = 0;        # If true then make _shortmsg call _longmsg instead."
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "our $VERSION = '6.08';"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "# _longmsg() crawls all the way up the stack reporting on all the function"
NSQ_SOURCE_LINE 00000034 "# calls made. The error string, $error, is originally constructed from the"
NSQ_SOURCE_LINE 00000035 "# arguments passed into _longmsg() via confess(), cluck() or _shortmsg()."
NSQ_SOURCE_LINE 00000036 "# This gets appended with the stack trace messages which are generated for"
NSQ_SOURCE_LINE 00000037 "# each function call on the stack."
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "sub _longmsg {"
NSQ_SOURCE_LINE 00000040 "    return (@_) if ( ref $_[0] );"
NSQ_SOURCE_LINE 00000041 "    local $_;        # Protect surrounding program - just in case..."
NSQ_SOURCE_LINE 00000042 "    my ( $pack, $file, $line, $sub, $hargs, $eval, $require, @parms, $push );"
NSQ_SOURCE_LINE 00000043 "    my $error = join( '', @_ );"
NSQ_SOURCE_LINE 00000044 "    my $msg   = '';"
NSQ_SOURCE_LINE 00000045 "    my $i     = 0;"
NSQ_SOURCE_LINE 00000046 "    while ("
NSQ_SOURCE_LINE 00000047 "        do {"
NSQ_SOURCE_LINE 00000048 "            {"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "                package # hide from PAUSE"
NSQ_SOURCE_LINE 00000051 "                    DB;"
NSQ_SOURCE_LINE 00000052 "                ( $pack, $file, $line, $sub, $hargs, undef, $eval, $require )"
NSQ_SOURCE_LINE 00000053 "                    = caller( $i++ )"
NSQ_SOURCE_LINE 00000054 "            }"
NSQ_SOURCE_LINE 00000055 "        }"
NSQ_SOURCE_LINE 00000056 "        )"
NSQ_SOURCE_LINE 00000057 "    {"
NSQ_SOURCE_LINE 00000058 "        next if ( $pack eq 'Carp::Clan' );"
NSQ_SOURCE_LINE 00000059 "        if ( $error eq '' ) {"
NSQ_SOURCE_LINE 00000060 "            if ( defined $eval ) {"
NSQ_SOURCE_LINE 00000061 "                $eval =~ s/([\\\\\\'])/\\\\$1/g unless ($require); # Escape \\ and '"
NSQ_SOURCE_LINE 00000062 "                $eval"
NSQ_SOURCE_LINE 00000063 "                    =~ s/([\\x00-\\x1F\\x7F-\\xFF])/sprintf(\"\\\\x%02X\",ord($1))/eg;"
NSQ_SOURCE_LINE 00000064 "                substr( $eval, $MaxEvalLen ) = '...'"
NSQ_SOURCE_LINE 00000065 "                    if ( $MaxEvalLen && length($eval) > $MaxEvalLen );"
NSQ_SOURCE_LINE 00000066 "                if   ($require) { $sub = \"require $eval\"; }"
NSQ_SOURCE_LINE 00000067 "                else            { $sub = \"eval '$eval'\"; }"
NSQ_SOURCE_LINE 00000068 "            }"
NSQ_SOURCE_LINE 00000069 "            elsif ( $sub eq '(eval)' ) { $sub = 'eval {...}'; }"
NSQ_SOURCE_LINE 00000070 "            else {"
NSQ_SOURCE_LINE 00000071 "                @parms = ();"
NSQ_SOURCE_LINE 00000072 "                if ($hargs) {"
NSQ_SOURCE_LINE 00000073 "                    $push  = 0;"
NSQ_SOURCE_LINE 00000074 "                    @parms = @DB::args"
NSQ_SOURCE_LINE 00000075 "                        ;    # We may trash some of the args so we take a copy"
NSQ_SOURCE_LINE 00000076 "                    if ( $MaxArgNums and @parms > $MaxArgNums ) {"
NSQ_SOURCE_LINE 00000077 "                        $#parms = $MaxArgNums;"
NSQ_SOURCE_LINE 00000078 "                        pop(@parms);"
NSQ_SOURCE_LINE 00000079 "                        $push = 1;"
NSQ_SOURCE_LINE 00000080 "                    }"
NSQ_SOURCE_LINE 00000081 "                    for (@parms) {"
NSQ_SOURCE_LINE 00000082 "                        if ( defined $_ ) {"
NSQ_SOURCE_LINE 00000083 "                            if ( ref $_ ) {"
NSQ_SOURCE_LINE 00000084 "                                $_ = overload::StrVal($_);"
NSQ_SOURCE_LINE 00000085 "                            }"
NSQ_SOURCE_LINE 00000086 "                            else {"
NSQ_SOURCE_LINE 00000087 "                                unless ( /^-?\\d+(?:\\.\\d+(?:[eE][+-]\\d+)?)?$/"
NSQ_SOURCE_LINE 00000088 "                                    )    # Looks numeric"
NSQ_SOURCE_LINE 00000089 "                                {"
NSQ_SOURCE_LINE 00000090 "                                    s/([\\\\\\'])/\\\\$1/g;    # Escape \\ and '"
NSQ_SOURCE_LINE 00000091 "                                    s/([\\x00-\\x1F\\x7F-\\xFF])/sprintf(\"\\\\x%02X\",ord($1))/eg;"
NSQ_SOURCE_LINE 00000092 "                                    substr( $_, $MaxArgLen ) = '...'"
NSQ_SOURCE_LINE 00000093 "                                        if ( $MaxArgLen"
NSQ_SOURCE_LINE 00000094 "                                        and length($_) > $MaxArgLen );"
NSQ_SOURCE_LINE 00000095 "                                    $_ = \"'$_'\";"
NSQ_SOURCE_LINE 00000096 "                                }"
NSQ_SOURCE_LINE 00000097 "                            }"
NSQ_SOURCE_LINE 00000098 "                        }"
NSQ_SOURCE_LINE 00000099 "                        else { $_ = 'undef'; }"
NSQ_SOURCE_LINE 00000100 "                    }"
NSQ_SOURCE_LINE 00000101 "                    push( @parms, '...' ) if ($push);"
NSQ_SOURCE_LINE 00000102 "                }"
NSQ_SOURCE_LINE 00000103 "                $sub .= '(' . join( ', ', @parms ) . ')';"
NSQ_SOURCE_LINE 00000104 "            }"
NSQ_SOURCE_LINE 00000105 "            if ( $msg eq '' ) { $msg = \"$sub called\"; }"
NSQ_SOURCE_LINE 00000106 "            else              { $msg .= \"\\t$sub called\"; }"
NSQ_SOURCE_LINE 00000107 "        }"
NSQ_SOURCE_LINE 00000108 "        else {"
NSQ_SOURCE_LINE 00000109 "            $msg = quotemeta($sub);"
NSQ_SOURCE_LINE 00000110 "            if ( $error =~ /\\b$msg\\b/ ) { $msg = $error; }"
NSQ_SOURCE_LINE 00000111 "            else {"
NSQ_SOURCE_LINE 00000112 "                if ( $sub =~ /::/ ) { $msg = \"$sub(): $error\"; }"
NSQ_SOURCE_LINE 00000113 "                else                { $msg = \"$sub: $error\"; }"
NSQ_SOURCE_LINE 00000114 "            }"
NSQ_SOURCE_LINE 00000115 "        }"
NSQ_SOURCE_LINE 00000116 "        $msg .= \" at $file line $line\\n\" unless ( $error =~ /\\n$/ );"
NSQ_SOURCE_LINE 00000117 "        $error = '';"
NSQ_SOURCE_LINE 00000118 "    }"
NSQ_SOURCE_LINE 00000119 "    $msg ||= $error;"
NSQ_SOURCE_LINE 00000120 "    $msg =~ tr/\\0//d;  # Circumvent die's incorrect handling of NUL characters"
NSQ_SOURCE_LINE 00000121 "    $msg;"
NSQ_SOURCE_LINE 00000122 "}"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "# _shortmsg() is called by carp() and croak() to skip all the way up to"
NSQ_SOURCE_LINE 00000125 "# the top-level caller's package and report the error from there. confess()"
NSQ_SOURCE_LINE 00000126 "# and cluck() generate a full stack trace so they call _longmsg() to"
NSQ_SOURCE_LINE 00000127 "# generate that. In verbose mode _shortmsg() calls _longmsg() so you"
NSQ_SOURCE_LINE 00000128 "# always get a stack trace."
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "sub _shortmsg {"
NSQ_SOURCE_LINE 00000131 "    my $pattern = shift;"
NSQ_SOURCE_LINE 00000132 "    my $verbose = shift;"
NSQ_SOURCE_LINE 00000133 "    return (@_) if ( ref $_[0] );"
NSQ_SOURCE_LINE 00000134 "    goto &_longmsg if ( $Verbose or $verbose );"
NSQ_SOURCE_LINE 00000135 "    my ( $pack, $file, $line, $sub );"
NSQ_SOURCE_LINE 00000136 "    my $error = join( '', @_ );"
NSQ_SOURCE_LINE 00000137 "    my $msg   = '';"
NSQ_SOURCE_LINE 00000138 "    my $i     = 0;"
NSQ_SOURCE_LINE 00000139 "    while ( ( $pack, $file, $line, $sub ) = caller( $i++ ) ) {"
NSQ_SOURCE_LINE 00000140 "        next if ( $pack eq 'Carp::Clan' or $pack =~ /$pattern/ );"
NSQ_SOURCE_LINE 00000141 "        if ( $error eq '' ) { $msg = \"$sub() called\"; }"
NSQ_SOURCE_LINE 00000142 "        else {"
NSQ_SOURCE_LINE 00000143 "            $msg = quotemeta($sub);"
NSQ_SOURCE_LINE 00000144 "            if ( $error =~ /\\b$msg\\b/ ) { $msg = $error; }"
NSQ_SOURCE_LINE 00000145 "            else {"
NSQ_SOURCE_LINE 00000146 "                if ( $sub =~ /::/ ) { $msg = \"$sub(): $error\"; }"
NSQ_SOURCE_LINE 00000147 "                else                { $msg = \"$sub: $error\"; }"
NSQ_SOURCE_LINE 00000148 "            }"
NSQ_SOURCE_LINE 00000149 "        }"
NSQ_SOURCE_LINE 00000150 "        $msg .= \" at $file line $line\\n\" unless ( $error =~ /\\n$/ );"
NSQ_SOURCE_LINE 00000151 "        $msg =~ tr/\\0//d; # Circumvent die's incorrect handling of NUL characters"
NSQ_SOURCE_LINE 00000152 "        return $msg;"
NSQ_SOURCE_LINE 00000153 "    }"
NSQ_SOURCE_LINE 00000154 "    goto &_longmsg;"
NSQ_SOURCE_LINE 00000155 "}"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "# In the two identical regular expressions (immediately after the two occurrences of"
NSQ_SOURCE_LINE 00000158 "# \"quotemeta\") above, the \"\\b ... \\b\" helps to avoid confusion between function names"
NSQ_SOURCE_LINE 00000159 "# which are prefixes of each other, e.g. \"My::Class::print\" and \"My::Class::println\"."
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "# The following four functions call _longmsg() or _shortmsg() depending on"
NSQ_SOURCE_LINE 00000162 "# whether they should generate a full stack trace (confess() and cluck())"
NSQ_SOURCE_LINE 00000163 "# or simply report the caller's package (croak() and carp()), respectively."
NSQ_SOURCE_LINE 00000164 "# confess() and croak() die, carp() and cluck() warn."
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "# Following code kept for calls with fully qualified subroutine names:"
NSQ_SOURCE_LINE 00000167 "# (For backward compatibility with the original Carp.pm)"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "sub croak {"
NSQ_SOURCE_LINE 00000170 "    my $callpkg = caller(0);"
NSQ_SOURCE_LINE 00000171 "    my $pattern = ( $callpkg eq 'main' ) ? '^:::' : \"^$callpkg\\$\";"
NSQ_SOURCE_LINE 00000172 "    die _shortmsg( $pattern, 0, @_ );"
NSQ_SOURCE_LINE 00000173 "}"
NSQ_SOURCE_LINE 00000174 "sub confess { die _longmsg(@_); }"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "sub carp {"
NSQ_SOURCE_LINE 00000177 "    my $callpkg = caller(0);"
NSQ_SOURCE_LINE 00000178 "    my $pattern = ( $callpkg eq 'main' ) ? '^:::' : \"^$callpkg\\$\";"
NSQ_SOURCE_LINE 00000179 "    warn _shortmsg( $pattern, 0, @_ );"
NSQ_SOURCE_LINE 00000180 "}"
NSQ_SOURCE_LINE 00000181 "sub cluck { warn _longmsg(@_); }"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "# The following method imports a different closure for every caller."
NSQ_SOURCE_LINE 00000184 "# I.e., different modules can use this module at the same time"
NSQ_SOURCE_LINE 00000185 "# and in parallel and still use different patterns."
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "sub import {"
NSQ_SOURCE_LINE 00000188 "    my $pkg     = shift;"
NSQ_SOURCE_LINE 00000189 "    my $callpkg = caller(0);"
NSQ_SOURCE_LINE 00000190 "    my $pattern = ( $callpkg eq 'main' ) ? '^:::' : \"^$callpkg\\$\";"
NSQ_SOURCE_LINE 00000191 "    my $verbose = 0;"
NSQ_SOURCE_LINE 00000192 "    my $item;"
NSQ_SOURCE_LINE 00000193 "    my $file;"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "    for $item (@_) {"
NSQ_SOURCE_LINE 00000196 "        if ( $item =~ /^\\d/ ) {"
NSQ_SOURCE_LINE 00000197 "            if ( $VERSION < $item ) {"
NSQ_SOURCE_LINE 00000198 "                $file = \"$pkg.pm\";"
NSQ_SOURCE_LINE 00000199 "                $file =~ s!::!/!g;"
NSQ_SOURCE_LINE 00000200 "                $file = $INC{$file};"
NSQ_SOURCE_LINE 00000201 "                die _shortmsg( '^:::', 0,"
NSQ_SOURCE_LINE 00000202 "                    \"$pkg $item required--this is only version $VERSION ($file)\""
NSQ_SOURCE_LINE 00000203 "                );"
NSQ_SOURCE_LINE 00000204 "            }"
NSQ_SOURCE_LINE 00000205 "        }"
NSQ_SOURCE_LINE 00000206 "        elsif ( $item =~ /^verbose$/i ) { $verbose = 1; }"
NSQ_SOURCE_LINE 00000207 "        else                            { $pattern = $item; }"
NSQ_SOURCE_LINE 00000208 "    }"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "    eval { $pattern = qr/$pattern/ };"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "    if ($@) {"
NSQ_SOURCE_LINE 00000213 "        $@ =~ s/\\s+$//;"
NSQ_SOURCE_LINE 00000214 "        $@ =~ s/\\s+at\\s.+$//;"
NSQ_SOURCE_LINE 00000215 "        die _shortmsg( '^:::', 0, $@ );"
NSQ_SOURCE_LINE 00000216 "    }"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "    {"
NSQ_SOURCE_LINE 00000219 "        local ($^W) = 0;"
NSQ_SOURCE_LINE 00000220 "        no strict \"refs\";"
NSQ_SOURCE_LINE 00000221 "        *{\"${callpkg}::croak\"}   = sub { die  _shortmsg( $pattern, $verbose, @_ ); };"
NSQ_SOURCE_LINE 00000222 "        *{\"${callpkg}::confess\"} = sub { die  _longmsg (                     @_ ); };"
NSQ_SOURCE_LINE 00000223 "        *{\"${callpkg}::carp\"}    = sub { warn _shortmsg( $pattern, $verbose, @_ ); };"
NSQ_SOURCE_LINE 00000224 "        *{\"${callpkg}::cluck\"}   = sub { warn _longmsg (                     @_ ); };"
NSQ_SOURCE_LINE 00000225 "    }"
NSQ_SOURCE_LINE 00000226 "}"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "1;"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "__END__"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "=pod"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "=head1 NAME"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "Carp::Clan - Report errors from perspective of caller of a \"clan\" of modules"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "=head1 VERSION"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "version 6.08"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 " carp    - warn of errors (from perspective of caller)"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 " cluck   - warn of errors with stack backtrace"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 " croak   - die of errors (from perspective of caller)"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 " confess - die of errors with stack backtrace"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "    use Carp::Clan qw(^MyClan::);"
NSQ_SOURCE_LINE 00000255 "    croak \"We're outta here!\";"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "    use Carp::Clan;"
NSQ_SOURCE_LINE 00000258 "    confess \"This is how we got here!\";"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "This module is based on \"C<Carp.pm>\" from Perl 5.005_03. It has been"
NSQ_SOURCE_LINE 00000263 "modified to skip all package names matching the pattern given in"
NSQ_SOURCE_LINE 00000264 "the \"use\" statement inside the \"C<qw()>\" term (or argument list)."
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "Suppose you have a family of modules or classes named \"Pack::A\","
NSQ_SOURCE_LINE 00000267 "\"Pack::B\" and so on, and each of them uses \"C<Carp::Clan qw(^Pack::);>\""
NSQ_SOURCE_LINE 00000268 "(or at least the one in which the error or warning gets raised)."
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "Thus when for example your script \"tool.pl\" calls module \"Pack::A\","
NSQ_SOURCE_LINE 00000271 "and module \"Pack::A\" calls module \"Pack::B\", an exception raised in"
NSQ_SOURCE_LINE 00000272 "module \"Pack::B\" will appear to have originated in \"tool.pl\" where"
NSQ_SOURCE_LINE 00000273 "\"Pack::A\" was called, and not in \"Pack::A\" where \"Pack::B\" was called,"
NSQ_SOURCE_LINE 00000274 "as the unmodified \"C<Carp.pm>\" would try to make you believe C<:-)>."
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "This works similarly if \"Pack::B\" calls \"Pack::C\" where the"
NSQ_SOURCE_LINE 00000277 "exception is raised, et cetera."
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "In other words, this blames all errors in the \"C<Pack::*>\" modules"
NSQ_SOURCE_LINE 00000280 "on the user of these modules, i.e., on you. C<;-)>"
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "The skipping of a clan (or family) of packages according to a pattern"
NSQ_SOURCE_LINE 00000283 "describing its members is necessary in cases where these modules are"
NSQ_SOURCE_LINE 00000284 "not classes derived from each other (and thus when examining C<@ISA>"
NSQ_SOURCE_LINE 00000285 "- as in the original \"C<Carp.pm>\" module - doesn't help)."
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "The purpose and advantage of this is that a \"clan\" of modules can work"
NSQ_SOURCE_LINE 00000288 "together (and call each other) and throw exceptions at various depths"
NSQ_SOURCE_LINE 00000289 "down the calling hierarchy and still appear as a monolithic block (as"
NSQ_SOURCE_LINE 00000290 "though they were a single module) from the perspective of the caller."
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "In case you just want to ward off all error messages from the module"
NSQ_SOURCE_LINE 00000293 "in which you \"C<use Carp::Clan>\", i.e., if you want to make all error"
NSQ_SOURCE_LINE 00000294 "messages or warnings to appear to originate from where your module"
NSQ_SOURCE_LINE 00000295 "was called (this is what you usually used to \"C<use Carp;>\" for C<;-)>),"
NSQ_SOURCE_LINE 00000296 "instead of in your module itself (which is what you can do with a"
NSQ_SOURCE_LINE 00000297 "\"die\" or \"warn\" anyway), you do not need to provide a pattern,"
NSQ_SOURCE_LINE 00000298 "the module will automatically provide the correct one for you."
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "I.e., just \"C<use Carp::Clan;>\" without any arguments and call \"carp\""
NSQ_SOURCE_LINE 00000301 "or \"croak\" as appropriate, and they will automatically defend your"
NSQ_SOURCE_LINE 00000302 "module against all blames!"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "In other words, a pattern is only necessary if you want to make"
NSQ_SOURCE_LINE 00000305 "several modules (more than one) work together and appear as though"
NSQ_SOURCE_LINE 00000306 "they were only one."
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "=head2 Forcing a Stack Trace"
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "As a debugging aid, you can force \"C<Carp::Clan>\" to treat a \"croak\" as"
NSQ_SOURCE_LINE 00000311 "a \"confess\" and a \"carp\" as a \"cluck\". In other words, force a detailed"
NSQ_SOURCE_LINE 00000312 "stack trace to be given. This can be very helpful when trying to"
NSQ_SOURCE_LINE 00000313 "understand why, or from where, a warning or error is being generated."
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "This feature is enabled either by \"importing\" the non-existent symbol"
NSQ_SOURCE_LINE 00000316 "'verbose', or by setting the global variable \"C<$Carp::Clan::Verbose>\""
NSQ_SOURCE_LINE 00000317 "to a true value."
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "You would typically enable it by saying"
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "    use Carp::Clan qw(verbose);"
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "Note that you can both specify a \"family pattern\" and the string \"verbose\""
NSQ_SOURCE_LINE 00000324 "inside the \"C<qw()>\" term (or argument list) of the \"use\" statement, but"
NSQ_SOURCE_LINE 00000325 "consider that a pattern of packages to skip is pointless when \"verbose\""
NSQ_SOURCE_LINE 00000326 "causes a full stack trace anyway."
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "=head1 BUGS"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "The \"C<Carp::Clan>\" routines don't handle exception objects currently."
NSQ_SOURCE_LINE 00000331 "If called with a first argument that is a reference, they simply"
NSQ_SOURCE_LINE 00000332 "call \"C<die()>\" or \"C<warn()>\", as appropriate."
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "Bugs may be submitted through L<the RT bug tracker|https://rt.cpan.org/Public/Dist/Display.html?Name=Carp-Clan>"
NSQ_SOURCE_LINE 00000335 "(or L<bug-Carp-Clan@rt.cpan.org|mailto:bug-Carp-Clan@rt.cpan.org>)."
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000338 ""
