NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "=item *"
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "Joshua ben Jore <jjore@cpan.org>"
NSQ_SOURCE_LINE 00000354 ""
