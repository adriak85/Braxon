BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Perinci::Access::Lite;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.010001;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "use Perinci::AccessUtil qw(strip_riap_stuffs_from_res);"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000010 "our $DATE = '2022-10-28'; # DATE"
NSQ_SOURCE_LINE 00000011 "our $DIST = 'Perinci-Access-Lite'; # DIST"
NSQ_SOURCE_LINE 00000012 "our $VERSION = '0.150'; # VERSION"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "sub new {"
NSQ_SOURCE_LINE 00000015 "    my ($class, %args) = @_;"
NSQ_SOURCE_LINE 00000016 "    $args{riap_version} //= 1.1;"
NSQ_SOURCE_LINE 00000017 "    bless \\%args, $class;"
NSQ_SOURCE_LINE 00000018 "}"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "# copy-pasted from SHARYANTO::Package::Util"
NSQ_SOURCE_LINE 00000021 "sub __package_exists {"
NSQ_SOURCE_LINE 00000022 "    no strict 'refs'; ## no critic: TestingAndDebugging::ProhibitNoStrict"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "    my $pkg = shift;"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "    return unless $pkg =~ /\\A\\w+(::\\w+)*\\z/;"
NSQ_SOURCE_LINE 00000027 "    if ($pkg =~ s/::(\\w+)\\z//) {"
NSQ_SOURCE_LINE 00000028 "        return !!${$pkg . \"::\"}{$1 . \"::\"};"
NSQ_SOURCE_LINE 00000029 "    } else {"
NSQ_SOURCE_LINE 00000030 "        return !!$::{$pkg . \"::\"};"
NSQ_SOURCE_LINE 00000031 "    }"
NSQ_SOURCE_LINE 00000032 "}"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "sub request {"
NSQ_SOURCE_LINE 00000035 "    no strict 'refs'; ## no critic: TestingAndDebugging::ProhibitNoStrict"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "    my ($self, $action, $url, $extra) = @_;"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "    #say \"D:request($action => $url)\";"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "    $extra //= {};"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "    my $v = $extra->{v} // 1.1;"
NSQ_SOURCE_LINE 00000044 "    if ($v ne '1.1' && $v ne '1.2') {"
NSQ_SOURCE_LINE 00000045 "        return [501, \"Riap protocol not supported, must be 1.1 or 1.2\"];"
NSQ_SOURCE_LINE 00000046 "    }"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "    my $res;"
NSQ_SOURCE_LINE 00000049 "    if ($url =~ m!\\A(?:pl:)?/(\\w+(?:/\\w+)*)/(\\w*)\\z!) {"
NSQ_SOURCE_LINE 00000050 "        my ($mod_uripath, $func) = ($1, $2);"
NSQ_SOURCE_LINE 00000051 "        (my $pkg = $mod_uripath) =~ s!/!::!g;"
NSQ_SOURCE_LINE 00000052 "        my $mod_pm = \"$mod_uripath.pm\";"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "        my $pkg_exists;"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "      LOAD:"
NSQ_SOURCE_LINE 00000057 "        {"
NSQ_SOURCE_LINE 00000058 "            last if exists $INC{$mod_pm};"
NSQ_SOURCE_LINE 00000059 "            $pkg_exists = __package_exists($pkg);"
NSQ_SOURCE_LINE 00000060 "            # special names"
NSQ_SOURCE_LINE 00000061 "            last LOAD if $pkg =~ /\\A(main)\\z/;"
NSQ_SOURCE_LINE 00000062 "            last if $pkg_exists && defined(${\"$pkg\\::VERSION\"});"
NSQ_SOURCE_LINE 00000063 "            #say \"D:Loading $pkg ...\";"
NSQ_SOURCE_LINE 00000064 "            eval { require $mod_pm };"
NSQ_SOURCE_LINE 00000065 "            return [500, \"Can't load module $pkg: $@\"] if $@;"
NSQ_SOURCE_LINE 00000066 "        }"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "        if ($action eq 'list') {"
NSQ_SOURCE_LINE 00000069 "            return [501, \"Action 'list' not implemented for \"."
NSQ_SOURCE_LINE 00000070 "                        \"non-package entities\"]"
NSQ_SOURCE_LINE 00000071 "                if length($func);"
NSQ_SOURCE_LINE 00000072 "            no strict 'refs'; ## no critic: TestingAndDebugging::ProhibitNoStrict"
NSQ_SOURCE_LINE 00000073 "            my $spec = \\%{\"$pkg\\::SPEC\"};"
NSQ_SOURCE_LINE 00000074 "            return [200, \"OK (list)\", [grep {/\\A\\w+\\z/} sort keys %$spec]];"
NSQ_SOURCE_LINE 00000075 "        } elsif ($action eq 'info') {"
NSQ_SOURCE_LINE 00000076 "            my $data = {"
NSQ_SOURCE_LINE 00000077 "                uri => \"$mod_uripath/$func\","
NSQ_SOURCE_LINE 00000078 "                type => (!length($func) ? \"package\" :"
NSQ_SOURCE_LINE 00000079 "                             $func =~ /\\A\\w+\\z/ ? \"function\" :"
NSQ_SOURCE_LINE 00000080 "                                 $func =~ /\\A[\\@\\$\\%]/ ? \"variable\" :"
NSQ_SOURCE_LINE 00000081 "                                     \"?\"),"
NSQ_SOURCE_LINE 00000082 "            };"
NSQ_SOURCE_LINE 00000083 "            return [200, \"OK (info)\", $data];"
NSQ_SOURCE_LINE 00000084 "        } elsif ($action eq 'meta' || $action eq 'call') {"
NSQ_SOURCE_LINE 00000085 "            return [501, \"Action 'call' not implemented for package entity\"]"
NSQ_SOURCE_LINE 00000086 "                if !length($func) && $action eq 'call';"
NSQ_SOURCE_LINE 00000087 "            my $meta;"
NSQ_SOURCE_LINE 00000088 "            {"
NSQ_SOURCE_LINE 00000089 "                no strict 'refs'; ## no critic: TestingAndDebugging::ProhibitNoStrict"
NSQ_SOURCE_LINE 00000090 "                if (length $func) {"
NSQ_SOURCE_LINE 00000091 "                    $meta = ${\"$pkg\\::SPEC\"}{$func}"
NSQ_SOURCE_LINE 00000092 "                        or return ["
NSQ_SOURCE_LINE 00000093 "                            500, \"No metadata for '$url' (\"."
NSQ_SOURCE_LINE 00000094 "                                ($pkg_exists ? \"package '$pkg' exists, perhaps you mentioned '$pkg' somewhere without actually loading the module, or perhaps '$func' is a typo?\" :"
NSQ_SOURCE_LINE 00000095 "                                     \"package '$pkg' doesn't exist, perhaps '$mod_uripath' or '$func' is a typo?\") ."
NSQ_SOURCE_LINE 00000096 "                                \")\"];"
NSQ_SOURCE_LINE 00000097 "                } else {"
NSQ_SOURCE_LINE 00000098 "                    $meta = ${\"$pkg\\::SPEC\"}{':package'} // {v=>1.1};"
NSQ_SOURCE_LINE 00000099 "                }"
NSQ_SOURCE_LINE 00000100 "                $meta->{entity_v}    //= ${\"$pkg\\::VERSION\"};"
NSQ_SOURCE_LINE 00000101 "                $meta->{entity_date} //= ${\"$pkg\\::DATE\"};"
NSQ_SOURCE_LINE 00000102 "            }"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "            require Perinci::Sub::Normalize;"
NSQ_SOURCE_LINE 00000105 "            $meta = Perinci::Sub::Normalize::normalize_function_metadata($meta);"
NSQ_SOURCE_LINE 00000106 "            if ($action eq 'meta') {"
NSQ_SOURCE_LINE 00000107 "                $meta->{_orig_args_as} = $meta->{args_as};"
NSQ_SOURCE_LINE 00000108 "                $meta->{args_as} = 'hash';"
NSQ_SOURCE_LINE 00000109 "                $meta->{_orig_result_naked} = $meta->{result_naked};"
NSQ_SOURCE_LINE 00000110 "                $meta->{result_naked} = 0;"
NSQ_SOURCE_LINE 00000111 "                return [200, \"OK ($action)\", $meta];"
NSQ_SOURCE_LINE 00000112 "            }"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "            # form args (and add special args)"
NSQ_SOURCE_LINE 00000115 "            my $args = { %{$extra->{args} // {}} }; # shallow copy"
NSQ_SOURCE_LINE 00000116 "            if ($meta->{features} && $meta->{features}{progress}) {"
NSQ_SOURCE_LINE 00000117 "                require Progress::Any;"
NSQ_SOURCE_LINE 00000118 "                $args->{-progress} = Progress::Any->get_indicator;"
NSQ_SOURCE_LINE 00000119 "            }"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "            # convert args"
NSQ_SOURCE_LINE 00000122 "            my $aa = $meta->{args_as} // 'hash';"
NSQ_SOURCE_LINE 00000123 "            my @args;"
NSQ_SOURCE_LINE 00000124 "            if ($aa =~ /array/) {"
NSQ_SOURCE_LINE 00000125 "                require Perinci::Sub::ConvertArgs::Array;"
NSQ_SOURCE_LINE 00000126 "                my $convres = Perinci::Sub::ConvertArgs::Array::convert_args_to_array("
NSQ_SOURCE_LINE 00000127 "                    args => $args, meta => $meta,"
NSQ_SOURCE_LINE 00000128 "                );"
NSQ_SOURCE_LINE 00000129 "                return $convres unless $convres->[0] == 200;"
NSQ_SOURCE_LINE 00000130 "                if ($aa =~ /ref/) {"
NSQ_SOURCE_LINE 00000131 "                    @args = ($convres->[2]);"
NSQ_SOURCE_LINE 00000132 "                } else {"
NSQ_SOURCE_LINE 00000133 "                    @args = @{ $convres->[2] };"
NSQ_SOURCE_LINE 00000134 "                }"
NSQ_SOURCE_LINE 00000135 "            } elsif ($aa eq 'hashref') {"
NSQ_SOURCE_LINE 00000136 "                @args = ({ %$args });"
NSQ_SOURCE_LINE 00000137 "            } else {"
NSQ_SOURCE_LINE 00000138 "                # hash"
NSQ_SOURCE_LINE 00000139 "                @args = %$args;"
NSQ_SOURCE_LINE 00000140 "            }"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "            # call!"
NSQ_SOURCE_LINE 00000143 "            {"
NSQ_SOURCE_LINE 00000144 "                no strict 'refs'; ## no critic: TestingAndDebugging::ProhibitNoStrict"
NSQ_SOURCE_LINE 00000145 "                $res = &{\"$pkg\\::$func\"}(@args);"
NSQ_SOURCE_LINE 00000146 "            }"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "            # add envelope"
NSQ_SOURCE_LINE 00000149 "            if ($meta->{result_naked}) {"
NSQ_SOURCE_LINE 00000150 "                $res = [200, \"OK (envelope added by \".__PACKAGE__.\")\", $res];"
NSQ_SOURCE_LINE 00000151 "            }"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "            # add hint that result is binary"
NSQ_SOURCE_LINE 00000154 "            if (defined $res->[2]) {"
NSQ_SOURCE_LINE 00000155 "                if ($meta->{result} && $meta->{result}{schema} &&"
NSQ_SOURCE_LINE 00000156 "                        $meta->{result}{schema}[0] eq 'buf') {"
NSQ_SOURCE_LINE 00000157 "                    $res->[3]{'x.hint.result_binary'} = 1;"
NSQ_SOURCE_LINE 00000158 "                }"
NSQ_SOURCE_LINE 00000159 "            }"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "        } else {"
NSQ_SOURCE_LINE 00000162 "            return [501, \"Unknown/unsupported action '$action'\"];"
NSQ_SOURCE_LINE 00000163 "        }"
NSQ_SOURCE_LINE 00000164 "    } elsif ($url =~ m!\\Ahttps?:/(/?)!i) {"
NSQ_SOURCE_LINE 00000165 "        my $is_unix = !$1;"
NSQ_SOURCE_LINE 00000166 "        my $ht;"
NSQ_SOURCE_LINE 00000167 "        require JSON;"
NSQ_SOURCE_LINE 00000168 "        state $json = JSON->new->allow_nonref;"
NSQ_SOURCE_LINE 00000169 "        if ($is_unix) {"
NSQ_SOURCE_LINE 00000170 "            require HTTP::Tiny::UNIX;"
NSQ_SOURCE_LINE 00000171 "            $ht = HTTP::Tiny::UNIX->new;"
NSQ_SOURCE_LINE 00000172 "        } else {"
NSQ_SOURCE_LINE 00000173 "            require HTTP::Tiny;"
NSQ_SOURCE_LINE 00000174 "            $ht = HTTP::Tiny->new;"
NSQ_SOURCE_LINE 00000175 "        }"
NSQ_SOURCE_LINE 00000176 "        my %headers = ("
NSQ_SOURCE_LINE 00000177 "            \"x-riap-v\" => $self->{riap_version},"
NSQ_SOURCE_LINE 00000178 "            \"x-riap-action\" => $action,"
NSQ_SOURCE_LINE 00000179 "            \"x-riap-fmt\" => \"json\","
NSQ_SOURCE_LINE 00000180 "            \"content-type\" => \"application/json\","
NSQ_SOURCE_LINE 00000181 "        );"
NSQ_SOURCE_LINE 00000182 "        my $args = $extra->{args} // {};"
NSQ_SOURCE_LINE 00000183 "        for (keys %$extra) {"
NSQ_SOURCE_LINE 00000184 "            next if /\\Aargs\\z/;"
NSQ_SOURCE_LINE 00000185 "            $headers{\"x-riap-$_\"} = $extra->{$_};"
NSQ_SOURCE_LINE 00000186 "        }"
NSQ_SOURCE_LINE 00000187 "        my $htres = $ht->post("
NSQ_SOURCE_LINE 00000188 "            $url, {"
NSQ_SOURCE_LINE 00000189 "                headers => \\%headers,"
NSQ_SOURCE_LINE 00000190 "                content => $json->encode($args),"
NSQ_SOURCE_LINE 00000191 "            });"
NSQ_SOURCE_LINE 00000192 "        return [500, \"Network error: $htres->{status} - $htres->{reason}\"]"
NSQ_SOURCE_LINE 00000193 "            if $htres->{status} != 200;"
NSQ_SOURCE_LINE 00000194 "        return [500, \"Server error: didn't return JSON (\".$htres->{headers}{'content-type'}.\")\"]"
NSQ_SOURCE_LINE 00000195 "            unless $htres->{headers}{'content-type'} eq 'application/json';"
NSQ_SOURCE_LINE 00000196 "        return [500, \"Server error: didn't return Riap 1.1 response (\".$htres->{headers}{'x-riap-v'}.\")\"]"
NSQ_SOURCE_LINE 00000197 "            unless $htres->{headers}{'x-riap-v'} =~ /\\A1\\.1(\\.\\d+)?\\z/;"
NSQ_SOURCE_LINE 00000198 "        $res = $json->decode($htres->{content});"
NSQ_SOURCE_LINE 00000199 "    } else {"
NSQ_SOURCE_LINE 00000200 "        return [501, \"Unsupported scheme or bad URL '$url'\"];"
NSQ_SOURCE_LINE 00000201 "    }"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "    strip_riap_stuffs_from_res($res);"
NSQ_SOURCE_LINE 00000204 "}"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "1;"
NSQ_SOURCE_LINE 00000207 "# ABSTRACT: A lightweight Riap client library"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "__END__"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "=pod"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "=head1 NAME"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "Perinci::Access::Lite - A lightweight Riap client library"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "=head1 VERSION"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "This document describes version 0.150 of Perinci::Access::Lite (from Perl distribution Perinci-Access-Lite), released on 2022-10-28."
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "This module is a lightweight alternative to L<Perinci::Access>. It has less"
NSQ_SOURCE_LINE 00000226 "prerequisites but does fewer things. The things it supports:"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "=over"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "=item * Local (in-process) access to Perl modules and functions"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "Currently only C<call>, C<meta>, and C<list> actions are implemented. Variables"
NSQ_SOURCE_LINE 00000233 "and other entities are not yet supported."
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "The C<list> action only gathers keys from C<%SPEC> and do not yet list"
NSQ_SOURCE_LINE 00000236 "subpackages."
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "=item * HTTP/HTTPS"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "=item * HTTP over Unix socket"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "=back"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "Differences with Perinci::Access:"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "=over"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "=item * For network access, uses HTTP::Tiny module family instead of LWP"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "This results in fewer dependencies. L<HTTP::Tiny> (and L<HTTP::Tiny::UNIX>) are"
NSQ_SOURCE_LINE 00000251 "even specified as runtime recommends dependencies instead of runtime requires,"
NSQ_SOURCE_LINE 00000252 "so if your script or downstream library requires HTTP access, you'll need to"
NSQ_SOURCE_LINE 00000253 "specify the dependencies explicitly."
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "=item * No wrapping, no argument checking"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "For 'pl' or schemeless URL, no wrapping (L<Perinci::Sub::Wrapper>) is done, only"
NSQ_SOURCE_LINE 00000258 "normalization (using L<Perinci::Sub::Normalize>)."
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "=item * No transaction or logging support"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "=item * No support for some schemes"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "This includes: Riap::Simple over pipe/TCP socket."
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "=back"
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "=head1 ADDED RESULT METADATA"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "This class might add the following property/attribute in result metadata:"
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "=head2 x.hint.result_binary => bool"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "If result's schema type is C<buf>, then this class will set this attribute to"
NSQ_SOURCE_LINE 00000275 "true, to give hints to result formatters."
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "=head1 ATTRIBUTES"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "=head2 riap_version => float (default: 1.1)"
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "=head1 METHODS"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "=head2 new(%attrs) => obj"
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "=head2 $pa->request($action, $url, $extra) => hash"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "Please visit the project's homepage at L<https://metacpan.org/release/Perinci-Access-Lite>."
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "Source repository is at L<https://github.com/perlancar/perl-Perinci-Access-Lite>."
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000296 ""
