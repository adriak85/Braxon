NSQ_SOURCE_LINE 00000001 "package CSS;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "$VERSION = 1.09;"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "use strict;"
NSQ_SOURCE_LINE 00000006 "use warnings;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use Carp;"
NSQ_SOURCE_LINE 00000009 "use CSS::Style;"
NSQ_SOURCE_LINE 00000010 "use CSS::Selector;"
NSQ_SOURCE_LINE 00000011 "use CSS::Property;"
NSQ_SOURCE_LINE 00000012 "use CSS::Adaptor;"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "use Data::Dumper;"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "sub new {"
NSQ_SOURCE_LINE 00000017 "\tmy $class = shift;"
NSQ_SOURCE_LINE 00000018 "\tmy $self = bless {}, $class;"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "\tmy $options = shift;"
NSQ_SOURCE_LINE 00000021 "\t$self->{styles} = [];"
NSQ_SOURCE_LINE 00000022 "\t$self->{parser} = $options->{parser} || 'CSS::Parse::Lite';"
NSQ_SOURCE_LINE 00000023 "\t$self->{adaptor} = $options->{adaptor} || 'CSS::Adaptor';"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "\treturn $self;"
NSQ_SOURCE_LINE 00000026 "}"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "sub read_file {"
NSQ_SOURCE_LINE 00000029 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000030 "\tmy $path = shift;"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "\tif (ref $path){"
NSQ_SOURCE_LINE 00000033 "\t\tif (ref $path eq 'ARRAY'){"
NSQ_SOURCE_LINE 00000034 "\t\t\t$self->read_file($_) for @$path;"
NSQ_SOURCE_LINE 00000035 "\t\t\treturn 1;"
NSQ_SOURCE_LINE 00000036 "\t\t}"
NSQ_SOURCE_LINE 00000037 "\t} else {"
NSQ_SOURCE_LINE 00000038 " \t\tif ($path){"
NSQ_SOURCE_LINE 00000039 "\t\t\tlocal *IN;"
NSQ_SOURCE_LINE 00000040 " \t\t\topen(IN, $path) or croak \"couldn't open file: $!\";"
NSQ_SOURCE_LINE 00000041 "\t\t\tmy $source = join '',<IN>;"
NSQ_SOURCE_LINE 00000042 "\t\t\tclose(IN);"
NSQ_SOURCE_LINE 00000043 "\t\t\t$self->parse_string($source) if $source;"
NSQ_SOURCE_LINE 00000044 "\t\t\treturn 1;"
NSQ_SOURCE_LINE 00000045 "\t\t}"
NSQ_SOURCE_LINE 00000046 "\t}"
NSQ_SOURCE_LINE 00000047 "\tcroak \"only scalars and arrays accepted: $!\";"
NSQ_SOURCE_LINE 00000048 "}"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "sub read_string {"
NSQ_SOURCE_LINE 00000051 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000052 "\tmy $data = shift;"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "\tif (ref $data){"
NSQ_SOURCE_LINE 00000055 "\t\tif (ref $data eq 'ARRAY'){"
NSQ_SOURCE_LINE 00000056 "\t\t\t$self->read_string($_) for @$data;"
NSQ_SOURCE_LINE 00000057 "\t\t\treturn 1;"
NSQ_SOURCE_LINE 00000058 "\t\t}"
NSQ_SOURCE_LINE 00000059 "\t} else {"
NSQ_SOURCE_LINE 00000060 "\t\t$self->parse_string($data) if length $data;"
NSQ_SOURCE_LINE 00000061 "\t}"
NSQ_SOURCE_LINE 00000062 "}"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "sub parse_string {"
NSQ_SOURCE_LINE 00000065 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000066 "\tmy $string = shift;"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "\t# remove comments"
NSQ_SOURCE_LINE 00000069 "\t$string =~ s!/\\*.*?\\*\\/!!g;"
NSQ_SOURCE_LINE 00000070 "\t$string =~ s|<!--||g;"
NSQ_SOURCE_LINE 00000071 "\t$string =~ s|-->||g;"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "\teval \"use $self->{parser}\";"
NSQ_SOURCE_LINE 00000074 "\tmy $parser_obj = new $self->{parser};"
NSQ_SOURCE_LINE 00000075 "\t$parser_obj->{'parent'} = $self;"
NSQ_SOURCE_LINE 00000076 "\t$parser_obj->parse_string($string);"
NSQ_SOURCE_LINE 00000077 "}"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "sub purge {"
NSQ_SOURCE_LINE 00000080 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000081 "\t$self->{styles} = [];"
NSQ_SOURCE_LINE 00000082 "}"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "sub set_adaptor {"
NSQ_SOURCE_LINE 00000085 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000086 "\tmy $adaptor = shift;"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "\t$self->{adaptor} = $adaptor;"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "\tfor(@{$self->{styles}}){"
NSQ_SOURCE_LINE 00000091 "\t\t$_->set_adaptor($adaptor);"
NSQ_SOURCE_LINE 00000092 "\t}"
NSQ_SOURCE_LINE 00000093 "}"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "sub output {"
NSQ_SOURCE_LINE 00000096 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000097 "\tmy $adaptor = shift || $self->{adaptor};"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "\tfor(@{$self->{styles}}){"
NSQ_SOURCE_LINE 00000100 "\t\t$_->set_adaptor($adaptor);"
NSQ_SOURCE_LINE 00000101 "\t}"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "\tmy $output = '';"
NSQ_SOURCE_LINE 00000104 "\tfor(@{$self->{styles}}){"
NSQ_SOURCE_LINE 00000105 "\t\t$output .= \"$_\";"
NSQ_SOURCE_LINE 00000106 "\t}"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "\treturn $output;"
NSQ_SOURCE_LINE 00000109 "}"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "sub get_style_by_selector {"
NSQ_SOURCE_LINE 00000112 "\tmy ($self, $sel_name) = @_;"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "        for my $style (@{$self->{styles}}){"
NSQ_SOURCE_LINE 00000115 "                for my $selector (@{$style->{selectors}}){"
NSQ_SOURCE_LINE 00000116 "                        if ($selector->{name} eq $sel_name){"
NSQ_SOURCE_LINE 00000117 "                                return $style;"
NSQ_SOURCE_LINE 00000118 "                        }"
NSQ_SOURCE_LINE 00000119 "                }"
NSQ_SOURCE_LINE 00000120 "        }"
NSQ_SOURCE_LINE 00000121 "        return 0;"
NSQ_SOURCE_LINE 00000122 "}"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "1;"
NSQ_SOURCE_LINE 00000125 "__END__"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "=head1 NAME"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "CSS - Object oriented access to Cascading Style Sheets (CSS)"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "  use CSS;"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "  # create a CSS object with the default options  "
NSQ_SOURCE_LINE 00000136 "  my $css = CSS->new();"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "  # create a CSS object with a specific parser"
NSQ_SOURCE_LINE 00000139 "  my $css = CSS->new( { 'parser' => 'CSS::Parse::Lite' } );"
NSQ_SOURCE_LINE 00000140 "  my $css = CSS->new( { 'parser' => 'CSS::Parse::Heavy' } );"
NSQ_SOURCE_LINE 00000141 "  my $css = CSS->new( { 'parser' => 'CSS::Parse::Compiled' } );"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "  # create a CSS object with a specific adaptor"
NSQ_SOURCE_LINE 00000144 "  my $css = CSS->new( { 'adaptor' => 'CSS::Adaptor' } );"
NSQ_SOURCE_LINE 00000145 "  my $css = CSS->new( { 'adaptor' => 'CSS::Adaptor::Pretty' } );"
NSQ_SOURCE_LINE 00000146 "  my $css = CSS->new( { 'adaptor' => 'CSS::Adaptor::Debug' } );"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "  # parse some CSS from a string"
NSQ_SOURCE_LINE 00000151 "  $css->read_string( $css_data );"
NSQ_SOURCE_LINE 00000152 "  $css->read_string( ( $css_data, $more_css_data ) );"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "  # parse some CSS from a file"
NSQ_SOURCE_LINE 00000155 "  $css->read_file( 'my_file.css' );"
NSQ_SOURCE_LINE 00000156 "  $css->read_file( ( 'my_file.css', 'my_other_file.css' ) );"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "  # output the CSS using the current adaptor"
NSQ_SOURCE_LINE 00000161 "  print $css->output();"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "  # set a new adaptor and then output the CSS"
NSQ_SOURCE_LINE 00000164 "  $css->set_adaptor( 'CSS::Adaptor::Foo' );"
NSQ_SOURCE_LINE 00000165 "  print $css->output();"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "  # output the CSS using a tempory adaptor"
NSQ_SOURCE_LINE 00000168 "  print $css->output( 'CSS::Adaptor::Bar' );"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "  # forget about the CSS we've already parsed"
NSQ_SOURCE_LINE 00000173 "  $css->purge();"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "This module can be used, along with a CSS::Parse::* module, to parse"
NSQ_SOURCE_LINE 00000179 "CSS data and represent it as a tree of objects. Using a CSS::Adaptor::*"
NSQ_SOURCE_LINE 00000180 "module, the CSS data tree can then be transformed into other formats."
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "=head1 NOTICE"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "From version 1.00 of this module onwards, backwards compatibility is"
NSQ_SOURCE_LINE 00000185 "broken. This is due to large changes in the way data is parsed and"
NSQ_SOURCE_LINE 00000186 "then represented internally. Version 0.08 is still available on"
NSQ_SOURCE_LINE 00000187 "CPAN: L<http://search.cpan.org/author/IAMCAL/CSS-0.08/>"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "=head1 TREE STRUCTURE"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "The CSS object is the head of the tree. It contains a list of "
NSQ_SOURCE_LINE 00000192 "CSS::Style objects which each represent a CSS ruleset. Each of"
NSQ_SOURCE_LINE 00000193 "these objects contains a list of selectors and properties. Each"
NSQ_SOURCE_LINE 00000194 "selector is stored as a CSS::Selector object. Each property"
NSQ_SOURCE_LINE 00000195 "object is stored as a CSS::Property object and contains a list"
NSQ_SOURCE_LINE 00000196 "of values. These values are stored as CSS::Value objects."
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "  foo, bar {"
NSQ_SOURCE_LINE 00000199 "      baz: fop;"
NSQ_SOURCE_LINE 00000200 "      woo: yay houpla;"
NSQ_SOURCE_LINE 00000201 "  }"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "The above example would be represented as a single CSS::Style object."
NSQ_SOURCE_LINE 00000204 "That object would then have two CSS::Selector objects representing"
NSQ_SOURCE_LINE 00000205 "'foo' and 'bar'. It would also have two CSS::Property objects "
NSQ_SOURCE_LINE 00000206 "representing 'baz' and 'woo'. The 'baz' object then has a single child"
NSQ_SOURCE_LINE 00000207 "CSS::Value object for 'fop', whilst the 'woo' object has two"
NSQ_SOURCE_LINE 00000208 "child objects for 'yay' and 'houpla'."
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "=head1 METHODS"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "=head2 CONSTRUCTOR"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "=over 4"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "=item C<new()> or C<new( { ..options.. } )>"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "An optional hash can contain arguments:"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "  parser\tmodule to use as the CSS parser"
NSQ_SOURCE_LINE 00000221 "  adaptor\tadaptor to use for output"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "=back"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "=head2 ACCESSORS"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "=over 4"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "=item C<read_file( $filename )> or C<read_file( @filenames )>"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "Read one or mores files and parse the CSS within them."
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "=item C<read_string( $scalar )> or C<read_string( @strings )>"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "Read one or more strings and parse the CSS within them."
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "=item C<output()> or C<output( 'CSS::Adaptor::Foo' )>"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "Return a string representation of the CSS tree, using either the "
NSQ_SOURCE_LINE 00000242 "current adaptor or the specified one."
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "=item C<set_adaptor( 'CSS::Adaptor::Bar' )>"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "Set the current adaptor for the CSS tree."
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "=item C<purge()>"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "Forget all the objects in the CSS tree;"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "=item C<get_style_by_selector( 'selector_name' )>"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "Returns the first CSS::Style object with the specified selector"
NSQ_SOURCE_LINE 00000258 "name attached. Returns zero on failure."
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "=back"
NSQ_SOURCE_LINE 00000262 ""
