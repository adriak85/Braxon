NSQ_SOURCE_LINE 00000001 "package Log::Dispatch;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.006;"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "use strict;"
NSQ_SOURCE_LINE 00000006 "use warnings;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "our $VERSION = '2.71';"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use Carp ();"
NSQ_SOURCE_LINE 00000011 "use Log::Dispatch::Types;"
NSQ_SOURCE_LINE 00000012 "use Log::Dispatch::Vars qw( %CanonicalLevelNames %LevelNamesToNumbers );"
NSQ_SOURCE_LINE 00000013 "use Module::Runtime     qw( use_package_optimistically );"
NSQ_SOURCE_LINE 00000014 "use Params::ValidationCompiler qw( validation_for );"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "use base qw( Log::Dispatch::Base );"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "BEGIN {"
NSQ_SOURCE_LINE 00000019 "    for my $l ( keys %CanonicalLevelNames ) {"
NSQ_SOURCE_LINE 00000020 "        my $level_num = $LevelNamesToNumbers{$l};"
NSQ_SOURCE_LINE 00000021 "        my $sub       = sub {"
NSQ_SOURCE_LINE 00000022 "            my $self = shift;"
NSQ_SOURCE_LINE 00000023 "            $self->_log_with_num("
NSQ_SOURCE_LINE 00000024 "                $level_num,"
NSQ_SOURCE_LINE 00000025 "                level   => $CanonicalLevelNames{$l},"
NSQ_SOURCE_LINE 00000026 "                message => @_ > 1 ? \"@_\" : $_[0],"
NSQ_SOURCE_LINE 00000027 "            );"
NSQ_SOURCE_LINE 00000028 "        };"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "        ## no critic (TestingAndDebugging::ProhibitNoStrict)"
NSQ_SOURCE_LINE 00000031 "        no strict 'refs';"
NSQ_SOURCE_LINE 00000032 "        *{$l} = $sub;"
NSQ_SOURCE_LINE 00000033 "    }"
NSQ_SOURCE_LINE 00000034 "}"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "{"
NSQ_SOURCE_LINE 00000037 "    my $validator = validation_for("
NSQ_SOURCE_LINE 00000038 "        params => {"
NSQ_SOURCE_LINE 00000039 "            outputs => {"
NSQ_SOURCE_LINE 00000040 "                type     => t('ArrayRef'),"
NSQ_SOURCE_LINE 00000041 "                optional => 1,"
NSQ_SOURCE_LINE 00000042 "            },"
NSQ_SOURCE_LINE 00000043 "            callbacks => {"
NSQ_SOURCE_LINE 00000044 "                type     => t('Callbacks'),"
NSQ_SOURCE_LINE 00000045 "                optional => 1,"
NSQ_SOURCE_LINE 00000046 "            },"
NSQ_SOURCE_LINE 00000047 "        },"
NSQ_SOURCE_LINE 00000048 "    );"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "    sub new {"
NSQ_SOURCE_LINE 00000051 "        my $class = shift;"
NSQ_SOURCE_LINE 00000052 "        my %p     = $validator->(@_);"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "        my $self = bless {}, $class;"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "        $self->{callbacks} = $p{callbacks}"
NSQ_SOURCE_LINE 00000057 "            if $p{callbacks};"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "        if ( my $outputs = $p{outputs} ) {"
NSQ_SOURCE_LINE 00000060 "            if ( ref $outputs->[1] eq 'HASH' ) {"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "                # 2.23 API"
NSQ_SOURCE_LINE 00000063 "                # outputs => ["
NSQ_SOURCE_LINE 00000064 "                #   File => { min_level => 'debug', filename => 'logfile' },"
NSQ_SOURCE_LINE 00000065 "                #   Screen => { min_level => 'warning' }"
NSQ_SOURCE_LINE 00000066 "                # ]"
NSQ_SOURCE_LINE 00000067 "                while ( my ( $class, $params ) = splice @$outputs, 0, 2 ) {"
NSQ_SOURCE_LINE 00000068 "                    $self->_add_output( $class, %$params );"
NSQ_SOURCE_LINE 00000069 "                }"
NSQ_SOURCE_LINE 00000070 "            }"
NSQ_SOURCE_LINE 00000071 "            else {"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "                # 2.24+ syntax"
NSQ_SOURCE_LINE 00000074 "                # outputs => ["
NSQ_SOURCE_LINE 00000075 "                #   [ 'File',   min_level => 'debug', filename => 'logfile' ],"
NSQ_SOURCE_LINE 00000076 "                #   [ 'Screen', min_level => 'warning' ]"
NSQ_SOURCE_LINE 00000077 "                # ]"
NSQ_SOURCE_LINE 00000078 "                for my $arr ( @{$outputs} ) {"
NSQ_SOURCE_LINE 00000079 "                    die \"expected arrayref, not '$arr'\""
NSQ_SOURCE_LINE 00000080 "                        unless ref $arr eq 'ARRAY';"
NSQ_SOURCE_LINE 00000081 "                    $self->_add_output( @{$arr} );"
NSQ_SOURCE_LINE 00000082 "                }"
NSQ_SOURCE_LINE 00000083 "            }"
NSQ_SOURCE_LINE 00000084 "        }"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "        return $self;"
NSQ_SOURCE_LINE 00000087 "    }"
NSQ_SOURCE_LINE 00000088 "}"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "sub clone {"
NSQ_SOURCE_LINE 00000091 "    my $self = shift;"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "    my %clone = ("
NSQ_SOURCE_LINE 00000094 "        callbacks => [ @{ $self->{callbacks} || [] } ],"
NSQ_SOURCE_LINE 00000095 "        outputs   => { %{ $self->{outputs}   || {} } },"
NSQ_SOURCE_LINE 00000096 "    );"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "    return bless \\%clone, ref $self;"
NSQ_SOURCE_LINE 00000099 "}"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "sub _add_output {"
NSQ_SOURCE_LINE 00000102 "    my $self  = shift;"
NSQ_SOURCE_LINE 00000103 "    my $class = shift;"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "    my $full_class"
NSQ_SOURCE_LINE 00000106 "        = substr( $class, 0, 1 ) eq '+'"
NSQ_SOURCE_LINE 00000107 "        ? substr( $class, 1 )"
NSQ_SOURCE_LINE 00000108 "        : \"Log::Dispatch::$class\";"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "    use_package_optimistically($full_class);"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "    $self->add( $full_class->new(@_) );"
NSQ_SOURCE_LINE 00000113 "}"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "sub add {"
NSQ_SOURCE_LINE 00000116 "    my $self   = shift;"
NSQ_SOURCE_LINE 00000117 "    my $object = shift;"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "    # Once 5.6 is more established start using the warnings module."
NSQ_SOURCE_LINE 00000120 "    if ( exists $self->{outputs}{ $object->name } && $^W ) {"
NSQ_SOURCE_LINE 00000121 "        Carp::carp("
NSQ_SOURCE_LINE 00000122 "            'Log::Dispatch::* object ', $object->name,"
NSQ_SOURCE_LINE 00000123 "            ' already exists.'"
NSQ_SOURCE_LINE 00000124 "        );"
NSQ_SOURCE_LINE 00000125 "    }"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "    $self->{outputs}{ $object->name } = $object;"
NSQ_SOURCE_LINE 00000128 "}"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "sub remove {"
NSQ_SOURCE_LINE 00000131 "    my $self = shift;"
NSQ_SOURCE_LINE 00000132 "    my $name = shift;"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "    return delete $self->{outputs}{$name};"
NSQ_SOURCE_LINE 00000135 "}"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "sub outputs {"
NSQ_SOURCE_LINE 00000138 "    my $self = shift;"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "    return values %{ $self->{outputs} };"
NSQ_SOURCE_LINE 00000141 "}"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "sub callbacks {"
NSQ_SOURCE_LINE 00000144 "    my $self = shift;"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "    return @{ $self->{callbacks} };"
NSQ_SOURCE_LINE 00000147 "}"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "## no critic (Subroutines::ProhibitBuiltinHomonyms)"
NSQ_SOURCE_LINE 00000150 "sub log {"
NSQ_SOURCE_LINE 00000151 "    my $self = shift;"
NSQ_SOURCE_LINE 00000152 "    my %p    = @_;"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "    my $level_num = $self->_level_as_number( $p{level} );"
NSQ_SOURCE_LINE 00000155 "    return unless defined $level_num;"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "    return $self->_log_with_num( $level_num, %p );"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "}"
NSQ_SOURCE_LINE 00000160 "## use critic"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "sub _log_with_num {"
NSQ_SOURCE_LINE 00000163 "    my $self      = shift;"
NSQ_SOURCE_LINE 00000164 "    my $level_num = shift;"
NSQ_SOURCE_LINE 00000165 "    my %p         = @_;"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "    return unless $self->_would_log($level_num);"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "    $p{message} = $self->_prepare_message(%p);"
NSQ_SOURCE_LINE 00000170 "    $_->_log_with_num( $level_num, %p ) for values %{ $self->{outputs} };"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "    return;"
NSQ_SOURCE_LINE 00000173 "}"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "sub _prepare_message {"
NSQ_SOURCE_LINE 00000176 "    my $self = shift;"
NSQ_SOURCE_LINE 00000177 "    my %p    = @_;"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "    $p{message} = $p{message}->()"
NSQ_SOURCE_LINE 00000180 "        if ref $p{message} eq 'CODE';"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "    $p{message} = $self->_apply_callbacks(%p)"
NSQ_SOURCE_LINE 00000183 "        if $self->{callbacks};"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "    return $p{message};"
NSQ_SOURCE_LINE 00000186 "}"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "sub _log_to_outputs {"
NSQ_SOURCE_LINE 00000189 "    my $self = shift;"
NSQ_SOURCE_LINE 00000190 "    my %p    = @_;"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "    for ( values %{ $self->{outputs} } ) {"
NSQ_SOURCE_LINE 00000193 "        $_->log(%p);"
NSQ_SOURCE_LINE 00000194 "    }"
NSQ_SOURCE_LINE 00000195 "}"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "sub log_and_die {"
NSQ_SOURCE_LINE 00000198 "    my $self = shift;"
NSQ_SOURCE_LINE 00000199 "    my %p    = @_;"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "    $p{message} = $self->_prepare_message(%p);"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "    $self->_log_to_outputs(%p) if $self->would_log( $p{level} );"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "    $self->_die_with_message(%p);"
NSQ_SOURCE_LINE 00000206 "}"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "sub log_and_croak {"
NSQ_SOURCE_LINE 00000209 "    my $self = shift;"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "    $self->log_and_die(@_);"
NSQ_SOURCE_LINE 00000212 "}"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "sub _die_with_message {"
NSQ_SOURCE_LINE 00000215 "    my $self = shift;"
NSQ_SOURCE_LINE 00000216 "    my %p    = @_;"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "    my $msg = $p{message};"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "    local $Carp::CarpLevel = ( $Carp::CarpLevel || 0 ) + $p{carp_level}"
NSQ_SOURCE_LINE 00000221 "        if exists $p{carp_level};"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "    Carp::croak($msg);"
NSQ_SOURCE_LINE 00000224 "}"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "sub log_to {"
NSQ_SOURCE_LINE 00000227 "    my $self = shift;"
NSQ_SOURCE_LINE 00000228 "    my %p    = @_;"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "    $p{message} = $self->_apply_callbacks(%p)"
NSQ_SOURCE_LINE 00000231 "        if $self->{callbacks};"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "    $self->_log_to(%p);"
NSQ_SOURCE_LINE 00000234 "}"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "sub _log_to {"
NSQ_SOURCE_LINE 00000237 "    my $self = shift;"
NSQ_SOURCE_LINE 00000238 "    my %p    = @_;"
NSQ_SOURCE_LINE 00000239 "    my $name = $p{name};"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "    if ( exists $self->{outputs}{$name} ) {"
NSQ_SOURCE_LINE 00000242 "        $self->{outputs}{$name}->log(@_);"
NSQ_SOURCE_LINE 00000243 "    }"
NSQ_SOURCE_LINE 00000244 "    elsif ($^W) {"
NSQ_SOURCE_LINE 00000245 "        Carp::carp("
NSQ_SOURCE_LINE 00000246 "            \"Log::Dispatch::* object named '$name' not in dispatcher\\n\");"
NSQ_SOURCE_LINE 00000247 "    }"
NSQ_SOURCE_LINE 00000248 "}"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "sub output {"
NSQ_SOURCE_LINE 00000251 "    my $self = shift;"
NSQ_SOURCE_LINE 00000252 "    my $name = shift;"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "    return unless exists $self->{outputs}{$name};"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "    return $self->{outputs}{$name};"
NSQ_SOURCE_LINE 00000257 "}"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "sub would_log {"
NSQ_SOURCE_LINE 00000260 "    my $self  = shift;"
NSQ_SOURCE_LINE 00000261 "    my $level = shift;"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "    my $level_num = $self->_level_as_number($level);"
NSQ_SOURCE_LINE 00000264 "    return 0 unless defined $level_num;"
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "    return $self->_would_log($level_num);"
NSQ_SOURCE_LINE 00000267 "}"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "sub _would_log {"
NSQ_SOURCE_LINE 00000270 "    my $self      = shift;"
NSQ_SOURCE_LINE 00000271 "    my $level_num = shift;"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "    for ( values %{ $self->{outputs} } ) {"
NSQ_SOURCE_LINE 00000274 "        return 1 if $_->_should_log($level_num);"
NSQ_SOURCE_LINE 00000275 "    }"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "    return 0;"
NSQ_SOURCE_LINE 00000278 "}"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "sub is_debug     { $_[0]->would_log('debug') }"
NSQ_SOURCE_LINE 00000281 "sub is_info      { $_[0]->would_log('info') }"
NSQ_SOURCE_LINE 00000282 "sub is_notice    { $_[0]->would_log('notice') }"
