NSQ_SOURCE_LINE 00000284 "sub is_warn      { $_[0]->would_log('warn') }"
NSQ_SOURCE_LINE 00000285 "sub is_error     { $_[0]->would_log('error') }"
NSQ_SOURCE_LINE 00000286 "sub is_err       { $_[0]->would_log('err') }"
NSQ_SOURCE_LINE 00000287 "sub is_critical  { $_[0]->would_log('critical') }"
NSQ_SOURCE_LINE 00000288 "sub is_crit      { $_[0]->would_log('crit') }"
NSQ_SOURCE_LINE 00000289 "sub is_alert     { $_[0]->would_log('alert') }"
NSQ_SOURCE_LINE 00000290 "sub is_emerg     { $_[0]->would_log('emerg') }"
NSQ_SOURCE_LINE 00000291 "sub is_emergency { $_[0]->would_log('emergency') }"
