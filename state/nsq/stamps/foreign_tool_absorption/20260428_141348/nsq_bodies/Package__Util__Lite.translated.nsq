NSQ_SOURCE_LINE 00000001 "package Package::Util::Lite;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2019-01-06'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.001'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use strict 'subs', 'vars';"
NSQ_SOURCE_LINE 00000007 "use warnings;"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "require Exporter;"
NSQ_SOURCE_LINE 00000010 "our @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000011 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000012 "                       package_exists"
NSQ_SOURCE_LINE 00000013 "                       list_subpackages"
NSQ_SOURCE_LINE 00000014 "               );"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "sub package_exists {"
NSQ_SOURCE_LINE 00000017 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "    my $pkg = shift;"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "    # opt"
NSQ_SOURCE_LINE 00000022 "    #return unless $pkg =~ /\\A\\w+(::\\w+)*\\z/;"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "    if ($pkg =~ s/::(\\w+)\\z//) {"
NSQ_SOURCE_LINE 00000025 "        return !!${$pkg . \"::\"}{$1 . \"::\"};"
NSQ_SOURCE_LINE 00000026 "    } else {"
NSQ_SOURCE_LINE 00000027 "        return !!$::{$pkg . \"::\"};"
NSQ_SOURCE_LINE 00000028 "    }"
NSQ_SOURCE_LINE 00000029 "}"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "sub list_subpackages {"
NSQ_SOURCE_LINE 00000032 "    my ($pkg, $recursive, $cur_res, $ref_mem) = @_;"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "    return () unless !length($pkg) || package_exists($pkg);"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "    # this is used to avoid deep recursion. for example (the only one?) %:: and"
NSQ_SOURCE_LINE 00000037 "    # %main:: point to the same thing."
NSQ_SOURCE_LINE 00000038 "    $ref_mem ||= {};"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "    my $symtbl = \\%{$pkg . \"::\"};"
NSQ_SOURCE_LINE 00000041 "    return () if $ref_mem->{\"$symtbl\"}++;"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "    my $res = $cur_res || [];"
NSQ_SOURCE_LINE 00000044 "    for (sort keys %$symtbl) {"
NSQ_SOURCE_LINE 00000045 "        next unless s/::$//;"
NSQ_SOURCE_LINE 00000046 "        my $name = (length($pkg) ? \"$pkg\\::\" : \"\" ) . $_;"
NSQ_SOURCE_LINE 00000047 "        push @$res, $name;"
NSQ_SOURCE_LINE 00000048 "        list_subpackages($name, 1, $res, $ref_mem) if $recursive;"
NSQ_SOURCE_LINE 00000049 "    }"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "    @$res;"
NSQ_SOURCE_LINE 00000052 "}"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "1;"
NSQ_SOURCE_LINE 00000055 "# ABSTRACT: Package-related utilities"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "__END__"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "=pod"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "=head1 NAME"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "Package::Util::Lite - Package-related utilities"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "=head1 VERSION"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "This document describes version 0.001 of Package::Util::Lite (from Perl distribution Package-Util-Lite), released on 2019-01-06."
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 " use Package::Util::Lite qw("
NSQ_SOURCE_LINE 00000074 "     package_exists"
NSQ_SOURCE_LINE 00000075 "     list_subpackages"
NSQ_SOURCE_LINE 00000076 " );"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 " print \"Package Foo::Bar exists\" if package_exists(\"Foo::Bar\");"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 " my @subpkg    = list_subpackages(\"Foo::Bar\");"
NSQ_SOURCE_LINE 00000081 " my @allsubpkg = list_subpackages(\"Foo::Bar\", 1); # recursive"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "This module provides package-related utilities. You should check"
NSQ_SOURCE_LINE 00000086 "L<Package::Stash> first, then here."
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "=head2 package_exists"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "Usage:"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 " package_exists($name) => bool"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "Return true if package \"exists\". By \"exists\", it means that the package has been"
NSQ_SOURCE_LINE 00000097 "defined by C<package> statement or some entries have been created in the symbol"
NSQ_SOURCE_LINE 00000098 "table (e.g. C<$Foo::var = 1;> will make the C<Foo> package \"exist\")."
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "This function can be used e.g. for checking before aliasing one package to"
NSQ_SOURCE_LINE 00000101 "another. Or to casually check whether a module has been loaded."
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "=head2 list_subpackages($name[, $recursive]) => @res"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "List subpackages, e.g.:"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 " ("
NSQ_SOURCE_LINE 00000108 "     \"Foo::Bar::Baz\","
NSQ_SOURCE_LINE 00000109 "     \"Foo::Bar::Qux\","
NSQ_SOURCE_LINE 00000110 "     ..."
NSQ_SOURCE_LINE 00000111 " )"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "If $recursive is true, will also list subpackages of subpackages, and so on."
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "=head1 FAQ"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "Please visit the project's homepage at L<https://metacpan.org/release/Package-Util-Lite>."
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "Source repository is at L<https://github.com/perlancar/perl-Package-Util-Lite>."
NSQ_SOURCE_LINE 00000124 ""
