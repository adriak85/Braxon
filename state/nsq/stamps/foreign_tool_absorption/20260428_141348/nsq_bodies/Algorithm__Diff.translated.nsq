NSQ_SOURCE_LINE 00000001 "package Algorithm::Diff;"
NSQ_SOURCE_LINE 00000002 "# Skip to first \"=head\" line for documentation."
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "use integer;    # see below in _replaceNextLargerWith() for mod to make"
NSQ_SOURCE_LINE 00000006 "                # if you don't use this"
NSQ_SOURCE_LINE 00000007 "use vars qw( $VERSION @EXPORT_OK );"
NSQ_SOURCE_LINE 00000008 "$VERSION = '1.201';"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "require Exporter;"
NSQ_SOURCE_LINE 00000011 "*import    = \\&Exporter::import;"
NSQ_SOURCE_LINE 00000012 "@EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000013 "    prepare LCS LCSidx LCS_length"
NSQ_SOURCE_LINE 00000014 "    diff sdiff compact_diff"
NSQ_SOURCE_LINE 00000015 "    traverse_sequences traverse_balanced"
NSQ_SOURCE_LINE 00000016 ");"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "# McIlroy-Hunt diff algorithm"
NSQ_SOURCE_LINE 00000019 "# Adapted from the Smalltalk code of Mario I. Wolczko, <mario@wolczko.com>"
NSQ_SOURCE_LINE 00000020 "# by Ned Konz, perl@bike-nomad.com"
NSQ_SOURCE_LINE 00000021 "# Updates by Tye McQueen, http://perlmonks.org/?node=tye"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "# Create a hash that maps each element of $aCollection to the set of"
NSQ_SOURCE_LINE 00000024 "# positions it occupies in $aCollection, restricted to the elements"
NSQ_SOURCE_LINE 00000025 "# within the range of indexes specified by $start and $end."
NSQ_SOURCE_LINE 00000026 "# The fourth parameter is a subroutine reference that will be called to"
NSQ_SOURCE_LINE 00000027 "# generate a string to use as a key."
NSQ_SOURCE_LINE 00000028 "# Additional parameters, if any, will be passed to this subroutine."
NSQ_SOURCE_LINE 00000029 "#"
NSQ_SOURCE_LINE 00000030 "# my $hashRef = _withPositionsOfInInterval( \\@array, $start, $end, $keyGen );"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "sub _withPositionsOfInInterval"
NSQ_SOURCE_LINE 00000033 "{"
NSQ_SOURCE_LINE 00000034 "    my $aCollection = shift;    # array ref"
NSQ_SOURCE_LINE 00000035 "    my $start       = shift;"
NSQ_SOURCE_LINE 00000036 "    my $end         = shift;"
NSQ_SOURCE_LINE 00000037 "    my $keyGen      = shift;"
NSQ_SOURCE_LINE 00000038 "    my %d;"
NSQ_SOURCE_LINE 00000039 "    my $index;"
NSQ_SOURCE_LINE 00000040 "    for ( $index = $start ; $index <= $end ; $index++ )"
NSQ_SOURCE_LINE 00000041 "    {"
NSQ_SOURCE_LINE 00000042 "        my $element = $aCollection->[$index];"
NSQ_SOURCE_LINE 00000043 "        my $key = $keyGen ? &$keyGen( $element, @_ ) : $element;"
NSQ_SOURCE_LINE 00000044 "        if ( exists( $d{$key} ) )"
NSQ_SOURCE_LINE 00000045 "        {"
NSQ_SOURCE_LINE 00000046 "            unshift ( @{ $d{$key} }, $index );"
NSQ_SOURCE_LINE 00000047 "        }"
NSQ_SOURCE_LINE 00000048 "        else"
NSQ_SOURCE_LINE 00000049 "        {"
NSQ_SOURCE_LINE 00000050 "            $d{$key} = [$index];"
NSQ_SOURCE_LINE 00000051 "        }"
NSQ_SOURCE_LINE 00000052 "    }"
NSQ_SOURCE_LINE 00000053 "    return wantarray ? %d : \\%d;"
NSQ_SOURCE_LINE 00000054 "}"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "# Find the place at which aValue would normally be inserted into the"
NSQ_SOURCE_LINE 00000057 "# array. If that place is already occupied by aValue, do nothing, and"
NSQ_SOURCE_LINE 00000058 "# return undef. If the place does not exist (i.e., it is off the end of"
NSQ_SOURCE_LINE 00000059 "# the array), add it to the end, otherwise replace the element at that"
NSQ_SOURCE_LINE 00000060 "# point with aValue.  It is assumed that the array's values are numeric."
NSQ_SOURCE_LINE 00000061 "# This is where the bulk (75%) of the time is spent in this module, so"
NSQ_SOURCE_LINE 00000062 "# try to make it fast!"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "sub _replaceNextLargerWith"
NSQ_SOURCE_LINE 00000065 "{"
NSQ_SOURCE_LINE 00000066 "    my ( $array, $aValue, $high ) = @_;"
NSQ_SOURCE_LINE 00000067 "    $high ||= $#$array;"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "    # off the end?"
NSQ_SOURCE_LINE 00000070 "    if ( $high == -1 || $aValue > $array->[-1] )"
NSQ_SOURCE_LINE 00000071 "    {"
NSQ_SOURCE_LINE 00000072 "        push ( @$array, $aValue );"
NSQ_SOURCE_LINE 00000073 "        return $high + 1;"
NSQ_SOURCE_LINE 00000074 "    }"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "    # binary search for insertion point..."
NSQ_SOURCE_LINE 00000077 "    my $low = 0;"
NSQ_SOURCE_LINE 00000078 "    my $index;"
NSQ_SOURCE_LINE 00000079 "    my $found;"
NSQ_SOURCE_LINE 00000080 "    while ( $low <= $high )"
NSQ_SOURCE_LINE 00000081 "    {"
NSQ_SOURCE_LINE 00000082 "        $index = ( $high + $low ) / 2;"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "        # $index = int(( $high + $low ) / 2);  # without 'use integer'"
NSQ_SOURCE_LINE 00000085 "        $found = $array->[$index];"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "        if ( $aValue == $found )"
NSQ_SOURCE_LINE 00000088 "        {"
NSQ_SOURCE_LINE 00000089 "            return undef;"
NSQ_SOURCE_LINE 00000090 "        }"
NSQ_SOURCE_LINE 00000091 "        elsif ( $aValue > $found )"
NSQ_SOURCE_LINE 00000092 "        {"
NSQ_SOURCE_LINE 00000093 "            $low = $index + 1;"
NSQ_SOURCE_LINE 00000094 "        }"
NSQ_SOURCE_LINE 00000095 "        else"
NSQ_SOURCE_LINE 00000096 "        {"
NSQ_SOURCE_LINE 00000097 "            $high = $index - 1;"
NSQ_SOURCE_LINE 00000098 "        }"
NSQ_SOURCE_LINE 00000099 "    }"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "    # now insertion point is in $low."
NSQ_SOURCE_LINE 00000102 "    $array->[$low] = $aValue;    # overwrite next larger"
NSQ_SOURCE_LINE 00000103 "    return $low;"
NSQ_SOURCE_LINE 00000104 "}"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "# This method computes the longest common subsequence in $a and $b."
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "# Result is array or ref, whose contents is such that"
NSQ_SOURCE_LINE 00000109 "#   $a->[ $i ] == $b->[ $result[ $i ] ]"
NSQ_SOURCE_LINE 00000110 "# foreach $i in ( 0 .. $#result ) if $result[ $i ] is defined."
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "# An additional argument may be passed; this is a hash or key generating"
NSQ_SOURCE_LINE 00000113 "# function that should return a string that uniquely identifies the given"
NSQ_SOURCE_LINE 00000114 "# element.  It should be the case that if the key is the same, the elements"
NSQ_SOURCE_LINE 00000115 "# will compare the same. If this parameter is undef or missing, the key"
NSQ_SOURCE_LINE 00000116 "# will be the element as a string."
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "# By default, comparisons will use \"eq\" and elements will be turned into keys"
NSQ_SOURCE_LINE 00000119 "# using the default stringizing operator '\"\"'."
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "# Additional parameters, if any, will be passed to the key generation"
NSQ_SOURCE_LINE 00000122 "# routine."
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "sub _longestCommonSubsequence"
NSQ_SOURCE_LINE 00000125 "{"
NSQ_SOURCE_LINE 00000126 "    my $a        = shift;    # array ref or hash ref"
NSQ_SOURCE_LINE 00000127 "    my $b        = shift;    # array ref or hash ref"
NSQ_SOURCE_LINE 00000128 "    my $counting = shift;    # scalar"
NSQ_SOURCE_LINE 00000129 "    my $keyGen   = shift;    # code ref"
NSQ_SOURCE_LINE 00000130 "    my $compare;             # code ref"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "    if ( ref($a) eq 'HASH' )"
NSQ_SOURCE_LINE 00000133 "    {                        # prepared hash must be in $b"
NSQ_SOURCE_LINE 00000134 "        my $tmp = $b;"
NSQ_SOURCE_LINE 00000135 "        $b = $a;"
NSQ_SOURCE_LINE 00000136 "        $a = $tmp;"
NSQ_SOURCE_LINE 00000137 "    }"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "    # Check for bogus (non-ref) argument values"
NSQ_SOURCE_LINE 00000140 "    if ( !ref($a) || !ref($b) )"
NSQ_SOURCE_LINE 00000141 "    {"
NSQ_SOURCE_LINE 00000142 "        my @callerInfo = caller(1);"
NSQ_SOURCE_LINE 00000143 "        die 'error: must pass array or hash references to ' . $callerInfo[3];"
NSQ_SOURCE_LINE 00000144 "    }"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "    # set up code refs"
NSQ_SOURCE_LINE 00000147 "    # Note that these are optimized."
NSQ_SOURCE_LINE 00000148 "    if ( $keyGen )    # optimize for strings"
NSQ_SOURCE_LINE 00000149 "    {"
NSQ_SOURCE_LINE 00000150 "        $compare = sub {"
NSQ_SOURCE_LINE 00000151 "            my $a = shift;"
NSQ_SOURCE_LINE 00000152 "            my $b = shift;"
NSQ_SOURCE_LINE 00000153 "            &$keyGen( $a, @_ ) eq &$keyGen( $b, @_ );"
NSQ_SOURCE_LINE 00000154 "        };"
NSQ_SOURCE_LINE 00000155 "    }"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "    my ( $aStart, $aFinish, $matchVector ) = ( 0, $#$a, [] );"
NSQ_SOURCE_LINE 00000158 "    my ( $prunedCount, $bMatches ) = ( 0, {} );"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "    if ( ref($b) eq 'HASH' )    # was $bMatches prepared for us?"
NSQ_SOURCE_LINE 00000161 "    {"
NSQ_SOURCE_LINE 00000162 "        $bMatches = $b;"
NSQ_SOURCE_LINE 00000163 "    }"
NSQ_SOURCE_LINE 00000164 "    else"
NSQ_SOURCE_LINE 00000165 "    {"
NSQ_SOURCE_LINE 00000166 "        my ( $bStart, $bFinish ) = ( 0, $#$b );"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "        # First we prune off any common elements at the beginning"
NSQ_SOURCE_LINE 00000169 "        while ( $aStart <= $aFinish"
NSQ_SOURCE_LINE 00000170 "            and $bStart <= $bFinish"
NSQ_SOURCE_LINE 00000171 "            and ( $keyGen ? &$compare( $a->[$aStart], $b->[$bStart], @_ )"
NSQ_SOURCE_LINE 00000172 "                          : ( $a->[$aStart] eq $b->[$bStart] ) ) )"
NSQ_SOURCE_LINE 00000173 "        {"
NSQ_SOURCE_LINE 00000174 "            $matchVector->[ $aStart++ ] = $bStart++;"
NSQ_SOURCE_LINE 00000175 "            $prunedCount++;"
NSQ_SOURCE_LINE 00000176 "        }"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "        # now the end"
NSQ_SOURCE_LINE 00000179 "        while ( $aStart <= $aFinish"
NSQ_SOURCE_LINE 00000180 "            and $bStart <= $bFinish"
NSQ_SOURCE_LINE 00000181 "            and ( $keyGen ? &$compare( $a->[$aFinish], $b->[$bFinish], @_ )"
NSQ_SOURCE_LINE 00000182 "                          : ( $a->[$aFinish] eq $b->[$bFinish] ) ) )"
NSQ_SOURCE_LINE 00000183 "        {"
NSQ_SOURCE_LINE 00000184 "            $matchVector->[ $aFinish-- ] = $bFinish--;"
NSQ_SOURCE_LINE 00000185 "            $prunedCount++;"
NSQ_SOURCE_LINE 00000186 "        }"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "        # Now compute the equivalence classes of positions of elements"
NSQ_SOURCE_LINE 00000189 "        $bMatches ="
NSQ_SOURCE_LINE 00000190 "          _withPositionsOfInInterval( $b, $bStart, $bFinish, $keyGen, @_ );"
NSQ_SOURCE_LINE 00000191 "    }"
NSQ_SOURCE_LINE 00000192 "    my $thresh = [];"
NSQ_SOURCE_LINE 00000193 "    my $links  = [];"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "    my ( $i, $ai, $j, $k );"
NSQ_SOURCE_LINE 00000196 "    for ( $i = $aStart ; $i <= $aFinish ; $i++ )"
NSQ_SOURCE_LINE 00000197 "    {"
NSQ_SOURCE_LINE 00000198 "        $ai = $keyGen ? &$keyGen( $a->[$i], @_ ) : $a->[$i];"
NSQ_SOURCE_LINE 00000199 "        if ( exists( $bMatches->{$ai} ) )"
NSQ_SOURCE_LINE 00000200 "        {"
NSQ_SOURCE_LINE 00000201 "            $k = 0;"
NSQ_SOURCE_LINE 00000202 "            for $j ( @{ $bMatches->{$ai} } )"
NSQ_SOURCE_LINE 00000203 "            {"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "                # optimization: most of the time this will be true"
NSQ_SOURCE_LINE 00000206 "                if ( $k and $thresh->[$k] > $j and $thresh->[ $k - 1 ] < $j )"
NSQ_SOURCE_LINE 00000207 "                {"
NSQ_SOURCE_LINE 00000208 "                    $thresh->[$k] = $j;"
NSQ_SOURCE_LINE 00000209 "                }"
NSQ_SOURCE_LINE 00000210 "                else"
NSQ_SOURCE_LINE 00000211 "                {"
NSQ_SOURCE_LINE 00000212 "                    $k = _replaceNextLargerWith( $thresh, $j, $k );"
NSQ_SOURCE_LINE 00000213 "                }"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "                # oddly, it's faster to always test this (CPU cache?)."
NSQ_SOURCE_LINE 00000216 "                if ( defined($k) )"
NSQ_SOURCE_LINE 00000217 "                {"
NSQ_SOURCE_LINE 00000218 "                    $links->[$k] ="
NSQ_SOURCE_LINE 00000219 "                      [ ( $k ? $links->[ $k - 1 ] : undef ), $i, $j ];"
NSQ_SOURCE_LINE 00000220 "                }"
NSQ_SOURCE_LINE 00000221 "            }"
NSQ_SOURCE_LINE 00000222 "        }"
NSQ_SOURCE_LINE 00000223 "    }"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "    if (@$thresh)"
NSQ_SOURCE_LINE 00000226 "    {"
NSQ_SOURCE_LINE 00000227 "        return $prunedCount + @$thresh if $counting;"
NSQ_SOURCE_LINE 00000228 "        for ( my $link = $links->[$#$thresh] ; $link ; $link = $link->[0] )"
NSQ_SOURCE_LINE 00000229 "        {"
NSQ_SOURCE_LINE 00000230 "            $matchVector->[ $link->[1] ] = $link->[2];"
NSQ_SOURCE_LINE 00000231 "        }"
NSQ_SOURCE_LINE 00000232 "    }"
NSQ_SOURCE_LINE 00000233 "    elsif ($counting)"
NSQ_SOURCE_LINE 00000234 "    {"
NSQ_SOURCE_LINE 00000235 "        return $prunedCount;"
NSQ_SOURCE_LINE 00000236 "    }"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "    return wantarray ? @$matchVector : $matchVector;"
NSQ_SOURCE_LINE 00000239 "}"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "sub traverse_sequences"
NSQ_SOURCE_LINE 00000242 "{"
NSQ_SOURCE_LINE 00000243 "    my $a                 = shift;          # array ref"
NSQ_SOURCE_LINE 00000244 "    my $b                 = shift;          # array ref"
NSQ_SOURCE_LINE 00000245 "    my $callbacks         = shift || {};"
NSQ_SOURCE_LINE 00000246 "    my $keyGen            = shift;"
NSQ_SOURCE_LINE 00000247 "    my $matchCallback     = $callbacks->{'MATCH'} || sub { };"
NSQ_SOURCE_LINE 00000248 "    my $discardACallback  = $callbacks->{'DISCARD_A'} || sub { };"
NSQ_SOURCE_LINE 00000249 "    my $finishedACallback = $callbacks->{'A_FINISHED'};"
NSQ_SOURCE_LINE 00000250 "    my $discardBCallback  = $callbacks->{'DISCARD_B'} || sub { };"
NSQ_SOURCE_LINE 00000251 "    my $finishedBCallback = $callbacks->{'B_FINISHED'};"
NSQ_SOURCE_LINE 00000252 "    my $matchVector = _longestCommonSubsequence( $a, $b, 0, $keyGen, @_ );"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "    # Process all the lines in @$matchVector"
NSQ_SOURCE_LINE 00000255 "    my $lastA = $#$a;"
NSQ_SOURCE_LINE 00000256 "    my $lastB = $#$b;"
NSQ_SOURCE_LINE 00000257 "    my $bi    = 0;"
NSQ_SOURCE_LINE 00000258 "    my $ai;"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "    for ( $ai = 0 ; $ai <= $#$matchVector ; $ai++ )"
NSQ_SOURCE_LINE 00000261 "    {"
NSQ_SOURCE_LINE 00000262 "        my $bLine = $matchVector->[$ai];"
NSQ_SOURCE_LINE 00000263 "        if ( defined($bLine) )    # matched"
NSQ_SOURCE_LINE 00000264 "        {"
NSQ_SOURCE_LINE 00000265 "            &$discardBCallback( $ai, $bi++, @_ ) while $bi < $bLine;"
NSQ_SOURCE_LINE 00000266 "            &$matchCallback( $ai,    $bi++, @_ );"
NSQ_SOURCE_LINE 00000267 "        }"
NSQ_SOURCE_LINE 00000268 "        else"
NSQ_SOURCE_LINE 00000269 "        {"
NSQ_SOURCE_LINE 00000270 "            &$discardACallback( $ai, $bi, @_ );"
NSQ_SOURCE_LINE 00000271 "        }"
NSQ_SOURCE_LINE 00000272 "    }"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "    # The last entry (if any) processed was a match."
NSQ_SOURCE_LINE 00000275 "    # $ai and $bi point just past the last matching lines in their sequences."
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "    while ( $ai <= $lastA or $bi <= $lastB )"
NSQ_SOURCE_LINE 00000278 "    {"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "        # last A?"
NSQ_SOURCE_LINE 00000281 "        if ( $ai == $lastA + 1 and $bi <= $lastB )"
NSQ_SOURCE_LINE 00000282 "        {"
NSQ_SOURCE_LINE 00000283 "            if ( defined($finishedACallback) )"
NSQ_SOURCE_LINE 00000284 "            {"
NSQ_SOURCE_LINE 00000285 "                &$finishedACallback( $lastA, @_ );"
NSQ_SOURCE_LINE 00000286 "                $finishedACallback = undef;"
NSQ_SOURCE_LINE 00000287 "            }"
NSQ_SOURCE_LINE 00000288 "            else"
NSQ_SOURCE_LINE 00000289 "            {"
NSQ_SOURCE_LINE 00000290 "                &$discardBCallback( $ai, $bi++, @_ ) while $bi <= $lastB;"
NSQ_SOURCE_LINE 00000291 "            }"
NSQ_SOURCE_LINE 00000292 "        }"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "        # last B?"
NSQ_SOURCE_LINE 00000295 "        if ( $bi == $lastB + 1 and $ai <= $lastA )"
NSQ_SOURCE_LINE 00000296 "        {"
NSQ_SOURCE_LINE 00000297 "            if ( defined($finishedBCallback) )"
NSQ_SOURCE_LINE 00000298 "            {"
NSQ_SOURCE_LINE 00000299 "                &$finishedBCallback( $lastB, @_ );"
NSQ_SOURCE_LINE 00000300 "                $finishedBCallback = undef;"
NSQ_SOURCE_LINE 00000301 "            }"
NSQ_SOURCE_LINE 00000302 "            else"
NSQ_SOURCE_LINE 00000303 "            {"
NSQ_SOURCE_LINE 00000304 "                &$discardACallback( $ai++, $bi, @_ ) while $ai <= $lastA;"
NSQ_SOURCE_LINE 00000305 "            }"
NSQ_SOURCE_LINE 00000306 "        }"
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "        &$discardACallback( $ai++, $bi, @_ ) if $ai <= $lastA;"
NSQ_SOURCE_LINE 00000309 "        &$discardBCallback( $ai, $bi++, @_ ) if $bi <= $lastB;"
NSQ_SOURCE_LINE 00000310 "    }"
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "    return 1;"
NSQ_SOURCE_LINE 00000313 "}"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "sub traverse_balanced"
NSQ_SOURCE_LINE 00000316 "{"
NSQ_SOURCE_LINE 00000317 "    my $a                 = shift;              # array ref"
NSQ_SOURCE_LINE 00000318 "    my $b                 = shift;              # array ref"
NSQ_SOURCE_LINE 00000319 "    my $callbacks         = shift || {};"
NSQ_SOURCE_LINE 00000320 "    my $keyGen            = shift;"
NSQ_SOURCE_LINE 00000321 "    my $matchCallback     = $callbacks->{'MATCH'} || sub { };"
NSQ_SOURCE_LINE 00000322 "    my $discardACallback  = $callbacks->{'DISCARD_A'} || sub { };"
NSQ_SOURCE_LINE 00000323 "    my $discardBCallback  = $callbacks->{'DISCARD_B'} || sub { };"
NSQ_SOURCE_LINE 00000324 "    my $changeCallback    = $callbacks->{'CHANGE'};"
NSQ_SOURCE_LINE 00000325 "    my $matchVector = _longestCommonSubsequence( $a, $b, 0, $keyGen, @_ );"
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "    # Process all the lines in match vector"
NSQ_SOURCE_LINE 00000328 "    my $lastA = $#$a;"
NSQ_SOURCE_LINE 00000329 "    my $lastB = $#$b;"
NSQ_SOURCE_LINE 00000330 "    my $bi    = 0;"
NSQ_SOURCE_LINE 00000331 "    my $ai    = 0;"
NSQ_SOURCE_LINE 00000332 "    my $ma    = -1;"
NSQ_SOURCE_LINE 00000333 "    my $mb;"
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "    while (1)"
NSQ_SOURCE_LINE 00000336 "    {"
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "        # Find next match indices $ma and $mb"
NSQ_SOURCE_LINE 00000339 "        do {"
NSQ_SOURCE_LINE 00000340 "            $ma++;"
NSQ_SOURCE_LINE 00000341 "        } while("
NSQ_SOURCE_LINE 00000342 "                $ma <= $#$matchVector"
NSQ_SOURCE_LINE 00000343 "            &&  !defined $matchVector->[$ma]"
NSQ_SOURCE_LINE 00000344 "        );"
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "        last if $ma > $#$matchVector;    # end of matchVector?"
NSQ_SOURCE_LINE 00000347 "        $mb = $matchVector->[$ma];"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "        # Proceed with discard a/b or change events until"
NSQ_SOURCE_LINE 00000350 "        # next match"
NSQ_SOURCE_LINE 00000351 "        while ( $ai < $ma || $bi < $mb )"
NSQ_SOURCE_LINE 00000352 "        {"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "            if ( $ai < $ma && $bi < $mb )"
NSQ_SOURCE_LINE 00000355 "            {"
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "                # Change"
NSQ_SOURCE_LINE 00000358 "                if ( defined $changeCallback )"
NSQ_SOURCE_LINE 00000359 "                {"
NSQ_SOURCE_LINE 00000360 "                    &$changeCallback( $ai++, $bi++, @_ );"
NSQ_SOURCE_LINE 00000361 "                }"
NSQ_SOURCE_LINE 00000362 "                else"
NSQ_SOURCE_LINE 00000363 "                {"
NSQ_SOURCE_LINE 00000364 "                    &$discardACallback( $ai++, $bi, @_ );"
NSQ_SOURCE_LINE 00000365 "                    &$discardBCallback( $ai, $bi++, @_ );"
NSQ_SOURCE_LINE 00000366 "                }"
NSQ_SOURCE_LINE 00000367 "            }"
NSQ_SOURCE_LINE 00000368 "            elsif ( $ai < $ma )"
NSQ_SOURCE_LINE 00000369 "            {"
NSQ_SOURCE_LINE 00000370 "                &$discardACallback( $ai++, $bi, @_ );"
NSQ_SOURCE_LINE 00000371 "            }"
NSQ_SOURCE_LINE 00000372 "            else"
NSQ_SOURCE_LINE 00000373 "            {"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "                # $bi < $mb"
NSQ_SOURCE_LINE 00000376 "                &$discardBCallback( $ai, $bi++, @_ );"
NSQ_SOURCE_LINE 00000377 "            }"
NSQ_SOURCE_LINE 00000378 "        }"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "        # Match"
NSQ_SOURCE_LINE 00000381 "        &$matchCallback( $ai++, $bi++, @_ );"
NSQ_SOURCE_LINE 00000382 "    }"
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "    while ( $ai <= $lastA || $bi <= $lastB )"
NSQ_SOURCE_LINE 00000385 "    {"
NSQ_SOURCE_LINE 00000386 "        if ( $ai <= $lastA && $bi <= $lastB )"
NSQ_SOURCE_LINE 00000387 "        {"
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "            # Change"
NSQ_SOURCE_LINE 00000390 "            if ( defined $changeCallback )"
NSQ_SOURCE_LINE 00000391 "            {"
NSQ_SOURCE_LINE 00000392 "                &$changeCallback( $ai++, $bi++, @_ );"
NSQ_SOURCE_LINE 00000393 "            }"
NSQ_SOURCE_LINE 00000394 "            else"
NSQ_SOURCE_LINE 00000395 "            {"
NSQ_SOURCE_LINE 00000396 "                &$discardACallback( $ai++, $bi, @_ );"
NSQ_SOURCE_LINE 00000397 "                &$discardBCallback( $ai, $bi++, @_ );"
NSQ_SOURCE_LINE 00000398 "            }"
NSQ_SOURCE_LINE 00000399 "        }"
NSQ_SOURCE_LINE 00000400 "        elsif ( $ai <= $lastA )"
NSQ_SOURCE_LINE 00000401 "        {"
NSQ_SOURCE_LINE 00000402 "            &$discardACallback( $ai++, $bi, @_ );"
NSQ_SOURCE_LINE 00000403 "        }"
NSQ_SOURCE_LINE 00000404 "        else"
NSQ_SOURCE_LINE 00000405 "        {"
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "            # $bi <= $lastB"
NSQ_SOURCE_LINE 00000408 "            &$discardBCallback( $ai, $bi++, @_ );"
NSQ_SOURCE_LINE 00000409 "        }"
NSQ_SOURCE_LINE 00000410 "    }"
NSQ_SOURCE_LINE 00000411 ""
NSQ_SOURCE_LINE 00000412 "    return 1;"
NSQ_SOURCE_LINE 00000413 "}"
NSQ_SOURCE_LINE 00000414 ""
NSQ_SOURCE_LINE 00000415 "sub prepare"
NSQ_SOURCE_LINE 00000416 "{"
NSQ_SOURCE_LINE 00000417 "    my $a       = shift;    # array ref"
NSQ_SOURCE_LINE 00000418 "    my $keyGen  = shift;    # code ref"
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "    # set up code ref"
NSQ_SOURCE_LINE 00000421 "    $keyGen = sub { $_[0] } unless defined($keyGen);"
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "    return scalar _withPositionsOfInInterval( $a, 0, $#$a, $keyGen, @_ );"
NSQ_SOURCE_LINE 00000424 "}"
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 "sub LCS"
NSQ_SOURCE_LINE 00000427 "{"
NSQ_SOURCE_LINE 00000428 "    my $a = shift;                  # array ref"
NSQ_SOURCE_LINE 00000429 "    my $b = shift;                  # array ref or hash ref"
NSQ_SOURCE_LINE 00000430 "    my $matchVector = _longestCommonSubsequence( $a, $b, 0, @_ );"
NSQ_SOURCE_LINE 00000431 "    my @retval;"
NSQ_SOURCE_LINE 00000432 "    my $i;"
NSQ_SOURCE_LINE 00000433 "    for ( $i = 0 ; $i <= $#$matchVector ; $i++ )"
NSQ_SOURCE_LINE 00000434 "    {"
NSQ_SOURCE_LINE 00000435 "        if ( defined( $matchVector->[$i] ) )"
NSQ_SOURCE_LINE 00000436 "        {"
NSQ_SOURCE_LINE 00000437 "            push ( @retval, $a->[$i] );"
NSQ_SOURCE_LINE 00000438 "        }"
NSQ_SOURCE_LINE 00000439 "    }"
NSQ_SOURCE_LINE 00000440 "    return wantarray ? @retval : \\@retval;"
NSQ_SOURCE_LINE 00000441 "}"
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "sub LCS_length"
NSQ_SOURCE_LINE 00000444 "{"
NSQ_SOURCE_LINE 00000445 "    my $a = shift;                          # array ref"
NSQ_SOURCE_LINE 00000446 "    my $b = shift;                          # array ref or hash ref"
NSQ_SOURCE_LINE 00000447 "    return _longestCommonSubsequence( $a, $b, 1, @_ );"
NSQ_SOURCE_LINE 00000448 "}"
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "sub LCSidx"
NSQ_SOURCE_LINE 00000451 "{"
NSQ_SOURCE_LINE 00000452 "    my $a= shift @_;"
NSQ_SOURCE_LINE 00000453 "    my $b= shift @_;"
NSQ_SOURCE_LINE 00000454 "    my $match= _longestCommonSubsequence( $a, $b, 0, @_ );"
NSQ_SOURCE_LINE 00000455 "    my @am= grep defined $match->[$_], 0..$#$match;"
NSQ_SOURCE_LINE 00000456 "    my @bm= @{$match}[@am];"
NSQ_SOURCE_LINE 00000457 "    return \\@am, \\@bm;"
NSQ_SOURCE_LINE 00000458 "}"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "sub compact_diff"
NSQ_SOURCE_LINE 00000461 "{"
NSQ_SOURCE_LINE 00000462 "    my $a= shift @_;"
NSQ_SOURCE_LINE 00000463 "    my $b= shift @_;"
NSQ_SOURCE_LINE 00000464 "    my( $am, $bm )= LCSidx( $a, $b, @_ );"
NSQ_SOURCE_LINE 00000465 "    my @cdiff;"
NSQ_SOURCE_LINE 00000466 "    my( $ai, $bi )= ( 0, 0 );"
NSQ_SOURCE_LINE 00000467 "    push @cdiff, $ai, $bi;"
NSQ_SOURCE_LINE 00000468 "    while( 1 ) {"
NSQ_SOURCE_LINE 00000469 "        while(  @$am  &&  $ai == $am->[0]  &&  $bi == $bm->[0]  ) {"
NSQ_SOURCE_LINE 00000470 "            shift @$am;"
NSQ_SOURCE_LINE 00000471 "            shift @$bm;"
NSQ_SOURCE_LINE 00000472 "            ++$ai, ++$bi;"
NSQ_SOURCE_LINE 00000473 "        }"
NSQ_SOURCE_LINE 00000474 "        push @cdiff, $ai, $bi;"
NSQ_SOURCE_LINE 00000475 "        last   if  ! @$am;"
NSQ_SOURCE_LINE 00000476 "        $ai = $am->[0];"
NSQ_SOURCE_LINE 00000477 "        $bi = $bm->[0];"
NSQ_SOURCE_LINE 00000478 "        push @cdiff, $ai, $bi;"
NSQ_SOURCE_LINE 00000479 "    }"
NSQ_SOURCE_LINE 00000480 "    push @cdiff, 0+@$a, 0+@$b"
NSQ_SOURCE_LINE 00000481 "        if  $ai < @$a || $bi < @$b;"
NSQ_SOURCE_LINE 00000482 "    return wantarray ? @cdiff : \\@cdiff;"
NSQ_SOURCE_LINE 00000483 "}"
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "sub diff"
NSQ_SOURCE_LINE 00000486 "{"
NSQ_SOURCE_LINE 00000487 "    my $a      = shift;    # array ref"
NSQ_SOURCE_LINE 00000488 "    my $b      = shift;    # array ref"
NSQ_SOURCE_LINE 00000489 "    my $retval = [];"
NSQ_SOURCE_LINE 00000490 "    my $hunk   = [];"
NSQ_SOURCE_LINE 00000491 "    my $discard = sub {"
NSQ_SOURCE_LINE 00000492 "        push @$hunk, [ '-', $_[0], $a->[ $_[0] ] ];"
NSQ_SOURCE_LINE 00000493 "    };"
NSQ_SOURCE_LINE 00000494 "    my $add = sub {"
NSQ_SOURCE_LINE 00000495 "        push @$hunk, [ '+', $_[1], $b->[ $_[1] ] ];"
NSQ_SOURCE_LINE 00000496 "    };"
NSQ_SOURCE_LINE 00000497 "    my $match = sub {"
NSQ_SOURCE_LINE 00000498 "        push @$retval, $hunk"
NSQ_SOURCE_LINE 00000499 "            if 0 < @$hunk;"
NSQ_SOURCE_LINE 00000500 "        $hunk = []"
NSQ_SOURCE_LINE 00000501 "    };"
NSQ_SOURCE_LINE 00000502 "    traverse_sequences( $a, $b,"
NSQ_SOURCE_LINE 00000503 "        { MATCH => $match, DISCARD_A => $discard, DISCARD_B => $add }, @_ );"
NSQ_SOURCE_LINE 00000504 "    &$match();"
NSQ_SOURCE_LINE 00000505 "    return wantarray ? @$retval : $retval;"
NSQ_SOURCE_LINE 00000506 "}"
NSQ_SOURCE_LINE 00000507 ""
NSQ_SOURCE_LINE 00000508 "sub sdiff"
NSQ_SOURCE_LINE 00000509 "{"
NSQ_SOURCE_LINE 00000510 "    my $a      = shift;    # array ref"
NSQ_SOURCE_LINE 00000511 "    my $b      = shift;    # array ref"
NSQ_SOURCE_LINE 00000512 "    my $retval = [];"
NSQ_SOURCE_LINE 00000513 "    my $discard = sub { push ( @$retval, [ '-', $a->[ $_[0] ], \"\" ] ) };"
NSQ_SOURCE_LINE 00000514 "    my $add = sub { push ( @$retval, [ '+', \"\", $b->[ $_[1] ] ] ) };"
NSQ_SOURCE_LINE 00000515 "    my $change = sub {"
NSQ_SOURCE_LINE 00000516 "        push ( @$retval, [ 'c', $a->[ $_[0] ], $b->[ $_[1] ] ] );"
NSQ_SOURCE_LINE 00000517 "    };"
NSQ_SOURCE_LINE 00000518 "    my $match = sub {"
NSQ_SOURCE_LINE 00000519 "        push ( @$retval, [ 'u', $a->[ $_[0] ], $b->[ $_[1] ] ] );"
NSQ_SOURCE_LINE 00000520 "    };"
NSQ_SOURCE_LINE 00000521 "    traverse_balanced("
NSQ_SOURCE_LINE 00000522 "        $a,"
NSQ_SOURCE_LINE 00000523 "        $b,"
NSQ_SOURCE_LINE 00000524 "        {"
NSQ_SOURCE_LINE 00000525 "            MATCH     => $match,"
NSQ_SOURCE_LINE 00000526 "            DISCARD_A => $discard,"
NSQ_SOURCE_LINE 00000527 "            DISCARD_B => $add,"
NSQ_SOURCE_LINE 00000528 "            CHANGE    => $change,"
NSQ_SOURCE_LINE 00000529 "        },"
NSQ_SOURCE_LINE 00000530 "        @_"
NSQ_SOURCE_LINE 00000531 "    );"
NSQ_SOURCE_LINE 00000532 "    return wantarray ? @$retval : $retval;"
NSQ_SOURCE_LINE 00000533 "}"
NSQ_SOURCE_LINE 00000534 ""
NSQ_SOURCE_LINE 00000535 "########################################"
NSQ_SOURCE_LINE 00000536 "my $Root= __PACKAGE__;"
NSQ_SOURCE_LINE 00000537 "package Algorithm::Diff::_impl;"
NSQ_SOURCE_LINE 00000538 "use strict;"
NSQ_SOURCE_LINE 00000539 ""
NSQ_SOURCE_LINE 00000540 "sub _Idx()  { 0 } # $me->[_Idx]: Ref to array of hunk indices"
NSQ_SOURCE_LINE 00000541 "            # 1   # $me->[1]: Ref to first sequence"
NSQ_SOURCE_LINE 00000542 "            # 2   # $me->[2]: Ref to second sequence"
NSQ_SOURCE_LINE 00000543 "sub _End()  { 3 } # $me->[_End]: Diff between forward and reverse pos"
NSQ_SOURCE_LINE 00000544 "sub _Same() { 4 } # $me->[_Same]: 1 if pos 1 contains unchanged items"
NSQ_SOURCE_LINE 00000545 "sub _Base() { 5 } # $me->[_Base]: Added to range's min and max"
NSQ_SOURCE_LINE 00000546 "sub _Pos()  { 6 } # $me->[_Pos]: Which hunk is currently selected"
NSQ_SOURCE_LINE 00000547 "sub _Off()  { 7 } # $me->[_Off]: Offset into _Idx for current position"
NSQ_SOURCE_LINE 00000548 "sub _Min() { -2 } # Added to _Off to get min instead of max+1"
NSQ_SOURCE_LINE 00000549 ""
NSQ_SOURCE_LINE 00000550 "sub Die"
NSQ_SOURCE_LINE 00000551 "{"
NSQ_SOURCE_LINE 00000552 "    require Carp;"
NSQ_SOURCE_LINE 00000553 "    Carp::confess( @_ );"
NSQ_SOURCE_LINE 00000554 "}"
NSQ_SOURCE_LINE 00000555 ""
NSQ_SOURCE_LINE 00000556 "sub _ChkPos"
NSQ_SOURCE_LINE 00000557 "{"
NSQ_SOURCE_LINE 00000558 "    my( $me )= @_;"
NSQ_SOURCE_LINE 00000559 "    return   if  $me->[_Pos];"
NSQ_SOURCE_LINE 00000560 "    my $meth= ( caller(1) )[3];"
NSQ_SOURCE_LINE 00000561 "    Die( \"Called $meth on 'reset' object\" );"
NSQ_SOURCE_LINE 00000562 "}"
NSQ_SOURCE_LINE 00000563 ""
NSQ_SOURCE_LINE 00000564 "sub _ChkSeq"
NSQ_SOURCE_LINE 00000565 "{"
NSQ_SOURCE_LINE 00000566 "    my( $me, $seq )= @_;"
NSQ_SOURCE_LINE 00000567 "    return $seq + $me->[_Off]"
NSQ_SOURCE_LINE 00000568 "        if  1 == $seq  ||  2 == $seq;"
NSQ_SOURCE_LINE 00000569 "    my $meth= ( caller(1) )[3];"
NSQ_SOURCE_LINE 00000570 "    Die( \"$meth: Invalid sequence number ($seq); must be 1 or 2\" );"
NSQ_SOURCE_LINE 00000571 "}"
NSQ_SOURCE_LINE 00000572 ""
NSQ_SOURCE_LINE 00000573 "sub getObjPkg"
NSQ_SOURCE_LINE 00000574 "{"
NSQ_SOURCE_LINE 00000575 "    my( $us )= @_;"
NSQ_SOURCE_LINE 00000576 "    return ref $us   if  ref $us;"
NSQ_SOURCE_LINE 00000577 "    return $us . \"::_obj\";"
NSQ_SOURCE_LINE 00000578 "}"
NSQ_SOURCE_LINE 00000579 ""
NSQ_SOURCE_LINE 00000580 "sub new"
NSQ_SOURCE_LINE 00000581 "{"
NSQ_SOURCE_LINE 00000582 "    my( $us, $seq1, $seq2, $opts ) = @_;"
NSQ_SOURCE_LINE 00000583 "    my @args;"
NSQ_SOURCE_LINE 00000584 "    for( $opts->{keyGen} ) {"
NSQ_SOURCE_LINE 00000585 "        push @args, $_   if  $_;"
NSQ_SOURCE_LINE 00000586 "    }"
NSQ_SOURCE_LINE 00000587 "    for( $opts->{keyGenArgs} ) {"
NSQ_SOURCE_LINE 00000588 "        push @args, @$_   if  $_;"
NSQ_SOURCE_LINE 00000589 "    }"
NSQ_SOURCE_LINE 00000590 "    my $cdif= Algorithm::Diff::compact_diff( $seq1, $seq2, @args );"
NSQ_SOURCE_LINE 00000591 "    my $same= 1;"
NSQ_SOURCE_LINE 00000592 "    if(  0 == $cdif->[2]  &&  0 == $cdif->[3]  ) {"
NSQ_SOURCE_LINE 00000593 "        $same= 0;"
NSQ_SOURCE_LINE 00000594 "        splice @$cdif, 0, 2;"
NSQ_SOURCE_LINE 00000595 "    }"
NSQ_SOURCE_LINE 00000596 "    my @obj= ( $cdif, $seq1, $seq2 );"
NSQ_SOURCE_LINE 00000597 "    $obj[_End] = (1+@$cdif)/2;"
NSQ_SOURCE_LINE 00000598 "    $obj[_Same] = $same;"
NSQ_SOURCE_LINE 00000599 "    $obj[_Base] = 0;"
NSQ_SOURCE_LINE 00000600 "    my $me = bless \\@obj, $us->getObjPkg();"
NSQ_SOURCE_LINE 00000601 "    $me->Reset( 0 );"
NSQ_SOURCE_LINE 00000602 "    return $me;"
NSQ_SOURCE_LINE 00000603 "}"
NSQ_SOURCE_LINE 00000604 ""
NSQ_SOURCE_LINE 00000605 "sub Reset"
NSQ_SOURCE_LINE 00000606 "{"
NSQ_SOURCE_LINE 00000607 "    my( $me, $pos )= @_;"
NSQ_SOURCE_LINE 00000608 "    $pos= int( $pos || 0 );"
NSQ_SOURCE_LINE 00000609 "    $pos += $me->[_End]"
NSQ_SOURCE_LINE 00000610 "        if  $pos < 0;"
NSQ_SOURCE_LINE 00000611 "    $pos= 0"
NSQ_SOURCE_LINE 00000612 "        if  $pos < 0  ||  $me->[_End] <= $pos;"
NSQ_SOURCE_LINE 00000613 "    $me->[_Pos]= $pos || !1;"
NSQ_SOURCE_LINE 00000614 "    $me->[_Off]= 2*$pos - 1;"
NSQ_SOURCE_LINE 00000615 "    return $me;"
NSQ_SOURCE_LINE 00000616 "}"
NSQ_SOURCE_LINE 00000617 ""
NSQ_SOURCE_LINE 00000618 "sub Base"
NSQ_SOURCE_LINE 00000619 "{"
NSQ_SOURCE_LINE 00000620 "    my( $me, $base )= @_;"
NSQ_SOURCE_LINE 00000621 "    my $oldBase= $me->[_Base];"
NSQ_SOURCE_LINE 00000622 "    $me->[_Base]= 0+$base   if  defined $base;"
NSQ_SOURCE_LINE 00000623 "    return $oldBase;"
NSQ_SOURCE_LINE 00000624 "}"
NSQ_SOURCE_LINE 00000625 ""
NSQ_SOURCE_LINE 00000626 "sub Copy"
NSQ_SOURCE_LINE 00000627 "{"
NSQ_SOURCE_LINE 00000628 "    my( $me, $pos, $base )= @_;"
NSQ_SOURCE_LINE 00000629 "    my @obj= @$me;"
NSQ_SOURCE_LINE 00000630 "    my $you= bless \\@obj, ref($me);"
NSQ_SOURCE_LINE 00000631 "    $you->Reset( $pos )   if  defined $pos;"
NSQ_SOURCE_LINE 00000632 "    $you->Base( $base );"
NSQ_SOURCE_LINE 00000633 "    return $you;"
NSQ_SOURCE_LINE 00000634 "}"
NSQ_SOURCE_LINE 00000635 ""
NSQ_SOURCE_LINE 00000636 "sub Next {"
NSQ_SOURCE_LINE 00000637 "    my( $me, $steps )= @_;"
NSQ_SOURCE_LINE 00000638 "    $steps= 1   if  ! defined $steps;"
NSQ_SOURCE_LINE 00000639 "    if( $steps ) {"
NSQ_SOURCE_LINE 00000640 "        my $pos= $me->[_Pos];"
NSQ_SOURCE_LINE 00000641 "        my $new= $pos + $steps;"
NSQ_SOURCE_LINE 00000642 "        $new= 0   if  $pos  &&  $new < 0;"
NSQ_SOURCE_LINE 00000643 "        $me->Reset( $new )"
NSQ_SOURCE_LINE 00000644 "    }"
NSQ_SOURCE_LINE 00000645 "    return $me->[_Pos];"
NSQ_SOURCE_LINE 00000646 "}"
NSQ_SOURCE_LINE 00000647 ""
NSQ_SOURCE_LINE 00000648 "sub Prev {"
NSQ_SOURCE_LINE 00000649 "    my( $me, $steps )= @_;"
NSQ_SOURCE_LINE 00000650 "    $steps= 1   if  ! defined $steps;"
NSQ_SOURCE_LINE 00000651 "    my $pos= $me->Next(-$steps);"
NSQ_SOURCE_LINE 00000652 "    $pos -= $me->[_End]   if  $pos;"
NSQ_SOURCE_LINE 00000653 "    return $pos;"
NSQ_SOURCE_LINE 00000654 "}"
NSQ_SOURCE_LINE 00000655 ""
NSQ_SOURCE_LINE 00000656 "sub Diff {"
NSQ_SOURCE_LINE 00000657 "    my( $me )= @_;"
NSQ_SOURCE_LINE 00000658 "    $me->_ChkPos();"
NSQ_SOURCE_LINE 00000659 "    return 0   if  $me->[_Same] == ( 1 & $me->[_Pos] );"
NSQ_SOURCE_LINE 00000660 "    my $ret= 0;"
NSQ_SOURCE_LINE 00000661 "    my $off= $me->[_Off];"
NSQ_SOURCE_LINE 00000662 "    for my $seq ( 1, 2 ) {"
NSQ_SOURCE_LINE 00000663 "        $ret |= $seq"
NSQ_SOURCE_LINE 00000664 "            if  $me->[_Idx][ $off + $seq + _Min ]"
NSQ_SOURCE_LINE 00000665 "            <   $me->[_Idx][ $off + $seq ];"
NSQ_SOURCE_LINE 00000666 "    }"
NSQ_SOURCE_LINE 00000667 "    return $ret;"
NSQ_SOURCE_LINE 00000668 "}"
NSQ_SOURCE_LINE 00000669 ""
NSQ_SOURCE_LINE 00000670 "sub Min {"
NSQ_SOURCE_LINE 00000671 "    my( $me, $seq, $base )= @_;"
NSQ_SOURCE_LINE 00000672 "    $me->_ChkPos();"
NSQ_SOURCE_LINE 00000673 "    my $off= $me->_ChkSeq($seq);"
NSQ_SOURCE_LINE 00000674 "    $base= $me->[_Base] if !defined $base;"
NSQ_SOURCE_LINE 00000675 "    return $base + $me->[_Idx][ $off + _Min ];"
NSQ_SOURCE_LINE 00000676 "}"
NSQ_SOURCE_LINE 00000677 ""
NSQ_SOURCE_LINE 00000678 "sub Max {"
NSQ_SOURCE_LINE 00000679 "    my( $me, $seq, $base )= @_;"
NSQ_SOURCE_LINE 00000680 "    $me->_ChkPos();"
NSQ_SOURCE_LINE 00000681 "    my $off= $me->_ChkSeq($seq);"
NSQ_SOURCE_LINE 00000682 "    $base= $me->[_Base] if !defined $base;"
NSQ_SOURCE_LINE 00000683 "    return $base + $me->[_Idx][ $off ] -1;"
NSQ_SOURCE_LINE 00000684 "}"
NSQ_SOURCE_LINE 00000685 ""
NSQ_SOURCE_LINE 00000686 "sub Range {"
NSQ_SOURCE_LINE 00000687 "    my( $me, $seq, $base )= @_;"
NSQ_SOURCE_LINE 00000688 "    $me->_ChkPos();"
NSQ_SOURCE_LINE 00000689 "    my $off = $me->_ChkSeq($seq);"
NSQ_SOURCE_LINE 00000690 "    if( !wantarray ) {"
NSQ_SOURCE_LINE 00000691 "        return  $me->[_Idx][ $off ]"
NSQ_SOURCE_LINE 00000692 "            -   $me->[_Idx][ $off + _Min ];"
NSQ_SOURCE_LINE 00000693 "    }"
NSQ_SOURCE_LINE 00000694 "    $base= $me->[_Base] if !defined $base;"
NSQ_SOURCE_LINE 00000695 "    return  ( $base + $me->[_Idx][ $off + _Min ] )"
NSQ_SOURCE_LINE 00000696 "        ..  ( $base + $me->[_Idx][ $off ] - 1 );"
NSQ_SOURCE_LINE 00000697 "}"
NSQ_SOURCE_LINE 00000698 ""
NSQ_SOURCE_LINE 00000699 "sub Items {"
NSQ_SOURCE_LINE 00000700 "    my( $me, $seq )= @_;"
NSQ_SOURCE_LINE 00000701 "    $me->_ChkPos();"
NSQ_SOURCE_LINE 00000702 "    my $off = $me->_ChkSeq($seq);"
NSQ_SOURCE_LINE 00000703 "    if( !wantarray ) {"
NSQ_SOURCE_LINE 00000704 "        return  $me->[_Idx][ $off ]"
NSQ_SOURCE_LINE 00000705 "            -   $me->[_Idx][ $off + _Min ];"
NSQ_SOURCE_LINE 00000706 "    }"
NSQ_SOURCE_LINE 00000707 "    return"
NSQ_SOURCE_LINE 00000708 "        @{$me->[$seq]}["
NSQ_SOURCE_LINE 00000709 "                $me->[_Idx][ $off + _Min ]"
NSQ_SOURCE_LINE 00000710 "            ..  ( $me->[_Idx][ $off ] - 1 )"
NSQ_SOURCE_LINE 00000711 "        ];"
NSQ_SOURCE_LINE 00000712 "}"
NSQ_SOURCE_LINE 00000713 ""
NSQ_SOURCE_LINE 00000714 "sub Same {"
NSQ_SOURCE_LINE 00000715 "    my( $me )= @_;"
NSQ_SOURCE_LINE 00000716 "    $me->_ChkPos();"
NSQ_SOURCE_LINE 00000717 "    return wantarray ? () : 0"
NSQ_SOURCE_LINE 00000718 "        if  $me->[_Same] != ( 1 & $me->[_Pos] );"
NSQ_SOURCE_LINE 00000719 "    return $me->Items(1);"
NSQ_SOURCE_LINE 00000720 "}"
NSQ_SOURCE_LINE 00000721 ""
NSQ_SOURCE_LINE 00000722 "my %getName;"
NSQ_SOURCE_LINE 00000723 "BEGIN {"
NSQ_SOURCE_LINE 00000724 "    %getName= ("
NSQ_SOURCE_LINE 00000725 "        same => \\&Same,"
NSQ_SOURCE_LINE 00000726 "        diff => \\&Diff,"
NSQ_SOURCE_LINE 00000727 "        base => \\&Base,"
NSQ_SOURCE_LINE 00000728 "        min  => \\&Min,"
NSQ_SOURCE_LINE 00000729 "        max  => \\&Max,"
NSQ_SOURCE_LINE 00000730 "        range=> \\&Range,"
NSQ_SOURCE_LINE 00000731 "        items=> \\&Items, # same thing"
NSQ_SOURCE_LINE 00000732 "    );"
NSQ_SOURCE_LINE 00000733 "}"
NSQ_SOURCE_LINE 00000734 ""
NSQ_SOURCE_LINE 00000735 "sub Get"
NSQ_SOURCE_LINE 00000736 "{"
NSQ_SOURCE_LINE 00000737 "    my $me= shift @_;"
NSQ_SOURCE_LINE 00000738 "    $me->_ChkPos();"
NSQ_SOURCE_LINE 00000739 "    my @value;"
NSQ_SOURCE_LINE 00000740 "    for my $arg (  @_  ) {"
NSQ_SOURCE_LINE 00000741 "        for my $word (  split ' ', $arg  ) {"
NSQ_SOURCE_LINE 00000742 "            my $meth;"
NSQ_SOURCE_LINE 00000743 "            if(     $word !~ /^(-?\\d+)?([a-zA-Z]+)([12])?$/"
NSQ_SOURCE_LINE 00000744 "                ||  not  $meth= $getName{ lc $2 }"
NSQ_SOURCE_LINE 00000745 "            ) {"
NSQ_SOURCE_LINE 00000746 "                Die( $Root, \", Get: Invalid request ($word)\" );"
NSQ_SOURCE_LINE 00000747 "            }"
NSQ_SOURCE_LINE 00000748 "            my( $base, $name, $seq )= ( $1, $2, $3 );"
NSQ_SOURCE_LINE 00000749 "            push @value, scalar("
NSQ_SOURCE_LINE 00000750 "                4 == length($name)"
NSQ_SOURCE_LINE 00000751 "                    ? $meth->( $me )"
NSQ_SOURCE_LINE 00000752 "                    : $meth->( $me, $seq, $base )"
NSQ_SOURCE_LINE 00000753 "            );"
NSQ_SOURCE_LINE 00000754 "        }"
NSQ_SOURCE_LINE 00000755 "    }"
NSQ_SOURCE_LINE 00000756 "    if(  wantarray  ) {"
NSQ_SOURCE_LINE 00000757 "        return @value;"
NSQ_SOURCE_LINE 00000758 "    } elsif(  1 == @value  ) {"
NSQ_SOURCE_LINE 00000759 "        return $value[0];"
NSQ_SOURCE_LINE 00000760 "    }"
NSQ_SOURCE_LINE 00000761 "    Die( 0+@value, \" values requested from \","
NSQ_SOURCE_LINE 00000762 "        $Root, \"'s Get in scalar context\" );"
NSQ_SOURCE_LINE 00000763 "}"
NSQ_SOURCE_LINE 00000764 ""
NSQ_SOURCE_LINE 00000765 ""
NSQ_SOURCE_LINE 00000766 "my $Obj= getObjPkg($Root);"
NSQ_SOURCE_LINE 00000767 "no strict 'refs';"
NSQ_SOURCE_LINE 00000768 ""
NSQ_SOURCE_LINE 00000769 "for my $meth (  qw( new getObjPkg )  ) {"
NSQ_SOURCE_LINE 00000770 "    *{$Root.\"::\".$meth} = \\&{$meth};"
NSQ_SOURCE_LINE 00000771 "    *{$Obj .\"::\".$meth} = \\&{$meth};"
NSQ_SOURCE_LINE 00000772 "}"
NSQ_SOURCE_LINE 00000773 "for my $meth (  qw("
NSQ_SOURCE_LINE 00000774 "    Next Prev Reset Copy Base Diff"
NSQ_SOURCE_LINE 00000775 "    Same Items Range Min Max Get"
NSQ_SOURCE_LINE 00000776 "    _ChkPos _ChkSeq"
NSQ_SOURCE_LINE 00000777 ")  ) {"
NSQ_SOURCE_LINE 00000778 "    *{$Obj.\"::\".$meth} = \\&{$meth};"
NSQ_SOURCE_LINE 00000779 "}"
NSQ_SOURCE_LINE 00000780 ""
NSQ_SOURCE_LINE 00000781 "1;"
NSQ_SOURCE_LINE 00000782 "__END__"
NSQ_SOURCE_LINE 00000783 ""
NSQ_SOURCE_LINE 00000784 "=head1 NAME"
NSQ_SOURCE_LINE 00000785 ""
NSQ_SOURCE_LINE 00000786 "Algorithm::Diff - Compute `intelligent' differences between two files / lists"
NSQ_SOURCE_LINE 00000787 ""
NSQ_SOURCE_LINE 00000788 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000789 ""
NSQ_SOURCE_LINE 00000790 "    require Algorithm::Diff;"
NSQ_SOURCE_LINE 00000791 ""
NSQ_SOURCE_LINE 00000792 "    # This example produces traditional 'diff' output:"
NSQ_SOURCE_LINE 00000793 ""
NSQ_SOURCE_LINE 00000794 "    my $diff = Algorithm::Diff->new( \\@seq1, \\@seq2 );"
NSQ_SOURCE_LINE 00000795 ""
NSQ_SOURCE_LINE 00000796 "    $diff->Base( 1 );   # Return line numbers, not indices"
NSQ_SOURCE_LINE 00000797 "    while(  $diff->Next()  ) {"
NSQ_SOURCE_LINE 00000798 "        next   if  $diff->Same();"
NSQ_SOURCE_LINE 00000799 "        my $sep = '';"
NSQ_SOURCE_LINE 00000800 "        if(  ! $diff->Items(2)  ) {"
NSQ_SOURCE_LINE 00000801 "            printf \"%d,%dd%d\\n\","
NSQ_SOURCE_LINE 00000802 "                $diff->Get(qw( Min1 Max1 Max2 ));"
NSQ_SOURCE_LINE 00000803 "        } elsif(  ! $diff->Items(1)  ) {"
NSQ_SOURCE_LINE 00000804 "            printf \"%da%d,%d\\n\","
NSQ_SOURCE_LINE 00000805 "                $diff->Get(qw( Max1 Min2 Max2 ));"
NSQ_SOURCE_LINE 00000806 "        } else {"
NSQ_SOURCE_LINE 00000807 "            $sep = \"---\\n\";"
NSQ_SOURCE_LINE 00000808 "            printf \"%d,%dc%d,%d\\n\","
NSQ_SOURCE_LINE 00000809 "                $diff->Get(qw( Min1 Max1 Min2 Max2 ));"
NSQ_SOURCE_LINE 00000810 "        }"
NSQ_SOURCE_LINE 00000811 "        print \"< $_\"   for  $diff->Items(1);"
NSQ_SOURCE_LINE 00000812 "        print $sep;"
NSQ_SOURCE_LINE 00000813 "        print \"> $_\"   for  $diff->Items(2);"
NSQ_SOURCE_LINE 00000814 "    }"
NSQ_SOURCE_LINE 00000815 ""
NSQ_SOURCE_LINE 00000816 ""
NSQ_SOURCE_LINE 00000817 "    # Alternate interfaces:"
NSQ_SOURCE_LINE 00000818 ""
NSQ_SOURCE_LINE 00000819 "    use Algorithm::Diff qw("
NSQ_SOURCE_LINE 00000820 "        LCS LCS_length LCSidx"
NSQ_SOURCE_LINE 00000821 "        diff sdiff compact_diff"
NSQ_SOURCE_LINE 00000822 "        traverse_sequences traverse_balanced );"
NSQ_SOURCE_LINE 00000823 ""
NSQ_SOURCE_LINE 00000824 "    @lcs    = LCS( \\@seq1, \\@seq2 );"
NSQ_SOURCE_LINE 00000825 "    $lcsref = LCS( \\@seq1, \\@seq2 );"
NSQ_SOURCE_LINE 00000826 "    $count  = LCS_length( \\@seq1, \\@seq2 );"
NSQ_SOURCE_LINE 00000827 ""
NSQ_SOURCE_LINE 00000828 "    ( $seq1idxref, $seq2idxref ) = LCSidx( \\@seq1, \\@seq2 );"
NSQ_SOURCE_LINE 00000829 ""
NSQ_SOURCE_LINE 00000830 ""
NSQ_SOURCE_LINE 00000831 "    # Complicated interfaces:"
NSQ_SOURCE_LINE 00000832 ""
NSQ_SOURCE_LINE 00000833 "    @diffs  = diff( \\@seq1, \\@seq2 );"
NSQ_SOURCE_LINE 00000834 ""
NSQ_SOURCE_LINE 00000835 "    @sdiffs = sdiff( \\@seq1, \\@seq2 );"
NSQ_SOURCE_LINE 00000836 ""
NSQ_SOURCE_LINE 00000837 "    @cdiffs = compact_diff( \\@seq1, \\@seq2 );"
NSQ_SOURCE_LINE 00000838 ""
NSQ_SOURCE_LINE 00000839 "    traverse_sequences("
NSQ_SOURCE_LINE 00000840 "        \\@seq1,"
NSQ_SOURCE_LINE 00000841 "        \\@seq2,"
NSQ_SOURCE_LINE 00000842 "        {   MATCH     => \\&callback1,"
NSQ_SOURCE_LINE 00000843 "            DISCARD_A => \\&callback2,"
NSQ_SOURCE_LINE 00000844 "            DISCARD_B => \\&callback3,"
NSQ_SOURCE_LINE 00000845 "        },"
NSQ_SOURCE_LINE 00000846 "        \\&key_generator,"
NSQ_SOURCE_LINE 00000847 "        @extra_args,"
NSQ_SOURCE_LINE 00000848 "    );"
NSQ_SOURCE_LINE 00000849 ""
NSQ_SOURCE_LINE 00000850 "    traverse_balanced("
NSQ_SOURCE_LINE 00000851 "        \\@seq1,"
NSQ_SOURCE_LINE 00000852 "        \\@seq2,"
NSQ_SOURCE_LINE 00000853 "        {   MATCH     => \\&callback1,"
NSQ_SOURCE_LINE 00000854 "            DISCARD_A => \\&callback2,"
NSQ_SOURCE_LINE 00000855 "            DISCARD_B => \\&callback3,"
NSQ_SOURCE_LINE 00000856 "            CHANGE    => \\&callback4,"
NSQ_SOURCE_LINE 00000857 "        },"
NSQ_SOURCE_LINE 00000858 "        \\&key_generator,"
NSQ_SOURCE_LINE 00000859 "        @extra_args,"
NSQ_SOURCE_LINE 00000860 "    );"
NSQ_SOURCE_LINE 00000861 ""
NSQ_SOURCE_LINE 00000862 ""
NSQ_SOURCE_LINE 00000863 "=head1 INTRODUCTION"
NSQ_SOURCE_LINE 00000864 ""
NSQ_SOURCE_LINE 00000865 "(by Mark-Jason Dominus)"
NSQ_SOURCE_LINE 00000866 ""
NSQ_SOURCE_LINE 00000867 "I once read an article written by the authors of C<diff>; they said"
NSQ_SOURCE_LINE 00000868 "that they worked very hard on the algorithm until they found the"
NSQ_SOURCE_LINE 00000869 "right one."
NSQ_SOURCE_LINE 00000870 ""
NSQ_SOURCE_LINE 00000871 "I think what they ended up using (and I hope someone will correct me,"
NSQ_SOURCE_LINE 00000872 "because I am not very confident about this) was the `longest common"
NSQ_SOURCE_LINE 00000873 "subsequence' method.  In the LCS problem, you have two sequences of"
NSQ_SOURCE_LINE 00000874 "items:"
NSQ_SOURCE_LINE 00000875 ""
NSQ_SOURCE_LINE 00000876 "    a b c d f g h j q z"
NSQ_SOURCE_LINE 00000877 ""
NSQ_SOURCE_LINE 00000878 "    a b c d e f g i j k r x y z"
NSQ_SOURCE_LINE 00000879 ""
NSQ_SOURCE_LINE 00000880 "and you want to find the longest sequence of items that is present in"
NSQ_SOURCE_LINE 00000881 "both original sequences in the same order.  That is, you want to find"
NSQ_SOURCE_LINE 00000882 "a new sequence I<S> which can be obtained from the first sequence by"
NSQ_SOURCE_LINE 00000883 "deleting some items, and from the second sequence by deleting other"
NSQ_SOURCE_LINE 00000884 "items.  You also want I<S> to be as long as possible.  In this case I<S>"
NSQ_SOURCE_LINE 00000885 "is"
NSQ_SOURCE_LINE 00000886 ""
NSQ_SOURCE_LINE 00000887 "    a b c d f g j z"
NSQ_SOURCE_LINE 00000888 ""
NSQ_SOURCE_LINE 00000889 "From there it's only a small step to get diff-like output:"
NSQ_SOURCE_LINE 00000890 ""
NSQ_SOURCE_LINE 00000891 "    e   h i   k   q r x y"
NSQ_SOURCE_LINE 00000892 "    +   - +   +   - + + +"
NSQ_SOURCE_LINE 00000893 ""
NSQ_SOURCE_LINE 00000894 "This module solves the LCS problem.  It also includes a canned function"
NSQ_SOURCE_LINE 00000895 "to generate C<diff>-like output."
NSQ_SOURCE_LINE 00000896 ""
NSQ_SOURCE_LINE 00000897 "It might seem from the example above that the LCS of two sequences is"
NSQ_SOURCE_LINE 00000898 "always pretty obvious, but that's not always the case, especially when"
NSQ_SOURCE_LINE 00000899 "the two sequences have many repeated elements.  For example, consider"
NSQ_SOURCE_LINE 00000900 ""
NSQ_SOURCE_LINE 00000901 "    a x b y c z p d q"
NSQ_SOURCE_LINE 00000902 "    a b c a x b y c z"
NSQ_SOURCE_LINE 00000903 ""
NSQ_SOURCE_LINE 00000904 "A naive approach might start by matching up the C<a> and C<b> that"
NSQ_SOURCE_LINE 00000905 "appear at the beginning of each sequence, like this:"
NSQ_SOURCE_LINE 00000906 ""
NSQ_SOURCE_LINE 00000907 "    a x b y c         z p d q"
NSQ_SOURCE_LINE 00000908 "    a   b   c a b y c z"
NSQ_SOURCE_LINE 00000909 ""
NSQ_SOURCE_LINE 00000910 "This finds the common subsequence C<a b c z>.  But actually, the LCS"
NSQ_SOURCE_LINE 00000911 "is C<a x b y c z>:"
NSQ_SOURCE_LINE 00000912 ""
NSQ_SOURCE_LINE 00000913 "          a x b y c z p d q"
NSQ_SOURCE_LINE 00000914 "    a b c a x b y c z"
NSQ_SOURCE_LINE 00000915 ""
NSQ_SOURCE_LINE 00000916 "or"
NSQ_SOURCE_LINE 00000917 ""
NSQ_SOURCE_LINE 00000918 "    a       x b y c z p d q"
NSQ_SOURCE_LINE 00000919 "    a b c a x b y c z"
NSQ_SOURCE_LINE 00000920 ""
NSQ_SOURCE_LINE 00000921 "=head1 USAGE"
NSQ_SOURCE_LINE 00000922 ""
NSQ_SOURCE_LINE 00000923 "(See also the README file and several example"
NSQ_SOURCE_LINE 00000924 "scripts include with this module.)"
NSQ_SOURCE_LINE 00000925 ""
NSQ_SOURCE_LINE 00000926 "This module now provides an object-oriented interface that uses less"
NSQ_SOURCE_LINE 00000927 "memory and is easier to use than most of the previous procedural"
NSQ_SOURCE_LINE 00000928 "interfaces.  It also still provides several exportable functions.  We'll"
NSQ_SOURCE_LINE 00000929 "deal with these in ascending order of difficulty:  C<LCS>,"
NSQ_SOURCE_LINE 00000930 "C<LCS_length>, C<LCSidx>, OO interface, C<prepare>, C<diff>, C<sdiff>,"
NSQ_SOURCE_LINE 00000931 "C<traverse_sequences>, and C<traverse_balanced>."
NSQ_SOURCE_LINE 00000932 ""
NSQ_SOURCE_LINE 00000933 "=head2 C<LCS>"
NSQ_SOURCE_LINE 00000934 ""
NSQ_SOURCE_LINE 00000935 "Given references to two lists of items, LCS returns an array containing"
NSQ_SOURCE_LINE 00000936 "their longest common subsequence.  In scalar context, it returns a"
NSQ_SOURCE_LINE 00000937 "reference to such a list."
NSQ_SOURCE_LINE 00000938 ""
NSQ_SOURCE_LINE 00000939 "    @lcs    = LCS( \\@seq1, \\@seq2 );"
NSQ_SOURCE_LINE 00000940 "    $lcsref = LCS( \\@seq1, \\@seq2 );"
NSQ_SOURCE_LINE 00000941 ""
NSQ_SOURCE_LINE 00000942 "C<LCS> may be passed an optional third parameter; this is a CODE"
NSQ_SOURCE_LINE 00000943 "reference to a key generation function.  See L</KEY GENERATION"
NSQ_SOURCE_LINE 00000944 "FUNCTIONS>."
NSQ_SOURCE_LINE 00000945 ""
NSQ_SOURCE_LINE 00000946 "    @lcs    = LCS( \\@seq1, \\@seq2, \\&keyGen, @args );"
NSQ_SOURCE_LINE 00000947 "    $lcsref = LCS( \\@seq1, \\@seq2, \\&keyGen, @args );"
NSQ_SOURCE_LINE 00000948 ""
NSQ_SOURCE_LINE 00000949 "Additional parameters, if any, will be passed to the key generation"
NSQ_SOURCE_LINE 00000950 "routine."
NSQ_SOURCE_LINE 00000951 ""
NSQ_SOURCE_LINE 00000952 "=head2 C<LCS_length>"
NSQ_SOURCE_LINE 00000953 ""
NSQ_SOURCE_LINE 00000954 "This is just like C<LCS> except it only returns the length of the"
NSQ_SOURCE_LINE 00000955 "longest common subsequence.  This provides a performance gain of about"
NSQ_SOURCE_LINE 00000956 "9% compared to C<LCS>."
NSQ_SOURCE_LINE 00000957 ""
NSQ_SOURCE_LINE 00000958 "=head2 C<LCSidx>"
NSQ_SOURCE_LINE 00000959 ""
NSQ_SOURCE_LINE 00000960 "Like C<LCS> except it returns references to two arrays.  The first array"
NSQ_SOURCE_LINE 00000961 "contains the indices into @seq1 where the LCS items are located.  The"
NSQ_SOURCE_LINE 00000962 "second array contains the indices into @seq2 where the LCS items are located."
NSQ_SOURCE_LINE 00000963 ""
NSQ_SOURCE_LINE 00000964 "Therefore, the following three lists will contain the same values:"
NSQ_SOURCE_LINE 00000965 ""
NSQ_SOURCE_LINE 00000966 "    my( $idx1, $idx2 ) = LCSidx( \\@seq1, \\@seq2 );"
NSQ_SOURCE_LINE 00000967 "    my @list1 = @seq1[ @$idx1 ];"
NSQ_SOURCE_LINE 00000968 "    my @list2 = @seq2[ @$idx2 ];"
NSQ_SOURCE_LINE 00000969 "    my @list3 = LCS( \\@seq1, \\@seq2 );"
NSQ_SOURCE_LINE 00000970 ""
NSQ_SOURCE_LINE 00000971 "=head2 C<new>"
NSQ_SOURCE_LINE 00000972 ""
NSQ_SOURCE_LINE 00000973 "    $diff = Algorithm::Diff->new( \\@seq1, \\@seq2 );"
NSQ_SOURCE_LINE 00000974 "    $diff = Algorithm::Diff->new( \\@seq1, \\@seq2, \\%opts );"
NSQ_SOURCE_LINE 00000975 ""
NSQ_SOURCE_LINE 00000976 "C<new> computes the smallest set of additions and deletions necessary"
NSQ_SOURCE_LINE 00000977 "to turn the first sequence into the second and compactly records them"
NSQ_SOURCE_LINE 00000978 "in the object."
NSQ_SOURCE_LINE 00000979 ""
NSQ_SOURCE_LINE 00000980 "You use the object to iterate over I<hunks>, where each hunk represents"
NSQ_SOURCE_LINE 00000981 "a contiguous section of items which should be added, deleted, replaced,"
NSQ_SOURCE_LINE 00000982 "or left unchanged."
NSQ_SOURCE_LINE 00000983 ""
NSQ_SOURCE_LINE 00000984 "The following summary of all of the methods looks a lot like Perl code"
NSQ_SOURCE_LINE 00000985 "but some of the symbols have different meanings:"
NSQ_SOURCE_LINE 00000986 ""
NSQ_SOURCE_LINE 00000987 "    [ ]     Encloses optional arguments"
NSQ_SOURCE_LINE 00000988 "    :       Is followed by the default value for an optional argument"
NSQ_SOURCE_LINE 00000989 "    |       Separates alternate return results"
NSQ_SOURCE_LINE 00000990 ""
NSQ_SOURCE_LINE 00000991 "Method summary:"
NSQ_SOURCE_LINE 00000992 ""
NSQ_SOURCE_LINE 00000993 "    $obj        = Algorithm::Diff->new( \\@seq1, \\@seq2, [ \\%opts ] );"
NSQ_SOURCE_LINE 00000994 "    $pos        = $obj->Next(  [ $count : 1 ] );"
NSQ_SOURCE_LINE 00000995 "    $revPos     = $obj->Prev(  [ $count : 1 ] );"
NSQ_SOURCE_LINE 00000996 "    $obj        = $obj->Reset( [ $pos : 0 ] );"
NSQ_SOURCE_LINE 00000997 "    $copy       = $obj->Copy(  [ $pos, [ $newBase ] ] );"
NSQ_SOURCE_LINE 00000998 "    $oldBase    = $obj->Base(  [ $newBase ] );"
NSQ_SOURCE_LINE 00000999 ""
NSQ_SOURCE_LINE 00001000 "Note that all of the following methods C<die> if used on an object that"
NSQ_SOURCE_LINE 00001001 "is \"reset\" (not currently pointing at any hunk)."
NSQ_SOURCE_LINE 00001002 ""
NSQ_SOURCE_LINE 00001003 "    $bits       = $obj->Diff(  );"
NSQ_SOURCE_LINE 00001004 "    @items|$cnt = $obj->Same(  );"
NSQ_SOURCE_LINE 00001005 "    @items|$cnt = $obj->Items( $seqNum );"
NSQ_SOURCE_LINE 00001006 "    @idxs |$cnt = $obj->Range( $seqNum, [ $base ] );"
NSQ_SOURCE_LINE 00001007 "    $minIdx     = $obj->Min(   $seqNum, [ $base ] );"
NSQ_SOURCE_LINE 00001008 "    $maxIdx     = $obj->Max(   $seqNum, [ $base ] );"
NSQ_SOURCE_LINE 00001009 "    @values     = $obj->Get(   @names );"
NSQ_SOURCE_LINE 00001010 ""
NSQ_SOURCE_LINE 00001011 "Passing in C<undef> for an optional argument is always treated the same"
NSQ_SOURCE_LINE 00001012 "as if no argument were passed in."
NSQ_SOURCE_LINE 00001013 ""
NSQ_SOURCE_LINE 00001014 "=over 4"
NSQ_SOURCE_LINE 00001015 ""
NSQ_SOURCE_LINE 00001016 "=item C<Next>"
NSQ_SOURCE_LINE 00001017 ""
NSQ_SOURCE_LINE 00001018 "    $pos = $diff->Next();    # Move forward 1 hunk"
NSQ_SOURCE_LINE 00001019 "    $pos = $diff->Next( 2 ); # Move forward 2 hunks"
NSQ_SOURCE_LINE 00001020 "    $pos = $diff->Next(-5);  # Move backward 5 hunks"
NSQ_SOURCE_LINE 00001021 ""
NSQ_SOURCE_LINE 00001022 "C<Next> moves the object to point at the next hunk.  The object starts"
NSQ_SOURCE_LINE 00001023 "out \"reset\", which means it isn't pointing at any hunk.  If the object"
NSQ_SOURCE_LINE 00001024 "is reset, then C<Next()> moves to the first hunk."
NSQ_SOURCE_LINE 00001025 ""
NSQ_SOURCE_LINE 00001026 "C<Next> returns a true value iff the move didn't go past the last hunk."
NSQ_SOURCE_LINE 00001027 "So C<Next(0)> will return true iff the object is not reset."
NSQ_SOURCE_LINE 00001028 ""
NSQ_SOURCE_LINE 00001029 "Actually, C<Next> returns the object's new position, which is a number"
NSQ_SOURCE_LINE 00001030 "between 1 and the number of hunks (inclusive), or returns a false value."
NSQ_SOURCE_LINE 00001031 ""
NSQ_SOURCE_LINE 00001032 "=item C<Prev>"
NSQ_SOURCE_LINE 00001033 ""
NSQ_SOURCE_LINE 00001034 "C<Prev($N)> is almost identical to C<Next(-$N)>; it moves to the $Nth"
NSQ_SOURCE_LINE 00001035 "previous hunk.  On a 'reset' object, C<Prev()> [and C<Next(-1)>] move"
NSQ_SOURCE_LINE 00001036 "to the last hunk."
NSQ_SOURCE_LINE 00001037 ""
NSQ_SOURCE_LINE 00001038 "The position returned by C<Prev> is relative to the I<end> of the"
NSQ_SOURCE_LINE 00001039 "hunks; -1 for the last hunk, -2 for the second-to-last, etc."
NSQ_SOURCE_LINE 00001040 ""
NSQ_SOURCE_LINE 00001041 "=item C<Reset>"
NSQ_SOURCE_LINE 00001042 ""
NSQ_SOURCE_LINE 00001043 "    $diff->Reset();     # Reset the object's position"
NSQ_SOURCE_LINE 00001044 "    $diff->Reset($pos); # Move to the specified hunk"
NSQ_SOURCE_LINE 00001045 "    $diff->Reset(1);    # Move to the first hunk"
NSQ_SOURCE_LINE 00001046 "    $diff->Reset(-1);   # Move to the last hunk"
NSQ_SOURCE_LINE 00001047 ""
NSQ_SOURCE_LINE 00001048 "C<Reset> returns the object, so, for example, you could use"
NSQ_SOURCE_LINE 00001049 "C<< $diff->Reset()->Next(-1) >> to get the number of hunks."
NSQ_SOURCE_LINE 00001050 ""
NSQ_SOURCE_LINE 00001051 "=item C<Copy>"
NSQ_SOURCE_LINE 00001052 ""
NSQ_SOURCE_LINE 00001053 "    $copy = $diff->Copy( $newPos, $newBase );"
NSQ_SOURCE_LINE 00001054 ""
NSQ_SOURCE_LINE 00001055 "C<Copy> returns a copy of the object.  The copy and the original object"
NSQ_SOURCE_LINE 00001056 "share most of their data, so making copies takes very little memory."
NSQ_SOURCE_LINE 00001057 "The copy maintains its own position (separate from the original), which"
NSQ_SOURCE_LINE 00001058 "is the main purpose of copies.  It also maintains its own base."
NSQ_SOURCE_LINE 00001059 ""
NSQ_SOURCE_LINE 00001060 "By default, the copy's position starts out the same as the original"
NSQ_SOURCE_LINE 00001061 "object's position.  But C<Copy> takes an optional first argument to set the"
NSQ_SOURCE_LINE 00001062 "new position, so the following three snippets are equivalent:"
NSQ_SOURCE_LINE 00001063 ""
NSQ_SOURCE_LINE 00001064 "    $copy = $diff->Copy($pos);"
NSQ_SOURCE_LINE 00001065 ""
NSQ_SOURCE_LINE 00001066 "    $copy = $diff->Copy();"
NSQ_SOURCE_LINE 00001067 "    $copy->Reset($pos);"
NSQ_SOURCE_LINE 00001068 ""
NSQ_SOURCE_LINE 00001069 "    $copy = $diff->Copy()->Reset($pos);"
NSQ_SOURCE_LINE 00001070 ""
NSQ_SOURCE_LINE 00001071 "C<Copy> takes an optional second argument to set the base for"
NSQ_SOURCE_LINE 00001072 "the copy.  If you wish to change the base of the copy but leave"
NSQ_SOURCE_LINE 00001073 "the position the same as in the original, here are two"
NSQ_SOURCE_LINE 00001074 "equivalent ways:"
NSQ_SOURCE_LINE 00001075 ""
NSQ_SOURCE_LINE 00001076 "    $copy = $diff->Copy();"
NSQ_SOURCE_LINE 00001077 "    $copy->Base( 0 );"
NSQ_SOURCE_LINE 00001078 ""
NSQ_SOURCE_LINE 00001079 "    $copy = $diff->Copy(undef,0);"
NSQ_SOURCE_LINE 00001080 ""
NSQ_SOURCE_LINE 00001081 "Here are two equivalent way to get a \"reset\" copy:"
NSQ_SOURCE_LINE 00001082 ""
NSQ_SOURCE_LINE 00001083 "    $copy = $diff->Copy(0);"
NSQ_SOURCE_LINE 00001084 ""
NSQ_SOURCE_LINE 00001085 "    $copy = $diff->Copy()->Reset();"
NSQ_SOURCE_LINE 00001086 ""
NSQ_SOURCE_LINE 00001087 "=item C<Diff>"
NSQ_SOURCE_LINE 00001088 ""
NSQ_SOURCE_LINE 00001089 "    $bits = $obj->Diff();"
NSQ_SOURCE_LINE 00001090 ""
NSQ_SOURCE_LINE 00001091 "C<Diff> returns a true value iff the current hunk contains items that are"
NSQ_SOURCE_LINE 00001092 "different between the two sequences.  It actually returns one of the"
NSQ_SOURCE_LINE 00001093 "follow 4 values:"
NSQ_SOURCE_LINE 00001094 ""
NSQ_SOURCE_LINE 00001095 "=over 4"
NSQ_SOURCE_LINE 00001096 ""
NSQ_SOURCE_LINE 00001097 "=item Z<>3"
NSQ_SOURCE_LINE 00001098 ""
NSQ_SOURCE_LINE 00001099 "C<3==(1|2)>.  This hunk contains items from @seq1 and the items"
NSQ_SOURCE_LINE 00001100 "from @seq2 that should replace them.  Both sequence 1 and 2"
NSQ_SOURCE_LINE 00001101 "contain changed items so both the 1 and 2 bits are set."
NSQ_SOURCE_LINE 00001102 ""
NSQ_SOURCE_LINE 00001103 "=item Z<>2"
NSQ_SOURCE_LINE 00001104 ""
NSQ_SOURCE_LINE 00001105 "This hunk only contains items from @seq2 that should be inserted (not"
NSQ_SOURCE_LINE 00001106 "items from @seq1).  Only sequence 2 contains changed items so only the 2"
NSQ_SOURCE_LINE 00001107 "bit is set."
NSQ_SOURCE_LINE 00001108 ""
NSQ_SOURCE_LINE 00001109 "=item Z<>1"
NSQ_SOURCE_LINE 00001110 ""
NSQ_SOURCE_LINE 00001111 "This hunk only contains items from @seq1 that should be deleted (not"
NSQ_SOURCE_LINE 00001112 "items from @seq2).  Only sequence 1 contains changed items so only the 1"
NSQ_SOURCE_LINE 00001113 "bit is set."
NSQ_SOURCE_LINE 00001114 ""
NSQ_SOURCE_LINE 00001115 "=item Z<>0"
NSQ_SOURCE_LINE 00001116 ""
NSQ_SOURCE_LINE 00001117 "This means that the items in this hunk are the same in both sequences."
NSQ_SOURCE_LINE 00001118 "Neither sequence 1 nor 2 contain changed items so neither the 1 nor the"
NSQ_SOURCE_LINE 00001119 "2 bits are set."
NSQ_SOURCE_LINE 00001120 ""
NSQ_SOURCE_LINE 00001121 "=back"
NSQ_SOURCE_LINE 00001122 ""
NSQ_SOURCE_LINE 00001123 "=item C<Same>"
NSQ_SOURCE_LINE 00001124 ""
NSQ_SOURCE_LINE 00001125 "C<Same> returns a true value iff the current hunk contains items that"
NSQ_SOURCE_LINE 00001126 "are the same in both sequences.  It actually returns the list of items"
NSQ_SOURCE_LINE 00001127 "if they are the same or an empty list if they aren't.  In a scalar"
NSQ_SOURCE_LINE 00001128 "context, it returns the size of the list."
NSQ_SOURCE_LINE 00001129 ""
NSQ_SOURCE_LINE 00001130 "=item C<Items>"
NSQ_SOURCE_LINE 00001131 ""
NSQ_SOURCE_LINE 00001132 "    $count = $diff->Items(2);"
NSQ_SOURCE_LINE 00001133 "    @items = $diff->Items($seqNum);"
NSQ_SOURCE_LINE 00001134 ""
NSQ_SOURCE_LINE 00001135 "C<Items> returns the (number of) items from the specified sequence that"
NSQ_SOURCE_LINE 00001136 "are part of the current hunk."
NSQ_SOURCE_LINE 00001137 ""
NSQ_SOURCE_LINE 00001138 "If the current hunk contains only insertions, then"
NSQ_SOURCE_LINE 00001139 "C<< $diff->Items(1) >> will return an empty list (0 in a scalar context)."
NSQ_SOURCE_LINE 00001140 "If the current hunk contains only deletions, then C<< $diff->Items(2) >>"
NSQ_SOURCE_LINE 00001141 "will return an empty list (0 in a scalar context)."
NSQ_SOURCE_LINE 00001142 ""
NSQ_SOURCE_LINE 00001143 "If the hunk contains replacements, then both C<< $diff->Items(1) >> and"
NSQ_SOURCE_LINE 00001144 "C<< $diff->Items(2) >> will return different, non-empty lists."
NSQ_SOURCE_LINE 00001145 ""
NSQ_SOURCE_LINE 00001146 "Otherwise, the hunk contains identical items and all of the following"
NSQ_SOURCE_LINE 00001147 "will return the same lists:"
NSQ_SOURCE_LINE 00001148 ""
NSQ_SOURCE_LINE 00001149 "    @items = $diff->Items(1);"
NSQ_SOURCE_LINE 00001150 "    @items = $diff->Items(2);"
NSQ_SOURCE_LINE 00001151 "    @items = $diff->Same();"
NSQ_SOURCE_LINE 00001152 ""
NSQ_SOURCE_LINE 00001153 "=item C<Range>"
NSQ_SOURCE_LINE 00001154 ""
NSQ_SOURCE_LINE 00001155 "    $count = $diff->Range( $seqNum );"
NSQ_SOURCE_LINE 00001156 "    @indices = $diff->Range( $seqNum );"
NSQ_SOURCE_LINE 00001157 "    @indices = $diff->Range( $seqNum, $base );"
NSQ_SOURCE_LINE 00001158 ""
NSQ_SOURCE_LINE 00001159 "C<Range> is like C<Items> except that it returns a list of I<indices> to"
NSQ_SOURCE_LINE 00001160 "the items rather than the items themselves.  By default, the index of"
NSQ_SOURCE_LINE 00001161 "the first item (in each sequence) is 0 but this can be changed by"
NSQ_SOURCE_LINE 00001162 "calling the C<Base> method.  So, by default, the following two snippets"
NSQ_SOURCE_LINE 00001163 "return the same lists:"
NSQ_SOURCE_LINE 00001164 ""
NSQ_SOURCE_LINE 00001165 "    @list = $diff->Items(2);"
NSQ_SOURCE_LINE 00001166 "    @list = @seq2[ $diff->Range(2) ];"
NSQ_SOURCE_LINE 00001167 ""
NSQ_SOURCE_LINE 00001168 "You can also specify the base to use as the second argument.  So the"
NSQ_SOURCE_LINE 00001169 "following two snippets I<always> return the same lists:"
NSQ_SOURCE_LINE 00001170 ""
NSQ_SOURCE_LINE 00001171 "    @list = $diff->Items(1);"
NSQ_SOURCE_LINE 00001172 "    @list = @seq1[ $diff->Range(1,0) ];"
NSQ_SOURCE_LINE 00001173 ""
NSQ_SOURCE_LINE 00001174 "=item C<Base>"
NSQ_SOURCE_LINE 00001175 ""
NSQ_SOURCE_LINE 00001176 "    $curBase = $diff->Base();"
NSQ_SOURCE_LINE 00001177 "    $oldBase = $diff->Base($newBase);"
NSQ_SOURCE_LINE 00001178 ""
NSQ_SOURCE_LINE 00001179 "C<Base> sets and/or returns the current base (usually 0 or 1) that is"
NSQ_SOURCE_LINE 00001180 "used when you request range information.  The base defaults to 0 so"
NSQ_SOURCE_LINE 00001181 "that range information is returned as array indices.  You can set the"
NSQ_SOURCE_LINE 00001182 "base to 1 if you want to report traditional line numbers instead."
NSQ_SOURCE_LINE 00001183 ""
NSQ_SOURCE_LINE 00001184 "=item C<Min>"
NSQ_SOURCE_LINE 00001185 ""
NSQ_SOURCE_LINE 00001186 "    $min1 = $diff->Min(1);"
NSQ_SOURCE_LINE 00001187 "    $min = $diff->Min( $seqNum, $base );"
NSQ_SOURCE_LINE 00001188 ""
NSQ_SOURCE_LINE 00001189 "C<Min> returns the first value that C<Range> would return (given the"
NSQ_SOURCE_LINE 00001190 "same arguments) or returns C<undef> if C<Range> would return an empty"
NSQ_SOURCE_LINE 00001191 "list."
NSQ_SOURCE_LINE 00001192 ""
NSQ_SOURCE_LINE 00001193 "=item C<Max>"
NSQ_SOURCE_LINE 00001194 ""
NSQ_SOURCE_LINE 00001195 "C<Max> returns the last value that C<Range> would return or C<undef>."
NSQ_SOURCE_LINE 00001196 ""
NSQ_SOURCE_LINE 00001197 "=item C<Get>"
NSQ_SOURCE_LINE 00001198 ""
NSQ_SOURCE_LINE 00001199 "    ( $n, $x, $r ) = $diff->Get(qw( min1 max1 range1 ));"
NSQ_SOURCE_LINE 00001200 "    @values = $diff->Get(qw( 0min2 1max2 range2 same base ));"
NSQ_SOURCE_LINE 00001201 ""
NSQ_SOURCE_LINE 00001202 "C<Get> returns one or more scalar values.  You pass in a list of the"
NSQ_SOURCE_LINE 00001203 "names of the values you want returned.  Each name must match one of the"
NSQ_SOURCE_LINE 00001204 "following regexes:"
NSQ_SOURCE_LINE 00001205 ""
NSQ_SOURCE_LINE 00001206 "    /^(-?\\d+)?(min|max)[12]$/i"
NSQ_SOURCE_LINE 00001207 "    /^(range[12]|same|diff|base)$/i"
NSQ_SOURCE_LINE 00001208 ""
NSQ_SOURCE_LINE 00001209 "The 1 or 2 after a name says which sequence you want the information"
NSQ_SOURCE_LINE 00001210 "for (and where allowed, it is required).  The optional number before"
NSQ_SOURCE_LINE 00001211 "\"min\" or \"max\" is the base to use.  So the following equalities hold:"
NSQ_SOURCE_LINE 00001212 ""
NSQ_SOURCE_LINE 00001213 "    $diff->Get('min1') == $diff->Min(1)"
NSQ_SOURCE_LINE 00001214 "    $diff->Get('0min2') == $diff->Min(2,0)"
NSQ_SOURCE_LINE 00001215 ""
NSQ_SOURCE_LINE 00001216 "Using C<Get> in a scalar context when you've passed in more than one"
NSQ_SOURCE_LINE 00001217 "name is a fatal error (C<die> is called)."
NSQ_SOURCE_LINE 00001218 ""
NSQ_SOURCE_LINE 00001219 "=back"
NSQ_SOURCE_LINE 00001220 ""
NSQ_SOURCE_LINE 00001221 "=head2 C<prepare>"
NSQ_SOURCE_LINE 00001222 ""
NSQ_SOURCE_LINE 00001223 "Given a reference to a list of items, C<prepare> returns a reference"
NSQ_SOURCE_LINE 00001224 "to a hash which can be used when comparing this sequence to other"
NSQ_SOURCE_LINE 00001225 "sequences with C<LCS> or C<LCS_length>."
NSQ_SOURCE_LINE 00001226 ""
NSQ_SOURCE_LINE 00001227 "    $prep = prepare( \\@seq1 );"
NSQ_SOURCE_LINE 00001228 "    for $i ( 0 .. 10_000 )"
NSQ_SOURCE_LINE 00001229 "    {"
NSQ_SOURCE_LINE 00001230 "        @lcs = LCS( $prep, $seq[$i] );"
NSQ_SOURCE_LINE 00001231 "        # do something useful with @lcs"
NSQ_SOURCE_LINE 00001232 "    }"
NSQ_SOURCE_LINE 00001233 ""
NSQ_SOURCE_LINE 00001234 "C<prepare> may be passed an optional third parameter; this is a CODE"
NSQ_SOURCE_LINE 00001235 "reference to a key generation function.  See L</KEY GENERATION"
NSQ_SOURCE_LINE 00001236 "FUNCTIONS>."
NSQ_SOURCE_LINE 00001237 ""
NSQ_SOURCE_LINE 00001238 "    $prep = prepare( \\@seq1, \\&keyGen );"
NSQ_SOURCE_LINE 00001239 "    for $i ( 0 .. 10_000 )"
NSQ_SOURCE_LINE 00001240 "    {"
NSQ_SOURCE_LINE 00001241 "        @lcs = LCS( $seq[$i], $prep, \\&keyGen );"
NSQ_SOURCE_LINE 00001242 "        # do something useful with @lcs"
NSQ_SOURCE_LINE 00001243 "    }"
NSQ_SOURCE_LINE 00001244 ""
NSQ_SOURCE_LINE 00001245 "Using C<prepare> provides a performance gain of about 50% when calling LCS"
NSQ_SOURCE_LINE 00001246 "many times compared with not preparing."
NSQ_SOURCE_LINE 00001247 ""
NSQ_SOURCE_LINE 00001248 "=head2 C<diff>"
NSQ_SOURCE_LINE 00001249 ""
NSQ_SOURCE_LINE 00001250 "    @diffs     = diff( \\@seq1, \\@seq2 );"
NSQ_SOURCE_LINE 00001251 "    $diffs_ref = diff( \\@seq1, \\@seq2 );"
NSQ_SOURCE_LINE 00001252 ""
NSQ_SOURCE_LINE 00001253 "C<diff> computes the smallest set of additions and deletions necessary"
NSQ_SOURCE_LINE 00001254 "to turn the first sequence into the second, and returns a description"
NSQ_SOURCE_LINE 00001255 "of these changes.  The description is a list of I<hunks>; each hunk"
NSQ_SOURCE_LINE 00001256 "represents a contiguous section of items which should be added,"
NSQ_SOURCE_LINE 00001257 "deleted, or replaced.  (Hunks containing unchanged items are not"
NSQ_SOURCE_LINE 00001258 "included.)"
NSQ_SOURCE_LINE 00001259 ""
NSQ_SOURCE_LINE 00001260 "The return value of C<diff> is a list of hunks, or, in scalar context, a"
NSQ_SOURCE_LINE 00001261 "reference to such a list.  If there are no differences, the list will be"
NSQ_SOURCE_LINE 00001262 "empty."
NSQ_SOURCE_LINE 00001263 ""
NSQ_SOURCE_LINE 00001264 "Here is an example.  Calling C<diff> for the following two sequences:"
NSQ_SOURCE_LINE 00001265 ""
NSQ_SOURCE_LINE 00001266 "    a b c e h j l m n p"
NSQ_SOURCE_LINE 00001267 "    b c d e f j k l m r s t"
NSQ_SOURCE_LINE 00001268 ""
NSQ_SOURCE_LINE 00001269 "would produce the following list:"
NSQ_SOURCE_LINE 00001270 ""
NSQ_SOURCE_LINE 00001271 "    ("
NSQ_SOURCE_LINE 00001272 "      [ [ '-', 0, 'a' ] ],"
NSQ_SOURCE_LINE 00001273 ""
NSQ_SOURCE_LINE 00001274 "      [ [ '+', 2, 'd' ] ],"
NSQ_SOURCE_LINE 00001275 ""
NSQ_SOURCE_LINE 00001276 "      [ [ '-', 4, 'h' ],"
NSQ_SOURCE_LINE 00001277 "        [ '+', 4, 'f' ] ],"
NSQ_SOURCE_LINE 00001278 ""
NSQ_SOURCE_LINE 00001279 "      [ [ '+', 6, 'k' ] ],"
NSQ_SOURCE_LINE 00001280 ""
NSQ_SOURCE_LINE 00001281 "      [ [ '-',  8, 'n' ],"
NSQ_SOURCE_LINE 00001282 "        [ '-',  9, 'p' ],"
NSQ_SOURCE_LINE 00001283 "        [ '+',  9, 'r' ],"
NSQ_SOURCE_LINE 00001284 "        [ '+', 10, 's' ],"
NSQ_SOURCE_LINE 00001285 "        [ '+', 11, 't' ] ],"
NSQ_SOURCE_LINE 00001286 "    )"
NSQ_SOURCE_LINE 00001287 ""
NSQ_SOURCE_LINE 00001288 "There are five hunks here.  The first hunk says that the C<a> at"
NSQ_SOURCE_LINE 00001289 "position 0 of the first sequence should be deleted (C<->).  The second"
NSQ_SOURCE_LINE 00001290 "hunk says that the C<d> at position 2 of the second sequence should"
NSQ_SOURCE_LINE 00001291 "be inserted (C<+>).  The third hunk says that the C<h> at position 4"
NSQ_SOURCE_LINE 00001292 "of the first sequence should be removed and replaced with the C<f>"
NSQ_SOURCE_LINE 00001293 "from position 4 of the second sequence.  And so on."
NSQ_SOURCE_LINE 00001294 ""
NSQ_SOURCE_LINE 00001295 "C<diff> may be passed an optional third parameter; this is a CODE"
NSQ_SOURCE_LINE 00001296 "reference to a key generation function.  See L</KEY GENERATION"
NSQ_SOURCE_LINE 00001297 "FUNCTIONS>."
NSQ_SOURCE_LINE 00001298 ""
NSQ_SOURCE_LINE 00001299 "Additional parameters, if any, will be passed to the key generation"
NSQ_SOURCE_LINE 00001300 "routine."
NSQ_SOURCE_LINE 00001301 ""
NSQ_SOURCE_LINE 00001302 "=head2 C<sdiff>"
NSQ_SOURCE_LINE 00001303 ""
NSQ_SOURCE_LINE 00001304 "    @sdiffs     = sdiff( \\@seq1, \\@seq2 );"
NSQ_SOURCE_LINE 00001305 "    $sdiffs_ref = sdiff( \\@seq1, \\@seq2 );"
NSQ_SOURCE_LINE 00001306 ""
NSQ_SOURCE_LINE 00001307 "C<sdiff> computes all necessary components to show two sequences"
NSQ_SOURCE_LINE 00001308 "and their minimized differences side by side, just like the"
NSQ_SOURCE_LINE 00001309 "Unix-utility I<sdiff> does:"
NSQ_SOURCE_LINE 00001310 ""
NSQ_SOURCE_LINE 00001311 "    same             same"
NSQ_SOURCE_LINE 00001312 "    before     |     after"
NSQ_SOURCE_LINE 00001313 "    old        <     -"
NSQ_SOURCE_LINE 00001314 "    -          >     new"
NSQ_SOURCE_LINE 00001315 ""
NSQ_SOURCE_LINE 00001316 "It returns a list of array refs, each pointing to an array of"
NSQ_SOURCE_LINE 00001317 "display instructions. In scalar context it returns a reference"
NSQ_SOURCE_LINE 00001318 "to such a list. If there are no differences, the list will have one"
NSQ_SOURCE_LINE 00001319 "entry per item, each indicating that the item was unchanged."
NSQ_SOURCE_LINE 00001320 ""
NSQ_SOURCE_LINE 00001321 "Display instructions consist of three elements: A modifier indicator"
NSQ_SOURCE_LINE 00001322 "(C<+>: Element added, C<->: Element removed, C<u>: Element unmodified,"
NSQ_SOURCE_LINE 00001323 "C<c>: Element changed) and the value of the old and new elements, to"
NSQ_SOURCE_LINE 00001324 "be displayed side-by-side."
NSQ_SOURCE_LINE 00001325 ""
NSQ_SOURCE_LINE 00001326 "An C<sdiff> of the following two sequences:"
NSQ_SOURCE_LINE 00001327 ""
NSQ_SOURCE_LINE 00001328 "    a b c e h j l m n p"
NSQ_SOURCE_LINE 00001329 "    b c d e f j k l m r s t"
NSQ_SOURCE_LINE 00001330 ""
NSQ_SOURCE_LINE 00001331 "results in"
NSQ_SOURCE_LINE 00001332 ""
NSQ_SOURCE_LINE 00001333 "    ( [ '-', 'a', ''  ],"
NSQ_SOURCE_LINE 00001334 "      [ 'u', 'b', 'b' ],"
NSQ_SOURCE_LINE 00001335 "      [ 'u', 'c', 'c' ],"
NSQ_SOURCE_LINE 00001336 "      [ '+', '',  'd' ],"
NSQ_SOURCE_LINE 00001337 "      [ 'u', 'e', 'e' ],"
NSQ_SOURCE_LINE 00001338 "      [ 'c', 'h', 'f' ],"
NSQ_SOURCE_LINE 00001339 "      [ 'u', 'j', 'j' ],"
NSQ_SOURCE_LINE 00001340 "      [ '+', '',  'k' ],"
NSQ_SOURCE_LINE 00001341 "      [ 'u', 'l', 'l' ],"
NSQ_SOURCE_LINE 00001342 "      [ 'u', 'm', 'm' ],"
NSQ_SOURCE_LINE 00001343 "      [ 'c', 'n', 'r' ],"
NSQ_SOURCE_LINE 00001344 "      [ 'c', 'p', 's' ],"
NSQ_SOURCE_LINE 00001345 "      [ '+', '',  't' ],"
NSQ_SOURCE_LINE 00001346 "    )"
NSQ_SOURCE_LINE 00001347 ""
NSQ_SOURCE_LINE 00001348 "C<sdiff> may be passed an optional third parameter; this is a CODE"
NSQ_SOURCE_LINE 00001349 "reference to a key generation function.  See L</KEY GENERATION"
NSQ_SOURCE_LINE 00001350 "FUNCTIONS>."
NSQ_SOURCE_LINE 00001351 ""
NSQ_SOURCE_LINE 00001352 "Additional parameters, if any, will be passed to the key generation"
NSQ_SOURCE_LINE 00001353 "routine."
NSQ_SOURCE_LINE 00001354 ""
NSQ_SOURCE_LINE 00001355 "=head2 C<compact_diff>"
NSQ_SOURCE_LINE 00001356 ""
NSQ_SOURCE_LINE 00001357 "C<compact_diff> is much like C<sdiff> except it returns a much more"
NSQ_SOURCE_LINE 00001358 "compact description consisting of just one flat list of indices.  An"
NSQ_SOURCE_LINE 00001359 "example helps explain the format:"
NSQ_SOURCE_LINE 00001360 ""
NSQ_SOURCE_LINE 00001361 "    my @a = qw( a b c   e  h j   l m n p      );"
NSQ_SOURCE_LINE 00001362 "    my @b = qw(   b c d e f  j k l m    r s t );"
NSQ_SOURCE_LINE 00001363 "    @cdiff = compact_diff( \\@a, \\@b );"
NSQ_SOURCE_LINE 00001364 "    # Returns:"
NSQ_SOURCE_LINE 00001365 "    #   @a      @b       @a       @b"
NSQ_SOURCE_LINE 00001366 "    #  start   start   values   values"
NSQ_SOURCE_LINE 00001367 "    (    0,      0,   #       ="
NSQ_SOURCE_LINE 00001368 "         0,      0,   #    a  !"
NSQ_SOURCE_LINE 00001369 "         1,      0,   #  b c  =  b c"
NSQ_SOURCE_LINE 00001370 "         3,      2,   #       !  d"
NSQ_SOURCE_LINE 00001371 "         3,      3,   #    e  =  e"
NSQ_SOURCE_LINE 00001372 "         4,      4,   #    f  !  h"
NSQ_SOURCE_LINE 00001373 "         5,      5,   #    j  =  j"
NSQ_SOURCE_LINE 00001374 "         6,      6,   #       !  k"
NSQ_SOURCE_LINE 00001375 "         6,      7,   #  l m  =  l m"
NSQ_SOURCE_LINE 00001376 "         8,      9,   #  n p  !  r s t"
NSQ_SOURCE_LINE 00001377 "        10,     12,   #"
NSQ_SOURCE_LINE 00001378 "    );"
NSQ_SOURCE_LINE 00001379 ""
NSQ_SOURCE_LINE 00001380 "The 0th, 2nd, 4th, etc. entries are all indices into @seq1 (@a in the"
NSQ_SOURCE_LINE 00001381 "above example) indicating where a hunk begins.  The 1st, 3rd, 5th, etc."
NSQ_SOURCE_LINE 00001382 "entries are all indices into @seq2 (@b in the above example) indicating"
NSQ_SOURCE_LINE 00001383 "where the same hunk begins."
NSQ_SOURCE_LINE 00001384 ""
NSQ_SOURCE_LINE 00001385 "So each pair of indices (except the last pair) describes where a hunk"
NSQ_SOURCE_LINE 00001386 "begins (in each sequence).  Since each hunk must end at the item just"
NSQ_SOURCE_LINE 00001387 "before the item that starts the next hunk, the next pair of indices can"
NSQ_SOURCE_LINE 00001388 "be used to determine where the hunk ends."
NSQ_SOURCE_LINE 00001389 ""
NSQ_SOURCE_LINE 00001390 "So, the first 4 entries (0..3) describe the first hunk.  Entries 0 and 1"
NSQ_SOURCE_LINE 00001391 "describe where the first hunk begins (and so are always both 0)."
NSQ_SOURCE_LINE 00001392 "Entries 2 and 3 describe where the next hunk begins, so subtracting 1"
NSQ_SOURCE_LINE 00001393 "from each tells us where the first hunk ends.  That is, the first hunk"
NSQ_SOURCE_LINE 00001394 "contains items C<$diff[0]> through C<$diff[2] - 1> of the first sequence"
NSQ_SOURCE_LINE 00001395 "and contains items C<$diff[1]> through C<$diff[3] - 1> of the second"
NSQ_SOURCE_LINE 00001396 "sequence."
NSQ_SOURCE_LINE 00001397 ""
NSQ_SOURCE_LINE 00001398 "In other words, the first hunk consists of the following two lists of items:"
NSQ_SOURCE_LINE 00001399 ""
NSQ_SOURCE_LINE 00001400 "               #  1st pair     2nd pair"
NSQ_SOURCE_LINE 00001401 "               # of indices   of indices"
NSQ_SOURCE_LINE 00001402 "    @list1 = @a[ $cdiff[0] .. $cdiff[2]-1 ];"
NSQ_SOURCE_LINE 00001403 "    @list2 = @b[ $cdiff[1] .. $cdiff[3]-1 ];"
NSQ_SOURCE_LINE 00001404 "               # Hunk start   Hunk end"
NSQ_SOURCE_LINE 00001405 ""
NSQ_SOURCE_LINE 00001406 "Note that the hunks will always alternate between those that are part of"
NSQ_SOURCE_LINE 00001407 "the LCS (those that contain unchanged items) and those that contain"
NSQ_SOURCE_LINE 00001408 "changes.  This means that all we need to be told is whether the first"
NSQ_SOURCE_LINE 00001409 "hunk is a 'same' or 'diff' hunk and we can determine which of the other"
NSQ_SOURCE_LINE 00001410 "hunks contain 'same' items or 'diff' items."
NSQ_SOURCE_LINE 00001411 ""
NSQ_SOURCE_LINE 00001412 "By convention, we always make the first hunk contain unchanged items."
NSQ_SOURCE_LINE 00001413 "So the 1st, 3rd, 5th, etc. hunks (all odd-numbered hunks if you start"
NSQ_SOURCE_LINE 00001414 "counting from 1) all contain unchanged items.  And the 2nd, 4th, 6th,"
NSQ_SOURCE_LINE 00001415 "etc. hunks (all even-numbered hunks if you start counting from 1) all"
NSQ_SOURCE_LINE 00001416 "contain changed items."
NSQ_SOURCE_LINE 00001417 ""
NSQ_SOURCE_LINE 00001418 "Since @a and @b don't begin with the same value, the first hunk in our"
NSQ_SOURCE_LINE 00001419 "example is empty (otherwise we'd violate the above convention).  Note"
NSQ_SOURCE_LINE 00001420 "that the first 4 index values in our example are all zero.  Plug these"
NSQ_SOURCE_LINE 00001421 "values into our previous code block and we get:"
NSQ_SOURCE_LINE 00001422 ""
NSQ_SOURCE_LINE 00001423 "    @hunk1a = @a[ 0 .. 0-1 ];"
NSQ_SOURCE_LINE 00001424 "    @hunk1b = @b[ 0 .. 0-1 ];"
NSQ_SOURCE_LINE 00001425 ""
NSQ_SOURCE_LINE 00001426 "And C<0..-1> returns the empty list."
NSQ_SOURCE_LINE 00001427 ""
NSQ_SOURCE_LINE 00001428 "Move down one pair of indices (2..5) and we get the offset ranges for"
NSQ_SOURCE_LINE 00001429 "the second hunk, which contains changed items."
NSQ_SOURCE_LINE 00001430 ""
NSQ_SOURCE_LINE 00001431 "Since C<@diff[2..5]> contains (0,0,1,0) in our example, the second hunk"
NSQ_SOURCE_LINE 00001432 "consists of these two lists of items:"
NSQ_SOURCE_LINE 00001433 ""
NSQ_SOURCE_LINE 00001434 "        @hunk2a = @a[ $cdiff[2] .. $cdiff[4]-1 ];"
NSQ_SOURCE_LINE 00001435 "        @hunk2b = @b[ $cdiff[3] .. $cdiff[5]-1 ];"
NSQ_SOURCE_LINE 00001436 "    # or"
NSQ_SOURCE_LINE 00001437 "        @hunk2a = @a[ 0 .. 1-1 ];"
NSQ_SOURCE_LINE 00001438 "        @hunk2b = @b[ 0 .. 0-1 ];"
NSQ_SOURCE_LINE 00001439 "    # or"
NSQ_SOURCE_LINE 00001440 "        @hunk2a = @a[ 0 .. 0 ];"
NSQ_SOURCE_LINE 00001441 "        @hunk2b = @b[ 0 .. -1 ];"
NSQ_SOURCE_LINE 00001442 "    # or"
NSQ_SOURCE_LINE 00001443 "        @hunk2a = ( 'a' );"
NSQ_SOURCE_LINE 00001444 "        @hunk2b = ( );"
NSQ_SOURCE_LINE 00001445 ""
NSQ_SOURCE_LINE 00001446 "That is, we would delete item 0 ('a') from @a."
NSQ_SOURCE_LINE 00001447 ""
NSQ_SOURCE_LINE 00001448 "Since C<@diff[4..7]> contains (1,0,3,2) in our example, the third hunk"
NSQ_SOURCE_LINE 00001449 "consists of these two lists of items:"
NSQ_SOURCE_LINE 00001450 ""
NSQ_SOURCE_LINE 00001451 "        @hunk3a = @a[ $cdiff[4] .. $cdiff[6]-1 ];"
NSQ_SOURCE_LINE 00001452 "        @hunk3a = @b[ $cdiff[5] .. $cdiff[7]-1 ];"
NSQ_SOURCE_LINE 00001453 "    # or"
NSQ_SOURCE_LINE 00001454 "        @hunk3a = @a[ 1 .. 3-1 ];"
NSQ_SOURCE_LINE 00001455 "        @hunk3a = @b[ 0 .. 2-1 ];"
NSQ_SOURCE_LINE 00001456 "    # or"
NSQ_SOURCE_LINE 00001457 "        @hunk3a = @a[ 1 .. 2 ];"
NSQ_SOURCE_LINE 00001458 "        @hunk3a = @b[ 0 .. 1 ];"
NSQ_SOURCE_LINE 00001459 "    # or"
NSQ_SOURCE_LINE 00001460 "        @hunk3a = qw( b c );"
NSQ_SOURCE_LINE 00001461 "        @hunk3a = qw( b c );"
NSQ_SOURCE_LINE 00001462 ""
NSQ_SOURCE_LINE 00001463 "Note that this third hunk contains unchanged items as our convention demands."
NSQ_SOURCE_LINE 00001464 ""
NSQ_SOURCE_LINE 00001465 "You can continue this process until you reach the last two indices,"
NSQ_SOURCE_LINE 00001466 "which will always be the number of items in each sequence.  This is"
NSQ_SOURCE_LINE 00001467 "required so that subtracting one from each will give you the indices to"
NSQ_SOURCE_LINE 00001468 "the last items in each sequence."
NSQ_SOURCE_LINE 00001469 ""
NSQ_SOURCE_LINE 00001470 "=head2 C<traverse_sequences>"
NSQ_SOURCE_LINE 00001471 ""
NSQ_SOURCE_LINE 00001472 "C<traverse_sequences> used to be the most general facility provided by"
NSQ_SOURCE_LINE 00001473 "this module (the new OO interface is more powerful and much easier to"
NSQ_SOURCE_LINE 00001474 "use)."
NSQ_SOURCE_LINE 00001475 ""
NSQ_SOURCE_LINE 00001476 "Imagine that there are two arrows.  Arrow A points to an element of"
NSQ_SOURCE_LINE 00001477 "sequence A, and arrow B points to an element of the sequence B."
NSQ_SOURCE_LINE 00001478 "Initially, the arrows point to the first elements of the respective"
NSQ_SOURCE_LINE 00001479 "sequences.  C<traverse_sequences> will advance the arrows through the"
NSQ_SOURCE_LINE 00001480 "sequences one element at a time, calling an appropriate user-specified"
NSQ_SOURCE_LINE 00001481 "callback function before each advance.  It will advance the arrows in"
NSQ_SOURCE_LINE 00001482 "such a way that if there are equal elements C<$A[$i]> and C<$B[$j]>"
NSQ_SOURCE_LINE 00001483 "which are equal and which are part of the LCS, there will be some moment"
NSQ_SOURCE_LINE 00001484 "during the execution of C<traverse_sequences> when arrow A is pointing"
NSQ_SOURCE_LINE 00001485 "to C<$A[$i]> and arrow B is pointing to C<$B[$j]>.  When this happens,"
NSQ_SOURCE_LINE 00001486 "C<traverse_sequences> will call the C<MATCH> callback function and then"
NSQ_SOURCE_LINE 00001487 "it will advance both arrows."
NSQ_SOURCE_LINE 00001488 ""
NSQ_SOURCE_LINE 00001489 "Otherwise, one of the arrows is pointing to an element of its sequence"
NSQ_SOURCE_LINE 00001490 "that is not part of the LCS.  C<traverse_sequences> will advance that"
NSQ_SOURCE_LINE 00001491 "arrow and will call the C<DISCARD_A> or the C<DISCARD_B> callback,"
NSQ_SOURCE_LINE 00001492 "depending on which arrow it advanced.  If both arrows point to elements"
NSQ_SOURCE_LINE 00001493 "that are not part of the LCS, then C<traverse_sequences> will advance"
NSQ_SOURCE_LINE 00001494 "one of them and call the appropriate callback, but it is not specified"
NSQ_SOURCE_LINE 00001495 "which it will call."
NSQ_SOURCE_LINE 00001496 ""
NSQ_SOURCE_LINE 00001497 "The arguments to C<traverse_sequences> are the two sequences to"
NSQ_SOURCE_LINE 00001498 "traverse, and a hash which specifies the callback functions, like this:"
NSQ_SOURCE_LINE 00001499 ""
NSQ_SOURCE_LINE 00001500 "    traverse_sequences("
NSQ_SOURCE_LINE 00001501 "        \\@seq1, \\@seq2,"
NSQ_SOURCE_LINE 00001502 "        {   MATCH => $callback_1,"
NSQ_SOURCE_LINE 00001503 "            DISCARD_A => $callback_2,"
NSQ_SOURCE_LINE 00001504 "            DISCARD_B => $callback_3,"
NSQ_SOURCE_LINE 00001505 "        }"
NSQ_SOURCE_LINE 00001506 "    );"
NSQ_SOURCE_LINE 00001507 ""
NSQ_SOURCE_LINE 00001508 "Callbacks for MATCH, DISCARD_A, and DISCARD_B are invoked with at least"
NSQ_SOURCE_LINE 00001509 "the indices of the two arrows as their arguments.  They are not expected"
NSQ_SOURCE_LINE 00001510 "to return any values.  If a callback is omitted from the table, it is"
NSQ_SOURCE_LINE 00001511 "not called."
NSQ_SOURCE_LINE 00001512 ""
NSQ_SOURCE_LINE 00001513 "Callbacks for A_FINISHED and B_FINISHED are invoked with at least the"
NSQ_SOURCE_LINE 00001514 "corresponding index in A or B."
NSQ_SOURCE_LINE 00001515 ""
NSQ_SOURCE_LINE 00001516 "If arrow A reaches the end of its sequence, before arrow B does,"
NSQ_SOURCE_LINE 00001517 "C<traverse_sequences> will call the C<A_FINISHED> callback when it"
NSQ_SOURCE_LINE 00001518 "advances arrow B, if there is such a function; if not it will call"
NSQ_SOURCE_LINE 00001519 "C<DISCARD_B> instead.  Similarly if arrow B finishes first."
NSQ_SOURCE_LINE 00001520 "C<traverse_sequences> returns when both arrows are at the ends of their"
NSQ_SOURCE_LINE 00001521 "respective sequences.  It returns true on success and false on failure."
NSQ_SOURCE_LINE 00001522 "At present there is no way to fail."
NSQ_SOURCE_LINE 00001523 ""
NSQ_SOURCE_LINE 00001524 "C<traverse_sequences> may be passed an optional fourth parameter; this"
NSQ_SOURCE_LINE 00001525 "is a CODE reference to a key generation function.  See L</KEY GENERATION"
NSQ_SOURCE_LINE 00001526 "FUNCTIONS>."
NSQ_SOURCE_LINE 00001527 ""
NSQ_SOURCE_LINE 00001528 "Additional parameters, if any, will be passed to the key generation function."
NSQ_SOURCE_LINE 00001529 ""
NSQ_SOURCE_LINE 00001530 "If you want to pass additional parameters to your callbacks, but don't"
NSQ_SOURCE_LINE 00001531 "need a custom key generation function, you can get the default by"
NSQ_SOURCE_LINE 00001532 "passing undef:"
NSQ_SOURCE_LINE 00001533 ""
NSQ_SOURCE_LINE 00001534 "    traverse_sequences("
NSQ_SOURCE_LINE 00001535 "        \\@seq1, \\@seq2,"
NSQ_SOURCE_LINE 00001536 "        {   MATCH => $callback_1,"
NSQ_SOURCE_LINE 00001537 "            DISCARD_A => $callback_2,"
NSQ_SOURCE_LINE 00001538 "            DISCARD_B => $callback_3,"
NSQ_SOURCE_LINE 00001539 "        },"
NSQ_SOURCE_LINE 00001540 "        undef,     # default key-gen"
NSQ_SOURCE_LINE 00001541 "        $myArgument1,"
NSQ_SOURCE_LINE 00001542 "        $myArgument2,"
NSQ_SOURCE_LINE 00001543 "        $myArgument3,"
NSQ_SOURCE_LINE 00001544 "    );"
NSQ_SOURCE_LINE 00001545 ""
NSQ_SOURCE_LINE 00001546 "C<traverse_sequences> does not have a useful return value; you are"
NSQ_SOURCE_LINE 00001547 "expected to plug in the appropriate behavior with the callback"
NSQ_SOURCE_LINE 00001548 "functions."
NSQ_SOURCE_LINE 00001549 ""
NSQ_SOURCE_LINE 00001550 "=head2 C<traverse_balanced>"
NSQ_SOURCE_LINE 00001551 ""
NSQ_SOURCE_LINE 00001552 "C<traverse_balanced> is an alternative to C<traverse_sequences>. It"
NSQ_SOURCE_LINE 00001553 "uses a different algorithm to iterate through the entries in the"
NSQ_SOURCE_LINE 00001554 "computed LCS. Instead of sticking to one side and showing element changes"
NSQ_SOURCE_LINE 00001555 "as insertions and deletions only, it will jump back and forth between"
NSQ_SOURCE_LINE 00001556 "the two sequences and report I<changes> occurring as deletions on one"
NSQ_SOURCE_LINE 00001557 "side followed immediately by an insertion on the other side."
NSQ_SOURCE_LINE 00001558 ""
NSQ_SOURCE_LINE 00001559 "In addition to the C<DISCARD_A>, C<DISCARD_B>, and C<MATCH> callbacks"
NSQ_SOURCE_LINE 00001560 "supported by C<traverse_sequences>, C<traverse_balanced> supports"
NSQ_SOURCE_LINE 00001561 "a C<CHANGE> callback indicating that one element got C<replaced> by another:"
NSQ_SOURCE_LINE 00001562 ""
NSQ_SOURCE_LINE 00001563 "    traverse_balanced("
NSQ_SOURCE_LINE 00001564 "        \\@seq1, \\@seq2,"
NSQ_SOURCE_LINE 00001565 "        {   MATCH => $callback_1,"
NSQ_SOURCE_LINE 00001566 "            DISCARD_A => $callback_2,"
NSQ_SOURCE_LINE 00001567 "            DISCARD_B => $callback_3,"
NSQ_SOURCE_LINE 00001568 "            CHANGE    => $callback_4,"
NSQ_SOURCE_LINE 00001569 "        }"
NSQ_SOURCE_LINE 00001570 "    );"
NSQ_SOURCE_LINE 00001571 ""
NSQ_SOURCE_LINE 00001572 "If no C<CHANGE> callback is specified, C<traverse_balanced>"
NSQ_SOURCE_LINE 00001573 "will map C<CHANGE> events to C<DISCARD_A> and C<DISCARD_B> actions,"
NSQ_SOURCE_LINE 00001574 "therefore resulting in a similar behaviour as C<traverse_sequences>"
NSQ_SOURCE_LINE 00001575 "with different order of events."
NSQ_SOURCE_LINE 00001576 ""
NSQ_SOURCE_LINE 00001577 "C<traverse_balanced> might be a bit slower than C<traverse_sequences>,"
NSQ_SOURCE_LINE 00001578 "noticeable only while processing huge amounts of data."
NSQ_SOURCE_LINE 00001579 ""
NSQ_SOURCE_LINE 00001580 "The C<sdiff> function of this module is implemented as call to"
NSQ_SOURCE_LINE 00001581 "C<traverse_balanced>."
NSQ_SOURCE_LINE 00001582 ""
NSQ_SOURCE_LINE 00001583 "C<traverse_balanced> does not have a useful return value; you are expected to"
NSQ_SOURCE_LINE 00001584 "plug in the appropriate behavior with the callback functions."
NSQ_SOURCE_LINE 00001585 ""
NSQ_SOURCE_LINE 00001586 "=head1 KEY GENERATION FUNCTIONS"
NSQ_SOURCE_LINE 00001587 ""
NSQ_SOURCE_LINE 00001588 "Most of the functions accept an optional extra parameter.  This is a"
NSQ_SOURCE_LINE 00001589 "CODE reference to a key generating (hashing) function that should return"
NSQ_SOURCE_LINE 00001590 "a string that uniquely identifies a given element.  It should be the"
NSQ_SOURCE_LINE 00001591 "case that if two elements are to be considered equal, their keys should"
NSQ_SOURCE_LINE 00001592 "be the same (and the other way around).  If no key generation function"
NSQ_SOURCE_LINE 00001593 "is provided, the key will be the element as a string."
NSQ_SOURCE_LINE 00001594 ""
NSQ_SOURCE_LINE 00001595 "By default, comparisons will use \"eq\" and elements will be turned into keys"
NSQ_SOURCE_LINE 00001596 "using the default stringizing operator '\"\"'."
NSQ_SOURCE_LINE 00001597 ""
NSQ_SOURCE_LINE 00001598 "Where this is important is when you're comparing something other than"
NSQ_SOURCE_LINE 00001599 "strings.  If it is the case that you have multiple different objects"
NSQ_SOURCE_LINE 00001600 "that should be considered to be equal, you should supply a key"
NSQ_SOURCE_LINE 00001601 "generation function. Otherwise, you have to make sure that your arrays"
NSQ_SOURCE_LINE 00001602 "contain unique references."
NSQ_SOURCE_LINE 00001603 ""
NSQ_SOURCE_LINE 00001604 "For instance, consider this example:"
NSQ_SOURCE_LINE 00001605 ""
NSQ_SOURCE_LINE 00001606 "    package Person;"
NSQ_SOURCE_LINE 00001607 ""
NSQ_SOURCE_LINE 00001608 "    sub new"
NSQ_SOURCE_LINE 00001609 "    {"
NSQ_SOURCE_LINE 00001610 "        my $package = shift;"
NSQ_SOURCE_LINE 00001611 "        return bless { name => '', ssn => '', @_ }, $package;"
NSQ_SOURCE_LINE 00001612 "    }"
NSQ_SOURCE_LINE 00001613 ""
NSQ_SOURCE_LINE 00001614 "    sub clone"
NSQ_SOURCE_LINE 00001615 "    {"
NSQ_SOURCE_LINE 00001616 "        my $old = shift;"
NSQ_SOURCE_LINE 00001617 "        my $new = bless { %$old }, ref($old);"
NSQ_SOURCE_LINE 00001618 "    }"
NSQ_SOURCE_LINE 00001619 ""
NSQ_SOURCE_LINE 00001620 "    sub hash"
NSQ_SOURCE_LINE 00001621 "    {"
NSQ_SOURCE_LINE 00001622 "        return shift()->{'ssn'};"
NSQ_SOURCE_LINE 00001623 "    }"
NSQ_SOURCE_LINE 00001624 ""
NSQ_SOURCE_LINE 00001625 "    my $person1 = Person->new( name => 'Joe', ssn => '123-45-6789' );"
NSQ_SOURCE_LINE 00001626 "    my $person2 = Person->new( name => 'Mary', ssn => '123-47-0000' );"
NSQ_SOURCE_LINE 00001627 "    my $person3 = Person->new( name => 'Pete', ssn => '999-45-2222' );"
NSQ_SOURCE_LINE 00001628 "    my $person4 = Person->new( name => 'Peggy', ssn => '123-45-9999' );"
NSQ_SOURCE_LINE 00001629 "    my $person5 = Person->new( name => 'Frank', ssn => '000-45-9999' );"
NSQ_SOURCE_LINE 00001630 ""
NSQ_SOURCE_LINE 00001631 "If you did this:"
NSQ_SOURCE_LINE 00001632 ""
NSQ_SOURCE_LINE 00001633 "    my $array1 = [ $person1, $person2, $person4 ];"
NSQ_SOURCE_LINE 00001634 "    my $array2 = [ $person1, $person3, $person4, $person5 ];"
NSQ_SOURCE_LINE 00001635 "    Algorithm::Diff::diff( $array1, $array2 );"
NSQ_SOURCE_LINE 00001636 ""
NSQ_SOURCE_LINE 00001637 "everything would work out OK (each of the objects would be converted"
NSQ_SOURCE_LINE 00001638 "into a string like \"Person=HASH(0x82425b0)\" for comparison)."
NSQ_SOURCE_LINE 00001639 ""
NSQ_SOURCE_LINE 00001640 "But if you did this:"
NSQ_SOURCE_LINE 00001641 ""
NSQ_SOURCE_LINE 00001642 "    my $array1 = [ $person1, $person2, $person4 ];"
NSQ_SOURCE_LINE 00001643 "    my $array2 = [ $person1, $person3, $person4->clone(), $person5 ];"
NSQ_SOURCE_LINE 00001644 "    Algorithm::Diff::diff( $array1, $array2 );"
NSQ_SOURCE_LINE 00001645 ""
NSQ_SOURCE_LINE 00001646 "$person4 and $person4->clone() (which have the same name and SSN)"
NSQ_SOURCE_LINE 00001647 "would be seen as different objects. If you wanted them to be considered"
NSQ_SOURCE_LINE 00001648 "equivalent, you would have to pass in a key generation function:"
NSQ_SOURCE_LINE 00001649 ""
NSQ_SOURCE_LINE 00001650 "    my $array1 = [ $person1, $person2, $person4 ];"
NSQ_SOURCE_LINE 00001651 "    my $array2 = [ $person1, $person3, $person4->clone(), $person5 ];"
NSQ_SOURCE_LINE 00001652 "    Algorithm::Diff::diff( $array1, $array2, \\&Person::hash );"
NSQ_SOURCE_LINE 00001653 ""
NSQ_SOURCE_LINE 00001654 "This would use the 'ssn' field in each Person as a comparison key, and"
NSQ_SOURCE_LINE 00001655 "so would consider $person4 and $person4->clone() as equal."
NSQ_SOURCE_LINE 00001656 ""
NSQ_SOURCE_LINE 00001657 "You may also pass additional parameters to the key generation function"
NSQ_SOURCE_LINE 00001658 "if you wish."
NSQ_SOURCE_LINE 00001659 ""
NSQ_SOURCE_LINE 00001660 "=head1 ERROR CHECKING"
NSQ_SOURCE_LINE 00001661 ""
NSQ_SOURCE_LINE 00001662 "If you pass these routines a non-reference and they expect a reference,"
NSQ_SOURCE_LINE 00001663 "they will die with a message."
NSQ_SOURCE_LINE 00001664 ""
