NSQ_SOURCE_LINE 00000001 "package PERLANCAR::File::HomeDir;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2018-09-20'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.060'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use 5.010001;"
NSQ_SOURCE_LINE 00000007 "use strict;"
NSQ_SOURCE_LINE 00000008 "use warnings;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use Exporter qw(import);"
NSQ_SOURCE_LINE 00000011 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000012 "                       get_my_home_dir"
NSQ_SOURCE_LINE 00000013 "                       get_user_home_dir"
NSQ_SOURCE_LINE 00000014 "               );"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "our $DIE_ON_FAILURE = 0;"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "# borrowed from File::HomeDir, with some modifications"
NSQ_SOURCE_LINE 00000019 "sub get_my_home_dir {"
NSQ_SOURCE_LINE 00000020 "    if ($^O eq 'MSWin32') {"
NSQ_SOURCE_LINE 00000021 "        # File::HomeDir always uses exists($ENV{x}) first, does it want to avoid"
NSQ_SOURCE_LINE 00000022 "        # accidentally creating env vars?"
NSQ_SOURCE_LINE 00000023 "        return $ENV{HOME} if $ENV{HOME};"
NSQ_SOURCE_LINE 00000024 "        return $ENV{USERPROFILE} if $ENV{USERPROFILE};"
NSQ_SOURCE_LINE 00000025 "        return join($ENV{HOMEDRIVE}, \"\\\\\", $ENV{HOMEPATH})"
NSQ_SOURCE_LINE 00000026 "            if $ENV{HOMEDRIVE} && $ENV{HOMEPATH};"
NSQ_SOURCE_LINE 00000027 "    } else {"
NSQ_SOURCE_LINE 00000028 "        return $ENV{HOME} if $ENV{HOME};"
NSQ_SOURCE_LINE 00000029 "        my @pw;"
NSQ_SOURCE_LINE 00000030 "        eval { @pw = getpwuid($>) };"
NSQ_SOURCE_LINE 00000031 "        return $pw[7] if @pw;"
NSQ_SOURCE_LINE 00000032 "    }"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "    if ($DIE_ON_FAILURE) {"
NSQ_SOURCE_LINE 00000035 "        die \"Can't get home directory\";"
NSQ_SOURCE_LINE 00000036 "    } else {"
NSQ_SOURCE_LINE 00000037 "        return undef;"
NSQ_SOURCE_LINE 00000038 "    }"
NSQ_SOURCE_LINE 00000039 "}"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "# borrowed from File::HomeDir, with some modifications"
NSQ_SOURCE_LINE 00000042 "sub get_user_home_dir {"
NSQ_SOURCE_LINE 00000043 "    my ($name) = @_;"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "    if ($^O eq 'MSWin32') {"
NSQ_SOURCE_LINE 00000046 "        # not yet implemented"
NSQ_SOURCE_LINE 00000047 "        return undef;"
NSQ_SOURCE_LINE 00000048 "    } else {"
NSQ_SOURCE_LINE 00000049 "        # IF and only if we have getpwuid support, and the name of the user is"
NSQ_SOURCE_LINE 00000050 "        # our own, shortcut to my_home. This is needed to handle HOME"
NSQ_SOURCE_LINE 00000051 "        # environment settings."
NSQ_SOURCE_LINE 00000052 "        if ($name eq getpwuid($<)) {"
NSQ_SOURCE_LINE 00000053 "            return get_my_home_dir();"
NSQ_SOURCE_LINE 00000054 "        }"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "      SCOPE: {"
NSQ_SOURCE_LINE 00000057 "            my $home = (getpwnam($name))[7];"
NSQ_SOURCE_LINE 00000058 "            return $home if $home and -d $home;"
NSQ_SOURCE_LINE 00000059 "        }"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "        return undef;"
NSQ_SOURCE_LINE 00000062 "    }"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "}"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "1;"
NSQ_SOURCE_LINE 00000067 "# ABSTRACT: Lightweight way to get current user's home directory"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "__END__"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "=pod"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "=head1 NAME"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "PERLANCAR::File::HomeDir - Lightweight way to get current user's home directory"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "=head1 VERSION"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "This document describes version 0.060 of PERLANCAR::File::HomeDir (from Perl distribution PERLANCAR-File-HomeDir), released on 2018-09-20."
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 " use PERLANCAR::File::HomeDir qw(get_my_home_dir get_user_home_dir);"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 " my $dir = get_my_home_dir(); # e.g. \"/home/ujang\""
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 " $dir = get_user_home_dir(\"ujang\");"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "This is a (temporary?) module to get user's home directory. It is a lightweight"
NSQ_SOURCE_LINE 00000094 "version of L<File::HomeDir> with fewer OS support (only Windows and Unix) and"
NSQ_SOURCE_LINE 00000095 "fewer logic/heuristic."
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "=head1 VARIABLES"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "=head2 $DIE_ON_FAILURE => bool (default: 0)"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "If set to true, will die on failure. Else, function usually return undef on"
NSQ_SOURCE_LINE 00000102 "failure."
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "None are exported by default, but they are exportable."
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "=head2 get_my_home_dir"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "Usage:"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 " my $home_dir = get_my_home_dir();"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "Try several ways to get home directory of the current user. Return undef or die"
NSQ_SOURCE_LINE 00000115 "(depends on C<$DIE_ON_FAILURE>) if everything fails."
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "=head2 get_user_home_dir"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "Usage:"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 " my $home_dir = get_user_home_dir($username);"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "Try several ways to get home directory of a specified user (C<$username>)."
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "Please visit the project's homepage at L<https://metacpan.org/release/PERLANCAR-File-HomeDir>."
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "Source repository is at L<https://github.com/perlancar/perl-PERLANCAR-File-HomeDir>."
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "=head1 BUGS"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "Please report any bugs or feature requests on the bugtracker website L<https://rt.cpan.org/Public/Dist/Display.html?Name=PERLANCAR-File-HomeDir>"
