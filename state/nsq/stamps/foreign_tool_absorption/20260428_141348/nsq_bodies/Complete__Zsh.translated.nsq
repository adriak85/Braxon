NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "_"
NSQ_SOURCE_LINE 00000044 "            schema=>['any*' => of => ['hash*', 'array*']],"
NSQ_SOURCE_LINE 00000045 "            req=>1,"
NSQ_SOURCE_LINE 00000046 "            pos=>0,"
NSQ_SOURCE_LINE 00000047 "        },"
NSQ_SOURCE_LINE 00000048 "    },"
