NSQ_SOURCE_LINE 00000024 "};"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "$SPEC{format_completion} = {"
NSQ_SOURCE_LINE 00000027 "    v => 1.1,"
NSQ_SOURCE_LINE 00000028 "    summary => 'Format completion for output (for shell)',"
NSQ_SOURCE_LINE 00000029 "    description => <<'_',"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "zsh accepts completion reply in the form of one entry per line to STDOUT."
NSQ_SOURCE_LINE 00000032 "Currently the formatting is done using `Complete::Bash`'s `format_completion`."
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "_"
NSQ_SOURCE_LINE 00000035 "    args_as => 'array',"
NSQ_SOURCE_LINE 00000036 "    args => {"
NSQ_SOURCE_LINE 00000037 "        completion => {"
NSQ_SOURCE_LINE 00000038 "            summary => 'Completion answer structure',"
NSQ_SOURCE_LINE 00000039 "            description => <<'_',"
