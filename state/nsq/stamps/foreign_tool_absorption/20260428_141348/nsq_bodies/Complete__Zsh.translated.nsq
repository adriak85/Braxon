NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "=head1 NAME"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "Complete::Zsh - Completion module for zsh shell"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "=head1 VERSION"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "This document describes version 0.03 of Complete::Zsh (from Perl distribution Complete-Zsh), released on 2016-10-22."
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "This module provides routines related to doing completion in zsh."
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "=head2 format_completion($completion) -> str|array"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "Format completion for output (for shell)."
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "zsh accepts completion reply in the form of one entry per line to STDOUT."
NSQ_SOURCE_LINE 00000088 "Currently the formatting is done using C<Complete::Bash>'s C<format_completion>."
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "=over 4"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "=item * B<$completion>* => I<hash|array>"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "Completion answer structure."
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "Either an array or hash, as described in C<Complete>."
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "=back"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "Return value: Formatted string (or array, if `as` key is set to `array`) (str|array)"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "Please visit the project's homepage at L<https://metacpan.org/release/Complete-Zsh>."
NSQ_SOURCE_LINE 00000109 ""
