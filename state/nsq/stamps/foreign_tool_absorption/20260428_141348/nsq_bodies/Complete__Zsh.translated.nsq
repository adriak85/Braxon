NSQ_SOURCE_LINE 00000050 "        summary => 'Formatted string (or array, if `as` key is set to `array`)',"
NSQ_SOURCE_LINE 00000051 "        schema => ['any*' => of => ['str*', 'array*']],"
NSQ_SOURCE_LINE 00000052 "    },"
NSQ_SOURCE_LINE 00000053 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000054 "};"
NSQ_SOURCE_LINE 00000055 "sub format_completion {"
NSQ_SOURCE_LINE 00000056 "    Complete::Bash::format_completion(@_);"
NSQ_SOURCE_LINE 00000057 "}"
