NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "1;"
NSQ_SOURCE_LINE 00000181 "# ABSTRACT: Check structure of data"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "__END__"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "=pod"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "=head1 NAME"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "Data::Check::Structure - Check structure of data"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "=head1 VERSION"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "This document describes version 0.050 of Data::Check::Structure (from Perl distribution Data-Check-Structure), released on 2020-11-08."
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "This small module provides several simple routines to check the structure of"
NSQ_SOURCE_LINE 00000202 "data, e.g. whether data is an array of arrays (\"aoa\"), array of scalars (\"aos\"),"
NSQ_SOURCE_LINE 00000203 "and so on."
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "None exported by default, but they are exportable."
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "=head2 is_aos($data[, \\%opts]) => bool"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "Check that data is an array of scalars. Examples:"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 " is_aos([]);                     # true"
NSQ_SOURCE_LINE 00000214 " is_aos(['a', 'b']);             # true"
NSQ_SOURCE_LINE 00000215 " is_aos(['a', []]);              # false"
NSQ_SOURCE_LINE 00000216 " is_aos([1,2,3, []], {max=>3});  # true"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "Known options: C<max> (maximum number of items to check, undef means check all"
NSQ_SOURCE_LINE 00000219 "items)."
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "=head2 is_aoa($data[, \\%opts]) => bool"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "Check that data is an array of arrays. Examples:"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 " is_aoa([]);                          # true"
NSQ_SOURCE_LINE 00000226 " is_aoa([[1], [2]]);                  # true"
NSQ_SOURCE_LINE 00000227 " is_aoa([[1], 'a']);                  # false"
NSQ_SOURCE_LINE 00000228 " is_aoa([[1],[],[], 'a'], {max=>3});  # true"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "Known options: C<max> (maximum number of items to check, undef means check all"
NSQ_SOURCE_LINE 00000231 "items)."
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "=head2 is_aoaos($data[, \\%opts]) => bool"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "Check that data is an array of arrays of scalars. Examples:"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 " is_aoaos([]);                           # true"
NSQ_SOURCE_LINE 00000238 " is_aoaos([[1], [2]]);                   # true"
NSQ_SOURCE_LINE 00000239 " is_aoaos([[1], [{}]]);                  # false"
NSQ_SOURCE_LINE 00000240 " is_aoaos([[1],[],[], [{}]], {max=>3});  # true"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "Known options: C<max> (maximum number of items to check, undef means check all"
NSQ_SOURCE_LINE 00000243 "items)."
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "=head2 is_aoh($data[, \\%opts]) => bool"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "Check that data is an array of hashes. Examples:"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 " is_aoh([]);                             # true"
NSQ_SOURCE_LINE 00000250 " is_aoh([{}, {a=>1}]);                   # true"
NSQ_SOURCE_LINE 00000251 " is_aoh([{}, 'a']);                      # false"
NSQ_SOURCE_LINE 00000252 " is_aoh([{},{},{a=>1}, 'a'], {max=>3});  # true"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "Known options: C<max> (maximum number of items to check, undef means check all"
NSQ_SOURCE_LINE 00000255 "items)."
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "=head2 is_aohos($data[, \\%opts]) => bool"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "Check that data is an array of hashes of scalars. Examples:"
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 " is_aohos([]);                                 # true"
NSQ_SOURCE_LINE 00000262 " is_aohos([{a=>1}, {}]);                       # true"
NSQ_SOURCE_LINE 00000263 " is_aohos([{a=>1}, {b=>[]}]);                  # false"
NSQ_SOURCE_LINE 00000264 " is_aohos([{a=>1},{},{}, {b=>[]}], {max=>3});  # true"
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "Known options: C<max> (maximum number of items to check, undef means check all"
NSQ_SOURCE_LINE 00000267 "items)."
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "=head2 is_hos($data[, \\%opts]) => bool"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "Check that data is a hash of scalars. Examples:"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 " is_hos({});                                   # true"
NSQ_SOURCE_LINE 00000274 " is_hos({a=>1, b=>2});                         # true"
NSQ_SOURCE_LINE 00000275 " is_hos({a=>1, b=>[]});                        # false"
NSQ_SOURCE_LINE 00000276 " is_hos({a=>1, b=>2, c=>3, d=>[]}, {max=>3});  # true (or false, depending on random hash key ordering)"
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "Known options: C<max> (maximum number of items to check, undef means check all"
NSQ_SOURCE_LINE 00000279 "items)."
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "=head2 is_hoa($data[, \\%opts]) => bool"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "Check that data is a hash of arrays. Examples:"
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 " is_hoa({}) );       # true"
NSQ_SOURCE_LINE 00000286 " is_hoa({a=>[]}) );  # true"
NSQ_SOURCE_LINE 00000287 " is_hoa({a=>1}) );   # false"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "Known options: C<max> (maximum number of items to check, undef means check all"
NSQ_SOURCE_LINE 00000290 "items)."
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "=head2 is_hoaos($data[, \\%opts]) => bool"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "Check that data is a hash of arrays of scalars. Examples:"
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 " is_hoaos({}) );         # true"
NSQ_SOURCE_LINE 00000297 " is_hoaos({a=>[]}) );    # true"
NSQ_SOURCE_LINE 00000298 " is_hoaos({a=>[1]}) );   # true"
NSQ_SOURCE_LINE 00000299 " is_hoaos({a=>1}) );     # false"
NSQ_SOURCE_LINE 00000300 " is_hoaos({a=>[{}]}) );  # false"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "Known options: C<max> (maximum number of items to check, undef means check all"
NSQ_SOURCE_LINE 00000303 "items)."
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "=head2 is_hoh($data[, \\%opts]) => bool"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "Check that data is a hash of hashes. Examples:"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 " is_hoh({}) );       # true"
NSQ_SOURCE_LINE 00000310 " is_hoh({a=>{}}) );  # true"
NSQ_SOURCE_LINE 00000311 " is_hoh({a=>1}) );   # false"
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "Known options: C<max> (maximum number of items to check, undef means check all"
NSQ_SOURCE_LINE 00000314 "items)."
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "=head2 is_hohos($data[, \\%opts]) => bool"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "Check that data is a hash of hashes of scalrs. Examples:"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 " is_hohos({}) );            # true"
NSQ_SOURCE_LINE 00000321 " is_hohos({a=>{}}) );       # true"
NSQ_SOURCE_LINE 00000322 " is_hohos({a=>{b=>1}}) );   # true"
NSQ_SOURCE_LINE 00000323 " is_hohos({a=>1}) );        # false"
NSQ_SOURCE_LINE 00000324 " is_hohos({a=>{b=>[]}}) );  # false"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "Known options: C<max> (maximum number of items to check, undef means check all"
NSQ_SOURCE_LINE 00000327 "items)."
NSQ_SOURCE_LINE 00000328 ""
