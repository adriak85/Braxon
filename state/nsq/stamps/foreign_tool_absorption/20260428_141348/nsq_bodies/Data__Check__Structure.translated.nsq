NSQ_SOURCE_LINE 00000150 "    my ($data, $opts) = @_;"
NSQ_SOURCE_LINE 00000151 "    $opts ||= {};"
NSQ_SOURCE_LINE 00000152 "    my $max = $opts->{max};"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "    return 0 unless ref($data) eq 'HASH';"
NSQ_SOURCE_LINE 00000155 "    my $i = 0;"
NSQ_SOURCE_LINE 00000156 "    for my $k (keys %$data) {"
NSQ_SOURCE_LINE 00000157 "        last if defined($max) && ++$i >= $max;"
NSQ_SOURCE_LINE 00000158 "        my $ref = ref($data->{$k});"
NSQ_SOURCE_LINE 00000159 "        do { $errstr = \"not hoh: value for key '$k' not hash ($ref)\"; return 0 } unless $ref eq 'HASH';"
NSQ_SOURCE_LINE 00000160 "    }"
