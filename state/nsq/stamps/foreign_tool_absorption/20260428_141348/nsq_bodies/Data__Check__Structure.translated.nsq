NSQ_SOURCE_LINE 00000001 "package Data::Check::Structure;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000004 "our $DATE = '2020-11-08'; # DATE"
NSQ_SOURCE_LINE 00000005 "our $DIST = 'Data-Check-Structure'; # DIST"
NSQ_SOURCE_LINE 00000006 "our $VERSION = '0.050'; # VERSION"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use strict;"
NSQ_SOURCE_LINE 00000009 "#use warnings;"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "use Exporter 'import';"
NSQ_SOURCE_LINE 00000012 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000013 "                       is_aoa"
NSQ_SOURCE_LINE 00000014 "                       is_aoaos"
NSQ_SOURCE_LINE 00000015 "                       is_aoh"
NSQ_SOURCE_LINE 00000016 "                       is_aohos"
NSQ_SOURCE_LINE 00000017 "                       is_aos"
NSQ_SOURCE_LINE 00000018 "                       is_hoa"
NSQ_SOURCE_LINE 00000019 "                       is_hoaos"
NSQ_SOURCE_LINE 00000020 "                       is_hoh"
NSQ_SOURCE_LINE 00000021 "                       is_hohos"
NSQ_SOURCE_LINE 00000022 "                       is_hos"
NSQ_SOURCE_LINE 00000023 "               );"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "our $errstr = '';"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "sub is_aos {"
NSQ_SOURCE_LINE 00000028 "    my ($data, $opts) = @_;"
NSQ_SOURCE_LINE 00000029 "    $opts ||= {};"
NSQ_SOURCE_LINE 00000030 "    my $max = $opts->{max};"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "    return 0 unless ref($data) eq 'ARRAY';"
NSQ_SOURCE_LINE 00000033 "    for my $i (0..@$data-1) {"
NSQ_SOURCE_LINE 00000034 "        last if defined($max) && $i >= $max;"
NSQ_SOURCE_LINE 00000035 "        my $ref = ref($data->[$i]);"
NSQ_SOURCE_LINE 00000036 "        do { $errstr = \"not aos: array element [$i] not scalar ($ref)\"; return 0 } if $ref;"
NSQ_SOURCE_LINE 00000037 "    }"
NSQ_SOURCE_LINE 00000038 "    $errstr = '';"
NSQ_SOURCE_LINE 00000039 "    1;"
NSQ_SOURCE_LINE 00000040 "}"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "sub is_aoa {"
NSQ_SOURCE_LINE 00000043 "    my ($data, $opts) = @_;"
NSQ_SOURCE_LINE 00000044 "    $opts ||= {};"
NSQ_SOURCE_LINE 00000045 "    my $max = $opts->{max};"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "    return 0 unless ref($data) eq 'ARRAY';"
NSQ_SOURCE_LINE 00000048 "    for my $i (0..@$data-1) {"
NSQ_SOURCE_LINE 00000049 "        last if defined($max) && $i >= $max;"
NSQ_SOURCE_LINE 00000050 "        my $ref = ref($data->[$i]);"
NSQ_SOURCE_LINE 00000051 "        do { $errstr = \"not aoa: array element [$i] not array ($ref)\"; return 0 } unless $ref eq 'ARRAY';"
NSQ_SOURCE_LINE 00000052 "    }"
NSQ_SOURCE_LINE 00000053 "    $errstr = '';"
NSQ_SOURCE_LINE 00000054 "    1;"
NSQ_SOURCE_LINE 00000055 "}"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "sub is_aoaos {"
NSQ_SOURCE_LINE 00000058 "    my ($data, $opts) = @_;"
NSQ_SOURCE_LINE 00000059 "    $opts ||= {};"
NSQ_SOURCE_LINE 00000060 "    my $max = $opts->{max};"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "    return 0 unless ref($data) eq 'ARRAY';"
NSQ_SOURCE_LINE 00000063 "    my $aos_opts = {max=>$max};"
NSQ_SOURCE_LINE 00000064 "    for my $i (0..@$data-1) {"
NSQ_SOURCE_LINE 00000065 "        last if defined($max) && $i >= $max;"
NSQ_SOURCE_LINE 00000066 "        do { $errstr = \"not aoaos: element [$i]\".($errstr ? \": $errstr\" : \" not aos\"); return 0 } unless is_aos($data->[$i], $aos_opts);"
NSQ_SOURCE_LINE 00000067 "    }"
NSQ_SOURCE_LINE 00000068 "    $errstr = '';"
NSQ_SOURCE_LINE 00000069 "    1;"
NSQ_SOURCE_LINE 00000070 "}"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "sub is_aoh {"
NSQ_SOURCE_LINE 00000073 "    my ($data, $opts) = @_;"
NSQ_SOURCE_LINE 00000074 "    $opts ||= {};"
NSQ_SOURCE_LINE 00000075 "    my $max = $opts->{max};"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "    return 0 unless ref($data) eq 'ARRAY';"
NSQ_SOURCE_LINE 00000078 "    for my $i (0..@$data-1) {"
NSQ_SOURCE_LINE 00000079 "        last if defined($max) && $i >= $max;"
NSQ_SOURCE_LINE 00000080 "        my $ref = ref($data->[$i]);"
NSQ_SOURCE_LINE 00000081 "        do { $errstr = \"not aoh: element [$i] not hash ($ref)\"; return 0 } unless $ref eq 'HASH';"
NSQ_SOURCE_LINE 00000082 "    }"
NSQ_SOURCE_LINE 00000083 "    $errstr = '';"
NSQ_SOURCE_LINE 00000084 "    1;"
NSQ_SOURCE_LINE 00000085 "}"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "sub is_aohos {"
NSQ_SOURCE_LINE 00000088 "    my ($data, $opts) = @_;"
NSQ_SOURCE_LINE 00000089 "    $opts ||= {};"
NSQ_SOURCE_LINE 00000090 "    my $max = $opts->{max};"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "    return 0 unless ref($data) eq 'ARRAY';"
NSQ_SOURCE_LINE 00000093 "    my $hos_opts = {max=>$max};"
NSQ_SOURCE_LINE 00000094 "    for my $i (0..@$data-1) {"
NSQ_SOURCE_LINE 00000095 "        last if defined($max) && $i >= $max;"
NSQ_SOURCE_LINE 00000096 "        do { $errstr = \"not aohos: element [$i]\".($errstr ? \": $errstr\" : \" not hos\"); return 0 } unless is_hos($data->[$i], $hos_opts);"
NSQ_SOURCE_LINE 00000097 "    }"
NSQ_SOURCE_LINE 00000098 "    $errstr = '';"
NSQ_SOURCE_LINE 00000099 "    1;"
NSQ_SOURCE_LINE 00000100 "}"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "sub is_hos {"
NSQ_SOURCE_LINE 00000103 "    my ($data, $opts) = @_;"
NSQ_SOURCE_LINE 00000104 "    $opts ||= {};"
NSQ_SOURCE_LINE 00000105 "    my $max = $opts->{max};"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "    return 0 unless ref($data) eq 'HASH';"
NSQ_SOURCE_LINE 00000108 "    my $i = 0;"
NSQ_SOURCE_LINE 00000109 "    for my $k (keys %$data) {"
NSQ_SOURCE_LINE 00000110 "        last if defined($max) && ++$i >= $max;"
NSQ_SOURCE_LINE 00000111 "        my $ref = ref($data->{$k});"
NSQ_SOURCE_LINE 00000112 "        do { $errstr = \"not hos: value for key '$k' not scalar ($ref)\"; return 0 } if $ref;"
NSQ_SOURCE_LINE 00000113 "    }"
NSQ_SOURCE_LINE 00000114 "    $errstr = '';"
NSQ_SOURCE_LINE 00000115 "    1;"
NSQ_SOURCE_LINE 00000116 "}"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "sub is_hoa {"
NSQ_SOURCE_LINE 00000119 "    my ($data, $opts) = @_;"
NSQ_SOURCE_LINE 00000120 "    $opts ||= {};"
NSQ_SOURCE_LINE 00000121 "    my $max = $opts->{max};"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "    return 0 unless ref($data) eq 'HASH';"
NSQ_SOURCE_LINE 00000124 "    my $i = 0;"
NSQ_SOURCE_LINE 00000125 "    for my $k (keys %$data) {"
NSQ_SOURCE_LINE 00000126 "        last if defined($max) && ++$i >= $max;"
NSQ_SOURCE_LINE 00000127 "        my $ref = ref($data->{$k});"
NSQ_SOURCE_LINE 00000128 "        do { $errstr = \"not hoa: value for key '$k' not array ($ref)\"; return 0 } unless $ref eq 'ARRAY';"
NSQ_SOURCE_LINE 00000129 "    }"
NSQ_SOURCE_LINE 00000130 "    $errstr = '';"
NSQ_SOURCE_LINE 00000131 "    1;"
NSQ_SOURCE_LINE 00000132 "}"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "sub is_hoaos {"
NSQ_SOURCE_LINE 00000135 "    my ($data, $opts) = @_;"
NSQ_SOURCE_LINE 00000136 "    $opts ||= {};"
NSQ_SOURCE_LINE 00000137 "    my $max = $opts->{max};"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "    return 0 unless ref($data) eq 'HASH';"
NSQ_SOURCE_LINE 00000140 "    my $i = 0;"
NSQ_SOURCE_LINE 00000141 "    for my $k (keys %$data) {"
NSQ_SOURCE_LINE 00000142 "        last if defined($max) && ++$i >= $max;"
NSQ_SOURCE_LINE 00000143 "        do { $errstr = \"not hoaos: value for key '$k'\".($errstr ? \": $errstr\" : \" not aos\"); return 0 } unless is_aos($data->{$k});"
NSQ_SOURCE_LINE 00000144 "    }"
NSQ_SOURCE_LINE 00000145 "    $errstr = '';"
NSQ_SOURCE_LINE 00000146 "    1;"
NSQ_SOURCE_LINE 00000147 "}"
