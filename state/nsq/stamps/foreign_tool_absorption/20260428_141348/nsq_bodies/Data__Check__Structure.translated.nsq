NSQ_SOURCE_LINE 00000162 "    1;"
NSQ_SOURCE_LINE 00000163 "}"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "sub is_hohos {"
NSQ_SOURCE_LINE 00000166 "    my ($data, $opts) = @_;"
NSQ_SOURCE_LINE 00000167 "    $opts ||= {};"
NSQ_SOURCE_LINE 00000168 "    my $max = $opts->{max};"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "    return 0 unless ref($data) eq 'HASH';"
NSQ_SOURCE_LINE 00000171 "    my $i = 0;"
NSQ_SOURCE_LINE 00000172 "    for my $k (keys %$data) {"
