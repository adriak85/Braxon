BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Devel::StackTrace::AsHTML;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use 5.008_001;"
NSQ_SOURCE_LINE 00000005 "our $VERSION = '0.15';"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "use Data::Dumper;"
NSQ_SOURCE_LINE 00000008 "use Devel::StackTrace;"
NSQ_SOURCE_LINE 00000009 "use Scalar::Util;"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "no warnings 'qw';"
NSQ_SOURCE_LINE 00000012 "my %enc = qw( & &amp; > &gt; < &lt; \" &quot; ' &#39; );"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "# NOTE: because we don't know which encoding $str is in, or even if"
NSQ_SOURCE_LINE 00000015 "# $str is a wide character (decoded strings), we just leave the low"
NSQ_SOURCE_LINE 00000016 "# bits, including latin-1 range and encode everything higher as HTML"
NSQ_SOURCE_LINE 00000017 "# entities. I know this is NOT always correct, but should mostly work"
NSQ_SOURCE_LINE 00000018 "# in case $str is encoded in utf-8 bytes or wide chars. This is a"
NSQ_SOURCE_LINE 00000019 "# necessary workaround since we're rendering someone else's code which"
NSQ_SOURCE_LINE 00000020 "# we can't enforce string encodings."
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "sub encode_html {"
NSQ_SOURCE_LINE 00000023 "    my $str = shift;"
NSQ_SOURCE_LINE 00000024 "    $str =~ s/([^\\x00-\\x21\\x23-\\x25\\x28-\\x3b\\x3d\\x3f-\\xff])/$enc{$1} || '&#' . ord($1) . ';' /ge;"
NSQ_SOURCE_LINE 00000025 "    utf8::downgrade($str);"
NSQ_SOURCE_LINE 00000026 "    $str;"
NSQ_SOURCE_LINE 00000027 "}"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "sub Devel::StackTrace::as_html {"
NSQ_SOURCE_LINE 00000030 "    __PACKAGE__->render(@_);"
NSQ_SOURCE_LINE 00000031 "}"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "sub render {"
NSQ_SOURCE_LINE 00000034 "    my $class = shift;"
NSQ_SOURCE_LINE 00000035 "    my $trace = shift;"
NSQ_SOURCE_LINE 00000036 "    my %opt   = @_;"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "    my $msg = encode_html($trace->frame(0)->as_string(1));"
NSQ_SOURCE_LINE 00000039 "    my $out = qq{<!doctype html><head><title>Error: ${msg}</title>};"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "    $opt{style} ||= \\<<STYLE;"
NSQ_SOURCE_LINE 00000042 "a.toggle { color: #444 }"
NSQ_SOURCE_LINE 00000043 "body { margin: 0; padding: 0; background: #fff; color: #000; }"
NSQ_SOURCE_LINE 00000044 "h1 { margin: 0 0 .5em; padding: .25em .5em .1em 1.5em; border-bottom: thick solid #002; background: #444; color: #eee; font-size: x-large; }"
NSQ_SOURCE_LINE 00000045 "pre.message { margin: .5em 1em; }"
NSQ_SOURCE_LINE 00000046 "li.frame { font-size: small; margin-top: 3em }"
NSQ_SOURCE_LINE 00000047 "li.frame:nth-child(1) { margin-top: 0 }"
NSQ_SOURCE_LINE 00000048 "pre.context { border: 1px solid #aaa; padding: 0.2em 0; background: #fff; color: #444; font-size: medium; }"
NSQ_SOURCE_LINE 00000049 "pre .match { color: #000;background-color: #f99; font-weight: bold }"
NSQ_SOURCE_LINE 00000050 "pre.vardump { margin:0 }"
NSQ_SOURCE_LINE 00000051 "pre code strong { color: #000; background: #f88; }"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "table.lexicals, table.arguments { border-collapse: collapse }"
NSQ_SOURCE_LINE 00000054 "table.lexicals td, table.arguments td { border: 1px solid #000; margin: 0; padding: .3em }"
NSQ_SOURCE_LINE 00000055 "table.lexicals tr:nth-child(2n) { background: #DDDDFF }"
NSQ_SOURCE_LINE 00000056 "table.arguments tr:nth-child(2n) { background: #DDFFDD }"
NSQ_SOURCE_LINE 00000057 ".lexicals, .arguments { display: none }"
NSQ_SOURCE_LINE 00000058 ".variable, .value { font-family: monospace; white-space: pre }"
NSQ_SOURCE_LINE 00000059 "td.variable { vertical-align: top }"
NSQ_SOURCE_LINE 00000060 "STYLE"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "    if (ref $opt{style}) {"
NSQ_SOURCE_LINE 00000063 "        $out .= qq(<style type=\"text/css\">${$opt{style}}</style>);"
NSQ_SOURCE_LINE 00000064 "    } else {"
NSQ_SOURCE_LINE 00000065 "        $out .= qq(<link rel=\"stylesheet\" type=\"text/css\" href=\") . encode_html($opt{style}) . q(\" />);"
NSQ_SOURCE_LINE 00000066 "    }"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "    $out .= <<HEAD;"
NSQ_SOURCE_LINE 00000069 "<script language=\"JavaScript\" type=\"text/javascript\">"
NSQ_SOURCE_LINE 00000070 "function toggleThing(ref, type, hideMsg, showMsg) {"
NSQ_SOURCE_LINE 00000071 " var css = document.getElementById(type+'-'+ref).style;"
NSQ_SOURCE_LINE 00000072 " css.display = css.display == 'block' ? 'none' : 'block';"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 " var hyperlink = document.getElementById('toggle-'+ref);"
NSQ_SOURCE_LINE 00000075 " hyperlink.textContent = css.display == 'block' ? hideMsg : showMsg;"
NSQ_SOURCE_LINE 00000076 "}"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "function toggleArguments(ref) {"
NSQ_SOURCE_LINE 00000079 " toggleThing(ref, 'arguments', 'Hide function arguments', 'Show function arguments');"
NSQ_SOURCE_LINE 00000080 "}"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "function toggleLexicals(ref) {"
NSQ_SOURCE_LINE 00000083 " toggleThing(ref, 'lexicals', 'Hide lexical variables', 'Show lexical variables');"
NSQ_SOURCE_LINE 00000084 "}"
NSQ_SOURCE_LINE 00000085 "</script>"
NSQ_SOURCE_LINE 00000086 "</head>"
NSQ_SOURCE_LINE 00000087 "<body>"
NSQ_SOURCE_LINE 00000088 "<h1>Error trace</h1><pre class=\"message\">$msg</pre><ol>"
NSQ_SOURCE_LINE 00000089 "HEAD"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "    my $i = 0;"
NSQ_SOURCE_LINE 00000092 "    while (my $frame = $trace->next_frame) {"
NSQ_SOURCE_LINE 00000093 "        $i++;"
NSQ_SOURCE_LINE 00000094 "        my $next_frame = $trace->frame($i); # peek next"
NSQ_SOURCE_LINE 00000095 "        $out .= join("
NSQ_SOURCE_LINE 00000096 "            '',"
NSQ_SOURCE_LINE 00000097 "            '<li class=\"frame\">',"
NSQ_SOURCE_LINE 00000098 "            ($next_frame && $next_frame->subroutine) ? encode_html(\"in \" . $next_frame->subroutine) : '',"
NSQ_SOURCE_LINE 00000099 "            ' at ',"
NSQ_SOURCE_LINE 00000100 "            $frame->filename ? encode_html($frame->filename) : '',"
NSQ_SOURCE_LINE 00000101 "            ' line ',"
NSQ_SOURCE_LINE 00000102 "            $frame->line,"
NSQ_SOURCE_LINE 00000103 "            q(<pre class=\"context\"><code>),"
NSQ_SOURCE_LINE 00000104 "            _build_context($frame) || '',"
NSQ_SOURCE_LINE 00000105 "            q(</code></pre>),"
NSQ_SOURCE_LINE 00000106 "            _build_arguments($i, $next_frame),"
NSQ_SOURCE_LINE 00000107 "            $frame->can('lexicals') ? _build_lexicals($i, $frame->lexicals) : '',"
NSQ_SOURCE_LINE 00000108 "            q(</li>),"
NSQ_SOURCE_LINE 00000109 "        );"
NSQ_SOURCE_LINE 00000110 "    }"
NSQ_SOURCE_LINE 00000111 "    $out .= qq{</ol>};"
NSQ_SOURCE_LINE 00000112 "    $out .= \"</body></html>\";"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "    $out;"
NSQ_SOURCE_LINE 00000115 "}"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "my $dumper = sub {"
NSQ_SOURCE_LINE 00000118 "    my $value = shift;"
NSQ_SOURCE_LINE 00000119 "    $value = $$value if ref $value eq 'SCALAR' or ref $value eq 'REF';"
NSQ_SOURCE_LINE 00000120 "    my $d = Data::Dumper->new([ $value ]);"
NSQ_SOURCE_LINE 00000121 "    $d->Indent(1)->Terse(1)->Deparse(1);"
NSQ_SOURCE_LINE 00000122 "    chomp(my $dump = $d->Dump);"
NSQ_SOURCE_LINE 00000123 "    $dump;"
NSQ_SOURCE_LINE 00000124 "};"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "sub _build_arguments {"
NSQ_SOURCE_LINE 00000127 "    my($id, $frame) = @_;"
NSQ_SOURCE_LINE 00000128 "    my $ref = \"arg-$id\";"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "    return '' unless $frame && $frame->args;"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "    my @args = $frame->args;"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "    my $html = qq(<p><a class=\"toggle\" id=\"toggle-$ref\" href=\"javascript:toggleArguments('$ref')\">Show function arguments</a></p><table class=\"arguments\" id=\"arguments-$ref\">);"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "    # Don't use while each since Dumper confuses that"
NSQ_SOURCE_LINE 00000137 "    for my $idx (0 .. @args - 1) {"
NSQ_SOURCE_LINE 00000138 "        my $value = $args[$idx];"
NSQ_SOURCE_LINE 00000139 "        my $dump = $dumper->($value);"
NSQ_SOURCE_LINE 00000140 "        $html .= qq{<tr>};"
NSQ_SOURCE_LINE 00000141 "        $html .= qq{<td class=\"variable\">\\$_[$idx]</td>};"
NSQ_SOURCE_LINE 00000142 "        $html .= qq{<td class=\"value\">} . encode_html($dump) . qq{</td>};"
NSQ_SOURCE_LINE 00000143 "        $html .= qq{</tr>};"
NSQ_SOURCE_LINE 00000144 "    }"
NSQ_SOURCE_LINE 00000145 "    $html .= qq(</table>);"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "    return $html;"
NSQ_SOURCE_LINE 00000148 "}"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "sub _build_lexicals {"
NSQ_SOURCE_LINE 00000151 "    my($id, $lexicals) = @_;"
NSQ_SOURCE_LINE 00000152 "    my $ref = \"lex-$id\";"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "    return '' unless keys %$lexicals;"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "    my $html = qq(<p><a class=\"toggle\" id=\"toggle-$ref\" href=\"javascript:toggleLexicals('$ref')\">Show lexical variables</a></p><table class=\"lexicals\" id=\"lexicals-$ref\">);"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "    # Don't use while each since Dumper confuses that"
NSQ_SOURCE_LINE 00000159 "    for my $var (sort keys %$lexicals) {"
NSQ_SOURCE_LINE 00000160 "        my $value = $lexicals->{$var};"
NSQ_SOURCE_LINE 00000161 "        my $dump = $dumper->($value);"
NSQ_SOURCE_LINE 00000162 "        $dump =~ s/^\\{(.*)\\}$/($1)/s if $var =~ /^\\%/;"
NSQ_SOURCE_LINE 00000163 "        $dump =~ s/^\\[(.*)\\]$/($1)/s if $var =~ /^\\@/;"
NSQ_SOURCE_LINE 00000164 "        $html .= qq{<tr>};"
NSQ_SOURCE_LINE 00000165 "        $html .= qq{<td class=\"variable\">} . encode_html($var)  . qq{</td>};"
NSQ_SOURCE_LINE 00000166 "        $html .= qq{<td class=\"value\">}    . encode_html($dump) . qq{</td>};"
NSQ_SOURCE_LINE 00000167 "        $html .= qq{</tr>};"
NSQ_SOURCE_LINE 00000168 "    }"
NSQ_SOURCE_LINE 00000169 "    $html .= qq(</table>);"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "    return $html;"
NSQ_SOURCE_LINE 00000172 "}"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "sub _build_context {"
NSQ_SOURCE_LINE 00000175 "    my $frame = shift;"
NSQ_SOURCE_LINE 00000176 "    my $file    = $frame->filename;"
NSQ_SOURCE_LINE 00000177 "    my $linenum = $frame->line;"
NSQ_SOURCE_LINE 00000178 "    my $code;"
NSQ_SOURCE_LINE 00000179 "    if (-f $file) {"
NSQ_SOURCE_LINE 00000180 "        my $start = $linenum - 3;"
NSQ_SOURCE_LINE 00000181 "        my $end   = $linenum + 3;"
NSQ_SOURCE_LINE 00000182 "        $start = $start < 1 ? 1 : $start;"
NSQ_SOURCE_LINE 00000183 "        open my $fh, '<', $file"
NSQ_SOURCE_LINE 00000184 "            or die \"cannot open $file:$!\";"
NSQ_SOURCE_LINE 00000185 "        my $cur_line = 0;"
NSQ_SOURCE_LINE 00000186 "        while (my $line = <$fh>) {"
NSQ_SOURCE_LINE 00000187 "            ++$cur_line;"
NSQ_SOURCE_LINE 00000188 "            last if $cur_line > $end;"
NSQ_SOURCE_LINE 00000189 "            next if $cur_line < $start;"
NSQ_SOURCE_LINE 00000190 "            $line =~ s|\\t|        |g;"
NSQ_SOURCE_LINE 00000191 "            my @tag = $cur_line == $linenum"
NSQ_SOURCE_LINE 00000192 "                ? (q{<strong class=\"match\">}, '</strong>')"
NSQ_SOURCE_LINE 00000193 "                    : ('', '');"
NSQ_SOURCE_LINE 00000194 "            $code .= sprintf("
NSQ_SOURCE_LINE 00000195 "                '%s%5d: %s%s', $tag[0], $cur_line, encode_html($line),"
NSQ_SOURCE_LINE 00000196 "                $tag[1],"
NSQ_SOURCE_LINE 00000197 "            );"
NSQ_SOURCE_LINE 00000198 "        }"
NSQ_SOURCE_LINE 00000199 "        close $file;"
NSQ_SOURCE_LINE 00000200 "    }"
NSQ_SOURCE_LINE 00000201 "    return $code;"
NSQ_SOURCE_LINE 00000202 "}"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "1;"
NSQ_SOURCE_LINE 00000205 "__END__"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "=encoding utf-8"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "=for stopwords"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "=head1 NAME"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "Devel::StackTrace::AsHTML - Displays stack trace in HTML"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "  use Devel::StackTrace::AsHTML;"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "  my $trace = Devel::StackTrace->new;"
NSQ_SOURCE_LINE 00000220 "  my $html  = $trace->as_html;"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "Devel::StackTrace::AsHTML adds C<as_html> method to L<Devel::StackTrace> which"
NSQ_SOURCE_LINE 00000225 "displays the stack trace in beautiful HTML, with code snippet context and"
NSQ_SOURCE_LINE 00000226 "function parameters. If you call it on an instance of"
NSQ_SOURCE_LINE 00000227 "L<Devel::StackTrace::WithLexicals>, you even get to see the lexical variables"
NSQ_SOURCE_LINE 00000228 "of each stack frame."
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "Tatsuhiko Miyagawa E<lt>miyagawa@bulknews.netE<gt>"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "Shawn M Moore"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "HTML generation code is ripped off from L<CGI::ExceptionManager> written by Tokuhiro Matsuno and Kazuho Oku."
NSQ_SOURCE_LINE 00000237 ""
