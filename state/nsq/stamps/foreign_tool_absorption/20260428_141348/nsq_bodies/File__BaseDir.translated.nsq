BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package File::BaseDir;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 "use Exporter 5.57 qw( import );"
NSQ_SOURCE_LINE 00000006 "use File::Spec;"
NSQ_SOURCE_LINE 00000007 "use Config;"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "# ABSTRACT: Use the Freedesktop.org base directory specification"
NSQ_SOURCE_LINE 00000010 "our $VERSION = '0.09'; # VERSION"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "our %EXPORT_TAGS = ("
NSQ_SOURCE_LINE 00000013 "  vars => [ qw("
NSQ_SOURCE_LINE 00000014 "    xdg_data_home xdg_data_dirs"
NSQ_SOURCE_LINE 00000015 "    xdg_config_home xdg_config_dirs"
NSQ_SOURCE_LINE 00000016 "    xdg_cache_home"
NSQ_SOURCE_LINE 00000017 "  ) ],"
NSQ_SOURCE_LINE 00000018 "  lookup => [ qw("
NSQ_SOURCE_LINE 00000019 "    data_home data_dirs data_files"
NSQ_SOURCE_LINE 00000020 "    config_home config_dirs config_files"
NSQ_SOURCE_LINE 00000021 "    cache_home"
NSQ_SOURCE_LINE 00000022 "  ) ],"
NSQ_SOURCE_LINE 00000023 ");"
NSQ_SOURCE_LINE 00000024 "our @EXPORT_OK = ("
NSQ_SOURCE_LINE 00000025 "  qw(xdg_data_files xdg_config_files),"
NSQ_SOURCE_LINE 00000026 "  map @$_, values %EXPORT_TAGS"
NSQ_SOURCE_LINE 00000027 ");"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "if($^O eq 'MSWin32')"
NSQ_SOURCE_LINE 00000030 "{"
NSQ_SOURCE_LINE 00000031 "  *_rootdir = sub { 'C:\\\\' };"
NSQ_SOURCE_LINE 00000032 "  *_home    = sub { $ENV{USERPROFILE} || $ENV{HOMEDRIVE}.$ENV{HOMEPATH} || 'C:\\\\' };"
NSQ_SOURCE_LINE 00000033 "}"
NSQ_SOURCE_LINE 00000034 "else"
NSQ_SOURCE_LINE 00000035 "{"
NSQ_SOURCE_LINE 00000036 "  *_rootdir = sub { File::Spec->rootdir };"
NSQ_SOURCE_LINE 00000037 "  *_home    = sub { $ENV{HOME} || eval { [getpwuid($>)]->[7] } || File::Spec->rootdir };"
NSQ_SOURCE_LINE 00000038 "}"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "# OO method"
NSQ_SOURCE_LINE 00000041 "sub new { bless \\$VERSION, shift } # what else is there to bless ?"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "# Variable methods"
NSQ_SOURCE_LINE 00000044 "sub xdg_data_home { $ENV{XDG_DATA_HOME} || File::Spec->catdir(_home(), qw/.local share/) }"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "sub xdg_data_dirs {"
NSQ_SOURCE_LINE 00000047 "  ( $ENV{XDG_DATA_DIRS}"
NSQ_SOURCE_LINE 00000048 "    ? _adapt($ENV{XDG_DATA_DIRS})"
NSQ_SOURCE_LINE 00000049 "    : (File::Spec->catdir(_rootdir(), qw/usr local share/), File::Spec->catdir(_rootdir(), qw/usr share/))"
NSQ_SOURCE_LINE 00000050 "  )"
NSQ_SOURCE_LINE 00000051 "}"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "sub xdg_config_home {$ENV{XDG_CONFIG_HOME} || File::Spec->catdir(_home(), '.config') }"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "sub xdg_config_dirs {"
NSQ_SOURCE_LINE 00000056 "  ( $ENV{XDG_CONFIG_DIRS}"
NSQ_SOURCE_LINE 00000057 "    ? _adapt($ENV{XDG_CONFIG_DIRS})"
NSQ_SOURCE_LINE 00000058 "    : File::Spec->catdir(_rootdir(), qw/etc xdg/)"
NSQ_SOURCE_LINE 00000059 "  )"
NSQ_SOURCE_LINE 00000060 "}"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "sub xdg_cache_home { $ENV{XDG_CACHE_HOME} || File::Spec->catdir(_home(), '.cache') }"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "sub _adapt {"
NSQ_SOURCE_LINE 00000065 "  map { File::Spec->catdir( split(/\\//, $_) ) } split /\\Q$Config{path_sep}\\E/, shift;"
NSQ_SOURCE_LINE 00000066 "    # ':' defined in the spec, but ';' is standard on win32"
NSQ_SOURCE_LINE 00000067 "}"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "# Lookup methods"
NSQ_SOURCE_LINE 00000070 "sub data_home { _catfile(xdg_data_home, @_) }"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "sub data_dirs { _find_files(\\&_dir, \\@_, xdg_data_home, xdg_data_dirs) }"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "sub data_files { _find_files(\\&_file, \\@_, xdg_data_home, xdg_data_dirs) }"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "sub xdg_data_files { my @dirs = data_files(@_); return @dirs }"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "sub config_home { _catfile(xdg_config_home, @_) }"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "sub config_dirs { _find_files(\\&_dir, \\@_, xdg_config_home, xdg_config_dirs) }"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "sub config_files { _find_files(\\&_file, \\@_, xdg_config_home, xdg_config_dirs) }"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "sub xdg_config_files { my @dirs = config_files(@_); return @dirs }"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "sub cache_home { _catfile(xdg_cache_home, @_) }"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "sub _catfile {"
NSQ_SOURCE_LINE 00000089 "  my $dir = shift;"
NSQ_SOURCE_LINE 00000090 "  shift if ref $_[0] or $_[0] =~ /::/; # OO call"
NSQ_SOURCE_LINE 00000091 "  return File::Spec->catfile($dir, @_);"
NSQ_SOURCE_LINE 00000092 "}"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "sub _find_files {"
NSQ_SOURCE_LINE 00000095 "  my $type = shift;"
NSQ_SOURCE_LINE 00000096 "  my $file = shift;"
NSQ_SOURCE_LINE 00000097 "  shift @$file if ref $$file[0] or $$file[0] =~ /::/; # OO call"
NSQ_SOURCE_LINE 00000098 "  #warn \"Looking for: @$file\\n         in: @_\\n\";"
NSQ_SOURCE_LINE 00000099 "  if (wantarray) {  ## no critic (Community::Wantarray)"
NSQ_SOURCE_LINE 00000100 "    return grep { &$type( $_ ) && -r $_ }"
NSQ_SOURCE_LINE 00000101 "           map  { File::Spec->catfile($_, @$file) } @_;"
NSQ_SOURCE_LINE 00000102 "  }"
NSQ_SOURCE_LINE 00000103 "  else { # prevent unnecessary stats by returning early"
NSQ_SOURCE_LINE 00000104 "    for (@_) {"
NSQ_SOURCE_LINE 00000105 "      my $path = File::Spec->catfile($_, @$file);"
NSQ_SOURCE_LINE 00000106 "      return $path if &$type($path) && -r $path;"
NSQ_SOURCE_LINE 00000107 "    }"
NSQ_SOURCE_LINE 00000108 "  }"
NSQ_SOURCE_LINE 00000109 "  return ();"
NSQ_SOURCE_LINE 00000110 "}"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "sub _dir { -d $_[0] }"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "sub _file { -f $_[0] }"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "1;"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "__END__"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "=pod"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "=head1 NAME"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "File::BaseDir - Use the Freedesktop.org base directory specification"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "=head1 VERSION"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "version 0.09"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 " use File::BaseDir qw/xdg_data_files/;"
NSQ_SOURCE_LINE 00000135 " for ( xdg_data_files('mime/globs') ) {"
NSQ_SOURCE_LINE 00000136 "   # do something"
NSQ_SOURCE_LINE 00000137 " }"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "This module can be used to find directories and files as specified"
NSQ_SOURCE_LINE 00000142 "by the Freedesktop.org Base Directory Specification. This specifications"
NSQ_SOURCE_LINE 00000143 "gives a mechanism to locate directories for configuration, application data"
NSQ_SOURCE_LINE 00000144 "and cache data. It is suggested that desktop applications for e.g. the"
NSQ_SOURCE_LINE 00000145 "GNOME, KDE or Xfce platforms follow this layout. However, the same layout can"
NSQ_SOURCE_LINE 00000146 "just as well be used for non-GUI applications."
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "This module forked from L<File::MimeInfo>."
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "This module follows version 0.6 of BaseDir specification."
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "=head1 CONSTRUCTOR"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "=head2 new"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 " my $bd = File::BaseDir->new;"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "Simple constructor to allow calling functions as object oriented methods."
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "None of these are exported by default, but all functions can be exported"
NSQ_SOURCE_LINE 00000163 "by request.  Also the groups C<:lookup> and C<:vars> are defined.  The"
NSQ_SOURCE_LINE 00000164 "C<:vars> group contains all the routines with a C<xdg_> prefix. The"
NSQ_SOURCE_LINE 00000165 "C<:lookup> group contains the routines to locate files and directories."
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "=head2 data_home"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 " my $path = data_home(@path);"
NSQ_SOURCE_LINE 00000170 " my $path = $bd->data_home(@path);"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "Takes a list of file path elements and returns a new path by appending"
NSQ_SOURCE_LINE 00000173 "them to the data home directory. The new path does not need to exist."
NSQ_SOURCE_LINE 00000174 "Use this when writing user specific application data."
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "Example:"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 " # data_home is: /home/USER/.local/share"
NSQ_SOURCE_LINE 00000179 " $path = $bd->data_home('Foo', 'Bar', 'Baz');"
NSQ_SOURCE_LINE 00000180 " # returns: /home/USER/.local/share/Foo/Bar/Baz"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "=head2 data_dirs"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 " # :lookup"
NSQ_SOURCE_LINE 00000185 " my $dir = data_dirs(@path);"
NSQ_SOURCE_LINE 00000186 " my $dir = $bd->data_dirs(@path);"
NSQ_SOURCE_LINE 00000187 " my @dirs = data_dirs(@path);"
NSQ_SOURCE_LINE 00000188 " my @dirs = $bd->data_dirs(@path);"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "Looks for directories specified by C<@path> in the data home and"
NSQ_SOURCE_LINE 00000191 "other data directories. Returns (possibly empty) list of readable"
NSQ_SOURCE_LINE 00000192 "directories. In scalar context only the first directory found is"
NSQ_SOURCE_LINE 00000193 "returned. Use this to lookup application data."
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "=head2 data_files"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 " # :lookup"
NSQ_SOURCE_LINE 00000198 " my $file = data_files(@path);"
NSQ_SOURCE_LINE 00000199 " my $file = $bd->data_files(@path);"
NSQ_SOURCE_LINE 00000200 " my @files = data_files(@path);"
NSQ_SOURCE_LINE 00000201 " my @files = $bd->data_files(@path);"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "Looks for files specified by C<@path> in the data home and other data"
NSQ_SOURCE_LINE 00000204 "directories. Only returns files that are readable. In scalar context only"
NSQ_SOURCE_LINE 00000205 "the first file found is returned. Use this to lookup application data."
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "=head2 config_home"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 " # :lookup"
NSQ_SOURCE_LINE 00000210 " my $dir = config_home(@path);"
NSQ_SOURCE_LINE 00000211 " my $dir = $bd->config_home(@path);"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "Takes a list of path elements and appends them to the config home"
NSQ_SOURCE_LINE 00000214 "directory returning a new path. The new path does not need to exist."
NSQ_SOURCE_LINE 00000215 "Use this when writing user specific configuration."
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "=head2 config_dirs"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 " # :lookup"
NSQ_SOURCE_LINE 00000220 " my $dir = config_dirs(@path);"
NSQ_SOURCE_LINE 00000221 " my $dir = $bd->config_dirs(@path);"
NSQ_SOURCE_LINE 00000222 " my @dirs = config_dirs(@path);"
NSQ_SOURCE_LINE 00000223 " my @dirs = $bd->config_dirs(@path);"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "Looks for directories specified by C<@path> in the config home and"
NSQ_SOURCE_LINE 00000226 "other config directories. Returns (possibly empty) list of readable"
NSQ_SOURCE_LINE 00000227 "directories. In scalar context only the first directory found is"
NSQ_SOURCE_LINE 00000228 "returned. Use this to lookup configuration."
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "=head2 config_files"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 " # :lookup"
NSQ_SOURCE_LINE 00000233 " my $file = config_files(@path);"
NSQ_SOURCE_LINE 00000234 " my $file = $bd->config_files(@path);"
NSQ_SOURCE_LINE 00000235 " my @files = config_files(@path);"
NSQ_SOURCE_LINE 00000236 " my @files = $bd->config_files(@path);"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "Looks for files specified by C<@path> in the config home and other"
NSQ_SOURCE_LINE 00000239 "config directories. Returns a (possibly empty) list of files that"
NSQ_SOURCE_LINE 00000240 "are readable. In scalar context only the first file found is returned."
NSQ_SOURCE_LINE 00000241 "Use this to lookup configuration."
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "=head2 cache_home"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 " # :lookup"
NSQ_SOURCE_LINE 00000246 " my $dir = cache_home(@path);"
NSQ_SOURCE_LINE 00000247 " my $dir = $bd->cache_home(@path);"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "Takes a list of path elements and appends them to the cache home"
NSQ_SOURCE_LINE 00000250 "directory returning a new path. The new path does not need to exist."
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "=head2 xdg_data_home"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 " # :var"
NSQ_SOURCE_LINE 00000255 " my $dir = xdg_data_home;"
NSQ_SOURCE_LINE 00000256 " my $dir = $bd->xdg_data_home;"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "Returns either C<$ENV{XDG_DATA_HOME}> or it's default value."
NSQ_SOURCE_LINE 00000259 "Default is F<$HOME/.local/share>."
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "=head2 xdg_data_dirs"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 " # :var"
NSQ_SOURCE_LINE 00000264 " my @dirs = xdg_data_dirs;"
NSQ_SOURCE_LINE 00000265 " my @dirs = $bd->xdg_data_dirs;"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "Returns either C<$ENV{XDG_DATA_DIRS}> or it's default value as list."
NSQ_SOURCE_LINE 00000268 "Default is F</usr/local/share>, F</usr/share>."
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "=head2 xdg_config_home"
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 " # :var"
NSQ_SOURCE_LINE 00000273 " my $dir = xdg_config_home;"
NSQ_SOURCE_LINE 00000274 " my $dir = $bd->xdg_config_home;"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "Returns either C<$ENV{XDG_CONFIG_HOME}> or it's default value."
NSQ_SOURCE_LINE 00000277 "Default is F<$HOME/.config>."
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "=head2 xdg_config_dirs"
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 " # :var"
NSQ_SOURCE_LINE 00000282 " my @dirs = xdg_config_dirs;"
NSQ_SOURCE_LINE 00000283 " my @dirs = $bd->xdg_config_dirs;"
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "Returns either C<$ENV{XDG_CONFIG_DIRS}> or it's default value as list."
NSQ_SOURCE_LINE 00000286 "Default is F</etc/xdg>."
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "=head2 xdg_cache_home"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 " # :var"
NSQ_SOURCE_LINE 00000291 " my $dir = xdg_cache_home;"
NSQ_SOURCE_LINE 00000292 " my $dir = $bd->xdg_cache_home;"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "Returns either C<$ENV{XDG_CACHE_HOME}> or it's default value."
NSQ_SOURCE_LINE 00000295 "Default is F<$HOME/.cache>."
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "=head1 NON-UNIX PLATFORMS"
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "The use of L<File::Spec> ensures that all paths are returned in their native"
NSQ_SOURCE_LINE 00000300 "formats regardless of platform.  On Windows this module will use the native"
NSQ_SOURCE_LINE 00000301 "environment variables, rather than the default on UNIX (which is traditionally"
NSQ_SOURCE_LINE 00000302 "C<$HOME>)."
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "Please note that the specification is targeting Unix platforms only and"
NSQ_SOURCE_LINE 00000305 "will only have limited relevance on other platforms. Any platform dependent"
NSQ_SOURCE_LINE 00000306 "behavior in this module should be considered an extension of the spec."
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "=head1 BACKWARDS COMPATIBILITY"
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "The methods C<xdg_data_files()> and C<xdg_config_files()> are exported for"
NSQ_SOURCE_LINE 00000311 "backwards compatibility with version 0.02. They are identical to C<data_files()>"
NSQ_SOURCE_LINE 00000312 "and C<config_files()> respectively but without the C<wantarray> behavior."
NSQ_SOURCE_LINE 00000313 ""
