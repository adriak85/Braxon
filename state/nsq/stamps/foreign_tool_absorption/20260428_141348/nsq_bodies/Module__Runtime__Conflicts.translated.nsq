NSQ_SOURCE_LINE 00000001 "use strict;"
NSQ_SOURCE_LINE 00000002 "use warnings;"
NSQ_SOURCE_LINE 00000003 "package Module::Runtime::Conflicts; # git description: v0.002-9-gc4cd9f2"
NSQ_SOURCE_LINE 00000004 "# vim: set ts=8 sts=4 sw=4 tw=115 et :"
NSQ_SOURCE_LINE 00000005 "# ABSTRACT: Provide information on conflicts for Module::Runtime"
NSQ_SOURCE_LINE 00000006 "# KEYWORDS: conflicts breaks modules prerequisites upgrade"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "our $VERSION = '0.003';"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use Module::Runtime ();"
NSQ_SOURCE_LINE 00000011 "use Dist::CheckConflicts"
NSQ_SOURCE_LINE 00000012 "    -dist      => 'Module::Runtime',"
NSQ_SOURCE_LINE 00000013 "    -conflicts => {"
NSQ_SOURCE_LINE 00000014 "        # listed modules are the highest *non-working* version when used in"
NSQ_SOURCE_LINE 00000015 "        # combination with the indicated version of Module::Runtime"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "        eval { Module::Runtime->VERSION('0.014'); 1 } ? ("
NSQ_SOURCE_LINE 00000018 "            'Moose' => '2.1202',"
NSQ_SOURCE_LINE 00000019 "            'MooseX::NonMoose' => '0.24',"
NSQ_SOURCE_LINE 00000020 "            'Elasticsearch' => '1.00',"
NSQ_SOURCE_LINE 00000021 "        ) : (),"
NSQ_SOURCE_LINE 00000022 "    },"
NSQ_SOURCE_LINE 00000023 "    -also => ["
NSQ_SOURCE_LINE 00000024 "        'Package::Stash::Conflicts',"
NSQ_SOURCE_LINE 00000025 "        'Moose::Conflicts',"
NSQ_SOURCE_LINE 00000026 "    ];"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "1;"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "__END__"
NSQ_SOURCE_LINE 00000031 ""
