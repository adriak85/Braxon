NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "This module provides conflicts checking for L<Module::Runtime>, which had a"
NSQ_SOURCE_LINE 00000056 "recent release that broke some versions of L<Moose>. It is called from"
NSQ_SOURCE_LINE 00000057 "L<Moose::Conflicts> and C<moose-outdated>."
