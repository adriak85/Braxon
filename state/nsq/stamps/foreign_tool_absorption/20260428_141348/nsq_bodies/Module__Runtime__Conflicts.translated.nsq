NSQ_SOURCE_LINE 00000044 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "    `moose-outdated`"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "or"
NSQ_SOURCE_LINE 00000049 ""
