BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package HTTP::MultiPartParser;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use warnings;"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "BEGIN {"
NSQ_SOURCE_LINE 00000006 "    our $VERSION = '0.02';"
NSQ_SOURCE_LINE 00000007 "}"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "use Carp         qw[];"
NSQ_SOURCE_LINE 00000010 "use Scalar::Util qw[];"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "my $_mk_parser;"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "# RFC2046"
NSQ_SOURCE_LINE 00000015 "my $ValidBoundary = qr<\\A [0-9A-Za-z'()+_,-./:=?]+ \\z>x;"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "sub new {"
NSQ_SOURCE_LINE 00000018 "    my ($class, %params) = @_;"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "    my $self = {"
NSQ_SOURCE_LINE 00000021 "        on_error          => \\&Carp::croak,"
NSQ_SOURCE_LINE 00000022 "        max_header_size   => 32 * 1024,"
NSQ_SOURCE_LINE 00000023 "        max_preamble_size => 32 * 1024,"
NSQ_SOURCE_LINE 00000024 "        on_header_as      => 'lines',"
NSQ_SOURCE_LINE 00000025 "    };"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "    while (my ($p, $v) = each %params) {"
NSQ_SOURCE_LINE 00000028 "        if ($p eq 'boundary') {"
NSQ_SOURCE_LINE 00000029 "            Carp::croak(q/Parameter 'boundary' is not a valid boundary value/)"
NSQ_SOURCE_LINE 00000030 "              unless ref \\$v eq 'SCALAR' && defined $v && $v =~ $ValidBoundary;"
NSQ_SOURCE_LINE 00000031 "            $self->{boundary} = $v;"
NSQ_SOURCE_LINE 00000032 "        }"
NSQ_SOURCE_LINE 00000033 "        elsif (   $p eq 'on_header'"
NSQ_SOURCE_LINE 00000034 "               || $p eq 'on_body'"
NSQ_SOURCE_LINE 00000035 "               || $p eq 'on_error') {"
NSQ_SOURCE_LINE 00000036 "            Carp::croak(qq/Parameter '$p' is not a CODE reference/)"
NSQ_SOURCE_LINE 00000037 "              unless ref $v eq 'CODE';"
NSQ_SOURCE_LINE 00000038 "            $self->{$p} = $v;"
NSQ_SOURCE_LINE 00000039 "        }"
NSQ_SOURCE_LINE 00000040 "        elsif (   $p eq 'max_header_size'"
NSQ_SOURCE_LINE 00000041 "               || $p eq 'max_preamble_size') {"
NSQ_SOURCE_LINE 00000042 "            Carp::croak(qq/Parameter '$p' is not a positive integer/)"
NSQ_SOURCE_LINE 00000043 "              unless ref \\$v eq 'SCALAR' && defined $v && $v =~ /\\A [1-9][0-9]* \\z/x;"
NSQ_SOURCE_LINE 00000044 "            $self->{$p} = $v;"
NSQ_SOURCE_LINE 00000045 "        }"
NSQ_SOURCE_LINE 00000046 "        elsif ($p eq 'on_header_as') {"
NSQ_SOURCE_LINE 00000047 "            Carp::croak(q/Parameter 'on_header_as' must be either 'unparsed' or 'lines'/)"
NSQ_SOURCE_LINE 00000048 "              unless ref \\$v eq 'SCALAR' && defined $v && $v =~ /\\A (?: unparsed | lines) \\z/x;"
NSQ_SOURCE_LINE 00000049 "            $self->{on_header_as} = $v;"
NSQ_SOURCE_LINE 00000050 "        }"
NSQ_SOURCE_LINE 00000051 "        else {"
NSQ_SOURCE_LINE 00000052 "            Carp::croak(qq/Unknown parameter '$p' passed to constructor/);"
NSQ_SOURCE_LINE 00000053 "        }"
NSQ_SOURCE_LINE 00000054 "    }"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "    for my $p (qw(boundary on_header on_body)) {"
NSQ_SOURCE_LINE 00000057 "        Carp::croak(qq/Mandatory parameter '$p' is missing/)"
NSQ_SOURCE_LINE 00000058 "          unless exists $self->{$p};"
NSQ_SOURCE_LINE 00000059 "    }"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "    bless $self, $class;"
NSQ_SOURCE_LINE 00000062 "    $self->{parser} = $_mk_parser->($self);"
NSQ_SOURCE_LINE 00000063 "    return $self;"
NSQ_SOURCE_LINE 00000064 "}"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "sub parse {"
NSQ_SOURCE_LINE 00000067 "    @_ == 2 || Carp::croak(q/Usage: $parser->parse($octets)/);"
NSQ_SOURCE_LINE 00000068 "    return $_[0]->{parser}->($_[1]);"
NSQ_SOURCE_LINE 00000069 "}"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "sub finish {"
NSQ_SOURCE_LINE 00000072 "    @_ == 1 || Carp::croak(q/Usage: $parser->finish()/);"
NSQ_SOURCE_LINE 00000073 "    return $_[0]->{parser}->('', 1);"
NSQ_SOURCE_LINE 00000074 "}"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "sub reset {"
NSQ_SOURCE_LINE 00000077 "    @_ == 1 || Carp::croak(q/Usage: $parser->reset()/);"
NSQ_SOURCE_LINE 00000078 "    $_[0]->{parser}  = $_mk_parser->($_[0]);"
NSQ_SOURCE_LINE 00000079 "    $_[0]->{aborted} = !!0;"
NSQ_SOURCE_LINE 00000080 "}"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "sub is_aborted {"
NSQ_SOURCE_LINE 00000083 "    @_ == 1 || Carp::croak(q/Usage: $parser->is_aborted()/);"
NSQ_SOURCE_LINE 00000084 "    return $_[0]->{aborted};"
NSQ_SOURCE_LINE 00000085 "}"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "sub CRLF  () { \"\\x0D\\x0A\" }"
NSQ_SOURCE_LINE 00000088 "sub TRUE  () { !!1 }"
NSQ_SOURCE_LINE 00000089 "sub FALSE () { !!0 }"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "sub STATE_PREAMBLE () { 1 }"
NSQ_SOURCE_LINE 00000092 "sub STATE_BOUNDARY () { 2 }"
NSQ_SOURCE_LINE 00000093 "sub STATE_HEADER   () { 3 }"
NSQ_SOURCE_LINE 00000094 "sub STATE_BODY     () { 4 }"
NSQ_SOURCE_LINE 00000095 "sub STATE_EPILOGUE () { 5 }"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "$_mk_parser = sub {"
NSQ_SOURCE_LINE 00000098 "    Scalar::Util::weaken(my $self = $_[0]);"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "    # RFC 2616 3.7.2 Multipart Types"
NSQ_SOURCE_LINE 00000101 "    # The message body is itself a protocol element and MUST therefore use only"
NSQ_SOURCE_LINE 00000102 "    # CRLF to represent line breaks between body-parts."
NSQ_SOURCE_LINE 00000103 "    my $boundary           = $self->{boundary};"
NSQ_SOURCE_LINE 00000104 "    my $boundary_preamble  =        '--' . $boundary;"
NSQ_SOURCE_LINE 00000105 "    my $boundary_delimiter = CRLF . '--' . $boundary;"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "    my $chunk   = '';"
NSQ_SOURCE_LINE 00000108 "    my $buffer  = '';"
NSQ_SOURCE_LINE 00000109 "    my $state   = STATE_PREAMBLE;"
NSQ_SOURCE_LINE 00000110 "    my $finish  = FALSE;"
NSQ_SOURCE_LINE 00000111 "    my $aborted = FALSE;"
NSQ_SOURCE_LINE 00000112 "    "
NSQ_SOURCE_LINE 00000113 "    my $on_header = $self->{on_header};"
NSQ_SOURCE_LINE 00000114 "    my $on_body   = $self->{on_body};"
NSQ_SOURCE_LINE 00000115 "    my $on_error  = sub {"
NSQ_SOURCE_LINE 00000116 "        $aborted = $self->{aborted} = TRUE;"
NSQ_SOURCE_LINE 00000117 "        goto $self->{on_error};"
NSQ_SOURCE_LINE 00000118 "    };"
NSQ_SOURCE_LINE 00000119 "    "
NSQ_SOURCE_LINE 00000120 "    if ($self->{on_header_as} eq 'lines') {"
NSQ_SOURCE_LINE 00000121 "        $on_header = sub {"
NSQ_SOURCE_LINE 00000122 "            my @headers;"
NSQ_SOURCE_LINE 00000123 "            for (split /\\x0D\\x0A/, $_[0]) {"
NSQ_SOURCE_LINE 00000124 "                if (/\\A [^\\x00-\\x1F\\x7F:]+ : /x) {"
NSQ_SOURCE_LINE 00000125 "                    push @headers, $_;"
NSQ_SOURCE_LINE 00000126 "                }"
NSQ_SOURCE_LINE 00000127 "                elsif (s/\\A [\\x09\\x20]+ //x) {"
NSQ_SOURCE_LINE 00000128 "                    if (!@headers) {"
NSQ_SOURCE_LINE 00000129 "                        $on_error->(q/Continuation line seen before first header/);"
NSQ_SOURCE_LINE 00000130 "                        return;"
NSQ_SOURCE_LINE 00000131 "                    }"
NSQ_SOURCE_LINE 00000132 "                    next unless length;"
NSQ_SOURCE_LINE 00000133 "                    $headers[-1] .= ' ' unless $headers[-1] =~ /[\\x09\\x20]\\z/;"
NSQ_SOURCE_LINE 00000134 "                    $headers[-1] .= $_;"
NSQ_SOURCE_LINE 00000135 "                }"
NSQ_SOURCE_LINE 00000136 "                else {"
NSQ_SOURCE_LINE 00000137 "                    $on_error->(q/Malformed header line/);"
NSQ_SOURCE_LINE 00000138 "                    return;"
NSQ_SOURCE_LINE 00000139 "                }"
NSQ_SOURCE_LINE 00000140 "            }"
NSQ_SOURCE_LINE 00000141 "            $self->{on_header}->(\\@headers);"
NSQ_SOURCE_LINE 00000142 "        };"
NSQ_SOURCE_LINE 00000143 "    }"
NSQ_SOURCE_LINE 00000144 "    "
NSQ_SOURCE_LINE 00000145 "    return sub {"
NSQ_SOURCE_LINE 00000146 "        $buffer .= $_[0];"
NSQ_SOURCE_LINE 00000147 "        $finish  = $_[1];"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "        while (!$aborted) {"
NSQ_SOURCE_LINE 00000150 "            if ($state == STATE_PREAMBLE) {"
NSQ_SOURCE_LINE 00000151 "                my $pos = index($buffer, $boundary_preamble);"
NSQ_SOURCE_LINE 00000152 "                if ($pos < 0) {"
NSQ_SOURCE_LINE 00000153 "                    if (length $buffer > $self->{max_preamble_size}) {"
NSQ_SOURCE_LINE 00000154 "                        $on_error->(q/Size of preamble exceeds maximum allowed/);"
NSQ_SOURCE_LINE 00000155 "                        last;"
NSQ_SOURCE_LINE 00000156 "                    }"
NSQ_SOURCE_LINE 00000157 "                    $finish && $on_error->(q/End of stream encountered while parsing preamble/);"
NSQ_SOURCE_LINE 00000158 "                    last;"
NSQ_SOURCE_LINE 00000159 "                }"
NSQ_SOURCE_LINE 00000160 "                substr($buffer, 0, $pos + 2 + length $boundary, '');"
NSQ_SOURCE_LINE 00000161 "                $state = STATE_BOUNDARY;"
NSQ_SOURCE_LINE 00000162 "            }"
NSQ_SOURCE_LINE 00000163 "            elsif ($state == STATE_BOUNDARY) {"
NSQ_SOURCE_LINE 00000164 "                if (length $buffer < 2) {"
NSQ_SOURCE_LINE 00000165 "                    $finish && $on_error->(q/End of stream encountered while parsing boundary/);"
NSQ_SOURCE_LINE 00000166 "                    last;"
NSQ_SOURCE_LINE 00000167 "                }"
NSQ_SOURCE_LINE 00000168 "                elsif (substr($buffer, 0, 2) eq CRLF) {"
NSQ_SOURCE_LINE 00000169 "                    substr($buffer, 0, 2, '');"
NSQ_SOURCE_LINE 00000170 "                    $state = STATE_HEADER;"
NSQ_SOURCE_LINE 00000171 "                }"
NSQ_SOURCE_LINE 00000172 "                elsif (substr($buffer, 0, 2) eq '--') {"
NSQ_SOURCE_LINE 00000173 "                    if (length $buffer < 4) {"
NSQ_SOURCE_LINE 00000174 "                        $finish && $on_error->(q/End of stream encountered while parsing closing boundary/);"
NSQ_SOURCE_LINE 00000175 "                        last;"
NSQ_SOURCE_LINE 00000176 "                    }"
NSQ_SOURCE_LINE 00000177 "                    elsif (substr($buffer, 2, 2) eq CRLF) {"
NSQ_SOURCE_LINE 00000178 "                        substr($buffer, 0, 4, '');"
NSQ_SOURCE_LINE 00000179 "                        $state = STATE_EPILOGUE;"
NSQ_SOURCE_LINE 00000180 "                    }"
NSQ_SOURCE_LINE 00000181 "                    else {"
NSQ_SOURCE_LINE 00000182 "                        $on_error->(q/Closing boundary does not terminate with CRLF/);"
NSQ_SOURCE_LINE 00000183 "                        last;"
NSQ_SOURCE_LINE 00000184 "                    }"
NSQ_SOURCE_LINE 00000185 "                }"
NSQ_SOURCE_LINE 00000186 "                else {"
NSQ_SOURCE_LINE 00000187 "                    $on_error->(q/Boundary does not terminate with CRLF or hyphens/);"
NSQ_SOURCE_LINE 00000188 "                    last;"
NSQ_SOURCE_LINE 00000189 "                }"
NSQ_SOURCE_LINE 00000190 "            }"
NSQ_SOURCE_LINE 00000191 "            elsif ($state == STATE_HEADER) {"
NSQ_SOURCE_LINE 00000192 "                my $pos = index($buffer, CRLF . CRLF);"
NSQ_SOURCE_LINE 00000193 "                if ($pos < 0) {"
NSQ_SOURCE_LINE 00000194 "                    if (length $buffer > $self->{max_header_size}) {"
NSQ_SOURCE_LINE 00000195 "                        $on_error->(q/Size of part header exceeds maximum allowed/);"
NSQ_SOURCE_LINE 00000196 "                        last;"
NSQ_SOURCE_LINE 00000197 "                    }"
NSQ_SOURCE_LINE 00000198 "                    $finish && $on_error->(q/End of stream encountered while parsing part header/);"
NSQ_SOURCE_LINE 00000199 "                    last;"
NSQ_SOURCE_LINE 00000200 "                }"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "                $chunk = substr($buffer, 0, $pos + 4, '');"
NSQ_SOURCE_LINE 00000203 "                $state = STATE_BODY;"
NSQ_SOURCE_LINE 00000204 "                $on_header->($chunk);"
NSQ_SOURCE_LINE 00000205 "            }"
NSQ_SOURCE_LINE 00000206 "            elsif ($state == STATE_BODY) {"
NSQ_SOURCE_LINE 00000207 "                my $take = index($buffer, $boundary_delimiter);"
NSQ_SOURCE_LINE 00000208 "                if ($take < 0) {"
NSQ_SOURCE_LINE 00000209 "                    $take = length($buffer) - (6 + length $boundary);"
NSQ_SOURCE_LINE 00000210 "                    if ($take <= 0) {"
NSQ_SOURCE_LINE 00000211 "                        $finish && $on_error->(q/End of stream encountered while parsing part body/);"
NSQ_SOURCE_LINE 00000212 "                        last;"
NSQ_SOURCE_LINE 00000213 "                    }"
NSQ_SOURCE_LINE 00000214 "                }"
NSQ_SOURCE_LINE 00000215 "                else {"
NSQ_SOURCE_LINE 00000216 "                    $state = STATE_BOUNDARY;"
NSQ_SOURCE_LINE 00000217 "                }"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "                $chunk = substr($buffer, 0, $take, '');"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "                if ($state == STATE_BOUNDARY) {"
NSQ_SOURCE_LINE 00000222 "                    substr($buffer, 0, 4 + length $boundary, '');"
NSQ_SOURCE_LINE 00000223 "                }"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "                $on_body->($chunk, $state == STATE_BOUNDARY);"
NSQ_SOURCE_LINE 00000226 "            }"
NSQ_SOURCE_LINE 00000227 "            # RFC 2616 3.7.2 Multipart Types"
NSQ_SOURCE_LINE 00000228 "            # Unlike in RFC 2046, the epilogue of any multipart message MUST be"
NSQ_SOURCE_LINE 00000229 "            # empty; HTTP applications MUST NOT transmit the epilogue (even if the"
NSQ_SOURCE_LINE 00000230 "            # original multipart contains an epilogue). These restrictions exist in"
NSQ_SOURCE_LINE 00000231 "            # order to preserve the self-delimiting nature of a multipart message-"
NSQ_SOURCE_LINE 00000232 "            # body, wherein the \"end\" of the message-body is indicated by the"
NSQ_SOURCE_LINE 00000233 "            # ending multipart boundary."
NSQ_SOURCE_LINE 00000234 "            elsif ($state == STATE_EPILOGUE) {"
NSQ_SOURCE_LINE 00000235 "                (length $buffer == 0)"
NSQ_SOURCE_LINE 00000236 "                  || $on_error->(q/Nonempty epilogue/);"
NSQ_SOURCE_LINE 00000237 "                last;"
NSQ_SOURCE_LINE 00000238 "            }"
NSQ_SOURCE_LINE 00000239 "            else {"
NSQ_SOURCE_LINE 00000240 "                Carp::croak(qq/panic: unknown state: $state/);"
NSQ_SOURCE_LINE 00000241 "            }"
NSQ_SOURCE_LINE 00000242 "        }"
NSQ_SOURCE_LINE 00000243 "        return !$aborted;"
NSQ_SOURCE_LINE 00000244 "    };"
NSQ_SOURCE_LINE 00000245 "};"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "1;"
BODY_END
