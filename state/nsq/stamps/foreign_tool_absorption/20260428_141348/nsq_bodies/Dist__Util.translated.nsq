NSQ_SOURCE_LINE 00000001 "package Dist::Util;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use Config;"
NSQ_SOURCE_LINE 00000007 "use Exporter 'import';"
NSQ_SOURCE_LINE 00000008 "use File::Spec;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000011 "our $DATE = '2022-08-21'; # DATE"
NSQ_SOURCE_LINE 00000012 "our $DIST = 'Dist-Util'; # DIST"
NSQ_SOURCE_LINE 00000013 "our $VERSION = '0.071'; # VERSION"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "our @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000016 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000017 "                       list_dist_modules"
NSQ_SOURCE_LINE 00000018 "                       list_dists"
NSQ_SOURCE_LINE 00000019 "                       packlist_for"
NSQ_SOURCE_LINE 00000020 "               );"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "sub packlist_for {"
NSQ_SOURCE_LINE 00000023 "    my $mod = shift;"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "    unless ($mod =~ s/\\.pm\\z//) {"
NSQ_SOURCE_LINE 00000026 "        $mod =~ s!::!/!g;"
NSQ_SOURCE_LINE 00000027 "    }"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "    for (@INC) {"
NSQ_SOURCE_LINE 00000030 "        next if ref($_);"
NSQ_SOURCE_LINE 00000031 "        my $f = \"$_/$Config{archname}/auto/$mod/.packlist\";"
NSQ_SOURCE_LINE 00000032 "        return $f if -f $f;"
NSQ_SOURCE_LINE 00000033 "    }"
NSQ_SOURCE_LINE 00000034 "    undef;"
NSQ_SOURCE_LINE 00000035 "}"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "sub list_dists {"
NSQ_SOURCE_LINE 00000038 "    require File::Find;"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "    my %args = @_;"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "    my %dists;"
NSQ_SOURCE_LINE 00000043 "    for my $inc (@INC) {"
NSQ_SOURCE_LINE 00000044 "        next if ref($inc);"
NSQ_SOURCE_LINE 00000045 "        my $prefix = \"$inc/$Config{archname}/auto\";"
NSQ_SOURCE_LINE 00000046 "        next unless -d $prefix;"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "        File::Find::find("
NSQ_SOURCE_LINE 00000049 "            sub {"
NSQ_SOURCE_LINE 00000050 "                return unless $_ eq '.packlist';"
NSQ_SOURCE_LINE 00000051 "                my $dist = substr($File::Find::dir, length($prefix)+1);"
NSQ_SOURCE_LINE 00000052 "                # XXX use platform-neutral path separator"
NSQ_SOURCE_LINE 00000053 "                $dist =~ s!/!-!g;"
NSQ_SOURCE_LINE 00000054 "                $dists{$dist} = {dist=>$dist, packlist => \"$File::Find::dir/$_\"};"
NSQ_SOURCE_LINE 00000055 "            },"
NSQ_SOURCE_LINE 00000056 "            $prefix,"
NSQ_SOURCE_LINE 00000057 "        );"
NSQ_SOURCE_LINE 00000058 "    }"
NSQ_SOURCE_LINE 00000059 "    if ($args{detail}) {"
NSQ_SOURCE_LINE 00000060 "        return values %dists;"
NSQ_SOURCE_LINE 00000061 "    } else {"
NSQ_SOURCE_LINE 00000062 "        return (sort keys %dists);"
NSQ_SOURCE_LINE 00000063 "    }"
NSQ_SOURCE_LINE 00000064 "}"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "sub list_dist_modules {"
NSQ_SOURCE_LINE 00000067 "    my $mod = shift;"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "    # convenience: convert Foo-Bar to Foo::Bar"
NSQ_SOURCE_LINE 00000070 "    $mod =~ s/-/::/g;"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "    my $packlist = packlist_for($mod);"
NSQ_SOURCE_LINE 00000073 "    return () unless $packlist;"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "    # path structure for .packlist: <libprefix> + <arch> + \"auto\" +"
NSQ_SOURCE_LINE 00000076 "    # /Module/Name/ + \"/.packlist\". we want to get <libprefix>"
NSQ_SOURCE_LINE 00000077 "    my $libprefix;"
NSQ_SOURCE_LINE 00000078 "    {"
NSQ_SOURCE_LINE 00000079 "        my ($vol, $dirs, $name) = File::Spec->splitpath("
NSQ_SOURCE_LINE 00000080 "            File::Spec->rel2abs($packlist));"
NSQ_SOURCE_LINE 00000081 "        my @dirs = File::Spec->splitdir($dirs);"
NSQ_SOURCE_LINE 00000082 "        for (0..@dirs-2) {"
NSQ_SOURCE_LINE 00000083 "            if ($dirs[$_] eq $Config{archname} && $dirs[$_+1] eq 'auto') {"
NSQ_SOURCE_LINE 00000084 "                $libprefix = File::Spec->catpath("
NSQ_SOURCE_LINE 00000085 "                    $vol, File::Spec->catdir(@dirs[0..$_-1]));"
NSQ_SOURCE_LINE 00000086 "                last;"
NSQ_SOURCE_LINE 00000087 "            }"
NSQ_SOURCE_LINE 00000088 "        }"
NSQ_SOURCE_LINE 00000089 "        die \"Can't find libprefix for packlist $packlist\" unless $libprefix;"
NSQ_SOURCE_LINE 00000090 "    }"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "    open my($fh), \"<\", $packlist or return ();"
NSQ_SOURCE_LINE 00000093 "    my @mods;"
NSQ_SOURCE_LINE 00000094 "    while (my $l = <$fh>) {"
NSQ_SOURCE_LINE 00000095 "        chomp $l;"
NSQ_SOURCE_LINE 00000096 "        next unless $l =~ /\\.pm\\z/;"
NSQ_SOURCE_LINE 00000097 "        $l =~ s/\\A\\Q$libprefix\\E// or next;"
NSQ_SOURCE_LINE 00000098 "        my @dirs = File::Spec->splitdir($l);"
NSQ_SOURCE_LINE 00000099 "        shift @dirs; # \"\""
NSQ_SOURCE_LINE 00000100 "        shift @dirs if $dirs[0] eq $Config{archname};"
NSQ_SOURCE_LINE 00000101 "        $dirs[-1] =~ s/\\.pm\\z//;"
NSQ_SOURCE_LINE 00000102 "        push @mods, join(\"::\", @dirs);"
NSQ_SOURCE_LINE 00000103 "    }"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "    @mods;"
NSQ_SOURCE_LINE 00000106 "}"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "1;"
NSQ_SOURCE_LINE 00000109 "# ABSTRACT: Dist-related utilities"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "__END__"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "=pod"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "=head1 NAME"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "Dist::Util - Dist-related utilities"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "=head1 VERSION"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "This document describes version 0.071 of Dist::Util (from Perl distribution Dist-Util), released on 2022-08-21."
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 " use Dist::Util qw("
NSQ_SOURCE_LINE 00000128 "     list_dist_modules"
NSQ_SOURCE_LINE 00000129 "     list_dists"
NSQ_SOURCE_LINE 00000130 "     packlist_for"
NSQ_SOURCE_LINE 00000131 " );"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 " say packlist_for(\"Text::ANSITable\"); # sample output: /home/steven/perl5/perlbrew/perls/perl-5.18.2/lib/site_perl/5.18.2/x86_64-linux/auto/Text/ANSITable/.packlist"
NSQ_SOURCE_LINE 00000134 " my @mods = list_dist_modules(\"Text::ANSITable\"); # -> (\"Text::ANSITable\", \"Text::ANSITable::BorderStyle::Default\", \"Text::ANSITable::ColorTheme::Default\")"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "=head2 packlist_for($mod) => STR"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "Find C<.packlist> file for installed module C<$mod> (which can be in the form of"
NSQ_SOURCE_LINE 00000143 "C<Package::SubPkg> or C<Package/SubPkg.pm>). Return undef if none is found."
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "Depending on the content of C<@INC>, the returned path may be absolute or"
NSQ_SOURCE_LINE 00000146 "relative."
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "Caveat: many Linux distributions strip C<.packlist> files."
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "=head2 list_dists"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "Usage:"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 " list_dists(%opts) => LIST"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "Find all C<.packlist> files in C<@INC> and then pick the dist names from the"
NSQ_SOURCE_LINE 00000157 "paths, because C<.packlist> files are put in:"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 " $INC/$Config{archname}/auto/Foo/Bar/.packlist"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "Caveat: many Linux distributions strip C<.packlist> files."
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "TODO: Instead of via L<.packlist>, also try querying the OS package manager."
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "Known options:"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "=over"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "=item * detail"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "Bool. If set to true, instead of a list of distribution names, the function will"
NSQ_SOURCE_LINE 00000172 "return a list of hashrefs containing detailed information e.g.:"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 " ("
NSQ_SOURCE_LINE 00000175 "   {dist=>\"Foo-Bar\", packlist=>\"/home/u1/perl5/perlbrew/perls/perl-5.34.0/lib/site_perl/5.34.0/x86_64-linux/auto/Foo/Bar/.packlist\"},"
NSQ_SOURCE_LINE 00000176 "   ..."
NSQ_SOURCE_LINE 00000177 " )"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "=back"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "=head2 list_dist_modules($mod) => LIST"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "Given installed module name C<$mod> (which must be the name of the main module"
NSQ_SOURCE_LINE 00000184 "of its distribution), list all the modules in the distribution. This is done by"
NSQ_SOURCE_LINE 00000185 "first finding the C<.packlist> file, then look at all the C<.pm> files listed in"
NSQ_SOURCE_LINE 00000186 "the packlist."
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "Will return empty list if fails to get the packlist."
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "Caveat: many Linux distributions strip C<.packlist> files."
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "Please visit the project's homepage at L<https://metacpan.org/release/Dist-Util>."
NSQ_SOURCE_LINE 00000195 ""
