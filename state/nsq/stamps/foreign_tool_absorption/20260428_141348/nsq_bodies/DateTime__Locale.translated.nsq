NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "# These are hard-coded for backwards comaptibility with the DateTime::Language"
NSQ_SOURCE_LINE 00000156 "# code."
NSQ_SOURCE_LINE 00000157 "my %DateTimeLanguageAliases = ("
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "    #    'Afar'      => 'aa',"
NSQ_SOURCE_LINE 00000160 "    'Amharic'   => 'am-ET',"
NSQ_SOURCE_LINE 00000161 "    'Austrian'  => 'de-AT',"
NSQ_SOURCE_LINE 00000162 "    'Brazilian' => 'pt-BR',"
NSQ_SOURCE_LINE 00000163 "    'Czech'     => 'cs-CZ',"
NSQ_SOURCE_LINE 00000164 "    'Danish'    => 'da-DK',"
NSQ_SOURCE_LINE 00000165 "    'Dutch'     => 'nl-NL',"
NSQ_SOURCE_LINE 00000166 "    'English'   => 'en-US',"
NSQ_SOURCE_LINE 00000167 "    'French'    => 'fr-FR',"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "    #      'Gedeo'             => undef, # XXX"
NSQ_SOURCE_LINE 00000170 "    'German'    => 'de-DE',"
NSQ_SOURCE_LINE 00000171 "    'Italian'   => 'it-IT',"
NSQ_SOURCE_LINE 00000172 "    'Norwegian' => 'no-NO',"
NSQ_SOURCE_LINE 00000173 "    'Oromo'     => 'om-ET',    # Maybe om-KE or plain om ?"
NSQ_SOURCE_LINE 00000174 "    'Portugese' => 'pt-PT',"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "    #    'Sidama'            => 'sid',"
NSQ_SOURCE_LINE 00000177 "    'Somali'  => 'so-SO',"
NSQ_SOURCE_LINE 00000178 "    'Spanish' => 'es-ES',"
NSQ_SOURCE_LINE 00000179 "    'Swedish' => 'sv-SE',"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "    #    'Tigre'             => 'tig',"
NSQ_SOURCE_LINE 00000182 "    'TigrinyaEthiopian' => 'ti-ET',"
NSQ_SOURCE_LINE 00000183 "    'TigrinyaEritrean'  => 'ti-ER',"
NSQ_SOURCE_LINE 00000184 ");"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "my %POSIXAliases = ("
NSQ_SOURCE_LINE 00000187 "    C     => 'en-US',"
NSQ_SOURCE_LINE 00000188 "    POSIX => 'en-US',"
NSQ_SOURCE_LINE 00000189 ");"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "{"
NSQ_SOURCE_LINE 00000192 "    my $validator = validation_for("
NSQ_SOURCE_LINE 00000193 "        name             => '_check_load_params',"
NSQ_SOURCE_LINE 00000194 "        name_is_optional => 1,"
NSQ_SOURCE_LINE 00000195 "        params           => ["
NSQ_SOURCE_LINE 00000196 "            { type => t('NonEmptyStr') },"
NSQ_SOURCE_LINE 00000197 "        ],"
NSQ_SOURCE_LINE 00000198 "    );"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "    sub load {"
NSQ_SOURCE_LINE 00000201 "        my $class = shift;"
NSQ_SOURCE_LINE 00000202 "        my ($code) = $validator->(@_);"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "        # We used to use underscores in codes instead of dashes. We want to"
NSQ_SOURCE_LINE 00000205 "        # support both indefinitely."
NSQ_SOURCE_LINE 00000206 "        $code =~ tr/_/-/;"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "        # Strip off charset for LC_* codes : en_GB.UTF-8 etc"
NSQ_SOURCE_LINE 00000209 "        $code =~ s/\\..*$//;"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "        return $LoadCache{$code} if exists $LoadCache{$code};"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "        while ( exists $UserDefinedAlias{$code} ) {"
NSQ_SOURCE_LINE 00000214 "            $code = $UserDefinedAlias{$code};"
NSQ_SOURCE_LINE 00000215 "        }"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "        $code = $DateTimeLanguageAliases{$code}"
NSQ_SOURCE_LINE 00000218 "            if exists $DateTimeLanguageAliases{$code};"
NSQ_SOURCE_LINE 00000219 "        $code = $POSIXAliases{$code} if exists $POSIXAliases{$code};"
NSQ_SOURCE_LINE 00000220 "        $code = $DateTime::Locale::Data::ISO639Aliases{$code}"
NSQ_SOURCE_LINE 00000221 "            if exists $DateTime::Locale::Data::ISO639Aliases{$code};"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "        if ( exists $DateTime::Locale::Data::Codes{$code} ) {"
NSQ_SOURCE_LINE 00000224 "            return $class->_locale_object_for($code);"
NSQ_SOURCE_LINE 00000225 "        }"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "        if ( exists $DateTime::Locale::Data::Names{$code} ) {"
NSQ_SOURCE_LINE 00000228 "            return $class->_locale_object_for("
NSQ_SOURCE_LINE 00000229 "                $DateTime::Locale::Data::Names{$code} );"
NSQ_SOURCE_LINE 00000230 "        }"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "        if ( exists $DateTime::Locale::Data::NativeNames{$code} ) {"
NSQ_SOURCE_LINE 00000233 "            return $class->_locale_object_for("
NSQ_SOURCE_LINE 00000234 "                $DateTime::Locale::Data::NativeNames{$code} );"
NSQ_SOURCE_LINE 00000235 "        }"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "        if ( my $locale = $class->_registered_locale_for($code) ) {"
NSQ_SOURCE_LINE 00000238 "            return $locale;"
NSQ_SOURCE_LINE 00000239 "        }"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "        if ( my $guessed = $class->_guess_code($code) ) {"
NSQ_SOURCE_LINE 00000242 "            return $class->_locale_object_for($guessed);"
NSQ_SOURCE_LINE 00000243 "        }"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "        die \"Invalid locale code or name: $code\\n\";"
NSQ_SOURCE_LINE 00000246 "    }"
NSQ_SOURCE_LINE 00000247 "}"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "sub _guess_code {"
NSQ_SOURCE_LINE 00000250 "    shift;"
NSQ_SOURCE_LINE 00000251 "    my $code = shift;"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "    my %codes = parse_locale_code($code);"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "    my @guesses;"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "    if ( $codes{script} ) {"
NSQ_SOURCE_LINE 00000258 "        my $guess = join q{-}, $codes{language}, $codes{script};"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "        push @guesses, $guess;"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "        $guess .= q{-} . $codes{territory} if defined $codes{territory};"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "        # version with script comes first"
NSQ_SOURCE_LINE 00000265 "        unshift @guesses, $guess;"
NSQ_SOURCE_LINE 00000266 "    }"
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "    if ( $codes{variant} ) {"
NSQ_SOURCE_LINE 00000269 "        push @guesses, join q{-}, $codes{language}, $codes{territory},"
NSQ_SOURCE_LINE 00000270 "            $codes{variant};"
NSQ_SOURCE_LINE 00000271 "    }"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "    if ( $codes{territory} ) {"
NSQ_SOURCE_LINE 00000274 "        push @guesses, join q{-}, $codes{language}, $codes{territory};"
NSQ_SOURCE_LINE 00000275 "    }"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "    push @guesses, $codes{language};"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "    for my $code (@guesses) {"
NSQ_SOURCE_LINE 00000280 "        return $code"
NSQ_SOURCE_LINE 00000281 "            if exists $DateTime::Locale::Data::Codes{$code}"
NSQ_SOURCE_LINE 00000282 "            || exists $DateTime::Locale::Data::Names{$code};"
NSQ_SOURCE_LINE 00000283 "    }"
NSQ_SOURCE_LINE 00000284 "}"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "sub _locale_object_for {"
NSQ_SOURCE_LINE 00000287 "    shift;"
NSQ_SOURCE_LINE 00000288 "    my $code = shift;"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "    my $data = DateTime::Locale::Data::locale_data($code)"
NSQ_SOURCE_LINE 00000291 "        or return;"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "    # We want to make a copy of the data just in case ..."
NSQ_SOURCE_LINE 00000294 "    return $LoadCache{$code} = DateTime::Locale::FromData->new( \\%{$data} );"
NSQ_SOURCE_LINE 00000295 "}"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "sub _registered_locale_for {"
NSQ_SOURCE_LINE 00000298 "    my $class = shift;"
NSQ_SOURCE_LINE 00000299 "    my $code  = shift;"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "    # Custom locale registered by user"
NSQ_SOURCE_LINE 00000302 "    if ( $Class{$code} ) {"
NSQ_SOURCE_LINE 00000303 "        return $LoadCache{$code}"
NSQ_SOURCE_LINE 00000304 "            = $class->_load_class_from_code( $code, $Class{$code} );"
NSQ_SOURCE_LINE 00000305 "    }"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "    if ( $DataForCode{$code} ) {"
NSQ_SOURCE_LINE 00000308 "        return $LoadCache{$code} = $class->_load_class_from_code($code);"
NSQ_SOURCE_LINE 00000309 "    }"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "    if ( $NameToCode{$code} ) {"
NSQ_SOURCE_LINE 00000312 "        return $LoadCache{$code}"
NSQ_SOURCE_LINE 00000313 "            = $class->_load_class_from_code( $NameToCode{$code} );"
NSQ_SOURCE_LINE 00000314 "    }"
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "    if ( $NativeNameToCode{$code} ) {"
NSQ_SOURCE_LINE 00000317 "        return $LoadCache{$code}"
NSQ_SOURCE_LINE 00000318 "            = $class->_load_class_from_code( $NativeNameToCode{$code} );"
NSQ_SOURCE_LINE 00000319 "    }"
NSQ_SOURCE_LINE 00000320 "}"
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "sub _load_class_from_code {"
NSQ_SOURCE_LINE 00000323 "    my $class      = shift;"
NSQ_SOURCE_LINE 00000324 "    my $code       = shift;"
NSQ_SOURCE_LINE 00000325 "    my $real_class = shift;"
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "    # We want the first alias for which there is data, even if it has"
NSQ_SOURCE_LINE 00000328 "    # no corresponding .pm file.  There may be multiple levels of"
NSQ_SOURCE_LINE 00000329 "    # alias to go through."
NSQ_SOURCE_LINE 00000330 "    my $data_code = $code;"
NSQ_SOURCE_LINE 00000331 "    while ( exists $UserDefinedAlias{$data_code}"
NSQ_SOURCE_LINE 00000332 "        && !exists $DataForCode{$data_code} ) {"
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "        $data_code = $UserDefinedAlias{$data_code};"
NSQ_SOURCE_LINE 00000335 "    }"
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "    ( my $underscore_code = $data_code ) =~ s/-/_/g;"
NSQ_SOURCE_LINE 00000338 "    $real_class ||= \"DateTime::Locale::$underscore_code\";"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "    unless ( $real_class->can('new') ) {"
NSQ_SOURCE_LINE 00000341 "        ## no critic (BuiltinFunctions::ProhibitStringyEval, ErrorHandling::RequireCheckingReturnValueOfEval)"
NSQ_SOURCE_LINE 00000342 "        eval \"require $real_class\";"
NSQ_SOURCE_LINE 00000343 "        die $@ if $@;"
NSQ_SOURCE_LINE 00000344 "        ## use critic"
NSQ_SOURCE_LINE 00000345 "    }"
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "    my $locale = $real_class->new("
NSQ_SOURCE_LINE 00000348 "        %{ $DataForCode{$data_code} },"
NSQ_SOURCE_LINE 00000349 "        code => $code,"
NSQ_SOURCE_LINE 00000350 "    );"
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "    if ( $locale->can('cldr_version') ) {"
NSQ_SOURCE_LINE 00000353 "        my $object_version = $locale->cldr_version;"
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 "        if ( $object_version ne $DateTime::Locale::Data::CLDRVersion ) {"
NSQ_SOURCE_LINE 00000356 "            warn"
NSQ_SOURCE_LINE 00000357 "                \"Loaded $real_class, which is from an older version ($object_version)\""
NSQ_SOURCE_LINE 00000358 "                . ' of the CLDR database than this installation of'"
NSQ_SOURCE_LINE 00000359 "                . \" DateTime::Locale ($DateTime::Locale::Data::CLDRVersion).\\n\";"
NSQ_SOURCE_LINE 00000360 "        }"
NSQ_SOURCE_LINE 00000361 "    }"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "    return $locale;"
NSQ_SOURCE_LINE 00000364 "}"
NSQ_SOURCE_LINE 00000365 "## use critic"
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "1;"
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "# ABSTRACT: Localization support for DateTime.pm"
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "__END__"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "=pod"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "=head1 NAME"
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "DateTime::Locale - Localization support for DateTime.pm"
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "=head1 VERSION"
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "version 1.45"
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "  use DateTime::Locale;"
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "  my $loc = DateTime::Locale->load('en-GB');"
NSQ_SOURCE_LINE 00000390 ""
NSQ_SOURCE_LINE 00000391 "  print $loc->native_name, \"\\n\", $loc->datetime_format_long, \"\\n\";"
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "  # but mostly just things like ..."
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "  my $dt = DateTime->now( locale => 'fr' );"
NSQ_SOURCE_LINE 00000396 "  print \"Aujourd'hui le mois est \" . $dt->month_name, \"\\n\";"
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000399 ""
NSQ_SOURCE_LINE 00000400 "DateTime::Locale is primarily a factory for the various locale subclasses. It"
NSQ_SOURCE_LINE 00000401 "also provides some functions for getting information on all the available"
NSQ_SOURCE_LINE 00000402 "locales."
NSQ_SOURCE_LINE 00000403 ""
NSQ_SOURCE_LINE 00000404 "If you want to know what methods are available for locale objects, then please"
NSQ_SOURCE_LINE 00000405 "read the L<DateTime::Locale::FromData> documentation."
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "=head1 USAGE"
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "This module provides the following class methods:"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "=head2 DateTime::Locale->load( $locale_code | $locale_name )"
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "Returns the locale object for the specified locale code or name - see the"
NSQ_SOURCE_LINE 00000414 "L<DateTime::Locale::Catalog> documentation for the list of available codes and"
NSQ_SOURCE_LINE 00000415 "names. The name provided may be either the English or native name."
NSQ_SOURCE_LINE 00000416 ""
NSQ_SOURCE_LINE 00000417 "If the requested locale is not found, a fallback search takes place to find a"
NSQ_SOURCE_LINE 00000418 "suitable replacement."
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "The fallback search order is:"
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "  {language}-{script}-{territory}"
NSQ_SOURCE_LINE 00000423 "  {language}-{script}"
NSQ_SOURCE_LINE 00000424 "  {language}-{territory}-{variant}"
NSQ_SOURCE_LINE 00000425 "  {language}-{territory}"
NSQ_SOURCE_LINE 00000426 "  {language}"
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "Eg. For the locale code C<es-XX-UNKNOWN> the fallback search would be:"
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "  es-XX-UNKNOWN   # Fails - no such locale"
NSQ_SOURCE_LINE 00000431 "  es-XX           # Fails - no such locale"
NSQ_SOURCE_LINE 00000432 "  es              # Found - the es locale is returned as the"
NSQ_SOURCE_LINE 00000433 "                  # closest match to the requested id"
NSQ_SOURCE_LINE 00000434 ""
NSQ_SOURCE_LINE 00000435 "Eg. For the locale code C<es-Latn-XX> the fallback search would be:"
NSQ_SOURCE_LINE 00000436 ""
NSQ_SOURCE_LINE 00000437 "  es-Latn-XX      # Fails - no such locale"
NSQ_SOURCE_LINE 00000438 "  es-Latn         # Fails - no such locale"
NSQ_SOURCE_LINE 00000439 "  es-XX           # Fails - no such locale"
NSQ_SOURCE_LINE 00000440 "  es              # Found - the es locale is returned as the"
NSQ_SOURCE_LINE 00000441 "                  # closest match to the requested id"
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "If no suitable replacement is found, then an exception is thrown."
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "The loaded locale is cached, so that B<locale objects may be singletons>."
NSQ_SOURCE_LINE 00000446 "Calling C<< DateTime::Locale->register_from_data >>, C<<"
NSQ_SOURCE_LINE 00000447 "DateTime::Locale->add_aliases >>, or C<< DateTime::Locale->remove_alias >>"
NSQ_SOURCE_LINE 00000448 "clears the cache."
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "=head2 DateTime::Locale->codes"
NSQ_SOURCE_LINE 00000451 ""
NSQ_SOURCE_LINE 00000452 "  my @codes = DateTime::Locale->codes;"
NSQ_SOURCE_LINE 00000453 "  my $codes = DateTime::Locale->codes;"
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 "Returns an unsorted list of the available locale codes, or an array reference"
NSQ_SOURCE_LINE 00000456 "if called in a scalar context. This list does not include aliases."
NSQ_SOURCE_LINE 00000457 ""
NSQ_SOURCE_LINE 00000458 "=head2 DateTime::Locale->names"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "  my @names = DateTime::Locale->names;"
NSQ_SOURCE_LINE 00000461 "  my $names = DateTime::Locale->names;"
NSQ_SOURCE_LINE 00000462 ""
NSQ_SOURCE_LINE 00000463 "Returns an unsorted list of the available locale names in English, or an array"
NSQ_SOURCE_LINE 00000464 "reference if called in a scalar context."
NSQ_SOURCE_LINE 00000465 ""
NSQ_SOURCE_LINE 00000466 "=head2 DateTime::Locale->native_names"
NSQ_SOURCE_LINE 00000467 ""
NSQ_SOURCE_LINE 00000468 "  my @names = DateTime::Locale->native_names;"
NSQ_SOURCE_LINE 00000469 "  my $names = DateTime::Locale->native_names;"
NSQ_SOURCE_LINE 00000470 ""
NSQ_SOURCE_LINE 00000471 "Returns an unsorted list of the available locale names in their native"
NSQ_SOURCE_LINE 00000472 "language, or an array reference if called in a scalar context. All native names"
NSQ_SOURCE_LINE 00000473 "use UTF-8 as appropriate."
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 "=head2 DateTime::Locale->register_from_data( $locale_data )"
NSQ_SOURCE_LINE 00000476 ""
NSQ_SOURCE_LINE 00000477 "This method allows you to register a custom locale. The data for the locale is"
NSQ_SOURCE_LINE 00000478 "specified as a hash (or hashref) where the keys match the method names given in"
NSQ_SOURCE_LINE 00000479 "L<DateTime::Locale::FromData>."
NSQ_SOURCE_LINE 00000480 ""
NSQ_SOURCE_LINE 00000481 "If you just want to make some small changes on top of an existing locale you"
NSQ_SOURCE_LINE 00000482 "can get that locale's data by calling C<< $locale->locale_data >>."
NSQ_SOURCE_LINE 00000483 ""
NSQ_SOURCE_LINE 00000484 "Here is an example of making a custom locale based off of C<en-US>:"
NSQ_SOURCE_LINE 00000485 ""
NSQ_SOURCE_LINE 00000486 "  my $locale = DateTime::Locale->load('en-US');"
NSQ_SOURCE_LINE 00000487 "  my %data   = $locale->locale_data;"
NSQ_SOURCE_LINE 00000488 "  $data{code}               = 'en-US-CUSTOM';"
NSQ_SOURCE_LINE 00000489 "  $data{time_format_medium} = 'HH:mm:ss';"
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "  DateTime::Locale->register_from_data(%data);"
NSQ_SOURCE_LINE 00000492 ""
NSQ_SOURCE_LINE 00000493 "  # Prints 18:24:38"
NSQ_SOURCE_LINE 00000494 "  say DateTime->now( locale => 'en-US-CUSTOM' )->strftime('%X');"
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "  # Prints 6:24:38 PM"
NSQ_SOURCE_LINE 00000497 "  say DateTime->now( locale => 'en-US' )->strftime('%X');"
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "The keys that should be present in the hash are the same as the accessor"
NSQ_SOURCE_LINE 00000500 "methods provided by L<DateTime::Locale::FromData>, except for the following:"
NSQ_SOURCE_LINE 00000501 ""
NSQ_SOURCE_LINE 00000502 "=over 4"
NSQ_SOURCE_LINE 00000503 ""
NSQ_SOURCE_LINE 00000504 "=item The C<*_code> methods"
NSQ_SOURCE_LINE 00000505 ""
NSQ_SOURCE_LINE 00000506 "While you should provide a C<code> key, the other methods like C<language_code>"
NSQ_SOURCE_LINE 00000507 "and C<script_code> are determined by parsing the code."
NSQ_SOURCE_LINE 00000508 ""
NSQ_SOURCE_LINE 00000509 "=item All C<id> returning methods"
NSQ_SOURCE_LINE 00000510 ""
NSQ_SOURCE_LINE 00000511 "These are aliases for the corresponding C<*code> methods."
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "=item C<prefers_24_hour_time>"
NSQ_SOURCE_LINE 00000514 ""
NSQ_SOURCE_LINE 00000515 "This is determined by looking at the short time format to see how it formats"
NSQ_SOURCE_LINE 00000516 "hours,"
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "=item C<date_format_default> and C<time_format_default>"
NSQ_SOURCE_LINE 00000519 ""
NSQ_SOURCE_LINE 00000520 "These are the corresponding medium formats."
NSQ_SOURCE_LINE 00000521 ""
NSQ_SOURCE_LINE 00000522 "=item C<datetime_format> and C<datetime_format_default>"
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 "This is the same as the medium format."
NSQ_SOURCE_LINE 00000525 ""
NSQ_SOURCE_LINE 00000526 "=item C<date_formats> and C<time_formats>"
NSQ_SOURCE_LINE 00000527 ""
NSQ_SOURCE_LINE 00000528 "These are calculated as needed."
NSQ_SOURCE_LINE 00000529 ""
NSQ_SOURCE_LINE 00000530 "=item C<available_formats>"
NSQ_SOURCE_LINE 00000531 ""
NSQ_SOURCE_LINE 00000532 "This should be provided as a hashref where the keys are things like C<Gy> or"
NSQ_SOURCE_LINE 00000533 "C<MMMEd> and the values are an actual format like C<\"y G\"> or C<\"E, MMM d\">."
NSQ_SOURCE_LINE 00000534 ""
NSQ_SOURCE_LINE 00000535 "=item C<locale_data>"
NSQ_SOURCE_LINE 00000536 ""
NSQ_SOURCE_LINE 00000537 "This is everything you pass in."
NSQ_SOURCE_LINE 00000538 ""
NSQ_SOURCE_LINE 00000539 "=back"
NSQ_SOURCE_LINE 00000540 ""
NSQ_SOURCE_LINE 00000541 "=head1 LOADING LOCALES IN A PRE-FORKING SYSTEM"
NSQ_SOURCE_LINE 00000542 ""
NSQ_SOURCE_LINE 00000543 "If you are running an application that does pre-forking (for example with"
NSQ_SOURCE_LINE 00000544 "Starman), then you should try to load all the locales that you'll need in the"
NSQ_SOURCE_LINE 00000545 "parent process. Locales are loaded on-demand, so loading them once in each"
NSQ_SOURCE_LINE 00000546 "child will waste memory that could otherwise be shared."
NSQ_SOURCE_LINE 00000547 ""
NSQ_SOURCE_LINE 00000548 "=head1 CLDR DATA BUGS"
NSQ_SOURCE_LINE 00000549 ""
NSQ_SOURCE_LINE 00000550 "Please be aware that all locale data has been generated from the CLDR (Common"
NSQ_SOURCE_LINE 00000551 "Locale Data Repository) project locales data). The data is incomplete, and may"
NSQ_SOURCE_LINE 00000552 "contain errors in some locales."
NSQ_SOURCE_LINE 00000553 ""
NSQ_SOURCE_LINE 00000554 "When reporting errors in data, please check the primary data sources first,"
NSQ_SOURCE_LINE 00000555 "then where necessary report errors directly to the primary source via the CLDR"
NSQ_SOURCE_LINE 00000556 "bug report system. See L<http://unicode.org/cldr/filing_bug_reports.html> for"
NSQ_SOURCE_LINE 00000557 "details."
NSQ_SOURCE_LINE 00000558 ""
NSQ_SOURCE_LINE 00000559 "Once these errors have been confirmed, please forward the error report and"
NSQ_SOURCE_LINE 00000560 "corrections to the DateTime mailing list, datetime@perl.org."
NSQ_SOURCE_LINE 00000561 ""
NSQ_SOURCE_LINE 00000562 "=head1 AUTHOR EMERITUS"
NSQ_SOURCE_LINE 00000563 ""
NSQ_SOURCE_LINE 00000564 "Richard Evans wrote the first version of DateTime::Locale, including the tools"
NSQ_SOURCE_LINE 00000565 "to extract the CLDR data."
NSQ_SOURCE_LINE 00000566 ""
NSQ_SOURCE_LINE 00000567 "=head1 SEE ALSO"
