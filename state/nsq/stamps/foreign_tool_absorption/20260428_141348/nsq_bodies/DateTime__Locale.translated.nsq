NSQ_SOURCE_LINE 00000038 "sub _register {"
NSQ_SOURCE_LINE 00000039 "    shift;"
NSQ_SOURCE_LINE 00000040 "    my %p = @_;"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "    my $id = $p{id};"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "    die q{'\\@' or '=' are not allowed in locale ids}"
NSQ_SOURCE_LINE 00000045 "        if $id =~ /[\\@=]/;"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "    die"
NSQ_SOURCE_LINE 00000048 "        \"You cannot replace an existing locale ('$id') unless you also specify the 'replace' parameter as true\\n\""
NSQ_SOURCE_LINE 00000049 "        if !delete $p{replace} && exists $DataForCode{$id};"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "    $p{native_language} = $p{en_language}"
NSQ_SOURCE_LINE 00000052 "        unless exists $p{native_language};"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "    my @en_pieces;"
NSQ_SOURCE_LINE 00000055 "    my @native_pieces;"
NSQ_SOURCE_LINE 00000056 "    foreach my $p (qw( language script territory variant )) {"
NSQ_SOURCE_LINE 00000057 "        push @en_pieces,     $p{\"en_$p\"}     if exists $p{\"en_$p\"};"
NSQ_SOURCE_LINE 00000058 "        push @native_pieces, $p{\"native_$p\"} if exists $p{\"native_$p\"};"
NSQ_SOURCE_LINE 00000059 "    }"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "    $p{en_complete_name}     = join q{ }, @en_pieces;"
NSQ_SOURCE_LINE 00000062 "    $p{native_complete_name} = join q{ }, @native_pieces;"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "    $id =~ s/_/-/g;"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "    $DataForCode{$id} = \\%p;"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "    $NameToCode{ $p{en_complete_name} }           = $id;"
NSQ_SOURCE_LINE 00000069 "    $NativeNameToCode{ $p{native_complete_name} } = $id;"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "    $Class{$id} = $p{class} if defined exists $p{class};"
NSQ_SOURCE_LINE 00000072 "}"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "sub register_from_data {"
NSQ_SOURCE_LINE 00000075 "    shift;"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "    %LoadCache = ();"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "    my %p = ref $_[0] ? %{ $_[0] } : @_;"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "    my $code = $p{code};"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "    die q{'\\@' or '=' are not allowed in locale codes}"
NSQ_SOURCE_LINE 00000084 "        if $code =~ /[\\@=]/;"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "    $code =~ s/_/-/g;"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "    DateTime::Locale::Data::add_locale( $code, \\%p );"
NSQ_SOURCE_LINE 00000089 "    return $LoadCache{$code} = DateTime::Locale::FromData->new( \\%p );"
NSQ_SOURCE_LINE 00000090 "}"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "sub add_aliases {"
NSQ_SOURCE_LINE 00000093 "    shift;"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "    %LoadCache = ();"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "    my $aliases = ref $_[0] ? $_[0] : {@_};"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "    for my $alias ( keys %{$aliases} ) {"
NSQ_SOURCE_LINE 00000100 "        my $code = $aliases->{$alias};"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "        die q{Can't alias an id to itself}"
NSQ_SOURCE_LINE 00000103 "            if $alias eq $code;"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "        # check for overwrite?"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "        my %seen = ( $alias => 1, $code => 1 );"
NSQ_SOURCE_LINE 00000108 "        my $copy = $code;"
NSQ_SOURCE_LINE 00000109 "        while ( $copy = $UserDefinedAlias{$copy} ) {"
NSQ_SOURCE_LINE 00000110 "            die"
NSQ_SOURCE_LINE 00000111 "                \"Creating an alias from $alias to $code would create a loop.\\n\""
NSQ_SOURCE_LINE 00000112 "                if $seen{$copy};"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "            $seen{$copy} = 1;"
NSQ_SOURCE_LINE 00000115 "        }"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "        $UserDefinedAlias{$alias} = $code;"
NSQ_SOURCE_LINE 00000118 "    }"
NSQ_SOURCE_LINE 00000119 "}"
NSQ_SOURCE_LINE 00000120 ""
