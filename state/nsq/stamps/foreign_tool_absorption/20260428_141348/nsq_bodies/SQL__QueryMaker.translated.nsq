NSQ_SOURCE_LINE 00000001 "package SQL::QueryMaker;"
NSQ_SOURCE_LINE 00000002 "use 5.008_001;"
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 "use utf8;"
NSQ_SOURCE_LINE 00000006 "use Carp ();"
NSQ_SOURCE_LINE 00000007 "use Exporter qw(import);"
NSQ_SOURCE_LINE 00000008 "use Scalar::Util qw(blessed);"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "our $VERSION = '0.03';"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "our @EXPORT = qw(sql_op sql_raw);"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "{"
NSQ_SOURCE_LINE 00000015 "    no strict \"refs\";"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "    for (qw(and or)) {"
NSQ_SOURCE_LINE 00000018 "        my $fn = \"sql_$_\";"
NSQ_SOURCE_LINE 00000019 "        my $op = uc $_;"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "        *{__PACKAGE__ . \"::$fn\"} = sub {"
NSQ_SOURCE_LINE 00000022 "            # fetch args"
NSQ_SOURCE_LINE 00000023 "            my $args = pop;"
NSQ_SOURCE_LINE 00000024 "            my $column = shift;"
NSQ_SOURCE_LINE 00000025 "            if (ref $args eq 'HASH') {"
NSQ_SOURCE_LINE 00000026 "                Carp::croak(\"cannot specify the column name as another argument when the conditions are listed using hashref\")"
NSQ_SOURCE_LINE 00000027 "                    if defined $column;"
NSQ_SOURCE_LINE 00000028 "                my @conds;"
NSQ_SOURCE_LINE 00000029 "                for my $column (keys %$args) {"
NSQ_SOURCE_LINE 00000030 "                    my $value = $args->{$column};"
NSQ_SOURCE_LINE 00000031 "                    if (blessed($value) && $value->can('bind_column')) {"
NSQ_SOURCE_LINE 00000032 "                        $value->bind_column($column);"
NSQ_SOURCE_LINE 00000033 "                    } else {"
NSQ_SOURCE_LINE 00000034 "                        $value = sql_eq($column, $value);"
NSQ_SOURCE_LINE 00000035 "                    }"
NSQ_SOURCE_LINE 00000036 "                    push @conds, $value;"
NSQ_SOURCE_LINE 00000037 "                }"
NSQ_SOURCE_LINE 00000038 "                $args = \\@conds;"
NSQ_SOURCE_LINE 00000039 "            } else {"
NSQ_SOURCE_LINE 00000040 "                Carp::croak(\"arguments to `$op` must be contained in an arrayref or a hashref\")"
NSQ_SOURCE_LINE 00000041 "                    if ref $args ne 'ARRAY';"
NSQ_SOURCE_LINE 00000042 "            }"
NSQ_SOURCE_LINE 00000043 "            # build and return the compiler"
NSQ_SOURCE_LINE 00000044 "            return SQL::QueryMaker->_new($column, sub {"
NSQ_SOURCE_LINE 00000045 "                my ($column, $quote_cb) = @_;"
NSQ_SOURCE_LINE 00000046 "                return $op eq 'AND' ? '0=1' : '1=1'"
NSQ_SOURCE_LINE 00000047 "                    if @$args == 0;"
NSQ_SOURCE_LINE 00000048 "                my @term;"
NSQ_SOURCE_LINE 00000049 "                for my $arg (@$args) {"
NSQ_SOURCE_LINE 00000050 "                    if (blessed($arg) && $arg->can('as_sql')) {"
NSQ_SOURCE_LINE 00000051 "                        my ($term, $bind) = $arg->as_sql($column, $quote_cb);"
NSQ_SOURCE_LINE 00000052 "                        push @term, \"($term)\";"
NSQ_SOURCE_LINE 00000053 "                    } else {"
NSQ_SOURCE_LINE 00000054 "                        Carp::croak(\"no column binding for $fn\")"
NSQ_SOURCE_LINE 00000055 "                            unless defined $column;"
NSQ_SOURCE_LINE 00000056 "                        push @term, '(' . $quote_cb->($column) . ' = ?)';"
NSQ_SOURCE_LINE 00000057 "                    }"
NSQ_SOURCE_LINE 00000058 "                }"
NSQ_SOURCE_LINE 00000059 "                my $term = join \" $op \", @term;"
NSQ_SOURCE_LINE 00000060 "                return $term;"
NSQ_SOURCE_LINE 00000061 "            }, do {"
NSQ_SOURCE_LINE 00000062 "                my @bind;"
NSQ_SOURCE_LINE 00000063 "                for my $arg (@$args) {"
NSQ_SOURCE_LINE 00000064 "                    if (blessed($arg) && $arg->can('as_sql')) {"
NSQ_SOURCE_LINE 00000065 "                        push @bind, $arg->bind();"
NSQ_SOURCE_LINE 00000066 "                    } else {"
NSQ_SOURCE_LINE 00000067 "                        push @bind, $arg;"
NSQ_SOURCE_LINE 00000068 "                    }"
NSQ_SOURCE_LINE 00000069 "                }"
NSQ_SOURCE_LINE 00000070 "                \\@bind;"
NSQ_SOURCE_LINE 00000071 "            });"
NSQ_SOURCE_LINE 00000072 "        };"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "        push @EXPORT, $fn;"
NSQ_SOURCE_LINE 00000075 "    }"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "    for (qw(in not_in)) {"
NSQ_SOURCE_LINE 00000078 "        my $fn = \"sql_$_\";"
NSQ_SOURCE_LINE 00000079 "        my $op = uc $_;"
NSQ_SOURCE_LINE 00000080 "        $op =~ s/_/ /g;"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "        *{__PACKAGE__ . \"::$fn\"} = sub {"
NSQ_SOURCE_LINE 00000083 "            # fetch args"
NSQ_SOURCE_LINE 00000084 "            my $args = pop;"
NSQ_SOURCE_LINE 00000085 "            Carp::croak(\"arguments to `$op` must be contained in an arrayref\")"
NSQ_SOURCE_LINE 00000086 "                if ref $args ne 'ARRAY';"
NSQ_SOURCE_LINE 00000087 "            my $column = shift;"
NSQ_SOURCE_LINE 00000088 "            # build and return the compiler"
NSQ_SOURCE_LINE 00000089 "            return SQL::QueryMaker->_new($column, sub {"
NSQ_SOURCE_LINE 00000090 "                my ($column, $quote_cb) = @_;"
NSQ_SOURCE_LINE 00000091 "                Carp::croak(\"no column binding for $fn\")"
NSQ_SOURCE_LINE 00000092 "                    unless defined $column;"
NSQ_SOURCE_LINE 00000093 "                return $op eq 'IN' ? '0=1' : '1=1'"
NSQ_SOURCE_LINE 00000094 "                    if @$args == 0;"
NSQ_SOURCE_LINE 00000095 "                my @term;"
NSQ_SOURCE_LINE 00000096 "                for my $arg (@$args) {"
NSQ_SOURCE_LINE 00000097 "                    if (blessed($arg) && $arg->can('as_sql')) {"
NSQ_SOURCE_LINE 00000098 "                        my $term = $arg->as_sql(undef, $quote_cb);"
NSQ_SOURCE_LINE 00000099 "                        push @term, $term eq '?' ? $term : \"($term)\"; # emit parens only when necessary"
NSQ_SOURCE_LINE 00000100 "                    } else {"
NSQ_SOURCE_LINE 00000101 "                        push @term, '?';"
NSQ_SOURCE_LINE 00000102 "                    }"
NSQ_SOURCE_LINE 00000103 "                }"
NSQ_SOURCE_LINE 00000104 "                my $term = $quote_cb->($column) . \" $op (\" . join(',', @term) . ')';"
NSQ_SOURCE_LINE 00000105 "                return $term;"
NSQ_SOURCE_LINE 00000106 "            }, do {"
NSQ_SOURCE_LINE 00000107 "                my @bind;"
NSQ_SOURCE_LINE 00000108 "                for my $arg (@$args) {"
NSQ_SOURCE_LINE 00000109 "                    if (blessed($arg) && $arg->can('as_sql')) {"
NSQ_SOURCE_LINE 00000110 "                        push @bind, $arg->bind();"
NSQ_SOURCE_LINE 00000111 "                    } else {"
NSQ_SOURCE_LINE 00000112 "                        push @bind, $arg;"
NSQ_SOURCE_LINE 00000113 "                    }"
NSQ_SOURCE_LINE 00000114 "                }"
NSQ_SOURCE_LINE 00000115 "                \\@bind;"
NSQ_SOURCE_LINE 00000116 "            });"
NSQ_SOURCE_LINE 00000117 "        };"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "        push @EXPORT, $fn;"
NSQ_SOURCE_LINE 00000120 "    }"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "    my %FNOP = ("
NSQ_SOURCE_LINE 00000123 "        'is_null' => 'IS NULL',"
NSQ_SOURCE_LINE 00000124 "        'is_not_null' => 'IS NOT NULL',"
NSQ_SOURCE_LINE 00000125 "        'eq' => '= ?',"
NSQ_SOURCE_LINE 00000126 "        'ne' => '!= ?',"
NSQ_SOURCE_LINE 00000127 "        'lt' => '< ?',"
NSQ_SOURCE_LINE 00000128 "        'gt' => '> ?',"
NSQ_SOURCE_LINE 00000129 "        'le' => '<= ?',"
NSQ_SOURCE_LINE 00000130 "        'ge' => '>= ?',"
NSQ_SOURCE_LINE 00000131 "        'like' => 'LIKE ?',"
NSQ_SOURCE_LINE 00000132 "        'between' => 'BETWEEN ? AND ?',"
NSQ_SOURCE_LINE 00000133 "        'not_between' => 'NOT BETWEEN ? AND ?',"
NSQ_SOURCE_LINE 00000134 "        'not' => 'NOT @',"
NSQ_SOURCE_LINE 00000135 "    );"
NSQ_SOURCE_LINE 00000136 "    for (keys %FNOP) {"
NSQ_SOURCE_LINE 00000137 "        my $fn = \"sql_$_\";"
NSQ_SOURCE_LINE 00000138 "        my ($num_args, $builder) = _compile_builder($FNOP{$_});"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "        *{__PACKAGE__ . \"::$fn\"} = sub {"
NSQ_SOURCE_LINE 00000141 "            # fetch args"
NSQ_SOURCE_LINE 00000142 "            my $column = @_ > $num_args ? shift : undef;"
NSQ_SOURCE_LINE 00000143 "            Carp::croak(\"the operator expects $num_args parameters, but got \" . scalar(@_))"
NSQ_SOURCE_LINE 00000144 "                if $num_args != @_;"
NSQ_SOURCE_LINE 00000145 "            return _sql_op($fn, $builder, $column, [ @_ ]);"
NSQ_SOURCE_LINE 00000146 "        };"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "        push @EXPORT, $fn;"
NSQ_SOURCE_LINE 00000149 "    }"
NSQ_SOURCE_LINE 00000150 "}"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "sub sql_op {"
NSQ_SOURCE_LINE 00000153 "    my $args = pop;"
NSQ_SOURCE_LINE 00000154 "    my $expr = pop;"
NSQ_SOURCE_LINE 00000155 "    my ($num_args, $builder) = _compile_builder($expr);"
NSQ_SOURCE_LINE 00000156 "    Carp::croak(\"the operator expects $num_args but got \" . scalar(@$args))"
NSQ_SOURCE_LINE 00000157 "        if $num_args != @$args;"
NSQ_SOURCE_LINE 00000158 "    return _sql_op(\"sql_op\", $builder, shift, $args);"
NSQ_SOURCE_LINE 00000159 "}"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "sub _sql_op {"
NSQ_SOURCE_LINE 00000162 "    my ($fn, $builder, $column, $args) = @_;"
NSQ_SOURCE_LINE 00000163 "    return SQL::QueryMaker->_new($column, sub {"
NSQ_SOURCE_LINE 00000164 "        my ($column, $quote_cb) = @_;"
NSQ_SOURCE_LINE 00000165 "        Carp::croak(\"no column binding for $fn(args...)\")"
NSQ_SOURCE_LINE 00000166 "            unless defined $column;"
NSQ_SOURCE_LINE 00000167 "        my $term = $builder->($quote_cb->($column));"
NSQ_SOURCE_LINE 00000168 "        return $term;"
NSQ_SOURCE_LINE 00000169 "    }, $args);"
NSQ_SOURCE_LINE 00000170 "}"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "sub sql_raw {"
NSQ_SOURCE_LINE 00000173 "    my ($sql, @bind) = @_;"
NSQ_SOURCE_LINE 00000174 "    return SQL::QueryMaker->_new(undef, sub {"
NSQ_SOURCE_LINE 00000175 "        return $sql;"
NSQ_SOURCE_LINE 00000176 "    }, \\@bind);"
NSQ_SOURCE_LINE 00000177 "}"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "sub _compile_builder {"
NSQ_SOURCE_LINE 00000180 "    my $expr = shift;"
NSQ_SOURCE_LINE 00000181 "    # substitute the column character"
NSQ_SOURCE_LINE 00000182 "    $expr = \"\\@ $expr\""
NSQ_SOURCE_LINE 00000183 "        if $expr !~ /\\@/;"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "    my $num_args = @{[ $expr =~ /\\?/g ]};"
NSQ_SOURCE_LINE 00000186 "    my @expr = split /\\@/, $expr, -1;"
NSQ_SOURCE_LINE 00000187 "    my $builder = sub {"
NSQ_SOURCE_LINE 00000188 "        return join $_[0], @expr;"
NSQ_SOURCE_LINE 00000189 "    };"
NSQ_SOURCE_LINE 00000190 "    return ($num_args, $builder);"
NSQ_SOURCE_LINE 00000191 "}"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "sub _new {"
NSQ_SOURCE_LINE 00000194 "    my ($class, $column, $as_sql, $bind) = @_;"
NSQ_SOURCE_LINE 00000195 "    for my $b (@$bind) {"
NSQ_SOURCE_LINE 00000196 "        Carp::croak(\"cannot bind an arrayref or an hashref\")"
NSQ_SOURCE_LINE 00000197 "            if ref $b && ! blessed($b);"
NSQ_SOURCE_LINE 00000198 "    }"
NSQ_SOURCE_LINE 00000199 "    return bless {"
NSQ_SOURCE_LINE 00000200 "        column => $column,"
NSQ_SOURCE_LINE 00000201 "        as_sql => $as_sql,"
NSQ_SOURCE_LINE 00000202 "        bind   => $bind,"
NSQ_SOURCE_LINE 00000203 "    }, $class;"
NSQ_SOURCE_LINE 00000204 "}"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "sub bind_column {"
NSQ_SOURCE_LINE 00000207 "    my ($self, $column) = @_;"
NSQ_SOURCE_LINE 00000208 "    if (defined $column) {"
NSQ_SOURCE_LINE 00000209 "        Carp::croak('cannot rebind column for \\`' . $self->{column} . \"` to: `$column`\")"
NSQ_SOURCE_LINE 00000210 "            if defined $self->{column};"
NSQ_SOURCE_LINE 00000211 "    }"
NSQ_SOURCE_LINE 00000212 "    $self->{column} = $column;"
NSQ_SOURCE_LINE 00000213 "}"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "sub as_sql {"
NSQ_SOURCE_LINE 00000216 "    my ($self, $supplied_colname, $quote_cb) = @_;"
NSQ_SOURCE_LINE 00000217 "    $self->bind_column($supplied_colname)"
NSQ_SOURCE_LINE 00000218 "        if defined $supplied_colname;"
NSQ_SOURCE_LINE 00000219 "    $quote_cb ||= \\&quote_identifier;"
NSQ_SOURCE_LINE 00000220 "    return $self->{as_sql}->($self->{column}, $quote_cb);"
NSQ_SOURCE_LINE 00000221 "}"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "sub bind {"
NSQ_SOURCE_LINE 00000224 "    my $self = shift;"
NSQ_SOURCE_LINE 00000225 "    return @{$self->{bind}};"
NSQ_SOURCE_LINE 00000226 "}"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "sub quote_identifier {"
NSQ_SOURCE_LINE 00000229 "    my $label = shift;"
NSQ_SOURCE_LINE 00000230 "    return join '.', map { \"`$_`\" } split /\\./, $label;"
NSQ_SOURCE_LINE 00000231 "}"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "1;"
NSQ_SOURCE_LINE 00000234 "__END__"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "=head1 NAME"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "SQL::QueryMaker - helper functions for SQL query generation"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "    my $query = sql_eq(foo => $v);"
NSQ_SOURCE_LINE 00000243 "    $query->as_sql;                 # `foo`=?"
NSQ_SOURCE_LINE 00000244 "    $query->bind;                   # ($v)"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "    my $query = sql_lt(foo => $v);"
NSQ_SOURCE_LINE 00000247 "    $query->as_sql;                 # `foo`<?"
NSQ_SOURCE_LINE 00000248 "    $query->bind;                   # ($v)"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "    my $query = sql_in(foo => ["
NSQ_SOURCE_LINE 00000251 "        $v1, $v2, $v3,"
NSQ_SOURCE_LINE 00000252 "    ]);"
NSQ_SOURCE_LINE 00000253 "    $query->as_sql;                 # `foo` IN (?,?,?)"
NSQ_SOURCE_LINE 00000254 "    $query->bind;                   # ($v1,$v2,$v3)"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "    my $query = sql_and(foo => ["
NSQ_SOURCE_LINE 00000257 "        sql_ge($min),"
NSQ_SOURCE_LINE 00000258 "        sql_lt($max)"
NSQ_SOURCE_LINE 00000259 "    ]);"
NSQ_SOURCE_LINE 00000260 "    $query->as_sql;                 # `foo`>=? AND `foo`<?"
NSQ_SOURCE_LINE 00000261 "    $query->bind;                   # ($min,$max)"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "    my $query = sql_and(["
NSQ_SOURCE_LINE 00000264 "        sql_eq(foo => $v1),"
NSQ_SOURCE_LINE 00000265 "        sql_eq(bar => $v2)"
NSQ_SOURCE_LINE 00000266 "    ];"
NSQ_SOURCE_LINE 00000267 "    $query->as_sql;                 # `foo`=? AND `bar`=?"
NSQ_SOURCE_LINE 00000268 "    $query->bind;                   # ($v1,$v2)"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "    my $query = sql_and(["
NSQ_SOURCE_LINE 00000271 "        foo => $v1,"
NSQ_SOURCE_LINE 00000272 "        bar => sql_lt($v2),"
NSQ_SOURCE_LINE 00000273 "    ]);"
NSQ_SOURCE_LINE 00000274 "    $query->as_sql;                 # `foo`=? AND `bar`<?"
NSQ_SOURCE_LINE 00000275 "    $query->bind;                   # ($v1,$v2)"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "This module concentrates on providing an expressive, concise way to declare SQL"
NSQ_SOURCE_LINE 00000280 "expressions by exporting carefully-designed functions."
NSQ_SOURCE_LINE 00000281 "It is possible to use the module to generate SQL query conditions and pass them"
NSQ_SOURCE_LINE 00000282 "as arguments to other more versatile query builders such as L<SQL::Maker>."
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "The functions exported by the module instantiate comparator objects that build"
NSQ_SOURCE_LINE 00000285 "SQL expressions when their C<as_sql> method are being invoked."
NSQ_SOURCE_LINE 00000286 "There are two ways to specify the names of the columns to the comparator; to"
NSQ_SOURCE_LINE 00000287 "pass in the names as argument or to specify then as an argument to the"
NSQ_SOURCE_LINE 00000288 "C<as_sql> method."
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "=head2 C<< sql_eq([$column,] $value) >>"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "=head2 C<< sql_ne([$column,] $value) >>"
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "=head2 C<< sql_lt([$column,] $value) >>"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "=head2 C<< sql_gt([$column,] $value) >>"
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "=head2 C<< sql_le([$column,] $value) >>"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "=head2 C<< sql_ge([$column,] $value) >>"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "=head2 C<< sql_like([$column,] $value) >>"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "=head2 C<< sql_is_null([$column]) >>"
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "=head2 C<< sql_is_not_null([$column]) >>"
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "=head2 C<< sql_not([$column]) >>"
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "=head2 C<< sql_between([$column,] $min_value, $max_value) >>"
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "=head2 C<< sql_not_between([$column,] $min_value, $max_value) >>"
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "=head2 C<< sql_in([$column,] \\@values) >>"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "=head2 C<< sql_not_in([$column,] \\@values) >>"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "Instantiates a comparator object that tests a column against given value(s)."
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "=head2 C<< sql_and([$column,] \\@conditions) >>"
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "=head2 C<< sql_or([$ column,] \\@conditions) >>"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "Aggregates given comparator objects into a logical expression."
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "If specified, the column name is pushed down to the arguments when the"
NSQ_SOURCE_LINE 00000329 "C<as_sql> method is being called, as show in the second example below."
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "    sql_and([                   # => `foo`=? AND `bar`<?"
NSQ_SOURCE_LINE 00000332 "        sql_eq(\"foo\" => $v1),"
NSQ_SOURCE_LINE 00000333 "        sql_lt(\"bar\" => $v2)"
NSQ_SOURCE_LINE 00000334 "    ])"
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "    sql_and(\"foo\" => [          # => `foo`>=$min OR `foo`<$max"
NSQ_SOURCE_LINE 00000337 "        sql_ge($min),"
NSQ_SOURCE_LINE 00000338 "        sql_lt($max),"
NSQ_SOURCE_LINE 00000339 "    ])"
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "=head2 C<< sql_and(\\%conditions) >>"
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "=head2 C<< sql_or(\\%conditions) >>"
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "Aggregates given pairs of column names and comparators into a logical"
NSQ_SOURCE_LINE 00000346 "expression."
NSQ_SOURCE_LINE 00000347 ""
NSQ_SOURCE_LINE 00000348 "The value part is composed of as the argument to the C<=> operator if it is"
NSQ_SOURCE_LINE 00000349 "not a blessed reference."
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "    my $query = sql_and({"
NSQ_SOURCE_LINE 00000352 "        foo => 'abc',"
NSQ_SOURCE_LINE 00000353 "        bar => sql_lt(123),"
NSQ_SOURCE_LINE 00000354 "    });"
NSQ_SOURCE_LINE 00000355 "    $query->as_sql;             # => `foo`=? AND bar<?"
NSQ_SOURCE_LINE 00000356 "    $query->bind;               # => ('abc', 123)"
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "=head2 C<< sql_op([$column,] $op_sql, \\@bind_values) >>"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "Generates a comparator object that tests a column using the given SQL and"
NSQ_SOURCE_LINE 00000362 "values.  C<<@>> in the given SQL are replaced by the column name (specified"
NSQ_SOURCE_LINE 00000363 "either by the argument to the function or later by the call to the C<<as_sql>>"
NSQ_SOURCE_LINE 00000364 "method), and C<<?>> are substituted by the given bind values."
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "=head2 C<< sql_raw($sql, @bind_values) >>"
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 "Generates a comparator object from raw SQL and bind values.  C<<?>> in the"
NSQ_SOURCE_LINE 00000369 "given SQL are replaced by the bind values."
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "=head2 C<< $obj->as_sql() >>"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "=head2 C<< $obj->as_sql($column_name) >>"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "=head2 C<< $obj->as_sql($column_name, $quote_identifier_cb) >>"
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "Compiles given comparator object and returns an SQL expression."
NSQ_SOURCE_LINE 00000378 "Corresponding bind values should be obtained by calling the C<bind> method."
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "The function optionally accepts a column name to which the comparator object"
NSQ_SOURCE_LINE 00000381 "should be bound; an error is thrown if the comparator object is already bound"
NSQ_SOURCE_LINE 00000382 "to another column."
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "The function also accepts a callback for quoting the identifiers.  If omitted,"
NSQ_SOURCE_LINE 00000385 "the identifiers are quoted using C<`> after being splitted using C<.>; i.e. a"
NSQ_SOURCE_LINE 00000386 "column designated as C<foo.bar> is quoted as C<`foo`.`bar`>."
NSQ_SOURCE_LINE 00000387 ""
NSQ_SOURCE_LINE 00000388 "=head2 C<< $obj->bind() >>"
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "Returns a list of bind values corresponding to the SQL expression returned by"
NSQ_SOURCE_LINE 00000391 "the C<as_sql> method."
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "=head1 CHEAT SHEET"
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "    IN:        sql_eq('foo' => 'bar')"
NSQ_SOURCE_LINE 00000396 "    OUT QUERY: '`foo` = ?'"
NSQ_SOURCE_LINE 00000397 "    OUT BIND:  ('bar')"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "    IN:        sql_ne('foo' => 'bar')"
NSQ_SOURCE_LINE 00000400 "    OUT QUERY: '`foo` != ?'"
NSQ_SOURCE_LINE 00000401 "    OUT BIND:  ('bar')"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "    IN:        sql_in('foo' => ['bar', 'baz'])"
NSQ_SOURCE_LINE 00000404 "    OUT QUERY: '`foo` IN (?,?)'"
NSQ_SOURCE_LINE 00000405 "    OUT BIND:  ('bar','baz')"
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "    IN:        sql_and([sql_eq('foo' => 'bar'), sql_eq('baz' => 123)])"
NSQ_SOURCE_LINE 00000408 "    OUT QUERY: '(`foo` = ?) AND (`baz` = ?)'"
NSQ_SOURCE_LINE 00000409 "    OUT BIND:  ('bar',123)"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "    IN:        sql_and('foo' => [sql_ge(3), sql_lt(5)])"
NSQ_SOURCE_LINE 00000412 "    OUT QUERY: '(`foo` >= ?) AND (`foo` < ?)'"
NSQ_SOURCE_LINE 00000413 "    OUT BIND:  (3,5)"
NSQ_SOURCE_LINE 00000414 ""
NSQ_SOURCE_LINE 00000415 "    IN:        sql_or([sql_eq('foo' => 'bar'), sql_eq('baz' => 123)])"
NSQ_SOURCE_LINE 00000416 "    OUT QUERY: '(`foo` = ?) OR (`baz` = ?)'"
NSQ_SOURCE_LINE 00000417 "    OUT BIND:  ('bar',123)"
NSQ_SOURCE_LINE 00000418 ""
NSQ_SOURCE_LINE 00000419 "    IN:        sql_or('foo' => ['bar', 'baz'])"
NSQ_SOURCE_LINE 00000420 "    OUT QUERY: '(`foo` = ?) OR (`foo` = ?)'"
NSQ_SOURCE_LINE 00000421 "    OUT BIND:  ('bar','baz')"
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "    IN:        sql_is_null('foo')"
NSQ_SOURCE_LINE 00000424 "    OUT QUERY: '`foo` IS NULL'"
NSQ_SOURCE_LINE 00000425 "    OUT BIND:  ()"
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 "    IN:        sql_is_not_null('foo')"
NSQ_SOURCE_LINE 00000428 "    OUT QUERY: '`foo` IS NOT NULL'"
NSQ_SOURCE_LINE 00000429 "    OUT BIND:  ()"
NSQ_SOURCE_LINE 00000430 ""
NSQ_SOURCE_LINE 00000431 "    IN:        sql_between('foo', 1, 2)"
NSQ_SOURCE_LINE 00000432 "    OUT QUERY: '`foo` BETWEEN ? AND ?'"
NSQ_SOURCE_LINE 00000433 "    OUT BIND:  (1,2)"
NSQ_SOURCE_LINE 00000434 ""
NSQ_SOURCE_LINE 00000435 "    IN:        sql_not('foo')"
NSQ_SOURCE_LINE 00000436 "    OUT QUERY: 'NOT `foo`'"
NSQ_SOURCE_LINE 00000437 "    OUT BIND:  ()"
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "    IN:        sql_op('apples', 'MATCH (@) AGAINST (?)', ['oranges'])"
NSQ_SOURCE_LINE 00000440 "    OUT QUERY: 'MATCH (`apples`) AGAINST (?)'"
NSQ_SOURCE_LINE 00000441 "    OUT BIND:  ('oranges')"
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "    IN:        sql_raw('SELECT * FROM t WHERE id=?',123)"
NSQ_SOURCE_LINE 00000444 "    OUT QUERY: 'SELECT * FROM t WHERE id=?'"
NSQ_SOURCE_LINE 00000445 "    OUT BIND:  (123)"
NSQ_SOURCE_LINE 00000446 ""
NSQ_SOURCE_LINE 00000447 "    IN:        sql_in('foo', => [123,sql_raw('SELECT id FROM t WHERE cat=?',5)])"
NSQ_SOURCE_LINE 00000448 "    OUT QUERY: '`foo` IN (?,(SELECT id FROM t WHERE cat=?))'"
NSQ_SOURCE_LINE 00000449 "    OUT BIND:  (123,5)"
NSQ_SOURCE_LINE 00000450 ""
