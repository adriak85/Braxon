NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "# printer"
NSQ_SOURCE_LINE 00000331 "sub writeFile {"
NSQ_SOURCE_LINE 00000332 "    my $self = shift;"
NSQ_SOURCE_LINE 00000333 "    my $filename = shift;"
NSQ_SOURCE_LINE 00000334 "    "
NSQ_SOURCE_LINE 00000335 "    open OUT, \">$filename\" or die \"Can't open $filename : $!\\n\";"
NSQ_SOURCE_LINE 00000336 "    "
NSQ_SOURCE_LINE 00000337 "    $self->writeHeader(\\*OUT);"
NSQ_SOURCE_LINE 00000338 "    $self->writeObjects(\\*OUT);"
NSQ_SOURCE_LINE 00000339 "    "
NSQ_SOURCE_LINE 00000340 "    close OUT;"
NSQ_SOURCE_LINE 00000341 "}"
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "sub writeHeader {"
NSQ_SOURCE_LINE 00000344 "    my $self = shift;"
NSQ_SOURCE_LINE 00000345 "    my $fh = shift;"
NSQ_SOURCE_LINE 00000346 "    "
NSQ_SOURCE_LINE 00000347 "    printf $fh \"#FIG %s\\n\", $self->{version};"
NSQ_SOURCE_LINE 00000348 "    printf $fh \"%s\\n\", $self->{orientation};"
NSQ_SOURCE_LINE 00000349 "    printf $fh \"%s\\n\", $self->{justification};"
NSQ_SOURCE_LINE 00000350 "    printf $fh \"%s\\n\", $self->{units};"
NSQ_SOURCE_LINE 00000351 "    printf $fh \"%s\\n\", $self->{papersize};"
NSQ_SOURCE_LINE 00000352 "    printf $fh \"%.2f\\n\", $self->{magnification};"
NSQ_SOURCE_LINE 00000353 "    printf $fh \"%s\\n\", $self->{multiple_page};"
NSQ_SOURCE_LINE 00000354 "    printf $fh \"%d\\n\", $self->{transparent_color};"
NSQ_SOURCE_LINE 00000355 "    if ($self->{title} ne \"\") {"
NSQ_SOURCE_LINE 00000356 "\tforeach (split(/\\n/, $self->{title})) {"
NSQ_SOURCE_LINE 00000357 "\t    printf $fh \"# $_\\n\";"
NSQ_SOURCE_LINE 00000358 "\t}"
NSQ_SOURCE_LINE 00000359 "    }"
NSQ_SOURCE_LINE 00000360 "    printf $fh \"%d %d\\n\", $self->{resolution}, $self->{coord_system};"
NSQ_SOURCE_LINE 00000361 "}"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "sub writeObjects {"
NSQ_SOURCE_LINE 00000364 "    my $self = shift;"
NSQ_SOURCE_LINE 00000365 "    my $fh = shift;"
NSQ_SOURCE_LINE 00000366 "    "
