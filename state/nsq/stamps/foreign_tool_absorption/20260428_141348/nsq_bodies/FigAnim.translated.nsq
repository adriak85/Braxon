NSQ_SOURCE_LINE 00000107 "sub parseHeader {"
NSQ_SOURCE_LINE 00000108 "    my $self = shift;"
NSQ_SOURCE_LINE 00000109 "    my $fh = shift;"
NSQ_SOURCE_LINE 00000110 "    "
NSQ_SOURCE_LINE 00000111 "    my $line = <$fh>;"
NSQ_SOURCE_LINE 00000112 "    return unless ($line =~ /^\\#FIG (\\d(.\\d)*)\\n$/);"
NSQ_SOURCE_LINE 00000113 "    $self->{version} = $1;"
NSQ_SOURCE_LINE 00000114 "    $self->{orientation} = nextline($fh);"
NSQ_SOURCE_LINE 00000115 "    $self->{justification} = nextline($fh);"
NSQ_SOURCE_LINE 00000116 "    $self->{units} = nextline($fh);"
NSQ_SOURCE_LINE 00000117 "    $self->{papersize} = nextline($fh);"
NSQ_SOURCE_LINE 00000118 "    $self->{magnification} = nextline($fh);"
NSQ_SOURCE_LINE 00000119 "    $self->{multiple_page} = nextline($fh);"
NSQ_SOURCE_LINE 00000120 "    $self->{transparent_color} = nextline($fh);"
NSQ_SOURCE_LINE 00000121 "    while (($line = nextline($fh)) =~ /^\\# /) {"
NSQ_SOURCE_LINE 00000122 "\t$line =~ s/\\# //;"
NSQ_SOURCE_LINE 00000123 "\t$self->{title} .= $line . \"\\n\";"
NSQ_SOURCE_LINE 00000124 "    }"
NSQ_SOURCE_LINE 00000125 "    ($self->{resolution}, $self->{coord_system}) = split / /, $line;"
NSQ_SOURCE_LINE 00000126 "}"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "sub parseObjects {"
NSQ_SOURCE_LINE 00000129 "    my $self = shift;"
NSQ_SOURCE_LINE 00000130 "    my $fh = shift;"
NSQ_SOURCE_LINE 00000131 "    my $current = shift;"
NSQ_SOURCE_LINE 00000132 "    my ($line, $object_code, $object, @attr);"
NSQ_SOURCE_LINE 00000133 "    my $name = \"\";"
NSQ_SOURCE_LINE 00000134 "    "
NSQ_SOURCE_LINE 00000135 "    while ($line = nextline($fh)) {"
NSQ_SOURCE_LINE 00000136 "\treturn if ($line =~ /^-6/);"
NSQ_SOURCE_LINE 00000137 "\t"
NSQ_SOURCE_LINE 00000138 "\t@attr = split / /, $line;"
NSQ_SOURCE_LINE 00000139 "\t$object_code = shift @attr;"
NSQ_SOURCE_LINE 00000140 "\t"
NSQ_SOURCE_LINE 00000141 "\tif ($object_code eq \"0\") { # Color"
NSQ_SOURCE_LINE 00000142 "\t    $object = new Color(@attr);"
NSQ_SOURCE_LINE 00000143 "\t    push @{$self->{colors}}, $object;"
NSQ_SOURCE_LINE 00000144 "\t}"
NSQ_SOURCE_LINE 00000145 "\t"
NSQ_SOURCE_LINE 00000146 "\telsif ($object_code eq \"#\") { # Comment"
NSQ_SOURCE_LINE 00000147 "\t    $line =~ s/^\\# //;"
NSQ_SOURCE_LINE 00000148 "\t    $name .= $line . \"\\n\";"
NSQ_SOURCE_LINE 00000149 "\t}"
NSQ_SOURCE_LINE 00000150 "\t"
NSQ_SOURCE_LINE 00000151 "\telsif ($object_code eq \"5\") { # Arc"
NSQ_SOURCE_LINE 00000152 "\t    if ($attr[11]) { # forward_arrow == 1"
NSQ_SOURCE_LINE 00000153 "\t\t$line = nextline($fh);"
NSQ_SOURCE_LINE 00000154 "\t\t$line =~ s/^[\\t ]*//;"
NSQ_SOURCE_LINE 00000155 "\t\tpush @attr, (split / /, $line);"
NSQ_SOURCE_LINE 00000156 "\t    } else {"
NSQ_SOURCE_LINE 00000157 "\t\tpush @attr, (undef,undef,undef,undef,undef);"
NSQ_SOURCE_LINE 00000158 "\t    }"
NSQ_SOURCE_LINE 00000159 "\t    "
NSQ_SOURCE_LINE 00000160 "\t    if ($attr[12]) { # backward_arrow == 1"
NSQ_SOURCE_LINE 00000161 "\t\t$line = nextline($fh);"
NSQ_SOURCE_LINE 00000162 "\t\t$line =~ s/^[\\t ]*//;"
NSQ_SOURCE_LINE 00000163 "\t\tpush @attr, (split / /, $line);"
NSQ_SOURCE_LINE 00000164 "\t    } else {"
NSQ_SOURCE_LINE 00000165 "\t\tpush @attr, (undef,undef,undef,undef,undef);"
NSQ_SOURCE_LINE 00000166 "\t    }"
NSQ_SOURCE_LINE 00000167 "\t    "
NSQ_SOURCE_LINE 00000168 "\t    $name =~ s/\\n$//;"
NSQ_SOURCE_LINE 00000169 "\t    if (($name =~ /^\\n*$/) || (defined $self->{objects}->{$name})) {"
NSQ_SOURCE_LINE 00000170 "\t\t$name = sprintf(\"untitled%04d\", $self->{num}++);"
NSQ_SOURCE_LINE 00000171 "\t    }"
NSQ_SOURCE_LINE 00000172 "\t    $object = new Arc($name,@attr,$self);"
NSQ_SOURCE_LINE 00000173 "\t    push @{$current->{arcs}}, $name;"
NSQ_SOURCE_LINE 00000174 "\t    $self->{objects}->{$name} = $object;"
NSQ_SOURCE_LINE 00000175 "\t    $name = \"\";"
NSQ_SOURCE_LINE 00000176 "\t}"
NSQ_SOURCE_LINE 00000177 "\t"
NSQ_SOURCE_LINE 00000178 "\telsif ($object_code eq \"6\") { # Compound"
NSQ_SOURCE_LINE 00000179 "\t    $name =~ s/\\n$//;"
NSQ_SOURCE_LINE 00000180 "\t    if (($name =~ /^\\n*$/) || (defined $self->{objects}->{$name})) {"
NSQ_SOURCE_LINE 00000181 "\t\t$name = sprintf(\"untitled%04d\", $self->{num}++);"
NSQ_SOURCE_LINE 00000182 "\t    }"
NSQ_SOURCE_LINE 00000183 "\t    $object = new Compound($name,@attr,$self);"
NSQ_SOURCE_LINE 00000184 "\t    $object->calculateCenter();"
NSQ_SOURCE_LINE 00000185 "\t    push @{$current->{compounds}}, $name;"
NSQ_SOURCE_LINE 00000186 "\t    $self->{objects}->{$name} = $object;"
NSQ_SOURCE_LINE 00000187 "\t    $name = \"\";"
NSQ_SOURCE_LINE 00000188 "\t    $self->parseObjects(\\*IN,$object);"
NSQ_SOURCE_LINE 00000189 "\t}"
NSQ_SOURCE_LINE 00000190 "\t"
NSQ_SOURCE_LINE 00000191 "\telsif ($object_code eq \"1\") { # Ellipse"
NSQ_SOURCE_LINE 00000192 "\t    $name =~ s/\\n$//;"
NSQ_SOURCE_LINE 00000193 "\t    if (($name =~ /^\\n*$/) || (defined $self->{objects}->{$name})) {"
NSQ_SOURCE_LINE 00000194 "\t\t$name = sprintf(\"untitled%04d\", $self->{num}++);"
NSQ_SOURCE_LINE 00000195 "\t    }"
NSQ_SOURCE_LINE 00000196 "\t    $object = new Ellipse($name,@attr,$self);"
NSQ_SOURCE_LINE 00000197 "\t    push @{$current->{ellipses}}, $name;"
NSQ_SOURCE_LINE 00000198 "\t    $self->{objects}->{$name} = $object;"
NSQ_SOURCE_LINE 00000199 "\t    $name = \"\";"
NSQ_SOURCE_LINE 00000200 "\t}"
NSQ_SOURCE_LINE 00000201 "\t"
NSQ_SOURCE_LINE 00000202 "\telsif ($object_code eq \"2\") { # Polyline"
NSQ_SOURCE_LINE 00000203 "\t    if ($attr[12]) { # forward_arrow == 1"
NSQ_SOURCE_LINE 00000204 "\t\t$line = nextline($fh);"
NSQ_SOURCE_LINE 00000205 "\t\t$line =~ s/^[\\t ]*//;"
NSQ_SOURCE_LINE 00000206 "\t\tpush @attr, (split / /, $line);"
NSQ_SOURCE_LINE 00000207 "\t    } else {"
NSQ_SOURCE_LINE 00000208 "\t\tpush @attr, (undef,undef,undef,undef,undef);"
NSQ_SOURCE_LINE 00000209 "\t    }"
NSQ_SOURCE_LINE 00000210 "\t    "
NSQ_SOURCE_LINE 00000211 "\t    if ($attr[13]) { # backward_arrow == 1"
NSQ_SOURCE_LINE 00000212 "\t\t$line = nextline($fh);"
NSQ_SOURCE_LINE 00000213 "\t\t$line =~ s/^[\\t ]*//;"
NSQ_SOURCE_LINE 00000214 "\t\tpush @attr, (split / /, $line);"
NSQ_SOURCE_LINE 00000215 "\t    } else {"
NSQ_SOURCE_LINE 00000216 "\t\tpush @attr, (undef,undef,undef,undef,undef);"
NSQ_SOURCE_LINE 00000217 "\t    }"
NSQ_SOURCE_LINE 00000218 "\t    "
NSQ_SOURCE_LINE 00000219 "\t    if ($attr[0] == 5) { # sub_type == 5"
NSQ_SOURCE_LINE 00000220 "\t\t$line = nextline($fh);"
NSQ_SOURCE_LINE 00000221 "\t\t$line =~ s/^[\\t ]*//;"
NSQ_SOURCE_LINE 00000222 "\t\tpush @attr, (split / /, $line);"
NSQ_SOURCE_LINE 00000223 "\t    } else {"
NSQ_SOURCE_LINE 00000224 "\t\tpush @attr, (undef,undef);"
NSQ_SOURCE_LINE 00000225 "\t    }"
NSQ_SOURCE_LINE 00000226 "\t    "
NSQ_SOURCE_LINE 00000227 "\t    my $npoints = $attr[14];"
NSQ_SOURCE_LINE 00000228 "\t    my(@xnpoints, @ynpoints);"
NSQ_SOURCE_LINE 00000229 "\t    until ($npoints == 0) {"
NSQ_SOURCE_LINE 00000230 "\t\t$line = nextline($fh);"
NSQ_SOURCE_LINE 00000231 "\t\t$line =~ s/^[\\t ]*//;"
NSQ_SOURCE_LINE 00000232 "\t\tmy @points = split / /, $line;"
NSQ_SOURCE_LINE 00000233 "\t\t$npoints -= (scalar(@points) / 2);"
NSQ_SOURCE_LINE 00000234 "\t\twhile (@points) {"
NSQ_SOURCE_LINE 00000235 "\t\t    push @xnpoints, (shift @points);"
NSQ_SOURCE_LINE 00000236 "\t\t    push @ynpoints, (shift @points);"
NSQ_SOURCE_LINE 00000237 "\t\t}"
NSQ_SOURCE_LINE 00000238 "\t    }"
NSQ_SOURCE_LINE 00000239 "\t    "
NSQ_SOURCE_LINE 00000240 "\t    $name =~ s/\\n$//;"
NSQ_SOURCE_LINE 00000241 "\t    if (($name =~ /^\\n*$/) || (defined $self->{objects}->{$name})) {"
NSQ_SOURCE_LINE 00000242 "\t\t$name = sprintf(\"untitled%04d\", $self->{num}++);"
NSQ_SOURCE_LINE 00000243 "\t    }"
NSQ_SOURCE_LINE 00000244 "\t    $object = new Polyline($name,@attr,\\@xnpoints,\\@ynpoints,$self);"
NSQ_SOURCE_LINE 00000245 "\t    $object->calculateCenter();"
NSQ_SOURCE_LINE 00000246 "\t    push @{$current->{polylines}}, $name;"
NSQ_SOURCE_LINE 00000247 "\t    $self->{objects}->{$name} = $object;"
NSQ_SOURCE_LINE 00000248 "\t    $name = \"\";"
NSQ_SOURCE_LINE 00000249 "\t}"
NSQ_SOURCE_LINE 00000250 "\t"
NSQ_SOURCE_LINE 00000251 "\telsif ($object_code eq \"3\") { # Spline"
NSQ_SOURCE_LINE 00000252 "\t    if ($attr[10]) { # forward_arrow == 1"
NSQ_SOURCE_LINE 00000253 "\t\t$line = nextline($fh);"
NSQ_SOURCE_LINE 00000254 "\t\t$line =~ s/^[\\t ]*//;"
NSQ_SOURCE_LINE 00000255 "\t\tpush @attr, (split / /, $line);"
NSQ_SOURCE_LINE 00000256 "\t    } else {"
NSQ_SOURCE_LINE 00000257 "\t\tpush @attr, (undef,undef,undef,undef,undef);"
NSQ_SOURCE_LINE 00000258 "\t    }"
NSQ_SOURCE_LINE 00000259 "\t    "
NSQ_SOURCE_LINE 00000260 "\t    if ($attr[11]) { # backward_arrow == 1"
NSQ_SOURCE_LINE 00000261 "\t\t$line = nextline($fh);"
NSQ_SOURCE_LINE 00000262 "\t\t$line =~ s/^\\t//;"
NSQ_SOURCE_LINE 00000263 "\t\tpush @attr, (split / /, $line);"
NSQ_SOURCE_LINE 00000264 "\t    } else {"
NSQ_SOURCE_LINE 00000265 "\t\tpush @attr, (undef,undef,undef,undef,undef);"
NSQ_SOURCE_LINE 00000266 "\t    }"
NSQ_SOURCE_LINE 00000267 "\t    "
NSQ_SOURCE_LINE 00000268 "\t    my $npoints = $attr[12];"
NSQ_SOURCE_LINE 00000269 "\t    my(@xnpoints, @ynpoints);"
NSQ_SOURCE_LINE 00000270 "\t    until ($npoints == 0) {"
NSQ_SOURCE_LINE 00000271 "\t\t$line = nextline($fh);"
NSQ_SOURCE_LINE 00000272 "\t\t$line =~ s/^[\\t ]*//;"
NSQ_SOURCE_LINE 00000273 "\t\tmy @points = split / /, $line;"
NSQ_SOURCE_LINE 00000274 "\t\t$npoints -= (scalar(@points) / 2);"
NSQ_SOURCE_LINE 00000275 "\t\twhile (@points) {"
NSQ_SOURCE_LINE 00000276 "\t\t    push @xnpoints, (shift @points);"
NSQ_SOURCE_LINE 00000277 "\t\t    push @ynpoints, (shift @points);"
NSQ_SOURCE_LINE 00000278 "\t\t}"
NSQ_SOURCE_LINE 00000279 "\t    }"
NSQ_SOURCE_LINE 00000280 "\t    "
NSQ_SOURCE_LINE 00000281 "\t    $npoints = $attr[12];"
NSQ_SOURCE_LINE 00000282 "\t    my @control_points;"
NSQ_SOURCE_LINE 00000283 "\t    until ($npoints == 0) {"
NSQ_SOURCE_LINE 00000284 "\t\t$line = nextline($fh);"
NSQ_SOURCE_LINE 00000285 "\t\t$line =~ s/^[\\t ]*//;"
NSQ_SOURCE_LINE 00000286 "\t\tmy @points = split / /, $line;"
NSQ_SOURCE_LINE 00000287 "\t\t$npoints -= scalar(@points);"
NSQ_SOURCE_LINE 00000288 "\t\tpush @control_points, @points;"
NSQ_SOURCE_LINE 00000289 "\t    }"
NSQ_SOURCE_LINE 00000290 "\t    "
NSQ_SOURCE_LINE 00000291 "\t    $name =~ s/\\n$//;"
NSQ_SOURCE_LINE 00000292 "\t    if (($name =~ /^\\n*$/) || (defined $self->{objects}->{$name})) {"
NSQ_SOURCE_LINE 00000293 "\t\t$name = sprintf(\"untitled%04d\", $self->{num}++);"
NSQ_SOURCE_LINE 00000294 "\t    }"
NSQ_SOURCE_LINE 00000295 "\t    $object = new Spline($name,@attr,\\@xnpoints,\\@ynpoints,"
NSQ_SOURCE_LINE 00000296 "\t\t\t\t \\@control_points,$self);"
NSQ_SOURCE_LINE 00000297 "\t    $object->calculateCenter();"
NSQ_SOURCE_LINE 00000298 "\t    push @{$current->{splines}}, $name;"
NSQ_SOURCE_LINE 00000299 "\t    $self->{objects}->{$name} = $object;"
NSQ_SOURCE_LINE 00000300 "\t    $name = \"\";"
NSQ_SOURCE_LINE 00000301 "\t}"
NSQ_SOURCE_LINE 00000302 "\t"
NSQ_SOURCE_LINE 00000303 "\telsif ($object_code eq \"4\") { # Text"
NSQ_SOURCE_LINE 00000304 "\t    my @new_attr = @attr[0..11];"
