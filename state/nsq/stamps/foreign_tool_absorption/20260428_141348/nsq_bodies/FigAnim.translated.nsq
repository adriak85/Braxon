NSQ_SOURCE_LINE 00000094 "# parser"
NSQ_SOURCE_LINE 00000095 "sub parseFile {"
NSQ_SOURCE_LINE 00000096 "    my $self = shift;"
NSQ_SOURCE_LINE 00000097 "    my $filename = shift;"
NSQ_SOURCE_LINE 00000098 "    "
NSQ_SOURCE_LINE 00000099 "    open IN, \"<$filename\" or die \"Can't open $filename : $!\\n\";"
NSQ_SOURCE_LINE 00000100 "    "
NSQ_SOURCE_LINE 00000101 "    $self->parseHeader(\\*IN);"
NSQ_SOURCE_LINE 00000102 "    $self->parseObjects(\\*IN,$self);"
NSQ_SOURCE_LINE 00000103 "    "
NSQ_SOURCE_LINE 00000104 "    close IN;"
NSQ_SOURCE_LINE 00000105 "}"
