NSQ_SOURCE_LINE 00001122 "# objects selectors"
NSQ_SOURCE_LINE 00001123 "sub selectByType {"
NSQ_SOURCE_LINE 00001124 "    my $self = shift;"
NSQ_SOURCE_LINE 00001125 "    my $res = new Compound(\"\",0,0,0,0,$self);"
NSQ_SOURCE_LINE 00001126 "    "
NSQ_SOURCE_LINE 00001127 "    foreach (@_) {"
NSQ_SOURCE_LINE 00001128 "\tpush @{$res->{$_}}, @{$self->{$_}};"
NSQ_SOURCE_LINE 00001129 "    }"
NSQ_SOURCE_LINE 00001130 "    "
NSQ_SOURCE_LINE 00001131 "    foreach (@{$self->{compounds}}) {"
NSQ_SOURCE_LINE 00001132 "\tmy $aux = $self->{objects}->{$_}->selectByType(@_);"
NSQ_SOURCE_LINE 00001133 "\tforeach (@_) {"
NSQ_SOURCE_LINE 00001134 "\t    push @{$res->{$_}}, @{$aux->{$_}};"
NSQ_SOURCE_LINE 00001135 "\t}"
NSQ_SOURCE_LINE 00001136 "    }"
NSQ_SOURCE_LINE 00001137 "    "
NSQ_SOURCE_LINE 00001138 "    return $res;"
NSQ_SOURCE_LINE 00001139 "}"
