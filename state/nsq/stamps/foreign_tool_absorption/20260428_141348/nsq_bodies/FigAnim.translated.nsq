NSQ_SOURCE_LINE 00001521 "\t$self->{objects}->{$name}->{animations}[$last][2] = $dur; # dur"
NSQ_SOURCE_LINE 00001522 "\t$self->{objects}->{$name}->{animations}[$last][3] = $x; # x"
NSQ_SOURCE_LINE 00001523 "\t$self->{objects}->{$name}->{animations}[$last][4] = $y; # y"
NSQ_SOURCE_LINE 00001524 "\t$self->{objects}->{$name}->{animations}[$last][5] = $unit; # unit"
NSQ_SOURCE_LINE 00001525 "    }"
NSQ_SOURCE_LINE 00001526 ""
NSQ_SOURCE_LINE 00001527 "    for ($i = 0; $i <= $#rotate; $i++) {"
NSQ_SOURCE_LINE 00001528 "\tmy $type = $rotate[$i][0];"
NSQ_SOURCE_LINE 00001529 "\tmy $name = $rotate[$i][1];"
NSQ_SOURCE_LINE 00001530 "\tmy $begin = $rotate[$i][2];"
NSQ_SOURCE_LINE 00001531 "\tmy $dur = $rotate[$i][3];"
NSQ_SOURCE_LINE 00001532 "\tmy $angle = $rotate[$i][4];"
NSQ_SOURCE_LINE 00001533 "\tmy $x = $rotate[$i][5];"
NSQ_SOURCE_LINE 00001534 "\tmy $y = $rotate[$i][6];"
NSQ_SOURCE_LINE 00001535 "\tmy $unit = $rotate[$i][7];"
NSQ_SOURCE_LINE 00001536 ""
NSQ_SOURCE_LINE 00001537 "\tmy $last = $#{$self->{objects}->{$name}->{animations}} + 1;"
NSQ_SOURCE_LINE 00001538 ""
NSQ_SOURCE_LINE 00001539 "\t$self->{objects}->{$name}->{animations}[$last][0] = $type; # type"
NSQ_SOURCE_LINE 00001540 "\t$self->{objects}->{$name}->{animations}[$last][1] = $begin; # begin"
NSQ_SOURCE_LINE 00001541 "\t$self->{objects}->{$name}->{animations}[$last][2] = $dur; # dur"
NSQ_SOURCE_LINE 00001542 "\t$self->{objects}->{$name}->{animations}[$last][3] = $angle; # angle"
NSQ_SOURCE_LINE 00001543 "\t$self->{objects}->{$name}->{animations}[$last][4] = $x; # x"
NSQ_SOURCE_LINE 00001544 "\t$self->{objects}->{$name}->{animations}[$last][5] = $y; # y"
NSQ_SOURCE_LINE 00001545 "\t$self->{objects}->{$name}->{animations}[$last][6] = $unit; # unit"
NSQ_SOURCE_LINE 00001546 "    }"
NSQ_SOURCE_LINE 00001547 ""
NSQ_SOURCE_LINE 00001548 "    for ($i = 0; $i <= $#scale; $i++) {"
NSQ_SOURCE_LINE 00001549 "\tmy $type = $scale[$i][0];"
NSQ_SOURCE_LINE 00001550 "\tmy $name = $scale[$i][1];"
NSQ_SOURCE_LINE 00001551 "\tmy $begin = $scale[$i][2];"
NSQ_SOURCE_LINE 00001552 "\tmy $dur = $scale[$i][3];"
NSQ_SOURCE_LINE 00001553 "\tmy $factor = $scale[$i][4];"
NSQ_SOURCE_LINE 00001554 "\tmy $x = $scale[$i][5];"
NSQ_SOURCE_LINE 00001555 "\tmy $y = $scale[$i][6];"
NSQ_SOURCE_LINE 00001556 ""
NSQ_SOURCE_LINE 00001557 "\tmy $last = $#{$self->{objects}->{$name}->{animations}} + 1;"
NSQ_SOURCE_LINE 00001558 ""
NSQ_SOURCE_LINE 00001559 "\t$self->{objects}->{$name}->{animations}[$last][0] = $type; # type"
NSQ_SOURCE_LINE 00001560 "\t$self->{objects}->{$name}->{animations}[$last][1] = $begin; # begin"
NSQ_SOURCE_LINE 00001561 "\t$self->{objects}->{$name}->{animations}[$last][2] = $dur; # dur"
NSQ_SOURCE_LINE 00001562 "\t$self->{objects}->{$name}->{animations}[$last][3] = $factor; # factor"
NSQ_SOURCE_LINE 00001563 "\t$self->{objects}->{$name}->{animations}[$last][4] = $x; # x"
NSQ_SOURCE_LINE 00001564 "\t$self->{objects}->{$name}->{animations}[$last][5] = $y; # y"
NSQ_SOURCE_LINE 00001565 "    }"
NSQ_SOURCE_LINE 00001566 ""
NSQ_SOURCE_LINE 00001567 "    $self->writeSVGObjects($fh);"
NSQ_SOURCE_LINE 00001568 "}"
NSQ_SOURCE_LINE 00001569 ""
NSQ_SOURCE_LINE 00001570 ""
NSQ_SOURCE_LINE 00001571 "# useful functions"
NSQ_SOURCE_LINE 00001572 "sub nextline {"
NSQ_SOURCE_LINE 00001573 "    my $fh = shift;"
NSQ_SOURCE_LINE 00001574 "    if (eof $fh) {"
NSQ_SOURCE_LINE 00001575 "\treturn;"
NSQ_SOURCE_LINE 00001576 "    }"
NSQ_SOURCE_LINE 00001577 "    "
NSQ_SOURCE_LINE 00001578 "    my $line = <$fh>;"
NSQ_SOURCE_LINE 00001579 "    $line = nextline($fh) if ($line eq \"\\n\");"
NSQ_SOURCE_LINE 00001580 "    chomp $line;"
NSQ_SOURCE_LINE 00001581 "    return $line;"
NSQ_SOURCE_LINE 00001582 "}"
NSQ_SOURCE_LINE 00001583 ""
NSQ_SOURCE_LINE 00001584 ""
NSQ_SOURCE_LINE 00001585 "1;"
NSQ_SOURCE_LINE 00001586 "__END__"
NSQ_SOURCE_LINE 00001587 ""
NSQ_SOURCE_LINE 00001588 "=head1 NAME"
NSQ_SOURCE_LINE 00001589 ""
NSQ_SOURCE_LINE 00001590 "FigAnim - A XFig file animator class"
NSQ_SOURCE_LINE 00001591 ""
NSQ_SOURCE_LINE 00001592 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00001593 ""
NSQ_SOURCE_LINE 00001594 "Here is a simple example where we first parse a file \"file.fig\"."
NSQ_SOURCE_LINE 00001595 "This file is supposed to contain an object named \"Square\""
NSQ_SOURCE_LINE 00001596 "(in XFig the name of an object is it's commentary)."
NSQ_SOURCE_LINE 00001597 "Then this object translates according to vector (50px, 25px),"
NSQ_SOURCE_LINE 00001598 "the animation starts at t=0 second and it's duration is 1 second."
NSQ_SOURCE_LINE 00001599 "In the end we generate an animated GIF file named \"anim.gif\","
NSQ_SOURCE_LINE 00001600 "and a SVG+SMIL file named \"anim.svg\"."
NSQ_SOURCE_LINE 00001601 ""
NSQ_SOURCE_LINE 00001602 "    use FigAnim;"
NSQ_SOURCE_LINE 00001603 ""
NSQ_SOURCE_LINE 00001604 "    $fig_anim = new FigAnim;"
NSQ_SOURCE_LINE 00001605 "    $fig_anim->parseFile(\"file.fig\");"
NSQ_SOURCE_LINE 00001606 ""
NSQ_SOURCE_LINE 00001607 "    $fig_anim->{objects}->{Square}->translate(0, 1, 50, 25, 'px');"
NSQ_SOURCE_LINE 00001608 ""
NSQ_SOURCE_LINE 00001609 "    $fig_anim->generateGif(\"anim.gif\", 12, 0);"
NSQ_SOURCE_LINE 00001610 "    $fig_anim->generateSMIL(\"anim.svg\");"
NSQ_SOURCE_LINE 00001611 ""
NSQ_SOURCE_LINE 00001612 "=head1 ABSTRACT"
NSQ_SOURCE_LINE 00001613 ""
NSQ_SOURCE_LINE 00001614 "FigAnim is a package which takes an existing FIG file"
NSQ_SOURCE_LINE 00001615 "(made by the XFig vector drawing program for example)"
NSQ_SOURCE_LINE 00001616 "and generates animations in animated GIF format and/or in SVG+SMIL format."
NSQ_SOURCE_LINE 00001617 ""
NSQ_SOURCE_LINE 00001618 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00001619 ""
NSQ_SOURCE_LINE 00001620 "Here are all the methods you can use in the package FigAnim :"
NSQ_SOURCE_LINE 00001621 ""
NSQ_SOURCE_LINE 00001622 "B<new(), parseFile(), writeFile(), setAttributevalue(), setPenColor(),"
NSQ_SOURCE_LINE 00001623 "setFillColor(), hide(), show(), changeThickness(), changeFillIntensity(),"
NSQ_SOURCE_LINE 00001624 "scale(), translate(), rotate(), generateGIF(), writeSVGfile(), generateSMIL(),"
NSQ_SOURCE_LINE 00001625 "selectByType(), selectByPenColor(), selectByFillColor(),"
NSQ_SOURCE_LINE 00001626 "selectByAttributeValue()>"
NSQ_SOURCE_LINE 00001627 ""
NSQ_SOURCE_LINE 00001628 "The time unit used for every animation is in B<seconds>."
NSQ_SOURCE_LINE 00001629 ""
NSQ_SOURCE_LINE 00001630 "=head2 BASIC COMMANDS"
NSQ_SOURCE_LINE 00001631 ""
NSQ_SOURCE_LINE 00001632 "=over"
NSQ_SOURCE_LINE 00001633 ""
NSQ_SOURCE_LINE 00001634 "=item new()"
NSQ_SOURCE_LINE 00001635 ""
NSQ_SOURCE_LINE 00001636 "Creates a new instance of the class FigAnim."
NSQ_SOURCE_LINE 00001637 "Every animation B<must> begin with these two lines:"
NSQ_SOURCE_LINE 00001638 ""
NSQ_SOURCE_LINE 00001639 "    use FigAnim;"
NSQ_SOURCE_LINE 00001640 "    $fig_anim = new FigAnim;"
NSQ_SOURCE_LINE 00001641 ""
NSQ_SOURCE_LINE 00001642 "=item parseFile()"
NSQ_SOURCE_LINE 00001643 ""
NSQ_SOURCE_LINE 00001644 "Parses the file given in parameter, for example:"
NSQ_SOURCE_LINE 00001645 ""
NSQ_SOURCE_LINE 00001646 "    $fig_anim->parseFile(\"file.fig\");"
NSQ_SOURCE_LINE 00001647 ""
NSQ_SOURCE_LINE 00001648 "where \"file.fig\" is a correct FIG file."
NSQ_SOURCE_LINE 00001649 ""
NSQ_SOURCE_LINE 00001650 "=item writeFile()"
NSQ_SOURCE_LINE 00001651 ""
NSQ_SOURCE_LINE 00001652 "Writes a new FIG file from another parsed FIG file."
NSQ_SOURCE_LINE 00001653 "This method is only used for testing purpose (to test the identity). Example:"
NSQ_SOURCE_LINE 00001654 ""
NSQ_SOURCE_LINE 00001655 "    $fig_anim->writeFile(\"another_file.fig\");"
NSQ_SOURCE_LINE 00001656 ""
NSQ_SOURCE_LINE 00001657 "=back"
NSQ_SOURCE_LINE 00001658 ""
NSQ_SOURCE_LINE 00001659 "=head2 SET"
NSQ_SOURCE_LINE 00001660 ""
NSQ_SOURCE_LINE 00001661 "=over"
NSQ_SOURCE_LINE 00001662 ""
NSQ_SOURCE_LINE 00001663 "=item setAttributeValue()"
NSQ_SOURCE_LINE 00001664 ""
NSQ_SOURCE_LINE 00001665 "This method sets an attribute value of an object at a given time,"
NSQ_SOURCE_LINE 00001666 "without any interpolation. For example, if we have in our FIG file"
NSQ_SOURCE_LINE 00001667 "an object named \"Square\":"
NSQ_SOURCE_LINE 00001668 ""
NSQ_SOURCE_LINE 00001669 "    $fig_anim->{objects}->{Square}->setAttributeValue(3, 'thickness', 2);"
NSQ_SOURCE_LINE 00001670 ""
NSQ_SOURCE_LINE 00001671 "sets the attribute \"thickness\" of object \"Square\" to 2 at instant t=3 seconds."
NSQ_SOURCE_LINE 00001672 ""
NSQ_SOURCE_LINE 00001673 "=item setPenColor()"
NSQ_SOURCE_LINE 00001674 ""
NSQ_SOURCE_LINE 00001675 "Example:"
NSQ_SOURCE_LINE 00001676 ""
NSQ_SOURCE_LINE 00001677 "    $fig_anim->{objects}->{Square}->setPenColor(4, 'Green4');"
NSQ_SOURCE_LINE 00001678 ""
NSQ_SOURCE_LINE 00001679 "this command modifies the object's pen color to a color called Green4 (in XFig)"
NSQ_SOURCE_LINE 00001680 "at instant t=4s, without any interpolation."
NSQ_SOURCE_LINE 00001681 ""
NSQ_SOURCE_LINE 00001682 "=item setFillColor()"
NSQ_SOURCE_LINE 00001683 ""
NSQ_SOURCE_LINE 00001684 "Example:"
NSQ_SOURCE_LINE 00001685 ""
NSQ_SOURCE_LINE 00001686 "    $fig_anim->{objects}->{Square}->setFillColor(5, 'Green4');"
NSQ_SOURCE_LINE 00001687 ""
NSQ_SOURCE_LINE 00001688 "similar to previous method, but modifies fill color instead of pen color"
NSQ_SOURCE_LINE 00001689 "at t=5s."
NSQ_SOURCE_LINE 00001690 ""
NSQ_SOURCE_LINE 00001691 "=back"
NSQ_SOURCE_LINE 00001692 ""
NSQ_SOURCE_LINE 00001693 "=head2 HIDE/SHOW"
NSQ_SOURCE_LINE 00001694 ""
NSQ_SOURCE_LINE 00001695 "=over"
NSQ_SOURCE_LINE 00001696 ""
NSQ_SOURCE_LINE 00001697 "=item hide()"
NSQ_SOURCE_LINE 00001698 ""
NSQ_SOURCE_LINE 00001699 "Example:"
NSQ_SOURCE_LINE 00001700 ""
NSQ_SOURCE_LINE 00001701 "    $fig_anim->{objects}->{Square}->hide(3);"
NSQ_SOURCE_LINE 00001702 ""
NSQ_SOURCE_LINE 00001703 "this command hides an object named \"Square\" at instant t=3s."
NSQ_SOURCE_LINE 00001704 ""
NSQ_SOURCE_LINE 00001705 "=item show()"
NSQ_SOURCE_LINE 00001706 ""
NSQ_SOURCE_LINE 00001707 "Example:"
NSQ_SOURCE_LINE 00001708 ""
NSQ_SOURCE_LINE 00001709 "    $fig_anim->{objects}->{Square}->hide(4);"
NSQ_SOURCE_LINE 00001710 ""
NSQ_SOURCE_LINE 00001711 "this command makes an object named \"Square\" appear at instant t=4s."
NSQ_SOURCE_LINE 00001712 ""
NSQ_SOURCE_LINE 00001713 "=back"
NSQ_SOURCE_LINE 00001714 ""
NSQ_SOURCE_LINE 00001715 "=head2 CHANGE"
NSQ_SOURCE_LINE 00001716 ""
NSQ_SOURCE_LINE 00001717 "=over"
NSQ_SOURCE_LINE 00001718 ""
NSQ_SOURCE_LINE 00001719 "=item changeThickness()"
NSQ_SOURCE_LINE 00001720 ""
NSQ_SOURCE_LINE 00001721 "Example:"
NSQ_SOURCE_LINE 00001722 ""
NSQ_SOURCE_LINE 00001723 "    $fig_anim->{objects}->{Square}->changeThickness(0, 1, 7);"
NSQ_SOURCE_LINE 00001724 ""
NSQ_SOURCE_LINE 00001725 "animates (with linear interpolation)"
NSQ_SOURCE_LINE 00001726 "the thickness of an object named \"Square\" from time t=0s for a duration of 1s."
NSQ_SOURCE_LINE 00001727 "The thickness will have a value of 7 at the end of the animation. "
NSQ_SOURCE_LINE 00001728 ""
NSQ_SOURCE_LINE 00001729 "=item changeFillIntensity()"
NSQ_SOURCE_LINE 00001730 ""
NSQ_SOURCE_LINE 00001731 "Example:"
NSQ_SOURCE_LINE 00001732 ""
NSQ_SOURCE_LINE 00001733 "    $fig_anim->{objects}->{Square}->changeFillIntensity(2, 1, 0);"
NSQ_SOURCE_LINE 00001734 ""
NSQ_SOURCE_LINE 00001735 "animates (with linear interpolation)"
NSQ_SOURCE_LINE 00001736 "the fill intensity of an object named \"Square\" from time t=2s"
NSQ_SOURCE_LINE 00001737 "for a duration of 1s."
NSQ_SOURCE_LINE 00001738 "The intensity will have a value of 0 at the end of the animation."
NSQ_SOURCE_LINE 00001739 "The intensity must be a number between 0 (black) and 20"
NSQ_SOURCE_LINE 00001740 "(full saturation of the color)."
NSQ_SOURCE_LINE 00001741 "In the example the object becomes darker and darker until it becomes black."
NSQ_SOURCE_LINE 00001742 ""
NSQ_SOURCE_LINE 00001743 "=item scale()"
NSQ_SOURCE_LINE 00001744 ""
NSQ_SOURCE_LINE 00001745 "Example:"
NSQ_SOURCE_LINE 00001746 ""
NSQ_SOURCE_LINE 00001747 "    $fig_anim->{objects}->{Arc}->scale(0, 1, 1.2);"
NSQ_SOURCE_LINE 00001748 ""
NSQ_SOURCE_LINE 00001749 "scales the object named \"Arc\" from time t=0s"
NSQ_SOURCE_LINE 00001750 "for a duration of 1s according to scale factor 1.2."
NSQ_SOURCE_LINE 00001751 "The center of the scale is the center of the object."
NSQ_SOURCE_LINE 00001752 ""
NSQ_SOURCE_LINE 00001753 "=back"
NSQ_SOURCE_LINE 00001754 ""
NSQ_SOURCE_LINE 00001755 "=head2 MOVEMENTS"
NSQ_SOURCE_LINE 00001756 ""
NSQ_SOURCE_LINE 00001757 "=over"
NSQ_SOURCE_LINE 00001758 ""
NSQ_SOURCE_LINE 00001759 "=item translate()"
NSQ_SOURCE_LINE 00001760 ""
NSQ_SOURCE_LINE 00001761 "Example:"
NSQ_SOURCE_LINE 00001762 ""
NSQ_SOURCE_LINE 00001763 "    $fig_anim->{objects}->{Square}->translate(0, 1, 2, 3, 'in');"
NSQ_SOURCE_LINE 00001764 ""
NSQ_SOURCE_LINE 00001765 "translates the object named \"Square\" from time t=0s"
NSQ_SOURCE_LINE 00001766 "for a duration of 1s according to vector (2in, 3in)."
NSQ_SOURCE_LINE 00001767 "Possible values for units (last parameter) are 'in', 'cm' or 'px'."
NSQ_SOURCE_LINE 00001768 "Units are Fig units if none specified."
NSQ_SOURCE_LINE 00001769 ""
NSQ_SOURCE_LINE 00001770 "=item rotate()"
NSQ_SOURCE_LINE 00001771 ""
NSQ_SOURCE_LINE 00001772 "Example:"
NSQ_SOURCE_LINE 00001773 ""
NSQ_SOURCE_LINE 00001774 "    $fig_anim->{objects}->{Arc}->rotate(0, 1, -330);"
NSQ_SOURCE_LINE 00001775 ""
NSQ_SOURCE_LINE 00001776 "rotates the object named \"Arc\" from time t=0s"
NSQ_SOURCE_LINE 00001777 "for a duration of 1s according to rotation angle -330 degrees."
NSQ_SOURCE_LINE 00001778 "In this case the center of the rotation is the center of the object."
NSQ_SOURCE_LINE 00001779 ""
NSQ_SOURCE_LINE 00001780 "    $fig_anim->{objects}->{Ellipse}->rotate(0, 1, -330, 2, 3,'in');"
NSQ_SOURCE_LINE 00001781 ""
NSQ_SOURCE_LINE 00001782 "rotates the object named \"Arc\" from time t=0s"
NSQ_SOURCE_LINE 00001783 "for a duration of 1s according to rotation angle -330 degrees."
NSQ_SOURCE_LINE 00001784 "In this case the center of the rotation is point (2in, 3in)."
NSQ_SOURCE_LINE 00001785 "Possible values for units (last parameter) are 'in', 'cm' or 'px'."
NSQ_SOURCE_LINE 00001786 "Units are Fig units if none specified."
NSQ_SOURCE_LINE 00001787 ""
NSQ_SOURCE_LINE 00001788 "=back"
NSQ_SOURCE_LINE 00001789 ""
NSQ_SOURCE_LINE 00001790 "=head2 FILE GENERATION"
NSQ_SOURCE_LINE 00001791 ""
NSQ_SOURCE_LINE 00001792 "=over"
NSQ_SOURCE_LINE 00001793 ""
NSQ_SOURCE_LINE 00001794 "=item generateGif()"
NSQ_SOURCE_LINE 00001795 ""
NSQ_SOURCE_LINE 00001796 "Example:"
NSQ_SOURCE_LINE 00001797 ""
NSQ_SOURCE_LINE 00001798 "    $fig_anim->generateGif(\"anim.gif\", 10, 1);"
NSQ_SOURCE_LINE 00001799 ""
NSQ_SOURCE_LINE 00001800 "generates an animated GIF file named \"anim.gif\" with 10 frames per second,"
NSQ_SOURCE_LINE 00001801 "with only one loop (1). If you put a higher number of frames,"
NSQ_SOURCE_LINE 00001802 "the animation will be smoother but will take more time"
NSQ_SOURCE_LINE 00001803 "to be generated and the file size will be bigger."
NSQ_SOURCE_LINE 00001804 "If you put a lower number of frames, the file will be generated faster"
NSQ_SOURCE_LINE 00001805 "and it's size will be smaller but the animation will be less smooth."
NSQ_SOURCE_LINE 00001806 ""
NSQ_SOURCE_LINE 00001807 "Another example:"
NSQ_SOURCE_LINE 00001808 ""
NSQ_SOURCE_LINE 00001809 "    $fig_anim->generateGif(\"anim.gif\", 10, 0, 1);"
NSQ_SOURCE_LINE 00001810 ""
NSQ_SOURCE_LINE 00001811 "generates a GIF file named \"anim.gif\" with 10 frames per second,"
NSQ_SOURCE_LINE 00001812 "with infinite loop (0), and waits for 1s at the end of each loop."
NSQ_SOURCE_LINE 00001813 "The last parameter is optional, if ommited its value is 0 (no waiting).  "
NSQ_SOURCE_LINE 00001814 ""
NSQ_SOURCE_LINE 00001815 "=item writeSVGfile()"
NSQ_SOURCE_LINE 00001816 ""
NSQ_SOURCE_LINE 00001817 "Example:"
NSQ_SOURCE_LINE 00001818 "    $fig_anim->writeSVGFile(\"file.svg\");"
NSQ_SOURCE_LINE 00001819 ""
NSQ_SOURCE_LINE 00001820 "generates a SVG file named \"file.svg\" from a FIG file."
NSQ_SOURCE_LINE 00001821 "This is a graphic filter with no animations."
NSQ_SOURCE_LINE 00001822 ""
NSQ_SOURCE_LINE 00001823 "=item generateSMIL()"
NSQ_SOURCE_LINE 00001824 ""
NSQ_SOURCE_LINE 00001825 "Example:"
NSQ_SOURCE_LINE 00001826 ""
NSQ_SOURCE_LINE 00001827 "    $fig_anim->generateSMIL(\"file.svg\");"
NSQ_SOURCE_LINE 00001828 ""
NSQ_SOURCE_LINE 00001829 "generates a SVG+SMIL file named \"file.svg\","
NSQ_SOURCE_LINE 00001830 "it is an animated SVG file with SMIL tags."
NSQ_SOURCE_LINE 00001831 "For now only the Adobe SVG plugin can display animated SVG+SMIL files."
NSQ_SOURCE_LINE 00001832 ""
NSQ_SOURCE_LINE 00001833 "=back"
NSQ_SOURCE_LINE 00001834 ""
NSQ_SOURCE_LINE 00001835 "=head2 SELECT OBJECTS"
NSQ_SOURCE_LINE 00001836 ""
NSQ_SOURCE_LINE 00001837 "You can select objects by there type, pen color, fill color or attribute value"
NSQ_SOURCE_LINE 00001838 "and apply an animation to the selected object(s)."
NSQ_SOURCE_LINE 00001839 "Also, you can put as many parameters as you want in each select method"
NSQ_SOURCE_LINE 00001840 "(as you can see in Example2)."
NSQ_SOURCE_LINE 00001841 "You can also apply a selector on a compound object."
NSQ_SOURCE_LINE 00001842 "Many selectors can be applied successively. "
NSQ_SOURCE_LINE 00001843 ""
NSQ_SOURCE_LINE 00001844 "=over"
NSQ_SOURCE_LINE 00001845 ""
NSQ_SOURCE_LINE 00001846 "=item selectByType()"
NSQ_SOURCE_LINE 00001847 ""
NSQ_SOURCE_LINE 00001848 "Example1:"
NSQ_SOURCE_LINE 00001849 ""
NSQ_SOURCE_LINE 00001850 "    $fig_anim->selectByType(\"polylines\")->hide(1);"
NSQ_SOURCE_LINE 00001851 ""
NSQ_SOURCE_LINE 00001852 "hides all objects of type polylines (as defined in XFig) at t=1s."
NSQ_SOURCE_LINE 00001853 ""
NSQ_SOURCE_LINE 00001854 "=item selectByPenColor()"
NSQ_SOURCE_LINE 00001855 ""
NSQ_SOURCE_LINE 00001856 "Example2:"
NSQ_SOURCE_LINE 00001857 ""
NSQ_SOURCE_LINE 00001858 "    $fig_anim->selectByPenColor(\"Red\", \"Blue\")->hide(1);"
NSQ_SOURCE_LINE 00001859 ""
NSQ_SOURCE_LINE 00001860 "hides all objects with \"Red\" or \"Blue\" line (as defined in XFig) at t=1s."
NSQ_SOURCE_LINE 00001861 ""
NSQ_SOURCE_LINE 00001862 "=item selectByFillColor()"
NSQ_SOURCE_LINE 00001863 ""
NSQ_SOURCE_LINE 00001864 "Example3:"
NSQ_SOURCE_LINE 00001865 ""
NSQ_SOURCE_LINE 00001866 "    $fig_anim->selectByFillColor(\"White\")->hide(1);"
NSQ_SOURCE_LINE 00001867 ""
NSQ_SOURCE_LINE 00001868 "hides all objects filled with \"White\" color (as defined in XFig) at t=1s."
NSQ_SOURCE_LINE 00001869 ""
NSQ_SOURCE_LINE 00001870 "=item selectByAttributeValue()"
NSQ_SOURCE_LINE 00001871 ""
NSQ_SOURCE_LINE 00001872 "Example4:"
NSQ_SOURCE_LINE 00001873 ""
NSQ_SOURCE_LINE 00001874 "    $fig_anim->selectByAttributeValue(\"thickness\", 1)->hide(1);"
NSQ_SOURCE_LINE 00001875 ""
NSQ_SOURCE_LINE 00001876 "hides all objects with thickness value 1 (as defined in XFig) at t=1s."
NSQ_SOURCE_LINE 00001877 ""
NSQ_SOURCE_LINE 00001878 "Example5: multiple selections:"
NSQ_SOURCE_LINE 00001879 ""
NSQ_SOURCE_LINE 00001880 "    $fig_anim"
NSQ_SOURCE_LINE 00001881 "    ->selectByPenColor(\"Red\",\"Blue\")"
NSQ_SOURCE_LINE 00001882 "    ->selectByType(\"polylines\")"
NSQ_SOURCE_LINE 00001883 "    ->hide(1);"
NSQ_SOURCE_LINE 00001884 ""
NSQ_SOURCE_LINE 00001885 "hides all polylines with \"Red\" or \"Blue\" line (as defined in XFig) at t=1s."
NSQ_SOURCE_LINE 00001886 "=back"
NSQ_SOURCE_LINE 00001887 ""
NSQ_SOURCE_LINE 00001888 "=head2 AVAILABLE COLORS"
NSQ_SOURCE_LINE 00001889 ""
NSQ_SOURCE_LINE 00001890 "Background, None, Default, Black, Blue, Green, Cyan, Red, Magenta, Yellow,"
NSQ_SOURCE_LINE 00001891 "White, Blue4, Blue3,Blue2, LtBlue, Green4, Green3, Green2, Cyan4, Cyan3, Cyan2,"
NSQ_SOURCE_LINE 00001892 "Red4, Red3, Red2, Magenta4, Magenta3, Magenta2, Brown4, Brown3, Brown2, Pink4,"
NSQ_SOURCE_LINE 00001893 "Pink3, Pink2, Pink, Gold"
NSQ_SOURCE_LINE 00001894 ""
NSQ_SOURCE_LINE 00001895 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00001896 ""
NSQ_SOURCE_LINE 00001897 "FigAnim::Arc, FigAnim::Color, FigAnim::Compound, FigAnim::Ellipse,"
NSQ_SOURCE_LINE 00001898 "FigAnim::Polyline, FigAnim::Spline, FigAnim::Text."
NSQ_SOURCE_LINE 00001899 ""
NSQ_SOURCE_LINE 00001900 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00001901 ""
