NSQ_SOURCE_LINE 00001141 "sub selectByPenColor {"
NSQ_SOURCE_LINE 00001142 "    my $self = shift;"
NSQ_SOURCE_LINE 00001143 "    my $res = new Compound(\"\",0,0,0,0,$self);"
NSQ_SOURCE_LINE 00001144 "    "
NSQ_SOURCE_LINE 00001145 "    foreach (@_) {"
NSQ_SOURCE_LINE 00001146 "\tmy $color = $FigAnim::Utils::colors_codes{$_};"
NSQ_SOURCE_LINE 00001147 "\tif (defined $color) {"
NSQ_SOURCE_LINE 00001148 "\t    foreach (@{$self->{arcs}}) {"
NSQ_SOURCE_LINE 00001149 "\t\tif ($self->{objects}->{$_}->{pen_color} == $color) {"
NSQ_SOURCE_LINE 00001150 "\t\t    push @{$res->{arcs}}, $_;"
NSQ_SOURCE_LINE 00001151 "\t\t}"
NSQ_SOURCE_LINE 00001152 "\t    }"
NSQ_SOURCE_LINE 00001153 "\t    foreach (@{$self->{ellipses}}) {"
NSQ_SOURCE_LINE 00001154 "\t\tif ($self->{objects}->{$_}->{pen_color} == $color) {"
NSQ_SOURCE_LINE 00001155 "\t\t    push @{$res->{ellipses}}, $_;"
NSQ_SOURCE_LINE 00001156 "\t\t}"
NSQ_SOURCE_LINE 00001157 "\t    }"
NSQ_SOURCE_LINE 00001158 "\t    foreach (@{$self->{polylines}}) {"
NSQ_SOURCE_LINE 00001159 "\t\tif ($self->{objects}->{$_}->{pen_color} == $color) {"
NSQ_SOURCE_LINE 00001160 "\t\t    push @{$res->{polylines}}, $_;"
NSQ_SOURCE_LINE 00001161 "\t\t}"
NSQ_SOURCE_LINE 00001162 "\t    }"
NSQ_SOURCE_LINE 00001163 "\t    foreach (@{$self->{splines}}) {"
NSQ_SOURCE_LINE 00001164 "\t\tif ($self->{objects}->{$_}->{pen_color} == $color) {"
NSQ_SOURCE_LINE 00001165 "\t\t    push @{$res->{splines}}, $_;"
NSQ_SOURCE_LINE 00001166 "\t\t}"
NSQ_SOURCE_LINE 00001167 "\t    }"
NSQ_SOURCE_LINE 00001168 "\t    foreach (@{$self->{texts}}) {"
NSQ_SOURCE_LINE 00001169 "\t\tif ($self->{objects}->{$_}->{pen_color} == $color) {"
NSQ_SOURCE_LINE 00001170 "\t\t    push @{$res->{texts}}, $_;"
