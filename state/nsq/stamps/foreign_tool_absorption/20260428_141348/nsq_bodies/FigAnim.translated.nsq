NSQ_SOURCE_LINE 00000023 "# constructor"
NSQ_SOURCE_LINE 00000024 "sub new {"
NSQ_SOURCE_LINE 00000025 "    my $proto = shift;"
NSQ_SOURCE_LINE 00000026 "    my $class = ref($proto) || $proto;"
NSQ_SOURCE_LINE 00000027 "    my $self = {};"
NSQ_SOURCE_LINE 00000028 "    "
NSQ_SOURCE_LINE 00000029 "    $self->{title} = \"\";"
NSQ_SOURCE_LINE 00000030 "    "
NSQ_SOURCE_LINE 00000031 "    # header"
NSQ_SOURCE_LINE 00000032 "    $self->{version} = undef;"
NSQ_SOURCE_LINE 00000033 "    $self->{orientation} = undef;"
NSQ_SOURCE_LINE 00000034 "    $self->{justification} = undef;"
NSQ_SOURCE_LINE 00000035 "    $self->{units} = undef;"
NSQ_SOURCE_LINE 00000036 "    $self->{papersize} = undef;"
NSQ_SOURCE_LINE 00000037 "    $self->{magnification} = undef;"
NSQ_SOURCE_LINE 00000038 "    $self->{multiple_page} = undef;"
NSQ_SOURCE_LINE 00000039 "    $self->{transparent_color} = undef;"
NSQ_SOURCE_LINE 00000040 "    $self->{resolution} = undef;"
NSQ_SOURCE_LINE 00000041 "    $self->{coord_system} = undef;"
NSQ_SOURCE_LINE 00000042 "    "
NSQ_SOURCE_LINE 00000043 "    # array containing the Color objects"
NSQ_SOURCE_LINE 00000044 "    $self->{colors} = [];"
NSQ_SOURCE_LINE 00000045 "    "
NSQ_SOURCE_LINE 00000046 "    # arrays containing every object's name classified by type"
NSQ_SOURCE_LINE 00000047 "    $self->{arcs} = [];"
NSQ_SOURCE_LINE 00000048 "    $self->{compounds} = [];"
NSQ_SOURCE_LINE 00000049 "    $self->{ellipses} = [];"
NSQ_SOURCE_LINE 00000050 "    $self->{polylines} = [];"
NSQ_SOURCE_LINE 00000051 "    $self->{splines} = [];"
NSQ_SOURCE_LINE 00000052 "    $self->{texts} = [];"
NSQ_SOURCE_LINE 00000053 "    "
NSQ_SOURCE_LINE 00000054 "    # hash containing all the objects (except Color objects)"
NSQ_SOURCE_LINE 00000055 "    # with their names as keys"
NSQ_SOURCE_LINE 00000056 "    $self->{objects} = {};"
NSQ_SOURCE_LINE 00000057 "    "
NSQ_SOURCE_LINE 00000058 "    # number of the current unnamed object"
NSQ_SOURCE_LINE 00000059 "    $self->{num} = 1;"
NSQ_SOURCE_LINE 00000060 "    "
NSQ_SOURCE_LINE 00000061 "    # array containing all the animations"
NSQ_SOURCE_LINE 00000062 "    $self->{animations} = [];"
NSQ_SOURCE_LINE 00000063 "    "
NSQ_SOURCE_LINE 00000064 "    bless ($self, $class);"
NSQ_SOURCE_LINE 00000065 "    return $self;"
NSQ_SOURCE_LINE 00000066 "}"
