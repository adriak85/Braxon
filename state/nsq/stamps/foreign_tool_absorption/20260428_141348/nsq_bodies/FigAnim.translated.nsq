NSQ_SOURCE_LINE 00000069 "# methods"
NSQ_SOURCE_LINE 00000070 "sub clone {"
NSQ_SOURCE_LINE 00000071 "    my $self = shift;"
NSQ_SOURCE_LINE 00000072 "    my $obj = new FigAnim;"
NSQ_SOURCE_LINE 00000073 "    "
NSQ_SOURCE_LINE 00000074 "    foreach ('title','version','orientation','justification','units',"
NSQ_SOURCE_LINE 00000075 "\t     'papersize','magnification','multiple_page','transparent_color',"
NSQ_SOURCE_LINE 00000076 "\t     'resolution','coord_system','arcs','compounds','ellipses',"
NSQ_SOURCE_LINE 00000077 "\t     'polylines','splines','texts') {"
NSQ_SOURCE_LINE 00000078 "\t$obj->{$_} = $self->{$_};"
NSQ_SOURCE_LINE 00000079 "    }"
NSQ_SOURCE_LINE 00000080 "    "
NSQ_SOURCE_LINE 00000081 "    foreach (@{$self->{colors}}) {"
NSQ_SOURCE_LINE 00000082 "\tpush @{$obj->{colors}}, $_->clone();"
NSQ_SOURCE_LINE 00000083 "    }"
NSQ_SOURCE_LINE 00000084 "    "
NSQ_SOURCE_LINE 00000085 "    foreach (keys %{$self->{objects}}) {"
NSQ_SOURCE_LINE 00000086 "\t$obj->{objects}->{$_} = $self->{objects}->{$_}->clone();"
NSQ_SOURCE_LINE 00000087 "\t$obj->{objects}->{$_}->{fig_file} = $obj;"
NSQ_SOURCE_LINE 00000088 "    }"
NSQ_SOURCE_LINE 00000089 "    "
NSQ_SOURCE_LINE 00000090 "    return $obj;"
NSQ_SOURCE_LINE 00000091 "}"
