NSQ_SOURCE_LINE 00000397 "# scheduler"
NSQ_SOURCE_LINE 00000398 "sub generateGif {"
NSQ_SOURCE_LINE 00000399 "    my $self = shift;"
NSQ_SOURCE_LINE 00000400 "    my $file = shift;"
NSQ_SOURCE_LINE 00000401 "    my $speed = shift;"
NSQ_SOURCE_LINE 00000402 "    my $loop = shift;"
NSQ_SOURCE_LINE 00000403 "    my $wait = shift;"
NSQ_SOURCE_LINE 00000404 "    $wait = 0 if (!(defined $wait));"
NSQ_SOURCE_LINE 00000405 "    "
NSQ_SOURCE_LINE 00000406 "    my $length = 1;"
NSQ_SOURCE_LINE 00000407 "    for (my $i=0; $i<scalar(@{$self->{animations}}); $i++) {"
NSQ_SOURCE_LINE 00000408 "\t# calculates the number of frames = first frame + number of frames of the each animation"
NSQ_SOURCE_LINE 00000409 "\tmy $count = sprintf(\"%.0f\",$self->{animations}[$i][2]*$speed) +"
NSQ_SOURCE_LINE 00000410 "\t    sprintf(\"%.0f\",$self->{animations}[$i][3]*$speed);"
NSQ_SOURCE_LINE 00000411 "\t$length = $count if ($count > $length); # we choose the biggest number of frame"
NSQ_SOURCE_LINE 00000412 "     }"
NSQ_SOURCE_LINE 00000413 "    "
NSQ_SOURCE_LINE 00000414 "    my $last = $self->clone(); # The first frame is the copy of the static image"
NSQ_SOURCE_LINE 00000415 "    for (my $f=0; $f<=$length; $f++) { # for each frame do"
NSQ_SOURCE_LINE 00000416 "\tmy $current = $last->clone(); # the current frame is the copy of precedent"
NSQ_SOURCE_LINE 00000417 "\tfor (my $i=0; $i<scalar(@{$self->{animations}}); $i++) { # for each animation do"
NSQ_SOURCE_LINE 00000418 "\t    my $firstframe = sprintf(\"%.0f\",$self->{animations}[$i][2]*$speed);"
NSQ_SOURCE_LINE 00000419 "\t    my $nbframes = sprintf(\"%.0f\",$self->{animations}[$i][3]*$speed);"
NSQ_SOURCE_LINE 00000420 "\t    if (($f > $firstframe) && ($f <= $firstframe+$nbframes)) {"
NSQ_SOURCE_LINE 00000421 "\t\t# if the current frame is inside the current animation do "
NSQ_SOURCE_LINE 00000422 "\t\t"
NSQ_SOURCE_LINE 00000423 "\t\tif ($self->{animations}[$i][0] == 1) { # changeThickness"
NSQ_SOURCE_LINE 00000424 "\t\t    my $name = $self->{animations}[$i][1];"
NSQ_SOURCE_LINE 00000425 "\t\t    my $inc = $self->{animations}[$i][5];"
NSQ_SOURCE_LINE 00000426 "\t\t    "
NSQ_SOURCE_LINE 00000427 "\t\t    $current->{objects}->{$name}->{thickness} ="
NSQ_SOURCE_LINE 00000428 "\t\t\t$last->{objects}->{$name}->{thickness} + $inc;"
NSQ_SOURCE_LINE 00000429 "\t\t}"
NSQ_SOURCE_LINE 00000430 "\t\t"
NSQ_SOURCE_LINE 00000431 "\t\telsif ($self->{animations}[$i][0] == 2) { # changeFillIntensity"
NSQ_SOURCE_LINE 00000432 "\t\t    my $name = $self->{animations}[$i][1];"
NSQ_SOURCE_LINE 00000433 "\t\t    my $inc = $self->{animations}[$i][5];"
NSQ_SOURCE_LINE 00000434 "\t\t    "
NSQ_SOURCE_LINE 00000435 "\t\t    $current->{objects}->{$name}->{area_fill} ="
NSQ_SOURCE_LINE 00000436 "\t\t\t$last->{objects}->{$name}->{area_fill} + $inc;"
NSQ_SOURCE_LINE 00000437 "\t\t}"
NSQ_SOURCE_LINE 00000438 "\t\t"
NSQ_SOURCE_LINE 00000439 "\t\telsif ($self->{animations}[$i][0] == 11) { # translate Ellipse"
NSQ_SOURCE_LINE 00000440 "\t\t    my $name = $self->{animations}[$i][1];"
NSQ_SOURCE_LINE 00000441 "\t\t    my $inc_x = $self->{animations}[$i][7];"
