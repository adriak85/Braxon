NSQ_SOURCE_LINE 00001116 "    my @frames = split /\\n/, `ls .frame????.gif`;"
NSQ_SOURCE_LINE 00001117 "    `convert -loop $loop -delay $delay @frames[0..$length-1] -delay $final_delay $frames[$length] $file`;"
NSQ_SOURCE_LINE 00001118 "    `rm @frames`;"
