BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Clone::PP;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.006;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 "use vars qw($VERSION @EXPORT_OK);"
NSQ_SOURCE_LINE 00000007 "use Exporter;"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "$VERSION = 1.08;"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "@EXPORT_OK = qw( clone );"
NSQ_SOURCE_LINE 00000012 "sub import { goto &Exporter::import } # lazy Exporter"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "# These methods can be temporarily overridden to work with a given class."
NSQ_SOURCE_LINE 00000015 "use vars qw( $CloneSelfMethod $CloneInitMethod );"
NSQ_SOURCE_LINE 00000016 "$CloneSelfMethod ||= 'clone_self';"
NSQ_SOURCE_LINE 00000017 "$CloneInitMethod ||= 'clone_init';"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "# Used to detect looped networks and avoid infinite recursion. "
NSQ_SOURCE_LINE 00000020 "use vars qw( %CloneCache );"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "# Generic cloning function"
NSQ_SOURCE_LINE 00000023 "sub clone {"
NSQ_SOURCE_LINE 00000024 "  my $source = shift;"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "  return undef if not defined($source);"
NSQ_SOURCE_LINE 00000027 "  "
NSQ_SOURCE_LINE 00000028 "  # Optional depth limit: after a given number of levels, do shallow copy."
NSQ_SOURCE_LINE 00000029 "  my $depth = shift;"
NSQ_SOURCE_LINE 00000030 "  return $source if ( defined $depth and $depth -- < 1 );"
NSQ_SOURCE_LINE 00000031 "  "
NSQ_SOURCE_LINE 00000032 "  # Maintain a shared cache during recursive calls, then clear it at the end."
NSQ_SOURCE_LINE 00000033 "  local %CloneCache = ( undef => undef ) unless ( exists $CloneCache{undef} );"
NSQ_SOURCE_LINE 00000034 "  "
NSQ_SOURCE_LINE 00000035 "  return $CloneCache{ $source } if ( defined $CloneCache{ $source } );"
NSQ_SOURCE_LINE 00000036 "  "
NSQ_SOURCE_LINE 00000037 "  # Non-reference values are copied shallowly"
NSQ_SOURCE_LINE 00000038 "  my $ref_type = ref $source or return $source;"
NSQ_SOURCE_LINE 00000039 "  "
NSQ_SOURCE_LINE 00000040 "  # Extract both the structure type and the class name of referent"
NSQ_SOURCE_LINE 00000041 "  my $class_name;"
NSQ_SOURCE_LINE 00000042 "  if ( \"$source\" =~ /^\\Q$ref_type\\E\\=([A-Z]+)\\(0x[0-9a-f]+\\)$/ ) {"
NSQ_SOURCE_LINE 00000043 "    $class_name = $ref_type;"
NSQ_SOURCE_LINE 00000044 "    $ref_type = $1;"
NSQ_SOURCE_LINE 00000045 "    # Some objects would prefer to clone themselves; check for clone_self()."
NSQ_SOURCE_LINE 00000046 "    return $CloneCache{ $source } = $source->$CloneSelfMethod() "
NSQ_SOURCE_LINE 00000047 "\t\t\t\t  if $source->can($CloneSelfMethod);"
NSQ_SOURCE_LINE 00000048 "  }"
NSQ_SOURCE_LINE 00000049 "  "
NSQ_SOURCE_LINE 00000050 "  # To make a copy:"
NSQ_SOURCE_LINE 00000051 "  # - Prepare a reference to the same type of structure;"
NSQ_SOURCE_LINE 00000052 "  # - Store it in the cache, to avoid looping if it refers to itself;"
NSQ_SOURCE_LINE 00000053 "  # - Tie in to the same class as the original, if it was tied;"
NSQ_SOURCE_LINE 00000054 "  # - Assign a value to the reference by cloning each item in the original;"
NSQ_SOURCE_LINE 00000055 "  "
NSQ_SOURCE_LINE 00000056 "  my $copy;"
NSQ_SOURCE_LINE 00000057 "  if ($ref_type eq 'HASH') {"
NSQ_SOURCE_LINE 00000058 "    $CloneCache{ $source } = $copy = {};"
NSQ_SOURCE_LINE 00000059 "    if ( my $tied = tied( %$source ) ) { tie %$copy, ref $tied }"
NSQ_SOURCE_LINE 00000060 "    %$copy = map { ! ref($_) ? $_ : clone($_, $depth) } %$source;"
NSQ_SOURCE_LINE 00000061 "  } elsif ($ref_type eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000062 "    $CloneCache{ $source } = $copy = [];"
NSQ_SOURCE_LINE 00000063 "    if ( my $tied = tied( @$source ) ) { tie @$copy, ref $tied }"
NSQ_SOURCE_LINE 00000064 "    @$copy = map { ! ref($_) ? $_ : clone($_, $depth) } @$source;"
NSQ_SOURCE_LINE 00000065 "  } elsif ($ref_type eq 'REF' or $ref_type eq 'SCALAR') {"
NSQ_SOURCE_LINE 00000066 "    $CloneCache{ $source } = $copy = \\( my $var = \"\" );"
NSQ_SOURCE_LINE 00000067 "    if ( my $tied = tied( $$source ) ) { tie $$copy, ref $tied }"
NSQ_SOURCE_LINE 00000068 "    $$copy = clone($$source, $depth);"
NSQ_SOURCE_LINE 00000069 "  } else {"
NSQ_SOURCE_LINE 00000070 "    # Shallow copy anything else; this handles a reference to code, glob, regex"
NSQ_SOURCE_LINE 00000071 "    $CloneCache{ $source } = $copy = $source;"
NSQ_SOURCE_LINE 00000072 "  }"
NSQ_SOURCE_LINE 00000073 "  "
NSQ_SOURCE_LINE 00000074 "  # - Bless it into the same class as the original, if it was blessed;"
NSQ_SOURCE_LINE 00000075 "  # - If it has a post-cloning initialization method, call it."
NSQ_SOURCE_LINE 00000076 "  if ( $class_name ) {"
NSQ_SOURCE_LINE 00000077 "    bless $copy, $class_name;"
NSQ_SOURCE_LINE 00000078 "    $copy->$CloneInitMethod() if $copy->can($CloneInitMethod);"
NSQ_SOURCE_LINE 00000079 "  }"
NSQ_SOURCE_LINE 00000080 "  "
NSQ_SOURCE_LINE 00000081 "  return $copy;"
NSQ_SOURCE_LINE 00000082 "}"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "1;"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "__END__"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "=head1 NAME"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "Clone::PP - Recursively copy Perl datatypes"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "  use Clone::PP qw(clone);"
NSQ_SOURCE_LINE 00000095 "  "
NSQ_SOURCE_LINE 00000096 "  $item = { 'foo' => 'bar', 'move' => [ 'zig', 'zag' ]  };"
NSQ_SOURCE_LINE 00000097 "  $copy = clone( $item );"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "  $item = [ 'alpha', 'beta', { 'gamma' => 'vlissides' } ];"
NSQ_SOURCE_LINE 00000100 "  $copy = clone( $item );"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "  $item = Foo->new();"
NSQ_SOURCE_LINE 00000103 "  $copy = clone( $item );"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "Or as an object method:"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "  require Clone::PP;"
NSQ_SOURCE_LINE 00000108 "  push @Foo::ISA, 'Clone::PP';"
NSQ_SOURCE_LINE 00000109 "  "
NSQ_SOURCE_LINE 00000110 "  $item = Foo->new();"
NSQ_SOURCE_LINE 00000111 "  $copy = $item->clone();"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "This module provides a general-purpose clone function to make deep"
NSQ_SOURCE_LINE 00000116 "copies of Perl data structures. It calls itself recursively to copy"
NSQ_SOURCE_LINE 00000117 "nested hash, array, scalar and reference types, including tied"
NSQ_SOURCE_LINE 00000118 "variables and objects."
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "The clone() function takes a scalar argument to copy. To duplicate"
NSQ_SOURCE_LINE 00000121 "arrays or hashes, pass them in by reference:"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "  my $copy = clone(\\@array);    my @copy = @{ clone(\\@array) };"
NSQ_SOURCE_LINE 00000124 "  my $copy = clone(\\%hash);     my %copy = %{ clone(\\%hash) };"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "The clone() function also accepts an optional second parameter that"
NSQ_SOURCE_LINE 00000127 "can be used to limit the depth of the copy. If you pass a limit of"
NSQ_SOURCE_LINE 00000128 "0, clone will return the same value you supplied; for a limit of"
NSQ_SOURCE_LINE 00000129 "1, a shallow copy is constructed; for a limit of 2, two layers of"
NSQ_SOURCE_LINE 00000130 "copying are done, and so on."
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "  my $shallow_copy = clone( $item, 1 );"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "To allow objects to intervene in the way they are copied, the"
NSQ_SOURCE_LINE 00000135 "clone() function checks for a couple of optional methods. If an"
NSQ_SOURCE_LINE 00000136 "object provides a method named C<clone_self>, it is called and the"
NSQ_SOURCE_LINE 00000137 "result returned without further processing. Alternately, if an"
NSQ_SOURCE_LINE 00000138 "object provides a method named C<clone_init>, it is called on the"
NSQ_SOURCE_LINE 00000139 "copied object before it is returned."
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "=head1 BUGS"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "Some data types, such as globs, regexes, and code refs, are always copied shallowly."
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "References to hash elements are not properly duplicated. (This is why two tests in t/dclone.t that are marked \"todo\".) For example, the following test should succeed but does not:"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "  my $hash = { foo => 1 }; "
NSQ_SOURCE_LINE 00000148 "  $hash->{bar} = \\{ $hash->{foo} }; "
NSQ_SOURCE_LINE 00000149 "  my $copy = clone( \\%hash ); "
NSQ_SOURCE_LINE 00000150 "  $hash->{foo} = 2; "
NSQ_SOURCE_LINE 00000151 "  $copy->{foo} = 2; "
NSQ_SOURCE_LINE 00000152 "  ok( $hash->{bar} == $copy->{bar} );"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "To report bugs via the CPAN web tracking system, go to "
NSQ_SOURCE_LINE 00000155 "C<http://rt.cpan.org/NoAuth/Bugs.html?Dist=Clone-PP> or send mail "
NSQ_SOURCE_LINE 00000156 "to C<Dist=Clone-PP#rt.cpan.org>, replacing C<#> with C<@>."
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "L<Clone> - a baseclass which provides a C<clone()> method."
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "L<MooseX::Clone> - find-grained cloning for Moose objects."
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "The C<dclone()> function in L<Storable>."
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "L<Data::Clone> -"
NSQ_SOURCE_LINE 00000167 "polymorphic data cloning (see its documentation for what that means)."
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "L<Clone::Any> - use whichever of the cloning methods is available."
NSQ_SOURCE_LINE 00000170 ""
