BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Encode::Locale;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "our $VERSION = \"1.05\";"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use base 'Exporter';"
NSQ_SOURCE_LINE 00000007 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000008 "    decode_argv env"
NSQ_SOURCE_LINE 00000009 "    $ENCODING_LOCALE $ENCODING_LOCALE_FS"
NSQ_SOURCE_LINE 00000010 "    $ENCODING_CONSOLE_IN $ENCODING_CONSOLE_OUT"
NSQ_SOURCE_LINE 00000011 ");"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "use Encode ();"
NSQ_SOURCE_LINE 00000014 "use Encode::Alias ();"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "our $ENCODING_LOCALE;"
NSQ_SOURCE_LINE 00000017 "our $ENCODING_LOCALE_FS;"
NSQ_SOURCE_LINE 00000018 "our $ENCODING_CONSOLE_IN;"
NSQ_SOURCE_LINE 00000019 "our $ENCODING_CONSOLE_OUT;"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "sub DEBUG () { 0 }"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "sub _init {"
NSQ_SOURCE_LINE 00000024 "    if ($^O eq \"MSWin32\") {"
NSQ_SOURCE_LINE 00000025 "\tunless ($ENCODING_LOCALE) {"
NSQ_SOURCE_LINE 00000026 "\t    # Try to obtain what the Windows ANSI code page is"
NSQ_SOURCE_LINE 00000027 "\t    eval {"
NSQ_SOURCE_LINE 00000028 "\t\tunless (defined &GetACP) {"
NSQ_SOURCE_LINE 00000029 "\t\t    require Win32;"
NSQ_SOURCE_LINE 00000030 "                    eval { Win32::GetACP() };"
NSQ_SOURCE_LINE 00000031 "\t\t    *GetACP = sub { &Win32::GetACP } unless $@;"
NSQ_SOURCE_LINE 00000032 "\t\t}"
NSQ_SOURCE_LINE 00000033 "\t\tunless (defined &GetACP) {"
NSQ_SOURCE_LINE 00000034 "\t\t    require Win32::API;"
NSQ_SOURCE_LINE 00000035 "\t\t    Win32::API->Import('kernel32', 'int GetACP()');"
NSQ_SOURCE_LINE 00000036 "\t\t}"
NSQ_SOURCE_LINE 00000037 "\t\tif (defined &GetACP) {"
NSQ_SOURCE_LINE 00000038 "\t\t    my $cp = GetACP();"
NSQ_SOURCE_LINE 00000039 "\t\t    $ENCODING_LOCALE = \"cp$cp\" if $cp;"
NSQ_SOURCE_LINE 00000040 "\t\t}"
NSQ_SOURCE_LINE 00000041 "\t    };"
NSQ_SOURCE_LINE 00000042 "\t}"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "\tunless ($ENCODING_CONSOLE_IN) {"
NSQ_SOURCE_LINE 00000045 "            # only test one since set together"
NSQ_SOURCE_LINE 00000046 "            unless (defined &GetInputCP) {"
NSQ_SOURCE_LINE 00000047 "                eval {"
NSQ_SOURCE_LINE 00000048 "                    require Win32;"
NSQ_SOURCE_LINE 00000049 "                    eval { Win32::GetConsoleCP() };"
NSQ_SOURCE_LINE 00000050 "                    # manually \"import\" it since Win32->import refuses"
NSQ_SOURCE_LINE 00000051 "                    *GetInputCP = sub { &Win32::GetConsoleCP } unless $@;"
NSQ_SOURCE_LINE 00000052 "                    *GetOutputCP = sub { &Win32::GetConsoleOutputCP } unless $@;"
NSQ_SOURCE_LINE 00000053 "                };"
NSQ_SOURCE_LINE 00000054 "                unless (defined &GetInputCP) {"
NSQ_SOURCE_LINE 00000055 "                    eval {"
NSQ_SOURCE_LINE 00000056 "                        # try Win32::Console module for codepage to use"
NSQ_SOURCE_LINE 00000057 "                        require Win32::Console;"
NSQ_SOURCE_LINE 00000058 "                        eval { Win32::Console::InputCP() };"
NSQ_SOURCE_LINE 00000059 "                        *GetInputCP = sub { &Win32::Console::InputCP }"
NSQ_SOURCE_LINE 00000060 "                            unless $@;"
NSQ_SOURCE_LINE 00000061 "                        *GetOutputCP = sub { &Win32::Console::OutputCP }"
NSQ_SOURCE_LINE 00000062 "                            unless $@;"
NSQ_SOURCE_LINE 00000063 "                    };"
NSQ_SOURCE_LINE 00000064 "                }"
NSQ_SOURCE_LINE 00000065 "                unless (defined &GetInputCP) {"
NSQ_SOURCE_LINE 00000066 "                    # final fallback"
NSQ_SOURCE_LINE 00000067 "                    *GetInputCP = *GetOutputCP = sub {"
NSQ_SOURCE_LINE 00000068 "                        # another fallback that could work is:"
NSQ_SOURCE_LINE 00000069 "                        # reg query HKLM\\System\\CurrentControlSet\\Control\\Nls\\CodePage /v ACP"
NSQ_SOURCE_LINE 00000070 "                        ((qx(chcp) || '') =~ /^Active code page: (\\d+)/)"
NSQ_SOURCE_LINE 00000071 "                            ? $1 : ();"
NSQ_SOURCE_LINE 00000072 "                    };"
NSQ_SOURCE_LINE 00000073 "                }"
NSQ_SOURCE_LINE 00000074 "\t    }"
NSQ_SOURCE_LINE 00000075 "            my $cp = GetInputCP();"
NSQ_SOURCE_LINE 00000076 "            $ENCODING_CONSOLE_IN = \"cp$cp\" if $cp;"
NSQ_SOURCE_LINE 00000077 "            $cp = GetOutputCP();"
NSQ_SOURCE_LINE 00000078 "            $ENCODING_CONSOLE_OUT = \"cp$cp\" if $cp;"
NSQ_SOURCE_LINE 00000079 "\t}"
NSQ_SOURCE_LINE 00000080 "    }"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "    unless ($ENCODING_LOCALE) {"
NSQ_SOURCE_LINE 00000083 "\teval {"
NSQ_SOURCE_LINE 00000084 "\t    require I18N::Langinfo;"
NSQ_SOURCE_LINE 00000085 "\t    $ENCODING_LOCALE = I18N::Langinfo::langinfo(I18N::Langinfo::CODESET());"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "\t    # Workaround of Encode < v2.25.  The \"646\" encoding  alias was"
NSQ_SOURCE_LINE 00000088 "\t    # introduced in Encode-2.25, but we don't want to require that version"
NSQ_SOURCE_LINE 00000089 "\t    # quite yet.  Should avoid the CPAN testers failure reported from"
NSQ_SOURCE_LINE 00000090 "\t    # openbsd-4.7/perl-5.10.0 combo."
NSQ_SOURCE_LINE 00000091 "\t    $ENCODING_LOCALE = \"ascii\" if $ENCODING_LOCALE eq \"646\";"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "\t    # https://rt.cpan.org/Ticket/Display.html?id=66373"
NSQ_SOURCE_LINE 00000094 "\t    $ENCODING_LOCALE = \"hp-roman8\" if $^O eq \"hpux\" && $ENCODING_LOCALE eq \"roman8\";"
NSQ_SOURCE_LINE 00000095 "\t};"
NSQ_SOURCE_LINE 00000096 "\t$ENCODING_LOCALE ||= $ENCODING_CONSOLE_IN;"
NSQ_SOURCE_LINE 00000097 "    }"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "    if ($^O eq \"darwin\") {"
NSQ_SOURCE_LINE 00000100 "\t$ENCODING_LOCALE_FS ||= \"UTF-8\";"
NSQ_SOURCE_LINE 00000101 "    }"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "    # final fallback"
NSQ_SOURCE_LINE 00000104 "    $ENCODING_LOCALE ||= $^O eq \"MSWin32\" ? \"cp1252\" : \"UTF-8\";"
NSQ_SOURCE_LINE 00000105 "    $ENCODING_LOCALE_FS ||= $ENCODING_LOCALE;"
NSQ_SOURCE_LINE 00000106 "    $ENCODING_CONSOLE_IN ||= $ENCODING_LOCALE;"
NSQ_SOURCE_LINE 00000107 "    $ENCODING_CONSOLE_OUT ||= $ENCODING_CONSOLE_IN;"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "    unless (Encode::find_encoding($ENCODING_LOCALE)) {"
NSQ_SOURCE_LINE 00000110 "\tmy $foundit;"
NSQ_SOURCE_LINE 00000111 "\tif (lc($ENCODING_LOCALE) eq \"gb18030\") {"
NSQ_SOURCE_LINE 00000112 "\t    eval {"
NSQ_SOURCE_LINE 00000113 "\t\trequire Encode::HanExtra;"
NSQ_SOURCE_LINE 00000114 "\t    };"
NSQ_SOURCE_LINE 00000115 "\t    if ($@) {"
NSQ_SOURCE_LINE 00000116 "\t\tdie \"Need Encode::HanExtra to be installed to support locale codeset ($ENCODING_LOCALE), stopped\";"
NSQ_SOURCE_LINE 00000117 "\t    }"
NSQ_SOURCE_LINE 00000118 "\t    $foundit++ if Encode::find_encoding($ENCODING_LOCALE);"
NSQ_SOURCE_LINE 00000119 "\t}"
NSQ_SOURCE_LINE 00000120 "\tdie \"The locale codeset ($ENCODING_LOCALE) isn't one that perl can decode, stopped\""
NSQ_SOURCE_LINE 00000121 "\t    unless $foundit;"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "    }"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "    # use Data::Dump; ddx $ENCODING_LOCALE, $ENCODING_LOCALE_FS, $ENCODING_CONSOLE_IN, $ENCODING_CONSOLE_OUT;"
NSQ_SOURCE_LINE 00000126 "}"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "_init();"
NSQ_SOURCE_LINE 00000129 "Encode::Alias::define_alias(sub {"
NSQ_SOURCE_LINE 00000130 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000131 "    no warnings 'once';"
NSQ_SOURCE_LINE 00000132 "    return ${\"ENCODING_\" . uc(shift)};"
NSQ_SOURCE_LINE 00000133 "}, \"locale\");"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "sub _flush_aliases {"
NSQ_SOURCE_LINE 00000136 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000137 "    for my $a (keys %Encode::Alias::Alias) {"
NSQ_SOURCE_LINE 00000138 "\tif (defined ${\"ENCODING_\" . uc($a)}) {"
NSQ_SOURCE_LINE 00000139 "\t    delete $Encode::Alias::Alias{$a};"
NSQ_SOURCE_LINE 00000140 "\t    warn \"Flushed alias cache for $a\" if DEBUG;"
NSQ_SOURCE_LINE 00000141 "\t}"
NSQ_SOURCE_LINE 00000142 "    }"
NSQ_SOURCE_LINE 00000143 "}"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "sub reinit {"
NSQ_SOURCE_LINE 00000146 "    $ENCODING_LOCALE = shift;"
NSQ_SOURCE_LINE 00000147 "    $ENCODING_LOCALE_FS = shift;"
NSQ_SOURCE_LINE 00000148 "    $ENCODING_CONSOLE_IN = $ENCODING_LOCALE;"
NSQ_SOURCE_LINE 00000149 "    $ENCODING_CONSOLE_OUT = $ENCODING_LOCALE;"
NSQ_SOURCE_LINE 00000150 "    _init();"
NSQ_SOURCE_LINE 00000151 "    _flush_aliases();"
NSQ_SOURCE_LINE 00000152 "}"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "sub decode_argv {"
NSQ_SOURCE_LINE 00000155 "    die if defined wantarray;"
NSQ_SOURCE_LINE 00000156 "    for (@ARGV) {"
NSQ_SOURCE_LINE 00000157 "\t$_ = Encode::decode(locale => $_, @_);"
NSQ_SOURCE_LINE 00000158 "    }"
NSQ_SOURCE_LINE 00000159 "}"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "sub env {"
NSQ_SOURCE_LINE 00000162 "    my $k = Encode::encode(locale => shift);"
NSQ_SOURCE_LINE 00000163 "    my $old = $ENV{$k};"
NSQ_SOURCE_LINE 00000164 "    if (@_) {"
NSQ_SOURCE_LINE 00000165 "\tmy $v = shift;"
NSQ_SOURCE_LINE 00000166 "\tif (defined $v) {"
NSQ_SOURCE_LINE 00000167 "\t    $ENV{$k} = Encode::encode(locale => $v);"
NSQ_SOURCE_LINE 00000168 "\t}"
NSQ_SOURCE_LINE 00000169 "\telse {"
NSQ_SOURCE_LINE 00000170 "\t    delete $ENV{$k};"
NSQ_SOURCE_LINE 00000171 "\t}"
NSQ_SOURCE_LINE 00000172 "    }"
NSQ_SOURCE_LINE 00000173 "    return Encode::decode(locale => $old) if defined wantarray;"
NSQ_SOURCE_LINE 00000174 "}"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "1;"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "__END__"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "=head1 NAME"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "Encode::Locale - Determine the locale encoding"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "  use Encode::Locale;"
NSQ_SOURCE_LINE 00000187 "  use Encode;"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "  $string = decode(locale => $bytes);"
NSQ_SOURCE_LINE 00000190 "  $bytes = encode(locale => $string);"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "  if (-t) {"
NSQ_SOURCE_LINE 00000193 "      binmode(STDIN, \":encoding(console_in)\");"
NSQ_SOURCE_LINE 00000194 "      binmode(STDOUT, \":encoding(console_out)\");"
NSQ_SOURCE_LINE 00000195 "      binmode(STDERR, \":encoding(console_out)\");"
NSQ_SOURCE_LINE 00000196 "  }"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "  # Processing file names passed in as arguments"
NSQ_SOURCE_LINE 00000199 "  my $uni_filename = decode(locale => $ARGV[0]);"
NSQ_SOURCE_LINE 00000200 "  open(my $fh, \"<\", encode(locale_fs => $uni_filename))"
NSQ_SOURCE_LINE 00000201 "     || die \"Can't open '$uni_filename': $!\";"
NSQ_SOURCE_LINE 00000202 "  binmode($fh, \":encoding(locale)\");"
NSQ_SOURCE_LINE 00000203 "  ..."
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "In many applications it's wise to let Perl use Unicode for the strings it"
NSQ_SOURCE_LINE 00000208 "processes.  Most of the interfaces Perl has to the outside world are still byte"
NSQ_SOURCE_LINE 00000209 "based.  Programs therefore need to decode byte strings that enter the program"
NSQ_SOURCE_LINE 00000210 "from the outside and encode them again on the way out."
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "The POSIX locale system is used to specify both the language conventions"
NSQ_SOURCE_LINE 00000213 "requested by the user and the preferred character set to consume and"
NSQ_SOURCE_LINE 00000214 "output.  The C<Encode::Locale> module looks up the charset and encoding (called"
NSQ_SOURCE_LINE 00000215 "a CODESET in the locale jargon) and arranges for the L<Encode> module to know"
NSQ_SOURCE_LINE 00000216 "this encoding under the name \"locale\".  It means bytes obtained from the"
NSQ_SOURCE_LINE 00000217 "environment can be converted to Unicode strings by calling C<<"
NSQ_SOURCE_LINE 00000218 "Encode::encode(locale => $bytes) >> and converted back again with C<<"
NSQ_SOURCE_LINE 00000219 "Encode::decode(locale => $string) >>."
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "Where file systems interfaces pass file names in and out of the program we also"
NSQ_SOURCE_LINE 00000222 "need care.  The trend is for operating systems to use a fixed file encoding"
NSQ_SOURCE_LINE 00000223 "that don't actually depend on the locale; and this module determines the most"
NSQ_SOURCE_LINE 00000224 "appropriate encoding for file names. The L<Encode> module will know this"
NSQ_SOURCE_LINE 00000225 "encoding under the name \"locale_fs\".  For traditional Unix systems this will"
NSQ_SOURCE_LINE 00000226 "be an alias to the same encoding as \"locale\"."
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "For programs running in a terminal window (called a \"Console\" on some systems)"
NSQ_SOURCE_LINE 00000229 "the \"locale\" encoding is usually a good choice for what to expect as input and"
NSQ_SOURCE_LINE 00000230 "output.  Some systems allows us to query the encoding set for the terminal and"
NSQ_SOURCE_LINE 00000231 "C<Encode::Locale> will do that if available and make these encodings known"
NSQ_SOURCE_LINE 00000232 "under the C<Encode> aliases \"console_in\" and \"console_out\".  For systems where"
NSQ_SOURCE_LINE 00000233 "we can't determine the terminal encoding these will be aliased as the same"
NSQ_SOURCE_LINE 00000234 "encoding as \"locale\".  The advice is to use \"console_in\" for input known to"
NSQ_SOURCE_LINE 00000235 "come from the terminal and \"console_out\" for output to the terminal."
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "In addition to arranging for various Encode aliases the following functions and"
NSQ_SOURCE_LINE 00000238 "variables are provided:"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "=over"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "=item decode_argv( )"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "=item decode_argv( Encode::FB_CROAK )"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "This will decode the command line arguments to perl (the C<@ARGV> array) in-place."
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "The function will by default replace characters that can't be decoded by"
NSQ_SOURCE_LINE 00000249 "\"\\x{FFFD}\", the Unicode replacement character."
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "Any argument provided is passed as CHECK to underlying Encode::decode() call."
NSQ_SOURCE_LINE 00000252 "Pass the value C<Encode::FB_CROAK> to have the decoding croak if not all the"
NSQ_SOURCE_LINE 00000253 "command line arguments can be decoded.  See L<Encode/\"Handling Malformed Data\">"
NSQ_SOURCE_LINE 00000254 "for details on other options for CHECK."
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "=item env( $uni_key )"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "=item env( $uni_key => $uni_value )"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "Interface to get/set environment variables.  Returns the current value as a"
NSQ_SOURCE_LINE 00000261 "Unicode string. The $uni_key and $uni_value arguments are expected to be"
NSQ_SOURCE_LINE 00000262 "Unicode strings as well.  Passing C<undef> as $uni_value deletes the"
NSQ_SOURCE_LINE 00000263 "environment variable named $uni_key."
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "The returned value will have the characters that can't be decoded replaced by"
NSQ_SOURCE_LINE 00000266 "\"\\x{FFFD}\", the Unicode replacement character."
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "There is no interface to request alternative CHECK behavior as for"
NSQ_SOURCE_LINE 00000269 "decode_argv().  If you need that you need to call encode/decode yourself."
NSQ_SOURCE_LINE 00000270 "For example:"
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "    my $key = Encode::encode(locale => $uni_key, Encode::FB_CROAK);"
NSQ_SOURCE_LINE 00000273 "    my $uni_value = Encode::decode(locale => $ENV{$key}, Encode::FB_CROAK);"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "=item reinit( )"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "=item reinit( $encoding )"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "Reinitialize the encodings from the locale.  You want to call this function if"
NSQ_SOURCE_LINE 00000280 "you changed anything in the environment that might influence the locale."
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "This function will croak if the determined encoding isn't recognized by"
NSQ_SOURCE_LINE 00000283 "the Encode module."
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "With argument force $ENCODING_... variables to set to the given value."
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "=item $ENCODING_LOCALE"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "The encoding name determined to be suitable for the current locale."
NSQ_SOURCE_LINE 00000290 "L<Encode> know this encoding as \"locale\"."
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "=item $ENCODING_LOCALE_FS"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "The encoding name determined to be suitable for file system interfaces"
NSQ_SOURCE_LINE 00000295 "involving file names."
NSQ_SOURCE_LINE 00000296 "L<Encode> know this encoding as \"locale_fs\"."
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "=item $ENCODING_CONSOLE_IN"
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "=item $ENCODING_CONSOLE_OUT"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "The encodings to be used for reading and writing output to the a console."
NSQ_SOURCE_LINE 00000303 "L<Encode> know these encodings as \"console_in\" and \"console_out\"."
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "=back"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "=head1 NOTES"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "This table summarizes the mapping of the encodings set up"
NSQ_SOURCE_LINE 00000310 "by the C<Encode::Locale> module:"
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "  Encode      |         |              |"
NSQ_SOURCE_LINE 00000313 "  Alias       | Windows | Mac OS X     | POSIX"
NSQ_SOURCE_LINE 00000314 "  ------------+---------+--------------+------------"
NSQ_SOURCE_LINE 00000315 "  locale      | ANSI    | nl_langinfo  | nl_langinfo"
NSQ_SOURCE_LINE 00000316 "  locale_fs   | ANSI    | UTF-8        | nl_langinfo"
NSQ_SOURCE_LINE 00000317 "  console_in  | OEM     | nl_langinfo  | nl_langinfo"
NSQ_SOURCE_LINE 00000318 "  console_out | OEM     | nl_langinfo  | nl_langinfo"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "=head2 Windows"
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "Windows has basically 2 sets of APIs.  A wide API (based on passing UTF-16"
NSQ_SOURCE_LINE 00000323 "strings) and a byte based API based a character set called ANSI.  The"
NSQ_SOURCE_LINE 00000324 "regular Perl interfaces to the OS currently only uses the ANSI APIs."
NSQ_SOURCE_LINE 00000325 "Unfortunately ANSI is not a single character set."
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "The encoding that corresponds to ANSI varies between different editions of"
NSQ_SOURCE_LINE 00000328 "Windows.  For many western editions of Windows ANSI corresponds to CP-1252"
NSQ_SOURCE_LINE 00000329 "which is a character set similar to ISO-8859-1.  Conceptually the ANSI"
NSQ_SOURCE_LINE 00000330 "character set is a similar concept to the POSIX locale CODESET so this module"
NSQ_SOURCE_LINE 00000331 "figures out what the ANSI code page is and make this available as"
NSQ_SOURCE_LINE 00000332 "$ENCODING_LOCALE and the \"locale\" Encoding alias."
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "Windows systems also operate with another byte based character set."
NSQ_SOURCE_LINE 00000335 "It's called the OEM code page.  This is the encoding that the Console"
NSQ_SOURCE_LINE 00000336 "takes as input and output.  It's common for the OEM code page to"
NSQ_SOURCE_LINE 00000337 "differ from the ANSI code page."
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "=head2 Mac OS X"
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "On Mac OS X the file system encoding is always UTF-8 while the locale"
NSQ_SOURCE_LINE 00000342 "can otherwise be set up as normal for POSIX systems."
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "File names on Mac OS X will at the OS-level be converted to"
NSQ_SOURCE_LINE 00000345 "NFD-form.  A file created by passing a NFC-filename will come"
NSQ_SOURCE_LINE 00000346 "in NFD-form from readdir().  See L<Unicode::Normalize> for details"
NSQ_SOURCE_LINE 00000347 "of NFD/NFC."
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "Actually, Apple does not follow the Unicode NFD standard since not all"
NSQ_SOURCE_LINE 00000350 "character ranges are decomposed.  The claim is that this avoids problems with"
NSQ_SOURCE_LINE 00000351 "round trip conversions from old Mac text encodings.  See L<Encode::UTF8Mac> for"
NSQ_SOURCE_LINE 00000352 "details."
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "=head2 POSIX (Linux and other Unixes)"
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "File systems might vary in what encoding is to be used for"
NSQ_SOURCE_LINE 00000357 "filenames.  Since this module has no way to actually figure out"
NSQ_SOURCE_LINE 00000358 "what the is correct it goes with the best guess which is to"
NSQ_SOURCE_LINE 00000359 "assume filenames are encoding according to the current locale."
NSQ_SOURCE_LINE 00000360 "Users are advised to always specify UTF-8 as the locale charset."
NSQ_SOURCE_LINE 00000361 ""
NSQ_SOURCE_LINE 00000362 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "L<I18N::Langinfo>, L<Encode>, L<Term::Encoding>"
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 "Copyright 2010 Gisle Aas <gisle@aas.no>."
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "This library is free software; you can redistribute it and/or"
NSQ_SOURCE_LINE 00000371 "modify it under the same terms as Perl itself."
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "=cut"
BODY_END
