BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Config::IOD::Reader;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.010001;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "use parent qw(Config::IOD::Base);"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000010 "our $DATE = '2022-05-02'; # DATE"
NSQ_SOURCE_LINE 00000011 "our $DIST = 'Config-IOD-Reader'; # DIST"
NSQ_SOURCE_LINE 00000012 "our $VERSION = '0.345'; # VERSION"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "sub _merge {"
NSQ_SOURCE_LINE 00000015 "    my ($self, $section) = @_;"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "    my $res = $self->{_res};"
NSQ_SOURCE_LINE 00000018 "    for my $msect (@{ $self->{_merge} }) {"
NSQ_SOURCE_LINE 00000019 "        if ($msect eq $section) {"
NSQ_SOURCE_LINE 00000020 "            # ignore merging self"
NSQ_SOURCE_LINE 00000021 "            next;"
NSQ_SOURCE_LINE 00000022 "            #local $self->{_linum} = $self->{_linum}-1;"
NSQ_SOURCE_LINE 00000023 "            #$self->_err(\"Can't merge section '$msect' to '$section': \"."
NSQ_SOURCE_LINE 00000024 "            #                \"Same section\");"
NSQ_SOURCE_LINE 00000025 "        }"
NSQ_SOURCE_LINE 00000026 "        if (!exists($res->{$msect})) {"
NSQ_SOURCE_LINE 00000027 "            local $self->{_linum} = $self->{_linum}-1;"
NSQ_SOURCE_LINE 00000028 "            $self->_err(\"Can't merge section '$msect' to '$section': \"."
NSQ_SOURCE_LINE 00000029 "                            \"Section '$msect' not seen yet\");"
NSQ_SOURCE_LINE 00000030 "        }"
NSQ_SOURCE_LINE 00000031 "        for my $k (keys %{ $res->{$msect} }) {"
NSQ_SOURCE_LINE 00000032 "            $res->{$section}{$k} //= $res->{$msect}{$k};"
NSQ_SOURCE_LINE 00000033 "        }"
NSQ_SOURCE_LINE 00000034 "    }"
NSQ_SOURCE_LINE 00000035 "}"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "sub _init_read {"
NSQ_SOURCE_LINE 00000038 "    my $self = shift;"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "    $self->SUPER::_init_read;"
NSQ_SOURCE_LINE 00000041 "    $self->{_res} = {};"
NSQ_SOURCE_LINE 00000042 "    $self->{_merge} = undef;"
NSQ_SOURCE_LINE 00000043 "    $self->{_num_seen_section_lines} = 0;"
NSQ_SOURCE_LINE 00000044 "    $self->{_cur_section} = $self->{default_section};"
NSQ_SOURCE_LINE 00000045 "    $self->{_arrayified} = {};"
NSQ_SOURCE_LINE 00000046 "}"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "sub _read_string {"
NSQ_SOURCE_LINE 00000049 "    my ($self, $str, $cb) = @_;"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "    my $res = $self->{_res};"
NSQ_SOURCE_LINE 00000052 "    my $cur_section = $self->{_cur_section};"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "    my $directive_re = $self->{allow_bang_only} ?"
NSQ_SOURCE_LINE 00000055 "        qr/^;?\\s*!\\s*(\\w+)\\s*/ :"
NSQ_SOURCE_LINE 00000056 "        qr/^;\\s*!\\s*(\\w+)\\s*/;"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "    my $_raw_val; # only to provide to callback"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "    my @lines = split /^/, $str;"
NSQ_SOURCE_LINE 00000061 "    local $self->{_linum} = 0;"
NSQ_SOURCE_LINE 00000062 "  LINE:"
NSQ_SOURCE_LINE 00000063 "    for my $line (@lines) {"
NSQ_SOURCE_LINE 00000064 "        $self->{_linum}++;"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "        # blank line"
NSQ_SOURCE_LINE 00000067 "        if ($line !~ /\\S/) {"
NSQ_SOURCE_LINE 00000068 "            next LINE;"
NSQ_SOURCE_LINE 00000069 "        }"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "        # directive line"
NSQ_SOURCE_LINE 00000072 "        if ($self->{enable_directive} && $line =~ s/$directive_re//) {"
NSQ_SOURCE_LINE 00000073 "            my $directive = $1;"
NSQ_SOURCE_LINE 00000074 "            if ($self->{allow_directives}) {"
NSQ_SOURCE_LINE 00000075 "                $self->_err(\"Directive '$directive' is not in \"."
NSQ_SOURCE_LINE 00000076 "                                \"allow_directives list\")"
NSQ_SOURCE_LINE 00000077 "                    unless grep { $_ eq $directive }"
NSQ_SOURCE_LINE 00000078 "                        @{$self->{allow_directives}};"
NSQ_SOURCE_LINE 00000079 "            }"
NSQ_SOURCE_LINE 00000080 "            if ($self->{disallow_directives}) {"
NSQ_SOURCE_LINE 00000081 "                $self->_err(\"Directive '$directive' is in \"."
NSQ_SOURCE_LINE 00000082 "                                \"disallow_directives list\")"
NSQ_SOURCE_LINE 00000083 "                    if grep { $_ eq $directive }"
NSQ_SOURCE_LINE 00000084 "                        @{$self->{disallow_directives}};"
NSQ_SOURCE_LINE 00000085 "            }"
NSQ_SOURCE_LINE 00000086 "            my $args = $self->_parse_command_line($line);"
NSQ_SOURCE_LINE 00000087 "            if (!defined($args)) {"
NSQ_SOURCE_LINE 00000088 "                $self->_err(\"Invalid arguments syntax '$line'\");"
NSQ_SOURCE_LINE 00000089 "            }"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "            if ($cb) {"
NSQ_SOURCE_LINE 00000092 "                $cb->("
NSQ_SOURCE_LINE 00000093 "                    event => 'directive',"
NSQ_SOURCE_LINE 00000094 "                    linum=>$self->{_linum}, line=>$line, cur_section=>$self->{_cur_section},"
NSQ_SOURCE_LINE 00000095 "                    directive => $directive,"
NSQ_SOURCE_LINE 00000096 "                    args => $args,"
NSQ_SOURCE_LINE 00000097 "                );"
NSQ_SOURCE_LINE 00000098 "            }"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "            if ($directive eq 'include') {"
NSQ_SOURCE_LINE 00000101 "                my $path;"
NSQ_SOURCE_LINE 00000102 "                if (! @$args) {"
NSQ_SOURCE_LINE 00000103 "                    $self->_err(\"Missing filename to include\");"
NSQ_SOURCE_LINE 00000104 "                } elsif (@$args > 1) {"
NSQ_SOURCE_LINE 00000105 "                    $self->_err(\"Extraneous arguments\");"
NSQ_SOURCE_LINE 00000106 "                } else {"
NSQ_SOURCE_LINE 00000107 "                    $path = $args->[0];"
NSQ_SOURCE_LINE 00000108 "                }"
NSQ_SOURCE_LINE 00000109 "                my $res = $self->_push_include_stack($path);"
NSQ_SOURCE_LINE 00000110 "                if ($res->[0] != 200) {"
NSQ_SOURCE_LINE 00000111 "                    $self->_err(\"Can't include '$path': $res->[1]\");"
NSQ_SOURCE_LINE 00000112 "                }"
NSQ_SOURCE_LINE 00000113 "                $path = $res->[2];"
NSQ_SOURCE_LINE 00000114 "                $self->_read_string($self->_read_file($path, $cb), $cb);"
NSQ_SOURCE_LINE 00000115 "                $self->_pop_include_stack;"
NSQ_SOURCE_LINE 00000116 "            } elsif ($directive eq 'merge') {"
NSQ_SOURCE_LINE 00000117 "                $self->{_merge} = @$args ? $args : undef;"
NSQ_SOURCE_LINE 00000118 "            } elsif ($directive eq 'noop') {"
NSQ_SOURCE_LINE 00000119 "            } else {"
NSQ_SOURCE_LINE 00000120 "                if ($self->{ignore_unknown_directive}) {"
NSQ_SOURCE_LINE 00000121 "                    # assume a regular comment"
NSQ_SOURCE_LINE 00000122 "                    next LINE;"
NSQ_SOURCE_LINE 00000123 "                } else {"
NSQ_SOURCE_LINE 00000124 "                    $self->_err(\"Unknown directive '$directive'\");"
NSQ_SOURCE_LINE 00000125 "                }"
NSQ_SOURCE_LINE 00000126 "            }"
NSQ_SOURCE_LINE 00000127 "            next LINE;"
NSQ_SOURCE_LINE 00000128 "        }"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "        # comment line"
NSQ_SOURCE_LINE 00000131 "        if ($line =~ /^\\s*[;#]/) {"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "            if ($cb) {"
NSQ_SOURCE_LINE 00000134 "                $cb->("
NSQ_SOURCE_LINE 00000135 "                    event => 'comment',"
NSQ_SOURCE_LINE 00000136 "                    linum=>$self->{_linum}, line=>$line, cur_section=>$self->{_cur_section},"
NSQ_SOURCE_LINE 00000137 "                );"
NSQ_SOURCE_LINE 00000138 "            }"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "            next LINE;"
NSQ_SOURCE_LINE 00000141 "        }"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "        # section line"
NSQ_SOURCE_LINE 00000144 "        if ($line =~ /^\\s*\\[\\s*(.+?)\\s*\\](?: \\s*[;#].*)?/) {"
NSQ_SOURCE_LINE 00000145 "            my $prev_section = $self->{_cur_section};"
NSQ_SOURCE_LINE 00000146 "            $self->{_cur_section} = $cur_section = $1;"
NSQ_SOURCE_LINE 00000147 "            $res->{$cur_section} //= {};"
NSQ_SOURCE_LINE 00000148 "            $self->{_num_seen_section_lines}++;"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "            # previous section exists? do merging for previous section"
NSQ_SOURCE_LINE 00000151 "            if ($self->{_merge} && $self->{_num_seen_section_lines} > 1) {"
NSQ_SOURCE_LINE 00000152 "                $self->_merge($prev_section);"
NSQ_SOURCE_LINE 00000153 "            }"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "            if ($cb) {"
NSQ_SOURCE_LINE 00000156 "                $cb->("
NSQ_SOURCE_LINE 00000157 "                    event => 'section',"
NSQ_SOURCE_LINE 00000158 "                    linum=>$self->{_linum}, line=>$line, cur_section=>$self->{_cur_section},"
NSQ_SOURCE_LINE 00000159 "                    section => $cur_section,"
NSQ_SOURCE_LINE 00000160 "                );"
NSQ_SOURCE_LINE 00000161 "            }"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "            next LINE;"
NSQ_SOURCE_LINE 00000164 "        }"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "        # key line"
NSQ_SOURCE_LINE 00000167 "        if ($line =~ /^\\s*([^=]+?)\\s*=(\\s*)(.*)/) {"
NSQ_SOURCE_LINE 00000168 "            my $key = $1;"
NSQ_SOURCE_LINE 00000169 "            my $space = $2;"
NSQ_SOURCE_LINE 00000170 "            my $val = $3;"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "            if ($self->{warn_perl} && !$space && $val =~ /\\A>/) {"
NSQ_SOURCE_LINE 00000173 "                $self->_warn(\"Probably using Perl syntax instead of INI: $line\");"
NSQ_SOURCE_LINE 00000174 "            }"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "            # the common case is that value are not decoded or"
NSQ_SOURCE_LINE 00000177 "            # quoted/bracketed/braced, so we avoid calling _parse_raw_value here"
NSQ_SOURCE_LINE 00000178 "            # to avoid overhead"
NSQ_SOURCE_LINE 00000179 "            if ($val =~ /\\A[\"!\\\\[\\{~]/) {"
NSQ_SOURCE_LINE 00000180 "                $_raw_val = $val if $cb;"
NSQ_SOURCE_LINE 00000181 "                my ($err, $parse_res, $decoded_val) = $self->_parse_raw_value($val);"
NSQ_SOURCE_LINE 00000182 "                $self->_err(\"Invalid value: \" . $err) if $err;"
NSQ_SOURCE_LINE 00000183 "                $val = $decoded_val;"
NSQ_SOURCE_LINE 00000184 "            } else {"
NSQ_SOURCE_LINE 00000185 "                $_raw_val = $val if $cb;"
NSQ_SOURCE_LINE 00000186 "                $val =~ s/\\s*[#;].*//; # strip comment"
NSQ_SOURCE_LINE 00000187 "            }"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "            if (exists $res->{$cur_section}{$key}) {"
NSQ_SOURCE_LINE 00000190 "                if (!$self->{allow_duplicate_key}) {"
NSQ_SOURCE_LINE 00000191 "                    $self->_err(\"Duplicate key: $key (section $cur_section)\");"
NSQ_SOURCE_LINE 00000192 "                } elsif ($self->{_arrayified}{$cur_section}{$key}++) {"
NSQ_SOURCE_LINE 00000193 "                    push @{ $res->{$cur_section}{$key} }, $val;"
NSQ_SOURCE_LINE 00000194 "                } else {"
NSQ_SOURCE_LINE 00000195 "                    $res->{$cur_section}{$key} = ["
NSQ_SOURCE_LINE 00000196 "                        $res->{$cur_section}{$key}, $val];"
NSQ_SOURCE_LINE 00000197 "                }"
NSQ_SOURCE_LINE 00000198 "            } else {"
NSQ_SOURCE_LINE 00000199 "                $res->{$cur_section}{$key} = $val;"
NSQ_SOURCE_LINE 00000200 "            }"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "            if ($cb) {"
NSQ_SOURCE_LINE 00000203 "                $cb->("
NSQ_SOURCE_LINE 00000204 "                    event => 'key',"
NSQ_SOURCE_LINE 00000205 "                    linum=>$self->{_linum}, line=>$line, cur_section=>$self->{_cur_section},"
NSQ_SOURCE_LINE 00000206 "                    key => $key,"
NSQ_SOURCE_LINE 00000207 "                    val => $val,"
NSQ_SOURCE_LINE 00000208 "                    raw_val => $_raw_val,"
NSQ_SOURCE_LINE 00000209 "                );"
NSQ_SOURCE_LINE 00000210 "            }"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "            next LINE;"
NSQ_SOURCE_LINE 00000213 "        }"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "        $self->_err(\"Invalid syntax\");"
NSQ_SOURCE_LINE 00000216 "    }"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "    if ($self->{_merge} && $self->{_num_seen_section_lines} > 1) {"
NSQ_SOURCE_LINE 00000219 "        $self->_merge($cur_section);"
NSQ_SOURCE_LINE 00000220 "    }"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "    $res;"
NSQ_SOURCE_LINE 00000223 "}"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "1;"
NSQ_SOURCE_LINE 00000226 "# ABSTRACT: Read IOD/INI configuration files"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "__END__"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "=pod"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "=head1 NAME"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "Config::IOD::Reader - Read IOD/INI configuration files"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "=head1 VERSION"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "This document describes version 0.345 of Config::IOD::Reader (from Perl distribution Config-IOD-Reader), released on 2022-05-02."
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 " use Config::IOD::Reader;"
NSQ_SOURCE_LINE 00000245 " my $reader = Config::IOD::Reader->new("
NSQ_SOURCE_LINE 00000246 "     # list of known attributes, with their default values"
NSQ_SOURCE_LINE 00000247 "     # default_section     => 'GLOBAL',"
NSQ_SOURCE_LINE 00000248 "     # enable_directive    => 1,"
NSQ_SOURCE_LINE 00000249 "     # enable_encoding     => 1,"
NSQ_SOURCE_LINE 00000250 "     # enable_quoting      => 1,"
NSQ_SOURCE_LINE 00000251 "     # enable_backet       => 1,"
NSQ_SOURCE_LINE 00000252 "     # enable_brace        => 1,"
NSQ_SOURCE_LINE 00000253 "     # allow_encodings     => undef, # or ['base64','json',...]"
NSQ_SOURCE_LINE 00000254 "     # disallow_encodings  => undef, # or ['base64','json',...]"
NSQ_SOURCE_LINE 00000255 "     # allow_directives    => undef, # or ['include','merge',...]"
NSQ_SOURCE_LINE 00000256 "     # disallow_directives => undef, # or ['include','merge',...]"
NSQ_SOURCE_LINE 00000257 "     # allow_bang_only     => 1,"
NSQ_SOURCE_LINE 00000258 "     # enable_expr         => 0,"
NSQ_SOURCE_LINE 00000259 "     # allow_duplicate_key => 1,"
NSQ_SOURCE_LINE 00000260 "     # ignore_unknown_directive => 0,"
NSQ_SOURCE_LINE 00000261 " );"
NSQ_SOURCE_LINE 00000262 " my $config_hash = $reader->read_file('config.iod');"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "This module reads L<IOD> configuration files (IOD is an INI-like format with"
NSQ_SOURCE_LINE 00000267 "more precise specification, some extra features, and 99% compatible with typical"
NSQ_SOURCE_LINE 00000268 "INI format). It is a minimalist alternative to the more fully-featured"
NSQ_SOURCE_LINE 00000269 "L<Config::IOD>. It cannot write IOD files and is optimized for low startup"
NSQ_SOURCE_LINE 00000270 "overhead."
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "=head1 EXPRESSION"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "Expression allows you to do things like:"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 " [section1]"
NSQ_SOURCE_LINE 00000277 " foo=1"
NSQ_SOURCE_LINE 00000278 " bar=\"monkey\""
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 " [section2]"
NSQ_SOURCE_LINE 00000281 " baz =!e 1+1"
NSQ_SOURCE_LINE 00000282 " qux =!e \"grease\" . val(\"section1.bar\")"
NSQ_SOURCE_LINE 00000283 " quux=!e val(\"qux\") . \" \" . val('baz')"
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "And the result will be:"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 " {"
NSQ_SOURCE_LINE 00000288 "     section1 => {foo=>1, bar=>\"monkey\"},"
NSQ_SOURCE_LINE 00000289 "     section2 => {baz=>2, qux=>\"greasemonkey\", quux=>\"greasemonkey 2\"},"
NSQ_SOURCE_LINE 00000290 " }"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "For safety, you'll need to set C<enable_expr> attribute to 1 first to enable"
NSQ_SOURCE_LINE 00000293 "this feature."
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "The syntax of the expression (the C<expr> encoding) is not officially specified"
NSQ_SOURCE_LINE 00000296 "yet in the L<IOD> specification. It will probably be Expr (see"
NSQ_SOURCE_LINE 00000297 "L<Language::Expr::Manual::Syntax>). At the moment, this module implements a very"
NSQ_SOURCE_LINE 00000298 "limited subset that is compatible (lowest common denominator) with Perl syntax"
NSQ_SOURCE_LINE 00000299 "and uses C<eval()> to evaluate the expression. However, only the limited subset"
NSQ_SOURCE_LINE 00000300 "is allowed (checked by Perl 5.10 regular expression)."
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "The supported terms:"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 " number"
NSQ_SOURCE_LINE 00000305 " string (double-quoted and single-quoted)"
NSQ_SOURCE_LINE 00000306 " undef literal"
NSQ_SOURCE_LINE 00000307 " simple variable ($abc, no namespace, no array/hash sigil, no special variables)"
NSQ_SOURCE_LINE 00000308 " function call (only the 'val' function is supported)"
NSQ_SOURCE_LINE 00000309 " grouping (parenthesis)"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "The supported operators are:"
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 " + - ."
NSQ_SOURCE_LINE 00000314 " * / % x"
NSQ_SOURCE_LINE 00000315 " **"
NSQ_SOURCE_LINE 00000316 " unary -, unary +, !, ~"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "The C<val()> function refers to the configuration key. If the argument contains"
NSQ_SOURCE_LINE 00000319 "\".\", it will be assumed as C<SECTIONNAME.KEYNAME>, otherwise it will access the"
NSQ_SOURCE_LINE 00000320 "current section's key. Since parsing is done in a single pass, you can only"
NSQ_SOURCE_LINE 00000321 "refer to the already mentioned key."
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "Code will be compiled using Perl's C<eval()> in the"
NSQ_SOURCE_LINE 00000324 "C<Config::IOD::Expr::_Compiled> namespace, with C<no strict>, C<no warnings>."
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "=head1 ATTRIBUTES"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "=head2 default_section => str (default: C<GLOBAL>)"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "If a key line is specified before any section line, this is the section that the"
NSQ_SOURCE_LINE 00000331 "key will be put in."
NSQ_SOURCE_LINE 00000332 ""
NSQ_SOURCE_LINE 00000333 "=head2 enable_directive => bool (default: 1)"
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "If set to false, then directives will not be parsed. Lines such as below will be"
NSQ_SOURCE_LINE 00000336 "considered a regular comment:"
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 " ;!include foo.ini"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "and lines such as below will be considered a syntax error (B<regardless> of the"
NSQ_SOURCE_LINE 00000341 "C<allow_bang_only> setting):"
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 " !include foo.ini"
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "B<NOTE: Turning this setting off violates IOD specification.>"
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "=head2 enable_encoding => bool (default: 1)"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "If set to false, then encoding notation will be ignored and key value will be"
NSQ_SOURCE_LINE 00000350 "parsed as verbatim. Example:"
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 " name = !json null"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "With C<enable_encoding> turned off, value will not be undef but will be string"
NSQ_SOURCE_LINE 00000355 "with the value of (as Perl literal) C<\"!json null\">."
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "B<NOTE: Turning this setting off violates IOD specification.>"
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "=head2 enable_quoting => bool (default: 1)"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "If set to false, then quotes on key value will be ignored and key value will be"
NSQ_SOURCE_LINE 00000362 "parsed as verbatim. Example:"
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 " name = \"line 1\\nline2\""
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "With C<enable_quoting> turned off, value will not be a two-line string, but will"
NSQ_SOURCE_LINE 00000367 "be a one line string with the value of (as Perl literal) C<\"line 1\\\\nline2\">."
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "B<NOTE: Turning this setting off violates IOD specification.>"
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "=head2 enable_bracket => bool (default: 1)"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "If set to false, then JSON literal array will be parsed as verbatim. Example:"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 " name = [1,2,3]"
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "With C<enable_bracket> turned off, value will not be a three-element array, but"
NSQ_SOURCE_LINE 00000378 "will be a string with the value of (as Perl literal) C<\"[1,2,3]\">."
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "B<NOTE: Turning this setting off violates IOD specification.>"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "=head2 enable_brace => bool (default: 1)"
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "If set to false, then JSON literal object (hash) will be parsed as verbatim."
NSQ_SOURCE_LINE 00000385 "Example:"
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 " name = {\"a\":1,\"b\":2}"
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "With C<enable_brace> turned off, value will not be a hash with two pairs, but"
NSQ_SOURCE_LINE 00000390 "will be a string with the value of (as Perl literal) C<'{\"a\":1,\"b\":2}'>."
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "B<NOTE: Turning this setting off violates IOD specification.>"
NSQ_SOURCE_LINE 00000393 ""
NSQ_SOURCE_LINE 00000394 "=head2 enable_tilde => bool (default: 1)"
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "If set to true (the default), then value that starts with C<~> (tilde) will be"
NSQ_SOURCE_LINE 00000397 "assumed to use !path encoding, unless an explicit encoding has been otherwise"
NSQ_SOURCE_LINE 00000398 "specified."
NSQ_SOURCE_LINE 00000399 ""
NSQ_SOURCE_LINE 00000400 "Example:"
NSQ_SOURCE_LINE 00000401 ""
NSQ_SOURCE_LINE 00000402 " log_dir = ~/logs  ; ~ will be resolved to current user's home directory"
NSQ_SOURCE_LINE 00000403 ""
NSQ_SOURCE_LINE 00000404 "With C<enable_tilde> turned off, value will still be literally C<~/logs>."
NSQ_SOURCE_LINE 00000405 ""
NSQ_SOURCE_LINE 00000406 "B<NOTE: Turning this setting off violates IOD specification.>"
NSQ_SOURCE_LINE 00000407 ""
NSQ_SOURCE_LINE 00000408 "=head2 allow_encodings => array"
NSQ_SOURCE_LINE 00000409 ""
NSQ_SOURCE_LINE 00000410 "If defined, set list of allowed encodings. Note that if C<disallow_encodings> is"
NSQ_SOURCE_LINE 00000411 "also set, an encoding must also not be in that list."
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "Also note that, for safety reason, if you want to enable C<expr> encoding,"
NSQ_SOURCE_LINE 00000414 "you'll also need to set C<enable_expr> to 1."
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "=head2 disallow_encodings => array"
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 "If defined, set list of disallowed encodings. Note that if C<allow_encodings> is"
NSQ_SOURCE_LINE 00000419 "also set, an encoding must also be in that list."
NSQ_SOURCE_LINE 00000420 ""
NSQ_SOURCE_LINE 00000421 "Also note that, for safety reason, if you want to enable C<expr> encoding,"
NSQ_SOURCE_LINE 00000422 "you'll also need to set C<enable_expr> to 1."
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "=head2 enable_expr => bool (default: 0)"
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 "Whether to enable C<expr> encoding. By default this is turned off, for safety."
NSQ_SOURCE_LINE 00000427 "Please see L</\"EXPRESSION\"> for more details."
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 "=head2 allow_directives => array"
NSQ_SOURCE_LINE 00000430 ""
NSQ_SOURCE_LINE 00000431 "If defined, only directives listed here are allowed. Note that if"
NSQ_SOURCE_LINE 00000432 "C<disallow_directives> is also set, a directive must also not be in that list."
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 "=head2 disallow_directives => array"
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 "If defined, directives listed here are not allowed. Note that if"
NSQ_SOURCE_LINE 00000437 "C<allow_directives> is also set, a directive must also be in that list."
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "=head2 allow_bang_only => bool (default: 1)"
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "Since the mistake of specifying a directive like this:"
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 " !foo"
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "instead of the correct:"
NSQ_SOURCE_LINE 00000446 ""
NSQ_SOURCE_LINE 00000447 " ;!foo"
NSQ_SOURCE_LINE 00000448 ""
NSQ_SOURCE_LINE 00000449 "is very common, the spec allows it. This reader, however, can be configured to"
NSQ_SOURCE_LINE 00000450 "be more strict."
NSQ_SOURCE_LINE 00000451 ""
NSQ_SOURCE_LINE 00000452 "=head2 allow_duplicate_key => bool (default: 1)"
NSQ_SOURCE_LINE 00000453 ""
NSQ_SOURCE_LINE 00000454 "If set to 0, you can forbid duplicate key, e.g.:"
NSQ_SOURCE_LINE 00000455 ""
NSQ_SOURCE_LINE 00000456 " [section]"
NSQ_SOURCE_LINE 00000457 " a=1"
NSQ_SOURCE_LINE 00000458 " a=2"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "or:"
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 " [section]"
NSQ_SOURCE_LINE 00000463 " a=1"
NSQ_SOURCE_LINE 00000464 " b=2"
NSQ_SOURCE_LINE 00000465 " c=3"
NSQ_SOURCE_LINE 00000466 " a=10"
NSQ_SOURCE_LINE 00000467 ""
NSQ_SOURCE_LINE 00000468 "In traditional INI file, to specify an array you specify multiple keys. But when"
NSQ_SOURCE_LINE 00000469 "there is only a single key, it is unclear if the value is a single-element array"
NSQ_SOURCE_LINE 00000470 "or a scalar. You can use this setting to avoid this array/scalar ambiguity in"
NSQ_SOURCE_LINE 00000471 "config file and force user to use JSON encoding or bracket to specify array:"
NSQ_SOURCE_LINE 00000472 ""
NSQ_SOURCE_LINE 00000473 " [section]"
NSQ_SOURCE_LINE 00000474 " a=[1,2]"
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 "B<NOTE: Turning this setting off violates IOD specification.>"
NSQ_SOURCE_LINE 00000477 ""
NSQ_SOURCE_LINE 00000478 "=head2 ignore_unknown_directive => bool (default: 0)"
NSQ_SOURCE_LINE 00000479 ""
NSQ_SOURCE_LINE 00000480 "If set to true, will not die if an unknown directive is encountered. It will"
NSQ_SOURCE_LINE 00000481 "simply be ignored as a regular comment."
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 "B<NOTE: Turning this setting on violates IOD specification.>"
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "=head2 warn_perl => bool (default: 0)"
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "Emit warning if configuration contains key line like these:"
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 " foo=>\"bar\""
NSQ_SOURCE_LINE 00000490 " foo => 123,"
NSQ_SOURCE_LINE 00000491 ""
NSQ_SOURCE_LINE 00000492 "which suggest user is assuming configuration is in Perl format instead of INI."
NSQ_SOURCE_LINE 00000493 ""
NSQ_SOURCE_LINE 00000494 "If you enable this option, but happens to have a value that begins with \">\", to"
NSQ_SOURCE_LINE 00000495 "avoid this warning you can quote the value first:"
NSQ_SOURCE_LINE 00000496 ""
NSQ_SOURCE_LINE 00000497 " foo=\">the value does begins with a greater-than sign\""
NSQ_SOURCE_LINE 00000498 " bar=\">the value does begins with a greater-than sign and ends with a comma,\""
NSQ_SOURCE_LINE 00000499 ""
NSQ_SOURCE_LINE 00000500 "=head1 METHODS"
NSQ_SOURCE_LINE 00000501 ""
NSQ_SOURCE_LINE 00000502 "=head2 new(%attrs) => obj"
NSQ_SOURCE_LINE 00000503 ""
NSQ_SOURCE_LINE 00000504 "=head2 $reader->read_file($filename[ , $callback ]) => hash"
NSQ_SOURCE_LINE 00000505 ""
NSQ_SOURCE_LINE 00000506 "Read IOD configuration from a file. Die on errors."
NSQ_SOURCE_LINE 00000507 ""
NSQ_SOURCE_LINE 00000508 "See C<read_string> for more information on C<$callback> argument."
NSQ_SOURCE_LINE 00000509 ""
NSQ_SOURCE_LINE 00000510 "=head2 $reader->read_string($str[ , $callback ]) => hash"
NSQ_SOURCE_LINE 00000511 ""
NSQ_SOURCE_LINE 00000512 "Read IOD configuration from a string. Die on errors."
NSQ_SOURCE_LINE 00000513 ""
NSQ_SOURCE_LINE 00000514 "C<$callback> is an optional coderef argument that will be called during various"
NSQ_SOURCE_LINE 00000515 "stages. It can be useful if you want more information (especially ordering). It"
NSQ_SOURCE_LINE 00000516 "will be called with hash argument C<%args>"
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "=over"
NSQ_SOURCE_LINE 00000519 ""
NSQ_SOURCE_LINE 00000520 "=item * Found a directive line"
NSQ_SOURCE_LINE 00000521 ""
NSQ_SOURCE_LINE 00000522 "Arguments passed: C<event> (str, has the value of 'directive'), C<linum> (int,"
NSQ_SOURCE_LINE 00000523 "line number, starts from 1), C<line> (str, raw line), C<directive> (str,"
NSQ_SOURCE_LINE 00000524 "directive name), C<cur_section> (str, current section name), C<args> (array,"
NSQ_SOURCE_LINE 00000525 "directive arguments)."
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 "=item * Found a comment line"
NSQ_SOURCE_LINE 00000528 ""
NSQ_SOURCE_LINE 00000529 "Arguments passed: C<event> (str, 'comment'), C<linum>, C<line>, C<cur_section>."
NSQ_SOURCE_LINE 00000530 ""
NSQ_SOURCE_LINE 00000531 "=item * Found a section line"
NSQ_SOURCE_LINE 00000532 ""
NSQ_SOURCE_LINE 00000533 "Arguments passed: C<event> (str, 'section'), C<linum>, C<line>, C<cur_section>,"
NSQ_SOURCE_LINE 00000534 "C<section> (str, section name)."
NSQ_SOURCE_LINE 00000535 ""
NSQ_SOURCE_LINE 00000536 "=item * Found a key line"
NSQ_SOURCE_LINE 00000537 ""
NSQ_SOURCE_LINE 00000538 "Arguments passed: C<event> (str, 'section'), C<linum>, C<line>, C<cur_section>,"
NSQ_SOURCE_LINE 00000539 "C<key> (str, key name), C<val> (any, value name, already decoded if encoded),"
NSQ_SOURCE_LINE 00000540 "C<raw_val> (str, raw value)."
NSQ_SOURCE_LINE 00000541 ""
NSQ_SOURCE_LINE 00000542 "=back"
NSQ_SOURCE_LINE 00000543 ""
NSQ_SOURCE_LINE 00000544 "TODO: callback when there is merging."
NSQ_SOURCE_LINE 00000545 ""
