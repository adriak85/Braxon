NSQ_SOURCE_LINE 00000001 "package Data::Page::NoTotalEntries;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use warnings;"
NSQ_SOURCE_LINE 00000004 "use 5.008001;"
NSQ_SOURCE_LINE 00000005 "our $VERSION = '0.02';"
NSQ_SOURCE_LINE 00000006 "use Class::Accessor::Lite 0.05 ("
NSQ_SOURCE_LINE 00000007 "    new => 1,"
NSQ_SOURCE_LINE 00000008 "    rw => [qw/has_next entries_per_page current_page entries_on_this_page/]"
NSQ_SOURCE_LINE 00000009 ");"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "sub next_page {"
NSQ_SOURCE_LINE 00000012 "    my $self = shift;"
NSQ_SOURCE_LINE 00000013 "    $self->has_next ? $self->current_page + 1 : undef;"
NSQ_SOURCE_LINE 00000014 "}"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "sub previous_page { goto &prev_page }"
NSQ_SOURCE_LINE 00000017 "sub prev_page {"
NSQ_SOURCE_LINE 00000018 "    my $self = shift;"
NSQ_SOURCE_LINE 00000019 "    $self->current_page > 1 ? $self->current_page - 1 : undef;"
NSQ_SOURCE_LINE 00000020 "}"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "sub first {"
NSQ_SOURCE_LINE 00000023 "    my $self = shift;"
NSQ_SOURCE_LINE 00000024 "    Carp::croak(\"'first' method requires 'entries_on_this_page'\") unless defined $self->entries_on_this_page;"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "    if ( $self->entries_on_this_page == 0 ) {"
NSQ_SOURCE_LINE 00000027 "        return 0;"
NSQ_SOURCE_LINE 00000028 "    }"
NSQ_SOURCE_LINE 00000029 "    else {"
NSQ_SOURCE_LINE 00000030 "        return ( ( $self->current_page - 1 ) * $self->entries_per_page ) + 1;"
NSQ_SOURCE_LINE 00000031 "    }"
NSQ_SOURCE_LINE 00000032 "}"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "sub last {"
NSQ_SOURCE_LINE 00000035 "    my $self = shift;"
NSQ_SOURCE_LINE 00000036 "    Carp::croak(\"'last' method requires 'entries_on_this_page'\") unless defined $self->entries_on_this_page;"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "    if ( !$self->has_next ) {"
NSQ_SOURCE_LINE 00000039 "        if ($self->entries_on_this_page == 0) {"
NSQ_SOURCE_LINE 00000040 "            return 0;"
NSQ_SOURCE_LINE 00000041 "        } else {"
NSQ_SOURCE_LINE 00000042 "            return $self->first + $self->entries_on_this_page - 1;"
NSQ_SOURCE_LINE 00000043 "        }"
NSQ_SOURCE_LINE 00000044 "    }"
NSQ_SOURCE_LINE 00000045 "    else {"
NSQ_SOURCE_LINE 00000046 "        return ( $self->current_page * $self->entries_per_page );"
NSQ_SOURCE_LINE 00000047 "    }"
NSQ_SOURCE_LINE 00000048 "}"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "1;"
NSQ_SOURCE_LINE 00000051 "__END__"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "=encoding utf8"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "=head1 NAME"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "Data::Page::NoTotalEntries - help when paging through sets of results without total entries"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "  use Data::Page::NoTotalEntries;"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "Data::Page::NoTotalEntries is a generic pager object, so it's very similar with L<Data::Page>."
NSQ_SOURCE_LINE 00000066 "But so Data::Page::NoTotalEntries doesn't support C<< $pager->total_entries >> and other some methods."
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "In sometime, I don't want to count total entries, because counting total entries from database are very slow."
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "=head1 METHODS"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "=over 4"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "=item my $pager = Data::Page::NoTotalEntries->new(%args);"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "Create new instance of Data::Page::NoTotalEntries."
NSQ_SOURCE_LINE 00000077 "You can initialize attributes at constructor with C<< %args >>."
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "=item $pager->next_page()"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "This method returns the next page number, if one exists. Otherwise"
NSQ_SOURCE_LINE 00000082 "it returns undefined:"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "    if ($page->next_page) {"
NSQ_SOURCE_LINE 00000085 "        print \"Next page number: \", $page->next_page, \"\\n\";"
NSQ_SOURCE_LINE 00000086 "    }"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "=item $pager->previous_page()"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "This method returns the previous page number, if one exists. Otherwise"
NSQ_SOURCE_LINE 00000091 "it returns undefined:"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "    if ($page->previous_page) {"
NSQ_SOURCE_LINE 00000094 "        print \"Previous page number: \", $page->previous_page, \"\\n\";"
NSQ_SOURCE_LINE 00000095 "    }"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "=item $pager->prev_page()"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "This is a alias for C<< $pager->previous_page() >>"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "=item $pager->first()"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "This method returns the number of the first entry on the current page."
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "=item $pager->last()"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "This method returns the number of the last entry on the current page."
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "=back"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "=head1 ATTRIBUTES"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "=over 4"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "=item has_next: Bool"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "Does this page has a next page?"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "=item entries_per_page: Int"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "The number of entries in each page."
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "=item current_page : Int"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "This attribute is the current page number:"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "=item entries_on_this_page: Int"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "This attribute is the number of entries on the current page"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "=back"
