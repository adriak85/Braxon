BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "use 5.008001;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use warnings;"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "package Log::Any;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "# ABSTRACT: Bringing loggers and listeners together"
NSQ_SOURCE_LINE 00000008 "our $VERSION = '1.720';"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use Log::Any::Manager;"
NSQ_SOURCE_LINE 00000011 "use Log::Any::Proxy::Null;"
NSQ_SOURCE_LINE 00000012 "use Log::Any::Adapter::Util qw("
NSQ_SOURCE_LINE 00000013 "  require_dynamic"
NSQ_SOURCE_LINE 00000014 "  detection_aliases"
NSQ_SOURCE_LINE 00000015 "  detection_methods"
NSQ_SOURCE_LINE 00000016 "  log_level_aliases"
NSQ_SOURCE_LINE 00000017 "  logging_aliases"
NSQ_SOURCE_LINE 00000018 "  logging_and_detection_methods"
NSQ_SOURCE_LINE 00000019 "  logging_methods"
NSQ_SOURCE_LINE 00000020 ");"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "# This is overridden in Log::Any::Test"
NSQ_SOURCE_LINE 00000023 "our $OverrideDefaultAdapterClass;"
NSQ_SOURCE_LINE 00000024 "our $OverrideDefaultProxyClass;"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "# singleton and accessor"
NSQ_SOURCE_LINE 00000027 "{"
NSQ_SOURCE_LINE 00000028 "    my $manager = Log::Any::Manager->new();"
NSQ_SOURCE_LINE 00000029 "    sub _manager { return $manager }"
NSQ_SOURCE_LINE 00000030 "    sub has_consumer { $manager->has_consumer }"
NSQ_SOURCE_LINE 00000031 "}"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "sub import {"
NSQ_SOURCE_LINE 00000034 "    my $class  = shift;"
NSQ_SOURCE_LINE 00000035 "    my $caller = caller();"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "    my @export_params = ( $caller, @_ );"
NSQ_SOURCE_LINE 00000038 "    $class->_export_to_caller(@export_params);"
NSQ_SOURCE_LINE 00000039 "}"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "sub _export_to_caller {"
NSQ_SOURCE_LINE 00000042 "    my $class  = shift;"
NSQ_SOURCE_LINE 00000043 "    my $caller = shift;"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "    # Parse parameters passed to 'use Log::Any'"
NSQ_SOURCE_LINE 00000046 "    my $saw_log_param;"
NSQ_SOURCE_LINE 00000047 "    my @params;"
NSQ_SOURCE_LINE 00000048 "    while ( my $param = shift @_ ) {"
NSQ_SOURCE_LINE 00000049 "        if ( !$saw_log_param && $param =~ /^\\$(\\w+)/ ) {"
NSQ_SOURCE_LINE 00000050 "            $saw_log_param = $1;   # defer until later"
NSQ_SOURCE_LINE 00000051 "            next;                  # singular"
NSQ_SOURCE_LINE 00000052 "        }"
NSQ_SOURCE_LINE 00000053 "        else {"
NSQ_SOURCE_LINE 00000054 "            push @params, $param, shift @_;    # pairwise"
NSQ_SOURCE_LINE 00000055 "        }"
NSQ_SOURCE_LINE 00000056 "    }"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "    unless ( @params % 2 == 0 ) {"
NSQ_SOURCE_LINE 00000059 "        require Carp;"
NSQ_SOURCE_LINE 00000060 "        Carp::croak(\"Argument list not balanced: @params\");"
NSQ_SOURCE_LINE 00000061 "    }"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "    # get logger if one was requested"
NSQ_SOURCE_LINE 00000064 "    if ( defined $saw_log_param ) {"
NSQ_SOURCE_LINE 00000065 "        no strict 'refs';"
NSQ_SOURCE_LINE 00000066 "        my $proxy = $class->get_logger( category => $caller, @params );"
NSQ_SOURCE_LINE 00000067 "        my $varname = \"${caller}::${saw_log_param}\";"
NSQ_SOURCE_LINE 00000068 "        *$varname = \\$proxy;"
NSQ_SOURCE_LINE 00000069 "    }"
NSQ_SOURCE_LINE 00000070 "}"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "sub get_logger {"
NSQ_SOURCE_LINE 00000073 "    my ( $class, %params ) = @_;"
NSQ_SOURCE_LINE 00000074 "    no warnings 'once';"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "    my $category ="
NSQ_SOURCE_LINE 00000077 "      defined $params{category} ? delete $params{'category'} : caller;"
NSQ_SOURCE_LINE 00000078 "    if ( my $default = delete $params{'default_adapter'} ) {"
NSQ_SOURCE_LINE 00000079 "        my @default_adapter_params = ();"
NSQ_SOURCE_LINE 00000080 "        if (ref $default eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000081 "            ($default, @default_adapter_params) = @{ $default };"
NSQ_SOURCE_LINE 00000082 "        }"
NSQ_SOURCE_LINE 00000083 "        # Every default adapter is set only for a given logger category."
NSQ_SOURCE_LINE 00000084 "        # When another adapter is configured (by using"
NSQ_SOURCE_LINE 00000085 "        # Log::Any::Adapter->set) for this category, it takes"
NSQ_SOURCE_LINE 00000086 "        # precedence, but if that adapter is later removed, the default"
NSQ_SOURCE_LINE 00000087 "        # we set here takes over again."
NSQ_SOURCE_LINE 00000088 "        $class->_manager->set_default("
NSQ_SOURCE_LINE 00000089 "            $category, $default, @default_adapter_params"
NSQ_SOURCE_LINE 00000090 "        );"
NSQ_SOURCE_LINE 00000091 "    }"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "    my $proxy_class = $class->_get_proxy_class( delete $params{proxy_class} );"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "    my $adapter = $class->_manager->get_adapter( $category );"
NSQ_SOURCE_LINE 00000096 "    my $context = $class->_manager->get_context();"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "    require_dynamic($proxy_class);"
NSQ_SOURCE_LINE 00000099 "    return $proxy_class->new("
NSQ_SOURCE_LINE 00000100 "        %params, adapter => $adapter, category => $category, context => $context"
NSQ_SOURCE_LINE 00000101 "    );"
NSQ_SOURCE_LINE 00000102 "}"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "sub _get_proxy_class {"
NSQ_SOURCE_LINE 00000105 "    my ( $self, $proxy_name ) = @_;"
NSQ_SOURCE_LINE 00000106 "    return $Log::Any::OverrideDefaultProxyClass"
NSQ_SOURCE_LINE 00000107 "      if $Log::Any::OverrideDefaultProxyClass;"
NSQ_SOURCE_LINE 00000108 "    return \"Log::Any::Proxy\" if !$proxy_name && _manager->has_consumer;"
NSQ_SOURCE_LINE 00000109 "    return \"Log::Any::Proxy::Null\" if !$proxy_name;"
NSQ_SOURCE_LINE 00000110 "    my $proxy_class = ("
NSQ_SOURCE_LINE 00000111 "          substr( $proxy_name, 0, 1 ) eq '+'"
NSQ_SOURCE_LINE 00000112 "        ? substr( $proxy_name, 1 )"
NSQ_SOURCE_LINE 00000113 "        : \"Log::Any::Proxy::$proxy_name\""
NSQ_SOURCE_LINE 00000114 "    );"
NSQ_SOURCE_LINE 00000115 "    return $proxy_class;"
NSQ_SOURCE_LINE 00000116 "}"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "# For backward compatibility"
NSQ_SOURCE_LINE 00000119 "sub set_adapter {"
NSQ_SOURCE_LINE 00000120 "    my $class = shift;"
NSQ_SOURCE_LINE 00000121 "    Log::Any->_manager->set(@_);"
NSQ_SOURCE_LINE 00000122 "}"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "1;"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "__END__"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "=pod"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "=head1 NAME"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "Log::Any - Bringing loggers and listeners together"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "=head1 VERSION"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "version 1.720"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "In a CPAN or other module:"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "    package Foo;"
NSQ_SOURCE_LINE 00000145 "    use Log::Any qw($log);"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "    # log a string"
NSQ_SOURCE_LINE 00000148 "    $log->error(\"an error occurred\");"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "    # log a string and some data"
NSQ_SOURCE_LINE 00000151 "    $log->info(\"program started\","
NSQ_SOURCE_LINE 00000152 "        {progname => $0, pid => $$, perl_version => $]});"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "    # log a string and data using a format string"
NSQ_SOURCE_LINE 00000155 "    $log->debugf(\"arguments are: %s\", \\@_);"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "    # log an error and throw an exception"
NSQ_SOURCE_LINE 00000158 "    die $log->fatal(\"a fatal error occurred\");"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "In a Moo/Moose-based module:"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "    package Foo;"
NSQ_SOURCE_LINE 00000163 "    use Log::Any ();"
NSQ_SOURCE_LINE 00000164 "    use Moo;"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "    has log => ("
NSQ_SOURCE_LINE 00000167 "        is => 'ro',"
NSQ_SOURCE_LINE 00000168 "        default => sub { Log::Any->get_logger },"
NSQ_SOURCE_LINE 00000169 "    );"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "In your application:"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "    use Foo;"
NSQ_SOURCE_LINE 00000174 "    use Log::Any::Adapter;"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "    # Send all logs to Log::Log4perl"
NSQ_SOURCE_LINE 00000177 "    Log::Any::Adapter->set('Log4perl');"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "    # Send all logs to Log::Dispatch"
NSQ_SOURCE_LINE 00000180 "    my $log = Log::Dispatch->new(outputs => [[ ... ]]);"
NSQ_SOURCE_LINE 00000181 "    Log::Any::Adapter->set( 'Dispatch', dispatcher => $log );"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "    # See Log::Any::Adapter documentation for more options"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "C<Log::Any> provides a standard log production API for modules."
NSQ_SOURCE_LINE 00000188 "L<Log::Any::Adapter> allows applications to choose the mechanism for log"
NSQ_SOURCE_LINE 00000189 "consumption, whether screen, file or another logging mechanism like"
NSQ_SOURCE_LINE 00000190 "L<Log::Dispatch> or L<Log::Log4perl>."
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "Many modules have something interesting to say. Unfortunately there is no"
NSQ_SOURCE_LINE 00000193 "standard way for them to say it - some output to STDERR, others to C<warn>,"
NSQ_SOURCE_LINE 00000194 "others to custom file logs. And there is no standard way to get a module to"
NSQ_SOURCE_LINE 00000195 "start talking - sometimes you must call a uniquely named method, other times"
NSQ_SOURCE_LINE 00000196 "set a package variable."
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "This being Perl, there are many logging mechanisms available on CPAN.  Each has"
NSQ_SOURCE_LINE 00000199 "their pros and cons. Unfortunately, the existence of so many mechanisms makes"
NSQ_SOURCE_LINE 00000200 "it difficult for a CPAN author to commit his/her users to one of them. This may"
NSQ_SOURCE_LINE 00000201 "be why many CPAN modules invent their own logging or choose not to log at all."
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "To untangle this situation, we must separate the two parts of a logging API."
NSQ_SOURCE_LINE 00000204 "The first, I<log production>, includes methods to output logs (like"
NSQ_SOURCE_LINE 00000205 "C<$log-E<gt>debug>) and methods to inspect whether a log level is activated"
NSQ_SOURCE_LINE 00000206 "(like C<$log-E<gt>is_debug>). This is generally all that CPAN modules care"
NSQ_SOURCE_LINE 00000207 "about. The second, I<log consumption>, includes a way to configure where"
NSQ_SOURCE_LINE 00000208 "logging goes (a file, the screen, etc.) and the code to send it there. This"
NSQ_SOURCE_LINE 00000209 "choice generally belongs to the application."
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "A CPAN module uses C<Log::Any> to get a log producer object.  An application,"
NSQ_SOURCE_LINE 00000212 "in turn, may choose one or more logging mechanisms via L<Log::Any::Adapter>, or"
NSQ_SOURCE_LINE 00000213 "none at all."
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "C<Log::Any> has a very tiny footprint and no dependencies beyond Perl 5.8.1,"
NSQ_SOURCE_LINE 00000216 "which makes it appropriate for even small CPAN modules to use. It defaults to"
NSQ_SOURCE_LINE 00000217 "'null' logging activity, so a module can safely log without worrying about"
NSQ_SOURCE_LINE 00000218 "whether the application has chosen (or will ever choose) a logging mechanism."
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "See L<http://www.openswartz.com/2007/09/06/standard-logging-api/> for the"
NSQ_SOURCE_LINE 00000221 "original post proposing this module."
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "=head1 LOG LEVELS"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "C<Log::Any> supports the following log levels and aliases, which is meant to be"
NSQ_SOURCE_LINE 00000226 "inclusive of the major logging packages:"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "     trace"
NSQ_SOURCE_LINE 00000229 "     debug"
NSQ_SOURCE_LINE 00000230 "     info (inform)"
NSQ_SOURCE_LINE 00000231 "     notice"
NSQ_SOURCE_LINE 00000232 "     warning (warn)"
NSQ_SOURCE_LINE 00000233 "     error (err)"
NSQ_SOURCE_LINE 00000234 "     critical (crit, fatal)"
NSQ_SOURCE_LINE 00000235 "     alert"
NSQ_SOURCE_LINE 00000236 "     emergency"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "Levels are translated as appropriate to the underlying logging mechanism. For"
NSQ_SOURCE_LINE 00000239 "example, log4perl only has six levels, so we translate 'notice' to 'info' and"
NSQ_SOURCE_LINE 00000240 "the top three levels to 'fatal'.  See the documentation of an adapter class"
NSQ_SOURCE_LINE 00000241 "for specifics."
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "=head1 CATEGORIES"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "Every logger has a category, generally the name of the class that asked for the"
NSQ_SOURCE_LINE 00000246 "logger. Some logging mechanisms, like log4perl, can direct logs to different"
NSQ_SOURCE_LINE 00000247 "places depending on category."
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "=head1 PRODUCING LOGS (FOR MODULES)"
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "=head2 Getting a logger"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "The most convenient way to get a logger in your module is:"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "    use Log::Any qw($log);"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "This creates a package variable I<$log> and assigns it to the logger for the"
NSQ_SOURCE_LINE 00000258 "current package. It is equivalent to"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "    our $log = Log::Any->get_logger;"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "In general, to get a logger for a specified category:"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "    my $log = Log::Any->get_logger(category => $category)"
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "If no category is specified, the calling package is used."
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "A logger object is an instance of L<Log::Any::Proxy>, which passes"
NSQ_SOURCE_LINE 00000269 "on messages to the L<Log::Any::Adapter> handling its category."
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "If the C<proxy_class> argument is passed, an alternative to"
NSQ_SOURCE_LINE 00000272 "L<Log::Any::Proxy> (such as a subclass) will be instantiated and returned"
NSQ_SOURCE_LINE 00000273 "instead.  The argument is automatically prepended with \"Log::Any::Proxy::\"."
NSQ_SOURCE_LINE 00000274 "If instead you want to pass the full name of a proxy class, prefix it with"
NSQ_SOURCE_LINE 00000275 "a \"+\". E.g."
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "    # Log::Any::Proxy::Foo"
NSQ_SOURCE_LINE 00000278 "    my $log = Log::Any->get_logger(proxy_class => 'Foo');"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "    # MyLog::Proxy"
NSQ_SOURCE_LINE 00000281 "    my $log = Log::Any->get_logger(proxy_class => '+MyLog::Proxy');"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "=head2 Logging"
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "To log a message, pass a single string to any of the log levels or aliases. e.g."
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "    $log->error(\"this is an error\");"
NSQ_SOURCE_LINE 00000288 "    $log->warn(\"this is a warning\");"
NSQ_SOURCE_LINE 00000289 "    $log->warning(\"this is also a warning\");"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "The log string will be returned so that it can be used further (e.g. for a C<die> or"
NSQ_SOURCE_LINE 00000292 "C<warn> call)."
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "You should B<not> include a newline in your message; that is the responsibility"
NSQ_SOURCE_LINE 00000295 "of the logging mechanism, which may or may not want the newline."
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "If you want to log additional structured data alongside with your string, you"
NSQ_SOURCE_LINE 00000298 "can add a single hashref after your log string. e.g."
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "    $log->info(\"program started\","
NSQ_SOURCE_LINE 00000301 "        {progname => $0, pid => $$, perl_version => $]});"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "If the configured L<Log::Any::Adapter> does not support logging structured data,"
NSQ_SOURCE_LINE 00000304 "the hash will be converted to a string using L<Data::Dumper>."
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "There are also versions of each of the logging methods with an additional \"f\" suffix"
NSQ_SOURCE_LINE 00000307 "(C<infof>, C<errorf>, C<debugf>, etc.) that format a list of arguments.  The"
NSQ_SOURCE_LINE 00000308 "specific formatting mechanism and meaning of the arguments is controlled by the"
NSQ_SOURCE_LINE 00000309 "L<Log::Any::Proxy> object."
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "    $log->errorf(\"an error occurred: %s\", $@);"
NSQ_SOURCE_LINE 00000312 "    $log->debugf(\"called with %d params: %s\", $param_count, \\@params);"
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "By default it renders like L<C<sprintf>|perlfunc/\"sprintf FORMAT, LIST\">,"
NSQ_SOURCE_LINE 00000315 "with the following additional features:"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "=over"
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "=item *"
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "Any complex references (like C<\\@params> above) are automatically converted to"
NSQ_SOURCE_LINE 00000322 "single-line strings with L<Data::Dumper>."
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "=item *"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "Any undefined values are automatically converted to the string \"<undef>\"."
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "=back"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "=head2 Log level detection"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "To detect whether a log level is on, use \"is_\" followed by any of the log"
NSQ_SOURCE_LINE 00000333 "levels or aliases. e.g."
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "    if ($log->is_info()) { ... }"
NSQ_SOURCE_LINE 00000336 "    $log->debug(\"arguments are: \" . Dumper(\\@_))"
NSQ_SOURCE_LINE 00000337 "        if $log->is_debug();"
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "This is important for efficiency, as you can avoid the work of putting together"
NSQ_SOURCE_LINE 00000340 "the logging message (in the above case, stringifying C<@_>) if the log level is"
NSQ_SOURCE_LINE 00000341 "not active."
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "The formatting methods (C<infof>, C<errorf>, etc.) check the log level for you."
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "Some logging mechanisms don't support detection of log levels. In these cases"
NSQ_SOURCE_LINE 00000346 "the detection methods will always return 1."
NSQ_SOURCE_LINE 00000347 ""
NSQ_SOURCE_LINE 00000348 "In contrast, the default logging mechanism - Null - will return 0 for all"
NSQ_SOURCE_LINE 00000349 "detection methods."
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "=head2 Log context data"
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "C<Log::Any> supports logging context data by exposing the C<context>"
NSQ_SOURCE_LINE 00000354 "hashref. All the key/value pairs added to this hash will be printed"
NSQ_SOURCE_LINE 00000355 "with every log message. You can localize the data so that it will be"
NSQ_SOURCE_LINE 00000356 "removed again automatically at the end of the block:"
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 "    $log->context->{directory} = $dir;"
NSQ_SOURCE_LINE 00000359 "    for my $file (glob \"$dir/*\") {"
NSQ_SOURCE_LINE 00000360 "        local $log->context->{file} = basename($file);"
NSQ_SOURCE_LINE 00000361 "        $log->warn(\"Can't read file!\") unless -r $file;"
NSQ_SOURCE_LINE 00000362 "    }"
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "This will produce the following line:"
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "    Can't read file! {directory => '/foo',file => 'bar'}"
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 "If the configured L<Log::Any::Adapter> does not support structured"
NSQ_SOURCE_LINE 00000369 "data, the context hash will be converted to a string using"
NSQ_SOURCE_LINE 00000370 "L<Data::Dumper>, and will be appended to the log message."
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "=head2 Setting an alternate default logger"
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "When no other adapters are configured for your logger, C<Log::Any>"
NSQ_SOURCE_LINE 00000375 "uses the C<default_adapter>. To choose something other than Null as"
NSQ_SOURCE_LINE 00000376 "the default, either set the C<LOG_ANY_DEFAULT_ADAPTER> environment"
NSQ_SOURCE_LINE 00000377 "variable, or pass it as a parameter when loading C<Log::Any>"
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "    use Log::Any '$log', default_adapter => 'Stderr';"
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "The name of the default class follows the same rules as used by L<Log::Any::Adapter>."
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "To pass arguments to the default adapter's constructor, use an arrayref:"
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "    use Log::Any '$log', default_adapter => [ 'File' => '/var/log/mylog.log' ];"
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "When a consumer configures their own adapter, the default adapter will be"
NSQ_SOURCE_LINE 00000388 "overridden. If they later remove their adapter, the default adapter will be"
NSQ_SOURCE_LINE 00000389 "used again."
NSQ_SOURCE_LINE 00000390 ""
NSQ_SOURCE_LINE 00000391 "=head2 Configuring the proxy"
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "Any parameters passed on the import line or via the C<get_logger> method"
NSQ_SOURCE_LINE 00000394 "are passed on to the L<Log::Any::Proxy> constructor."
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "    use Log::Any '$log', filter => \\&myfilter;"
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "=head2 Testing"
NSQ_SOURCE_LINE 00000399 ""
NSQ_SOURCE_LINE 00000400 "L<Log::Any::Test> provides a mechanism to test code that uses C<Log::Any>."
NSQ_SOURCE_LINE 00000401 ""
NSQ_SOURCE_LINE 00000402 "=head1 CONSUMING LOGS (FOR APPLICATIONS)"
NSQ_SOURCE_LINE 00000403 ""
NSQ_SOURCE_LINE 00000404 "Log::Any provides modules with a L<Log::Any::Proxy> object, which is the log"
NSQ_SOURCE_LINE 00000405 "producer.  To consume its output and direct it where you want (a file, the"
NSQ_SOURCE_LINE 00000406 "screen, syslog, etc.), you use L<Log::Any::Adapter> along with a"
NSQ_SOURCE_LINE 00000407 "destination-specific subclass."
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "For example, to send output to a file via L<Log::Any::Adapter::File>, your"
NSQ_SOURCE_LINE 00000410 "application could do this:"
NSQ_SOURCE_LINE 00000411 ""
NSQ_SOURCE_LINE 00000412 "    use Log::Any::Adapter ('File', '/path/to/file.log');"
NSQ_SOURCE_LINE 00000413 ""
NSQ_SOURCE_LINE 00000414 "See the L<Log::Any::Adapter> documentation for more details."
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "To detect if a consumer exists, use C<< Log::Any->has_consumer >>."
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 "=head1 Q & A"
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "=over"
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "=item Isn't Log::Any just yet another logging mechanism?"
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "No. C<Log::Any> does not include code that knows how to log to a particular"
NSQ_SOURCE_LINE 00000425 "place (file, screen, etc.) It can only forward logging requests to another"
NSQ_SOURCE_LINE 00000426 "logging mechanism."
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "=item Why don't you just pick the best logging mechanism, and use and promote it?"
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "Each of the logging mechanisms have their pros and cons, particularly in terms"
NSQ_SOURCE_LINE 00000431 "of how they are configured. For example, log4perl offers a great deal of power"
NSQ_SOURCE_LINE 00000432 "and flexibility but uses a global and potentially heavy configuration, whereas"
NSQ_SOURCE_LINE 00000433 "L<Log::Dispatch> is extremely configuration-light but doesn't handle"
NSQ_SOURCE_LINE 00000434 "categories. There is also the unnamed future logger that may have advantages"
NSQ_SOURCE_LINE 00000435 "over either of these two, and all the custom in-house loggers people have"
NSQ_SOURCE_LINE 00000436 "created and cannot (for whatever reason) stop using."
NSQ_SOURCE_LINE 00000437 ""
NSQ_SOURCE_LINE 00000438 "=item Is it safe for my critical module to depend on Log::Any?"
NSQ_SOURCE_LINE 00000439 ""
NSQ_SOURCE_LINE 00000440 "Our intent is to keep C<Log::Any> minimal, and change it only when absolutely"
NSQ_SOURCE_LINE 00000441 "necessary. Most of the \"innovation\", if any, is expected to occur in"
NSQ_SOURCE_LINE 00000442 "C<Log::Any::Adapter>, which your module should not have to depend on (unless it"
NSQ_SOURCE_LINE 00000443 "wants to direct logs somewhere specific). C<Log::Any> has no non-core dependencies."
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "=item Why doesn't Log::Any use I<insert modern Perl technique>?"
NSQ_SOURCE_LINE 00000446 ""
NSQ_SOURCE_LINE 00000447 "To encourage CPAN module authors to adopt and use C<Log::Any>, we aim to have"
NSQ_SOURCE_LINE 00000448 "as few dependencies and chances of breakage as possible. Thus, no C<Moose> or"
NSQ_SOURCE_LINE 00000449 "other niceties."
NSQ_SOURCE_LINE 00000450 ""
NSQ_SOURCE_LINE 00000451 "=back"
NSQ_SOURCE_LINE 00000452 ""
