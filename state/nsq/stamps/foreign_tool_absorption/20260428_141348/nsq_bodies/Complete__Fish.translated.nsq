NSQ_SOURCE_LINE 00000001 "package Complete::Fish;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2020-01-29'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.060'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use 5.010001;"
NSQ_SOURCE_LINE 00000007 "use strict;"
NSQ_SOURCE_LINE 00000008 "use warnings;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "require Exporter;"
NSQ_SOURCE_LINE 00000011 "our @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000012 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000013 "                       format_completion"
NSQ_SOURCE_LINE 00000014 "               );"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "require Complete::Bash;"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "our %SPEC;"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "$SPEC{':package'} = {"
NSQ_SOURCE_LINE 00000021 "    v => 1.1,"
NSQ_SOURCE_LINE 00000022 "    summary => 'Completion module for fish shell',"
NSQ_SOURCE_LINE 00000023 "};"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "$SPEC{format_completion} = {"
NSQ_SOURCE_LINE 00000026 "    v => 1.1,"
NSQ_SOURCE_LINE 00000027 "    summary => 'Format completion for output (for shell)',"
NSQ_SOURCE_LINE 00000028 "    description => <<'_',"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "fish accepts completion reply in the form of one entry per line to STDOUT."
NSQ_SOURCE_LINE 00000031 "Description can be added to each entry, prefixed by tab character."
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "_"
NSQ_SOURCE_LINE 00000034 "    args_as => 'array',"
NSQ_SOURCE_LINE 00000035 "    args => {"
NSQ_SOURCE_LINE 00000036 "        completion => {"
NSQ_SOURCE_LINE 00000037 "            summary => 'Completion answer structure',"
NSQ_SOURCE_LINE 00000038 "            description => <<'_',"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "Either an array or hash, as described in `Complete`."
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "_"
NSQ_SOURCE_LINE 00000043 "            schema=>['any*' => of => ['hash*', 'array*']],"
NSQ_SOURCE_LINE 00000044 "            req=>1,"
NSQ_SOURCE_LINE 00000045 "            pos=>0,"
NSQ_SOURCE_LINE 00000046 "        },"
NSQ_SOURCE_LINE 00000047 "    },"
NSQ_SOURCE_LINE 00000048 "    result => {"
NSQ_SOURCE_LINE 00000049 "        summary => 'Formatted string (or array, if `as` key is set to `array`)',"
NSQ_SOURCE_LINE 00000050 "        schema => ['any*' => of => ['str*', 'array*']],"
NSQ_SOURCE_LINE 00000051 "    },"
NSQ_SOURCE_LINE 00000052 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000053 "};"
NSQ_SOURCE_LINE 00000054 "sub format_completion {"
NSQ_SOURCE_LINE 00000055 "    my $comp = shift;"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "    my $as;"
NSQ_SOURCE_LINE 00000058 "    my $entries;"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "    # we currently use Complete::Bash's rule because i haven't done a read up on"
NSQ_SOURCE_LINE 00000061 "    # how exactly fish escaping rules are."
NSQ_SOURCE_LINE 00000062 "    if (ref $comp eq 'HASH') {"
NSQ_SOURCE_LINE 00000063 "        $as = $comp->{as} // 'string';"
NSQ_SOURCE_LINE 00000064 "        $entries = Complete::Bash::format_completion({%$comp}, {as=>'array'});"
NSQ_SOURCE_LINE 00000065 "    } else {"
NSQ_SOURCE_LINE 00000066 "        $as = 'string';"
NSQ_SOURCE_LINE 00000067 "        $entries = Complete::Bash::format_completion({words=>$comp}, {as=>'array'});"
NSQ_SOURCE_LINE 00000068 "    }"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "    # insert description"
NSQ_SOURCE_LINE 00000071 "    {"
NSQ_SOURCE_LINE 00000072 "        my $compary = ref($comp) eq 'HASH' ? $comp->{words} : $comp;"
NSQ_SOURCE_LINE 00000073 "        for (my $i=0; $i<@$compary; $i++) {"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "            my $desc = (ref($compary->[$i]) eq 'HASH' ?"
NSQ_SOURCE_LINE 00000076 "                            $compary->[$i]{description} : '' ) // '';"
NSQ_SOURCE_LINE 00000077 "            $desc =~ s/\\R/ /g;"
NSQ_SOURCE_LINE 00000078 "            $entries->[$i] .= \"\\t$desc\";"
NSQ_SOURCE_LINE 00000079 "        }"
NSQ_SOURCE_LINE 00000080 "    }"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "    # turn back to string if that's what the user wants"
NSQ_SOURCE_LINE 00000083 "    if ($as eq 'string') {"
NSQ_SOURCE_LINE 00000084 "        $entries = join(\"\", map{\"$_\\n\"} @$entries);"
NSQ_SOURCE_LINE 00000085 "    }"
NSQ_SOURCE_LINE 00000086 "    $entries;"
NSQ_SOURCE_LINE 00000087 "}"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "1;"
NSQ_SOURCE_LINE 00000090 "# ABSTRACT: Completion module for fish shell"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "__END__"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "=pod"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "=head1 NAME"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "Complete::Fish - Completion module for fish shell"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "=head1 VERSION"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "This document describes version 0.060 of Complete::Fish (from Perl distribution Complete-Fish), released on 2020-01-29."
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "fish allows completion of option arguments to come from an external command,"
NSQ_SOURCE_LINE 00000109 "e.g.:"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 " % complete -c deluser -l user -d Username -a \"(cat /etc/passwd|cut -d : -f 1)\""
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "The command is supposed to return completion entries one in a separate line."
NSQ_SOURCE_LINE 00000114 "Description for each entry can be added, prefixed with a tab character. The"
NSQ_SOURCE_LINE 00000115 "provided function C<format_completion()> accept a completion answer structure"
NSQ_SOURCE_LINE 00000116 "and format it for fish. Example:"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 " format_completion([\"a\", \"b\", {word=>\"c\", description=>\"Another letter\"}])"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "will result in:"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 " a"
NSQ_SOURCE_LINE 00000123 " b"
NSQ_SOURCE_LINE 00000124 " c       Another letter"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "=head2 format_completion"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "Usage:"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 " format_completion($completion) -> str|array"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "Format completion for output (for shell)."
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "fish accepts completion reply in the form of one entry per line to STDOUT."
NSQ_SOURCE_LINE 00000138 "Description can be added to each entry, prefixed by tab character."
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "=over 4"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "=item * B<$completion>* => I<hash|array>"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "Completion answer structure."
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "Either an array or hash, as described in C<Complete>."
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "=back"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "Return value: Formatted string (or array, if `as` key is set to `array`) (str|array)"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "Please visit the project's homepage at L<https://metacpan.org/release/Complete-Fish>."
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "Source repository is at L<https://github.com/perlancar/perl-Complete-Fish>."
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "=head1 BUGS"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "Please report any bugs or feature requests on the bugtracker website L<https://rt.cpan.org/Public/Dist/Display.html?Name=Complete-Fish>"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "When submitting a bug or request, please include a test-file or a"
NSQ_SOURCE_LINE 00000170 "patch to an existing test-file that illustrates the bug or desired"
NSQ_SOURCE_LINE 00000171 "feature."
NSQ_SOURCE_LINE 00000172 ""
