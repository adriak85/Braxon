NSQ_SOURCE_LINE 00000001 "#############################################################################"
NSQ_SOURCE_LINE 00000002 "# Pod/Parser.pm -- package which defines a base class for parsing POD docs."
NSQ_SOURCE_LINE 00000003 "#"
NSQ_SOURCE_LINE 00000004 "# Copyright (C) 1996-2000 by Bradford Appleton. All rights reserved."
NSQ_SOURCE_LINE 00000005 "# This file is part of \"PodParser\". PodParser is free software;"
NSQ_SOURCE_LINE 00000006 "# you can redistribute it and/or modify it under the same terms"
NSQ_SOURCE_LINE 00000007 "# as Perl itself."
NSQ_SOURCE_LINE 00000008 "#############################################################################"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "package Pod::Parser;"
NSQ_SOURCE_LINE 00000011 "use strict;"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "## These \"variables\" are used as local \"glob aliases\" for performance"
NSQ_SOURCE_LINE 00000014 "use vars qw($VERSION @ISA %myData %myOpts @input_stack);"
NSQ_SOURCE_LINE 00000015 "$VERSION = '1.67';  ## Current version of this package"
NSQ_SOURCE_LINE 00000016 "require  5.005;    ## requires this Perl version or later"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "#############################################################################"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "=head1 NAME"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "Pod::Parser - base class for creating POD filters and translators"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "    use Pod::Parser;"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "    package MyParser;"
NSQ_SOURCE_LINE 00000029 "    @ISA = qw(Pod::Parser);"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "    sub command { "
NSQ_SOURCE_LINE 00000032 "        my ($parser, $command, $paragraph, $line_num) = @_;"
NSQ_SOURCE_LINE 00000033 "        ## Interpret the command and its text; sample actions might be:"
NSQ_SOURCE_LINE 00000034 "        if ($command eq 'head1') { ... }"
NSQ_SOURCE_LINE 00000035 "        elsif ($command eq 'head2') { ... }"
NSQ_SOURCE_LINE 00000036 "        ## ... other commands and their actions"
NSQ_SOURCE_LINE 00000037 "        my $out_fh = $parser->output_handle();"
NSQ_SOURCE_LINE 00000038 "        my $expansion = $parser->interpolate($paragraph, $line_num);"
NSQ_SOURCE_LINE 00000039 "        print $out_fh $expansion;"
NSQ_SOURCE_LINE 00000040 "    }"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "    sub verbatim { "
NSQ_SOURCE_LINE 00000043 "        my ($parser, $paragraph, $line_num) = @_;"
NSQ_SOURCE_LINE 00000044 "        ## Format verbatim paragraph; sample actions might be:"
NSQ_SOURCE_LINE 00000045 "        my $out_fh = $parser->output_handle();"
NSQ_SOURCE_LINE 00000046 "        print $out_fh $paragraph;"
NSQ_SOURCE_LINE 00000047 "    }"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "    sub textblock { "
NSQ_SOURCE_LINE 00000050 "        my ($parser, $paragraph, $line_num) = @_;"
NSQ_SOURCE_LINE 00000051 "        ## Translate/Format this block of text; sample actions might be:"
NSQ_SOURCE_LINE 00000052 "        my $out_fh = $parser->output_handle();"
NSQ_SOURCE_LINE 00000053 "        my $expansion = $parser->interpolate($paragraph, $line_num);"
NSQ_SOURCE_LINE 00000054 "        print $out_fh $expansion;"
NSQ_SOURCE_LINE 00000055 "    }"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "    sub interior_sequence { "
NSQ_SOURCE_LINE 00000058 "        my ($parser, $seq_command, $seq_argument) = @_;"
NSQ_SOURCE_LINE 00000059 "        ## Expand an interior sequence; sample actions might be:"
NSQ_SOURCE_LINE 00000060 "        return \"*$seq_argument*\"     if ($seq_command eq 'B');"
NSQ_SOURCE_LINE 00000061 "        return \"`$seq_argument'\"     if ($seq_command eq 'C');"
NSQ_SOURCE_LINE 00000062 "        return \"_${seq_argument}_'\"  if ($seq_command eq 'I');"
NSQ_SOURCE_LINE 00000063 "        ## ... other sequence commands and their resulting text"
NSQ_SOURCE_LINE 00000064 "    }"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "    package main;"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "    ## Create a parser object and have it parse file whose name was"
NSQ_SOURCE_LINE 00000069 "    ## given on the command-line (use STDIN if no files were given)."
NSQ_SOURCE_LINE 00000070 "    $parser = new MyParser();"
NSQ_SOURCE_LINE 00000071 "    $parser->parse_from_filehandle(\\*STDIN)  if (@ARGV == 0);"
NSQ_SOURCE_LINE 00000072 "    for (@ARGV) { $parser->parse_from_file($_); }"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "=head1 REQUIRES"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "perl5.005, Pod::InputObjects, Exporter, Symbol, Carp"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "=head1 EXPORTS"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "Nothing."
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "B<NOTE: This module is considered legacy; modern Perl releases (5.31.1 and"
NSQ_SOURCE_LINE 00000085 "higher) are going to remove Pod-Parser from core and use L<Pod::Simple>"
NSQ_SOURCE_LINE 00000086 "for all things POD.>"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "B<Pod::Parser> is a base class for creating POD filters and translators."
NSQ_SOURCE_LINE 00000089 "It handles most of the effort involved with parsing the POD sections"
NSQ_SOURCE_LINE 00000090 "from an input stream, leaving subclasses free to be concerned only with"
NSQ_SOURCE_LINE 00000091 "performing the actual translation of text."
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "B<Pod::Parser> parses PODs, and makes method calls to handle the various"
NSQ_SOURCE_LINE 00000094 "components of the POD. Subclasses of B<Pod::Parser> override these methods"
NSQ_SOURCE_LINE 00000095 "to translate the POD into whatever output format they desire."
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "=head1 QUICK OVERVIEW"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "To create a POD filter for translating POD documentation into some other"
NSQ_SOURCE_LINE 00000100 "format, you create a subclass of B<Pod::Parser> which typically overrides"
NSQ_SOURCE_LINE 00000101 "just the base class implementation for the following methods:"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "=over 2"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "=item *"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "B<command()>"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "=item *"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "B<verbatim()>"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "=item *"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "B<textblock()>"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "=item *"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "B<interior_sequence()>"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "=back"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "You may also want to override the B<begin_input()> and B<end_input()>"
NSQ_SOURCE_LINE 00000124 "methods for your subclass (to perform any needed per-file and/or"
NSQ_SOURCE_LINE 00000125 "per-document initialization or cleanup)."
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "If you need to perform any preprocessing of input before it is parsed"
NSQ_SOURCE_LINE 00000128 "you may want to override one or more of B<preprocess_line()> and/or"
NSQ_SOURCE_LINE 00000129 "B<preprocess_paragraph()>."
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "Sometimes it may be necessary to make more than one pass over the input"
NSQ_SOURCE_LINE 00000132 "files. If this is the case you have several options. You can make the"
NSQ_SOURCE_LINE 00000133 "first pass using B<Pod::Parser> and override your methods to store the"
NSQ_SOURCE_LINE 00000134 "intermediate results in memory somewhere for the B<end_pod()> method to"
NSQ_SOURCE_LINE 00000135 "process. You could use B<Pod::Parser> for several passes with an"
NSQ_SOURCE_LINE 00000136 "appropriate state variable to control the operation for each pass. If"
NSQ_SOURCE_LINE 00000137 "your input source can't be reset to start at the beginning, you can"
NSQ_SOURCE_LINE 00000138 "store it in some other structure as a string or an array and have that"
NSQ_SOURCE_LINE 00000139 "structure implement a B<getline()> method (which is all that"
NSQ_SOURCE_LINE 00000140 "B<parse_from_filehandle()> uses to read input)."
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "Feel free to add any member data fields you need to keep track of things"
NSQ_SOURCE_LINE 00000143 "like current font, indentation, horizontal or vertical position, or"
NSQ_SOURCE_LINE 00000144 "whatever else you like. Be sure to read L<\"PRIVATE METHODS AND DATA\">"
NSQ_SOURCE_LINE 00000145 "to avoid name collisions."
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "For the most part, the B<Pod::Parser> base class should be able to"
NSQ_SOURCE_LINE 00000148 "do most of the input parsing for you and leave you free to worry about"
NSQ_SOURCE_LINE 00000149 "how to interpret the commands and translate the result."
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "Note that all we have described here in this quick overview is the"
NSQ_SOURCE_LINE 00000152 "simplest most straightforward use of B<Pod::Parser> to do stream-based"
NSQ_SOURCE_LINE 00000153 "parsing. It is also possible to use the B<Pod::Parser::parse_text> function"
NSQ_SOURCE_LINE 00000154 "to do more sophisticated tree-based parsing. See L<\"TREE-BASED PARSING\">."
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "=head1 PARSING OPTIONS"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "A I<parse-option> is simply a named option of B<Pod::Parser> with a"
NSQ_SOURCE_LINE 00000159 "value that corresponds to a certain specified behavior. These various"
NSQ_SOURCE_LINE 00000160 "behaviors of B<Pod::Parser> may be enabled/disabled by setting"
NSQ_SOURCE_LINE 00000161 "or unsetting one or more I<parse-options> using the B<parseopts()> method."
NSQ_SOURCE_LINE 00000162 "The set of currently accepted parse-options is as follows:"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "=over 3"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "=item B<-want_nonPODs> (default: unset)"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "Normally (by default) B<Pod::Parser> will only provide access to"
NSQ_SOURCE_LINE 00000169 "the POD sections of the input. Input paragraphs that are not part"
NSQ_SOURCE_LINE 00000170 "of the POD-format documentation are not made available to the caller"
NSQ_SOURCE_LINE 00000171 "(not even using B<preprocess_paragraph()>). Setting this option to a"
NSQ_SOURCE_LINE 00000172 "non-empty, non-zero value will allow B<preprocess_paragraph()> to see"
NSQ_SOURCE_LINE 00000173 "non-POD sections of the input as well as POD sections. The B<cutting()>"
NSQ_SOURCE_LINE 00000174 "method can be used to determine if the corresponding paragraph is a POD"
NSQ_SOURCE_LINE 00000175 "paragraph, or some other input paragraph."
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "=item B<-process_cut_cmd> (default: unset)"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "Normally (by default) B<Pod::Parser> handles the C<=cut> POD directive"
NSQ_SOURCE_LINE 00000180 "by itself and does not pass it on to the caller for processing. Setting"
NSQ_SOURCE_LINE 00000181 "this option to a non-empty, non-zero value will cause B<Pod::Parser> to"
NSQ_SOURCE_LINE 00000182 "pass the C<=cut> directive to the caller just like any other POD command"
NSQ_SOURCE_LINE 00000183 "(and hence it may be processed by the B<command()> method)."
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "B<Pod::Parser> will still interpret the C<=cut> directive to mean that"
NSQ_SOURCE_LINE 00000186 "\"cutting mode\" has been (re)entered, but the caller will get a chance"
NSQ_SOURCE_LINE 00000187 "to capture the actual C<=cut> paragraph itself for whatever purpose"
NSQ_SOURCE_LINE 00000188 "it desires."
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "=item B<-warnings> (default: unset)"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "Normally (by default) B<Pod::Parser> recognizes a bare minimum of"
NSQ_SOURCE_LINE 00000193 "pod syntax errors and warnings and issues diagnostic messages"
NSQ_SOURCE_LINE 00000194 "for errors, but not for warnings. (Use B<Pod::Checker> to do more"
NSQ_SOURCE_LINE 00000195 "thorough checking of POD syntax.) Setting this option to a non-empty,"
NSQ_SOURCE_LINE 00000196 "non-zero value will cause B<Pod::Parser> to issue diagnostics for"
NSQ_SOURCE_LINE 00000197 "the few warnings it recognizes as well as the errors."
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "=back"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "Please see L<\"parseopts()\"> for a complete description of the interface"
NSQ_SOURCE_LINE 00000202 "for the setting and unsetting of parse-options."
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "=cut"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "#############################################################################"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "#use diagnostics;"
NSQ_SOURCE_LINE 00000209 "use Pod::InputObjects;"
NSQ_SOURCE_LINE 00000210 "use Carp;"
NSQ_SOURCE_LINE 00000211 "use Exporter;"
NSQ_SOURCE_LINE 00000212 "BEGIN {"
NSQ_SOURCE_LINE 00000213 "   if ($] < 5.006) {"
NSQ_SOURCE_LINE 00000214 "      require Symbol;"
NSQ_SOURCE_LINE 00000215 "      import Symbol;"
NSQ_SOURCE_LINE 00000216 "   }"
NSQ_SOURCE_LINE 00000217 "}"
NSQ_SOURCE_LINE 00000218 "@ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "#############################################################################"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "=head1 RECOMMENDED SUBROUTINE/METHOD OVERRIDES"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "B<Pod::Parser> provides several methods which most subclasses will probably"
NSQ_SOURCE_LINE 00000225 "want to override. These methods are as follows:"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "=cut"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "##---------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "=head1 B<command()>"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "            $parser->command($cmd,$text,$line_num,$pod_para);"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "This method should be overridden by subclasses to take the appropriate"
NSQ_SOURCE_LINE 00000236 "action when a POD command paragraph (denoted by a line beginning with"
NSQ_SOURCE_LINE 00000237 "\"=\") is encountered. When such a POD directive is seen in the input,"
NSQ_SOURCE_LINE 00000238 "this method is called and is passed:"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "=over 3"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "=item C<$cmd>"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "the name of the command for this POD paragraph"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "=item C<$text>"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "the paragraph text for the given POD paragraph command."
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "=item C<$line_num>"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "the line-number of the beginning of the paragraph"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "=item C<$pod_para>"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "a reference to a C<Pod::Paragraph> object which contains further"
NSQ_SOURCE_LINE 00000257 "information about the paragraph command (see L<Pod::InputObjects>"
NSQ_SOURCE_LINE 00000258 "for details)."
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "=back"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "B<Note> that this method I<is> called for C<=pod> paragraphs."
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "The base class implementation of this method simply treats the raw POD"
NSQ_SOURCE_LINE 00000265 "command as normal block of paragraph text (invoking the B<textblock()>"
NSQ_SOURCE_LINE 00000266 "method with the command paragraph)."
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "=cut"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "sub command {"
NSQ_SOURCE_LINE 00000271 "    my ($self, $cmd, $text, $line_num, $pod_para)  = @_;"
NSQ_SOURCE_LINE 00000272 "    ## Just treat this like a textblock"
NSQ_SOURCE_LINE 00000273 "    $self->textblock($pod_para->raw_text(), $line_num, $pod_para);"
NSQ_SOURCE_LINE 00000274 "}"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "##---------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "=head1 B<verbatim()>"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "            $parser->verbatim($text,$line_num,$pod_para);"
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "This method may be overridden by subclasses to take the appropriate"
NSQ_SOURCE_LINE 00000283 "action when a block of verbatim text is encountered. It is passed the"
NSQ_SOURCE_LINE 00000284 "following parameters:"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "=over 3"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "=item C<$text>"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "the block of text for the verbatim paragraph"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "=item C<$line_num>"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "the line-number of the beginning of the paragraph"
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "=item C<$pod_para>"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "a reference to a C<Pod::Paragraph> object which contains further"
NSQ_SOURCE_LINE 00000299 "information about the paragraph (see L<Pod::InputObjects>"
NSQ_SOURCE_LINE 00000300 "for details)."
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "=back"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "The base class implementation of this method simply prints the textblock"
NSQ_SOURCE_LINE 00000305 "(unmodified) to the output filehandle."
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "=cut"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "sub verbatim {"
NSQ_SOURCE_LINE 00000310 "    my ($self, $text, $line_num, $pod_para) = @_;"
NSQ_SOURCE_LINE 00000311 "    my $out_fh = $self->{_OUTPUT};"
NSQ_SOURCE_LINE 00000312 "    print $out_fh $text;"
NSQ_SOURCE_LINE 00000313 "}"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "##---------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "=head1 B<textblock()>"
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "            $parser->textblock($text,$line_num,$pod_para);"
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "This method may be overridden by subclasses to take the appropriate"
NSQ_SOURCE_LINE 00000322 "action when a normal block of POD text is encountered (although the base"
NSQ_SOURCE_LINE 00000323 "class method will usually do what you want). It is passed the following"
NSQ_SOURCE_LINE 00000324 "parameters:"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "=over 3"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "=item C<$text>"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "the block of text for the a POD paragraph"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "=item C<$line_num>"
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "the line-number of the beginning of the paragraph"
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "=item C<$pod_para>"
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "a reference to a C<Pod::Paragraph> object which contains further"
NSQ_SOURCE_LINE 00000339 "information about the paragraph (see L<Pod::InputObjects>"
NSQ_SOURCE_LINE 00000340 "for details)."
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "=back"
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "In order to process interior sequences, subclasses implementations of"
NSQ_SOURCE_LINE 00000345 "this method will probably want to invoke either B<interpolate()> or"
NSQ_SOURCE_LINE 00000346 "B<parse_text()>, passing it the text block C<$text>, and the corresponding"
NSQ_SOURCE_LINE 00000347 "line number in C<$line_num>, and then perform any desired processing upon"
NSQ_SOURCE_LINE 00000348 "the returned result."
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "The base class implementation of this method simply prints the text block"
NSQ_SOURCE_LINE 00000351 "as it occurred in the input stream)."
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "=cut"
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 "sub textblock {"
NSQ_SOURCE_LINE 00000356 "    my ($self, $text, $line_num, $pod_para) = @_;"
NSQ_SOURCE_LINE 00000357 "    my $out_fh = $self->{_OUTPUT};"
NSQ_SOURCE_LINE 00000358 "    print $out_fh $self->interpolate($text, $line_num);"
NSQ_SOURCE_LINE 00000359 "}"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "##---------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "=head1 B<interior_sequence()>"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "            $parser->interior_sequence($seq_cmd,$seq_arg,$pod_seq);"
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "This method should be overridden by subclasses to take the appropriate"
NSQ_SOURCE_LINE 00000368 "action when an interior sequence is encountered. An interior sequence is"
NSQ_SOURCE_LINE 00000369 "an embedded command within a block of text which appears as a command"
NSQ_SOURCE_LINE 00000370 "name (usually a single uppercase character) followed immediately by a"
NSQ_SOURCE_LINE 00000371 "string of text which is enclosed in angle brackets. This method is"
NSQ_SOURCE_LINE 00000372 "passed the sequence command C<$seq_cmd> and the corresponding text"
NSQ_SOURCE_LINE 00000373 "C<$seq_arg>. It is invoked by the B<interpolate()> method for each interior"
NSQ_SOURCE_LINE 00000374 "sequence that occurs in the string that it is passed. It should return"
NSQ_SOURCE_LINE 00000375 "the desired text string to be used in place of the interior sequence."
NSQ_SOURCE_LINE 00000376 "The C<$pod_seq> argument is a reference to a C<Pod::InteriorSequence>"
NSQ_SOURCE_LINE 00000377 "object which contains further information about the interior sequence."
NSQ_SOURCE_LINE 00000378 "Please see L<Pod::InputObjects> for details if you need to access this"
NSQ_SOURCE_LINE 00000379 "additional information."
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "Subclass implementations of this method may wish to invoke the "
NSQ_SOURCE_LINE 00000382 "B<nested()> method of C<$pod_seq> to see if it is nested inside"
NSQ_SOURCE_LINE 00000383 "some other interior-sequence (and if so, which kind)."
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "The base class implementation of the B<interior_sequence()> method"
NSQ_SOURCE_LINE 00000386 "simply returns the raw text of the interior sequence (as it occurred"
NSQ_SOURCE_LINE 00000387 "in the input) to the caller."
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "=cut"
NSQ_SOURCE_LINE 00000390 ""
NSQ_SOURCE_LINE 00000391 "sub interior_sequence {"
NSQ_SOURCE_LINE 00000392 "    my ($self, $seq_cmd, $seq_arg, $pod_seq) = @_;"
NSQ_SOURCE_LINE 00000393 "    ## Just return the raw text of the interior sequence"
NSQ_SOURCE_LINE 00000394 "    return  $pod_seq->raw_text();"
NSQ_SOURCE_LINE 00000395 "}"
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "#############################################################################"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "=head1 OPTIONAL SUBROUTINE/METHOD OVERRIDES"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "B<Pod::Parser> provides several methods which subclasses may want to override"
NSQ_SOURCE_LINE 00000402 "to perform any special pre/post-processing. These methods do I<not> have to"
NSQ_SOURCE_LINE 00000403 "be overridden, but it may be useful for subclasses to take advantage of them."
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "=cut"
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "##---------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "=head1 B<new()>"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "            my $parser = Pod::Parser->new();"
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "This is the constructor for B<Pod::Parser> and its subclasses. You"
NSQ_SOURCE_LINE 00000414 "I<do not> need to override this method! It is capable of constructing"
NSQ_SOURCE_LINE 00000415 "subclass objects as well as base class objects, provided you use"
NSQ_SOURCE_LINE 00000416 "any of the following constructor invocation styles:"
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 "    my $parser1 = MyParser->new();"
NSQ_SOURCE_LINE 00000419 "    my $parser2 = new MyParser();"
NSQ_SOURCE_LINE 00000420 "    my $parser3 = $parser2->new();"
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "where C<MyParser> is some subclass of B<Pod::Parser>."
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "Using the syntax C<MyParser::new()> to invoke the constructor is I<not>"
NSQ_SOURCE_LINE 00000425 "recommended, but if you insist on being able to do this, then the"
NSQ_SOURCE_LINE 00000426 "subclass I<will> need to override the B<new()> constructor method. If"
NSQ_SOURCE_LINE 00000427 "you do override the constructor, you I<must> be sure to invoke the"
NSQ_SOURCE_LINE 00000428 "B<initialize()> method of the newly blessed object."
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "Using any of the above invocations, the first argument to the"
NSQ_SOURCE_LINE 00000431 "constructor is always the corresponding package name (or object"
NSQ_SOURCE_LINE 00000432 "reference). No other arguments are required, but if desired, an"
NSQ_SOURCE_LINE 00000433 "associative array (or hash-table) my be passed to the B<new()>"
NSQ_SOURCE_LINE 00000434 "constructor, as in:"
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 "    my $parser1 = MyParser->new( MYDATA => $value1, MOREDATA => $value2 );"
NSQ_SOURCE_LINE 00000437 "    my $parser2 = new MyParser( -myflag => 1 );"
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "All arguments passed to the B<new()> constructor will be treated as"
NSQ_SOURCE_LINE 00000440 "key/value pairs in a hash-table. The newly constructed object will be"
NSQ_SOURCE_LINE 00000441 "initialized by copying the contents of the given hash-table (which may"
NSQ_SOURCE_LINE 00000442 "have been empty). The B<new()> constructor for this class and all of its"
NSQ_SOURCE_LINE 00000443 "subclasses returns a blessed reference to the initialized object (hash-table)."
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "=cut"
NSQ_SOURCE_LINE 00000446 ""
NSQ_SOURCE_LINE 00000447 "sub new {"
NSQ_SOURCE_LINE 00000448 "    ## Determine if we were called via an object-ref or a classname"
NSQ_SOURCE_LINE 00000449 "    my ($this,%params) = @_;"
NSQ_SOURCE_LINE 00000450 "    my $class = ref($this) || $this;"
NSQ_SOURCE_LINE 00000451 "    ## Any remaining arguments are treated as initial values for the"
NSQ_SOURCE_LINE 00000452 "    ## hash that is used to represent this object."
NSQ_SOURCE_LINE 00000453 "    my $self = { %params };"
NSQ_SOURCE_LINE 00000454 "    ## Bless ourselves into the desired class and perform any initialization"
NSQ_SOURCE_LINE 00000455 "    bless $self, $class;"
NSQ_SOURCE_LINE 00000456 "    $self->initialize();"
NSQ_SOURCE_LINE 00000457 "    return $self;"
NSQ_SOURCE_LINE 00000458 "}"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "##---------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 "=head1 B<initialize()>"
NSQ_SOURCE_LINE 00000463 ""
NSQ_SOURCE_LINE 00000464 "            $parser->initialize();"
NSQ_SOURCE_LINE 00000465 ""
NSQ_SOURCE_LINE 00000466 "This method performs any necessary object initialization. It takes no"
NSQ_SOURCE_LINE 00000467 "arguments (other than the object instance of course, which is typically"
NSQ_SOURCE_LINE 00000468 "copied to a local variable named C<$self>). If subclasses override this"
NSQ_SOURCE_LINE 00000469 "method then they I<must> be sure to invoke C<$self-E<gt>SUPER::initialize()>."
NSQ_SOURCE_LINE 00000470 ""
NSQ_SOURCE_LINE 00000471 "=cut"
NSQ_SOURCE_LINE 00000472 ""
NSQ_SOURCE_LINE 00000473 "sub initialize {"
NSQ_SOURCE_LINE 00000474 "    #my $self = shift;"
NSQ_SOURCE_LINE 00000475 "    #return;"
NSQ_SOURCE_LINE 00000476 "}"
NSQ_SOURCE_LINE 00000477 ""
NSQ_SOURCE_LINE 00000478 "##---------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000479 ""
NSQ_SOURCE_LINE 00000480 "=head1 B<begin_pod()>"
NSQ_SOURCE_LINE 00000481 ""
NSQ_SOURCE_LINE 00000482 "            $parser->begin_pod();"
NSQ_SOURCE_LINE 00000483 ""
NSQ_SOURCE_LINE 00000484 "This method is invoked at the beginning of processing for each POD"
NSQ_SOURCE_LINE 00000485 "document that is encountered in the input. Subclasses should override"
NSQ_SOURCE_LINE 00000486 "this method to perform any per-document initialization."
NSQ_SOURCE_LINE 00000487 ""
NSQ_SOURCE_LINE 00000488 "=cut"
NSQ_SOURCE_LINE 00000489 ""
NSQ_SOURCE_LINE 00000490 "sub begin_pod {"
NSQ_SOURCE_LINE 00000491 "    #my $self = shift;"
NSQ_SOURCE_LINE 00000492 "    #return;"
NSQ_SOURCE_LINE 00000493 "}"
NSQ_SOURCE_LINE 00000494 ""
NSQ_SOURCE_LINE 00000495 "##---------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000496 ""
NSQ_SOURCE_LINE 00000497 "=head1 B<begin_input()>"
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "            $parser->begin_input();"
NSQ_SOURCE_LINE 00000500 ""
NSQ_SOURCE_LINE 00000501 "This method is invoked by B<parse_from_filehandle()> immediately I<before>"
NSQ_SOURCE_LINE 00000502 "processing input from a filehandle. The base class implementation does"
NSQ_SOURCE_LINE 00000503 "nothing, however, subclasses may override it to perform any per-file"
NSQ_SOURCE_LINE 00000504 "initializations."
NSQ_SOURCE_LINE 00000505 ""
NSQ_SOURCE_LINE 00000506 "Note that if multiple files are parsed for a single POD document"
NSQ_SOURCE_LINE 00000507 "(perhaps the result of some future C<=include> directive) this method"
NSQ_SOURCE_LINE 00000508 "is invoked for every file that is parsed. If you wish to perform certain"
NSQ_SOURCE_LINE 00000509 "initializations once per document, then you should use B<begin_pod()>."
NSQ_SOURCE_LINE 00000510 ""
NSQ_SOURCE_LINE 00000511 "=cut"
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "sub begin_input {"
NSQ_SOURCE_LINE 00000514 "    #my $self = shift;"
NSQ_SOURCE_LINE 00000515 "    #return;"
NSQ_SOURCE_LINE 00000516 "}"
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "##---------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000519 ""
NSQ_SOURCE_LINE 00000520 "=head1 B<end_input()>"
NSQ_SOURCE_LINE 00000521 ""
NSQ_SOURCE_LINE 00000522 "            $parser->end_input();"
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 "This method is invoked by B<parse_from_filehandle()> immediately I<after>"
NSQ_SOURCE_LINE 00000525 "processing input from a filehandle. The base class implementation does"
NSQ_SOURCE_LINE 00000526 "nothing, however, subclasses may override it to perform any per-file"
NSQ_SOURCE_LINE 00000527 "cleanup actions."
NSQ_SOURCE_LINE 00000528 ""
NSQ_SOURCE_LINE 00000529 "Please note that if multiple files are parsed for a single POD document"
NSQ_SOURCE_LINE 00000530 "(perhaps the result of some kind of C<=include> directive) this method"
NSQ_SOURCE_LINE 00000531 "is invoked for every file that is parsed. If you wish to perform certain"
NSQ_SOURCE_LINE 00000532 "cleanup actions once per document, then you should use B<end_pod()>."
NSQ_SOURCE_LINE 00000533 ""
NSQ_SOURCE_LINE 00000534 "=cut"
NSQ_SOURCE_LINE 00000535 ""
NSQ_SOURCE_LINE 00000536 "sub end_input {"
NSQ_SOURCE_LINE 00000537 "    #my $self = shift;"
NSQ_SOURCE_LINE 00000538 "    #return;"
NSQ_SOURCE_LINE 00000539 "}"
NSQ_SOURCE_LINE 00000540 ""
NSQ_SOURCE_LINE 00000541 "##---------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000542 ""
NSQ_SOURCE_LINE 00000543 "=head1 B<end_pod()>"
NSQ_SOURCE_LINE 00000544 ""
NSQ_SOURCE_LINE 00000545 "            $parser->end_pod();"
NSQ_SOURCE_LINE 00000546 ""
NSQ_SOURCE_LINE 00000547 "This method is invoked at the end of processing for each POD document"
NSQ_SOURCE_LINE 00000548 "that is encountered in the input. Subclasses should override this method"
NSQ_SOURCE_LINE 00000549 "to perform any per-document finalization."
NSQ_SOURCE_LINE 00000550 ""
NSQ_SOURCE_LINE 00000551 "=cut"
NSQ_SOURCE_LINE 00000552 ""
NSQ_SOURCE_LINE 00000553 "sub end_pod {"
NSQ_SOURCE_LINE 00000554 "    #my $self = shift;"
NSQ_SOURCE_LINE 00000555 "    #return;"
NSQ_SOURCE_LINE 00000556 "}"
NSQ_SOURCE_LINE 00000557 ""
NSQ_SOURCE_LINE 00000558 "##---------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000559 ""
NSQ_SOURCE_LINE 00000560 "=head1 B<preprocess_line()>"
NSQ_SOURCE_LINE 00000561 ""
NSQ_SOURCE_LINE 00000562 "          $textline = $parser->preprocess_line($text, $line_num);"
NSQ_SOURCE_LINE 00000563 ""
NSQ_SOURCE_LINE 00000564 "This method should be overridden by subclasses that wish to perform"
NSQ_SOURCE_LINE 00000565 "any kind of preprocessing for each I<line> of input (I<before> it has"
NSQ_SOURCE_LINE 00000566 "been determined whether or not it is part of a POD paragraph). The"
NSQ_SOURCE_LINE 00000567 "parameter C<$text> is the input line; and the parameter C<$line_num> is"
NSQ_SOURCE_LINE 00000568 "the line number of the corresponding text line."
NSQ_SOURCE_LINE 00000569 ""
NSQ_SOURCE_LINE 00000570 "The value returned should correspond to the new text to use in its"
NSQ_SOURCE_LINE 00000571 "place.  If the empty string or an undefined value is returned then no"
NSQ_SOURCE_LINE 00000572 "further processing will be performed for this line."
NSQ_SOURCE_LINE 00000573 ""
NSQ_SOURCE_LINE 00000574 "Please note that the B<preprocess_line()> method is invoked I<before>"
NSQ_SOURCE_LINE 00000575 "the B<preprocess_paragraph()> method. After all (possibly preprocessed)"
NSQ_SOURCE_LINE 00000576 "lines in a paragraph have been assembled together and it has been"
NSQ_SOURCE_LINE 00000577 "determined that the paragraph is part of the POD documentation from one"
NSQ_SOURCE_LINE 00000578 "of the selected sections, then B<preprocess_paragraph()> is invoked."
NSQ_SOURCE_LINE 00000579 ""
NSQ_SOURCE_LINE 00000580 "The base class implementation of this method returns the given text."
NSQ_SOURCE_LINE 00000581 ""
NSQ_SOURCE_LINE 00000582 "=cut"
NSQ_SOURCE_LINE 00000583 ""
NSQ_SOURCE_LINE 00000584 "sub preprocess_line {"
NSQ_SOURCE_LINE 00000585 "    my ($self, $text, $line_num) = @_;"
NSQ_SOURCE_LINE 00000586 "    return  $text;"
NSQ_SOURCE_LINE 00000587 "}"
NSQ_SOURCE_LINE 00000588 ""
NSQ_SOURCE_LINE 00000589 "##---------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000590 ""
NSQ_SOURCE_LINE 00000591 "=head1 B<preprocess_paragraph()>"
NSQ_SOURCE_LINE 00000592 ""
NSQ_SOURCE_LINE 00000593 "            $textblock = $parser->preprocess_paragraph($text, $line_num);"
NSQ_SOURCE_LINE 00000594 ""
NSQ_SOURCE_LINE 00000595 "This method should be overridden by subclasses that wish to perform any"
NSQ_SOURCE_LINE 00000596 "kind of preprocessing for each block (paragraph) of POD documentation"
NSQ_SOURCE_LINE 00000597 "that appears in the input stream. The parameter C<$text> is the POD"
NSQ_SOURCE_LINE 00000598 "paragraph from the input file; and the parameter C<$line_num> is the"
NSQ_SOURCE_LINE 00000599 "line number for the beginning of the corresponding paragraph."
NSQ_SOURCE_LINE 00000600 ""
NSQ_SOURCE_LINE 00000601 "The value returned should correspond to the new text to use in its"
NSQ_SOURCE_LINE 00000602 "place If the empty string is returned or an undefined value is"
NSQ_SOURCE_LINE 00000603 "returned, then the given C<$text> is ignored (not processed)."
NSQ_SOURCE_LINE 00000604 ""
NSQ_SOURCE_LINE 00000605 "This method is invoked after gathering up all the lines in a paragraph"
NSQ_SOURCE_LINE 00000606 "and after determining the cutting state of the paragraph,"
NSQ_SOURCE_LINE 00000607 "but before trying to further parse or interpret them. After"
NSQ_SOURCE_LINE 00000608 "B<preprocess_paragraph()> returns, the current cutting state (which"
NSQ_SOURCE_LINE 00000609 "is returned by C<$self-E<gt>cutting()>) is examined. If it evaluates"
NSQ_SOURCE_LINE 00000610 "to true then input text (including the given C<$text>) is cut (not"
NSQ_SOURCE_LINE 00000611 "processed) until the next POD directive is encountered."
NSQ_SOURCE_LINE 00000612 ""
NSQ_SOURCE_LINE 00000613 "Please note that the B<preprocess_line()> method is invoked I<before>"
NSQ_SOURCE_LINE 00000614 "the B<preprocess_paragraph()> method. After all (possibly preprocessed)"
NSQ_SOURCE_LINE 00000615 "lines in a paragraph have been assembled together and either it has been"
NSQ_SOURCE_LINE 00000616 "determined that the paragraph is part of the POD documentation from one"
NSQ_SOURCE_LINE 00000617 "of the selected sections or the C<-want_nonPODs> option is true,"
NSQ_SOURCE_LINE 00000618 "then B<preprocess_paragraph()> is invoked."
NSQ_SOURCE_LINE 00000619 ""
NSQ_SOURCE_LINE 00000620 "The base class implementation of this method returns the given text."
NSQ_SOURCE_LINE 00000621 ""
NSQ_SOURCE_LINE 00000622 "=cut"
NSQ_SOURCE_LINE 00000623 ""
NSQ_SOURCE_LINE 00000624 "sub preprocess_paragraph {"
NSQ_SOURCE_LINE 00000625 "    my ($self, $text, $line_num) = @_;"
NSQ_SOURCE_LINE 00000626 "    return  $text;"
NSQ_SOURCE_LINE 00000627 "}"
NSQ_SOURCE_LINE 00000628 ""
NSQ_SOURCE_LINE 00000629 "#############################################################################"
NSQ_SOURCE_LINE 00000630 ""
NSQ_SOURCE_LINE 00000631 "=head1 METHODS FOR PARSING AND PROCESSING"
NSQ_SOURCE_LINE 00000632 ""
NSQ_SOURCE_LINE 00000633 "B<Pod::Parser> provides several methods to process input text. These"
NSQ_SOURCE_LINE 00000634 "methods typically won't need to be overridden (and in some cases they"
NSQ_SOURCE_LINE 00000635 "can't be overridden), but subclasses may want to invoke them to exploit"
NSQ_SOURCE_LINE 00000636 "their functionality."
NSQ_SOURCE_LINE 00000637 ""
NSQ_SOURCE_LINE 00000638 "=cut"
NSQ_SOURCE_LINE 00000639 ""
NSQ_SOURCE_LINE 00000640 "##---------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000641 ""
NSQ_SOURCE_LINE 00000642 "=head1 B<parse_text()>"
NSQ_SOURCE_LINE 00000643 ""
NSQ_SOURCE_LINE 00000644 "            $ptree1 = $parser->parse_text($text, $line_num);"
NSQ_SOURCE_LINE 00000645 "            $ptree2 = $parser->parse_text({%opts}, $text, $line_num);"
NSQ_SOURCE_LINE 00000646 "            $ptree3 = $parser->parse_text(\\%opts, $text, $line_num);"
NSQ_SOURCE_LINE 00000647 ""
NSQ_SOURCE_LINE 00000648 "This method is useful if you need to perform your own interpolation "
NSQ_SOURCE_LINE 00000649 "of interior sequences and can't rely upon B<interpolate> to expand"
NSQ_SOURCE_LINE 00000650 "them in simple bottom-up order."
NSQ_SOURCE_LINE 00000651 ""
NSQ_SOURCE_LINE 00000652 "The parameter C<$text> is a string or block of text to be parsed"
NSQ_SOURCE_LINE 00000653 "for interior sequences; and the parameter C<$line_num> is the"
NSQ_SOURCE_LINE 00000654 "line number corresponding to the beginning of C<$text>."
NSQ_SOURCE_LINE 00000655 ""
NSQ_SOURCE_LINE 00000656 "B<parse_text()> will parse the given text into a parse-tree of \"nodes.\""
NSQ_SOURCE_LINE 00000657 "and interior-sequences.  Each \"node\" in the parse tree is either a"
NSQ_SOURCE_LINE 00000658 "text-string, or a B<Pod::InteriorSequence>.  The result returned is a"
NSQ_SOURCE_LINE 00000659 "parse-tree of type B<Pod::ParseTree>. Please see L<Pod::InputObjects>"
NSQ_SOURCE_LINE 00000660 "for more information about B<Pod::InteriorSequence> and B<Pod::ParseTree>."
NSQ_SOURCE_LINE 00000661 ""
NSQ_SOURCE_LINE 00000662 "If desired, an optional hash-ref may be specified as the first argument"
NSQ_SOURCE_LINE 00000663 "to customize certain aspects of the parse-tree that is created and"
NSQ_SOURCE_LINE 00000664 "returned. The set of recognized option keywords are:"
NSQ_SOURCE_LINE 00000665 ""
NSQ_SOURCE_LINE 00000666 "=over 3"
NSQ_SOURCE_LINE 00000667 ""
NSQ_SOURCE_LINE 00000668 "=item B<-expand_seq> =E<gt> I<code-ref>|I<method-name>"
NSQ_SOURCE_LINE 00000669 ""
NSQ_SOURCE_LINE 00000670 "Normally, the parse-tree returned by B<parse_text()> will contain an"
NSQ_SOURCE_LINE 00000671 "unexpanded C<Pod::InteriorSequence> object for each interior-sequence"
NSQ_SOURCE_LINE 00000672 "encountered. Specifying B<-expand_seq> tells B<parse_text()> to \"expand\""
NSQ_SOURCE_LINE 00000673 "every interior-sequence it sees by invoking the referenced function"
NSQ_SOURCE_LINE 00000674 "(or named method of the parser object) and using the return value as the"
NSQ_SOURCE_LINE 00000675 "expanded result."
NSQ_SOURCE_LINE 00000676 ""
NSQ_SOURCE_LINE 00000677 "If a subroutine reference was given, it is invoked as:"
NSQ_SOURCE_LINE 00000678 ""
NSQ_SOURCE_LINE 00000679 "  &$code_ref( $parser, $sequence )"
NSQ_SOURCE_LINE 00000680 ""
NSQ_SOURCE_LINE 00000681 "and if a method-name was given, it is invoked as:"
NSQ_SOURCE_LINE 00000682 ""
NSQ_SOURCE_LINE 00000683 "  $parser->method_name( $sequence )"
NSQ_SOURCE_LINE 00000684 ""
NSQ_SOURCE_LINE 00000685 "where C<$parser> is a reference to the parser object, and C<$sequence>"
NSQ_SOURCE_LINE 00000686 "is a reference to the interior-sequence object."
NSQ_SOURCE_LINE 00000687 "[I<NOTE>: If the B<interior_sequence()> method is specified, then it is"
NSQ_SOURCE_LINE 00000688 "invoked according to the interface specified in L<\"interior_sequence()\">]."
NSQ_SOURCE_LINE 00000689 ""
NSQ_SOURCE_LINE 00000690 "=item B<-expand_text> =E<gt> I<code-ref>|I<method-name>"
NSQ_SOURCE_LINE 00000691 ""
NSQ_SOURCE_LINE 00000692 "Normally, the parse-tree returned by B<parse_text()> will contain a"
NSQ_SOURCE_LINE 00000693 "text-string for each contiguous sequence of characters outside of an"
NSQ_SOURCE_LINE 00000694 "interior-sequence. Specifying B<-expand_text> tells B<parse_text()> to"
NSQ_SOURCE_LINE 00000695 "\"preprocess\" every such text-string it sees by invoking the referenced"
NSQ_SOURCE_LINE 00000696 "function (or named method of the parser object) and using the return value"
NSQ_SOURCE_LINE 00000697 "as the preprocessed (or \"expanded\") result. [Note that if the result is"
NSQ_SOURCE_LINE 00000698 "an interior-sequence, then it will I<not> be expanded as specified by the"
NSQ_SOURCE_LINE 00000699 "B<-expand_seq> option; Any such recursive expansion needs to be handled by"
NSQ_SOURCE_LINE 00000700 "the specified callback routine.]"
NSQ_SOURCE_LINE 00000701 ""
NSQ_SOURCE_LINE 00000702 "If a subroutine reference was given, it is invoked as:"
NSQ_SOURCE_LINE 00000703 ""
NSQ_SOURCE_LINE 00000704 "  &$code_ref( $parser, $text, $ptree_node )"
NSQ_SOURCE_LINE 00000705 ""
NSQ_SOURCE_LINE 00000706 "and if a method-name was given, it is invoked as:"
NSQ_SOURCE_LINE 00000707 ""
NSQ_SOURCE_LINE 00000708 "  $parser->method_name( $text, $ptree_node )"
NSQ_SOURCE_LINE 00000709 ""
NSQ_SOURCE_LINE 00000710 "where C<$parser> is a reference to the parser object, C<$text> is the"
NSQ_SOURCE_LINE 00000711 "text-string encountered, and C<$ptree_node> is a reference to the current"
NSQ_SOURCE_LINE 00000712 "node in the parse-tree (usually an interior-sequence object or else the"
NSQ_SOURCE_LINE 00000713 "top-level node of the parse-tree)."
NSQ_SOURCE_LINE 00000714 ""
NSQ_SOURCE_LINE 00000715 "=item B<-expand_ptree> =E<gt> I<code-ref>|I<method-name>"
NSQ_SOURCE_LINE 00000716 ""
NSQ_SOURCE_LINE 00000717 "Rather than returning a C<Pod::ParseTree>, pass the parse-tree as an"
NSQ_SOURCE_LINE 00000718 "argument to the referenced subroutine (or named method of the parser"
NSQ_SOURCE_LINE 00000719 "object) and return the result instead of the parse-tree object."
NSQ_SOURCE_LINE 00000720 ""
NSQ_SOURCE_LINE 00000721 "If a subroutine reference was given, it is invoked as:"
NSQ_SOURCE_LINE 00000722 ""
NSQ_SOURCE_LINE 00000723 "  &$code_ref( $parser, $ptree )"
NSQ_SOURCE_LINE 00000724 ""
NSQ_SOURCE_LINE 00000725 "and if a method-name was given, it is invoked as:"
NSQ_SOURCE_LINE 00000726 ""
NSQ_SOURCE_LINE 00000727 "  $parser->method_name( $ptree )"
NSQ_SOURCE_LINE 00000728 ""
NSQ_SOURCE_LINE 00000729 "where C<$parser> is a reference to the parser object, and C<$ptree>"
NSQ_SOURCE_LINE 00000730 "is a reference to the parse-tree object."
NSQ_SOURCE_LINE 00000731 ""
NSQ_SOURCE_LINE 00000732 "=back"
NSQ_SOURCE_LINE 00000733 ""
NSQ_SOURCE_LINE 00000734 "=cut"
NSQ_SOURCE_LINE 00000735 ""
NSQ_SOURCE_LINE 00000736 "sub parse_text {"
NSQ_SOURCE_LINE 00000737 "    my $self = shift;"
NSQ_SOURCE_LINE 00000738 "    local $_ = '';"
NSQ_SOURCE_LINE 00000739 ""
NSQ_SOURCE_LINE 00000740 "    ## Get options and set any defaults"
NSQ_SOURCE_LINE 00000741 "    my %opts = (ref $_[0]) ? %{ shift() } : ();"
NSQ_SOURCE_LINE 00000742 "    my $expand_seq   = $opts{'-expand_seq'}   || undef;"
NSQ_SOURCE_LINE 00000743 "    my $expand_text  = $opts{'-expand_text'}  || undef;"
NSQ_SOURCE_LINE 00000744 "    my $expand_ptree = $opts{'-expand_ptree'} || undef;"
NSQ_SOURCE_LINE 00000745 ""
NSQ_SOURCE_LINE 00000746 "    my $text = shift;"
NSQ_SOURCE_LINE 00000747 "    my $line = shift;"
NSQ_SOURCE_LINE 00000748 "    my $file = $self->input_file();"
NSQ_SOURCE_LINE 00000749 "    my $cmd  = \"\";"
NSQ_SOURCE_LINE 00000750 ""
NSQ_SOURCE_LINE 00000751 "    ## Convert method calls into closures, for our convenience"
NSQ_SOURCE_LINE 00000752 "    my $xseq_sub   = $expand_seq;"
NSQ_SOURCE_LINE 00000753 "    my $xtext_sub  = $expand_text;"
NSQ_SOURCE_LINE 00000754 "    my $xptree_sub = $expand_ptree;"
NSQ_SOURCE_LINE 00000755 "    if (defined $expand_seq  and  $expand_seq eq 'interior_sequence') {"
NSQ_SOURCE_LINE 00000756 "        ## If 'interior_sequence' is the method to use, we have to pass"
NSQ_SOURCE_LINE 00000757 "        ## more than just the sequence object, we also need to pass the"
NSQ_SOURCE_LINE 00000758 "        ## sequence name and text."
NSQ_SOURCE_LINE 00000759 "        $xseq_sub = sub {"
NSQ_SOURCE_LINE 00000760 "            my ($sself, $iseq) = @_;"
NSQ_SOURCE_LINE 00000761 "            my $args = join('', $iseq->parse_tree->children);"
NSQ_SOURCE_LINE 00000762 "            return  $sself->interior_sequence($iseq->name, $args, $iseq);"
NSQ_SOURCE_LINE 00000763 "        };"
NSQ_SOURCE_LINE 00000764 "    }"
NSQ_SOURCE_LINE 00000765 "    ref $xseq_sub    or  $xseq_sub   = sub { shift()->$expand_seq(@_) };"
NSQ_SOURCE_LINE 00000766 "    ref $xtext_sub   or  $xtext_sub  = sub { shift()->$expand_text(@_) };"
NSQ_SOURCE_LINE 00000767 "    ref $xptree_sub  or  $xptree_sub = sub { shift()->$expand_ptree(@_) };"
NSQ_SOURCE_LINE 00000768 ""
NSQ_SOURCE_LINE 00000769 "    ## Keep track of the \"current\" interior sequence, and maintain a stack"
NSQ_SOURCE_LINE 00000770 "    ## of \"in progress\" sequences."
NSQ_SOURCE_LINE 00000771 "    ##"
NSQ_SOURCE_LINE 00000772 "    ## NOTE that we push our own \"accumulator\" at the very beginning of the"
NSQ_SOURCE_LINE 00000773 "    ## stack. It's really a parse-tree, not a sequence; but it implements"
NSQ_SOURCE_LINE 00000774 "    ## the methods we need so we can use it to gather-up all the sequences"
NSQ_SOURCE_LINE 00000775 "    ## and strings we parse. Thus, by the end of our parsing, it should be"
NSQ_SOURCE_LINE 00000776 "    ## the only thing left on our stack and all we have to do is return it!"
NSQ_SOURCE_LINE 00000777 "    ##"
NSQ_SOURCE_LINE 00000778 "    my $seq       = Pod::ParseTree->new();"
NSQ_SOURCE_LINE 00000779 "    my @seq_stack = ($seq);"
NSQ_SOURCE_LINE 00000780 "    my ($ldelim, $rdelim) = ('', '');"
NSQ_SOURCE_LINE 00000781 ""
NSQ_SOURCE_LINE 00000782 "    ## Iterate over all sequence starts text (NOTE: split with"
NSQ_SOURCE_LINE 00000783 "    ## capturing parens keeps the delimiters)"
NSQ_SOURCE_LINE 00000784 "    $_ = $text;"
NSQ_SOURCE_LINE 00000785 "    my @tokens = split /([A-Z]<(?:<+(?:\\r?\\n|[ \\t]))?)/;"
NSQ_SOURCE_LINE 00000786 "    while ( @tokens ) {"
NSQ_SOURCE_LINE 00000787 "        $_ = shift @tokens;"
NSQ_SOURCE_LINE 00000788 "        ## Look for the beginning of a sequence"
NSQ_SOURCE_LINE 00000789 "        if ( /^([A-Z])(<(?:<+(?:\\r?\\n|[ \\t]))?)$/ ) {"
NSQ_SOURCE_LINE 00000790 "            ## Push a new sequence onto the stack of those \"in-progress\""
NSQ_SOURCE_LINE 00000791 "            my $ldelim_orig;"
NSQ_SOURCE_LINE 00000792 "            ($cmd, $ldelim_orig) = ($1, $2);"
NSQ_SOURCE_LINE 00000793 "            ($ldelim = $ldelim_orig) =~ s/\\s+$//;"
NSQ_SOURCE_LINE 00000794 "            ($rdelim = $ldelim) =~ tr/</>/;"
NSQ_SOURCE_LINE 00000795 "            $seq = Pod::InteriorSequence->new("
NSQ_SOURCE_LINE 00000796 "                       -name   => $cmd,"
NSQ_SOURCE_LINE 00000797 "                       -ldelim => $ldelim_orig,  -rdelim => $rdelim,"
NSQ_SOURCE_LINE 00000798 "                       -file   => $file,    -line   => $line"
NSQ_SOURCE_LINE 00000799 "                   );"
NSQ_SOURCE_LINE 00000800 "            (@seq_stack > 1)  and  $seq->nested($seq_stack[-1]);"
NSQ_SOURCE_LINE 00000801 "            push @seq_stack, $seq;"
NSQ_SOURCE_LINE 00000802 "        }"
NSQ_SOURCE_LINE 00000803 "        ## Look for sequence ending"
NSQ_SOURCE_LINE 00000804 "        elsif ( @seq_stack > 1 ) {"
NSQ_SOURCE_LINE 00000805 "            ## Make sure we match the right kind of closing delimiter"
NSQ_SOURCE_LINE 00000806 "            my ($seq_end, $post_seq) = ('', '');"
NSQ_SOURCE_LINE 00000807 "            if ( ($ldelim eq '<'   and  /\\A(.*?)(>)/s)"
NSQ_SOURCE_LINE 00000808 "                 or  /\\A(.*?)(\\s+$rdelim)/s )"
NSQ_SOURCE_LINE 00000809 "            {"
NSQ_SOURCE_LINE 00000810 "                ## Found end-of-sequence, capture the interior and the"
NSQ_SOURCE_LINE 00000811 "                ## closing the delimiter, and put the rest back on the"
NSQ_SOURCE_LINE 00000812 "                ## token-list"
NSQ_SOURCE_LINE 00000813 "                $post_seq = substr($_, length($1) + length($2));"
NSQ_SOURCE_LINE 00000814 "                ($_, $seq_end) = ($1, $2);"
NSQ_SOURCE_LINE 00000815 "                (length $post_seq)  and  unshift @tokens, $post_seq;"
NSQ_SOURCE_LINE 00000816 "            }"
NSQ_SOURCE_LINE 00000817 "            if (length) {"
NSQ_SOURCE_LINE 00000818 "                ## In the middle of a sequence, append this text to it, and"
NSQ_SOURCE_LINE 00000819 "                ## don't forget to \"expand\" it if that's what the caller wanted"
NSQ_SOURCE_LINE 00000820 "                $seq->append($expand_text ? &$xtext_sub($self,$_,$seq) : $_);"
NSQ_SOURCE_LINE 00000821 "                $_ .= $seq_end;"
NSQ_SOURCE_LINE 00000822 "            }"
NSQ_SOURCE_LINE 00000823 "            if (length $seq_end) {"
NSQ_SOURCE_LINE 00000824 "                ## End of current sequence, record terminating delimiter"
NSQ_SOURCE_LINE 00000825 "                $seq->rdelim($seq_end);"
NSQ_SOURCE_LINE 00000826 "                ## Pop it off the stack of \"in progress\" sequences"
NSQ_SOURCE_LINE 00000827 "                pop @seq_stack;"
NSQ_SOURCE_LINE 00000828 "                ## Append result to its parent in current parse tree"
NSQ_SOURCE_LINE 00000829 "                $seq_stack[-1]->append($expand_seq ? &$xseq_sub($self,$seq)"
NSQ_SOURCE_LINE 00000830 "                                                   : $seq);"
NSQ_SOURCE_LINE 00000831 "                ## Remember the current cmd-name and left-delimiter"
NSQ_SOURCE_LINE 00000832 "                if(@seq_stack > 1) {"
NSQ_SOURCE_LINE 00000833 "                    $cmd = $seq_stack[-1]->name;"
NSQ_SOURCE_LINE 00000834 "                    $ldelim = $seq_stack[-1]->ldelim;"
NSQ_SOURCE_LINE 00000835 "                    $rdelim = $seq_stack[-1]->rdelim;"
NSQ_SOURCE_LINE 00000836 "                } else {"
NSQ_SOURCE_LINE 00000837 "                    $cmd = $ldelim = $rdelim = '';"
NSQ_SOURCE_LINE 00000838 "                }"
NSQ_SOURCE_LINE 00000839 "            }"
NSQ_SOURCE_LINE 00000840 "        }"
NSQ_SOURCE_LINE 00000841 "        elsif (length) {"
NSQ_SOURCE_LINE 00000842 "            ## In the middle of a sequence, append this text to it, and"
NSQ_SOURCE_LINE 00000843 "            ## don't forget to \"expand\" it if that's what the caller wanted"
NSQ_SOURCE_LINE 00000844 "            $seq->append($expand_text ? &$xtext_sub($self,$_,$seq) : $_);"
NSQ_SOURCE_LINE 00000845 "        }"
NSQ_SOURCE_LINE 00000846 "        ## Keep track of line count"
NSQ_SOURCE_LINE 00000847 "        $line += /\\n/;"
NSQ_SOURCE_LINE 00000848 "        ## Remember the \"current\" sequence"
NSQ_SOURCE_LINE 00000849 "        $seq = $seq_stack[-1];"
NSQ_SOURCE_LINE 00000850 "    }"
NSQ_SOURCE_LINE 00000851 ""
NSQ_SOURCE_LINE 00000852 "    ## Handle unterminated sequences"
NSQ_SOURCE_LINE 00000853 "    my $errorsub = (@seq_stack > 1) ? $self->errorsub() : undef;"
NSQ_SOURCE_LINE 00000854 "    while (@seq_stack > 1) {"
NSQ_SOURCE_LINE 00000855 "       ($cmd, $file, $line) = ($seq->name, $seq->file_line);"
NSQ_SOURCE_LINE 00000856 "       $ldelim  = $seq->ldelim;"
NSQ_SOURCE_LINE 00000857 "       ($rdelim = $ldelim) =~ tr/</>/;"
NSQ_SOURCE_LINE 00000858 "       $rdelim  =~ s/^(\\S+)(\\s*)$/$2$1/;"
NSQ_SOURCE_LINE 00000859 "       pop @seq_stack;"
NSQ_SOURCE_LINE 00000860 "       my $errmsg = \"*** ERROR: unterminated ${cmd}${ldelim}...${rdelim}\"."
NSQ_SOURCE_LINE 00000861 "                    \" at line $line in file $file\\n\";"
NSQ_SOURCE_LINE 00000862 "       (ref $errorsub) and &{$errorsub}($errmsg)"
NSQ_SOURCE_LINE 00000863 "           or (defined $errorsub) and $self->$errorsub($errmsg)"
NSQ_SOURCE_LINE 00000864 "               or  carp($errmsg);"
NSQ_SOURCE_LINE 00000865 "       $seq_stack[-1]->append($expand_seq ? &$xseq_sub($self,$seq) : $seq);"
NSQ_SOURCE_LINE 00000866 "       $seq = $seq_stack[-1];"
NSQ_SOURCE_LINE 00000867 "    }"
NSQ_SOURCE_LINE 00000868 ""
NSQ_SOURCE_LINE 00000869 "    ## Return the resulting parse-tree"
NSQ_SOURCE_LINE 00000870 "    my $ptree = (pop @seq_stack)->parse_tree;"
NSQ_SOURCE_LINE 00000871 "    return  $expand_ptree ? &$xptree_sub($self, $ptree) : $ptree;"
NSQ_SOURCE_LINE 00000872 "}"
NSQ_SOURCE_LINE 00000873 ""
NSQ_SOURCE_LINE 00000874 "##---------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000875 ""
NSQ_SOURCE_LINE 00000876 "=head1 B<interpolate()>"
NSQ_SOURCE_LINE 00000877 ""
NSQ_SOURCE_LINE 00000878 "            $textblock = $parser->interpolate($text, $line_num);"
NSQ_SOURCE_LINE 00000879 ""
NSQ_SOURCE_LINE 00000880 "This method translates all text (including any embedded interior sequences)"
NSQ_SOURCE_LINE 00000881 "in the given text string C<$text> and returns the interpolated result. The"
NSQ_SOURCE_LINE 00000882 "parameter C<$line_num> is the line number corresponding to the beginning"
NSQ_SOURCE_LINE 00000883 "of C<$text>."
NSQ_SOURCE_LINE 00000884 ""
NSQ_SOURCE_LINE 00000885 "B<interpolate()> merely invokes a private method to recursively expand"
NSQ_SOURCE_LINE 00000886 "nested interior sequences in bottom-up order (innermost sequences are"
NSQ_SOURCE_LINE 00000887 "expanded first). If there is a need to expand nested sequences in"
NSQ_SOURCE_LINE 00000888 "some alternate order, use B<parse_text> instead."
NSQ_SOURCE_LINE 00000889 ""
NSQ_SOURCE_LINE 00000890 "=cut"
NSQ_SOURCE_LINE 00000891 ""
NSQ_SOURCE_LINE 00000892 "sub interpolate {"
NSQ_SOURCE_LINE 00000893 "    my($self, $text, $line_num) = @_;"
NSQ_SOURCE_LINE 00000894 "    my %parse_opts = ( -expand_seq => 'interior_sequence' );"
NSQ_SOURCE_LINE 00000895 "    my $ptree = $self->parse_text( \\%parse_opts, $text, $line_num );"
NSQ_SOURCE_LINE 00000896 "    return  join '', $ptree->children();"
NSQ_SOURCE_LINE 00000897 "}"
NSQ_SOURCE_LINE 00000898 ""
NSQ_SOURCE_LINE 00000899 "##---------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000900 ""
NSQ_SOURCE_LINE 00000901 "=begin __PRIVATE__"
NSQ_SOURCE_LINE 00000902 ""
NSQ_SOURCE_LINE 00000903 "=head1 B<parse_paragraph()>"
NSQ_SOURCE_LINE 00000904 ""
NSQ_SOURCE_LINE 00000905 "            $parser->parse_paragraph($text, $line_num);"
NSQ_SOURCE_LINE 00000906 ""
NSQ_SOURCE_LINE 00000907 "This method takes the text of a POD paragraph to be processed, along"
NSQ_SOURCE_LINE 00000908 "with its corresponding line number, and invokes the appropriate method"
NSQ_SOURCE_LINE 00000909 "(one of B<command()>, B<verbatim()>, or B<textblock()>)."
NSQ_SOURCE_LINE 00000910 ""
NSQ_SOURCE_LINE 00000911 "For performance reasons, this method is invoked directly without any"
NSQ_SOURCE_LINE 00000912 "dynamic lookup; Hence subclasses may I<not> override it!"
NSQ_SOURCE_LINE 00000913 ""
NSQ_SOURCE_LINE 00000914 "=end __PRIVATE__"
NSQ_SOURCE_LINE 00000915 ""
NSQ_SOURCE_LINE 00000916 "=cut"
NSQ_SOURCE_LINE 00000917 ""
NSQ_SOURCE_LINE 00000918 "sub parse_paragraph {"
NSQ_SOURCE_LINE 00000919 "    my ($self, $text, $line_num) = @_;"
NSQ_SOURCE_LINE 00000920 "    local *myData = $self;  ## alias to avoid deref-ing overhead"
NSQ_SOURCE_LINE 00000921 "    local *myOpts = ($myData{_PARSEOPTS} ||= {});  ## get parse-options"
NSQ_SOURCE_LINE 00000922 "    local $_;"
NSQ_SOURCE_LINE 00000923 ""
NSQ_SOURCE_LINE 00000924 "    ## See if we want to preprocess nonPOD paragraphs as well as POD ones."
NSQ_SOURCE_LINE 00000925 "    my $wantNonPods = $myOpts{'-want_nonPODs'};"
NSQ_SOURCE_LINE 00000926 ""
NSQ_SOURCE_LINE 00000927 "    ## Update cutting status"
NSQ_SOURCE_LINE 00000928 "    $myData{_CUTTING} = 0 if $text =~ /^={1,2}\\S/;"
NSQ_SOURCE_LINE 00000929 ""
NSQ_SOURCE_LINE 00000930 "    ## Perform any desired preprocessing if we wanted it this early"
NSQ_SOURCE_LINE 00000931 "    $wantNonPods  and  $text = $self->preprocess_paragraph($text, $line_num);"
NSQ_SOURCE_LINE 00000932 ""
NSQ_SOURCE_LINE 00000933 "    ## Ignore up until next POD directive if we are cutting"
NSQ_SOURCE_LINE 00000934 "    return if $myData{_CUTTING};"
NSQ_SOURCE_LINE 00000935 ""
NSQ_SOURCE_LINE 00000936 "    ## Now we know this is block of text in a POD section!"
NSQ_SOURCE_LINE 00000937 ""
NSQ_SOURCE_LINE 00000938 "    ##-----------------------------------------------------------------"
NSQ_SOURCE_LINE 00000939 "    ## This is a hook (hack ;-) for Pod::Select to do its thing without"
NSQ_SOURCE_LINE 00000940 "    ## having to override methods, but also without Pod::Parser assuming"
NSQ_SOURCE_LINE 00000941 "    ## $self is an instance of Pod::Select (if the _SELECTED_SECTIONS"
NSQ_SOURCE_LINE 00000942 "    ## field exists then we assume there is an is_selected() method for"
NSQ_SOURCE_LINE 00000943 "    ## us to invoke (calling $self->can('is_selected') could verify this"
NSQ_SOURCE_LINE 00000944 "    ## but that is more overhead than I want to incur)"
NSQ_SOURCE_LINE 00000945 "    ##-----------------------------------------------------------------"
NSQ_SOURCE_LINE 00000946 ""
NSQ_SOURCE_LINE 00000947 "    ## Ignore this block if it isn't in one of the selected sections"
NSQ_SOURCE_LINE 00000948 "    if (exists $myData{_SELECTED_SECTIONS}) {"
NSQ_SOURCE_LINE 00000949 "        $self->is_selected($text)  or  return ($myData{_CUTTING} = 1);"
NSQ_SOURCE_LINE 00000950 "    }"
NSQ_SOURCE_LINE 00000951 ""
NSQ_SOURCE_LINE 00000952 "    ## If we haven't already, perform any desired preprocessing and"
NSQ_SOURCE_LINE 00000953 "    ## then re-check the \"cutting\" state"
NSQ_SOURCE_LINE 00000954 "    unless ($wantNonPods) {"
NSQ_SOURCE_LINE 00000955 "       $text = $self->preprocess_paragraph($text, $line_num);"
NSQ_SOURCE_LINE 00000956 "       return 1  unless ((defined $text) and (length $text));"
NSQ_SOURCE_LINE 00000957 "       return 1  if ($myData{_CUTTING});"
NSQ_SOURCE_LINE 00000958 "    }"
NSQ_SOURCE_LINE 00000959 ""
NSQ_SOURCE_LINE 00000960 "    ## Look for one of the three types of paragraphs"
NSQ_SOURCE_LINE 00000961 "    my ($pfx, $cmd, $arg, $sep) = ('', '', '', '');"
NSQ_SOURCE_LINE 00000962 "    my $pod_para = undef;"
NSQ_SOURCE_LINE 00000963 "    if ($text =~ /^(={1,2})(?=\\S)/) {"
NSQ_SOURCE_LINE 00000964 "        ## Looks like a command paragraph. Capture the command prefix used"
NSQ_SOURCE_LINE 00000965 "        ## (\"=\" or \"==\"), as well as the command-name, its paragraph text,"
NSQ_SOURCE_LINE 00000966 "        ## and whatever sequence of characters was used to separate them"
NSQ_SOURCE_LINE 00000967 "        $pfx = $1;"
NSQ_SOURCE_LINE 00000968 "        $_ = substr($text, length $pfx);"
NSQ_SOURCE_LINE 00000969 "        ($cmd, $sep, $text) = split /(\\s+)/, $_, 2;"
NSQ_SOURCE_LINE 00000970 "        $sep = '' unless defined $sep;"
NSQ_SOURCE_LINE 00000971 "        $text = '' unless defined $text;"
NSQ_SOURCE_LINE 00000972 "        ## If this is a \"cut\" directive then we don't need to do anything"
NSQ_SOURCE_LINE 00000973 "        ## except return to \"cutting\" mode."
NSQ_SOURCE_LINE 00000974 "        if ($cmd eq 'cut') {"
NSQ_SOURCE_LINE 00000975 "           $myData{_CUTTING} = 1;"
NSQ_SOURCE_LINE 00000976 "           return  unless $myOpts{'-process_cut_cmd'};"
NSQ_SOURCE_LINE 00000977 "        }"
NSQ_SOURCE_LINE 00000978 "    }"
NSQ_SOURCE_LINE 00000979 "    ## Save the attributes indicating how the command was specified."
NSQ_SOURCE_LINE 00000980 "    $pod_para = new Pod::Paragraph("
NSQ_SOURCE_LINE 00000981 "          -name      => $cmd,"
NSQ_SOURCE_LINE 00000982 "          -text      => $text,"
NSQ_SOURCE_LINE 00000983 "          -prefix    => $pfx,"
NSQ_SOURCE_LINE 00000984 "          -separator => $sep,"
NSQ_SOURCE_LINE 00000985 "          -file      => $myData{_INFILE},"
NSQ_SOURCE_LINE 00000986 "          -line      => $line_num"
NSQ_SOURCE_LINE 00000987 "    );"
NSQ_SOURCE_LINE 00000988 "    # ## Invoke appropriate callbacks"
NSQ_SOURCE_LINE 00000989 "    # if (exists $myData{_CALLBACKS}) {"
NSQ_SOURCE_LINE 00000990 "    #    ## Look through the callback list, invoke callbacks,"
NSQ_SOURCE_LINE 00000991 "    #    ## then see if we need to do the default actions"
NSQ_SOURCE_LINE 00000992 "    #    ## (invoke_callbacks will return true if we do)."
NSQ_SOURCE_LINE 00000993 "    #    return  1  unless $self->invoke_callbacks($cmd, $text, $line_num, $pod_para);"
NSQ_SOURCE_LINE 00000994 "    # }"
NSQ_SOURCE_LINE 00000995 ""
NSQ_SOURCE_LINE 00000996 "    # If the last paragraph ended in whitespace, and we're not between verbatim blocks, carp"
NSQ_SOURCE_LINE 00000997 "    if ($myData{_WHITESPACE} and $myOpts{'-warnings'}"
NSQ_SOURCE_LINE 00000998 "            and not ($text =~ /^\\s+/ and ($myData{_PREVIOUS}||\"\") eq \"verbatim\")) {"
NSQ_SOURCE_LINE 00000999 "        my $errorsub = $self->errorsub();"
NSQ_SOURCE_LINE 00001000 "        my $line = $line_num - 1;"
NSQ_SOURCE_LINE 00001001 "        my $errmsg = \"*** WARNING: line containing nothing but whitespace\"."
NSQ_SOURCE_LINE 00001002 "                     \" in paragraph at line $line in file $myData{_INFILE}\\n\";"
NSQ_SOURCE_LINE 00001003 "        (ref $errorsub) and &{$errorsub}($errmsg)"
NSQ_SOURCE_LINE 00001004 "            or (defined $errorsub) and $self->$errorsub($errmsg)"
NSQ_SOURCE_LINE 00001005 "                or  carp($errmsg);"
NSQ_SOURCE_LINE 00001006 "    }"
NSQ_SOURCE_LINE 00001007 ""
NSQ_SOURCE_LINE 00001008 "    if (length $cmd) {"
NSQ_SOURCE_LINE 00001009 "        ## A command paragraph"
NSQ_SOURCE_LINE 00001010 "        $self->command($cmd, $text, $line_num, $pod_para);"
NSQ_SOURCE_LINE 00001011 "        $myData{_PREVIOUS} = $cmd;"
NSQ_SOURCE_LINE 00001012 "    }"
NSQ_SOURCE_LINE 00001013 "    elsif ($text =~ /^\\s+/) {"
NSQ_SOURCE_LINE 00001014 "        ## Indented text - must be a verbatim paragraph"
NSQ_SOURCE_LINE 00001015 "        $self->verbatim($text, $line_num, $pod_para);"
NSQ_SOURCE_LINE 00001016 "        $myData{_PREVIOUS} = \"verbatim\";"
NSQ_SOURCE_LINE 00001017 "    }"
NSQ_SOURCE_LINE 00001018 "    else {"
NSQ_SOURCE_LINE 00001019 "        ## Looks like an ordinary block of text"
NSQ_SOURCE_LINE 00001020 "        $self->textblock($text, $line_num, $pod_para);"
NSQ_SOURCE_LINE 00001021 "        $myData{_PREVIOUS} = \"textblock\";"
NSQ_SOURCE_LINE 00001022 "    }"
NSQ_SOURCE_LINE 00001023 ""
NSQ_SOURCE_LINE 00001024 "    # Update the whitespace for the next time around"
NSQ_SOURCE_LINE 00001025 "    #$myData{_WHITESPACE} = $text =~ /^[^\\S\\r\\n]+\\Z/m ? 1 : 0;"
NSQ_SOURCE_LINE 00001026 "    $myData{_WHITESPACE} = $text =~ /^[^\\S\\r\\n]+\\r*\\Z/m ? 1 : 0;"
NSQ_SOURCE_LINE 00001027 ""
NSQ_SOURCE_LINE 00001028 "    return  1;"
NSQ_SOURCE_LINE 00001029 "}"
NSQ_SOURCE_LINE 00001030 ""
NSQ_SOURCE_LINE 00001031 "##---------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00001032 ""
NSQ_SOURCE_LINE 00001033 "=head1 B<parse_from_filehandle()>"
NSQ_SOURCE_LINE 00001034 ""
NSQ_SOURCE_LINE 00001035 "            $parser->parse_from_filehandle($in_fh,$out_fh);"
NSQ_SOURCE_LINE 00001036 ""
NSQ_SOURCE_LINE 00001037 "This method takes an input filehandle (which is assumed to already be"
NSQ_SOURCE_LINE 00001038 "opened for reading) and reads the entire input stream looking for blocks"
NSQ_SOURCE_LINE 00001039 "(paragraphs) of POD documentation to be processed. If no first argument"
NSQ_SOURCE_LINE 00001040 "is given the default input filehandle C<STDIN> is used."
NSQ_SOURCE_LINE 00001041 ""
NSQ_SOURCE_LINE 00001042 "The C<$in_fh> parameter may be any object that provides a B<getline()>"
NSQ_SOURCE_LINE 00001043 "method to retrieve a single line of input text (hence, an appropriate"
NSQ_SOURCE_LINE 00001044 "wrapper object could be used to parse PODs from a single string or an"
NSQ_SOURCE_LINE 00001045 "array of strings)."
NSQ_SOURCE_LINE 00001046 ""
NSQ_SOURCE_LINE 00001047 "Using C<$in_fh-E<gt>getline()>, input is read line-by-line and assembled"
NSQ_SOURCE_LINE 00001048 "into paragraphs or \"blocks\" (which are separated by lines containing"
NSQ_SOURCE_LINE 00001049 "nothing but whitespace). For each block of POD documentation"
NSQ_SOURCE_LINE 00001050 "encountered it will invoke a method to parse the given paragraph."
NSQ_SOURCE_LINE 00001051 ""
NSQ_SOURCE_LINE 00001052 "If a second argument is given then it should correspond to a filehandle where"
NSQ_SOURCE_LINE 00001053 "output should be sent (otherwise the default output filehandle is"
NSQ_SOURCE_LINE 00001054 "C<STDOUT> if no output filehandle is currently in use)."
NSQ_SOURCE_LINE 00001055 ""
NSQ_SOURCE_LINE 00001056 "B<NOTE:> For performance reasons, this method caches the input stream at"
NSQ_SOURCE_LINE 00001057 "the top of the stack in a local variable. Any attempts by clients to"
NSQ_SOURCE_LINE 00001058 "change the stack contents during processing when in the midst executing"
NSQ_SOURCE_LINE 00001059 "of this method I<will not affect> the input stream used by the current"
NSQ_SOURCE_LINE 00001060 "invocation of this method."
NSQ_SOURCE_LINE 00001061 ""
NSQ_SOURCE_LINE 00001062 "This method does I<not> usually need to be overridden by subclasses."
NSQ_SOURCE_LINE 00001063 ""
NSQ_SOURCE_LINE 00001064 "=cut"
NSQ_SOURCE_LINE 00001065 ""
NSQ_SOURCE_LINE 00001066 "sub parse_from_filehandle {"
NSQ_SOURCE_LINE 00001067 "    my $self = shift;"
NSQ_SOURCE_LINE 00001068 "    my %opts = (ref $_[0] eq 'HASH') ? %{ shift() } : ();"
NSQ_SOURCE_LINE 00001069 "    my ($in_fh, $out_fh) = @_;"
NSQ_SOURCE_LINE 00001070 "    $in_fh = \\*STDIN  unless ($in_fh);"
NSQ_SOURCE_LINE 00001071 "    local *myData = $self;  ## alias to avoid deref-ing overhead"
NSQ_SOURCE_LINE 00001072 "    local *myOpts = ($myData{_PARSEOPTS} ||= {});  ## get parse-options"
NSQ_SOURCE_LINE 00001073 "    local $_;"
NSQ_SOURCE_LINE 00001074 ""
NSQ_SOURCE_LINE 00001075 "    ## Put this stream at the top of the stack and do beginning-of-input"
NSQ_SOURCE_LINE 00001076 "    ## processing. NOTE that $in_fh might be reset during this process."
NSQ_SOURCE_LINE 00001077 "    my $topstream = $self->_push_input_stream($in_fh, $out_fh);"
NSQ_SOURCE_LINE 00001078 "    (exists $opts{-cutting})  and  $self->cutting( $opts{-cutting} );"
NSQ_SOURCE_LINE 00001079 ""
NSQ_SOURCE_LINE 00001080 "    ## Initialize line/paragraph"
NSQ_SOURCE_LINE 00001081 "    my ($textline, $paragraph) = ('', '');"
NSQ_SOURCE_LINE 00001082 "    my ($nlines, $plines) = (0, 0);"
NSQ_SOURCE_LINE 00001083 ""
NSQ_SOURCE_LINE 00001084 "    ## Use <$fh> instead of $fh->getline where possible (for speed)"
NSQ_SOURCE_LINE 00001085 "    $_ = ref $in_fh;"
NSQ_SOURCE_LINE 00001086 "    my $tied_fh = (/^(?:GLOB|FileHandle|IO::\\w+)$/  or  tied $in_fh);"
NSQ_SOURCE_LINE 00001087 ""
NSQ_SOURCE_LINE 00001088 "    ## Read paragraphs line-by-line"
NSQ_SOURCE_LINE 00001089 "    while (defined ($textline = $tied_fh ? <$in_fh> : $in_fh->getline)) {"
NSQ_SOURCE_LINE 00001090 "        $textline = $self->preprocess_line($textline, ++$nlines);"
NSQ_SOURCE_LINE 00001091 "        next  unless ((defined $textline)  &&  (length $textline));"
NSQ_SOURCE_LINE 00001092 ""
NSQ_SOURCE_LINE 00001093 "        if ((! length $paragraph) && ($textline =~ /^==/)) {"
NSQ_SOURCE_LINE 00001094 "            ## '==' denotes a one-line command paragraph"
NSQ_SOURCE_LINE 00001095 "            $paragraph = $textline;"
NSQ_SOURCE_LINE 00001096 "            $plines    = 1;"
NSQ_SOURCE_LINE 00001097 "            $textline  = '';"
NSQ_SOURCE_LINE 00001098 "        } else {"
NSQ_SOURCE_LINE 00001099 "            ## Append this line to the current paragraph"
NSQ_SOURCE_LINE 00001100 "            $paragraph .= $textline;"
NSQ_SOURCE_LINE 00001101 "            ++$plines;"
NSQ_SOURCE_LINE 00001102 "        }"
NSQ_SOURCE_LINE 00001103 ""
NSQ_SOURCE_LINE 00001104 "        ## See if this line is blank and ends the current paragraph."
NSQ_SOURCE_LINE 00001105 "        ## If it isn't, then keep iterating until it is."
NSQ_SOURCE_LINE 00001106 "        next unless (($textline =~ /^[^\\S\\r\\n]*[\\r\\n]*$/)"
NSQ_SOURCE_LINE 00001107 "                                     && (length $paragraph));"
NSQ_SOURCE_LINE 00001108 ""
NSQ_SOURCE_LINE 00001109 "        ## Now process the paragraph"
NSQ_SOURCE_LINE 00001110 "        parse_paragraph($self, $paragraph, ($nlines - $plines) + 1);"
NSQ_SOURCE_LINE 00001111 "        $paragraph = '';"
NSQ_SOURCE_LINE 00001112 "        $plines = 0;"
NSQ_SOURCE_LINE 00001113 "    }"
NSQ_SOURCE_LINE 00001114 "    ## Don't forget about the last paragraph in the file"
NSQ_SOURCE_LINE 00001115 "    if (length $paragraph) {"
NSQ_SOURCE_LINE 00001116 "       parse_paragraph($self, $paragraph, ($nlines - $plines) + 1)"
NSQ_SOURCE_LINE 00001117 "    }"
NSQ_SOURCE_LINE 00001118 ""
NSQ_SOURCE_LINE 00001119 "    ## Now pop the input stream off the top of the input stack."
NSQ_SOURCE_LINE 00001120 "    $self->_pop_input_stream();"
NSQ_SOURCE_LINE 00001121 "}"
NSQ_SOURCE_LINE 00001122 ""
NSQ_SOURCE_LINE 00001123 "##---------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00001124 ""
NSQ_SOURCE_LINE 00001125 "=head1 B<parse_from_file()>"
NSQ_SOURCE_LINE 00001126 ""
NSQ_SOURCE_LINE 00001127 "            $parser->parse_from_file($filename,$outfile);"
NSQ_SOURCE_LINE 00001128 ""
NSQ_SOURCE_LINE 00001129 "This method takes a filename and does the following:"
NSQ_SOURCE_LINE 00001130 ""
NSQ_SOURCE_LINE 00001131 "=over 2"
NSQ_SOURCE_LINE 00001132 ""
NSQ_SOURCE_LINE 00001133 "=item *"
NSQ_SOURCE_LINE 00001134 ""
NSQ_SOURCE_LINE 00001135 "opens the input and output files for reading"
NSQ_SOURCE_LINE 00001136 "(creating the appropriate filehandles)"
NSQ_SOURCE_LINE 00001137 ""
NSQ_SOURCE_LINE 00001138 "=item *"
NSQ_SOURCE_LINE 00001139 ""
NSQ_SOURCE_LINE 00001140 "invokes the B<parse_from_filehandle()> method passing it the"
NSQ_SOURCE_LINE 00001141 "corresponding input and output filehandles."
NSQ_SOURCE_LINE 00001142 ""
NSQ_SOURCE_LINE 00001143 "=item *"
NSQ_SOURCE_LINE 00001144 ""
NSQ_SOURCE_LINE 00001145 "closes the input and output files."
NSQ_SOURCE_LINE 00001146 ""
NSQ_SOURCE_LINE 00001147 "=back"
NSQ_SOURCE_LINE 00001148 ""
NSQ_SOURCE_LINE 00001149 "If the special input filename \"\", \"-\" or \"<&STDIN\" is given then the STDIN"
NSQ_SOURCE_LINE 00001150 "filehandle is used for input (and no open or close is performed). If no"
NSQ_SOURCE_LINE 00001151 "input filename is specified then \"-\" is implied. Filehandle references,"
NSQ_SOURCE_LINE 00001152 "or objects that support the regular IO operations (like C<E<lt>$fhE<gt>>"
NSQ_SOURCE_LINE 00001153 "or C<$fh-<Egt>getline>) are also accepted; the handles must already be "
NSQ_SOURCE_LINE 00001154 "opened."
NSQ_SOURCE_LINE 00001155 ""
NSQ_SOURCE_LINE 00001156 "If a second argument is given then it should be the name of the desired"
NSQ_SOURCE_LINE 00001157 "output file. If the special output filename \"-\" or \">&STDOUT\" is given"
NSQ_SOURCE_LINE 00001158 "then the STDOUT filehandle is used for output (and no open or close is"
NSQ_SOURCE_LINE 00001159 "performed). If the special output filename \">&STDERR\" is given then the"
NSQ_SOURCE_LINE 00001160 "STDERR filehandle is used for output (and no open or close is"
NSQ_SOURCE_LINE 00001161 "performed). If no output filehandle is currently in use and no output"
NSQ_SOURCE_LINE 00001162 "filename is specified, then \"-\" is implied."
NSQ_SOURCE_LINE 00001163 "Alternatively, filehandle references or objects that support the regular"
NSQ_SOURCE_LINE 00001164 "IO operations (like C<print>, e.g. L<IO::String>) are also accepted;"
NSQ_SOURCE_LINE 00001165 "the object must already be opened."
NSQ_SOURCE_LINE 00001166 ""
NSQ_SOURCE_LINE 00001167 "This method does I<not> usually need to be overridden by subclasses."
NSQ_SOURCE_LINE 00001168 ""
NSQ_SOURCE_LINE 00001169 "=cut"
NSQ_SOURCE_LINE 00001170 ""
NSQ_SOURCE_LINE 00001171 "sub parse_from_file {"
NSQ_SOURCE_LINE 00001172 "    my $self = shift;"
NSQ_SOURCE_LINE 00001173 "    my %opts = (ref $_[0] eq 'HASH') ? %{ shift() } : ();"
NSQ_SOURCE_LINE 00001174 "    my ($infile, $outfile) = @_;"
NSQ_SOURCE_LINE 00001175 "    my ($in_fh,  $out_fh);"
NSQ_SOURCE_LINE 00001176 "    if ($] < 5.006) {"
NSQ_SOURCE_LINE 00001177 "      ($in_fh,  $out_fh) = (gensym(), gensym());"
NSQ_SOURCE_LINE 00001178 "    }"
NSQ_SOURCE_LINE 00001179 "    my ($close_input, $close_output) = (0, 0);"
NSQ_SOURCE_LINE 00001180 "    local *myData = $self;"
NSQ_SOURCE_LINE 00001181 "    local *_;"
NSQ_SOURCE_LINE 00001182 ""
NSQ_SOURCE_LINE 00001183 "    ## Is $infile a filename or a (possibly implied) filehandle"
NSQ_SOURCE_LINE 00001184 "    if (defined $infile && ref $infile) {"
NSQ_SOURCE_LINE 00001185 "        if (ref($infile) =~ /^(SCALAR|ARRAY|HASH|CODE|REF)$/) {"
NSQ_SOURCE_LINE 00001186 "            croak \"Input from $1 reference not supported!\\n\";"
NSQ_SOURCE_LINE 00001187 "        }"
NSQ_SOURCE_LINE 00001188 "        ## Must be a filehandle-ref (or else assume its a ref to an object"
NSQ_SOURCE_LINE 00001189 "        ## that supports the common IO read operations)."
NSQ_SOURCE_LINE 00001190 "        $myData{_INFILE} = ${$infile};"
NSQ_SOURCE_LINE 00001191 "        $in_fh = $infile;"
NSQ_SOURCE_LINE 00001192 "    }"
NSQ_SOURCE_LINE 00001193 "    elsif (!defined($infile) || !length($infile) || ($infile eq '-')"
NSQ_SOURCE_LINE 00001194 "        || ($infile =~ /^<&(?:STDIN|0)$/i))"
NSQ_SOURCE_LINE 00001195 "    {"
NSQ_SOURCE_LINE 00001196 "        ## Not a filename, just a string implying STDIN"
NSQ_SOURCE_LINE 00001197 "        $infile ||= '-';"
NSQ_SOURCE_LINE 00001198 "        $myData{_INFILE} = '<standard input>';"
NSQ_SOURCE_LINE 00001199 "        $in_fh = \\*STDIN;"
NSQ_SOURCE_LINE 00001200 "    }"
NSQ_SOURCE_LINE 00001201 "    else {"
NSQ_SOURCE_LINE 00001202 "        ## We have a filename, open it for reading"
NSQ_SOURCE_LINE 00001203 "        $myData{_INFILE} = $infile;"
NSQ_SOURCE_LINE 00001204 "        open($in_fh, \"< $infile\")  or"
NSQ_SOURCE_LINE 00001205 "             croak \"Can't open $infile for reading: $!\\n\";"
NSQ_SOURCE_LINE 00001206 "        $close_input = 1;"
NSQ_SOURCE_LINE 00001207 "    }"
NSQ_SOURCE_LINE 00001208 ""
NSQ_SOURCE_LINE 00001209 "    ## NOTE: we need to be *very* careful when \"defaulting\" the output"
NSQ_SOURCE_LINE 00001210 "    ## file. We only want to use a default if this is the beginning of"
NSQ_SOURCE_LINE 00001211 "    ## the entire document (but *not* if this is an included file). We"
NSQ_SOURCE_LINE 00001212 "    ## determine this by seeing if the input stream stack has been set-up"
NSQ_SOURCE_LINE 00001213 "    ## already"
NSQ_SOURCE_LINE 00001214 ""
NSQ_SOURCE_LINE 00001215 "    ## Is $outfile a filename, a (possibly implied) filehandle, maybe a ref?"
NSQ_SOURCE_LINE 00001216 "    if (ref $outfile) {"
NSQ_SOURCE_LINE 00001217 "        ## we need to check for ref() first, as other checks involve reading"
NSQ_SOURCE_LINE 00001218 "        if (ref($outfile) =~ /^(ARRAY|HASH|CODE)$/) {"
NSQ_SOURCE_LINE 00001219 "            croak \"Output to $1 reference not supported!\\n\";"
NSQ_SOURCE_LINE 00001220 "        }"
NSQ_SOURCE_LINE 00001221 "        elsif (ref($outfile) eq 'SCALAR') {"
NSQ_SOURCE_LINE 00001222 "#           # NOTE: IO::String isn't a part of the perl distribution,"
NSQ_SOURCE_LINE 00001223 "#           #       so probably we shouldn't support this case..."
NSQ_SOURCE_LINE 00001224 "#           require IO::String;"
NSQ_SOURCE_LINE 00001225 "#           $myData{_OUTFILE} = \"$outfile\";"
NSQ_SOURCE_LINE 00001226 "#           $out_fh = IO::String->new($outfile);"
NSQ_SOURCE_LINE 00001227 "            croak \"Output to SCALAR reference not supported!\\n\";"
NSQ_SOURCE_LINE 00001228 "        }"
NSQ_SOURCE_LINE 00001229 "        else {"
NSQ_SOURCE_LINE 00001230 "            ## Must be a filehandle-ref (or else assume its a ref to an"
NSQ_SOURCE_LINE 00001231 "            ## object that supports the common IO write operations)."
NSQ_SOURCE_LINE 00001232 "            $myData{_OUTFILE} = ${$outfile};"
NSQ_SOURCE_LINE 00001233 "            $out_fh = $outfile;"
NSQ_SOURCE_LINE 00001234 "        }"
NSQ_SOURCE_LINE 00001235 "    }"
NSQ_SOURCE_LINE 00001236 "    elsif (!defined($outfile) || !length($outfile) || ($outfile eq '-')"
NSQ_SOURCE_LINE 00001237 "        || ($outfile =~ /^>&?(?:STDOUT|1)$/i))"
NSQ_SOURCE_LINE 00001238 "    {"
NSQ_SOURCE_LINE 00001239 "        if (defined $myData{_TOP_STREAM}) {"
NSQ_SOURCE_LINE 00001240 "            $out_fh = $myData{_OUTPUT};"
NSQ_SOURCE_LINE 00001241 "        }"
NSQ_SOURCE_LINE 00001242 "        else {"
NSQ_SOURCE_LINE 00001243 "            ## Not a filename, just a string implying STDOUT"
NSQ_SOURCE_LINE 00001244 "            $outfile ||= '-';"
NSQ_SOURCE_LINE 00001245 "            $myData{_OUTFILE} = '<standard output>';"
NSQ_SOURCE_LINE 00001246 "            $out_fh  = \\*STDOUT;"
NSQ_SOURCE_LINE 00001247 "        }"
NSQ_SOURCE_LINE 00001248 "    }"
NSQ_SOURCE_LINE 00001249 "    elsif ($outfile =~ /^>&(STDERR|2)$/i) {"
NSQ_SOURCE_LINE 00001250 "        ## Not a filename, just a string implying STDERR"
NSQ_SOURCE_LINE 00001251 "        $myData{_OUTFILE} = '<standard error>';"
NSQ_SOURCE_LINE 00001252 "        $out_fh  = \\*STDERR;"
NSQ_SOURCE_LINE 00001253 "    }"
NSQ_SOURCE_LINE 00001254 "    else {"
NSQ_SOURCE_LINE 00001255 "        ## We have a filename, open it for writing"
NSQ_SOURCE_LINE 00001256 "        $myData{_OUTFILE} = $outfile;"
NSQ_SOURCE_LINE 00001257 "        (-d $outfile) and croak \"$outfile is a directory, not POD input!\\n\";"
NSQ_SOURCE_LINE 00001258 "        open($out_fh, \"> $outfile\")  or"
NSQ_SOURCE_LINE 00001259 "             croak \"Can't open $outfile for writing: $!\\n\";"
NSQ_SOURCE_LINE 00001260 "        $close_output = 1;"
NSQ_SOURCE_LINE 00001261 "    }"
NSQ_SOURCE_LINE 00001262 ""
NSQ_SOURCE_LINE 00001263 "    ## Whew! That was a lot of work to set up reasonably/robust behavior"
NSQ_SOURCE_LINE 00001264 "    ## in the case of a non-filename for reading and writing. Now we just"
NSQ_SOURCE_LINE 00001265 "    ## have to parse the input and close the handles when we're finished."
NSQ_SOURCE_LINE 00001266 "    $self->parse_from_filehandle(\\%opts, $in_fh, $out_fh);"
NSQ_SOURCE_LINE 00001267 ""
NSQ_SOURCE_LINE 00001268 "    $close_input  and"
NSQ_SOURCE_LINE 00001269 "        close($in_fh) || croak \"Can't close $infile after reading: $!\\n\";"
NSQ_SOURCE_LINE 00001270 "    $close_output  and"
NSQ_SOURCE_LINE 00001271 "        close($out_fh) || croak \"Can't close $outfile after writing: $!\\n\";"
NSQ_SOURCE_LINE 00001272 "}"
NSQ_SOURCE_LINE 00001273 ""
NSQ_SOURCE_LINE 00001274 "#############################################################################"
NSQ_SOURCE_LINE 00001275 ""
NSQ_SOURCE_LINE 00001276 "=head1 ACCESSOR METHODS"
NSQ_SOURCE_LINE 00001277 ""
NSQ_SOURCE_LINE 00001278 "Clients of B<Pod::Parser> should use the following methods to access"
NSQ_SOURCE_LINE 00001279 "instance data fields:"
NSQ_SOURCE_LINE 00001280 ""
NSQ_SOURCE_LINE 00001281 "=cut"
NSQ_SOURCE_LINE 00001282 ""
NSQ_SOURCE_LINE 00001283 "##---------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00001284 ""
NSQ_SOURCE_LINE 00001285 "=head1 B<errorsub()>"
NSQ_SOURCE_LINE 00001286 ""
NSQ_SOURCE_LINE 00001287 "            $parser->errorsub(\"method_name\");"
NSQ_SOURCE_LINE 00001288 "            $parser->errorsub(\\&warn_user);"
NSQ_SOURCE_LINE 00001289 "            $parser->errorsub(sub { print STDERR, @_ });"
NSQ_SOURCE_LINE 00001290 ""
NSQ_SOURCE_LINE 00001291 "Specifies the method or subroutine to use when printing error messages"
NSQ_SOURCE_LINE 00001292 "about POD syntax. The supplied method/subroutine I<must> return TRUE upon"
NSQ_SOURCE_LINE 00001293 "successful printing of the message. If C<undef> is given, then the B<carp>"
NSQ_SOURCE_LINE 00001294 "builtin is used to issue error messages (this is the default behavior)."
NSQ_SOURCE_LINE 00001295 ""
NSQ_SOURCE_LINE 00001296 "            my $errorsub = $parser->errorsub()"
NSQ_SOURCE_LINE 00001297 "            my $errmsg = \"This is an error message!\\n\""
NSQ_SOURCE_LINE 00001298 "            (ref $errorsub) and &{$errorsub}($errmsg)"
NSQ_SOURCE_LINE 00001299 "                or (defined $errorsub) and $parser->$errorsub($errmsg)"
NSQ_SOURCE_LINE 00001300 "                    or  carp($errmsg);"
NSQ_SOURCE_LINE 00001301 ""
NSQ_SOURCE_LINE 00001302 "Returns a method name, or else a reference to the user-supplied subroutine"
NSQ_SOURCE_LINE 00001303 "used to print error messages. Returns C<undef> if the B<carp> builtin"
NSQ_SOURCE_LINE 00001304 "is used to issue error messages (this is the default behavior)."
NSQ_SOURCE_LINE 00001305 ""
NSQ_SOURCE_LINE 00001306 "=cut"
NSQ_SOURCE_LINE 00001307 ""
NSQ_SOURCE_LINE 00001308 "sub errorsub {"
NSQ_SOURCE_LINE 00001309 "   return (@_ > 1) ? ($_[0]->{_ERRORSUB} = $_[1]) : $_[0]->{_ERRORSUB};"
NSQ_SOURCE_LINE 00001310 "}"
NSQ_SOURCE_LINE 00001311 ""
NSQ_SOURCE_LINE 00001312 "##---------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00001313 ""
NSQ_SOURCE_LINE 00001314 "=head1 B<cutting()>"
NSQ_SOURCE_LINE 00001315 ""
NSQ_SOURCE_LINE 00001316 "            $boolean = $parser->cutting();"
NSQ_SOURCE_LINE 00001317 ""
NSQ_SOURCE_LINE 00001318 "Returns the current C<cutting> state: a boolean-valued scalar which"
NSQ_SOURCE_LINE 00001319 "evaluates to true if text from the input file is currently being \"cut\""
NSQ_SOURCE_LINE 00001320 "(meaning it is I<not> considered part of the POD document)."
NSQ_SOURCE_LINE 00001321 ""
NSQ_SOURCE_LINE 00001322 "            $parser->cutting($boolean);"
NSQ_SOURCE_LINE 00001323 ""
NSQ_SOURCE_LINE 00001324 "Sets the current C<cutting> state to the given value and returns the"
NSQ_SOURCE_LINE 00001325 "result."
NSQ_SOURCE_LINE 00001326 ""
NSQ_SOURCE_LINE 00001327 "=cut"
NSQ_SOURCE_LINE 00001328 ""
NSQ_SOURCE_LINE 00001329 "sub cutting {"
NSQ_SOURCE_LINE 00001330 "   return (@_ > 1) ? ($_[0]->{_CUTTING} = $_[1]) : $_[0]->{_CUTTING};"
NSQ_SOURCE_LINE 00001331 "}"
NSQ_SOURCE_LINE 00001332 ""
NSQ_SOURCE_LINE 00001333 "##---------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00001334 ""
NSQ_SOURCE_LINE 00001335 "##---------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00001336 ""
NSQ_SOURCE_LINE 00001337 "=head1 B<parseopts()>"
NSQ_SOURCE_LINE 00001338 ""
NSQ_SOURCE_LINE 00001339 "When invoked with no additional arguments, B<parseopts> returns a hashtable"
NSQ_SOURCE_LINE 00001340 "of all the current parsing options."
NSQ_SOURCE_LINE 00001341 ""
NSQ_SOURCE_LINE 00001342 "            ## See if we are parsing non-POD sections as well as POD ones"
NSQ_SOURCE_LINE 00001343 "            my %opts = $parser->parseopts();"
NSQ_SOURCE_LINE 00001344 "            $opts{'-want_nonPODs}' and print \"-want_nonPODs\\n\";"
NSQ_SOURCE_LINE 00001345 ""
NSQ_SOURCE_LINE 00001346 "When invoked using a single string, B<parseopts> treats the string as the"
NSQ_SOURCE_LINE 00001347 "name of a parse-option and returns its corresponding value if it exists"
NSQ_SOURCE_LINE 00001348 "(returns C<undef> if it doesn't)."
NSQ_SOURCE_LINE 00001349 ""
NSQ_SOURCE_LINE 00001350 "            ## Did we ask to see '=cut' paragraphs?"
NSQ_SOURCE_LINE 00001351 "            my $want_cut = $parser->parseopts('-process_cut_cmd');"
NSQ_SOURCE_LINE 00001352 "            $want_cut and print \"-process_cut_cmd\\n\";"
NSQ_SOURCE_LINE 00001353 ""
NSQ_SOURCE_LINE 00001354 "When invoked with multiple arguments, B<parseopts> treats them as"
NSQ_SOURCE_LINE 00001355 "key/value pairs and the specified parse-option names are set to the"
NSQ_SOURCE_LINE 00001356 "given values. Any unspecified parse-options are unaffected."
NSQ_SOURCE_LINE 00001357 ""
NSQ_SOURCE_LINE 00001358 "            ## Set them back to the default"
NSQ_SOURCE_LINE 00001359 "            $parser->parseopts(-warnings => 0);"
NSQ_SOURCE_LINE 00001360 ""
NSQ_SOURCE_LINE 00001361 "When passed a single hash-ref, B<parseopts> uses that hash to completely"
NSQ_SOURCE_LINE 00001362 "reset the existing parse-options, all previous parse-option values"
NSQ_SOURCE_LINE 00001363 "are lost."
NSQ_SOURCE_LINE 00001364 ""
NSQ_SOURCE_LINE 00001365 "            ## Reset all options to default "
NSQ_SOURCE_LINE 00001366 "            $parser->parseopts( { } );"
NSQ_SOURCE_LINE 00001367 ""
NSQ_SOURCE_LINE 00001368 "See L<\"PARSING OPTIONS\"> for more information on the name and meaning of each"
NSQ_SOURCE_LINE 00001369 "parse-option currently recognized."
NSQ_SOURCE_LINE 00001370 ""
NSQ_SOURCE_LINE 00001371 "=cut"
NSQ_SOURCE_LINE 00001372 ""
NSQ_SOURCE_LINE 00001373 "sub parseopts {"
NSQ_SOURCE_LINE 00001374 "   local *myData = shift;"
NSQ_SOURCE_LINE 00001375 "   local *myOpts = ($myData{_PARSEOPTS} ||= {});"
NSQ_SOURCE_LINE 00001376 "   return %myOpts  if (@_ == 0);"
NSQ_SOURCE_LINE 00001377 "   if (@_ == 1) {"
NSQ_SOURCE_LINE 00001378 "      local $_ = shift;"
NSQ_SOURCE_LINE 00001379 "      return  ref($_)  ?  $myData{_PARSEOPTS} = $_  :  $myOpts{$_};"
NSQ_SOURCE_LINE 00001380 "   }"
NSQ_SOURCE_LINE 00001381 "   my @newOpts = (%myOpts, @_);"
NSQ_SOURCE_LINE 00001382 "   $myData{_PARSEOPTS} = { @newOpts };"
NSQ_SOURCE_LINE 00001383 "}"
NSQ_SOURCE_LINE 00001384 ""
NSQ_SOURCE_LINE 00001385 "##---------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00001386 ""
NSQ_SOURCE_LINE 00001387 "=head1 B<output_file()>"
NSQ_SOURCE_LINE 00001388 ""
NSQ_SOURCE_LINE 00001389 "            $fname = $parser->output_file();"
NSQ_SOURCE_LINE 00001390 ""
NSQ_SOURCE_LINE 00001391 "Returns the name of the output file being written."
NSQ_SOURCE_LINE 00001392 ""
NSQ_SOURCE_LINE 00001393 "=cut"
NSQ_SOURCE_LINE 00001394 ""
NSQ_SOURCE_LINE 00001395 "sub output_file {"
NSQ_SOURCE_LINE 00001396 "   return $_[0]->{_OUTFILE};"
NSQ_SOURCE_LINE 00001397 "}"
NSQ_SOURCE_LINE 00001398 ""
NSQ_SOURCE_LINE 00001399 "##---------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00001400 ""
NSQ_SOURCE_LINE 00001401 "=head1 B<output_handle()>"
NSQ_SOURCE_LINE 00001402 ""
NSQ_SOURCE_LINE 00001403 "            $fhandle = $parser->output_handle();"
NSQ_SOURCE_LINE 00001404 ""
NSQ_SOURCE_LINE 00001405 "Returns the output filehandle object."
NSQ_SOURCE_LINE 00001406 ""
NSQ_SOURCE_LINE 00001407 "=cut"
NSQ_SOURCE_LINE 00001408 ""
NSQ_SOURCE_LINE 00001409 "sub output_handle {"
NSQ_SOURCE_LINE 00001410 "   return $_[0]->{_OUTPUT};"
NSQ_SOURCE_LINE 00001411 "}"
NSQ_SOURCE_LINE 00001412 ""
NSQ_SOURCE_LINE 00001413 "##---------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00001414 ""
NSQ_SOURCE_LINE 00001415 "=head1 B<input_file()>"
NSQ_SOURCE_LINE 00001416 ""
NSQ_SOURCE_LINE 00001417 "            $fname = $parser->input_file();"
NSQ_SOURCE_LINE 00001418 ""
NSQ_SOURCE_LINE 00001419 "Returns the name of the input file being read."
NSQ_SOURCE_LINE 00001420 ""
NSQ_SOURCE_LINE 00001421 "=cut"
NSQ_SOURCE_LINE 00001422 ""
NSQ_SOURCE_LINE 00001423 "sub input_file {"
NSQ_SOURCE_LINE 00001424 "   return $_[0]->{_INFILE};"
NSQ_SOURCE_LINE 00001425 "}"
NSQ_SOURCE_LINE 00001426 ""
NSQ_SOURCE_LINE 00001427 "##---------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00001428 ""
NSQ_SOURCE_LINE 00001429 "=head1 B<input_handle()>"
NSQ_SOURCE_LINE 00001430 ""
NSQ_SOURCE_LINE 00001431 "            $fhandle = $parser->input_handle();"
NSQ_SOURCE_LINE 00001432 ""
NSQ_SOURCE_LINE 00001433 "Returns the current input filehandle object."
NSQ_SOURCE_LINE 00001434 ""
NSQ_SOURCE_LINE 00001435 "=cut"
NSQ_SOURCE_LINE 00001436 ""
NSQ_SOURCE_LINE 00001437 "sub input_handle {"
NSQ_SOURCE_LINE 00001438 "   return $_[0]->{_INPUT};"
NSQ_SOURCE_LINE 00001439 "}"
NSQ_SOURCE_LINE 00001440 ""
NSQ_SOURCE_LINE 00001441 "##---------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00001442 ""
NSQ_SOURCE_LINE 00001443 "=begin __PRIVATE__"
NSQ_SOURCE_LINE 00001444 ""
NSQ_SOURCE_LINE 00001445 "=head1 B<input_streams()>"
NSQ_SOURCE_LINE 00001446 ""
NSQ_SOURCE_LINE 00001447 "            $listref = $parser->input_streams();"
NSQ_SOURCE_LINE 00001448 ""
NSQ_SOURCE_LINE 00001449 "Returns a reference to an array which corresponds to the stack of all"
NSQ_SOURCE_LINE 00001450 "the input streams that are currently in the middle of being parsed."
NSQ_SOURCE_LINE 00001451 ""
NSQ_SOURCE_LINE 00001452 "While parsing an input stream, it is possible to invoke"
NSQ_SOURCE_LINE 00001453 "B<parse_from_file()> or B<parse_from_filehandle()> to parse a new input"
NSQ_SOURCE_LINE 00001454 "stream and then return to parsing the previous input stream. Each input"
NSQ_SOURCE_LINE 00001455 "stream to be parsed is pushed onto the end of this input stack"
NSQ_SOURCE_LINE 00001456 "before any of its input is read. The input stream that is currently"
NSQ_SOURCE_LINE 00001457 "being parsed is always at the end (or top) of the input stack. When an"
NSQ_SOURCE_LINE 00001458 "input stream has been exhausted, it is popped off the end of the"
NSQ_SOURCE_LINE 00001459 "input stack."
NSQ_SOURCE_LINE 00001460 ""
NSQ_SOURCE_LINE 00001461 "Each element on this input stack is a reference to C<Pod::InputSource>"
NSQ_SOURCE_LINE 00001462 "object. Please see L<Pod::InputObjects> for more details."
NSQ_SOURCE_LINE 00001463 ""
NSQ_SOURCE_LINE 00001464 "This method might be invoked when printing diagnostic messages, for example,"
NSQ_SOURCE_LINE 00001465 "to obtain the name and line number of the all input files that are currently"
NSQ_SOURCE_LINE 00001466 "being processed."
NSQ_SOURCE_LINE 00001467 ""
NSQ_SOURCE_LINE 00001468 "=end __PRIVATE__"
NSQ_SOURCE_LINE 00001469 ""
NSQ_SOURCE_LINE 00001470 "=cut"
NSQ_SOURCE_LINE 00001471 ""
NSQ_SOURCE_LINE 00001472 "sub input_streams {"
NSQ_SOURCE_LINE 00001473 "   return $_[0]->{_INPUT_STREAMS};"
NSQ_SOURCE_LINE 00001474 "}"
NSQ_SOURCE_LINE 00001475 ""
NSQ_SOURCE_LINE 00001476 "##---------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00001477 ""
NSQ_SOURCE_LINE 00001478 "=begin __PRIVATE__"
NSQ_SOURCE_LINE 00001479 ""
NSQ_SOURCE_LINE 00001480 "=head1 B<top_stream()>"
NSQ_SOURCE_LINE 00001481 ""
NSQ_SOURCE_LINE 00001482 "            $hashref = $parser->top_stream();"
NSQ_SOURCE_LINE 00001483 ""
NSQ_SOURCE_LINE 00001484 "Returns a reference to the hash-table that represents the element"
NSQ_SOURCE_LINE 00001485 "that is currently at the top (end) of the input stream stack"
NSQ_SOURCE_LINE 00001486 "(see L<\"input_streams()\">). The return value will be the C<undef>"
NSQ_SOURCE_LINE 00001487 "if the input stack is empty."
NSQ_SOURCE_LINE 00001488 ""
NSQ_SOURCE_LINE 00001489 "This method might be used when printing diagnostic messages, for example,"
NSQ_SOURCE_LINE 00001490 "to obtain the name and line number of the current input file."
NSQ_SOURCE_LINE 00001491 ""
NSQ_SOURCE_LINE 00001492 "=end __PRIVATE__"
NSQ_SOURCE_LINE 00001493 ""
NSQ_SOURCE_LINE 00001494 "=cut"
NSQ_SOURCE_LINE 00001495 ""
NSQ_SOURCE_LINE 00001496 "sub top_stream {"
NSQ_SOURCE_LINE 00001497 "   return $_[0]->{_TOP_STREAM} || undef;"
NSQ_SOURCE_LINE 00001498 "}"
NSQ_SOURCE_LINE 00001499 ""
NSQ_SOURCE_LINE 00001500 "#############################################################################"
NSQ_SOURCE_LINE 00001501 ""
NSQ_SOURCE_LINE 00001502 "=head1 PRIVATE METHODS AND DATA"
NSQ_SOURCE_LINE 00001503 ""
NSQ_SOURCE_LINE 00001504 "B<Pod::Parser> makes use of several internal methods and data fields"
NSQ_SOURCE_LINE 00001505 "which clients should not need to see or use. For the sake of avoiding"
NSQ_SOURCE_LINE 00001506 "name collisions for client data and methods, these methods and fields"
NSQ_SOURCE_LINE 00001507 "are briefly discussed here. Determined hackers may obtain further"
NSQ_SOURCE_LINE 00001508 "information about them by reading the B<Pod::Parser> source code."
NSQ_SOURCE_LINE 00001509 ""
NSQ_SOURCE_LINE 00001510 "Private data fields are stored in the hash-object whose reference is"
NSQ_SOURCE_LINE 00001511 "returned by the B<new()> constructor for this class. The names of all"
NSQ_SOURCE_LINE 00001512 "private methods and data-fields used by B<Pod::Parser> begin with a"
NSQ_SOURCE_LINE 00001513 "prefix of \"_\" and match the regular expression C</^_\\w+$/>."
NSQ_SOURCE_LINE 00001514 ""
NSQ_SOURCE_LINE 00001515 "=cut"
NSQ_SOURCE_LINE 00001516 ""
NSQ_SOURCE_LINE 00001517 "##---------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00001518 ""
NSQ_SOURCE_LINE 00001519 "=begin _PRIVATE_"
NSQ_SOURCE_LINE 00001520 ""
NSQ_SOURCE_LINE 00001521 "=head1 B<_push_input_stream()>"
NSQ_SOURCE_LINE 00001522 ""
NSQ_SOURCE_LINE 00001523 "            $hashref = $parser->_push_input_stream($in_fh,$out_fh);"
NSQ_SOURCE_LINE 00001524 ""
NSQ_SOURCE_LINE 00001525 "This method will push the given input stream on the input stack and"
NSQ_SOURCE_LINE 00001526 "perform any necessary beginning-of-document or beginning-of-file"
NSQ_SOURCE_LINE 00001527 "processing. The argument C<$in_fh> is the input stream filehandle to"
NSQ_SOURCE_LINE 00001528 "push, and C<$out_fh> is the corresponding output filehandle to use (if"
NSQ_SOURCE_LINE 00001529 "it is not given or is undefined, then the current output stream is used,"
NSQ_SOURCE_LINE 00001530 "which defaults to standard output if it doesnt exist yet)."
NSQ_SOURCE_LINE 00001531 ""
NSQ_SOURCE_LINE 00001532 "The value returned will be reference to the hash-table that represents"
NSQ_SOURCE_LINE 00001533 "the new top of the input stream stack. I<Please Note> that it is"
NSQ_SOURCE_LINE 00001534 "possible for this method to use default values for the input and output"
NSQ_SOURCE_LINE 00001535 "file handles. If this happens, you will need to look at the C<INPUT>"
NSQ_SOURCE_LINE 00001536 "and C<OUTPUT> instance data members to determine their new values."
NSQ_SOURCE_LINE 00001537 ""
NSQ_SOURCE_LINE 00001538 "=end _PRIVATE_"
NSQ_SOURCE_LINE 00001539 ""
NSQ_SOURCE_LINE 00001540 "=cut"
NSQ_SOURCE_LINE 00001541 ""
NSQ_SOURCE_LINE 00001542 "sub _push_input_stream {"
NSQ_SOURCE_LINE 00001543 "    my ($self, $in_fh, $out_fh) = @_;"
NSQ_SOURCE_LINE 00001544 "    local *myData = $self;"
NSQ_SOURCE_LINE 00001545 ""
NSQ_SOURCE_LINE 00001546 "    ## Initialize stuff for the entire document if this is *not*"
NSQ_SOURCE_LINE 00001547 "    ## an included file."
NSQ_SOURCE_LINE 00001548 "    ##"
NSQ_SOURCE_LINE 00001549 "    ## NOTE: we need to be *very* careful when \"defaulting\" the output"
NSQ_SOURCE_LINE 00001550 "    ## filehandle. We only want to use a default value if this is the"
NSQ_SOURCE_LINE 00001551 "    ## beginning of the entire document (but *not* if this is an included"
NSQ_SOURCE_LINE 00001552 "    ## file)."
NSQ_SOURCE_LINE 00001553 "    unless (defined  $myData{_TOP_STREAM}) {"
NSQ_SOURCE_LINE 00001554 "        $out_fh  = \\*STDOUT  unless (defined $out_fh);"
NSQ_SOURCE_LINE 00001555 "        $myData{_CUTTING}       = 1;   ## current \"cutting\" state"
NSQ_SOURCE_LINE 00001556 "        $myData{_INPUT_STREAMS} = [];  ## stack of all input streams"
NSQ_SOURCE_LINE 00001557 "    }"
NSQ_SOURCE_LINE 00001558 ""
NSQ_SOURCE_LINE 00001559 "    ## Initialize input indicators"
NSQ_SOURCE_LINE 00001560 "    $myData{_OUTFILE} = '(unknown)'  unless (defined  $myData{_OUTFILE});"
NSQ_SOURCE_LINE 00001561 "    $myData{_OUTPUT}  = $out_fh      if (defined  $out_fh);"
NSQ_SOURCE_LINE 00001562 "    $in_fh            = \\*STDIN      unless (defined  $in_fh);"
NSQ_SOURCE_LINE 00001563 "    $myData{_INFILE}  = '(unknown)'  unless (defined  $myData{_INFILE});"
NSQ_SOURCE_LINE 00001564 "    $myData{_INPUT}   = $in_fh;"
NSQ_SOURCE_LINE 00001565 "    my $input_top     = $myData{_TOP_STREAM}"
NSQ_SOURCE_LINE 00001566 "                      = new Pod::InputSource("
NSQ_SOURCE_LINE 00001567 "                            -name        => $myData{_INFILE},"
NSQ_SOURCE_LINE 00001568 "                            -handle      => $in_fh,"
NSQ_SOURCE_LINE 00001569 "                            -was_cutting => $myData{_CUTTING}"
NSQ_SOURCE_LINE 00001570 "                        );"
NSQ_SOURCE_LINE 00001571 "    local *input_stack = $myData{_INPUT_STREAMS};"
NSQ_SOURCE_LINE 00001572 "    push(@input_stack, $input_top);"
NSQ_SOURCE_LINE 00001573 ""
NSQ_SOURCE_LINE 00001574 "    ## Perform beginning-of-document and/or beginning-of-input processing"
NSQ_SOURCE_LINE 00001575 "    $self->begin_pod()  if (@input_stack == 1);"
NSQ_SOURCE_LINE 00001576 "    $self->begin_input();"
NSQ_SOURCE_LINE 00001577 ""
NSQ_SOURCE_LINE 00001578 "    return  $input_top;"
NSQ_SOURCE_LINE 00001579 "}"
NSQ_SOURCE_LINE 00001580 ""
NSQ_SOURCE_LINE 00001581 "##---------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00001582 ""
NSQ_SOURCE_LINE 00001583 "=begin _PRIVATE_"
NSQ_SOURCE_LINE 00001584 ""
NSQ_SOURCE_LINE 00001585 "=head1 B<_pop_input_stream()>"
NSQ_SOURCE_LINE 00001586 ""
NSQ_SOURCE_LINE 00001587 "            $hashref = $parser->_pop_input_stream();"
NSQ_SOURCE_LINE 00001588 ""
NSQ_SOURCE_LINE 00001589 "This takes no arguments. It will perform any necessary end-of-file or"
NSQ_SOURCE_LINE 00001590 "end-of-document processing and then pop the current input stream from"
NSQ_SOURCE_LINE 00001591 "the top of the input stack."
NSQ_SOURCE_LINE 00001592 ""
NSQ_SOURCE_LINE 00001593 "The value returned will be reference to the hash-table that represents"
NSQ_SOURCE_LINE 00001594 "the new top of the input stream stack."
NSQ_SOURCE_LINE 00001595 ""
NSQ_SOURCE_LINE 00001596 "=end _PRIVATE_"
NSQ_SOURCE_LINE 00001597 ""
NSQ_SOURCE_LINE 00001598 "=cut"
NSQ_SOURCE_LINE 00001599 ""
NSQ_SOURCE_LINE 00001600 "sub _pop_input_stream {"
NSQ_SOURCE_LINE 00001601 "    my ($self) = @_;"
NSQ_SOURCE_LINE 00001602 "    local *myData = $self;"
NSQ_SOURCE_LINE 00001603 "    local *input_stack = $myData{_INPUT_STREAMS};"
NSQ_SOURCE_LINE 00001604 ""
NSQ_SOURCE_LINE 00001605 "    ## Perform end-of-input and/or end-of-document processing"
NSQ_SOURCE_LINE 00001606 "    $self->end_input()  if (@input_stack > 0);"
NSQ_SOURCE_LINE 00001607 "    $self->end_pod()    if (@input_stack == 1);"
NSQ_SOURCE_LINE 00001608 ""
NSQ_SOURCE_LINE 00001609 "    ## Restore cutting state to whatever it was before we started"
NSQ_SOURCE_LINE 00001610 "    ## parsing this file."
NSQ_SOURCE_LINE 00001611 "    my $old_top = pop(@input_stack);"
NSQ_SOURCE_LINE 00001612 "    $myData{_CUTTING} = $old_top->was_cutting();"
NSQ_SOURCE_LINE 00001613 ""
NSQ_SOURCE_LINE 00001614 "    ## Don't forget to reset the input indicators"
NSQ_SOURCE_LINE 00001615 "    my $input_top = undef;"
NSQ_SOURCE_LINE 00001616 "    if (@input_stack > 0) {"
NSQ_SOURCE_LINE 00001617 "       $input_top = $myData{_TOP_STREAM} = $input_stack[-1];"
NSQ_SOURCE_LINE 00001618 "       $myData{_INFILE}  = $input_top->name();"
NSQ_SOURCE_LINE 00001619 "       $myData{_INPUT}   = $input_top->handle();"
NSQ_SOURCE_LINE 00001620 "    } else {"
NSQ_SOURCE_LINE 00001621 "       delete $myData{_TOP_STREAM};"
NSQ_SOURCE_LINE 00001622 "       delete $myData{_INPUT_STREAMS};"
NSQ_SOURCE_LINE 00001623 "    }"
NSQ_SOURCE_LINE 00001624 ""
NSQ_SOURCE_LINE 00001625 "    return  $input_top;"
NSQ_SOURCE_LINE 00001626 "}"
NSQ_SOURCE_LINE 00001627 ""
NSQ_SOURCE_LINE 00001628 "#############################################################################"
NSQ_SOURCE_LINE 00001629 ""
NSQ_SOURCE_LINE 00001630 "=head1 TREE-BASED PARSING"
NSQ_SOURCE_LINE 00001631 ""
NSQ_SOURCE_LINE 00001632 "If straightforward stream-based parsing wont meet your needs (as is"
NSQ_SOURCE_LINE 00001633 "likely the case for tasks such as translating PODs into structured"
NSQ_SOURCE_LINE 00001634 "markup languages like HTML and XML) then you may need to take the"
NSQ_SOURCE_LINE 00001635 "tree-based approach. Rather than doing everything in one pass and"
NSQ_SOURCE_LINE 00001636 "calling the B<interpolate()> method to expand sequences into text, it"
NSQ_SOURCE_LINE 00001637 "may be desirable to instead create a parse-tree using the B<parse_text()>"
NSQ_SOURCE_LINE 00001638 "method to return a tree-like structure which may contain an ordered"
NSQ_SOURCE_LINE 00001639 "list of children (each of which may be a text-string, or a similar"
NSQ_SOURCE_LINE 00001640 "tree-like structure)."
NSQ_SOURCE_LINE 00001641 ""
NSQ_SOURCE_LINE 00001642 "Pay special attention to L<\"METHODS FOR PARSING AND PROCESSING\"> and"
NSQ_SOURCE_LINE 00001643 "to the objects described in L<Pod::InputObjects>. The former describes"
NSQ_SOURCE_LINE 00001644 "the gory details and parameters for how to customize and extend the"
NSQ_SOURCE_LINE 00001645 "parsing behavior of B<Pod::Parser>. B<Pod::InputObjects> provides"
NSQ_SOURCE_LINE 00001646 "several objects that may all be used interchangeably as parse-trees. The"
NSQ_SOURCE_LINE 00001647 "most obvious one is the B<Pod::ParseTree> object. It defines the basic"
NSQ_SOURCE_LINE 00001648 "interface and functionality that all things trying to be a POD parse-tree"
NSQ_SOURCE_LINE 00001649 "should do. A B<Pod::ParseTree> is defined such that each \"node\" may be a"
NSQ_SOURCE_LINE 00001650 "text-string, or a reference to another parse-tree.  Each B<Pod::Paragraph>"
NSQ_SOURCE_LINE 00001651 "object and each B<Pod::InteriorSequence> object also supports the basic"
NSQ_SOURCE_LINE 00001652 "parse-tree interface."
NSQ_SOURCE_LINE 00001653 ""
NSQ_SOURCE_LINE 00001654 "The B<parse_text()> method takes a given paragraph of text, and"
NSQ_SOURCE_LINE 00001655 "returns a parse-tree that contains one or more children, each of which"
NSQ_SOURCE_LINE 00001656 "may be a text-string, or an InteriorSequence object. There are also"
NSQ_SOURCE_LINE 00001657 "callback-options that may be passed to B<parse_text()> to customize"
NSQ_SOURCE_LINE 00001658 "the way it expands or transforms interior-sequences, as well as the"
NSQ_SOURCE_LINE 00001659 "returned result. These callbacks can be used to create a parse-tree"
NSQ_SOURCE_LINE 00001660 "with custom-made objects (which may or may not support the parse-tree"
NSQ_SOURCE_LINE 00001661 "interface, depending on how you choose to do it)."
NSQ_SOURCE_LINE 00001662 ""
NSQ_SOURCE_LINE 00001663 "If you wish to turn an entire POD document into a parse-tree, that process"
NSQ_SOURCE_LINE 00001664 "is fairly straightforward. The B<parse_text()> method is the key to doing"
NSQ_SOURCE_LINE 00001665 "this successfully. Every paragraph-callback (i.e. the polymorphic methods"
NSQ_SOURCE_LINE 00001666 "for B<command()>, B<verbatim()>, and B<textblock()> paragraphs) takes"
NSQ_SOURCE_LINE 00001667 "a B<Pod::Paragraph> object as an argument. Each paragraph object has a"
NSQ_SOURCE_LINE 00001668 "B<parse_tree()> method that can be used to get or set a corresponding"
NSQ_SOURCE_LINE 00001669 "parse-tree. So for each of those paragraph-callback methods, simply call"
NSQ_SOURCE_LINE 00001670 "B<parse_text()> with the options you desire, and then use the returned"
NSQ_SOURCE_LINE 00001671 "parse-tree to assign to the given paragraph object."
NSQ_SOURCE_LINE 00001672 ""
NSQ_SOURCE_LINE 00001673 "That gives you a parse-tree for each paragraph - so now all you need is"
NSQ_SOURCE_LINE 00001674 "an ordered list of paragraphs. You can maintain that yourself as a data"
NSQ_SOURCE_LINE 00001675 "element in the object/hash. The most straightforward way would be simply"
NSQ_SOURCE_LINE 00001676 "to use an array-ref, with the desired set of custom \"options\" for each"
NSQ_SOURCE_LINE 00001677 "invocation of B<parse_text>. Let's assume the desired option-set is"
NSQ_SOURCE_LINE 00001678 "given by the hash C<%options>. Then we might do something like the"
NSQ_SOURCE_LINE 00001679 "following:"
NSQ_SOURCE_LINE 00001680 ""
NSQ_SOURCE_LINE 00001681 "    package MyPodParserTree;"
NSQ_SOURCE_LINE 00001682 ""
NSQ_SOURCE_LINE 00001683 "    @ISA = qw( Pod::Parser );"
NSQ_SOURCE_LINE 00001684 ""
NSQ_SOURCE_LINE 00001685 "    ..."
NSQ_SOURCE_LINE 00001686 ""
NSQ_SOURCE_LINE 00001687 "    sub begin_pod {"
NSQ_SOURCE_LINE 00001688 "        my $self = shift;"
NSQ_SOURCE_LINE 00001689 "        $self->{'-paragraphs'} = [];  ## initialize paragraph list"
NSQ_SOURCE_LINE 00001690 "    }"
NSQ_SOURCE_LINE 00001691 ""
NSQ_SOURCE_LINE 00001692 "    sub command { "
NSQ_SOURCE_LINE 00001693 "        my ($parser, $command, $paragraph, $line_num, $pod_para) = @_;"
NSQ_SOURCE_LINE 00001694 "        my $ptree = $parser->parse_text({%options}, $paragraph, ...);"
NSQ_SOURCE_LINE 00001695 "        $pod_para->parse_tree( $ptree );"
NSQ_SOURCE_LINE 00001696 "        push @{ $self->{'-paragraphs'} }, $pod_para;"
NSQ_SOURCE_LINE 00001697 "    }"
NSQ_SOURCE_LINE 00001698 ""
NSQ_SOURCE_LINE 00001699 "    sub verbatim { "
NSQ_SOURCE_LINE 00001700 "        my ($parser, $paragraph, $line_num, $pod_para) = @_;"
NSQ_SOURCE_LINE 00001701 "        push @{ $self->{'-paragraphs'} }, $pod_para;"
NSQ_SOURCE_LINE 00001702 "    }"
NSQ_SOURCE_LINE 00001703 ""
NSQ_SOURCE_LINE 00001704 "    sub textblock { "
NSQ_SOURCE_LINE 00001705 "        my ($parser, $paragraph, $line_num, $pod_para) = @_;"
NSQ_SOURCE_LINE 00001706 "        my $ptree = $parser->parse_text({%options}, $paragraph, ...);"
NSQ_SOURCE_LINE 00001707 "        $pod_para->parse_tree( $ptree );"
NSQ_SOURCE_LINE 00001708 "        push @{ $self->{'-paragraphs'} }, $pod_para;"
NSQ_SOURCE_LINE 00001709 "    }"
NSQ_SOURCE_LINE 00001710 ""
NSQ_SOURCE_LINE 00001711 "    ..."
NSQ_SOURCE_LINE 00001712 ""
NSQ_SOURCE_LINE 00001713 "    package main;"
NSQ_SOURCE_LINE 00001714 "    ..."
NSQ_SOURCE_LINE 00001715 "    my $parser = new MyPodParserTree(...);"
NSQ_SOURCE_LINE 00001716 "    $parser->parse_from_file(...);"
NSQ_SOURCE_LINE 00001717 "    my $paragraphs_ref = $parser->{'-paragraphs'};"
NSQ_SOURCE_LINE 00001718 ""
NSQ_SOURCE_LINE 00001719 "Of course, in this module-author's humble opinion, I'd be more inclined to"
NSQ_SOURCE_LINE 00001720 "use the existing B<Pod::ParseTree> object than a simple array. That way"
NSQ_SOURCE_LINE 00001721 "everything in it, paragraphs and sequences, all respond to the same core"
NSQ_SOURCE_LINE 00001722 "interface for all parse-tree nodes. The result would look something like:"
NSQ_SOURCE_LINE 00001723 ""
NSQ_SOURCE_LINE 00001724 "    package MyPodParserTree2;"
NSQ_SOURCE_LINE 00001725 ""
NSQ_SOURCE_LINE 00001726 "    ..."
NSQ_SOURCE_LINE 00001727 ""
NSQ_SOURCE_LINE 00001728 "    sub begin_pod {"
NSQ_SOURCE_LINE 00001729 "        my $self = shift;"
NSQ_SOURCE_LINE 00001730 "        $self->{'-ptree'} = new Pod::ParseTree;  ## initialize parse-tree"
NSQ_SOURCE_LINE 00001731 "    }"
NSQ_SOURCE_LINE 00001732 ""
NSQ_SOURCE_LINE 00001733 "    sub parse_tree {"
NSQ_SOURCE_LINE 00001734 "        ## convenience method to get/set the parse-tree for the entire POD"
NSQ_SOURCE_LINE 00001735 "        (@_ > 1)  and  $_[0]->{'-ptree'} = $_[1];"
NSQ_SOURCE_LINE 00001736 "        return $_[0]->{'-ptree'};"
NSQ_SOURCE_LINE 00001737 "    }"
NSQ_SOURCE_LINE 00001738 ""
NSQ_SOURCE_LINE 00001739 "    sub command { "
NSQ_SOURCE_LINE 00001740 "        my ($parser, $command, $paragraph, $line_num, $pod_para) = @_;"
NSQ_SOURCE_LINE 00001741 "        my $ptree = $parser->parse_text({<<options>>}, $paragraph, ...);"
NSQ_SOURCE_LINE 00001742 "        $pod_para->parse_tree( $ptree );"
NSQ_SOURCE_LINE 00001743 "        $parser->parse_tree()->append( $pod_para );"
NSQ_SOURCE_LINE 00001744 "    }"
NSQ_SOURCE_LINE 00001745 ""
NSQ_SOURCE_LINE 00001746 "    sub verbatim { "
NSQ_SOURCE_LINE 00001747 "        my ($parser, $paragraph, $line_num, $pod_para) = @_;"
NSQ_SOURCE_LINE 00001748 "        $parser->parse_tree()->append( $pod_para );"
NSQ_SOURCE_LINE 00001749 "    }"
NSQ_SOURCE_LINE 00001750 ""
NSQ_SOURCE_LINE 00001751 "    sub textblock { "
NSQ_SOURCE_LINE 00001752 "        my ($parser, $paragraph, $line_num, $pod_para) = @_;"
NSQ_SOURCE_LINE 00001753 "        my $ptree = $parser->parse_text({<<options>>}, $paragraph, ...);"
NSQ_SOURCE_LINE 00001754 "        $pod_para->parse_tree( $ptree );"
NSQ_SOURCE_LINE 00001755 "        $parser->parse_tree()->append( $pod_para );"
NSQ_SOURCE_LINE 00001756 "    }"
NSQ_SOURCE_LINE 00001757 ""
NSQ_SOURCE_LINE 00001758 "    ..."
NSQ_SOURCE_LINE 00001759 ""
NSQ_SOURCE_LINE 00001760 "    package main;"
NSQ_SOURCE_LINE 00001761 "    ..."
NSQ_SOURCE_LINE 00001762 "    my $parser = new MyPodParserTree2(...);"
NSQ_SOURCE_LINE 00001763 "    $parser->parse_from_file(...);"
NSQ_SOURCE_LINE 00001764 "    my $ptree = $parser->parse_tree;"
NSQ_SOURCE_LINE 00001765 "    ..."
NSQ_SOURCE_LINE 00001766 ""
NSQ_SOURCE_LINE 00001767 "Now you have the entire POD document as one great big parse-tree. You"
NSQ_SOURCE_LINE 00001768 "can even use the B<-expand_seq> option to B<parse_text> to insert"
NSQ_SOURCE_LINE 00001769 "whole different kinds of objects. Just don't expect B<Pod::Parser>"
NSQ_SOURCE_LINE 00001770 "to know what to do with them after that. That will need to be in your"
NSQ_SOURCE_LINE 00001771 "code. Or, alternatively, you can insert any object you like so long as"
NSQ_SOURCE_LINE 00001772 "it conforms to the B<Pod::ParseTree> interface."
NSQ_SOURCE_LINE 00001773 ""
NSQ_SOURCE_LINE 00001774 "One could use this to create subclasses of B<Pod::Paragraphs> and"
NSQ_SOURCE_LINE 00001775 "B<Pod::InteriorSequences> for specific commands (or to create your own"
NSQ_SOURCE_LINE 00001776 "custom node-types in the parse-tree) and add some kind of B<emit()>"
NSQ_SOURCE_LINE 00001777 "method to each custom node/subclass object in the tree. Then all you'd"
NSQ_SOURCE_LINE 00001778 "need to do is recursively walk the tree in the desired order, processing"
NSQ_SOURCE_LINE 00001779 "the children (most likely from left to right) by formatting them if"
NSQ_SOURCE_LINE 00001780 "they are text-strings, or by calling their B<emit()> method if they"
NSQ_SOURCE_LINE 00001781 "are objects/references."
NSQ_SOURCE_LINE 00001782 ""
NSQ_SOURCE_LINE 00001783 "=head1 CAVEATS"
NSQ_SOURCE_LINE 00001784 ""
NSQ_SOURCE_LINE 00001785 "Please note that POD has the notion of \"paragraphs\": this is something"
NSQ_SOURCE_LINE 00001786 "starting I<after> a blank (read: empty) line, with the single exception"
NSQ_SOURCE_LINE 00001787 "of the file start, which is also starting a paragraph. That means that"
NSQ_SOURCE_LINE 00001788 "especially a command (e.g. C<=head1>) I<must> be preceded with a blank"
NSQ_SOURCE_LINE 00001789 "line; C<__END__> is I<not> a blank line."
NSQ_SOURCE_LINE 00001790 ""
NSQ_SOURCE_LINE 00001791 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00001792 ""
NSQ_SOURCE_LINE 00001793 "L<Pod::InputObjects>, L<Pod::Select>"
NSQ_SOURCE_LINE 00001794 ""
NSQ_SOURCE_LINE 00001795 "B<Pod::InputObjects> defines POD input objects corresponding to"
NSQ_SOURCE_LINE 00001796 "command paragraphs, parse-trees, and interior-sequences."
NSQ_SOURCE_LINE 00001797 ""
NSQ_SOURCE_LINE 00001798 "B<Pod::Select> is a subclass of B<Pod::Parser> which provides the ability"
NSQ_SOURCE_LINE 00001799 "to selectively include and/or exclude sections of a POD document from being"
NSQ_SOURCE_LINE 00001800 "translated based upon the current heading, subheading, subsubheading, etc."
NSQ_SOURCE_LINE 00001801 ""
NSQ_SOURCE_LINE 00001802 "=for __PRIVATE__"
NSQ_SOURCE_LINE 00001803 "B<Pod::Callbacks> is a subclass of B<Pod::Parser> which gives its users"
NSQ_SOURCE_LINE 00001804 "the ability the employ I<callback functions> instead of, or in addition"
NSQ_SOURCE_LINE 00001805 "to, overriding methods of the base class."
NSQ_SOURCE_LINE 00001806 ""
NSQ_SOURCE_LINE 00001807 "=for __PRIVATE__"
NSQ_SOURCE_LINE 00001808 "B<Pod::Select> and B<Pod::Callbacks> do not override any"
NSQ_SOURCE_LINE 00001809 "methods nor do they define any new methods with the same name. Because"
NSQ_SOURCE_LINE 00001810 "of this, they may I<both> be used (in combination) as a base class of"
NSQ_SOURCE_LINE 00001811 "the same subclass in order to combine their functionality without"
NSQ_SOURCE_LINE 00001812 "causing any namespace clashes due to multiple inheritance."
NSQ_SOURCE_LINE 00001813 ""
NSQ_SOURCE_LINE 00001814 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00001815 ""
NSQ_SOURCE_LINE 00001816 "Please report bugs using L<http://rt.cpan.org>."
NSQ_SOURCE_LINE 00001817 ""
