NSQ_SOURCE_LINE 00000030 "# Seed size: 256 bits is eight 32-bit integers."
NSQ_SOURCE_LINE 00000031 "use constant SEED_SIZE => 256;       # In bits"
NSQ_SOURCE_LINE 00000032 "use constant SEED_MIN  => 64;"
NSQ_SOURCE_LINE 00000033 "use constant SEED_MAX  => 8192;"
NSQ_SOURCE_LINE 00000034 "use constant PRNG      => 'ISAAC';"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "use constant OO_ATTRIBS => {"
NSQ_SOURCE_LINE 00000038 "    Weak        => 0,            # Boolean. (0)             Crypt::Random::Seed"
NSQ_SOURCE_LINE 00000039 "    NonBlocking => 0,            # Boolean. (0)             Crypt::Random::Seed"
NSQ_SOURCE_LINE 00000040 "    Only        => undef,        # Aref of strings.         Crypt::Random::Seed"
NSQ_SOURCE_LINE 00000041 "    Never       => undef,        # Aref of strings.         Crypt::Random::Seed"
NSQ_SOURCE_LINE 00000042 "    Source      => undef,        # Subref or ARef.          Crypt::Random::Seed"
NSQ_SOURCE_LINE 00000043 "    PRNG        => PRNG,         # String. Alt RNG.         Internal (ISAAC)"
NSQ_SOURCE_LINE 00000044 "    Bits        => SEED_SIZE,    # Seed 64 <= Bits <= 8192. Internal (256)"
NSQ_SOURCE_LINE 00000045 "};"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "# Function interface seed attributes (standard, and lite)."
NSQ_SOURCE_LINE 00000048 "use constant FUNC_STD => {"
NSQ_SOURCE_LINE 00000049 "    Weak        => 0,"
NSQ_SOURCE_LINE 00000050 "    NonBlocking => 0,"
NSQ_SOURCE_LINE 00000051 "    Bits        => SEED_SIZE,"
NSQ_SOURCE_LINE 00000052 "};"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "use constant CRYPT_RANDOM_SEED_OPTS =>"
NSQ_SOURCE_LINE 00000056 "  [ qw( Weak NonBlocking Only Never Source ) ];"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 ""
