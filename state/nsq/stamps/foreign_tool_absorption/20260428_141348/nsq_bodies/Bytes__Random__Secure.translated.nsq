NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "# Constructor"
NSQ_SOURCE_LINE 00000065 "sub new {"
NSQ_SOURCE_LINE 00000066 "    my ( $class, @config ) = @_;"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "    my $self = bless {}, $class;"
NSQ_SOURCE_LINE 00000069 "    my $args_href = $self->_build_args(@config);"
NSQ_SOURCE_LINE 00000070 "    $self->_build_attributes($args_href);"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "    return $self;"
NSQ_SOURCE_LINE 00000073 "}"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "sub _build_args {"
NSQ_SOURCE_LINE 00000077 "    my ( $self, @args ) = @_;"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "    @args = %{ $args[0] } if ref $args[0] eq 'HASH';"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "    croak \"Illegal argument list; key => value pairs expected.\""
NSQ_SOURCE_LINE 00000082 "      if @args % 2;"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "    my %args = $self->_validate_args( OO_ATTRIBS, @args );"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "    if ( exists $args{Bits} ) {"
NSQ_SOURCE_LINE 00000087 "        $args{Bits} = $self->_round_bits_to_ge_32( $args{Bits} );"
NSQ_SOURCE_LINE 00000088 "        $args{Bits} = $self->_constrain_bits( $args{Bits}, SEED_MIN, SEED_MAX );"
NSQ_SOURCE_LINE 00000089 "    }"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "    return \\%args;"
NSQ_SOURCE_LINE 00000092 "}"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "# _build_args() helpers:"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "# Verify drop illegal or 'undef' args."
NSQ_SOURCE_LINE 00000098 "sub _validate_args {"
NSQ_SOURCE_LINE 00000099 "  my( $self, $legal_args_href, %args ) = @_;"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "  # Iterate through input args."
NSQ_SOURCE_LINE 00000102 "  while( my ( $arg_key, $arg_value ) = each %args ) {"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "    # Disqualify if not in white list."
NSQ_SOURCE_LINE 00000105 "    if( ! exists $legal_args_href->{$arg_key} ) {"
NSQ_SOURCE_LINE 00000106 "      carp \"Illegal argument ($arg_key) will be ignored.\";"
NSQ_SOURCE_LINE 00000107 "      delete $args{$arg_key};"
NSQ_SOURCE_LINE 00000108 "      next;"
NSQ_SOURCE_LINE 00000109 "    }"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "    # Disqualify if undef passed."
NSQ_SOURCE_LINE 00000112 "    if( ! defined $arg_value ) {"
NSQ_SOURCE_LINE 00000113 "      carp \"Undefined value specified for attribute ($arg_key). \""
NSQ_SOURCE_LINE 00000114 "           . \"Attribute will be ignored.\";"
NSQ_SOURCE_LINE 00000115 "      delete $args{$arg_key};"
NSQ_SOURCE_LINE 00000116 "    }"
NSQ_SOURCE_LINE 00000117 "  }"
NSQ_SOURCE_LINE 00000118 "  return %args;"
NSQ_SOURCE_LINE 00000119 "}"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "# Round bits parameter to nearest greater or equal 32-bit \"long\"."
NSQ_SOURCE_LINE 00000123 "sub _round_bits_to_ge_32 {"
NSQ_SOURCE_LINE 00000124 "  my( $self, $bits ) = @_;"
NSQ_SOURCE_LINE 00000125 "  my $remainder = $bits % 32;"
NSQ_SOURCE_LINE 00000126 "  return $bits if $remainder == 0;"
NSQ_SOURCE_LINE 00000127 "  carp \"Bits field must be a multiple of 32.  Rounding up.\";"
NSQ_SOURCE_LINE 00000128 "  return $bits + 32 - $remainder;"
NSQ_SOURCE_LINE 00000129 "}"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "# Constrain bits argument to a reasonable range."
NSQ_SOURCE_LINE 00000133 "sub _constrain_bits {"
NSQ_SOURCE_LINE 00000134 "  my( $self, $bits, $min, $max ) = @_;"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "  if( $bits < $min ) {"
NSQ_SOURCE_LINE 00000137 "    carp \"Bits field must be >= 64 (two longs). Rounding up.\";"
NSQ_SOURCE_LINE 00000138 "    $bits = $min;"
NSQ_SOURCE_LINE 00000139 "  }"
NSQ_SOURCE_LINE 00000140 "  elsif( $bits > $max ) {"
NSQ_SOURCE_LINE 00000141 "    carp \"Bits field must be <= 8192 (256 longs). Rounding down.\";"
NSQ_SOURCE_LINE 00000142 "    $bits = $max;"
NSQ_SOURCE_LINE 00000143 "  }"
NSQ_SOURCE_LINE 00000144 "  # No need for an 'else' here."
NSQ_SOURCE_LINE 00000145 "  "
NSQ_SOURCE_LINE 00000146 "  return $bits;"
NSQ_SOURCE_LINE 00000147 "}"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "# Build attributes set by new().  Any not explicitly set will use defaults"
NSQ_SOURCE_LINE 00000151 "# as described in the constant OO_ATTRIBS."
NSQ_SOURCE_LINE 00000152 "sub _build_attributes {"
NSQ_SOURCE_LINE 00000153 "    my ( $self, $args ) = @_;"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "    while ( my ( $arg, $default ) = each %{ OO_ATTRIBS() } ) {"
NSQ_SOURCE_LINE 00000156 "      $self->{$arg} = exists $args->{$arg} ? $args->{$arg} : $default;"
NSQ_SOURCE_LINE 00000157 "    }"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "    $self->{_RNG} = undef;    # Lazy initialization."
NSQ_SOURCE_LINE 00000160 "    return $self;"
NSQ_SOURCE_LINE 00000161 "}"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "# Get a seed and use it to instantiate a RNG."
NSQ_SOURCE_LINE 00000165 "# Note: Currently we specify only Math::Random::ISAAC.  However, the PRNG"
NSQ_SOURCE_LINE 00000166 "# object attribute may be used in the future to specify alternate RNG's."
NSQ_SOURCE_LINE 00000167 "sub _instantiate_rng {"
NSQ_SOURCE_LINE 00000168 "    my $self = shift;"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "    my ( %seed_opts ) = $self->_build_seed_options;"
NSQ_SOURCE_LINE 00000171 "    my @seeds = $self->_generate_seed( %seed_opts );"
NSQ_SOURCE_LINE 00000172 "    $self->{_RNG} = Math::Random::ISAAC->new(@seeds);"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "    return $self->{_RNG};"
NSQ_SOURCE_LINE 00000175 "}"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "# Set up seed options for Crypt::Random::Seed"
NSQ_SOURCE_LINE 00000179 "sub _build_seed_options {"
NSQ_SOURCE_LINE 00000180 "  my( $self ) = @_;"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "  my %crs_opts;"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "  # CRYPT_RANDOM_SEED_OPTS enumerates the options that Crypt::Random::Seed"
NSQ_SOURCE_LINE 00000185 "  # supports.  We have already built object attributes for those options."
NSQ_SOURCE_LINE 00000186 "  foreach my $opt ( @{ CRYPT_RANDOM_SEED_OPTS() } ) {"
NSQ_SOURCE_LINE 00000187 "      $crs_opts{$opt} = $self->{$opt} if defined $self->{$opt};"
NSQ_SOURCE_LINE 00000188 "  }"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "  return %crs_opts;"
NSQ_SOURCE_LINE 00000191 "}"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "# Use Crypt::Random::Seed to generate some high-quality long int"
NSQ_SOURCE_LINE 00000195 "# seeds for Math::Random::ISAAC."
NSQ_SOURCE_LINE 00000196 "sub _generate_seed {"
NSQ_SOURCE_LINE 00000197 "    my ( $self, %options_hash ) = @_;"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "    my $seed_size = $self->{Bits} / 32;"
NSQ_SOURCE_LINE 00000200 "    my $source = Crypt::Random::Seed->new(%options_hash);"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "    croak 'Unable to obtain a strong seed source from Crypt::Random::Seed.'"
NSQ_SOURCE_LINE 00000203 "      unless defined $source;"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "    return $source->random_values($seed_size); # List of unsigned longs."
NSQ_SOURCE_LINE 00000206 "}"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "# Validate that we are getting an integer >= 0."
NSQ_SOURCE_LINE 00000210 "# If not, throw an exception."
NSQ_SOURCE_LINE 00000211 "sub _validate_int {"
NSQ_SOURCE_LINE 00000212 "  my( $self, $input ) = @_;"
NSQ_SOURCE_LINE 00000213 "  croak \"Byte count must be a positive integer.\""
NSQ_SOURCE_LINE 00000214 "    unless    looks_like_number( $input )"
NSQ_SOURCE_LINE 00000215 "           && $input == int( $input )"
NSQ_SOURCE_LINE 00000216 "           && $input >= 0;"
NSQ_SOURCE_LINE 00000217 "  return 1;"
NSQ_SOURCE_LINE 00000218 "}"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "# Random bytes string."
NSQ_SOURCE_LINE 00000222 "sub bytes {"
NSQ_SOURCE_LINE 00000223 "  my( $self, $bytes ) = @_;"
NSQ_SOURCE_LINE 00000224 "  $bytes = defined $bytes ? $bytes : 0; # Default to zero bytes."
NSQ_SOURCE_LINE 00000225 "  $self->_validate_int( $bytes ); # Throws on violation."
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "  $self->_instantiate_rng unless defined $self->{_RNG};"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "  my $str = '';"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "  while ( $bytes >= 4 ) {                  # Utilize irand()'s 32 bits."
NSQ_SOURCE_LINE 00000232 "    $str .= pack( \"L\", $self->{_RNG}->irand );"
NSQ_SOURCE_LINE 00000233 "    $bytes -= 4;"
NSQ_SOURCE_LINE 00000234 "  }"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "  if ( $bytes > 0 ) {"
NSQ_SOURCE_LINE 00000237 "    my $rval = $self->{_RNG}->irand;"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "    $str .= pack( \"S\", ( $rval >> 8 ) & 0xFFFF )"
NSQ_SOURCE_LINE 00000240 "      if $bytes >= 2;                    # 16 bits."
NSQ_SOURCE_LINE 00000241 "    $str .= pack( \"C\", $rval & 0xFF ) if $bytes % 2;    # 8 bits."
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "  }"
NSQ_SOURCE_LINE 00000244 "  return $str;"
NSQ_SOURCE_LINE 00000245 "}"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "# Base64 encoding of random byte string."
NSQ_SOURCE_LINE 00000248 "sub bytes_base64 {"
NSQ_SOURCE_LINE 00000249 "  my ( $self, $bytes, $eol ) = @_;"
NSQ_SOURCE_LINE 00000250 "  return encode_base64( $self->bytes($bytes), defined($eol) ? $eol : qq{\\n} );"
NSQ_SOURCE_LINE 00000251 "}"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "# Hex digits representing random byte string (No whitespace, no '0x')."
NSQ_SOURCE_LINE 00000254 "sub bytes_hex {"
NSQ_SOURCE_LINE 00000255 "  my ( $self, $bytes ) = @_;"
NSQ_SOURCE_LINE 00000256 "  return unpack 'H*', $self->bytes($bytes);"
NSQ_SOURCE_LINE 00000257 "}"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "# Quoted Printable representation of random byte string."
NSQ_SOURCE_LINE 00000260 "sub bytes_qp {"
NSQ_SOURCE_LINE 00000261 "  my ( $self, $bytes, $eol ) = @_;"
NSQ_SOURCE_LINE 00000262 "  return encode_qp $self->bytes($bytes), defined($eol) ? $eol : qq{\\n}, 1;"
NSQ_SOURCE_LINE 00000263 "}"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "sub string_from {"
NSQ_SOURCE_LINE 00000267 "  my( $self, $bag, $bytes ) = @_;"
NSQ_SOURCE_LINE 00000268 "  $bag   = defined $bag   ? $bag   : '';"
NSQ_SOURCE_LINE 00000269 "  $bytes = defined $bytes ? $bytes : 0;"
NSQ_SOURCE_LINE 00000270 "  my $range = length $bag;"
NSQ_SOURCE_LINE 00000271 "  "
NSQ_SOURCE_LINE 00000272 "  $self->_validate_int( $bytes );"
NSQ_SOURCE_LINE 00000273 "  "
NSQ_SOURCE_LINE 00000274 "  croak \"Bag's size must be at least 1 character.\""
NSQ_SOURCE_LINE 00000275 "    if $range < 1;"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "  my $rand_bytes = q{};              # We need an empty (and defined) string."
NSQ_SOURCE_LINE 00000278 "  "
NSQ_SOURCE_LINE 00000279 "  for my $random ( $self->_ranged_randoms( $range, $bytes ) ) {"
NSQ_SOURCE_LINE 00000280 "      $rand_bytes .= substr( $bag, $random, 1 );"
NSQ_SOURCE_LINE 00000281 "  }"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "  return $rand_bytes;"
NSQ_SOURCE_LINE 00000284 "}"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "sub shuffle {"
NSQ_SOURCE_LINE 00000288 "    my($self, $aref) = @_;"
NSQ_SOURCE_LINE 00000289 "    croak 'Argument must be an array reference.' unless 'ARRAY' eq ref $aref;"
NSQ_SOURCE_LINE 00000290 "    return $aref unless @$aref;"
NSQ_SOURCE_LINE 00000291 "    for (my $i = @$aref; --$i;) {"
NSQ_SOURCE_LINE 00000292 "        my $r = ($self->_ranged_randoms($i+1, 1))[0];"
NSQ_SOURCE_LINE 00000293 "        ($aref->[$i],$aref->[$r]) = ($aref->[$r], $aref->[$i]);"
NSQ_SOURCE_LINE 00000294 "    }"
NSQ_SOURCE_LINE 00000295 "    return $aref;"
NSQ_SOURCE_LINE 00000296 "}"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "# Helpers for string_from() and shuffle."
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "sub _ranged_randoms {"
NSQ_SOURCE_LINE 00000301 "    my ( $self, $range, $count ) = @_;"
NSQ_SOURCE_LINE 00000302 "    $count = defined $count ? $count : 0;"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "    # Lazily seed the RNG so we don't waste available strong entropy."
NSQ_SOURCE_LINE 00000305 "    $self->_instantiate_rng unless defined $self->{_RNG};"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "    my $divisor = $self->_closest_divisor($range);"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "    my @randoms;"
NSQ_SOURCE_LINE 00000310 "    "
NSQ_SOURCE_LINE 00000311 "    $#randoms = $count - 1;  # Pre-extend the @randoms array so 'push' avoids"
NSQ_SOURCE_LINE 00000312 "                             # copy on resize."
NSQ_SOURCE_LINE 00000313 "    @randoms = ();           # Then purge it, but its memory won't be released."
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "    for my $n ( 1 .. $count ) {"
NSQ_SOURCE_LINE 00000316 "        my $random;"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "        # The loop rolls, and re-rolls if the random number is out of the bag's"
NSQ_SOURCE_LINE 00000319 "        # range.  This is to avoid a solution that would introduce modulo bias."
NSQ_SOURCE_LINE 00000320 "        do {"
NSQ_SOURCE_LINE 00000321 "            $random = $self->{_RNG}->irand % $divisor;"
NSQ_SOURCE_LINE 00000322 "        } while ( $random >= $range );"
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "        push @randoms, $random;"
NSQ_SOURCE_LINE 00000325 "    }"
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "    return @randoms;"
NSQ_SOURCE_LINE 00000328 "}"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "# Find nearest factor of 2**32 >= $range."
NSQ_SOURCE_LINE 00000332 ""
NSQ_SOURCE_LINE 00000333 "sub _closest_divisor {"
NSQ_SOURCE_LINE 00000334 "    my ( $self, $range ) = @_;"
NSQ_SOURCE_LINE 00000335 "    $range = defined $range ? $range : 0;"
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "    croak \"$range must be positive.\" if $range < 0;"
NSQ_SOURCE_LINE 00000338 "    croak \"$range exceeds irand max limit of 2**32.\" if $range > 2**32;"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "    my $n = 0;"
NSQ_SOURCE_LINE 00000341 "    my $d;"
NSQ_SOURCE_LINE 00000342 "    while ( $n <= 32 ) {"
NSQ_SOURCE_LINE 00000343 "        $d = 2 ** $n++;"
NSQ_SOURCE_LINE 00000344 "        last if $d >= $range;"
NSQ_SOURCE_LINE 00000345 "    }"
NSQ_SOURCE_LINE 00000346 "    "
NSQ_SOURCE_LINE 00000347 "     return $d;"
NSQ_SOURCE_LINE 00000348 "}"
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "# irand, so that people who don't need \"bytes\" can enjoy B::R::S's convenience"
NSQ_SOURCE_LINE 00000353 "# without jumping through \"unpack\" hoops. (A suggestion from Dana Jacobsen.)"
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 "sub irand {"
NSQ_SOURCE_LINE 00000356 "  my( $self ) = @_;"
NSQ_SOURCE_LINE 00000357 "  $self->_instantiate_rng unless defined $self->{_RNG};"
NSQ_SOURCE_LINE 00000358 "  return $self->{_RNG}->irand;"
NSQ_SOURCE_LINE 00000359 "}"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 ""
NSQ_SOURCE_LINE 00000362 "################################################################################"
NSQ_SOURCE_LINE 00000363 "##  Functions interface                                                       ##"
NSQ_SOURCE_LINE 00000364 "################################################################################"
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "# Instantiate our random number generator(s) inside of a lexical closure,"
NSQ_SOURCE_LINE 00000367 "# limiting the scope of the RNG object so it can't be tampered with."
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "{"
NSQ_SOURCE_LINE 00000370 "  my $RNG_object = undef;"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "  # Lazily, instantiate the RNG object, but only once."
NSQ_SOURCE_LINE 00000374 "  my $fetch_RNG = sub {"
NSQ_SOURCE_LINE 00000375 "    $RNG_object = Bytes::Random::Secure->new( FUNC_STD )"
NSQ_SOURCE_LINE 00000376 "      unless defined $RNG_object;"
NSQ_SOURCE_LINE 00000377 "    return $RNG_object;"
NSQ_SOURCE_LINE 00000378 "  };"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "  sub random_bytes {"
NSQ_SOURCE_LINE 00000382 "    return $fetch_RNG->()->bytes( @_ );"
NSQ_SOURCE_LINE 00000383 "  }"
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 ""
NSQ_SOURCE_LINE 00000386 "  sub random_string_from {"
NSQ_SOURCE_LINE 00000387 "    return $fetch_RNG->()->string_from( @_ );"
NSQ_SOURCE_LINE 00000388 "  }"
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "}"
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "# Base64 encoded random bytes functions"
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "sub random_bytes_base64 {"
NSQ_SOURCE_LINE 00000396 "  my ( $bytes, $eof ) = @_;"
NSQ_SOURCE_LINE 00000397 "  return encode_base64 random_bytes($bytes), defined($eof) ? $eof : qq{\\n};"
NSQ_SOURCE_LINE 00000398 "}"
NSQ_SOURCE_LINE 00000399 ""
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "# Hex digit encoded random bytes"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "sub random_bytes_hex {"
NSQ_SOURCE_LINE 00000404 "  return unpack 'H*', random_bytes( shift );"
NSQ_SOURCE_LINE 00000405 "}"
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 ""
NSQ_SOURCE_LINE 00000408 "# Quoted Printable encoded random bytes"
NSQ_SOURCE_LINE 00000409 ""
NSQ_SOURCE_LINE 00000410 "sub random_bytes_qp {"
NSQ_SOURCE_LINE 00000411 "  my ( $bytes, $eof ) = @_;"
NSQ_SOURCE_LINE 00000412 "  return encode_qp random_bytes($bytes), defined($eof) ? $eof : qq{\\n}, 1;"
NSQ_SOURCE_LINE 00000413 "}"
NSQ_SOURCE_LINE 00000414 ""
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "1;"
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 "=pod"
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "=head1 NAME"
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "Bytes::Random::Secure - Perl extension to generate cryptographically-secure"
NSQ_SOURCE_LINE 00000423 "random bytes."
NSQ_SOURCE_LINE 00000424 ""
NSQ_SOURCE_LINE 00000425 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "    use Bytes::Random::Secure qw("
NSQ_SOURCE_LINE 00000429 "        random_bytes random_bytes_base64 random_bytes_hex"
NSQ_SOURCE_LINE 00000430 "    );"
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 "    my $bytes = random_bytes(32); # A string of 32 random bytes."
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 "    my $bytes = random_string_from( 'abcde', 10 ); # 10 random a,b,c,d, and e's."
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 "    my $bytes_as_base64 = random_bytes_base64(57); # Base64 encoded rand bytes."
NSQ_SOURCE_LINE 00000437 ""
NSQ_SOURCE_LINE 00000438 "    my $bytes_as_hex = random_bytes_hex(8); # Eight random bytes as hex digits."
NSQ_SOURCE_LINE 00000439 ""
NSQ_SOURCE_LINE 00000440 "    my $bytes_as_quoted_printable = random_bytes_qp(100); # QP encoded bytes."
NSQ_SOURCE_LINE 00000441 ""
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "    my $random = Bytes::Random::Secure->new("
NSQ_SOURCE_LINE 00000444 "        Bits        => 64,"
NSQ_SOURCE_LINE 00000445 "        NonBlocking => 1,"
NSQ_SOURCE_LINE 00000446 "    ); # Seed with 64 bits, and use /dev/urandom (or other non-blocking)."
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 "    my $bytes = $random->bytes(32); # A string of 32 random bytes."
NSQ_SOURCE_LINE 00000449 "    my $long  = $random->irand;     # 32-bit random integer."
NSQ_SOURCE_LINE 00000450 ""
NSQ_SOURCE_LINE 00000451 ""
NSQ_SOURCE_LINE 00000452 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000453 ""
NSQ_SOURCE_LINE 00000454 "L<Bytes::Random::Secure> provides two interfaces for obtaining crypto-quality"
NSQ_SOURCE_LINE 00000455 "random bytes.  The simple interface is built around plain functions.  For"
NSQ_SOURCE_LINE 00000456 "greater control over the Random Number Generator's seeding, there is an Object"
NSQ_SOURCE_LINE 00000457 "Oriented interface that provides much more flexibility."
NSQ_SOURCE_LINE 00000458 ""
NSQ_SOURCE_LINE 00000459 "The \"functions\" interface provides functions that can be used any time you need"
NSQ_SOURCE_LINE 00000460 "a string of a specific number of random bytes.  The random bytes are available"
NSQ_SOURCE_LINE 00000461 "as simple strings, or as hex-digits, Quoted Printable, or MIME Base64.  There"
NSQ_SOURCE_LINE 00000462 "are equivalent methods available from the OO interface, plus a few others."
NSQ_SOURCE_LINE 00000463 ""
NSQ_SOURCE_LINE 00000464 "This module can be a drop-in replacement for L<Bytes::Random>, with the primary"
NSQ_SOURCE_LINE 00000465 "enhancement of using a cryptographic-quality random number generator to create"
NSQ_SOURCE_LINE 00000466 "the random data.  The C<random_bytes> function emulates the user interface of"
NSQ_SOURCE_LINE 00000467 "L<Bytes::Random>'s function by the same name.  But with Bytes::Random::Secure"
NSQ_SOURCE_LINE 00000468 "the random number generator comes from L<Math::Random::ISAAC>, and is suitable"
NSQ_SOURCE_LINE 00000469 "for cryptographic purposes.  The harder problem to solve is how to seed the"
NSQ_SOURCE_LINE 00000470 "generator.  This module uses L<Crypt::Random::Seed> to generate the initial"
NSQ_SOURCE_LINE 00000471 "seeds for Math::Random::ISAAC."
NSQ_SOURCE_LINE 00000472 ""
NSQ_SOURCE_LINE 00000473 "In addition to providing C<random_bytes()>, this module also provides several"
NSQ_SOURCE_LINE 00000474 "functions not found in L<Bytes::Random>: C<random_string_from>,"
NSQ_SOURCE_LINE 00000475 "C<random_bytes_base64()>, C<random_bytes_hex>, and C<random_bytes_qp>."
NSQ_SOURCE_LINE 00000476 ""
NSQ_SOURCE_LINE 00000477 "And finally, for those who need finer control over how L<Crypt::Random::Seed>"
NSQ_SOURCE_LINE 00000478 "generates its seed, there is an object oriented interface with a constructor"
NSQ_SOURCE_LINE 00000479 "that facilitates configuring the seeding process, while providing methods that"
NSQ_SOURCE_LINE 00000480 "do everything the \"functions\" interface can do (truth be told, the functions"
NSQ_SOURCE_LINE 00000481 "interface is just a thin wrapper around the OO version, with some sane defaults"
NSQ_SOURCE_LINE 00000482 "selected).  The OO interface also provides an C<irand> method, not available"
NSQ_SOURCE_LINE 00000483 "through the functions interface."
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "=head1 RATIONALE"
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "There are many uses for cryptographic quality randomness.  This module aims to"
NSQ_SOURCE_LINE 00000488 "provide a generalized tool that can fit into many applications while providing"
NSQ_SOURCE_LINE 00000489 "a minimal dependency chain, and a user interface that is simple.  You're free"
NSQ_SOURCE_LINE 00000490 "to come up with your own use-cases, but there are several obvious ones:"
NSQ_SOURCE_LINE 00000491 ""
NSQ_SOURCE_LINE 00000492 "=over 4"
NSQ_SOURCE_LINE 00000493 ""
NSQ_SOURCE_LINE 00000494 "=item * Creating temporary passphrases (C<random_string_from()>)."
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "=item * Generating per-account random salt to be hashed along with passphrases "
NSQ_SOURCE_LINE 00000497 "(and stored alongside them) to prevent rainbow table attacks."
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "=item * Generating a secret that can be hashed along with a cookie's session"
NSQ_SOURCE_LINE 00000500 "content to prevent cookie forgeries."
NSQ_SOURCE_LINE 00000501 ""
NSQ_SOURCE_LINE 00000502 "=item * Building raw cryptographic-quality pseudo-random data sets for testing"
NSQ_SOURCE_LINE 00000503 "or sampling."
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "=item * Feeding secure key-gen utilities."
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "=back"
NSQ_SOURCE_LINE 00000508 ""
NSQ_SOURCE_LINE 00000509 "Why use this module?  This module employs several well-designed CPAN tools to"
NSQ_SOURCE_LINE 00000510 "first generate a strong random seed, and then to instantiate a high quality"
NSQ_SOURCE_LINE 00000511 "random number generator based on the seed.  The code in this module really"
NSQ_SOURCE_LINE 00000512 "just glues together the building blocks.  However, it has taken a good deal of"
NSQ_SOURCE_LINE 00000513 "research to come up with what I feel is a strong tool-chain that isn't going to"
NSQ_SOURCE_LINE 00000514 "fall back to a weak state on some systems.  The interface is designed with"
NSQ_SOURCE_LINE 00000515 "simplicity in mind, to minimize the potential for misconfiguration."
NSQ_SOURCE_LINE 00000516 ""
NSQ_SOURCE_LINE 00000517 "=head1 EXPORTS"
NSQ_SOURCE_LINE 00000518 ""
NSQ_SOURCE_LINE 00000519 "By default C<random_bytes> is the only function exported.  Optionally"
NSQ_SOURCE_LINE 00000520 "C<random_string_from>, C<random_bytes_base64>, C<random_bytes_hex>,"
NSQ_SOURCE_LINE 00000521 "and C<random_bytes_qp> may be exported."
NSQ_SOURCE_LINE 00000522 ""
NSQ_SOURCE_LINE 00000523 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000524 ""
NSQ_SOURCE_LINE 00000525 "The B<functions interface> seeds the ISAAC generator on first use with a 256 bit"
NSQ_SOURCE_LINE 00000526 "seed that uses Crypt::Random::Seed's default configuration as a strong random"
NSQ_SOURCE_LINE 00000527 "seed source."
NSQ_SOURCE_LINE 00000528 ""
NSQ_SOURCE_LINE 00000529 "=head2 random_bytes"
NSQ_SOURCE_LINE 00000530 ""
NSQ_SOURCE_LINE 00000531 "    my $random_bytes = random_bytes( 512 );"
NSQ_SOURCE_LINE 00000532 "    "
NSQ_SOURCE_LINE 00000533 "Returns a string containing as many random bytes as requested.  Obviously the"
NSQ_SOURCE_LINE 00000534 "string isn't useful for display, as it can contain any byte value from 0 through"
NSQ_SOURCE_LINE 00000535 "255."
NSQ_SOURCE_LINE 00000536 ""
NSQ_SOURCE_LINE 00000537 "The parameter is a byte-count, and must be an integer greater or equal to zero."
NSQ_SOURCE_LINE 00000538 ""
NSQ_SOURCE_LINE 00000539 "=head2 random_string_from"
NSQ_SOURCE_LINE 00000540 ""
NSQ_SOURCE_LINE 00000541 "    my $random_bytes = random_string_from( $bag, $length );"
NSQ_SOURCE_LINE 00000542 "    my $random_bytes = random_string_from( 'abc', 50 );"
NSQ_SOURCE_LINE 00000543 ""
NSQ_SOURCE_LINE 00000544 "C<$bag> is a string of characters from which C<random_string_from> may choose in"
NSQ_SOURCE_LINE 00000545 "building a random string.  We call it a 'bag', because it's permissible to have"
NSQ_SOURCE_LINE 00000546 "repeated chars in the bag (if not, we could call it a set).  Repeated digits"
NSQ_SOURCE_LINE 00000547 "get more weight.  For example, C<random_string_from( 'aab', 1 )> would have a"
NSQ_SOURCE_LINE 00000548 "66.67% chance of returning an 'a', and a 33.33% chance of returning a 'b'.  For"
NSQ_SOURCE_LINE 00000549 "unweighted distribution, ensure there are no duplicates in C<$bag>."
NSQ_SOURCE_LINE 00000550 ""
NSQ_SOURCE_LINE 00000551 "This I<isn't> a \"draw and discard\", or a permutation algorithm; each character"
NSQ_SOURCE_LINE 00000552 "selected is independent of previous or subsequent selections; duplicate"
NSQ_SOURCE_LINE 00000553 "selections are possible by design. "
NSQ_SOURCE_LINE 00000554 ""
NSQ_SOURCE_LINE 00000555 "Return value is a string of size C<$length>, of characters chosen at random"
NSQ_SOURCE_LINE 00000556 "from the 'bag' string."
NSQ_SOURCE_LINE 00000557 ""
NSQ_SOURCE_LINE 00000558 "It is perfectly legal to pass a Unicode string as the \"bag\", and in that case,"
NSQ_SOURCE_LINE 00000559 "the yield will include Unicode characters selected from those passed in via the"
NSQ_SOURCE_LINE 00000560 "bag string."
NSQ_SOURCE_LINE 00000561 ""
NSQ_SOURCE_LINE 00000562 "This function is useful for random string generation such as temporary"
NSQ_SOURCE_LINE 00000563 "random passwords."
NSQ_SOURCE_LINE 00000564 ""
NSQ_SOURCE_LINE 00000565 "=head2 random_bytes_base64"
NSQ_SOURCE_LINE 00000566 ""
NSQ_SOURCE_LINE 00000567 "    my $random_bytes_b64           = random_bytes_base64( $num_bytes );"
NSQ_SOURCE_LINE 00000568 "    my $random_bytes_b64_formatted = random_bytes_base64( $num_bytes, $eol );"
NSQ_SOURCE_LINE 00000569 ""
NSQ_SOURCE_LINE 00000570 "Returns a MIME Base64 encoding of a string of $number_of_bytes random bytes."
NSQ_SOURCE_LINE 00000571 "Note, it should be obvious, but is worth mentioning that a base64 encoding of"
NSQ_SOURCE_LINE 00000572 "base256 data requires more digits to represent the bytes requested.  The actual"
NSQ_SOURCE_LINE 00000573 "number of digits required, including padding is C<4(n/3)>."
NSQ_SOURCE_LINE 00000574 "Furthermore, the Base64 standard is to add padding to the end of any string for"
NSQ_SOURCE_LINE 00000575 "which C<length % 57> is a non-zero value."
NSQ_SOURCE_LINE 00000576 ""
NSQ_SOURCE_LINE 00000577 "If an C<$eol> is specified, the character(s) specified will be used as line"
NSQ_SOURCE_LINE 00000578 "delimiters after every 76th character.  The default is C<qq{\\n}>.  If you wish"
NSQ_SOURCE_LINE 00000579 "to eliminate line-break insertions, specify an empty string: C<q{}>."
NSQ_SOURCE_LINE 00000580 ""
NSQ_SOURCE_LINE 00000581 "=head2 random_bytes_hex"
NSQ_SOURCE_LINE 00000582 ""
NSQ_SOURCE_LINE 00000583 "    my $random_bytes_as_hex = random_bytes_hex( $num_bytes );"
NSQ_SOURCE_LINE 00000584 ""
NSQ_SOURCE_LINE 00000585 "Returns a string of hex digits representing the string of $number_of_bytes"
NSQ_SOURCE_LINE 00000586 "random bytes."
NSQ_SOURCE_LINE 00000587 ""
NSQ_SOURCE_LINE 00000588 "It's worth mentioning that a hex (base16) representation of base256 data"
NSQ_SOURCE_LINE 00000589 "requires two digits for every byte requested. So"
NSQ_SOURCE_LINE 00000590 "C<length( random_bytes_hex( 16 ) )> will return 32, as it takes 32 hex digits to"
NSQ_SOURCE_LINE 00000591 "represent 16 bytes.  Simple stuff, but better to mention it now than forget and"
NSQ_SOURCE_LINE 00000592 "set a database field that's too narrow."
NSQ_SOURCE_LINE 00000593 ""
NSQ_SOURCE_LINE 00000594 "=head2 random_bytes_qp"
NSQ_SOURCE_LINE 00000595 ""
NSQ_SOURCE_LINE 00000596 "    my $random_bytes_qp           = random_bytes_qp( $num_bytes );"
NSQ_SOURCE_LINE 00000597 "    my $random_bytes_qp_formatted = random_bytes_qp( $num_bytes, $eol );"
NSQ_SOURCE_LINE 00000598 ""
NSQ_SOURCE_LINE 00000599 "Produces a string of C<$num_bytes> random bytes, using MIME Quoted Printable"
NSQ_SOURCE_LINE 00000600 "encoding (as produced by L<MIME::QuotedPrint>'s C<encode_qp> function.  The"
NSQ_SOURCE_LINE 00000601 "default configuration uses C<\\n> as a line break after every 76 characters, and"
NSQ_SOURCE_LINE 00000602 "the \"binmode\" setting is used to guarantee a lossless round trip.  If no line"
NSQ_SOURCE_LINE 00000603 "break is wanted, pass an empty string as C<$eol>."
NSQ_SOURCE_LINE 00000604 ""
NSQ_SOURCE_LINE 00000605 "=head1 METHODS"
NSQ_SOURCE_LINE 00000606 ""
NSQ_SOURCE_LINE 00000607 "The B<Object Oriented interface> provides methods that mirror the \"functions\""
NSQ_SOURCE_LINE 00000608 "interface.  However, the OO interface offers the advantage that the user can"
NSQ_SOURCE_LINE 00000609 "control how many bits of entropy are used in seeding, and even how"
NSQ_SOURCE_LINE 00000610 "L<Crypt::Random::Seed> is configured."
NSQ_SOURCE_LINE 00000611 ""
NSQ_SOURCE_LINE 00000612 "=head2 new"
NSQ_SOURCE_LINE 00000613 ""
NSQ_SOURCE_LINE 00000614 "    my $random = Bytes::Random::Secure->new( Bits => 512 );"
NSQ_SOURCE_LINE 00000615 "    my $bytes  = $random->bytes( 32 );"
NSQ_SOURCE_LINE 00000616 ""
NSQ_SOURCE_LINE 00000617 "The constructor is used to specify how the ISAAC generator is seeded.  Future"
NSQ_SOURCE_LINE 00000618 "versions may also allow for alternate CSPRNGs to be selected.  If no parameters"
NSQ_SOURCE_LINE 00000619 "are passed the default configuration specifies 256 bits for the seed.  The rest"
NSQ_SOURCE_LINE 00000620 "of the default configuration accepts the L<Crypt::Random::Seed> defaults, which"
NSQ_SOURCE_LINE 00000621 "favor the strongest operating system provided entropy source, which in many"
NSQ_SOURCE_LINE 00000622 "cases may be \"blocking\"."
NSQ_SOURCE_LINE 00000623 ""
NSQ_SOURCE_LINE 00000624 "=head3 CONSTRUCTOR PARAMETERS"
NSQ_SOURCE_LINE 00000625 ""
NSQ_SOURCE_LINE 00000626 "=head4 Bits"
NSQ_SOURCE_LINE 00000627 ""
NSQ_SOURCE_LINE 00000628 "    my $random = Bytes::Random::Secure->new( Bits => 128 );"
NSQ_SOURCE_LINE 00000629 "    "
NSQ_SOURCE_LINE 00000630 "The C<Bits> parameter specifies how many bits (rounded up to nearest multiple of"
NSQ_SOURCE_LINE 00000631 "32) will be used in seeding the ISAAC random number generator.  The default is"
NSQ_SOURCE_LINE 00000632 "256 bits of entropy.  But in some cases it may not be necessary, or even wise to"
NSQ_SOURCE_LINE 00000633 "pull so many bits of entropy out of C</dev/random> (a blocking source)."
NSQ_SOURCE_LINE 00000634 ""
NSQ_SOURCE_LINE 00000635 "Any value between 64 and 8192 will be accepted. If an out-of-range value is"
NSQ_SOURCE_LINE 00000636 "specified, or a value that is not a multiple of 32, a warning will be generated"
NSQ_SOURCE_LINE 00000637 "and the parameter will be rounded up to the nearest multiple of 32 within the"
NSQ_SOURCE_LINE 00000638 "range of 64 through 8192 bits.  So if 16384 is specified, you will get 8192.  If"
NSQ_SOURCE_LINE 00000639 "33 is specified, you will get 64.  "
NSQ_SOURCE_LINE 00000640 ""
NSQ_SOURCE_LINE 00000641 "B<Note:> In the Perlish spirit of \"I<no arbitrary limits>\", the maximum number"
NSQ_SOURCE_LINE 00000642 "of bits this module accepts is 8192, which is the maximum number that ISAAC can"
NSQ_SOURCE_LINE 00000643 "utilize.  But just because you I<can> specify a seed of 8192 bits doesn't mean"
NSQ_SOURCE_LINE 00000644 "you ought to, much less need to.  And if you do, you probably want to use the"
NSQ_SOURCE_LINE 00000645 "C<NonBlocking> option, discussed below.  8192 bits is a lot to ask from a"
NSQ_SOURCE_LINE 00000646 "blocking source such as C</dev/random>, and really anything beyond 512 bits in"
NSQ_SOURCE_LINE 00000647 "the seed is probably wasteful."
NSQ_SOURCE_LINE 00000648 ""
NSQ_SOURCE_LINE 00000649 ""
NSQ_SOURCE_LINE 00000650 "=head4 PRNG"
NSQ_SOURCE_LINE 00000651 ""
NSQ_SOURCE_LINE 00000652 "Reserved for future use.  Eventually the user will be able to select other RNGs"
NSQ_SOURCE_LINE 00000653 "aside from Math::Random::ISAAC."
NSQ_SOURCE_LINE 00000654 ""
NSQ_SOURCE_LINE 00000655 "=head4 Unique"
NSQ_SOURCE_LINE 00000656 ""
NSQ_SOURCE_LINE 00000657 "Reserved for future use."
NSQ_SOURCE_LINE 00000658 ""
NSQ_SOURCE_LINE 00000659 "=head4 Other Crypt::Random::Seed Configuration Parameters"
NSQ_SOURCE_LINE 00000660 ""
NSQ_SOURCE_LINE 00000661 "For additional seeding control, refer to the POD for L<Crypt::Random::Seed>."
NSQ_SOURCE_LINE 00000662 "By supplying a Crypt::Random::Seed parameter to Bytes::Random::Secure's"
NSQ_SOURCE_LINE 00000663 "constructor, it will be passed through to Crypt::Random::Seed.  For example:"
NSQ_SOURCE_LINE 00000664 ""
NSQ_SOURCE_LINE 00000665 "    my $random = Bytes::Random::Secure->new( NonBlocking => 1, Bits => 64 );"
NSQ_SOURCE_LINE 00000666 ""
NSQ_SOURCE_LINE 00000667 "In this example, C<Bits> is used internally, while C<NonBlocking> is passed"
NSQ_SOURCE_LINE 00000668 "through to Crypt::Random::Seed."
NSQ_SOURCE_LINE 00000669 ""
NSQ_SOURCE_LINE 00000670 ""
NSQ_SOURCE_LINE 00000671 "=head2 bytes"
NSQ_SOURCE_LINE 00000672 ""
NSQ_SOURCE_LINE 00000673 "    my $random_bytes = $random->bytes(1024);"
NSQ_SOURCE_LINE 00000674 ""
NSQ_SOURCE_LINE 00000675 "This works just like the C<random_bytes> function."
NSQ_SOURCE_LINE 00000676 ""
NSQ_SOURCE_LINE 00000677 ""
NSQ_SOURCE_LINE 00000678 "=head2 string_from"
NSQ_SOURCE_LINE 00000679 ""
NSQ_SOURCE_LINE 00000680 "    my $random_string = $random->string_from( 'abcdefg', 10 );"
NSQ_SOURCE_LINE 00000681 ""
NSQ_SOURCE_LINE 00000682 "Just like C<random_string_from>: Returns a string of random octets selected"
NSQ_SOURCE_LINE 00000683 "from the \"Bag\" string (in this case ten octets from 'abcdefg')."
NSQ_SOURCE_LINE 00000684 ""
NSQ_SOURCE_LINE 00000685 ""
NSQ_SOURCE_LINE 00000686 "=head2 bytes_hex"
NSQ_SOURCE_LINE 00000687 ""
NSQ_SOURCE_LINE 00000688 "    my $random_hex = $random->bytes_hex(12);"
NSQ_SOURCE_LINE 00000689 ""
NSQ_SOURCE_LINE 00000690 "Identical in function to C<random_bytes_hex>."
NSQ_SOURCE_LINE 00000691 ""
NSQ_SOURCE_LINE 00000692 ""
NSQ_SOURCE_LINE 00000693 "=head2 bytes_base64"
NSQ_SOURCE_LINE 00000694 ""
NSQ_SOURCE_LINE 00000695 "    my $random_base64 = $random->bytes_base64( 32, EOL => \"\\n\" );"
NSQ_SOURCE_LINE 00000696 ""
NSQ_SOURCE_LINE 00000697 "Identical in function to C<random_bytes_base64>."
NSQ_SOURCE_LINE 00000698 ""
NSQ_SOURCE_LINE 00000699 ""
NSQ_SOURCE_LINE 00000700 "=head2 bytes_qp"
NSQ_SOURCE_LINE 00000701 ""
NSQ_SOURCE_LINE 00000702 "    my $random_qp = $random->bytes_qp( 80 );"
NSQ_SOURCE_LINE 00000703 ""
NSQ_SOURCE_LINE 00000704 "You guessed it: Identical in function to C<random_bytes_qp>."
NSQ_SOURCE_LINE 00000705 ""
NSQ_SOURCE_LINE 00000706 ""
NSQ_SOURCE_LINE 00000707 "=head2 irand"
NSQ_SOURCE_LINE 00000708 ""
NSQ_SOURCE_LINE 00000709 "    my $unsigned_long = $random->irand;"
NSQ_SOURCE_LINE 00000710 ""
NSQ_SOURCE_LINE 00000711 "Returns a random 32-bit unsigned integer.  The value will satisfy"
NSQ_SOURCE_LINE 00000712 "C<< 0 <= x <= 2**32-1 >>.  This functionality is only available through the OO"
NSQ_SOURCE_LINE 00000713 "interface."
NSQ_SOURCE_LINE 00000714 ""
NSQ_SOURCE_LINE 00000715 "=head2 shuffle"
NSQ_SOURCE_LINE 00000716 ""
NSQ_SOURCE_LINE 00000717 "    my $aref_shuffled = $random->shuffle($aref);"
NSQ_SOURCE_LINE 00000718 ""
NSQ_SOURCE_LINE 00000719 "Shuffles the contents of a reference to an array in sitiu, and returns"
NSQ_SOURCE_LINE 00000720 "the same reference."
NSQ_SOURCE_LINE 00000721 ""
NSQ_SOURCE_LINE 00000722 "L<List::Util>, which ships with Perl, includes C<shuffle> function. But that"
NSQ_SOURCE_LINE 00000723 "function is flawed in two ways. First, from a cryptographic standpoint,"
NSQ_SOURCE_LINE 00000724 "it uses Perl's C<rand>, which is not a CSPRNG, and therefore is inadequate."
NSQ_SOURCE_LINE 00000725 ""
NSQ_SOURCE_LINE 00000726 "Second, because Perl's rand has an internal state of just 32 bits, it cannot"
NSQ_SOURCE_LINE 00000727 "possibly generate all permutations of arrays containing 13 or more elements."
NSQ_SOURCE_LINE 00000728 ""
NSQ_SOURCE_LINE 00000729 "This module's C<shuffle> uses a CSPRNG, and also benefits from large seeds"
NSQ_SOURCE_LINE 00000730 "and a huge internal state. ISAAC can be seeded with up to 8192 bits, yielding"
NSQ_SOURCE_LINE 00000731 "2^8192 possible initial states, and 2^8288 possible internal states. A seed of"
NSQ_SOURCE_LINE 00000732 "8192 bits will assure that for arrays of up to 966 elements every permutation"
NSQ_SOURCE_LINE 00000733 "is accessible."
NSQ_SOURCE_LINE 00000734 ""
NSQ_SOURCE_LINE 00000735 "=head1 CONFIGURATION"
NSQ_SOURCE_LINE 00000736 ""
NSQ_SOURCE_LINE 00000737 "L<Bytes::Random::Secure>'s interface tries to I<keep it simple>.  There is"
NSQ_SOURCE_LINE 00000738 "generally nothing to configure.  This design, eliminates much of the  potential"
NSQ_SOURCE_LINE 00000739 "for diminishing the quality of the random byte stream through misconfiguration."
NSQ_SOURCE_LINE 00000740 "The ISAAC algorithm is used as our factory, seeded with a strong source."
NSQ_SOURCE_LINE 00000741 ""
NSQ_SOURCE_LINE 00000742 "There may be times when the default seed characteristics carry too heavy a"
NSQ_SOURCE_LINE 00000743 "burden on system resources.  The default seed for the functions interface is"
NSQ_SOURCE_LINE 00000744 "256 bits of entropy taken from /dev/random (a blocking source on many systems),"
NSQ_SOURCE_LINE 00000745 "or via API calls on Windows.  The default seed size for the OO interface is also"
NSQ_SOURCE_LINE 00000746 "256 bits. If /dev/random should become depleted at the time that this module"
NSQ_SOURCE_LINE 00000747 "attempts to seed the ISAAC generator, there could be delay while additional"
NSQ_SOURCE_LINE 00000748 "system entropy is generated.  If this is a problem, it is possible to override"
NSQ_SOURCE_LINE 00000749 "the default seeding characteristics using the OO interface instead of the"
NSQ_SOURCE_LINE 00000750 "functions interface.  However, under most circumstances, this capability may be"
NSQ_SOURCE_LINE 00000751 "safely ignored."
NSQ_SOURCE_LINE 00000752 ""
NSQ_SOURCE_LINE 00000753 "Beginning with Bytes::Random::Secure version 0.20, L<Crypt::Random::Seed>"
NSQ_SOURCE_LINE 00000754 "provides our strong seed (previously it was Crypt::Random::Source).  This module"
NSQ_SOURCE_LINE 00000755 "gives us excellent \"strong source\" failsafe behavior, while keeping the"
NSQ_SOURCE_LINE 00000756 "non-core dependencies to a bare minimum.  Best of all, it performs well across"
NSQ_SOURCE_LINE 00000757 "a wide variety of platforms, and is compatible with Perl versions back through"
NSQ_SOURCE_LINE 00000758 "5.6.0."
NSQ_SOURCE_LINE 00000759 ""
NSQ_SOURCE_LINE 00000760 "And as mentioned earlier in this document, there may be circumstances where"
NSQ_SOURCE_LINE 00000761 "the performance of the operating system's strong random source is prohibitive"
NSQ_SOURCE_LINE 00000762 "from using the module's default seeding configuration.  Use the OO interface"
NSQ_SOURCE_LINE 00000763 "instead, and read the documentation for L<Crypt::Random::Seed> to learn what"
NSQ_SOURCE_LINE 00000764 "options are available."
NSQ_SOURCE_LINE 00000765 ""
NSQ_SOURCE_LINE 00000766 "Prior to version 0.20, a heavy dependency chain was required for reliably"
NSQ_SOURCE_LINE 00000767 "and securely seeding the ISAAC generator.  Earlier versions required"
NSQ_SOURCE_LINE 00000768 "L<Crypt::Random::Source>, which in turn required L<Any::Moose>.  Thanks to Dana"
NSQ_SOURCE_LINE 00000769 "Jacobsen's new Crypt::Random::Seed module, this situation has been resolved."
NSQ_SOURCE_LINE 00000770 "So if you're looking for a secure random bytes solution that \"just works\""
NSQ_SOURCE_LINE 00000771 "portably, and on Perl versions as far back as 5.6.0, you've come to the right"
NSQ_SOURCE_LINE 00000772 "place.  Users of older versions of this module are encouraged to update to"
NSQ_SOURCE_LINE 00000773 "version 0.20 or higher to benefit from the improved user interface and lighter"
NSQ_SOURCE_LINE 00000774 "dependency chain."
NSQ_SOURCE_LINE 00000775 ""
NSQ_SOURCE_LINE 00000776 ""
NSQ_SOURCE_LINE 00000777 "=head2 OPTIONAL (RECOMMENDED) DEPENDENCY"
NSQ_SOURCE_LINE 00000778 ""
NSQ_SOURCE_LINE 00000779 "If performance is a consideration, you may also install "
NSQ_SOURCE_LINE 00000780 "L<Math::Random::ISAAC::XS>. Bytes::Random::Secure's random number generator "
NSQ_SOURCE_LINE 00000781 "uses L<Math::Random::ISAAC>.  That module implements the ISAAC algorithm in pure"
NSQ_SOURCE_LINE 00000782 "Perl.  However, if you install L<Math::Random::ISAAC::XS>, you"
NSQ_SOURCE_LINE 00000783 "get the same algorithm implemented in C/XS, which will provide better"
NSQ_SOURCE_LINE 00000784 "performance.  If you need to produce your random bytes more quickly, simply"
NSQ_SOURCE_LINE 00000785 "installing Math::Random::ISAAC::XS will result in it automatically being used,"
NSQ_SOURCE_LINE 00000786 "and a pretty good performance improvement will coincide."
NSQ_SOURCE_LINE 00000787 ""
NSQ_SOURCE_LINE 00000788 ""
NSQ_SOURCE_LINE 00000789 "=head1 CAVEATS"
NSQ_SOURCE_LINE 00000790 ""
NSQ_SOURCE_LINE 00000791 "=head2 FORK AND THREAD SAFETY"
NSQ_SOURCE_LINE 00000792 ""
NSQ_SOURCE_LINE 00000793 "When programming for parallel computation, avoid the \"functions\" interface B<do>"
NSQ_SOURCE_LINE 00000794 "use the Object Oriented interface, and create a unique C<Bytes::Random::Secure> "
NSQ_SOURCE_LINE 00000795 "object within each process or thread.  Bytes::Random::Secure uses"
NSQ_SOURCE_LINE 00000796 "a CSPRNG, and sharing the same RNG between threads or processes will share the "
NSQ_SOURCE_LINE 00000797 "same seed and the same starting point.  This is probably not what one would "
NSQ_SOURCE_LINE 00000798 "want to do. By instantiating the B::R::S object after forking or creating "
NSQ_SOURCE_LINE 00000799 "threads, a unique randomness stream will be created per thread or process."
NSQ_SOURCE_LINE 00000800 ""
NSQ_SOURCE_LINE 00000801 "=head2 STRONG RANDOMNESS"
NSQ_SOURCE_LINE 00000802 ""
NSQ_SOURCE_LINE 00000803 "It's easy to generate weak pseudo-random bytes.  It's also easy to think you're"
NSQ_SOURCE_LINE 00000804 "generating strong pseudo-random bytes when really you're not.  And it's hard to"
NSQ_SOURCE_LINE 00000805 "test for pseudo-random cryptographic acceptable quality.  There are many high"
NSQ_SOURCE_LINE 00000806 "quality random number generators that are suitable for statistical purposes,"
NSQ_SOURCE_LINE 00000807 "but not necessarily up to the rigors of cryptographic use."
NSQ_SOURCE_LINE 00000808 ""
NSQ_SOURCE_LINE 00000809 "Assuring strong (ie, secure) random bytes in a way that works across a wide"
NSQ_SOURCE_LINE 00000810 "variety of platforms is also challenging.  A primary goal for this module is to"
NSQ_SOURCE_LINE 00000811 "provide cryptographically secure pseudo-random bytes.  A secondary goal is to"
NSQ_SOURCE_LINE 00000812 "provide a simple user experience (thus reducing the propensity for getting it"
NSQ_SOURCE_LINE 00000813 "wrong).  A tertiary goal is to minimize the dependencies required to achieve"
NSQ_SOURCE_LINE 00000814 "the primary and secondary goals, to the extent that is practical."
NSQ_SOURCE_LINE 00000815 ""
NSQ_SOURCE_LINE 00000816 "=head2 ISAAC"
NSQ_SOURCE_LINE 00000817 ""
NSQ_SOURCE_LINE 00000818 "The ISAAC algorithm is considered to be a cryptographically strong pseudo-random"
NSQ_SOURCE_LINE 00000819 "number generator.  There are 1.0e2466 initial states.  The best known attack for"
NSQ_SOURCE_LINE 00000820 "discovering initial state would theoretically take a complexity of"
NSQ_SOURCE_LINE 00000821 "approximately 4.67e1240, which has no practical impact on ISAAC's security."
NSQ_SOURCE_LINE 00000822 "Cycles are guaranteed to have a minimum length of 2**40, with an average cycle"
NSQ_SOURCE_LINE 00000823 "of 2**8295.  Because there is no practical attack capable of discovering"
NSQ_SOURCE_LINE 00000824 "initial state, and because the average cycle is so long, it's generally"
NSQ_SOURCE_LINE 00000825 "unnecessary to re-seed a running application.  The results are uniformly"
NSQ_SOURCE_LINE 00000826 "distributed, unbiased, and unpredictable unless the seed is known."
NSQ_SOURCE_LINE 00000827 ""
NSQ_SOURCE_LINE 00000828 "To confirm the quality of the CSPRNG, this module's test suite implements the"
NSQ_SOURCE_LINE 00000829 "L<FIPS-140-1|http://csrc.nist.gov/publications/fips/fips1401.htm> tests for"
NSQ_SOURCE_LINE 00000830 "strong random number generators.  See the comments in C<t/27-fips140-1.t> for"
NSQ_SOURCE_LINE 00000831 "details."
NSQ_SOURCE_LINE 00000832 ""
NSQ_SOURCE_LINE 00000833 "=head2 DEPENDENCIES"
NSQ_SOURCE_LINE 00000834 ""
NSQ_SOURCE_LINE 00000835 "To keep the dependencies as light as possible this module uses some ideas from"
NSQ_SOURCE_LINE 00000836 "L<Math::Random::Secure>.  That module is an excellent resource, but implements"
NSQ_SOURCE_LINE 00000837 "a broader range of functionality than is needed here.  So we just borrowed"
NSQ_SOURCE_LINE 00000838 "from it."
NSQ_SOURCE_LINE 00000839 ""
NSQ_SOURCE_LINE 00000840 "The primary source of random data in this module comes from the excellent"
NSQ_SOURCE_LINE 00000841 "L<Math::Random::ISAAC>.  To be useful and secure, even Math::Random::ISAAC"
NSQ_SOURCE_LINE 00000842 "needs a cryptographically sound seed, which we derive from"
NSQ_SOURCE_LINE 00000843 "L<Crypt::Random::Seed>.  There are no known weaknesses in the ISAAC algorithm."
NSQ_SOURCE_LINE 00000844 "And Crypt::Random::Seed does a very good job of preventing fall-back to weak"
NSQ_SOURCE_LINE 00000845 "seed sources."
NSQ_SOURCE_LINE 00000846 ""
NSQ_SOURCE_LINE 00000847 "This module requires Perl 5.6 or newer.  The module also uses a number of core"
NSQ_SOURCE_LINE 00000848 "modules, some of which require newer versions than those contemporary with 5.6."
NSQ_SOURCE_LINE 00000849 "Unicode support in C<random_string_from> is best with Perl 5.8.9 or newer."
NSQ_SOURCE_LINE 00000850 "See the INSTALLATION section in this document for details."
NSQ_SOURCE_LINE 00000851 ""
NSQ_SOURCE_LINE 00000852 "If L<Test::Warn> is installed, test coverage is 100%.  For those who don't want"
NSQ_SOURCE_LINE 00000853 "to bother installing Test::Warn, you can just take our word for it.  It's an"
NSQ_SOURCE_LINE 00000854 "optional installation dependency."
NSQ_SOURCE_LINE 00000855 ""
NSQ_SOURCE_LINE 00000856 "=head2 BLOCKING ENTROPY SOURCE"
NSQ_SOURCE_LINE 00000857 ""
NSQ_SOURCE_LINE 00000858 "It is possible (and has been seen in testing) that the system's random"
NSQ_SOURCE_LINE 00000859 "entropy source might not have enough entropy in reserve to generate the seed"
NSQ_SOURCE_LINE 00000860 "requested by this module without blocking.  If you suspect that you're a victim"
NSQ_SOURCE_LINE 00000861 "of blocking from reads on C</dev/random>, one option is to manipulate the"
NSQ_SOURCE_LINE 00000862 "random seed configuration by using the object oriented interface."
NSQ_SOURCE_LINE 00000863 ""
NSQ_SOURCE_LINE 00000864 "This module seeds as lazily as possible so that using the module, and even"
NSQ_SOURCE_LINE 00000865 "instantiating a Bytes::Random::Secure object will not trigger reads from"
NSQ_SOURCE_LINE 00000866 "C</dev/random>.  Only the first time the object is used to deliver random bytes"
NSQ_SOURCE_LINE 00000867 "will the RNG be seeded.  Long-running scripts may prefer to force early seeding"
NSQ_SOURCE_LINE 00000868 "as close to start-up time as possible, rather than allowing it to happen later"
NSQ_SOURCE_LINE 00000869 "in a program's run-time.  This can be achieved simply by invoking any of the"
NSQ_SOURCE_LINE 00000870 "functions or methods that return a random byte.  As soon as a random byte is"
NSQ_SOURCE_LINE 00000871 "requested for the first time, the CSPRNG will be seeded."
NSQ_SOURCE_LINE 00000872 ""
NSQ_SOURCE_LINE 00000873 "=head2 UNICODE SUPPORT"
NSQ_SOURCE_LINE 00000874 ""
NSQ_SOURCE_LINE 00000875 "The C<random_string_from> function, and C<string_from> method permit the user"
NSQ_SOURCE_LINE 00000876 "to pass a \"bag\" (or source) string containing Unicode characters.  For any"
NSQ_SOURCE_LINE 00000877 "modern Perl version, this will work just as you would hope.  But some versions"
NSQ_SOURCE_LINE 00000878 "of Perl older than 5.8.9 exhibited varying degrees of bugginess in their"
NSQ_SOURCE_LINE 00000879 "handling of Unicode.  If you're depending on the Unicode features of this"
NSQ_SOURCE_LINE 00000880 "module while using Perl versions older than 5.8.9 be sure to test thoroughly,"
NSQ_SOURCE_LINE 00000881 "and don't be surprised when the outcome isn't as expected.  ...this is to be"
NSQ_SOURCE_LINE 00000882 "expected.  Upgrade."
NSQ_SOURCE_LINE 00000883 ""
NSQ_SOURCE_LINE 00000884 "No other functions or methods in this module get anywhere near Perl's Unicode"
NSQ_SOURCE_LINE 00000885 "features.  So as long as you're not passing Unicode source strings to"
NSQ_SOURCE_LINE 00000886 "C<random_string_from>, you have nothing to worry about, even if you're using"
NSQ_SOURCE_LINE 00000887 "Perl 5.6.0."
NSQ_SOURCE_LINE 00000888 ""
NSQ_SOURCE_LINE 00000889 "=head2 MODULO BIAS"
NSQ_SOURCE_LINE 00000890 ""
NSQ_SOURCE_LINE 00000891 "Care is taken so that there is no modulo bias in the randomness returned"
NSQ_SOURCE_LINE 00000892 "either by C<random_bytes> or its siblings, nor by C<random_string_from>.  As a"
NSQ_SOURCE_LINE 00000893 "matter if fact, this is exactly I<why> the C<random_string_from> function is"
NSQ_SOURCE_LINE 00000894 "useful.  However, the algorithm to eliminate modulo bias can impact the"
NSQ_SOURCE_LINE 00000895 "performance of the C<random_string_from> function. Any time the length of the"
NSQ_SOURCE_LINE 00000896 "bag string is significantly less than the nearest greater or equal factor"
NSQ_SOURCE_LINE 00000897 "of 2**32, performance will degrade.  Unfortunately there is no known algorithm"
NSQ_SOURCE_LINE 00000898 "that improves upon this situation.  Fortunately, for sanely sized strings, it's"
NSQ_SOURCE_LINE 00000899 "a minor issue.  To put it in perspective, even in the case of passing a \"bag\""
NSQ_SOURCE_LINE 00000900 "string of length 2**31 (which is huge), the expected time to return random"
NSQ_SOURCE_LINE 00000901 "bytes will only double.  Given that the entire Unicode range is just over a"
NSQ_SOURCE_LINE 00000902 "million possible code-points, it seems unlikely that the normal use case would"
NSQ_SOURCE_LINE 00000903 "ever have to be concerned with the performance of the C<random_string_from>"
NSQ_SOURCE_LINE 00000904 "function."
NSQ_SOURCE_LINE 00000905 ""
NSQ_SOURCE_LINE 00000906 "=head1 INSTALLATION"
NSQ_SOURCE_LINE 00000907 ""
NSQ_SOURCE_LINE 00000908 "This module should install without any fuss on modern versions of Perl.  For"
NSQ_SOURCE_LINE 00000909 "older Perl versions (particularly 5.6 and early 5.8.x's), it may be necessary"
NSQ_SOURCE_LINE 00000910 "to update your CPAN installer to a more modern version before installing this"
NSQ_SOURCE_LINE 00000911 "this module."
NSQ_SOURCE_LINE 00000912 ""
NSQ_SOURCE_LINE 00000913 "Another alternative for those with old Perl versions who don't want to update"
NSQ_SOURCE_LINE 00000914 "their CPAN installer (You must know you're crazy, right?): Review C<Makefile.PL>"
NSQ_SOURCE_LINE 00000915 "and assure that you've got the dependencies listed under C<PREREQ_PM> and"
NSQ_SOURCE_LINE 00000916 "C<BUILD_REQUIRES>, in at least the minimum versions specified.  Then proceed as"
NSQ_SOURCE_LINE 00000917 "usual. "
NSQ_SOURCE_LINE 00000918 ""
NSQ_SOURCE_LINE 00000919 "This module only has two non-Core dependencies.  But it does expect that some"
NSQ_SOURCE_LINE 00000920 "of the Core dependencies are newer than those supplied with 5.6 or early 5.8's."
NSQ_SOURCE_LINE 00000921 "If you keep your CPAN installer up-to-date, you shouldn't have to think about"
NSQ_SOURCE_LINE 00000922 "this, as it will usually just \"do the right thing\", pulling in newer dependency"
NSQ_SOURCE_LINE 00000923 "versions as directed by the module's META files."
NSQ_SOURCE_LINE 00000924 ""
NSQ_SOURCE_LINE 00000925 "Test coverage for Bytes::Random::Secure is 100% (per Devel::Cover) on any"
NSQ_SOURCE_LINE 00000926 "system that has L<Test::Warn> installed.  But to keep the module light-weight,"
NSQ_SOURCE_LINE 00000927 "Test::Warn is not dragged in by default at installation time."
NSQ_SOURCE_LINE 00000928 ""
NSQ_SOURCE_LINE 00000929 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000930 ""
NSQ_SOURCE_LINE 00000931 "L<Math::Random::Secure> and L<Crypt::Random> provide strong CSPRINGs and even"
NSQ_SOURCE_LINE 00000932 "more configuration options, but come with hefty toolchains."
NSQ_SOURCE_LINE 00000933 ""
NSQ_SOURCE_LINE 00000934 "L<Bytes::Random::Secure::Tiny> is a stand-alone adaptation of"
NSQ_SOURCE_LINE 00000935 "L<Bytes::Random::Secure> with no dependencies. It will, however, detect if"
NSQ_SOURCE_LINE 00000936 "L<Math::Random::ISAAC>, L<Math::Random::ISAAC::XS>, and L<Crypt::Random::Seed>"
NSQ_SOURCE_LINE 00000937 "are installed on the target system, and if they are, it quietly upgrades to"
NSQ_SOURCE_LINE 00000938 "using them."
NSQ_SOURCE_LINE 00000939 ""
NSQ_SOURCE_LINE 00000940 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000941 ""
