NSQ_SOURCE_LINE 00000001 "package HTTP::Cookies;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use HTTP::Date qw(str2time parse_date time2str);"
NSQ_SOURCE_LINE 00000005 "use HTTP::Headers::Util qw(_split_header_words join_header_words);"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "our $EPOCH_OFFSET;"
NSQ_SOURCE_LINE 00000008 "our $VERSION = '6.11';"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "# Legacy: because \"use \"HTTP::Cookies\" used be the ONLY way"
NSQ_SOURCE_LINE 00000011 "#  to load the class HTTP::Cookies::Netscape."
NSQ_SOURCE_LINE 00000012 "require HTTP::Cookies::Netscape;"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "$EPOCH_OFFSET = 0;  # difference from Unix epoch"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "# A HTTP::Cookies object is a hash.  The main attribute is the"
NSQ_SOURCE_LINE 00000017 "# COOKIES 3 level hash:  $self->{COOKIES}{$domain}{$path}{$key}."
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "sub new"
NSQ_SOURCE_LINE 00000020 "{"
NSQ_SOURCE_LINE 00000021 "    my $class = shift;"
NSQ_SOURCE_LINE 00000022 "    my $self = bless {"
NSQ_SOURCE_LINE 00000023 "\tCOOKIES => {},"
NSQ_SOURCE_LINE 00000024 "    }, $class;"
NSQ_SOURCE_LINE 00000025 "    my %cnf = @_;"
NSQ_SOURCE_LINE 00000026 "    for (keys %cnf) {"
NSQ_SOURCE_LINE 00000027 "\t$self->{lc($_)} = $cnf{$_};"
NSQ_SOURCE_LINE 00000028 "    }"
NSQ_SOURCE_LINE 00000029 "    $self->load;"
NSQ_SOURCE_LINE 00000030 "    $self;"
NSQ_SOURCE_LINE 00000031 "}"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "sub add_cookie_header"
NSQ_SOURCE_LINE 00000035 "{"
NSQ_SOURCE_LINE 00000036 "    my $self = shift;"
NSQ_SOURCE_LINE 00000037 "    my $request = shift || return;"
NSQ_SOURCE_LINE 00000038 "    my $url = $request->uri;"
NSQ_SOURCE_LINE 00000039 "    my $scheme = $url->scheme;"
NSQ_SOURCE_LINE 00000040 "    unless ($scheme =~ /^https?\\z/) {"
NSQ_SOURCE_LINE 00000041 "\treturn;"
NSQ_SOURCE_LINE 00000042 "    }"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "    my $domain = _host($request, $url);"
NSQ_SOURCE_LINE 00000045 "    $domain = \"$domain.local\" unless $domain =~ /\\./;"
NSQ_SOURCE_LINE 00000046 "    my $secure_request = ($scheme eq \"https\");"
NSQ_SOURCE_LINE 00000047 "    my $req_path = _url_path($url);"
NSQ_SOURCE_LINE 00000048 "    my $req_port = $url->port;"
NSQ_SOURCE_LINE 00000049 "    my $now = time();"
NSQ_SOURCE_LINE 00000050 "    _normalize_path($req_path) if $req_path =~ /%/;"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "    my @cval;    # cookie values for the \"Cookie\" header"
NSQ_SOURCE_LINE 00000053 "    my $set_ver;"
NSQ_SOURCE_LINE 00000054 "    my $netscape_only = 0; # An exact domain match applies to any cookie"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "    while ($domain =~ /\\./) {"
NSQ_SOURCE_LINE 00000057 "        # Checking $domain for cookies\""
NSQ_SOURCE_LINE 00000058 "\tmy $cookies = $self->{COOKIES}{$domain};"
NSQ_SOURCE_LINE 00000059 "\tnext unless $cookies;"
NSQ_SOURCE_LINE 00000060 "\tif ($self->{delayload} && defined($cookies->{'//+delayload'})) {"
NSQ_SOURCE_LINE 00000061 "\t    my $cookie_data = $cookies->{'//+delayload'}{'cookie'};"
NSQ_SOURCE_LINE 00000062 "\t    delete $self->{COOKIES}{$domain};"
NSQ_SOURCE_LINE 00000063 "\t    $self->load_cookie($cookie_data->[1]);"
NSQ_SOURCE_LINE 00000064 "\t    $cookies = $self->{COOKIES}{$domain};"
NSQ_SOURCE_LINE 00000065 "\t    next unless $cookies;  # should not really happen"
NSQ_SOURCE_LINE 00000066 "\t}"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "\t# Want to add cookies corresponding to the most specific paths"
NSQ_SOURCE_LINE 00000069 "\t# first (i.e. longest path first)"
NSQ_SOURCE_LINE 00000070 "\tmy $path;"
NSQ_SOURCE_LINE 00000071 "\tfor $path (sort {length($b) <=> length($a) } keys %$cookies) {"
NSQ_SOURCE_LINE 00000072 "\t    if (index($req_path, $path) != 0) {"
NSQ_SOURCE_LINE 00000073 "\t\tnext;"
NSQ_SOURCE_LINE 00000074 "\t    }"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "\t    my($key,$array);"
NSQ_SOURCE_LINE 00000077 "\t    while (($key,$array) = each %{$cookies->{$path}}) {"
NSQ_SOURCE_LINE 00000078 "\t\tmy($version,$val,$port,$path_spec,$secure,$expires) = @$array;"
NSQ_SOURCE_LINE 00000079 "\t\tif ($secure && !$secure_request) {"
NSQ_SOURCE_LINE 00000080 "\t\t    next;"
NSQ_SOURCE_LINE 00000081 "\t\t}"
NSQ_SOURCE_LINE 00000082 "\t\tif ($expires && $expires < $now) {"
NSQ_SOURCE_LINE 00000083 "\t\t    next;"
NSQ_SOURCE_LINE 00000084 "\t\t}"
NSQ_SOURCE_LINE 00000085 "\t\tif ($port) {"
NSQ_SOURCE_LINE 00000086 "\t\t    my $found;"
NSQ_SOURCE_LINE 00000087 "\t\t    if ($port =~ s/^_//) {"
NSQ_SOURCE_LINE 00000088 "\t\t\t# The corresponding Set-Cookie attribute was empty"
NSQ_SOURCE_LINE 00000089 "\t\t\t$found++ if $port eq $req_port;"
NSQ_SOURCE_LINE 00000090 "\t\t\t$port = \"\";"
NSQ_SOURCE_LINE 00000091 "\t\t    }"
NSQ_SOURCE_LINE 00000092 "\t\t    else {"
NSQ_SOURCE_LINE 00000093 "\t\t\tmy $p;"
NSQ_SOURCE_LINE 00000094 "\t\t\tfor $p (split(/,/, $port)) {"
NSQ_SOURCE_LINE 00000095 "\t\t\t    $found++, last if $p eq $req_port;"
NSQ_SOURCE_LINE 00000096 "\t\t\t}"
NSQ_SOURCE_LINE 00000097 "\t\t    }"
NSQ_SOURCE_LINE 00000098 "\t\t    unless ($found) {"
NSQ_SOURCE_LINE 00000099 "\t\t\tnext;"
NSQ_SOURCE_LINE 00000100 "\t\t    }"
NSQ_SOURCE_LINE 00000101 "\t\t}"
NSQ_SOURCE_LINE 00000102 "\t\tif ($version > 0 && $netscape_only) {"
NSQ_SOURCE_LINE 00000103 "\t\t    next;"
NSQ_SOURCE_LINE 00000104 "\t\t}"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "\t\t# set version number of cookie header."
NSQ_SOURCE_LINE 00000107 "\t        # XXX: What should it be if multiple matching"
NSQ_SOURCE_LINE 00000108 "                #      Set-Cookie headers have different versions themselves"
NSQ_SOURCE_LINE 00000109 "\t\tif (!$set_ver++) {"
NSQ_SOURCE_LINE 00000110 "\t\t    if ($version >= 1) {"
NSQ_SOURCE_LINE 00000111 "\t\t\tpush(@cval, \"\\$Version=$version\");"
NSQ_SOURCE_LINE 00000112 "\t\t    }"
NSQ_SOURCE_LINE 00000113 "\t\t    elsif (!$self->{hide_cookie2}) {"
NSQ_SOURCE_LINE 00000114 "\t\t\t$request->header(Cookie2 => '$Version=\"1\"');"
NSQ_SOURCE_LINE 00000115 "\t\t    }"
NSQ_SOURCE_LINE 00000116 "\t\t}"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "\t\t# do we need to quote the value"
NSQ_SOURCE_LINE 00000119 "\t\tif ($val =~ /\\W/ && $version) {"
NSQ_SOURCE_LINE 00000120 "\t\t    $val =~ s/([\\\\\\\"])/\\\\$1/g;"
NSQ_SOURCE_LINE 00000121 "\t\t    $val = qq(\"$val\");"
NSQ_SOURCE_LINE 00000122 "\t\t}"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "\t\t# and finally remember this cookie"
NSQ_SOURCE_LINE 00000125 "\t\tpush(@cval, \"$key=$val\");"
NSQ_SOURCE_LINE 00000126 "\t\tif ($version >= 1) {"
NSQ_SOURCE_LINE 00000127 "\t\t    push(@cval, qq(\\$Path=\"$path\"))     if $path_spec;"
NSQ_SOURCE_LINE 00000128 "\t\t    push(@cval, qq(\\$Domain=\"$domain\")) if $domain =~ /^\\./;"
NSQ_SOURCE_LINE 00000129 "\t\t    if (defined $port) {"
NSQ_SOURCE_LINE 00000130 "\t\t\tmy $p = '$Port';"
NSQ_SOURCE_LINE 00000131 "\t\t\t$p .= qq(=\"$port\") if length $port;"
NSQ_SOURCE_LINE 00000132 "\t\t\tpush(@cval, $p);"
NSQ_SOURCE_LINE 00000133 "\t\t    }"
NSQ_SOURCE_LINE 00000134 "\t\t}"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "\t    }"
NSQ_SOURCE_LINE 00000137 "        }"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "    } continue {"
NSQ_SOURCE_LINE 00000140 "\t# Try with a more general domain, alternately stripping"
NSQ_SOURCE_LINE 00000141 "\t# leading name components and leading dots.  When this"
NSQ_SOURCE_LINE 00000142 "\t# results in a domain with no leading dot, it is for"
NSQ_SOURCE_LINE 00000143 "\t# Netscape cookie compatibility only:"
NSQ_SOURCE_LINE 00000144 "\t#"
NSQ_SOURCE_LINE 00000145 "\t# a.b.c.net\tAny cookie"
NSQ_SOURCE_LINE 00000146 "\t# .b.c.net\tAny cookie"
NSQ_SOURCE_LINE 00000147 "\t# b.c.net\tNetscape cookie only"
NSQ_SOURCE_LINE 00000148 "\t# .c.net\tAny cookie"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "\tif ($domain =~ s/^\\.+//) {"
NSQ_SOURCE_LINE 00000151 "\t    $netscape_only = 1;"
NSQ_SOURCE_LINE 00000152 "\t}"
NSQ_SOURCE_LINE 00000153 "\telse {"
NSQ_SOURCE_LINE 00000154 "\t    $domain =~ s/[^.]*//;"
NSQ_SOURCE_LINE 00000155 "\t    $netscape_only = 0;"
NSQ_SOURCE_LINE 00000156 "\t}"
NSQ_SOURCE_LINE 00000157 "    }"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "    if (@cval) {"
NSQ_SOURCE_LINE 00000160 "\tif (my $old = $request->header(\"Cookie\")) {"
NSQ_SOURCE_LINE 00000161 "\t    unshift(@cval, $old);"
NSQ_SOURCE_LINE 00000162 "\t}"
NSQ_SOURCE_LINE 00000163 "\t$request->header(Cookie => join(\"; \", @cval));"
NSQ_SOURCE_LINE 00000164 "\tif (my $hash = $request->{_http_cookies}) {"
NSQ_SOURCE_LINE 00000165 "\t    %$hash = (map split(/=/, $_, 2), @cval);"
NSQ_SOURCE_LINE 00000166 "\t}"
NSQ_SOURCE_LINE 00000167 "    }"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "    $request;"
NSQ_SOURCE_LINE 00000170 "}"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "sub get_cookies"
NSQ_SOURCE_LINE 00000174 "{"
NSQ_SOURCE_LINE 00000175 "    my $self = shift;"
NSQ_SOURCE_LINE 00000176 "    my $url = shift;"
NSQ_SOURCE_LINE 00000177 "    $url = \"https://$url\" unless $url =~ m,^[a-zA-Z][a-zA-Z0-9.+\\-]*:,;"
NSQ_SOURCE_LINE 00000178 "    require HTTP::Request;"
NSQ_SOURCE_LINE 00000179 "    my $req = HTTP::Request->new(GET => $url);"
NSQ_SOURCE_LINE 00000180 "    my $cookies = $req->{_http_cookies} = {};"
NSQ_SOURCE_LINE 00000181 "    $self->add_cookie_header($req);"
NSQ_SOURCE_LINE 00000182 "    if (@_) {"
NSQ_SOURCE_LINE 00000183 "\treturn map $cookies->{$_}, @_ if wantarray;"
NSQ_SOURCE_LINE 00000184 "\treturn $cookies->{$_[0]};"
NSQ_SOURCE_LINE 00000185 "    }"
NSQ_SOURCE_LINE 00000186 "    return $cookies;"
NSQ_SOURCE_LINE 00000187 "}"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "sub extract_cookies"
NSQ_SOURCE_LINE 00000191 "{"
NSQ_SOURCE_LINE 00000192 "    my $self = shift;"
NSQ_SOURCE_LINE 00000193 "    my $response = shift || return;"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "    my @set = _split_header_words($response->_header(\"Set-Cookie2\"));"
NSQ_SOURCE_LINE 00000196 "    my @ns_set = $response->_header(\"Set-Cookie\");"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "    return $response unless @set || @ns_set;  # quick exit"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "    my $request = $response->request;"
NSQ_SOURCE_LINE 00000201 "    my $url = $request->uri;"
NSQ_SOURCE_LINE 00000202 "    my $req_host = _host($request, $url);"
NSQ_SOURCE_LINE 00000203 "    $req_host = \"$req_host.local\" unless $req_host =~ /\\./;"
NSQ_SOURCE_LINE 00000204 "    my $req_port = $url->port;"
NSQ_SOURCE_LINE 00000205 "    my $req_path = _url_path($url);"
NSQ_SOURCE_LINE 00000206 "    _normalize_path($req_path) if $req_path =~ /%/;"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "    if (@ns_set) {"
NSQ_SOURCE_LINE 00000209 "\t# The old Netscape cookie format for Set-Cookie"
NSQ_SOURCE_LINE 00000210 "\t# http://curl.haxx.se/rfc/cookie_spec.html"
NSQ_SOURCE_LINE 00000211 "\t# can for instance contain an unquoted \",\" in the expires"
NSQ_SOURCE_LINE 00000212 "\t# field, so we have to use this ad-hoc parser."
NSQ_SOURCE_LINE 00000213 "\tmy $now = time();"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "\t# Build a hash of cookies that was present in Set-Cookie2"
NSQ_SOURCE_LINE 00000216 "\t# headers.  We need to skip them if we also find them in a"
NSQ_SOURCE_LINE 00000217 "\t# Set-Cookie header."
NSQ_SOURCE_LINE 00000218 "\tmy %in_set2;"
NSQ_SOURCE_LINE 00000219 "\tfor (@set) {"
NSQ_SOURCE_LINE 00000220 "\t    $in_set2{$_->[0]}++;"
NSQ_SOURCE_LINE 00000221 "\t}"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "\tmy $set;"
NSQ_SOURCE_LINE 00000224 "\tfor $set (@ns_set) {"
NSQ_SOURCE_LINE 00000225 "            $set =~ s/^\\s+//;"
NSQ_SOURCE_LINE 00000226 "\t    my @cur;"
NSQ_SOURCE_LINE 00000227 "\t    my $param;"
NSQ_SOURCE_LINE 00000228 "\t    my $expires;"
NSQ_SOURCE_LINE 00000229 "\t    my $first_param = 1;"
NSQ_SOURCE_LINE 00000230 "\t    for $param (@{_split_text($set)}) {"
NSQ_SOURCE_LINE 00000231 "                next unless length($param);"
NSQ_SOURCE_LINE 00000232 "\t\tmy($k,$v) = split(/\\s*=\\s*/, $param, 2);"
NSQ_SOURCE_LINE 00000233 "\t\tif (defined $v) {"
NSQ_SOURCE_LINE 00000234 "\t\t    $v =~ s/\\s+$//;"
NSQ_SOURCE_LINE 00000235 "\t\t    #print \"$k => $v\\n\";"
NSQ_SOURCE_LINE 00000236 "\t\t}"
NSQ_SOURCE_LINE 00000237 "\t\telse {"
NSQ_SOURCE_LINE 00000238 "\t\t    $k =~ s/\\s+$//;"
NSQ_SOURCE_LINE 00000239 "\t\t    #print \"$k => undef\";"
NSQ_SOURCE_LINE 00000240 "\t\t}"
NSQ_SOURCE_LINE 00000241 "\t\tif (!$first_param && lc($k) eq \"expires\") {"
NSQ_SOURCE_LINE 00000242 "\t\t    my $etime = str2time($v);"
NSQ_SOURCE_LINE 00000243 "\t\t    if (defined $etime) {"
NSQ_SOURCE_LINE 00000244 "\t\t\tpush(@cur, \"Max-Age\" => $etime - $now);"
NSQ_SOURCE_LINE 00000245 "\t\t\t$expires++;"
NSQ_SOURCE_LINE 00000246 "\t\t    }"
NSQ_SOURCE_LINE 00000247 "\t\t    else {"
NSQ_SOURCE_LINE 00000248 "\t\t\t# parse_date can deal with years outside the range of time_t,"
NSQ_SOURCE_LINE 00000249 "\t\t\tmy($year, $mon, $day, $hour, $min, $sec, $tz) = parse_date($v);"
NSQ_SOURCE_LINE 00000250 "\t\t\tif ($year) {"
NSQ_SOURCE_LINE 00000251 "\t\t\t    my $thisyear = (gmtime)[5] + 1900;"
NSQ_SOURCE_LINE 00000252 "\t\t\t    if ($year < $thisyear) {"
NSQ_SOURCE_LINE 00000253 "\t\t\t\tpush(@cur, \"Max-Age\" => -1);  # any negative value will do"
NSQ_SOURCE_LINE 00000254 "\t\t\t\t$expires++;"
NSQ_SOURCE_LINE 00000255 "\t\t\t    }"
NSQ_SOURCE_LINE 00000256 "\t\t\t    elsif ($year >= $thisyear + 10) {"
NSQ_SOURCE_LINE 00000257 "\t\t\t\t# the date is at least 10 years into the future, just replace"
NSQ_SOURCE_LINE 00000258 "\t\t\t\t# it with something approximate"
NSQ_SOURCE_LINE 00000259 "\t\t\t\tpush(@cur, \"Max-Age\" => 10 * 365 * 24 * 60 * 60);"
NSQ_SOURCE_LINE 00000260 "\t\t\t\t$expires++;"
NSQ_SOURCE_LINE 00000261 "\t\t\t    }"
NSQ_SOURCE_LINE 00000262 "\t\t\t}"
NSQ_SOURCE_LINE 00000263 "\t\t    }"
NSQ_SOURCE_LINE 00000264 "\t\t}"
NSQ_SOURCE_LINE 00000265 "                elsif (!$first_param && lc($k) eq 'max-age') {"
NSQ_SOURCE_LINE 00000266 "                    $expires++;"
NSQ_SOURCE_LINE 00000267 "                }"
NSQ_SOURCE_LINE 00000268 "                elsif (!$first_param && lc($k) =~ /^(?:version|discard|ns-cookie)/) {"
NSQ_SOURCE_LINE 00000269 "                    # ignore"
NSQ_SOURCE_LINE 00000270 "                }"
NSQ_SOURCE_LINE 00000271 "\t\telse {"
NSQ_SOURCE_LINE 00000272 "\t\t    push(@cur, $k => $v);"
NSQ_SOURCE_LINE 00000273 "\t\t}"
NSQ_SOURCE_LINE 00000274 "\t\t$first_param = 0;"
NSQ_SOURCE_LINE 00000275 "\t    }"
NSQ_SOURCE_LINE 00000276 "            next unless @cur;"
NSQ_SOURCE_LINE 00000277 "\t    next if $in_set2{$cur[0]};"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "#\t    push(@cur, \"Port\" => $req_port);"
NSQ_SOURCE_LINE 00000280 "\t    push(@cur, \"Discard\" => undef) unless $expires;"
NSQ_SOURCE_LINE 00000281 "\t    push(@cur, \"Version\" => 0);"
NSQ_SOURCE_LINE 00000282 "\t    push(@cur, \"ns-cookie\" => 1);"
NSQ_SOURCE_LINE 00000283 "\t    push(@set, \\@cur);"
NSQ_SOURCE_LINE 00000284 "\t}"
NSQ_SOURCE_LINE 00000285 "    }"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "  SET_COOKIE:"
NSQ_SOURCE_LINE 00000288 "    for my $set (@set) {"
NSQ_SOURCE_LINE 00000289 "\tnext unless @$set >= 2;"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "\tmy $key = shift @$set;"
NSQ_SOURCE_LINE 00000292 "\tmy $val = shift @$set;"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "\tmy %hash;"
NSQ_SOURCE_LINE 00000295 "\twhile (@$set) {"
NSQ_SOURCE_LINE 00000296 "\t    my $k = shift @$set;"
NSQ_SOURCE_LINE 00000297 "\t    my $v = shift @$set;"
NSQ_SOURCE_LINE 00000298 "\t    my $lc = lc($k);"
NSQ_SOURCE_LINE 00000299 "\t    # don't loose case distinction for unknown fields"
NSQ_SOURCE_LINE 00000300 "\t    $k = $lc if $lc =~ /^(?:discard|domain|max-age|"
NSQ_SOURCE_LINE 00000301 "                                    path|port|secure|version)$/x;"
NSQ_SOURCE_LINE 00000302 "\t    if ($k eq \"discard\" || $k eq \"secure\") {"
NSQ_SOURCE_LINE 00000303 "\t\t$v = 1 unless defined $v;"
NSQ_SOURCE_LINE 00000304 "\t    }"
NSQ_SOURCE_LINE 00000305 "\t    next if exists $hash{$k};  # only first value is significant"
NSQ_SOURCE_LINE 00000306 "\t    $hash{$k} = $v;"
NSQ_SOURCE_LINE 00000307 "\t};"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "\tmy %orig_hash = %hash;"
NSQ_SOURCE_LINE 00000310 "\tmy $version   = delete $hash{version};"
NSQ_SOURCE_LINE 00000311 "\t$version = 1 unless defined($version);"
NSQ_SOURCE_LINE 00000312 "\tmy $discard   = delete $hash{discard};"
NSQ_SOURCE_LINE 00000313 "\tmy $secure    = delete $hash{secure};"
NSQ_SOURCE_LINE 00000314 "\tmy $maxage    = delete $hash{'max-age'};"
NSQ_SOURCE_LINE 00000315 "\tmy $ns_cookie = delete $hash{'ns-cookie'};"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "\t# Check domain"
NSQ_SOURCE_LINE 00000318 "\tmy $domain  = delete $hash{domain};"
NSQ_SOURCE_LINE 00000319 "\t$domain = lc($domain) if defined $domain;"
NSQ_SOURCE_LINE 00000320 "\tif (defined($domain)"
NSQ_SOURCE_LINE 00000321 "\t    && $domain ne $req_host && $domain ne \".$req_host\") {"
NSQ_SOURCE_LINE 00000322 "\t    if ($domain !~ /\\./ && $domain ne \"local\") {"
NSQ_SOURCE_LINE 00000323 "\t\tnext SET_COOKIE;"
NSQ_SOURCE_LINE 00000324 "\t    }"
NSQ_SOURCE_LINE 00000325 "\t    $domain = \".$domain\" unless $domain =~ /^\\./;"
NSQ_SOURCE_LINE 00000326 "\t    if ($domain =~ /\\.\\d+$/) {"
NSQ_SOURCE_LINE 00000327 "\t\tnext SET_COOKIE;"
NSQ_SOURCE_LINE 00000328 "\t    }"
NSQ_SOURCE_LINE 00000329 "\t    my $len = length($domain);"
NSQ_SOURCE_LINE 00000330 "\t    unless (substr($req_host, -$len) eq $domain) {"
NSQ_SOURCE_LINE 00000331 "\t\tnext SET_COOKIE;"
NSQ_SOURCE_LINE 00000332 "\t    }"
NSQ_SOURCE_LINE 00000333 "\t    my $hostpre = substr($req_host, 0, length($req_host) - $len);"
NSQ_SOURCE_LINE 00000334 "\t    if ($hostpre =~ /\\./ && !$ns_cookie) {"
NSQ_SOURCE_LINE 00000335 "\t\tnext SET_COOKIE;"
NSQ_SOURCE_LINE 00000336 "\t    }"
NSQ_SOURCE_LINE 00000337 "\t}"
NSQ_SOURCE_LINE 00000338 "\telse {"
NSQ_SOURCE_LINE 00000339 "\t    $domain = $req_host;"
NSQ_SOURCE_LINE 00000340 "\t}"
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "\tmy $path = delete $hash{path};"
NSQ_SOURCE_LINE 00000343 "\tmy $path_spec;"
NSQ_SOURCE_LINE 00000344 "\tif (defined $path && $path ne '') {"
NSQ_SOURCE_LINE 00000345 "\t    $path_spec++;"
NSQ_SOURCE_LINE 00000346 "\t    _normalize_path($path) if $path =~ /%/;"
NSQ_SOURCE_LINE 00000347 "\t    if (!$ns_cookie &&"
NSQ_SOURCE_LINE 00000348 "                substr($req_path, 0, length($path)) ne $path) {"
NSQ_SOURCE_LINE 00000349 "\t\tnext SET_COOKIE;"
NSQ_SOURCE_LINE 00000350 "\t    }"
NSQ_SOURCE_LINE 00000351 "\t}"
NSQ_SOURCE_LINE 00000352 "\telse {"
NSQ_SOURCE_LINE 00000353 "\t    $path = $req_path;"
NSQ_SOURCE_LINE 00000354 "\t    $path =~ s,/[^/]*$,,;"
NSQ_SOURCE_LINE 00000355 "\t    $path = \"/\" unless length($path);"
NSQ_SOURCE_LINE 00000356 "\t}"
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 "\tmy $port;"
NSQ_SOURCE_LINE 00000359 "\tif (exists $hash{port}) {"
NSQ_SOURCE_LINE 00000360 "\t    $port = delete $hash{port};"
NSQ_SOURCE_LINE 00000361 "\t    if (defined $port) {"
NSQ_SOURCE_LINE 00000362 "\t\t$port =~ s/\\s+//g;"
NSQ_SOURCE_LINE 00000363 "\t\tmy $found;"
NSQ_SOURCE_LINE 00000364 "\t\tfor my $p (split(/,/, $port)) {"
NSQ_SOURCE_LINE 00000365 "\t\t    unless ($p =~ /^\\d+$/) {"
NSQ_SOURCE_LINE 00000366 "\t\t\tnext SET_COOKIE;"
NSQ_SOURCE_LINE 00000367 "\t\t    }"
NSQ_SOURCE_LINE 00000368 "\t\t    $found++ if $p eq $req_port;"
NSQ_SOURCE_LINE 00000369 "\t\t}"
NSQ_SOURCE_LINE 00000370 "\t\tunless ($found) {"
NSQ_SOURCE_LINE 00000371 "\t\t    next SET_COOKIE;"
NSQ_SOURCE_LINE 00000372 "\t\t}"
NSQ_SOURCE_LINE 00000373 "\t    }"
NSQ_SOURCE_LINE 00000374 "\t    else {"
NSQ_SOURCE_LINE 00000375 "\t\t$port = \"_$req_port\";"
NSQ_SOURCE_LINE 00000376 "\t    }"
NSQ_SOURCE_LINE 00000377 "\t}"
NSQ_SOURCE_LINE 00000378 "\t$self->set_cookie($version,$key,$val,$path,$domain,$port,$path_spec,$secure,$maxage,$discard, \\%hash)"
NSQ_SOURCE_LINE 00000379 "\t    if $self->set_cookie_ok(\\%orig_hash);"
NSQ_SOURCE_LINE 00000380 "    }"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "    $response;"
NSQ_SOURCE_LINE 00000383 "}"
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "sub set_cookie_ok"
NSQ_SOURCE_LINE 00000386 "{"
NSQ_SOURCE_LINE 00000387 "    1;"
NSQ_SOURCE_LINE 00000388 "}"
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 ""
NSQ_SOURCE_LINE 00000391 "sub set_cookie"
NSQ_SOURCE_LINE 00000392 "{"
NSQ_SOURCE_LINE 00000393 "    my $self = shift;"
NSQ_SOURCE_LINE 00000394 "    my($version,"
NSQ_SOURCE_LINE 00000395 "       $key, $val, $path, $domain, $port,"
NSQ_SOURCE_LINE 00000396 "       $path_spec, $secure, $maxage, $discard, $rest) = @_;"
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "    # path and key can not be empty (key can't start with '$')"
NSQ_SOURCE_LINE 00000399 "    return $self if !defined($path) || $path !~ m,^/, ||"
NSQ_SOURCE_LINE 00000400 "\t            !defined($key)  || $key  =~ m,^\\$,;"
NSQ_SOURCE_LINE 00000401 ""
NSQ_SOURCE_LINE 00000402 "    # ensure legal port"
NSQ_SOURCE_LINE 00000403 "    if (defined $port) {"
NSQ_SOURCE_LINE 00000404 "\treturn $self unless $port =~ /^_?\\d+(?:,\\d+)*$/;"
NSQ_SOURCE_LINE 00000405 "    }"
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "    my $expires;"
NSQ_SOURCE_LINE 00000408 "    if (defined $maxage) {"
NSQ_SOURCE_LINE 00000409 "\tif ($maxage <= 0) {"
NSQ_SOURCE_LINE 00000410 "\t    delete $self->{COOKIES}{$domain}{$path}{$key};"
NSQ_SOURCE_LINE 00000411 "\t    return $self;"
NSQ_SOURCE_LINE 00000412 "\t}"
NSQ_SOURCE_LINE 00000413 "\t$expires = time() + $maxage;"
NSQ_SOURCE_LINE 00000414 "    }"
NSQ_SOURCE_LINE 00000415 "    $version = 0 unless defined $version;"
NSQ_SOURCE_LINE 00000416 ""
NSQ_SOURCE_LINE 00000417 "    my @array = ($version, $val,$port,"
NSQ_SOURCE_LINE 00000418 "\t\t $path_spec,"
NSQ_SOURCE_LINE 00000419 "\t\t $secure, $expires, $discard);"
NSQ_SOURCE_LINE 00000420 "    push(@array, {%$rest}) if defined($rest) && %$rest;"
NSQ_SOURCE_LINE 00000421 "    # trim off undefined values at end"
NSQ_SOURCE_LINE 00000422 "    pop(@array) while !defined $array[-1];"
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "    $self->{COOKIES}{$domain}{$path}{$key} = \\@array;"
NSQ_SOURCE_LINE 00000425 "    $self;"
NSQ_SOURCE_LINE 00000426 "}"
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 "sub save"
NSQ_SOURCE_LINE 00000430 "{"
NSQ_SOURCE_LINE 00000431 "    my $self = shift;"
NSQ_SOURCE_LINE 00000432 "    my %args = ("
NSQ_SOURCE_LINE 00000433 "        file => $self->{'file'},"
NSQ_SOURCE_LINE 00000434 "        ignore_discard => $self->{'ignore_discard'},"
NSQ_SOURCE_LINE 00000435 "        @_ == 1 ? ( file => $_[0] ) : @_"
NSQ_SOURCE_LINE 00000436 "    );"
NSQ_SOURCE_LINE 00000437 "    Carp::croak('Unexpected argument to save method') if keys %args > 2;"
NSQ_SOURCE_LINE 00000438 "    my $file = $args{'file'} || return;"
NSQ_SOURCE_LINE 00000439 "    open(my $fh, '>', $file) or die \"Can't open $file: $!\";"
NSQ_SOURCE_LINE 00000440 "    print {$fh} \"#LWP-Cookies-1.0\\n\";"
NSQ_SOURCE_LINE 00000441 "    print {$fh} $self->as_string(!$args{'ignore_discard'});"
NSQ_SOURCE_LINE 00000442 "    close $fh or die \"Can't close $file: $!\";"
NSQ_SOURCE_LINE 00000443 "    1;"
NSQ_SOURCE_LINE 00000444 "}"
NSQ_SOURCE_LINE 00000445 ""
NSQ_SOURCE_LINE 00000446 ""
NSQ_SOURCE_LINE 00000447 "sub load"
NSQ_SOURCE_LINE 00000448 "{"
NSQ_SOURCE_LINE 00000449 "    my $self = shift;"
NSQ_SOURCE_LINE 00000450 "    my $file = shift || $self->{'file'} || return;"
NSQ_SOURCE_LINE 00000451 ""
NSQ_SOURCE_LINE 00000452 "    local $/ = \"\\n\";  # make sure we got standard record separator"
NSQ_SOURCE_LINE 00000453 "    open(my $fh, '<', $file) or return;"
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 "    # check that we have the proper header"
NSQ_SOURCE_LINE 00000456 "    my $magic = <$fh>;"
NSQ_SOURCE_LINE 00000457 "    chomp $magic;"
NSQ_SOURCE_LINE 00000458 "    unless ($magic =~ /^#LWP-Cookies-\\d+\\.\\d+/) {"
NSQ_SOURCE_LINE 00000459 "        warn \"$file does not seem to contain cookies\";"
NSQ_SOURCE_LINE 00000460 "        return;"
NSQ_SOURCE_LINE 00000461 "    }"
NSQ_SOURCE_LINE 00000462 ""
NSQ_SOURCE_LINE 00000463 "    # go through the file"
NSQ_SOURCE_LINE 00000464 "    while (my $line = <$fh>) {"
NSQ_SOURCE_LINE 00000465 "        chomp $line;"
NSQ_SOURCE_LINE 00000466 "        next unless $line =~ s/^Set-Cookie3:\\s*//;"
NSQ_SOURCE_LINE 00000467 "        my $cookie;"
NSQ_SOURCE_LINE 00000468 "        for $cookie (_split_header_words($line)) {"
NSQ_SOURCE_LINE 00000469 "            my($key,$val) = splice(@$cookie, 0, 2);"
NSQ_SOURCE_LINE 00000470 "            my %hash;"
NSQ_SOURCE_LINE 00000471 "            while (@$cookie) {"
NSQ_SOURCE_LINE 00000472 "                my $k = shift @$cookie;"
NSQ_SOURCE_LINE 00000473 "                my $v = shift @$cookie;"
NSQ_SOURCE_LINE 00000474 "                $hash{$k} = $v;"
NSQ_SOURCE_LINE 00000475 "            }"
NSQ_SOURCE_LINE 00000476 "            my $version   = delete $hash{version};"
NSQ_SOURCE_LINE 00000477 "            my $path      = delete $hash{path};"
NSQ_SOURCE_LINE 00000478 "            my $domain    = delete $hash{domain};"
NSQ_SOURCE_LINE 00000479 "            my $port      = delete $hash{port};"
NSQ_SOURCE_LINE 00000480 "            my $expires   = str2time(delete $hash{expires});"
NSQ_SOURCE_LINE 00000481 ""
NSQ_SOURCE_LINE 00000482 "            my $path_spec = exists $hash{path_spec}; delete $hash{path_spec};"
NSQ_SOURCE_LINE 00000483 "            my $secure    = exists $hash{secure};    delete $hash{secure};"
NSQ_SOURCE_LINE 00000484 "            my $discard   = exists $hash{discard};   delete $hash{discard};"
NSQ_SOURCE_LINE 00000485 ""
NSQ_SOURCE_LINE 00000486 "            my @array = ($version, $val, $port, $path_spec, $secure, $expires,"
NSQ_SOURCE_LINE 00000487 "                $discard);"
NSQ_SOURCE_LINE 00000488 "            push(@array, \\%hash) if %hash;"
NSQ_SOURCE_LINE 00000489 "            $self->{COOKIES}{$domain}{$path}{$key} = \\@array;"
NSQ_SOURCE_LINE 00000490 "        }"
NSQ_SOURCE_LINE 00000491 "    }"
NSQ_SOURCE_LINE 00000492 "    1;"
NSQ_SOURCE_LINE 00000493 "}"
NSQ_SOURCE_LINE 00000494 ""
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "sub revert"
NSQ_SOURCE_LINE 00000497 "{"
NSQ_SOURCE_LINE 00000498 "    my $self = shift;"
NSQ_SOURCE_LINE 00000499 "    $self->clear->load;"
NSQ_SOURCE_LINE 00000500 "    $self;"
NSQ_SOURCE_LINE 00000501 "}"
NSQ_SOURCE_LINE 00000502 ""
NSQ_SOURCE_LINE 00000503 ""
NSQ_SOURCE_LINE 00000504 "sub clear"
NSQ_SOURCE_LINE 00000505 "{"
NSQ_SOURCE_LINE 00000506 "    my $self = shift;"
NSQ_SOURCE_LINE 00000507 "    if (@_ == 0) {"
NSQ_SOURCE_LINE 00000508 "\t$self->{COOKIES} = {};"
NSQ_SOURCE_LINE 00000509 "    }"
NSQ_SOURCE_LINE 00000510 "    elsif (@_ == 1) {"
NSQ_SOURCE_LINE 00000511 "\tdelete $self->{COOKIES}{$_[0]};"
NSQ_SOURCE_LINE 00000512 "    }"
NSQ_SOURCE_LINE 00000513 "    elsif (@_ == 2) {"
NSQ_SOURCE_LINE 00000514 "\tdelete $self->{COOKIES}{$_[0]}{$_[1]};"
NSQ_SOURCE_LINE 00000515 "    }"
NSQ_SOURCE_LINE 00000516 "    elsif (@_ == 3) {"
NSQ_SOURCE_LINE 00000517 "\tdelete $self->{COOKIES}{$_[0]}{$_[1]}{$_[2]};"
NSQ_SOURCE_LINE 00000518 "    }"
NSQ_SOURCE_LINE 00000519 "    else {"
NSQ_SOURCE_LINE 00000520 "\trequire Carp;"
NSQ_SOURCE_LINE 00000521 "        Carp::carp('Usage: $c->clear([domain [,path [,key]]])');"
NSQ_SOURCE_LINE 00000522 "    }"
NSQ_SOURCE_LINE 00000523 "    $self;"
NSQ_SOURCE_LINE 00000524 "}"
NSQ_SOURCE_LINE 00000525 ""
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 "sub clear_temporary_cookies"
NSQ_SOURCE_LINE 00000528 "{"
NSQ_SOURCE_LINE 00000529 "    my($self) = @_;"
NSQ_SOURCE_LINE 00000530 ""
NSQ_SOURCE_LINE 00000531 "    $self->scan(sub {"
NSQ_SOURCE_LINE 00000532 "        if($_[9] or        # \"Discard\" flag set"
NSQ_SOURCE_LINE 00000533 "           not $_[8]) {    # No expire field?"
NSQ_SOURCE_LINE 00000534 "            $_[8] = -1;            # Set the expire/max_age field"
NSQ_SOURCE_LINE 00000535 "            $self->set_cookie(@_); # Clear the cookie"
NSQ_SOURCE_LINE 00000536 "        }"
NSQ_SOURCE_LINE 00000537 "      });"
NSQ_SOURCE_LINE 00000538 "}"
NSQ_SOURCE_LINE 00000539 ""
NSQ_SOURCE_LINE 00000540 ""
NSQ_SOURCE_LINE 00000541 "sub DESTROY"
NSQ_SOURCE_LINE 00000542 "{"
NSQ_SOURCE_LINE 00000543 "    my $self = shift;"
NSQ_SOURCE_LINE 00000544 "    local($., $@, $!, $^E, $?);"
NSQ_SOURCE_LINE 00000545 "    $self->save if $self->{'autosave'};"
NSQ_SOURCE_LINE 00000546 "}"
NSQ_SOURCE_LINE 00000547 ""
NSQ_SOURCE_LINE 00000548 ""
NSQ_SOURCE_LINE 00000549 "sub scan"
NSQ_SOURCE_LINE 00000550 "{"
NSQ_SOURCE_LINE 00000551 "    my($self, $cb) = @_;"
NSQ_SOURCE_LINE 00000552 "    my($domain,$path,$key);"
NSQ_SOURCE_LINE 00000553 "    for $domain (sort keys %{$self->{COOKIES}}) {"
NSQ_SOURCE_LINE 00000554 "\tfor $path (sort keys %{$self->{COOKIES}{$domain}}) {"
NSQ_SOURCE_LINE 00000555 "\t    for $key (sort keys %{$self->{COOKIES}{$domain}{$path}}) {"
NSQ_SOURCE_LINE 00000556 "\t\tmy($version,$val,$port,$path_spec,"
NSQ_SOURCE_LINE 00000557 "\t\t   $secure,$expires,$discard,$rest) ="
NSQ_SOURCE_LINE 00000558 "\t\t       @{$self->{COOKIES}{$domain}{$path}{$key}};"
NSQ_SOURCE_LINE 00000559 "\t\t$rest = {} unless defined($rest);"
NSQ_SOURCE_LINE 00000560 "\t\t&$cb($version,$key,$val,$path,$domain,$port,"
NSQ_SOURCE_LINE 00000561 "\t\t     $path_spec,$secure,$expires,$discard,$rest);"
NSQ_SOURCE_LINE 00000562 "\t    }"
NSQ_SOURCE_LINE 00000563 "\t}"
NSQ_SOURCE_LINE 00000564 "    }"
NSQ_SOURCE_LINE 00000565 "}"
NSQ_SOURCE_LINE 00000566 ""
NSQ_SOURCE_LINE 00000567 ""
NSQ_SOURCE_LINE 00000568 "sub as_string"
NSQ_SOURCE_LINE 00000569 "{"
NSQ_SOURCE_LINE 00000570 "    my($self, $skip_discard) = @_;"
NSQ_SOURCE_LINE 00000571 "    my @res;"
NSQ_SOURCE_LINE 00000572 "    $self->scan(sub {"
NSQ_SOURCE_LINE 00000573 "\tmy($version,$key,$val,$path,$domain,$port,"
NSQ_SOURCE_LINE 00000574 "\t   $path_spec,$secure,$expires,$discard,$rest) = @_;"
NSQ_SOURCE_LINE 00000575 "\treturn if $discard && $skip_discard;"
NSQ_SOURCE_LINE 00000576 "\tmy @h = ($key, $val);"
NSQ_SOURCE_LINE 00000577 "\tpush(@h, \"path\", $path);"
NSQ_SOURCE_LINE 00000578 "\tpush(@h, \"domain\" => $domain);"
NSQ_SOURCE_LINE 00000579 "\tpush(@h, \"port\" => $port) if defined $port;"
NSQ_SOURCE_LINE 00000580 "\tpush(@h, \"path_spec\" => undef) if $path_spec;"
NSQ_SOURCE_LINE 00000581 "\tpush(@h, \"secure\" => undef) if $secure;"
NSQ_SOURCE_LINE 00000582 "\tpush(@h, \"expires\" => HTTP::Date::time2isoz($expires)) if $expires;"
NSQ_SOURCE_LINE 00000583 "\tpush(@h, \"discard\" => undef) if $discard;"
NSQ_SOURCE_LINE 00000584 "\tmy $k;"
NSQ_SOURCE_LINE 00000585 "\tfor $k (sort keys %$rest) {"
NSQ_SOURCE_LINE 00000586 "\t    push(@h, $k, $rest->{$k});"
NSQ_SOURCE_LINE 00000587 "\t}"
NSQ_SOURCE_LINE 00000588 "\tpush(@h, \"version\" => $version);"
NSQ_SOURCE_LINE 00000589 "\tpush(@res, \"Set-Cookie3: \" . join_header_words(\\@h));"
NSQ_SOURCE_LINE 00000590 "    });"
NSQ_SOURCE_LINE 00000591 "    join(\"\\n\", @res, \"\");"
NSQ_SOURCE_LINE 00000592 "}"
NSQ_SOURCE_LINE 00000593 ""
NSQ_SOURCE_LINE 00000594 "sub _host"
NSQ_SOURCE_LINE 00000595 "{"
NSQ_SOURCE_LINE 00000596 "    my($request, $url) = @_;"
NSQ_SOURCE_LINE 00000597 "    if (my $h = $request->header(\"Host\")) {"
NSQ_SOURCE_LINE 00000598 "\t$h =~ s/:\\d+$//;  # might have a port as well"
NSQ_SOURCE_LINE 00000599 "\treturn lc($h);"
NSQ_SOURCE_LINE 00000600 "    }"
NSQ_SOURCE_LINE 00000601 "    return lc($url->host);"
NSQ_SOURCE_LINE 00000602 "}"
NSQ_SOURCE_LINE 00000603 ""
NSQ_SOURCE_LINE 00000604 "sub _url_path"
NSQ_SOURCE_LINE 00000605 "{"
NSQ_SOURCE_LINE 00000606 "    my $url = shift;"
NSQ_SOURCE_LINE 00000607 "    my $path;"
NSQ_SOURCE_LINE 00000608 "    if($url->can('epath')) {"
NSQ_SOURCE_LINE 00000609 "       $path = $url->epath;    # URI::URL method"
NSQ_SOURCE_LINE 00000610 "    }"
NSQ_SOURCE_LINE 00000611 "    else {"
NSQ_SOURCE_LINE 00000612 "       $path = $url->path;           # URI::_generic method"
NSQ_SOURCE_LINE 00000613 "    }"
NSQ_SOURCE_LINE 00000614 "    $path = \"/\" unless length $path;"
NSQ_SOURCE_LINE 00000615 "    $path;"
NSQ_SOURCE_LINE 00000616 "}"
NSQ_SOURCE_LINE 00000617 ""
NSQ_SOURCE_LINE 00000618 "sub _normalize_path  # so that plain string compare can be used"
NSQ_SOURCE_LINE 00000619 "{"
NSQ_SOURCE_LINE 00000620 "    my $x;"
NSQ_SOURCE_LINE 00000621 "    $_[0] =~ s/%([0-9a-fA-F][0-9a-fA-F])/"
NSQ_SOURCE_LINE 00000622 "\t         $x = uc($1);"
NSQ_SOURCE_LINE 00000623 "                 $x eq \"2F\" || $x eq \"25\" ? \"%$x\" :"
NSQ_SOURCE_LINE 00000624 "                                            pack(\"C\", hex($x));"
NSQ_SOURCE_LINE 00000625 "              /eg;"
NSQ_SOURCE_LINE 00000626 "    $_[0] =~ s/([\\0-\\x20\\x7f-\\xff])/sprintf(\"%%%02X\",ord($1))/eg;"
NSQ_SOURCE_LINE 00000627 "}"
NSQ_SOURCE_LINE 00000628 ""
NSQ_SOURCE_LINE 00000629 "# deals with splitting values by ; and the fact that they could"
NSQ_SOURCE_LINE 00000630 "# be in quotes which can also have escaping."
NSQ_SOURCE_LINE 00000631 "sub _split_text {"
NSQ_SOURCE_LINE 00000632 "    my $val = shift;"
NSQ_SOURCE_LINE 00000633 "    my @vals = grep { $_ ne q{} } split(/([;\\\\\"])/, $val);"
NSQ_SOURCE_LINE 00000634 "    my @chunks;"
NSQ_SOURCE_LINE 00000635 "    # divide it up into chunks to be processed."
NSQ_SOURCE_LINE 00000636 "    my $in_string = 0;"
NSQ_SOURCE_LINE 00000637 "    my @current_string;"
NSQ_SOURCE_LINE 00000638 "    for(my $i = 0; $i < @vals; $i++) {"
NSQ_SOURCE_LINE 00000639 "        my $chunk = $vals[$i];"
NSQ_SOURCE_LINE 00000640 "        if($in_string) {"
NSQ_SOURCE_LINE 00000641 "            if($chunk eq q{\\\\}) {"
NSQ_SOURCE_LINE 00000642 "                # don't care about next char probably."
NSQ_SOURCE_LINE 00000643 "                # having said that, probably need to be appending to the chunks"
NSQ_SOURCE_LINE 00000644 "                # just dropping this."
NSQ_SOURCE_LINE 00000645 "                $i++;"
NSQ_SOURCE_LINE 00000646 "                if($i < @vals) {"
NSQ_SOURCE_LINE 00000647 "                    push @current_string, $vals[$i];"
NSQ_SOURCE_LINE 00000648 "                }"
NSQ_SOURCE_LINE 00000649 "            } elsif($chunk eq q{\"}) {"
NSQ_SOURCE_LINE 00000650 "                $in_string = 0;"
NSQ_SOURCE_LINE 00000651 "            }"
NSQ_SOURCE_LINE 00000652 "            else {"
NSQ_SOURCE_LINE 00000653 "                push @current_string, $chunk;"
NSQ_SOURCE_LINE 00000654 "            }"
NSQ_SOURCE_LINE 00000655 "        } else {"
NSQ_SOURCE_LINE 00000656 "            if($chunk eq q{\"}) {"
NSQ_SOURCE_LINE 00000657 "                $in_string = 1;"
NSQ_SOURCE_LINE 00000658 "            }"
NSQ_SOURCE_LINE 00000659 "            elsif($chunk eq q{;}) {"
NSQ_SOURCE_LINE 00000660 "                push @chunks, join(q{}, @current_string);"
NSQ_SOURCE_LINE 00000661 "                @current_string = ();"
NSQ_SOURCE_LINE 00000662 "            }"
NSQ_SOURCE_LINE 00000663 "            else {"
NSQ_SOURCE_LINE 00000664 "                push @current_string, $chunk;"
NSQ_SOURCE_LINE 00000665 "            }"
NSQ_SOURCE_LINE 00000666 "        }"
NSQ_SOURCE_LINE 00000667 "    }"
NSQ_SOURCE_LINE 00000668 "    push @chunks, join(q{}, @current_string) if @current_string;"
NSQ_SOURCE_LINE 00000669 "    s/^\\s+// for @chunks;"
NSQ_SOURCE_LINE 00000670 "    return \\@chunks;"
NSQ_SOURCE_LINE 00000671 "}"
NSQ_SOURCE_LINE 00000672 ""
NSQ_SOURCE_LINE 00000673 "1;"
NSQ_SOURCE_LINE 00000674 ""
NSQ_SOURCE_LINE 00000675 "=pod"
NSQ_SOURCE_LINE 00000676 ""
NSQ_SOURCE_LINE 00000677 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000678 ""
NSQ_SOURCE_LINE 00000679 "=head1 NAME"
NSQ_SOURCE_LINE 00000680 ""
NSQ_SOURCE_LINE 00000681 "HTTP::Cookies - HTTP cookie jars"
NSQ_SOURCE_LINE 00000682 ""
NSQ_SOURCE_LINE 00000683 "=head1 VERSION"
NSQ_SOURCE_LINE 00000684 ""
NSQ_SOURCE_LINE 00000685 "version 6.11"
NSQ_SOURCE_LINE 00000686 ""
NSQ_SOURCE_LINE 00000687 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000688 ""
NSQ_SOURCE_LINE 00000689 "  use HTTP::Cookies;"
NSQ_SOURCE_LINE 00000690 "  $cookie_jar = HTTP::Cookies->new("
NSQ_SOURCE_LINE 00000691 "    file => \"$ENV{'HOME'}/lwp_cookies.dat\","
NSQ_SOURCE_LINE 00000692 "    autosave => 1,"
NSQ_SOURCE_LINE 00000693 "  );"
NSQ_SOURCE_LINE 00000694 ""
NSQ_SOURCE_LINE 00000695 "  use LWP;"
NSQ_SOURCE_LINE 00000696 "  my $browser = LWP::UserAgent->new;"
NSQ_SOURCE_LINE 00000697 "  $browser->cookie_jar($cookie_jar);"
NSQ_SOURCE_LINE 00000698 ""
NSQ_SOURCE_LINE 00000699 "Or for an empty and temporary cookie jar:"
NSQ_SOURCE_LINE 00000700 ""
NSQ_SOURCE_LINE 00000701 "  use LWP;"
NSQ_SOURCE_LINE 00000702 "  my $browser = LWP::UserAgent->new;"
NSQ_SOURCE_LINE 00000703 "  $browser->cookie_jar( {} );"
NSQ_SOURCE_LINE 00000704 ""
NSQ_SOURCE_LINE 00000705 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000706 ""
NSQ_SOURCE_LINE 00000707 "This class is for objects that represent a \"cookie jar\" -- that is, a"
NSQ_SOURCE_LINE 00000708 "database of all the HTTP cookies that a given LWP::UserAgent object"
NSQ_SOURCE_LINE 00000709 "knows about."
NSQ_SOURCE_LINE 00000710 ""
NSQ_SOURCE_LINE 00000711 "Cookies are a general mechanism which server side connections can use"
NSQ_SOURCE_LINE 00000712 "to both store and retrieve information on the client side of the"
NSQ_SOURCE_LINE 00000713 "connection.  For more information about cookies refer to"
NSQ_SOURCE_LINE 00000714 "L<Cookie Spec|http://curl.haxx.se/rfc/cookie_spec.html> and"
NSQ_SOURCE_LINE 00000715 "L<Cookie Central|http://www.cookiecentral.com>.  This module also implements the"
NSQ_SOURCE_LINE 00000716 "new style cookies described in L<RFC 2965|https://tools.ietf.org/html/rfc2965>."
NSQ_SOURCE_LINE 00000717 "The two variants of cookies are supposed to be able to coexist happily."
NSQ_SOURCE_LINE 00000718 ""
NSQ_SOURCE_LINE 00000719 "Instances of the class I<HTTP::Cookies> are able to store a collection"
NSQ_SOURCE_LINE 00000720 "of Set-Cookie2: and Set-Cookie: headers and are able to use this"
NSQ_SOURCE_LINE 00000721 "information to initialize Cookie-headers in I<HTTP::Request> objects."
NSQ_SOURCE_LINE 00000722 "The state of a I<HTTP::Cookies> object can be saved in and restored from"
NSQ_SOURCE_LINE 00000723 "files."
NSQ_SOURCE_LINE 00000724 ""
NSQ_SOURCE_LINE 00000725 "=head1 LIMITATIONS"
NSQ_SOURCE_LINE 00000726 ""
NSQ_SOURCE_LINE 00000727 "This module does not support L<< Public Suffix|https://publicsuffix.org/"
NSQ_SOURCE_LINE 00000728 ">> encouraged by a more recent standard, L<< RFC"
NSQ_SOURCE_LINE 00000729 "6265|https://tools.ietf.org/html/rfc6265 >>."
NSQ_SOURCE_LINE 00000730 ""
NSQ_SOURCE_LINE 00000731 "This module's shortcomings mean that a malicious Web site can set"
NSQ_SOURCE_LINE 00000732 "cookies to track your user agent across all sites under a top level"
NSQ_SOURCE_LINE 00000733 "domain.  See F<< t/publicsuffix.t >> in this module's distribution for"
NSQ_SOURCE_LINE 00000734 "details."
NSQ_SOURCE_LINE 00000735 ""
NSQ_SOURCE_LINE 00000736 "L<< HTTP::CookieJar::LWP >> supports Public Suffix, but only provides a"
NSQ_SOURCE_LINE 00000737 "limited subset of this module's functionality and L<< does not"
NSQ_SOURCE_LINE 00000738 "support|HTTP::CookieJar/LIMITATIONS-AND-CAVEATS >> standards older than"
NSQ_SOURCE_LINE 00000739 "I<RFC 6265>."
NSQ_SOURCE_LINE 00000740 ""
NSQ_SOURCE_LINE 00000741 "=head1 METHODS"
NSQ_SOURCE_LINE 00000742 ""
NSQ_SOURCE_LINE 00000743 "The following methods are provided:"
NSQ_SOURCE_LINE 00000744 ""
NSQ_SOURCE_LINE 00000745 "=over 4"
NSQ_SOURCE_LINE 00000746 ""
NSQ_SOURCE_LINE 00000747 "=item $cookie_jar = HTTP::Cookies->new"
NSQ_SOURCE_LINE 00000748 ""
NSQ_SOURCE_LINE 00000749 "The constructor takes hash style parameters.  The following"
NSQ_SOURCE_LINE 00000750 "parameters are recognized:"
NSQ_SOURCE_LINE 00000751 ""
NSQ_SOURCE_LINE 00000752 "  file:            name of the file to restore cookies from and save cookies to"
NSQ_SOURCE_LINE 00000753 "  autosave:        save during destruction (bool)"
NSQ_SOURCE_LINE 00000754 "  ignore_discard:  save even cookies that are requested to be discarded (bool)"
NSQ_SOURCE_LINE 00000755 "  hide_cookie2:    do not add Cookie2 header to requests"
NSQ_SOURCE_LINE 00000756 ""
NSQ_SOURCE_LINE 00000757 "Future parameters might include (not yet implemented):"
NSQ_SOURCE_LINE 00000758 ""
NSQ_SOURCE_LINE 00000759 "  max_cookies               300"
NSQ_SOURCE_LINE 00000760 "  max_cookies_per_domain    20"
NSQ_SOURCE_LINE 00000761 "  max_cookie_size           4096"
NSQ_SOURCE_LINE 00000762 ""
NSQ_SOURCE_LINE 00000763 "  no_cookies   list of domain names that we never return cookies to"
NSQ_SOURCE_LINE 00000764 ""
NSQ_SOURCE_LINE 00000765 "=item $cookie_jar->get_cookies( $url_or_domain )"
NSQ_SOURCE_LINE 00000766 ""
NSQ_SOURCE_LINE 00000767 "=item $cookie_jar->get_cookies( $url_or_domain, $cookie_key,... )"
NSQ_SOURCE_LINE 00000768 ""
NSQ_SOURCE_LINE 00000769 "Returns a hash of the cookies that applies to the given URL. If a"
NSQ_SOURCE_LINE 00000770 "domainname is given as argument, then a prefix of \"https://\" is assumed."
NSQ_SOURCE_LINE 00000771 ""
NSQ_SOURCE_LINE 00000772 "If one or more $cookie_key parameters are provided return the given values,"
NSQ_SOURCE_LINE 00000773 "or C<undef> if the cookie isn't available."
NSQ_SOURCE_LINE 00000774 ""
NSQ_SOURCE_LINE 00000775 "=item $cookie_jar->add_cookie_header( $request )"
NSQ_SOURCE_LINE 00000776 ""
NSQ_SOURCE_LINE 00000777 "The add_cookie_header() method will set the appropriate Cookie:-header"
NSQ_SOURCE_LINE 00000778 "for the I<HTTP::Request> object given as argument.  The $request must"
NSQ_SOURCE_LINE 00000779 "have a valid url attribute before this method is called."
NSQ_SOURCE_LINE 00000780 ""
NSQ_SOURCE_LINE 00000781 "=item $cookie_jar->extract_cookies( $response )"
NSQ_SOURCE_LINE 00000782 ""
NSQ_SOURCE_LINE 00000783 "The extract_cookies() method will look for Set-Cookie: and"
NSQ_SOURCE_LINE 00000784 "Set-Cookie2: headers in the I<HTTP::Response> object passed as"
NSQ_SOURCE_LINE 00000785 "argument.  Any of these headers that are found are used to update"
NSQ_SOURCE_LINE 00000786 "the state of the $cookie_jar."
NSQ_SOURCE_LINE 00000787 ""
NSQ_SOURCE_LINE 00000788 "=item $cookie_jar->set_cookie( $version, $key, $val, $path, $domain, $port, $path_spec, $secure, $maxage, $discard, \\%rest )"
NSQ_SOURCE_LINE 00000789 ""
NSQ_SOURCE_LINE 00000790 "The set_cookie() method updates the state of the $cookie_jar.  The"
NSQ_SOURCE_LINE 00000791 "$key, $val, $domain, $port and $path arguments are strings.  The"
NSQ_SOURCE_LINE 00000792 "$path_spec, $secure, $discard arguments are boolean values. The $maxage"
NSQ_SOURCE_LINE 00000793 "value is a number indicating number of seconds that this cookie will"
NSQ_SOURCE_LINE 00000794 "live.  A value of $maxage <= 0 will delete this cookie.  The $version argument"
NSQ_SOURCE_LINE 00000795 "sets the version of the cookie; the default value is 0 ( original Netscape"
NSQ_SOURCE_LINE 00000796 "spec ).  Setting $version to another value indicates the RFC to which the"
NSQ_SOURCE_LINE 00000797 "cookie conforms (e.g. version 1 for RFC 2109).  %rest defines various other"
NSQ_SOURCE_LINE 00000798 "attributes like \"Comment\" and \"CommentURL\"."
NSQ_SOURCE_LINE 00000799 ""
NSQ_SOURCE_LINE 00000800 "=item $cookie_jar->save"
NSQ_SOURCE_LINE 00000801 ""
NSQ_SOURCE_LINE 00000802 "=item $cookie_jar->save( $file )"
NSQ_SOURCE_LINE 00000803 ""
NSQ_SOURCE_LINE 00000804 "=item $cookie_jar->save( file => $file, ignore_discard => $ignore_discard )"
NSQ_SOURCE_LINE 00000805 ""
NSQ_SOURCE_LINE 00000806 "This method saves the state of the $cookie_jar to a file."
NSQ_SOURCE_LINE 00000807 "The state can then be restored later using the load() method.  If a"
NSQ_SOURCE_LINE 00000808 "filename is not specified we will use the name specified during"
NSQ_SOURCE_LINE 00000809 "construction.  If the $ignore_discard value is true (or not specified,"
NSQ_SOURCE_LINE 00000810 "but attribute I<ignore_discard> was set at cookie jar construction),"
NSQ_SOURCE_LINE 00000811 "then we will even save cookies that are marked to be discarded."
NSQ_SOURCE_LINE 00000812 ""
NSQ_SOURCE_LINE 00000813 "The default is to save a sequence of \"Set-Cookie3\" lines."
NSQ_SOURCE_LINE 00000814 "\"Set-Cookie3\" is a proprietary LWP format, not known to be compatible"
NSQ_SOURCE_LINE 00000815 "with any browser.  The I<HTTP::Cookies::Netscape> sub-class can"
NSQ_SOURCE_LINE 00000816 "be used to save in a format compatible with Netscape."
NSQ_SOURCE_LINE 00000817 ""
NSQ_SOURCE_LINE 00000818 "=item $cookie_jar->load"
NSQ_SOURCE_LINE 00000819 ""
NSQ_SOURCE_LINE 00000820 "=item $cookie_jar->load( $file )"
NSQ_SOURCE_LINE 00000821 ""
NSQ_SOURCE_LINE 00000822 "This method reads the cookies from the file and adds them to the"
NSQ_SOURCE_LINE 00000823 "$cookie_jar.  The file must be in the format written by the save()"
NSQ_SOURCE_LINE 00000824 "method."
NSQ_SOURCE_LINE 00000825 ""
NSQ_SOURCE_LINE 00000826 "=item $cookie_jar->revert"
NSQ_SOURCE_LINE 00000827 ""
NSQ_SOURCE_LINE 00000828 "This method empties the $cookie_jar and re-loads the $cookie_jar"
NSQ_SOURCE_LINE 00000829 "from the last save file."
NSQ_SOURCE_LINE 00000830 ""
NSQ_SOURCE_LINE 00000831 "=item $cookie_jar->clear"
NSQ_SOURCE_LINE 00000832 ""
NSQ_SOURCE_LINE 00000833 "=item $cookie_jar->clear( $domain )"
NSQ_SOURCE_LINE 00000834 ""
NSQ_SOURCE_LINE 00000835 "=item $cookie_jar->clear( $domain, $path )"
NSQ_SOURCE_LINE 00000836 ""
NSQ_SOURCE_LINE 00000837 "=item $cookie_jar->clear( $domain, $path, $key )"
NSQ_SOURCE_LINE 00000838 ""
NSQ_SOURCE_LINE 00000839 "Invoking this method without arguments will empty the whole"
NSQ_SOURCE_LINE 00000840 "$cookie_jar.  If given a single argument only cookies belonging to"
NSQ_SOURCE_LINE 00000841 "that domain will be removed.  If given two arguments, cookies"
NSQ_SOURCE_LINE 00000842 "belonging to the specified path within that domain are removed.  If"
NSQ_SOURCE_LINE 00000843 "given three arguments, then the cookie with the specified key, path"
NSQ_SOURCE_LINE 00000844 "and domain is removed."
NSQ_SOURCE_LINE 00000845 ""
NSQ_SOURCE_LINE 00000846 "=item $cookie_jar->clear_temporary_cookies"
NSQ_SOURCE_LINE 00000847 ""
NSQ_SOURCE_LINE 00000848 "Discard all temporary cookies. Scans for all cookies in the jar"
NSQ_SOURCE_LINE 00000849 "with either no expire field or a true C<discard> flag. To be"
NSQ_SOURCE_LINE 00000850 "called when the user agent shuts down according to RFC 2965."
NSQ_SOURCE_LINE 00000851 ""
NSQ_SOURCE_LINE 00000852 "=item $cookie_jar->scan( \\&callback )"
NSQ_SOURCE_LINE 00000853 ""
NSQ_SOURCE_LINE 00000854 "The argument is a subroutine that will be invoked for each cookie"
NSQ_SOURCE_LINE 00000855 "stored in the $cookie_jar.  The subroutine will be invoked with"
NSQ_SOURCE_LINE 00000856 "the following arguments:"
NSQ_SOURCE_LINE 00000857 ""
NSQ_SOURCE_LINE 00000858 "  0  version"
NSQ_SOURCE_LINE 00000859 "  1  key"
NSQ_SOURCE_LINE 00000860 "  2  val"
NSQ_SOURCE_LINE 00000861 "  3  path"
NSQ_SOURCE_LINE 00000862 "  4  domain"
NSQ_SOURCE_LINE 00000863 "  5  port"
NSQ_SOURCE_LINE 00000864 "  6  path_spec"
NSQ_SOURCE_LINE 00000865 "  7  secure"
NSQ_SOURCE_LINE 00000866 "  8  expires"
NSQ_SOURCE_LINE 00000867 "  9  discard"
NSQ_SOURCE_LINE 00000868 " 10  hash"
NSQ_SOURCE_LINE 00000869 ""
NSQ_SOURCE_LINE 00000870 "=item $cookie_jar->as_string"
NSQ_SOURCE_LINE 00000871 ""
NSQ_SOURCE_LINE 00000872 "=item $cookie_jar->as_string( $skip_discardables )"
NSQ_SOURCE_LINE 00000873 ""
NSQ_SOURCE_LINE 00000874 "The as_string() method will return the state of the $cookie_jar"
NSQ_SOURCE_LINE 00000875 "represented as a sequence of \"Set-Cookie3\" header lines separated by"
NSQ_SOURCE_LINE 00000876 "\"\\n\".  If $skip_discardables is TRUE, it will not return lines for"
NSQ_SOURCE_LINE 00000877 "cookies with the I<Discard> attribute."
NSQ_SOURCE_LINE 00000878 ""
NSQ_SOURCE_LINE 00000879 "=back"
NSQ_SOURCE_LINE 00000880 ""
NSQ_SOURCE_LINE 00000881 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000882 ""
NSQ_SOURCE_LINE 00000883 "L<HTTP::Cookies::Netscape>, L<HTTP::Cookies::Microsoft>"
NSQ_SOURCE_LINE 00000884 ""
