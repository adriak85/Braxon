NSQ_SOURCE_LINE 00000020 "=head1 NAME"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "PerlIO::utf8_strict - Fast and correct UTF-8 IO"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "=head1 VERSION"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "version 0.010"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 " open my $fh, '<:utf8_strict', $filename;"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "This module provides a fast and correct UTF-8 PerlIO layer. Unlike perl's default C<:utf8> layer it checks the input for correctness."
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "=head1 LAYER ARGUMENTS"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "=over 4"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "=item allow_noncharacters"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "=item allow_surrogates"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "=back"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "=head1 EXPORT"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "PerlIO::utf8_strict exports no subroutines or symbols, just a perl layer C<utf8_strict>"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "=head1 DIAGNOSTICS"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "=over 4"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "=item Can't decode ill-formed UTF-8 octet sequence <%s>"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "(F) Encountered an ill-formed UTF-8 octet sequence. <%s> contains a hexadecimal "
NSQ_SOURCE_LINE 00000057 "representation of the maximal subpart of the ill-formed subsequence."
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "=item Can't interchange noncharacter code point U+%.4X"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "(F) Noncharacters is permanently reserved for internal use and that should "
NSQ_SOURCE_LINE 00000062 "never be interchanged. Noncharacters consist of the values U+nFFFE and U+nFFFF "
NSQ_SOURCE_LINE 00000063 "(where n is from 0 to 10^16) and the values U+FDD0..U+FDEF."
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "=back"
NSQ_SOURCE_LINE 00000066 ""
