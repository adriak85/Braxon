NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000013 "our $DATE = '2024-04-17'; # DATE"
NSQ_SOURCE_LINE 00000014 "our $DIST = 'Module-Patch'; # DIST"
NSQ_SOURCE_LINE 00000015 "our $VERSION = '0.278'; # VERSION"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "our @EXPORT_OK = qw(patch_package);"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "sub is_loaded {"
NSQ_SOURCE_LINE 00000020 "    my $mod = shift;"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "    (my $mod_pm = \"$mod.pm\") =~ s!::!/!g;"
NSQ_SOURCE_LINE 00000023 "    exists($INC{$mod_pm}) && $INC{$mod_pm};"
NSQ_SOURCE_LINE 00000024 "}"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "my%loaded_by_us;"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "sub import {"
NSQ_SOURCE_LINE 00000029 "    my $self = shift;"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "    my $caller = caller;"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "    if ($self eq __PACKAGE__) {"
NSQ_SOURCE_LINE 00000034 "        # we are not subclassed, provide exports"
NSQ_SOURCE_LINE 00000035 "        for my $exp (@_) {"
NSQ_SOURCE_LINE 00000036 "            die \"$exp is not exported by \".__PACKAGE__"
NSQ_SOURCE_LINE 00000037 "                unless grep { $_ eq $exp } @EXPORT_OK;"
NSQ_SOURCE_LINE 00000038 "            *{\"$caller\\::$exp\"} = \\&{$exp};"
NSQ_SOURCE_LINE 00000039 "        }"
NSQ_SOURCE_LINE 00000040 "    } else {"
NSQ_SOURCE_LINE 00000041 "        # patch already applied, ignore"
NSQ_SOURCE_LINE 00000042 "        return if ${\"$self\\::handles\"};"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "        # get patch data from patch_data()"
NSQ_SOURCE_LINE 00000045 "        unless (${\"$self\\::patch_data_cached\"}) {"
NSQ_SOURCE_LINE 00000046 "            ${\"$self\\::patch_data_cached\"} = $self->patch_data;"
NSQ_SOURCE_LINE 00000047 "        }"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "        # we are subclassed, patch caller with patch data"
NSQ_SOURCE_LINE 00000050 "        my %opts = @_;"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "        my $load;"
NSQ_SOURCE_LINE 00000053 "        if (exists $opts{-load_target}) {"
NSQ_SOURCE_LINE 00000054 "            $load = $opts{-load_target};"
NSQ_SOURCE_LINE 00000055 "            delete $opts{-load_target};"
NSQ_SOURCE_LINE 00000056 "        }"
NSQ_SOURCE_LINE 00000057 "        $load //= ${\"$self\\::patch_data_cached\"}->{-load_target};"
NSQ_SOURCE_LINE 00000058 "        $load //= 1;"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "        my $force;"
NSQ_SOURCE_LINE 00000061 "        if (exists $opts{-force}) {"
NSQ_SOURCE_LINE 00000062 "            $force = $opts{-force};"
NSQ_SOURCE_LINE 00000063 "            delete $opts{-force};"
NSQ_SOURCE_LINE 00000064 "        }"
NSQ_SOURCE_LINE 00000065 "        $force //= ${\"$self\\::patch_data_cached\"}->{-force};"
NSQ_SOURCE_LINE 00000066 "        $force //= 0;"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "        my $warn;"
NSQ_SOURCE_LINE 00000069 "        if (exists $opts{-warn_target_loaded}) {"
NSQ_SOURCE_LINE 00000070 "            $warn = $opts{-warn_target_loaded};"
NSQ_SOURCE_LINE 00000071 "            delete $opts{-warn_target_loaded};"
NSQ_SOURCE_LINE 00000072 "        }"
NSQ_SOURCE_LINE 00000073 "        $warn //= ${\"$self\\::patch_data_cached\"}->{\"-warn_target_loaded\"};"
NSQ_SOURCE_LINE 00000074 "        $warn //= 1;"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "        my $pdata = ${\"$self\\::patch_data_cached\"} or"
NSQ_SOURCE_LINE 00000077 "            die \"BUG: $self: No patch data supplied\";"
NSQ_SOURCE_LINE 00000078 "        my $v = $pdata->{v} // 1;"
NSQ_SOURCE_LINE 00000079 "        my $curv = 3;"
NSQ_SOURCE_LINE 00000080 "        if ($v == 1 || $v == 2) {"
NSQ_SOURCE_LINE 00000081 "            my $mpv;"
NSQ_SOURCE_LINE 00000082 "            if ($v == 1) {"
NSQ_SOURCE_LINE 00000083 "                $mpv = \"0.06 or earlier\";"
NSQ_SOURCE_LINE 00000084 "            } elsif ($v == 2) {"
NSQ_SOURCE_LINE 00000085 "                $mpv = \"0.07-0.09\";"
NSQ_SOURCE_LINE 00000086 "            }"
NSQ_SOURCE_LINE 00000087 "            die \"$self \".( ${\"$self\\::VERSION\" } // \"?\" )."
NSQ_SOURCE_LINE 00000088 "                \" requires Module::Patch $mpv (patch_data format v=$v),\"."
NSQ_SOURCE_LINE 00000089 "                \" this is Module::Patch \".($Module::Patch::VERSION // '?')."
NSQ_SOURCE_LINE 00000090 "                \" (v=$curv), please install an older version of \"."
NSQ_SOURCE_LINE 00000091 "                \"Module::Patch or upgrade $self\";"
NSQ_SOURCE_LINE 00000092 "        } elsif ($v == 3) {"
NSQ_SOURCE_LINE 00000093 "            # ok, current version"
NSQ_SOURCE_LINE 00000094 "        } else {"
NSQ_SOURCE_LINE 00000095 "            die \"BUG: $self: Unknown patch_data format version ($v), \"."
NSQ_SOURCE_LINE 00000096 "                \"only v=$curv supported by this version of Module::Patch\";"
NSQ_SOURCE_LINE 00000097 "        }"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "        my $target = $self;"
NSQ_SOURCE_LINE 00000100 "        $target =~ s/(?<=\\w)::[Pp]atch::\\w+$//"
NSQ_SOURCE_LINE 00000101 "            or die \"BUG: $self: Bad patch module name '$target', it should \"."
NSQ_SOURCE_LINE 00000102 "                \"end with '::Patch::YourCategory'\";"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "        if (is_loaded($target)) {"
NSQ_SOURCE_LINE 00000105 "            if (!$loaded_by_us{$target}) {"
NSQ_SOURCE_LINE 00000106 "                if ($load && $warn) {"
NSQ_SOURCE_LINE 00000107 "                    warn \"$target is loaded before \".__PACKAGE__.\", this is \"."
NSQ_SOURCE_LINE 00000108 "                        \"not recommended since $target might export subs \"."
NSQ_SOURCE_LINE 00000109 "                        \"before \" . __PACKAGE__.\" gets the chance to patch \" ."
NSQ_SOURCE_LINE 00000110 "                        \"them\";"
NSQ_SOURCE_LINE 00000111 "                }"
NSQ_SOURCE_LINE 00000112 "            }"
NSQ_SOURCE_LINE 00000113 "        } else {"
NSQ_SOURCE_LINE 00000114 "            if ($load) {"
NSQ_SOURCE_LINE 00000115 "                eval \"package $caller; use $target\"; ## no critic: BuiltinFunctions::ProhibitStringyEval"
NSQ_SOURCE_LINE 00000116 "                die if $@;"
NSQ_SOURCE_LINE 00000117 "                $loaded_by_us{$target}++;"
NSQ_SOURCE_LINE 00000118 "            } else {"
NSQ_SOURCE_LINE 00000119 "                if ($warn) {"
NSQ_SOURCE_LINE 00000120 "                    warn \"$target does not exist and we are told not to load \"."
NSQ_SOURCE_LINE 00000121 "                        \"it, skipped patching\";"
NSQ_SOURCE_LINE 00000122 "                }"
NSQ_SOURCE_LINE 00000123 "                return;"
NSQ_SOURCE_LINE 00000124 "            }"
NSQ_SOURCE_LINE 00000125 "        }"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "        # read patch module's configs"
NSQ_SOURCE_LINE 00000128 "        no warnings 'once';"
NSQ_SOURCE_LINE 00000129 "        my $pcdata = $pdata->{config} // {};"
NSQ_SOURCE_LINE 00000130 "        my $config = \\%{\"$self\\::config\"};"
NSQ_SOURCE_LINE 00000131 "        while (my ($k, $v) = each %$pcdata) {"
NSQ_SOURCE_LINE 00000132 "            die \"Invalid configuration defined by $self\\::patch_data(): \"."
NSQ_SOURCE_LINE 00000133 "                \"$k: must start with dash\" unless $k =~ /\\A-/;"
NSQ_SOURCE_LINE 00000134 "            $config->{$k} = $v->{default};"
NSQ_SOURCE_LINE 00000135 "            if (exists $opts{$k}) {"
NSQ_SOURCE_LINE 00000136 "                $config->{$k} = $opts{$k};"
NSQ_SOURCE_LINE 00000137 "                delete $opts{$k};"
NSQ_SOURCE_LINE 00000138 "            }"
NSQ_SOURCE_LINE 00000139 "        }"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "        if (keys %opts) {"
NSQ_SOURCE_LINE 00000142 "            die \"$self: Unknown option(s): \".join(\", \", keys %opts);"
NSQ_SOURCE_LINE 00000143 "        }"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "        if ($pdata->{after_read_config}) {"
NSQ_SOURCE_LINE 00000146 "            $pdata->{after_read_config}->();"
NSQ_SOURCE_LINE 00000147 "        }"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "        if ($pdata->{before_patch}) {"
NSQ_SOURCE_LINE 00000150 "            $pdata->{before_patch}->();"
NSQ_SOURCE_LINE 00000151 "        }"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "        log_trace \"Module::Patch: patching $target with $self ...\";"
NSQ_SOURCE_LINE 00000154 "        ${\"$self\\::handles\"} = patch_package("
NSQ_SOURCE_LINE 00000155 "            $target, $pdata->{patches},"
NSQ_SOURCE_LINE 00000156 "            {force=>$force, patch_module=>ref($self) || $self});"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "        if ($pdata->{after_patch}) {"
NSQ_SOURCE_LINE 00000159 "            $pdata->{after_patch}->();"
NSQ_SOURCE_LINE 00000160 "        }"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "    }"
NSQ_SOURCE_LINE 00000163 "}"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "sub unimport {"
NSQ_SOURCE_LINE 00000166 "    my $self = shift;"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "    if ($self eq __PACKAGE__) {"
NSQ_SOURCE_LINE 00000169 "        # we are not subclassed, do nothing"
NSQ_SOURCE_LINE 00000170 "    } else {"
NSQ_SOURCE_LINE 00000171 "        my $pdata = ${\"$self\\::patch_data_cached\"} or"
NSQ_SOURCE_LINE 00000172 "            die \"BUG: $self: No patch data supplied\";"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "        if ($pdata->{before_unpatch}) {"
NSQ_SOURCE_LINE 00000175 "            $pdata->{before_unpatch}->();"
NSQ_SOURCE_LINE 00000176 "        }"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "        my $handles = ${\"$self\\::handles\"};"
NSQ_SOURCE_LINE 00000179 "        log_trace \"Module::Patch: Unpatching $self ...\";"
NSQ_SOURCE_LINE 00000180 "        undef ${\"$self\\::handles\"};"
NSQ_SOURCE_LINE 00000181 "        # do we need to undef ${\"$self\\::config\"}?, i'm thinking not really"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "        if ($pdata->{after_unpatch}) {"
NSQ_SOURCE_LINE 00000184 "            $pdata->{after_unpatch}->();"
NSQ_SOURCE_LINE 00000185 "        }"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "    }"
NSQ_SOURCE_LINE 00000188 "}"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "sub patch_data {"
NSQ_SOURCE_LINE 00000191 "    die \"BUG: patch_data() should be provided by subclass\";"
NSQ_SOURCE_LINE 00000192 "}"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "sub patch_package {"
NSQ_SOURCE_LINE 00000195 "    my ($package0, $patches_spec, $opts) = @_;"
NSQ_SOURCE_LINE 00000196 "    $opts //= {};"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "    my $handles = {};"
NSQ_SOURCE_LINE 00000199 "    for my $target (ref($package0) eq 'ARRAY' ? @$package0 : ($package0)) {"
NSQ_SOURCE_LINE 00000200 "        die \"FATAL: Target module '$target' not loaded\""
NSQ_SOURCE_LINE 00000201 "            unless package_exists($target);"
NSQ_SOURCE_LINE 00000202 "        my $target_version = ${\"$target\\::VERSION\"};"
NSQ_SOURCE_LINE 00000203 "        my $target_subs;"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "        my $i = 0;"
NSQ_SOURCE_LINE 00000206 "      PATCH:"
NSQ_SOURCE_LINE 00000207 "        for my $pspec (@$patches_spec) {"
NSQ_SOURCE_LINE 00000208 "            my $act = $pspec->{action};"
NSQ_SOURCE_LINE 00000209 "            my $errp = ($opts->{patch_module} ? \"$opts->{patch_module}: \":\"\")."
NSQ_SOURCE_LINE 00000210 "                \"patch[$i]\"; # error prefix"
NSQ_SOURCE_LINE 00000211 "            $act or die \"BUG: $errp: no action supplied\";"
NSQ_SOURCE_LINE 00000212 "            $act =~ /\\A(wrap|add|replace|add_or_replace|delete)\\z/ or die"
NSQ_SOURCE_LINE 00000213 "                \"BUG: $errp: action '$pspec->{action}' unknown\";"
NSQ_SOURCE_LINE 00000214 "            if ($act eq 'delete') {"
NSQ_SOURCE_LINE 00000215 "                $pspec->{code} and die \"BUG: $errp: for action 'delete', \"."
NSQ_SOURCE_LINE 00000216 "                    \"code must not be supplied\";"
NSQ_SOURCE_LINE 00000217 "            } else {"
NSQ_SOURCE_LINE 00000218 "                $pspec->{code} or die \"BUG: $errp: code not supplied\";"
NSQ_SOURCE_LINE 00000219 "            }"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "            my $sub_names = ref($pspec->{sub_name}) eq 'ARRAY' ?"
NSQ_SOURCE_LINE 00000222 "                [@{ $pspec->{sub_name} }] : [$pspec->{sub_name}];"
NSQ_SOURCE_LINE 00000223 "            for (@$sub_names) {"
NSQ_SOURCE_LINE 00000224 "                $_ = qr/.*/    if $_ eq ':all';"
NSQ_SOURCE_LINE 00000225 "                $_ = qr/^_/    if $_ eq ':private';"
NSQ_SOURCE_LINE 00000226 "                $_ = qr/^[^_]/ if $_ eq ':public';"
NSQ_SOURCE_LINE 00000227 "                die \"BUG: $errp: unknown tag in sub_name $_\" if /^:/;"
NSQ_SOURCE_LINE 00000228 "            }"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "            my @s;"
NSQ_SOURCE_LINE 00000231 "            for my $sub_name (@$sub_names) {"
NSQ_SOURCE_LINE 00000232 "                if (ref($sub_name) eq 'Regexp') {"
NSQ_SOURCE_LINE 00000233 "                    unless ($target_subs) {"
NSQ_SOURCE_LINE 00000234 "                        $target_subs = [Package::Stash->new($target)->list_all_symbols(\"CODE\")];"
NSQ_SOURCE_LINE 00000235 "                    }"
NSQ_SOURCE_LINE 00000236 "                    for (@$target_subs) {"
NSQ_SOURCE_LINE 00000237 "                        push @s, $_ if $_ !~~ @s && $_ =~ $sub_name;"
NSQ_SOURCE_LINE 00000238 "                    }"
NSQ_SOURCE_LINE 00000239 "                } else {"
NSQ_SOURCE_LINE 00000240 "                    push @s, $sub_name;"
NSQ_SOURCE_LINE 00000241 "                }"
NSQ_SOURCE_LINE 00000242 "            }"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "            unless (!defined($pspec->{mod_version}) ||"
NSQ_SOURCE_LINE 00000245 "                        $pspec->{mod_version} eq ':all') {"
NSQ_SOURCE_LINE 00000246 "                defined($target_version) && length($target_version)"
NSQ_SOURCE_LINE 00000247 "                    or die \"FATAL: Target package '$target' does not have \"."
NSQ_SOURCE_LINE 00000248 "                    \"\\$VERSION\";"
NSQ_SOURCE_LINE 00000249 "                my $mod_versions = $pspec->{mod_version};"
NSQ_SOURCE_LINE 00000250 "                $mod_versions = ref($mod_versions) eq 'ARRAY' ?"
NSQ_SOURCE_LINE 00000251 "                    [@$mod_versions] : [$mod_versions];"
NSQ_SOURCE_LINE 00000252 "                for (@$mod_versions) {"
NSQ_SOURCE_LINE 00000253 "                    $_ = qr/.*/    if $_ eq ':all';"
NSQ_SOURCE_LINE 00000254 "                    die \"BUG: $errp: unknown tag in mod_version $_\""
NSQ_SOURCE_LINE 00000255 "                        if /^:/;"
NSQ_SOURCE_LINE 00000256 "                }"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "                unless (grep {"
NSQ_SOURCE_LINE 00000259 "                    ref($_) eq 'Regexp' ? $target_version =~ $_ : $target_version eq $_"
NSQ_SOURCE_LINE 00000260 "                } @$mod_versions) {"
NSQ_SOURCE_LINE 00000261 "                    warn \"$errp: Target module version $target_version \"."
NSQ_SOURCE_LINE 00000262 "                        \"does not match [\".join(\", \", @$mod_versions).\"], \"."
NSQ_SOURCE_LINE 00000263 "                        ($opts->{force} ?"
NSQ_SOURCE_LINE 00000264 "                         \"patching anyway (force)\":\"skipped\"). \".\";"
NSQ_SOURCE_LINE 00000265 "                    next PATCH unless $opts->{force};"
NSQ_SOURCE_LINE 00000266 "                }"
NSQ_SOURCE_LINE 00000267 "            }"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "            for my $s (@s) {"
NSQ_SOURCE_LINE 00000270 "                #log_trace(\"Patching %s ...\", $s);"
NSQ_SOURCE_LINE 00000271 "                $handles->{\"$target\\::$s\"} ="
NSQ_SOURCE_LINE 00000272 "                    Monkey::Patch::Action::patch_package("
NSQ_SOURCE_LINE 00000273 "                        $target, $s, $act, $pspec->{code});"
NSQ_SOURCE_LINE 00000274 "            }"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "            $i++;"
NSQ_SOURCE_LINE 00000277 "        } # for $pspec"
NSQ_SOURCE_LINE 00000278 "    } # for $target"
NSQ_SOURCE_LINE 00000279 "    $handles;"
NSQ_SOURCE_LINE 00000280 "}"
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "1;"
NSQ_SOURCE_LINE 00000283 "# ABSTRACT: Patch package with a set of patches"
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "__END__"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "=pod"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "=head1 NAME"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "Module::Patch - Patch package with a set of patches"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "=head1 VERSION"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "This document describes version 0.278 of Module::Patch (from Perl distribution Module-Patch), released on 2024-04-17."
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "In this example, we're patching L<HTTP::Tiny> to add automatic retrying."
NSQ_SOURCE_LINE 00000302 "L<Module::Patch> can be used in two ways: either directly or via creating your"
NSQ_SOURCE_LINE 00000303 "own patch module based on Module::Patch."
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "=head2 Using Module::Patch directly"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 " use Module::Patch qw(patch_package);"
NSQ_SOURCE_LINE 00000308 " use Log::ger;"
NSQ_SOURCE_LINE 00000309 " my $handle = patch_package('HTTP::Tiny', ["
NSQ_SOURCE_LINE 00000310 "     {"
NSQ_SOURCE_LINE 00000311 "         action      => 'wrap',"
NSQ_SOURCE_LINE 00000312 "         mod_version => qr/^0\\.*/,"
NSQ_SOURCE_LINE 00000313 "         sub_name    => 'request',"
NSQ_SOURCE_LINE 00000314 "         code        => sub {"
NSQ_SOURCE_LINE 00000315 "             my $ctx = shift;"
NSQ_SOURCE_LINE 00000316 "             my $orig = $ctx->{orig};"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "             my ($self, $method, $url) = @_;"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "             my $retries = 0;"
NSQ_SOURCE_LINE 00000321 "             my $res;"
NSQ_SOURCE_LINE 00000322 "             while (1) {"
NSQ_SOURCE_LINE 00000323 "                 $res = $orig->(@_);"
NSQ_SOURCE_LINE 00000324 "                 return $res if $res->{status} !~ /\\A[5]/; # only retry 5xx responses"
NSQ_SOURCE_LINE 00000325 "                 last if $retries >= $config{-retries};"
NSQ_SOURCE_LINE 00000326 "                 $retries++;"
NSQ_SOURCE_LINE 00000327 "                 log_trace \"Failed requesting $url ($res->{status} - $res->{reason}), retrying\" ."
NSQ_SOURCE_LINE 00000328 "                     ($config{-delay} ? \" in $config{-delay} second(s)\" : \"\") ."
NSQ_SOURCE_LINE 00000329 "                     \" ($retries of $config{-retries}) ...\";"
NSQ_SOURCE_LINE 00000330 "                 sleep $config{-delay};"
NSQ_SOURCE_LINE 00000331 "             }"
NSQ_SOURCE_LINE 00000332 "             $res;"
NSQ_SOURCE_LINE 00000333 "         };"
NSQ_SOURCE_LINE 00000334 "     },"
NSQ_SOURCE_LINE 00000335 " ]);"
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 " # do stuffs with HTTP::Tiny"
NSQ_SOURCE_LINE 00000338 " my $res = HTTP::Tiny->new->request(...);"
NSQ_SOURCE_LINE 00000339 " ..."
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 " # unpatch, restore original subroutines/methods"
NSQ_SOURCE_LINE 00000342 " undef $handle;"
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "=head2 Creating patch module by subclassing Module::Patch"
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "In your patch module F<lib/HTTP/Tiny/Patch/Retry.pm>:"
NSQ_SOURCE_LINE 00000347 ""
NSQ_SOURCE_LINE 00000348 " package HTTP::Tiny::Patch::Retry;"
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 " use parent qw(Module::Patch);"
NSQ_SOURCE_LINE 00000351 " use Log::ger;"
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 " our %config;"
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 " sub patch_data {"
NSQ_SOURCE_LINE 00000356 "     return {"
NSQ_SOURCE_LINE 00000357 "         v => 3,"
NSQ_SOURCE_LINE 00000358 "         config => {"
NSQ_SOURCE_LINE 00000359 "             -delay => {"
NSQ_SOURCE_LINE 00000360 "                 summary => 'Number of seconds to wait between retries',"
NSQ_SOURCE_LINE 00000361 "                 schema  => 'nonnegint*',"
NSQ_SOURCE_LINE 00000362 "                 default => 2,"
NSQ_SOURCE_LINE 00000363 "             },"
NSQ_SOURCE_LINE 00000364 "             -retries => {"
NSQ_SOURCE_LINE 00000365 "                 summary => 'Maximum number of retries to perform consecutively on a request (0=disable retry)',"
NSQ_SOURCE_LINE 00000366 "                 schema  => 'nonnegint*',"
NSQ_SOURCE_LINE 00000367 "                 default => 3,"
NSQ_SOURCE_LINE 00000368 "             },"
NSQ_SOURCE_LINE 00000369 "         },"
NSQ_SOURCE_LINE 00000370 "         patches => ["
NSQ_SOURCE_LINE 00000371 "             {"
NSQ_SOURCE_LINE 00000372 "                 action      => 'wrap',"
NSQ_SOURCE_LINE 00000373 "                 mod_version => qr/^0\\.*/,"
NSQ_SOURCE_LINE 00000374 "                 sub_name    => 'request',"
NSQ_SOURCE_LINE 00000375 "                 code        => sub {"
NSQ_SOURCE_LINE 00000376 "                     my $ctx = shift;"
NSQ_SOURCE_LINE 00000377 "                     my $orig = $ctx->{orig};"
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "                     my ($self, $method, $url) = @_;"
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "                     my $retries = 0;"
NSQ_SOURCE_LINE 00000382 "                     my $res;"
NSQ_SOURCE_LINE 00000383 "                     while (1) {"
NSQ_SOURCE_LINE 00000384 "                         $res = $orig->(@_);"
NSQ_SOURCE_LINE 00000385 "                         return $res if $res->{status} !~ /\\A[5]/; # only retry 5xx responses"
NSQ_SOURCE_LINE 00000386 "                         last if $retries >= $config{-retries};"
NSQ_SOURCE_LINE 00000387 "                         $retries++;"
NSQ_SOURCE_LINE 00000388 "                         log_trace \"Failed requesting $url ($res->{status} - $res->{reason}), retrying\" ."
NSQ_SOURCE_LINE 00000389 "                             ($config{-delay} ? \" in $config{-delay} second(s)\" : \"\") ."
NSQ_SOURCE_LINE 00000390 "                             \" ($retries of $config{-retries}) ...\";"
NSQ_SOURCE_LINE 00000391 "                         sleep $config{-delay};"
NSQ_SOURCE_LINE 00000392 "                     }"
NSQ_SOURCE_LINE 00000393 "                     $res;"
NSQ_SOURCE_LINE 00000394 "                 };"
NSQ_SOURCE_LINE 00000395 "             },"
NSQ_SOURCE_LINE 00000396 "         ], # patches"
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "         # other Module::Patch import options can be specified here"
NSQ_SOURCE_LINE 00000399 "         # -load_target => 1,"
NSQ_SOURCE_LINE 00000400 "         # -warn_target_loaded => 1,"
NSQ_SOURCE_LINE 00000401 "         # -force => 0,"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "     };"
NSQ_SOURCE_LINE 00000404 " }"
NSQ_SOURCE_LINE 00000405 " 1;"
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "Using your patch module in Perl:"
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 " use HTTP::Tiny::Patch::Retry"
NSQ_SOURCE_LINE 00000410 "     -retries => 4,  # optional, default is 3 as per configuration"
NSQ_SOURCE_LINE 00000411 "     -delay   => 5,  # optional, default is 2 as per configuration"
NSQ_SOURCE_LINE 00000412 " ;"
NSQ_SOURCE_LINE 00000413 ""
NSQ_SOURCE_LINE 00000414 " # do stuffs with HTTP::Tiny"
NSQ_SOURCE_LINE 00000415 " my $res = HTTP::Tiny->new->request(...);"
NSQ_SOURCE_LINE 00000416 ""
NSQ_SOURCE_LINE 00000417 " # unpatch, restore original subroutines/methods in target module (HTTP::Tiny)"
NSQ_SOURCE_LINE 00000418 " HTTP::Tiny::Patch::Retry->unimport;"
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "To patch locally:"
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 " use HTTP::Tiny::Patch::Retry ();"
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 " sub get_data {"
NSQ_SOURCE_LINE 00000425 "     HTTP::Tiny::Patch::Retry->import;"
NSQ_SOURCE_LINE 00000426 "     my $res = HTTP::TIny->new->request(...);"
NSQ_SOURCE_LINE 00000427 "     HTTP::Tiny::Patch::Retry->unimport;"
NSQ_SOURCE_LINE 00000428 "     $res;"
NSQ_SOURCE_LINE 00000429 " }"
NSQ_SOURCE_LINE 00000430 ""
NSQ_SOURCE_LINE 00000431 "Using your patch module on the command-line:"
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 " % perl -MHTTP::Tiny::Patch::Retry -E'my $res = HTTP::Tiny->new->request(...); ...'"
NSQ_SOURCE_LINE 00000434 ""
NSQ_SOURCE_LINE 00000435 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000436 ""
NSQ_SOURCE_LINE 00000437 "Module::Patch is basically a convenient way to define and bundle a set of"
NSQ_SOURCE_LINE 00000438 "patches. Actual patching is done by L<Monkey::Patch::Action>, which provides"
NSQ_SOURCE_LINE 00000439 "lexically scoped patching."
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "There are two ways to use this module:"
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "=over 4"
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "=item * subclass it"
NSQ_SOURCE_LINE 00000446 ""
NSQ_SOURCE_LINE 00000447 "This is used for convenient bundling of patches. You create a I<patch module> (a"
NSQ_SOURCE_LINE 00000448 "module that monkey-patches other module by adding/replacing/wrapping/deleting"
NSQ_SOURCE_LINE 00000449 "subroutines of target module) by subclassing Module::Patch and providing the"
NSQ_SOURCE_LINE 00000450 "patches specification in patch_data() method."
NSQ_SOURCE_LINE 00000451 ""
NSQ_SOURCE_LINE 00000452 "Patch module should be named I<Some::Module>::Patch::I<YourCategory>."
NSQ_SOURCE_LINE 00000453 "I<YourCategory> should be a keyword or phrase (verb + obj) that describes what"
NSQ_SOURCE_LINE 00000454 "the patch does. For example, L<HTTP::Daemon::Patch::IPv6>,"
NSQ_SOURCE_LINE 00000455 "L<LWP::UserAgent::Patch::LogResponse>."
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "Patch module should be use()'d, or require()'d + import()'ed instead of just"
NSQ_SOURCE_LINE 00000458 "require()'d, because the patching is done in import()."
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "=item * require/import it directly"
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 "Module::Patch provides B<patch_package> which is the actual routine to do the"
NSQ_SOURCE_LINE 00000463 "patching."
NSQ_SOURCE_LINE 00000464 ""
NSQ_SOURCE_LINE 00000465 "=back"
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "=for Pod::Coverage ^(unimport|patch_data|is_loaded)$"
NSQ_SOURCE_LINE 00000468 ""
NSQ_SOURCE_LINE 00000469 "=head1 PATCH DATA SPECIFICATION"
NSQ_SOURCE_LINE 00000470 ""
NSQ_SOURCE_LINE 00000471 "Patch data must be stored in C<patch_data()> subroutine. It must be a L<DefHash>"
NSQ_SOURCE_LINE 00000472 "(i.e. a regular Perl hash) with the following known properties:"
NSQ_SOURCE_LINE 00000473 ""
NSQ_SOURCE_LINE 00000474 "=over"
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 "=item * v => int"
NSQ_SOURCE_LINE 00000477 ""
NSQ_SOURCE_LINE 00000478 "Must be 3 (current version)."
NSQ_SOURCE_LINE 00000479 ""
NSQ_SOURCE_LINE 00000480 "=item * patches => array"
NSQ_SOURCE_LINE 00000481 ""
NSQ_SOURCE_LINE 00000482 "Will be passed to C<patch_package()>."
NSQ_SOURCE_LINE 00000483 ""
NSQ_SOURCE_LINE 00000484 "=item * config => hash"
NSQ_SOURCE_LINE 00000485 ""
NSQ_SOURCE_LINE 00000486 "A hash of name and config specifications. Config specification is another"
NSQ_SOURCE_LINE 00000487 "DefHash and can contain the following properties: C<schema> (a L<Sah> schema),"
NSQ_SOURCE_LINE 00000488 "C<default> (default value)."
NSQ_SOURCE_LINE 00000489 ""
NSQ_SOURCE_LINE 00000490 "=item * after_read_config => coderef"
NSQ_SOURCE_LINE 00000491 ""
NSQ_SOURCE_LINE 00000492 "A hook to run after patch module is imported and configuration has been read."
NSQ_SOURCE_LINE 00000493 ""
NSQ_SOURCE_LINE 00000494 "=item * before_patch => coderef"
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "=item * after_patch => coderef"
NSQ_SOURCE_LINE 00000497 ""
NSQ_SOURCE_LINE 00000498 "=item * before_unpatch => coderef"
NSQ_SOURCE_LINE 00000499 ""
NSQ_SOURCE_LINE 00000500 "=item * after_unpatch => coderef"
NSQ_SOURCE_LINE 00000501 ""
NSQ_SOURCE_LINE 00000502 "=back"
NSQ_SOURCE_LINE 00000503 ""
NSQ_SOURCE_LINE 00000504 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000505 ""
NSQ_SOURCE_LINE 00000506 "=head2 import"
NSQ_SOURCE_LINE 00000507 ""
NSQ_SOURCE_LINE 00000508 "If imported directly, will export @exports as arguments and export requested"
NSQ_SOURCE_LINE 00000509 "symbols."
NSQ_SOURCE_LINE 00000510 ""
NSQ_SOURCE_LINE 00000511 "If imported from subclass, will take %opts as arguments and run patch_package()"
NSQ_SOURCE_LINE 00000512 "on caller package. %opts include:"
NSQ_SOURCE_LINE 00000513 ""
NSQ_SOURCE_LINE 00000514 "=over 4"
NSQ_SOURCE_LINE 00000515 ""
NSQ_SOURCE_LINE 00000516 "=item * -load_target => BOOL (default 1)"
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "Load target modules. Set to 0 if package is already defined in other files and"
NSQ_SOURCE_LINE 00000519 "cannot be require()-ed."
NSQ_SOURCE_LINE 00000520 ""
NSQ_SOURCE_LINE 00000521 "=item * -warn_target_loaded => BOOL (default 1)"
NSQ_SOURCE_LINE 00000522 ""
NSQ_SOURCE_LINE 00000523 "If set to false, do not warn if target modules are loaded before the patch"
NSQ_SOURCE_LINE 00000524 "module. By default, it warns to prevent users making the mistake of importing"
NSQ_SOURCE_LINE 00000525 "subroutines from target modules before they are patched."
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 "=item * -force => BOOL"
NSQ_SOURCE_LINE 00000528 ""
NSQ_SOURCE_LINE 00000529 "Will be passed to patch_package's \\%opts."
NSQ_SOURCE_LINE 00000530 ""
NSQ_SOURCE_LINE 00000531 "=back"
NSQ_SOURCE_LINE 00000532 ""
NSQ_SOURCE_LINE 00000533 "=head2 patch_package"
NSQ_SOURCE_LINE 00000534 ""
NSQ_SOURCE_LINE 00000535 "Usage:"
NSQ_SOURCE_LINE 00000536 ""
NSQ_SOURCE_LINE 00000537 " my $handle = patch_package($package, $patches_spec, \\%opts);"
NSQ_SOURCE_LINE 00000538 ""
NSQ_SOURCE_LINE 00000539 "Patch target package C<$package> with a set of patches."
NSQ_SOURCE_LINE 00000540 ""
NSQ_SOURCE_LINE 00000541 "C<$patches_spec> is an arrayref containing a series of patches specifications."
NSQ_SOURCE_LINE 00000542 "Each patch specification is a hashref containing these keys: C<action> (string,"
NSQ_SOURCE_LINE 00000543 "required; either 'wrap', 'add', 'replace', 'add_or_replace', 'delete'),"
NSQ_SOURCE_LINE 00000544 "C<mod_version> (string/regex or array of string/regex, can be ':all' to mean all"
NSQ_SOURCE_LINE 00000545 "versions; optional; defaults to ':all'). C<sub_name> (string/regex or array of"
NSQ_SOURCE_LINE 00000546 "string/regex, subroutine(s) to patch, can be ':all' to mean all subroutine,"
NSQ_SOURCE_LINE 00000547 "':public' to mean all public subroutines [those not prefixed by C<_>],"
NSQ_SOURCE_LINE 00000548 "':private' to mean all private), C<code> (coderef, not required if C<action> is"
NSQ_SOURCE_LINE 00000549 "'delete')."
NSQ_SOURCE_LINE 00000550 ""
NSQ_SOURCE_LINE 00000551 "Die if there is conflict with other patch modules, for example if target module"
NSQ_SOURCE_LINE 00000552 "has been patched 'delete' and another patch wants to 'wrap' it."
NSQ_SOURCE_LINE 00000553 ""
NSQ_SOURCE_LINE 00000554 "Known options:"
NSQ_SOURCE_LINE 00000555 ""
NSQ_SOURCE_LINE 00000556 "=over 4"
NSQ_SOURCE_LINE 00000557 ""
NSQ_SOURCE_LINE 00000558 "=item * force => BOOL (default 0)"
NSQ_SOURCE_LINE 00000559 ""
NSQ_SOURCE_LINE 00000560 "Force patching even if target module version does not match. The default is to"
NSQ_SOURCE_LINE 00000561 "warn and skip patching."
NSQ_SOURCE_LINE 00000562 ""
NSQ_SOURCE_LINE 00000563 "=back"
NSQ_SOURCE_LINE 00000564 ""
NSQ_SOURCE_LINE 00000565 "=head1 FAQ"
NSQ_SOURCE_LINE 00000566 ""
NSQ_SOURCE_LINE 00000567 "=head2 Why patch? Why not subclass the target module?"
NSQ_SOURCE_LINE 00000568 ""
NSQ_SOURCE_LINE 00000569 "Sometimes the target module is not easily subclassable or at all. But even if"
NSQ_SOURCE_LINE 00000570 "the target module is subclassable, all client code must explicitly use the"
NSQ_SOURCE_LINE 00000571 "subclass. Patching allows us to modify behavior of a target module without"
NSQ_SOURCE_LINE 00000572 "changing any client code that use that module."
NSQ_SOURCE_LINE 00000573 ""
NSQ_SOURCE_LINE 00000574 "=head2 Why create a patch module? Why not submit patches to the module's author?"
NSQ_SOURCE_LINE 00000575 ""
NSQ_SOURCE_LINE 00000576 "Not all patches are potentials for inclusion into the upstream (target module)."
NSQ_SOURCE_LINE 00000577 "But even if a patch is, creating and releasing a patch module can get you"
NSQ_SOURCE_LINE 00000578 "something working sooner (while you wait for the original author to respond to"
NSQ_SOURCE_LINE 00000579 "your patch, if ever)."
NSQ_SOURCE_LINE 00000580 ""
NSQ_SOURCE_LINE 00000581 "=head2 This module does not work! The target module does not get patched!"
NSQ_SOURCE_LINE 00000582 ""
NSQ_SOURCE_LINE 00000583 "It probably does. Some of the common mistakes are:"
NSQ_SOURCE_LINE 00000584 ""
NSQ_SOURCE_LINE 00000585 "=over"
NSQ_SOURCE_LINE 00000586 ""
NSQ_SOURCE_LINE 00000587 "=item * Not storing the handle"
NSQ_SOURCE_LINE 00000588 ""
NSQ_SOURCE_LINE 00000589 "You do this:"
NSQ_SOURCE_LINE 00000590 ""
NSQ_SOURCE_LINE 00000591 " patch_package(...);"
NSQ_SOURCE_LINE 00000592 ""
NSQ_SOURCE_LINE 00000593 "instead of this:"
NSQ_SOURCE_LINE 00000594 ""
NSQ_SOURCE_LINE 00000595 " my $handle = patch_package(...);"
NSQ_SOURCE_LINE 00000596 ""
NSQ_SOURCE_LINE 00000597 "Since the handle is used to revert the patch, if you do not store C<$handle>,"
NSQ_SOURCE_LINE 00000598 "you are basically patching and immediately reverting the patch."
NSQ_SOURCE_LINE 00000599 ""
NSQ_SOURCE_LINE 00000600 "=item * Importing before patching"
NSQ_SOURCE_LINE 00000601 ""
NSQ_SOURCE_LINE 00000602 "If C<Target::Module> exports symbols, and you patch one of the default exports,"
NSQ_SOURCE_LINE 00000603 "the users need to patch before importing. Otherwise he/she will get the"
NSQ_SOURCE_LINE 00000604 "unpatched version. For example, this won't work:"
NSQ_SOURCE_LINE 00000605 ""
NSQ_SOURCE_LINE 00000606 " use Target::Module; # by default export foo"
NSQ_SOURCE_LINE 00000607 " use Target::Module::Patch::Foo; # patches foo"
NSQ_SOURCE_LINE 00000608 ""
NSQ_SOURCE_LINE 00000609 " foo(); # user gets the unpatched version"
NSQ_SOURCE_LINE 00000610 ""
NSQ_SOURCE_LINE 00000611 "While this does:"
NSQ_SOURCE_LINE 00000612 ""
NSQ_SOURCE_LINE 00000613 " use Target::Module::Patch::Foo; # patches foo"
NSQ_SOURCE_LINE 00000614 " use Target::Module; # by default export foo"
NSQ_SOURCE_LINE 00000615 ""
NSQ_SOURCE_LINE 00000616 " foo(); # user gets the patched version"
NSQ_SOURCE_LINE 00000617 ""
NSQ_SOURCE_LINE 00000618 "Since 0.16, Module::Patch already warns this (unless C<-load_target> or"
NSQ_SOURCE_LINE 00000619 "C<-warn_target_loaded> is set to false)."
NSQ_SOURCE_LINE 00000620 ""
NSQ_SOURCE_LINE 00000621 "=back"
NSQ_SOURCE_LINE 00000622 ""
NSQ_SOURCE_LINE 00000623 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000624 ""
NSQ_SOURCE_LINE 00000625 "Please visit the project's homepage at L<https://metacpan.org/release/Module-Patch>."
NSQ_SOURCE_LINE 00000626 ""
NSQ_SOURCE_LINE 00000627 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000628 ""
NSQ_SOURCE_LINE 00000629 "Source repository is at L<https://github.com/perlancar/perl-Module-Patch>."
NSQ_SOURCE_LINE 00000630 ""
NSQ_SOURCE_LINE 00000631 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000632 ""
NSQ_SOURCE_LINE 00000633 "L<Monkey::Patch::Action>"
NSQ_SOURCE_LINE 00000634 ""
NSQ_SOURCE_LINE 00000635 "L<Pod::Weaver::Plugin::ModulePatch>"
NSQ_SOURCE_LINE 00000636 ""
NSQ_SOURCE_LINE 00000637 "Some examples of patch modules that use Module::Patch by subclassing it:"
NSQ_SOURCE_LINE 00000638 "L<Net::HTTP::Methods::Patch::LogRequest>,"
NSQ_SOURCE_LINE 00000639 "L<LWP::UserAgent::Patch::HTTPSHardTimeout>, L<HTTP::Tiny::Patch::Cache>,"
NSQ_SOURCE_LINE 00000640 "L<HTTP::Tiny::Patch::Retry>."
NSQ_SOURCE_LINE 00000641 ""
NSQ_SOURCE_LINE 00000642 "Some examples of modules that use Module::Patch directly:"
NSQ_SOURCE_LINE 00000643 "L<Log::ger::For::Class>."
NSQ_SOURCE_LINE 00000644 ""
