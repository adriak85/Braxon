BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package HTML::Parser;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "our $VERSION = '3.83';"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "require HTML::Entities;"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "require XSLoader;"
NSQ_SOURCE_LINE 00000010 "XSLoader::load('HTML::Parser', $VERSION);"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "sub new"
NSQ_SOURCE_LINE 00000013 "{"
NSQ_SOURCE_LINE 00000014 "    my $class = shift;"
NSQ_SOURCE_LINE 00000015 "    my $self = bless {}, $class;"
NSQ_SOURCE_LINE 00000016 "    return $self->init(@_);"
NSQ_SOURCE_LINE 00000017 "}"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "sub init"
NSQ_SOURCE_LINE 00000021 "{"
NSQ_SOURCE_LINE 00000022 "    my $self = shift;"
NSQ_SOURCE_LINE 00000023 "    $self->_alloc_pstate;"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "    my %arg = @_;"
NSQ_SOURCE_LINE 00000026 "    my $api_version = delete $arg{api_version} || (@_ ? 3 : 2);"
NSQ_SOURCE_LINE 00000027 "    if ($api_version >= 4) {"
NSQ_SOURCE_LINE 00000028 "\trequire Carp;"
NSQ_SOURCE_LINE 00000029 "\tCarp::croak(\"API version $api_version not supported \" ."
NSQ_SOURCE_LINE 00000030 "\t\t    \"by HTML::Parser $VERSION\");"
NSQ_SOURCE_LINE 00000031 "    }"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "    if ($api_version < 3) {"
NSQ_SOURCE_LINE 00000034 "\t# Set up method callbacks compatible with HTML-Parser-2.xx"
NSQ_SOURCE_LINE 00000035 "\t$self->handler(text    => \"text\",    \"self,text,is_cdata\");"
NSQ_SOURCE_LINE 00000036 "\t$self->handler(end     => \"end\",     \"self,tagname,text\");"
NSQ_SOURCE_LINE 00000037 "\t$self->handler(process => \"process\", \"self,token0,text\");"
NSQ_SOURCE_LINE 00000038 "\t$self->handler(start   => \"start\","
NSQ_SOURCE_LINE 00000039 "\t\t                  \"self,tagname,attr,attrseq,text\");"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "\t$self->handler(comment =>"
NSQ_SOURCE_LINE 00000042 "\t\t       sub {"
NSQ_SOURCE_LINE 00000043 "\t\t\t   my($self, $tokens) = @_;"
NSQ_SOURCE_LINE 00000044 "\t\t\t   for (@$tokens) {"
NSQ_SOURCE_LINE 00000045 "\t\t\t       $self->comment($_);"
NSQ_SOURCE_LINE 00000046 "\t\t\t   }"
NSQ_SOURCE_LINE 00000047 "\t\t       }, \"self,tokens\");"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "\t$self->handler(declaration =>"
NSQ_SOURCE_LINE 00000050 "\t\t       sub {"
NSQ_SOURCE_LINE 00000051 "\t\t\t   my $self = shift;"
NSQ_SOURCE_LINE 00000052 "\t\t\t   $self->declaration(substr($_[0], 2, -1));"
NSQ_SOURCE_LINE 00000053 "\t\t       }, \"self,text\");"
NSQ_SOURCE_LINE 00000054 "    }"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "    if (my $h = delete $arg{handlers}) {"
NSQ_SOURCE_LINE 00000057 "\t$h = {@$h} if ref($h) eq \"ARRAY\";"
NSQ_SOURCE_LINE 00000058 "\twhile (my($event, $cb) = each %$h) {"
NSQ_SOURCE_LINE 00000059 "\t    $self->handler($event => @$cb);"
NSQ_SOURCE_LINE 00000060 "\t}"
NSQ_SOURCE_LINE 00000061 "    }"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "    # In the end we try to assume plain attribute or handler"
NSQ_SOURCE_LINE 00000064 "    while (my($option, $val) = each %arg) {"
NSQ_SOURCE_LINE 00000065 "\tif ($option =~ /^(\\w+)_h$/) {"
NSQ_SOURCE_LINE 00000066 "\t    $self->handler($1 => @$val);"
NSQ_SOURCE_LINE 00000067 "\t}"
NSQ_SOURCE_LINE 00000068 "        elsif ($option =~ /^(text|start|end|process|declaration|comment)$/) {"
NSQ_SOURCE_LINE 00000069 "\t    require Carp;"
NSQ_SOURCE_LINE 00000070 "\t    Carp::croak(\"Bad constructor option '$option'\");"
NSQ_SOURCE_LINE 00000071 "        }"
NSQ_SOURCE_LINE 00000072 "\telse {"
NSQ_SOURCE_LINE 00000073 "\t    $self->$option($val);"
NSQ_SOURCE_LINE 00000074 "\t}"
NSQ_SOURCE_LINE 00000075 "    }"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "    return $self;"
NSQ_SOURCE_LINE 00000078 "}"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "sub parse_file"
NSQ_SOURCE_LINE 00000082 "{"
NSQ_SOURCE_LINE 00000083 "    my($self, $file) = @_;"
NSQ_SOURCE_LINE 00000084 "    my $opened;"
NSQ_SOURCE_LINE 00000085 "    if (!ref($file) && ref(\\$file) ne \"GLOB\") {"
NSQ_SOURCE_LINE 00000086 "        # Assume $file is a filename"
NSQ_SOURCE_LINE 00000087 "        local(*F);"
NSQ_SOURCE_LINE 00000088 "        open(F, \"<\", $file) || return undef;"
NSQ_SOURCE_LINE 00000089 "        binmode(F);  # should we? good for byte counts"
NSQ_SOURCE_LINE 00000090 "        $opened++;"
NSQ_SOURCE_LINE 00000091 "        $file = *F;"
NSQ_SOURCE_LINE 00000092 "    }"
NSQ_SOURCE_LINE 00000093 "    my $chunk = '';"
NSQ_SOURCE_LINE 00000094 "    while (read($file, $chunk, 512)) {"
NSQ_SOURCE_LINE 00000095 "        $self->parse($chunk) || last;"
NSQ_SOURCE_LINE 00000096 "    }"
NSQ_SOURCE_LINE 00000097 "    close($file) if $opened;"
NSQ_SOURCE_LINE 00000098 "    $self->eof;"
NSQ_SOURCE_LINE 00000099 "}"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "sub netscape_buggy_comment  # legacy"
NSQ_SOURCE_LINE 00000103 "{"
NSQ_SOURCE_LINE 00000104 "    my $self = shift;"
NSQ_SOURCE_LINE 00000105 "    require Carp;"
NSQ_SOURCE_LINE 00000106 "    Carp::carp(\"netscape_buggy_comment() is deprecated.  \" ."
NSQ_SOURCE_LINE 00000107 "        \"Please use the strict_comment() method instead\");"
NSQ_SOURCE_LINE 00000108 "    my $old = !$self->strict_comment;"
NSQ_SOURCE_LINE 00000109 "    $self->strict_comment(!shift) if @_;"
NSQ_SOURCE_LINE 00000110 "    return $old;"
NSQ_SOURCE_LINE 00000111 "}"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "# set up method stubs"
NSQ_SOURCE_LINE 00000114 "sub text { }"
NSQ_SOURCE_LINE 00000115 "*start       = \\&text;"
NSQ_SOURCE_LINE 00000116 "*end         = \\&text;"
NSQ_SOURCE_LINE 00000117 "*comment     = \\&text;"
NSQ_SOURCE_LINE 00000118 "*declaration = \\&text;"
NSQ_SOURCE_LINE 00000119 "*process     = \\&text;"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "1;"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "__END__"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "=head1 NAME"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "HTML::Parser - HTML parser class"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "    use strict;"
NSQ_SOURCE_LINE 00000133 "    use warnings;"
NSQ_SOURCE_LINE 00000134 "    use HTML::Parser ();"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "    # Create parser object"
NSQ_SOURCE_LINE 00000137 "    my $p = HTML::Parser->new("
NSQ_SOURCE_LINE 00000138 "        api_version     => 3,"
NSQ_SOURCE_LINE 00000139 "        start_h         => [\\&start, \"tagname, attr\"],"
NSQ_SOURCE_LINE 00000140 "        end_h           => [\\&end,   \"tagname\"],"
NSQ_SOURCE_LINE 00000141 "        marked_sections => 1,"
NSQ_SOURCE_LINE 00000142 "    );"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "    # Parse document text chunk by chunk"
NSQ_SOURCE_LINE 00000145 "    $p->parse($chunk1);"
NSQ_SOURCE_LINE 00000146 "    $p->parse($chunk2);"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "    # ..."
NSQ_SOURCE_LINE 00000149 "    # signal end of document"
NSQ_SOURCE_LINE 00000150 "    $p->eof;"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "    # Parse directly from file"
NSQ_SOURCE_LINE 00000153 "    $p->parse_file(\"foo.html\");"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "    # or"
NSQ_SOURCE_LINE 00000156 "    open(my $fh, \"<:utf8\", \"foo.html\") || die;"
NSQ_SOURCE_LINE 00000157 "    $p->parse_file($fh);"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "Objects of the C<HTML::Parser> class will recognize markup and"
NSQ_SOURCE_LINE 00000162 "separate it from plain text (alias data content) in HTML"
NSQ_SOURCE_LINE 00000163 "documents.  As different kinds of markup and text are recognized, the"
NSQ_SOURCE_LINE 00000164 "corresponding event handlers are invoked."
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "C<HTML::Parser> is not a generic SGML parser.  We have tried to"
NSQ_SOURCE_LINE 00000167 "make it able to deal with the HTML that is actually \"out there\", and"
NSQ_SOURCE_LINE 00000168 "it normally parses as closely as possible to the way the popular web"
NSQ_SOURCE_LINE 00000169 "browsers do it instead of strictly following one of the many HTML"
NSQ_SOURCE_LINE 00000170 "specifications from W3C.  Where there is disagreement, there is often"
NSQ_SOURCE_LINE 00000171 "an option that you can enable to get the official behaviour."
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "The document to be parsed may be supplied in arbitrary chunks.  This"
NSQ_SOURCE_LINE 00000174 "makes on-the-fly parsing as documents are received from the network"
NSQ_SOURCE_LINE 00000175 "possible."
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "If event driven parsing does not feel right for your application, you"
NSQ_SOURCE_LINE 00000178 "might want to use C<HTML::PullParser>.  This is an C<HTML::Parser>"
NSQ_SOURCE_LINE 00000179 "subclass that allows a more conventional program structure."
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "=head1 METHODS"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "The following method is used to construct a new C<HTML::Parser> object:"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "=over"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "=item $p = HTML::Parser->new( %options_and_handlers )"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "This class method creates a new C<HTML::Parser> object and"
NSQ_SOURCE_LINE 00000191 "returns it.  Key/value argument pairs may be provided to assign event"
NSQ_SOURCE_LINE 00000192 "handlers or initialize parser options.  The handlers and parser"
NSQ_SOURCE_LINE 00000193 "options can also be set or modified later by the method calls described below."
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "If a top level key is in the form \"<event>_h\" (e.g., \"text_h\") then it"
NSQ_SOURCE_LINE 00000196 "assigns a handler to that event, otherwise it initializes a parser"
NSQ_SOURCE_LINE 00000197 "option. The event handler specification value must be an array"
NSQ_SOURCE_LINE 00000198 "reference.  Multiple handlers may also be assigned with the 'handlers"
NSQ_SOURCE_LINE 00000199 "=> [%handlers]' option.  See examples below."
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "If new() is called without any arguments, it will create a parser that"
NSQ_SOURCE_LINE 00000202 "uses callback methods compatible with version 2 of C<HTML::Parser>."
NSQ_SOURCE_LINE 00000203 "See the section on \"version 2 compatibility\" below for details."
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "The special constructor option 'api_version => 2' can be used to"
NSQ_SOURCE_LINE 00000206 "initialize version 2 callbacks while still setting other options and"
NSQ_SOURCE_LINE 00000207 "handlers.  The 'api_version => 3' option can be used if you don't want"
NSQ_SOURCE_LINE 00000208 "to set any options and don't want to fall back to v2 compatible"
NSQ_SOURCE_LINE 00000209 "mode."
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "Examples:"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 " $p = HTML::Parser->new("
NSQ_SOURCE_LINE 00000214 "   api_version => 3,"
NSQ_SOURCE_LINE 00000215 "   text_h => [ sub {...}, \"dtext\" ]"
NSQ_SOURCE_LINE 00000216 " );"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "This creates a new parser object with a text event handler subroutine"
NSQ_SOURCE_LINE 00000219 "that receives the original text with general entities decoded."
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 " $p = HTML::Parser->new("
NSQ_SOURCE_LINE 00000222 "   api_version => 3,"
NSQ_SOURCE_LINE 00000223 "   start_h => [ 'my_start', \"self,tokens\" ]"
NSQ_SOURCE_LINE 00000224 " );"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "This creates a new parser object with a start event handler method"
NSQ_SOURCE_LINE 00000227 "that receives the $p and the tokens array."
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 " $p = HTML::Parser->new("
NSQ_SOURCE_LINE 00000230 "   api_version => 3,"
NSQ_SOURCE_LINE 00000231 "   handlers => {"
NSQ_SOURCE_LINE 00000232 "     text => [\\@array, \"event,text\"],"
NSQ_SOURCE_LINE 00000233 "     comment => [\\@array, \"event,text\"],"
NSQ_SOURCE_LINE 00000234 "   }"
NSQ_SOURCE_LINE 00000235 " );"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "This creates a new parser object that stores the event type and the"
NSQ_SOURCE_LINE 00000238 "original text in @array for text and comment events."
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "=back"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "The following methods feed the HTML document"
NSQ_SOURCE_LINE 00000243 "to the C<HTML::Parser> object:"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "=over"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "=item $p->parse( $string )"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "Parse $string as the next chunk of the HTML document.  Handlers invoked should"
NSQ_SOURCE_LINE 00000250 "not attempt to modify the $string in-place until $p->parse returns."
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "If an invoked event handler aborts parsing by calling $p->eof, then $p->parse()"
NSQ_SOURCE_LINE 00000253 "will return a FALSE value.  Otherwise the return value is a reference to the"
NSQ_SOURCE_LINE 00000254 "parser object ($p)."
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "=item $p->parse( $code_ref )"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "If a code reference is passed as the argument to be parsed, then the"
NSQ_SOURCE_LINE 00000259 "chunks to be parsed are obtained by invoking this function repeatedly."
NSQ_SOURCE_LINE 00000260 "Parsing continues until the function returns an empty (or undefined)"
NSQ_SOURCE_LINE 00000261 "result.  When this happens $p->eof is automatically signaled."
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "Parsing will also abort if one of the event handlers calls $p->eof."
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "The effect of this is the same as:"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "    while (1) {"
NSQ_SOURCE_LINE 00000268 "        my $chunk = &$code_ref();"
NSQ_SOURCE_LINE 00000269 "        if (!defined($chunk) || !length($chunk)) {"
NSQ_SOURCE_LINE 00000270 "            $p->eof;"
NSQ_SOURCE_LINE 00000271 "            return $p;"
NSQ_SOURCE_LINE 00000272 "        }"
NSQ_SOURCE_LINE 00000273 "        $p->parse($chunk) || return undef;"
NSQ_SOURCE_LINE 00000274 "    }"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "But it is more efficient as this loop runs internally in XS code."
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "=item $p->parse_file( $file )"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "Parse text directly from a file.  The $file argument can be a"
NSQ_SOURCE_LINE 00000281 "filename, an open file handle, or a reference to an open file"
NSQ_SOURCE_LINE 00000282 "handle."
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "If $file contains a filename and the file can't be opened, then the"
NSQ_SOURCE_LINE 00000285 "method returns an undefined value and $! tells why it failed."
NSQ_SOURCE_LINE 00000286 "Otherwise the return value is a reference to the parser object."
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "If a file handle is passed as the $file argument, then the file will"
NSQ_SOURCE_LINE 00000289 "normally be read until EOF, but not closed."
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "If an invoked event handler aborts parsing by calling $p->eof,"
NSQ_SOURCE_LINE 00000292 "then $p->parse_file() may not have read the entire file."
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "On systems with multi-byte line terminators, the values passed for the"
NSQ_SOURCE_LINE 00000295 "offset and length argspecs may be too low if parse_file() is called on"
NSQ_SOURCE_LINE 00000296 "a file handle that is not in binary mode."
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "If a filename is passed in, then parse_file() will open the file in"
NSQ_SOURCE_LINE 00000299 "binary mode."
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "=item $p->eof"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "Signals the end of the HTML document.  Calling the $p->eof method"
NSQ_SOURCE_LINE 00000304 "outside a handler callback will flush any remaining buffered text"
NSQ_SOURCE_LINE 00000305 "(which triggers the C<text> event if there is any remaining text)."
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "Calling $p->eof inside a handler will terminate parsing at that point"
NSQ_SOURCE_LINE 00000308 "and cause $p->parse to return a FALSE value.  This also terminates"
NSQ_SOURCE_LINE 00000309 "parsing by $p->parse_file()."
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "After $p->eof has been called, the parse() and parse_file() methods"
NSQ_SOURCE_LINE 00000312 "can be invoked to feed new documents with the parser object."
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "The return value from eof() is a reference to the parser object."
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "=back"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "Most parser options are controlled by boolean attributes."
NSQ_SOURCE_LINE 00000320 "Each boolean attribute is enabled by calling the corresponding method"
NSQ_SOURCE_LINE 00000321 "with a TRUE argument and disabled with a FALSE argument.  The"
NSQ_SOURCE_LINE 00000322 "attribute value is left unchanged if no argument is given.  The return"
NSQ_SOURCE_LINE 00000323 "value from each method is the old attribute value."
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "Methods that can be used to get and/or set parser options are:"
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "=over"
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "=item $p->attr_encoded"
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "=item $p->attr_encoded( $bool )"
NSQ_SOURCE_LINE 00000332 ""
NSQ_SOURCE_LINE 00000333 "By default, the C<attr> and C<@attr> argspecs will have general"
NSQ_SOURCE_LINE 00000334 "entities for attribute values decoded.  Enabling this attribute leaves"
NSQ_SOURCE_LINE 00000335 "entities alone."
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "=item $p->backquote"
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "=item $p->backquote( $bool )"
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "By default, only ' and \" are recognized as quote characters around"
NSQ_SOURCE_LINE 00000342 "attribute values.  MSIE also recognizes backquotes for some reason."
NSQ_SOURCE_LINE 00000343 "Enabling this attribute provides compatibility with this behaviour."
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "=item $p->boolean_attribute_value( $val )"
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "This method sets the value reported for boolean attributes inside HTML"
NSQ_SOURCE_LINE 00000348 "start tags.  By default, the name of the attribute is also used as its"
NSQ_SOURCE_LINE 00000349 "value.  This affects the values reported for C<tokens> and C<attr>"
NSQ_SOURCE_LINE 00000350 "argspecs."
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "=item $p->case_sensitive"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "=item $p->case_sensitive( $bool )"
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "By default, tag names and attribute names are down-cased.  Enabling this"
NSQ_SOURCE_LINE 00000357 "attribute leaves them as found in the HTML source document."
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "=item $p->closing_plaintext"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "=item $p->closing_plaintext( $bool )"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "By default, C<plaintext> element can never be closed. Everything up to"
NSQ_SOURCE_LINE 00000364 "the end of the document is parsed in CDATA mode.  This historical"
NSQ_SOURCE_LINE 00000365 "behaviour is what at least MSIE does.  Enabling this attribute makes"
NSQ_SOURCE_LINE 00000366 "closing C< </plaintext> > tag effective and the parsing process will resume"
NSQ_SOURCE_LINE 00000367 "after seeing this tag.  This emulates early gecko-based browsers."
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "=item $p->empty_element_tags"
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "=item $p->empty_element_tags( $bool )"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "By default, empty element tags are not recognized as such and the \"/\""
NSQ_SOURCE_LINE 00000374 "before \">\" is just treated like a normal name character (unless"
NSQ_SOURCE_LINE 00000375 "C<strict_names> is enabled).  Enabling this attribute make"
NSQ_SOURCE_LINE 00000376 "C<HTML::Parser> recognize these tags."
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 "Empty element tags look like start tags, but end with the character"
NSQ_SOURCE_LINE 00000379 "sequence \"/>\" instead of \">\".  When recognized by C<HTML::Parser> they"
NSQ_SOURCE_LINE 00000380 "cause an artificial end event in addition to the start event.  The"
NSQ_SOURCE_LINE 00000381 "C<text> for the artificial end event will be empty and the C<tokenpos>"
NSQ_SOURCE_LINE 00000382 "array will be undefined even though the token array will have one"
NSQ_SOURCE_LINE 00000383 "element containing the tag name."
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "=item $p->marked_sections"
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "=item $p->marked_sections( $bool )"
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "By default, section markings like <![CDATA[...]]> are treated like"
NSQ_SOURCE_LINE 00000390 "ordinary text.  When this attribute is enabled section markings are"
NSQ_SOURCE_LINE 00000391 "honoured."
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "There are currently no events associated with the marked section"
NSQ_SOURCE_LINE 00000394 "markup, but the text can be returned as C<skipped_text>."
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "=item $p->strict_comment"
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "=item $p->strict_comment( $bool )"
NSQ_SOURCE_LINE 00000399 ""
NSQ_SOURCE_LINE 00000400 "By default, comments are terminated by the first occurrence of \"-->\"."
NSQ_SOURCE_LINE 00000401 "This is the behaviour of most popular browsers (like Mozilla, Opera and"
NSQ_SOURCE_LINE 00000402 "MSIE), but it is not correct according to the official HTML"
NSQ_SOURCE_LINE 00000403 "standard.  Officially, you need an even number of \"--\" tokens before"
NSQ_SOURCE_LINE 00000404 "the closing \">\" is recognized and there may not be anything but"
NSQ_SOURCE_LINE 00000405 "whitespace between an even and an odd \"--\"."
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "The official behaviour is enabled by enabling this attribute."
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "Enabling of 'strict_comment' also disables recognizing these forms as"
NSQ_SOURCE_LINE 00000410 "comments:"
NSQ_SOURCE_LINE 00000411 ""
NSQ_SOURCE_LINE 00000412 "  </ comment>"
NSQ_SOURCE_LINE 00000413 "  <! comment>"
NSQ_SOURCE_LINE 00000414 ""
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "=item $p->strict_end"
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 "=item $p->strict_end( $bool )"
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "By default, attributes and other junk are allowed to be present on end tags in a"
NSQ_SOURCE_LINE 00000421 "manner that emulates MSIE's behaviour."
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "The official behaviour is enabled with this attribute.  If enabled,"
NSQ_SOURCE_LINE 00000424 "only whitespace is allowed between the tagname and the final \">\"."
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 "=item $p->strict_names"
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "=item $p->strict_names( $bool )"
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "By default, almost anything is allowed in tag and attribute names."
NSQ_SOURCE_LINE 00000431 "This is the behaviour of most popular browsers and allows us to parse"
NSQ_SOURCE_LINE 00000432 "some broken tags with invalid attribute values like:"
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 "   <IMG SRC=newprevlstGr.gif ALT=[PREV LIST] BORDER=0>"
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 "By default, \"LIST]\" is parsed as a boolean attribute, not as"
NSQ_SOURCE_LINE 00000437 "part of the ALT value as was clearly intended.  This is also what"
NSQ_SOURCE_LINE 00000438 "Mozilla sees."
NSQ_SOURCE_LINE 00000439 ""
NSQ_SOURCE_LINE 00000440 "The official behaviour is enabled by enabling this attribute.  If"
NSQ_SOURCE_LINE 00000441 "enabled, it will cause the tag above to be reported as text"
NSQ_SOURCE_LINE 00000442 "since \"LIST]\" is not a legal attribute name."
NSQ_SOURCE_LINE 00000443 ""
NSQ_SOURCE_LINE 00000444 "=item $p->unbroken_text"
NSQ_SOURCE_LINE 00000445 ""
NSQ_SOURCE_LINE 00000446 "=item $p->unbroken_text( $bool )"
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 "By default, blocks of text are given to the text handler as soon as"
NSQ_SOURCE_LINE 00000449 "possible (but the parser takes care always to break text at a"
NSQ_SOURCE_LINE 00000450 "boundary between whitespace and non-whitespace so single words and"
NSQ_SOURCE_LINE 00000451 "entities can always be decoded safely).  This might create breaks that"
NSQ_SOURCE_LINE 00000452 "make it hard to do transformations on the text. When this attribute is"
NSQ_SOURCE_LINE 00000453 "enabled, blocks of text are always reported in one piece.  This will"
NSQ_SOURCE_LINE 00000454 "delay the text event until the following (non-text) event has been"
NSQ_SOURCE_LINE 00000455 "recognized by the parser."
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "Note that the C<offset> argspec will give you the offset of the first"
NSQ_SOURCE_LINE 00000458 "segment of text and C<length> is the combined length of the segments."
NSQ_SOURCE_LINE 00000459 "Since there might be ignored tags in between, these numbers can't be"
NSQ_SOURCE_LINE 00000460 "used to directly index in the original document file."
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 "=item $p->utf8_mode"
NSQ_SOURCE_LINE 00000463 ""
NSQ_SOURCE_LINE 00000464 "=item $p->utf8_mode( $bool )"
NSQ_SOURCE_LINE 00000465 ""
NSQ_SOURCE_LINE 00000466 "Enable this option when parsing raw undecoded UTF-8.  This tells the"
NSQ_SOURCE_LINE 00000467 "parser that the entities expanded for strings reported by C<attr>,"
NSQ_SOURCE_LINE 00000468 "C<@attr> and C<dtext> should be expanded as decoded UTF-8 so they end"
NSQ_SOURCE_LINE 00000469 "up compatible with the surrounding text."
NSQ_SOURCE_LINE 00000470 ""
NSQ_SOURCE_LINE 00000471 "If C<utf8_mode> is enabled then it is an error to pass strings"
NSQ_SOURCE_LINE 00000472 "containing characters with code above 255 to the parse() method, and"
NSQ_SOURCE_LINE 00000473 "the parse() method will croak if you try."
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 "Example: The Unicode character \"\\x{2665}\" is \"\\xE2\\x99\\xA5\" when UTF-8"
NSQ_SOURCE_LINE 00000476 "encoded.  The character can also be represented by the entity"
NSQ_SOURCE_LINE 00000477 "\"&hearts;\" or \"&#x2665\".  If we feed the parser:"
NSQ_SOURCE_LINE 00000478 ""
NSQ_SOURCE_LINE 00000479 "  $p->parse(\"\\xE2\\x99\\xA5&hearts;\");"
NSQ_SOURCE_LINE 00000480 ""
NSQ_SOURCE_LINE 00000481 "then C<dtext> will be reported as \"\\xE2\\x99\\xA5\\x{2665}\" without"
NSQ_SOURCE_LINE 00000482 "C<utf8_mode> enabled, but as \"\\xE2\\x99\\xA5\\xE2\\x99\\xA5\" when enabled."
NSQ_SOURCE_LINE 00000483 "The later string is what you want."
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "This option is only available with perl-5.8 or better."
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "=item $p->xml_mode"
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 "=item $p->xml_mode( $bool )"
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "Enabling this attribute changes the parser to allow some XML"
NSQ_SOURCE_LINE 00000492 "constructs.  This enables the behaviour controlled by individually by"
NSQ_SOURCE_LINE 00000493 "the C<case_sensitive>, C<empty_element_tags>, C<strict_names> and"
NSQ_SOURCE_LINE 00000494 "C<xml_pic> attributes and also suppresses special treatment of"
NSQ_SOURCE_LINE 00000495 "elements that are parsed as CDATA for HTML."
NSQ_SOURCE_LINE 00000496 ""
NSQ_SOURCE_LINE 00000497 "=item $p->xml_pic"
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "=item $p->xml_pic( $bool )"
NSQ_SOURCE_LINE 00000500 ""
NSQ_SOURCE_LINE 00000501 "By default, I<processing instructions> are terminated by \">\". When"
NSQ_SOURCE_LINE 00000502 "this attribute is enabled, processing instructions are terminated by"
NSQ_SOURCE_LINE 00000503 "\"?>\" instead."
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "=back"
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "As markup and text is recognized, handlers are invoked.  The following"
NSQ_SOURCE_LINE 00000508 "method is used to set up handlers for different events:"
NSQ_SOURCE_LINE 00000509 ""
NSQ_SOURCE_LINE 00000510 "=over"
NSQ_SOURCE_LINE 00000511 ""
NSQ_SOURCE_LINE 00000512 "=item $p->handler( event => \\&subroutine, $argspec )"
NSQ_SOURCE_LINE 00000513 ""
NSQ_SOURCE_LINE 00000514 "=item $p->handler( event => $method_name, $argspec )"
NSQ_SOURCE_LINE 00000515 ""
NSQ_SOURCE_LINE 00000516 "=item $p->handler( event => \\@accum, $argspec )"
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "=item $p->handler( event => \"\" );"
NSQ_SOURCE_LINE 00000519 ""
NSQ_SOURCE_LINE 00000520 "=item $p->handler( event => undef );"
NSQ_SOURCE_LINE 00000521 ""
NSQ_SOURCE_LINE 00000522 "=item $p->handler( event );"
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 "This method assigns a subroutine, method, or array to handle an event."
NSQ_SOURCE_LINE 00000525 ""
NSQ_SOURCE_LINE 00000526 "Event is one of C<text>, C<start>, C<end>, C<declaration>, C<comment>,"
NSQ_SOURCE_LINE 00000527 "C<process>, C<start_document>, C<end_document> or C<default>."
NSQ_SOURCE_LINE 00000528 ""
NSQ_SOURCE_LINE 00000529 "The C<\\&subroutine> is a reference to a subroutine which is called to handle"
NSQ_SOURCE_LINE 00000530 "the event."
NSQ_SOURCE_LINE 00000531 ""
NSQ_SOURCE_LINE 00000532 "The C<$method_name> is the name of a method of $p which is called to handle"
NSQ_SOURCE_LINE 00000533 "the event."
NSQ_SOURCE_LINE 00000534 ""
NSQ_SOURCE_LINE 00000535 "The C<@accum> is an array that will hold the event information as"
NSQ_SOURCE_LINE 00000536 "sub-arrays."
NSQ_SOURCE_LINE 00000537 ""
NSQ_SOURCE_LINE 00000538 "If the second argument is \"\", the event is ignored."
NSQ_SOURCE_LINE 00000539 "If it is undef, the default handler is invoked for the event."
NSQ_SOURCE_LINE 00000540 ""
NSQ_SOURCE_LINE 00000541 "The C<$argspec> is a string that describes the information to be reported"
NSQ_SOURCE_LINE 00000542 "for the event.  Any requested information that does not apply to a"
NSQ_SOURCE_LINE 00000543 "specific event is passed as C<undef>.  If argspec is omitted, then it"
NSQ_SOURCE_LINE 00000544 "is left unchanged."
NSQ_SOURCE_LINE 00000545 ""
NSQ_SOURCE_LINE 00000546 "The return value from $p->handler is the old callback routine or a"
NSQ_SOURCE_LINE 00000547 "reference to the accumulator array."
NSQ_SOURCE_LINE 00000548 ""
NSQ_SOURCE_LINE 00000549 "Any return values from handler callback routines/methods are always"
NSQ_SOURCE_LINE 00000550 "ignored.  A handler callback can request parsing to be aborted by"
NSQ_SOURCE_LINE 00000551 "invoking the $p->eof method.  A handler callback is not allowed to"
NSQ_SOURCE_LINE 00000552 "invoke the $p->parse() or $p->parse_file() method.  An exception will"
NSQ_SOURCE_LINE 00000553 "be raised if it tries."
NSQ_SOURCE_LINE 00000554 ""
NSQ_SOURCE_LINE 00000555 "Examples:"
NSQ_SOURCE_LINE 00000556 ""
NSQ_SOURCE_LINE 00000557 "    $p->handler(start =>  \"start\", 'self, attr, attrseq, text' );"
NSQ_SOURCE_LINE 00000558 ""
NSQ_SOURCE_LINE 00000559 "This causes the \"start\" method of object C<$p> to be called for 'start' events."
NSQ_SOURCE_LINE 00000560 "The callback signature is C<< $p->start(\\%attr, \\@attr_seq, $text) >>."
NSQ_SOURCE_LINE 00000561 ""
NSQ_SOURCE_LINE 00000562 "    $p->handler(start =>  \\&start, 'attr, attrseq, text' );"
NSQ_SOURCE_LINE 00000563 ""
NSQ_SOURCE_LINE 00000564 "This causes subroutine start() to be called for 'start' events."
NSQ_SOURCE_LINE 00000565 "The callback signature is start(\\%attr, \\@attr_seq, $text)."
NSQ_SOURCE_LINE 00000566 ""
NSQ_SOURCE_LINE 00000567 "    $p->handler(start =>  \\@accum, '\"S\", attr, attrseq, text' );"
NSQ_SOURCE_LINE 00000568 ""
NSQ_SOURCE_LINE 00000569 "This causes 'start' event information to be saved in @accum."
NSQ_SOURCE_LINE 00000570 "The array elements will be ['S', \\%attr, \\@attr_seq, $text]."
NSQ_SOURCE_LINE 00000571 ""
NSQ_SOURCE_LINE 00000572 "   $p->handler(start => \"\");"
NSQ_SOURCE_LINE 00000573 ""
NSQ_SOURCE_LINE 00000574 "This causes 'start' events to be ignored.  It also suppresses"
NSQ_SOURCE_LINE 00000575 "invocations of any default handler for start events.  It is in most"
NSQ_SOURCE_LINE 00000576 "cases equivalent to $p->handler(start => sub {}), but is more"
NSQ_SOURCE_LINE 00000577 "efficient.  It is different from the empty-sub-handler in that"
NSQ_SOURCE_LINE 00000578 "C<skipped_text> is not reset by it."
NSQ_SOURCE_LINE 00000579 ""
NSQ_SOURCE_LINE 00000580 "   $p->handler(start => undef);"
NSQ_SOURCE_LINE 00000581 ""
NSQ_SOURCE_LINE 00000582 "This causes no handler to be associated with start events."
NSQ_SOURCE_LINE 00000583 "If there is a default handler it will be invoked."
NSQ_SOURCE_LINE 00000584 ""
NSQ_SOURCE_LINE 00000585 "=back"
NSQ_SOURCE_LINE 00000586 ""
NSQ_SOURCE_LINE 00000587 "Filters based on tags can be set up to limit the number of events"
NSQ_SOURCE_LINE 00000588 "reported.  The main bottleneck during parsing is often the huge number"
NSQ_SOURCE_LINE 00000589 "of callbacks made from the parser.  Applying filters can improve"
NSQ_SOURCE_LINE 00000590 "performance significantly."
NSQ_SOURCE_LINE 00000591 ""
NSQ_SOURCE_LINE 00000592 "The following methods control filters:"
NSQ_SOURCE_LINE 00000593 ""
NSQ_SOURCE_LINE 00000594 "=over"
NSQ_SOURCE_LINE 00000595 ""
NSQ_SOURCE_LINE 00000596 "=item $p->ignore_elements( @tags )"
NSQ_SOURCE_LINE 00000597 ""
NSQ_SOURCE_LINE 00000598 "Both the C<start> event and the C<end> event as well as any events that"
NSQ_SOURCE_LINE 00000599 "would be reported in between are suppressed.  The ignored elements can"
NSQ_SOURCE_LINE 00000600 "contain nested occurrences of itself.  Example:"
NSQ_SOURCE_LINE 00000601 ""
NSQ_SOURCE_LINE 00000602 "   $p->ignore_elements(qw(script style));"
NSQ_SOURCE_LINE 00000603 ""
NSQ_SOURCE_LINE 00000604 "The C<script> and C<style> tags will always nest properly since their"
NSQ_SOURCE_LINE 00000605 "content is parsed in CDATA mode.  For most other tags"
NSQ_SOURCE_LINE 00000606 "C<ignore_elements> must be used with caution since HTML is often not"
NSQ_SOURCE_LINE 00000607 "I<well formed>."
NSQ_SOURCE_LINE 00000608 ""
NSQ_SOURCE_LINE 00000609 "=item $p->ignore_tags( @tags )"
NSQ_SOURCE_LINE 00000610 ""
NSQ_SOURCE_LINE 00000611 "Any C<start> and C<end> events involving any of the tags given are"
NSQ_SOURCE_LINE 00000612 "suppressed.  To reset the filter (i.e. don't suppress any C<start> and"
NSQ_SOURCE_LINE 00000613 "C<end> events), call C<ignore_tags> without an argument."
NSQ_SOURCE_LINE 00000614 ""
NSQ_SOURCE_LINE 00000615 "=item $p->report_tags( @tags )"
NSQ_SOURCE_LINE 00000616 ""
NSQ_SOURCE_LINE 00000617 "Any C<start> and C<end> events involving any of the tags I<not> given"
NSQ_SOURCE_LINE 00000618 "are suppressed.  To reset the filter (i.e. report all C<start> and"
NSQ_SOURCE_LINE 00000619 "C<end> events), call C<report_tags> without an argument."
NSQ_SOURCE_LINE 00000620 ""
NSQ_SOURCE_LINE 00000621 "=back"
NSQ_SOURCE_LINE 00000622 ""
NSQ_SOURCE_LINE 00000623 "Internally, the system has two filter lists, one for C<report_tags>"
NSQ_SOURCE_LINE 00000624 "and one for C<ignore_tags>, and both filters are applied.  This"
NSQ_SOURCE_LINE 00000625 "effectively gives C<ignore_tags> precedence over C<report_tags>."
NSQ_SOURCE_LINE 00000626 ""
NSQ_SOURCE_LINE 00000627 "Examples:"
NSQ_SOURCE_LINE 00000628 ""
NSQ_SOURCE_LINE 00000629 "   $p->ignore_tags(qw(style));"
NSQ_SOURCE_LINE 00000630 "   $p->report_tags(qw(script style));"
NSQ_SOURCE_LINE 00000631 ""
NSQ_SOURCE_LINE 00000632 "results in only C<script> events being reported."
NSQ_SOURCE_LINE 00000633 ""
NSQ_SOURCE_LINE 00000634 "=head2 Argspec"
NSQ_SOURCE_LINE 00000635 ""
NSQ_SOURCE_LINE 00000636 "Argspec is a string containing a comma-separated list that describes"
NSQ_SOURCE_LINE 00000637 "the information reported by the event.  The following argspec"
NSQ_SOURCE_LINE 00000638 "identifier names can be used:"
NSQ_SOURCE_LINE 00000639 ""
NSQ_SOURCE_LINE 00000640 "=over"
NSQ_SOURCE_LINE 00000641 ""
NSQ_SOURCE_LINE 00000642 "=item C<attr>"
NSQ_SOURCE_LINE 00000643 ""
NSQ_SOURCE_LINE 00000644 "Attr causes a reference to a hash of attribute name/value pairs to be"
NSQ_SOURCE_LINE 00000645 "passed."
NSQ_SOURCE_LINE 00000646 ""
NSQ_SOURCE_LINE 00000647 "Boolean attributes' values are either the value set by"
NSQ_SOURCE_LINE 00000648 "$p->boolean_attribute_value, or the attribute name if no value has been"
NSQ_SOURCE_LINE 00000649 "set by $p->boolean_attribute_value."
NSQ_SOURCE_LINE 00000650 ""
NSQ_SOURCE_LINE 00000651 "This passes undef except for C<start> events."
NSQ_SOURCE_LINE 00000652 ""
NSQ_SOURCE_LINE 00000653 "Unless C<xml_mode> or C<case_sensitive> is enabled, the attribute"
NSQ_SOURCE_LINE 00000654 "names are forced to lower case."
NSQ_SOURCE_LINE 00000655 ""
NSQ_SOURCE_LINE 00000656 "General entities are decoded in the attribute values and"
NSQ_SOURCE_LINE 00000657 "one layer of matching quotes enclosing the attribute values is removed."
NSQ_SOURCE_LINE 00000658 ""
NSQ_SOURCE_LINE 00000659 "The Unicode character set is assumed for entity decoding."
NSQ_SOURCE_LINE 00000660 ""
NSQ_SOURCE_LINE 00000661 "=item C<@attr>"
NSQ_SOURCE_LINE 00000662 ""
NSQ_SOURCE_LINE 00000663 "Basically the same as C<attr>, but keys and values are passed as"
NSQ_SOURCE_LINE 00000664 "individual arguments and the original sequence of the attributes is"
NSQ_SOURCE_LINE 00000665 "kept.  The parameters passed will be the same as the @attr calculated"
NSQ_SOURCE_LINE 00000666 "here:"
NSQ_SOURCE_LINE 00000667 ""
NSQ_SOURCE_LINE 00000668 "   @attr = map { $_ => $attr->{$_} } @$attrseq;"
NSQ_SOURCE_LINE 00000669 ""
NSQ_SOURCE_LINE 00000670 "assuming $attr and $attrseq here are the hash and array passed as the"
NSQ_SOURCE_LINE 00000671 "result of C<attr> and C<attrseq> argspecs."
NSQ_SOURCE_LINE 00000672 ""
NSQ_SOURCE_LINE 00000673 "This passes no values for events besides C<start>."
NSQ_SOURCE_LINE 00000674 ""
NSQ_SOURCE_LINE 00000675 "=item C<attrseq>"
NSQ_SOURCE_LINE 00000676 ""
NSQ_SOURCE_LINE 00000677 "Attrseq causes a reference to an array of attribute names to be"
NSQ_SOURCE_LINE 00000678 "passed.  This can be useful if you want to walk the C<attr> hash in"
NSQ_SOURCE_LINE 00000679 "the original sequence."
NSQ_SOURCE_LINE 00000680 ""
NSQ_SOURCE_LINE 00000681 "This passes undef except for C<start> events."
NSQ_SOURCE_LINE 00000682 ""
NSQ_SOURCE_LINE 00000683 "Unless C<xml_mode> or C<case_sensitive> is enabled, the attribute"
NSQ_SOURCE_LINE 00000684 "names are forced to lower case."
NSQ_SOURCE_LINE 00000685 ""
NSQ_SOURCE_LINE 00000686 "=item C<column>"
NSQ_SOURCE_LINE 00000687 ""
NSQ_SOURCE_LINE 00000688 "Column causes the column number of the start of the event to be passed."
NSQ_SOURCE_LINE 00000689 "The first column on a line is 0."
NSQ_SOURCE_LINE 00000690 ""
NSQ_SOURCE_LINE 00000691 "=item C<dtext>"
NSQ_SOURCE_LINE 00000692 ""
NSQ_SOURCE_LINE 00000693 "Dtext causes the decoded text to be passed.  General entities are"
NSQ_SOURCE_LINE 00000694 "automatically decoded unless the event was inside a CDATA section or"
NSQ_SOURCE_LINE 00000695 "was between literal start and end tags (C<script>, C<style>,"
NSQ_SOURCE_LINE 00000696 "C<xmp>, C<iframe>, C<title>, C<textarea> and C<plaintext>)."
NSQ_SOURCE_LINE 00000697 ""
NSQ_SOURCE_LINE 00000698 "The Unicode character set is assumed for entity decoding.  With Perl"
NSQ_SOURCE_LINE 00000699 "version 5.6 or earlier only the Latin-1 range is supported, and"
NSQ_SOURCE_LINE 00000700 "entities for characters outside the range 0..255 are left unchanged."
NSQ_SOURCE_LINE 00000701 ""
NSQ_SOURCE_LINE 00000702 "This passes undef except for C<text> events."
NSQ_SOURCE_LINE 00000703 ""
NSQ_SOURCE_LINE 00000704 "=item C<event>"
NSQ_SOURCE_LINE 00000705 ""
NSQ_SOURCE_LINE 00000706 "Event causes the event name to be passed."
NSQ_SOURCE_LINE 00000707 ""
NSQ_SOURCE_LINE 00000708 "The event name is one of C<text>, C<start>, C<end>, C<declaration>,"
NSQ_SOURCE_LINE 00000709 "C<comment>, C<process>, C<start_document> or C<end_document>."
NSQ_SOURCE_LINE 00000710 ""
NSQ_SOURCE_LINE 00000711 "=item C<is_cdata>"
NSQ_SOURCE_LINE 00000712 ""
NSQ_SOURCE_LINE 00000713 "Is_cdata causes a TRUE value to be passed if the event is inside a CDATA"
NSQ_SOURCE_LINE 00000714 "section or between literal start and end tags (C<script>,"
NSQ_SOURCE_LINE 00000715 "C<style>, C<xmp>, C<iframe>, C<title>, C<textarea> and C<plaintext>)."
NSQ_SOURCE_LINE 00000716 ""
NSQ_SOURCE_LINE 00000717 "if the flag is FALSE for a text event, then you should normally"
NSQ_SOURCE_LINE 00000718 "either use C<dtext> or decode the entities yourself before the text is"
NSQ_SOURCE_LINE 00000719 "processed further."
NSQ_SOURCE_LINE 00000720 ""
NSQ_SOURCE_LINE 00000721 "=item C<length>"
NSQ_SOURCE_LINE 00000722 ""
NSQ_SOURCE_LINE 00000723 "Length causes the number of bytes of the source text of the event to"
NSQ_SOURCE_LINE 00000724 "be passed."
NSQ_SOURCE_LINE 00000725 ""
NSQ_SOURCE_LINE 00000726 "=item C<line>"
NSQ_SOURCE_LINE 00000727 ""
NSQ_SOURCE_LINE 00000728 "Line causes the line number of the start of the event to be passed."
NSQ_SOURCE_LINE 00000729 "The first line in the document is 1.  Line counting doesn't start"
NSQ_SOURCE_LINE 00000730 "until at least one handler requests this value to be reported."
NSQ_SOURCE_LINE 00000731 ""
NSQ_SOURCE_LINE 00000732 "=item C<offset>"
NSQ_SOURCE_LINE 00000733 ""
NSQ_SOURCE_LINE 00000734 "Offset causes the byte position in the HTML document of the start of"
NSQ_SOURCE_LINE 00000735 "the event to be passed.  The first byte in the document has offset 0."
NSQ_SOURCE_LINE 00000736 ""
NSQ_SOURCE_LINE 00000737 "=item C<offset_end>"
NSQ_SOURCE_LINE 00000738 ""
NSQ_SOURCE_LINE 00000739 "Offset_end causes the byte position in the HTML document of the end of"
NSQ_SOURCE_LINE 00000740 "the event to be passed.  This is the same as C<offset> + C<length>."
NSQ_SOURCE_LINE 00000741 ""
NSQ_SOURCE_LINE 00000742 "=item C<self>"
NSQ_SOURCE_LINE 00000743 ""
NSQ_SOURCE_LINE 00000744 "Self causes the current object to be passed to the handler.  If the"
NSQ_SOURCE_LINE 00000745 "handler is a method, this must be the first element in the argspec."
NSQ_SOURCE_LINE 00000746 ""
NSQ_SOURCE_LINE 00000747 "An alternative to passing self as an argspec is to register closures"
NSQ_SOURCE_LINE 00000748 "that capture $self by themselves as handlers.  Unfortunately this"
NSQ_SOURCE_LINE 00000749 "creates circular references which prevent the HTML::Parser object"
NSQ_SOURCE_LINE 00000750 "from being garbage collected.  Using the C<self> argspec avoids this"
NSQ_SOURCE_LINE 00000751 "problem."
NSQ_SOURCE_LINE 00000752 ""
NSQ_SOURCE_LINE 00000753 "=item C<skipped_text>"
NSQ_SOURCE_LINE 00000754 ""
NSQ_SOURCE_LINE 00000755 "Skipped_text returns the concatenated text of all the events that have"
NSQ_SOURCE_LINE 00000756 "been skipped since the last time an event was reported.  Events might"
NSQ_SOURCE_LINE 00000757 "be skipped because no handler is registered for them or because some"
NSQ_SOURCE_LINE 00000758 "filter applies.  Skipped text also includes marked section markup,"
NSQ_SOURCE_LINE 00000759 "since there are no events that can catch it."
NSQ_SOURCE_LINE 00000760 ""
NSQ_SOURCE_LINE 00000761 "If an C<\"\">-handler is registered for an event, then the text for this"
NSQ_SOURCE_LINE 00000762 "event is not included in C<skipped_text>.  Skipped text both before"
NSQ_SOURCE_LINE 00000763 "and after the C<\"\">-event is included in the next reported"
NSQ_SOURCE_LINE 00000764 "C<skipped_text>."
NSQ_SOURCE_LINE 00000765 ""
NSQ_SOURCE_LINE 00000766 "=item C<tag>"
NSQ_SOURCE_LINE 00000767 ""
NSQ_SOURCE_LINE 00000768 "Same as C<tagname>, but prefixed with \"/\" if it belongs to an C<end>"
NSQ_SOURCE_LINE 00000769 "event and \"!\" for a declaration.  The C<tag> does not have any prefix"
NSQ_SOURCE_LINE 00000770 "for C<start> events, and is in this case identical to C<tagname>."
NSQ_SOURCE_LINE 00000771 ""
NSQ_SOURCE_LINE 00000772 "=item C<tagname>"
NSQ_SOURCE_LINE 00000773 ""
NSQ_SOURCE_LINE 00000774 "This is the element name (or I<generic identifier> in SGML jargon) for"
NSQ_SOURCE_LINE 00000775 "start and end tags.  Since HTML is case insensitive, this name is"
NSQ_SOURCE_LINE 00000776 "forced to lower case to ease string matching."
NSQ_SOURCE_LINE 00000777 ""
NSQ_SOURCE_LINE 00000778 "Since XML is case sensitive, the tagname case is not changed when"
NSQ_SOURCE_LINE 00000779 "C<xml_mode> is enabled.  The same happens if the C<case_sensitive> attribute"
NSQ_SOURCE_LINE 00000780 "is set."
NSQ_SOURCE_LINE 00000781 ""
NSQ_SOURCE_LINE 00000782 "The declaration type of declaration elements is also passed as a tagname,"
NSQ_SOURCE_LINE 00000783 "even if that is a bit strange."
NSQ_SOURCE_LINE 00000784 "In fact, in the current implementation tagname is"
NSQ_SOURCE_LINE 00000785 "identical to C<token0> except that the name may be forced to lower case."
NSQ_SOURCE_LINE 00000786 ""
NSQ_SOURCE_LINE 00000787 "=item C<token0>"
NSQ_SOURCE_LINE 00000788 ""
NSQ_SOURCE_LINE 00000789 "Token0 causes the original text of the first token string to be"
NSQ_SOURCE_LINE 00000790 "passed.  This should always be the same as $tokens->[0]."
NSQ_SOURCE_LINE 00000791 ""
NSQ_SOURCE_LINE 00000792 "For C<declaration> events, this is the declaration type."
NSQ_SOURCE_LINE 00000793 ""
NSQ_SOURCE_LINE 00000794 "For C<start> and C<end> events, this is the tag name."
NSQ_SOURCE_LINE 00000795 ""
NSQ_SOURCE_LINE 00000796 "For C<process> and non-strict C<comment> events, this is everything"
NSQ_SOURCE_LINE 00000797 "inside the tag."
NSQ_SOURCE_LINE 00000798 ""
NSQ_SOURCE_LINE 00000799 "This passes undef if there are no tokens in the event."
NSQ_SOURCE_LINE 00000800 ""
NSQ_SOURCE_LINE 00000801 "=item C<tokenpos>"
NSQ_SOURCE_LINE 00000802 ""
NSQ_SOURCE_LINE 00000803 "Tokenpos causes a reference to an array of token positions to be"
NSQ_SOURCE_LINE 00000804 "passed.  For each string that appears in C<tokens>, this array"
NSQ_SOURCE_LINE 00000805 "contains two numbers.  The first number is the offset of the start of"
NSQ_SOURCE_LINE 00000806 "the token in the original C<text> and the second number is the length"
NSQ_SOURCE_LINE 00000807 "of the token."
NSQ_SOURCE_LINE 00000808 ""
NSQ_SOURCE_LINE 00000809 "Boolean attributes in a C<start> event will have (0,0) for the"
NSQ_SOURCE_LINE 00000810 "attribute value offset and length."
NSQ_SOURCE_LINE 00000811 ""
NSQ_SOURCE_LINE 00000812 "This passes undef if there are no tokens in the event (e.g., C<text>)"
NSQ_SOURCE_LINE 00000813 "and for artificial C<end> events triggered by empty element tags."
NSQ_SOURCE_LINE 00000814 ""
NSQ_SOURCE_LINE 00000815 "If you are using these offsets and lengths to modify C<text>, you"
NSQ_SOURCE_LINE 00000816 "should either work from right to left, or be very careful to calculate"
NSQ_SOURCE_LINE 00000817 "the changes to the offsets."
NSQ_SOURCE_LINE 00000818 ""
NSQ_SOURCE_LINE 00000819 "=item C<tokens>"
NSQ_SOURCE_LINE 00000820 ""
NSQ_SOURCE_LINE 00000821 "Tokens causes a reference to an array of token strings to be passed."
NSQ_SOURCE_LINE 00000822 "The strings are exactly as they were found in the original text,"
NSQ_SOURCE_LINE 00000823 "no decoding or case changes are applied."
NSQ_SOURCE_LINE 00000824 ""
NSQ_SOURCE_LINE 00000825 "For C<declaration> events, the array contains each word, comment, and"
NSQ_SOURCE_LINE 00000826 "delimited string starting with the declaration type."
NSQ_SOURCE_LINE 00000827 ""
NSQ_SOURCE_LINE 00000828 "For C<comment> events, this contains each sub-comment.  If"
NSQ_SOURCE_LINE 00000829 "$p->strict_comments is disabled, there will be only one sub-comment."
NSQ_SOURCE_LINE 00000830 ""
NSQ_SOURCE_LINE 00000831 "For C<start> events, this contains the original tag name followed by"
NSQ_SOURCE_LINE 00000832 "the attribute name/value pairs.  The values of boolean attributes will"
NSQ_SOURCE_LINE 00000833 "be either the value set by $p->boolean_attribute_value, or the"
NSQ_SOURCE_LINE 00000834 "attribute name if no value has been set by"
NSQ_SOURCE_LINE 00000835 "$p->boolean_attribute_value."
NSQ_SOURCE_LINE 00000836 ""
NSQ_SOURCE_LINE 00000837 "For C<end> events, this contains the original tag name (always one token)."
NSQ_SOURCE_LINE 00000838 ""
NSQ_SOURCE_LINE 00000839 "For C<process> events, this contains the process instructions (always one"
NSQ_SOURCE_LINE 00000840 "token)."
NSQ_SOURCE_LINE 00000841 ""
NSQ_SOURCE_LINE 00000842 "This passes C<undef> for C<text> events."
NSQ_SOURCE_LINE 00000843 ""
NSQ_SOURCE_LINE 00000844 "=item C<text>"
NSQ_SOURCE_LINE 00000845 ""
NSQ_SOURCE_LINE 00000846 "Text causes the source text (including markup element delimiters) to be"
NSQ_SOURCE_LINE 00000847 "passed."
NSQ_SOURCE_LINE 00000848 ""
NSQ_SOURCE_LINE 00000849 "=item C<undef>"
NSQ_SOURCE_LINE 00000850 ""
NSQ_SOURCE_LINE 00000851 "Pass an undefined value.  Useful as padding where the same handler"
NSQ_SOURCE_LINE 00000852 "routine is registered for multiple events."
NSQ_SOURCE_LINE 00000853 ""
NSQ_SOURCE_LINE 00000854 "=item C<'...'>"
NSQ_SOURCE_LINE 00000855 ""
NSQ_SOURCE_LINE 00000856 "A literal string of 0 to 255 characters enclosed"
NSQ_SOURCE_LINE 00000857 "in single (') or double (\") quotes is passed as entered."
NSQ_SOURCE_LINE 00000858 ""
NSQ_SOURCE_LINE 00000859 "=back"
NSQ_SOURCE_LINE 00000860 ""
NSQ_SOURCE_LINE 00000861 "The whole argspec string can be wrapped up in C<'@{...}'> to signal"
NSQ_SOURCE_LINE 00000862 "that the resulting event array should be flattened.  This only makes a"
NSQ_SOURCE_LINE 00000863 "difference if an array reference is used as the handler target."
NSQ_SOURCE_LINE 00000864 "Consider this example:"
NSQ_SOURCE_LINE 00000865 ""
NSQ_SOURCE_LINE 00000866 "   $p->handler(text => [], 'text');"
NSQ_SOURCE_LINE 00000867 "   $p->handler(text => [], '@{text}']);"
NSQ_SOURCE_LINE 00000868 ""
NSQ_SOURCE_LINE 00000869 "With two text events; C<\"foo\">, C<\"bar\">; then the first example will end"
NSQ_SOURCE_LINE 00000870 "up with [[\"foo\"], [\"bar\"]] and the second with [\"foo\", \"bar\"] in"
NSQ_SOURCE_LINE 00000871 "the handler target array."
NSQ_SOURCE_LINE 00000872 ""
NSQ_SOURCE_LINE 00000873 ""
NSQ_SOURCE_LINE 00000874 "=head2 Events"
NSQ_SOURCE_LINE 00000875 ""
NSQ_SOURCE_LINE 00000876 "Handlers for the following events can be registered:"
NSQ_SOURCE_LINE 00000877 ""
NSQ_SOURCE_LINE 00000878 "=over"
NSQ_SOURCE_LINE 00000879 ""
NSQ_SOURCE_LINE 00000880 "=item C<comment>"
NSQ_SOURCE_LINE 00000881 ""
NSQ_SOURCE_LINE 00000882 "This event is triggered when a markup comment is recognized."
NSQ_SOURCE_LINE 00000883 ""
NSQ_SOURCE_LINE 00000884 "Example:"
NSQ_SOURCE_LINE 00000885 ""
NSQ_SOURCE_LINE 00000886 "  <!-- This is a comment -- -- So is this -->"
NSQ_SOURCE_LINE 00000887 ""
NSQ_SOURCE_LINE 00000888 "=item C<declaration>"
NSQ_SOURCE_LINE 00000889 ""
NSQ_SOURCE_LINE 00000890 "This event is triggered when a I<markup declaration> is recognized."
NSQ_SOURCE_LINE 00000891 ""
NSQ_SOURCE_LINE 00000892 "For typical HTML documents, the only declaration you are"
NSQ_SOURCE_LINE 00000893 "likely to find is <!DOCTYPE ...>."
NSQ_SOURCE_LINE 00000894 ""
NSQ_SOURCE_LINE 00000895 "Example:"
NSQ_SOURCE_LINE 00000896 ""
NSQ_SOURCE_LINE 00000897 "  <!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.01//EN\""
NSQ_SOURCE_LINE 00000898 "      \"http://www.w3.org/TR/html4/strict.dtd\">"
NSQ_SOURCE_LINE 00000899 ""
NSQ_SOURCE_LINE 00000900 "DTDs inside <!DOCTYPE ...> will confuse HTML::Parser."
NSQ_SOURCE_LINE 00000901 ""
NSQ_SOURCE_LINE 00000902 "=item C<default>"
NSQ_SOURCE_LINE 00000903 ""
NSQ_SOURCE_LINE 00000904 "This event is triggered for events that do not have a specific"
NSQ_SOURCE_LINE 00000905 "handler.  You can set up a handler for this event to catch stuff you"
NSQ_SOURCE_LINE 00000906 "did not want to catch explicitly."
NSQ_SOURCE_LINE 00000907 ""
NSQ_SOURCE_LINE 00000908 "=item C<end>"
NSQ_SOURCE_LINE 00000909 ""
NSQ_SOURCE_LINE 00000910 "This event is triggered when an end tag is recognized."
NSQ_SOURCE_LINE 00000911 ""
NSQ_SOURCE_LINE 00000912 "Example:"
NSQ_SOURCE_LINE 00000913 ""
NSQ_SOURCE_LINE 00000914 "  </A>"
NSQ_SOURCE_LINE 00000915 ""
NSQ_SOURCE_LINE 00000916 "=item C<end_document>"
NSQ_SOURCE_LINE 00000917 ""
NSQ_SOURCE_LINE 00000918 "This event is triggered when $p->eof is called and after any remaining"
NSQ_SOURCE_LINE 00000919 "text is flushed.  There is no document text associated with this event."
NSQ_SOURCE_LINE 00000920 ""
NSQ_SOURCE_LINE 00000921 "=item C<process>"
NSQ_SOURCE_LINE 00000922 ""
NSQ_SOURCE_LINE 00000923 "This event is triggered when a processing instructions markup is"
NSQ_SOURCE_LINE 00000924 "recognized."
NSQ_SOURCE_LINE 00000925 ""
NSQ_SOURCE_LINE 00000926 "The format and content of processing instructions are system and"
NSQ_SOURCE_LINE 00000927 "application dependent."
NSQ_SOURCE_LINE 00000928 ""
NSQ_SOURCE_LINE 00000929 "Examples:"
NSQ_SOURCE_LINE 00000930 ""
NSQ_SOURCE_LINE 00000931 "  <? HTML processing instructions >"
NSQ_SOURCE_LINE 00000932 "  <? XML processing instructions ?>"
NSQ_SOURCE_LINE 00000933 ""
NSQ_SOURCE_LINE 00000934 "=item C<start>"
NSQ_SOURCE_LINE 00000935 ""
NSQ_SOURCE_LINE 00000936 "This event is triggered when a start tag is recognized."
NSQ_SOURCE_LINE 00000937 ""
NSQ_SOURCE_LINE 00000938 "Example:"
NSQ_SOURCE_LINE 00000939 ""
NSQ_SOURCE_LINE 00000940 "  <A HREF=\"http://www.perl.com/\">"
NSQ_SOURCE_LINE 00000941 ""
NSQ_SOURCE_LINE 00000942 "=item C<start_document>"
NSQ_SOURCE_LINE 00000943 ""
NSQ_SOURCE_LINE 00000944 "This event is triggered before any other events for a new document.  A"
NSQ_SOURCE_LINE 00000945 "handler for it can be used to initialize stuff.  There is no document"
NSQ_SOURCE_LINE 00000946 "text associated with this event."
NSQ_SOURCE_LINE 00000947 ""
NSQ_SOURCE_LINE 00000948 "=item C<text>"
NSQ_SOURCE_LINE 00000949 ""
NSQ_SOURCE_LINE 00000950 "This event is triggered when plain text (characters) is recognized."
NSQ_SOURCE_LINE 00000951 "The text may contain multiple lines.  A sequence of text may be broken"
NSQ_SOURCE_LINE 00000952 "between several text events unless $p->unbroken_text is enabled."
NSQ_SOURCE_LINE 00000953 ""
NSQ_SOURCE_LINE 00000954 "The parser will make sure that it does not break a word or a sequence"
NSQ_SOURCE_LINE 00000955 "of whitespace between two text events."
NSQ_SOURCE_LINE 00000956 ""
NSQ_SOURCE_LINE 00000957 "=back"
NSQ_SOURCE_LINE 00000958 ""
NSQ_SOURCE_LINE 00000959 "=head2 Unicode"
NSQ_SOURCE_LINE 00000960 ""
NSQ_SOURCE_LINE 00000961 "C<HTML::Parser> can parse Unicode strings when running under"
NSQ_SOURCE_LINE 00000962 "perl-5.8 or better.  If Unicode is passed to $p->parse() then chunks"
NSQ_SOURCE_LINE 00000963 "of Unicode will be reported to the handlers.  The offset and length"
NSQ_SOURCE_LINE 00000964 "argspecs will also report their position in terms of characters."
NSQ_SOURCE_LINE 00000965 ""
NSQ_SOURCE_LINE 00000966 "It is safe to parse raw undecoded UTF-8 if you either avoid decoding"
NSQ_SOURCE_LINE 00000967 "entities and make sure to not use I<argspecs> that do, or enable the"
NSQ_SOURCE_LINE 00000968 "C<utf8_mode> for the parser.  Parsing of undecoded UTF-8 might be"
NSQ_SOURCE_LINE 00000969 "useful when parsing from a file where you need the reported offsets"
NSQ_SOURCE_LINE 00000970 "and lengths to match the byte offsets in the file."
NSQ_SOURCE_LINE 00000971 ""
NSQ_SOURCE_LINE 00000972 "If a filename is passed to $p->parse_file() then the file will be read"
NSQ_SOURCE_LINE 00000973 "in binary mode.  This will be fine if the file contains only ASCII or"
NSQ_SOURCE_LINE 00000974 "Latin-1 characters.  If the file contains UTF-8 encoded text then care"
NSQ_SOURCE_LINE 00000975 "must be taken when decoding entities as described in the previous"
NSQ_SOURCE_LINE 00000976 "paragraph, but better is to open the file with the UTF-8 layer so that"
NSQ_SOURCE_LINE 00000977 "it is decoded properly:"
NSQ_SOURCE_LINE 00000978 ""
NSQ_SOURCE_LINE 00000979 "   open(my $fh, \"<:utf8\", \"index.html\") || die \"...: $!\";"
NSQ_SOURCE_LINE 00000980 "   $p->parse_file($fh);"
NSQ_SOURCE_LINE 00000981 ""
NSQ_SOURCE_LINE 00000982 "If the file contains text encoded in a charset besides ASCII, Latin-1"
NSQ_SOURCE_LINE 00000983 "or UTF-8 then decoding will always be needed."
NSQ_SOURCE_LINE 00000984 ""
NSQ_SOURCE_LINE 00000985 "=head1 VERSION 2 COMPATIBILITY"
NSQ_SOURCE_LINE 00000986 ""
NSQ_SOURCE_LINE 00000987 "When an C<HTML::Parser> object is constructed with no arguments, a set"
NSQ_SOURCE_LINE 00000988 "of handlers is automatically provided that is compatible with the old"
NSQ_SOURCE_LINE 00000989 "HTML::Parser version 2 callback methods."
NSQ_SOURCE_LINE 00000990 ""
NSQ_SOURCE_LINE 00000991 "This is equivalent to the following method calls:"
NSQ_SOURCE_LINE 00000992 ""
NSQ_SOURCE_LINE 00000993 "    $p->handler(start   => \"start\",   \"self, tagname, attr, attrseq, text\");"
NSQ_SOURCE_LINE 00000994 "    $p->handler(end     => \"end\",     \"self, tagname, text\");"
NSQ_SOURCE_LINE 00000995 "    $p->handler(text    => \"text\",    \"self, text, is_cdata\");"
NSQ_SOURCE_LINE 00000996 "    $p->handler(process => \"process\", \"self, token0, text\");"
NSQ_SOURCE_LINE 00000997 "    $p->handler("
NSQ_SOURCE_LINE 00000998 "        comment => sub {"
NSQ_SOURCE_LINE 00000999 "            my ($self, $tokens) = @_;"
NSQ_SOURCE_LINE 00001000 "            for (@$tokens) { $self->comment($_); }"
NSQ_SOURCE_LINE 00001001 "        },"
NSQ_SOURCE_LINE 00001002 "        \"self, tokens\""
NSQ_SOURCE_LINE 00001003 "    );"
NSQ_SOURCE_LINE 00001004 "    $p->handler("
NSQ_SOURCE_LINE 00001005 "        declaration => sub {"
NSQ_SOURCE_LINE 00001006 "            my $self = shift;"
NSQ_SOURCE_LINE 00001007 "            $self->declaration(substr($_[0], 2, -1));"
NSQ_SOURCE_LINE 00001008 "        },"
NSQ_SOURCE_LINE 00001009 "        \"self, text\""
NSQ_SOURCE_LINE 00001010 "    );"
NSQ_SOURCE_LINE 00001011 ""
NSQ_SOURCE_LINE 00001012 "Setting up these handlers can also be requested with the \"api_version =>"
NSQ_SOURCE_LINE 00001013 "2\" constructor option."
NSQ_SOURCE_LINE 00001014 ""
NSQ_SOURCE_LINE 00001015 "=head1 SUBCLASSING"
NSQ_SOURCE_LINE 00001016 ""
NSQ_SOURCE_LINE 00001017 "The C<HTML::Parser> class is able to be subclassed.  Parser objects are plain"
NSQ_SOURCE_LINE 00001018 "hashes and C<HTML::Parser> reserves only hash keys that start with"
NSQ_SOURCE_LINE 00001019 "\"_hparser\".  The parser state can be set up by invoking the init()"
NSQ_SOURCE_LINE 00001020 "method, which takes the same arguments as new()."
NSQ_SOURCE_LINE 00001021 ""
NSQ_SOURCE_LINE 00001022 "=head1 EXAMPLES"
NSQ_SOURCE_LINE 00001023 ""
NSQ_SOURCE_LINE 00001024 "The first simple example shows how you might strip out comments from"
NSQ_SOURCE_LINE 00001025 "an HTML document.  We achieve this by setting up a comment handler that"
NSQ_SOURCE_LINE 00001026 "does nothing and a default handler that will print out anything else:"
NSQ_SOURCE_LINE 00001027 ""
NSQ_SOURCE_LINE 00001028 "    use HTML::Parser ();"
NSQ_SOURCE_LINE 00001029 "    HTML::Parser->new("
NSQ_SOURCE_LINE 00001030 "        default_h => [sub { print shift }, 'text'],"
NSQ_SOURCE_LINE 00001031 "        comment_h => [\"\"],"
NSQ_SOURCE_LINE 00001032 "    )->parse_file(shift || die)"
NSQ_SOURCE_LINE 00001033 "        || die $!;"
NSQ_SOURCE_LINE 00001034 ""
NSQ_SOURCE_LINE 00001035 "An alternative implementation is:"
NSQ_SOURCE_LINE 00001036 ""
NSQ_SOURCE_LINE 00001037 "    use HTML::Parser ();"
NSQ_SOURCE_LINE 00001038 "    HTML::Parser->new("
NSQ_SOURCE_LINE 00001039 "        end_document_h => [sub { print shift }, 'skipped_text'],"
NSQ_SOURCE_LINE 00001040 "        comment_h      => [\"\"],"
NSQ_SOURCE_LINE 00001041 "    )->parse_file(shift || die)"
NSQ_SOURCE_LINE 00001042 "        || die $!;"
NSQ_SOURCE_LINE 00001043 ""
NSQ_SOURCE_LINE 00001044 "This will in most cases be much more efficient since only a single"
NSQ_SOURCE_LINE 00001045 "callback will be made."
NSQ_SOURCE_LINE 00001046 ""
NSQ_SOURCE_LINE 00001047 "The next example prints out the text that is inside the <title>"
NSQ_SOURCE_LINE 00001048 "element of an HTML document.  Here we start by setting up a start"
NSQ_SOURCE_LINE 00001049 "handler.  When it sees the title start tag it enables a text handler"
NSQ_SOURCE_LINE 00001050 "that prints any text found and an end handler that will terminate"
NSQ_SOURCE_LINE 00001051 "parsing as soon as the title end tag is seen:"
NSQ_SOURCE_LINE 00001052 ""
NSQ_SOURCE_LINE 00001053 "    use HTML::Parser ();"
NSQ_SOURCE_LINE 00001054 ""
NSQ_SOURCE_LINE 00001055 "    sub start_handler {"
NSQ_SOURCE_LINE 00001056 "        return if shift ne \"title\";"
NSQ_SOURCE_LINE 00001057 "        my $self = shift;"
NSQ_SOURCE_LINE 00001058 "        $self->handler(text => sub { print shift }, \"dtext\");"
NSQ_SOURCE_LINE 00001059 "        $self->handler("
NSQ_SOURCE_LINE 00001060 "            end => sub {"
NSQ_SOURCE_LINE 00001061 "                shift->eof if shift eq \"title\";"
NSQ_SOURCE_LINE 00001062 "            },"
NSQ_SOURCE_LINE 00001063 "            \"tagname,self\""
NSQ_SOURCE_LINE 00001064 "        );"
NSQ_SOURCE_LINE 00001065 "    }"
NSQ_SOURCE_LINE 00001066 ""
NSQ_SOURCE_LINE 00001067 "    my $p = HTML::Parser->new(api_version => 3);"
NSQ_SOURCE_LINE 00001068 "    $p->handler(start => \\&start_handler, \"tagname,self\");"
NSQ_SOURCE_LINE 00001069 "    $p->parse_file(shift || die) || die $!;"
NSQ_SOURCE_LINE 00001070 "    print \"\\n\";"
NSQ_SOURCE_LINE 00001071 ""
NSQ_SOURCE_LINE 00001072 "More examples are found in the F<eg/> directory of the C<HTML-Parser>"
NSQ_SOURCE_LINE 00001073 "distribution: the program C<hrefsub> shows how you can edit all links"
NSQ_SOURCE_LINE 00001074 "found in a document; the program C<htextsub> shows how to edit the text only; the"
NSQ_SOURCE_LINE 00001075 "program C<hstrip> shows how you can strip out certain tags/elements"
NSQ_SOURCE_LINE 00001076 "and/or attributes; and the program C<htext> show how to obtain the"
NSQ_SOURCE_LINE 00001077 "plain text, but not any script/style content."
NSQ_SOURCE_LINE 00001078 ""
NSQ_SOURCE_LINE 00001079 "You can browse the F<eg/> directory online from the I<[Browse]> link on"
NSQ_SOURCE_LINE 00001080 "the http://search.cpan.org/~gaas/HTML-Parser/ page."
NSQ_SOURCE_LINE 00001081 ""
NSQ_SOURCE_LINE 00001082 "=head1 BUGS"
NSQ_SOURCE_LINE 00001083 ""
NSQ_SOURCE_LINE 00001084 "The <style> and <script> sections do not end with the first \"</\", but"
NSQ_SOURCE_LINE 00001085 "need the complete corresponding end tag.  The standard behaviour is"
NSQ_SOURCE_LINE 00001086 "not really practical."
NSQ_SOURCE_LINE 00001087 ""
NSQ_SOURCE_LINE 00001088 "When the I<strict_comment> option is enabled, we still recognize"
NSQ_SOURCE_LINE 00001089 "comments where there is something other than whitespace between even"
NSQ_SOURCE_LINE 00001090 "and odd \"--\" markers."
NSQ_SOURCE_LINE 00001091 ""
NSQ_SOURCE_LINE 00001092 "Once $p->boolean_attribute_value has been set, there is no way to"
NSQ_SOURCE_LINE 00001093 "restore the default behaviour."
NSQ_SOURCE_LINE 00001094 ""
NSQ_SOURCE_LINE 00001095 "There is currently no way to get both quote characters"
NSQ_SOURCE_LINE 00001096 "into the same literal argspec."
NSQ_SOURCE_LINE 00001097 ""
NSQ_SOURCE_LINE 00001098 "Empty tags, e.g. \"<>\" and \"</>\", are not recognized.  SGML allows them"
NSQ_SOURCE_LINE 00001099 "to repeat the previous start tag or close the previous start tag"
NSQ_SOURCE_LINE 00001100 "respectively."
NSQ_SOURCE_LINE 00001101 ""
NSQ_SOURCE_LINE 00001102 "NET tags, e.g. \"code/.../\" are not recognized.  This is SGML"
NSQ_SOURCE_LINE 00001103 "shorthand for \"<code>...</code>\"."
NSQ_SOURCE_LINE 00001104 ""
NSQ_SOURCE_LINE 00001105 "Incomplete start or end tags, e.g. \"<tt<b>...</b</tt>\" are not"
NSQ_SOURCE_LINE 00001106 "recognized."
NSQ_SOURCE_LINE 00001107 ""
NSQ_SOURCE_LINE 00001108 "=head1 DIAGNOSTICS"
NSQ_SOURCE_LINE 00001109 ""
NSQ_SOURCE_LINE 00001110 "The following messages may be produced by HTML::Parser.  The notation"
NSQ_SOURCE_LINE 00001111 "in this listing is the same as used in L<perldiag>:"
NSQ_SOURCE_LINE 00001112 ""
NSQ_SOURCE_LINE 00001113 "=over"
NSQ_SOURCE_LINE 00001114 ""
NSQ_SOURCE_LINE 00001115 "=item Not a reference to a hash"
NSQ_SOURCE_LINE 00001116 ""
NSQ_SOURCE_LINE 00001117 "(F) The object blessed into or subclassed from HTML::Parser is not a"
NSQ_SOURCE_LINE 00001118 "hash as required by the HTML::Parser methods."
NSQ_SOURCE_LINE 00001119 ""
NSQ_SOURCE_LINE 00001120 "=item Bad signature in parser state object at %p"
NSQ_SOURCE_LINE 00001121 ""
NSQ_SOURCE_LINE 00001122 "(F) The _hparser_xs_state element does not refer to a valid state structure."
NSQ_SOURCE_LINE 00001123 "Something must have changed the internal value"
NSQ_SOURCE_LINE 00001124 "stored in this hash element, or the memory has been overwritten."
NSQ_SOURCE_LINE 00001125 ""
NSQ_SOURCE_LINE 00001126 "=item _hparser_xs_state element is not a reference"
NSQ_SOURCE_LINE 00001127 ""
NSQ_SOURCE_LINE 00001128 "(F) The _hparser_xs_state element has been destroyed."
NSQ_SOURCE_LINE 00001129 ""
NSQ_SOURCE_LINE 00001130 "=item Can't find '_hparser_xs_state' element in HTML::Parser hash"
NSQ_SOURCE_LINE 00001131 ""
NSQ_SOURCE_LINE 00001132 "(F) The _hparser_xs_state element is missing from the parser hash."
NSQ_SOURCE_LINE 00001133 "It was either deleted, or not created when the object was created."
NSQ_SOURCE_LINE 00001134 ""
NSQ_SOURCE_LINE 00001135 "=item API version %s not supported by HTML::Parser %s"
NSQ_SOURCE_LINE 00001136 ""
NSQ_SOURCE_LINE 00001137 "(F) The constructor option 'api_version' with an argument greater than"
NSQ_SOURCE_LINE 00001138 "or equal to 4 is reserved for future extensions."
NSQ_SOURCE_LINE 00001139 ""
NSQ_SOURCE_LINE 00001140 "=item Bad constructor option '%s'"
NSQ_SOURCE_LINE 00001141 ""
NSQ_SOURCE_LINE 00001142 "(F) An unknown constructor option key was passed to the new() or"
NSQ_SOURCE_LINE 00001143 "init() methods."
NSQ_SOURCE_LINE 00001144 ""
NSQ_SOURCE_LINE 00001145 "=item Parse loop not allowed"
NSQ_SOURCE_LINE 00001146 ""
NSQ_SOURCE_LINE 00001147 "(F) A handler invoked the parse() or parse_file() method."
NSQ_SOURCE_LINE 00001148 "This is not permitted."
NSQ_SOURCE_LINE 00001149 ""
NSQ_SOURCE_LINE 00001150 "=item marked sections not supported"
NSQ_SOURCE_LINE 00001151 ""
NSQ_SOURCE_LINE 00001152 "(F) The $p->marked_sections() method was invoked in a HTML::Parser"
NSQ_SOURCE_LINE 00001153 "module that was compiled without support for marked sections."
NSQ_SOURCE_LINE 00001154 ""
NSQ_SOURCE_LINE 00001155 "=item Unknown boolean attribute (%d)"
NSQ_SOURCE_LINE 00001156 ""
NSQ_SOURCE_LINE 00001157 "(F) Something is wrong with the internal logic that set up aliases for"
NSQ_SOURCE_LINE 00001158 "boolean attributes."
NSQ_SOURCE_LINE 00001159 ""
NSQ_SOURCE_LINE 00001160 "=item Only code or array references allowed as handler"
NSQ_SOURCE_LINE 00001161 ""
NSQ_SOURCE_LINE 00001162 "(F) The second argument for $p->handler must be either a subroutine"
NSQ_SOURCE_LINE 00001163 "reference, then name of a subroutine or method, or a reference to an"
NSQ_SOURCE_LINE 00001164 "array."
NSQ_SOURCE_LINE 00001165 ""
NSQ_SOURCE_LINE 00001166 "=item No handler for %s events"
NSQ_SOURCE_LINE 00001167 ""
NSQ_SOURCE_LINE 00001168 "(F) The first argument to $p->handler must be a valid event name; i.e. one"
NSQ_SOURCE_LINE 00001169 "of \"start\", \"end\", \"text\", \"process\", \"declaration\" or \"comment\"."
NSQ_SOURCE_LINE 00001170 ""
NSQ_SOURCE_LINE 00001171 "=item Unrecognized identifier %s in argspec"
NSQ_SOURCE_LINE 00001172 ""
NSQ_SOURCE_LINE 00001173 "(F) The identifier is not a known argspec name."
NSQ_SOURCE_LINE 00001174 "Use one of the names mentioned in the argspec section above."
NSQ_SOURCE_LINE 00001175 ""
NSQ_SOURCE_LINE 00001176 "=item Literal string is longer than 255 chars in argspec"
NSQ_SOURCE_LINE 00001177 ""
NSQ_SOURCE_LINE 00001178 "(F) The current implementation limits the length of literals in"
NSQ_SOURCE_LINE 00001179 "an argspec to 255 characters.  Make the literal shorter."
NSQ_SOURCE_LINE 00001180 ""
NSQ_SOURCE_LINE 00001181 "=item Backslash reserved for literal string in argspec"
NSQ_SOURCE_LINE 00001182 ""
NSQ_SOURCE_LINE 00001183 "(F) The backslash character \"\\\" is not allowed in argspec literals."
NSQ_SOURCE_LINE 00001184 "It is reserved to permit quoting inside a literal in a later version."
NSQ_SOURCE_LINE 00001185 ""
NSQ_SOURCE_LINE 00001186 "=item Unterminated literal string in argspec"
NSQ_SOURCE_LINE 00001187 ""
NSQ_SOURCE_LINE 00001188 "(F) The terminating quote character for a literal was not found."
NSQ_SOURCE_LINE 00001189 ""
NSQ_SOURCE_LINE 00001190 "=item Bad argspec (%s)"
NSQ_SOURCE_LINE 00001191 ""
NSQ_SOURCE_LINE 00001192 "(F) Only identifier names, literals, spaces and commas"
NSQ_SOURCE_LINE 00001193 "are allowed in argspecs."
NSQ_SOURCE_LINE 00001194 ""
NSQ_SOURCE_LINE 00001195 "=item Missing comma separator in argspec"
NSQ_SOURCE_LINE 00001196 ""
NSQ_SOURCE_LINE 00001197 "(F) Identifiers in an argspec must be separated with \",\"."
NSQ_SOURCE_LINE 00001198 ""
NSQ_SOURCE_LINE 00001199 "=item Parsing of undecoded UTF-8 will give garbage when decoding entities"
NSQ_SOURCE_LINE 00001200 ""
NSQ_SOURCE_LINE 00001201 "(W) The first chunk parsed appears to contain undecoded UTF-8 and one"
NSQ_SOURCE_LINE 00001202 "or more argspecs that decode entities are used for the callback"
NSQ_SOURCE_LINE 00001203 "handlers."
NSQ_SOURCE_LINE 00001204 ""
NSQ_SOURCE_LINE 00001205 "The result of decoding will be a mix of encoded and decoded characters"
NSQ_SOURCE_LINE 00001206 "for any entities that expand to characters with code above 127.  This"
NSQ_SOURCE_LINE 00001207 "is not a good thing."
NSQ_SOURCE_LINE 00001208 ""
NSQ_SOURCE_LINE 00001209 "The recommended solution is to apply Encode::decode_utf8() on the data before"
NSQ_SOURCE_LINE 00001210 "feeding it to the $p->parse().  For $p->parse_file() pass a file that has been"
NSQ_SOURCE_LINE 00001211 "opened in \":utf8\" mode."
NSQ_SOURCE_LINE 00001212 ""
NSQ_SOURCE_LINE 00001213 "The alternative solution is to enable the C<utf8_mode> and not decode before"
NSQ_SOURCE_LINE 00001214 "passing strings to $p->parse().  The parser can process raw undecoded UTF-8"
NSQ_SOURCE_LINE 00001215 "sanely if the C<utf8_mode> is enabled, or if the C<attr>, C<@attr> or C<dtext>"
NSQ_SOURCE_LINE 00001216 "argspecs are avoided."
NSQ_SOURCE_LINE 00001217 ""
NSQ_SOURCE_LINE 00001218 "=item Parsing string decoded with wrong endian selection"
NSQ_SOURCE_LINE 00001219 ""
NSQ_SOURCE_LINE 00001220 "(W) The first character in the document is U+FFFE.  This is not a"
NSQ_SOURCE_LINE 00001221 "legal Unicode character but a byte swapped C<BOM>.  The result of parsing"
NSQ_SOURCE_LINE 00001222 "will likely be garbage."
NSQ_SOURCE_LINE 00001223 ""
NSQ_SOURCE_LINE 00001224 "=item Parsing of undecoded UTF-32"
NSQ_SOURCE_LINE 00001225 ""
NSQ_SOURCE_LINE 00001226 "(W) The parser found the Unicode UTF-32 C<BOM> signature at the start"
NSQ_SOURCE_LINE 00001227 "of the document.  The result of parsing will likely be garbage."
NSQ_SOURCE_LINE 00001228 ""
NSQ_SOURCE_LINE 00001229 "=item Parsing of undecoded UTF-16"
NSQ_SOURCE_LINE 00001230 ""
NSQ_SOURCE_LINE 00001231 "(W) The parser found the Unicode UTF-16 C<BOM> signature at the start of"
NSQ_SOURCE_LINE 00001232 "the document.  The result of parsing will likely be garbage."
NSQ_SOURCE_LINE 00001233 ""
NSQ_SOURCE_LINE 00001234 "=back"
NSQ_SOURCE_LINE 00001235 ""
