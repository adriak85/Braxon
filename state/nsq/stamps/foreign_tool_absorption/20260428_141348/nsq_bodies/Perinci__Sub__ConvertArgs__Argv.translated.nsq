BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Perinci::Sub::ConvertArgs::Argv;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2019-04-15'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.110'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use 5.010001;"
NSQ_SOURCE_LINE 00000007 "use strict;"
NSQ_SOURCE_LINE 00000008 "use warnings;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use Data::Sah::Util::Type qw(is_simple);"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "use Exporter;"
NSQ_SOURCE_LINE 00000013 "our @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000014 "our @EXPORT_OK = qw(convert_args_to_argv);"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "our %SPEC;"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "sub _json {"
NSQ_SOURCE_LINE 00000019 "    require JSON;"
NSQ_SOURCE_LINE 00000020 "    state $json = JSON->new->allow_nonref;"
NSQ_SOURCE_LINE 00000021 "    $json->encode($_[0]);"
NSQ_SOURCE_LINE 00000022 "}"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "sub _encode {"
NSQ_SOURCE_LINE 00000025 "    ref($_[0]) ? _json($_[0]) : $_[0];"
NSQ_SOURCE_LINE 00000026 "}"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "$SPEC{convert_args_to_argv} = {"
NSQ_SOURCE_LINE 00000029 "    v => 1.1,"
NSQ_SOURCE_LINE 00000030 "    summary => 'Convert hash arguments to command-line options (and arguments)',"
NSQ_SOURCE_LINE 00000031 "    description => <<'_',"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "Convert hash arguments to command-line arguments. This is the reverse of"
NSQ_SOURCE_LINE 00000034 "`Perinci::Sub::GetArgs::Argv::get_args_from_argv`."
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "Note: currently the function expects schemas in metadata to be normalized"
NSQ_SOURCE_LINE 00000037 "already."
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "_"
NSQ_SOURCE_LINE 00000040 "    args => {"
NSQ_SOURCE_LINE 00000041 "        args => {req=>1, schema=>'hash*', pos=>0},"
NSQ_SOURCE_LINE 00000042 "        meta => {req=>0, schema=>'hash*', pos=>1},"
NSQ_SOURCE_LINE 00000043 "        use_pos => {"
NSQ_SOURCE_LINE 00000044 "            summary => 'Whether to use positional arguments',"
NSQ_SOURCE_LINE 00000045 "            schema  => 'bool',"
NSQ_SOURCE_LINE 00000046 "            description => <<'_',"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "For example, given this metadata:"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "    {"
NSQ_SOURCE_LINE 00000051 "        v => 1.1,"
NSQ_SOURCE_LINE 00000052 "        args => {"
NSQ_SOURCE_LINE 00000053 "          arg1 => {pos=>0, req=>1},"
NSQ_SOURCE_LINE 00000054 "          arg2 => {pos=>1},"
NSQ_SOURCE_LINE 00000055 "          arg3 => {},"
NSQ_SOURCE_LINE 00000056 "        },"
NSQ_SOURCE_LINE 00000057 "    }"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "then under `use_pos=0` the hash `{arg1=>1, arg2=>2, arg3=>'a b'}` will be"
NSQ_SOURCE_LINE 00000060 "converted to `['--arg1', 1, '--arg2', 2, '--arg3', 'a b']`. Meanwhile if"
NSQ_SOURCE_LINE 00000061 "`use_pos=1` the same hash will be converted to `[1, 2, '--arg3', 'a b']`."
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "_"
NSQ_SOURCE_LINE 00000064 "        },"
NSQ_SOURCE_LINE 00000065 "    },"
NSQ_SOURCE_LINE 00000066 "};"
NSQ_SOURCE_LINE 00000067 "sub convert_args_to_argv {"
NSQ_SOURCE_LINE 00000068 "    my %fargs = @_;"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "    my $iargs = $fargs{args} or return [400, \"Please specify args\"];"
NSQ_SOURCE_LINE 00000071 "    my $meta  = $fargs{meta} // {v=>1.1};"
NSQ_SOURCE_LINE 00000072 "    my $args_prop = $meta->{args} // {};"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "    my $v = $meta->{v} // 1.0;"
NSQ_SOURCE_LINE 00000075 "    return [412, \"Sorry, only metadata version 1.1 is supported (yours: $v)\"]"
NSQ_SOURCE_LINE 00000076 "        unless $v == 1.1;"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "    my @argv;"
NSQ_SOURCE_LINE 00000079 "    my %iargs = %$iargs; # copy 'coz we will delete them one by one as we fill"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "    if ($fargs{use_pos}) {"
NSQ_SOURCE_LINE 00000082 "        for my $arg (sort {$args_prop->{$a}{pos} <=> $args_prop->{$b}{pos}}"
NSQ_SOURCE_LINE 00000083 "                         grep {defined $args_prop->{$_}{pos}} keys %iargs) {"
NSQ_SOURCE_LINE 00000084 "            my $pos = $args_prop->{$arg}{pos};"
NSQ_SOURCE_LINE 00000085 "            if ($args_prop->{$arg}{slurpy} // $args_prop->{$arg}{greedy}) {"
NSQ_SOURCE_LINE 00000086 "                my $sch = $args_prop->{$arg}{schema};"
NSQ_SOURCE_LINE 00000087 "                my $is_array_of_simple = $sch && $sch->[0] eq 'array' &&"
NSQ_SOURCE_LINE 00000088 "                    is_simple($sch->[1]{of} // $sch->[1]{each_elem});"
NSQ_SOURCE_LINE 00000089 "                for my $el (@{ $iargs{$arg} }) {"
NSQ_SOURCE_LINE 00000090 "                    $argv[$pos] = $is_array_of_simple ? $el : _encode($el);"
NSQ_SOURCE_LINE 00000091 "                    $pos++;"
NSQ_SOURCE_LINE 00000092 "                }"
NSQ_SOURCE_LINE 00000093 "            } else {"
NSQ_SOURCE_LINE 00000094 "                $argv[$pos] = _encode($iargs{$arg});"
NSQ_SOURCE_LINE 00000095 "            }"
NSQ_SOURCE_LINE 00000096 "            delete $iargs{$arg};"
NSQ_SOURCE_LINE 00000097 "        }"
NSQ_SOURCE_LINE 00000098 "    }"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "    for (sort keys %iargs) {"
NSQ_SOURCE_LINE 00000101 "        my $sch = $args_prop->{$_}{schema};"
NSQ_SOURCE_LINE 00000102 "        my $is_bool = $sch && $sch->[0] eq 'bool';"
NSQ_SOURCE_LINE 00000103 "        my $is_array_of_simple = $sch && $sch->[0] eq 'array' &&"
NSQ_SOURCE_LINE 00000104 "            $sch->[1]{of} && is_simple($sch->[1]{of});"
NSQ_SOURCE_LINE 00000105 "        my $is_hash_of_simple = $sch && $sch->[0] eq 'hash' &&"
NSQ_SOURCE_LINE 00000106 "            is_simple($sch->[1]{of} // $sch->[1]{each_value} // $sch->[1]{each_elem});"
NSQ_SOURCE_LINE 00000107 "        my $can_be_comma_separated = $is_array_of_simple &&"
NSQ_SOURCE_LINE 00000108 "            $sch->[1]{of}[0] =~ /\\A(int|float)\\z/; # XXX as well as other simple types that cannot contain commas"
NSQ_SOURCE_LINE 00000109 "        my $opt = $_; $opt =~ s/_/-/g;"
NSQ_SOURCE_LINE 00000110 "        my $dashopt = length($opt) > 1 ? \"--$opt\" : \"-$opt\";"
NSQ_SOURCE_LINE 00000111 "        if ($is_bool) {"
NSQ_SOURCE_LINE 00000112 "            if ($iargs{$_}) {"
NSQ_SOURCE_LINE 00000113 "                push @argv, $dashopt;"
NSQ_SOURCE_LINE 00000114 "            } else {"
NSQ_SOURCE_LINE 00000115 "                push @argv, \"--no$opt\";"
NSQ_SOURCE_LINE 00000116 "            }"
NSQ_SOURCE_LINE 00000117 "        } elsif ($can_be_comma_separated) {"
NSQ_SOURCE_LINE 00000118 "            push @argv, \"$dashopt\", join(\",\", @{ $iargs{$_} });"
NSQ_SOURCE_LINE 00000119 "        } elsif ($is_array_of_simple) {"
NSQ_SOURCE_LINE 00000120 "            for (@{ $iargs{$_} }) {"
NSQ_SOURCE_LINE 00000121 "                push @argv, \"$dashopt\", $_;"
NSQ_SOURCE_LINE 00000122 "            }"
NSQ_SOURCE_LINE 00000123 "        } elsif ($is_hash_of_simple) {"
NSQ_SOURCE_LINE 00000124 "            my $arg = $iargs{$_};"
NSQ_SOURCE_LINE 00000125 "            for (sort keys %$arg) {"
NSQ_SOURCE_LINE 00000126 "                push @argv, \"$dashopt\", \"$_=$arg->{$_}\";"
NSQ_SOURCE_LINE 00000127 "            }"
NSQ_SOURCE_LINE 00000128 "        } else {"
NSQ_SOURCE_LINE 00000129 "            if (ref $iargs{$_}) {"
NSQ_SOURCE_LINE 00000130 "                push @argv, \"$dashopt-json\", _encode($iargs{$_});"
NSQ_SOURCE_LINE 00000131 "            } else {"
NSQ_SOURCE_LINE 00000132 "                push @argv, $dashopt, \"$iargs{$_}\";"
NSQ_SOURCE_LINE 00000133 "            }"
NSQ_SOURCE_LINE 00000134 "        }"
NSQ_SOURCE_LINE 00000135 "    }"
NSQ_SOURCE_LINE 00000136 "    [200, \"OK\", \\@argv];"
NSQ_SOURCE_LINE 00000137 "}"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "1;"
NSQ_SOURCE_LINE 00000140 "# ABSTRACT: Convert hash arguments to command-line options (and arguments)"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "__END__"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "=pod"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "=head1 NAME"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "Perinci::Sub::ConvertArgs::Argv - Convert hash arguments to command-line options (and arguments)"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "=head1 VERSION"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "This document describes version 0.110 of Perinci::Sub::ConvertArgs::Argv (from Perl distribution Perinci-Sub-ConvertArgs-Argv), released on 2019-04-15."
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 " use Perinci::Sub::ConvertArgs::Argv qw(convert_args_to_argv);"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 " my $res = convert_args_to_argv(args=>\\%args, meta=>$meta, ...);"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "=head2 convert_args_to_argv"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "Usage:"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 " convert_args_to_argv(%args) -> [status, msg, payload, meta]"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "Convert hash arguments to command-line options (and arguments)."
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "Convert hash arguments to command-line arguments. This is the reverse of"
NSQ_SOURCE_LINE 00000174 "C<Perinci::Sub::GetArgs::Argv::get_args_from_argv>."
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "Note: currently the function expects schemas in metadata to be normalized"
NSQ_SOURCE_LINE 00000177 "already."
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "=over 4"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "=item * B<args>* => I<hash>"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "=item * B<meta> => I<hash>"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "=item * B<use_pos> => I<bool>"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "Whether to use positional arguments."
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "For example, given this metadata:"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 " {"
NSQ_SOURCE_LINE 00000196 "     v => 1.1,"
NSQ_SOURCE_LINE 00000197 "     args => {"
NSQ_SOURCE_LINE 00000198 "       arg1 => {pos=>0, req=>1},"
NSQ_SOURCE_LINE 00000199 "       arg2 => {pos=>1},"
NSQ_SOURCE_LINE 00000200 "       arg3 => {},"
NSQ_SOURCE_LINE 00000201 "     },"
NSQ_SOURCE_LINE 00000202 " }"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "then under C<use_pos=0> the hash C<< {arg1=E<gt>1, arg2=E<gt>2, arg3=E<gt>'a b'} >> will be"
NSQ_SOURCE_LINE 00000205 "converted to C<['--arg1', 1, '--arg2', 2, '--arg3', 'a b']>. Meanwhile if"
NSQ_SOURCE_LINE 00000206 "C<use_pos=1> the same hash will be converted to C<[1, 2, '--arg3', 'a b']>."
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "=back"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "Returns an enveloped result (an array)."
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "First element (status) is an integer containing HTTP status code"
NSQ_SOURCE_LINE 00000213 "(200 means OK, 4xx caller error, 5xx function error). Second element"
NSQ_SOURCE_LINE 00000214 "(msg) is a string containing error message, or 'OK' if status is"
NSQ_SOURCE_LINE 00000215 "200. Third element (payload) is optional, the actual result. Fourth"
NSQ_SOURCE_LINE 00000216 "element (meta) is called result metadata and is optional, a hash"
NSQ_SOURCE_LINE 00000217 "that contains extra information."
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "Return value:  (any)"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "Please visit the project's homepage at L<https://metacpan.org/release/Perinci-Sub-ConvertArgs-Argv>."
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "Source repository is at L<https://github.com/perlancar/perl-Perinci-Sub-ConvertArgs-Argv>."
NSQ_SOURCE_LINE 00000228 ""
