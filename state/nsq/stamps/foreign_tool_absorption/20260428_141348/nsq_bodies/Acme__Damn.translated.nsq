BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Acme::Damn;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.000;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "use Exporter;"
NSQ_SOURCE_LINE 00000008 "use DynaLoader;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use vars qw( $VERSION @ISA @EXPORT @EXPORT_OK );"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "  $VERSION    = '0.09';"
NSQ_SOURCE_LINE 00000013 "  @ISA        = qw( Exporter DynaLoader );"
NSQ_SOURCE_LINE 00000014 "  @EXPORT     = qw( damn                );"
NSQ_SOURCE_LINE 00000015 "  @EXPORT_OK  = qw( bless               );"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "# ensure we aren't exposed to changes in inherited AUTOLOAD behaviour"
NSQ_SOURCE_LINE 00000018 "*Acme::Damn::AUTOLOAD   = *DynaLoader::AUTOLOAD;"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "sub import"
NSQ_SOURCE_LINE 00000022 "{"
NSQ_SOURCE_LINE 00000023 "  my  $class    = shift;"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "  # check the unknown symbols to ensure they are 'safe'"
NSQ_SOURCE_LINE 00000026 "  my  @bad      = grep { /\\W/o } @_;"
NSQ_SOURCE_LINE 00000027 "  if ( @bad ) {"
NSQ_SOURCE_LINE 00000028 "    # throw an error message informing the user where the problem is"
NSQ_SOURCE_LINE 00000029 "    my  ( undef, $file , $line )    = caller 0;"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "    die sprintf( \"Bad choice of symbol name%s %s for import at %s line %s\\n\""
NSQ_SOURCE_LINE 00000032 "                 , ( @bad == 1 ) ? '' : 's'"
NSQ_SOURCE_LINE 00000033 "                 , join( ', ' , map { qq|'$_'| } @bad ) , $file , $line );"
NSQ_SOURCE_LINE 00000034 "  }"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "  # remove duplicates from the list of aliases, as well as those symbol"
NSQ_SOURCE_LINE 00000037 "  # names listed in @EXPORT"
NSQ_SOURCE_LINE 00000038 "  #   - we keep @EXPORT_OK in a separate list since they are optionally"
NSQ_SOURCE_LINE 00000039 "  #     requested at use() time"
NSQ_SOURCE_LINE 00000040 "  my  @aliases  = do {  local %_;"
NSQ_SOURCE_LINE 00000041 "                              @_{ @_         } = undef;"
NSQ_SOURCE_LINE 00000042 "                       delete @_{ @EXPORT    };"
NSQ_SOURCE_LINE 00000043 "                         keys %_"
NSQ_SOURCE_LINE 00000044 "                     };"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "  # 'import' the symbols into the host package"
NSQ_SOURCE_LINE 00000047 "  #   - ensure 'EXPORT_OK' is correctly honoured"
NSQ_SOURCE_LINE 00000048 "  my    %reserved   = map { $_ => 1 } @EXPORT , @EXPORT_OK;"
NSQ_SOURCE_LINE 00000049 "  my    @reserved   = ();"
NSQ_SOURCE_LINE 00000050 "  my  ( $pkg )      = caller 1;"
NSQ_SOURCE_LINE 00000051 "  foreach my $alias ( @aliases ) {"
NSQ_SOURCE_LINE 00000052 "    # if this alias is a reserved symbol as defined by @EXPORT et al."
NSQ_SOURCE_LINE 00000053 "    # then add it to the list of symbols to export"
NSQ_SOURCE_LINE 00000054 "        $reserved{ $alias }"
NSQ_SOURCE_LINE 00000055 "    and push @reserved , $alias"
NSQ_SOURCE_LINE 00000056 "    and next;"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "    # otherwise, create an alias for 'damn'"
NSQ_SOURCE_LINE 00000059 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "    *{ $pkg . '::' . $alias } = sub {"
NSQ_SOURCE_LINE 00000062 "        my    $ref                      = shift;"
NSQ_SOURCE_LINE 00000063 "        my  ( undef , $file , $line )   = caller 1;"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "        # call damn() with the location of where this method was"
NSQ_SOURCE_LINE 00000066 "        # originally called"
NSQ_SOURCE_LINE 00000067 "        &{ __PACKAGE__ . '::damn' }( $ref , $alias , $file , $line );"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "        # NB: wanted to do something like"
NSQ_SOURCE_LINE 00000070 "        #         goto \\&{ __PACKAGE__ . '::damn' };"
NSQ_SOURCE_LINE 00000071 "        #     having set the @_ array appropriately, but this caused a"
NSQ_SOURCE_LINE 00000072 "        #     \"Attempt to free unrefernced SV\" error that I couldn't solve"
NSQ_SOURCE_LINE 00000073 "        #     - I think it was to do with the @_ array"
NSQ_SOURCE_LINE 00000074 "      };"
NSQ_SOURCE_LINE 00000075 "  }"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "  # add the known symbols to @_"
NSQ_SOURCE_LINE 00000078 "  splice @_ , 0;  push @_ , $class , @reserved;"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "  # run the \"proper\" import() routine"
NSQ_SOURCE_LINE 00000081 "  goto \\&Exporter::import;"
NSQ_SOURCE_LINE 00000082 "} # import()"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "bootstrap Acme::Damn $VERSION;"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "1;  # end of module"
NSQ_SOURCE_LINE 00000089 "__END__"
NSQ_SOURCE_LINE 00000090 "=pod"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "=head1 NAME"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "Acme::Damn - 'Unbless' Perl objects."
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "  use Acme::Damn;"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "  my $ref = ... some reference ..."
NSQ_SOURCE_LINE 00000102 "  my $obj = bless $ref , 'Some::Class';"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "  ... do something with your object ..."
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "     $ref = damn $obj;   # recover the original reference (unblessed)"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "  ... neither $ref nor $obj are Some::Class objects ..."
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "B<Acme::Damn> provides a single routine, B<damn()>, which takes a blessed"
NSQ_SOURCE_LINE 00000114 "reference (a Perl object), and I<unblesses> it, to return the original"
NSQ_SOURCE_LINE 00000115 "reference."
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "=head2 EXPORT"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "By default, B<Acme::Damn> exports the method B<damn()> into the current"
NSQ_SOURCE_LINE 00000121 "namespace. Aliases for B<damn()> (see below) may be imported upon request."
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "=head2 Methods"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "=over 4"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "=item B<damn> I<object>"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "B<damn()> accepts a single blessed reference as its argument, and returns"
NSQ_SOURCE_LINE 00000130 "that reference unblessed. If I<object> is not a blessed reference, then"
NSQ_SOURCE_LINE 00000131 "B<damn()> will C<die> with an error."
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "=item B<bless> I<reference>"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "=item B<bless> I<reference> [ , I<package> ]"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "=item B<bless> I<reference> [ , undef ]"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "Optionally, B<Acme::Damn> will modify the behaviour of C<bless> to"
NSQ_SOURCE_LINE 00000141 "allow the passing of an explicit C<undef> as the target package to invoke"
NSQ_SOURCE_LINE 00000142 "B<damn()>:"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "    use Acme::Damn  qw( bless );"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "    my  $obj = ... some blessed reference ...;"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "    # the following statements are equivalent"
NSQ_SOURCE_LINE 00000149 "    my  $ref = bless $obj , undef;"
NSQ_SOURCE_LINE 00000150 "    my  $ref = damn $obj;"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "B<NOTE:> The modification of C<bless> is lexically scoped to the current"
NSQ_SOURCE_LINE 00000153 "package, and is I<not> global."
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "=back"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "=head2 Method Aliases"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "Not everyone likes to damn the same way or in the same language, so"
NSQ_SOURCE_LINE 00000162 "B<Acme::Damn> offers the ability to specify any alias on import, provided"
NSQ_SOURCE_LINE 00000163 "that alias is a valid Perl subroutine name (i.e. all characters match C<\\w>)."
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "  use Acme::Damn qw( unbless );"
NSQ_SOURCE_LINE 00000166 "  use Acme::Damn qw( foo );"
NSQ_SOURCE_LINE 00000167 "  use Acme::Damn qw( unblessthyself );"
NSQ_SOURCE_LINE 00000168 "  use Acme::Damn qw( recant );"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "Version 0.02 supported a defined list of aliases, and this has been replaced"
NSQ_SOURCE_LINE 00000171 "in v0.03 by the ability to import any alias for C<damn()>."
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "=head1 WARNING"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "Just as C<bless> doesn't call an object's initialisation code, C<damn> doesn't"
NSQ_SOURCE_LINE 00000177 "invoke an object's C<DESTROY> method. For objects that need to be C<DESTROY>ed,"
NSQ_SOURCE_LINE 00000178 "either don't C<damn> them, or call C<DESTROY> before judgement is passed."
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "=head1 ACKNOWLEDGEMENTS"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "Thanks to Claes Jacobsson E<lt>claes@surfar.nuE<gt> for suggesting the use of"
NSQ_SOURCE_LINE 00000184 "aliases, and Bo Lindbergh E<lt>blgl@cpan.orgE<gt> for the suggested"
NSQ_SOURCE_LINE 00000185 "modification of C<bless>."
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "L<bless|perlfunc/bless>, L<perlboot>, L<perltoot>, L<perltooc>, L<perlbot>,"
NSQ_SOURCE_LINE 00000191 "L<perlobj>."
