NSQ_SOURCE_LINE 00000001 "package Clone::Util;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2016-03-10'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.03'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use 5.010001;"
NSQ_SOURCE_LINE 00000007 "use strict;"
NSQ_SOURCE_LINE 00000008 "use warnings;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use Function::Fallback::CoreOrPP qw(clone);"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "use Exporter qw(import);"
NSQ_SOURCE_LINE 00000013 "our @EXPORT_OK = qw(clone modclone sclone);"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "sub modclone(&$;@) {"
NSQ_SOURCE_LINE 00000016 "    my $code = shift;"
NSQ_SOURCE_LINE 00000017 "    my $data = shift;"
NSQ_SOURCE_LINE 00000018 "    my $clone = clone($data);"
NSQ_SOURCE_LINE 00000019 "    local $_ = $clone;"
NSQ_SOURCE_LINE 00000020 "    $code->($clone);"
NSQ_SOURCE_LINE 00000021 "    if (@_ || wantarray) {"
NSQ_SOURCE_LINE 00000022 "        return ($clone, @_);"
NSQ_SOURCE_LINE 00000023 "    } else {"
NSQ_SOURCE_LINE 00000024 "        return $clone;"
NSQ_SOURCE_LINE 00000025 "    }"
NSQ_SOURCE_LINE 00000026 "}"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "sub sclone($) {"
NSQ_SOURCE_LINE 00000029 "    my $data = shift;"
NSQ_SOURCE_LINE 00000030 "    my $ref = ref($data);"
NSQ_SOURCE_LINE 00000031 "    if ($ref eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000032 "        return [@$data];"
NSQ_SOURCE_LINE 00000033 "    } elsif ($ref eq 'HASH') {"
NSQ_SOURCE_LINE 00000034 "        return {%$data};"
NSQ_SOURCE_LINE 00000035 "    } else {"
NSQ_SOURCE_LINE 00000036 "        die \"Cannot shallow clone $data ($ref)\";"
NSQ_SOURCE_LINE 00000037 "    }"
NSQ_SOURCE_LINE 00000038 "}"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "1;"
NSQ_SOURCE_LINE 00000041 "# ABSTRACT: Utilities related to cloning"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "__END__"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "=pod"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "=head1 NAME"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "Clone::Util - Utilities related to cloning"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "=head1 VERSION"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "This document describes version 0.03 of Clone::Util (from Perl distribution Clone-Util), released on 2016-03-10."
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 " use Clone::Util qw(modclone sclone);"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 " my $row = {name=>'ujang', gender=>'m', nationality=>'id'};"
NSQ_SOURCE_LINE 00000062 " my $table = ["
NSQ_SOURCE_LINE 00000063 "     $row,"
NSQ_SOURCE_LINE 00000064 "     modclone { $_->{name} = 'budi' } $row,"
NSQ_SOURCE_LINE 00000065 "     modclone { $_->{name} = 'asep' } $row,"
NSQ_SOURCE_LINE 00000066 "     modclone { $_->{name} = 'rini'; $_->{gender} = 'f' } $row,"
NSQ_SOURCE_LINE 00000067 " ];"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 " my $shallow_clone = sclone($data);"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "None of the functions are exported by default, but they are exportable."
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "=head2 clone($data) => $cloned"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "This is just re-exported L<Function::Fallback::CoreOrPP>'s C<clone()>."
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "=head2 modclone(\\&code, $data) => $clone"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "Clone C<$data> and then run code. Code will be given the clone of data. For"
NSQ_SOURCE_LINE 00000082 "convenience, C<$_> will also be localized and set to the clone of data. So you"
NSQ_SOURCE_LINE 00000083 "can access the clone using C<$_> in addition to C<$_[0]>."
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "=head2 sclone($data) => $clone"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "Shallow-clone C<$data>, which must be an arrayref or a hashref. Shallow cloning"
NSQ_SOURCE_LINE 00000088 "means only copying the first level of data."
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 " my $array = [0,1,2,[3]];"
NSQ_SOURCE_LINE 00000091 " my $clone = sclone $array; # => [0,1,2,[3]], but [3] is still the same reference"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 " $clone->[3][0] = \"three\"; # $clone as well as $array become [0,1,2,[\"three\"]]"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 " $clone->[0] = \"zero\"; # $clone becomes [\"zero\",1,...] but $array still [0,1,...]"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "You can perform shallow copying trivially yourself using:"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 " my $cloned_array = [@$array];"
NSQ_SOURCE_LINE 00000100 " my $cloned_hash  = {%$hash};"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "Please visit the project's homepage at L<https://metacpan.org/release/Clone-Util>."
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "Source repository is at L<https://github.com/perlancar/perl-Clone-Util>."
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "=head1 BUGS"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "Please report any bugs or feature requests on the bugtracker website L<https://rt.cpan.org/Public/Dist/Display.html?Name=Clone-Util>"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "When submitting a bug or request, please include a test-file or a"
NSQ_SOURCE_LINE 00000115 "patch to an existing test-file that illustrates the bug or desired"
NSQ_SOURCE_LINE 00000116 "feature."
NSQ_SOURCE_LINE 00000117 ""
