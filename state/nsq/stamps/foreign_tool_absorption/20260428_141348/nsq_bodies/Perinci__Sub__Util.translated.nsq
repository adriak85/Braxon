NSQ_SOURCE_LINE 00000001 "package Perinci::Sub::Util;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.010001;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 "use Log::ger;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use Exporter qw(import);"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000011 "our $DATE = '2023-10-28'; # DATE"
NSQ_SOURCE_LINE 00000012 "our $DIST = 'Perinci-Sub-Util'; # DIST"
NSQ_SOURCE_LINE 00000013 "our $VERSION = '0.472'; # VERSION"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000016 "                       err"
NSQ_SOURCE_LINE 00000017 "                       caller"
NSQ_SOURCE_LINE 00000018 "                       warn_err"
NSQ_SOURCE_LINE 00000019 "                       die_err"
NSQ_SOURCE_LINE 00000020 "                       gen_modified_sub"
NSQ_SOURCE_LINE 00000021 "                       gen_curried_sub"
NSQ_SOURCE_LINE 00000022 "               );"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "our %SPEC;"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "$SPEC{':package'} = {"
NSQ_SOURCE_LINE 00000027 "    v => 1.1,"
NSQ_SOURCE_LINE 00000028 "    summary => 'Helper when writing functions',"
NSQ_SOURCE_LINE 00000029 "};"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "our $STACK_TRACE;"
NSQ_SOURCE_LINE 00000032 "our @_c; # to store temporary celler() result"
NSQ_SOURCE_LINE 00000033 "our $_i; # temporary variable"
NSQ_SOURCE_LINE 00000034 "sub err {"
NSQ_SOURCE_LINE 00000035 "    require Scalar::Util;"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "    # get information about caller"
NSQ_SOURCE_LINE 00000038 "    my @caller = CORE::caller(1);"
NSQ_SOURCE_LINE 00000039 "    if (!@caller) {"
NSQ_SOURCE_LINE 00000040 "        # probably called from command-line (-e)"
NSQ_SOURCE_LINE 00000041 "        @caller = (\"main\", \"-e\", 1, \"program\");"
NSQ_SOURCE_LINE 00000042 "    }"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "    my ($status, $msg, $meta, $prev);"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "    for (@_) {"
NSQ_SOURCE_LINE 00000047 "        my $ref = ref($_);"
NSQ_SOURCE_LINE 00000048 "        if ($ref eq 'ARRAY') { $prev = $_ }"
NSQ_SOURCE_LINE 00000049 "        elsif ($ref eq 'HASH') { $meta = $_ }"
NSQ_SOURCE_LINE 00000050 "        elsif (!$ref) {"
NSQ_SOURCE_LINE 00000051 "            if (Scalar::Util::looks_like_number($_)) {"
NSQ_SOURCE_LINE 00000052 "                $status = $_;"
NSQ_SOURCE_LINE 00000053 "            } else {"
NSQ_SOURCE_LINE 00000054 "                $msg = $_;"
NSQ_SOURCE_LINE 00000055 "            }"
NSQ_SOURCE_LINE 00000056 "        }"
NSQ_SOURCE_LINE 00000057 "    }"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "    $status //= 500;"
NSQ_SOURCE_LINE 00000060 "    $msg  //= \"$caller[3] failed\";"
NSQ_SOURCE_LINE 00000061 "    $meta //= {};"
NSQ_SOURCE_LINE 00000062 "    $meta->{prev} //= $prev if $prev;"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "    # put information on who produced this error and where/when"
NSQ_SOURCE_LINE 00000065 "    if (!$meta->{logs}) {"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "        # should we produce a stack trace?"
NSQ_SOURCE_LINE 00000068 "        my $stack_trace;"
NSQ_SOURCE_LINE 00000069 "        {"
NSQ_SOURCE_LINE 00000070 "            no warnings;"
NSQ_SOURCE_LINE 00000071 "            # we use Carp::Always as a sign that user wants stack traces"
NSQ_SOURCE_LINE 00000072 "            last unless $STACK_TRACE // $INC{\"Carp/Always.pm\"};"
NSQ_SOURCE_LINE 00000073 "            # stack trace is already there in previous result's log"
NSQ_SOURCE_LINE 00000074 "            last if $prev && ref($prev->[3]) eq 'HASH' &&"
NSQ_SOURCE_LINE 00000075 "                ref($prev->[3]{logs}) eq 'ARRAY' &&"
NSQ_SOURCE_LINE 00000076 "                    ref($prev->[3]{logs}[0]) eq 'HASH' &&"
NSQ_SOURCE_LINE 00000077 "                        $prev->[3]{logs}[0]{stack_trace};"
NSQ_SOURCE_LINE 00000078 "            $stack_trace = [];"
NSQ_SOURCE_LINE 00000079 "            $_i = 1;"
NSQ_SOURCE_LINE 00000080 "            while (1) {"
NSQ_SOURCE_LINE 00000081 "                {"
NSQ_SOURCE_LINE 00000082 "                    package DB;"
NSQ_SOURCE_LINE 00000083 "                    @_c = CORE::caller($_i);"
NSQ_SOURCE_LINE 00000084 "                    if (@_c) {"
NSQ_SOURCE_LINE 00000085 "                        $_c[4] = [@DB::args];"
NSQ_SOURCE_LINE 00000086 "                    }"
NSQ_SOURCE_LINE 00000087 "                }"
NSQ_SOURCE_LINE 00000088 "                last unless @_c;"
NSQ_SOURCE_LINE 00000089 "                push @$stack_trace, [@_c];"
NSQ_SOURCE_LINE 00000090 "                $_i++;"
NSQ_SOURCE_LINE 00000091 "            }"
NSQ_SOURCE_LINE 00000092 "        }"
NSQ_SOURCE_LINE 00000093 "        push @{ $meta->{logs} }, {"
NSQ_SOURCE_LINE 00000094 "            type    => 'create',"
NSQ_SOURCE_LINE 00000095 "            time    => time(),"
NSQ_SOURCE_LINE 00000096 "            package => $caller[0],"
NSQ_SOURCE_LINE 00000097 "            file    => $caller[1],"
NSQ_SOURCE_LINE 00000098 "            line    => $caller[2],"
NSQ_SOURCE_LINE 00000099 "            func    => $caller[3],"
NSQ_SOURCE_LINE 00000100 "            ( stack_trace => $stack_trace ) x !!$stack_trace,"
NSQ_SOURCE_LINE 00000101 "        };"
NSQ_SOURCE_LINE 00000102 "    }"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "    #die;"
NSQ_SOURCE_LINE 00000105 "    [$status, $msg, undef, $meta];"
NSQ_SOURCE_LINE 00000106 "}"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "sub warn_err {"
NSQ_SOURCE_LINE 00000109 "    require Carp;"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "    my $res = err(@_);"
NSQ_SOURCE_LINE 00000112 "    Carp::carp(\"ERROR $res->[0]: $res->[1]\");"
NSQ_SOURCE_LINE 00000113 "}"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "sub die_err {"
NSQ_SOURCE_LINE 00000116 "    require Carp;"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "    my $res = err(@_);"
NSQ_SOURCE_LINE 00000119 "    Carp::croak(\"ERROR $res->[0]: $res->[1]\");"
NSQ_SOURCE_LINE 00000120 "}"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "sub caller {"
NSQ_SOURCE_LINE 00000123 "    my $n0 = shift;"
NSQ_SOURCE_LINE 00000124 "    my $n  = $n0 // 0;"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "    my $pkg = $Perinci::Sub::Wrapper::default_wrapped_package //"
NSQ_SOURCE_LINE 00000127 "        'Perinci::Sub::Wrapped';"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "    my @r;"
NSQ_SOURCE_LINE 00000130 "    my $i =  0;"
NSQ_SOURCE_LINE 00000131 "    my $j = -1;"
NSQ_SOURCE_LINE 00000132 "    while ($i <= $n+1) { # +1 for this sub itself"
NSQ_SOURCE_LINE 00000133 "        $j++;"
NSQ_SOURCE_LINE 00000134 "        @r = CORE::caller($j);"
NSQ_SOURCE_LINE 00000135 "        last unless @r;"
NSQ_SOURCE_LINE 00000136 "        if ($r[0] eq $pkg && $r[1] =~ /^\\(eval /) {"
NSQ_SOURCE_LINE 00000137 "            next;"
NSQ_SOURCE_LINE 00000138 "        }"
NSQ_SOURCE_LINE 00000139 "        $i++;"
NSQ_SOURCE_LINE 00000140 "    }"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "    return unless @r;"
NSQ_SOURCE_LINE 00000143 "    return defined($n0) ? @r : $r[0];"
NSQ_SOURCE_LINE 00000144 "}"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "$SPEC{gen_modified_sub} = {"
NSQ_SOURCE_LINE 00000147 "    v => 1.1,"
NSQ_SOURCE_LINE 00000148 "    summary => 'Generate modified metadata (and subroutine) based on another',"
NSQ_SOURCE_LINE 00000149 "    description => <<'_',"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "Often you'll want to create another sub (and its metadata) based on another, but"
NSQ_SOURCE_LINE 00000152 "with some modifications, e.g. add/remove/rename some arguments, change summary,"
NSQ_SOURCE_LINE 00000153 "add/remove some properties, and so on."
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "Instead of cloning the Rinci metadata and modify it manually yourself, this"
NSQ_SOURCE_LINE 00000156 "routine provides some shortcuts."
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "You can specify base sub/metadata using `base_name` (string, subroutine name,"
NSQ_SOURCE_LINE 00000159 "either qualified or not) or `base_code` (coderef) + `base_meta` (hash)."
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "_"
NSQ_SOURCE_LINE 00000162 "    args => {"
NSQ_SOURCE_LINE 00000163 "        die => {"
NSQ_SOURCE_LINE 00000164 "            summary => 'Die upon failure',"
NSQ_SOURCE_LINE 00000165 "            schema => 'bool*',"
NSQ_SOURCE_LINE 00000166 "        },"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "        base_name => {"
NSQ_SOURCE_LINE 00000169 "            summary => 'Subroutine name (either qualified or not)',"
NSQ_SOURCE_LINE 00000170 "            schema => 'str*',"
NSQ_SOURCE_LINE 00000171 "            description => <<'_',"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "If not qualified with package name, will be searched in the caller's package."
NSQ_SOURCE_LINE 00000174 "Rinci metadata will be searched in `%SPEC` package variable."
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "Alternatively, you can also specify `base_code` and `base_meta`."
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "Either `base_name` or `base_code` + `base_meta` are required."
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "_"
NSQ_SOURCE_LINE 00000181 "        },"
NSQ_SOURCE_LINE 00000182 "        base_code => {"
NSQ_SOURCE_LINE 00000183 "            summary => 'Base subroutine code',"
NSQ_SOURCE_LINE 00000184 "            schema  => 'code*',"
NSQ_SOURCE_LINE 00000185 "            description => <<'_',"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "If you specify this, you'll also need to specify `base_meta`."
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "Alternatively, you can specify `base_name` instead, to let this routine search"
NSQ_SOURCE_LINE 00000190 "the base subroutine from existing Perl package."
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "_"
NSQ_SOURCE_LINE 00000193 "        },"
NSQ_SOURCE_LINE 00000194 "        base_meta => {"
NSQ_SOURCE_LINE 00000195 "            summary => 'Base Rinci metadata',"
NSQ_SOURCE_LINE 00000196 "            schema  => 'hash*', # XXX defhash/rifunc"
NSQ_SOURCE_LINE 00000197 "        },"
NSQ_SOURCE_LINE 00000198 "        output_name => {"
NSQ_SOURCE_LINE 00000199 "            summary => 'Where to install the modified sub',"
NSQ_SOURCE_LINE 00000200 "            schema  => 'str*',"
NSQ_SOURCE_LINE 00000201 "            description => <<'_',"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "Output subroutine will be put in the specified name. If the name is not"
NSQ_SOURCE_LINE 00000204 "qualified with package name, will use caller's package. If the name is not"
NSQ_SOURCE_LINE 00000205 "specified, the base name will be used and must not be from the caller's package."
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "Note that this argument is optional."
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "To prevent installing subroutine, set `install_sub` to false."
NSQ_SOURCE_LINE 00000210 "_"
NSQ_SOURCE_LINE 00000211 "        },"
NSQ_SOURCE_LINE 00000212 "        output_code => {"
NSQ_SOURCE_LINE 00000213 "            summary => 'Code for the modified sub',"
NSQ_SOURCE_LINE 00000214 "            schema  => 'code*',"
NSQ_SOURCE_LINE 00000215 "            description => <<'_',"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "Alternatively you can use `wrap_code`. If both are not specified, will use"
NSQ_SOURCE_LINE 00000218 "`base_code` (which will then be required) as the modified subroutine's code."
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "_"
NSQ_SOURCE_LINE 00000221 "        },"
NSQ_SOURCE_LINE 00000222 "        wrap_code => {"
NSQ_SOURCE_LINE 00000223 "            summary => 'Wrapper to generate the modified sub',"
NSQ_SOURCE_LINE 00000224 "            schema  => 'code*',"
NSQ_SOURCE_LINE 00000225 "            description => <<'_',"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "The modified sub will become:"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "    sub { wrap_code->(base_code, @_) }"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "Alternatively you can use `output_code`. If both are not specified, will use"
NSQ_SOURCE_LINE 00000232 "`base_code` (which will then be required) as the modified subroutine's code."
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "_"
NSQ_SOURCE_LINE 00000235 "        },"
NSQ_SOURCE_LINE 00000236 "        summary => {"
NSQ_SOURCE_LINE 00000237 "            summary => 'Summary for the mod subroutine',"
NSQ_SOURCE_LINE 00000238 "            schema  => 'str*',"
NSQ_SOURCE_LINE 00000239 "        },"
NSQ_SOURCE_LINE 00000240 "        description => {"
NSQ_SOURCE_LINE 00000241 "            summary => 'Description for the mod subroutine',"
NSQ_SOURCE_LINE 00000242 "            schema  => 'str*',"
NSQ_SOURCE_LINE 00000243 "        },"
NSQ_SOURCE_LINE 00000244 "        remove_args => {"
NSQ_SOURCE_LINE 00000245 "            summary => 'List of arguments to remove',"
NSQ_SOURCE_LINE 00000246 "            schema  => 'array*',"
NSQ_SOURCE_LINE 00000247 "        },"
NSQ_SOURCE_LINE 00000248 "        add_args => {"
NSQ_SOURCE_LINE 00000249 "            summary => 'Arguments to add',"
NSQ_SOURCE_LINE 00000250 "            schema  => 'hash*',"
NSQ_SOURCE_LINE 00000251 "        },"
NSQ_SOURCE_LINE 00000252 "        replace_args => {"
NSQ_SOURCE_LINE 00000253 "            summary => 'Arguments to add',"
NSQ_SOURCE_LINE 00000254 "            schema  => 'hash*',"
NSQ_SOURCE_LINE 00000255 "        },"
NSQ_SOURCE_LINE 00000256 "        rename_args => {"
NSQ_SOURCE_LINE 00000257 "            summary => 'Arguments to rename',"
NSQ_SOURCE_LINE 00000258 "            schema  => 'hash*',"
NSQ_SOURCE_LINE 00000259 "        },"
NSQ_SOURCE_LINE 00000260 "        modify_args => {"
NSQ_SOURCE_LINE 00000261 "            summary => 'Arguments to modify',"
NSQ_SOURCE_LINE 00000262 "            description => <<'_',"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "For each argument you can specify a coderef. The coderef will receive the"
NSQ_SOURCE_LINE 00000265 "argument ($arg_spec) and is expected to modify the argument specification."
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "_"
NSQ_SOURCE_LINE 00000268 "            schema  => 'hash*',"
NSQ_SOURCE_LINE 00000269 "        },"
NSQ_SOURCE_LINE 00000270 "        modify_meta => {"
NSQ_SOURCE_LINE 00000271 "            summary => 'Specify code to modify metadata',"
NSQ_SOURCE_LINE 00000272 "            schema  => 'code*',"
NSQ_SOURCE_LINE 00000273 "            description => <<'_',"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "Code will be called with arguments ($meta) where $meta is the cloned Rinci"
NSQ_SOURCE_LINE 00000276 "metadata."
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "_"
NSQ_SOURCE_LINE 00000279 "        },"
NSQ_SOURCE_LINE 00000280 "        install_sub => {"
NSQ_SOURCE_LINE 00000281 "            schema  => 'bool',"
NSQ_SOURCE_LINE 00000282 "            default => 1,"
NSQ_SOURCE_LINE 00000283 "        },"
NSQ_SOURCE_LINE 00000284 "    },"
NSQ_SOURCE_LINE 00000285 "    args_rels => {"
NSQ_SOURCE_LINE 00000286 "        req_one => [qw/base_name base_code/],"
NSQ_SOURCE_LINE 00000287 "        choose_all => [qw/base_code base_meta/],"
NSQ_SOURCE_LINE 00000288 "    },"
NSQ_SOURCE_LINE 00000289 "    result => {"
NSQ_SOURCE_LINE 00000290 "        schema => ['hash*' => {"
NSQ_SOURCE_LINE 00000291 "            keys => {"
NSQ_SOURCE_LINE 00000292 "                code => ['code*'],"
NSQ_SOURCE_LINE 00000293 "                meta => ['hash*'], # XXX defhash/risub"
NSQ_SOURCE_LINE 00000294 "            },"
NSQ_SOURCE_LINE 00000295 "        }],"
NSQ_SOURCE_LINE 00000296 "    },"
NSQ_SOURCE_LINE 00000297 "};"
NSQ_SOURCE_LINE 00000298 "sub gen_modified_sub {"
NSQ_SOURCE_LINE 00000299 "    require Function::Fallback::CoreOrPP;"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "    my %args = @_;"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "    # get base code/meta"
NSQ_SOURCE_LINE 00000304 "    my $caller_pkg = CORE::caller();"
NSQ_SOURCE_LINE 00000305 "    my ($base_code, $base_meta);"
NSQ_SOURCE_LINE 00000306 "    my ($base_pkg, $base_leaf);"
NSQ_SOURCE_LINE 00000307 "    if ($args{base_name}) {"
NSQ_SOURCE_LINE 00000308 "        if ($args{base_name} =~ /(.+)::(.+)/) {"
NSQ_SOURCE_LINE 00000309 "            ($base_pkg, $base_leaf) = ($1, $2);"
NSQ_SOURCE_LINE 00000310 "        } else {"
NSQ_SOURCE_LINE 00000311 "            $base_pkg  = $caller_pkg;"
NSQ_SOURCE_LINE 00000312 "            $base_leaf = $args{base_name};"
NSQ_SOURCE_LINE 00000313 "        }"
NSQ_SOURCE_LINE 00000314 "        {"
NSQ_SOURCE_LINE 00000315 "            no strict 'refs'; ## no critic: TestingAndDebugging::ProhibitNoStrict"
NSQ_SOURCE_LINE 00000316 "            $base_code = \\&{\"$base_pkg\\::$base_leaf\"};"
NSQ_SOURCE_LINE 00000317 "            $base_meta = ${\"$base_pkg\\::SPEC\"}{$base_leaf};"
NSQ_SOURCE_LINE 00000318 "        }"
NSQ_SOURCE_LINE 00000319 "        die \"Can't find Rinci metadata for $base_pkg\\::$base_leaf\" unless $base_meta;"
NSQ_SOURCE_LINE 00000320 "    } elsif ($args{base_meta}) {"
NSQ_SOURCE_LINE 00000321 "        $base_meta = $args{base_meta};"
NSQ_SOURCE_LINE 00000322 "        $base_code = $args{base_code}"
NSQ_SOURCE_LINE 00000323 "            or die \"Please specify base_code\";"
NSQ_SOURCE_LINE 00000324 "    } else {"
NSQ_SOURCE_LINE 00000325 "        die \"Please specify base_name or base_code+base_meta\";"
NSQ_SOURCE_LINE 00000326 "    }"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "    my $output_meta = Function::Fallback::CoreOrPP::clone($base_meta);"
NSQ_SOURCE_LINE 00000329 "    my $output_code = ($args{wrap_code} ? sub { $args{wrap_code}->($base_code, @_) } : undef) //"
NSQ_SOURCE_LINE 00000330 "        $args{output_code} // $base_code;"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "    # modify metadata"
NSQ_SOURCE_LINE 00000333 "    for (qw/summary description/) {"
NSQ_SOURCE_LINE 00000334 "        $output_meta->{$_} = $args{$_} if $args{$_};"
NSQ_SOURCE_LINE 00000335 "    }"
NSQ_SOURCE_LINE 00000336 "    if ($args{remove_args}) {"
NSQ_SOURCE_LINE 00000337 "        delete $output_meta->{args}{$_} for @{ $args{remove_args} };"
NSQ_SOURCE_LINE 00000338 "    }"
NSQ_SOURCE_LINE 00000339 "    if ($args{add_args}) {"
NSQ_SOURCE_LINE 00000340 "        for my $k (keys %{ $args{add_args} }) {"
NSQ_SOURCE_LINE 00000341 "            my $v = $args{add_args}{$k};"
NSQ_SOURCE_LINE 00000342 "            die \"Can't add arg '$k' in mod sub: already exists\""
NSQ_SOURCE_LINE 00000343 "                if $output_meta->{args}{$k};"
NSQ_SOURCE_LINE 00000344 "            $output_meta->{args}{$k} = $v;"
NSQ_SOURCE_LINE 00000345 "        }"
NSQ_SOURCE_LINE 00000346 "    }"
NSQ_SOURCE_LINE 00000347 "    if ($args{replace_args}) {"
NSQ_SOURCE_LINE 00000348 "        for my $k (keys %{ $args{replace_args} }) {"
NSQ_SOURCE_LINE 00000349 "            my $v = $args{replace_args}{$k};"
NSQ_SOURCE_LINE 00000350 "            die \"Can't replace arg '$k' in mod sub: doesn't exist\""
NSQ_SOURCE_LINE 00000351 "                unless $output_meta->{args}{$k};"
NSQ_SOURCE_LINE 00000352 "            $output_meta->{args}{$k} = $v;"
NSQ_SOURCE_LINE 00000353 "        }"
NSQ_SOURCE_LINE 00000354 "    }"
NSQ_SOURCE_LINE 00000355 "    if ($args{rename_args}) {"
NSQ_SOURCE_LINE 00000356 "        for my $old (keys %{ $args{rename_args} }) {"
NSQ_SOURCE_LINE 00000357 "            my $new = $args{rename_args}{$old};"
NSQ_SOURCE_LINE 00000358 "            my $as = $output_meta->{args}{$old};"
NSQ_SOURCE_LINE 00000359 "            die \"Can't rename arg '$old' in mod sub: doesn't exist\" unless $as;"
NSQ_SOURCE_LINE 00000360 "            die \"Can't rename arg '$old'->'$new' in mod sub: \"."
NSQ_SOURCE_LINE 00000361 "                \"new name already exist\" if $output_meta->{args}{$new};"
NSQ_SOURCE_LINE 00000362 "            $output_meta->{args}{$new} = $as;"
NSQ_SOURCE_LINE 00000363 "            delete $output_meta->{args}{$old};"
NSQ_SOURCE_LINE 00000364 "        }"
NSQ_SOURCE_LINE 00000365 "    }"
NSQ_SOURCE_LINE 00000366 "    if ($args{modify_args}) {"
NSQ_SOURCE_LINE 00000367 "        for (keys %{ $args{modify_args} }) {"
NSQ_SOURCE_LINE 00000368 "            $args{modify_args}{$_}->($output_meta->{args}{$_});"
NSQ_SOURCE_LINE 00000369 "        }"
NSQ_SOURCE_LINE 00000370 "    }"
NSQ_SOURCE_LINE 00000371 "    if ($args{modify_meta}) {"
NSQ_SOURCE_LINE 00000372 "        $args{modify_meta}->($output_meta);"
NSQ_SOURCE_LINE 00000373 "    }"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "    # install"
NSQ_SOURCE_LINE 00000376 "    my ($output_pkg, $output_leaf);"
NSQ_SOURCE_LINE 00000377 "    if (!defined $args{output_name}) {"
NSQ_SOURCE_LINE 00000378 "        $output_pkg  = $caller_pkg;"
NSQ_SOURCE_LINE 00000379 "        $output_leaf = $base_leaf;"
NSQ_SOURCE_LINE 00000380 "        if ($base_pkg eq $output_pkg) {"
NSQ_SOURCE_LINE 00000381 "            if ($args{die}) {"
NSQ_SOURCE_LINE 00000382 "                die \"Won't override $base_pkg\\::$base_leaf\";"
NSQ_SOURCE_LINE 00000383 "            } else {"
NSQ_SOURCE_LINE 00000384 "                return [412, \"Won't override $base_pkg\\::$base_leaf\"];"
NSQ_SOURCE_LINE 00000385 "            }"
NSQ_SOURCE_LINE 00000386 "        }"
NSQ_SOURCE_LINE 00000387 "    } elsif ($args{output_name} =~ /(.+)::(.+)/) {"
NSQ_SOURCE_LINE 00000388 "        ($output_pkg, $output_leaf) = ($1, $2);"
NSQ_SOURCE_LINE 00000389 "    } else {"
NSQ_SOURCE_LINE 00000390 "        $output_pkg  = $caller_pkg;"
NSQ_SOURCE_LINE 00000391 "        $output_leaf = $args{output_name};"
NSQ_SOURCE_LINE 00000392 "    }"
NSQ_SOURCE_LINE 00000393 "    {"
NSQ_SOURCE_LINE 00000394 "        no strict 'refs'; ## no critic: TestingAndDebugging::ProhibitNoStrict"
NSQ_SOURCE_LINE 00000395 "        no warnings 'redefine', 'once';"
NSQ_SOURCE_LINE 00000396 "        log_trace \"Installing modified sub to $output_pkg\\::$output_leaf ...\";"
NSQ_SOURCE_LINE 00000397 "        *{\"$output_pkg\\::$output_leaf\"} = $output_code if $args{install_sub} // 1;"
NSQ_SOURCE_LINE 00000398 "        ${\"$output_pkg\\::SPEC\"}{$output_leaf} = $output_meta;"
NSQ_SOURCE_LINE 00000399 "    }"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "    [200, \"OK\", {code=>$output_code, meta=>$output_meta}];"
NSQ_SOURCE_LINE 00000402 "}"
NSQ_SOURCE_LINE 00000403 ""
NSQ_SOURCE_LINE 00000404 "$SPEC{gen_curried_sub} = {"
NSQ_SOURCE_LINE 00000405 "    v => 1.1,"
NSQ_SOURCE_LINE 00000406 "    summary => 'Generate curried subroutine (and its metadata)',"
NSQ_SOURCE_LINE 00000407 "    description => <<'_',"
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "This is a more convenient helper than `gen_modified_sub` if you want to create a"
NSQ_SOURCE_LINE 00000410 "new subroutine that has some of its arguments preset (so they no longer need to"
NSQ_SOURCE_LINE 00000411 "be present in the new metadata)."
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "For more general needs of modifying a subroutine (e.g. add some arguments,"
NSQ_SOURCE_LINE 00000414 "modify some arguments, etc) use `gen_modified_sub`."
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "_"
NSQ_SOURCE_LINE 00000417 "    args => {"
NSQ_SOURCE_LINE 00000418 "        base_name => {"
NSQ_SOURCE_LINE 00000419 "            summary => 'Subroutine name (either qualified or not)',"
NSQ_SOURCE_LINE 00000420 "            schema => 'str*',"
NSQ_SOURCE_LINE 00000421 "            description => <<'_',"
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "If not qualified with package name, will be searched in the caller's package."
NSQ_SOURCE_LINE 00000424 "Rinci metadata will be searched in `%SPEC` package variable."
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 "_"
NSQ_SOURCE_LINE 00000427 "            req => 1,"
NSQ_SOURCE_LINE 00000428 "            pos => 0,"
NSQ_SOURCE_LINE 00000429 "        },"
NSQ_SOURCE_LINE 00000430 "        set_args => {"
NSQ_SOURCE_LINE 00000431 "            summary => 'Arguments to set',"
NSQ_SOURCE_LINE 00000432 "            schema  => 'hash*',"
NSQ_SOURCE_LINE 00000433 "            req => 1,"
NSQ_SOURCE_LINE 00000434 "            pos => 1,"
NSQ_SOURCE_LINE 00000435 "        },"
NSQ_SOURCE_LINE 00000436 "        output_name => {"
NSQ_SOURCE_LINE 00000437 "            summary => 'Where to install the modified sub',"
NSQ_SOURCE_LINE 00000438 "            schema  => 'str*',"
NSQ_SOURCE_LINE 00000439 "            description => <<'_',"
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "Subroutine will be put in the specified name. If the name is not qualified with"
NSQ_SOURCE_LINE 00000442 "package name, will use caller's package. If the name is not specified, will use"
NSQ_SOURCE_LINE 00000443 "the base name which must not be in the caller's package."
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "_"
NSQ_SOURCE_LINE 00000446 "            pos => 2,"
NSQ_SOURCE_LINE 00000447 "        },"
NSQ_SOURCE_LINE 00000448 "    },"
NSQ_SOURCE_LINE 00000449 "    args_as => 'array',"
NSQ_SOURCE_LINE 00000450 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000451 "};"
NSQ_SOURCE_LINE 00000452 "sub gen_curried_sub {"
NSQ_SOURCE_LINE 00000453 "    my ($base_name, $set_args, $output_name) = @_;"
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 "    my $caller = CORE::caller();"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "    my ($base_pkg, $base_leaf);"
NSQ_SOURCE_LINE 00000458 "    if ($base_name =~ /(.+)::(.+)/) {"
NSQ_SOURCE_LINE 00000459 "        ($base_pkg, $base_leaf) = ($1, $2);"
NSQ_SOURCE_LINE 00000460 "    } else {"
NSQ_SOURCE_LINE 00000461 "        $base_pkg  = $caller;"
NSQ_SOURCE_LINE 00000462 "        $base_leaf = $base_name;"
NSQ_SOURCE_LINE 00000463 "    }"
NSQ_SOURCE_LINE 00000464 ""
NSQ_SOURCE_LINE 00000465 "    my ($output_pkg, $output_leaf);"
NSQ_SOURCE_LINE 00000466 "    if (!defined $output_name) {"
NSQ_SOURCE_LINE 00000467 "        die \"Won't override $base_pkg\\::$base_leaf\" if $base_pkg eq $caller;"
NSQ_SOURCE_LINE 00000468 "        $output_pkg = $caller;"
NSQ_SOURCE_LINE 00000469 "        $output_leaf = $base_leaf;"
NSQ_SOURCE_LINE 00000470 "    } elsif ($output_name =~ /(.+)::(.+)/) {"
NSQ_SOURCE_LINE 00000471 "        ($output_pkg, $output_leaf) = ($1, $2);"
NSQ_SOURCE_LINE 00000472 "    } else {"
NSQ_SOURCE_LINE 00000473 "        $output_pkg  = $caller;"
NSQ_SOURCE_LINE 00000474 "        $output_leaf = $output_name;"
NSQ_SOURCE_LINE 00000475 "    }"
NSQ_SOURCE_LINE 00000476 ""
NSQ_SOURCE_LINE 00000477 "    my $base_sub = \\&{\"$base_pkg\\::$base_leaf\"};"
NSQ_SOURCE_LINE 00000478 ""
NSQ_SOURCE_LINE 00000479 "    gen_modified_sub("
NSQ_SOURCE_LINE 00000480 "        die         => 1,"
NSQ_SOURCE_LINE 00000481 "        base_name   => \"$base_pkg\\::$base_leaf\","
NSQ_SOURCE_LINE 00000482 "        output_name => \"$output_pkg\\::$output_leaf\","
NSQ_SOURCE_LINE 00000483 "        output_code => sub {"
NSQ_SOURCE_LINE 00000484 "            no strict 'refs'; ## no critic: TestingAndDebugging::ProhibitNoStrict"
NSQ_SOURCE_LINE 00000485 "            $base_sub->(@_, %$set_args);"
NSQ_SOURCE_LINE 00000486 "        },"
NSQ_SOURCE_LINE 00000487 "        remove_args => [keys %$set_args],"
NSQ_SOURCE_LINE 00000488 "        install => 1,"
NSQ_SOURCE_LINE 00000489 "    );"
NSQ_SOURCE_LINE 00000490 "}"
NSQ_SOURCE_LINE 00000491 ""
NSQ_SOURCE_LINE 00000492 "1;"
NSQ_SOURCE_LINE 00000493 "# ABSTRACT: Helper when writing functions"
NSQ_SOURCE_LINE 00000494 ""
NSQ_SOURCE_LINE 00000495 "__END__"
NSQ_SOURCE_LINE 00000496 ""
NSQ_SOURCE_LINE 00000497 "=pod"
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000500 ""
NSQ_SOURCE_LINE 00000501 "=head1 NAME"
NSQ_SOURCE_LINE 00000502 ""
NSQ_SOURCE_LINE 00000503 "Perinci::Sub::Util - Helper when writing functions"
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "=head1 VERSION"
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "This document describes version 0.472 of Perinci::Sub::Util (from Perl distribution Perinci-Sub-Util), released on 2023-10-28."
NSQ_SOURCE_LINE 00000508 ""
NSQ_SOURCE_LINE 00000509 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000510 ""
NSQ_SOURCE_LINE 00000511 "Example for err() and caller():"
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 " use Perinci::Sub::Util qw(err caller);"
NSQ_SOURCE_LINE 00000514 ""
NSQ_SOURCE_LINE 00000515 " sub foo {"
NSQ_SOURCE_LINE 00000516 "     my %args = @_;"
NSQ_SOURCE_LINE 00000517 "     my $res;"
NSQ_SOURCE_LINE 00000518 ""
NSQ_SOURCE_LINE 00000519 "     my $caller = caller();"
NSQ_SOURCE_LINE 00000520 ""
NSQ_SOURCE_LINE 00000521 "     $res = bar(...);"
NSQ_SOURCE_LINE 00000522 "     return err($err, 500, \"Can't foo\") if $res->[0] != 200;"
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 "     [200, \"OK\"];"
NSQ_SOURCE_LINE 00000525 " }"
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 "Example for die_err() and warn_err():"
NSQ_SOURCE_LINE 00000528 ""
NSQ_SOURCE_LINE 00000529 " use Perinci::Sub::Util qw(warn_err die_err);"
NSQ_SOURCE_LINE 00000530 " warn_err(403, \"Forbidden\");"
NSQ_SOURCE_LINE 00000531 " die_err(403, \"Forbidden\");"
NSQ_SOURCE_LINE 00000532 ""
NSQ_SOURCE_LINE 00000533 "Example for gen_modified_sub():"
NSQ_SOURCE_LINE 00000534 ""
NSQ_SOURCE_LINE 00000535 " use Perinci::Sub::Util qw(gen_modified_sub);"
NSQ_SOURCE_LINE 00000536 ""
NSQ_SOURCE_LINE 00000537 " $SPEC{list_users} = {"
NSQ_SOURCE_LINE 00000538 "     v => 1.1,"
NSQ_SOURCE_LINE 00000539 "     args => {"
NSQ_SOURCE_LINE 00000540 "         search => {},"
NSQ_SOURCE_LINE 00000541 "         is_suspended => {},"
NSQ_SOURCE_LINE 00000542 "     },"
NSQ_SOURCE_LINE 00000543 " };"
NSQ_SOURCE_LINE 00000544 " sub list_users { ... }"
NSQ_SOURCE_LINE 00000545 ""
NSQ_SOURCE_LINE 00000546 " gen_modified_sub("
NSQ_SOURCE_LINE 00000547 "     output_name => 'list_suspended_users',"
NSQ_SOURCE_LINE 00000548 "     base_name   => 'list_users',"
NSQ_SOURCE_LINE 00000549 "     remove_args => ['is_suspended'],"
NSQ_SOURCE_LINE 00000550 "     output_code => sub {"
NSQ_SOURCE_LINE 00000551 "         list_users(@_, is_suspended=>1);"
NSQ_SOURCE_LINE 00000552 "     },"
NSQ_SOURCE_LINE 00000553 " );"
NSQ_SOURCE_LINE 00000554 ""
NSQ_SOURCE_LINE 00000555 "Example for gen_curried_sub():"
NSQ_SOURCE_LINE 00000556 ""
NSQ_SOURCE_LINE 00000557 " use Perinci::Sub::Util qw(gen_curried_sub);"
NSQ_SOURCE_LINE 00000558 ""
NSQ_SOURCE_LINE 00000559 " $SPEC{list_users} = {"
NSQ_SOURCE_LINE 00000560 "     v => 1.1,"
NSQ_SOURCE_LINE 00000561 "     args => {"
NSQ_SOURCE_LINE 00000562 "         search => {},"
NSQ_SOURCE_LINE 00000563 "         is_suspended => {},"
NSQ_SOURCE_LINE 00000564 "     },"
NSQ_SOURCE_LINE 00000565 " };"
NSQ_SOURCE_LINE 00000566 " sub list_users { ... }"
NSQ_SOURCE_LINE 00000567 ""
NSQ_SOURCE_LINE 00000568 " # simpler/shorter than gen_modified_sub, but can be used for currying only"
NSQ_SOURCE_LINE 00000569 " gen_curried_sub('list_users', {is_suspended=>1}, 'list_suspended_users');"
NSQ_SOURCE_LINE 00000570 ""
NSQ_SOURCE_LINE 00000571 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000572 ""
NSQ_SOURCE_LINE 00000573 ""
NSQ_SOURCE_LINE 00000574 "=head2 gen_curried_sub"
NSQ_SOURCE_LINE 00000575 ""
NSQ_SOURCE_LINE 00000576 "Usage:"
NSQ_SOURCE_LINE 00000577 ""
NSQ_SOURCE_LINE 00000578 " gen_curried_sub($base_name, $set_args, $output_name) -> any"
NSQ_SOURCE_LINE 00000579 ""
NSQ_SOURCE_LINE 00000580 "Generate curried subroutine (and its metadata)."
NSQ_SOURCE_LINE 00000581 ""
NSQ_SOURCE_LINE 00000582 "This is a more convenient helper than C<gen_modified_sub> if you want to create a"
NSQ_SOURCE_LINE 00000583 "new subroutine that has some of its arguments preset (so they no longer need to"
NSQ_SOURCE_LINE 00000584 "be present in the new metadata)."
NSQ_SOURCE_LINE 00000585 ""
NSQ_SOURCE_LINE 00000586 "For more general needs of modifying a subroutine (e.g. add some arguments,"
NSQ_SOURCE_LINE 00000587 "modify some arguments, etc) use C<gen_modified_sub>."
NSQ_SOURCE_LINE 00000588 ""
NSQ_SOURCE_LINE 00000589 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000590 ""
NSQ_SOURCE_LINE 00000591 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000592 ""
NSQ_SOURCE_LINE 00000593 "=over 4"
NSQ_SOURCE_LINE 00000594 ""
NSQ_SOURCE_LINE 00000595 "=item * B<$base_name>* => I<str>"
NSQ_SOURCE_LINE 00000596 ""
NSQ_SOURCE_LINE 00000597 "Subroutine name (either qualified or not)."
NSQ_SOURCE_LINE 00000598 ""
NSQ_SOURCE_LINE 00000599 "If not qualified with package name, will be searched in the caller's package."
NSQ_SOURCE_LINE 00000600 "Rinci metadata will be searched in C<%SPEC> package variable."
NSQ_SOURCE_LINE 00000601 ""
NSQ_SOURCE_LINE 00000602 "=item * B<$output_name> => I<str>"
NSQ_SOURCE_LINE 00000603 ""
NSQ_SOURCE_LINE 00000604 "Where to install the modified sub."
NSQ_SOURCE_LINE 00000605 ""
NSQ_SOURCE_LINE 00000606 "Subroutine will be put in the specified name. If the name is not qualified with"
NSQ_SOURCE_LINE 00000607 "package name, will use caller's package. If the name is not specified, will use"
NSQ_SOURCE_LINE 00000608 "the base name which must not be in the caller's package."
NSQ_SOURCE_LINE 00000609 ""
NSQ_SOURCE_LINE 00000610 "=item * B<$set_args>* => I<hash>"
NSQ_SOURCE_LINE 00000611 ""
NSQ_SOURCE_LINE 00000612 "Arguments to set."
NSQ_SOURCE_LINE 00000613 ""
NSQ_SOURCE_LINE 00000614 ""
NSQ_SOURCE_LINE 00000615 "=back"
NSQ_SOURCE_LINE 00000616 ""
NSQ_SOURCE_LINE 00000617 "Return value:  (any)"
NSQ_SOURCE_LINE 00000618 ""
NSQ_SOURCE_LINE 00000619 ""
NSQ_SOURCE_LINE 00000620 ""
NSQ_SOURCE_LINE 00000621 "=head2 gen_modified_sub"
NSQ_SOURCE_LINE 00000622 ""
NSQ_SOURCE_LINE 00000623 "Usage:"
NSQ_SOURCE_LINE 00000624 ""
NSQ_SOURCE_LINE 00000625 " gen_modified_sub(%args) -> [$status_code, $reason, $payload, \\%result_meta]"
NSQ_SOURCE_LINE 00000626 ""
NSQ_SOURCE_LINE 00000627 "Generate modified metadata (and subroutine) based on another."
NSQ_SOURCE_LINE 00000628 ""
NSQ_SOURCE_LINE 00000629 "Often you'll want to create another sub (and its metadata) based on another, but"
NSQ_SOURCE_LINE 00000630 "with some modifications, e.g. add/remove/rename some arguments, change summary,"
NSQ_SOURCE_LINE 00000631 "add/remove some properties, and so on."
NSQ_SOURCE_LINE 00000632 ""
NSQ_SOURCE_LINE 00000633 "Instead of cloning the Rinci metadata and modify it manually yourself, this"
NSQ_SOURCE_LINE 00000634 "routine provides some shortcuts."
NSQ_SOURCE_LINE 00000635 ""
NSQ_SOURCE_LINE 00000636 "You can specify base sub/metadata using C<base_name> (string, subroutine name,"
NSQ_SOURCE_LINE 00000637 "either qualified or not) or C<base_code> (coderef) + C<base_meta> (hash)."
NSQ_SOURCE_LINE 00000638 ""
NSQ_SOURCE_LINE 00000639 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000640 ""
NSQ_SOURCE_LINE 00000641 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000642 ""
NSQ_SOURCE_LINE 00000643 "=over 4"
NSQ_SOURCE_LINE 00000644 ""
NSQ_SOURCE_LINE 00000645 "=item * B<add_args> => I<hash>"
NSQ_SOURCE_LINE 00000646 ""
NSQ_SOURCE_LINE 00000647 "Arguments to add."
NSQ_SOURCE_LINE 00000648 ""
NSQ_SOURCE_LINE 00000649 "=item * B<base_code> => I<code>"
NSQ_SOURCE_LINE 00000650 ""
NSQ_SOURCE_LINE 00000651 "Base subroutine code."
NSQ_SOURCE_LINE 00000652 ""
NSQ_SOURCE_LINE 00000653 "If you specify this, you'll also need to specify C<base_meta>."
NSQ_SOURCE_LINE 00000654 ""
NSQ_SOURCE_LINE 00000655 "Alternatively, you can specify C<base_name> instead, to let this routine search"
NSQ_SOURCE_LINE 00000656 "the base subroutine from existing Perl package."
NSQ_SOURCE_LINE 00000657 ""
NSQ_SOURCE_LINE 00000658 "=item * B<base_meta> => I<hash>"
NSQ_SOURCE_LINE 00000659 ""
NSQ_SOURCE_LINE 00000660 "Base Rinci metadata."
NSQ_SOURCE_LINE 00000661 ""
NSQ_SOURCE_LINE 00000662 "=item * B<base_name> => I<str>"
NSQ_SOURCE_LINE 00000663 ""
NSQ_SOURCE_LINE 00000664 "Subroutine name (either qualified or not)."
NSQ_SOURCE_LINE 00000665 ""
NSQ_SOURCE_LINE 00000666 "If not qualified with package name, will be searched in the caller's package."
NSQ_SOURCE_LINE 00000667 "Rinci metadata will be searched in C<%SPEC> package variable."
NSQ_SOURCE_LINE 00000668 ""
NSQ_SOURCE_LINE 00000669 "Alternatively, you can also specify C<base_code> and C<base_meta>."
NSQ_SOURCE_LINE 00000670 ""
NSQ_SOURCE_LINE 00000671 "Either C<base_name> or C<base_code> + C<base_meta> are required."
NSQ_SOURCE_LINE 00000672 ""
NSQ_SOURCE_LINE 00000673 "=item * B<description> => I<str>"
NSQ_SOURCE_LINE 00000674 ""
NSQ_SOURCE_LINE 00000675 "Description for the mod subroutine."
NSQ_SOURCE_LINE 00000676 ""
NSQ_SOURCE_LINE 00000677 "=item * B<die> => I<bool>"
NSQ_SOURCE_LINE 00000678 ""
NSQ_SOURCE_LINE 00000679 "Die upon failure."
NSQ_SOURCE_LINE 00000680 ""
NSQ_SOURCE_LINE 00000681 "=item * B<install_sub> => I<bool> (default: 1)"
NSQ_SOURCE_LINE 00000682 ""
NSQ_SOURCE_LINE 00000683 "(No description)"
NSQ_SOURCE_LINE 00000684 ""
NSQ_SOURCE_LINE 00000685 "=item * B<modify_args> => I<hash>"
NSQ_SOURCE_LINE 00000686 ""
NSQ_SOURCE_LINE 00000687 "Arguments to modify."
NSQ_SOURCE_LINE 00000688 ""
NSQ_SOURCE_LINE 00000689 "For each argument you can specify a coderef. The coderef will receive the"
NSQ_SOURCE_LINE 00000690 "argument ($arg_spec) and is expected to modify the argument specification."
NSQ_SOURCE_LINE 00000691 ""
NSQ_SOURCE_LINE 00000692 "=item * B<modify_meta> => I<code>"
NSQ_SOURCE_LINE 00000693 ""
NSQ_SOURCE_LINE 00000694 "Specify code to modify metadata."
NSQ_SOURCE_LINE 00000695 ""
NSQ_SOURCE_LINE 00000696 "Code will be called with arguments ($meta) where $meta is the cloned Rinci"
NSQ_SOURCE_LINE 00000697 "metadata."
NSQ_SOURCE_LINE 00000698 ""
NSQ_SOURCE_LINE 00000699 "=item * B<output_code> => I<code>"
NSQ_SOURCE_LINE 00000700 ""
NSQ_SOURCE_LINE 00000701 "Code for the modified sub."
NSQ_SOURCE_LINE 00000702 ""
NSQ_SOURCE_LINE 00000703 "Alternatively you can use C<wrap_code>. If both are not specified, will use"
NSQ_SOURCE_LINE 00000704 "C<base_code> (which will then be required) as the modified subroutine's code."
NSQ_SOURCE_LINE 00000705 ""
NSQ_SOURCE_LINE 00000706 "=item * B<output_name> => I<str>"
NSQ_SOURCE_LINE 00000707 ""
NSQ_SOURCE_LINE 00000708 "Where to install the modified sub."
NSQ_SOURCE_LINE 00000709 ""
NSQ_SOURCE_LINE 00000710 "Output subroutine will be put in the specified name. If the name is not"
NSQ_SOURCE_LINE 00000711 "qualified with package name, will use caller's package. If the name is not"
NSQ_SOURCE_LINE 00000712 "specified, the base name will be used and must not be from the caller's package."
NSQ_SOURCE_LINE 00000713 ""
NSQ_SOURCE_LINE 00000714 "Note that this argument is optional."
NSQ_SOURCE_LINE 00000715 ""
NSQ_SOURCE_LINE 00000716 "To prevent installing subroutine, set C<install_sub> to false."
NSQ_SOURCE_LINE 00000717 ""
NSQ_SOURCE_LINE 00000718 "=item * B<remove_args> => I<array>"
NSQ_SOURCE_LINE 00000719 ""
NSQ_SOURCE_LINE 00000720 "List of arguments to remove."
NSQ_SOURCE_LINE 00000721 ""
NSQ_SOURCE_LINE 00000722 "=item * B<rename_args> => I<hash>"
NSQ_SOURCE_LINE 00000723 ""
NSQ_SOURCE_LINE 00000724 "Arguments to rename."
NSQ_SOURCE_LINE 00000725 ""
NSQ_SOURCE_LINE 00000726 "=item * B<replace_args> => I<hash>"
NSQ_SOURCE_LINE 00000727 ""
NSQ_SOURCE_LINE 00000728 "Arguments to add."
NSQ_SOURCE_LINE 00000729 ""
NSQ_SOURCE_LINE 00000730 "=item * B<summary> => I<str>"
NSQ_SOURCE_LINE 00000731 ""
NSQ_SOURCE_LINE 00000732 "Summary for the mod subroutine."
NSQ_SOURCE_LINE 00000733 ""
NSQ_SOURCE_LINE 00000734 "=item * B<wrap_code> => I<code>"
NSQ_SOURCE_LINE 00000735 ""
NSQ_SOURCE_LINE 00000736 "Wrapper to generate the modified sub."
NSQ_SOURCE_LINE 00000737 ""
NSQ_SOURCE_LINE 00000738 "The modified sub will become:"
NSQ_SOURCE_LINE 00000739 ""
NSQ_SOURCE_LINE 00000740 " sub { wrap_code->(base_code, @_) }"
NSQ_SOURCE_LINE 00000741 ""
NSQ_SOURCE_LINE 00000742 "Alternatively you can use C<output_code>. If both are not specified, will use"
NSQ_SOURCE_LINE 00000743 "C<base_code> (which will then be required) as the modified subroutine's code."
NSQ_SOURCE_LINE 00000744 ""
NSQ_SOURCE_LINE 00000745 ""
NSQ_SOURCE_LINE 00000746 "=back"
NSQ_SOURCE_LINE 00000747 ""
NSQ_SOURCE_LINE 00000748 "Returns an enveloped result (an array)."
NSQ_SOURCE_LINE 00000749 ""
NSQ_SOURCE_LINE 00000750 "First element ($status_code) is an integer containing HTTP-like status code"
NSQ_SOURCE_LINE 00000751 "(200 means OK, 4xx caller error, 5xx function error). Second element"
NSQ_SOURCE_LINE 00000752 "($reason) is a string containing error message, or something like \"OK\" if status is"
NSQ_SOURCE_LINE 00000753 "200. Third element ($payload) is the actual result, but usually not present when enveloped result is an error response ($status_code is not 2xx). Fourth"
NSQ_SOURCE_LINE 00000754 "element (%result_meta) is called result metadata and is optional, a hash"
NSQ_SOURCE_LINE 00000755 "that contains extra information, much like how HTTP response headers provide additional metadata."
NSQ_SOURCE_LINE 00000756 ""
NSQ_SOURCE_LINE 00000757 "Return value:  (hash)"
NSQ_SOURCE_LINE 00000758 ""
NSQ_SOURCE_LINE 00000759 ""
NSQ_SOURCE_LINE 00000760 "=head2 caller([ $n ])"
NSQ_SOURCE_LINE 00000761 ""
NSQ_SOURCE_LINE 00000762 "Just like Perl's builtin caller(), except that this one will ignore wrapper code"
NSQ_SOURCE_LINE 00000763 "in the call stack. You should use this if your code is potentially wrapped. See"
NSQ_SOURCE_LINE 00000764 "L<Perinci::Sub::Wrapper> for more details."
NSQ_SOURCE_LINE 00000765 ""
NSQ_SOURCE_LINE 00000766 "=head2 err(...) => ARRAY"
NSQ_SOURCE_LINE 00000767 ""
NSQ_SOURCE_LINE 00000768 "Experimental."
NSQ_SOURCE_LINE 00000769 ""
NSQ_SOURCE_LINE 00000770 "Generate an enveloped error response (see L<Rinci::function>). Can accept"
NSQ_SOURCE_LINE 00000771 "arguments in an unordered fashion, by utilizing the fact that status codes are"
NSQ_SOURCE_LINE 00000772 "always integers, messages are strings, result metadata are hashes, and previous"
NSQ_SOURCE_LINE 00000773 "error responses are arrays. Error responses also seldom contain actual result."
NSQ_SOURCE_LINE 00000774 "Status code defaults to 500, status message will default to \"FUNC failed\". This"
NSQ_SOURCE_LINE 00000775 "function will also fill the information in the C<logs> result metadata."
NSQ_SOURCE_LINE 00000776 ""
NSQ_SOURCE_LINE 00000777 "Examples:"
NSQ_SOURCE_LINE 00000778 ""
NSQ_SOURCE_LINE 00000779 " err();    # => [500, \"FUNC failed\", undef, {...}];"
NSQ_SOURCE_LINE 00000780 " err(404); # => [404, \"FUNC failed\", undef, {...}];"
NSQ_SOURCE_LINE 00000781 " err(404, \"Not found\"); # => [404, \"Not found\", ...]"
NSQ_SOURCE_LINE 00000782 " err(\"Not found\", 404); # => [404, \"Not found\", ...]; # order doesn't matter"
NSQ_SOURCE_LINE 00000783 " err([404, \"Prev error\"]); # => [500, \"FUNC failed\", undef,"
NSQ_SOURCE_LINE 00000784 "                           #     {logs=>[...], prev=>[404, \"Prev error\"]}]"
NSQ_SOURCE_LINE 00000785 ""
NSQ_SOURCE_LINE 00000786 "Will put C<stack_trace> in logs only if C<Carp::Always> module is loaded."
NSQ_SOURCE_LINE 00000787 ""
NSQ_SOURCE_LINE 00000788 "=head2 warn_err(...)"
NSQ_SOURCE_LINE 00000789 ""
NSQ_SOURCE_LINE 00000790 "This is a shortcut for:"
NSQ_SOURCE_LINE 00000791 ""
NSQ_SOURCE_LINE 00000792 " $res = err(...);"
NSQ_SOURCE_LINE 00000793 " warn \"ERROR $res->[0]: $res->[1]\";"
NSQ_SOURCE_LINE 00000794 ""
NSQ_SOURCE_LINE 00000795 "=head2 die_err(...)"
NSQ_SOURCE_LINE 00000796 ""
NSQ_SOURCE_LINE 00000797 "This is a shortcut for:"
NSQ_SOURCE_LINE 00000798 ""
NSQ_SOURCE_LINE 00000799 " $res = err(...);"
NSQ_SOURCE_LINE 00000800 " die \"ERROR $res->[0]: $res->[1]\";"
NSQ_SOURCE_LINE 00000801 ""
NSQ_SOURCE_LINE 00000802 "=head1 FAQ"
NSQ_SOURCE_LINE 00000803 ""
NSQ_SOURCE_LINE 00000804 "=head2 What if I want to put result ($res->[2]) into my result with err()?"
NSQ_SOURCE_LINE 00000805 ""
NSQ_SOURCE_LINE 00000806 "You can do something like this:"
NSQ_SOURCE_LINE 00000807 ""
NSQ_SOURCE_LINE 00000808 " my $err = err(...) if ERROR_CONDITION;"
NSQ_SOURCE_LINE 00000809 " $err->[2] = SOME_RESULT;"
NSQ_SOURCE_LINE 00000810 " return $err;"
NSQ_SOURCE_LINE 00000811 ""
