BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package LWP::UserAgent::Plugin;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000004 "our $DATE = '2020-08-13'; # DATE"
NSQ_SOURCE_LINE 00000005 "our $DIST = 'LWP-UserAgent-Plugin'; # DIST"
NSQ_SOURCE_LINE 00000006 "our $VERSION = '0.004'; # VERSION"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use 5.010001;"
NSQ_SOURCE_LINE 00000009 "use strict 'subs', 'vars';"
NSQ_SOURCE_LINE 00000010 "use warnings;"
NSQ_SOURCE_LINE 00000011 "use Log::ger;"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "use parent 'LWP::UserAgent';"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "if ($ENV{LWP_USERAGENT_PLUGINS}) {"
NSQ_SOURCE_LINE 00000016 "    require JSON::PP;"
NSQ_SOURCE_LINE 00000017 "    __PACKAGE__->set_plugins(@{"
NSQ_SOURCE_LINE 00000018 "        JSON::PP::decode_json($ENV{LWP_USERAGENT_PLUGINS})"
NSQ_SOURCE_LINE 00000019 "      });"
NSQ_SOURCE_LINE 00000020 "}"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "sub import {"
NSQ_SOURCE_LINE 00000023 "    my $class = shift;"
NSQ_SOURCE_LINE 00000024 "    $class->set_plugins(@_) if @_;"
NSQ_SOURCE_LINE 00000025 "}"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "my @plugins;"
NSQ_SOURCE_LINE 00000028 "sub set_plugins {"
NSQ_SOURCE_LINE 00000029 "    my $class = shift;"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "    my @old_plugins = @plugins;"
NSQ_SOURCE_LINE 00000032 "    @plugins = ();"
NSQ_SOURCE_LINE 00000033 "    while (1) {"
NSQ_SOURCE_LINE 00000034 "        last unless @_;"
NSQ_SOURCE_LINE 00000035 "        my $arg = shift;"
NSQ_SOURCE_LINE 00000036 "        my $class = ref $class eq 'ARRAY' ? $arg->[0] : $arg;"
NSQ_SOURCE_LINE 00000037 "        $class = \"LWP::UserAgent::Plugin::$class\""
NSQ_SOURCE_LINE 00000038 "            unless $class =~ /\\ALWP::UserAgent::Plugin::/;"
NSQ_SOURCE_LINE 00000039 "        (my $class_pm = \"$class.pm\") =~ s!::!/!g;"
NSQ_SOURCE_LINE 00000040 "        require $class_pm;"
NSQ_SOURCE_LINE 00000041 "        my $config = ref $arg eq 'ARRAY' ? $arg->[1] :"
NSQ_SOURCE_LINE 00000042 "            ref($_[0]) eq 'HASH' ? shift : {};"
NSQ_SOURCE_LINE 00000043 "        push @plugins, [$class, $config];"
NSQ_SOURCE_LINE 00000044 "    }"
NSQ_SOURCE_LINE 00000045 "    @old_plugins;"
NSQ_SOURCE_LINE 00000046 "}"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "sub _run_hooks {"
NSQ_SOURCE_LINE 00000049 "    my ($self, $hook, $opts, $r) = @_;"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "    log_trace \"[LWP::UserAgent::Plugin] -> running hook %s\", $hook if $ENV{LWP_USERAGENT_PLUGIN_TRACE};"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "    my $status;"
NSQ_SOURCE_LINE 00000054 "    for my $p (@plugins) {"
NSQ_SOURCE_LINE 00000055 "        next unless $p->[0]->can($hook);"
NSQ_SOURCE_LINE 00000056 "        log_trace \"[LWP::UserAgent::Plugin]   -> handler from plugin %s\", $p->[0] if $ENV{LWP_USERAGENT_PLUGIN_TRACE};"
NSQ_SOURCE_LINE 00000057 "        local $r->{config} = $p->[1];"
NSQ_SOURCE_LINE 00000058 "        local $r->{hook} = $hook;"
NSQ_SOURCE_LINE 00000059 "        $status = $p->[0]->$hook($r);"
NSQ_SOURCE_LINE 00000060 "        unless ($opts->{all}) {"
NSQ_SOURCE_LINE 00000061 "            last unless $status == -1;"
NSQ_SOURCE_LINE 00000062 "        }"
NSQ_SOURCE_LINE 00000063 "        last if $status == 98 || $status == 99;"
NSQ_SOURCE_LINE 00000064 "    }"
NSQ_SOURCE_LINE 00000065 "    $status //= -1;"
NSQ_SOURCE_LINE 00000066 "    log_trace \"[LWP::UserAgent::Plugin] <- return hook %s, status %d\", $hook, $status if $ENV{LWP_USERAGENT_PLUGIN_TRACE};"
NSQ_SOURCE_LINE 00000067 "    $status;"
NSQ_SOURCE_LINE 00000068 "}"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "sub request {"
NSQ_SOURCE_LINE 00000071 "    my $r = {ua=>$_[0], argv=>[@_], method=>'request'};"
NSQ_SOURCE_LINE 00000072 "    my $self = shift;"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "    while (1) {"
NSQ_SOURCE_LINE 00000075 "        $r->{response} = $self->SUPER::request(@_)"
NSQ_SOURCE_LINE 00000076 "            unless $self->_run_hooks('before_request', {all=>1}, $r) == 99;"
NSQ_SOURCE_LINE 00000077 "        last unless $self->_run_hooks('after_request', {all=>1}, $r) == 98;"
NSQ_SOURCE_LINE 00000078 "    }"
NSQ_SOURCE_LINE 00000079 "    $r->{response};"
NSQ_SOURCE_LINE 00000080 "}"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "sub mirror {"
NSQ_SOURCE_LINE 00000083 "    my $r = {ua=>$_[0], argv=>[@_], method=>'mirror'};"
NSQ_SOURCE_LINE 00000084 "    my $self = shift;"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "    while (1) {"
NSQ_SOURCE_LINE 00000087 "        $r->{response} = $self->SUPER::mirror(@_)"
NSQ_SOURCE_LINE 00000088 "            unless $self->_run_hooks('before_mirror', {all=>1}, $r) == 99;"
NSQ_SOURCE_LINE 00000089 "        last unless $self->_run_hooks('after_mirror', {all=>1}, $r) == 98;"
NSQ_SOURCE_LINE 00000090 "    }"
NSQ_SOURCE_LINE 00000091 "    $r->{response};"
NSQ_SOURCE_LINE 00000092 "}"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "1;"
NSQ_SOURCE_LINE 00000095 "# ABSTRACT: LWP::UserAgent with plugins"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "__END__"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "=pod"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "=head1 NAME"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "LWP::UserAgent::Plugin - LWP::UserAgent with plugins"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "=head1 VERSION"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "This document describes version 0.004 of LWP::UserAgent::Plugin (from Perl distribution LWP-UserAgent-Plugin), released on 2020-08-13."
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 " # set plugins to use, globally"
NSQ_SOURCE_LINE 00000114 " use LWP::UserAgent::Plugin Retry=>{retries=>3, retry_delay=>2}, 'Cache';"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 " my $ua = LWP::UserAgent::Plugin->new;"
NSQ_SOURCE_LINE 00000117 " my $res;"
NSQ_SOURCE_LINE 00000118 " $res = $ua->get(\"http://www.example.com/\"); # will retry a few times if failed"
NSQ_SOURCE_LINE 00000119 " $res = $ua->get(\"http://www.example.com/\"); # will get cached response"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 " # to set plugins locally"
NSQ_SOURCE_LINE 00000122 " {"
NSQ_SOURCE_LINE 00000123 "     my @old_plugins = LWP::UserAgent::Plugin->set_plugins(Retry=>{max_attempts=>3, delay=>2}, 'Cache');"
NSQ_SOURCE_LINE 00000124 "     # do stuffs"
NSQ_SOURCE_LINE 00000125 "     LWP::UserAgent::Plugin->set_plugins(@old_plugins);"
NSQ_SOURCE_LINE 00000126 " }"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "B<EARLY RELEASE, THINGS MIGHT STILL CHANGE A LOT>."
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "Like L<HTTP::Tiny::Plugin>, LWP::UserAgent::Plugin allows you to extend"
NSQ_SOURCE_LINE 00000133 "functionalities of L<LWP::UserAgent> using plugins instead of subclassing. This"
NSQ_SOURCE_LINE 00000134 "makes it easy to combine several functionalities together. (Ironically,"
NSQ_SOURCE_LINE 00000135 "LWP::UserAgent::Plugin itself is a subclass of LWP::UserAgent, but the plugins"
NSQ_SOURCE_LINE 00000136 "need not be.)"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "=head2 Plugins"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "A plugin should be module named under C<LWP::UserAgent::Plugin::>, e.g."
NSQ_SOURCE_LINE 00000141 "L<LWP::UserAgent::Plugin::Cache>, LWP::UserAgent::Plugin::Some::Other::Name,"
NSQ_SOURCE_LINE 00000142 "etc."
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "Plugins are used either via import arguments to LWP::UserAgent::Plugin:"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 " use LWP::UserAgent::Plugin Retry=>{retries=>3, retry_delay=>2}, 'Cache';"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "or via calling L</set_plugins>."
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "=head2 Hooks"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "Plugin can define zero or more hooks (as methods with the same name as the hook)"
NSQ_SOURCE_LINE 00000153 "that will be executed during various stages."
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "=head2 Hook arguments"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "Hooks will be called with argument C<$r>, a hash that contains various"
NSQ_SOURCE_LINE 00000158 "information. Keys that are common for all hooks:"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "=over"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "=item * method"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "The related LWP::UserAgent method. For example, in C<before_request> and"
NSQ_SOURCE_LINE 00000165 "C<after_request> hook, the value is C<request>."
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "=item * config"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "Hash."
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "=item * ua"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "Object. The LWP::UserAgent object."
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "=item * hook"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "The current hook name."
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "=item * hook"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "The hook name."
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "=item * argv"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "Array. Arguments passed to hook-related method. For example, for"
NSQ_SOURCE_LINE 00000186 "L</before_request> and L</after_request> hooks, C<argv> will contain arguments"
NSQ_SOURCE_LINE 00000187 "(C<@_>) passed to C<request()>."
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "=item * response"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "Object. The L<HTTP::Response> object. Hooks can modify this."
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "=back"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "=head2 Hook return value"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "Hooks can return an integer, which can be used to signal"
NSQ_SOURCE_LINE 00000198 "declination/success/failure as well as flow control. The following values are"
NSQ_SOURCE_LINE 00000199 "possible:"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "=over"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "=item * -1"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "Declare decline (i.e. try next hook)."
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "=item * 0"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "Declare failure status (for the stage). For a stage that only wants a single"
NSQ_SOURCE_LINE 00000210 "plugin to respond, this will stop hook execution for that stage and the next"
NSQ_SOURCE_LINE 00000211 "plugin in line will not be called. For a stage that wants to execute all"
NSQ_SOURCE_LINE 00000212 "plugins, this will still continue to the next plugin. The status of the"
NSQ_SOURCE_LINE 00000213 "stage is from the status of the plugin called last."
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "=item * 1"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "Declare success/OK status (for the stage). For a stage that only wants a single"
NSQ_SOURCE_LINE 00000218 "plugin to respond, this will stop hook execution for that stage and the next"
NSQ_SOURCE_LINE 00000219 "plugin in line will not be called. For a stage that wants to execute all"
NSQ_SOURCE_LINE 00000220 "plugins, this will still continue to the next plugin. The status of the stage is"
NSQ_SOURCE_LINE 00000221 "from the status of the plugin called last."
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "=item * 99"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "Skip execution of hook-related method. For example, if we return 99 in"
NSQ_SOURCE_LINE 00000226 "L</before_request> then C<request()> will be skipped."
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "Will also immediately stop hook execution for that stage."
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "=item * 98"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "Repeat execution of hook-related method. For example, if we return 98 in"
NSQ_SOURCE_LINE 00000233 "L</after_request> then C<request()> will be repeated."
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "Will also immediately stop hook execution for that stage."
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "=back"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "=head2 List of available hooks"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "Below is the list of hooks in order of execution during a request:"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "=over"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "=item * before_request"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "Will be called before C<request()>. All plugins will be called. Stage will"
NSQ_SOURCE_LINE 00000248 "interpret 99 (skip calling C<request()>)."
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "=item * after_request"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "Will be called before C<request()>. All plugins will be called. Stage will"
NSQ_SOURCE_LINE 00000253 "interpret 98 (repeat calling C<request()>)."
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "=item * before_mirror"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "Will be called before C<mirror()>. All plugins will be called. Stage will"
NSQ_SOURCE_LINE 00000258 "interpret 99 (skip calling C<mirror()>)."
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "=item * after_mirror"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "Will be called before C<request()>. All plugins will be called. Stage will"
NSQ_SOURCE_LINE 00000263 "interpret 98 (repeat calling C<mirror()>)."
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "=back"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "=head1 METHODS"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "=head2 set_plugins"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "Usage:"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 " LWP::UserAgent::Plugin->set_plugins('Plugin1', 'Plugin2'=>{arg=>val, ...}, ...);"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "Class method. Set plugins to use (and replace the previous set of plugins used)."
NSQ_SOURCE_LINE 00000276 "Will return a list containing previous set of plugins."
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "Argument is a list of plugin names, with/without the C<LWP::UserAgent::Plugin::>"
NSQ_SOURCE_LINE 00000279 "prefix. After each plugin name, an optional hashref can be specified to"
NSQ_SOURCE_LINE 00000280 "configure the plugin."
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "=head1 ENVIRONMENT"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "=head2 LWP_USERAGENT_PLUGIN_TRACE"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "Bool. If set to true, will produce more trace log statements."
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "=head2 LWP_USERAGENT_PLUGINS"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "A JSON-encoded array. If set, will call L</set_plugins> with the decoded value."
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "Please visit the project's homepage at L<https://metacpan.org/release/LWP-UserAgent-Plugin>."
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "Source repository is at L<https://github.com/perlancar/perl-LWP-UserAgent-Plugin>."
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "=head1 BUGS"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "Please report any bugs or feature requests on the bugtracker website L<https://rt.cpan.org/Public/Dist/Display.html?Name=LWP-UserAgent-Plugin>"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "When submitting a bug or request, please include a test-file or a"
NSQ_SOURCE_LINE 00000305 "patch to an existing test-file that illustrates the bug or desired"
NSQ_SOURCE_LINE 00000306 "feature."
