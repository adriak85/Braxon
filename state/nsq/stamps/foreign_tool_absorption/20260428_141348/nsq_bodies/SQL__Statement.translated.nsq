NSQ_SOURCE_LINE 00002586 ""
NSQ_SOURCE_LINE 00002587 "=head1 SUPPORT"
NSQ_SOURCE_LINE 00002588 ""
NSQ_SOURCE_LINE 00002589 "You can find documentation for this module with the perldoc command."
NSQ_SOURCE_LINE 00002590 ""
NSQ_SOURCE_LINE 00002591 "    perldoc SQL::Statement"
NSQ_SOURCE_LINE 00002592 ""
NSQ_SOURCE_LINE 00002593 "You can also look for information at:"
NSQ_SOURCE_LINE 00002594 ""
NSQ_SOURCE_LINE 00002595 "=over 4"
NSQ_SOURCE_LINE 00002596 ""
NSQ_SOURCE_LINE 00002597 "=item * RT: CPAN's request tracker"
NSQ_SOURCE_LINE 00002598 ""
NSQ_SOURCE_LINE 00002599 "L<http://rt.cpan.org/NoAuth/Bugs.html?Dist=SQL-Statement>"
NSQ_SOURCE_LINE 00002600 ""
NSQ_SOURCE_LINE 00002601 "=item * AnnoCPAN: Annotated CPAN documentation"
