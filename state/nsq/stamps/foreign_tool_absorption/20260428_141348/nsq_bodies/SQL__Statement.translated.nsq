NSQ_SOURCE_LINE 00001199 ""
NSQ_SOURCE_LINE 00001200 "sub open_table ($$$$$) { croak \"Abstract method \" . ref( $_[0] ) . \"::open_table called\" }"
NSQ_SOURCE_LINE 00001201 ""
NSQ_SOURCE_LINE 00001202 "sub open_tables"
NSQ_SOURCE_LINE 00001203 "{"
NSQ_SOURCE_LINE 00001204 "    my ( $self, $data, $createMode, $lockMode ) = @_;"
NSQ_SOURCE_LINE 00001205 "    my @c;"
NSQ_SOURCE_LINE 00001206 "    my $t      = {};"
NSQ_SOURCE_LINE 00001207 "    my @tables = $self->tables();"
NSQ_SOURCE_LINE 00001208 "    my $count  = -1;"
NSQ_SOURCE_LINE 00001209 "    for my $tbl (@tables)"
NSQ_SOURCE_LINE 00001210 "    {"
NSQ_SOURCE_LINE 00001211 "        ++$count;"
NSQ_SOURCE_LINE 00001212 "        my $name = $tbl->name();"
NSQ_SOURCE_LINE 00001213 "        if ( $name =~ m/^(.+)\\.([^\\.]+)$/ )"
NSQ_SOURCE_LINE 00001214 "        {"
NSQ_SOURCE_LINE 00001215 "            my $schema = $1;    # ignored"
NSQ_SOURCE_LINE 00001216 "            $name = $tbl->{name} = $2;"
NSQ_SOURCE_LINE 00001217 "        }"
NSQ_SOURCE_LINE 00001218 ""
NSQ_SOURCE_LINE 00001219 "        if ( defined( $self->{table_func} ) && defined( $self->{table_func}->{ uc $name } ) )"
NSQ_SOURCE_LINE 00001220 "        {"
NSQ_SOURCE_LINE 00001221 "            my $u_func = $self->{table_func}->{ uc $name };"
NSQ_SOURCE_LINE 00001222 "            $t->{$name} = $self->get_user_func_table( $name, $u_func );"
NSQ_SOURCE_LINE 00001223 "        }"
NSQ_SOURCE_LINE 00001224 "        elsif (defined( $data->{Database}->{sql_ram_tables} )"
NSQ_SOURCE_LINE 00001225 "            && defined( $data->{Database}->{sql_ram_tables}->{$name} )"
NSQ_SOURCE_LINE 00001226 "            && $data->{Database}->{sql_ram_tables}->{$name} )"
NSQ_SOURCE_LINE 00001227 "        {"
NSQ_SOURCE_LINE 00001228 "            $t->{$name} = $data->{Database}->{sql_ram_tables}->{$name};"
NSQ_SOURCE_LINE 00001229 "            $t->{$name}->seek( $data, 0, 0 );"
NSQ_SOURCE_LINE 00001230 "            $t->{$name}->init_table( $data, $name, $createMode, $lockMode )"
NSQ_SOURCE_LINE 00001231 "              if ( $t->{$name}->can('init_table') );"
NSQ_SOURCE_LINE 00001232 "        }"
NSQ_SOURCE_LINE 00001233 "        elsif ( $self->{is_ram_table} )"
NSQ_SOURCE_LINE 00001234 "        {"
NSQ_SOURCE_LINE 00001235 "            $t->{$name} = $data->{Database}->{sql_ram_tables}->{$name} ="
NSQ_SOURCE_LINE 00001236 "              SQL::Statement::RAM::Table->new( $name, [], [] );"
NSQ_SOURCE_LINE 00001237 "        }"
NSQ_SOURCE_LINE 00001238 "        else"
NSQ_SOURCE_LINE 00001239 "        {"
NSQ_SOURCE_LINE 00001240 "            undef $@;"
NSQ_SOURCE_LINE 00001241 "            eval {"
NSQ_SOURCE_LINE 00001242 "                my $open_name = $self->{org_table_names}->[$count];"
NSQ_SOURCE_LINE 00001243 "                $t->{$name} = $self->open_table( $data, $open_name, $createMode, $lockMode );"
NSQ_SOURCE_LINE 00001244 "            };"
NSQ_SOURCE_LINE 00001245 "            my $err = $t->{$name}->{errstr};"
NSQ_SOURCE_LINE 00001246 "            return $self->do_err($err) if ($err);"
NSQ_SOURCE_LINE 00001247 "            return $self->do_err($@)   if ($@);"
NSQ_SOURCE_LINE 00001248 "        }"
NSQ_SOURCE_LINE 00001249 ""
NSQ_SOURCE_LINE 00001250 "        my @cnames;"
NSQ_SOURCE_LINE 00001251 "        my $table_cols = $t->{$name}->{org_col_names};"
NSQ_SOURCE_LINE 00001252 "        $table_cols = $t->{$name}->{col_names} unless $table_cols;"
NSQ_SOURCE_LINE 00001253 "        for my $c (@$table_cols)"
NSQ_SOURCE_LINE 00001254 "        {"
NSQ_SOURCE_LINE 00001255 "            my $newc = $c =~ m/^\"/ ? $c : lc($c);"
NSQ_SOURCE_LINE 00001256 "            push( @cnames, $newc );"
NSQ_SOURCE_LINE 00001257 "            $self->{ORG_NAME}->{$newc} = $c;"
NSQ_SOURCE_LINE 00001258 "        }"
NSQ_SOURCE_LINE 00001259 ""
NSQ_SOURCE_LINE 00001260 "        #"
NSQ_SOURCE_LINE 00001261 "        # set the col_num => col_obj hash for the table"
NSQ_SOURCE_LINE 00001262 "        #"
NSQ_SOURCE_LINE 00001263 "        my $col_nums;"
NSQ_SOURCE_LINE 00001264 "        my $i = 0;"
NSQ_SOURCE_LINE 00001265 "        for (@cnames)"
NSQ_SOURCE_LINE 00001266 "        {"
NSQ_SOURCE_LINE 00001267 "            $col_nums->{$_} = $i++;"
NSQ_SOURCE_LINE 00001268 "        }"
NSQ_SOURCE_LINE 00001269 "        $t->{$name}->{col_nums}  = $col_nums;"
NSQ_SOURCE_LINE 00001270 "        $t->{$name}->{col_names} = \\@cnames;"
NSQ_SOURCE_LINE 00001271 ""
NSQ_SOURCE_LINE 00001272 "        my $tcols = $t->{$name}->col_names();"
NSQ_SOURCE_LINE 00001273 "        my @newcols;"
NSQ_SOURCE_LINE 00001274 "        for (@$tcols)"
NSQ_SOURCE_LINE 00001275 "        {"
NSQ_SOURCE_LINE 00001276 "            next unless ( defined($_) );"
NSQ_SOURCE_LINE 00001277 "            my $ncol = $_;"
NSQ_SOURCE_LINE 00001278 "            $ncol = $name . '.' . $ncol unless ( $ncol =~ m/\\./ );"
NSQ_SOURCE_LINE 00001279 "            push( @newcols, $ncol );"
NSQ_SOURCE_LINE 00001280 "        }"
NSQ_SOURCE_LINE 00001281 "        @c = ( @c, @newcols );"
NSQ_SOURCE_LINE 00001282 "    }"
NSQ_SOURCE_LINE 00001283 ""
NSQ_SOURCE_LINE 00001284 "    $self->buildColumnObjects( $t, \\@tables );"
NSQ_SOURCE_LINE 00001285 "    return $self->do_err( $self->{errstr} ) if ( $self->{errstr} );"
NSQ_SOURCE_LINE 00001286 ""
NSQ_SOURCE_LINE 00001287 "    ##################################################"
NSQ_SOURCE_LINE 00001288 "    # Patch from Cosimo Streppone <cosimoATcpan.org>"
NSQ_SOURCE_LINE 00001289 ""
NSQ_SOURCE_LINE 00001290 "    # my $all_cols = $self->{all_cols}"
NSQ_SOURCE_LINE 00001291 "    #             || [ map {$_->{name} }@{$self->{columns}} ]"
NSQ_SOURCE_LINE 00001292 "    #             || [];"
NSQ_SOURCE_LINE 00001293 "    # @$all_cols = (@$all_cols,@c);"
NSQ_SOURCE_LINE 00001294 "    # $self->{all_cols} = $all_cols;"
NSQ_SOURCE_LINE 00001295 "    if ( !$self->{all_cols} )"
NSQ_SOURCE_LINE 00001296 "    {"
NSQ_SOURCE_LINE 00001297 "        my $all_cols = [];"
NSQ_SOURCE_LINE 00001298 "        $all_cols = [ map { $_->{name} } @{ $self->{columns} } ];"
NSQ_SOURCE_LINE 00001299 "        $all_cols ||= [];    # ?"
NSQ_SOURCE_LINE 00001300 "        @$all_cols = ( @$all_cols, @c );"
NSQ_SOURCE_LINE 00001301 "        $self->{all_cols} = $all_cols;"
NSQ_SOURCE_LINE 00001302 "    }"
NSQ_SOURCE_LINE 00001303 "    ##################################################"
NSQ_SOURCE_LINE 00001304 ""
NSQ_SOURCE_LINE 00001305 "    return SQL::Eval->new( { 'tables' => $t } ), \\@c;"
NSQ_SOURCE_LINE 00001306 "}"
NSQ_SOURCE_LINE 00001307 ""
NSQ_SOURCE_LINE 00001308 "sub getColumnObject($)"
NSQ_SOURCE_LINE 00001309 "{"
NSQ_SOURCE_LINE 00001310 "    my ( $self, $newcol, $t, $tables ) = @_;"
NSQ_SOURCE_LINE 00001311 "    my @columns;"
NSQ_SOURCE_LINE 00001312 ""
NSQ_SOURCE_LINE 00001313 "    if ( ( $newcol->{type} eq 'column' ) && ( -1 != index( $newcol->{value}, '*' ) ) )"
NSQ_SOURCE_LINE 00001314 "    {"
NSQ_SOURCE_LINE 00001315 "        my $tbl;"
NSQ_SOURCE_LINE 00001316 "        my @tables;"
NSQ_SOURCE_LINE 00001317 "        if ( $newcol->{value} =~ m/^(.+)\\.\\*$/ )"
NSQ_SOURCE_LINE 00001318 "        {"
NSQ_SOURCE_LINE 00001319 "            $tbl = $1;"
NSQ_SOURCE_LINE 00001320 "            return $self->do_err(\"No table name given in '$newcol->{value}'\")"
NSQ_SOURCE_LINE 00001321 "              unless ( defined( _STRING($tbl) ) );"
NSQ_SOURCE_LINE 00001322 "            @tables = ($tbl);"
NSQ_SOURCE_LINE 00001323 "        }"
NSQ_SOURCE_LINE 00001324 "        else"
NSQ_SOURCE_LINE 00001325 "        {"
NSQ_SOURCE_LINE 00001326 "            @tables = map { $_->name() } @{$tables};"
NSQ_SOURCE_LINE 00001327 "        }"
NSQ_SOURCE_LINE 00001328 ""
NSQ_SOURCE_LINE 00001329 "        my $join = defined( _HASH( $self->{join} ) )"
NSQ_SOURCE_LINE 00001330 "          && ( ( -1 != index( $self->{join}->{type}, 'NATURAL' ) )"
NSQ_SOURCE_LINE 00001331 "            || ( -1 != index( $self->{join}->{clause}, 'USING' ) ) );"
NSQ_SOURCE_LINE 00001332 "        my %shared_cols;"
NSQ_SOURCE_LINE 00001333 ""
NSQ_SOURCE_LINE 00001334 "        foreach my $table (@tables)"
NSQ_SOURCE_LINE 00001335 "        {"
NSQ_SOURCE_LINE 00001336 "            return $self->do_err(\"Can't find table '$table'\") unless ( defined( $t->{$table} ) );"
NSQ_SOURCE_LINE 00001337 "            my $tcols = $t->{$table}->{col_names};"
NSQ_SOURCE_LINE 00001338 "            return $self->do_err(\"Couldn't find column names for table '$table'!\")"
NSQ_SOURCE_LINE 00001339 "              unless ( _ARRAY($tcols) );"
NSQ_SOURCE_LINE 00001340 "            foreach my $colName ( @{$tcols} )"
NSQ_SOURCE_LINE 00001341 "            {"
NSQ_SOURCE_LINE 00001342 "                next if ( $join && $shared_cols{$colName}++ );"
NSQ_SOURCE_LINE 00001343 "                my $expcol = ["
NSQ_SOURCE_LINE 00001344 "                    $colName,    # column name"
NSQ_SOURCE_LINE 00001345 "                    $table,      # table name"
NSQ_SOURCE_LINE 00001346 "                    SQL::Statement::ColumnValue->new( $self, $table . '.' . $colName ),    # term"
NSQ_SOURCE_LINE 00001347 "                    $colName,                                                              # display name"
NSQ_SOURCE_LINE 00001348 "                    $colName,"
NSQ_SOURCE_LINE 00001349 "                    $newcol,"
NSQ_SOURCE_LINE 00001350 "                ];"
NSQ_SOURCE_LINE 00001351 "                push( @columns, $expcol );"
NSQ_SOURCE_LINE 00001352 "            }"
NSQ_SOURCE_LINE 00001353 "        }"
NSQ_SOURCE_LINE 00001354 "    }"
NSQ_SOURCE_LINE 00001355 "    elsif ( ( 'CREATE' eq $self->command() ) || ( 'DROP' eq $self->command() ) )"
NSQ_SOURCE_LINE 00001356 "    {"
NSQ_SOURCE_LINE 00001357 "        return $self->do_err(\"Invalid column type '$newcol->{type}'\")"
NSQ_SOURCE_LINE 00001358 "          unless ( 'column' eq $newcol->{type} );"
NSQ_SOURCE_LINE 00001359 "        my $expcol = ["
NSQ_SOURCE_LINE 00001360 "            $newcol->{value},    # column name"
NSQ_SOURCE_LINE 00001361 "            undef,               # table name"
NSQ_SOURCE_LINE 00001362 "            undef,               # term"
NSQ_SOURCE_LINE 00001363 "            $newcol->{value},    # display name"
NSQ_SOURCE_LINE 00001364 "            $newcol->{value},    # original name"
NSQ_SOURCE_LINE 00001365 "            $newcol,             # coldef"
NSQ_SOURCE_LINE 00001366 "        ];"
NSQ_SOURCE_LINE 00001367 "        push( @columns, $expcol );"
NSQ_SOURCE_LINE 00001368 "    }"
NSQ_SOURCE_LINE 00001369 "    else"
NSQ_SOURCE_LINE 00001370 "    {"
NSQ_SOURCE_LINE 00001371 "        my $col;"
NSQ_SOURCE_LINE 00001372 "        if ( $newcol->{type} eq 'setfunc' )"
NSQ_SOURCE_LINE 00001373 "        {"
NSQ_SOURCE_LINE 00001374 "            my @cols = $self->getColumnObject( $newcol->{arg}, $t );"
NSQ_SOURCE_LINE 00001375 "            if ( 1 == scalar(@cols) )"
NSQ_SOURCE_LINE 00001376 "            {"
NSQ_SOURCE_LINE 00001377 "                $col = $cols[0]->[2];"
NSQ_SOURCE_LINE 00001378 "            }"
NSQ_SOURCE_LINE 00001379 "            else"
NSQ_SOURCE_LINE 00001380 "            {"
NSQ_SOURCE_LINE 00001381 "                # FIXME add '\\0' constants between items?"
NSQ_SOURCE_LINE 00001382 "                my $colSep = $self->{termFactory}->buildCondition("
NSQ_SOURCE_LINE 00001383 "                    {"
NSQ_SOURCE_LINE 00001384 "                        type  => 'string',"
NSQ_SOURCE_LINE 00001385 "                        value => \"\\0\","
NSQ_SOURCE_LINE 00001386 "                    }"
NSQ_SOURCE_LINE 00001387 "                );"
NSQ_SOURCE_LINE 00001388 "                @cols = map { $_->[2], $colSep } @cols;"
NSQ_SOURCE_LINE 00001389 "                pop(@cols);"
NSQ_SOURCE_LINE 00001390 "                $col = $self->{termFactory}->buildCondition("
NSQ_SOURCE_LINE 00001391 "                    {"
NSQ_SOURCE_LINE 00001392 "                        type  => 'function',"
NSQ_SOURCE_LINE 00001393 "                        name  => 'str_concat',"
NSQ_SOURCE_LINE 00001394 "                        value => \\@cols,"
NSQ_SOURCE_LINE 00001395 "                    }"
NSQ_SOURCE_LINE 00001396 "                );"
NSQ_SOURCE_LINE 00001397 "            }"
NSQ_SOURCE_LINE 00001398 "        }"
NSQ_SOURCE_LINE 00001399 "        else"
NSQ_SOURCE_LINE 00001400 "        {"
NSQ_SOURCE_LINE 00001401 "            $col = $self->{termFactory}->buildCondition($newcol);"
NSQ_SOURCE_LINE 00001402 "        }"
NSQ_SOURCE_LINE 00001403 ""
NSQ_SOURCE_LINE 00001404 "        my $expcol = ["
NSQ_SOURCE_LINE 00001405 "            $newcol->{name} || $newcol->{value},    # column name"
NSQ_SOURCE_LINE 00001406 "            undef,                                  # table name"
NSQ_SOURCE_LINE 00001407 "            $col,                                   # term"
NSQ_SOURCE_LINE 00001408 "            $newcol->{alias} || $newcol->{fullorg}, # display name"
NSQ_SOURCE_LINE 00001409 "            $newcol->{fullorg},                     # original name"
NSQ_SOURCE_LINE 00001410 "            $newcol,                                # coldef"
NSQ_SOURCE_LINE 00001411 "        ];"
NSQ_SOURCE_LINE 00001412 "        push( @columns, $expcol );"
NSQ_SOURCE_LINE 00001413 "    }"
NSQ_SOURCE_LINE 00001414 ""
NSQ_SOURCE_LINE 00001415 "    return @columns;"
NSQ_SOURCE_LINE 00001416 "}"
NSQ_SOURCE_LINE 00001417 ""
NSQ_SOURCE_LINE 00001418 "sub buildColumnObjects($)"
NSQ_SOURCE_LINE 00001419 "{"
NSQ_SOURCE_LINE 00001420 "    my ( $self, $t, $tables ) = @_;"
NSQ_SOURCE_LINE 00001421 ""
NSQ_SOURCE_LINE 00001422 "    defined( _ARRAY0( $self->{column_defs} ) ) or return;"
NSQ_SOURCE_LINE 00001423 "    defined( _ARRAY0( $self->{columns} ) ) and return;"
NSQ_SOURCE_LINE 00001424 ""
NSQ_SOURCE_LINE 00001425 "    $self->{columns} = [];"
NSQ_SOURCE_LINE 00001426 ""
NSQ_SOURCE_LINE 00001427 "    my $coldefs = $self->{column_defs};"
NSQ_SOURCE_LINE 00001428 ""
NSQ_SOURCE_LINE 00001429 "    for ( my $i = 0; $i < scalar( @{$coldefs} ); ++$i )"
NSQ_SOURCE_LINE 00001430 "    {"
NSQ_SOURCE_LINE 00001431 "        my $colentry = $coldefs->[$i];"
NSQ_SOURCE_LINE 00001432 ""
NSQ_SOURCE_LINE 00001433 "        my @columns = $self->getColumnObject( $colentry, $t, $tables );"
NSQ_SOURCE_LINE 00001434 "        return if ( $self->{errstr} );"
NSQ_SOURCE_LINE 00001435 ""
NSQ_SOURCE_LINE 00001436 "        foreach my $col (@columns)"
NSQ_SOURCE_LINE 00001437 "        {"
NSQ_SOURCE_LINE 00001438 "            my $expcol = SQL::Statement::Util::Column->new( @{$col} );"
NSQ_SOURCE_LINE 00001439 "            push( @{ $self->{columns} }, $expcol );"
NSQ_SOURCE_LINE 00001440 "            $self->{column_aliases}->{ $col->[4] } ||= $col->[3];"
NSQ_SOURCE_LINE 00001441 "            $self->{colpos}->{ $col->[3] } = scalar( @{ $self->{columns} } ) - 1;"
NSQ_SOURCE_LINE 00001442 "        }"
NSQ_SOURCE_LINE 00001443 "    }"
NSQ_SOURCE_LINE 00001444 ""
NSQ_SOURCE_LINE 00001445 "    return;"
NSQ_SOURCE_LINE 00001446 "}"
NSQ_SOURCE_LINE 00001447 ""
NSQ_SOURCE_LINE 00001448 "sub verify_expand_column"
NSQ_SOURCE_LINE 00001449 "{"
NSQ_SOURCE_LINE 00001450 "    my ( $self, $c, $i, $usr_cols, $is_duplicate, $col_exists ) = @_;"
NSQ_SOURCE_LINE 00001451 ""
NSQ_SOURCE_LINE 00001452 "    # XXX"
NSQ_SOURCE_LINE 00001453 "    defined $self->{ALIASES}->{$c} and $c = $self->{ALIASES}->{$c};"
NSQ_SOURCE_LINE 00001454 ""
NSQ_SOURCE_LINE 00001455 "    my ( $table, $col, $col_obj );"
NSQ_SOURCE_LINE 00001456 "    if ( $c =~ m/(\\S+)\\.(\\S+)/ )"
NSQ_SOURCE_LINE 00001457 "    {"
NSQ_SOURCE_LINE 00001458 "        $table = $1;"
NSQ_SOURCE_LINE 00001459 "        $col   = $2;"
NSQ_SOURCE_LINE 00001460 "    }"
NSQ_SOURCE_LINE 00001461 "    elsif ( ++${$i} >= 0 )"
NSQ_SOURCE_LINE 00001462 "    {"
NSQ_SOURCE_LINE 00001463 "        $col_obj = $usr_cols->[ ${$i} ];"
NSQ_SOURCE_LINE 00001464 "        ( $table, $col ) = ( $col_obj->{table}, $col_obj->{name} );"
NSQ_SOURCE_LINE 00001465 "    }"
NSQ_SOURCE_LINE 00001466 "    else"
NSQ_SOURCE_LINE 00001467 "    {"
NSQ_SOURCE_LINE 00001468 "        ( $table, $col ) = $self->full_qualified_column_name($c);"
NSQ_SOURCE_LINE 00001469 "    }"
NSQ_SOURCE_LINE 00001470 "    return unless ($col);"
NSQ_SOURCE_LINE 00001471 ""
NSQ_SOURCE_LINE 00001472 "    my $is_column ="
NSQ_SOURCE_LINE 00001473 "      ( defined( _INSTANCE( $col_obj, 'SQL::Statement::Util::Column' ) ) and ( $col_obj->{coldef}->{type} eq 'column' ) )"
NSQ_SOURCE_LINE 00001474 "      ? 1"
NSQ_SOURCE_LINE 00001475 "      : 0;"
NSQ_SOURCE_LINE 00001476 ""
NSQ_SOURCE_LINE 00001477 "    unless ( $is_column and defined($table) )"
NSQ_SOURCE_LINE 00001478 "    {"
NSQ_SOURCE_LINE 00001479 "        ( $table, undef ) = $self->full_qualified_column_name($col);"
NSQ_SOURCE_LINE 00001480 "    }"
NSQ_SOURCE_LINE 00001481 ""
NSQ_SOURCE_LINE 00001482 "    if ( defined( _INSTANCE( $table, 'SQL::Statement::Table' ) ) )"
NSQ_SOURCE_LINE 00001483 "    {"
NSQ_SOURCE_LINE 00001484 "        $table = $table->name();"
NSQ_SOURCE_LINE 00001485 "    }"
NSQ_SOURCE_LINE 00001486 ""
NSQ_SOURCE_LINE 00001487 "    if ( $is_column and !$table )"
NSQ_SOURCE_LINE 00001488 "    {"
NSQ_SOURCE_LINE 00001489 "        return $self->do_err(\"Ambiguous column name '$c'\") if ( $is_duplicate->{$c} );"
NSQ_SOURCE_LINE 00001490 "        return $self->do_err(\"No such column '$col'\");"
NSQ_SOURCE_LINE 00001491 "        $col = $c;"
NSQ_SOURCE_LINE 00001492 "    }"
NSQ_SOURCE_LINE 00001493 "    elsif ($is_column)"
NSQ_SOURCE_LINE 00001494 "    {"
NSQ_SOURCE_LINE 00001495 "        my $is_user_def = 1 if ( $self->{opts}->{function_defs}->{$col} );"
NSQ_SOURCE_LINE 00001496 "        return $self->do_err(\"No such column '$table.$col'\")"
NSQ_SOURCE_LINE 00001497 "          unless ( $col_exists->{\"$table.$col\"}"
NSQ_SOURCE_LINE 00001498 "            or $col_exists->{ \"\\L$table.\" . $col }"
NSQ_SOURCE_LINE 00001499 "            or $is_user_def );"
NSQ_SOURCE_LINE 00001500 "    }"
NSQ_SOURCE_LINE 00001501 ""
NSQ_SOURCE_LINE 00001502 "    return ( $table, $col ) if ( $is_column or ${$i} < 0 );"
NSQ_SOURCE_LINE 00001503 "    return;"
NSQ_SOURCE_LINE 00001504 "}"
NSQ_SOURCE_LINE 00001505 ""
NSQ_SOURCE_LINE 00001506 "sub verify_columns"
NSQ_SOURCE_LINE 00001507 "{"
NSQ_SOURCE_LINE 00001508 "    my ( $self, $data, $eval, $all_cols ) = @_;"
NSQ_SOURCE_LINE 00001509 ""
NSQ_SOURCE_LINE 00001510 "    #"
NSQ_SOURCE_LINE 00001511 "    # NOTE FOR LATER:"
NSQ_SOURCE_LINE 00001512 "    # perhaps cache column names and skip this after first table open"
NSQ_SOURCE_LINE 00001513 "    #"
NSQ_SOURCE_LINE 00001514 "    $all_cols ||= [];"
NSQ_SOURCE_LINE 00001515 "    my @tmp_cols = @{$all_cols};"
NSQ_SOURCE_LINE 00001516 "    my @usr_cols = $self->columns();"
NSQ_SOURCE_LINE 00001517 "    return $self->do_err('No fetchable columns') if ( 0 == scalar(@usr_cols) );"
NSQ_SOURCE_LINE 00001518 ""
NSQ_SOURCE_LINE 00001519 "    my ( $cnum, $fully_qualified_cols ) = ( 0, [] );"
NSQ_SOURCE_LINE 00001520 "    my @tmpcols = map { $_->{name} } @usr_cols;"
NSQ_SOURCE_LINE 00001521 "    my %col_exists = map { $_ => 1 } @tmp_cols;"
NSQ_SOURCE_LINE 00001522 ""
NSQ_SOURCE_LINE 00001523 "    my ( %is_member, @duplicates, %is_duplicate );"
NSQ_SOURCE_LINE 00001524 "    # $_ =~ s/[^.]*\\.(.*)/$1/;"
NSQ_SOURCE_LINE 00001525 "    foreach (@$all_cols)"
NSQ_SOURCE_LINE 00001526 "    {"
NSQ_SOURCE_LINE 00001527 "        substr( $_, 0, index( $_, '.' ) + 1 ) = '';"
NSQ_SOURCE_LINE 00001528 "    }    # XXX we're modifying $all_cols from caller!"
NSQ_SOURCE_LINE 00001529 "    @duplicates = grep( $is_member{$_}++, @$all_cols );"
NSQ_SOURCE_LINE 00001530 "    %is_duplicate = map { $_ => 1 } @duplicates;"
NSQ_SOURCE_LINE 00001531 "    if ( exists( $self->{join} ) && defined( _HASH( $self->{join} ) ) )"
NSQ_SOURCE_LINE 00001532 "    {"
NSQ_SOURCE_LINE 00001533 "        my $join = $self->{join};"
NSQ_SOURCE_LINE 00001534 "        if ( -1 != index( uc $join->{type}, 'NATURAL' ) )"
NSQ_SOURCE_LINE 00001535 "        {"
NSQ_SOURCE_LINE 00001536 "            %is_duplicate = ();"
NSQ_SOURCE_LINE 00001537 "        }"
NSQ_SOURCE_LINE 00001538 ""
NSQ_SOURCE_LINE 00001539 "        # the following should be probably conditioned on an option,"
NSQ_SOURCE_LINE 00001540 "        # but I do not know which --BW"
NSQ_SOURCE_LINE 00001541 "        elsif ( 'USING' eq $join->{clause} )"
NSQ_SOURCE_LINE 00001542 "        {"
NSQ_SOURCE_LINE 00001543 "            my @keys = @{ $join->{keycols} };"
NSQ_SOURCE_LINE 00001544 "            delete @is_duplicate{@keys};"
NSQ_SOURCE_LINE 00001545 "        }"
NSQ_SOURCE_LINE 00001546 "    }"
NSQ_SOURCE_LINE 00001547 ""
NSQ_SOURCE_LINE 00001548 "    my %set_func_nofunc;"
NSQ_SOURCE_LINE 00001549 "    if ( defined( $self->{has_set_functions} ) )"
NSQ_SOURCE_LINE 00001550 "    {"
NSQ_SOURCE_LINE 00001551 "        my @set_func_nofunc = grep { ( $_->{type} ne 'setfunc' ) } @{ $self->{column_defs} };"
NSQ_SOURCE_LINE 00001552 "        %set_func_nofunc = map { ( $_->{alias} || $_->{fullorg} ) => 1 } @set_func_nofunc;"
NSQ_SOURCE_LINE 00001553 "    }"
NSQ_SOURCE_LINE 00001554 "    my ( $is_fully, $set_fully ) = ( {}, {} );"
NSQ_SOURCE_LINE 00001555 "    my $i          = -1;"
NSQ_SOURCE_LINE 00001556 "    my $num_tables = $self->tables();"
NSQ_SOURCE_LINE 00001557 "    for my $c (@tmpcols)"
NSQ_SOURCE_LINE 00001558 "    {"
NSQ_SOURCE_LINE 00001559 "        my ( $table, $col ) = $self->verify_expand_column( $c, \\$i, \\@usr_cols, \\%is_duplicate, \\%col_exists );"
NSQ_SOURCE_LINE 00001560 "        return if ( $self->{errstr} );"
NSQ_SOURCE_LINE 00001561 "        next unless ( $table && $col );"
NSQ_SOURCE_LINE 00001562 ""
NSQ_SOURCE_LINE 00001563 "        my $ftc = \"$table.$col\";"
NSQ_SOURCE_LINE 00001564 "        next if ( $table and $col and $is_fully->{$ftc} );"
NSQ_SOURCE_LINE 00001565 ""
NSQ_SOURCE_LINE 00001566 "        $self->{columns}->[$i]->{name}  = $col;"
NSQ_SOURCE_LINE 00001567 "        $self->{columns}->[$i]->{table} = $table;"
NSQ_SOURCE_LINE 00001568 ""
NSQ_SOURCE_LINE 00001569 "        if ( $table and $col )"
NSQ_SOURCE_LINE 00001570 "        {"
NSQ_SOURCE_LINE 00001571 "            push( @$fully_qualified_cols, $ftc );"
NSQ_SOURCE_LINE 00001572 "            ++$is_fully->{$ftc};"
NSQ_SOURCE_LINE 00001573 "            ++$set_fully->{$ftc} if ( $set_func_nofunc{$c} );"
NSQ_SOURCE_LINE 00001574 "        }"
NSQ_SOURCE_LINE 00001575 "    }"
NSQ_SOURCE_LINE 00001576 ""
NSQ_SOURCE_LINE 00001577 "    if ( defined( $self->{has_set_functions} ) )"
NSQ_SOURCE_LINE 00001578 "    {"
NSQ_SOURCE_LINE 00001579 "        if ( defined( _ARRAY( $self->{group_by} ) ) )"
NSQ_SOURCE_LINE 00001580 "        {"
NSQ_SOURCE_LINE 00001581 "            foreach my $grpby ( @{ $self->{group_by} } )"
NSQ_SOURCE_LINE 00001582 "            {"
NSQ_SOURCE_LINE 00001583 "                $i = -2;"
NSQ_SOURCE_LINE 00001584 "                my ( $table, $col ) = $self->verify_expand_column( $grpby, \\$i, \\@usr_cols, \\%is_duplicate, \\%col_exists );"
NSQ_SOURCE_LINE 00001585 "                return if ( $self->{errstr} );"
NSQ_SOURCE_LINE 00001586 "                $col ||= $grpby;"
NSQ_SOURCE_LINE 00001587 "                ( $table, $col ) = $self->full_qualified_column_name($col)"
NSQ_SOURCE_LINE 00001588 "                  if ( defined($col) && !defined($table) );"
NSQ_SOURCE_LINE 00001589 "                next unless ( defined($table) && defined($col) );"
NSQ_SOURCE_LINE 00001590 "                delete $set_fully->{\"$table.$col\"};"
NSQ_SOURCE_LINE 00001591 "            }"
NSQ_SOURCE_LINE 00001592 "        }"
NSQ_SOURCE_LINE 00001593 ""
NSQ_SOURCE_LINE 00001594 "        if ( defined( _HASH($set_fully) ) )"
NSQ_SOURCE_LINE 00001595 "        {"
NSQ_SOURCE_LINE 00001596 "            return $self->do_err("
NSQ_SOURCE_LINE 00001597 "                sprintf("
NSQ_SOURCE_LINE 00001598 "                    \"Column%s '%s' must appear in the GROUP BY clause or be used in an aggregate function\","
NSQ_SOURCE_LINE 00001599 "                    scalar( keys( %{$set_fully} ) ) > 1 ? 's' : '',"
NSQ_SOURCE_LINE 00001600 "                    join( \"', '\", keys( %{$set_fully} ) )"
NSQ_SOURCE_LINE 00001601 "                )"
NSQ_SOURCE_LINE 00001602 "            );"
NSQ_SOURCE_LINE 00001603 "        }"
NSQ_SOURCE_LINE 00001604 "    }"
NSQ_SOURCE_LINE 00001605 ""
NSQ_SOURCE_LINE 00001606 "    if ( $self->{sort_spec_list} )"
NSQ_SOURCE_LINE 00001607 "    {"
NSQ_SOURCE_LINE 00001608 "        for my $n ( 0 .. scalar @{ $self->{sort_spec_list} } - 1 )"
NSQ_SOURCE_LINE 00001609 "        {"
NSQ_SOURCE_LINE 00001610 "            defined( _INSTANCE( $self->{sort_spec_list}->[$n], 'SQL::Statement::Order' ) ) and next;"
NSQ_SOURCE_LINE 00001611 "            my ( $newcol, $direction ) = each %{ $self->{sort_spec_list}->[$n] };"
NSQ_SOURCE_LINE 00001612 "            my $desc = $direction && ( $direction eq \"DESC\" );    # ($direction || \"ASC\") eq \"DESC\";"
NSQ_SOURCE_LINE 00001613 ""
NSQ_SOURCE_LINE 00001614 "            # XXX parse order by like group by and select list"
NSQ_SOURCE_LINE 00001615 "            $i = -2;"
NSQ_SOURCE_LINE 00001616 "            my ( $table, $col ) = $self->verify_expand_column( $newcol, \\$i, \\@usr_cols, \\%is_duplicate, \\%col_exists );"
NSQ_SOURCE_LINE 00001617 "            $self->{errstr} and return;"
NSQ_SOURCE_LINE 00001618 "            ( $table, $col ) = $self->full_qualified_column_name($newcol)"
NSQ_SOURCE_LINE 00001619 "              if ( defined($col) && !defined($table) );"
NSQ_SOURCE_LINE 00001620 "            defined($table) and $col = $table . \".\" . $col;"
NSQ_SOURCE_LINE 00001621 "            $self->{sort_spec_list}->[$n] = SQL::Statement::Order->new("
NSQ_SOURCE_LINE 00001622 "                col => SQL::Statement::Util::Column->new("
NSQ_SOURCE_LINE 00001623 "                    $col,                                         # column name"
NSQ_SOURCE_LINE 00001624 "                    $table,                                       # table name"
NSQ_SOURCE_LINE 00001625 "                    SQL::Statement::ColumnValue->new( $self, $col ),    # term"
NSQ_SOURCE_LINE 00001626 "                    $newcol                                             # display name"
NSQ_SOURCE_LINE 00001627 "                ),"
NSQ_SOURCE_LINE 00001628 "                direction => $direction,"
NSQ_SOURCE_LINE 00001629 "                desc      => $desc,"
NSQ_SOURCE_LINE 00001630 "            );"
NSQ_SOURCE_LINE 00001631 "        }"
NSQ_SOURCE_LINE 00001632 "    }"
NSQ_SOURCE_LINE 00001633 ""
NSQ_SOURCE_LINE 00001634 "    return $fully_qualified_cols;"
NSQ_SOURCE_LINE 00001635 "}"
NSQ_SOURCE_LINE 00001636 ""
NSQ_SOURCE_LINE 00001637 "sub distinct()"
NSQ_SOURCE_LINE 00001638 "{"
NSQ_SOURCE_LINE 00001639 "    my $q = _STRING( $_[0]->{set_quantifier} );"
NSQ_SOURCE_LINE 00001640 "    return defined($q) && ( 'DISTINCT' eq $q );"
NSQ_SOURCE_LINE 00001641 "}"
NSQ_SOURCE_LINE 00001642 ""
NSQ_SOURCE_LINE 00001643 "sub column_names()"
NSQ_SOURCE_LINE 00001644 "{"
NSQ_SOURCE_LINE 00001645 "    my @cols = map { $_->name() } $_[0]->columns();"
NSQ_SOURCE_LINE 00001646 "    return @cols;"
NSQ_SOURCE_LINE 00001647 "}"
NSQ_SOURCE_LINE 00001648 ""
NSQ_SOURCE_LINE 00001649 "sub command() { return $_[0]->{command} }"
NSQ_SOURCE_LINE 00001650 ""
NSQ_SOURCE_LINE 00001651 "sub params(;$)"
NSQ_SOURCE_LINE 00001652 "{"
NSQ_SOURCE_LINE 00001653 "    if ( !$_[0]->{params} )"
NSQ_SOURCE_LINE 00001654 "    {"
NSQ_SOURCE_LINE 00001655 "        return wantarray ? () : 0;"
NSQ_SOURCE_LINE 00001656 "    }"
NSQ_SOURCE_LINE 00001657 "    return $_[0]->{params}->[ $_[1] ] if ( defined $_[1] );"
NSQ_SOURCE_LINE 00001658 ""
NSQ_SOURCE_LINE 00001659 "    return wantarray ? @{ $_[0]->{params} } : scalar @{ $_[0]->{params} };"
NSQ_SOURCE_LINE 00001660 "}"
NSQ_SOURCE_LINE 00001661 ""
NSQ_SOURCE_LINE 00001662 "sub row_values(;$$)"
NSQ_SOURCE_LINE 00001663 "{"
NSQ_SOURCE_LINE 00001664 "    unless ( defined( _ARRAY( $_[0]->{values} ) ) )"
NSQ_SOURCE_LINE 00001665 "    {"
NSQ_SOURCE_LINE 00001666 "        return wantarray ? () : 0;"
NSQ_SOURCE_LINE 00001667 "    }"
NSQ_SOURCE_LINE 00001668 "    if ( defined( $_[1] ) )"
NSQ_SOURCE_LINE 00001669 "    {"
NSQ_SOURCE_LINE 00001670 "        return 0 unless ( defined( $_[0]->{values}->[ $_[1] ] ) );"
NSQ_SOURCE_LINE 00001671 "        return $_[0]->{values}->[ $_[1] ]->[ $_[2] ] if ( defined $_[2] );"
NSQ_SOURCE_LINE 00001672 ""
NSQ_SOURCE_LINE 00001673 "        return wantarray"
NSQ_SOURCE_LINE 00001674 "          ? map { $_->{value} } @{ $_[0]->{values}->[ $_[1] ] }"
NSQ_SOURCE_LINE 00001675 "          : scalar @{ $_[0]->{values}->[ $_[1] ] };"
NSQ_SOURCE_LINE 00001676 "    }"
NSQ_SOURCE_LINE 00001677 "    else"
NSQ_SOURCE_LINE 00001678 "    {"
NSQ_SOURCE_LINE 00001679 "        return wantarray"
NSQ_SOURCE_LINE 00001680 "          ? map {"
NSQ_SOURCE_LINE 00001681 "            [ map { $_->{value} } @{$_} ]"
NSQ_SOURCE_LINE 00001682 "          } @{ $_[0]->{values} }"
NSQ_SOURCE_LINE 00001683 "          : scalar( @{ $_[0]->{values} } );"
NSQ_SOURCE_LINE 00001684 "    }"
NSQ_SOURCE_LINE 00001685 "}"
NSQ_SOURCE_LINE 00001686 ""
NSQ_SOURCE_LINE 00001687 "#"
NSQ_SOURCE_LINE 00001688 "# $num_of_cols = $stmt->columns()       # number of columns"
NSQ_SOURCE_LINE 00001689 "# @cols        = $stmt->columns()       # array of S::S::Column objects"
NSQ_SOURCE_LINE 00001690 "# $col         = $stmt->columns($cnum)  # S::S::Column obj for col number $cnum"
NSQ_SOURCE_LINE 00001691 "# $col         = $stmt->columns($cname) # S::S::Column obj for col named $cname"
NSQ_SOURCE_LINE 00001692 "#"
NSQ_SOURCE_LINE 00001693 "sub columns"
NSQ_SOURCE_LINE 00001694 "{"
NSQ_SOURCE_LINE 00001695 "    my ( $self, $col ) = @_;"
NSQ_SOURCE_LINE 00001696 "    if ( !$self->{columns} )"
NSQ_SOURCE_LINE 00001697 "    {"
NSQ_SOURCE_LINE 00001698 "        return wantarray ? () : 0;"
NSQ_SOURCE_LINE 00001699 "    }"
NSQ_SOURCE_LINE 00001700 ""
NSQ_SOURCE_LINE 00001701 "    if ( defined $col and $col =~ m/^\\d+$/ )"
NSQ_SOURCE_LINE 00001702 "    {    # arg1 = a number"
NSQ_SOURCE_LINE 00001703 "        return $self->{columns}->[$col];"
NSQ_SOURCE_LINE 00001704 "    }"
NSQ_SOURCE_LINE 00001705 "    elsif ( defined $col )"
NSQ_SOURCE_LINE 00001706 "    {    # arg1 = string"
NSQ_SOURCE_LINE 00001707 "        for my $c ( @{ $self->{columns} } )"
NSQ_SOURCE_LINE 00001708 "        {"
NSQ_SOURCE_LINE 00001709 "            return $c if ( $c->name() eq $col );"
NSQ_SOURCE_LINE 00001710 "        }"
NSQ_SOURCE_LINE 00001711 "    }"
NSQ_SOURCE_LINE 00001712 ""
NSQ_SOURCE_LINE 00001713 "    return wantarray ? @{ $self->{columns} } : scalar @{ $self->{columns} };"
NSQ_SOURCE_LINE 00001714 "}"
NSQ_SOURCE_LINE 00001715 ""
NSQ_SOURCE_LINE 00001716 "sub colname2colnum"
NSQ_SOURCE_LINE 00001717 "{"
NSQ_SOURCE_LINE 00001718 "    if ( !$_[0]->{columns} ) { return undef; }"
NSQ_SOURCE_LINE 00001719 "    for my $i ( 0 .. $#{ $_[0]->{columns} } )"
NSQ_SOURCE_LINE 00001720 "    {"
NSQ_SOURCE_LINE 00001721 "        return $i if ( $_[0]->{columns}->[$i]->name() eq $_[1] );"
NSQ_SOURCE_LINE 00001722 "    }"
NSQ_SOURCE_LINE 00001723 "    return undef;"
NSQ_SOURCE_LINE 00001724 "}"
NSQ_SOURCE_LINE 00001725 ""
NSQ_SOURCE_LINE 00001726 "sub colname2table($)"
NSQ_SOURCE_LINE 00001727 "{"
NSQ_SOURCE_LINE 00001728 "    my ( $self, $col_name ) = @_;"
NSQ_SOURCE_LINE 00001729 "    return undef unless defined $col_name;"
NSQ_SOURCE_LINE 00001730 ""
NSQ_SOURCE_LINE 00001731 "    my ( $tbl, $col );"
NSQ_SOURCE_LINE 00001732 "    if ( $col_name =~ /^(.+)\\.(.+)$/ )"
NSQ_SOURCE_LINE 00001733 "    {"
NSQ_SOURCE_LINE 00001734 "        ( $tbl, $col ) = ( $1, $2 );"
NSQ_SOURCE_LINE 00001735 "    }"
NSQ_SOURCE_LINE 00001736 "    else"
NSQ_SOURCE_LINE 00001737 "    {"
NSQ_SOURCE_LINE 00001738 "        $col = $col_name;"
NSQ_SOURCE_LINE 00001739 "    }"
NSQ_SOURCE_LINE 00001740 ""
NSQ_SOURCE_LINE 00001741 "    my $found_table;"
NSQ_SOURCE_LINE 00001742 "    for my $full_col ( @{ $self->{all_cols} } )"
NSQ_SOURCE_LINE 00001743 "    {"
NSQ_SOURCE_LINE 00001744 "        my ( $stbl, $scol ) = $full_col =~ /^(.+)\\.(.+)$/;"
NSQ_SOURCE_LINE 00001745 "        next unless ( $scol || '' ) eq $col;"
NSQ_SOURCE_LINE 00001746 "        next if ( defined($tbl) && ( $tbl ne $stbl ) );"
NSQ_SOURCE_LINE 00001747 "        $found_table = $stbl;"
NSQ_SOURCE_LINE 00001748 "        last;"
NSQ_SOURCE_LINE 00001749 "    }"
NSQ_SOURCE_LINE 00001750 "    return $found_table;"
NSQ_SOURCE_LINE 00001751 "}"
NSQ_SOURCE_LINE 00001752 ""
NSQ_SOURCE_LINE 00001753 "sub full_qualified_column_name($)"
NSQ_SOURCE_LINE 00001754 "{"
NSQ_SOURCE_LINE 00001755 "    my ( $self, $col_name ) = @_;"
NSQ_SOURCE_LINE 00001756 "    return unless ( defined($col_name) );"
NSQ_SOURCE_LINE 00001757 ""
NSQ_SOURCE_LINE 00001758 "    # XXX"
NSQ_SOURCE_LINE 00001759 "    defined $self->{ALIASES}->{$col_name} and $col_name = $self->{ALIASES}->{$col_name};"
NSQ_SOURCE_LINE 00001760 ""
NSQ_SOURCE_LINE 00001761 "    my ( $tbl, $col );"
NSQ_SOURCE_LINE 00001762 "    unless ( ( $tbl, $col ) = $col_name =~ m/^((?:\"[^\"]+\")|(?:[^.]+))\\.(.*)$/ )"
NSQ_SOURCE_LINE 00001763 "    {"
NSQ_SOURCE_LINE 00001764 "        $col = $col_name;"
NSQ_SOURCE_LINE 00001765 "    }"
NSQ_SOURCE_LINE 00001766 ""
NSQ_SOURCE_LINE 00001767 "    unless ( defined( $self->{splitted_all_cols} ) )"
NSQ_SOURCE_LINE 00001768 "    {"
NSQ_SOURCE_LINE 00001769 "        my @rc;"
NSQ_SOURCE_LINE 00001770 "        for my $full_col ( @{ $self->{all_cols} } )"
NSQ_SOURCE_LINE 00001771 "        {"
NSQ_SOURCE_LINE 00001772 "            if ( my ( $stbl, $scol ) = $full_col =~ m/^((?:\"[^\"]+\")|(?:[^.]+))\\.(.*)$/ )"
NSQ_SOURCE_LINE 00001773 "            {"
NSQ_SOURCE_LINE 00001774 "                push( @{ $self->{splitted_all_cols} }, [ $stbl, $scol ] );"
NSQ_SOURCE_LINE 00001775 "                defined($tbl) and ( $tbl ne $stbl ) and next;"
NSQ_SOURCE_LINE 00001776 "                ( $scol eq $col ) and @rc = ( $stbl, $scol );"
NSQ_SOURCE_LINE 00001777 "            }"
NSQ_SOURCE_LINE 00001778 "        }"
NSQ_SOURCE_LINE 00001779 "        @rc and return @rc;"
NSQ_SOURCE_LINE 00001780 "    }"
NSQ_SOURCE_LINE 00001781 "    else"
NSQ_SOURCE_LINE 00001782 "    {"
NSQ_SOURCE_LINE 00001783 "        for my $splitted_col ( @{ $self->{splitted_all_cols} } )"
NSQ_SOURCE_LINE 00001784 "        {"
NSQ_SOURCE_LINE 00001785 "            defined($tbl) and ( $tbl ne $splitted_col->[0] ) and next;"
NSQ_SOURCE_LINE 00001786 "            ( $splitted_col->[1] eq $col ) and return @$splitted_col;"
NSQ_SOURCE_LINE 00001787 "        }"
NSQ_SOURCE_LINE 00001788 "    }"
NSQ_SOURCE_LINE 00001789 ""
NSQ_SOURCE_LINE 00001790 "    return ( $tbl, $col );"
NSQ_SOURCE_LINE 00001791 "}"
NSQ_SOURCE_LINE 00001792 ""
NSQ_SOURCE_LINE 00001793 "#sub verify_order_cols"
NSQ_SOURCE_LINE 00001794 "#{"
NSQ_SOURCE_LINE 00001795 "#    my ( $self, $table ) = @_;"
NSQ_SOURCE_LINE 00001796 "#    return unless $self->{sort_spec_list};"
NSQ_SOURCE_LINE 00001797 "#    my @ocols = $self->order();"
NSQ_SOURCE_LINE 00001798 "#    my @tcols = @{ $table->col_names() };"
NSQ_SOURCE_LINE 00001799 "#    my @n_ocols;"
NSQ_SOURCE_LINE 00001800 "#"
NSQ_SOURCE_LINE 00001801 "#    for my $colnum ( 0 .. $#ocols )"
NSQ_SOURCE_LINE 00001802 "#    {"
NSQ_SOURCE_LINE 00001803 "#        my $col = $self->order($colnum);"
NSQ_SOURCE_LINE 00001804 "#"
NSQ_SOURCE_LINE 00001805 "#        if ( !defined( $col->table() ) )"
NSQ_SOURCE_LINE 00001806 "#        {"
NSQ_SOURCE_LINE 00001807 "#            my $cname = $ocols[$colnum]->{col}->name();"
NSQ_SOURCE_LINE 00001808 "#            my $tname = $self->colname2table($cname);"
NSQ_SOURCE_LINE 00001809 "#            return $self->do_err(\"No such column '$cname'.\") unless ($tname);"
NSQ_SOURCE_LINE 00001810 "#            $self->{sort_spec_list}->[$colnum]->{col}->{table} = $tname;"
NSQ_SOURCE_LINE 00001811 "#            push( @n_ocols, $tname );"
NSQ_SOURCE_LINE 00001812 "#        }"
NSQ_SOURCE_LINE 00001813 "#    }"
NSQ_SOURCE_LINE 00001814 "#"
NSQ_SOURCE_LINE 00001815 "#    return 1;"
NSQ_SOURCE_LINE 00001816 "#}"
NSQ_SOURCE_LINE 00001817 ""
NSQ_SOURCE_LINE 00001818 "sub limit ($)  { $_[0]->{limit_clause}->{limit}; }"
NSQ_SOURCE_LINE 00001819 "sub offset ($) { $_[0]->{limit_clause}->{offset}; }"
NSQ_SOURCE_LINE 00001820 ""
NSQ_SOURCE_LINE 00001821 "sub order"
NSQ_SOURCE_LINE 00001822 "{"
NSQ_SOURCE_LINE 00001823 "    return unless ( defined $_[0]->{sort_spec_list} );"
NSQ_SOURCE_LINE 00001824 ""
NSQ_SOURCE_LINE 00001825 "    return"
NSQ_SOURCE_LINE 00001826 "        defined( $_[1] ) && looks_like_number( $_[1] ) ? $_[0]->{sort_spec_list}->[ $_[1] ]"
NSQ_SOURCE_LINE 00001827 "      : wantarray ? @{ $_[0]->{sort_spec_list} }"
NSQ_SOURCE_LINE 00001828 "      :             scalar @{ $_[0]->{sort_spec_list} };"
NSQ_SOURCE_LINE 00001829 "}"
NSQ_SOURCE_LINE 00001830 ""
NSQ_SOURCE_LINE 00001831 "sub tables"
NSQ_SOURCE_LINE 00001832 "{"
NSQ_SOURCE_LINE 00001833 "    return"
NSQ_SOURCE_LINE 00001834 "        defined( $_[1] ) && looks_like_number( $_[1] ) ? $_[0]->{tables}->[ $_[1] ]"
NSQ_SOURCE_LINE 00001835 "      : wantarray ? @{ $_[0]->{tables} }"
NSQ_SOURCE_LINE 00001836 "      :             scalar @{ $_[0]->{tables} };"
NSQ_SOURCE_LINE 00001837 "}"
NSQ_SOURCE_LINE 00001838 ""
NSQ_SOURCE_LINE 00001839 "sub order_joins"
NSQ_SOURCE_LINE 00001840 "{"
NSQ_SOURCE_LINE 00001841 "    my ( $self, $links ) = @_;"
NSQ_SOURCE_LINE 00001842 "    my ( @new_keycols, @new_links );"
NSQ_SOURCE_LINE 00001843 "    for (@$links)"
NSQ_SOURCE_LINE 00001844 "    {"
NSQ_SOURCE_LINE 00001845 "        my ( $tbl, $col ) = $self->full_qualified_column_name($_);"
NSQ_SOURCE_LINE 00001846 "        push( @new_keycols, $tbl . $self->{dlm} . $col );"
NSQ_SOURCE_LINE 00001847 "        push( @new_links,   $tbl );"
NSQ_SOURCE_LINE 00001848 "    }"
NSQ_SOURCE_LINE 00001849 "    $self->{join}->{keycols} = $links = \\@new_keycols;"
NSQ_SOURCE_LINE 00001850 "    # my @tmp = @new_keycols;"
NSQ_SOURCE_LINE 00001851 "    # foreach (@tmp) { $_ =~ s/\\./$self->{dlm}/g; }"
NSQ_SOURCE_LINE 00001852 "    # $self->{join}->{keycols} = \\@tmp;"
NSQ_SOURCE_LINE 00001853 "    # @$links = \\@new_keycols;"
NSQ_SOURCE_LINE 00001854 "    my @all_tables;"
NSQ_SOURCE_LINE 00001855 "    my %relations;"
NSQ_SOURCE_LINE 00001856 "    my %is_table;"
NSQ_SOURCE_LINE 00001857 ""
NSQ_SOURCE_LINE 00001858 "    while (@new_links)"
NSQ_SOURCE_LINE 00001859 "    {"
NSQ_SOURCE_LINE 00001860 "        my $t1 = shift(@new_links);"
NSQ_SOURCE_LINE 00001861 "        my $t2 = shift(@new_links);"
NSQ_SOURCE_LINE 00001862 "        return undef unless ( defined($t1) and defined($t2) );"
NSQ_SOURCE_LINE 00001863 "        push @all_tables, $t1 unless ( $is_table{$t1}++ );"
NSQ_SOURCE_LINE 00001864 "        push @all_tables, $t2 unless ( $is_table{$t2}++ );"
NSQ_SOURCE_LINE 00001865 "        $relations{$t1}{$t2}++;"
NSQ_SOURCE_LINE 00001866 "        $relations{$t2}{$t1}++;"
NSQ_SOURCE_LINE 00001867 "    }"
NSQ_SOURCE_LINE 00001868 "    my @tables     = @all_tables;"
NSQ_SOURCE_LINE 00001869 "    my @order      = shift @tables;"
NSQ_SOURCE_LINE 00001870 "    my %is_ordered = ( $order[0] => 1 );"
NSQ_SOURCE_LINE 00001871 "    my %visited;"
NSQ_SOURCE_LINE 00001872 "    while (@tables)"
NSQ_SOURCE_LINE 00001873 "    {"
NSQ_SOURCE_LINE 00001874 "        my $t    = shift @tables;"
NSQ_SOURCE_LINE 00001875 "        my @rels = keys %{ $relations{$t} };"
NSQ_SOURCE_LINE 00001876 "        for my $t2 (@rels)"
NSQ_SOURCE_LINE 00001877 "        {"
NSQ_SOURCE_LINE 00001878 "            next unless $is_ordered{$t2};"
NSQ_SOURCE_LINE 00001879 "            push @order, $t;"
NSQ_SOURCE_LINE 00001880 "            $is_ordered{$t}++;"
NSQ_SOURCE_LINE 00001881 "            last;"
NSQ_SOURCE_LINE 00001882 "        }"
NSQ_SOURCE_LINE 00001883 "        if ( !$is_ordered{$t} )"
NSQ_SOURCE_LINE 00001884 "        {"
NSQ_SOURCE_LINE 00001885 "            push( @tables, $t ) if ( $visited{$t}++ < @all_tables );"
NSQ_SOURCE_LINE 00001886 "        }"
NSQ_SOURCE_LINE 00001887 "    }"
NSQ_SOURCE_LINE 00001888 "    if ( @order < @all_tables )"
NSQ_SOURCE_LINE 00001889 "    {"
NSQ_SOURCE_LINE 00001890 "        my @missing;"
NSQ_SOURCE_LINE 00001891 "        my %in_order = map { $_ => 1 } @order;"
NSQ_SOURCE_LINE 00001892 "        foreach my $tbl (@all_tables)"
NSQ_SOURCE_LINE 00001893 "        {"
NSQ_SOURCE_LINE 00001894 "            next if ( $in_order{$tbl} );"
NSQ_SOURCE_LINE 00001895 "            push( @missing, $tbl );"
NSQ_SOURCE_LINE 00001896 "        }"
NSQ_SOURCE_LINE 00001897 "        return $self->do_err( sprintf( 'Unconnected tables (%s) in equijoin statement!', join( ', ', @missing ) ) );"
NSQ_SOURCE_LINE 00001898 "    }"
NSQ_SOURCE_LINE 00001899 "    $self->{join}->{table_order} = \\@order;"
NSQ_SOURCE_LINE 00001900 "    return \\@order;"
NSQ_SOURCE_LINE 00001901 "}"
NSQ_SOURCE_LINE 00001902 ""
NSQ_SOURCE_LINE 00001903 "sub do_err"
NSQ_SOURCE_LINE 00001904 "{"
NSQ_SOURCE_LINE 00001905 "    my $self    = shift;"
NSQ_SOURCE_LINE 00001906 "    my $err     = shift;"
NSQ_SOURCE_LINE 00001907 "    my $errtype = shift;"
NSQ_SOURCE_LINE 00001908 "    my @c       = caller 6;"
NSQ_SOURCE_LINE 00001909 ""
NSQ_SOURCE_LINE 00001910 "    #$err = \"[\" . $self->{original_string} . \"]\\n$err\\n\\n\";"
NSQ_SOURCE_LINE 00001911 "    #    $err = \"$err\\n\\n\";"
NSQ_SOURCE_LINE 00001912 "    my $prog = $c[1];"
NSQ_SOURCE_LINE 00001913 "    my $line = $c[2];"
NSQ_SOURCE_LINE 00001914 "    $prog = defined($prog) ? \" called from $prog\" : '';"
NSQ_SOURCE_LINE 00001915 "    $prog .= defined($line) ? \" at $line\" : '';"
NSQ_SOURCE_LINE 00001916 "    $err = \"\\nExecution ERROR: $err$prog.\\n\\n\";"
NSQ_SOURCE_LINE 00001917 ""
NSQ_SOURCE_LINE 00001918 "    $self->{errstr} = $err;"
NSQ_SOURCE_LINE 00001919 "    carp $err if $self->{PrintError};"
NSQ_SOURCE_LINE 00001920 "    croak \"$err\" if $self->{RaiseError};"
NSQ_SOURCE_LINE 00001921 "    return;"
NSQ_SOURCE_LINE 00001922 "}"
NSQ_SOURCE_LINE 00001923 ""
NSQ_SOURCE_LINE 00001924 "sub errstr() { return $_[0]->{errstr}; }"
NSQ_SOURCE_LINE 00001925 ""
NSQ_SOURCE_LINE 00001926 "sub where_hash() { return $_[0]->{where_clause}; }"
NSQ_SOURCE_LINE 00001927 ""
NSQ_SOURCE_LINE 00001928 "sub column_defs() { return $_[0]->{column_defs}; }"
NSQ_SOURCE_LINE 00001929 ""
NSQ_SOURCE_LINE 00001930 "sub where()"
NSQ_SOURCE_LINE 00001931 "{"
NSQ_SOURCE_LINE 00001932 "    return undef unless $_[0]->{where_terms};"
NSQ_SOURCE_LINE 00001933 "    return $_[0]->{where_terms};"
NSQ_SOURCE_LINE 00001934 "}"
NSQ_SOURCE_LINE 00001935 ""
NSQ_SOURCE_LINE 00001936 "sub get_user_func_table"
