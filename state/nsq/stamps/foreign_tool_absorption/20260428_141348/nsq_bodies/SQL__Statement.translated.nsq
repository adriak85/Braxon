NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "sub new"
NSQ_SOURCE_LINE 00000038 "{"
NSQ_SOURCE_LINE 00000039 "    my ( $class, $sql, $flags ) = @_;"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "    # IF USER DEFINED extend_csv IN SCRIPT"
NSQ_SOURCE_LINE 00000042 "    # USE THE ANYDATA DIALECT RATHER THAN THE CSV DIALECT"
NSQ_SOURCE_LINE 00000043 "    # WITH DBD::CSV"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "    if (   ( defined($main::extend_csv) && $main::extend_csv )"
NSQ_SOURCE_LINE 00000046 "        || ( defined($main::extend_sql) && $main::extend_sql ) )"
NSQ_SOURCE_LINE 00000047 "    {"
NSQ_SOURCE_LINE 00000048 "        $flags = SQL::Parser->new('AnyData');"
NSQ_SOURCE_LINE 00000049 "    }"
NSQ_SOURCE_LINE 00000050 "    my $parser = $flags;"
NSQ_SOURCE_LINE 00000051 "    my $self = bless( {}, $class );"
NSQ_SOURCE_LINE 00000052 "    $flags->{PrintError}    = 1 unless defined $flags->{PrintError};"
NSQ_SOURCE_LINE 00000053 "    $flags->{text_numbers}  = 1 unless defined $flags->{text_numbers};"
NSQ_SOURCE_LINE 00000054 "    $flags->{alpha_compare} = 1 unless defined $flags->{alpha_compare};"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "    unless ( blessed($flags) )    # avoid copying stale data from earlier parsing sessions"
NSQ_SOURCE_LINE 00000057 "    {"
NSQ_SOURCE_LINE 00000058 "        %$self = ( %$self, %{ clone($flags) } );"
NSQ_SOURCE_LINE 00000059 "    }"
NSQ_SOURCE_LINE 00000060 "    else"
NSQ_SOURCE_LINE 00000061 "    {"
NSQ_SOURCE_LINE 00000062 "        $self->{$_} = $flags->{$_} for qw(RaiseError PrintError opts);"
NSQ_SOURCE_LINE 00000063 "    }"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "    $self->{dlm} = '~';"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "    # Dean Arnold improvement to allow better subclassing"
NSQ_SOURCE_LINE 00000068 "    # if (!ref($parser) or (ref($parser) and ref($parser) !~ /^SQL::Parser/)) {"
NSQ_SOURCE_LINE 00000069 "    unless ( _INSTANCE( $parser, 'SQL::Parser' ) )"
NSQ_SOURCE_LINE 00000070 "    {"
NSQ_SOURCE_LINE 00000071 "        my $parser_dialect = $flags->{dialect} || 'AnyData';"
NSQ_SOURCE_LINE 00000072 "        $parser_dialect = 'AnyData' if ( $parser_dialect =~ m/^(?:CSV|Excel)$/ );"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "        $parser = SQL::Parser->new( $parser_dialect, $flags );"
NSQ_SOURCE_LINE 00000075 "    }"
NSQ_SOURCE_LINE 00000076 "    $self->{termFactory}  = SQL::Statement::TermFactory->new($self);"
NSQ_SOURCE_LINE 00000077 "    $self->{capabilities} = {};"
NSQ_SOURCE_LINE 00000078 "    $self->prepare( $sql, $parser );"
NSQ_SOURCE_LINE 00000079 "    return $self;"
NSQ_SOURCE_LINE 00000080 "}"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "sub prepare"
NSQ_SOURCE_LINE 00000083 "{"
NSQ_SOURCE_LINE 00000084 "    my ( $self, $sql, $parser ) = @_;"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "    $self->{already_prepared}->{$sql} and return;"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "    # delete earlier preparations, they're overwritten after this prepare run"
NSQ_SOURCE_LINE 00000089 "    $self->{already_prepared} = {};"
NSQ_SOURCE_LINE 00000090 "    my $rv = $parser->parse($sql);"
NSQ_SOURCE_LINE 00000091 "    if ($rv)"
NSQ_SOURCE_LINE 00000092 "    {"
NSQ_SOURCE_LINE 00000093 "        undef $self->{errstr};"
NSQ_SOURCE_LINE 00000094 "        my $parser_struct = clone( $parser->{struct} );"
NSQ_SOURCE_LINE 00000095 "        while ( my ( $k, $v ) = each( %{$parser_struct} ) )"
NSQ_SOURCE_LINE 00000096 "        {"
NSQ_SOURCE_LINE 00000097 "            $self->{$k} = $v;"
NSQ_SOURCE_LINE 00000098 "        }"
NSQ_SOURCE_LINE 00000099 "        undef $self->{where_terms};    # force rebuild when needed"
NSQ_SOURCE_LINE 00000100 "        undef $self->{columns};"
NSQ_SOURCE_LINE 00000101 "        undef $self->{splitted_all_cols};"
NSQ_SOURCE_LINE 00000102 "        $self->{argnum} = 0;"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "        my $values    = $self->{values};"
NSQ_SOURCE_LINE 00000105 "        my $param_num = -1;"
NSQ_SOURCE_LINE 00000106 "        if ( $self->{limit_clause} )"
NSQ_SOURCE_LINE 00000107 "        {"
NSQ_SOURCE_LINE 00000108 "            $self->{limit_clause} = SQL::Statement::Limit->new( $self->{limit_clause} );"
NSQ_SOURCE_LINE 00000109 "        }"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "        if ( defined( $self->{num_placeholders} ) )"
NSQ_SOURCE_LINE 00000112 "        {"
NSQ_SOURCE_LINE 00000113 "            for my $i ( 0 .. $self->{num_placeholders} - 1 )"
NSQ_SOURCE_LINE 00000114 "            {"
NSQ_SOURCE_LINE 00000115 "                $self->{params}->[$i] = SQL::Statement::Param->new($i);"
NSQ_SOURCE_LINE 00000116 "            }"
NSQ_SOURCE_LINE 00000117 "        }"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "        $self->{tables} = [ map { SQL::Statement::Table->new($_) } @{ $self->{table_names} } ];"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "        if ( $self->{where_clause} && !defined( $self->{where_terms} ) )"
NSQ_SOURCE_LINE 00000122 "        {"
NSQ_SOURCE_LINE 00000123 "            $self->{where_terms} = $self->{termFactory}->buildCondition( $self->{where_clause} );"
NSQ_SOURCE_LINE 00000124 "            #if ( $self->{where_clause}->{combiners} )"
NSQ_SOURCE_LINE 00000125 "            #{"
NSQ_SOURCE_LINE 00000126 "            #    $self->{has_OR} = 1"
NSQ_SOURCE_LINE 00000127 "            #      if ( first { -1 != index( $_, 'OR' ) } @{ $self->{where_clause}->{combiners} } );"
NSQ_SOURCE_LINE 00000128 "            #}"
NSQ_SOURCE_LINE 00000129 "        }"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "        ++$self->{already_prepared}->{$sql};"
NSQ_SOURCE_LINE 00000132 "        return $self;"
NSQ_SOURCE_LINE 00000133 "    }"
NSQ_SOURCE_LINE 00000134 "    else"
NSQ_SOURCE_LINE 00000135 "    {"
NSQ_SOURCE_LINE 00000136 "        $self->{errstr} = $parser->errstr;"
NSQ_SOURCE_LINE 00000137 "        ++$self->{already_prepared}->{$sql};"
NSQ_SOURCE_LINE 00000138 "        return;"
NSQ_SOURCE_LINE 00000139 "    }"
NSQ_SOURCE_LINE 00000140 "}"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "sub execute"
NSQ_SOURCE_LINE 00000143 "{"
NSQ_SOURCE_LINE 00000144 "    my ( $self, $data, $params ) = @_;"
NSQ_SOURCE_LINE 00000145 "    ( $self->{NUM_OF_ROWS}, $self->{NUM_OF_FIELDS}, $self->{data} ) = ( 0, 0, [] ) and return 'OEO'"
NSQ_SOURCE_LINE 00000146 "      if ( $self->{no_execute} );"
NSQ_SOURCE_LINE 00000147 "    $self->{procedure}->{data} = $data if ( $self->{procedure} );"
NSQ_SOURCE_LINE 00000148 "    $self->{params} = $params;"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "    my ($command) = $self->command();"
NSQ_SOURCE_LINE 00000151 "    return $self->do_err('No command found!') unless ($command);"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "    $self->{where_clause}"
NSQ_SOURCE_LINE 00000154 "      and !defined( $self->{where_terms} )"
NSQ_SOURCE_LINE 00000155 "      and $self->{where_terms} = $self->{termFactory}->buildCondition( $self->{where_clause} );"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "    ( $self->{NUM_OF_ROWS}, $self->{NUM_OF_FIELDS}, $self->{data} ) = $self->$command( $data, $params );"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "    $self->{NAME} ="
NSQ_SOURCE_LINE 00000160 "      _ARRAY0( $self->{columns} ) ? [ map { delete $_->{term}->{fastpath}; $_->display_name() } @{ $self->{columns} } ] : [];"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "    # Force closing the tables"
NSQ_SOURCE_LINE 00000163 "    $self->{tables} = [ map { SQL::Statement::Table->new($_->{name}) } @{ delete $self->{tables} } ];    # create keen defs"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "    undef $self->{where_terms};                                              # force rebuild when needed"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "    return unless ( defined( $self->{NUM_OF_ROWS} ) );"
NSQ_SOURCE_LINE 00000168 "    return $self->{NUM_OF_ROWS} || '0E0';"
NSQ_SOURCE_LINE 00000169 "}"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "sub CREATE ($$$)"
NSQ_SOURCE_LINE 00000172 "{"
NSQ_SOURCE_LINE 00000173 "    my ( $self, $data, $params ) = @_;"
NSQ_SOURCE_LINE 00000174 "    my $names;"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "    # CREATE TABLE AS ..."
NSQ_SOURCE_LINE 00000177 "    my $subquery = $self->{subquery};"
NSQ_SOURCE_LINE 00000178 "    if ($subquery)"
NSQ_SOURCE_LINE 00000179 "    {"
NSQ_SOURCE_LINE 00000180 "        my $sth;"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "        # AS IMPORT"
NSQ_SOURCE_LINE 00000183 "        if ( $subquery =~ m/^IMPORT/i )"
NSQ_SOURCE_LINE 00000184 "        {"
NSQ_SOURCE_LINE 00000185 "            $sth = $data->{Database}->prepare(\"SELECT * FROM $subquery\")"
NSQ_SOURCE_LINE 00000186 "              or return $self->do_err( $data->{Database}->errstr() );"
NSQ_SOURCE_LINE 00000187 "            $sth->execute(@$params) or return $self->do_err( $sth->errstr() );"
NSQ_SOURCE_LINE 00000188 "            $names = $sth->{NAME};"
NSQ_SOURCE_LINE 00000189 "        }"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "        # AS SELECT"
NSQ_SOURCE_LINE 00000192 "        else"
NSQ_SOURCE_LINE 00000193 "        {"
NSQ_SOURCE_LINE 00000194 "            $sth = $data->{Database}->prepare($subquery)"
NSQ_SOURCE_LINE 00000195 "              or return $self->do_err( $data->{Database}->errstr() );"
NSQ_SOURCE_LINE 00000196 "            $sth->execute() or return $self->do_err( $sth->errstr() );"
NSQ_SOURCE_LINE 00000197 "            $names = $sth->{NAME};"
NSQ_SOURCE_LINE 00000198 "        }"
NSQ_SOURCE_LINE 00000199 "        $names = $sth->{NAME} unless defined $names;"
NSQ_SOURCE_LINE 00000200 "        my $tbl_data = $sth->{sql_stmt}->{data};"
NSQ_SOURCE_LINE 00000201 "        my $tbl_name = $self->{org_table_names}->[0] || $self->tables(0)->name;"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "        # my @tbl_cols = map {$_->name} $sth->{sql_stmt}->columns;"
NSQ_SOURCE_LINE 00000204 "        #my @tbl_cols=map{$_->name} $sth->{sql_stmt}->columns if $sth->{sql_stmt};"
NSQ_SOURCE_LINE 00000205 "        my @tbl_cols;"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "        #            @tbl_cols=@{ $sth->{NAME} } unless @tbl_cols;"
NSQ_SOURCE_LINE 00000208 "        @tbl_cols = @{$names} unless (@tbl_cols);"
NSQ_SOURCE_LINE 00000209 "        my $create_sql = \"CREATE TABLE $tbl_name\";"
NSQ_SOURCE_LINE 00000210 "        $create_sql = \"CREATE TEMP TABLE $tbl_name\" if ( $self->{is_ram_table} );"
NSQ_SOURCE_LINE 00000211 "        my @coldefs = map { \"'$_' TEXT\" } @tbl_cols;"
NSQ_SOURCE_LINE 00000212 "        $create_sql .= '(' . join( ',', @coldefs ) . ')';"
NSQ_SOURCE_LINE 00000213 "        $data->{Database}->do($create_sql) or die \"Can't do <$create_sql>: \" . $data->{Database}->errstr;"
NSQ_SOURCE_LINE 00000214 "        my $colstr     = ('?,') x @tbl_cols;"
NSQ_SOURCE_LINE 00000215 "        my $insert_sql = \"INSERT INTO $tbl_name VALUES($colstr)\";"
NSQ_SOURCE_LINE 00000216 "        my $local_sth  = $data->{Database}->prepare($insert_sql);"
NSQ_SOURCE_LINE 00000217 "        $local_sth->execute(@$_) for @$tbl_data;"
NSQ_SOURCE_LINE 00000218 "        return ( 0, 0 );"
NSQ_SOURCE_LINE 00000219 "    }"
NSQ_SOURCE_LINE 00000220 "    my ( $eval, $foo ) = $self->open_tables( $data, 1, 1 );"
NSQ_SOURCE_LINE 00000221 "    return unless ($eval);"
NSQ_SOURCE_LINE 00000222 "    $eval->params($params);"
NSQ_SOURCE_LINE 00000223 "    my ( $row, $table, $col ) = ( [], $eval->table( $self->tables(0)->name() ) );"
NSQ_SOURCE_LINE 00000224 "    if ( _ARRAY( $table->col_names() ) )"
NSQ_SOURCE_LINE 00000225 "    {"
NSQ_SOURCE_LINE 00000226 "        return $self->do_err( \"Table '\" . $self->tables(0)->name() . \"' already exists.\" );"
NSQ_SOURCE_LINE 00000227 "    }"
NSQ_SOURCE_LINE 00000228 "    foreach $col ( $self->columns() )"
NSQ_SOURCE_LINE 00000229 "    {"
NSQ_SOURCE_LINE 00000230 "        push( @{$row}, $col->name() );"
NSQ_SOURCE_LINE 00000231 "    }"
NSQ_SOURCE_LINE 00000232 "    $table->push_names( $data, $row );"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "    return ( 0, 0 );"
NSQ_SOURCE_LINE 00000235 "}"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "sub CALL"
NSQ_SOURCE_LINE 00000238 "{"
NSQ_SOURCE_LINE 00000239 "    my ( $self, $data, $params ) = @_;"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "    # my $dbh = $data->{Database};"
NSQ_SOURCE_LINE 00000242 "    # $self->{procedure}->{data} = $data;"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "    my $procTerm = $self->{termFactory}->buildCondition( $self->{procedure} );"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "    ( $self->{NUM_OF_ROWS}, $self->{NUM_OF_FIELDS}, $self->{data} ) = $procTerm->value($data);"
NSQ_SOURCE_LINE 00000247 "}"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "my $enoentstr = \"Cannot open .*\\(\" . Errno::ENOENT . \"\\)\";"
NSQ_SOURCE_LINE 00000250 "my $eabstrstr = \"Abstract method .*::open_table called\";"
NSQ_SOURCE_LINE 00000251 "my $notblrx   = qr/(?:$enoentstr|$eabstrstr)/;"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "sub DROP ($$$)"
NSQ_SOURCE_LINE 00000254 "{"
NSQ_SOURCE_LINE 00000255 "    my ( $self, $data, $params ) = @_;"
NSQ_SOURCE_LINE 00000256 "    my $eval;"
NSQ_SOURCE_LINE 00000257 "    my @err;"
NSQ_SOURCE_LINE 00000258 "    eval {"
NSQ_SOURCE_LINE 00000259 "        local $SIG{__WARN__} = sub { push @err, @_ };"
NSQ_SOURCE_LINE 00000260 "        ($eval) = $self->open_tables( $data, 0, 1 );"
NSQ_SOURCE_LINE 00000261 "    };"
NSQ_SOURCE_LINE 00000262 "    if (    $self->{ignore_missing_table}"
NSQ_SOURCE_LINE 00000263 "        and ( $@ or @err or $self->{errstr} )"
NSQ_SOURCE_LINE 00000264 "        and grep { $_ =~ $notblrx } ( @err, $@, $self->{errstr} ) )"
NSQ_SOURCE_LINE 00000265 "    {"
NSQ_SOURCE_LINE 00000266 "        return ( -1, 0 );"
NSQ_SOURCE_LINE 00000267 "    }"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "    return if $self->{errstr};"
NSQ_SOURCE_LINE 00000270 "    return $self->do_err( $@ || $err[0] ) if ( $@ || @err );"
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "    #    return undef unless $eval;"
NSQ_SOURCE_LINE 00000273 "    return ( -1, 0 ) unless $eval;"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "    #    $eval->params($params);"
NSQ_SOURCE_LINE 00000276 "    my ($table) = $eval->table( $self->tables(0)->name() );"
NSQ_SOURCE_LINE 00000277 "    $table->drop($data);"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "    #use mylibs; zwarn $self->{sql_stmt};"
NSQ_SOURCE_LINE 00000280 "    return ( -1, 0 );"
NSQ_SOURCE_LINE 00000281 "}"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "sub INSERT ($$$)"
NSQ_SOURCE_LINE 00000284 "{"
NSQ_SOURCE_LINE 00000285 "    my ( $self, $data, $params ) = @_;"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "    my ( $eval, $all_cols ) = $self->open_tables( $data, 0, 1 );"
NSQ_SOURCE_LINE 00000288 "    return unless ($eval);"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "    $params and $eval->params($params);"
NSQ_SOURCE_LINE 00000291 "    $self->verify_columns( $data, $eval, $all_cols ) if ( scalar( $self->columns() ) );"
NSQ_SOURCE_LINE 00000292 "    return if ( $self->{errstr} );"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "    my ($table) = $eval->table( $self->tables(0)->name() );"
NSQ_SOURCE_LINE 00000295 "    $table->seek( $data, 0, 2 ) unless ( $table->capability('insert_new_row') );"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "    my ( $val, $col, $i, $k );"
NSQ_SOURCE_LINE 00000298 "    my ($cNum) = scalar( $self->columns() );"
NSQ_SOURCE_LINE 00000299 "    my $param_num = 0;"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "    $cNum"
NSQ_SOURCE_LINE 00000302 "      or return $self->do_err(\"Bad col names in INSERT\");"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "    my $maxCol = $#$all_cols;"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "    # INSERT INTO $table (row, ...) VALUES (value, ...), (...)"
NSQ_SOURCE_LINE 00000307 "    for ( $k = 0; $k < scalar( @{ $self->{values} } ); ++$k )"
NSQ_SOURCE_LINE 00000308 "    {"
NSQ_SOURCE_LINE 00000309 "        my ($array) = [];"
NSQ_SOURCE_LINE 00000310 "        for ( $i = 0; $i < $cNum; $i++ )"
NSQ_SOURCE_LINE 00000311 "        {"
NSQ_SOURCE_LINE 00000312 "            $col = $self->columns($i);"
NSQ_SOURCE_LINE 00000313 "            $val = $self->row_values( $k, $i );"
NSQ_SOURCE_LINE 00000314 "            if ( defined( _INSTANCE( $val, 'SQL::Statement::Param' ) ) )"
NSQ_SOURCE_LINE 00000315 "            {"
NSQ_SOURCE_LINE 00000316 "                $val = $eval->param( $val->idx() );"
NSQ_SOURCE_LINE 00000317 "            }"
NSQ_SOURCE_LINE 00000318 "            elsif ( defined( _INSTANCE( $val, 'SQL::Statement::Term' ) ) )"
NSQ_SOURCE_LINE 00000319 "            {"
NSQ_SOURCE_LINE 00000320 "                $val = $val->value($eval);"
NSQ_SOURCE_LINE 00000321 "            }"
NSQ_SOURCE_LINE 00000322 "            elsif ( $val and $val->{type} eq 'placeholder' )"
NSQ_SOURCE_LINE 00000323 "            {"
NSQ_SOURCE_LINE 00000324 "                $val = $eval->param( $param_num++ );"
NSQ_SOURCE_LINE 00000325 "            }"
NSQ_SOURCE_LINE 00000326 "            elsif ( defined( _HASH($val) ) )"
NSQ_SOURCE_LINE 00000327 "            {"
NSQ_SOURCE_LINE 00000328 "                $val = $self->{termFactory}->buildCondition($val);"
NSQ_SOURCE_LINE 00000329 "                $val = $val->value($eval);"
NSQ_SOURCE_LINE 00000330 "            }"
NSQ_SOURCE_LINE 00000331 "            else"
NSQ_SOURCE_LINE 00000332 "            {"
NSQ_SOURCE_LINE 00000333 "                return $self->do_err('Internal error: Unexpected column type');"
NSQ_SOURCE_LINE 00000334 "            }"
NSQ_SOURCE_LINE 00000335 "            $array->[ $table->column_num( $col->name() ) ] = $val;"
NSQ_SOURCE_LINE 00000336 "        }"
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "        # Extend row to put values in ALL fields"
NSQ_SOURCE_LINE 00000339 "        $#$array < $maxCol and $array->[$maxCol] = undef;"
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "        $table->capability('insert_new_row')"
NSQ_SOURCE_LINE 00000342 "          ? $table->insert_new_row( $data, $array )"
NSQ_SOURCE_LINE 00000343 "          : $table->push_row( $data, $array );"
NSQ_SOURCE_LINE 00000344 "    }"
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "    return ( $k, 0 );"
NSQ_SOURCE_LINE 00000347 "}"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "sub DELETE ($$$)"
NSQ_SOURCE_LINE 00000350 "{"
NSQ_SOURCE_LINE 00000351 "    my ( $self, $data, $params ) = @_;"
NSQ_SOURCE_LINE 00000352 "    my ( $eval, $all_cols ) = $self->open_tables( $data, 0, 1 );"
NSQ_SOURCE_LINE 00000353 "    return unless $eval;"
NSQ_SOURCE_LINE 00000354 "    $eval->params($params);"
NSQ_SOURCE_LINE 00000355 "    $self->verify_columns( $data, $eval, $all_cols );"
NSQ_SOURCE_LINE 00000356 "    return if ( $self->{errstr} );"
NSQ_SOURCE_LINE 00000357 "    my $tname    = $self->tables(0)->name();"
NSQ_SOURCE_LINE 00000358 "    my ($table)  = $eval->table($tname);"
NSQ_SOURCE_LINE 00000359 "    my $affected = 0;"
NSQ_SOURCE_LINE 00000360 "    my ( @rows, $array );"
NSQ_SOURCE_LINE 00000361 ""
NSQ_SOURCE_LINE 00000362 "    while ( $array = $table->fetch_row($data) )"
NSQ_SOURCE_LINE 00000363 "    {"
NSQ_SOURCE_LINE 00000364 "        if ( $self->eval_where( $eval, $tname, $array ) )"
NSQ_SOURCE_LINE 00000365 "        {"
NSQ_SOURCE_LINE 00000366 "            ++$affected;"
NSQ_SOURCE_LINE 00000367 "            if ( $table->capability('rowwise_delete') and $table->capability('inplace_delete') )"
NSQ_SOURCE_LINE 00000368 "            {"
NSQ_SOURCE_LINE 00000369 "                if ( $table->capability('delete_one_row') )"
NSQ_SOURCE_LINE 00000370 "                {"
NSQ_SOURCE_LINE 00000371 "                    $table->delete_one_row( $data, $array );"
NSQ_SOURCE_LINE 00000372 "                }"
NSQ_SOURCE_LINE 00000373 "                elsif ( $table->capability('delete_current_row') )"
NSQ_SOURCE_LINE 00000374 "                {"
NSQ_SOURCE_LINE 00000375 "                    $table->delete_current_row( $data, $array );"
NSQ_SOURCE_LINE 00000376 "                }"
NSQ_SOURCE_LINE 00000377 "            }"
NSQ_SOURCE_LINE 00000378 "            elsif ( $table->capability('rowwise_delete') )"
NSQ_SOURCE_LINE 00000379 "            {"
NSQ_SOURCE_LINE 00000380 "                push( @rows, $array );"
NSQ_SOURCE_LINE 00000381 "            }"
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "            next;"
NSQ_SOURCE_LINE 00000384 "        }"
NSQ_SOURCE_LINE 00000385 ""
NSQ_SOURCE_LINE 00000386 "        push( @rows, $array ) unless ( $table->capability('rowwise_delete') );"
NSQ_SOURCE_LINE 00000387 "    }"
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "    if ($affected)"
NSQ_SOURCE_LINE 00000390 "    {"
NSQ_SOURCE_LINE 00000391 "        if ( $table->capability('rowwise_delete') )"
NSQ_SOURCE_LINE 00000392 "        {    # @rows is empty in case of inplace_delete capability"
NSQ_SOURCE_LINE 00000393 "            foreach my $array (@rows)"
NSQ_SOURCE_LINE 00000394 "            {"
NSQ_SOURCE_LINE 00000395 "                $table->delete_one_row( $data, $array );"
NSQ_SOURCE_LINE 00000396 "            }"
NSQ_SOURCE_LINE 00000397 "        }"
NSQ_SOURCE_LINE 00000398 "        else"
NSQ_SOURCE_LINE 00000399 "        {"
NSQ_SOURCE_LINE 00000400 "            # rewrite table without deleted elements"
NSQ_SOURCE_LINE 00000401 "            $table->seek( $data, 0, 0 );"
NSQ_SOURCE_LINE 00000402 "            foreach my $array (@rows)"
NSQ_SOURCE_LINE 00000403 "            {"
NSQ_SOURCE_LINE 00000404 "                $table->push_row( $data, $array );"
NSQ_SOURCE_LINE 00000405 "            }"
NSQ_SOURCE_LINE 00000406 "            $table->truncate($data);"
NSQ_SOURCE_LINE 00000407 "        }"
NSQ_SOURCE_LINE 00000408 "    }"
NSQ_SOURCE_LINE 00000409 ""
NSQ_SOURCE_LINE 00000410 "    return ( $affected, 0 );"
NSQ_SOURCE_LINE 00000411 "}"
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "sub UPDATE ($$$)"
NSQ_SOURCE_LINE 00000414 "{"
NSQ_SOURCE_LINE 00000415 "    my ( $self, $data, $params ) = @_;"
NSQ_SOURCE_LINE 00000416 ""
NSQ_SOURCE_LINE 00000417 "    my ( $eval, $all_cols ) = $self->open_tables( $data, 0, 1 );"
NSQ_SOURCE_LINE 00000418 "    return unless $eval;"
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "    my $valnum = $self->{num_val_placeholders};"
NSQ_SOURCE_LINE 00000421 "    my @val_params = splice( @{$params}, 0, $valnum ) if ($valnum);"
NSQ_SOURCE_LINE 00000422 "    $self->{params} ||= $params;"
NSQ_SOURCE_LINE 00000423 "    $eval->params($params);"
NSQ_SOURCE_LINE 00000424 "    $self->verify_columns( $data, $eval, $all_cols );"
NSQ_SOURCE_LINE 00000425 "    return if ( $self->{errstr} );"
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 "    my $tname    = $self->tables(0)->name();"
NSQ_SOURCE_LINE 00000428 "    my ($table)  = $eval->table($tname);"
NSQ_SOURCE_LINE 00000429 "    my $affected = 0;"
NSQ_SOURCE_LINE 00000430 "    my @rows;"
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 "    while ( my $array = $table->fetch_row($data) )"
NSQ_SOURCE_LINE 00000433 "    {"
NSQ_SOURCE_LINE 00000434 "        my $originalValues;"
NSQ_SOURCE_LINE 00000435 "        if ( $self->eval_where( $eval, $tname, $array ) )"
NSQ_SOURCE_LINE 00000436 "        {"
NSQ_SOURCE_LINE 00000437 "            my $valpos = 0;"
NSQ_SOURCE_LINE 00000438 "            if ( $table->capability('update_specific_row') )"
NSQ_SOURCE_LINE 00000439 "            {"
NSQ_SOURCE_LINE 00000440 "                $originalValues = clone($array);"
NSQ_SOURCE_LINE 00000441 "            }"
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "            for ( my $i = 0; $i < $self->columns(); $i++ )"
NSQ_SOURCE_LINE 00000444 "            {"
NSQ_SOURCE_LINE 00000445 "                my $val = $self->row_values( 0, $i );"
NSQ_SOURCE_LINE 00000446 "                if ( defined( _INSTANCE( $val, 'SQL::Statement::Param' ) ) )"
NSQ_SOURCE_LINE 00000447 "                {"
NSQ_SOURCE_LINE 00000448 "                    $val = $val_params[ $valpos++ ];"
NSQ_SOURCE_LINE 00000449 "                }"
NSQ_SOURCE_LINE 00000450 "                elsif ( defined( _INSTANCE( $val, 'SQL::Statement::Term' ) ) )"
NSQ_SOURCE_LINE 00000451 "                {"
NSQ_SOURCE_LINE 00000452 "                    $val = $val->value($eval);"
NSQ_SOURCE_LINE 00000453 "                }"
NSQ_SOURCE_LINE 00000454 "                elsif ( $val and $val->{type} eq 'placeholder' )"
NSQ_SOURCE_LINE 00000455 "                {"
NSQ_SOURCE_LINE 00000456 "                    $val = $val_params[ $valpos++ ];"
NSQ_SOURCE_LINE 00000457 "                }"
NSQ_SOURCE_LINE 00000458 "                elsif ( defined( _HASH($val) ) )"
NSQ_SOURCE_LINE 00000459 "                {"
NSQ_SOURCE_LINE 00000460 "                    $val = $self->{termFactory}->buildCondition($val);"
NSQ_SOURCE_LINE 00000461 "                    $val = $val->value($eval);"
NSQ_SOURCE_LINE 00000462 "                }"
NSQ_SOURCE_LINE 00000463 "                else"
NSQ_SOURCE_LINE 00000464 "                {"
NSQ_SOURCE_LINE 00000465 "                    return $self->do_err('Internal error: Unexpected column type');"
NSQ_SOURCE_LINE 00000466 "                }"
NSQ_SOURCE_LINE 00000467 ""
NSQ_SOURCE_LINE 00000468 "                my $col = $self->columns($i);"
NSQ_SOURCE_LINE 00000469 "                $array->[ $table->column_num( $col->name() ) ] = $val;"
NSQ_SOURCE_LINE 00000470 "            }"
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "            ++$affected;"
NSQ_SOURCE_LINE 00000473 "            if ( $table->capability('rowwise_update') and $table->capability('inplace_update') )"
NSQ_SOURCE_LINE 00000474 "            {"
NSQ_SOURCE_LINE 00000475 "                # Martin Fabiani <martin@fabiani.net>:"
NSQ_SOURCE_LINE 00000476 "                # the following block is the most important enhancement to SQL::Statement::UPDATE"
NSQ_SOURCE_LINE 00000477 "                if ( $table->capability('update_specific_row') )"
NSQ_SOURCE_LINE 00000478 "                {"
NSQ_SOURCE_LINE 00000479 "                    $table->update_specific_row( $data, $array, $originalValues );"
NSQ_SOURCE_LINE 00000480 "                }"
NSQ_SOURCE_LINE 00000481 "                elsif ( $table->capability('update_one_row') )"
NSQ_SOURCE_LINE 00000482 "                {"
NSQ_SOURCE_LINE 00000483 "                    # NOTE: this prevents from updating index keys"
NSQ_SOURCE_LINE 00000484 "                    $table->update_one_row( $data, $array );"
NSQ_SOURCE_LINE 00000485 "                }"
NSQ_SOURCE_LINE 00000486 "                elsif ( $table->capability('update_current_row') )"
NSQ_SOURCE_LINE 00000487 "                {"
NSQ_SOURCE_LINE 00000488 "                    $table->update_current_row( $data, $array );"
NSQ_SOURCE_LINE 00000489 "                }"
NSQ_SOURCE_LINE 00000490 "            }"
NSQ_SOURCE_LINE 00000491 "            elsif ( $table->capability('rowwise_update') )"
NSQ_SOURCE_LINE 00000492 "            {"
NSQ_SOURCE_LINE 00000493 "                push( @rows, $array ) unless ( $table->capability('update_specific_row') );"
NSQ_SOURCE_LINE 00000494 "                push( @rows, [ $array, $originalValues ] )"
NSQ_SOURCE_LINE 00000495 "                  if ( $table->capability('update_specific_row') );"
NSQ_SOURCE_LINE 00000496 "            }"
NSQ_SOURCE_LINE 00000497 "        }"
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "        push( @rows, $array ) unless ( $table->capability('rowwise_update') );"
NSQ_SOURCE_LINE 00000500 "    }"
NSQ_SOURCE_LINE 00000501 ""
NSQ_SOURCE_LINE 00000502 "    if ($affected)"
NSQ_SOURCE_LINE 00000503 "    {"
NSQ_SOURCE_LINE 00000504 "        if ( $table->capability('rowwise_update') )"
NSQ_SOURCE_LINE 00000505 "        {    # @rows is empty in case of inplace_update capability"
NSQ_SOURCE_LINE 00000506 "            foreach my $array (@rows)"
NSQ_SOURCE_LINE 00000507 "            {"
NSQ_SOURCE_LINE 00000508 "                if ( $table->capability('update_specific_row') )"
NSQ_SOURCE_LINE 00000509 "                {"
NSQ_SOURCE_LINE 00000510 "                    $table->update_specific_row( $data, $array->[0], $array->[1] );"
NSQ_SOURCE_LINE 00000511 "                }"
NSQ_SOURCE_LINE 00000512 "                elsif ( $table->capability('update_one_row') )"
NSQ_SOURCE_LINE 00000513 "                {"
NSQ_SOURCE_LINE 00000514 "                    $table->update_one_row( $data, $array );"
NSQ_SOURCE_LINE 00000515 "                }"
NSQ_SOURCE_LINE 00000516 "            }"
NSQ_SOURCE_LINE 00000517 "        }"
NSQ_SOURCE_LINE 00000518 "        else"
NSQ_SOURCE_LINE 00000519 "        {"
NSQ_SOURCE_LINE 00000520 "            # rewrite table with updated elements"
NSQ_SOURCE_LINE 00000521 "            $table->seek( $data, 0, 0 );"
NSQ_SOURCE_LINE 00000522 "            foreach my $array (@rows)"
NSQ_SOURCE_LINE 00000523 "            {"
NSQ_SOURCE_LINE 00000524 "                $table->push_row( $data, $array );"
NSQ_SOURCE_LINE 00000525 "            }"
NSQ_SOURCE_LINE 00000526 "            $table->truncate($data);"
NSQ_SOURCE_LINE 00000527 "        }"
NSQ_SOURCE_LINE 00000528 "    }"
NSQ_SOURCE_LINE 00000529 ""
NSQ_SOURCE_LINE 00000530 "    return ( $affected, 0 );"
NSQ_SOURCE_LINE 00000531 "}"
NSQ_SOURCE_LINE 00000532 ""
NSQ_SOURCE_LINE 00000533 "sub find_join_columns"
NSQ_SOURCE_LINE 00000534 "{"
NSQ_SOURCE_LINE 00000535 "    my ( $self, @all_cols ) = @_;"
NSQ_SOURCE_LINE 00000536 "    my $display_combine = 'NAMED';"
NSQ_SOURCE_LINE 00000537 "    $display_combine = 'NATURAL' if ( -1 != index( $self->{join}->{type},   'NATURAL' ) );"
NSQ_SOURCE_LINE 00000538 "    $display_combine = 'USING'   if ( -1 != index( $self->{join}->{clause}, 'USING' ) );"
NSQ_SOURCE_LINE 00000539 "    my @display_cols;"
NSQ_SOURCE_LINE 00000540 "    my @keycols = ();"
NSQ_SOURCE_LINE 00000541 "    @keycols = @{ $self->{join}->{keycols} }"
NSQ_SOURCE_LINE 00000542 "      if $self->{join}->{keycols};"
NSQ_SOURCE_LINE 00000543 "    foreach (@keycols) { $_ =~ s/\\./$self->{dlm}/ }"
NSQ_SOURCE_LINE 00000544 "    my %is_key_col;"
NSQ_SOURCE_LINE 00000545 "    %is_key_col = map { $_ => 1 } @keycols;"
NSQ_SOURCE_LINE 00000546 ""
NSQ_SOURCE_LINE 00000547 "    # IF NAMED COLUMNS, USE NAMED COLUMNS"
NSQ_SOURCE_LINE 00000548 "    #"
NSQ_SOURCE_LINE 00000549 "    if ( $display_combine eq 'NAMED' )"
NSQ_SOURCE_LINE 00000550 "    {"
NSQ_SOURCE_LINE 00000551 "        @display_cols = $self->columns();"
NSQ_SOURCE_LINE 00000552 ""
NSQ_SOURCE_LINE 00000553 "        #"
NSQ_SOURCE_LINE 00000554 "        #\tDAA"
NSQ_SOURCE_LINE 00000555 "        #\tneed to get to $self's table objects to get the name"
NSQ_SOURCE_LINE 00000556 "        #"
NSQ_SOURCE_LINE 00000557 "        #        @display_cols = map {$_->table . $self->{dlm} . $_->name} @display_cols;"
NSQ_SOURCE_LINE 00000558 "        #        @display_cols = map {$_->table->{NAME} . $self->{dlm} . $_->name} @display_cols;"
NSQ_SOURCE_LINE 00000559 ""
NSQ_SOURCE_LINE 00000560 "        my @tbls   = $self->tables();"
NSQ_SOURCE_LINE 00000561 "        my %tables = ();"
NSQ_SOURCE_LINE 00000562 ""
NSQ_SOURCE_LINE 00000563 "        $tables{ $_->name() } = $_ foreach (@tbls);"
NSQ_SOURCE_LINE 00000564 ""
NSQ_SOURCE_LINE 00000565 "        foreach ( 0 .. $#display_cols )"
NSQ_SOURCE_LINE 00000566 "        {"
NSQ_SOURCE_LINE 00000567 "            $display_cols[$_] = ("
NSQ_SOURCE_LINE 00000568 "                  $display_cols[$_]->table()"
NSQ_SOURCE_LINE 00000569 "                ? $tables{ $display_cols[$_]->table() }->name()"
NSQ_SOURCE_LINE 00000570 "                : ''"
NSQ_SOURCE_LINE 00000571 "              )"
NSQ_SOURCE_LINE 00000572 "              . $self->{dlm}"
NSQ_SOURCE_LINE 00000573 "              . $display_cols[$_]->name();"
NSQ_SOURCE_LINE 00000574 "        }"
NSQ_SOURCE_LINE 00000575 "    }"
NSQ_SOURCE_LINE 00000576 ""
NSQ_SOURCE_LINE 00000577 "    # IF ASTERISKED COLUMNS AND NOT NATURAL OR USING"
NSQ_SOURCE_LINE 00000578 "    # USE ALL COLUMNS, IN ORDER OF NAMING OF TABLES"
NSQ_SOURCE_LINE 00000579 "    #"
NSQ_SOURCE_LINE 00000580 "    elsif ( $display_combine eq 'NONE' )"
NSQ_SOURCE_LINE 00000581 "    {"
NSQ_SOURCE_LINE 00000582 "        @display_cols = @all_cols;"
NSQ_SOURCE_LINE 00000583 "    }"
NSQ_SOURCE_LINE 00000584 ""
NSQ_SOURCE_LINE 00000585 "    # IF NATURAL, COMBINE ALL SHARED COLUMNS"
NSQ_SOURCE_LINE 00000586 "    # IF USING, COMBINE ALL KEY COLUMNS"
NSQ_SOURCE_LINE 00000587 "    #"
NSQ_SOURCE_LINE 00000588 "    else"
NSQ_SOURCE_LINE 00000589 "    {"
NSQ_SOURCE_LINE 00000590 "        my %is_natural;"
NSQ_SOURCE_LINE 00000591 "        for my $full_col (@all_cols)"
NSQ_SOURCE_LINE 00000592 "        {"
NSQ_SOURCE_LINE 00000593 "            my ( $table, $col ) = $full_col =~ m/^([^$self->{dlm}]+)$self->{dlm}(.+)$/;"
NSQ_SOURCE_LINE 00000594 "            next if ( ( $display_combine eq 'NATURAL' ) and $is_natural{$col} );"
NSQ_SOURCE_LINE 00000595 "            next if ( ( $display_combine eq 'USING' ) && $is_natural{$col} && $is_key_col{$col} );"
NSQ_SOURCE_LINE 00000596 "            push( @display_cols, $full_col );"
NSQ_SOURCE_LINE 00000597 "            $is_natural{$col}++;"
NSQ_SOURCE_LINE 00000598 "        }"
NSQ_SOURCE_LINE 00000599 "    }"
NSQ_SOURCE_LINE 00000600 "    my @shared = ();"
NSQ_SOURCE_LINE 00000601 "    my %is_shared;"
NSQ_SOURCE_LINE 00000602 "    if ( $self->{join}->{type} =~ m/NATURAL/ )"
NSQ_SOURCE_LINE 00000603 "    {"
NSQ_SOURCE_LINE 00000604 "        for my $full_col (@all_cols)"
NSQ_SOURCE_LINE 00000605 "        {"
NSQ_SOURCE_LINE 00000606 "            my ( $table, $col ) = $full_col =~ m/^([^$self->{dlm}]+)$self->{dlm}(.+)$/;"
NSQ_SOURCE_LINE 00000607 "            push( @shared, $col ) if ( $is_shared{$col}++ );    # using side-effect of post-inc"
NSQ_SOURCE_LINE 00000608 "        }"
NSQ_SOURCE_LINE 00000609 "    }"
NSQ_SOURCE_LINE 00000610 "    else"
NSQ_SOURCE_LINE 00000611 "    {"
NSQ_SOURCE_LINE 00000612 "        @shared = @keycols;"
NSQ_SOURCE_LINE 00000613 "    }"
NSQ_SOURCE_LINE 00000614 "    $self->{join}->{shared_cols}  = \\@shared;"
NSQ_SOURCE_LINE 00000615 "    $self->{join}->{display_cols} = \\@display_cols;"
NSQ_SOURCE_LINE 00000616 "}"
NSQ_SOURCE_LINE 00000617 ""
NSQ_SOURCE_LINE 00000618 "sub JOIN"
NSQ_SOURCE_LINE 00000619 "{"
NSQ_SOURCE_LINE 00000620 "    my ( $self, $data, $params ) = @_;"
NSQ_SOURCE_LINE 00000621 ""
NSQ_SOURCE_LINE 00000622 "    my ( $eval, $all_cols ) = $self->open_tables( $data, 0, 0 );"
NSQ_SOURCE_LINE 00000623 "    return undef unless $eval;"
NSQ_SOURCE_LINE 00000624 "    $eval->params($params);"
NSQ_SOURCE_LINE 00000625 "    $self->verify_columns( $data, $eval, $all_cols );"
NSQ_SOURCE_LINE 00000626 "    return if ( $self->{errstr} );"
NSQ_SOURCE_LINE 00000627 "    if (    $self->{join}->{keycols}"
NSQ_SOURCE_LINE 00000628 "        and $self->{join}->{table_order}"
NSQ_SOURCE_LINE 00000629 "        and ( scalar( @{ $self->{join}->{table_order} } ) == 0 ) )"
NSQ_SOURCE_LINE 00000630 "    {"
NSQ_SOURCE_LINE 00000631 "        $self->{join}->{table_order} = $self->order_joins( $self->{join}->{keycols} );"
NSQ_SOURCE_LINE 00000632 "        $self->{join}->{table_order} = $self->{table_names}"
NSQ_SOURCE_LINE 00000633 "          unless ( defined( $self->{join}->{table_order} ) );"
NSQ_SOURCE_LINE 00000634 "    }"
NSQ_SOURCE_LINE 00000635 "    my @tables = $self->tables;"
NSQ_SOURCE_LINE 00000636 ""
NSQ_SOURCE_LINE 00000637 "    # GET THE LIST OF QUALIFIED COLUMN NAMES FOR DISPLAY"
NSQ_SOURCE_LINE 00000638 "    # *IN ORDER BY NAMING OF TABLES*"
NSQ_SOURCE_LINE 00000639 "    #"
NSQ_SOURCE_LINE 00000640 "    my @all_cols;"
NSQ_SOURCE_LINE 00000641 "    for my $table (@tables)"
NSQ_SOURCE_LINE 00000642 "    {"
NSQ_SOURCE_LINE 00000643 "        my @cols = @{ $eval->table( $table->{name} )->col_names };"
NSQ_SOURCE_LINE 00000644 "        for my $col (@cols)"
NSQ_SOURCE_LINE 00000645 "        {"
NSQ_SOURCE_LINE 00000646 "            push( @all_cols, $table->{name} . $self->{dlm} . $col );"
NSQ_SOURCE_LINE 00000647 "        }"
NSQ_SOURCE_LINE 00000648 "    }"
NSQ_SOURCE_LINE 00000649 "    $self->find_join_columns(@all_cols);"
NSQ_SOURCE_LINE 00000650 ""
NSQ_SOURCE_LINE 00000651 "    # JOIN THE TABLES"
NSQ_SOURCE_LINE 00000652 "    # *IN ORDER *BY JOINS*"
NSQ_SOURCE_LINE 00000653 "    #"
NSQ_SOURCE_LINE 00000654 "    @tables = @{ $self->{join}->{table_order} } if ( $self->{join}->{table_order} );"
NSQ_SOURCE_LINE 00000655 "    my ( $tableA, $tableB ) = splice( @tables, 0, 2 );"
NSQ_SOURCE_LINE 00000656 "    $tableA = $tableA->{name} if ( ref($tableA) );"
NSQ_SOURCE_LINE 00000657 "    $tableB = $tableB->{name} if ( ref($tableB) );"
NSQ_SOURCE_LINE 00000658 "    my ( $tableAobj, $tableBobj ) = ( $eval->table($tableA), $eval->table($tableB) );"
NSQ_SOURCE_LINE 00000659 "    $tableAobj->{NAME} ||= $tableA;"
NSQ_SOURCE_LINE 00000660 "    $tableBobj->{NAME} ||= $tableB;"
NSQ_SOURCE_LINE 00000661 "    $self->join_2_tables( $data, $params, $tableAobj, $tableBobj );"
NSQ_SOURCE_LINE 00000662 ""
NSQ_SOURCE_LINE 00000663 "    for my $next_table (@tables)"
NSQ_SOURCE_LINE 00000664 "    {"
NSQ_SOURCE_LINE 00000665 "        $tableAobj = $self->{join}->{table};"
NSQ_SOURCE_LINE 00000666 "        $tableBobj = $eval->table($next_table);"
NSQ_SOURCE_LINE 00000667 "        $tableBobj->{NAME} ||= $next_table;"
NSQ_SOURCE_LINE 00000668 "        $self->join_2_tables( $data, $params, $tableAobj, $tableBobj );"
NSQ_SOURCE_LINE 00000669 "        $self->{cur_table} = $next_table;"
NSQ_SOURCE_LINE 00000670 "    }"
NSQ_SOURCE_LINE 00000671 "    return $self->SELECT( $data, $params );"
NSQ_SOURCE_LINE 00000672 "}"
NSQ_SOURCE_LINE 00000673 ""
NSQ_SOURCE_LINE 00000674 "sub join_2_tables"
NSQ_SOURCE_LINE 00000675 "{"
NSQ_SOURCE_LINE 00000676 "    my ( $self, $data, $params, $tableAobj, $tableBobj ) = @_;"
NSQ_SOURCE_LINE 00000677 "    my $share_type = 'IMPLICIT';"
NSQ_SOURCE_LINE 00000678 "    $share_type = 'NATURAL' if ( -1 != index( $self->{join}->{type},   'NATURAL' ) );"
NSQ_SOURCE_LINE 00000679 "    $share_type = 'USING'   if ( -1 != index( $self->{join}->{clause}, 'USING' ) );"
NSQ_SOURCE_LINE 00000680 "    $share_type = 'ON'      if ( -1 != index( $self->{join}->{clause}, 'ON' ) );"
NSQ_SOURCE_LINE 00000681 "    $share_type = 'USING'"
NSQ_SOURCE_LINE 00000682 "      if ( ( $share_type eq 'ON' ) && ( scalar( @{ $self->{join}->{keycols} } ) == 1 ) );"
NSQ_SOURCE_LINE 00000683 "    my $join_type = 'INNER';"
NSQ_SOURCE_LINE 00000684 "    $join_type = 'LEFT'  if ( -1 != index( $self->{join}->{type}, 'LEFT' ) );"
NSQ_SOURCE_LINE 00000685 "    $join_type = 'RIGHT' if ( -1 != index( $self->{join}->{type}, 'RIGHT' ) );"
NSQ_SOURCE_LINE 00000686 "    $join_type = 'FULL'  if ( -1 != index( $self->{join}->{type}, 'FULL' ) );"
NSQ_SOURCE_LINE 00000687 ""
NSQ_SOURCE_LINE 00000688 "    my $right_join = $join_type eq 'RIGHT';"
NSQ_SOURCE_LINE 00000689 "    if ($right_join)"
NSQ_SOURCE_LINE 00000690 "    {"
NSQ_SOURCE_LINE 00000691 "        my $tmpTbl = $tableAobj;"
NSQ_SOURCE_LINE 00000692 "        $tableAobj = $tableBobj;"
NSQ_SOURCE_LINE 00000693 "        $tableBobj = $tmpTbl;"
NSQ_SOURCE_LINE 00000694 "    }"
NSQ_SOURCE_LINE 00000695 ""
NSQ_SOURCE_LINE 00000696 "    my $tableA = $tableAobj->{NAME};"
NSQ_SOURCE_LINE 00000697 "    ( 0 != index( $tableA, '\"' ) ) and $tableA = lc $tableA;"
NSQ_SOURCE_LINE 00000698 "    my $tableB = $tableBobj->{NAME};"
NSQ_SOURCE_LINE 00000699 "    ( 0 != index( $tableB, '\"' ) ) and $tableB = lc $tableB;"
NSQ_SOURCE_LINE 00000700 "    my @colsA = @{ $tableAobj->col_names() };"
NSQ_SOURCE_LINE 00000701 "    my @colsB = @{ $tableBobj->col_names() };"
NSQ_SOURCE_LINE 00000702 "    my ( %isunqualA, %isunqualB, @shared_cols );"
NSQ_SOURCE_LINE 00000703 "    $isunqualB{ $colsB[$_] } = 1 for ( 0 .. $#colsB );"
NSQ_SOURCE_LINE 00000704 "    my @tmpshared = @{ $self->{join}->{shared_cols} };"
NSQ_SOURCE_LINE 00000705 ""
NSQ_SOURCE_LINE 00000706 "    if ( $share_type eq 'ON' )"
NSQ_SOURCE_LINE 00000707 "    {"
NSQ_SOURCE_LINE 00000708 "        $right_join and @tmpshared = reverse @tmpshared;"
NSQ_SOURCE_LINE 00000709 "    }"
NSQ_SOURCE_LINE 00000710 "    elsif ( $share_type eq 'USING' )"
NSQ_SOURCE_LINE 00000711 "    {"
NSQ_SOURCE_LINE 00000712 "        foreach my $c (@tmpshared)"
NSQ_SOURCE_LINE 00000713 "        {"
NSQ_SOURCE_LINE 00000714 "            substr( $c, 0, index( $c, $self->{dlm} ) + 1 ) = '';"
NSQ_SOURCE_LINE 00000715 "            push( @shared_cols, $tableA . $self->{dlm} . $c );"
NSQ_SOURCE_LINE 00000716 "            push( @shared_cols, $tableB . $self->{dlm} . $c );"
NSQ_SOURCE_LINE 00000717 "        }"
NSQ_SOURCE_LINE 00000718 "    }"
NSQ_SOURCE_LINE 00000719 "    elsif ( $share_type eq 'NATURAL' )"
NSQ_SOURCE_LINE 00000720 "    {"
NSQ_SOURCE_LINE 00000721 "        for my $c (@colsA)"
NSQ_SOURCE_LINE 00000722 "        {"
NSQ_SOURCE_LINE 00000723 "            if ( $tableA eq $self->{dlm} . 'tmp' )"
NSQ_SOURCE_LINE 00000724 "            {"
NSQ_SOURCE_LINE 00000725 "                substr( $c, 0, index( $c, $self->{dlm} ) + 1 ) = '';"
NSQ_SOURCE_LINE 00000726 "            }"
NSQ_SOURCE_LINE 00000727 "            if ( $isunqualB{$c} )"
NSQ_SOURCE_LINE 00000728 "            {"
NSQ_SOURCE_LINE 00000729 "                push( @shared_cols, $tableA . $self->{dlm} . $c );"
NSQ_SOURCE_LINE 00000730 "                push( @shared_cols, $tableB . $self->{dlm} . $c );"
NSQ_SOURCE_LINE 00000731 "            }"
NSQ_SOURCE_LINE 00000732 "        }"
NSQ_SOURCE_LINE 00000733 "    }"
NSQ_SOURCE_LINE 00000734 ""
NSQ_SOURCE_LINE 00000735 "    my %whichqual;"
NSQ_SOURCE_LINE 00000736 "    if ( $share_type eq 'ON' || $share_type eq 'IMPLICIT' )"
NSQ_SOURCE_LINE 00000737 "    {"
NSQ_SOURCE_LINE 00000738 "        foreach my $colb (@colsB)"
NSQ_SOURCE_LINE 00000739 "        {"
NSQ_SOURCE_LINE 00000740 "            $colb = $whichqual{$colb} = $tableB . $self->{dlm} . $colb;"
NSQ_SOURCE_LINE 00000741 "        }"
NSQ_SOURCE_LINE 00000742 "    }"
NSQ_SOURCE_LINE 00000743 "    else"
NSQ_SOURCE_LINE 00000744 "    {"
NSQ_SOURCE_LINE 00000745 "        @colsB = map { $tableB . $self->{dlm} . $_ } @colsB;"
NSQ_SOURCE_LINE 00000746 "    }"
NSQ_SOURCE_LINE 00000747 ""
NSQ_SOURCE_LINE 00000748 "    my @all_cols = map { $tableA . $self->{dlm} . $_ } @colsA;"
NSQ_SOURCE_LINE 00000749 "    @all_cols = $right_join ? ( @colsB, @all_cols ) : ( @all_cols, @colsB );"
NSQ_SOURCE_LINE 00000750 "    {"
NSQ_SOURCE_LINE 00000751 "        my $str = $self->{dlm} . \"tmp\" . $self->{dlm};"
NSQ_SOURCE_LINE 00000752 "        foreach (@all_cols)"
NSQ_SOURCE_LINE 00000753 "        {"
NSQ_SOURCE_LINE 00000754 "            my $pos = index( $_, $str );"
NSQ_SOURCE_LINE 00000755 "            $pos >= 0 and substr( $_, $pos, length($str) ) = '';"
NSQ_SOURCE_LINE 00000756 "        }"
NSQ_SOURCE_LINE 00000757 "    }"
NSQ_SOURCE_LINE 00000758 "    if ( $tableA eq $self->{dlm} . 'tmp' )"
NSQ_SOURCE_LINE 00000759 "    {"
NSQ_SOURCE_LINE 00000760 "        foreach my $colA (@colsA)"
NSQ_SOURCE_LINE 00000761 "        {"
NSQ_SOURCE_LINE 00000762 "            my $c = substr( $colA, index( $colA, $self->{dlm} ) + 1 );"
NSQ_SOURCE_LINE 00000763 "            $isunqualA{$c} = $colA;"
NSQ_SOURCE_LINE 00000764 "        }"
NSQ_SOURCE_LINE 00000765 "        #%isunqualA ="
NSQ_SOURCE_LINE 00000766 "        #  map { my ($c) = $_ =~ m/^(?:[^$self->{dlm}]+)$self->{dlm}(.+)$/; $c => $_ } @colsA;"
NSQ_SOURCE_LINE 00000767 "    }"
NSQ_SOURCE_LINE 00000768 "    else"
NSQ_SOURCE_LINE 00000769 "    {"
NSQ_SOURCE_LINE 00000770 "        foreach my $cola (@colsA)"
NSQ_SOURCE_LINE 00000771 "        {"
NSQ_SOURCE_LINE 00000772 "            $cola = $isunqualA{$cola} = $tableA . $self->{dlm} . $cola;"
NSQ_SOURCE_LINE 00000773 "        }"
NSQ_SOURCE_LINE 00000774 "    }"
NSQ_SOURCE_LINE 00000775 ""
NSQ_SOURCE_LINE 00000776 "    my ( %col_numsA, %col_numsB );"
NSQ_SOURCE_LINE 00000777 "    $col_numsA{ $colsA[$_] } = $_ for ( 0 .. $#colsA );"
NSQ_SOURCE_LINE 00000778 "    $col_numsB{ $colsB[$_] } = $_ for ( 0 .. $#colsB );"
NSQ_SOURCE_LINE 00000779 ""
NSQ_SOURCE_LINE 00000780 "    if ( $share_type eq 'ON' || $share_type eq 'IMPLICIT' )"
NSQ_SOURCE_LINE 00000781 "    {"
NSQ_SOURCE_LINE 00000782 "        %whichqual = ( %whichqual, %isunqualA );"
NSQ_SOURCE_LINE 00000783 ""
NSQ_SOURCE_LINE 00000784 "        while (@tmpshared)"
NSQ_SOURCE_LINE 00000785 "        {"
NSQ_SOURCE_LINE 00000786 "            my ( $k1, $k2 ) = splice( @tmpshared, 0, 2 );"
NSQ_SOURCE_LINE 00000787 ""
NSQ_SOURCE_LINE 00000788 "            # if both keys are in one table, bail out - FIXME: errmsg?"
NSQ_SOURCE_LINE 00000789 "            next if ( $isunqualA{$k1} && $isunqualA{$k2} );"
NSQ_SOURCE_LINE 00000790 "            next if ( $isunqualB{$k1} && $isunqualB{$k2} );"
NSQ_SOURCE_LINE 00000791 ""
NSQ_SOURCE_LINE 00000792 "            defined( $whichqual{$k1} ) and $k1 = $whichqual{$k1};"
NSQ_SOURCE_LINE 00000793 "            defined( $whichqual{$k2} ) and $k2 = $whichqual{$k2};"
NSQ_SOURCE_LINE 00000794 ""
NSQ_SOURCE_LINE 00000795 "            if ( defined( $col_numsA{$k1} ) && defined( $col_numsB{$k2} ) )"
NSQ_SOURCE_LINE 00000796 "            {"
NSQ_SOURCE_LINE 00000797 "                push( @shared_cols, $k1, $k2 );"
NSQ_SOURCE_LINE 00000798 "            }"
NSQ_SOURCE_LINE 00000799 "            elsif ( defined( $col_numsA{$k2} ) && defined( $col_numsB{$k1} ) )"
NSQ_SOURCE_LINE 00000800 "            {"
NSQ_SOURCE_LINE 00000801 "                push( @shared_cols, $k2, $k1 );"
NSQ_SOURCE_LINE 00000802 "            }"
NSQ_SOURCE_LINE 00000803 "        }"
NSQ_SOURCE_LINE 00000804 "    }"
NSQ_SOURCE_LINE 00000805 ""
NSQ_SOURCE_LINE 00000806 "    my %is_shared;"
NSQ_SOURCE_LINE 00000807 "    for my $c (@shared_cols)"
NSQ_SOURCE_LINE 00000808 "    {"
NSQ_SOURCE_LINE 00000809 "        $is_shared{$c} = 1;"
NSQ_SOURCE_LINE 00000810 "        defined( $col_numsA{$c} )"
NSQ_SOURCE_LINE 00000811 "          or defined( $col_numsB{$c} )"
NSQ_SOURCE_LINE 00000812 "          or return $self->do_err(\"Can't find shared columns!\");"
NSQ_SOURCE_LINE 00000813 "    }"
NSQ_SOURCE_LINE 00000814 "    my ( $posA, $posB ) = ( [], [] );"
NSQ_SOURCE_LINE 00000815 "    for my $f (@shared_cols)"
NSQ_SOURCE_LINE 00000816 "    {"
NSQ_SOURCE_LINE 00000817 "        defined( $col_numsA{$f} ) and push( @{$posA}, $col_numsA{$f} );"
NSQ_SOURCE_LINE 00000818 "        defined( $col_numsB{$f} ) and push( @{$posB}, $col_numsB{$f} );"
NSQ_SOURCE_LINE 00000819 "    }"
NSQ_SOURCE_LINE 00000820 ""
NSQ_SOURCE_LINE 00000821 "    my $is_inner_join = $join_type eq \"INNER\";"
NSQ_SOURCE_LINE 00000822 "    #use mylibs; zwarn $self->{join};"
NSQ_SOURCE_LINE 00000823 "    # CYCLE THROUGH TABLE B, CREATING A HASH OF ITS VALUES"
NSQ_SOURCE_LINE 00000824 "    #"
NSQ_SOURCE_LINE 00000825 "    my $hashB = {};"
NSQ_SOURCE_LINE 00000826 "  TBLBFETCH: while ( my $array = $tableBobj->fetch_row($data) )"
NSQ_SOURCE_LINE 00000827 "    {"
NSQ_SOURCE_LINE 00000828 "        my @key_vals = @$array[@$posB];"
NSQ_SOURCE_LINE 00000829 "        if ($is_inner_join)"
NSQ_SOURCE_LINE 00000830 "        {"
NSQ_SOURCE_LINE 00000831 "            defined($_) or next TBLBFETCH for (@key_vals);"
NSQ_SOURCE_LINE 00000832 "        }"
NSQ_SOURCE_LINE 00000833 "        my $hashkey = join( ' ', @key_vals );"
NSQ_SOURCE_LINE 00000834 "        push( @{ $hashB->{$hashkey} }, $array );"
NSQ_SOURCE_LINE 00000835 "    }"
NSQ_SOURCE_LINE 00000836 ""
NSQ_SOURCE_LINE 00000837 "    # CYCLE THROUGH TABLE A"
NSQ_SOURCE_LINE 00000838 "    #"
NSQ_SOURCE_LINE 00000839 "    my $blankRow;"
NSQ_SOURCE_LINE 00000840 "    my $joined_table = [];"
NSQ_SOURCE_LINE 00000841 "    my %visited;"
NSQ_SOURCE_LINE 00000842 "  TBLAFETCH: while ( my $arrayA = $tableAobj->fetch_row($data) )    # use tbl1st & tbl2nd"
NSQ_SOURCE_LINE 00000843 "    {"
NSQ_SOURCE_LINE 00000844 "        my @key_vals = @$arrayA[@$posA];"
NSQ_SOURCE_LINE 00000845 "        if ($is_inner_join)"
NSQ_SOURCE_LINE 00000846 "        {"
NSQ_SOURCE_LINE 00000847 "            defined($_) or next TBLAFETCH for (@key_vals);"
NSQ_SOURCE_LINE 00000848 "        }"
NSQ_SOURCE_LINE 00000849 "        my $hashkey = join( ' ', @key_vals );"
NSQ_SOURCE_LINE 00000850 "        my $rowsB = $hashB->{$hashkey};"
NSQ_SOURCE_LINE 00000851 "        if ( !defined($rowsB) && ( $join_type ne 'INNER' ) )"
NSQ_SOURCE_LINE 00000852 "        {"
NSQ_SOURCE_LINE 00000853 "            defined($blankRow) or $blankRow = [ (undef) x scalar(@colsB) ];"
NSQ_SOURCE_LINE 00000854 "            $rowsB = [$blankRow];"
NSQ_SOURCE_LINE 00000855 "        }"
NSQ_SOURCE_LINE 00000856 ""
NSQ_SOURCE_LINE 00000857 "        if ( $join_type ne 'UNION' )"
NSQ_SOURCE_LINE 00000858 "        {"
NSQ_SOURCE_LINE 00000859 "            for my $arrayB ( @{$rowsB} )"
NSQ_SOURCE_LINE 00000860 "            {"
NSQ_SOURCE_LINE 00000861 "                my $newRow = $right_join ? [ @{$arrayB}, @{$arrayA} ] : [ @{$arrayA}, @{$arrayB} ];"
NSQ_SOURCE_LINE 00000862 ""
NSQ_SOURCE_LINE 00000863 "                push( @$joined_table, $newRow );"
NSQ_SOURCE_LINE 00000864 "            }"
NSQ_SOURCE_LINE 00000865 "        }"
NSQ_SOURCE_LINE 00000866 ""
NSQ_SOURCE_LINE 00000867 "        ++$visited{$hashkey};"
NSQ_SOURCE_LINE 00000868 "    }"
NSQ_SOURCE_LINE 00000869 ""
NSQ_SOURCE_LINE 00000870 "    # ADD THE LEFTOVER B ROWS IF NEEDED"
NSQ_SOURCE_LINE 00000871 "    #"
NSQ_SOURCE_LINE 00000872 "    if ( $join_type eq 'FULL' || $join_type eq 'UNION' )"
NSQ_SOURCE_LINE 00000873 "    {"
NSQ_SOURCE_LINE 00000874 "        my $st_is_NaturalOrUsing = ( -1 != index( $self->{join}->{type}, 'NATURAL' ) )"
NSQ_SOURCE_LINE 00000875 "          || ( -1 != index( $self->{join}->{clause}, 'USING' ) );"
NSQ_SOURCE_LINE 00000876 "        while ( my ( $k, $v ) = each %{$hashB} )"
NSQ_SOURCE_LINE 00000877 "        {"
NSQ_SOURCE_LINE 00000878 "            next if ( $visited{$k} );"
NSQ_SOURCE_LINE 00000879 "            for my $rowB (@$v)"
NSQ_SOURCE_LINE 00000880 "            {"
NSQ_SOURCE_LINE 00000881 "                my ( @arrayA, @tmpB, $rowhash );"
NSQ_SOURCE_LINE 00000882 "                @{$rowhash}{@colsB} = @{$rowB};"
NSQ_SOURCE_LINE 00000883 "                for my $c (@all_cols)"
NSQ_SOURCE_LINE 00000884 "                {"
NSQ_SOURCE_LINE 00000885 "                    my ( $table, $col ) = split( $self->{dlm}, $c, 2 );"
NSQ_SOURCE_LINE 00000886 "                    push( @arrayA, undef )          if ( $table eq $tableA );"
NSQ_SOURCE_LINE 00000887 "                    push( @tmpB,   $rowhash->{$c} ) if ( $table eq $tableB );"
NSQ_SOURCE_LINE 00000888 "                }"
NSQ_SOURCE_LINE 00000889 "                @arrayA[@$posA] = @tmpB[@$posB] if ($st_is_NaturalOrUsing);"
NSQ_SOURCE_LINE 00000890 "                my $newRow = [ @arrayA, @tmpB ];"
NSQ_SOURCE_LINE 00000891 "                push( @{$joined_table}, $newRow );"
NSQ_SOURCE_LINE 00000892 "            }"
NSQ_SOURCE_LINE 00000893 "        }"
NSQ_SOURCE_LINE 00000894 "    }"
NSQ_SOURCE_LINE 00000895 ""
NSQ_SOURCE_LINE 00000896 "    undef $hashB;"
NSQ_SOURCE_LINE 00000897 "    undef $tableAobj;"
NSQ_SOURCE_LINE 00000898 "    undef $tableBobj;"
NSQ_SOURCE_LINE 00000899 ""
NSQ_SOURCE_LINE 00000900 "    $self->{join}->{table} ="
NSQ_SOURCE_LINE 00000901 "      SQL::Statement::TempTable->new( $self->{dlm} . 'tmp', \\@all_cols, $self->{join}->{display_cols}, $joined_table );"
NSQ_SOURCE_LINE 00000902 ""
NSQ_SOURCE_LINE 00000903 "    return;"
NSQ_SOURCE_LINE 00000904 "}"
NSQ_SOURCE_LINE 00000905 ""
NSQ_SOURCE_LINE 00000906 "sub run_functions"
NSQ_SOURCE_LINE 00000907 "{"
NSQ_SOURCE_LINE 00000908 "    my ( $self, $data, $params ) = @_;"
NSQ_SOURCE_LINE 00000909 "    my ( $eval, $all_cols ) = $self->open_tables( $data, 0, 0 );"
NSQ_SOURCE_LINE 00000910 "    my @row = ();"
NSQ_SOURCE_LINE 00000911 "    for my $col ( $self->columns() )"
NSQ_SOURCE_LINE 00000912 "    {"
NSQ_SOURCE_LINE 00000913 "        my $val = $col->value($eval);    # FIXME approve"
NSQ_SOURCE_LINE 00000914 "        push( @row, $val );"
NSQ_SOURCE_LINE 00000915 "    }"
NSQ_SOURCE_LINE 00000916 "    return ( 1, scalar @row, [ \\@row ] );"
NSQ_SOURCE_LINE 00000917 "}"
NSQ_SOURCE_LINE 00000918 ""
NSQ_SOURCE_LINE 00000919 "sub SELECT($$)"
NSQ_SOURCE_LINE 00000920 "{"
NSQ_SOURCE_LINE 00000921 "    my ( $self, $data, $params ) = @_;"
NSQ_SOURCE_LINE 00000922 ""
NSQ_SOURCE_LINE 00000923 "    $self->{params} ||= $params;"
NSQ_SOURCE_LINE 00000924 "    defined( _ARRAY( $self->{table_names} ) ) or return $self->run_functions( $data, $params );"
NSQ_SOURCE_LINE 00000925 ""
NSQ_SOURCE_LINE 00000926 "    my ( $eval, $all_cols, $tableName, $table );"
NSQ_SOURCE_LINE 00000927 "    if ( defined( $self->{join} ) )"
NSQ_SOURCE_LINE 00000928 "    {"
NSQ_SOURCE_LINE 00000929 "        defined $self->{join}->{table} or return $self->JOIN( $data, $params );"
NSQ_SOURCE_LINE 00000930 "        $tableName = $self->{dlm} . 'tmp';"
NSQ_SOURCE_LINE 00000931 "        $table     = $self->{join}->{table};"
NSQ_SOURCE_LINE 00000932 "    }"
NSQ_SOURCE_LINE 00000933 "    else"
NSQ_SOURCE_LINE 00000934 "    {"
NSQ_SOURCE_LINE 00000935 "        ( $eval, $all_cols ) = $self->open_tables( $data, 0, 0 );"
NSQ_SOURCE_LINE 00000936 "        return unless $eval;"
NSQ_SOURCE_LINE 00000937 "        $eval->params($params);"
NSQ_SOURCE_LINE 00000938 "        $self->verify_columns( $data, $eval, $all_cols );"
NSQ_SOURCE_LINE 00000939 "        return if ( $self->{errstr} );"
NSQ_SOURCE_LINE 00000940 "        $tableName = $self->tables(0)->name();"
NSQ_SOURCE_LINE 00000941 "        $table     = $eval->table($tableName);"
NSQ_SOURCE_LINE 00000942 "    }"
NSQ_SOURCE_LINE 00000943 ""
NSQ_SOURCE_LINE 00000944 "    my $rows = [];"
NSQ_SOURCE_LINE 00000945 ""
NSQ_SOURCE_LINE 00000946 "    # In a loop, build the list of columns to retrieve; this will be"
NSQ_SOURCE_LINE 00000947 "    # used both for fetching data and ordering."
NSQ_SOURCE_LINE 00000948 "    my ( $cList, $col, $tbl, $ar, $i, $c );"
NSQ_SOURCE_LINE 00000949 "    my $numFields = 0;"
NSQ_SOURCE_LINE 00000950 "    my %columns;"
NSQ_SOURCE_LINE 00000951 "    my @names;"
NSQ_SOURCE_LINE 00000952 "    my %funcs = ();"
NSQ_SOURCE_LINE 00000953 ""
NSQ_SOURCE_LINE 00000954 "    #"
NSQ_SOURCE_LINE 00000955 "    #\tDAA"
NSQ_SOURCE_LINE 00000956 "    #"
NSQ_SOURCE_LINE 00000957 "    #\tlets just disable this and see where it leads..."
NSQ_SOURCE_LINE 00000958 "    #"
NSQ_SOURCE_LINE 00000959 "    #    if ($self->{join}) {"
NSQ_SOURCE_LINE 00000960 "    #          @names = @{ $table->col_names };"
NSQ_SOURCE_LINE 00000961 "    #          for my $col(@names) {"
NSQ_SOURCE_LINE 00000962 "    #             $columns{$tableName}->{\"$col\"} = $numFields++;"
NSQ_SOURCE_LINE 00000963 "    #             push(@$cList, $table->column_num($col));"
NSQ_SOURCE_LINE 00000964 "    #          }"
NSQ_SOURCE_LINE 00000965 "    #    }"
NSQ_SOURCE_LINE 00000966 "    #    else {"
NSQ_SOURCE_LINE 00000967 "    foreach my $column ( $self->columns() )"
NSQ_SOURCE_LINE 00000968 "    {"
NSQ_SOURCE_LINE 00000969 "        if ( _INSTANCE( $column, 'SQL::Statement::Param' ) )"
NSQ_SOURCE_LINE 00000970 "        {"
NSQ_SOURCE_LINE 00000971 "            my $val = $eval->param( $column->idx() );"
NSQ_SOURCE_LINE 00000972 "            if ( -1 != ( my $idx = index( $val, '.' ) ) )"
NSQ_SOURCE_LINE 00000973 "            {"
NSQ_SOURCE_LINE 00000974 "                $col = substr( $val, 0, $idx );"
NSQ_SOURCE_LINE 00000975 "                $tbl = substr( $val, $idx + 1 );"
NSQ_SOURCE_LINE 00000976 "            }"
NSQ_SOURCE_LINE 00000977 "            else"
NSQ_SOURCE_LINE 00000978 "            {"
NSQ_SOURCE_LINE 00000979 "                $col = $val;"
NSQ_SOURCE_LINE 00000980 "                $tbl = $tableName;"
NSQ_SOURCE_LINE 00000981 "            }"
NSQ_SOURCE_LINE 00000982 "            $tbl ||= '';"
NSQ_SOURCE_LINE 00000983 "            $columns{$tbl}->{$col} = $numFields++;"
NSQ_SOURCE_LINE 00000984 "        }"
NSQ_SOURCE_LINE 00000985 "        else"
NSQ_SOURCE_LINE 00000986 "        {"
NSQ_SOURCE_LINE 00000987 "            ( $col, $tbl ) = ( $column->name(), $column->table() );"
NSQ_SOURCE_LINE 00000988 "            $tbl ||= '';"
NSQ_SOURCE_LINE 00000989 "            $columns{$tbl}->{ $column->display_name() } = $columns{$tbl}->{$col} = $numFields++;"
NSQ_SOURCE_LINE 00000990 "        }"
NSQ_SOURCE_LINE 00000991 ""
NSQ_SOURCE_LINE 00000992 "        #"
NSQ_SOURCE_LINE 00000993 "        # handle functions in select list"
NSQ_SOURCE_LINE 00000994 "        #"
NSQ_SOURCE_LINE 00000995 "        #\tDAA"
NSQ_SOURCE_LINE 00000996 "        #"
NSQ_SOURCE_LINE 00000997 "        #\tcheck for a join temp table; if so, check if we can locate"
NSQ_SOURCE_LINE 00000998 "        #\tthe column in its delimited set"
NSQ_SOURCE_LINE 00000999 "        #"
NSQ_SOURCE_LINE 00001000 "        my $cnum ="
NSQ_SOURCE_LINE 00001001 "          ( ( $tableName eq ( $self->{dlm} . 'tmp' ) ) && ( $tbl ne '' ) )"
NSQ_SOURCE_LINE 00001002 "          ? $table->column_num( $tbl . $self->{dlm} . $col )"
NSQ_SOURCE_LINE 00001003 "          : $table->column_num($col);"
NSQ_SOURCE_LINE 00001004 ""
NSQ_SOURCE_LINE 00001005 "        if ( !defined $cnum || $column->{function} )"
NSQ_SOURCE_LINE 00001006 "        {"
NSQ_SOURCE_LINE 00001007 "            $funcs{$col} = $column->{function};"
NSQ_SOURCE_LINE 00001008 "            $cnum = $col;"
NSQ_SOURCE_LINE 00001009 "        }"
NSQ_SOURCE_LINE 00001010 "        push( @$cList, $cnum );"
NSQ_SOURCE_LINE 00001011 ""
NSQ_SOURCE_LINE 00001012 "        # push(@$cList, $table->column_num($col));"
NSQ_SOURCE_LINE 00001013 "        push( @names, $col );"
NSQ_SOURCE_LINE 00001014 "    }"
NSQ_SOURCE_LINE 00001015 ""
NSQ_SOURCE_LINE 00001016 "    #    }"
NSQ_SOURCE_LINE 00001017 "    $cList = [] unless ( defined($cList) );"
NSQ_SOURCE_LINE 00001018 "    if ( $self->{join} )"
NSQ_SOURCE_LINE 00001019 "    {"
NSQ_SOURCE_LINE 00001020 "        foreach (@names) { $_ =~ s/^[^$self->{dlm}]+$self->{dlm}//; }"
NSQ_SOURCE_LINE 00001021 "    }"
NSQ_SOURCE_LINE 00001022 "    $self->{NAME} = \\@names;"
NSQ_SOURCE_LINE 00001023 "    # $self->verify_order_cols($table);"
NSQ_SOURCE_LINE 00001024 "    my @order_by      = $self->order();"
NSQ_SOURCE_LINE 00001025 "    my @extraSortCols = ();"
NSQ_SOURCE_LINE 00001026 ""
NSQ_SOURCE_LINE 00001027 "    if (@order_by)"
NSQ_SOURCE_LINE 00001028 "    {"
NSQ_SOURCE_LINE 00001029 "        my $nFields = $numFields;"
NSQ_SOURCE_LINE 00001030 ""
NSQ_SOURCE_LINE 00001031 "        # It is possible that the user gave an ORDER BY clause with columns"
NSQ_SOURCE_LINE 00001032 "        # that are not part of $cList yet. These columns will need to be"
NSQ_SOURCE_LINE 00001033 "        # present in the array of arrays for sorting, but will be stripped"
NSQ_SOURCE_LINE 00001034 "        # off later."
NSQ_SOURCE_LINE 00001035 "        my $i = -1;"
NSQ_SOURCE_LINE 00001036 "        foreach my $column (@order_by)"
NSQ_SOURCE_LINE 00001037 "        {"
NSQ_SOURCE_LINE 00001038 "            ++$i;"
NSQ_SOURCE_LINE 00001039 "            ( $col, $tbl ) = ( $column->column(), $column->table() );"
NSQ_SOURCE_LINE 00001040 "            my $pos;"
NSQ_SOURCE_LINE 00001041 "            $tbl ||= $self->colname2table($col);"
NSQ_SOURCE_LINE 00001042 "            $tbl ||= '';"
NSQ_SOURCE_LINE 00001043 "            if ( $self->{join} )"
NSQ_SOURCE_LINE 00001044 "            {"
NSQ_SOURCE_LINE 00001045 "                $pos = $table->column_num( $tbl . $self->{dlm} . $col );"
NSQ_SOURCE_LINE 00001046 "                defined($pos)"
NSQ_SOURCE_LINE 00001047 "                  or $pos = $table->column_num( $tbl . '_' . $col );"
NSQ_SOURCE_LINE 00001048 "            }"
NSQ_SOURCE_LINE 00001049 "            next if ( exists( $columns{$tbl}->{$col} ) );"
NSQ_SOURCE_LINE 00001050 "            $pos = $table->column_num($col) unless ( defined($pos) );"
NSQ_SOURCE_LINE 00001051 "            push( @extraSortCols, $pos );"
NSQ_SOURCE_LINE 00001052 "            $columns{$tbl}->{$col} = $nFields++;"
NSQ_SOURCE_LINE 00001053 "        }"
NSQ_SOURCE_LINE 00001054 "    }"
NSQ_SOURCE_LINE 00001055 ""
NSQ_SOURCE_LINE 00001056 "    my $e = $self->{join} ? $table : $eval;"
NSQ_SOURCE_LINE 00001057 ""
NSQ_SOURCE_LINE 00001058 "    # begin count for limiting if there's a limit clause and no order clause"
NSQ_SOURCE_LINE 00001059 "    #"
NSQ_SOURCE_LINE 00001060 "    my $limit_count = 0 if ( $self->limit() and !$self->order() );"
NSQ_SOURCE_LINE 00001061 "    my $limit       = $self->limit();"
NSQ_SOURCE_LINE 00001062 "    my $row_count   = 0;"
NSQ_SOURCE_LINE 00001063 "    my $offset      = $self->offset() || 0;"
NSQ_SOURCE_LINE 00001064 "    while ( my $array = $table->fetch_row($data) )"
NSQ_SOURCE_LINE 00001065 "    {"
NSQ_SOURCE_LINE 00001066 "        if ( $self->eval_where( $e, $tableName, $array, \\%funcs ) )"
NSQ_SOURCE_LINE 00001067 "        {"
NSQ_SOURCE_LINE 00001068 "            next if ( defined($limit_count) and ( $row_count++ < $offset ) );"
NSQ_SOURCE_LINE 00001069 ""
NSQ_SOURCE_LINE 00001070 "            my @row = map { $_->value($e) } $self->columns();"
NSQ_SOURCE_LINE 00001071 "            push( @{$rows}, \\@row );"
NSQ_SOURCE_LINE 00001072 ""
NSQ_SOURCE_LINE 00001073 "            # We quit here if there's a limit clause without order clause"
NSQ_SOURCE_LINE 00001074 "            # and the limit has been reached"
NSQ_SOURCE_LINE 00001075 "            defined($limit_count)"
NSQ_SOURCE_LINE 00001076 "              and ( ++$limit_count >= $limit )"
NSQ_SOURCE_LINE 00001077 "              and return ( $limit, $numFields, $rows );"
NSQ_SOURCE_LINE 00001078 "        }"
NSQ_SOURCE_LINE 00001079 "    }"
NSQ_SOURCE_LINE 00001080 ""
NSQ_SOURCE_LINE 00001081 "    if ( $self->distinct() )"
NSQ_SOURCE_LINE 00001082 "    {"
NSQ_SOURCE_LINE 00001083 "        my %seen;"
NSQ_SOURCE_LINE 00001084 "        @{$rows} = map {"
NSQ_SOURCE_LINE 00001085 "            $seen{ join( \"\\0\", ( map { defined($_) ? $_ : '' } @{$_} ) ) }++"
NSQ_SOURCE_LINE 00001086 "              ? ()"
NSQ_SOURCE_LINE 00001087 "              : $_"
NSQ_SOURCE_LINE 00001088 "        } @{$rows};"
NSQ_SOURCE_LINE 00001089 "    }"
NSQ_SOURCE_LINE 00001090 ""
NSQ_SOURCE_LINE 00001091 "    if ( $self->{has_set_functions} )"
NSQ_SOURCE_LINE 00001092 "    {"
NSQ_SOURCE_LINE 00001093 "        my $aggreg;"
NSQ_SOURCE_LINE 00001094 "        if ( $self->{group_by} )"
NSQ_SOURCE_LINE 00001095 "        {"
NSQ_SOURCE_LINE 00001096 "            my @keycols = @{ $self->{colpos} }{ @{ $self->{group_by} } };"
NSQ_SOURCE_LINE 00001097 "            $aggreg = SQL::Statement::Group->new( $self, $rows, \\@keycols );"
NSQ_SOURCE_LINE 00001098 "        }"
NSQ_SOURCE_LINE 00001099 "        else"
NSQ_SOURCE_LINE 00001100 "        {"
NSQ_SOURCE_LINE 00001101 "            $aggreg = SQL::Statement::Aggregate->new( $self, $rows );"
NSQ_SOURCE_LINE 00001102 "        }"
NSQ_SOURCE_LINE 00001103 "        $rows = $aggreg->calc();"
NSQ_SOURCE_LINE 00001104 "        # FIXME re-order if order_by"
NSQ_SOURCE_LINE 00001105 "    }"
NSQ_SOURCE_LINE 00001106 ""
NSQ_SOURCE_LINE 00001107 "    if (@order_by)"
NSQ_SOURCE_LINE 00001108 "    {"
NSQ_SOURCE_LINE 00001109 "        use sort 'stable';"
NSQ_SOURCE_LINE 00001110 "        my @sortCols = map {"
NSQ_SOURCE_LINE 00001111 "            my ( $col, $tbl ) = ( $_->column(), $_->table() );"
NSQ_SOURCE_LINE 00001112 "            $self->{join} and $table->is_shared($col) and $tbl = 'shared';"
NSQ_SOURCE_LINE 00001113 "            $tbl ||= $self->colname2table($col) || '';"
NSQ_SOURCE_LINE 00001114 "            ( $columns{$tbl}->{$col}, $_->desc() )"
NSQ_SOURCE_LINE 00001115 "        } @order_by;"
NSQ_SOURCE_LINE 00001116 ""
NSQ_SOURCE_LINE 00001117 "        $i = scalar(@sortCols);"
NSQ_SOURCE_LINE 00001118 "        do"
NSQ_SOURCE_LINE 00001119 "        {"
NSQ_SOURCE_LINE 00001120 "            my $desc   = $sortCols[ --$i ];"
NSQ_SOURCE_LINE 00001121 "            my $colNum = $sortCols[ --$i ];"
NSQ_SOURCE_LINE 00001122 "            @{$rows} = sort {"
NSQ_SOURCE_LINE 00001123 "                my $result;"
NSQ_SOURCE_LINE 00001124 "                $result = _anycmp( $a->[$colNum], $b->[$colNum] );"
NSQ_SOURCE_LINE 00001125 "                $desc and $result = -$result;"
NSQ_SOURCE_LINE 00001126 "                $result;"
NSQ_SOURCE_LINE 00001127 "            } @{$rows};"
NSQ_SOURCE_LINE 00001128 "        } while ( $i > 0 );"
NSQ_SOURCE_LINE 00001129 "        use sort 'defaults';    # for perl < 5.10.0"
NSQ_SOURCE_LINE 00001130 "    }"
NSQ_SOURCE_LINE 00001131 ""
NSQ_SOURCE_LINE 00001132 "    if ( defined( $self->limit() ) )"
NSQ_SOURCE_LINE 00001133 "    {"
NSQ_SOURCE_LINE 00001134 "        my $offset = $self->offset() || 0;"
NSQ_SOURCE_LINE 00001135 "        my $limit  = $self->limit()  || 0;"
NSQ_SOURCE_LINE 00001136 "        @{$rows} = splice( @{$rows}, $offset, $limit );"
NSQ_SOURCE_LINE 00001137 "    }"
NSQ_SOURCE_LINE 00001138 ""
NSQ_SOURCE_LINE 00001139 "    # Rip off columns that have been added for @extraSortCols only"
NSQ_SOURCE_LINE 00001140 "    if (@extraSortCols)"
NSQ_SOURCE_LINE 00001141 "    {"
NSQ_SOURCE_LINE 00001142 "        foreach my $row ( @{$rows} )"
NSQ_SOURCE_LINE 00001143 "        {"
NSQ_SOURCE_LINE 00001144 "            splice( @{$row}, $numFields, scalar(@extraSortCols) );"
NSQ_SOURCE_LINE 00001145 "        }"
NSQ_SOURCE_LINE 00001146 "    }"
NSQ_SOURCE_LINE 00001147 ""
NSQ_SOURCE_LINE 00001148 "    ( scalar( @{$rows} ), $numFields, $rows );"
NSQ_SOURCE_LINE 00001149 "}"
NSQ_SOURCE_LINE 00001150 ""
NSQ_SOURCE_LINE 00001151 "sub _anycmp($$;$)"
NSQ_SOURCE_LINE 00001152 "{"
NSQ_SOURCE_LINE 00001153 "    my ( $a, $b, $case_fold ) = @_;"
NSQ_SOURCE_LINE 00001154 ""
NSQ_SOURCE_LINE 00001155 "    if ( !defined($a) || !defined($b) )"
NSQ_SOURCE_LINE 00001156 "    {"
NSQ_SOURCE_LINE 00001157 "        return defined($a) - defined($b);"
NSQ_SOURCE_LINE 00001158 "    }"
NSQ_SOURCE_LINE 00001159 "    elsif ( looks_like_number($a) && looks_like_number($b) )"
NSQ_SOURCE_LINE 00001160 "    {"
NSQ_SOURCE_LINE 00001161 "        return $a <=> $b;"
NSQ_SOURCE_LINE 00001162 "    }"
NSQ_SOURCE_LINE 00001163 "    else"
NSQ_SOURCE_LINE 00001164 "    {"
NSQ_SOURCE_LINE 00001165 "        return $case_fold ? lc($a) cmp lc($b) || $a cmp $b : $a cmp $b;"
NSQ_SOURCE_LINE 00001166 "    }"
NSQ_SOURCE_LINE 00001167 "}"
NSQ_SOURCE_LINE 00001168 ""
NSQ_SOURCE_LINE 00001169 "sub eval_where"
NSQ_SOURCE_LINE 00001170 "{"
NSQ_SOURCE_LINE 00001171 "    my ( $self, $eval, $tname, $rowary ) = @_;"
NSQ_SOURCE_LINE 00001172 "    return 1 unless ( defined( $self->{where_terms} ) );"
NSQ_SOURCE_LINE 00001173 "    $self->{argnum} = 0;"
NSQ_SOURCE_LINE 00001174 ""
NSQ_SOURCE_LINE 00001175 "    return $self->{where_terms}->value($eval);"
NSQ_SOURCE_LINE 00001176 "}"
NSQ_SOURCE_LINE 00001177 ""
NSQ_SOURCE_LINE 00001178 "sub fetch_row"
NSQ_SOURCE_LINE 00001179 "{"
NSQ_SOURCE_LINE 00001180 "    my ($self) = @_;"
NSQ_SOURCE_LINE 00001181 "    $self->{data} ||= [];"
NSQ_SOURCE_LINE 00001182 "    my $row = shift @{ $self->{data} };"
NSQ_SOURCE_LINE 00001183 "    return unless $row and scalar @$row;"
NSQ_SOURCE_LINE 00001184 "    return $row;"
NSQ_SOURCE_LINE 00001185 "}"
NSQ_SOURCE_LINE 00001186 ""
NSQ_SOURCE_LINE 00001187 "no warnings 'once';"
NSQ_SOURCE_LINE 00001188 "*fetch = \\&fetch_row;"
NSQ_SOURCE_LINE 00001189 ""
NSQ_SOURCE_LINE 00001190 "use warnings;"
NSQ_SOURCE_LINE 00001191 ""
NSQ_SOURCE_LINE 00001192 "sub fetch_rows"
NSQ_SOURCE_LINE 00001193 "{"
NSQ_SOURCE_LINE 00001194 "    my $self = $_[0];"
NSQ_SOURCE_LINE 00001195 "    my $rows = $self->{data} || [];"
