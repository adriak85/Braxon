NSQ_SOURCE_LINE 00001946 "    # );"
NSQ_SOURCE_LINE 00001947 "    my $tempTable = SQL::Statement::RAM::Table->new( $name, $col_names, \\@data_aryref );"
NSQ_SOURCE_LINE 00001948 "    $tempTable->{all_cols} ||= $col_names;"
