NSQ_SOURCE_LINE 00001995 "package SQL::Statement::Aggregate;"
NSQ_SOURCE_LINE 00001996 ""
NSQ_SOURCE_LINE 00001997 "use Scalar::Util qw(looks_like_number);"
NSQ_SOURCE_LINE 00001998 "use Params::Util qw(_HASH);"
NSQ_SOURCE_LINE 00001999 "use Clone qw(clone);"
NSQ_SOURCE_LINE 00002000 ""
NSQ_SOURCE_LINE 00002001 "sub new"
NSQ_SOURCE_LINE 00002002 "{"
NSQ_SOURCE_LINE 00002003 "    my ( $class, $owner, $rows ) = @_;"
NSQ_SOURCE_LINE 00002004 "    my $self = {"
NSQ_SOURCE_LINE 00002005 "        owner   => $owner,"
NSQ_SOURCE_LINE 00002006 "        records => $rows,"
NSQ_SOURCE_LINE 00002007 "    };"
NSQ_SOURCE_LINE 00002008 "    return bless( $self, $class );"
NSQ_SOURCE_LINE 00002009 "}"
NSQ_SOURCE_LINE 00002010 ""
NSQ_SOURCE_LINE 00002011 "my $empty_agg = {"
NSQ_SOURCE_LINE 00002012 "    uniq  => [],"
NSQ_SOURCE_LINE 00002013 "    count => 0,"
NSQ_SOURCE_LINE 00002014 "    sum   => undef,"
NSQ_SOURCE_LINE 00002015 "    min   => undef,"
NSQ_SOURCE_LINE 00002016 "    max   => undef,"
NSQ_SOURCE_LINE 00002017 "};"
NSQ_SOURCE_LINE 00002018 ""
NSQ_SOURCE_LINE 00002019 "sub do_calc()"
NSQ_SOURCE_LINE 00002020 "{"
NSQ_SOURCE_LINE 00002021 "    my $self = $_[0];"
NSQ_SOURCE_LINE 00002022 ""
NSQ_SOURCE_LINE 00002023 "    foreach my $line ( 0 .. ( scalar( @{ $self->{records} } ) - 1 ) )"
NSQ_SOURCE_LINE 00002024 "    {"
NSQ_SOURCE_LINE 00002025 "        my $row    = $self->{records}->[$line];"
NSQ_SOURCE_LINE 00002026 "        my $result = $self->getAffectedResult($row);"
NSQ_SOURCE_LINE 00002027 ""
NSQ_SOURCE_LINE 00002028 "        foreach my $colidx ( 0 .. ( scalar( @{ $self->{owner}->{columns} } ) - 1 ) )"
NSQ_SOURCE_LINE 00002029 "        {"
NSQ_SOURCE_LINE 00002030 "            my $coldef = $self->{owner}->{columns}->[$colidx]->{coldef};"
NSQ_SOURCE_LINE 00002031 "            my $colval = $row->[$colidx];"
NSQ_SOURCE_LINE 00002032 ""
NSQ_SOURCE_LINE 00002033 "            if ( $coldef->{type} eq 'setfunc' )"
NSQ_SOURCE_LINE 00002034 "            {"
NSQ_SOURCE_LINE 00002035 "                if ( $coldef->{distinct} eq 'DISTINCT' )"
NSQ_SOURCE_LINE 00002036 "                {"
NSQ_SOURCE_LINE 00002037 "                    next if defined( $result->{uniq}->[$colidx]->{$colval} );"
NSQ_SOURCE_LINE 00002038 "                    $result->{uniq}->[$colidx]->{$colval} = 1;"
NSQ_SOURCE_LINE 00002039 "                }"
NSQ_SOURCE_LINE 00002040 ""
NSQ_SOURCE_LINE 00002041 "                $result->{agg}->[$colidx] = clone($empty_agg)"
NSQ_SOURCE_LINE 00002042 "                  unless ( defined( _HASH( $result->{agg}->[$colidx] ) ) );"
NSQ_SOURCE_LINE 00002043 "                my $agg = $result->{agg}->[$colidx];"
NSQ_SOURCE_LINE 00002044 ""
NSQ_SOURCE_LINE 00002045 "                ++$agg->{count};"
NSQ_SOURCE_LINE 00002046 "                unless ( defined( $agg->{max} )"
NSQ_SOURCE_LINE 00002047 "                    && ( SQL::Statement::_anycmp( $colval, $agg->{max} ) < 0 ) )"
NSQ_SOURCE_LINE 00002048 "                {"
NSQ_SOURCE_LINE 00002049 "                    $agg->{max} = $colval;"
NSQ_SOURCE_LINE 00002050 "                }"
NSQ_SOURCE_LINE 00002051 "                unless ( defined( $agg->{min} )"
NSQ_SOURCE_LINE 00002052 "                    && ( SQL::Statement::_anycmp( $colval, $agg->{min} ) > 0 ) )"
NSQ_SOURCE_LINE 00002053 "                {"
NSQ_SOURCE_LINE 00002054 "                    $agg->{min} = $colval;"
NSQ_SOURCE_LINE 00002055 "                }"
NSQ_SOURCE_LINE 00002056 "                $agg->{sum} += $colval if ( looks_like_number($colval) );"
NSQ_SOURCE_LINE 00002057 "            }"
NSQ_SOURCE_LINE 00002058 "            else"
NSQ_SOURCE_LINE 00002059 "            {"
NSQ_SOURCE_LINE 00002060 "                $result->{pure}->[$colidx] = $colval"
NSQ_SOURCE_LINE 00002061 "                  unless ( defined( $result->{pure}->[$colidx] ) );"
NSQ_SOURCE_LINE 00002062 "            }"
NSQ_SOURCE_LINE 00002063 "        }"
NSQ_SOURCE_LINE 00002064 "    }"
NSQ_SOURCE_LINE 00002065 "}"
NSQ_SOURCE_LINE 00002066 ""
NSQ_SOURCE_LINE 00002067 "sub build_row    # (\\%)"
NSQ_SOURCE_LINE 00002068 "{"
NSQ_SOURCE_LINE 00002069 "    my ( $self, $result ) = @_;"
NSQ_SOURCE_LINE 00002070 "    my @row;"
NSQ_SOURCE_LINE 00002071 ""
NSQ_SOURCE_LINE 00002072 "    foreach my $colidx ( 0 .. ( scalar( @{ $self->{owner}->{columns} } ) - 1 ) )"
NSQ_SOURCE_LINE 00002073 "    {"
NSQ_SOURCE_LINE 00002074 "        my $coldef = $self->{owner}->{columns}->[$colidx]->{coldef};"
NSQ_SOURCE_LINE 00002075 ""
NSQ_SOURCE_LINE 00002076 "        if ( $coldef->{type} eq 'setfunc' )"
NSQ_SOURCE_LINE 00002077 "        {"
NSQ_SOURCE_LINE 00002078 "            if ( $coldef->{name} eq 'COUNT' )"
NSQ_SOURCE_LINE 00002079 "            {"
NSQ_SOURCE_LINE 00002080 "                push( @row, $result->{agg}->[$colidx]->{count} || 0 );"
NSQ_SOURCE_LINE 00002081 "            }"
NSQ_SOURCE_LINE 00002082 "            elsif ( $coldef->{name} eq 'MAX' )"
NSQ_SOURCE_LINE 00002083 "            {"
NSQ_SOURCE_LINE 00002084 "                push( @row, $result->{agg}->[$colidx]->{max} );"
NSQ_SOURCE_LINE 00002085 "            }"
NSQ_SOURCE_LINE 00002086 "            elsif ( $coldef->{name} eq 'MIN' )"
NSQ_SOURCE_LINE 00002087 "            {"
NSQ_SOURCE_LINE 00002088 "                push( @row, $result->{agg}->[$colidx]->{min} );"
NSQ_SOURCE_LINE 00002089 "            }"
NSQ_SOURCE_LINE 00002090 "            elsif ( $coldef->{name} eq 'SUM' )"
NSQ_SOURCE_LINE 00002091 "            {"
NSQ_SOURCE_LINE 00002092 "                push( @row, $result->{agg}->[$colidx]->{sum} );"
NSQ_SOURCE_LINE 00002093 "            }"
NSQ_SOURCE_LINE 00002094 "            elsif ( $coldef->{name} eq 'AVG' )"
NSQ_SOURCE_LINE 00002095 "            {"
NSQ_SOURCE_LINE 00002096 "                my $count = $result->{agg}->[$colidx]->{count};"
NSQ_SOURCE_LINE 00002097 "                my $sum   = $result->{agg}->[$colidx]->{sum};"
NSQ_SOURCE_LINE 00002098 "                my $avg   = $sum / $count if ( $count && $sum );"
NSQ_SOURCE_LINE 00002099 "                push( @row, $avg );"
NSQ_SOURCE_LINE 00002100 "            }"
NSQ_SOURCE_LINE 00002101 "            else"
NSQ_SOURCE_LINE 00002102 "            {"
NSQ_SOURCE_LINE 00002103 "                return $self->{owner}->do_err(\"Invalid SET FUNCTION '$coldef->{name}'\");"
NSQ_SOURCE_LINE 00002104 "            }"
NSQ_SOURCE_LINE 00002105 "        }"
NSQ_SOURCE_LINE 00002106 "        else"
NSQ_SOURCE_LINE 00002107 "        {"
NSQ_SOURCE_LINE 00002108 "            push( @row, $result->{pure}->[$colidx] );"
NSQ_SOURCE_LINE 00002109 "        }"
NSQ_SOURCE_LINE 00002110 "    }"
NSQ_SOURCE_LINE 00002111 ""
NSQ_SOURCE_LINE 00002112 "    return \\@row;"
NSQ_SOURCE_LINE 00002113 "}"
NSQ_SOURCE_LINE 00002114 ""
NSQ_SOURCE_LINE 00002115 "sub calc()"
NSQ_SOURCE_LINE 00002116 "{"
NSQ_SOURCE_LINE 00002117 "    my $self = $_[0];"
NSQ_SOURCE_LINE 00002118 ""
NSQ_SOURCE_LINE 00002119 "    $self->{final_row} = {};"
NSQ_SOURCE_LINE 00002120 ""
NSQ_SOURCE_LINE 00002121 "    $self->do_calc();"
NSQ_SOURCE_LINE 00002122 ""
NSQ_SOURCE_LINE 00002123 "    my $final_row = $self->build_row( $self->{final_row} );"
NSQ_SOURCE_LINE 00002124 ""
NSQ_SOURCE_LINE 00002125 "    return [$final_row];"
NSQ_SOURCE_LINE 00002126 "}"
NSQ_SOURCE_LINE 00002127 ""
NSQ_SOURCE_LINE 00002128 "sub getAffectedResult    # (\\@)"
NSQ_SOURCE_LINE 00002129 "{"
NSQ_SOURCE_LINE 00002130 "    return $_[0]->{final_row};"
NSQ_SOURCE_LINE 00002131 "}"
NSQ_SOURCE_LINE 00002132 ""
NSQ_SOURCE_LINE 00002133 "package SQL::Statement::Group;"
NSQ_SOURCE_LINE 00002134 ""
NSQ_SOURCE_LINE 00002135 "use vars qw(@ISA);"
NSQ_SOURCE_LINE 00002136 ""
NSQ_SOURCE_LINE 00002137 "use Params::Util qw(_HASH);"
NSQ_SOURCE_LINE 00002138 ""
NSQ_SOURCE_LINE 00002139 "@ISA = qw(SQL::Statement::Aggregate);"
NSQ_SOURCE_LINE 00002140 ""
NSQ_SOURCE_LINE 00002141 "sub new"
NSQ_SOURCE_LINE 00002142 "{"
NSQ_SOURCE_LINE 00002143 "    my ( $class, $owner, $rows, $keycols ) = @_;"
NSQ_SOURCE_LINE 00002144 ""
NSQ_SOURCE_LINE 00002145 "    my $self = $class->SUPER::new( $owner, $rows );"
NSQ_SOURCE_LINE 00002146 "    $self->{keycols} = $keycols;"
NSQ_SOURCE_LINE 00002147 ""
NSQ_SOURCE_LINE 00002148 "    return $self;"
NSQ_SOURCE_LINE 00002149 "}"
NSQ_SOURCE_LINE 00002150 ""
NSQ_SOURCE_LINE 00002151 "sub calc()"
NSQ_SOURCE_LINE 00002152 "{"
NSQ_SOURCE_LINE 00002153 "    my $self = $_[0];"
NSQ_SOURCE_LINE 00002154 "    my @final_table;"
NSQ_SOURCE_LINE 00002155 ""
NSQ_SOURCE_LINE 00002156 "    $self->do_calc();"
NSQ_SOURCE_LINE 00002157 ""
NSQ_SOURCE_LINE 00002158 "    if ( scalar( keys( %{ $self->{final_rows} } ) ) )"
NSQ_SOURCE_LINE 00002159 "    {"
NSQ_SOURCE_LINE 00002160 "        foreach my $key ( keys( %{ $self->{final_rows} } ) )"
NSQ_SOURCE_LINE 00002161 "        {"
NSQ_SOURCE_LINE 00002162 "            my $final_row = $self->build_row( $self->{final_rows}->{$key} );"
NSQ_SOURCE_LINE 00002163 "            push( @final_table, $final_row );"
NSQ_SOURCE_LINE 00002164 "        }"
NSQ_SOURCE_LINE 00002165 "    }"
NSQ_SOURCE_LINE 00002166 "    else"
NSQ_SOURCE_LINE 00002167 "    {"
NSQ_SOURCE_LINE 00002168 "        my $final_row = $self->build_row( {} );"
NSQ_SOURCE_LINE 00002169 "        push( @final_table, $final_row );"
NSQ_SOURCE_LINE 00002170 "    }"
NSQ_SOURCE_LINE 00002171 ""
NSQ_SOURCE_LINE 00002172 "    return \\@final_table;"
NSQ_SOURCE_LINE 00002173 "}"
NSQ_SOURCE_LINE 00002174 ""
NSQ_SOURCE_LINE 00002175 "sub getAffectedResult    # (\\@)"
NSQ_SOURCE_LINE 00002176 "{"
NSQ_SOURCE_LINE 00002177 "    my ( $self, $row ) = @_;"
NSQ_SOURCE_LINE 00002178 ""
NSQ_SOURCE_LINE 00002179 "    my $rowkey = join( \"\\0\", @$row[ @{ $self->{keycols} } ] );"
NSQ_SOURCE_LINE 00002180 ""
NSQ_SOURCE_LINE 00002181 "    $self->{final_rows}->{$rowkey} = {}"
NSQ_SOURCE_LINE 00002182 "      unless ( defined( _HASH( $self->{final_rows}->{$rowkey} ) ) );"
NSQ_SOURCE_LINE 00002183 ""
NSQ_SOURCE_LINE 00002184 "    return $self->{final_rows}->{$rowkey};"
NSQ_SOURCE_LINE 00002185 "}"
NSQ_SOURCE_LINE 00002186 ""
NSQ_SOURCE_LINE 00002187 "package SQL::Statement::TempTable;"
NSQ_SOURCE_LINE 00002188 ""
NSQ_SOURCE_LINE 00002189 "use vars qw(@ISA);"
NSQ_SOURCE_LINE 00002190 ""
NSQ_SOURCE_LINE 00002191 "BEGIN"
NSQ_SOURCE_LINE 00002192 "{"
NSQ_SOURCE_LINE 00002193 "    require SQL::Eval;"
NSQ_SOURCE_LINE 00002194 ""
NSQ_SOURCE_LINE 00002195 "    @SQL::Statement::TempTable::ISA = qw(SQL::Eval::Table);"
NSQ_SOURCE_LINE 00002196 "}"
NSQ_SOURCE_LINE 00002197 ""
NSQ_SOURCE_LINE 00002198 "sub new"
NSQ_SOURCE_LINE 00002199 "{"
NSQ_SOURCE_LINE 00002200 "    my ( $class, $name, $col_names, $table_cols, $table ) = @_;"
NSQ_SOURCE_LINE 00002201 "    my %col_nums;"
NSQ_SOURCE_LINE 00002202 "    $col_nums{ $col_names->[$_] } = $_ for ( 0 .. scalar @$col_names - 1 );"
NSQ_SOURCE_LINE 00002203 "    my @display_order = @col_nums{@$table_cols};"
NSQ_SOURCE_LINE 00002204 "    my $self          = {"
NSQ_SOURCE_LINE 00002205 "        col_names  => $col_names,"
NSQ_SOURCE_LINE 00002206 "        table_cols => \\@display_order,"
NSQ_SOURCE_LINE 00002207 "        col_nums   => \\%col_nums,"
NSQ_SOURCE_LINE 00002208 "        table      => $table,"
NSQ_SOURCE_LINE 00002209 "        NAME       => $name,"
NSQ_SOURCE_LINE 00002210 "        rowpos     => 0,"
NSQ_SOURCE_LINE 00002211 "        maxrow     => scalar @$table"
NSQ_SOURCE_LINE 00002212 "    };"
NSQ_SOURCE_LINE 00002213 "    return $class->SUPER::new($self);"
NSQ_SOURCE_LINE 00002214 "}"
NSQ_SOURCE_LINE 00002215 ""
NSQ_SOURCE_LINE 00002216 "sub is_shared($) { $_[0]->{is_shared}->{ $_[1] }; }"
NSQ_SOURCE_LINE 00002217 "sub get_pos()    { $_[0]->{rowpos} }"
NSQ_SOURCE_LINE 00002218 ""
NSQ_SOURCE_LINE 00002219 "sub column_num($)"
NSQ_SOURCE_LINE 00002220 "{"
NSQ_SOURCE_LINE 00002221 "    my ( $s, $col ) = @_;"
NSQ_SOURCE_LINE 00002222 "    my $new_col = $s->{col_nums}->{$col};"
NSQ_SOURCE_LINE 00002223 "    unless ( defined($new_col) )"
NSQ_SOURCE_LINE 00002224 "    {"
NSQ_SOURCE_LINE 00002225 "        my @tmp = split( '~', $col );"
NSQ_SOURCE_LINE 00002226 "        return unless ( 2 == scalar(@tmp) );"
NSQ_SOURCE_LINE 00002227 "        $new_col = lc( $tmp[0] ) . '~' . $tmp[1];"
NSQ_SOURCE_LINE 00002228 "        $new_col = $s->{col_nums}->{$new_col};"
NSQ_SOURCE_LINE 00002229 "    }"
NSQ_SOURCE_LINE 00002230 "    return $new_col;"
NSQ_SOURCE_LINE 00002231 "}"
NSQ_SOURCE_LINE 00002232 ""
NSQ_SOURCE_LINE 00002233 "sub fetch_row()"
NSQ_SOURCE_LINE 00002234 "{"
NSQ_SOURCE_LINE 00002235 "    return $_[0]->{row} ="
NSQ_SOURCE_LINE 00002236 "      ( $_[0]->{rowpos} >= $_[0]->{maxrow} )"
NSQ_SOURCE_LINE 00002237 "      ? undef"
NSQ_SOURCE_LINE 00002238 "      : $_[0]->{table}->[ $_[0]->{rowpos}++ ];"
NSQ_SOURCE_LINE 00002239 "}"
NSQ_SOURCE_LINE 00002240 ""
NSQ_SOURCE_LINE 00002241 "sub column($) { return $_[0]->{row}->[ $_[0]->{col_nums}->{ $_[1] } ]; }"
NSQ_SOURCE_LINE 00002242 ""
NSQ_SOURCE_LINE 00002243 "package SQL::Statement::Order;"
NSQ_SOURCE_LINE 00002244 ""
NSQ_SOURCE_LINE 00002245 "sub new ($$)"
NSQ_SOURCE_LINE 00002246 "{"
NSQ_SOURCE_LINE 00002247 "    my $proto = shift;"
NSQ_SOURCE_LINE 00002248 "    my $self  = {@_};"
NSQ_SOURCE_LINE 00002249 "    bless( $self, ( ref($proto) || $proto ) );"
NSQ_SOURCE_LINE 00002250 "}"
NSQ_SOURCE_LINE 00002251 "sub table ($)     { $_[0]->{col}->table(); }"
NSQ_SOURCE_LINE 00002252 "sub column ($)    { $_[0]->{col}->display_name(); }"
NSQ_SOURCE_LINE 00002253 "sub desc ($)      { $_[0]->{desc}; }"
NSQ_SOURCE_LINE 00002254 "sub direction ($) { $_[0]->{direction}; }"
NSQ_SOURCE_LINE 00002255 ""
NSQ_SOURCE_LINE 00002256 "package SQL::Statement::Limit;"
NSQ_SOURCE_LINE 00002257 ""
NSQ_SOURCE_LINE 00002258 "sub new ($$)"
NSQ_SOURCE_LINE 00002259 "{"
NSQ_SOURCE_LINE 00002260 "    my ( $proto, $self ) = @_;"
NSQ_SOURCE_LINE 00002261 "    bless( $self, ( ref($proto) || $proto ) );"
NSQ_SOURCE_LINE 00002262 "}"
NSQ_SOURCE_LINE 00002263 ""
NSQ_SOURCE_LINE 00002264 "#sub limit ($) { shift->{limit}; }"
NSQ_SOURCE_LINE 00002265 "#sub offset ($) { shift->{offset}; }"
NSQ_SOURCE_LINE 00002266 ""
NSQ_SOURCE_LINE 00002267 "package SQL::Statement::Param;"
NSQ_SOURCE_LINE 00002268 ""
NSQ_SOURCE_LINE 00002269 "sub new"
NSQ_SOURCE_LINE 00002270 "{"
NSQ_SOURCE_LINE 00002271 "    my ( $class, $idx ) = @_;"
NSQ_SOURCE_LINE 00002272 "    my $self = { 'idx' => $idx };"
NSQ_SOURCE_LINE 00002273 "    return bless( $self, $class );"
NSQ_SOURCE_LINE 00002274 "}"
NSQ_SOURCE_LINE 00002275 ""
NSQ_SOURCE_LINE 00002276 "sub idx ($) { $_[0]->{idx}; }"
NSQ_SOURCE_LINE 00002277 ""
NSQ_SOURCE_LINE 00002278 "package SQL::Statement::Table;"
NSQ_SOURCE_LINE 00002279 ""
NSQ_SOURCE_LINE 00002280 "sub new"
NSQ_SOURCE_LINE 00002281 "{"
NSQ_SOURCE_LINE 00002282 "    my ( $class, $table_name ) = @_;"
NSQ_SOURCE_LINE 00002283 ""
NSQ_SOURCE_LINE 00002284 "    if ( $table_name !~ m/\"/ )"
NSQ_SOURCE_LINE 00002285 "    {"
NSQ_SOURCE_LINE 00002286 "        $table_name = lc $table_name;"
NSQ_SOURCE_LINE 00002287 "    }"
NSQ_SOURCE_LINE 00002288 ""
NSQ_SOURCE_LINE 00002289 "    my $self = {"
NSQ_SOURCE_LINE 00002290 "        name => $table_name,"
NSQ_SOURCE_LINE 00002291 "    };"
NSQ_SOURCE_LINE 00002292 ""
NSQ_SOURCE_LINE 00002293 "    return bless( $self, $class );"
NSQ_SOURCE_LINE 00002294 "}"
NSQ_SOURCE_LINE 00002295 ""
NSQ_SOURCE_LINE 00002296 "sub name { $_[0]->{name} }"
NSQ_SOURCE_LINE 00002297 ""
NSQ_SOURCE_LINE 00002298 "1;"
NSQ_SOURCE_LINE 00002299 "__END__"
NSQ_SOURCE_LINE 00002300 ""
NSQ_SOURCE_LINE 00002301 "=pod"
NSQ_SOURCE_LINE 00002302 ""
NSQ_SOURCE_LINE 00002303 "=head1 NAME"
NSQ_SOURCE_LINE 00002304 ""
NSQ_SOURCE_LINE 00002305 "SQL::Statement - SQL parsing and processing engine"
NSQ_SOURCE_LINE 00002306 ""
NSQ_SOURCE_LINE 00002307 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00002308 ""
NSQ_SOURCE_LINE 00002309 "  # ... depends on what you want to do, see below"
NSQ_SOURCE_LINE 00002310 ""
NSQ_SOURCE_LINE 00002311 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00002312 ""
NSQ_SOURCE_LINE 00002313 "The SQL::Statement module implements a pure Perl SQL parsing and execution"
NSQ_SOURCE_LINE 00002314 "engine. While it by no means implements full ANSI standard, it does support"
NSQ_SOURCE_LINE 00002315 "many features including column and table aliases, built-in and user-defined"
NSQ_SOURCE_LINE 00002316 "functions, implicit and explicit joins, complex nested search conditions,"
NSQ_SOURCE_LINE 00002317 "and other features."
NSQ_SOURCE_LINE 00002318 ""
NSQ_SOURCE_LINE 00002319 "SQL::Statement is a small embeddable Database Management System"
NSQ_SOURCE_LINE 00002320 "(DBMS). This means that it provides all of the services of a simple"
NSQ_SOURCE_LINE 00002321 "DBMS except that instead of a persistent storage mechanism, it has two"
NSQ_SOURCE_LINE 00002322 "things: 1) an in-memory storage mechanism that allows you to prepare,"
NSQ_SOURCE_LINE 00002323 "execute, and fetch from SQL statements using temporary tables and 2) a"
NSQ_SOURCE_LINE 00002324 "set of software sockets where any author can plug in any storage"
NSQ_SOURCE_LINE 00002325 "mechanism."
NSQ_SOURCE_LINE 00002326 ""
NSQ_SOURCE_LINE 00002327 "There are three main uses for SQL::Statement. One or another (hopefully not"
NSQ_SOURCE_LINE 00002328 "all) may be irrelevant for your needs: 1) to access and manipulate data in"
NSQ_SOURCE_LINE 00002329 "CSV, XML, and other formats 2) to build your own DBD for a new data source"
NSQ_SOURCE_LINE 00002330 "3) to parse and examine the structure of SQL statements."
NSQ_SOURCE_LINE 00002331 ""
NSQ_SOURCE_LINE 00002332 "=head1 INSTALLATION"
NSQ_SOURCE_LINE 00002333 ""
NSQ_SOURCE_LINE 00002334 "There are no prerequisites for using this as a standalone parser. If"
NSQ_SOURCE_LINE 00002335 "you want to access persistent stored data, you either need to write a"
NSQ_SOURCE_LINE 00002336 "subclass or use one of the DBI DBD drivers.  You can install this"
NSQ_SOURCE_LINE 00002337 "module using CPAN.pm, CPANPLUS.pm, PPM, apt-get, or other packaging"
NSQ_SOURCE_LINE 00002338 "tools or you can download the tar.gz file from CPAN and use the"
NSQ_SOURCE_LINE 00002339 "standard perl mantra:"
NSQ_SOURCE_LINE 00002340 ""
NSQ_SOURCE_LINE 00002341 "  perl Makefile.PL"
NSQ_SOURCE_LINE 00002342 "  make"
NSQ_SOURCE_LINE 00002343 "  make test"
NSQ_SOURCE_LINE 00002344 "  make install"
NSQ_SOURCE_LINE 00002345 ""
NSQ_SOURCE_LINE 00002346 "It works fine on all platforms it has been tested on. On Windows, you"
NSQ_SOURCE_LINE 00002347 "can use ppm or with the mantra use nmake, dmake, or make depending on"
NSQ_SOURCE_LINE 00002348 "which is available."
NSQ_SOURCE_LINE 00002349 ""
NSQ_SOURCE_LINE 00002350 "=head1 USAGE"
NSQ_SOURCE_LINE 00002351 ""
NSQ_SOURCE_LINE 00002352 "=head2 How can I use SQL::Statement to access and modify data?"
NSQ_SOURCE_LINE 00002353 ""
NSQ_SOURCE_LINE 00002354 "SQL::Statement provides the SQL engine for a number of existing DBI drivers"
NSQ_SOURCE_LINE 00002355 "including L<DBD::CSV>, L<DBD::DBM>, L<DBD::AnyData>, L<DBD::Excel>,"
NSQ_SOURCE_LINE 00002356 "L<DBD::Amazon>, and others."
NSQ_SOURCE_LINE 00002357 ""
NSQ_SOURCE_LINE 00002358 "These modules provide access to Comma Separated Values, Fixed Length, XML,"
NSQ_SOURCE_LINE 00002359 "HTML and many other kinds of text files, to Excel Spreadsheets, to BerkeleyDB"
NSQ_SOURCE_LINE 00002360 "and other DBM formats, and to non-traditional data sources like on-the-fly"
NSQ_SOURCE_LINE 00002361 "Amazon searches."
NSQ_SOURCE_LINE 00002362 ""
NSQ_SOURCE_LINE 00002363 "If you are interested in accessing and manipulating persistent data, you may"
NSQ_SOURCE_LINE 00002364 "not really want to use SQL::Statement directly, but use L<DBI> along with"
NSQ_SOURCE_LINE 00002365 "one of the DBDs mentioned above instead. You will be using SQL::Statement, but"
NSQ_SOURCE_LINE 00002366 "under the hood of the DBD. See L<http://dbi.perl.org> for help with DBI and"
NSQ_SOURCE_LINE 00002367 "see L<SQL::Statement::Syntax> for a description of the SQL syntax that"
NSQ_SOURCE_LINE 00002368 "SQL::Statement provides for these modules and see the documentation for"
NSQ_SOURCE_LINE 00002369 "whichever DBD you are using for additional details."
NSQ_SOURCE_LINE 00002370 ""
NSQ_SOURCE_LINE 00002371 "=head2 How can I use it to parse and examine the structure of SQL statements?"
NSQ_SOURCE_LINE 00002372 ""
NSQ_SOURCE_LINE 00002373 "SQL::Statement can be used stand-alone (without a subclass and without"
NSQ_SOURCE_LINE 00002374 "DBI) to parse and examine the structure of SQL statements.  See"
NSQ_SOURCE_LINE 00002375 "L<SQL::Statement::Structure> for details."
NSQ_SOURCE_LINE 00002376 ""
NSQ_SOURCE_LINE 00002377 "=head2 How can I use it to embed a SQL engine in a DBD or other module?"
NSQ_SOURCE_LINE 00002378 ""
NSQ_SOURCE_LINE 00002379 "SQL::Statement is designed to be easily embedded in other modules and is"
NSQ_SOURCE_LINE 00002380 "especially suited for developing new DBI drivers (DBDs)."
NSQ_SOURCE_LINE 00002381 "See L<SQL::Statement::Embed>."
NSQ_SOURCE_LINE 00002382 ""
NSQ_SOURCE_LINE 00002383 "=head2 What SQL Syntax is supported?"
NSQ_SOURCE_LINE 00002384 ""
NSQ_SOURCE_LINE 00002385 "SQL::Statement supports a small but powerful subset of SQL commands."
NSQ_SOURCE_LINE 00002386 "See L<SQL::Statement::Syntax>."
NSQ_SOURCE_LINE 00002387 ""
NSQ_SOURCE_LINE 00002388 "=head2 How can I extend the supported SQL syntax?"
NSQ_SOURCE_LINE 00002389 ""
NSQ_SOURCE_LINE 00002390 "You can modify and extend the SQL syntax either by issuing SQL commands or"
NSQ_SOURCE_LINE 00002391 "by subclassing SQL::Statement.  See L<SQL::Statement::Syntax>."
NSQ_SOURCE_LINE 00002392 ""
NSQ_SOURCE_LINE 00002393 "=head1 How can I participate in ongoing development?"
NSQ_SOURCE_LINE 00002394 ""
NSQ_SOURCE_LINE 00002395 "SQL::Statement is a large module with many potential future directions."
NSQ_SOURCE_LINE 00002396 "You are invited to help plan, code, test, document, or kibbitz about these"
NSQ_SOURCE_LINE 00002397 "directions. If you want to join the development team, or just hear more"
NSQ_SOURCE_LINE 00002398 "about the development, write Jeff (<jzuckerATcpan.org>) or Jens"
NSQ_SOURCE_LINE 00002399 "(<rehsackATcpan.org>) a note."
NSQ_SOURCE_LINE 00002400 ""
NSQ_SOURCE_LINE 00002401 "=head1 METHODS"
NSQ_SOURCE_LINE 00002402 ""
NSQ_SOURCE_LINE 00002403 "The following methods can or must be overridden by derived classes."
NSQ_SOURCE_LINE 00002404 ""
NSQ_SOURCE_LINE 00002405 "=head2 capability"
NSQ_SOURCE_LINE 00002406 ""
NSQ_SOURCE_LINE 00002407 "  $has_capability = $h->capability('capability_name');"
NSQ_SOURCE_LINE 00002408 ""
NSQ_SOURCE_LINE 00002409 "Returns a true value if the specified capability is available."
NSQ_SOURCE_LINE 00002410 ""
NSQ_SOURCE_LINE 00002411 "Currently no capabilities are defined and this is a placeholder for"
NSQ_SOURCE_LINE 00002412 "future use. It is envisioned it will be used like C<<"
NSQ_SOURCE_LINE 00002413 "SQL::Eval::Table::capability >>."
NSQ_SOURCE_LINE 00002414 ""
NSQ_SOURCE_LINE 00002415 "=head2 open_table"
NSQ_SOURCE_LINE 00002416 ""
NSQ_SOURCE_LINE 00002417 "The C<< open_table >> method must be overridden by derived classes to provide"
NSQ_SOURCE_LINE 00002418 "the capability of opening data tables. This is a necessity."
NSQ_SOURCE_LINE 00002419 ""
NSQ_SOURCE_LINE 00002420 "Arguments given to open_table call:"
NSQ_SOURCE_LINE 00002421 ""
NSQ_SOURCE_LINE 00002422 "=over 4"
NSQ_SOURCE_LINE 00002423 ""
NSQ_SOURCE_LINE 00002424 "=item C<< $data >>"
NSQ_SOURCE_LINE 00002425 ""
NSQ_SOURCE_LINE 00002426 "The database memo parameter. See L</execute>."
NSQ_SOURCE_LINE 00002427 ""
NSQ_SOURCE_LINE 00002428 "=item C<< $table >>"
NSQ_SOURCE_LINE 00002429 ""
NSQ_SOURCE_LINE 00002430 "The name of the table to open as parsed from SQL statement."
NSQ_SOURCE_LINE 00002431 ""
NSQ_SOURCE_LINE 00002432 "=item C<< $createMode >>"
NSQ_SOURCE_LINE 00002433 ""
NSQ_SOURCE_LINE 00002434 "A flag indicating the mode (C<< CREATE TABLE ... >>) the table should"
NSQ_SOURCE_LINE 00002435 "be opened with. Set to a true value in create mode."
NSQ_SOURCE_LINE 00002436 ""
NSQ_SOURCE_LINE 00002437 "=item C<< $lockMode >>"
NSQ_SOURCE_LINE 00002438 ""
NSQ_SOURCE_LINE 00002439 "A flag indicating whether the table should be opened for writing (any"
NSQ_SOURCE_LINE 00002440 "other than C<< SELECT ... >>).  Set to a true value if the table is to"
NSQ_SOURCE_LINE 00002441 "be opened for write access."
NSQ_SOURCE_LINE 00002442 ""
NSQ_SOURCE_LINE 00002443 "=back"
NSQ_SOURCE_LINE 00002444 ""
NSQ_SOURCE_LINE 00002445 "The following methods are required to use SQL::Statement in a DBD (for"
NSQ_SOURCE_LINE 00002446 "example)."
NSQ_SOURCE_LINE 00002447 ""
NSQ_SOURCE_LINE 00002448 "=head2 new"
NSQ_SOURCE_LINE 00002449 ""
NSQ_SOURCE_LINE 00002450 "Instantiates a new SQL::Statement object."
NSQ_SOURCE_LINE 00002451 ""
NSQ_SOURCE_LINE 00002452 "Arguments:"
NSQ_SOURCE_LINE 00002453 ""
NSQ_SOURCE_LINE 00002454 "=over 4"
NSQ_SOURCE_LINE 00002455 ""
NSQ_SOURCE_LINE 00002456 "=item C<< $sql >>"
NSQ_SOURCE_LINE 00002457 ""
NSQ_SOURCE_LINE 00002458 "The SQL statement for later actions."
NSQ_SOURCE_LINE 00002459 ""
NSQ_SOURCE_LINE 00002460 "=item C<< $parser >>"
NSQ_SOURCE_LINE 00002461 ""
NSQ_SOURCE_LINE 00002462 "An instance of a L<SQL::Parser> object or flags for it's instantiation."
NSQ_SOURCE_LINE 00002463 "If omitted, default flags are used."
NSQ_SOURCE_LINE 00002464 ""
NSQ_SOURCE_LINE 00002465 "=back"
NSQ_SOURCE_LINE 00002466 ""
NSQ_SOURCE_LINE 00002467 "When the basic initialization is completed,"
NSQ_SOURCE_LINE 00002468 "C<< $self->prepare($sql, $parser) >> is invoked."
NSQ_SOURCE_LINE 00002469 ""
NSQ_SOURCE_LINE 00002470 "=head2 prepare"
NSQ_SOURCE_LINE 00002471 ""
NSQ_SOURCE_LINE 00002472 "Prepares SQL::Statement to execute a SQL statement."
NSQ_SOURCE_LINE 00002473 ""
NSQ_SOURCE_LINE 00002474 "Arguments:"
NSQ_SOURCE_LINE 00002475 ""
NSQ_SOURCE_LINE 00002476 "=over 4"
NSQ_SOURCE_LINE 00002477 ""
NSQ_SOURCE_LINE 00002478 "=item C<< $sql >>"
NSQ_SOURCE_LINE 00002479 ""
NSQ_SOURCE_LINE 00002480 "The SQL statement to parse and prepare."
NSQ_SOURCE_LINE 00002481 ""
NSQ_SOURCE_LINE 00002482 "=item C<< $parser >>"
NSQ_SOURCE_LINE 00002483 ""
NSQ_SOURCE_LINE 00002484 "Instance of a L<SQL::Parser> object to parse the provided SQL statement."
NSQ_SOURCE_LINE 00002485 ""
NSQ_SOURCE_LINE 00002486 "=back"
NSQ_SOURCE_LINE 00002487 ""
NSQ_SOURCE_LINE 00002488 "=head2 execute"
NSQ_SOURCE_LINE 00002489 ""
NSQ_SOURCE_LINE 00002490 "Executes a prepared statement."
NSQ_SOURCE_LINE 00002491 ""
NSQ_SOURCE_LINE 00002492 "Arguments:"
NSQ_SOURCE_LINE 00002493 ""
NSQ_SOURCE_LINE 00002494 "=over 4"
NSQ_SOURCE_LINE 00002495 ""
NSQ_SOURCE_LINE 00002496 "=item C<< $data >>"
NSQ_SOURCE_LINE 00002497 ""
NSQ_SOURCE_LINE 00002498 "Memo field passed through to calls of the instantiated C<< $table >>"
NSQ_SOURCE_LINE 00002499 "objects or C<< open_table >> calls. In C<< CREATE >> with subquery,"
NSQ_SOURCE_LINE 00002500 "C<< $data->{Database} >> must be a DBI database handle object."
NSQ_SOURCE_LINE 00002501 ""
NSQ_SOURCE_LINE 00002502 "=item C<< $params >>"
NSQ_SOURCE_LINE 00002503 ""
NSQ_SOURCE_LINE 00002504 "Bound params via DBI ..."
NSQ_SOURCE_LINE 00002505 ""
NSQ_SOURCE_LINE 00002506 "=back"
NSQ_SOURCE_LINE 00002507 ""
NSQ_SOURCE_LINE 00002508 "=head2 errstr"
NSQ_SOURCE_LINE 00002509 ""
NSQ_SOURCE_LINE 00002510 "Gives the error string of the last error, if any."
NSQ_SOURCE_LINE 00002511 ""
NSQ_SOURCE_LINE 00002512 "=head2 fetch_row"
NSQ_SOURCE_LINE 00002513 ""
NSQ_SOURCE_LINE 00002514 "Fetches the next row from the result data set (implies removing the fetched"
NSQ_SOURCE_LINE 00002515 "row from the result data set)."
NSQ_SOURCE_LINE 00002516 ""
NSQ_SOURCE_LINE 00002517 "=head2 fetch_rows"
NSQ_SOURCE_LINE 00002518 ""
NSQ_SOURCE_LINE 00002519 "Fetches all (remaining) rows from the result data set."
NSQ_SOURCE_LINE 00002520 ""
