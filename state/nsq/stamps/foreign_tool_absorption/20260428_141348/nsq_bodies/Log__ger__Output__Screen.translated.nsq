BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Log::ger::Output::Screen;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000007 "our $DATE = '2022-01-16'; # DATE"
NSQ_SOURCE_LINE 00000008 "our $DIST = 'Log-ger-Output-Screen'; # DIST"
NSQ_SOURCE_LINE 00000009 "our $VERSION = '0.019'; # VERSION"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "if ($^O eq 'MSWin32') {"
NSQ_SOURCE_LINE 00000012 "    eval { require Win32::Console::ANSI };"
NSQ_SOURCE_LINE 00000013 "}"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "use Log::ger::Util;"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "our %colors_16 = ("
NSQ_SOURCE_LINE 00000018 "    10 => \"\\e[31m\"  , # fatal  , red"
NSQ_SOURCE_LINE 00000019 "    20 => \"\\e[35m\"  , # error  , magenta"
NSQ_SOURCE_LINE 00000020 "    30 => \"\\e[1;34m\", # warning, light blue"
NSQ_SOURCE_LINE 00000021 "    40 => \"\\e[32m\"  , # info   , green"
NSQ_SOURCE_LINE 00000022 "    50 => \"\",         # debug  , no color"
NSQ_SOURCE_LINE 00000023 "    60 => \"\\e[33m\"  , # trace  , orange"
NSQ_SOURCE_LINE 00000024 ");"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "our %colors_256 = ("
NSQ_SOURCE_LINE 00000027 "    # pastel'ish, all brighter and avoid pure red/blue which is hard to see on"
NSQ_SOURCE_LINE 00000028 "    # laptop screen in a bright environment"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "    10 => \"\\e[1;38;5;160m\", # fatal  , bright red3"
NSQ_SOURCE_LINE 00000031 "    20 => \"\\e[1;38;5;163m\", # error  , bright magenta3"
NSQ_SOURCE_LINE 00000032 "    30 => \"\\e[1;38;5;69m\" , # warning, bright cornflowerblue"
NSQ_SOURCE_LINE 00000033 "    40 => \"\\e[1;38;5;113m\", # info   , bright darkolivegreen3"
NSQ_SOURCE_LINE 00000034 "    50 => \"\"              , # debug  , no color"
NSQ_SOURCE_LINE 00000035 "    60 => \"\\e[1;38;5;130m\", # trace  , bright darkorange3"
NSQ_SOURCE_LINE 00000036 ");"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "our %level_map;"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "sub meta { +{"
NSQ_SOURCE_LINE 00000041 "    v => 2,"
NSQ_SOURCE_LINE 00000042 "} }"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "sub _pick_color {"
NSQ_SOURCE_LINE 00000045 "    my ($level, $color_depth) = @_;"
NSQ_SOURCE_LINE 00000046 "    my $colors = $color_depth >= 256 ? \\%colors_256 : \\%colors_16;"
NSQ_SOURCE_LINE 00000047 "    if (defined(my $c = $colors->{$level})) {"
NSQ_SOURCE_LINE 00000048 "        return $c;"
NSQ_SOURCE_LINE 00000049 "    }"
NSQ_SOURCE_LINE 00000050 "    if (defined(my $clevel = $level_map{$level})) {"
NSQ_SOURCE_LINE 00000051 "        return $colors->{$clevel};"
NSQ_SOURCE_LINE 00000052 "    }"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "    # find the nearest"
NSQ_SOURCE_LINE 00000055 "    my ($dist, $clevel);"
NSQ_SOURCE_LINE 00000056 "    for my $k (keys %$colors) {"
NSQ_SOURCE_LINE 00000057 "        my $d = abs($k - $level);"
NSQ_SOURCE_LINE 00000058 "        if (!defined($dist) || $dist > $d) {"
NSQ_SOURCE_LINE 00000059 "            $dist = $d;"
NSQ_SOURCE_LINE 00000060 "            $clevel = $k;"
NSQ_SOURCE_LINE 00000061 "        }"
NSQ_SOURCE_LINE 00000062 "    }"
NSQ_SOURCE_LINE 00000063 "    $level_map{$level} = $clevel;"
NSQ_SOURCE_LINE 00000064 "    return $colors->{$clevel};"
NSQ_SOURCE_LINE 00000065 "}"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "sub hook_before_log {"
NSQ_SOURCE_LINE 00000068 "    my ($ctx, $msg) = @_;"
NSQ_SOURCE_LINE 00000069 "}"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "sub hook_after_log {"
NSQ_SOURCE_LINE 00000072 "    my ($ctx, $msg) = @_;"
NSQ_SOURCE_LINE 00000073 "    print { $ctx->{_fh} } \"\\n\" unless $msg =~ /\\R\\z/;"
NSQ_SOURCE_LINE 00000074 "}"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "sub get_hooks {"
NSQ_SOURCE_LINE 00000077 "    my %plugin_conf = @_;"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "    my $stderr = $plugin_conf{stderr};"
NSQ_SOURCE_LINE 00000080 "    $stderr = 1 unless defined $stderr;"
NSQ_SOURCE_LINE 00000081 "    my $handle = $stderr ? \\*STDERR : \\*STDOUT;"
NSQ_SOURCE_LINE 00000082 "    my $use_color = do {"
NSQ_SOURCE_LINE 00000083 "        if (defined $plugin_conf{use_color}) {"
NSQ_SOURCE_LINE 00000084 "            $plugin_conf{use_color};"
NSQ_SOURCE_LINE 00000085 "        } elsif (exists $ENV{NO_COLOR}) {"
NSQ_SOURCE_LINE 00000086 "            0;"
NSQ_SOURCE_LINE 00000087 "        } elsif (defined $ENV{COLOR}) {"
NSQ_SOURCE_LINE 00000088 "            $ENV{COLOR};"
NSQ_SOURCE_LINE 00000089 "        } else {"
NSQ_SOURCE_LINE 00000090 "            $stderr ? (-t STDERR) : (-t STDOUT); ## no critic: InputOutput::ProhibitInteractiveTest"
NSQ_SOURCE_LINE 00000091 "        }"
NSQ_SOURCE_LINE 00000092 "    };"
NSQ_SOURCE_LINE 00000093 "    my $color_depth = do {"
NSQ_SOURCE_LINE 00000094 "        if (defined $plugin_conf{color_depth}) {"
NSQ_SOURCE_LINE 00000095 "            $plugin_conf{color_depth};"
NSQ_SOURCE_LINE 00000096 "        } elsif (defined $ENV{COLOR_DEPTH}) {"
NSQ_SOURCE_LINE 00000097 "            $ENV{COLOR_DEPTH};"
NSQ_SOURCE_LINE 00000098 "        } elsif (!$use_color) {"
NSQ_SOURCE_LINE 00000099 "            0;"
NSQ_SOURCE_LINE 00000100 "        } elsif (defined $ENV{COLORTERM} && $ENV{COLORTERM} eq 'truecolor') {"
NSQ_SOURCE_LINE 00000101 "            16777216;"
NSQ_SOURCE_LINE 00000102 "        } elsif (defined $ENV{TERM} && $ENV{TERM} =~ /256color/) {"
NSQ_SOURCE_LINE 00000103 "            256;"
NSQ_SOURCE_LINE 00000104 "        } else {"
NSQ_SOURCE_LINE 00000105 "            16;"
NSQ_SOURCE_LINE 00000106 "        }"
NSQ_SOURCE_LINE 00000107 "    };"
NSQ_SOURCE_LINE 00000108 "    my $formatter = $plugin_conf{formatter};"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "    if ($plugin_conf{colorize_tags}) {"
NSQ_SOURCE_LINE 00000111 "        require Color::ANSI::Util;"
NSQ_SOURCE_LINE 00000112 "        require Color::RGB::Util;"
NSQ_SOURCE_LINE 00000113 "    }"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "    return {"
NSQ_SOURCE_LINE 00000116 "        create_outputter => ["
NSQ_SOURCE_LINE 00000117 "            __PACKAGE__, # key"
NSQ_SOURCE_LINE 00000118 "            50,          # priority"
NSQ_SOURCE_LINE 00000119 "            sub {        # hook"
NSQ_SOURCE_LINE 00000120 "                my %hook_args = @_; # see Log::ger::Manual::Internals/\"Arguments passed to hook\""
NSQ_SOURCE_LINE 00000121 "                my $outputter = sub {"
NSQ_SOURCE_LINE 00000122 "                    my ($per_target_conf, $msg, $per_msg_conf) = @_;"
NSQ_SOURCE_LINE 00000123 "                    my $level; $level = $per_msg_conf->{level} if $per_msg_conf; $level = $hook_args{level} unless defined $level;"
NSQ_SOURCE_LINE 00000124 "                    if ($formatter) {"
NSQ_SOURCE_LINE 00000125 "                        $msg = $formatter->($msg);"
NSQ_SOURCE_LINE 00000126 "                    }"
NSQ_SOURCE_LINE 00000127 "                    hook_before_log({ _fh=>$handle }, $msg);"
NSQ_SOURCE_LINE 00000128 "                    if ($use_color) {"
NSQ_SOURCE_LINE 00000129 "                        my $line_color = _pick_color($level, $color_depth);"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "                        if ($plugin_conf{colorize_tags}) {"
NSQ_SOURCE_LINE 00000132 "                            my $prog_prefix;"
NSQ_SOURCE_LINE 00000133 "                            if ($msg =~ s/\\A([\\w-]+:?\\s*)//) {"
NSQ_SOURCE_LINE 00000134 "                                $prog_prefix = $1;"
NSQ_SOURCE_LINE 00000135 "                            }"
NSQ_SOURCE_LINE 00000136 "                            my (@tags, @seps);"
NSQ_SOURCE_LINE 00000137 "                            while ($msg =~ s/\\A\\[([^\\]]+)\\](\\s*)//g) {"
NSQ_SOURCE_LINE 00000138 "                                push @tags, $1;"
NSQ_SOURCE_LINE 00000139 "                                push @seps, $2;"
NSQ_SOURCE_LINE 00000140 "                            }"
NSQ_SOURCE_LINE 00000141 "                            #use DD; dd {msg=>$msg, tags=>\\@tags, prog_prefix=>$prog_prefix};"
NSQ_SOURCE_LINE 00000142 "                            print $handle $line_color, $prog_prefix, \"\\e[0m\" if defined $prog_prefix;"
NSQ_SOURCE_LINE 00000143 "                            for my $i (0 .. $#tags) {"
NSQ_SOURCE_LINE 00000144 "                                # XXX force ansifg() to use the same color depth as us"
NSQ_SOURCE_LINE 00000145 "                                print $handle ("
NSQ_SOURCE_LINE 00000146 "                                    $line_color, \"[\", \"\\e[0m\","
NSQ_SOURCE_LINE 00000147 "                                    Color::ANSI::Util::ansifg( Color::RGB::Util::assign_rgb_light_color($tags[$i]) ), $tags[$i], \"\\e[0m\","
NSQ_SOURCE_LINE 00000148 "                                    $line_color, \"]\", $seps[$i], \"\\e[0m\","
NSQ_SOURCE_LINE 00000149 "                                );"
NSQ_SOURCE_LINE 00000150 "                            }"
NSQ_SOURCE_LINE 00000151 "                        }"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "                        print $handle $line_color, $msg, \"\\e[0m\";"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "                    } else {"
NSQ_SOURCE_LINE 00000156 "                        print $handle $msg;"
NSQ_SOURCE_LINE 00000157 "                    }"
NSQ_SOURCE_LINE 00000158 "                    hook_after_log({ _fh=>$handle }, $msg);"
NSQ_SOURCE_LINE 00000159 "                };"
NSQ_SOURCE_LINE 00000160 "                [$outputter];"
NSQ_SOURCE_LINE 00000161 "            }],"
NSQ_SOURCE_LINE 00000162 "    };"
NSQ_SOURCE_LINE 00000163 "}"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "1;"
NSQ_SOURCE_LINE 00000166 "# ABSTRACT: Output log to screen"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "__END__"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "=pod"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "=head1 NAME"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "Log::ger::Output::Screen - Output log to screen"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "=head1 VERSION"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "version 0.019"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 " use Log::ger::Output Screen => ("
NSQ_SOURCE_LINE 00000185 "     # stderr      => 1,    # set to 0 to print to stdout instead of stderr"
NSQ_SOURCE_LINE 00000186 "     # use_color   => 0,    # set to 1/0 to force usage of color, default is from NO_COLOR/COLOR or (-t STDOUT)"
NSQ_SOURCE_LINE 00000187 "     # color_depth => 16,   # if unset will guess from heuristic"
NSQ_SOURCE_LINE 00000188 "     # colorize_tags => 0,  # if set to true, will colorize \"[...]\" prefix in log message to unique colors"
NSQ_SOURCE_LINE 00000189 "     # formatter   => sub { ... },"
NSQ_SOURCE_LINE 00000190 " );"
NSQ_SOURCE_LINE 00000191 " use Log::ger;"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 " log_warn \"blah...\";"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "This L<Log::ger> plugin outputs log messages as lines to screen (STDERR by"
NSQ_SOURCE_LINE 00000198 "default), coloring them according to the log messages' levels. There are"
NSQ_SOURCE_LINE 00000199 "different color schemes available, see C<Log::ger::Screen::ColorScheme::*>"
NSQ_SOURCE_LINE 00000200 "modules like L<Log::ger::Screen::ColorScheme::Unlike>."
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "=for Pod::Coverage ^(.+)$"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "=head1 CONFIGURATION"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "=head2 stderr"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "Bool, default 1. Whether to print to STDERR (the default) or STDOUT."
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "=head2 use_color"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "Bool. The default is to look at the NO_COLOR and COLOR environment variables, or"
NSQ_SOURCE_LINE 00000213 "1 when in interactive mode and 0 when not in interactive mode."
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "=head2 color_depth"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "Integer, either 0, 16, 256, or 16777216. If unset, will use the following"
NSQ_SOURCE_LINE 00000218 "heuristic to guess color depth of terminal. First, if L</use_color> is false"
NSQ_SOURCE_LINE 00000219 "then 0. Otherwise, check if COLORTERM environment variable is defined and has"
NSQ_SOURCE_LINE 00000220 "the value of C<truecolor>; if yes then use 16777216. Otherwise, check if TERM"
NSQ_SOURCE_LINE 00000221 "environment variable contains the string C<256color>; if yes then 256. Otherwise"
NSQ_SOURCE_LINE 00000222 "16."
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "=head2 colorize_tags"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "Bool, default false. Experimental. If set to true, will colorize \"[...]\" tag"
NSQ_SOURCE_LINE 00000227 "prefixes in log message with unique RGB color. Will only do this if color is"
NSQ_SOURCE_LINE 00000228 "enabled, obviously. This option is inspired by Dist::Zilla terminal output."
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "For example, if log message is something like one of the following:"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 " [pericmd][plugin Foo::Bar] skip foobar-ing the program because of qux"
NSQ_SOURCE_LINE 00000233 " my-prog: [pericmd] [plugin Foo::Bar] skip foobar-ing the program because of qux"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "Then the C<< [pericmd] >> and C<< [plugin Foo::Bar] >> will be given a unique"
NSQ_SOURCE_LINE 00000236 "RGB color each."
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "=head2 formatter"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "Coderef. When defined, will pass the formatted message (but being applied with"
NSQ_SOURCE_LINE 00000241 "colors) to this custom formatter."
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "=head1 ENVIRONMENT"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "=head2 COLOR_DEPTH"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "Will be used as a default for L</color_depth> configuration."
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "=head2 NO_COLOR"
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "Can be set (to anything) to disable color by default, if C</use_color> is not"
NSQ_SOURCE_LINE 00000252 "set. Consulted before L</COLOR>."
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "=head2 COLOR"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "Can be set to disable/enable color by default, if C</use_color> is not set."
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "=head1 HISTORY"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "Originally modelled after L<Log::Any::Adapter::Screen>."
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "L<Log::ger>"
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "=head1 AUTHOR"
