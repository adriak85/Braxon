BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package LWP;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $VERSION = '6.82';"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "require LWP::UserAgent;  # this should load everything you need"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "1;"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "__END__"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "=pod"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "=encoding utf-8"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "=head1 NAME"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "LWP - The World-Wide Web library for Perl"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "  use LWP;"
NSQ_SOURCE_LINE 00000022 "  print \"This is libwww-perl-$LWP::VERSION\\n\";"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "The libwww-perl collection is a set of Perl modules which provides a"
NSQ_SOURCE_LINE 00000028 "simple and consistent application programming interface (API) to the"
NSQ_SOURCE_LINE 00000029 "World-Wide Web.  The main focus of the library is to provide classes"
NSQ_SOURCE_LINE 00000030 "and functions that allow you to write WWW clients. The library also"
NSQ_SOURCE_LINE 00000031 "contain modules that are of more general use and even classes that"
NSQ_SOURCE_LINE 00000032 "help you implement simple HTTP servers."
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "Most modules in this library provide an object oriented API.  The user"
NSQ_SOURCE_LINE 00000035 "agent, requests sent and responses received from the WWW server are"
NSQ_SOURCE_LINE 00000036 "all represented by objects.  This makes a simple and powerful"
NSQ_SOURCE_LINE 00000037 "interface to these services.  The interface is easy to extend"
NSQ_SOURCE_LINE 00000038 "and customize for your own needs."
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "The main features of the library are:"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "=over 3"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "=item *"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "Contains various reusable components (modules) that can be"
NSQ_SOURCE_LINE 00000047 "used separately or together."
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "=item *"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "Provides an object oriented model of HTTP-style communication.  Within"
NSQ_SOURCE_LINE 00000052 "this framework we currently support access to C<http>, C<https>, C<gopher>,"
NSQ_SOURCE_LINE 00000053 "C<ftp>, C<news>, C<file>, and C<mailto> resources."
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "=item *"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "Provides a full object oriented interface or"
NSQ_SOURCE_LINE 00000058 "a very simple procedural interface."
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "=item *"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "Supports the basic and digest authorization schemes."
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "=item *"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "Supports transparent redirect handling."
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "=item *"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "Supports access through proxy servers."
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "=item *"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "Provides parser for F<robots.txt> files and a framework for constructing robots."
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "=item *"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "Supports parsing of HTML forms."
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "=item *"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "Implements HTTP content negotiation algorithm that can"
NSQ_SOURCE_LINE 00000083 "be used both in protocol modules and in server scripts (like CGI"
NSQ_SOURCE_LINE 00000084 "scripts)."
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "=item *"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "Supports HTTP cookies."
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "=item *"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "Some simple command line clients, for instance C<lwp-request> and C<lwp-download>."
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "=back"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "=head1 HTTP STYLE COMMUNICATION"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "The libwww-perl library is based on HTTP style communication. This"
NSQ_SOURCE_LINE 00000101 "section tries to describe what that means."
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "Let us start with this quote from the HTTP specification document"
NSQ_SOURCE_LINE 00000104 "L<http://www.w3.org/Protocols/>:"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "=over 3"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "=item *"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "The HTTP protocol is based on a request/response paradigm. A client"
NSQ_SOURCE_LINE 00000111 "establishes a connection with a server and sends a request to the"
NSQ_SOURCE_LINE 00000112 "server in the form of a request method, URI, and protocol version,"
NSQ_SOURCE_LINE 00000113 "followed by a MIME-like message containing request modifiers, client"
NSQ_SOURCE_LINE 00000114 "information, and possible body content. The server responds with a"
NSQ_SOURCE_LINE 00000115 "status line, including the message's protocol version and a success or"
NSQ_SOURCE_LINE 00000116 "error code, followed by a MIME-like message containing server"
NSQ_SOURCE_LINE 00000117 "information, entity meta-information, and possible body content."
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "=back"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "What this means to libwww-perl is that communication always take place"
NSQ_SOURCE_LINE 00000122 "through these steps: First a I<request> object is created and"
NSQ_SOURCE_LINE 00000123 "configured. This object is then passed to a server and we get a"
NSQ_SOURCE_LINE 00000124 "I<response> object in return that we can examine. A request is always"
NSQ_SOURCE_LINE 00000125 "independent of any previous requests, i.e. the service is stateless."
NSQ_SOURCE_LINE 00000126 "The same simple model is used for any kind of service we want to"
NSQ_SOURCE_LINE 00000127 "access."
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "For example, if we want to fetch a document from a remote file server,"
NSQ_SOURCE_LINE 00000130 "then we send it a request that contains a name for that document and"
NSQ_SOURCE_LINE 00000131 "the response will contain the document itself.  If we access a search"
NSQ_SOURCE_LINE 00000132 "engine, then the content of the request will contain the query"
NSQ_SOURCE_LINE 00000133 "parameters and the response will contain the query result.  If we want"
NSQ_SOURCE_LINE 00000134 "to send a mail message to somebody then we send a request object which"
NSQ_SOURCE_LINE 00000135 "contains our message to the mail server and the response object will"
NSQ_SOURCE_LINE 00000136 "contain an acknowledgment that tells us that the message has been"
NSQ_SOURCE_LINE 00000137 "accepted and will be forwarded to the recipient(s)."
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "It is as simple as that!"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "=head2 The Request Object"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "The libwww-perl request object has the class name L<HTTP::Request>."
NSQ_SOURCE_LINE 00000145 "The fact that the class name uses C<HTTP::> as a"
NSQ_SOURCE_LINE 00000146 "prefix only implies that we use the HTTP model of communication.  It"
NSQ_SOURCE_LINE 00000147 "does not limit the kind of services we can try to pass this I<request>"
NSQ_SOURCE_LINE 00000148 "to.  For instance, we will send L<HTTP::Request>s both to ftp and"
NSQ_SOURCE_LINE 00000149 "gopher servers, as well as to the local file system."
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "The main attributes of the request objects are:"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "=over 3"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "=item *"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "B<method> is a short string that tells what kind of"
NSQ_SOURCE_LINE 00000158 "request this is.  The most common methods are B<GET>, B<PUT>,"
NSQ_SOURCE_LINE 00000159 "B<POST> and B<HEAD>."
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "=item *"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "B<uri> is a string denoting the protocol, server and"
NSQ_SOURCE_LINE 00000164 "the name of the \"document\" we want to access.  The B<uri> might"
NSQ_SOURCE_LINE 00000165 "also encode various other parameters."
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "=item *"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "B<headers> contains additional information about the"
NSQ_SOURCE_LINE 00000170 "request and can also used to describe the content.  The headers"
NSQ_SOURCE_LINE 00000171 "are a set of keyword/value pairs."
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "=item *"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "B<content> is an arbitrary amount of data."
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "=back"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "=head2 The Response Object"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "The libwww-perl response object has the class name L<HTTP::Response>."
NSQ_SOURCE_LINE 00000182 "The main attributes of objects of this class are:"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "=over 3"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "=item *"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "B<code> is a numerical value that indicates the overall"
NSQ_SOURCE_LINE 00000189 "outcome of the request."
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "=item *"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "B<message> is a short, human readable string that"
NSQ_SOURCE_LINE 00000194 "corresponds to the I<code>."
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "=item *"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "B<headers> contains additional information about the"
NSQ_SOURCE_LINE 00000199 "response and describe the content."
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "=item *"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "B<content> is an arbitrary amount of data."
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "=back"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "Since we don't want to handle all possible I<code> values directly in"
NSQ_SOURCE_LINE 00000208 "our programs, a libwww-perl response object has methods that can be"
NSQ_SOURCE_LINE 00000209 "used to query what kind of response this is.  The most commonly used"
NSQ_SOURCE_LINE 00000210 "response classification methods are:"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "=over 3"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "=item is_success()"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "The request was successfully received, understood or accepted."
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "=item is_error()"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "The request failed.  The server or the resource might not be"
NSQ_SOURCE_LINE 00000221 "available, access to the resource might be denied or other things might"
NSQ_SOURCE_LINE 00000222 "have failed for some reason."
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "=back"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "=head2 The User Agent"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "Let us assume that we have created a I<request> object. What do we"
NSQ_SOURCE_LINE 00000229 "actually do with it in order to receive a I<response>?"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "The answer is that you pass it to a I<user agent> object and this"
NSQ_SOURCE_LINE 00000232 "object takes care of all the things that need to be done"
NSQ_SOURCE_LINE 00000233 "(like low-level communication and error handling) and returns"
NSQ_SOURCE_LINE 00000234 "a I<response> object. The user agent represents your"
NSQ_SOURCE_LINE 00000235 "application on the network and provides you with an interface that"
NSQ_SOURCE_LINE 00000236 "can accept I<requests> and return I<responses>."
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "The user agent is an interface layer between"
NSQ_SOURCE_LINE 00000239 "your application code and the network.  Through this interface you are"
NSQ_SOURCE_LINE 00000240 "able to access the various servers on the network."
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "The class name for the user agent is L<LWP::UserAgent>.  Every"
NSQ_SOURCE_LINE 00000243 "libwww-perl application that wants to communicate should create at"
NSQ_SOURCE_LINE 00000244 "least one object of this class. The main method provided by this"
NSQ_SOURCE_LINE 00000245 "object is request(). This method takes an L<HTTP::Request> object as"
NSQ_SOURCE_LINE 00000246 "argument and (eventually) returns a L<HTTP::Response> object."
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "The user agent has many other attributes that let you"
NSQ_SOURCE_LINE 00000249 "configure how it will interact with the network and with your"
NSQ_SOURCE_LINE 00000250 "application."
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "=over 3"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "=item *"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "B<timeout> specifies how much time we give remote servers to"
NSQ_SOURCE_LINE 00000257 "respond before the library disconnects and creates an"
NSQ_SOURCE_LINE 00000258 "internal I<timeout> response."
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "=item *"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "B<agent> specifies the name that your application uses when it"
NSQ_SOURCE_LINE 00000263 "presents itself on the network."
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "=item *"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "B<from> can be set to the e-mail address of the person"
NSQ_SOURCE_LINE 00000268 "responsible for running the application.  If this is set, then the"
NSQ_SOURCE_LINE 00000269 "address will be sent to the servers with every request."
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "=item *"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "B<parse_head> specifies whether we should initialize response"
NSQ_SOURCE_LINE 00000274 "headers from the C<< <head> >> section of HTML documents."
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "=item *"
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "B<proxy> and B<no_proxy> specify if and when to go through"
NSQ_SOURCE_LINE 00000279 "a proxy server. L<http://www.w3.org/History/1994/WWW/Proxies/>"
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "=item *"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "B<credentials> provides a way to set up user names and"
NSQ_SOURCE_LINE 00000284 "passwords needed to access certain services."
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "=back"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "Many applications want even more control over how they interact"
NSQ_SOURCE_LINE 00000289 "with the network and they get this by sub-classing"
NSQ_SOURCE_LINE 00000290 "L<LWP::UserAgent>.  The library includes a"
NSQ_SOURCE_LINE 00000291 "sub-class, L<LWP::RobotUA>, for robot applications."
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "=head2 An Example"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "This example shows how the user agent, a request and a response are"
NSQ_SOURCE_LINE 00000296 "represented in actual perl code:"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "  # Create a user agent object"
NSQ_SOURCE_LINE 00000299 "  use LWP::UserAgent;"
NSQ_SOURCE_LINE 00000300 "  my $ua = LWP::UserAgent->new;"
NSQ_SOURCE_LINE 00000301 "  $ua->agent(\"MyApp/0.1 \");"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "  # Create a request"
NSQ_SOURCE_LINE 00000304 "  my $req = HTTP::Request->new(POST => 'http://search.cpan.org/search');"
NSQ_SOURCE_LINE 00000305 "  $req->content_type('application/x-www-form-urlencoded');"
NSQ_SOURCE_LINE 00000306 "  $req->content('query=libwww-perl&mode=dist');"
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "  # Pass request to the user agent and get a response back"
NSQ_SOURCE_LINE 00000309 "  my $res = $ua->request($req);"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "  # Check the outcome of the response"
NSQ_SOURCE_LINE 00000312 "  if ($res->is_success) {"
NSQ_SOURCE_LINE 00000313 "      print $res->content;"
NSQ_SOURCE_LINE 00000314 "  }"
NSQ_SOURCE_LINE 00000315 "  else {"
NSQ_SOURCE_LINE 00000316 "      print $res->status_line, \"\\n\";"
NSQ_SOURCE_LINE 00000317 "  }"
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "The C<$ua> is created once when the application starts up.  New request"
NSQ_SOURCE_LINE 00000320 "objects should normally created for each request sent."
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "=head1 NETWORK SUPPORT"
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "This section discusses the various protocol schemes and"
NSQ_SOURCE_LINE 00000326 "the HTTP style methods that headers may be used for each."
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "For all requests, a \"User-Agent\" header is added and initialized from"
NSQ_SOURCE_LINE 00000329 "the C<< $ua->agent >> attribute before the request is handed to the network"
NSQ_SOURCE_LINE 00000330 "layer.  In the same way, a \"From\" header is initialized from the"
NSQ_SOURCE_LINE 00000331 "$ua->from attribute."
NSQ_SOURCE_LINE 00000332 ""
NSQ_SOURCE_LINE 00000333 "For all responses, the library adds a header called \"Client-Date\"."
NSQ_SOURCE_LINE 00000334 "This header holds the time when the response was received by"
NSQ_SOURCE_LINE 00000335 "your application.  The format and semantics of the header are the"
NSQ_SOURCE_LINE 00000336 "same as the server created \"Date\" header.  You may also encounter other"
NSQ_SOURCE_LINE 00000337 "\"Client-XXX\" headers.  They are all generated by the library"
NSQ_SOURCE_LINE 00000338 "internally and are not received from the servers."
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "=head2 HTTP Requests"
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "HTTP requests are just handed off to an HTTP server and it"
NSQ_SOURCE_LINE 00000343 "decides what happens.  Few servers implement methods beside the usual"
NSQ_SOURCE_LINE 00000344 "\"GET\", \"HEAD\", \"POST\" and \"PUT\", but CGI-scripts may implement"
NSQ_SOURCE_LINE 00000345 "any method they like."
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "If the server is not available then the library will generate an"
NSQ_SOURCE_LINE 00000348 "internal error response."
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "The library automatically adds a \"Host\" and a \"Content-Length\" header"
NSQ_SOURCE_LINE 00000351 "to the HTTP request before it is sent over the network."
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "For a GET request you might want to add an \"If-Modified-Since\" or"
NSQ_SOURCE_LINE 00000354 "\"If-None-Match\" header to make the request conditional."
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "For a POST request you should add the \"Content-Type\" header.  When you"
NSQ_SOURCE_LINE 00000357 "try to emulate HTML E<lt>FORM> handling you should usually let the value"
NSQ_SOURCE_LINE 00000358 "of the \"Content-Type\" header be \"application/x-www-form-urlencoded\"."
NSQ_SOURCE_LINE 00000359 "See L<lwpcook> for examples of this."
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "The libwww-perl HTTP implementation currently support the HTTP/1.1"
NSQ_SOURCE_LINE 00000362 "and HTTP/1.0 protocol."
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "The library allows you to access proxy server through HTTP.  This"
NSQ_SOURCE_LINE 00000365 "means that you can set up the library to forward all types of request"
NSQ_SOURCE_LINE 00000366 "through the HTTP protocol module.  See L<LWP::UserAgent> for"
NSQ_SOURCE_LINE 00000367 "documentation of this."
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "=head2 HTTPS Requests"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "HTTPS requests are HTTP requests over an encrypted network connection"
NSQ_SOURCE_LINE 00000373 "using the SSL protocol developed by Netscape.  Everything about HTTP"
NSQ_SOURCE_LINE 00000374 "requests above also apply to HTTPS requests.  In addition the library"
NSQ_SOURCE_LINE 00000375 "will add the headers \"Client-SSL-Cipher\", \"Client-SSL-Cert-Subject\" and"
NSQ_SOURCE_LINE 00000376 "\"Client-SSL-Cert-Issuer\" to the response.  These headers denote the"
NSQ_SOURCE_LINE 00000377 "encryption method used and the name of the server owner."
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "The request can contain the header \"If-SSL-Cert-Subject\" in order to"
NSQ_SOURCE_LINE 00000380 "make the request conditional on the content of the server certificate."
NSQ_SOURCE_LINE 00000381 "If the certificate subject does not match, no request is sent to the"
NSQ_SOURCE_LINE 00000382 "server and an internally generated error response is returned.  The"
NSQ_SOURCE_LINE 00000383 "value of the \"If-SSL-Cert-Subject\" header is interpreted as a Perl"
NSQ_SOURCE_LINE 00000384 "regular expression."
NSQ_SOURCE_LINE 00000385 ""
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "=head2 FTP Requests"
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "The library currently supports GET, HEAD and PUT requests.  GET"
NSQ_SOURCE_LINE 00000390 "retrieves a file or a directory listing from an FTP server.  PUT"
NSQ_SOURCE_LINE 00000391 "stores a file on a ftp server."
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "You can specify a ftp account for servers that want this in addition"
NSQ_SOURCE_LINE 00000394 "to user name and password.  This is specified by including an \"Account\""
NSQ_SOURCE_LINE 00000395 "header in the request."
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "User name/password can be specified using basic authorization or be"
NSQ_SOURCE_LINE 00000398 "encoded in the URL.  Failed logins return an UNAUTHORIZED response with"
NSQ_SOURCE_LINE 00000399 "\"WWW-Authenticate: Basic\" and can be treated like basic authorization"
NSQ_SOURCE_LINE 00000400 "for HTTP."
NSQ_SOURCE_LINE 00000401 ""
NSQ_SOURCE_LINE 00000402 "The library supports ftp ASCII transfer mode by specifying the \"type=a\""
NSQ_SOURCE_LINE 00000403 "parameter in the URL. It also supports transfer of ranges for FTP transfers"
NSQ_SOURCE_LINE 00000404 "using the \"Range\" header."
NSQ_SOURCE_LINE 00000405 ""
NSQ_SOURCE_LINE 00000406 "Directory listings are by default returned unprocessed (as returned"
NSQ_SOURCE_LINE 00000407 "from the ftp server) with the content media type reported to be"
NSQ_SOURCE_LINE 00000408 "\"text/ftp-dir-listing\". The L<File::Listing> module provides methods"
NSQ_SOURCE_LINE 00000409 "for parsing of these directory listing."
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "The ftp module is also able to convert directory listings to HTML and"
NSQ_SOURCE_LINE 00000412 "this can be requested via the standard HTTP content negotiation"
NSQ_SOURCE_LINE 00000413 "mechanisms (add an \"Accept: text/html\" header in the request if you"
NSQ_SOURCE_LINE 00000414 "want this)."
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "For normal file retrievals, the \"Content-Type\" is guessed based on the"
NSQ_SOURCE_LINE 00000417 "file name suffix. See L<LWP::MediaTypes>."
NSQ_SOURCE_LINE 00000418 ""
NSQ_SOURCE_LINE 00000419 "The \"If-Modified-Since\" request header works for servers that implement"
NSQ_SOURCE_LINE 00000420 "the C<MDTM> command.  It will probably not work for directory listings though."
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "Example:"
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "  $req = HTTP::Request->new(GET => 'ftp://me:passwd@ftp.some.where.com/');"
NSQ_SOURCE_LINE 00000425 "  $req->header(Accept => \"text/html, */*;q=0.1\");"
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 "=head2 News Requests"
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 "Access to the USENET News system is implemented through the NNTP"
NSQ_SOURCE_LINE 00000430 "protocol.  The name of the news server is obtained from the"
NSQ_SOURCE_LINE 00000431 "NNTP_SERVER environment variable and defaults to \"news\".  It is not"
NSQ_SOURCE_LINE 00000432 "possible to specify the hostname of the NNTP server in news: URLs."
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 "The library supports GET and HEAD to retrieve news articles through the"
NSQ_SOURCE_LINE 00000435 "NNTP protocol.  You can also post articles to newsgroups by using"
NSQ_SOURCE_LINE 00000436 "(surprise!) the POST method."
NSQ_SOURCE_LINE 00000437 ""
NSQ_SOURCE_LINE 00000438 "GET on newsgroups is not implemented yet."
NSQ_SOURCE_LINE 00000439 ""
NSQ_SOURCE_LINE 00000440 "Examples:"
NSQ_SOURCE_LINE 00000441 ""
NSQ_SOURCE_LINE 00000442 "  $req = HTTP::Request->new(GET => 'news:abc1234@a.sn.no');"
NSQ_SOURCE_LINE 00000443 ""
NSQ_SOURCE_LINE 00000444 "  $req = HTTP::Request->new(POST => 'news:comp.lang.perl.test');"
NSQ_SOURCE_LINE 00000445 "  $req->header(Subject => 'This is a test',"
NSQ_SOURCE_LINE 00000446 "               From    => 'me@some.where.org');"
NSQ_SOURCE_LINE 00000447 "  $req->content(<<EOT);"
NSQ_SOURCE_LINE 00000448 "  This is the content of the message that we are sending to"
NSQ_SOURCE_LINE 00000449 "  the world."
NSQ_SOURCE_LINE 00000450 "  EOT"
NSQ_SOURCE_LINE 00000451 ""
NSQ_SOURCE_LINE 00000452 ""
NSQ_SOURCE_LINE 00000453 "=head2 Gopher Request"
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 "The library supports the GET and HEAD methods for gopher requests.  All"
NSQ_SOURCE_LINE 00000456 "request header values are ignored.  HEAD cheats and returns a"
NSQ_SOURCE_LINE 00000457 "response without even talking to server."
NSQ_SOURCE_LINE 00000458 ""
NSQ_SOURCE_LINE 00000459 "Gopher menus are always converted to HTML."
NSQ_SOURCE_LINE 00000460 ""
NSQ_SOURCE_LINE 00000461 "The response \"Content-Type\" is generated from the document type"
NSQ_SOURCE_LINE 00000462 "encoded (as the first letter) in the request URL path itself."
NSQ_SOURCE_LINE 00000463 ""
NSQ_SOURCE_LINE 00000464 "Example:"
NSQ_SOURCE_LINE 00000465 ""
NSQ_SOURCE_LINE 00000466 "  $req = HTTP::Request->new(GET => 'gopher://gopher.sn.no/');"
NSQ_SOURCE_LINE 00000467 ""
NSQ_SOURCE_LINE 00000468 ""
NSQ_SOURCE_LINE 00000469 ""
NSQ_SOURCE_LINE 00000470 "=head2 File Request"
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "The library supports GET and HEAD methods for file requests.  The"
NSQ_SOURCE_LINE 00000473 "\"If-Modified-Since\" header is supported.  All other headers are"
NSQ_SOURCE_LINE 00000474 "ignored.  The I<host> component of the file URL must be empty or set"
NSQ_SOURCE_LINE 00000475 "to \"localhost\".  Any other I<host> value will be treated as an error."
NSQ_SOURCE_LINE 00000476 ""
NSQ_SOURCE_LINE 00000477 "Directories are always converted to an HTML document.  For normal"
NSQ_SOURCE_LINE 00000478 "files, the \"Content-Type\" and \"Content-Encoding\" in the response are"
NSQ_SOURCE_LINE 00000479 "guessed based on the file suffix."
NSQ_SOURCE_LINE 00000480 ""
NSQ_SOURCE_LINE 00000481 "Example:"
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 "  $req = HTTP::Request->new(GET => 'file:/etc/passwd');"
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 ""
NSQ_SOURCE_LINE 00000486 "=head2 Mailto Request"
NSQ_SOURCE_LINE 00000487 ""
NSQ_SOURCE_LINE 00000488 "You can send (aka \"POST\") mail messages using the library.  All"
NSQ_SOURCE_LINE 00000489 "headers specified for the request are passed on to the mail system."
NSQ_SOURCE_LINE 00000490 "The \"To\" header is initialized from the mail address in the URL."
NSQ_SOURCE_LINE 00000491 ""
NSQ_SOURCE_LINE 00000492 "Example:"
NSQ_SOURCE_LINE 00000493 ""
NSQ_SOURCE_LINE 00000494 "  $req = HTTP::Request->new(POST => 'mailto:libwww@perl.org');"
NSQ_SOURCE_LINE 00000495 "  $req->header(Subject => \"subscribe\");"
NSQ_SOURCE_LINE 00000496 "  $req->content(\"Please subscribe me to the libwww-perl mailing list!\\n\");"
NSQ_SOURCE_LINE 00000497 ""
NSQ_SOURCE_LINE 00000498 "=head2 CPAN Requests"
NSQ_SOURCE_LINE 00000499 ""
NSQ_SOURCE_LINE 00000500 "URLs with scheme C<cpan:> are redirected to a suitable CPAN"
NSQ_SOURCE_LINE 00000501 "mirror.  If you have your own local mirror of CPAN you might tell LWP"
NSQ_SOURCE_LINE 00000502 "to use it for C<cpan:> URLs by an assignment like this:"
NSQ_SOURCE_LINE 00000503 ""
NSQ_SOURCE_LINE 00000504 "  $LWP::Protocol::cpan::CPAN = \"file:/local/CPAN/\";"
NSQ_SOURCE_LINE 00000505 ""
NSQ_SOURCE_LINE 00000506 "Suitable CPAN mirrors are also picked up from the configuration for"
NSQ_SOURCE_LINE 00000507 "the CPAN.pm, so if you have used that module a suitable mirror should"
NSQ_SOURCE_LINE 00000508 "be picked automatically.  If neither of these apply, then a redirect"
NSQ_SOURCE_LINE 00000509 "to the generic CPAN http location is issued."
NSQ_SOURCE_LINE 00000510 ""
NSQ_SOURCE_LINE 00000511 "Example request to download the newest perl:"
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "  $req = HTTP::Request->new(GET => \"cpan:src/latest.tar.gz\");"
NSQ_SOURCE_LINE 00000514 ""
NSQ_SOURCE_LINE 00000515 ""
NSQ_SOURCE_LINE 00000516 "=head1 OVERVIEW OF CLASSES AND PACKAGES"
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "This table should give you a quick overview of the classes provided by the"
NSQ_SOURCE_LINE 00000519 "library. Indentation shows class inheritance."
NSQ_SOURCE_LINE 00000520 ""
NSQ_SOURCE_LINE 00000521 " LWP::MemberMixin   -- Access to member variables of Perl5 classes"
NSQ_SOURCE_LINE 00000522 "   LWP::UserAgent   -- WWW user agent class"
NSQ_SOURCE_LINE 00000523 "     LWP::RobotUA   -- When developing a robot applications"
NSQ_SOURCE_LINE 00000524 "   LWP::Protocol          -- Interface to various protocol schemes"
NSQ_SOURCE_LINE 00000525 "     LWP::Protocol::http  -- http:// access"
NSQ_SOURCE_LINE 00000526 "     LWP::Protocol::file  -- file:// access"
NSQ_SOURCE_LINE 00000527 "     LWP::Protocol::ftp   -- ftp:// access"
NSQ_SOURCE_LINE 00000528 "     ..."
NSQ_SOURCE_LINE 00000529 ""
NSQ_SOURCE_LINE 00000530 " LWP::Authen::Basic -- Handle 401 and 407 responses"
NSQ_SOURCE_LINE 00000531 " LWP::Authen::Digest"
NSQ_SOURCE_LINE 00000532 ""
NSQ_SOURCE_LINE 00000533 " HTTP::Headers      -- MIME/RFC822 style header (used by HTTP::Message)"
NSQ_SOURCE_LINE 00000534 " HTTP::Message      -- HTTP style message"
NSQ_SOURCE_LINE 00000535 "   HTTP::Request    -- HTTP request"
NSQ_SOURCE_LINE 00000536 "   HTTP::Response   -- HTTP response"
NSQ_SOURCE_LINE 00000537 " HTTP::Daemon       -- A HTTP server class"
NSQ_SOURCE_LINE 00000538 ""
NSQ_SOURCE_LINE 00000539 " WWW::RobotRules    -- Parse robots.txt files"
NSQ_SOURCE_LINE 00000540 "   WWW::RobotRules::AnyDBM_File -- Persistent RobotRules"
NSQ_SOURCE_LINE 00000541 ""
NSQ_SOURCE_LINE 00000542 " Net::HTTP          -- Low level HTTP client"
NSQ_SOURCE_LINE 00000543 ""
NSQ_SOURCE_LINE 00000544 "The following modules provide various functions and definitions."
NSQ_SOURCE_LINE 00000545 ""
NSQ_SOURCE_LINE 00000546 " LWP                -- This file.  Library version number and documentation."
NSQ_SOURCE_LINE 00000547 " LWP::MediaTypes    -- MIME types configuration (text/html etc.)"
NSQ_SOURCE_LINE 00000548 " LWP::Simple        -- Simplified procedural interface for common functions"
NSQ_SOURCE_LINE 00000549 " HTTP::Status       -- HTTP status code (200 OK etc)"
NSQ_SOURCE_LINE 00000550 " HTTP::Date         -- Date parsing module for HTTP date formats"
NSQ_SOURCE_LINE 00000551 " HTTP::Negotiate    -- HTTP content negotiation calculation"
NSQ_SOURCE_LINE 00000552 " File::Listing      -- Parse directory listings"
NSQ_SOURCE_LINE 00000553 " HTML::Form         -- Processing for <form>s in HTML documents"
NSQ_SOURCE_LINE 00000554 ""
NSQ_SOURCE_LINE 00000555 ""
NSQ_SOURCE_LINE 00000556 "=head1 MORE DOCUMENTATION"
NSQ_SOURCE_LINE 00000557 ""
NSQ_SOURCE_LINE 00000558 "All modules contain detailed information on the interfaces they"
NSQ_SOURCE_LINE 00000559 "provide.  The L<lwpcook> manpage is the libwww-perl cookbook that contain"
NSQ_SOURCE_LINE 00000560 "examples of typical usage of the library.  You might want to take a"
NSQ_SOURCE_LINE 00000561 "look at how the scripts L<lwp-request>, L<lwp-download>, L<lwp-dump>"
NSQ_SOURCE_LINE 00000562 "and L<lwp-mirror> are implemented."
NSQ_SOURCE_LINE 00000563 ""
NSQ_SOURCE_LINE 00000564 "=head1 ENVIRONMENT"
NSQ_SOURCE_LINE 00000565 ""
NSQ_SOURCE_LINE 00000566 "The following environment variables are used by LWP:"
NSQ_SOURCE_LINE 00000567 ""
NSQ_SOURCE_LINE 00000568 "=over"
NSQ_SOURCE_LINE 00000569 ""
NSQ_SOURCE_LINE 00000570 "=item HOME"
NSQ_SOURCE_LINE 00000571 ""
NSQ_SOURCE_LINE 00000572 "The L<LWP::MediaTypes> functions will look for the F<.media.types> and"
NSQ_SOURCE_LINE 00000573 "F<.mime.types> files relative to you home directory."
NSQ_SOURCE_LINE 00000574 ""
NSQ_SOURCE_LINE 00000575 "=item http_proxy"
NSQ_SOURCE_LINE 00000576 ""
NSQ_SOURCE_LINE 00000577 "=item ftp_proxy"
NSQ_SOURCE_LINE 00000578 ""
NSQ_SOURCE_LINE 00000579 "=item xxx_proxy"
NSQ_SOURCE_LINE 00000580 ""
NSQ_SOURCE_LINE 00000581 "=item no_proxy"
NSQ_SOURCE_LINE 00000582 ""
NSQ_SOURCE_LINE 00000583 "These environment variables can be set to enable communication through"
NSQ_SOURCE_LINE 00000584 "a proxy server.  See the description of the C<env_proxy> method in"
NSQ_SOURCE_LINE 00000585 "L<LWP::UserAgent>."
NSQ_SOURCE_LINE 00000586 ""
NSQ_SOURCE_LINE 00000587 "=item PERL_LWP_ENV_PROXY"
NSQ_SOURCE_LINE 00000588 ""
NSQ_SOURCE_LINE 00000589 "If set to a TRUE value, then the L<LWP::UserAgent> will by default call"
NSQ_SOURCE_LINE 00000590 "C<env_proxy> during initialization.  This makes LWP honor the proxy variables"
NSQ_SOURCE_LINE 00000591 "described above."
NSQ_SOURCE_LINE 00000592 ""
NSQ_SOURCE_LINE 00000593 "=item PERL_LWP_SSL_VERIFY_HOSTNAME"
NSQ_SOURCE_LINE 00000594 ""
NSQ_SOURCE_LINE 00000595 "The default C<verify_hostname> setting for L<LWP::UserAgent>.  If"
NSQ_SOURCE_LINE 00000596 "not set the default will be 1.  Set it as 0 to disable hostname"
NSQ_SOURCE_LINE 00000597 "verification (the default prior to libwww-perl 5.840."
NSQ_SOURCE_LINE 00000598 ""
NSQ_SOURCE_LINE 00000599 "=item PERL_LWP_SSL_CA_FILE"
NSQ_SOURCE_LINE 00000600 ""
NSQ_SOURCE_LINE 00000601 "=item PERL_LWP_SSL_CA_PATH"
NSQ_SOURCE_LINE 00000602 ""
NSQ_SOURCE_LINE 00000603 "The file and/or directory"
NSQ_SOURCE_LINE 00000604 "where the trusted Certificate Authority certificates"
NSQ_SOURCE_LINE 00000605 "is located.  See L<LWP::UserAgent> for details."
NSQ_SOURCE_LINE 00000606 ""
NSQ_SOURCE_LINE 00000607 "=item PERL_HTTP_URI_CLASS"
NSQ_SOURCE_LINE 00000608 ""
NSQ_SOURCE_LINE 00000609 "Used to decide what URI objects to instantiate.  The default is L<URI>."
NSQ_SOURCE_LINE 00000610 "You might want to set it to L<URI::URL> for compatibility with old times."
NSQ_SOURCE_LINE 00000611 ""
NSQ_SOURCE_LINE 00000612 "=back"
NSQ_SOURCE_LINE 00000613 ""
