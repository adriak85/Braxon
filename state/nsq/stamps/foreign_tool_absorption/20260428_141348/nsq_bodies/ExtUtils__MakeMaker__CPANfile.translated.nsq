BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package ExtUtils::MakeMaker::CPANfile;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 "use ExtUtils::MakeMaker ();"
NSQ_SOURCE_LINE 00000006 "use File::Spec::Functions qw/catfile rel2abs/;"
NSQ_SOURCE_LINE 00000007 "use Module::CPANfile;"
NSQ_SOURCE_LINE 00000008 "use version;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "our $VERSION = \"0.09\";"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "sub import {"
NSQ_SOURCE_LINE 00000013 "  my $class = shift;"
NSQ_SOURCE_LINE 00000014 "  my $orig = \\&ExtUtils::MakeMaker::WriteMakefile;"
NSQ_SOURCE_LINE 00000015 "  my $writer = sub {"
NSQ_SOURCE_LINE 00000016 "    my %params = @_;"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "    # Do nothing if not called from Makefile.PL"
NSQ_SOURCE_LINE 00000019 "    my ($caller, $file, $line) = caller;"
NSQ_SOURCE_LINE 00000020 "    (my $root = rel2abs($file)) =~ s/Makefile\\.PL$//i or return;"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "    if (my $file = eval { Module::CPANfile->load(catfile($root, \"cpanfile\")) }) {"
NSQ_SOURCE_LINE 00000023 "      my $prereqs = $file->prereqs;"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "      # Runtime requires => PREREQ_PM"
NSQ_SOURCE_LINE 00000026 "      _merge("
NSQ_SOURCE_LINE 00000027 "        \\%params,"
NSQ_SOURCE_LINE 00000028 "        _get($prereqs, 'runtime', 'requires'),"
NSQ_SOURCE_LINE 00000029 "        'PREREQ_PM',"
NSQ_SOURCE_LINE 00000030 "      );"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "      # Build requires => BUILD_REQUIRES / PREREQ_PM"
NSQ_SOURCE_LINE 00000033 "      _merge("
NSQ_SOURCE_LINE 00000034 "         \\%params,"
NSQ_SOURCE_LINE 00000035 "         _get($prereqs, 'build', 'requires'),"
NSQ_SOURCE_LINE 00000036 "         _eumm('6.56') ? 'BUILD_REQUIRES' : 'PREREQ_PM',"
NSQ_SOURCE_LINE 00000037 "      );"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "      # Test requires => TEST_REQUIRES / BUILD_REQUIRES / PREREQ_PM"
NSQ_SOURCE_LINE 00000040 "      _merge("
NSQ_SOURCE_LINE 00000041 "         \\%params,"
NSQ_SOURCE_LINE 00000042 "         _get($prereqs, 'test', 'requires'),"
NSQ_SOURCE_LINE 00000043 "         _eumm('6.63_03') ? 'TEST_REQUIRES' :"
NSQ_SOURCE_LINE 00000044 "         _eumm('6.56') ? 'BUILD_REQUIRES' : 'PREREQ_PM',"
NSQ_SOURCE_LINE 00000045 "      );"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "      # Configure requires => CONFIGURE_REQUIRES / ignored"
NSQ_SOURCE_LINE 00000048 "      _merge("
NSQ_SOURCE_LINE 00000049 "         \\%params,"
NSQ_SOURCE_LINE 00000050 "         _get($prereqs, 'configure', 'requires'),"
NSQ_SOURCE_LINE 00000051 "         _eumm('6.52') ? 'CONFIGURE_REQUIRES' : undef,"
NSQ_SOURCE_LINE 00000052 "      );"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "      # Add myself to configure requires (if possible)"
NSQ_SOURCE_LINE 00000055 "      _merge("
NSQ_SOURCE_LINE 00000056 "         \\%params,"
NSQ_SOURCE_LINE 00000057 "         {'ExtUtils::MakeMaker::CPANfile' => $VERSION},"
NSQ_SOURCE_LINE 00000058 "         _eumm('6.52') ? 'CONFIGURE_REQUIRES' : undef,"
NSQ_SOURCE_LINE 00000059 "      );"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "      # Set dynamic_config to 0 if not set explicitly"
NSQ_SOURCE_LINE 00000062 "      if (!exists $params{META_ADD}{dynamic_config} &&"
NSQ_SOURCE_LINE 00000063 "          !exists $params{META_MERGE}{dynamic_config}) {"
NSQ_SOURCE_LINE 00000064 "          $params{META_MERGE}{dynamic_config} = 0;"
NSQ_SOURCE_LINE 00000065 "      }"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "      # recommends, suggests, conflicts"
NSQ_SOURCE_LINE 00000068 "      my $requires_2_0;"
NSQ_SOURCE_LINE 00000069 "      for my $type (qw/recommends suggests conflicts/) {"
NSQ_SOURCE_LINE 00000070 "          for my $phase (qw/configure build test runtime develop/) {"
NSQ_SOURCE_LINE 00000071 "              my %tmp = %{$params{META_MERGE}{prereqs}{$phase} || {}};"
NSQ_SOURCE_LINE 00000072 "              _merge("
NSQ_SOURCE_LINE 00000073 "                  \\%tmp,"
NSQ_SOURCE_LINE 00000074 "                  _get($prereqs, $phase, $type),"
NSQ_SOURCE_LINE 00000075 "                  $type,"
NSQ_SOURCE_LINE 00000076 "              );"
NSQ_SOURCE_LINE 00000077 "              if ($tmp{$type}) {"
NSQ_SOURCE_LINE 00000078 "                  $params{META_MERGE}{prereqs}{$phase} = \\%tmp;"
NSQ_SOURCE_LINE 00000079 "                  $requires_2_0 = 1;"
NSQ_SOURCE_LINE 00000080 "              }"
NSQ_SOURCE_LINE 00000081 "          }"
NSQ_SOURCE_LINE 00000082 "      }"
NSQ_SOURCE_LINE 00000083 "      if ($requires_2_0) { # for better recommends support"
NSQ_SOURCE_LINE 00000084 "          # stash prereqs, which is already converted"
NSQ_SOURCE_LINE 00000085 "          my $tmp_prereqs = delete $params{META_MERGE}{prereqs};"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "          require CPAN::Meta::Converter;"
NSQ_SOURCE_LINE 00000088 "          for my $key (qw/META_ADD META_MERGE/) {"
NSQ_SOURCE_LINE 00000089 "              next unless %{$params{$key} || {}};"
NSQ_SOURCE_LINE 00000090 "              my $converter = CPAN::Meta::Converter->new($params{$key}, default_version => 1.4);"
NSQ_SOURCE_LINE 00000091 "              $params{$key} = $converter->upgrade_fragment;"
NSQ_SOURCE_LINE 00000092 "          }"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "          if ($params{META_MERGE}{prereqs}) {"
NSQ_SOURCE_LINE 00000095 "              require CPAN::Meta::Requirements;"
NSQ_SOURCE_LINE 00000096 "              for my $phase (keys %{$tmp_prereqs || {}}) {"
NSQ_SOURCE_LINE 00000097 "                  for my $rel (keys %{$tmp_prereqs->{$phase} || {}}) {"
NSQ_SOURCE_LINE 00000098 "                     my $req1 = CPAN::Meta::Requirements->from_string_hash($tmp_prereqs->{$phase}{$rel});"
NSQ_SOURCE_LINE 00000099 "                     my $req2 = CPAN::Meta::Requirements->from_string_hash($params{META_MERGE}{prereqs}{$phase}{$rel});"
NSQ_SOURCE_LINE 00000100 "                     $req1->add_requirements($req2);"
NSQ_SOURCE_LINE 00000101 "                     $params{META_MERGE}{prereqs}{$phase} = $req1->as_string_hash;"
NSQ_SOURCE_LINE 00000102 "                  }"
NSQ_SOURCE_LINE 00000103 "              }"
NSQ_SOURCE_LINE 00000104 "          } else {"
NSQ_SOURCE_LINE 00000105 "              $params{META_MERGE}{prereqs} = $tmp_prereqs;"
NSQ_SOURCE_LINE 00000106 "          }"
NSQ_SOURCE_LINE 00000107 "      }"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "      # XXX: better to use also META_MERGE when applicable?"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "      # As a small bonus, remove params that the installed version"
NSQ_SOURCE_LINE 00000112 "      # of EUMM doesn't know, so that we can always write them"
NSQ_SOURCE_LINE 00000113 "      # in Makefile.PL without caring about EUMM version."
NSQ_SOURCE_LINE 00000114 "      # (EUMM warns if it finds unknown parameters.)"
NSQ_SOURCE_LINE 00000115 "      # As EUMM 6.17 is our prereq, we can safely ignore the keys"
NSQ_SOURCE_LINE 00000116 "      # defined before 6.17."
NSQ_SOURCE_LINE 00000117 "      {"
NSQ_SOURCE_LINE 00000118 "        last if _eumm('6.66_03');"
NSQ_SOURCE_LINE 00000119 "        if (my $r = delete $params{TEST_REQUIRES}) {"
NSQ_SOURCE_LINE 00000120 "          _merge(\\%params, $r, 'BUILD_REQUIRES');"
NSQ_SOURCE_LINE 00000121 "        }"
NSQ_SOURCE_LINE 00000122 "        last if _eumm('6.56');"
NSQ_SOURCE_LINE 00000123 "        if (my $r = delete $params{BUILD_REQUIRES}) {"
NSQ_SOURCE_LINE 00000124 "          _merge(\\%params, $r, 'PREREQ_PM');"
NSQ_SOURCE_LINE 00000125 "        }"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "        last if _eumm('6.52');"
NSQ_SOURCE_LINE 00000128 "        delete $params{CONFIGURE_REQUIRES};"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "        last if _eumm('6.47_01');"
NSQ_SOURCE_LINE 00000131 "        delete $params{MIN_PERL_VERSION};"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "        last if _eumm('6.45_01');"
NSQ_SOURCE_LINE 00000134 "        delete $params{META_ADD};"
NSQ_SOURCE_LINE 00000135 "        delete $params{META_MERGE};"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "        last if _eumm('6.30_01');"
NSQ_SOURCE_LINE 00000138 "        delete $params{LICENSE};"
NSQ_SOURCE_LINE 00000139 "      }"
NSQ_SOURCE_LINE 00000140 "    } else {"
NSQ_SOURCE_LINE 00000141 "        print \"cpanfile is not available: $@\\n\";"
NSQ_SOURCE_LINE 00000142 "        exit 0; # N/A"
NSQ_SOURCE_LINE 00000143 "    }"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "    $orig->(%params);"
NSQ_SOURCE_LINE 00000146 "  };"
NSQ_SOURCE_LINE 00000147 "  {"
NSQ_SOURCE_LINE 00000148 "    no warnings 'redefine';"
NSQ_SOURCE_LINE 00000149 "    *main::WriteMakefile ="
NSQ_SOURCE_LINE 00000150 "    *ExtUtils::MakeMaker::WriteMakefile = $writer;"
NSQ_SOURCE_LINE 00000151 "  }"
NSQ_SOURCE_LINE 00000152 "}"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "sub _eumm {"
NSQ_SOURCE_LINE 00000155 "  my $version = shift;"
NSQ_SOURCE_LINE 00000156 "  eval { ExtUtils::MakeMaker->VERSION($version) } ? 1 : 0;"
NSQ_SOURCE_LINE 00000157 "}"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "sub _get {"
NSQ_SOURCE_LINE 00000160 "  my $prereqs = shift;"
NSQ_SOURCE_LINE 00000161 "  eval { $prereqs->requirements_for(@_)->as_string_hash };"
NSQ_SOURCE_LINE 00000162 "}"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "sub _merge {"
NSQ_SOURCE_LINE 00000165 "  my ($params, $requires, $key) = @_;"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "  return unless $key;"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "  for (keys %{$requires || {}}) {"
NSQ_SOURCE_LINE 00000170 "    my $version = _normalize_version($requires->{$_});"
NSQ_SOURCE_LINE 00000171 "    next unless defined $version;"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "    if (not exists $params->{$key}{$_}) {"
NSQ_SOURCE_LINE 00000174 "      $params->{$key}{$_} = $version;"
NSQ_SOURCE_LINE 00000175 "    } else {"
NSQ_SOURCE_LINE 00000176 "      my $prev = $params->{$key}{$_};"
NSQ_SOURCE_LINE 00000177 "      if (version->parse($prev) < version->parse($version)) {"
NSQ_SOURCE_LINE 00000178 "        $params->{$key}{$_} = $version;"
NSQ_SOURCE_LINE 00000179 "      }"
NSQ_SOURCE_LINE 00000180 "    }"
NSQ_SOURCE_LINE 00000181 "  }"
NSQ_SOURCE_LINE 00000182 "}"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "sub _normalize_version {"
NSQ_SOURCE_LINE 00000185 "  my $version = shift;"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "  # shortcuts"
NSQ_SOURCE_LINE 00000188 "  return unless defined $version;"
NSQ_SOURCE_LINE 00000189 "  return $version unless $version =~ /\\s/;"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "  # TODO: better range handling"
NSQ_SOURCE_LINE 00000192 "  $version =~ s/(?:>=|==)\\s*//;"
NSQ_SOURCE_LINE 00000193 "  $version =~ s/,.+$//;"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "  return $version unless $version =~ /\\s/;"
NSQ_SOURCE_LINE 00000196 "  return;"
NSQ_SOURCE_LINE 00000197 "}"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "1;"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "__END__"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "=encoding utf-8"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "=head1 NAME"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "ExtUtils::MakeMaker::CPANfile - cpanfile support for EUMM"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "    # Makefile.PL"
NSQ_SOURCE_LINE 00000212 "    use ExtUtils::MakeMaker::CPANfile;"
NSQ_SOURCE_LINE 00000213 "    "
NSQ_SOURCE_LINE 00000214 "    WriteMakefile("
NSQ_SOURCE_LINE 00000215 "      NAME => 'Foo::Bar',"
NSQ_SOURCE_LINE 00000216 "      AUTHOR => 'A.U.Thor <author@cpan.org>',"
NSQ_SOURCE_LINE 00000217 "    );"
NSQ_SOURCE_LINE 00000218 "    "
NSQ_SOURCE_LINE 00000219 "    # cpanfile"
NSQ_SOURCE_LINE 00000220 "    requires 'ExtUtils::MakeMaker' => '6.17';"
NSQ_SOURCE_LINE 00000221 "    on test => sub {"
NSQ_SOURCE_LINE 00000222 "      requires 'Test::More' => '0.88';"
NSQ_SOURCE_LINE 00000223 "    };"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "ExtUtils::MakeMaker::CPANfile loads C<cpanfile> in your distribution"
NSQ_SOURCE_LINE 00000228 "and modifies parameters for C<WriteMakefile> in your Makefile.PL."
NSQ_SOURCE_LINE 00000229 "Just use it instead of L<ExtUtils::MakeMaker> (which should be"
NSQ_SOURCE_LINE 00000230 "loaded internally), and prepare C<cpanfile>."
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "As of version 0.03, ExtUtils::MakeMaker::CPANfile also removes"
NSQ_SOURCE_LINE 00000233 "WriteMakefile parameters that the installed version of"
NSQ_SOURCE_LINE 00000234 "ExtUtils::MakeMaker doesn't know, to avoid warnings."
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "=head1 LIMITATION"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "=head2 complex version ranges"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "As of this writing, complex version ranges are simply ignored."
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "=head2 dynamic config"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "Strictly speaking, C<cpanfile> is a Perl script, and may have some"
NSQ_SOURCE_LINE 00000245 "conditions in it. That said, you don't need to run Makefile.PL"
NSQ_SOURCE_LINE 00000246 "to determine prerequisites in most cases. Hence, as of 0.06,"
NSQ_SOURCE_LINE 00000247 "ExtUtils::MakeMaker::CPANfile sets C<dynamic_config> to false"
NSQ_SOURCE_LINE 00000248 "by default. If you do need a CPAN installer to run Makefile.PL"
NSQ_SOURCE_LINE 00000249 "to customize prerequisites dynamically, set C<dynamic_config>"
NSQ_SOURCE_LINE 00000250 "to true explicitly (via META_ADD/META_MERGE)."
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "=head1 FOR MODULE AUTHORS"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "Though the minimum version requirement of ExtUtils::MakeMaker is"
NSQ_SOURCE_LINE 00000255 "arbitrary set to 6.17 (the one bundled in Perl 5.8.1), you need"
NSQ_SOURCE_LINE 00000256 "at least EUMM 6.52 (with CONFIGURE_REQUIRES support) when you"
NSQ_SOURCE_LINE 00000257 "release a distribution."
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "=head1 LICENSE"
NSQ_SOURCE_LINE 00000260 ""
