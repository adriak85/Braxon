NSQ_SOURCE_LINE 00000264 "it under the same terms as Perl itself."
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "Kenichi Ishigaki E<lt>ishigaki@cpan.orgE<gt>"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "=cut"
NSQ_SOURCE_LINE 00000271 ""
BODY_END
