NSQ_SOURCE_LINE 00000001 "package Net::DNS;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "our $VERSION;"
NSQ_SOURCE_LINE 00000007 "$VERSION = '1.54';"
NSQ_SOURCE_LINE 00000008 "$VERSION = eval {$VERSION};"
NSQ_SOURCE_LINE 00000009 "our $SVNVERSION = (qw$Id: DNS.pm 2045 2026-01-16 12:30:12Z willem $)[2];"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "=head1 NAME"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "Net::DNS - Perl Interface to the Domain Name System"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "\tuse Net::DNS;"
NSQ_SOURCE_LINE 00000019 "\tmy $resolver = Net::DNS::Resolver->new(...);"
NSQ_SOURCE_LINE 00000020 "\tmy $response = $resolver->send(...);"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "Net::DNS is a collection of Perl modules that act as a Domain Name System"
NSQ_SOURCE_LINE 00000025 "(DNS) resolver. It allows the programmer to perform DNS queries that are"
NSQ_SOURCE_LINE 00000026 "beyond the capabilities of \"gethostbyname\" and \"gethostbyaddr\"."
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "The programmer should be familiar with the structure of a DNS packet"
NSQ_SOURCE_LINE 00000029 "and the zone file presentation format described in RFC1035."
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "=cut"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "use integer;"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "use base qw(Exporter);"
NSQ_SOURCE_LINE 00000037 "our @EXPORT = qw(SEQUENTIAL UNIXTIME YYYYMMDDxx"
NSQ_SOURCE_LINE 00000038 "\t\tyxrrset nxrrset yxdomain nxdomain rr_add rr_del"
NSQ_SOURCE_LINE 00000039 "\t\tmx rr rrsort);"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "local $SIG{__DIE__};"
NSQ_SOURCE_LINE 00000043 "require Net::DNS::Resolver;"
NSQ_SOURCE_LINE 00000044 "require Net::DNS::Packet;"
NSQ_SOURCE_LINE 00000045 "require Net::DNS::RR;"
NSQ_SOURCE_LINE 00000046 "require Net::DNS::Update;"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "sub version { return $VERSION; }"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "#"
NSQ_SOURCE_LINE 00000053 "# rr()"
NSQ_SOURCE_LINE 00000054 "#"
NSQ_SOURCE_LINE 00000055 "# Usage:"
NSQ_SOURCE_LINE 00000056 "#\t@rr = rr('example.com');"
NSQ_SOURCE_LINE 00000057 "#\t@rr = rr('example.com', 'A', 'IN');"
NSQ_SOURCE_LINE 00000058 "#\t@rr = rr($res, 'example.com' ... );"
NSQ_SOURCE_LINE 00000059 "#"
NSQ_SOURCE_LINE 00000060 "sub rr {"
NSQ_SOURCE_LINE 00000061 "\tmy @arg = @_;"
NSQ_SOURCE_LINE 00000062 "\tmy $res = ( ref( $arg[0] ) ? shift @arg : Net::DNS::Resolver->new() );"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "\tmy $reply = $res->query(@arg);"
NSQ_SOURCE_LINE 00000065 "\tmy @list  = $reply ? $reply->answer : ();"
NSQ_SOURCE_LINE 00000066 "\treturn @list;"
NSQ_SOURCE_LINE 00000067 "}"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "#"
NSQ_SOURCE_LINE 00000071 "# mx()"
NSQ_SOURCE_LINE 00000072 "#"
NSQ_SOURCE_LINE 00000073 "# Usage:"
NSQ_SOURCE_LINE 00000074 "#\t@mx = mx('example.com');"
NSQ_SOURCE_LINE 00000075 "#\t@mx = mx($res, 'example.com');"
NSQ_SOURCE_LINE 00000076 "#"
NSQ_SOURCE_LINE 00000077 "sub mx {"
NSQ_SOURCE_LINE 00000078 "\tmy @arg = @_;"
NSQ_SOURCE_LINE 00000079 "\tmy @res = ( ref( $arg[0] ) ? shift @arg : () );"
NSQ_SOURCE_LINE 00000080 "\tmy ( $name, @class ) = @arg;"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "\t# This construct is best read backwards."
NSQ_SOURCE_LINE 00000083 "\t#"
NSQ_SOURCE_LINE 00000084 "\t# First we take the answer section of the packet."
NSQ_SOURCE_LINE 00000085 "\t# Then we take just the MX records from that list"
NSQ_SOURCE_LINE 00000086 "\t# Then we sort the list by preference"
NSQ_SOURCE_LINE 00000087 "\t# We do this into an array to force list context."
NSQ_SOURCE_LINE 00000088 "\t# Then we return the list."
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "\tmy @list = sort { $a->preference <=> $b->preference }"
NSQ_SOURCE_LINE 00000091 "\t\t\tgrep { $_->type eq 'MX' } &rr( @res, $name, 'MX', @class );"
NSQ_SOURCE_LINE 00000092 "\treturn @list;"
NSQ_SOURCE_LINE 00000093 "}"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "#"
NSQ_SOURCE_LINE 00000097 "# rrsort()"
NSQ_SOURCE_LINE 00000098 "#"
NSQ_SOURCE_LINE 00000099 "# Usage:"
NSQ_SOURCE_LINE 00000100 "#    @prioritysorted = rrsort( \"SRV\", \"priority\", @rr_array );"
NSQ_SOURCE_LINE 00000101 "#"
NSQ_SOURCE_LINE 00000102 "sub rrsort {"
NSQ_SOURCE_LINE 00000103 "\tmy @arg\t   = @_;"
NSQ_SOURCE_LINE 00000104 "\tmy $rrtype = uc shift @arg;"
NSQ_SOURCE_LINE 00000105 "\tmy ( $attribute, @rr ) = @arg;\t## NB: attribute is optional"
NSQ_SOURCE_LINE 00000106 "\t( @rr, $attribute ) = @arg if ref($attribute) =~ /^Net::DNS::RR/;"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "\tmy @extracted = grep { $_->type eq $rrtype } @rr;"
NSQ_SOURCE_LINE 00000109 "\treturn @extracted unless scalar @extracted;"
NSQ_SOURCE_LINE 00000110 "\tmy $func   = \"Net::DNS::RR::$rrtype\"->get_rrsort_func($attribute);"
NSQ_SOURCE_LINE 00000111 "\tmy @sorted = sort $func @extracted;"
NSQ_SOURCE_LINE 00000112 "\treturn @sorted;"
NSQ_SOURCE_LINE 00000113 "}"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "#"
NSQ_SOURCE_LINE 00000117 "# Auxiliary functions to support policy-driven zone serial numbering."
NSQ_SOURCE_LINE 00000118 "#"
NSQ_SOURCE_LINE 00000119 "#\t$successor = $soa->serial(SEQUENTIAL);"
NSQ_SOURCE_LINE 00000120 "#\t$successor = $soa->serial(UNIXTIME);"
NSQ_SOURCE_LINE 00000121 "#\t$successor = $soa->serial(YYYYMMDDxx);"
NSQ_SOURCE_LINE 00000122 "#"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "sub SEQUENTIAL { return (undef) }"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "sub UNIXTIME { return CORE::time; }"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "sub YYYYMMDDxx {"
NSQ_SOURCE_LINE 00000129 "\tmy ( $dd, $mm, $yy ) = (localtime)[3 .. 5];"
NSQ_SOURCE_LINE 00000130 "\treturn 1900010000 + sprintf '%d%0.2d%0.2d00', $yy, $mm, $dd;"
NSQ_SOURCE_LINE 00000131 "}"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "#"
NSQ_SOURCE_LINE 00000135 "# Auxiliary functions to support dynamic update."
NSQ_SOURCE_LINE 00000136 "#"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "sub yxrrset {"
NSQ_SOURCE_LINE 00000139 "\tmy @arg = @_;"
NSQ_SOURCE_LINE 00000140 "\tmy $rr\t= Net::DNS::RR->new(@arg);"
NSQ_SOURCE_LINE 00000141 "\t$rr->ttl(0);"
NSQ_SOURCE_LINE 00000142 "\t$rr->class('ANY') unless $rr->rdata;"
NSQ_SOURCE_LINE 00000143 "\treturn $rr;"
NSQ_SOURCE_LINE 00000144 "}"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "sub nxrrset {"
NSQ_SOURCE_LINE 00000147 "\tmy @arg = @_;"
NSQ_SOURCE_LINE 00000148 "\tmy $rr\t= Net::DNS::RR->new(@arg);"
NSQ_SOURCE_LINE 00000149 "\treturn Net::DNS::RR->new("
NSQ_SOURCE_LINE 00000150 "\t\tname  => $rr->name,"
NSQ_SOURCE_LINE 00000151 "\t\ttype  => $rr->type,"
NSQ_SOURCE_LINE 00000152 "\t\tclass => 'NONE'"
NSQ_SOURCE_LINE 00000153 "\t\t);"
NSQ_SOURCE_LINE 00000154 "}"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "sub yxdomain {"
NSQ_SOURCE_LINE 00000157 "\tmy @arg = @_;"
NSQ_SOURCE_LINE 00000158 "\tmy ( $domain, @etc ) = map {split} @arg;"
NSQ_SOURCE_LINE 00000159 "\tmy $rr = Net::DNS::RR->new( scalar(@etc) ? @arg : ( name => $domain ) );"
NSQ_SOURCE_LINE 00000160 "\treturn Net::DNS::RR->new("
NSQ_SOURCE_LINE 00000161 "\t\tname  => $rr->name,"
NSQ_SOURCE_LINE 00000162 "\t\ttype  => 'ANY',"
NSQ_SOURCE_LINE 00000163 "\t\tclass => 'ANY'"
NSQ_SOURCE_LINE 00000164 "\t\t);"
NSQ_SOURCE_LINE 00000165 "}"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "sub nxdomain {"
NSQ_SOURCE_LINE 00000168 "\tmy @arg = @_;"
NSQ_SOURCE_LINE 00000169 "\tmy ( $domain, @etc ) = map {split} @arg;"
NSQ_SOURCE_LINE 00000170 "\tmy $rr = Net::DNS::RR->new( scalar(@etc) ? @arg : ( name => $domain ) );"
NSQ_SOURCE_LINE 00000171 "\treturn Net::DNS::RR->new("
NSQ_SOURCE_LINE 00000172 "\t\tname  => $rr->name,"
NSQ_SOURCE_LINE 00000173 "\t\ttype  => 'ANY',"
NSQ_SOURCE_LINE 00000174 "\t\tclass => 'NONE'"
NSQ_SOURCE_LINE 00000175 "\t\t);"
NSQ_SOURCE_LINE 00000176 "}"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "sub rr_add {"
NSQ_SOURCE_LINE 00000179 "\tmy @arg = @_;"
NSQ_SOURCE_LINE 00000180 "\tmy $rr\t= Net::DNS::RR->new(@arg);"
NSQ_SOURCE_LINE 00000181 "\t$rr->{ttl} = 86400 unless defined $rr->{ttl};"
NSQ_SOURCE_LINE 00000182 "\treturn $rr;"
NSQ_SOURCE_LINE 00000183 "}"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "sub rr_del {"
NSQ_SOURCE_LINE 00000186 "\tmy @arg = @_;"
NSQ_SOURCE_LINE 00000187 "\tmy ( $domain, @etc ) = map {split} @arg;"
NSQ_SOURCE_LINE 00000188 "\tmy $rr = Net::DNS::RR->new( scalar(@etc) ? @arg : ( name => $domain, type => 'ANY' ) );"
NSQ_SOURCE_LINE 00000189 "\t$rr->class( $rr->rdata ? 'NONE' : 'ANY' );"
NSQ_SOURCE_LINE 00000190 "\t$rr->ttl(0);"
NSQ_SOURCE_LINE 00000191 "\treturn $rr;"
NSQ_SOURCE_LINE 00000192 "}"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "1;"
NSQ_SOURCE_LINE 00000196 "__END__"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "=head2 Resolver Objects"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "A resolver object is an instance of the L<Net::DNS::Resolver> class."
NSQ_SOURCE_LINE 00000203 "A program may have multiple resolver objects, each maintaining its"
NSQ_SOURCE_LINE 00000204 "own state information such as the nameservers to be queried, whether"
NSQ_SOURCE_LINE 00000205 "recursion is desired, etc."
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "=head2 Packet Objects"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "L<Net::DNS::Resolver> queries return L<Net::DNS::Packet> objects."
NSQ_SOURCE_LINE 00000211 "A packet object has five sections:"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "=over 3"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "=item *"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "header, represented by a L<Net::DNS::Header> object"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "=item *"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "question, a list of no more than one L<Net::DNS::Question> object"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "=item *"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "answer, a list of L<Net::DNS::RR> objects"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "=item *"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "authority, a list of L<Net::DNS::RR> objects"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "=item *"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "additional, a list of L<Net::DNS::RR> objects"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "=back"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "=head2 Update Objects"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "L<Net::DNS::Update> is a subclass of L<Net::DNS::Packet>"
NSQ_SOURCE_LINE 00000240 "useful for creating dynamic update requests."
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "=head2 Header Object"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "The L<Net::DNS::Header> object mediates access to the header data"
NSQ_SOURCE_LINE 00000245 "which resides within the corresponding L<Net::DNS::Packet>."
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "=head2 Question Object"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "The L<Net::DNS::Question> object represents the content of the question"
NSQ_SOURCE_LINE 00000250 "section of the DNS packet."
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "=head2 RR Objects"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "L<Net::DNS::RR> is the base class for DNS resource record (RR) objects"
NSQ_SOURCE_LINE 00000255 "in the answer, authority, and additional sections of a DNS packet."
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "Do not assume that RR objects will be of the type requested."
NSQ_SOURCE_LINE 00000258 "The type of an RR object must be checked before calling any methods."
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "=head1 METHODS"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "Net::DNS exports methods and auxiliary functions to support"
NSQ_SOURCE_LINE 00000264 "DNS updates, zone serial number management, and simple DNS queries."
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "=head2 version"
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "\tuse Net::DNS;"
NSQ_SOURCE_LINE 00000269 "\tprint Net::DNS->version, \"\\n\";"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "Returns the version of Net::DNS."
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "=head2 rr"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "\t# Use a default resolver -- can not get an error string this way."
NSQ_SOURCE_LINE 00000277 "\tuse Net::DNS;"
NSQ_SOURCE_LINE 00000278 "\tmy @rr = rr(\"example.com\");"
NSQ_SOURCE_LINE 00000279 "\tmy @rr = rr(\"example.com\", \"AAAA\");"
NSQ_SOURCE_LINE 00000280 "\tmy @rr = rr(\"example.com\", \"AAAA\", \"IN\");"
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "\t# Use your own resolver object."
NSQ_SOURCE_LINE 00000283 "\tmy $res = Net::DNS::Resolver->new;"
NSQ_SOURCE_LINE 00000284 "\tmy @rr  = rr($res, \"example.com\" ... );"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "\tmy ($ptr) = rr(\"2001:DB8::dead:beef\");"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "The C<rr()> method provides simple RR lookup for scenarios where"
NSQ_SOURCE_LINE 00000289 "the full flexibility of Net::DNS is not required."
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "Returns a list of L<Net::DNS::RR> objects for the specified name"
NSQ_SOURCE_LINE 00000292 "or an empty list if the query failed or no record was found."
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "See L</EXAMPLES> for more complete examples."
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "=head2 mx"
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "\t# Use a default resolver -- can not get an error string this way."
NSQ_SOURCE_LINE 00000300 "\tuse Net::DNS;"
NSQ_SOURCE_LINE 00000301 "\tmy @mx = mx(\"example.com\");"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "\t# Use your own resolver object."
NSQ_SOURCE_LINE 00000304 "\tmy $res = Net::DNS::Resolver->new;"
NSQ_SOURCE_LINE 00000305 "\tmy @mx  = mx($res, \"example.com\");"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "Returns a list of L<Net::DNS::RR::MX> objects representing the MX"
NSQ_SOURCE_LINE 00000308 "records for the specified name."
NSQ_SOURCE_LINE 00000309 "The list will be sorted by preference."
NSQ_SOURCE_LINE 00000310 "Returns an empty list if the query failed or no MX record was found."
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "This method does not look up address records; it resolves MX only."
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "=head1 Dynamic DNS Update Support"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "The Net::DNS module provides auxiliary functions which support"
NSQ_SOURCE_LINE 00000318 "dynamic DNS update requests."
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "\t$update = Net::DNS::Update->new( 'example.com' );"
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "\t$update->push( prereq => nxrrset('example.com. AAAA') );"
NSQ_SOURCE_LINE 00000323 "\t$update->push( update => rr_add('example.com. 86400 AAAA 2001:DB8::F00') );"
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "=head2 yxrrset"
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "Use this method to add an \"RRset exists\" prerequisite to a dynamic"
NSQ_SOURCE_LINE 00000328 "update packet.\tThere are two forms, value-independent and"
NSQ_SOURCE_LINE 00000329 "value-dependent:"
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "\t# RRset exists (value-independent)"
NSQ_SOURCE_LINE 00000332 "\t$update->push( pre => yxrrset(\"host.example.com AAAA\") );"
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "Meaning:  At least one RR with the specified name and type must exist."
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "\t# RRset exists (value-dependent)"
NSQ_SOURCE_LINE 00000337 "\t$update->push( pre => yxrrset(\"host.example.com AAAA 2001:DB8::1\") );"
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "Meaning:  At least one RR with the specified name and type must"
NSQ_SOURCE_LINE 00000340 "exist and must have matching data."
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "Returns a L<Net::DNS::RR> object or C<undef> if the object could not"
NSQ_SOURCE_LINE 00000343 "be created."
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "=head2 nxrrset"
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "Use this method to add an \"RRset does not exist\" prerequisite to"
NSQ_SOURCE_LINE 00000348 "a dynamic update packet."
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "\t$update->push( pre => nxrrset(\"host.example.com AAAA\") );"
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "Meaning:  No RRs with the specified name and type can exist."
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "Returns a L<Net::DNS::RR> object or C<undef> if the object could not"
NSQ_SOURCE_LINE 00000355 "be created."
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "=head2 yxdomain"
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "Use this method to add a \"name is in use\" prerequisite to a dynamic"
NSQ_SOURCE_LINE 00000360 "update packet."
NSQ_SOURCE_LINE 00000361 ""
NSQ_SOURCE_LINE 00000362 "\t$update->push( pre => yxdomain(\"host.example.com\") );"
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "Meaning:  At least one RR with the specified name must exist."
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "Returns a L<Net::DNS::RR> object or C<undef> if the object could not"
NSQ_SOURCE_LINE 00000367 "be created."
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "=head2 nxdomain"
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "Use this method to add a \"name is not in use\" prerequisite to a"
NSQ_SOURCE_LINE 00000372 "dynamic update packet."
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "\t$update->push( pre => nxdomain(\"host.example.com\") );"
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "Meaning:  No RR with the specified name can exist."
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 "Returns a L<Net::DNS::RR> object or C<undef> if the object could not"
NSQ_SOURCE_LINE 00000379 "be created."
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "=head2 rr_add"
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "Use this method to add RRs to a zone."
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "\t$update->push( update => rr_add(\"host.example.com AAAA 2001:DB8::c001:a1e\") );"
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "Meaning:  Add this RR to the zone."
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "RR objects created by this method should be added to the \"update\""
NSQ_SOURCE_LINE 00000390 "section of a dynamic update packet.  The TTL defaults to 86400"
NSQ_SOURCE_LINE 00000391 "seconds (24 hours) if not specified."
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "Returns a L<Net::DNS::RR> object or C<undef> if the object could not"
NSQ_SOURCE_LINE 00000394 "be created."
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "=head2 rr_del"
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "Use this method to delete RRs from a zone.  There are three forms:"
NSQ_SOURCE_LINE 00000399 "delete all RRsets, delete an RRset, and delete a specific RR."
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "\t# Delete all RRsets."
NSQ_SOURCE_LINE 00000402 "\t$update->push( update => rr_del(\"host.example.com\") );"
NSQ_SOURCE_LINE 00000403 ""
NSQ_SOURCE_LINE 00000404 "Meaning:  Delete all RRs having the specified name."
NSQ_SOURCE_LINE 00000405 ""
NSQ_SOURCE_LINE 00000406 "\t# Delete an RRset."
NSQ_SOURCE_LINE 00000407 "\t$update->push( update => rr_del(\"host.example.com AAAA\") );"
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "Meaning:  Delete all RRs having the specified name and type."
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "\t# Delete a specific RR."
NSQ_SOURCE_LINE 00000412 "\t$update->push( update => rr_del(\"host.example.com AAAA 2001:DB8::dead:beef\") );"
NSQ_SOURCE_LINE 00000413 ""
NSQ_SOURCE_LINE 00000414 "Meaning:  Delete the RR which matches the specified argument."
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "RR objects created by this method should be added to the \"update\""
NSQ_SOURCE_LINE 00000417 "section of a dynamic update packet."
NSQ_SOURCE_LINE 00000418 ""
NSQ_SOURCE_LINE 00000419 "Returns a L<Net::DNS::RR> object or C<undef> if the object could not"
NSQ_SOURCE_LINE 00000420 "be created."
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "=head1 Zone Serial Number Management"
NSQ_SOURCE_LINE 00000424 ""
NSQ_SOURCE_LINE 00000425 "The Net::DNS module provides auxiliary functions which support"
NSQ_SOURCE_LINE 00000426 "policy-driven zone serial numbering regimes."
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "\t$soa->serial(SEQUENTIAL);"
NSQ_SOURCE_LINE 00000429 "\t$soa->serial(YYYMMDDxx);"
NSQ_SOURCE_LINE 00000430 ""
NSQ_SOURCE_LINE 00000431 "=head2 SEQUENTIAL"
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "\t$successor = $soa->serial( SEQUENTIAL );"
NSQ_SOURCE_LINE 00000434 ""
NSQ_SOURCE_LINE 00000435 "The existing serial number is incremented modulo 2**32."
NSQ_SOURCE_LINE 00000436 ""
NSQ_SOURCE_LINE 00000437 "=head2 UNIXTIME"
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "\t$successor = $soa->serial( UNIXTIME );"
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "The Unix time scale will be used as the basis for zone serial"
NSQ_SOURCE_LINE 00000442 "numbering. The serial number will be incremented if the time"
NSQ_SOURCE_LINE 00000443 "elapsed since the previous update is less than one second."
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "=head2 YYYYMMDDxx"
NSQ_SOURCE_LINE 00000446 ""
NSQ_SOURCE_LINE 00000447 "\t$successor = $soa->serial( YYYYMMDDxx );"
NSQ_SOURCE_LINE 00000448 ""
NSQ_SOURCE_LINE 00000449 "The 32 bit value returned by the auxiliary C<YYYYMMDDxx()> function"
NSQ_SOURCE_LINE 00000450 "will be used as the base for the date-coded zone serial number."
NSQ_SOURCE_LINE 00000451 "Serial number increments must be limited to 100 per day for the"
NSQ_SOURCE_LINE 00000452 "date information to remain useful."
NSQ_SOURCE_LINE 00000453 ""
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 ""
NSQ_SOURCE_LINE 00000456 "=head1 Sorting of RR arrays"
NSQ_SOURCE_LINE 00000457 ""
NSQ_SOURCE_LINE 00000458 "C<rrsort()> provides functionality to help you sort RR arrays. In most cases"
NSQ_SOURCE_LINE 00000459 "this will give you the result that you expect, but you can specify your"
NSQ_SOURCE_LINE 00000460 "own sorting method by using the C<< Net::DNS::RR::FOO->set_rrsort_func() >>"
NSQ_SOURCE_LINE 00000461 "class method. See L<Net::DNS::RR> for details."
NSQ_SOURCE_LINE 00000462 ""
NSQ_SOURCE_LINE 00000463 "=head2 rrsort"
NSQ_SOURCE_LINE 00000464 ""
NSQ_SOURCE_LINE 00000465 "\tuse Net::DNS;"
NSQ_SOURCE_LINE 00000466 "\tmy @sorted = rrsort( $rrtype, $attribute, @rr_array );"
NSQ_SOURCE_LINE 00000467 ""
NSQ_SOURCE_LINE 00000468 "C<rrsort()> selects all RRs from the input array that are of the type defined"
NSQ_SOURCE_LINE 00000469 "by the first argument. Those RRs are sorted based on the attribute that is"
NSQ_SOURCE_LINE 00000470 "specified as second argument."
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "There are a number of RRs for which the sorting function is defined in the"
NSQ_SOURCE_LINE 00000473 "code."
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 "For instance:"
NSQ_SOURCE_LINE 00000476 ""
NSQ_SOURCE_LINE 00000477 "\tmy @prioritysorted = rrsort( \"SRV\", \"priority\", @rr_array );"
NSQ_SOURCE_LINE 00000478 ""
NSQ_SOURCE_LINE 00000479 "returns the SRV records sorted from lowest to highest priority and for"
NSQ_SOURCE_LINE 00000480 "equal priorities from highest to lowest weight."
NSQ_SOURCE_LINE 00000481 ""
NSQ_SOURCE_LINE 00000482 "If the function does not exist then a numerical sort on the attribute"
NSQ_SOURCE_LINE 00000483 "value is performed."
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "\tmy @portsorted = rrsort( \"SRV\", \"port\", @rr_array );"
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "If the attribute is not defined then either the C<default_sort()> function or"
NSQ_SOURCE_LINE 00000488 "\"canonical sorting\" (as defined by DNSSEC) will be used."
NSQ_SOURCE_LINE 00000489 ""
NSQ_SOURCE_LINE 00000490 "C<rrsort()> returns a sorted array containing only elements of the specified"
NSQ_SOURCE_LINE 00000491 "RR type.  Any other RR types are silently discarded."
NSQ_SOURCE_LINE 00000492 ""
NSQ_SOURCE_LINE 00000493 "C<rrsort()> returns an empty list when arguments are incorrect."
NSQ_SOURCE_LINE 00000494 ""
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "=head1 EXAMPLES"
NSQ_SOURCE_LINE 00000497 ""
NSQ_SOURCE_LINE 00000498 "The following brief examples illustrate some of the features of Net::DNS."
NSQ_SOURCE_LINE 00000499 "The documentation for individual modules and the demo scripts included"
NSQ_SOURCE_LINE 00000500 "with the distribution provide more extensive examples."
NSQ_SOURCE_LINE 00000501 ""
NSQ_SOURCE_LINE 00000502 "See L<Net::DNS::Update> for an example of performing dynamic updates."
NSQ_SOURCE_LINE 00000503 ""
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "=head2 Look up host addresses."
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "\tuse Net::DNS;"
NSQ_SOURCE_LINE 00000508 "\tmy $res   = Net::DNS::Resolver->new;"
NSQ_SOURCE_LINE 00000509 "\tmy $reply = $res->search( \"www.example.com\", \"AAAA\" );"
NSQ_SOURCE_LINE 00000510 "\tdie \"query failed: \", $res->errorstring unless $reply;"
NSQ_SOURCE_LINE 00000511 ""
NSQ_SOURCE_LINE 00000512 "\tforeach my $rr ( $reply->answer ) {"
NSQ_SOURCE_LINE 00000513 "\t\tprint $rr->address, \"\\n\" if $rr->can(\"address\");"
NSQ_SOURCE_LINE 00000514 "\t}"
NSQ_SOURCE_LINE 00000515 ""
NSQ_SOURCE_LINE 00000516 ""
NSQ_SOURCE_LINE 00000517 "=head2 Find the nameservers for a domain."
NSQ_SOURCE_LINE 00000518 ""
NSQ_SOURCE_LINE 00000519 "\tuse Net::DNS;"
NSQ_SOURCE_LINE 00000520 "\tmy $res   = Net::DNS::Resolver->new;"
NSQ_SOURCE_LINE 00000521 "\tmy $reply = $res->query( \"example.com\", \"NS\");"
NSQ_SOURCE_LINE 00000522 "\tdie \"query failed: \", $res->errorstring unless $reply;"
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 "\tforeach $rr ( grep {$_->type eq \"NS\"} $reply->answer ) {"
NSQ_SOURCE_LINE 00000525 "\t\tprint $rr->nsdname, \"\\n\";"
NSQ_SOURCE_LINE 00000526 "\t}"
NSQ_SOURCE_LINE 00000527 ""
NSQ_SOURCE_LINE 00000528 ""
NSQ_SOURCE_LINE 00000529 "=head2 Find the MX records for a domain."
NSQ_SOURCE_LINE 00000530 ""
NSQ_SOURCE_LINE 00000531 "\tuse Net::DNS;"
NSQ_SOURCE_LINE 00000532 "\tmy $name = \"example.com\";"
NSQ_SOURCE_LINE 00000533 "\tmy $res  = Net::DNS::Resolver->new;"
NSQ_SOURCE_LINE 00000534 "\tmy @mx   = mx( $res, $name );"
NSQ_SOURCE_LINE 00000535 ""
NSQ_SOURCE_LINE 00000536 "\tforeach $rr (@mx) {"
NSQ_SOURCE_LINE 00000537 "\t\tprint $rr->preference, \"\\t\", $rr->exchange, \"\\n\";"
NSQ_SOURCE_LINE 00000538 "\t}"
NSQ_SOURCE_LINE 00000539 ""
NSQ_SOURCE_LINE 00000540 ""
NSQ_SOURCE_LINE 00000541 "=head2 Print domain SOA record in zone file format."
NSQ_SOURCE_LINE 00000542 ""
NSQ_SOURCE_LINE 00000543 "\tuse Net::DNS;"
NSQ_SOURCE_LINE 00000544 "\tmy $res   = Net::DNS::Resolver->new;"
NSQ_SOURCE_LINE 00000545 "\tmy $reply = $res->query( \"example.com\", \"SOA\" );"
NSQ_SOURCE_LINE 00000546 "\tdie \"query failed: \", $res->errorstring unless $reply;"
NSQ_SOURCE_LINE 00000547 ""
NSQ_SOURCE_LINE 00000548 "\tforeach my $rr ( $reply->answer ) {"
NSQ_SOURCE_LINE 00000549 "\t\t$rr->print;"
NSQ_SOURCE_LINE 00000550 "\t}"
NSQ_SOURCE_LINE 00000551 ""
NSQ_SOURCE_LINE 00000552 ""
NSQ_SOURCE_LINE 00000553 "=head2 Perform a zone transfer and print all the records."
NSQ_SOURCE_LINE 00000554 ""
NSQ_SOURCE_LINE 00000555 "\tuse Net::DNS;"
NSQ_SOURCE_LINE 00000556 "\tmy $res  = Net::DNS::Resolver->new("
NSQ_SOURCE_LINE 00000557 "\t\tnameservers => [\"a.iana-servers.net\", \"b.iana-servers.net\"],"
NSQ_SOURCE_LINE 00000558 "\t\ttcp_timeout => 20"
NSQ_SOURCE_LINE 00000559 "\t\t);"
NSQ_SOURCE_LINE 00000560 ""
NSQ_SOURCE_LINE 00000561 "\tmy @zone = $res->axfr(\"example.com\");"
NSQ_SOURCE_LINE 00000562 "\twarn $res->errorstring if $res->errorstring;"
NSQ_SOURCE_LINE 00000563 ""
NSQ_SOURCE_LINE 00000564 "\tforeach $rr (@zone) {"
NSQ_SOURCE_LINE 00000565 "\t\t$rr->print;"
NSQ_SOURCE_LINE 00000566 "\t}"
NSQ_SOURCE_LINE 00000567 ""
NSQ_SOURCE_LINE 00000568 ""
NSQ_SOURCE_LINE 00000569 "=head2 Perform a background query and print the reply."
NSQ_SOURCE_LINE 00000570 ""
NSQ_SOURCE_LINE 00000571 "\tuse Net::DNS;"
NSQ_SOURCE_LINE 00000572 "\tmy $res    = Net::DNS::Resolver->new;"
NSQ_SOURCE_LINE 00000573 "\t$res->udp_timeout(10);"
NSQ_SOURCE_LINE 00000574 "\t$res->tcp_timeout(20);"
NSQ_SOURCE_LINE 00000575 "\tmy $socket = $res->bgsend( \"www.example.com\", \"AAAA\" );"
NSQ_SOURCE_LINE 00000576 ""
NSQ_SOURCE_LINE 00000577 "\twhile ( $res->bgbusy($socket) ) {"
NSQ_SOURCE_LINE 00000578 "\t\t# do some work here whilst awaiting the response"
NSQ_SOURCE_LINE 00000579 "\t\t# ...and some more here"
NSQ_SOURCE_LINE 00000580 "\t}"
NSQ_SOURCE_LINE 00000581 ""
NSQ_SOURCE_LINE 00000582 "\tmy $packet = $res->bgread($socket);"
NSQ_SOURCE_LINE 00000583 "\tdie \"query failed: \", $res->errorstring unless $packet;"
NSQ_SOURCE_LINE 00000584 ""
NSQ_SOURCE_LINE 00000585 "\t$packet->print;"
NSQ_SOURCE_LINE 00000586 ""
NSQ_SOURCE_LINE 00000587 ""
NSQ_SOURCE_LINE 00000588 "=head1 BUGS"
NSQ_SOURCE_LINE 00000589 ""
NSQ_SOURCE_LINE 00000590 "Net::DNS is slow."
NSQ_SOURCE_LINE 00000591 ""
NSQ_SOURCE_LINE 00000592 "For other items to be fixed, or if you discover a bug in this"
NSQ_SOURCE_LINE 00000593 "distribution please use the CPAN bug reporting system."
