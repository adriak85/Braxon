BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package HTTP::Tinyish;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use warnings;"
NSQ_SOURCE_LINE 00000004 "use Carp ();"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "our $VERSION = '0.19';"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "our $PreferredBackend; # for tests"
NSQ_SOURCE_LINE 00000009 "our @Backends = map \"HTTP::Tinyish::$_\", qw( LWP HTTPTiny Curl Wget );"
NSQ_SOURCE_LINE 00000010 "my %configured;"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "sub new {"
NSQ_SOURCE_LINE 00000013 "    my($class, %attr) = @_;"
NSQ_SOURCE_LINE 00000014 "    bless \\%attr, $class;"
NSQ_SOURCE_LINE 00000015 "}"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "for my $method (qw/get head put post delete mirror patch/) {"
NSQ_SOURCE_LINE 00000018 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000019 "    eval <<\"HERE\";"
NSQ_SOURCE_LINE 00000020 "    sub $method {"
NSQ_SOURCE_LINE 00000021 "        my \\$self = shift;"
NSQ_SOURCE_LINE 00000022 "        \\$self->_backend_for(\\$_[0])->$method(\\@_);"
NSQ_SOURCE_LINE 00000023 "    }"
NSQ_SOURCE_LINE 00000024 "HERE"
NSQ_SOURCE_LINE 00000025 "}"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "sub request {"
NSQ_SOURCE_LINE 00000028 "    my $self = shift;"
NSQ_SOURCE_LINE 00000029 "    $self->_backend_for($_[1])->request(@_);"
NSQ_SOURCE_LINE 00000030 "}"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "sub _backend_for {"
NSQ_SOURCE_LINE 00000033 "    my($self, $url) = @_;"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "    my($scheme) = $url =~ m!^(https?):!;"
NSQ_SOURCE_LINE 00000036 "    Carp::croak \"URL Scheme '$url' not supported.\" unless $scheme;"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "    for my $backend ($self->backends) {"
NSQ_SOURCE_LINE 00000039 "        $self->configure_backend($backend) or next;"
NSQ_SOURCE_LINE 00000040 "        if ($backend->supports($scheme)) {"
NSQ_SOURCE_LINE 00000041 "            return $backend->new(%$self);"
NSQ_SOURCE_LINE 00000042 "        }"
NSQ_SOURCE_LINE 00000043 "    }"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "    Carp::croak \"No backend configured for scheme $scheme\";"
NSQ_SOURCE_LINE 00000046 "}"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "sub backends {"
NSQ_SOURCE_LINE 00000049 "    $PreferredBackend ? ($PreferredBackend) : @Backends;"
NSQ_SOURCE_LINE 00000050 "}"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "sub configure_backend {"
NSQ_SOURCE_LINE 00000053 "    my($self, $backend) = @_;"
NSQ_SOURCE_LINE 00000054 "    unless (exists $configured{$backend}) {"
NSQ_SOURCE_LINE 00000055 "        $configured{$backend} ="
NSQ_SOURCE_LINE 00000056 "          eval { require_module($backend); $backend->configure };"
NSQ_SOURCE_LINE 00000057 "    }"
NSQ_SOURCE_LINE 00000058 "    $configured{$backend};"
NSQ_SOURCE_LINE 00000059 "}"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "sub require_module {"
NSQ_SOURCE_LINE 00000062 "    local $_ = shift;"
NSQ_SOURCE_LINE 00000063 "    s!::!/!g;"
NSQ_SOURCE_LINE 00000064 "    require \"$_.pm\";"
NSQ_SOURCE_LINE 00000065 "}"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "1;"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "__END__"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "=head1 NAME"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "HTTP::Tinyish - HTTP::Tiny compatible HTTP client wrappers"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "  my $http = HTTP::Tinyish->new(agent => \"Mozilla/4.0\");"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "  my $res = $http->get(\"http://www.cpan.org/\");"
NSQ_SOURCE_LINE 00000080 "  warn $res->{status};"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "  $http->post(\"http://example.com/post\", {"
NSQ_SOURCE_LINE 00000083 "      headers => { \"Content-Type\" => \"application/x-www-form-urlencoded\" },"
NSQ_SOURCE_LINE 00000084 "      content => \"foo=bar&baz=quux\","
NSQ_SOURCE_LINE 00000085 "  });"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "  $http->mirror(\"http://www.cpan.org/modules/02packages.details.txt.gz\", \"./02packages.details.txt.gz\");"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "HTTP::Tinyish is a wrapper module for HTTP client modules"
NSQ_SOURCE_LINE 00000092 "L<LWP>, L<HTTP::Tiny> and HTTP client software C<curl> and C<wget>."
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "It provides an API compatible to HTTP::Tiny, and the implementation"
NSQ_SOURCE_LINE 00000095 "has been extracted out of L<App::cpanminus>. This module can be useful"
NSQ_SOURCE_LINE 00000096 "in a restrictive environment where you need to be able to download"
NSQ_SOURCE_LINE 00000097 "CPAN modules without an HTTPS support in built-in HTTP library."
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "=head1 BACKEND SELECTION"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "Backends are searched in the order of: L<LWP>, L<HTTP::Tiny>, C<curl>"
NSQ_SOURCE_LINE 00000102 "and C<wget>. HTTP::Tinyish will auto-detect if the backend also"
NSQ_SOURCE_LINE 00000103 "supports HTTPS, and use the appropriate backend based on the given"
NSQ_SOURCE_LINE 00000104 "URL to the request methods."
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "For example, if you only have HTTP::Tiny but without SSL related"
NSQ_SOURCE_LINE 00000107 "modules, it is possible that:"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "  my $http = HTTP::Tinyish->new;"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "  $http->get(\"http://example.com\");  # uses HTTP::Tiny"
NSQ_SOURCE_LINE 00000112 "  $http->get(\"https://example.com\"); # uses curl"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "=head1 COMPATIBILITIES"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "All request related methods such as C<get>, C<post>, C<put>,"
NSQ_SOURCE_LINE 00000117 "C<delete>, C<request>, C<patch> and C<mirror> are supported."
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "=head2 LWP"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "=over 4"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "=item *"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "L<LWP> backend requires L<LWP> 5.802 or over to be functional, and L<LWP::Protocol::https> to send HTTPS requests."
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "=item *"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "C<mirror> method doesn't consider third options hash into account (i.e. you can't override the HTTP headers)."
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "=item *"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "proxy is automatically detected from environment variables."
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "=item *"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "C<timeout>, C<max_redirect>, C<agent>, C<default_headers> and C<verify_SSL> are translated."
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "=back"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "=head2 HTTP::Tiny"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "Because the actual HTTP::Tiny backend is used, all APIs are supported."
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "=head2 Curl"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "=over"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "=item *"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "This module has been tested with curl 7.22 and later."
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "=item *"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "HTTPS support is automatically detected by running C<curl --version> and see its protocol output."
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "=item *"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "C<timeout>, C<max_redirect>, C<agent>, C<default_headers> and C<verify_SSL> are supported."
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "=back"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "=head2 Wget"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "=over 4"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "=item *"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "This module requires Wget 1.12 and later."
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "=item *"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "Wget prior to 1.15 doesn't support sending custom HTTP methods, so if you use C<< $http->put >> for example, you'll get an internal error response (599)."
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "=item *"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "HTTPS support is automatically detected."
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "=item *"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "C<mirror()> method doesn't send C<If-Modified-Since> header to the server, which will result in full-download every time because C<wget> doesn't support C<--timestamping> combined with C<-O> option."
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "=item *"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "C<timeout>, C<max_redirect>, C<agent>, C<default_headers> and C<verify_SSL> are supported."
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "=back"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "=head1 SIMILAR MODULES"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "=over 4"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "=item *"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "L<File::Fetch> - is core since 5.10. Has support for non-HTTP protocols such as ftp and git. Does not support HTTPS or basic authentication as of this writing."
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "=item *"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "L<Plient> - provides more complete runtime API, but seems only compatible on Unix environments. Does not support mirror() method."
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "=back"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "Tatsuhiko Miyagawa"
