NSQ_SOURCE_LINE 00000001 "package Proc::InvokeEditor;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use File::Temp qw(tempfile);"
NSQ_SOURCE_LINE 00000007 "use File::Spec;"
NSQ_SOURCE_LINE 00000008 "use IPC::Cmd qw(can_run);"
NSQ_SOURCE_LINE 00000009 "use Carp::Assert;"
NSQ_SOURCE_LINE 00000010 "use Fcntl;"
NSQ_SOURCE_LINE 00000011 "File::Temp->safe_level( File::Temp::HIGH );"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "require Exporter;"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "use vars qw(@ISA %EXPORT_TAGS @EXPORT_OK @EXPORT $VERSION"
NSQ_SOURCE_LINE 00000016 "            @DEFAULT_EDITORS);"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "@ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "# Items to export into callers namespace by default. Note: do not export"
NSQ_SOURCE_LINE 00000021 "# names by default without a very good reason. Use EXPORT_OK instead."
NSQ_SOURCE_LINE 00000022 "# Do not simply export all your public functions/methods/constants."
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "# This allows declaration\tuse Proc::InvokeEditor ':all';"
NSQ_SOURCE_LINE 00000025 "# If you do not need this, moving things directly into @EXPORT or @EXPORT_OK"
NSQ_SOURCE_LINE 00000026 "# will save memory."
NSQ_SOURCE_LINE 00000027 "%EXPORT_TAGS = ( 'all' => [ qw("
NSQ_SOURCE_LINE 00000028 "\t"
NSQ_SOURCE_LINE 00000029 ") ] );"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "@EXPORT_OK = ( @{ $EXPORT_TAGS{'all'} } );"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "@EXPORT = qw("
NSQ_SOURCE_LINE 00000034 "\t"
NSQ_SOURCE_LINE 00000035 ");"
NSQ_SOURCE_LINE 00000036 "$VERSION = '1.13';"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "@DEFAULT_EDITORS = ( $ENV{'VISUAL'}, $ENV{'EDITOR'}, '/usr/bin/vi',"
NSQ_SOURCE_LINE 00000039 "                     '/bin/vi', '/bin/ed',"
NSQ_SOURCE_LINE 00000040 "                     map({ can_run($_) } qw(vi ed notepad.exe))"
NSQ_SOURCE_LINE 00000041 ");"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "sub new {"
NSQ_SOURCE_LINE 00000044 "  my $proto = shift;"
NSQ_SOURCE_LINE 00000045 "  my $class = ref($proto) || $proto;"
NSQ_SOURCE_LINE 00000046 "  my $self = {"
NSQ_SOURCE_LINE 00000047 "                'editors' => \\@DEFAULT_EDITORS,"
NSQ_SOURCE_LINE 00000048 "                'cleanup' => 1,"
NSQ_SOURCE_LINE 00000049 "                'keep_file' => 0,"
NSQ_SOURCE_LINE 00000050 "  };"
NSQ_SOURCE_LINE 00000051 "  croak(\"$class requires an even number of parameters\") if @_ % 2;"
NSQ_SOURCE_LINE 00000052 "  my %args = @_;"
NSQ_SOURCE_LINE 00000053 "  foreach my $param (qw(editors cleanup keep_file)) {"
NSQ_SOURCE_LINE 00000054 "    if ($args{$param}) {"
NSQ_SOURCE_LINE 00000055 "      $self->{$param} = $args{$param};"
NSQ_SOURCE_LINE 00000056 "    }"
NSQ_SOURCE_LINE 00000057 "  }"
NSQ_SOURCE_LINE 00000058 "  bless ($self, $class);"
NSQ_SOURCE_LINE 00000059 "  return $self;"
NSQ_SOURCE_LINE 00000060 "}"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "sub editors {"
NSQ_SOURCE_LINE 00000063 "  my $self = shift;"
NSQ_SOURCE_LINE 00000064 "  my $editors = shift;"
NSQ_SOURCE_LINE 00000065 "  if (defined $editors) {"
NSQ_SOURCE_LINE 00000066 "    assert(ref($editors) eq 'ARRAY');"
NSQ_SOURCE_LINE 00000067 "    $self->{'editors'} = $editors;"
NSQ_SOURCE_LINE 00000068 "  }"
NSQ_SOURCE_LINE 00000069 "  return $self->{'editors'};"
NSQ_SOURCE_LINE 00000070 "}"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "sub editors_prepend {"
NSQ_SOURCE_LINE 00000073 "  my $self = shift;"
NSQ_SOURCE_LINE 00000074 "  my $edit = shift;"
NSQ_SOURCE_LINE 00000075 "  assert(ref($edit) eq 'ARRAY');"
NSQ_SOURCE_LINE 00000076 "  my @editors = @{$self->{'editors'}};"
NSQ_SOURCE_LINE 00000077 "  unshift @editors, @$edit;"
NSQ_SOURCE_LINE 00000078 "  $self->{'editors'} = \\@editors;"
NSQ_SOURCE_LINE 00000079 "}"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "sub editors_env {"
NSQ_SOURCE_LINE 00000082 "  my $self = shift;"
NSQ_SOURCE_LINE 00000083 "  my $edit = shift;"
NSQ_SOURCE_LINE 00000084 "  assert(ref($edit) eq 'ARRAY');"
NSQ_SOURCE_LINE 00000085 "  my @editors;"
NSQ_SOURCE_LINE 00000086 "  if (@$edit) {"
NSQ_SOURCE_LINE 00000087 "    foreach my $e (@$edit) {"
NSQ_SOURCE_LINE 00000088 "      if (exists $ENV{$e} and defined $ENV{$e}) {"
NSQ_SOURCE_LINE 00000089 "        push @editors, $ENV{$e};  "
NSQ_SOURCE_LINE 00000090 "      }"
NSQ_SOURCE_LINE 00000091 "    }"
NSQ_SOURCE_LINE 00000092 "    my @editors_list = @{$self->{'editors'}};"
NSQ_SOURCE_LINE 00000093 "    unshift @editors_list, @editors;"
NSQ_SOURCE_LINE 00000094 "    $self->{'editors'} = \\@editors_list;"
NSQ_SOURCE_LINE 00000095 "  }"
NSQ_SOURCE_LINE 00000096 "  return $self->{'editors'};"
NSQ_SOURCE_LINE 00000097 "}"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "sub cleanup {"
NSQ_SOURCE_LINE 00000100 "  my $self = shift;"
NSQ_SOURCE_LINE 00000101 "  my $cleanup = shift;"
NSQ_SOURCE_LINE 00000102 "  $self->{'cleanup'} = $cleanup if defined $cleanup;"
NSQ_SOURCE_LINE 00000103 "  return $self->{'cleanup'};"
NSQ_SOURCE_LINE 00000104 "}"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "sub keep_file {"
NSQ_SOURCE_LINE 00000107 "  my $self = shift;"
NSQ_SOURCE_LINE 00000108 "  my $keep_file = shift;"
NSQ_SOURCE_LINE 00000109 "  $self->{'keep_file'} = $keep_file if defined $keep_file;"
NSQ_SOURCE_LINE 00000110 "  return $self->{'keep_file'};"
NSQ_SOURCE_LINE 00000111 "}"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "sub edit {"
NSQ_SOURCE_LINE 00000114 "  my $self = shift;"
NSQ_SOURCE_LINE 00000115 "  my $arg = shift;"
NSQ_SOURCE_LINE 00000116 "  my $suff = shift;"
NSQ_SOURCE_LINE 00000117 "  # if the argument supplied is a reference to an array of lines,"
NSQ_SOURCE_LINE 00000118 "  # join it together based on the input record separator"
NSQ_SOURCE_LINE 00000119 "  if (ref($arg) eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000120 "    $arg = join $/, @$arg;"
NSQ_SOURCE_LINE 00000121 "  }"
NSQ_SOURCE_LINE 00000122 "  my $result;"
NSQ_SOURCE_LINE 00000123 "  if (ref($self)) {"
NSQ_SOURCE_LINE 00000124 "    ($result, $self->{'filename'}) = _edit("
NSQ_SOURCE_LINE 00000125 "      $arg,"
NSQ_SOURCE_LINE 00000126 "      $self->{'editors'},"
NSQ_SOURCE_LINE 00000127 "      $self->{'cleanup'},"
NSQ_SOURCE_LINE 00000128 "      $self->{'keep_file'},"
NSQ_SOURCE_LINE 00000129 "      $self->{'filename'},"
NSQ_SOURCE_LINE 00000130 "      $suff,"
NSQ_SOURCE_LINE 00000131 "    );"
NSQ_SOURCE_LINE 00000132 "  } else {"
NSQ_SOURCE_LINE 00000133 "    ($result) = _edit($arg, \\@DEFAULT_EDITORS, 1, 0, undef, $suff);"
NSQ_SOURCE_LINE 00000134 "  }"
NSQ_SOURCE_LINE 00000135 "  if (wantarray) {"
NSQ_SOURCE_LINE 00000136 "    my @result = split m|$/|, $result;"
NSQ_SOURCE_LINE 00000137 "    return @result;"
NSQ_SOURCE_LINE 00000138 "  } else {"
NSQ_SOURCE_LINE 00000139 "    return $result;"
NSQ_SOURCE_LINE 00000140 "  }"
NSQ_SOURCE_LINE 00000141 "}"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "sub first_usable {"
NSQ_SOURCE_LINE 00000144 "  my $self = shift;"
NSQ_SOURCE_LINE 00000145 "  my $er = shift;"
NSQ_SOURCE_LINE 00000146 "  my @editors;"
NSQ_SOURCE_LINE 00000147 "  if (defined $er) {"
NSQ_SOURCE_LINE 00000148 "    @editors = @$er;"
NSQ_SOURCE_LINE 00000149 "  } else {"
NSQ_SOURCE_LINE 00000150 "    if (ref $self) {"
NSQ_SOURCE_LINE 00000151 "      @editors = @{$self->{'editors'}};"
NSQ_SOURCE_LINE 00000152 "    } else {"
NSQ_SOURCE_LINE 00000153 "      @editors = @DEFAULT_EDITORS;"
NSQ_SOURCE_LINE 00000154 "    }"
NSQ_SOURCE_LINE 00000155 "  }"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "  my $chosen_editor;"
NSQ_SOURCE_LINE 00000158 "  my @path = File::Spec->path;"
NSQ_SOURCE_LINE 00000159 "  EDITORS: foreach my $editor (@editors) {"
NSQ_SOURCE_LINE 00000160 "    next unless defined $editor;"
NSQ_SOURCE_LINE 00000161 "    my @editor_bits;"
NSQ_SOURCE_LINE 00000162 "    if( $^O =~ /mswin/i ) {"
NSQ_SOURCE_LINE 00000163 "        require Text::ParseWords;"
NSQ_SOURCE_LINE 00000164 "        $editor =~ s!\\\\!\\\\\\\\!g; # quote path for shellwords"
NSQ_SOURCE_LINE 00000165 "        @editor_bits = Text::ParseWords::shellwords($editor);"
NSQ_SOURCE_LINE 00000166 "    } else {"
NSQ_SOURCE_LINE 00000167 "        @editor_bits = split /\\s+/, $editor;"
NSQ_SOURCE_LINE 00000168 "    };"
NSQ_SOURCE_LINE 00000169 "    next unless defined $editor_bits[0];"
NSQ_SOURCE_LINE 00000170 "    if (File::Spec->file_name_is_absolute($editor_bits[0])"
NSQ_SOURCE_LINE 00000171 "        and -x $editor_bits[0]) {"
NSQ_SOURCE_LINE 00000172 "      $chosen_editor = \\@editor_bits;"
NSQ_SOURCE_LINE 00000173 "      last;"
NSQ_SOURCE_LINE 00000174 "    } else {"
NSQ_SOURCE_LINE 00000175 "      foreach my $dir (@path) {"
NSQ_SOURCE_LINE 00000176 "         my $file = File::Spec->catfile($dir, $editor_bits[0]);"
NSQ_SOURCE_LINE 00000177 "         if (-x $file) { "
NSQ_SOURCE_LINE 00000178 "           $editor_bits[0] = $file;"
NSQ_SOURCE_LINE 00000179 "           $chosen_editor = \\@editor_bits;"
NSQ_SOURCE_LINE 00000180 "           last EDITORS;"
NSQ_SOURCE_LINE 00000181 "         }"
NSQ_SOURCE_LINE 00000182 "      }"
NSQ_SOURCE_LINE 00000183 "    }"
NSQ_SOURCE_LINE 00000184 "  }"
NSQ_SOURCE_LINE 00000185 "  die \"Couldn't find an editor: $!\" unless defined $chosen_editor;"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "  return $chosen_editor;"
NSQ_SOURCE_LINE 00000188 "}"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "sub _edit {"
NSQ_SOURCE_LINE 00000191 "  my $string = shift;"
NSQ_SOURCE_LINE 00000192 "  my $er = shift;"
NSQ_SOURCE_LINE 00000193 "  my $unlink = shift;"
NSQ_SOURCE_LINE 00000194 "  my $keep_file = shift;"
NSQ_SOURCE_LINE 00000195 "  my $filename = shift;"
NSQ_SOURCE_LINE 00000196 "  my $suff = shift;"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "  assert(ref($er) eq 'ARRAY');"
NSQ_SOURCE_LINE 00000199 "  assert(defined $unlink);"
NSQ_SOURCE_LINE 00000200 "  my @editors = @$er; "
NSQ_SOURCE_LINE 00000201 "  # Find an editor"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "  my $chosen_editor = first_usable(undef, $er); "
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "  my @suff;"
NSQ_SOURCE_LINE 00000206 "  @suff = (SUFFIX => $suff) if $suff;"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "  # get a temp file, and write the text to it"
NSQ_SOURCE_LINE 00000209 "  if (defined($filename) && $keep_file) {"
NSQ_SOURCE_LINE 00000210 "    open my $fh, '>', $filename or die \"Couldn't open tempfile [$filename]; $!\";"
NSQ_SOURCE_LINE 00000211 "    print $fh $string;"
NSQ_SOURCE_LINE 00000212 "    close $fh or die \"Couldn't close tempfile [$filename]; $!\";"
NSQ_SOURCE_LINE 00000213 "  }"
NSQ_SOURCE_LINE 00000214 "  else {"
NSQ_SOURCE_LINE 00000215 "    my $fh;"
NSQ_SOURCE_LINE 00000216 "    ($fh, $filename) = tempfile(UNLINK => $unlink, @suff);"
NSQ_SOURCE_LINE 00000217 "    print $fh $string;"
NSQ_SOURCE_LINE 00000218 "    close $fh or die \"Couldn't close tempfile [$filename]; $!\";"
NSQ_SOURCE_LINE 00000219 "  }"
NSQ_SOURCE_LINE 00000220 "  # start the editor"
NSQ_SOURCE_LINE 00000221 "  my $rc = system @$chosen_editor, $filename;"
NSQ_SOURCE_LINE 00000222 "  # check what happened - die if it all went wrong."
NSQ_SOURCE_LINE 00000223 "  unless ($rc == 0) {"
NSQ_SOURCE_LINE 00000224 "    my ($exit_value, $signal_num, $dumped_core);"
NSQ_SOURCE_LINE 00000225 "    $exit_value = $? >> 8;"
NSQ_SOURCE_LINE 00000226 "    $signal_num = $? & 127;"
NSQ_SOURCE_LINE 00000227 "    $dumped_core = $? & 128;"
NSQ_SOURCE_LINE 00000228 "    die \"Error in editor - exit val = $exit_value, signal = $signal_num, coredump? = $dumped_core: $!\";"
NSQ_SOURCE_LINE 00000229 "  }"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "  # read the temp file"
NSQ_SOURCE_LINE 00000232 "  sysopen(FH, $filename, O_RDONLY) or die \"Couldn't sysopen $filename: $!\";"
NSQ_SOURCE_LINE 00000233 "  my $result;"
NSQ_SOURCE_LINE 00000234 "  { local $/; $result = <FH>; }"
NSQ_SOURCE_LINE 00000235 "  close FH or die \"Couldn't close [$filename]: $!\";"
NSQ_SOURCE_LINE 00000236 "  # return as string"
NSQ_SOURCE_LINE 00000237 "  if ($keep_file) {"
NSQ_SOURCE_LINE 00000238 "    return ($result, $filename);"
NSQ_SOURCE_LINE 00000239 "  }"
NSQ_SOURCE_LINE 00000240 "  else {"
NSQ_SOURCE_LINE 00000241 "    return ($result);"
NSQ_SOURCE_LINE 00000242 "  }"
NSQ_SOURCE_LINE 00000243 "}"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "1;"
NSQ_SOURCE_LINE 00000246 "__END__"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "=head1 NAME"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "Proc::InvokeEditor - Perl extension for starting a text editor"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "  use Proc::InvokeEditor;"
NSQ_SOURCE_LINE 00000255 "  my $edited_text = Proc::InvokeEditor->edit($unedited_text);"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "This module provides the ability to supply some text to an external"
NSQ_SOURCE_LINE 00000260 "text editor, have it edited by the user, and retrieve the results."
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "The File::Temp module is used to provide secure, safe temporary"
NSQ_SOURCE_LINE 00000263 "files, and File::Temp is set to its highest available level of"
NSQ_SOURCE_LINE 00000264 "security. This may cause problems on some systems where no secure"
NSQ_SOURCE_LINE 00000265 "temporary directory is available."
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "When the editor is started, no subshell is used. Your path will"
NSQ_SOURCE_LINE 00000268 "be scanned to find the binary to use for each editor if the string"
NSQ_SOURCE_LINE 00000269 "given does not exist as a file, and if a named editor contains whitespace,"
NSQ_SOURCE_LINE 00000270 "eg) if you try to use the editor C<xemacs -nw>, then the string will"
NSQ_SOURCE_LINE 00000271 "be split on whitespace and anything after the editor name will be passed"
NSQ_SOURCE_LINE 00000272 "as arguments to your editor. A shell is not used but this should cover"
NSQ_SOURCE_LINE 00000273 "most simple cases."
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "=head1 METHODS"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "=head2 new(editors => [ editor list ], cleanup => 1)"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "This method creates a new Proc::InvokeEditor object. It takes two optional"
NSQ_SOURCE_LINE 00000280 "arguments in key => value form:"
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "=over 4"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "=item C<editors>"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "This should be a reference to an array of possible editor filenames"
NSQ_SOURCE_LINE 00000287 "to use. Each editor listed will be tried in turn until a working"
NSQ_SOURCE_LINE 00000288 "editor is found. If this argument is not supplied, an internal"
NSQ_SOURCE_LINE 00000289 "default list will be used."
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "=item C<cleanup>"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "This specifies whether the temporary file created should be unlinked"
NSQ_SOURCE_LINE 00000294 "when the program exits. The default is to unlink the file."
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "=item C<keep_file>"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "This specifies whether to reuse the same temporary file between invocations"
NSQ_SOURCE_LINE 00000299 "of C<edit> on the same Proc::InvokeEditor object. The default is to use a"
NSQ_SOURCE_LINE 00000300 "new file each time."
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "=back"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "=head2 editors()"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "This method gets or sets the list of editors to use."
NSQ_SOURCE_LINE 00000307 "If no argument is supplied, it returns the current value from the"
NSQ_SOURCE_LINE 00000308 "object, if an argument is supplied, it changes the value and"
NSQ_SOURCE_LINE 00000309 "returns the new value."
NSQ_SOURCE_LINE 00000310 "The argument should be a reference to a list of text editor filenames."
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "=head2 editors_env($arrayref)"
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "Takes a reference to an array of C<%ENV> keys to use as possible editors."
NSQ_SOURCE_LINE 00000315 "Each C<$ENV{$key}> value is only used if that key exits in C<%ENV> and"
NSQ_SOURCE_LINE 00000316 "the value is defined. The new values are prepended to the currently"
NSQ_SOURCE_LINE 00000317 "stored list of editors to use."
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "=head2 editors_prepend($arrayref)"
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "Takes a reference to an array of editors to use, and prepends them"
NSQ_SOURCE_LINE 00000322 "to the currently stored list."
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "=head2 cleanup()"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "This method gets or sets whether to cleanup temporary files after the"
NSQ_SOURCE_LINE 00000327 "program exits. If no argument is supplied, it returns the current value"
NSQ_SOURCE_LINE 00000328 "from the object. If an argument is supplied, it changes the value and"
NSQ_SOURCE_LINE 00000329 "returns the new object. The argument should be any true or false value."
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "=head2 keep_file()"
NSQ_SOURCE_LINE 00000332 ""
NSQ_SOURCE_LINE 00000333 "This method gets or sets whether to reuse temporary files. If no"
NSQ_SOURCE_LINE 00000334 "argument is supplied, it returns the current value from the object. If"
NSQ_SOURCE_LINE 00000335 "an argument is supplied, it changes the value and returns the new"
NSQ_SOURCE_LINE 00000336 "object. The argument should be any true or false value."
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "=head2 first_usable()"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "This method can be called either as a class method, in which it"
NSQ_SOURCE_LINE 00000341 "returns the first usable editor of the default list of editors, or as an"
NSQ_SOURCE_LINE 00000342 "object method, in which case it returns the first usable editor of"
NSQ_SOURCE_LINE 00000343 "the currently configured list."
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "The return is a reference to an array, the first element of which is a"
NSQ_SOURCE_LINE 00000346 "filename, and the other elements of which are appropriate arguments to"
NSQ_SOURCE_LINE 00000347 "the the command."
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "If this method can not find any usable editor, it will die."
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "=head2 edit($unedited_text)"
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "This can be called as either a class method or an object method."
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 "When called as a class method, it starts an external text editor"
NSQ_SOURCE_LINE 00000356 "in the text supplied, and returns the result to you. The text to"
NSQ_SOURCE_LINE 00000357 "edit can be supplied either as a scalar, in which case it will be"
NSQ_SOURCE_LINE 00000358 "treated as a simple string, or as a reference to an array, in which"
NSQ_SOURCE_LINE 00000359 "case it will be treated as an array of lines."
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "Example use of this form is as follows:"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "  my $result = Proc::InvokeEditor->edit($string);"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "  my @lines = Proc::InvokeEditor->edit(\\@unedited_lines);"
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "  my @lines = Proc::InvokeEditor->edit($string);"
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "When called as an object method, it behaves identically, but uses"
NSQ_SOURCE_LINE 00000370 "configuration parameters from the object:"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "  my $editor = new Proc::InvokeEditor(editors => [ '/usr/bin/emacs' ]);"
NSQ_SOURCE_LINE 00000373 "  $editor->cleanup(0);"
NSQ_SOURCE_LINE 00000374 "  my $result = $editor->edit($string);"
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "A optional second argument is available $suff - example usage:"
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 "\tmy $reuslt = Proc::InvokeEditor->edit($string, '.xml');"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "This specifies a filename suffix to be used when the editor is launched - this"
NSQ_SOURCE_LINE 00000381 "can be useful if the data in the file is of a particular type and you want to"
NSQ_SOURCE_LINE 00000382 "trigger an editor's syntax highlighting mode."
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "=head1 WINDOWS SUPPORT"
NSQ_SOURCE_LINE 00000385 ""
NSQ_SOURCE_LINE 00000386 "On Windows, the parsing is a bit different and uses shell parsing respecting"
NSQ_SOURCE_LINE 00000387 "double quoted paths as the first item for the editor."
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "The following might work to use Notepad++ as your editor with this module or C<git>"
NSQ_SOURCE_LINE 00000390 ""
NSQ_SOURCE_LINE 00000391 "    set EDITOR=\"c:\\Program Files\\Notepad++\\notepad++.exe\" -multiInst -nosession -notabbar"
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "=head1 TODO"
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "=over 4"
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "=item *"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "Write a test suite."
NSQ_SOURCE_LINE 00000400 ""
