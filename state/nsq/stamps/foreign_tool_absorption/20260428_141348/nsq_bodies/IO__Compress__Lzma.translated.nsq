NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "=head1 NAME"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "IO::Compress::Lzma - Write lzma files/buffers"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "    use IO::Compress::Lzma qw(lzma $LzmaError) ;"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "    my $status = lzma $input => $output [,OPTS]"
NSQ_SOURCE_LINE 00000128 "        or die \"lzma failed: $LzmaError\\n\";"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "    my $z = IO::Compress::Lzma->new( $output [,OPTS] )"
NSQ_SOURCE_LINE 00000131 "        or die \"lzma failed: $LzmaError\\n\";"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "    $z->print($string);"
NSQ_SOURCE_LINE 00000134 "    $z->printf($format, $string);"
NSQ_SOURCE_LINE 00000135 "    $z->write($string);"
NSQ_SOURCE_LINE 00000136 "    $z->syswrite($string [, $length, $offset]);"
NSQ_SOURCE_LINE 00000137 "    $z->flush();"
NSQ_SOURCE_LINE 00000138 "    $z->tell();"
NSQ_SOURCE_LINE 00000139 "    $z->eof();"
NSQ_SOURCE_LINE 00000140 "    $z->seek($position, $whence);"
NSQ_SOURCE_LINE 00000141 "    $z->binmode();"
NSQ_SOURCE_LINE 00000142 "    $z->fileno();"
NSQ_SOURCE_LINE 00000143 "    $z->opened();"
NSQ_SOURCE_LINE 00000144 "    $z->autoflush();"
NSQ_SOURCE_LINE 00000145 "    $z->input_line_number();"
NSQ_SOURCE_LINE 00000146 "    $z->newStream( [OPTS] );"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "    $z->close() ;"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "    $LzmaError ;"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "    # IO::File mode"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "    print $z $string;"
NSQ_SOURCE_LINE 00000155 "    printf $z $format, $string;"
NSQ_SOURCE_LINE 00000156 "    tell $z"
NSQ_SOURCE_LINE 00000157 "    eof $z"
NSQ_SOURCE_LINE 00000158 "    seek $z, $position, $whence"
NSQ_SOURCE_LINE 00000159 "    binmode $z"
NSQ_SOURCE_LINE 00000160 "    fileno $z"
NSQ_SOURCE_LINE 00000161 "    close $z ;"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "This module provides a Perl interface that allows writing lzma"
NSQ_SOURCE_LINE 00000166 "compressed data to files or buffer."
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "For reading lzma files/buffers, see the companion module"
NSQ_SOURCE_LINE 00000169 "L<IO::Uncompress::UnLzma|IO::Uncompress::UnLzma>."
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "=head1 Functional Interface"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "A top-level function, C<lzma>, is provided to carry out"
NSQ_SOURCE_LINE 00000174 "\"one-shot\" compression between buffers and/or files. For finer"
NSQ_SOURCE_LINE 00000175 "control over the compression process, see the L</\"OO Interface\">"
NSQ_SOURCE_LINE 00000176 "section."
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "    use IO::Compress::Lzma qw(lzma $LzmaError) ;"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "    lzma $input_filename_or_reference => $output_filename_or_reference [,OPTS]"
NSQ_SOURCE_LINE 00000181 "        or die \"lzma failed: $LzmaError\\n\";"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "The functional interface needs Perl5.005 or better."
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "=head2 lzma $input_filename_or_reference => $output_filename_or_reference [, OPTS]"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "C<lzma> expects at least two parameters,"
NSQ_SOURCE_LINE 00000188 "C<$input_filename_or_reference> and C<$output_filename_or_reference>"
NSQ_SOURCE_LINE 00000189 "and zero or more optional parameters (see L</Optional Parameters>)"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "=head3 The C<$input_filename_or_reference> parameter"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "The parameter, C<$input_filename_or_reference>, is used to define the"
NSQ_SOURCE_LINE 00000194 "source of the uncompressed data."
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "It can take one of the following forms:"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "=over 5"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "=item A filename"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "If the C<$input_filename_or_reference> parameter is a simple scalar, it is"
NSQ_SOURCE_LINE 00000203 "assumed to be a filename. This file will be opened for reading and the"
NSQ_SOURCE_LINE 00000204 "input data will be read from it."
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "=item A filehandle"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "If the C<$input_filename_or_reference> parameter is a filehandle, the input"
NSQ_SOURCE_LINE 00000209 "data will be read from it.  The string '-' can be used as an alias for"
NSQ_SOURCE_LINE 00000210 "standard input."
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "=item A scalar reference"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "If C<$input_filename_or_reference> is a scalar reference, the input data"
NSQ_SOURCE_LINE 00000215 "will be read from C<$$input_filename_or_reference>."
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "=item An array reference"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "If C<$input_filename_or_reference> is an array reference, each element in"
NSQ_SOURCE_LINE 00000220 "the array must be a filename."
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "The input data will be read from each file in turn."
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "The complete array will be walked to ensure that it only"
NSQ_SOURCE_LINE 00000225 "contains valid filenames before any data is compressed."
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "=item An Input FileGlob string"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "If C<$input_filename_or_reference> is a string that is delimited by the"
NSQ_SOURCE_LINE 00000230 "characters \"<\" and \">\" C<lzma> will assume that it is an"
NSQ_SOURCE_LINE 00000231 "I<input fileglob string>. The input is the list of files that match the"
NSQ_SOURCE_LINE 00000232 "fileglob."
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "See L<File::GlobMapper|File::GlobMapper> for more details."
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "=back"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "If the C<$input_filename_or_reference> parameter is any other type,"
NSQ_SOURCE_LINE 00000239 "C<undef> will be returned."
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "=head3 The C<$output_filename_or_reference> parameter"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "The parameter C<$output_filename_or_reference> is used to control the"
NSQ_SOURCE_LINE 00000244 "destination of the compressed data. This parameter can take one of"
NSQ_SOURCE_LINE 00000245 "these forms."
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "=over 5"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "=item A filename"
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "If the C<$output_filename_or_reference> parameter is a simple scalar, it is"
NSQ_SOURCE_LINE 00000252 "assumed to be a filename.  This file will be opened for writing and the"
NSQ_SOURCE_LINE 00000253 "compressed data will be written to it."
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "=item A filehandle"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "If the C<$output_filename_or_reference> parameter is a filehandle, the"
NSQ_SOURCE_LINE 00000258 "compressed data will be written to it.  The string '-' can be used as"
NSQ_SOURCE_LINE 00000259 "an alias for standard output."
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "=item A scalar reference"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "If C<$output_filename_or_reference> is a scalar reference, the"
NSQ_SOURCE_LINE 00000264 "compressed data will be stored in C<$$output_filename_or_reference>."
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "=item An Array Reference"
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "If C<$output_filename_or_reference> is an array reference,"
NSQ_SOURCE_LINE 00000269 "the compressed data will be pushed onto the array."
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "=item An Output FileGlob"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "If C<$output_filename_or_reference> is a string that is delimited by the"
NSQ_SOURCE_LINE 00000274 "characters \"<\" and \">\" C<lzma> will assume that it is an"
NSQ_SOURCE_LINE 00000275 "I<output fileglob string>. The output is the list of files that match the"
NSQ_SOURCE_LINE 00000276 "fileglob."
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "When C<$output_filename_or_reference> is an fileglob string,"
NSQ_SOURCE_LINE 00000279 "C<$input_filename_or_reference> must also be a fileglob string. Anything"
NSQ_SOURCE_LINE 00000280 "else is an error."
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "See L<File::GlobMapper|File::GlobMapper> for more details."
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "=back"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "If the C<$output_filename_or_reference> parameter is any other type,"
NSQ_SOURCE_LINE 00000287 "C<undef> will be returned."
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "=head2 Notes"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "When C<$input_filename_or_reference> maps to multiple files/buffers and"
NSQ_SOURCE_LINE 00000292 "C<$output_filename_or_reference> is a single"
NSQ_SOURCE_LINE 00000293 "file/buffer the input files/buffers will be stored"
NSQ_SOURCE_LINE 00000294 "in C<$output_filename_or_reference> as a concatenated series of compressed data streams."
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "=head2 Optional Parameters"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "The optional parameters for the one-shot function C<lzma>"
NSQ_SOURCE_LINE 00000299 "are (for the most part) identical to those used with the OO interface defined in the"
NSQ_SOURCE_LINE 00000300 "L</\"Constructor Options\"> section. The exceptions are listed below"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "=over 5"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "=item C<< AutoClose => 0|1 >>"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "This option applies to any input or output data streams to"
NSQ_SOURCE_LINE 00000307 "C<lzma> that are filehandles."
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "If C<AutoClose> is specified, and the value is true, it will result in all"
NSQ_SOURCE_LINE 00000310 "input and/or output filehandles being closed once C<lzma> has"
NSQ_SOURCE_LINE 00000311 "completed."
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "This parameter defaults to 0."
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "=item C<< BinModeIn => 0|1 >>"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "This option is now a no-op. All files will be read in binmode."
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "=item C<< Append => 0|1 >>"
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "The behaviour of this option is dependent on the type of output data"
NSQ_SOURCE_LINE 00000322 "stream."
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "=over 5"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "=item * A Buffer"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "If C<Append> is enabled, all compressed data will be append to the end of"
NSQ_SOURCE_LINE 00000329 "the output buffer. Otherwise the output buffer will be cleared before any"
NSQ_SOURCE_LINE 00000330 "compressed data is written to it."
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "=item * A Filename"
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "If C<Append> is enabled, the file will be opened in append mode. Otherwise"
NSQ_SOURCE_LINE 00000335 "the contents of the file, if any, will be truncated before any compressed"
NSQ_SOURCE_LINE 00000336 "data is written to it."
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "=item * A Filehandle"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "If C<Append> is enabled, the filehandle will be positioned to the end of"
NSQ_SOURCE_LINE 00000341 "the file via a call to C<seek> before any compressed data is"
NSQ_SOURCE_LINE 00000342 "written to it.  Otherwise the file pointer will not be moved."
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "=back"
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "When C<Append> is specified, and set to true, it will I<append> all compressed"
NSQ_SOURCE_LINE 00000347 "data to the output data stream."
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "So when the output is a filehandle it will carry out a seek to the eof"
NSQ_SOURCE_LINE 00000350 "before writing any compressed data. If the output is a filename, it will be opened for"
NSQ_SOURCE_LINE 00000351 "appending. If the output is a buffer, all compressed data will be"
NSQ_SOURCE_LINE 00000352 "appended to the existing buffer."
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "Conversely when C<Append> is not specified, or it is present and is set to"
NSQ_SOURCE_LINE 00000355 "false, it will operate as follows."
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "When the output is a filename, it will truncate the contents of the file"
NSQ_SOURCE_LINE 00000358 "before writing any compressed data. If the output is a filehandle"
NSQ_SOURCE_LINE 00000359 "its position will not be changed. If the output is a buffer, it will be"
NSQ_SOURCE_LINE 00000360 "wiped before any compressed data is output."
NSQ_SOURCE_LINE 00000361 ""
NSQ_SOURCE_LINE 00000362 "Defaults to 0."
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "=back"
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "=head2 Oneshot Examples"
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 "Here are a few example that show the capabilities of the module."
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "=head3 Streaming"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "This very simple command line example demonstrates the streaming capabilities of the module."
NSQ_SOURCE_LINE 00000373 "The code reads data from STDIN, compresses it, and writes the compressed data to STDOUT."
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "    $ echo hello world | perl -MIO::Compress::Lzma=lzma -e 'lzma \\*STDIN => \\*STDOUT' >output.lzma"
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "The special filename \"-\" can be used as a standin for both C<\\*STDIN> and C<\\*STDOUT>,"
NSQ_SOURCE_LINE 00000378 "so the above can be rewritten as"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "    $ echo hello world | perl -MIO::Compress::Lzma=lzma -e 'lzma \"-\" => \"-\"' >output.lzma"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "=head3 Compressing a file from the filesystem"
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "To read the contents of the file C<file1.txt> and write the compressed"
NSQ_SOURCE_LINE 00000385 "data to the file C<file1.txt.lzma>."
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "    use strict ;"
NSQ_SOURCE_LINE 00000388 "    use warnings ;"
NSQ_SOURCE_LINE 00000389 "    use IO::Compress::Lzma qw(lzma $LzmaError) ;"
NSQ_SOURCE_LINE 00000390 ""
NSQ_SOURCE_LINE 00000391 "    my $input = \"file1.txt\";"
NSQ_SOURCE_LINE 00000392 "    lzma $input => \"$input.lzma\""
NSQ_SOURCE_LINE 00000393 "        or die \"lzma failed: $LzmaError\\n\";"
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "=head3 Reading from a Filehandle and writing to an in-memory buffer"
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "To read from an existing Perl filehandle, C<$input>, and write the"
NSQ_SOURCE_LINE 00000398 "compressed data to a buffer, C<$buffer>."
NSQ_SOURCE_LINE 00000399 ""
NSQ_SOURCE_LINE 00000400 "    use strict ;"
NSQ_SOURCE_LINE 00000401 "    use warnings ;"
NSQ_SOURCE_LINE 00000402 "    use IO::Compress::Lzma qw(lzma $LzmaError) ;"
NSQ_SOURCE_LINE 00000403 "    use IO::File ;"
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "    my $input = IO::File->new( \"<file1.txt\" )"
NSQ_SOURCE_LINE 00000406 "        or die \"Cannot open 'file1.txt': $!\\n\" ;"
NSQ_SOURCE_LINE 00000407 "    my $buffer ;"
NSQ_SOURCE_LINE 00000408 "    lzma $input => \\$buffer"
NSQ_SOURCE_LINE 00000409 "        or die \"lzma failed: $LzmaError\\n\";"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "=head3 Compressing multiple files"
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "To compress all files in the directory \"/my/home\" that match \"*.txt\""
NSQ_SOURCE_LINE 00000414 "and store the compressed data in the same directory"
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "    use strict ;"
NSQ_SOURCE_LINE 00000417 "    use warnings ;"
NSQ_SOURCE_LINE 00000418 "    use IO::Compress::Lzma qw(lzma $LzmaError) ;"
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "    lzma '</my/home/*.txt>' => '<*.lzma>'"
NSQ_SOURCE_LINE 00000421 "        or die \"lzma failed: $LzmaError\\n\";"
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "and if you want to compress each file one at a time, this will do the trick"
NSQ_SOURCE_LINE 00000424 ""
NSQ_SOURCE_LINE 00000425 "    use strict ;"
NSQ_SOURCE_LINE 00000426 "    use warnings ;"
NSQ_SOURCE_LINE 00000427 "    use IO::Compress::Lzma qw(lzma $LzmaError) ;"
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 "    for my $input ( glob \"/my/home/*.txt\" )"
NSQ_SOURCE_LINE 00000430 "    {"
NSQ_SOURCE_LINE 00000431 "        my $output = \"$input.lzma\" ;"
NSQ_SOURCE_LINE 00000432 "        lzma $input => $output"
NSQ_SOURCE_LINE 00000433 "            or die \"Error compressing '$input': $LzmaError\\n\";"
NSQ_SOURCE_LINE 00000434 "    }"
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 "=head1 OO Interface"
NSQ_SOURCE_LINE 00000437 ""
NSQ_SOURCE_LINE 00000438 "=head2 Constructor"
NSQ_SOURCE_LINE 00000439 ""
NSQ_SOURCE_LINE 00000440 "The format of the constructor for C<IO::Compress::Lzma> is shown below"
NSQ_SOURCE_LINE 00000441 ""
NSQ_SOURCE_LINE 00000442 "    my $z = IO::Compress::Lzma->new( $output [,OPTS] )"
NSQ_SOURCE_LINE 00000443 "        or die \"IO::Compress::Lzma failed: $LzmaError\\n\";"
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "The constructor takes one mandatory parameter, C<$output>, defined below and"
NSQ_SOURCE_LINE 00000446 "zero or more C<OPTS>, defined in L<Constructor Options>."
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 "It returns an C<IO::Compress::Lzma> object on success and C<undef> on failure."
NSQ_SOURCE_LINE 00000449 "The variable C<$LzmaError> will contain an error message on failure."
NSQ_SOURCE_LINE 00000450 ""
NSQ_SOURCE_LINE 00000451 "If you are running Perl 5.005 or better the object, C<$z>, returned from"
NSQ_SOURCE_LINE 00000452 "IO::Compress::Lzma can be used exactly like an L<IO::File|IO::File> filehandle."
NSQ_SOURCE_LINE 00000453 "This means that all normal output file operations can be carried out"
NSQ_SOURCE_LINE 00000454 "with C<$z>."
NSQ_SOURCE_LINE 00000455 "For example, to write to a compressed file/buffer you can use either of"
NSQ_SOURCE_LINE 00000456 "these forms"
NSQ_SOURCE_LINE 00000457 ""
NSQ_SOURCE_LINE 00000458 "    $z->print(\"hello world\\n\");"
NSQ_SOURCE_LINE 00000459 "    print $z \"hello world\\n\";"
NSQ_SOURCE_LINE 00000460 ""
NSQ_SOURCE_LINE 00000461 "Below is a simple exaple of using the OO interface to create an output file"
NSQ_SOURCE_LINE 00000462 "C<myfile.lzma> and write some data to it."
NSQ_SOURCE_LINE 00000463 ""
NSQ_SOURCE_LINE 00000464 "    my $filename = \"myfile.lzma\";"
NSQ_SOURCE_LINE 00000465 "    my $z = IO::Compress::Lzma->new($filename)"
NSQ_SOURCE_LINE 00000466 "        or die \"IO::Compress::Lzma failed: $LzmaError\\n\";"
NSQ_SOURCE_LINE 00000467 ""
NSQ_SOURCE_LINE 00000468 "    $z->print(\"abcde\");"
NSQ_SOURCE_LINE 00000469 "    $z->close();"
NSQ_SOURCE_LINE 00000470 ""
NSQ_SOURCE_LINE 00000471 "See the L</Examples> for more."
NSQ_SOURCE_LINE 00000472 ""
NSQ_SOURCE_LINE 00000473 "The mandatory parameter C<$output> is used to control the destination"
NSQ_SOURCE_LINE 00000474 "of the compressed data. This parameter can take one of these forms."
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 "=over 5"
NSQ_SOURCE_LINE 00000477 ""
NSQ_SOURCE_LINE 00000478 "=item A filename"
NSQ_SOURCE_LINE 00000479 ""
NSQ_SOURCE_LINE 00000480 "If the C<$output> parameter is a simple scalar, it is assumed to be a"
NSQ_SOURCE_LINE 00000481 "filename. This file will be opened for writing and the compressed data"
NSQ_SOURCE_LINE 00000482 "will be written to it."
NSQ_SOURCE_LINE 00000483 ""
NSQ_SOURCE_LINE 00000484 "=item A filehandle"
NSQ_SOURCE_LINE 00000485 ""
NSQ_SOURCE_LINE 00000486 "If the C<$output> parameter is a filehandle, the compressed data will be"
NSQ_SOURCE_LINE 00000487 "written to it."
NSQ_SOURCE_LINE 00000488 "The string '-' can be used as an alias for standard output."
NSQ_SOURCE_LINE 00000489 ""
NSQ_SOURCE_LINE 00000490 "=item A scalar reference"
NSQ_SOURCE_LINE 00000491 ""
NSQ_SOURCE_LINE 00000492 "If C<$output> is a scalar reference, the compressed data will be stored"
NSQ_SOURCE_LINE 00000493 "in C<$$output>."
NSQ_SOURCE_LINE 00000494 ""
NSQ_SOURCE_LINE 00000495 "=back"
NSQ_SOURCE_LINE 00000496 ""
NSQ_SOURCE_LINE 00000497 "If the C<$output> parameter is any other type, C<IO::Compress::Lzma>::new will"
NSQ_SOURCE_LINE 00000498 "return undef."
NSQ_SOURCE_LINE 00000499 ""
NSQ_SOURCE_LINE 00000500 "=head2 Constructor Options"
NSQ_SOURCE_LINE 00000501 ""
NSQ_SOURCE_LINE 00000502 "C<OPTS> is any combination of zero or more the following options:"
NSQ_SOURCE_LINE 00000503 ""
NSQ_SOURCE_LINE 00000504 "=over 5"
NSQ_SOURCE_LINE 00000505 ""
NSQ_SOURCE_LINE 00000506 "=item C<< AutoClose => 0|1 >>"
NSQ_SOURCE_LINE 00000507 ""
NSQ_SOURCE_LINE 00000508 "This option is only valid when the C<$output> parameter is a filehandle. If"
NSQ_SOURCE_LINE 00000509 "specified, and the value is true, it will result in the C<$output> being"
NSQ_SOURCE_LINE 00000510 "closed once either the C<close> method is called or the C<IO::Compress::Lzma>"
NSQ_SOURCE_LINE 00000511 "object is destroyed."
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "This parameter defaults to 0."
NSQ_SOURCE_LINE 00000514 ""
NSQ_SOURCE_LINE 00000515 "=item C<< Append => 0|1 >>"
NSQ_SOURCE_LINE 00000516 ""
NSQ_SOURCE_LINE 00000517 "Opens C<$output> in append mode."
NSQ_SOURCE_LINE 00000518 ""
NSQ_SOURCE_LINE 00000519 "The behaviour of this option is dependent on the type of C<$output>."
NSQ_SOURCE_LINE 00000520 ""
NSQ_SOURCE_LINE 00000521 "=over 5"
NSQ_SOURCE_LINE 00000522 ""
NSQ_SOURCE_LINE 00000523 "=item * A Buffer"
NSQ_SOURCE_LINE 00000524 ""
NSQ_SOURCE_LINE 00000525 "If C<$output> is a buffer and C<Append> is enabled, all compressed data"
NSQ_SOURCE_LINE 00000526 "will be append to the end of C<$output>. Otherwise C<$output> will be"
NSQ_SOURCE_LINE 00000527 "cleared before any data is written to it."
NSQ_SOURCE_LINE 00000528 ""
NSQ_SOURCE_LINE 00000529 "=item * A Filename"
NSQ_SOURCE_LINE 00000530 ""
NSQ_SOURCE_LINE 00000531 "If C<$output> is a filename and C<Append> is enabled, the file will be"
NSQ_SOURCE_LINE 00000532 "opened in append mode. Otherwise the contents of the file, if any, will be"
NSQ_SOURCE_LINE 00000533 "truncated before any compressed data is written to it."
NSQ_SOURCE_LINE 00000534 ""
NSQ_SOURCE_LINE 00000535 "=item * A Filehandle"
NSQ_SOURCE_LINE 00000536 ""
NSQ_SOURCE_LINE 00000537 "If C<$output> is a filehandle, the file pointer will be positioned to the"
NSQ_SOURCE_LINE 00000538 "end of the file via a call to C<seek> before any compressed data is written"
NSQ_SOURCE_LINE 00000539 "to it.  Otherwise the file pointer will not be moved."
NSQ_SOURCE_LINE 00000540 ""
NSQ_SOURCE_LINE 00000541 "=back"
NSQ_SOURCE_LINE 00000542 ""
NSQ_SOURCE_LINE 00000543 "This parameter defaults to 0."
NSQ_SOURCE_LINE 00000544 ""
NSQ_SOURCE_LINE 00000545 "=item C<< Filter => $filter >>"
NSQ_SOURCE_LINE 00000546 ""
NSQ_SOURCE_LINE 00000547 "When present C< $filter > option must be an object of type C<Lzma::Filter::Lzma1>."
NSQ_SOURCE_LINE 00000548 "See L</Lzma::Filter::Lzma> for a definition of C<Lzma::Filter::Lzma1>."
NSQ_SOURCE_LINE 00000549 ""
NSQ_SOURCE_LINE 00000550 "If this option is not present an C<Lzma::Filter::Lzma1> object with default"
NSQ_SOURCE_LINE 00000551 "values will be used."
NSQ_SOURCE_LINE 00000552 ""
NSQ_SOURCE_LINE 00000553 "=item C<< Strict => 0|1 >>"
NSQ_SOURCE_LINE 00000554 ""
NSQ_SOURCE_LINE 00000555 "This is a placeholder option."
NSQ_SOURCE_LINE 00000556 ""
NSQ_SOURCE_LINE 00000557 "=back"
NSQ_SOURCE_LINE 00000558 ""
NSQ_SOURCE_LINE 00000559 "=head2 Examples"
NSQ_SOURCE_LINE 00000560 ""
NSQ_SOURCE_LINE 00000561 "=head3 Streaming"
NSQ_SOURCE_LINE 00000562 ""
NSQ_SOURCE_LINE 00000563 "This very simple command line example demonstrates the streaming capabilities"
NSQ_SOURCE_LINE 00000564 "of the module. The code reads data from STDIN or all the files given on the"
NSQ_SOURCE_LINE 00000565 "commandline, compresses it, and writes the compressed data to STDOUT."
NSQ_SOURCE_LINE 00000566 ""
NSQ_SOURCE_LINE 00000567 "    use strict ;"
NSQ_SOURCE_LINE 00000568 "    use warnings ;"
NSQ_SOURCE_LINE 00000569 "    use IO::Compress::Lzma qw(lzma $LzmaError) ;"
NSQ_SOURCE_LINE 00000570 ""
NSQ_SOURCE_LINE 00000571 "    my $z = IO::Compress::Lzma->new(\"-\", Stream => 1)"
NSQ_SOURCE_LINE 00000572 "        or die \"IO::Compress::Lzma failed: $LzmaError\\n\";"
NSQ_SOURCE_LINE 00000573 ""
NSQ_SOURCE_LINE 00000574 "    while (<>) {"
NSQ_SOURCE_LINE 00000575 "        $z->print(\"abcde\");"
NSQ_SOURCE_LINE 00000576 "    }"
NSQ_SOURCE_LINE 00000577 "    $z->close();"
NSQ_SOURCE_LINE 00000578 ""
NSQ_SOURCE_LINE 00000579 "Note the use of C<\"-\"> to means C<STDOUT>. Alternatively you can use C<\\*STDOUT>."
NSQ_SOURCE_LINE 00000580 ""
NSQ_SOURCE_LINE 00000581 "=head3 Compressing a file from the filesystem"
NSQ_SOURCE_LINE 00000582 ""
NSQ_SOURCE_LINE 00000583 "To read the contents of the file C<file1.txt> and write the compressed"
NSQ_SOURCE_LINE 00000584 "data to the file C<file1.txt.lzma> there are a few options"
NSQ_SOURCE_LINE 00000585 ""
NSQ_SOURCE_LINE 00000586 "Start by creating the compression object and opening the input file"
NSQ_SOURCE_LINE 00000587 ""
NSQ_SOURCE_LINE 00000588 "    use strict ;"
NSQ_SOURCE_LINE 00000589 "    use warnings ;"
NSQ_SOURCE_LINE 00000590 "    use IO::Compress::Lzma qw(lzma $LzmaError) ;"
NSQ_SOURCE_LINE 00000591 ""
NSQ_SOURCE_LINE 00000592 "    my $input = \"file1.txt\";"
NSQ_SOURCE_LINE 00000593 "    my $z = IO::Compress::Lzma->new(\"file1.txt.lzma\")"
NSQ_SOURCE_LINE 00000594 "        or die \"IO::Compress::Lzma failed: $LzmaError\\n\";"
NSQ_SOURCE_LINE 00000595 ""
NSQ_SOURCE_LINE 00000596 "    # open the input file"
NSQ_SOURCE_LINE 00000597 "    open my $fh, \"<\", \"file1.txt\""
NSQ_SOURCE_LINE 00000598 "        or die \"Cannot open file1.txt: $!\\n\";"
NSQ_SOURCE_LINE 00000599 ""
NSQ_SOURCE_LINE 00000600 "    # loop through the input file & write to the compressed file"
NSQ_SOURCE_LINE 00000601 "    while (<$fh>) {"
NSQ_SOURCE_LINE 00000602 "        $z->print($_);"
NSQ_SOURCE_LINE 00000603 "    }"
NSQ_SOURCE_LINE 00000604 ""
NSQ_SOURCE_LINE 00000605 "    # not forgetting to close the compressed file"
NSQ_SOURCE_LINE 00000606 "    $z->close();"
NSQ_SOURCE_LINE 00000607 ""
NSQ_SOURCE_LINE 00000608 "=head1 Methods"
NSQ_SOURCE_LINE 00000609 ""
NSQ_SOURCE_LINE 00000610 "=head2 print"
NSQ_SOURCE_LINE 00000611 ""
NSQ_SOURCE_LINE 00000612 "Usage is"
NSQ_SOURCE_LINE 00000613 ""
NSQ_SOURCE_LINE 00000614 "    $z->print($data)"
NSQ_SOURCE_LINE 00000615 "    print $z $data"
NSQ_SOURCE_LINE 00000616 ""
NSQ_SOURCE_LINE 00000617 "Compresses and outputs the contents of the C<$data> parameter. This"
NSQ_SOURCE_LINE 00000618 "has the same behaviour as the C<print> built-in."
NSQ_SOURCE_LINE 00000619 ""
NSQ_SOURCE_LINE 00000620 "Returns true if successful."
NSQ_SOURCE_LINE 00000621 ""
NSQ_SOURCE_LINE 00000622 "=head2 printf"
NSQ_SOURCE_LINE 00000623 ""
NSQ_SOURCE_LINE 00000624 "Usage is"
NSQ_SOURCE_LINE 00000625 ""
NSQ_SOURCE_LINE 00000626 "    $z->printf($format, $data)"
NSQ_SOURCE_LINE 00000627 "    printf $z $format, $data"
NSQ_SOURCE_LINE 00000628 ""
NSQ_SOURCE_LINE 00000629 "Compresses and outputs the contents of the C<$data> parameter."
NSQ_SOURCE_LINE 00000630 ""
NSQ_SOURCE_LINE 00000631 "Returns true if successful."
NSQ_SOURCE_LINE 00000632 ""
NSQ_SOURCE_LINE 00000633 "=head2 syswrite"
NSQ_SOURCE_LINE 00000634 ""
NSQ_SOURCE_LINE 00000635 "Usage is"
NSQ_SOURCE_LINE 00000636 ""
NSQ_SOURCE_LINE 00000637 "    $z->syswrite $data"
NSQ_SOURCE_LINE 00000638 "    $z->syswrite $data, $length"
NSQ_SOURCE_LINE 00000639 "    $z->syswrite $data, $length, $offset"
NSQ_SOURCE_LINE 00000640 ""
NSQ_SOURCE_LINE 00000641 "Compresses and outputs the contents of the C<$data> parameter."
NSQ_SOURCE_LINE 00000642 ""
NSQ_SOURCE_LINE 00000643 "Returns the number of uncompressed bytes written, or C<undef> if"
NSQ_SOURCE_LINE 00000644 "unsuccessful."
NSQ_SOURCE_LINE 00000645 ""
NSQ_SOURCE_LINE 00000646 "=head2 write"
NSQ_SOURCE_LINE 00000647 ""
NSQ_SOURCE_LINE 00000648 "Usage is"
NSQ_SOURCE_LINE 00000649 ""
NSQ_SOURCE_LINE 00000650 "    $z->write $data"
NSQ_SOURCE_LINE 00000651 "    $z->write $data, $length"
NSQ_SOURCE_LINE 00000652 "    $z->write $data, $length, $offset"
NSQ_SOURCE_LINE 00000653 ""
NSQ_SOURCE_LINE 00000654 "Compresses and outputs the contents of the C<$data> parameter."
NSQ_SOURCE_LINE 00000655 ""
NSQ_SOURCE_LINE 00000656 "Returns the number of uncompressed bytes written, or C<undef> if"
NSQ_SOURCE_LINE 00000657 "unsuccessful."
NSQ_SOURCE_LINE 00000658 ""
NSQ_SOURCE_LINE 00000659 "=head2 flush"
NSQ_SOURCE_LINE 00000660 ""
NSQ_SOURCE_LINE 00000661 "Usage is"
NSQ_SOURCE_LINE 00000662 ""
NSQ_SOURCE_LINE 00000663 "    $z->flush;"
NSQ_SOURCE_LINE 00000664 ""
NSQ_SOURCE_LINE 00000665 "Flushes any pending compressed data to the output file/buffer."
NSQ_SOURCE_LINE 00000666 ""
NSQ_SOURCE_LINE 00000667 "Returns true on success."
NSQ_SOURCE_LINE 00000668 ""
NSQ_SOURCE_LINE 00000669 "=head2 tell"
NSQ_SOURCE_LINE 00000670 ""
NSQ_SOURCE_LINE 00000671 "Usage is"
NSQ_SOURCE_LINE 00000672 ""
NSQ_SOURCE_LINE 00000673 "    $z->tell()"
NSQ_SOURCE_LINE 00000674 "    tell $z"
NSQ_SOURCE_LINE 00000675 ""
NSQ_SOURCE_LINE 00000676 "Returns the uncompressed file offset."
NSQ_SOURCE_LINE 00000677 ""
NSQ_SOURCE_LINE 00000678 "=head2 eof"
NSQ_SOURCE_LINE 00000679 ""
NSQ_SOURCE_LINE 00000680 "Usage is"
NSQ_SOURCE_LINE 00000681 ""
NSQ_SOURCE_LINE 00000682 "    $z->eof();"
NSQ_SOURCE_LINE 00000683 "    eof($z);"
NSQ_SOURCE_LINE 00000684 ""
NSQ_SOURCE_LINE 00000685 "Returns true if the C<close> method has been called."
NSQ_SOURCE_LINE 00000686 ""
NSQ_SOURCE_LINE 00000687 "=head2 seek"
NSQ_SOURCE_LINE 00000688 ""
NSQ_SOURCE_LINE 00000689 "    $z->seek($position, $whence);"
NSQ_SOURCE_LINE 00000690 "    seek($z, $position, $whence);"
NSQ_SOURCE_LINE 00000691 ""
NSQ_SOURCE_LINE 00000692 "Provides a sub-set of the C<seek> functionality, with the restriction"
NSQ_SOURCE_LINE 00000693 "that it is only legal to seek forward in the output file/buffer."
NSQ_SOURCE_LINE 00000694 "It is a fatal error to attempt to seek backward."
NSQ_SOURCE_LINE 00000695 ""
NSQ_SOURCE_LINE 00000696 "Empty parts of the file/buffer will have NULL (0x00) bytes written to them."
NSQ_SOURCE_LINE 00000697 ""
NSQ_SOURCE_LINE 00000698 "The C<$whence> parameter takes one the usual values, namely SEEK_SET,"
NSQ_SOURCE_LINE 00000699 "SEEK_CUR or SEEK_END."
NSQ_SOURCE_LINE 00000700 ""
NSQ_SOURCE_LINE 00000701 "Returns 1 on success, 0 on failure."
NSQ_SOURCE_LINE 00000702 ""
NSQ_SOURCE_LINE 00000703 "=head2 binmode"
NSQ_SOURCE_LINE 00000704 ""
NSQ_SOURCE_LINE 00000705 "Usage is"
NSQ_SOURCE_LINE 00000706 ""
NSQ_SOURCE_LINE 00000707 "    $z->binmode"
NSQ_SOURCE_LINE 00000708 "    binmode $z ;"
NSQ_SOURCE_LINE 00000709 ""
NSQ_SOURCE_LINE 00000710 "This is a noop provided for completeness."
NSQ_SOURCE_LINE 00000711 ""
NSQ_SOURCE_LINE 00000712 "=head2 opened"
NSQ_SOURCE_LINE 00000713 ""
NSQ_SOURCE_LINE 00000714 "    $z->opened()"
NSQ_SOURCE_LINE 00000715 ""
NSQ_SOURCE_LINE 00000716 "Returns true if the object currently refers to a opened file/buffer."
NSQ_SOURCE_LINE 00000717 ""
NSQ_SOURCE_LINE 00000718 "=head2 autoflush"
NSQ_SOURCE_LINE 00000719 ""
NSQ_SOURCE_LINE 00000720 "    my $prev = $z->autoflush()"
NSQ_SOURCE_LINE 00000721 "    my $prev = $z->autoflush(EXPR)"
NSQ_SOURCE_LINE 00000722 ""
NSQ_SOURCE_LINE 00000723 "If the C<$z> object is associated with a file or a filehandle, this method"
NSQ_SOURCE_LINE 00000724 "returns the current autoflush setting for the underlying filehandle. If"
NSQ_SOURCE_LINE 00000725 "C<EXPR> is present, and is non-zero, it will enable flushing after every"
NSQ_SOURCE_LINE 00000726 "write/print operation."
NSQ_SOURCE_LINE 00000727 ""
NSQ_SOURCE_LINE 00000728 "If C<$z> is associated with a buffer, this method has no effect and always"
NSQ_SOURCE_LINE 00000729 "returns C<undef>."
NSQ_SOURCE_LINE 00000730 ""
NSQ_SOURCE_LINE 00000731 "B<Note> that the special variable C<$|> B<cannot> be used to set or"
NSQ_SOURCE_LINE 00000732 "retrieve the autoflush setting."
NSQ_SOURCE_LINE 00000733 ""
NSQ_SOURCE_LINE 00000734 "=head2 input_line_number"
NSQ_SOURCE_LINE 00000735 ""
NSQ_SOURCE_LINE 00000736 "    $z->input_line_number()"
NSQ_SOURCE_LINE 00000737 "    $z->input_line_number(EXPR)"
NSQ_SOURCE_LINE 00000738 ""
NSQ_SOURCE_LINE 00000739 "This method always returns C<undef> when compressing."
NSQ_SOURCE_LINE 00000740 ""
NSQ_SOURCE_LINE 00000741 "=head2 fileno"
NSQ_SOURCE_LINE 00000742 ""
NSQ_SOURCE_LINE 00000743 "    $z->fileno()"
NSQ_SOURCE_LINE 00000744 "    fileno($z)"
NSQ_SOURCE_LINE 00000745 ""
NSQ_SOURCE_LINE 00000746 "If the C<$z> object is associated with a file or a filehandle, C<fileno>"
NSQ_SOURCE_LINE 00000747 "will return the underlying file descriptor. Once the C<close> method is"
NSQ_SOURCE_LINE 00000748 "called C<fileno> will return C<undef>."
NSQ_SOURCE_LINE 00000749 ""
NSQ_SOURCE_LINE 00000750 "If the C<$z> object is associated with a buffer, this method will return"
NSQ_SOURCE_LINE 00000751 "C<undef>."
NSQ_SOURCE_LINE 00000752 ""
NSQ_SOURCE_LINE 00000753 "=head2 close"
NSQ_SOURCE_LINE 00000754 ""
NSQ_SOURCE_LINE 00000755 "    $z->close() ;"
NSQ_SOURCE_LINE 00000756 "    close $z ;"
NSQ_SOURCE_LINE 00000757 ""
NSQ_SOURCE_LINE 00000758 "Flushes any pending compressed data and then closes the output file/buffer."
NSQ_SOURCE_LINE 00000759 ""
NSQ_SOURCE_LINE 00000760 "For most versions of Perl this method will be automatically invoked if"
NSQ_SOURCE_LINE 00000761 "the IO::Compress::Lzma object is destroyed (either explicitly or by the"
NSQ_SOURCE_LINE 00000762 "variable with the reference to the object going out of scope). The"
NSQ_SOURCE_LINE 00000763 "exceptions are Perl versions 5.005 through 5.00504 and 5.8.0. In"
NSQ_SOURCE_LINE 00000764 "these cases, the C<close> method will be called automatically, but"
NSQ_SOURCE_LINE 00000765 "not until global destruction of all live objects when the program is"
NSQ_SOURCE_LINE 00000766 "terminating."
NSQ_SOURCE_LINE 00000767 ""
NSQ_SOURCE_LINE 00000768 "Therefore, if you want your scripts to be able to run on all versions"
NSQ_SOURCE_LINE 00000769 "of Perl, you should call C<close> explicitly and not rely on automatic"
NSQ_SOURCE_LINE 00000770 "closing."
NSQ_SOURCE_LINE 00000771 ""
NSQ_SOURCE_LINE 00000772 "Returns true on success, otherwise 0."
NSQ_SOURCE_LINE 00000773 ""
NSQ_SOURCE_LINE 00000774 "If the C<AutoClose> option has been enabled when the IO::Compress::Lzma"
NSQ_SOURCE_LINE 00000775 "object was created, and the object is associated with a file, the"
NSQ_SOURCE_LINE 00000776 "underlying file will also be closed."
NSQ_SOURCE_LINE 00000777 ""
NSQ_SOURCE_LINE 00000778 "=head2 newStream([OPTS])"
NSQ_SOURCE_LINE 00000779 ""
NSQ_SOURCE_LINE 00000780 "Usage is"
NSQ_SOURCE_LINE 00000781 ""
NSQ_SOURCE_LINE 00000782 "    $z->newStream( [OPTS] )"
NSQ_SOURCE_LINE 00000783 ""
NSQ_SOURCE_LINE 00000784 "Closes the current compressed data stream and starts a new one."
NSQ_SOURCE_LINE 00000785 ""
NSQ_SOURCE_LINE 00000786 "OPTS consists of any of the options that are available when creating"
NSQ_SOURCE_LINE 00000787 "the C<$z> object."
NSQ_SOURCE_LINE 00000788 ""
NSQ_SOURCE_LINE 00000789 "See the L</\"Constructor Options\"> section for more details."
NSQ_SOURCE_LINE 00000790 ""
NSQ_SOURCE_LINE 00000791 "=head1 Importing"
NSQ_SOURCE_LINE 00000792 ""
NSQ_SOURCE_LINE 00000793 "No symbolic constants are required by IO::Compress::Lzma at present."
NSQ_SOURCE_LINE 00000794 ""
NSQ_SOURCE_LINE 00000795 "=over 5"
NSQ_SOURCE_LINE 00000796 ""
NSQ_SOURCE_LINE 00000797 "=item :all"
NSQ_SOURCE_LINE 00000798 ""
NSQ_SOURCE_LINE 00000799 "Imports C<lzma> and C<$LzmaError>."
NSQ_SOURCE_LINE 00000800 "Same as doing this"
NSQ_SOURCE_LINE 00000801 ""
NSQ_SOURCE_LINE 00000802 "    use IO::Compress::Lzma qw(lzma $LzmaError) ;"
NSQ_SOURCE_LINE 00000803 ""
NSQ_SOURCE_LINE 00000804 "=back"
NSQ_SOURCE_LINE 00000805 ""
NSQ_SOURCE_LINE 00000806 "=head1 EXAMPLES"
NSQ_SOURCE_LINE 00000807 ""
NSQ_SOURCE_LINE 00000808 "=head1 SUPPORT"
NSQ_SOURCE_LINE 00000809 ""
NSQ_SOURCE_LINE 00000810 "General feedback/questions/bug reports should be sent to"
NSQ_SOURCE_LINE 00000811 "L<https://github.com/pmqs/IO-Compress-Lzma/issues> (preferred) or"
NSQ_SOURCE_LINE 00000812 "L<https://rt.cpan.org/Public/Dist/Display.html?Name=IO-Compress-Lzma>."
NSQ_SOURCE_LINE 00000813 ""
