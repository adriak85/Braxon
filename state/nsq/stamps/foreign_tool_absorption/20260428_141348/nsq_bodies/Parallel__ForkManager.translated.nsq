NSQ_SOURCE_LINE 00000001 "package Parallel::ForkManager;"
NSQ_SOURCE_LINE 00000002 "our $AUTHORITY = 'cpan:DLUX';"
NSQ_SOURCE_LINE 00000003 "# ABSTRACT:  A simple parallel processing fork manager"
NSQ_SOURCE_LINE 00000004 "$Parallel::ForkManager::VERSION = '2.04';"
NSQ_SOURCE_LINE 00000005 "use POSIX \":sys_wait_h\";"
NSQ_SOURCE_LINE 00000006 "use Storable ();"
NSQ_SOURCE_LINE 00000007 "use File::Spec;"
NSQ_SOURCE_LINE 00000008 "use File::Temp ();"
NSQ_SOURCE_LINE 00000009 "use File::Path ();"
NSQ_SOURCE_LINE 00000010 "use Carp;"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "use Parallel::ForkManager::Child;"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "use strict;"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "use Moo 1.001000;"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "has max_proc => ("
NSQ_SOURCE_LINE 00000019 "    is => 'ro',"
NSQ_SOURCE_LINE 00000020 "    required => 1,"
NSQ_SOURCE_LINE 00000021 "    writer => 'set_max_procs',"
NSQ_SOURCE_LINE 00000022 ");"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "has processes => ("
NSQ_SOURCE_LINE 00000025 "    is => 'ro',"
NSQ_SOURCE_LINE 00000026 "    default => sub { {} },"
NSQ_SOURCE_LINE 00000027 ");"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "has parent_pid => ("
NSQ_SOURCE_LINE 00000030 "    is => 'ro',"
NSQ_SOURCE_LINE 00000031 "    default => sub { $$ },"
NSQ_SOURCE_LINE 00000032 ");"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "has auto_cleanup => ("
NSQ_SOURCE_LINE 00000035 "    is => 'rw',"
NSQ_SOURCE_LINE 00000036 "    default => sub { 1 },"
NSQ_SOURCE_LINE 00000037 ");"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "has waitpid_blocking_sleep => ("
NSQ_SOURCE_LINE 00000040 "    is =>'ro',"
NSQ_SOURCE_LINE 00000041 "    writer => 'set_waitpid_blocking_sleep',"
NSQ_SOURCE_LINE 00000042 "    default => sub { 1 },"
NSQ_SOURCE_LINE 00000043 ");"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "has tempdir => ("
NSQ_SOURCE_LINE 00000046 "    is => 'ro',"
NSQ_SOURCE_LINE 00000047 "    default => sub {"
NSQ_SOURCE_LINE 00000048 "        File::Temp::tempdir(CLEANUP => 0);"
NSQ_SOURCE_LINE 00000049 "    },"
NSQ_SOURCE_LINE 00000050 "    trigger => sub {"
NSQ_SOURCE_LINE 00000051 "        my( $self, $dir ) = @_;"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "        die qq|Temporary directory \"$dir\" doesn't exist or is not a directory.|"
NSQ_SOURCE_LINE 00000054 "            unless -d $dir;"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "        $self->auto_cleanup(0);"
NSQ_SOURCE_LINE 00000057 "    },"
NSQ_SOURCE_LINE 00000058 ");"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "has child_role => ("
NSQ_SOURCE_LINE 00000061 "    is => 'ro',"
NSQ_SOURCE_LINE 00000062 "    default => 'Parallel::ForkManager::Child',"
NSQ_SOURCE_LINE 00000063 ");"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "sub is_child  { 0 }"
NSQ_SOURCE_LINE 00000066 "sub is_parent { 1 }"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "sub BUILDARGS {"
NSQ_SOURCE_LINE 00000070 "    my ( undef, @args ) = @_;"
NSQ_SOURCE_LINE 00000071 "    my %args;"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "    if ( $args[0] =~ /^\\d+$/ ) {"
NSQ_SOURCE_LINE 00000074 "        $args{max_proc} = shift @args;"
NSQ_SOURCE_LINE 00000075 "        $args{tempdir} = shift @args if @args;"
NSQ_SOURCE_LINE 00000076 "    }"
NSQ_SOURCE_LINE 00000077 "    else {"
NSQ_SOURCE_LINE 00000078 "        %args = @args;"
NSQ_SOURCE_LINE 00000079 "    }"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "    return \\%args;"
NSQ_SOURCE_LINE 00000082 "}"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "sub start {"
NSQ_SOURCE_LINE 00000085 "  my ($s,$identification)=@_;"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "  while ($s->{max_proc} && ( keys %{ $s->{processes} } ) >= $s->{max_proc}) {"
NSQ_SOURCE_LINE 00000088 "    $s->on_wait;"
NSQ_SOURCE_LINE 00000089 "    $s->wait_one_child(defined $s->{on_wait_period} ? &WNOHANG : undef);"
NSQ_SOURCE_LINE 00000090 "  };"
NSQ_SOURCE_LINE 00000091 "  $s->wait_children;"
NSQ_SOURCE_LINE 00000092 "  if ($s->{max_proc}) {"
NSQ_SOURCE_LINE 00000093 "    my $pid=fork();"
NSQ_SOURCE_LINE 00000094 "    die \"Cannot fork: $!\" if !defined $pid;"
NSQ_SOURCE_LINE 00000095 "    if ($pid) {  # in parent"
NSQ_SOURCE_LINE 00000096 "      $s->{processes}->{$pid}=$identification;"
NSQ_SOURCE_LINE 00000097 "      $s->on_start($pid,$identification);"
NSQ_SOURCE_LINE 00000098 "    } else {"
NSQ_SOURCE_LINE 00000099 "      Role::Tiny->apply_roles_to_object( $s, $s->child_role );"
NSQ_SOURCE_LINE 00000100 "    }"
NSQ_SOURCE_LINE 00000101 "    return $pid;"
NSQ_SOURCE_LINE 00000102 "  }"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "  # non-forking mode"
NSQ_SOURCE_LINE 00000105 "  $s->{processes}->{$$}=$identification;"
NSQ_SOURCE_LINE 00000106 "  $s->on_start($$,$identification);"
NSQ_SOURCE_LINE 00000107 "  return 0; # Simulating the child which returns 0"
NSQ_SOURCE_LINE 00000108 "}"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "sub start_child {"
NSQ_SOURCE_LINE 00000111 "    my $self = shift;"
NSQ_SOURCE_LINE 00000112 "    my $sub = pop;"
NSQ_SOURCE_LINE 00000113 "    my $identification = shift;"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "    $self->start( $identification ) # in the parent"
NSQ_SOURCE_LINE 00000116 "            # ... or the child"
NSQ_SOURCE_LINE 00000117 "        or $self->finish( 0, $sub->() );"
NSQ_SOURCE_LINE 00000118 "}"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "sub finish {"
NSQ_SOURCE_LINE 00000122 "  my ($s, $x, $r)=@_;"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "  if ($s->{max_proc} == 0) { # nofork"
NSQ_SOURCE_LINE 00000125 "    $s->on_finish($$, $x ,$s->{processes}->{$$}, 0, 0, $r);"
NSQ_SOURCE_LINE 00000126 "    delete $s->{processes}->{$$};"
NSQ_SOURCE_LINE 00000127 "  }"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "  return 0;"
NSQ_SOURCE_LINE 00000130 "}"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "sub wait_children {"
NSQ_SOURCE_LINE 00000133 "  my ($s)=@_;"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "  return if !keys %{$s->{processes}};"
NSQ_SOURCE_LINE 00000136 "  my $kid;"
NSQ_SOURCE_LINE 00000137 "  do {"
NSQ_SOURCE_LINE 00000138 "    $kid = $s->wait_one_child(&WNOHANG);"
NSQ_SOURCE_LINE 00000139 "  } while defined $kid and ( $kid > 0 or $kid < -1 ); # AS 5.6/Win32 returns negative PIDs"
NSQ_SOURCE_LINE 00000140 "};"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "*wait_childs=*wait_children; # compatibility"
NSQ_SOURCE_LINE 00000143 "*reap_finished_children=*wait_children; # behavioral synonym for clarity"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "# TODO document the method"
NSQ_SOURCE_LINE 00000146 "sub retrieve {"
NSQ_SOURCE_LINE 00000147 "    my( $self, $kid ) = @_;"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "    my $retrieved = undef;"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "    my $storable_tempfile = File::Spec->catfile($self->{tempdir}, 'Parallel-ForkManager-' . $self->{parent_pid} . '-' . $kid . '.txt');"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "    if (-e $storable_tempfile) {  # child has option of not storing anything, so we need to see if it did or not"
NSQ_SOURCE_LINE 00000154 "      $retrieved = eval { Storable::retrieve($storable_tempfile) };"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "      # handle Storables errors"
NSQ_SOURCE_LINE 00000157 "      if (not $retrieved or $@) {"
NSQ_SOURCE_LINE 00000158 "        warn(qq|The storable module was unable to retrieve the child's data structure from the temporary file \"$storable_tempfile\":  | . join(', ', $@));"
NSQ_SOURCE_LINE 00000159 "      }"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "      # clean up after ourselves"
NSQ_SOURCE_LINE 00000162 "      unlink $storable_tempfile;"
NSQ_SOURCE_LINE 00000163 "    }"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "    return $retrieved;"
NSQ_SOURCE_LINE 00000166 "}"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "sub store {"
NSQ_SOURCE_LINE 00000169 "    my( $self, $data ) = @_;"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "    return unless defined $data;"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "      my $storable_tempfile = File::Spec->catfile($self->{tempdir}, 'Parallel-ForkManager-' . $self->{parent_pid} . '-' . $$ . '.txt');"
NSQ_SOURCE_LINE 00000174 "      my $stored = eval { return Storable::store($data, $storable_tempfile); };"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "      # handle Storables errors, IE logcarp or carp returning undef, or die (via logcroak or croak)"
NSQ_SOURCE_LINE 00000177 "      if (not $stored or $@) {"
NSQ_SOURCE_LINE 00000178 "        warn(qq|The storable module was unable to store the child's data structure to the temp file \"$storable_tempfile\":  | . join(', ', $@));"
NSQ_SOURCE_LINE 00000179 "      }"
NSQ_SOURCE_LINE 00000180 "}"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "sub wait_one_child {"
NSQ_SOURCE_LINE 00000185 "  my ($s,$flag)=@_;"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "  my $kid;"
NSQ_SOURCE_LINE 00000188 "  while (1) {"
NSQ_SOURCE_LINE 00000189 "    $kid = $s->_waitpid($flag||=0);"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "    last unless defined $kid;"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "    last if $kid == 0 || $kid == -1; # AS 5.6/Win32 returns negative PIDs"
NSQ_SOURCE_LINE 00000194 "    redo if !exists $s->{processes}->{$kid};"
NSQ_SOURCE_LINE 00000195 "    my $id = delete $s->{processes}->{$kid};"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "    # retrieve child data structure, if any"
NSQ_SOURCE_LINE 00000198 "    my $retrieved = $s->retrieve($kid);"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "    $s->on_finish( $kid, $? >> 8 , $id, $? & 0x7f, $? & 0x80 ? 1 : 0, $retrieved);"
NSQ_SOURCE_LINE 00000201 "    last;"
NSQ_SOURCE_LINE 00000202 "  }"
NSQ_SOURCE_LINE 00000203 "  $kid;"
NSQ_SOURCE_LINE 00000204 "};"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "sub wait_all_children {"
NSQ_SOURCE_LINE 00000207 "  my ($s)=@_;"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "  while (keys %{ $s->{processes} }) {"
NSQ_SOURCE_LINE 00000210 "    $s->on_wait;"
NSQ_SOURCE_LINE 00000211 "    $s->wait_one_child(defined $s->{on_wait_period} ? &WNOHANG : undef);"
NSQ_SOURCE_LINE 00000212 "  };"
NSQ_SOURCE_LINE 00000213 "}"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "*wait_all_childs=*wait_all_children; # compatibility;"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "sub max_procs { $_[0]->max_proc }"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "sub running_procs {"
NSQ_SOURCE_LINE 00000220 "    my $self = shift;"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "    my @pids = keys %{ $self->{processes} };"
NSQ_SOURCE_LINE 00000223 "    return @pids;"
NSQ_SOURCE_LINE 00000224 "}"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "sub running_procs_with_identifiers {"
NSQ_SOURCE_LINE 00000227 "    my $self = shift;"
NSQ_SOURCE_LINE 00000228 "    return %{ $self->{processes} };"
NSQ_SOURCE_LINE 00000229 "}"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "sub wait_for_available_procs {"
NSQ_SOURCE_LINE 00000232 "    my( $self, $nbr ) = @_;"
NSQ_SOURCE_LINE 00000233 "    $nbr ||= 1;"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "    croak \"number of processes '$nbr' higher than the max number of processes (@{[ $self->max_procs ]})\""
NSQ_SOURCE_LINE 00000236 "        if $nbr > $self->max_procs;"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "    $self->wait_one_child until $self->max_procs - $self->running_procs >= $nbr;"
NSQ_SOURCE_LINE 00000239 "}"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "sub run_on_finish {"
NSQ_SOURCE_LINE 00000242 "  my ($s,$code,$pid)=@_;"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "  $s->{on_finish}->{$pid || 0}=$code;"
NSQ_SOURCE_LINE 00000245 "}"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "sub on_finish {"
NSQ_SOURCE_LINE 00000248 "  my ($s,$pid,@par)=@_;"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "  my $code=$s->{on_finish}->{$pid} || $s->{on_finish}->{0} or return 0;"
NSQ_SOURCE_LINE 00000251 "  $code->($pid,@par);"
NSQ_SOURCE_LINE 00000252 "};"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "sub run_on_wait {"
NSQ_SOURCE_LINE 00000255 "  my ($s,$code, $period)=@_;"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "  $s->{on_wait}=$code;"
NSQ_SOURCE_LINE 00000258 "  $s->{on_wait_period} = $period;"
NSQ_SOURCE_LINE 00000259 "}"
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "sub on_wait {"
NSQ_SOURCE_LINE 00000262 "  my ($s)=@_;"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "  if(ref($s->{on_wait}) eq 'CODE') {"
NSQ_SOURCE_LINE 00000265 "    $s->{on_wait}->();"
NSQ_SOURCE_LINE 00000266 "    if (defined $s->{on_wait_period}) {"
NSQ_SOURCE_LINE 00000267 "        local $SIG{CHLD} = sub { } if ! defined $SIG{CHLD};"
NSQ_SOURCE_LINE 00000268 "        select undef, undef, undef, $s->{on_wait_period}"
NSQ_SOURCE_LINE 00000269 "    };"
NSQ_SOURCE_LINE 00000270 "  };"
NSQ_SOURCE_LINE 00000271 "};"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "sub run_on_start {"
NSQ_SOURCE_LINE 00000274 "  my ($s,$code)=@_;"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "  $s->{on_start}=$code;"
NSQ_SOURCE_LINE 00000277 "}"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "sub on_start {"
NSQ_SOURCE_LINE 00000280 "  my ($s,@par)=@_;"
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "  $s->{on_start}->(@par) if ref($s->{on_start}) eq 'CODE';"
NSQ_SOURCE_LINE 00000283 "};"
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "sub _waitpid { # Call waitpid() in the standard Unix fashion."
NSQ_SOURCE_LINE 00000286 "    my( $self, $flag ) = @_;"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "    return $flag ? $self->_waitpid_non_blocking : $self->_waitpid_blocking;"
NSQ_SOURCE_LINE 00000289 "}"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "sub _waitpid_non_blocking {"
NSQ_SOURCE_LINE 00000292 "    my $self = shift;"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "    for my $pid ( $self->running_procs ) {"
NSQ_SOURCE_LINE 00000295 "        my $p = waitpid $pid, &WNOHANG or next;"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "        return $pid if $p != -1;"
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "        warn \"child process '$pid' disappeared. A call to `waitpid` outside of Parallel::ForkManager might have reaped it.\\n\";"
NSQ_SOURCE_LINE 00000300 "        # it's gone. let's clean the process entry"
NSQ_SOURCE_LINE 00000301 "        delete $self->{processes}{$pid};"
NSQ_SOURCE_LINE 00000302 "    }"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "    return;"
NSQ_SOURCE_LINE 00000305 "}"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "sub _waitpid_blocking {"
NSQ_SOURCE_LINE 00000308 "    my $self = shift;"
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "    # pseudo-blocking"
NSQ_SOURCE_LINE 00000311 "    if( my $sleep_period = $self->{waitpid_blocking_sleep} ) {"
NSQ_SOURCE_LINE 00000312 "        while() {"
NSQ_SOURCE_LINE 00000313 "            my $pid = $self->_waitpid_non_blocking;"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "            return $pid if defined $pid;"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "            return unless $self->running_procs;"
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "            select undef, undef, undef, $sleep_period;"
NSQ_SOURCE_LINE 00000320 "        }"
NSQ_SOURCE_LINE 00000321 "    }"
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "    return waitpid -1, 0;"
NSQ_SOURCE_LINE 00000324 "}"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "sub DEMOLISH {"
NSQ_SOURCE_LINE 00000327 "    my $self = shift;"
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "    no warnings 'uninitialized';"
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "    File::Path::remove_tree($self->{tempdir})"
NSQ_SOURCE_LINE 00000332 "        if $self->{auto_cleanup} and $self->{parent_pid} == $$ and -d $self->{tempdir};"
NSQ_SOURCE_LINE 00000333 "}"
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "1;"
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "__END__"
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "=pod"
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "=head1 NAME"
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "Parallel::ForkManager - A simple parallel processing fork manager"
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "=head1 VERSION"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "version 2.04"
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "  use Parallel::ForkManager;"
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 "  my $pm = Parallel::ForkManager->new($MAX_PROCESSES);"
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "  DATA_LOOP:"
NSQ_SOURCE_LINE 00000358 "  foreach my $data (@all_data) {"
NSQ_SOURCE_LINE 00000359 "    # Forks and returns the pid for the child:"
NSQ_SOURCE_LINE 00000360 "    my $pid = $pm->start and next DATA_LOOP;"
NSQ_SOURCE_LINE 00000361 ""
NSQ_SOURCE_LINE 00000362 "    ... do some work with $data in the child process ..."
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "    $pm->finish; # Terminates the child process"
NSQ_SOURCE_LINE 00000365 "  }"
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "This module is intended for use in operations that can be done in parallel"
NSQ_SOURCE_LINE 00000370 "where the number of processes to be forked off should be limited. Typical"
NSQ_SOURCE_LINE 00000371 "use is a downloader which will be retrieving hundreds/thousands of files."
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "The code for a downloader would look something like this:"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "  use LWP::Simple;"
NSQ_SOURCE_LINE 00000376 "  use Parallel::ForkManager;"
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 "  ..."
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "  my @links=("
NSQ_SOURCE_LINE 00000381 "    [\"http://www.foo.bar/rulez.data\",\"rulez_data.txt\"],"
NSQ_SOURCE_LINE 00000382 "    [\"http://new.host/more_data.doc\",\"more_data.doc\"],"
NSQ_SOURCE_LINE 00000383 "    ..."
NSQ_SOURCE_LINE 00000384 "  );"
NSQ_SOURCE_LINE 00000385 ""
NSQ_SOURCE_LINE 00000386 "  ..."
NSQ_SOURCE_LINE 00000387 ""
NSQ_SOURCE_LINE 00000388 "  # Max 30 processes for parallel download"
NSQ_SOURCE_LINE 00000389 "  my $pm = Parallel::ForkManager->new(30);"
NSQ_SOURCE_LINE 00000390 ""
NSQ_SOURCE_LINE 00000391 "  LINKS:"
NSQ_SOURCE_LINE 00000392 "  foreach my $linkarray (@links) {"
NSQ_SOURCE_LINE 00000393 "    $pm->start and next LINKS; # do the fork"
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "    my ($link, $fn) = @$linkarray;"
NSQ_SOURCE_LINE 00000396 "    warn \"Cannot get $fn from $link\""
NSQ_SOURCE_LINE 00000397 "      if getstore($link, $fn) != RC_OK;"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "    $pm->finish; # do the exit in the child process"
NSQ_SOURCE_LINE 00000400 "  }"
NSQ_SOURCE_LINE 00000401 "  $pm->wait_all_children;"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "First you need to instantiate the ForkManager with the \"new\" constructor."
NSQ_SOURCE_LINE 00000404 "You must specify the maximum number of processes to be created. If you"
NSQ_SOURCE_LINE 00000405 "specify 0, then NO fork will be done; this is good for debugging purposes."
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "Next, use $pm->start to do the fork. $pm returns 0 for the child process,"
NSQ_SOURCE_LINE 00000408 "and child pid for the parent process (see also L<perlfunc/fork>)."
NSQ_SOURCE_LINE 00000409 "The \"and next\" skips the internal loop in the parent process. NOTE:"
NSQ_SOURCE_LINE 00000410 "$pm->start dies if the fork fails."
NSQ_SOURCE_LINE 00000411 ""
NSQ_SOURCE_LINE 00000412 "$pm->finish terminates the child process (assuming a fork was done in the"
NSQ_SOURCE_LINE 00000413 "\"start\")."
NSQ_SOURCE_LINE 00000414 ""
NSQ_SOURCE_LINE 00000415 "NOTE: You cannot use $pm->start if you are already in the child process."
NSQ_SOURCE_LINE 00000416 "If you want to manage another set of subprocesses in the child process,"
NSQ_SOURCE_LINE 00000417 "you must instantiate another Parallel::ForkManager object!"
NSQ_SOURCE_LINE 00000418 ""
NSQ_SOURCE_LINE 00000419 "=head1 METHODS"
NSQ_SOURCE_LINE 00000420 ""
NSQ_SOURCE_LINE 00000421 "The comment letter indicates where the method should be run. P for parent,"
NSQ_SOURCE_LINE 00000422 "C for child."
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "=over 5"
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 "=item new $processes"
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "Instantiate a new Parallel::ForkManager object. You must specify the maximum"
NSQ_SOURCE_LINE 00000429 "number of children to fork off. If you specify 0 (zero), then no children"
NSQ_SOURCE_LINE 00000430 "will be forked. This is intended for debugging purposes."
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 "The optional second parameter, $tempdir, is only used if you want the"
NSQ_SOURCE_LINE 00000433 "children to send back a reference to some data (see RETRIEVING DATASTRUCTURES"
NSQ_SOURCE_LINE 00000434 "below). If not provided, it is set via a call to L<File::Temp>::tempdir()."
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 "The new method will die if the temporary directory does not exist or it is not"
NSQ_SOURCE_LINE 00000437 "a directory."
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "Since version 2.00, the constructor can also be called in the typical Moo/Moose"
NSQ_SOURCE_LINE 00000440 "fashion. I.e."
NSQ_SOURCE_LINE 00000441 ""
NSQ_SOURCE_LINE 00000442 "    my $fm = Parallel::ForkManager->new("
NSQ_SOURCE_LINE 00000443 "        max_proc => 4,"
NSQ_SOURCE_LINE 00000444 "        tempdir => '...',"
NSQ_SOURCE_LINE 00000445 "        child_role => 'Parallel::ForkManager::CustomChild',"
NSQ_SOURCE_LINE 00000446 "    );"
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 "=item child_role"
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "Returns the name of the role consumed by the ForkManager object in"
NSQ_SOURCE_LINE 00000451 "child processes. Defaults to L<Parallel::ForkManager::Child> and can"
NSQ_SOURCE_LINE 00000452 "be set to something else via the constructor."
NSQ_SOURCE_LINE 00000453 ""
NSQ_SOURCE_LINE 00000454 "=item start [ $process_identifier ]"
NSQ_SOURCE_LINE 00000455 ""
NSQ_SOURCE_LINE 00000456 "This method does the fork. It returns the pid of the child process for"
NSQ_SOURCE_LINE 00000457 "the parent, and 0 for the child process. If the $processes parameter"
NSQ_SOURCE_LINE 00000458 "for the constructor is 0 then, assuming you're in the child process,"
NSQ_SOURCE_LINE 00000459 "$pm->start simply returns 0."
NSQ_SOURCE_LINE 00000460 ""
NSQ_SOURCE_LINE 00000461 "An optional $process_identifier can be provided to this method... It is used by"
NSQ_SOURCE_LINE 00000462 "the \"run_on_finish\" callback (see CALLBACKS) for identifying the finished"
NSQ_SOURCE_LINE 00000463 "process."
NSQ_SOURCE_LINE 00000464 ""
NSQ_SOURCE_LINE 00000465 "=item start_child [ $process_identifier, ] \\&callback"
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "Like C<start>, but will run the C<&callback> as the child. If the callback returns anything,"
NSQ_SOURCE_LINE 00000468 "it'll be passed as the data to transmit back to the parent process via C<finish()>."
NSQ_SOURCE_LINE 00000469 ""
NSQ_SOURCE_LINE 00000470 "=item finish [ $exit_code [, $data_structure_reference] ]"
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "Closes the child process by exiting and accepts an optional exit code"
NSQ_SOURCE_LINE 00000473 "(default exit code is 0) which can be retrieved in the parent via callback."
NSQ_SOURCE_LINE 00000474 "If the second optional parameter is provided, the child attempts to send"
NSQ_SOURCE_LINE 00000475 "its contents back to the parent. If you use the program in debug mode"
NSQ_SOURCE_LINE 00000476 "($processes == 0), this method just calls the callback."
NSQ_SOURCE_LINE 00000477 ""
NSQ_SOURCE_LINE 00000478 "If the $data_structure_reference is provided, then it is serialized and"
NSQ_SOURCE_LINE 00000479 "passed to the parent process. See RETRIEVING DATASTRUCTURES for more info."
NSQ_SOURCE_LINE 00000480 ""
NSQ_SOURCE_LINE 00000481 "=item set_max_procs $processes"
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 "Allows you to set a new maximum number of children to maintain."
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "=item wait_all_children"
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "You can call this method to wait for all the processes which have been"
NSQ_SOURCE_LINE 00000488 "forked. This is a blocking wait."
NSQ_SOURCE_LINE 00000489 ""
NSQ_SOURCE_LINE 00000490 "=item reap_finished_children"
NSQ_SOURCE_LINE 00000491 ""
NSQ_SOURCE_LINE 00000492 "This is a non-blocking call to reap children and execute callbacks independent"
NSQ_SOURCE_LINE 00000493 "of calls to \"start\" or \"wait_all_children\". Use this in scenarios where \"start\""
NSQ_SOURCE_LINE 00000494 "is called infrequently but you would like the callbacks executed quickly."
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "=item is_parent"
NSQ_SOURCE_LINE 00000497 ""
NSQ_SOURCE_LINE 00000498 "Returns C<true> if within the parent or C<false> if within the child."
NSQ_SOURCE_LINE 00000499 ""
NSQ_SOURCE_LINE 00000500 "=item is_child"
NSQ_SOURCE_LINE 00000501 ""
NSQ_SOURCE_LINE 00000502 "Returns C<true> if within the child or C<false> if within the parent."
NSQ_SOURCE_LINE 00000503 ""
NSQ_SOURCE_LINE 00000504 "=item max_procs"
NSQ_SOURCE_LINE 00000505 ""
NSQ_SOURCE_LINE 00000506 "Returns the maximal number of processes the object will fork."
NSQ_SOURCE_LINE 00000507 ""
NSQ_SOURCE_LINE 00000508 "=item running_procs"
NSQ_SOURCE_LINE 00000509 ""
NSQ_SOURCE_LINE 00000510 "Returns the pids of the forked processes currently monitored by the"
NSQ_SOURCE_LINE 00000511 "C<Parallel::ForkManager>. Note that children are still reported as running"
NSQ_SOURCE_LINE 00000512 "until the fork manager harvest them, via the next call to"
NSQ_SOURCE_LINE 00000513 "C<start> or C<wait_all_children>."
NSQ_SOURCE_LINE 00000514 ""
NSQ_SOURCE_LINE 00000515 "    my @pids = $pm->running_procs;"
NSQ_SOURCE_LINE 00000516 ""
NSQ_SOURCE_LINE 00000517 "    my $nbr_children = $pm->running_procs;"
NSQ_SOURCE_LINE 00000518 ""
NSQ_SOURCE_LINE 00000519 "=item running_procs_with_identifiers"
NSQ_SOURCE_LINE 00000520 ""
NSQ_SOURCE_LINE 00000521 "Returns a list of pairs.  The keys are the pids of forked processes (as"
NSQ_SOURCE_LINE 00000522 "returned by C<running_procs> and the values are the identifiers given to those"
NSQ_SOURCE_LINE 00000523 "pids by C<start>.  If no identifier was given for a process, the value for that"
NSQ_SOURCE_LINE 00000524 "pid will be undefined."
NSQ_SOURCE_LINE 00000525 ""
NSQ_SOURCE_LINE 00000526 "=item wait_for_available_procs( $n )"
NSQ_SOURCE_LINE 00000527 ""
NSQ_SOURCE_LINE 00000528 "Wait until C<$n> available process slots are available."
NSQ_SOURCE_LINE 00000529 "If C<$n> is not given, defaults to I<1>."
NSQ_SOURCE_LINE 00000530 ""
NSQ_SOURCE_LINE 00000531 "=item waitpid_blocking_sleep"
NSQ_SOURCE_LINE 00000532 ""
NSQ_SOURCE_LINE 00000533 "Returns the sleep period, in seconds, of the pseudo-blocking calls. The sleep"
NSQ_SOURCE_LINE 00000534 "period can be a fraction of second."
NSQ_SOURCE_LINE 00000535 ""
NSQ_SOURCE_LINE 00000536 "Returns C<0> if disabled."
NSQ_SOURCE_LINE 00000537 ""
NSQ_SOURCE_LINE 00000538 "Defaults to 1 second."
NSQ_SOURCE_LINE 00000539 ""
NSQ_SOURCE_LINE 00000540 "See I<BLOCKING CALLS> for more details."
NSQ_SOURCE_LINE 00000541 ""
NSQ_SOURCE_LINE 00000542 "=item set_waitpid_blocking_sleep $seconds"
NSQ_SOURCE_LINE 00000543 ""
NSQ_SOURCE_LINE 00000544 "Sets the the sleep period, in seconds, of the pseudo-blocking calls."
NSQ_SOURCE_LINE 00000545 "Set to C<0> to disable."
NSQ_SOURCE_LINE 00000546 ""
NSQ_SOURCE_LINE 00000547 "See I<BLOCKING CALLS> for more details."
NSQ_SOURCE_LINE 00000548 ""
NSQ_SOURCE_LINE 00000549 "=back"
NSQ_SOURCE_LINE 00000550 ""
NSQ_SOURCE_LINE 00000551 "=head1 CALLBACKS"
NSQ_SOURCE_LINE 00000552 ""
NSQ_SOURCE_LINE 00000553 "You can define callbacks in the code, which are called on events like starting"
NSQ_SOURCE_LINE 00000554 "a process or upon finish. Declare these before the first call to start()."
NSQ_SOURCE_LINE 00000555 ""
NSQ_SOURCE_LINE 00000556 "The callbacks can be defined with the following methods:"
NSQ_SOURCE_LINE 00000557 ""
NSQ_SOURCE_LINE 00000558 "=over 4"
NSQ_SOURCE_LINE 00000559 ""
NSQ_SOURCE_LINE 00000560 "=item run_on_finish $code [, $pid ]"
NSQ_SOURCE_LINE 00000561 ""
NSQ_SOURCE_LINE 00000562 "You can define a subroutine which is called when a child is terminated. It is"
NSQ_SOURCE_LINE 00000563 "called in the parent process."
NSQ_SOURCE_LINE 00000564 ""
NSQ_SOURCE_LINE 00000565 "The parameters of the $code are the following:"
NSQ_SOURCE_LINE 00000566 ""
NSQ_SOURCE_LINE 00000567 "  - pid of the process, which is terminated"
NSQ_SOURCE_LINE 00000568 "  - exit code of the program"
NSQ_SOURCE_LINE 00000569 "  - identification of the process (if provided in the \"start\" method)"
NSQ_SOURCE_LINE 00000570 "  - exit signal (0-127: signal name)"
NSQ_SOURCE_LINE 00000571 "  - core dump (1 if there was core dump at exit)"
NSQ_SOURCE_LINE 00000572 "  - datastructure reference or undef (see RETRIEVING DATASTRUCTURES)"
NSQ_SOURCE_LINE 00000573 ""
NSQ_SOURCE_LINE 00000574 "=item run_on_start $code"
NSQ_SOURCE_LINE 00000575 ""
NSQ_SOURCE_LINE 00000576 "You can define a subroutine which is called when a child is started. It called"
NSQ_SOURCE_LINE 00000577 "after the successful startup of a child in the parent process."
NSQ_SOURCE_LINE 00000578 ""
NSQ_SOURCE_LINE 00000579 "The parameters of the $code are the following:"
NSQ_SOURCE_LINE 00000580 ""
NSQ_SOURCE_LINE 00000581 "  - pid of the process which has been started"
NSQ_SOURCE_LINE 00000582 "  - identification of the process (if provided in the \"start\" method)"
NSQ_SOURCE_LINE 00000583 ""
NSQ_SOURCE_LINE 00000584 "=item run_on_wait $code, [$period]"
NSQ_SOURCE_LINE 00000585 ""
NSQ_SOURCE_LINE 00000586 "You can define a subroutine which is called when the child process needs to wait"
NSQ_SOURCE_LINE 00000587 "for the startup. If $period is not defined, then one call is done per"
NSQ_SOURCE_LINE 00000588 "child. If $period is defined, then $code is called periodically and the"
NSQ_SOURCE_LINE 00000589 "module waits for $period seconds between the two calls. Note, $period can be"
NSQ_SOURCE_LINE 00000590 "fractional number also. The exact \"$period seconds\" is not guaranteed,"
NSQ_SOURCE_LINE 00000591 "signals can shorten and the process scheduler can make it longer (on busy"
NSQ_SOURCE_LINE 00000592 "systems)."
NSQ_SOURCE_LINE 00000593 ""
NSQ_SOURCE_LINE 00000594 "The $code called in the \"start\" and the \"wait_all_children\" method also."
NSQ_SOURCE_LINE 00000595 ""
NSQ_SOURCE_LINE 00000596 "No parameters are passed to the $code on the call."
NSQ_SOURCE_LINE 00000597 ""
NSQ_SOURCE_LINE 00000598 "=back"
NSQ_SOURCE_LINE 00000599 ""
NSQ_SOURCE_LINE 00000600 "=head1 BLOCKING CALLS"
NSQ_SOURCE_LINE 00000601 ""
NSQ_SOURCE_LINE 00000602 "When it comes to waiting for child processes to terminate, C<Parallel::ForkManager> is between"
NSQ_SOURCE_LINE 00000603 "a fork and a hard place (if you excuse the terrible pun). The underlying Perl C<waitpid> function"
NSQ_SOURCE_LINE 00000604 "that the module relies on can block until either one specific or any child process"
NSQ_SOURCE_LINE 00000605 "terminate, but not for a process part of a given group."
NSQ_SOURCE_LINE 00000606 ""
NSQ_SOURCE_LINE 00000607 "This means that the module can do one of two things when it waits for"
NSQ_SOURCE_LINE 00000608 "one of its child processes to terminate:"
NSQ_SOURCE_LINE 00000609 ""
NSQ_SOURCE_LINE 00000610 "=over"
NSQ_SOURCE_LINE 00000611 ""
NSQ_SOURCE_LINE 00000612 "=item Only wait for its own child processes"
NSQ_SOURCE_LINE 00000613 ""
NSQ_SOURCE_LINE 00000614 "This is done via a loop using a C<waitpid> non-blocking call and a sleep statement."
NSQ_SOURCE_LINE 00000615 "The code does something along the lines of"
NSQ_SOURCE_LINE 00000616 ""
NSQ_SOURCE_LINE 00000617 "    while(1) {"
NSQ_SOURCE_LINE 00000618 "        if ( any of the P::FM child process terminated ) {"
NSQ_SOURCE_LINE 00000619 "            return its pid"
NSQ_SOURCE_LINE 00000620 "        }"
NSQ_SOURCE_LINE 00000621 ""
NSQ_SOURCE_LINE 00000622 "        sleep $sleep_period"
NSQ_SOURCE_LINE 00000623 "    }"
NSQ_SOURCE_LINE 00000624 ""
NSQ_SOURCE_LINE 00000625 "This is the default behavior that the module will use."
NSQ_SOURCE_LINE 00000626 "This is not the most efficient way to wait for child processes, but it's"
NSQ_SOURCE_LINE 00000627 "the safest way to ensure that C<Parallel::ForkManager> won't interfere with"
NSQ_SOURCE_LINE 00000628 "any other part of the codebase."
NSQ_SOURCE_LINE 00000629 ""
NSQ_SOURCE_LINE 00000630 "The sleep period is set via the method C<set_waitpid_blocking_sleep>."
NSQ_SOURCE_LINE 00000631 ""
NSQ_SOURCE_LINE 00000632 "=item Block until any process terminate"
NSQ_SOURCE_LINE 00000633 ""
NSQ_SOURCE_LINE 00000634 "Alternatively, C<Parallel::ForkManager> can call C<waitpid> such that it will"
NSQ_SOURCE_LINE 00000635 "block until any child process terminate. If the child process was not one of"
NSQ_SOURCE_LINE 00000636 "the monitored subprocesses, the wait will resume. This is more efficient, but mean"
NSQ_SOURCE_LINE 00000637 "that C<P::FM> can captures (and discards) the termination notification that a different"
NSQ_SOURCE_LINE 00000638 "part of the code might be waiting for."
NSQ_SOURCE_LINE 00000639 ""
NSQ_SOURCE_LINE 00000640 "If this is a race condition"
NSQ_SOURCE_LINE 00000641 "that doesn't apply to your codebase, you can set the"
NSQ_SOURCE_LINE 00000642 "I<waitpid_blocking_sleep> period to C<0>, which will enable C<waitpid> call blocking."
NSQ_SOURCE_LINE 00000643 ""
NSQ_SOURCE_LINE 00000644 "    my $pm = Parallel::ForkManager->new( 4 );"
NSQ_SOURCE_LINE 00000645 ""
NSQ_SOURCE_LINE 00000646 "    $pm->set_waitpid_blocking_sleep(0);  # true blocking calls enabled"
NSQ_SOURCE_LINE 00000647 ""
NSQ_SOURCE_LINE 00000648 "    for ( 1..100 ) {"
NSQ_SOURCE_LINE 00000649 "        $pm->start and next;"
NSQ_SOURCE_LINE 00000650 ""
NSQ_SOURCE_LINE 00000651 "        ...; # do work"
NSQ_SOURCE_LINE 00000652 ""
NSQ_SOURCE_LINE 00000653 "        $pm->finish;"
NSQ_SOURCE_LINE 00000654 "    }"
NSQ_SOURCE_LINE 00000655 ""
NSQ_SOURCE_LINE 00000656 "=back"
NSQ_SOURCE_LINE 00000657 ""
NSQ_SOURCE_LINE 00000658 "=head1 RETRIEVING DATASTRUCTURES from child processes"
NSQ_SOURCE_LINE 00000659 ""
NSQ_SOURCE_LINE 00000660 "The ability for the parent to retrieve data structures is new as of version"
NSQ_SOURCE_LINE 00000661 "0.7.6."
NSQ_SOURCE_LINE 00000662 ""
NSQ_SOURCE_LINE 00000663 "Each child process may optionally send 1 data structure back to the parent."
NSQ_SOURCE_LINE 00000664 "By data structure, we mean a reference to a string, hash or array. The"
NSQ_SOURCE_LINE 00000665 "contents of the data structure are written out to temporary files on disc"
NSQ_SOURCE_LINE 00000666 "using the L<Storable> modules' store() method. The reference is then"
NSQ_SOURCE_LINE 00000667 "retrieved from within the code you send to the run_on_finish callback."
NSQ_SOURCE_LINE 00000668 ""
NSQ_SOURCE_LINE 00000669 "The data structure can be any scalar perl data structure which makes sense:"
NSQ_SOURCE_LINE 00000670 "string, numeric value or a reference to an array, hash or object."
NSQ_SOURCE_LINE 00000671 ""
NSQ_SOURCE_LINE 00000672 "There are 2 steps involved in retrieving data structures:"
NSQ_SOURCE_LINE 00000673 ""
NSQ_SOURCE_LINE 00000674 "1) A reference to the data structure the child wishes to send back to the"
NSQ_SOURCE_LINE 00000675 "parent is provided as the second argument to the finish() call. It is up"
NSQ_SOURCE_LINE 00000676 "to the child to decide whether or not to send anything back to the parent."
NSQ_SOURCE_LINE 00000677 ""
NSQ_SOURCE_LINE 00000678 "2) The data structure reference is retrieved using the callback provided in"
NSQ_SOURCE_LINE 00000679 "the run_on_finish() method."
NSQ_SOURCE_LINE 00000680 ""
NSQ_SOURCE_LINE 00000681 "Keep in mind that data structure retrieval is not the same as returning a"
NSQ_SOURCE_LINE 00000682 "data structure from a method call. That is not what actually occurs. The"
NSQ_SOURCE_LINE 00000683 "data structure referenced in a given child process is serialized and"
NSQ_SOURCE_LINE 00000684 "written out to a file by L<Storable>. The file is subsequently read back"
NSQ_SOURCE_LINE 00000685 "into memory and a new data structure belonging to the parent process is"
NSQ_SOURCE_LINE 00000686 "created. Please consider the performance penalty it can imply, so try to"
NSQ_SOURCE_LINE 00000687 "keep the returned structure small."
NSQ_SOURCE_LINE 00000688 ""
NSQ_SOURCE_LINE 00000689 "=head1 EXAMPLES"
NSQ_SOURCE_LINE 00000690 ""
NSQ_SOURCE_LINE 00000691 "=head2 Parallel get"
NSQ_SOURCE_LINE 00000692 ""
NSQ_SOURCE_LINE 00000693 "This small example can be used to get URLs in parallel."
NSQ_SOURCE_LINE 00000694 ""
NSQ_SOURCE_LINE 00000695 "  use Parallel::ForkManager;"
NSQ_SOURCE_LINE 00000696 "  use LWP::Simple;"
NSQ_SOURCE_LINE 00000697 ""
NSQ_SOURCE_LINE 00000698 "  my $pm = Parallel::ForkManager->new(10);"
NSQ_SOURCE_LINE 00000699 ""
NSQ_SOURCE_LINE 00000700 "  LINKS:"
NSQ_SOURCE_LINE 00000701 "  for my $link (@ARGV) {"
NSQ_SOURCE_LINE 00000702 "    $pm->start and next LINKS;"
NSQ_SOURCE_LINE 00000703 "    my ($fn) = $link =~ /^.*\\/(.*?)$/;"
NSQ_SOURCE_LINE 00000704 "    if (!$fn) {"
NSQ_SOURCE_LINE 00000705 "      warn \"Cannot determine filename from $fn\\n\";"
NSQ_SOURCE_LINE 00000706 "    } else {"
NSQ_SOURCE_LINE 00000707 "      $0 .= \" \" . $fn;"
NSQ_SOURCE_LINE 00000708 "      print \"Getting $fn from $link\\n\";"
NSQ_SOURCE_LINE 00000709 "      my $rc = getstore($link, $fn);"
NSQ_SOURCE_LINE 00000710 "      print \"$link downloaded. response code: $rc\\n\";"
NSQ_SOURCE_LINE 00000711 "    };"
NSQ_SOURCE_LINE 00000712 "    $pm->finish;"
NSQ_SOURCE_LINE 00000713 "  };"
NSQ_SOURCE_LINE 00000714 ""
NSQ_SOURCE_LINE 00000715 "=head2 Callbacks"
NSQ_SOURCE_LINE 00000716 ""
NSQ_SOURCE_LINE 00000717 "Example of a program using callbacks to get child exit codes:"
NSQ_SOURCE_LINE 00000718 ""
NSQ_SOURCE_LINE 00000719 "  use strict;"
NSQ_SOURCE_LINE 00000720 "  use Parallel::ForkManager;"
NSQ_SOURCE_LINE 00000721 ""
NSQ_SOURCE_LINE 00000722 "  my $max_procs = 5;"
NSQ_SOURCE_LINE 00000723 "  my @names = qw( Fred Jim Lily Steve Jessica Bob Dave Christine Rico Sara );"
NSQ_SOURCE_LINE 00000724 "  # hash to resolve PID's back to child specific information"
NSQ_SOURCE_LINE 00000725 ""
NSQ_SOURCE_LINE 00000726 "  my $pm = Parallel::ForkManager->new($max_procs);"
NSQ_SOURCE_LINE 00000727 ""
NSQ_SOURCE_LINE 00000728 "  # Setup a callback for when a child finishes up so we can"
NSQ_SOURCE_LINE 00000729 "  # get it's exit code"
NSQ_SOURCE_LINE 00000730 "  $pm->run_on_finish( sub {"
NSQ_SOURCE_LINE 00000731 "      my ($pid, $exit_code, $ident) = @_;"
NSQ_SOURCE_LINE 00000732 "      print \"** $ident just got out of the pool \"."
NSQ_SOURCE_LINE 00000733 "        \"with PID $pid and exit code: $exit_code\\n\";"
NSQ_SOURCE_LINE 00000734 "  });"
NSQ_SOURCE_LINE 00000735 ""
NSQ_SOURCE_LINE 00000736 "  $pm->run_on_start( sub {"
NSQ_SOURCE_LINE 00000737 "      my ($pid, $ident)=@_;"
NSQ_SOURCE_LINE 00000738 "      print \"** $ident started, pid: $pid\\n\";"
NSQ_SOURCE_LINE 00000739 "  });"
NSQ_SOURCE_LINE 00000740 ""
NSQ_SOURCE_LINE 00000741 "  $pm->run_on_wait( sub {"
NSQ_SOURCE_LINE 00000742 "      print \"** Have to wait for one children ...\\n\""
NSQ_SOURCE_LINE 00000743 "    },"
NSQ_SOURCE_LINE 00000744 "    0.5"
NSQ_SOURCE_LINE 00000745 "  );"
NSQ_SOURCE_LINE 00000746 ""
NSQ_SOURCE_LINE 00000747 "  NAMES:"
NSQ_SOURCE_LINE 00000748 "  foreach my $child ( 0 .. $#names ) {"
NSQ_SOURCE_LINE 00000749 "    my $pid = $pm->start($names[$child]) and next NAMES;"
NSQ_SOURCE_LINE 00000750 ""
NSQ_SOURCE_LINE 00000751 "    # This code is the child process"
NSQ_SOURCE_LINE 00000752 "    print \"This is $names[$child], Child number $child\\n\";"
NSQ_SOURCE_LINE 00000753 "    sleep ( 2 * $child );"
NSQ_SOURCE_LINE 00000754 "    print \"$names[$child], Child $child is about to get out...\\n\";"
NSQ_SOURCE_LINE 00000755 "    sleep 1;"
NSQ_SOURCE_LINE 00000756 "    $pm->finish($child); # pass an exit code to finish"
NSQ_SOURCE_LINE 00000757 "  }"
NSQ_SOURCE_LINE 00000758 ""
NSQ_SOURCE_LINE 00000759 "  print \"Waiting for Children...\\n\";"
NSQ_SOURCE_LINE 00000760 "  $pm->wait_all_children;"
NSQ_SOURCE_LINE 00000761 "  print \"Everybody is out of the pool!\\n\";"
NSQ_SOURCE_LINE 00000762 ""
NSQ_SOURCE_LINE 00000763 "=head2 Data structure retrieval"
NSQ_SOURCE_LINE 00000764 ""
NSQ_SOURCE_LINE 00000765 "In this simple example, each child sends back a string reference."
NSQ_SOURCE_LINE 00000766 ""
NSQ_SOURCE_LINE 00000767 "  use Parallel::ForkManager 0.7.6;"
NSQ_SOURCE_LINE 00000768 "  use strict;"
NSQ_SOURCE_LINE 00000769 ""
NSQ_SOURCE_LINE 00000770 "  my $pm = Parallel::ForkManager->new(2, '/server/path/to/temp/dir/');"
NSQ_SOURCE_LINE 00000771 ""
NSQ_SOURCE_LINE 00000772 "  # data structure retrieval and handling"
NSQ_SOURCE_LINE 00000773 "  $pm -> run_on_finish ( # called BEFORE the first call to start()"
NSQ_SOURCE_LINE 00000774 "    sub {"
NSQ_SOURCE_LINE 00000775 "      my ($pid, $exit_code, $ident, $exit_signal, $core_dump, $data_structure_reference) = @_;"
NSQ_SOURCE_LINE 00000776 ""
NSQ_SOURCE_LINE 00000777 "      # retrieve data structure from child"
NSQ_SOURCE_LINE 00000778 "      if (defined($data_structure_reference)) {  # children are not forced to send anything"
NSQ_SOURCE_LINE 00000779 "        my $string = ${$data_structure_reference};  # child passed a string reference"
NSQ_SOURCE_LINE 00000780 "        print \"$string\\n\";"
NSQ_SOURCE_LINE 00000781 "      }"
NSQ_SOURCE_LINE 00000782 "      else {  # problems occurring during storage or retrieval will throw a warning"
NSQ_SOURCE_LINE 00000783 "        print qq|No message received from child process $pid!\\n|;"
NSQ_SOURCE_LINE 00000784 "      }"
NSQ_SOURCE_LINE 00000785 "    }"
NSQ_SOURCE_LINE 00000786 "  );"
NSQ_SOURCE_LINE 00000787 ""
NSQ_SOURCE_LINE 00000788 "  # prep random statement components"
NSQ_SOURCE_LINE 00000789 "  my @foods = ('chocolate', 'ice cream', 'peanut butter', 'pickles', 'pizza', 'bacon', 'pancakes', 'spaghetti', 'cookies');"
NSQ_SOURCE_LINE 00000790 "  my @preferences = ('loves', q|can't stand|, 'always wants more', 'will walk 100 miles for', 'only eats', 'would starve rather than eat');"
NSQ_SOURCE_LINE 00000791 ""
NSQ_SOURCE_LINE 00000792 "  # run the parallel processes"
NSQ_SOURCE_LINE 00000793 "  PERSONS:"
NSQ_SOURCE_LINE 00000794 "  foreach my $person (qw(Fred Wilma Ernie Bert Lucy Ethel Curly Moe Larry)) {"
NSQ_SOURCE_LINE 00000795 "    $pm->start() and next PERSONS;"
NSQ_SOURCE_LINE 00000796 ""
NSQ_SOURCE_LINE 00000797 "    # generate a random statement about food preferences"
NSQ_SOURCE_LINE 00000798 "    my $statement = $person . ' ' . $preferences[int(rand @preferences)] . ' ' . $foods[int(rand @foods)];"
NSQ_SOURCE_LINE 00000799 ""
NSQ_SOURCE_LINE 00000800 "    # send it back to the parent process"
NSQ_SOURCE_LINE 00000801 "    $pm->finish(0, \\$statement);  # note that it's a scalar REFERENCE, not the scalar itself"
NSQ_SOURCE_LINE 00000802 "  }"
NSQ_SOURCE_LINE 00000803 "  $pm->wait_all_children;"
NSQ_SOURCE_LINE 00000804 ""
NSQ_SOURCE_LINE 00000805 "A second datastructure retrieval example demonstrates how children decide"
NSQ_SOURCE_LINE 00000806 "whether or not to send anything back, what to send and how the parent should"
NSQ_SOURCE_LINE 00000807 "process whatever is retrieved."
NSQ_SOURCE_LINE 00000808 ""
NSQ_SOURCE_LINE 00000809 "=for example begin"
NSQ_SOURCE_LINE 00000810 ""
NSQ_SOURCE_LINE 00000811 "  use Parallel::ForkManager 0.7.6;"
NSQ_SOURCE_LINE 00000812 "  use Data::Dumper;  # to display the data structures retrieved."
NSQ_SOURCE_LINE 00000813 "  use strict;"
NSQ_SOURCE_LINE 00000814 ""
NSQ_SOURCE_LINE 00000815 "  my $pm = Parallel::ForkManager->new(20);  # using the system temp dir $L<File::Temp::tempdir()"
NSQ_SOURCE_LINE 00000816 ""
NSQ_SOURCE_LINE 00000817 "  # data structure retrieval and handling"
NSQ_SOURCE_LINE 00000818 "  my %retrieved_responses = ();  # for collecting responses"
NSQ_SOURCE_LINE 00000819 "  $pm -> run_on_finish ("
NSQ_SOURCE_LINE 00000820 "    sub {"
NSQ_SOURCE_LINE 00000821 "      my ($pid, $exit_code, $ident, $exit_signal, $core_dump, $data_structure_reference) = @_;"
NSQ_SOURCE_LINE 00000822 ""
NSQ_SOURCE_LINE 00000823 "      # see what the child sent us, if anything"
NSQ_SOURCE_LINE 00000824 "      if (defined($data_structure_reference)) {  # test rather than assume child sent anything"
NSQ_SOURCE_LINE 00000825 "        my $reftype = ref($data_structure_reference);"
NSQ_SOURCE_LINE 00000826 "        print qq|ident \"$ident\" returned a \"$reftype\" reference.\\n\\n|;"
NSQ_SOURCE_LINE 00000827 "        if (1) {  # simple on/off switch to display the contents"
NSQ_SOURCE_LINE 00000828 "          print &Dumper($data_structure_reference) . qq|end of \"$ident\" sent structure\\n\\n|;"
NSQ_SOURCE_LINE 00000829 "        }"
NSQ_SOURCE_LINE 00000830 ""
NSQ_SOURCE_LINE 00000831 "        # we can also collect retrieved data structures for processing after all children have exited"
NSQ_SOURCE_LINE 00000832 "        $retrieved_responses{$ident} = $data_structure_reference;"
NSQ_SOURCE_LINE 00000833 "      } else {"
NSQ_SOURCE_LINE 00000834 "        print qq|ident \"$ident\" did not send anything.\\n\\n|;"
NSQ_SOURCE_LINE 00000835 "      }"
NSQ_SOURCE_LINE 00000836 "    }"
NSQ_SOURCE_LINE 00000837 "  );"
NSQ_SOURCE_LINE 00000838 ""
NSQ_SOURCE_LINE 00000839 "  # generate a list of instructions"
NSQ_SOURCE_LINE 00000840 "  my @instructions = (  # a unique identifier and what the child process should send"
NSQ_SOURCE_LINE 00000841 "    {'name' => '%ENV keys as a string', 'send' => 'keys'},"
NSQ_SOURCE_LINE 00000842 "    {'name' => 'Send Nothing'},  # not instructing the child to send anything back to the parent"
NSQ_SOURCE_LINE 00000843 "    {'name' => 'Childs %ENV', 'send' => 'all'},"
NSQ_SOURCE_LINE 00000844 "    {'name' => 'Child chooses randomly', 'send' => 'random'},"
NSQ_SOURCE_LINE 00000845 "    {'name' => 'Invalid send instructions', 'send' => 'Na Na Nana Na'},"
NSQ_SOURCE_LINE 00000846 "    {'name' => 'ENV values in an array', 'send' => 'values'},"
NSQ_SOURCE_LINE 00000847 "  );"
NSQ_SOURCE_LINE 00000848 ""
NSQ_SOURCE_LINE 00000849 "  INSTRUCTS:"
NSQ_SOURCE_LINE 00000850 "  foreach my $instruction (@instructions) {"
NSQ_SOURCE_LINE 00000851 "    $pm->start($instruction->{'name'}) and next INSTRUCTS;  # this time we are using an explicit, unique child process identifier"
NSQ_SOURCE_LINE 00000852 ""
NSQ_SOURCE_LINE 00000853 "    # last step in child processing"
NSQ_SOURCE_LINE 00000854 "    $pm->finish(0) unless $instruction->{'send'};  # no data structure is sent unless this child is told what to send."
NSQ_SOURCE_LINE 00000855 ""
NSQ_SOURCE_LINE 00000856 "    if ($instruction->{'send'} eq 'keys') {"
NSQ_SOURCE_LINE 00000857 "      $pm->finish(0, \\join(', ', keys %ENV));"
NSQ_SOURCE_LINE 00000858 ""
NSQ_SOURCE_LINE 00000859 "    } elsif ($instruction->{'send'} eq 'values') {"
NSQ_SOURCE_LINE 00000860 "      $pm->finish(0, [values %ENV]);  # kinda useless without knowing which keys they belong to..."
NSQ_SOURCE_LINE 00000861 ""
NSQ_SOURCE_LINE 00000862 "    } elsif ($instruction->{'send'} eq 'all') {"
NSQ_SOURCE_LINE 00000863 "      $pm->finish(0, \\%ENV);  # remember, we are not \"returning\" anything, just copying the hash to disc"
NSQ_SOURCE_LINE 00000864 ""
NSQ_SOURCE_LINE 00000865 "    # demonstrate clearly that the child determines what type of reference to send"
NSQ_SOURCE_LINE 00000866 "    } elsif ($instruction->{'send'} eq 'random') {"
NSQ_SOURCE_LINE 00000867 "      my $string = q|I'm just a string.|;"
NSQ_SOURCE_LINE 00000868 "      my @array = qw(I am an array);"
NSQ_SOURCE_LINE 00000869 "      my %hash = (type => 'associative array', synonym => 'hash', cool => 'very :)');"
NSQ_SOURCE_LINE 00000870 "      my $return_choice = ('string', 'array', 'hash')[int(rand 3)];  # randomly choose return data type"
NSQ_SOURCE_LINE 00000871 "      $pm->finish(0, \\$string) if ($return_choice eq 'string');"
NSQ_SOURCE_LINE 00000872 "      $pm->finish(0, \\@array) if ($return_choice eq 'array');"
NSQ_SOURCE_LINE 00000873 "      $pm->finish(0, \\%hash) if ($return_choice eq 'hash');"
NSQ_SOURCE_LINE 00000874 ""
NSQ_SOURCE_LINE 00000875 "    # as a responsible child, inform parent that their instruction was invalid"
NSQ_SOURCE_LINE 00000876 "    } else {"
NSQ_SOURCE_LINE 00000877 "      $pm->finish(0, \\qq|Invalid instructions: \"$instruction->{'send'}\".|);  # ordinarily I wouldn't include invalid input in a response..."
NSQ_SOURCE_LINE 00000878 "    }"
NSQ_SOURCE_LINE 00000879 "  }"
NSQ_SOURCE_LINE 00000880 "  $pm->wait_all_children;  # blocks until all forked processes have exited"
NSQ_SOURCE_LINE 00000881 ""
NSQ_SOURCE_LINE 00000882 "  # post fork processing of returned data structures"
NSQ_SOURCE_LINE 00000883 "  for (sort keys %retrieved_responses) {"
NSQ_SOURCE_LINE 00000884 "    print qq|Post processing \"$_\"...\\n|;"
NSQ_SOURCE_LINE 00000885 "  }"
NSQ_SOURCE_LINE 00000886 ""
NSQ_SOURCE_LINE 00000887 "=for example end"
NSQ_SOURCE_LINE 00000888 ""
NSQ_SOURCE_LINE 00000889 "=head1 USING RAND() IN FORKED PROCESSES"
NSQ_SOURCE_LINE 00000890 ""
NSQ_SOURCE_LINE 00000891 "A caveat worth noting is that all forked processes will use the"
NSQ_SOURCE_LINE 00000892 "same random seed, so potentially providing the same results (see"
NSQ_SOURCE_LINE 00000893 "L<http://blogs.perl.org/users/brian_phillips/2010/06/when-rand-isnt-random.html>)."
NSQ_SOURCE_LINE 00000894 "If you are using C<rand()> and want each forked child to use a different seed, you"
NSQ_SOURCE_LINE 00000895 "can add the following to your program:"
NSQ_SOURCE_LINE 00000896 ""
NSQ_SOURCE_LINE 00000897 "    $pm->run_on_start(sub { srand });"
NSQ_SOURCE_LINE 00000898 ""
NSQ_SOURCE_LINE 00000899 "=head1 EXTENDING"
NSQ_SOURCE_LINE 00000900 ""
NSQ_SOURCE_LINE 00000901 "As of version 2.0.0, C<Parallel::ForkManager> uses L<Moo> under the hood. When"
NSQ_SOURCE_LINE 00000902 "a process is being forked from the parent object, the forked instance of the"
NSQ_SOURCE_LINE 00000903 "object will be modified to consume the L<Parallel::ForkManager::Child>"
NSQ_SOURCE_LINE 00000904 "role. All of this makes extending L<Parallel::ForkManager> to implement"
NSQ_SOURCE_LINE 00000905 "any storing/retrieving mechanism or any other behavior fairly easy."
NSQ_SOURCE_LINE 00000906 ""
NSQ_SOURCE_LINE 00000907 "=head2 Example: store and retrieve data via a web service"
NSQ_SOURCE_LINE 00000908 ""
NSQ_SOURCE_LINE 00000909 "    {"
NSQ_SOURCE_LINE 00000910 "        package Parallel::ForkManager::Web;"
NSQ_SOURCE_LINE 00000911 ""
NSQ_SOURCE_LINE 00000912 "        use HTTP::Tiny;"
NSQ_SOURCE_LINE 00000913 ""
NSQ_SOURCE_LINE 00000914 "        use Moo;"
NSQ_SOURCE_LINE 00000915 "        extends 'Parallel::ForkManager';"
NSQ_SOURCE_LINE 00000916 ""
NSQ_SOURCE_LINE 00000917 "        has ua => ("
NSQ_SOURCE_LINE 00000918 "            is => 'ro',"
NSQ_SOURCE_LINE 00000919 "            lazy => 1,"
NSQ_SOURCE_LINE 00000920 "            default => sub {"
NSQ_SOURCE_LINE 00000921 "                HTTP::Tiny->new;"
NSQ_SOURCE_LINE 00000922 "            }"
NSQ_SOURCE_LINE 00000923 "        );"
NSQ_SOURCE_LINE 00000924 ""
NSQ_SOURCE_LINE 00000925 "        sub store {"
NSQ_SOURCE_LINE 00000926 "            my( $self, $data ) = @_;"
NSQ_SOURCE_LINE 00000927 ""
NSQ_SOURCE_LINE 00000928 "            $self->ua->post( \"http://.../store/$$\", { body => $data } );"
NSQ_SOURCE_LINE 00000929 "        }"
NSQ_SOURCE_LINE 00000930 ""
NSQ_SOURCE_LINE 00000931 "        sub retrieve {"
NSQ_SOURCE_LINE 00000932 "            my( $self, $kid_id ) = @_;"
NSQ_SOURCE_LINE 00000933 ""
NSQ_SOURCE_LINE 00000934 "            $self->ua->get( \"http://.../store/$kid_id\" )->{content};"
NSQ_SOURCE_LINE 00000935 "        }"
NSQ_SOURCE_LINE 00000936 ""
NSQ_SOURCE_LINE 00000937 "    }"
NSQ_SOURCE_LINE 00000938 ""
NSQ_SOURCE_LINE 00000939 "    my $fm = Parallel::ForkManager::Web->new(2);"
NSQ_SOURCE_LINE 00000940 ""
NSQ_SOURCE_LINE 00000941 "    $fm->run_on_finish(sub{"
NSQ_SOURCE_LINE 00000942 "        my $retrieved = $_[5];"
NSQ_SOURCE_LINE 00000943 ""
NSQ_SOURCE_LINE 00000944 "        print \"got \", $retrieved, \"\\n\";"
NSQ_SOURCE_LINE 00000945 "    });"
NSQ_SOURCE_LINE 00000946 ""
NSQ_SOURCE_LINE 00000947 "    $fm->start_child(sub {"
NSQ_SOURCE_LINE 00000948 "        return $_**2;"
NSQ_SOURCE_LINE 00000949 "    }) for 1..3;"
NSQ_SOURCE_LINE 00000950 ""
NSQ_SOURCE_LINE 00000951 "    $fm->wait_all_children;"
NSQ_SOURCE_LINE 00000952 ""
NSQ_SOURCE_LINE 00000953 "=head2 Example: have the child processes exit differently"
NSQ_SOURCE_LINE 00000954 ""
NSQ_SOURCE_LINE 00000955 "    use Parallel::ForkManager;"
NSQ_SOURCE_LINE 00000956 ""
NSQ_SOURCE_LINE 00000957 "    package Parallel::ForkManager::Child::PosixExit {"
NSQ_SOURCE_LINE 00000958 "        use Moo::Role;"
NSQ_SOURCE_LINE 00000959 "        with 'Parallel::ForkManager::Child';"
NSQ_SOURCE_LINE 00000960 ""
NSQ_SOURCE_LINE 00000961 "        sub finish  { POSIX::_exit() };"
NSQ_SOURCE_LINE 00000962 "    }"
NSQ_SOURCE_LINE 00000963 ""
NSQ_SOURCE_LINE 00000964 "    my $fm = Parallel::ForkManager->new("
NSQ_SOURCE_LINE 00000965 "        max_proc   => 1,"
NSQ_SOURCE_LINE 00000966 "        child_role => 'Parallel::ForkManager::Child::PosixExit'"
NSQ_SOURCE_LINE 00000967 "    );"
NSQ_SOURCE_LINE 00000968 ""
NSQ_SOURCE_LINE 00000969 "=head1 SECURITY"
NSQ_SOURCE_LINE 00000970 ""
NSQ_SOURCE_LINE 00000971 "Parallel::ForkManager uses temporary files when"
NSQ_SOURCE_LINE 00000972 "a child process returns information to its parent process. The filenames are"
NSQ_SOURCE_LINE 00000973 "based on the process of the parent and child processes, so they are"
NSQ_SOURCE_LINE 00000974 "fairly easy to guess. So if security is a concern in your environment, make sure"
NSQ_SOURCE_LINE 00000975 "the directory used by Parallel::ForkManager is restricted to the current user"
NSQ_SOURCE_LINE 00000976 "only (the default behavior is to create a directory,"
NSQ_SOURCE_LINE 00000977 "via L<File::Temp>'s C<tempdir>, which does that)."
NSQ_SOURCE_LINE 00000978 ""
NSQ_SOURCE_LINE 00000979 "=head1 TROUBLESHOOTING"
NSQ_SOURCE_LINE 00000980 ""
NSQ_SOURCE_LINE 00000981 "=head2 PerlIO::gzip and Parallel::ForkManager do not play nice together"
NSQ_SOURCE_LINE 00000982 ""
NSQ_SOURCE_LINE 00000983 "If you are using L<PerlIO::gzip> in your child processes, you may end up with"
NSQ_SOURCE_LINE 00000984 "garbled files. This is not really P::FM's fault, but rather a problem between"
NSQ_SOURCE_LINE 00000985 "L<PerlIO::gzip> and C<fork()> (see L<https://rt.cpan.org/Public/Bug/Display.html?id=114557>)."
NSQ_SOURCE_LINE 00000986 ""
NSQ_SOURCE_LINE 00000987 "Fortunately, it seems there is an easy way to fix the problem by"
NSQ_SOURCE_LINE 00000988 "adding the \"unix\" layer? I.e.,"
NSQ_SOURCE_LINE 00000989 ""
NSQ_SOURCE_LINE 00000990 "    open(IN, '<:unix:gzip', ..."
NSQ_SOURCE_LINE 00000991 ""
NSQ_SOURCE_LINE 00000992 "=head1 BUGS AND LIMITATIONS"
NSQ_SOURCE_LINE 00000993 ""
NSQ_SOURCE_LINE 00000994 "Do not use Parallel::ForkManager in an environment where other child"
NSQ_SOURCE_LINE 00000995 "processes can affect the run of the main program; using this module"
NSQ_SOURCE_LINE 00000996 "is not recommended in an environment where fork() / wait() is already used."
NSQ_SOURCE_LINE 00000997 ""
NSQ_SOURCE_LINE 00000998 "If you want to use more than one copies of the Parallel::ForkManager, then"
NSQ_SOURCE_LINE 00000999 "you have to make sure that all children processes are terminated, before you"
NSQ_SOURCE_LINE 00001000 "use the second object in the main program."
NSQ_SOURCE_LINE 00001001 ""
NSQ_SOURCE_LINE 00001002 "You are free to use a new copy of Parallel::ForkManager in the child"
NSQ_SOURCE_LINE 00001003 "processes, although I don't think it makes sense."
NSQ_SOURCE_LINE 00001004 ""
