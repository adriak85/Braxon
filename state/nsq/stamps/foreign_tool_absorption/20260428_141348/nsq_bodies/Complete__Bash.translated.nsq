NSQ_SOURCE_LINE 00000001 "package Complete::Bash;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.010001;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 "use Log::ger;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use Exporter 'import';"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000011 "our $DATE = '2022-09-08'; # DATE"
NSQ_SOURCE_LINE 00000012 "our $DIST = 'Complete-Bash'; # DIST"
NSQ_SOURCE_LINE 00000013 "our $VERSION = '0.337'; # VERSION"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000016 "                       point"
NSQ_SOURCE_LINE 00000017 "                       parse_cmdline"
NSQ_SOURCE_LINE 00000018 "                       join_wordbreak_words"
NSQ_SOURCE_LINE 00000019 "                       format_completion"
NSQ_SOURCE_LINE 00000020 "               );"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "our %SPEC;"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "$SPEC{':package'} = {"
NSQ_SOURCE_LINE 00000025 "    v => 1.1,"
NSQ_SOURCE_LINE 00000026 "    summary => 'Completion routines for bash shell',"
NSQ_SOURCE_LINE 00000027 "};"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "sub _expand_tilde {"
NSQ_SOURCE_LINE 00000030 "    my ($user, $slash) = @_;"
NSQ_SOURCE_LINE 00000031 "    my @ent;"
NSQ_SOURCE_LINE 00000032 "    if (length $user) {"
NSQ_SOURCE_LINE 00000033 "        @ent = getpwnam($user);"
NSQ_SOURCE_LINE 00000034 "    } else {"
NSQ_SOURCE_LINE 00000035 "        @ent = getpwuid($>);"
NSQ_SOURCE_LINE 00000036 "        $user = $ent[0];"
NSQ_SOURCE_LINE 00000037 "    }"
NSQ_SOURCE_LINE 00000038 "    return $ent[7] . $slash if @ent;"
NSQ_SOURCE_LINE 00000039 "    \"~$user$slash\"; # return as-is when failed"
NSQ_SOURCE_LINE 00000040 "}"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "sub _add_unquoted {"
NSQ_SOURCE_LINE 00000043 "    no warnings 'uninitialized';"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "    my ($word, $is_cur_word, $after_ws) = @_;"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "    #say \"D:add_unquoted word=$word is_cur_word=$is_cur_word after_ws=$after_ws\";"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "    $word =~ s!^(~)(\\w*)(/|\\z) |  # 1) tilde  2) username  3) optional slash"
NSQ_SOURCE_LINE 00000050 "               \\\\(.)           |  # 4) escaped char"
NSQ_SOURCE_LINE 00000051 "               \\$(\\w+)            # 5) variable name"
NSQ_SOURCE_LINE 00000052 "              !"
NSQ_SOURCE_LINE 00000053 "                  $1 ? (not($after_ws) || $is_cur_word ? \"$1$2$3\" : _expand_tilde($2, $3)) :"
NSQ_SOURCE_LINE 00000054 "                      $4 ? $4 :"
NSQ_SOURCE_LINE 00000055 "                          ($is_cur_word ? \"\\$$5\" : $ENV{$5})"
NSQ_SOURCE_LINE 00000056 "                              !egx;"
NSQ_SOURCE_LINE 00000057 "    $word;"
NSQ_SOURCE_LINE 00000058 "}"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "sub _add_double_quoted {"
NSQ_SOURCE_LINE 00000061 "    no warnings 'uninitialized';"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "    my ($word, $is_cur_word) = @_;"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "    $word =~ s!\\\\(.)           |  # 1) escaped char"
NSQ_SOURCE_LINE 00000066 "               \\$(\\w+)            # 2) variable name"
NSQ_SOURCE_LINE 00000067 "              !"
NSQ_SOURCE_LINE 00000068 "                  $1 ? $1 :"
NSQ_SOURCE_LINE 00000069 "                      ($is_cur_word ? \"\\$$2\" : $ENV{$2})"
NSQ_SOURCE_LINE 00000070 "                          !egx;"
NSQ_SOURCE_LINE 00000071 "    $word;"
NSQ_SOURCE_LINE 00000072 "}"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "sub _add_single_quoted {"
NSQ_SOURCE_LINE 00000075 "    my $word = shift;"
NSQ_SOURCE_LINE 00000076 "    $word =~ s/\\\\(.)/$1/g;"
NSQ_SOURCE_LINE 00000077 "    $word;"
NSQ_SOURCE_LINE 00000078 "}"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "$SPEC{point} = {"
NSQ_SOURCE_LINE 00000081 "    v => 1.1,"
NSQ_SOURCE_LINE 00000082 "    summary => 'Return line with point marked by a marker',"
NSQ_SOURCE_LINE 00000083 "    description => <<'_',"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "This is a utility function useful for testing/debugging. `parse_cmdline()`"
NSQ_SOURCE_LINE 00000086 "expects a command-line and a cursor position (`$line`, `$point`). This routine"
NSQ_SOURCE_LINE 00000087 "expects `$line` with a marker character (by default it's the caret, `^`) and"
NSQ_SOURCE_LINE 00000088 "return (`$line`, `$point`) to feed to `parse_cmdline()`."
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "Example:"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "    point(\"^foo\") # => (\"foo\", 0)"
NSQ_SOURCE_LINE 00000093 "    point(\"fo^o\") # => (\"foo\", 2)"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "_"
NSQ_SOURCE_LINE 00000096 "    args_as => 'array',"
NSQ_SOURCE_LINE 00000097 "    args => {"
NSQ_SOURCE_LINE 00000098 "        cmdline => {"
NSQ_SOURCE_LINE 00000099 "            summary => 'Command-line which contains a marker character',"
NSQ_SOURCE_LINE 00000100 "            schema => 'str*',"
NSQ_SOURCE_LINE 00000101 "            pos => 0,"
NSQ_SOURCE_LINE 00000102 "        },"
NSQ_SOURCE_LINE 00000103 "        marker => {"
NSQ_SOURCE_LINE 00000104 "            summary => 'Marker character',"
NSQ_SOURCE_LINE 00000105 "            schema => ['str*', len=>1],"
NSQ_SOURCE_LINE 00000106 "            default => '^',"
NSQ_SOURCE_LINE 00000107 "            pos => 1,"
NSQ_SOURCE_LINE 00000108 "        },"
NSQ_SOURCE_LINE 00000109 "    },"
NSQ_SOURCE_LINE 00000110 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000111 "};"
NSQ_SOURCE_LINE 00000112 "sub point {"
NSQ_SOURCE_LINE 00000113 "    my ($line, $marker) = @_;"
NSQ_SOURCE_LINE 00000114 "    $marker //= '^';"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "    my $point = index($line, $marker);"
NSQ_SOURCE_LINE 00000117 "    die \"BUG: No marker '$marker' in line <$line>\" unless $point >= 0;"
NSQ_SOURCE_LINE 00000118 "    $line =~ s/\\Q$marker\\E//;"
NSQ_SOURCE_LINE 00000119 "    ($line, $point);"
NSQ_SOURCE_LINE 00000120 "}"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "$SPEC{parse_cmdline} = {"
NSQ_SOURCE_LINE 00000123 "    v => 1.1,"
NSQ_SOURCE_LINE 00000124 "    summary => 'Parse shell command-line for processing by completion routines',"
NSQ_SOURCE_LINE 00000125 "    description => <<'_',"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "This function basically converts `COMP_LINE` (str) and `COMP_POINT` (int) into"
NSQ_SOURCE_LINE 00000128 "something like (but not exactly the same as) `COMP_WORDS` (array) and"
NSQ_SOURCE_LINE 00000129 "`COMP_CWORD` (int) that bash supplies to shell functions."
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "The differences with bash are (these differences are mostly for parsing"
NSQ_SOURCE_LINE 00000132 "convenience for programs that use this routine; this comparison is made against"
NSQ_SOURCE_LINE 00000133 "bash versions 4.2-4.3):"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "1) quotes and backslashes are stripped (bash's `COMP_WORDS` contains all the"
NSQ_SOURCE_LINE 00000136 "   quotes and backslashes);"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "2) quoted phrase that contains spaces, or phrase that contains escaped spaces is"
NSQ_SOURCE_LINE 00000139 "   parsed as a single word. For example:"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "    command \"First argument\" Second\\ argument"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "   bash would split it as (represented as Perl):"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "    [\"command\", \"\\\"First\", \"argument\\\"\", \"Second\\\\\", \"argument\"]"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "   which is not very convenient. We parse it into:"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "    [\"command\", \"First argument\", \"Second argument\"]"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "3) variables are substituted with their values from environment variables except"
NSQ_SOURCE_LINE 00000152 "   for the current word (`COMP_WORDS[COMP_CWORD]`) (bash does not perform"
NSQ_SOURCE_LINE 00000153 "   variable substitution for `COMP_WORDS`). However, note that special shell"
NSQ_SOURCE_LINE 00000154 "   variables that are not environment variables like `$0`, `$_`, `$IFS` will not"
NSQ_SOURCE_LINE 00000155 "   be replaced correctly because bash does not export those variables for us."
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "4) tildes (`~`) are expanded with user's home directory except for the current"
NSQ_SOURCE_LINE 00000158 "   word (bash does not perform tilde expansion for `COMP_WORDS`);"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "Caveats:"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "* Like bash, we group non-whitespace word-breaking characters into its own word."
NSQ_SOURCE_LINE 00000163 "  By default `COMP_WORDBREAKS` is:"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "    \"'@><=;|&(:"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "  So if raw command-line is:"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "    command --foo=bar http://example.com:80 mail@example.org Foo::Bar"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "  then the parse result will be:"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "    [\"command\", \"--foo\", \"=\", \"bar\", \"http\", \":\", \"//example.com\", \":\", \"80\", \"Foo\", \"::\", \"Bar\"]"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "  which is annoying sometimes. But we follow bash here so we can more easily"
NSQ_SOURCE_LINE 00000176 "  accept input from a joined `COMP_WORDS` if we write completion bash functions,"
NSQ_SOURCE_LINE 00000177 "  e.g. (in the example, `foo` is a Perl script):"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "    _foo ()"
NSQ_SOURCE_LINE 00000180 "    {"
NSQ_SOURCE_LINE 00000181 "        local words=(${COMP_CWORDS[@]})"
NSQ_SOURCE_LINE 00000182 "        # add things to words, etc"
NSQ_SOURCE_LINE 00000183 "        local point=... # calculate the new point"
NSQ_SOURCE_LINE 00000184 "        COMPREPLY=( `COMP_LINE=\"foo ${words[@]}\" COMP_POINT=$point foo` )"
NSQ_SOURCE_LINE 00000185 "    }"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "  To avoid these word-breaking characters to be split/grouped, we can escape"
NSQ_SOURCE_LINE 00000188 "  them with backslash or quote them, e.g.:"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "    command \"http://example.com:80\" Foo\\:\\:Bar"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "  which bash will parse as:"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "    [\"command\", \"\\\"http://example.com:80\\\"\", \"Foo\\\\:\\\\:Bar\"]"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "  and we parse as:"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "    [\"command\", \"http://example.com:80\", \"Foo::Bar\"]"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "* Due to the way bash parses the command line (see above), the two below are"
NSQ_SOURCE_LINE 00000201 "  equivalent:"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "    % cmd --foo=bar"
NSQ_SOURCE_LINE 00000204 "    % cmd --foo = bar"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "Because they both expand to `['--foo', '=', 'bar']`. But obviously"
NSQ_SOURCE_LINE 00000207 "<pm:Getopt::Long> does not regard the two as equivalent."
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "_"
NSQ_SOURCE_LINE 00000210 "    args_as => 'array',"
NSQ_SOURCE_LINE 00000211 "    args => {"
NSQ_SOURCE_LINE 00000212 "        cmdline => {"
NSQ_SOURCE_LINE 00000213 "            summary => 'Command-line, defaults to COMP_LINE environment',"
NSQ_SOURCE_LINE 00000214 "            schema => 'str*',"
NSQ_SOURCE_LINE 00000215 "            pos => 0,"
NSQ_SOURCE_LINE 00000216 "        },"
NSQ_SOURCE_LINE 00000217 "        point => {"
NSQ_SOURCE_LINE 00000218 "            summary => 'Point/position to complete in command-line, '."
NSQ_SOURCE_LINE 00000219 "                'defaults to COMP_POINT',"
NSQ_SOURCE_LINE 00000220 "            schema => 'int*',"
NSQ_SOURCE_LINE 00000221 "            pos => 1,"
NSQ_SOURCE_LINE 00000222 "        },"
NSQ_SOURCE_LINE 00000223 "        opts => {"
NSQ_SOURCE_LINE 00000224 "            summary => 'Options',"
NSQ_SOURCE_LINE 00000225 "            schema => 'hash*',"
NSQ_SOURCE_LINE 00000226 "            description => <<'_',"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "Optional. Known options:"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "* `truncate_current_word` (bool). If set to 1, will truncate current word to the"
NSQ_SOURCE_LINE 00000231 "  position of cursor, for example (`^` marks the position of cursor):"
NSQ_SOURCE_LINE 00000232 "  `--vers^oo` to `--vers` instead of `--versoo`. This is more convenient when"
NSQ_SOURCE_LINE 00000233 "  doing tab completion."
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "_"
NSQ_SOURCE_LINE 00000236 "            schema => 'hash*',"
NSQ_SOURCE_LINE 00000237 "            pos => 2,"
NSQ_SOURCE_LINE 00000238 "        },"
NSQ_SOURCE_LINE 00000239 "    },"
NSQ_SOURCE_LINE 00000240 "    result => {"
NSQ_SOURCE_LINE 00000241 "        schema => ['array*', len=>2],"
NSQ_SOURCE_LINE 00000242 "        description => <<'_',"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "Return a 2-element array: `[$words, $cword]`. `$words` is array of str,"
NSQ_SOURCE_LINE 00000245 "equivalent to `COMP_WORDS` provided by bash to shell functions. `$cword` is an"
NSQ_SOURCE_LINE 00000246 "integer, roughly equivalent to `COMP_CWORD` provided by bash to shell functions."
NSQ_SOURCE_LINE 00000247 "The word to be completed is at `$words->[$cword]`."
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "Note that COMP_LINE includes the command name. If you want the command-line"
NSQ_SOURCE_LINE 00000250 "arguments only (like in `@ARGV`), you need to strip the first element from"
NSQ_SOURCE_LINE 00000251 "`$words` and reduce `$cword` by 1."
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "_"
NSQ_SOURCE_LINE 00000255 "    },"
NSQ_SOURCE_LINE 00000256 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000257 "    links => ["
NSQ_SOURCE_LINE 00000258 "    ],"
NSQ_SOURCE_LINE 00000259 "};"
NSQ_SOURCE_LINE 00000260 "sub parse_cmdline {"
NSQ_SOURCE_LINE 00000261 "    no warnings 'uninitialized';"
NSQ_SOURCE_LINE 00000262 "    my ($line, $point, $opts) = @_;"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "    $line  //= $ENV{COMP_LINE};"
NSQ_SOURCE_LINE 00000265 "    $point //= $ENV{COMP_POINT} // 0;"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "    die \"$0: COMP_LINE not set, make sure this script is run under \"."
NSQ_SOURCE_LINE 00000268 "        \"bash completion (e.g. through complete -C)\\n\" unless defined $line;"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "    log_trace \"[compbash] parse_cmdline(): input: line=<$line> point=<$point>\""
NSQ_SOURCE_LINE 00000271 "        if $ENV{COMPLETE_BASH_TRACE};"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "    my @words;"
NSQ_SOURCE_LINE 00000274 "    my $cword;"
NSQ_SOURCE_LINE 00000275 "    my $pos = 0;"
NSQ_SOURCE_LINE 00000276 "    my $pos_min_ws = 0;"
NSQ_SOURCE_LINE 00000277 "    my $after_ws = 1; # XXX what does this variable mean?"
NSQ_SOURCE_LINE 00000278 "    my $chunk;"
NSQ_SOURCE_LINE 00000279 "    my $add_blank;"
NSQ_SOURCE_LINE 00000280 "    my $is_cur_word;"
NSQ_SOURCE_LINE 00000281 "    $line =~ s!(                                                         # 1) everything"
NSQ_SOURCE_LINE 00000282 "                  (\")((?: \\\\\\\\|\\\\\"|[^\"])*)(?:\"|\\z)(\\s*)               |  #  2) open \"  3) content  4) space after"
NSQ_SOURCE_LINE 00000283 "                  (')((?: \\\\\\\\|\\\\'|[^'])*)(?:'|\\z)(\\s*)               |  #  5) open '  6) content  7) space after"
NSQ_SOURCE_LINE 00000284 "                  ((?: \\\\\\\\|\\\\\"|\\\\'|\\\\=|\\\\\\s|[^\"'@><=|&\\(:\\s])+)(\\s*) |  #  8) unquoted word  9) space after"
NSQ_SOURCE_LINE 00000285 "                  ([\\@><=|&\\(:]+) |                                      #  10) non-whitespace word-breaking characters"
NSQ_SOURCE_LINE 00000286 "                  \\s+"
NSQ_SOURCE_LINE 00000287 "              )!"
NSQ_SOURCE_LINE 00000288 "                  $pos += length($1);"
NSQ_SOURCE_LINE 00000289 "                  #say \"D: \\$1=<$1> \\$2=<$3> \\$3=<$3> \\$4=<$4> \\$5=<$5> \\$6=<$6> \\$7=<$7> \\$8=<$8> \\$9=<$9> \\$10=<$10>\";"
NSQ_SOURCE_LINE 00000290 "                  #say \"D:<$1> pos=$pos, point=$point, cword=$cword, after_ws=$after_ws\";"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "                  if ($2 || $5 || defined($8)) {"
NSQ_SOURCE_LINE 00000293 "                      # double-quoted/single-quoted/unquoted chunk"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "                      if (not(defined $cword)) {"
NSQ_SOURCE_LINE 00000296 "                          $pos_min_ws = $pos - length($2 ? $4 : $5 ? $7 : $9);"
NSQ_SOURCE_LINE 00000297 "                          #say \"D:pos_min_ws=$pos_min_ws\";"
NSQ_SOURCE_LINE 00000298 "                          if ($point <= $pos_min_ws) {"
NSQ_SOURCE_LINE 00000299 "                              $cword = @words - ($after_ws ? 0 : 1);"
NSQ_SOURCE_LINE 00000300 "                          } elsif ($point < $pos) {"
NSQ_SOURCE_LINE 00000301 "                              $cword = @words + 1 - ($after_ws ? 0 : 1);"
NSQ_SOURCE_LINE 00000302 "                              $add_blank = 1;"
NSQ_SOURCE_LINE 00000303 "                          }"
NSQ_SOURCE_LINE 00000304 "                      }"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "                      if ($after_ws) {"
NSQ_SOURCE_LINE 00000307 "                          $is_cur_word = defined($cword) && $cword==@words;"
NSQ_SOURCE_LINE 00000308 "                      } else {"
NSQ_SOURCE_LINE 00000309 "                          $is_cur_word = defined($cword) && $cword==@words-1;"
NSQ_SOURCE_LINE 00000310 "                      }"
NSQ_SOURCE_LINE 00000311 "                      #say \"D:is_cur_word=$is_cur_word\";"
NSQ_SOURCE_LINE 00000312 "                      $chunk ="
NSQ_SOURCE_LINE 00000313 "                          $2 ? _add_double_quoted($3, $is_cur_word) :"
NSQ_SOURCE_LINE 00000314 "                              $5 ? _add_single_quoted($6) :"
NSQ_SOURCE_LINE 00000315 "                              _add_unquoted($8, $is_cur_word, $after_ws);"
NSQ_SOURCE_LINE 00000316 "                      if ($opts && $opts->{truncate_current_word} &&"
NSQ_SOURCE_LINE 00000317 "                              $is_cur_word && $pos > $point) {"
NSQ_SOURCE_LINE 00000318 "                          $chunk = substr("
NSQ_SOURCE_LINE 00000319 "                              $chunk, 0, length($chunk)-($pos_min_ws-$point));"
NSQ_SOURCE_LINE 00000320 "                          #say \"D:truncating current word to <$chunk>\";"
NSQ_SOURCE_LINE 00000321 "                      }"
NSQ_SOURCE_LINE 00000322 "                      if ($after_ws) {"
NSQ_SOURCE_LINE 00000323 "                          push @words, $chunk;"
NSQ_SOURCE_LINE 00000324 "                      } else {"
NSQ_SOURCE_LINE 00000325 "                          $words[-1] .= $chunk;"
NSQ_SOURCE_LINE 00000326 "                      }"
NSQ_SOURCE_LINE 00000327 "                      if ($add_blank) {"
NSQ_SOURCE_LINE 00000328 "                          push @words, '';"
NSQ_SOURCE_LINE 00000329 "                          $add_blank = 0;"
NSQ_SOURCE_LINE 00000330 "                      }"
NSQ_SOURCE_LINE 00000331 "                      $after_ws = ($2 ? $4 : $5 ? $7 : $9) ? 1:0;"
NSQ_SOURCE_LINE 00000332 ""
NSQ_SOURCE_LINE 00000333 "                  } elsif ($10) {"
NSQ_SOURCE_LINE 00000334 "                      # non-whitespace word-breaking characters"
NSQ_SOURCE_LINE 00000335 "                      push @words, $10;"
NSQ_SOURCE_LINE 00000336 "                      $after_ws = 1;"
NSQ_SOURCE_LINE 00000337 "                  } else {"
NSQ_SOURCE_LINE 00000338 "                      # whitespace"
NSQ_SOURCE_LINE 00000339 "                      $after_ws = 1;"
NSQ_SOURCE_LINE 00000340 "                  }"
NSQ_SOURCE_LINE 00000341 "    !egx;"
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "    $cword //= @words;"
NSQ_SOURCE_LINE 00000344 "    $words[$cword] //= '';"
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "    log_trace \"[compbash] parse_cmdline(): result: words=%s, cword=%s\", \\@words, $cword"
NSQ_SOURCE_LINE 00000347 "        if $ENV{COMPLETE_BASH_TRACE};"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "    [\\@words, $cword];"
NSQ_SOURCE_LINE 00000350 "}"
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "$SPEC{join_wordbreak_words} = {"
NSQ_SOURCE_LINE 00000353 "    v => 1.1,"
NSQ_SOURCE_LINE 00000354 "    summary => 'Post-process parse_cmdline() result by joining some words',"
NSQ_SOURCE_LINE 00000355 "    description => <<'_',"
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "`parse_cmdline()`, like bash, splits some characters that are considered as"
NSQ_SOURCE_LINE 00000358 "word-breaking characters:"
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 "    \"'@><=;|&(:"
NSQ_SOURCE_LINE 00000361 ""
NSQ_SOURCE_LINE 00000362 "So if command-line is:"
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "    command --module=Data::Dump bob@example.org"
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "then they will be parsed as:"
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 "    [\"command\", \"--module\", \"=\", \"Data\", \"::\", \"Dump\", \"bob\", '@', \"example.org\"]"
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "Normally in Perl applications, we want `:`, `@` to be part of word. So this"
NSQ_SOURCE_LINE 00000371 "routine will convert the above into:"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "    [\"command\", \"--module=Data::Dump\", 'bob@example.org']"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "_"
NSQ_SOURCE_LINE 00000376 "};"
NSQ_SOURCE_LINE 00000377 "sub join_wordbreak_words {"
NSQ_SOURCE_LINE 00000378 "    my ($words, $cword) = @_;"
NSQ_SOURCE_LINE 00000379 "    my $new_words = [];"
NSQ_SOURCE_LINE 00000380 "    my $i = -1;"
NSQ_SOURCE_LINE 00000381 "    while (++$i < @$words) {"
NSQ_SOURCE_LINE 00000382 "        my $w = $words->[$i];"
NSQ_SOURCE_LINE 00000383 "        if ($w =~ /\\A[\\@=:]+\\z/) {"
NSQ_SOURCE_LINE 00000384 "            if (@$new_words and $#$new_words != $cword) {"
NSQ_SOURCE_LINE 00000385 "                $new_words->[-1] .= $w;"
NSQ_SOURCE_LINE 00000386 "                $cword-- if $cword >= $i || $cword >= @$new_words;"
NSQ_SOURCE_LINE 00000387 "            } else {"
NSQ_SOURCE_LINE 00000388 "                push @$new_words, $w;"
NSQ_SOURCE_LINE 00000389 "            }"
NSQ_SOURCE_LINE 00000390 "            if ($i+1 < @$words) {"
NSQ_SOURCE_LINE 00000391 "                $i++;"
NSQ_SOURCE_LINE 00000392 "                $new_words->[-1] .= $words->[$i];"
NSQ_SOURCE_LINE 00000393 "                $cword-- if $cword >= $i || $cword >= @$new_words;"
NSQ_SOURCE_LINE 00000394 "            }"
NSQ_SOURCE_LINE 00000395 "        } else {"
NSQ_SOURCE_LINE 00000396 "            push @$new_words, $w;"
NSQ_SOURCE_LINE 00000397 "        }"
NSQ_SOURCE_LINE 00000398 "    }"
NSQ_SOURCE_LINE 00000399 "    log_trace \"[compbash] join_wordbreak_words(): result: words=%s, cword=%d\", $new_words, $cword"
NSQ_SOURCE_LINE 00000400 "        if $ENV{COMPLETE_BASH_TRACE};"
NSQ_SOURCE_LINE 00000401 "    [$new_words, $cword];"
NSQ_SOURCE_LINE 00000402 "}"
NSQ_SOURCE_LINE 00000403 ""
NSQ_SOURCE_LINE 00000404 "sub _terminal_width {"
NSQ_SOURCE_LINE 00000405 "    # XXX need to cache?"
NSQ_SOURCE_LINE 00000406 "    if (eval { require Term::Size; 1 }) {"
NSQ_SOURCE_LINE 00000407 "        my ($cols, undef) = Term::Size::chars(*STDOUT{IO});"
NSQ_SOURCE_LINE 00000408 "        $cols // 80;"
NSQ_SOURCE_LINE 00000409 "    } else {"
NSQ_SOURCE_LINE 00000410 "        $ENV{COLUMNS} // 80;"
NSQ_SOURCE_LINE 00000411 "    }"
NSQ_SOURCE_LINE 00000412 "}"
NSQ_SOURCE_LINE 00000413 ""
NSQ_SOURCE_LINE 00000414 "sub _terminal_height {"
NSQ_SOURCE_LINE 00000415 "    # XXX need to cache?"
NSQ_SOURCE_LINE 00000416 "    if (eval { require Term::Size; 1 }) {"
NSQ_SOURCE_LINE 00000417 "        my (undef, $lines) = Term::Size::chars(*STDOUT{IO});"
NSQ_SOURCE_LINE 00000418 "        $lines // 25;"
NSQ_SOURCE_LINE 00000419 "    } else {"
NSQ_SOURCE_LINE 00000420 "        $ENV{LINES} // 25;"
NSQ_SOURCE_LINE 00000421 "    }"
NSQ_SOURCE_LINE 00000422 "}"
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "# given terminal width & number of columns, calculate column width"
NSQ_SOURCE_LINE 00000425 "sub _column_width {"
NSQ_SOURCE_LINE 00000426 "    my ($terminal_width, $num_columns) = @_;"
NSQ_SOURCE_LINE 00000427 "    if (defined $num_columns && $num_columns > 0) {"
NSQ_SOURCE_LINE 00000428 "        int( ($terminal_width - ($num_columns-1)*2) / $num_columns ) - 1;"
NSQ_SOURCE_LINE 00000429 "    } else {"
NSQ_SOURCE_LINE 00000430 "        undef;"
NSQ_SOURCE_LINE 00000431 "    }"
NSQ_SOURCE_LINE 00000432 "}"
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 "# given terminal width & column width, calculate number of columns"
NSQ_SOURCE_LINE 00000435 "sub _num_columns {"
NSQ_SOURCE_LINE 00000436 "    my ($terminal_width, $column_width) = @_;"
NSQ_SOURCE_LINE 00000437 "    my $n = int( ($terminal_width+2) / ($column_width+2) );"
NSQ_SOURCE_LINE 00000438 "    $n >= 1 ? $n : 1;"
NSQ_SOURCE_LINE 00000439 "}"
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "$SPEC{format_completion} = {"
NSQ_SOURCE_LINE 00000442 "    v => 1.1,"
NSQ_SOURCE_LINE 00000443 "    summary => 'Format completion for output (for shell)',"
NSQ_SOURCE_LINE 00000444 "    description => <<'_',"
NSQ_SOURCE_LINE 00000445 ""
NSQ_SOURCE_LINE 00000446 "Bash accepts completion reply in the form of one entry per line to STDOUT. Some"
NSQ_SOURCE_LINE 00000447 "characters will need to be escaped. This function helps you do the formatting,"
NSQ_SOURCE_LINE 00000448 "with some options."
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "This function accepts completion answer structure as described in the `Complete`"
NSQ_SOURCE_LINE 00000451 "POD. Aside from `words`, this function also recognizes these keys:"
NSQ_SOURCE_LINE 00000452 ""
NSQ_SOURCE_LINE 00000453 "_"
NSQ_SOURCE_LINE 00000454 "    args_as => 'array',"
NSQ_SOURCE_LINE 00000455 "    args => {"
NSQ_SOURCE_LINE 00000456 "        completion => {"
NSQ_SOURCE_LINE 00000457 "            summary => 'Completion answer structure',"
NSQ_SOURCE_LINE 00000458 "            description => <<'_',"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "Either an array or hash. See function description for more details."
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 "_"
NSQ_SOURCE_LINE 00000463 "            schema=>['any*' => of => ['hash*', 'array*']],"
NSQ_SOURCE_LINE 00000464 "            req=>1,"
NSQ_SOURCE_LINE 00000465 "            pos=>0,"
NSQ_SOURCE_LINE 00000466 "        },"
NSQ_SOURCE_LINE 00000467 "        opts => {"
NSQ_SOURCE_LINE 00000468 "            summary => 'Specify options',"
NSQ_SOURCE_LINE 00000469 "            schema=>'hash*',"
NSQ_SOURCE_LINE 00000470 "            pos=>1,"
NSQ_SOURCE_LINE 00000471 "            description => <<'_',"
NSQ_SOURCE_LINE 00000472 ""
NSQ_SOURCE_LINE 00000473 "Known options:"
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 "* as"
NSQ_SOURCE_LINE 00000476 ""
NSQ_SOURCE_LINE 00000477 "  Either `string` (the default) or `array` (to return array of lines instead of"
NSQ_SOURCE_LINE 00000478 "  the lines joined together). Returning array is useful if you are doing"
NSQ_SOURCE_LINE 00000479 "  completion inside `Term::ReadLine`, for example, where the library expects an"
NSQ_SOURCE_LINE 00000480 "  array."
NSQ_SOURCE_LINE 00000481 ""
NSQ_SOURCE_LINE 00000482 "* esc_mode"
NSQ_SOURCE_LINE 00000483 ""
NSQ_SOURCE_LINE 00000484 "  Escaping mode for entries. Either `default` (most nonalphanumeric characters"
NSQ_SOURCE_LINE 00000485 "  will be escaped), `shellvar` (like `default`, but dollar sign `$` will also be"
NSQ_SOURCE_LINE 00000486 "  escaped, convenient when completing environment variables for example),"
NSQ_SOURCE_LINE 00000487 "  `filename` (currently equals to `default`), `option` (currently equals to"
NSQ_SOURCE_LINE 00000488 "  `default`), or `none` (no escaping will be done)."
NSQ_SOURCE_LINE 00000489 ""
NSQ_SOURCE_LINE 00000490 "* word"
NSQ_SOURCE_LINE 00000491 ""
NSQ_SOURCE_LINE 00000492 "  A workaround. String. For now, see source code for more details."
NSQ_SOURCE_LINE 00000493 ""
NSQ_SOURCE_LINE 00000494 "* show_summaries"
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "  Whether to show item's summaries. Boolean, default is from"
NSQ_SOURCE_LINE 00000497 "  COMPLETE_BASH_SHOW_SUMMARIES environment variable or 1."
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "  An answer item contain summary, which is a short description about the item,"
NSQ_SOURCE_LINE 00000500 "  e.g.:"
NSQ_SOURCE_LINE 00000501 ""
NSQ_SOURCE_LINE 00000502 "      [{word=>\"-a\"    , summary=>\"Show hidden files\"},"
NSQ_SOURCE_LINE 00000503 "       {word=>\"-l\"    , summary=>\"Show details\"},"
NSQ_SOURCE_LINE 00000504 "       {word=>\"--sort\", summary=>\"Specify sort order\"}],"
NSQ_SOURCE_LINE 00000505 ""
NSQ_SOURCE_LINE 00000506 "  When summaries are not shown, user will just be seeing something like:"
NSQ_SOURCE_LINE 00000507 ""
NSQ_SOURCE_LINE 00000508 "      -a"
NSQ_SOURCE_LINE 00000509 "      -l"
NSQ_SOURCE_LINE 00000510 "      --sort"
NSQ_SOURCE_LINE 00000511 ""
NSQ_SOURCE_LINE 00000512 "  But when summaries are shown, user will see:"
NSQ_SOURCE_LINE 00000513 ""
NSQ_SOURCE_LINE 00000514 "      -a         -- Show hidden files"
NSQ_SOURCE_LINE 00000515 "      -l         -- Show details"
NSQ_SOURCE_LINE 00000516 "      --sort     -- Specify sort order"
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "  which is quite helpful."
NSQ_SOURCE_LINE 00000519 ""
NSQ_SOURCE_LINE 00000520 "* workaround_with_wordbreaks"
NSQ_SOURCE_LINE 00000521 ""
NSQ_SOURCE_LINE 00000522 "  Boolean. Default is true. See source code for more details."
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 "_"
NSQ_SOURCE_LINE 00000525 ""
NSQ_SOURCE_LINE 00000526 "        },"
NSQ_SOURCE_LINE 00000527 "    },"
NSQ_SOURCE_LINE 00000528 "    result => {"
NSQ_SOURCE_LINE 00000529 "        summary => 'Formatted string (or array, if `as` is set to `array`)',"
NSQ_SOURCE_LINE 00000530 "        schema => ['any*' => of => ['str*', 'array*']],"
NSQ_SOURCE_LINE 00000531 "    },"
NSQ_SOURCE_LINE 00000532 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000533 "};"
NSQ_SOURCE_LINE 00000534 "sub format_completion {"
NSQ_SOURCE_LINE 00000535 "    my ($hcomp, $opts) = @_;"
NSQ_SOURCE_LINE 00000536 ""
NSQ_SOURCE_LINE 00000537 "    $opts //= {};"
NSQ_SOURCE_LINE 00000538 ""
NSQ_SOURCE_LINE 00000539 "    $hcomp = {words=>$hcomp} unless ref($hcomp) eq 'HASH';"
NSQ_SOURCE_LINE 00000540 "    my $words    = $hcomp->{words};"
NSQ_SOURCE_LINE 00000541 "    my $as       = $opts->{as} // 'string';"
NSQ_SOURCE_LINE 00000542 "    # 'escmode' key is deprecated (Complete 0.11-) and will be removed later"
NSQ_SOURCE_LINE 00000543 "    my $esc_mode = $opts->{esc_mode} // $ENV{COMPLETE_BASH_DEFAULT_ESC_MODE} //"
NSQ_SOURCE_LINE 00000544 "        'default';"
NSQ_SOURCE_LINE 00000545 "    my $path_sep = $hcomp->{path_sep};"
NSQ_SOURCE_LINE 00000546 ""
NSQ_SOURCE_LINE 00000547 "    # we keep the original words (before formatted with summaries) when we want"
NSQ_SOURCE_LINE 00000548 "    # to use fzf instead of passing to bash directly"
NSQ_SOURCE_LINE 00000549 "    my @words;"
NSQ_SOURCE_LINE 00000550 "    my @summaries;"
NSQ_SOURCE_LINE 00000551 "    my @res;"
NSQ_SOURCE_LINE 00000552 "    my $has_summary;"
NSQ_SOURCE_LINE 00000553 ""
NSQ_SOURCE_LINE 00000554 "    my $code_return_message = sub {"
NSQ_SOURCE_LINE 00000555 "        # display a message instead of list of words. we send \" \" (ASCII space)"
NSQ_SOURCE_LINE 00000556 "        # which bash does not display, so we can display a line of message while"
NSQ_SOURCE_LINE 00000557 "        # the user does not get the message as the completion. I've also tried"
NSQ_SOURCE_LINE 00000558 "        # \\000 to \\037 instead of space (\\040) but nothing works better."
NSQ_SOURCE_LINE 00000559 "        my $msg = shift;"
NSQ_SOURCE_LINE 00000560 "        if ($msg =~ /\\A /) {"
NSQ_SOURCE_LINE 00000561 "            $msg =~ s/\\A +//;"
NSQ_SOURCE_LINE 00000562 "            $msg = \" (empty message)\" unless length $msg;"
NSQ_SOURCE_LINE 00000563 "        }"
NSQ_SOURCE_LINE 00000564 "        return (sprintf(\"%-\"._terminal_width().\"s\", $msg), \" \");"
NSQ_SOURCE_LINE 00000565 "    };"
NSQ_SOURCE_LINE 00000566 ""
NSQ_SOURCE_LINE 00000567 "  FORMAT_MESSAGE:"
NSQ_SOURCE_LINE 00000568 "    # display a message instead of list of words. we send \" \" (ASCII space)"
NSQ_SOURCE_LINE 00000569 "    # which bash does not display, so we can display a line of message while the"
NSQ_SOURCE_LINE 00000570 "    # user does not get the message as the completion. I've also tried \\000 to"
NSQ_SOURCE_LINE 00000571 "    # \\037 instead of space (\\040) but nothing works better."
NSQ_SOURCE_LINE 00000572 "    if (defined $hcomp->{message}) {"
NSQ_SOURCE_LINE 00000573 "        @res = $code_return_message->($hcomp->{message});"
NSQ_SOURCE_LINE 00000574 "        goto RETURN_RES;"
NSQ_SOURCE_LINE 00000575 "    }"
NSQ_SOURCE_LINE 00000576 ""
NSQ_SOURCE_LINE 00000577 "  WORKAROUND_PREVENT_BASH_FROM_INSERTING_SPACE:"
NSQ_SOURCE_LINE 00000578 "    {"
NSQ_SOURCE_LINE 00000579 "        last unless @$words == 1;"
NSQ_SOURCE_LINE 00000580 "        if (defined $path_sep) {"
NSQ_SOURCE_LINE 00000581 "            my $re = qr/\\Q$path_sep\\E\\z/;"
NSQ_SOURCE_LINE 00000582 "            my $word;"
NSQ_SOURCE_LINE 00000583 "            if (ref $words->[0] eq 'HASH') {"
NSQ_SOURCE_LINE 00000584 "                $words = [$words->[0], {word=>\"$words->[0]{word} \"}] if"
NSQ_SOURCE_LINE 00000585 "                    $words->[0]{word} =~ $re;"
NSQ_SOURCE_LINE 00000586 "            } else {"
NSQ_SOURCE_LINE 00000587 "                $words = [$words->[0], \"$words->[0] \"]"
NSQ_SOURCE_LINE 00000588 "                    if $words->[0] =~ $re;"
NSQ_SOURCE_LINE 00000589 "            }"
NSQ_SOURCE_LINE 00000590 "            last;"
NSQ_SOURCE_LINE 00000591 "        }"
NSQ_SOURCE_LINE 00000592 ""
NSQ_SOURCE_LINE 00000593 "        if ($hcomp->{is_partial} ||"
NSQ_SOURCE_LINE 00000594 "                ref $words->[0] eq 'HASH' && $words->[0]{is_partial}) {"
NSQ_SOURCE_LINE 00000595 "            if (ref $words->[0] eq 'HASH') {"
NSQ_SOURCE_LINE 00000596 "                $words = [$words->[0], {word=>\"$words->[0]{word} \"}];"
NSQ_SOURCE_LINE 00000597 "            } else {"
NSQ_SOURCE_LINE 00000598 "                $words = [$words->[0], \"$words->[0] \"];"
NSQ_SOURCE_LINE 00000599 "            }"
NSQ_SOURCE_LINE 00000600 "            last;"
NSQ_SOURCE_LINE 00000601 "        }"
NSQ_SOURCE_LINE 00000602 "    }"
NSQ_SOURCE_LINE 00000603 ""
NSQ_SOURCE_LINE 00000604 "  WORKAROUND_WITH_WORDBREAKS:"
NSQ_SOURCE_LINE 00000605 "    # this is a workaround. since bash breaks words using characters in"
NSQ_SOURCE_LINE 00000606 "    # $COMP_WORDBREAKS, which by default is \"'@><=;|&(: this presents a problem"
NSQ_SOURCE_LINE 00000607 "    # we often encounter: if we want to provide with a list of strings"
NSQ_SOURCE_LINE 00000608 "    # containing say ':', most often Perl modules/packages, if user types e.g."
NSQ_SOURCE_LINE 00000609 "    # \"Text::AN\" and we provide completion [\"Text::ANSI\"] then bash will change"
NSQ_SOURCE_LINE 00000610 "    # the word at cursor to become \"Text::Text::ANSI\" since it sees the current"
NSQ_SOURCE_LINE 00000611 "    # word as \"AN\" and not \"Text::AN\". the workaround is to chop /^Text::/ from"
NSQ_SOURCE_LINE 00000612 "    # completion answers. btw, we actually chop /^text::/i to handle"
NSQ_SOURCE_LINE 00000613 "    # case-insensitive matching, although this does not have the ability to"
NSQ_SOURCE_LINE 00000614 "    # replace the current word (e.g. if we type 'text::an' then bash can only"
NSQ_SOURCE_LINE 00000615 "    # replace the current word 'an' with 'ANSI)."
NSQ_SOURCE_LINE 00000616 "    {"
NSQ_SOURCE_LINE 00000617 "        last unless $opts->{workaround_with_wordbreaks} // 1;"
NSQ_SOURCE_LINE 00000618 "        last unless defined $opts->{word};"
NSQ_SOURCE_LINE 00000619 ""
NSQ_SOURCE_LINE 00000620 "        if ($opts->{word} =~ s/(.+[\\@><=;|&\\(:])//) {"
NSQ_SOURCE_LINE 00000621 "            my $prefix = $1;"
NSQ_SOURCE_LINE 00000622 "            for (@$words) {"
NSQ_SOURCE_LINE 00000623 "                if (ref($_) eq 'HASH') {"
NSQ_SOURCE_LINE 00000624 "                    $_->{word} =~ s/\\A\\Q$prefix\\E//i;"
NSQ_SOURCE_LINE 00000625 "                } else {"
NSQ_SOURCE_LINE 00000626 "                    s/\\A\\Q$prefix\\E//i;"
NSQ_SOURCE_LINE 00000627 "                }"
NSQ_SOURCE_LINE 00000628 "            }"
NSQ_SOURCE_LINE 00000629 "        }"
NSQ_SOURCE_LINE 00000630 "    }"
NSQ_SOURCE_LINE 00000631 ""
NSQ_SOURCE_LINE 00000632 "  ESCAPE_WORDS:"
NSQ_SOURCE_LINE 00000633 "    for my $entry (@$words) {"
NSQ_SOURCE_LINE 00000634 "        my $word    = ref($entry) eq 'HASH' ? $entry->{word}    : $entry;"
NSQ_SOURCE_LINE 00000635 "        my $summary = (ref($entry) eq 'HASH' ? $entry->{summary} : undef) // '';"
NSQ_SOURCE_LINE 00000636 "        if ($esc_mode eq 'shellvar') {"
NSQ_SOURCE_LINE 00000637 "            # escape $ also"
NSQ_SOURCE_LINE 00000638 "            $word =~ s!([^A-Za-z0-9,+._/:~-])!\\\\$1!g;"
NSQ_SOURCE_LINE 00000639 "        } elsif ($esc_mode eq 'none') {"
NSQ_SOURCE_LINE 00000640 "            # no escaping"
NSQ_SOURCE_LINE 00000641 "        } else {"
NSQ_SOURCE_LINE 00000642 "            # default"
NSQ_SOURCE_LINE 00000643 "            $word =~ s!([^A-Za-z0-9,+._/:\\$~-])!\\\\$1!g;"
NSQ_SOURCE_LINE 00000644 "        }"
NSQ_SOURCE_LINE 00000645 "        push @words, $word;"
NSQ_SOURCE_LINE 00000646 "        push @summaries, $summary;"
NSQ_SOURCE_LINE 00000647 "        $has_summary = 1 if length $summary;"
NSQ_SOURCE_LINE 00000648 "    }"
NSQ_SOURCE_LINE 00000649 ""
NSQ_SOURCE_LINE 00000650 "    my $summary_align = $ENV{COMPLETE_BASH_SUMMARY_ALIGN} // 'left';"
NSQ_SOURCE_LINE 00000651 "    my $max_columns = $ENV{COMPLETE_BASH_MAX_COLUMNS} // 0;"
NSQ_SOURCE_LINE 00000652 "    my $terminal_width = _terminal_width();"
NSQ_SOURCE_LINE 00000653 "    my $column_width = _column_width($terminal_width, $max_columns);"
NSQ_SOURCE_LINE 00000654 ""
NSQ_SOURCE_LINE 00000655 "    #warn \"terminal_width=$terminal_width, column_width=\".($column_width // 'undef').\"\\n\";"
NSQ_SOURCE_LINE 00000656 ""
NSQ_SOURCE_LINE 00000657 "  FORMAT_SUMMARIES: {"
NSQ_SOURCE_LINE 00000658 "        @res = @words;"
NSQ_SOURCE_LINE 00000659 "        last if @words <= 1;"
NSQ_SOURCE_LINE 00000660 "        last unless $has_summary;"
NSQ_SOURCE_LINE 00000661 "        last unless $opts->{show_summaries} //"
NSQ_SOURCE_LINE 00000662 "            $ENV{COMPLETE_BASH_SHOW_SUMMARIES} // 1;"
NSQ_SOURCE_LINE 00000663 "        my $max_entry_width   = 8;"
NSQ_SOURCE_LINE 00000664 "        my $max_summ_width = 0;"
NSQ_SOURCE_LINE 00000665 "        for (0..$#words) {"
NSQ_SOURCE_LINE 00000666 "            $max_entry_width = length $words[$_]"
NSQ_SOURCE_LINE 00000667 "                if $max_entry_width < length $words[$_];"
NSQ_SOURCE_LINE 00000668 "            $max_summ_width = length $summaries[$_]"
NSQ_SOURCE_LINE 00000669 "                if $max_summ_width < length $summaries[$_];"
NSQ_SOURCE_LINE 00000670 "        }"
NSQ_SOURCE_LINE 00000671 "        #warn \"max_entry_width=$max_entry_width, max_summ_width=$max_summ_width\\n\";"
NSQ_SOURCE_LINE 00000672 "        if ($summary_align eq 'right') {"
NSQ_SOURCE_LINE 00000673 "            # if we are aligning summary to the right, we want to fill column"
NSQ_SOURCE_LINE 00000674 "            # width width"
NSQ_SOURCE_LINE 00000675 "            if ($max_columns <= 0) {"
NSQ_SOURCE_LINE 00000676 "                $max_columns = _num_columns("
NSQ_SOURCE_LINE 00000677 "                    $terminal_width, ($max_entry_width + 2 + $max_summ_width));"
NSQ_SOURCE_LINE 00000678 "            }"
NSQ_SOURCE_LINE 00000679 "            $column_width = _column_width($terminal_width, $max_columns);"
NSQ_SOURCE_LINE 00000680 "            my $new_max_summ_width = $column_width - 2 - $max_entry_width;"
NSQ_SOURCE_LINE 00000681 "            $max_summ_width = $new_max_summ_width"
NSQ_SOURCE_LINE 00000682 "                if $max_summ_width < $new_max_summ_width;"
NSQ_SOURCE_LINE 00000683 "            #warn \"max_columns=$max_columns, column_width=$column_width, max_summ_width=$max_summ_width\\n\";"
NSQ_SOURCE_LINE 00000684 "        }"
NSQ_SOURCE_LINE 00000685 ""
NSQ_SOURCE_LINE 00000686 "        for (0..$#words) {"
NSQ_SOURCE_LINE 00000687 "            my $summary = $summaries[$_];"
NSQ_SOURCE_LINE 00000688 "            if (length $summary) {"
NSQ_SOURCE_LINE 00000689 "                $res[$_] = sprintf("
NSQ_SOURCE_LINE 00000690 "                    \"%-${max_entry_width}s |%\"."
NSQ_SOURCE_LINE 00000691 "                        ($summary_align eq 'right' ? $max_summ_width : '').\"s\","
NSQ_SOURCE_LINE 00000692 "                    $words[$_], $summary);"
NSQ_SOURCE_LINE 00000693 "            }"
NSQ_SOURCE_LINE 00000694 "        }"
NSQ_SOURCE_LINE 00000695 "    } # FORMAT_SUMMARIES"
NSQ_SOURCE_LINE 00000696 ""
NSQ_SOURCE_LINE 00000697 "  MAX_COLUMNS: {"
NSQ_SOURCE_LINE 00000698 "        last unless $max_columns > 0;"
NSQ_SOURCE_LINE 00000699 "        my $max_entry_width = 0;"
NSQ_SOURCE_LINE 00000700 "        for (@res) {"
NSQ_SOURCE_LINE 00000701 "            $max_entry_width = length if $max_entry_width < length;"
NSQ_SOURCE_LINE 00000702 "        }"
NSQ_SOURCE_LINE 00000703 "        last if $max_entry_width >= $column_width;"
NSQ_SOURCE_LINE 00000704 "        for (@res) {"
NSQ_SOURCE_LINE 00000705 "            $_ .= \" \" x ($column_width - length) if $column_width > length;"
NSQ_SOURCE_LINE 00000706 "        }"
NSQ_SOURCE_LINE 00000707 "    }"
NSQ_SOURCE_LINE 00000708 ""
NSQ_SOURCE_LINE 00000709 "  PASS_TO_FZF: {"
NSQ_SOURCE_LINE 00000710 "        last if $ENV{INSIDE_EMACS};"
NSQ_SOURCE_LINE 00000711 "        last unless $ENV{COMPLETE_BASH_FZF};"
NSQ_SOURCE_LINE 00000712 "        my $items = $ENV{COMPLETE_BASH_FZF_ITEMS} // 100;"
NSQ_SOURCE_LINE 00000713 "        if ($items == -1) {"
NSQ_SOURCE_LINE 00000714 "            $items = _terminal_height();"
NSQ_SOURCE_LINE 00000715 "        }"
NSQ_SOURCE_LINE 00000716 "        last unless @words >= $items;"
NSQ_SOURCE_LINE 00000717 ""
NSQ_SOURCE_LINE 00000718 "        require File::Which;"
NSQ_SOURCE_LINE 00000719 "        unless (File::Which::which(\"fzf\")) {"
NSQ_SOURCE_LINE 00000720 "            #@res = $code_return_message->(\"Cannot find fzf to filter \"."
NSQ_SOURCE_LINE 00000721 "            #                                  scalar(@words).\" items\");"
NSQ_SOURCE_LINE 00000722 "            goto RETURN_RES;"
NSQ_SOURCE_LINE 00000723 "        }"
NSQ_SOURCE_LINE 00000724 ""
NSQ_SOURCE_LINE 00000725 "        require IPC::Open2;"
NSQ_SOURCE_LINE 00000726 "        local *CHLD_OUT;"
NSQ_SOURCE_LINE 00000727 "        local *CHLD_IN;"
NSQ_SOURCE_LINE 00000728 "        my $pid = IPC::Open2::open2("
NSQ_SOURCE_LINE 00000729 "            \\*CHLD_OUT, \\*CHLD_IN, \"fzf\", \"-m\", \"-d:\", \"--with-nth=2..\")"
NSQ_SOURCE_LINE 00000730 "            or do {"
NSQ_SOURCE_LINE 00000731 "                @res = $code_return_message->(\"Cannot open fzf to filter \"."
NSQ_SOURCE_LINE 00000732 "                                                  scalar(@words).\" items\");"
NSQ_SOURCE_LINE 00000733 "                goto RETURN_RES;"
NSQ_SOURCE_LINE 00000734 "            };"
NSQ_SOURCE_LINE 00000735 ""
NSQ_SOURCE_LINE 00000736 "        print CHLD_IN map { \"$_:$res[$_]\\n\" } 0..$#res;"
NSQ_SOURCE_LINE 00000737 "        close CHLD_IN;"
NSQ_SOURCE_LINE 00000738 ""
NSQ_SOURCE_LINE 00000739 "        my @res_words;"
NSQ_SOURCE_LINE 00000740 "        while (<CHLD_OUT>) {"
NSQ_SOURCE_LINE 00000741 "            my ($index) = /\\A([0-9]+)\\:/ or next;"
NSQ_SOURCE_LINE 00000742 "            push @res_words, $words[$index];"
NSQ_SOURCE_LINE 00000743 "        }"
NSQ_SOURCE_LINE 00000744 "        if (@res_words) {"
NSQ_SOURCE_LINE 00000745 "            @res = join(\" \", @res_words);"
NSQ_SOURCE_LINE 00000746 "        } else {"
NSQ_SOURCE_LINE 00000747 "            @res = ();"
NSQ_SOURCE_LINE 00000748 "        }"
NSQ_SOURCE_LINE 00000749 "        waitpid($pid, 0);"
NSQ_SOURCE_LINE 00000750 "    }"
NSQ_SOURCE_LINE 00000751 ""
NSQ_SOURCE_LINE 00000752 "  RETURN_RES:"
NSQ_SOURCE_LINE 00000753 "    #use Data::Dump; warn Data::Dump::dump(\\@res);"
NSQ_SOURCE_LINE 00000754 "    if ($as eq 'array') {"
NSQ_SOURCE_LINE 00000755 "        return \\@res;"
NSQ_SOURCE_LINE 00000756 "    } else {"
NSQ_SOURCE_LINE 00000757 "        return join(\"\", map {($_, \"\\n\")} @res);"
NSQ_SOURCE_LINE 00000758 "    }"
NSQ_SOURCE_LINE 00000759 "}"
NSQ_SOURCE_LINE 00000760 ""
NSQ_SOURCE_LINE 00000761 "1;"
NSQ_SOURCE_LINE 00000762 "# ABSTRACT: Completion routines for bash shell"
NSQ_SOURCE_LINE 00000763 ""
NSQ_SOURCE_LINE 00000764 "__END__"
NSQ_SOURCE_LINE 00000765 ""
NSQ_SOURCE_LINE 00000766 "=pod"
NSQ_SOURCE_LINE 00000767 ""
NSQ_SOURCE_LINE 00000768 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000769 ""
NSQ_SOURCE_LINE 00000770 "=head1 NAME"
NSQ_SOURCE_LINE 00000771 ""
NSQ_SOURCE_LINE 00000772 "Complete::Bash - Completion routines for bash shell"
NSQ_SOURCE_LINE 00000773 ""
NSQ_SOURCE_LINE 00000774 "=head1 VERSION"
NSQ_SOURCE_LINE 00000775 ""
NSQ_SOURCE_LINE 00000776 "This document describes version 0.337 of Complete::Bash (from Perl distribution Complete-Bash), released on 2022-09-08."
NSQ_SOURCE_LINE 00000777 ""
NSQ_SOURCE_LINE 00000778 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000779 ""
NSQ_SOURCE_LINE 00000780 "This module provides routines related to tab completion in bash shell."
NSQ_SOURCE_LINE 00000781 ""
NSQ_SOURCE_LINE 00000782 "=head2 About programmable completion in bash"
NSQ_SOURCE_LINE 00000783 ""
NSQ_SOURCE_LINE 00000784 "Bash allows completion to come from various sources. The simplest is from a list"
NSQ_SOURCE_LINE 00000785 "of words (C<-W>):"
NSQ_SOURCE_LINE 00000786 ""
NSQ_SOURCE_LINE 00000787 " % complete -W \"one two three four\" somecmd"
NSQ_SOURCE_LINE 00000788 " % somecmd t<Tab>"
NSQ_SOURCE_LINE 00000789 " two  three"
NSQ_SOURCE_LINE 00000790 ""
NSQ_SOURCE_LINE 00000791 "Another source is from a bash function (C<-F>). The function will receive input"
NSQ_SOURCE_LINE 00000792 "in two variables: C<COMP_WORDS> (array, command-line chopped into words) and"
NSQ_SOURCE_LINE 00000793 "C<COMP_CWORD> (integer, index to the array of words indicating the cursor"
NSQ_SOURCE_LINE 00000794 "position). It must set an array variable C<COMPREPLY> that contains the list of"
NSQ_SOURCE_LINE 00000795 "possible completion:"
NSQ_SOURCE_LINE 00000796 ""
NSQ_SOURCE_LINE 00000797 " % _foo()"
NSQ_SOURCE_LINE 00000798 " {"
NSQ_SOURCE_LINE 00000799 "   local cur"
NSQ_SOURCE_LINE 00000800 "   COMPREPLY=()"
NSQ_SOURCE_LINE 00000801 "   cur=${COMP_WORDS[COMP_CWORD]}"
NSQ_SOURCE_LINE 00000802 "   COMPREPLY=($( compgen -W '--help --verbose --version' -- $cur ) )"
NSQ_SOURCE_LINE 00000803 " }"
NSQ_SOURCE_LINE 00000804 " % complete -F _foo foo"
NSQ_SOURCE_LINE 00000805 " % foo <Tab>"
NSQ_SOURCE_LINE 00000806 " --help  --verbose  --version"
NSQ_SOURCE_LINE 00000807 ""
NSQ_SOURCE_LINE 00000808 "And yet another source is an external command (C<-C>) including, from a Perl"
NSQ_SOURCE_LINE 00000809 "script. The command receives two environment variables: C<COMP_LINE> (string,"
NSQ_SOURCE_LINE 00000810 "raw command-line) and C<COMP_POINT> (integer, cursor location). Program must"
NSQ_SOURCE_LINE 00000811 "split C<COMP_LINE> into words, find the word to be completed, complete that, and"
NSQ_SOURCE_LINE 00000812 "return the list of words one per-line to STDOUT. An example:"
NSQ_SOURCE_LINE 00000813 ""
NSQ_SOURCE_LINE 00000814 " % cat foo-complete"
NSQ_SOURCE_LINE 00000815 " #!/usr/bin/perl"
NSQ_SOURCE_LINE 00000816 " use Complete::Bash qw(parse_cmdline format_completion);"
NSQ_SOURCE_LINE 00000817 " use Complete::Util qw(complete_array_elem);"
NSQ_SOURCE_LINE 00000818 " my ($words, $cword) = @{ parse_cmdline() };"
NSQ_SOURCE_LINE 00000819 " my $res = complete_array_elem(array=>[qw/--help --verbose --version/], word=>$words->[$cword]);"
NSQ_SOURCE_LINE 00000820 " print format_completion($res);"
NSQ_SOURCE_LINE 00000821 ""
NSQ_SOURCE_LINE 00000822 " % complete -C foo-complete foo"
NSQ_SOURCE_LINE 00000823 " % foo --v<Tab>"
NSQ_SOURCE_LINE 00000824 " --verbose --version"
NSQ_SOURCE_LINE 00000825 ""
NSQ_SOURCE_LINE 00000826 "=head2 About the routines in this module"
NSQ_SOURCE_LINE 00000827 ""
NSQ_SOURCE_LINE 00000828 "First of all, C<parse_cmdline()> is the function to parse raw command-line (such"
NSQ_SOURCE_LINE 00000829 "as what you get from bash in C<COMP_LINE> environment variable) into words. This"
NSQ_SOURCE_LINE 00000830 "makes it easy for the other functions to generate completion answer. See the"
NSQ_SOURCE_LINE 00000831 "documentation for that function for more details."
NSQ_SOURCE_LINE 00000832 ""
NSQ_SOURCE_LINE 00000833 "C<format_completion()> is what you use to format completion answer structure for"
NSQ_SOURCE_LINE 00000834 "bash."
NSQ_SOURCE_LINE 00000835 ""
NSQ_SOURCE_LINE 00000836 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000837 ""
NSQ_SOURCE_LINE 00000838 ""
NSQ_SOURCE_LINE 00000839 "=head2 format_completion"
NSQ_SOURCE_LINE 00000840 ""
NSQ_SOURCE_LINE 00000841 "Usage:"
NSQ_SOURCE_LINE 00000842 ""
NSQ_SOURCE_LINE 00000843 " format_completion($completion, $opts) -> str|array"
NSQ_SOURCE_LINE 00000844 ""
NSQ_SOURCE_LINE 00000845 "Format completion for output (for shell)."
NSQ_SOURCE_LINE 00000846 ""
NSQ_SOURCE_LINE 00000847 "Bash accepts completion reply in the form of one entry per line to STDOUT. Some"
NSQ_SOURCE_LINE 00000848 "characters will need to be escaped. This function helps you do the formatting,"
NSQ_SOURCE_LINE 00000849 "with some options."
NSQ_SOURCE_LINE 00000850 ""
NSQ_SOURCE_LINE 00000851 "This function accepts completion answer structure as described in the C<Complete>"
NSQ_SOURCE_LINE 00000852 "POD. Aside from C<words>, this function also recognizes these keys:"
NSQ_SOURCE_LINE 00000853 ""
NSQ_SOURCE_LINE 00000854 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000855 ""
NSQ_SOURCE_LINE 00000856 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000857 ""
NSQ_SOURCE_LINE 00000858 "=over 4"
NSQ_SOURCE_LINE 00000859 ""
NSQ_SOURCE_LINE 00000860 "=item * B<$completion>* => I<hash|array>"
NSQ_SOURCE_LINE 00000861 ""
NSQ_SOURCE_LINE 00000862 "Completion answer structure."
NSQ_SOURCE_LINE 00000863 ""
NSQ_SOURCE_LINE 00000864 "Either an array or hash. See function description for more details."
NSQ_SOURCE_LINE 00000865 ""
NSQ_SOURCE_LINE 00000866 "=item * B<$opts> => I<hash>"
NSQ_SOURCE_LINE 00000867 ""
NSQ_SOURCE_LINE 00000868 "Specify options."
NSQ_SOURCE_LINE 00000869 ""
NSQ_SOURCE_LINE 00000870 "Known options:"
NSQ_SOURCE_LINE 00000871 ""
NSQ_SOURCE_LINE 00000872 "=over"
NSQ_SOURCE_LINE 00000873 ""
NSQ_SOURCE_LINE 00000874 "=item * as"
NSQ_SOURCE_LINE 00000875 ""
NSQ_SOURCE_LINE 00000876 "Either C<string> (the default) or C<array> (to return array of lines instead of"
NSQ_SOURCE_LINE 00000877 "the lines joined together). Returning array is useful if you are doing"
NSQ_SOURCE_LINE 00000878 "completion inside C<Term::ReadLine>, for example, where the library expects an"
NSQ_SOURCE_LINE 00000879 "array."
NSQ_SOURCE_LINE 00000880 ""
NSQ_SOURCE_LINE 00000881 "=item * esc_mode"
NSQ_SOURCE_LINE 00000882 ""
NSQ_SOURCE_LINE 00000883 "Escaping mode for entries. Either C<default> (most nonalphanumeric characters"
NSQ_SOURCE_LINE 00000884 "will be escaped), C<shellvar> (like C<default>, but dollar sign C<$> will also be"
NSQ_SOURCE_LINE 00000885 "escaped, convenient when completing environment variables for example),"
NSQ_SOURCE_LINE 00000886 "C<filename> (currently equals to C<default>), C<option> (currently equals to"
NSQ_SOURCE_LINE 00000887 "C<default>), or C<none> (no escaping will be done)."
NSQ_SOURCE_LINE 00000888 ""
NSQ_SOURCE_LINE 00000889 "=item * word"
NSQ_SOURCE_LINE 00000890 ""
NSQ_SOURCE_LINE 00000891 "A workaround. String. For now, see source code for more details."
NSQ_SOURCE_LINE 00000892 ""
NSQ_SOURCE_LINE 00000893 "=item * show_summaries"
NSQ_SOURCE_LINE 00000894 ""
NSQ_SOURCE_LINE 00000895 "Whether to show item's summaries. Boolean, default is from"
NSQ_SOURCE_LINE 00000896 "COMPLETE_BASH_SHOW_SUMMARIES environment variable or 1."
NSQ_SOURCE_LINE 00000897 ""
NSQ_SOURCE_LINE 00000898 "An answer item contain summary, which is a short description about the item,"
NSQ_SOURCE_LINE 00000899 "e.g.:"
NSQ_SOURCE_LINE 00000900 ""
NSQ_SOURCE_LINE 00000901 "  [{word=>\"-a\"    , summary=>\"Show hidden files\"},"
NSQ_SOURCE_LINE 00000902 "   {word=>\"-l\"    , summary=>\"Show details\"},"
NSQ_SOURCE_LINE 00000903 "   {word=>\"--sort\", summary=>\"Specify sort order\"}],"
NSQ_SOURCE_LINE 00000904 ""
NSQ_SOURCE_LINE 00000905 "When summaries are not shown, user will just be seeing something like:"
NSQ_SOURCE_LINE 00000906 ""
NSQ_SOURCE_LINE 00000907 "  -a"
NSQ_SOURCE_LINE 00000908 "  -l"
NSQ_SOURCE_LINE 00000909 "  --sort"
NSQ_SOURCE_LINE 00000910 ""
NSQ_SOURCE_LINE 00000911 "But when summaries are shown, user will see:"
NSQ_SOURCE_LINE 00000912 ""
NSQ_SOURCE_LINE 00000913 "  -a         -- Show hidden files"
NSQ_SOURCE_LINE 00000914 "  -l         -- Show details"
NSQ_SOURCE_LINE 00000915 "  --sort     -- Specify sort order"
NSQ_SOURCE_LINE 00000916 ""
NSQ_SOURCE_LINE 00000917 "which is quite helpful."
NSQ_SOURCE_LINE 00000918 ""
NSQ_SOURCE_LINE 00000919 "=item * workaround_with_wordbreaks"
NSQ_SOURCE_LINE 00000920 ""
NSQ_SOURCE_LINE 00000921 "Boolean. Default is true. See source code for more details."
NSQ_SOURCE_LINE 00000922 ""
NSQ_SOURCE_LINE 00000923 "=back"
NSQ_SOURCE_LINE 00000924 ""
NSQ_SOURCE_LINE 00000925 ""
NSQ_SOURCE_LINE 00000926 "=back"
NSQ_SOURCE_LINE 00000927 ""
NSQ_SOURCE_LINE 00000928 "Return value: Formatted string (or array, if `as` is set to `array`) (str|array)"
NSQ_SOURCE_LINE 00000929 ""
NSQ_SOURCE_LINE 00000930 ""
NSQ_SOURCE_LINE 00000931 ""
NSQ_SOURCE_LINE 00000932 "=head2 join_wordbreak_words"
NSQ_SOURCE_LINE 00000933 ""
NSQ_SOURCE_LINE 00000934 "Usage:"
NSQ_SOURCE_LINE 00000935 ""
NSQ_SOURCE_LINE 00000936 " join_wordbreak_words() -> [$status_code, $reason, $payload, \\%result_meta]"
NSQ_SOURCE_LINE 00000937 ""
NSQ_SOURCE_LINE 00000938 "Post-process parse_cmdline() result by joining some words."
NSQ_SOURCE_LINE 00000939 ""
NSQ_SOURCE_LINE 00000940 "C<parse_cmdline()>, like bash, splits some characters that are considered as"
NSQ_SOURCE_LINE 00000941 "word-breaking characters:"
NSQ_SOURCE_LINE 00000942 ""
NSQ_SOURCE_LINE 00000943 " \"'@><=;|&(:"
NSQ_SOURCE_LINE 00000944 ""
NSQ_SOURCE_LINE 00000945 "So if command-line is:"
NSQ_SOURCE_LINE 00000946 ""
NSQ_SOURCE_LINE 00000947 " command --module=Data::Dump bob@example.org"
NSQ_SOURCE_LINE 00000948 ""
NSQ_SOURCE_LINE 00000949 "then they will be parsed as:"
NSQ_SOURCE_LINE 00000950 ""
NSQ_SOURCE_LINE 00000951 " [\"command\", \"--module\", \"=\", \"Data\", \"::\", \"Dump\", \"bob\", '@', \"example.org\"]"
NSQ_SOURCE_LINE 00000952 ""
NSQ_SOURCE_LINE 00000953 "Normally in Perl applications, we want C<:>, C<@> to be part of word. So this"
NSQ_SOURCE_LINE 00000954 "routine will convert the above into:"
NSQ_SOURCE_LINE 00000955 ""
NSQ_SOURCE_LINE 00000956 " [\"command\", \"--module=Data::Dump\", 'bob@example.org']"
NSQ_SOURCE_LINE 00000957 ""
NSQ_SOURCE_LINE 00000958 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000959 ""
NSQ_SOURCE_LINE 00000960 "No arguments."
NSQ_SOURCE_LINE 00000961 ""
NSQ_SOURCE_LINE 00000962 "Returns an enveloped result (an array)."
NSQ_SOURCE_LINE 00000963 ""
NSQ_SOURCE_LINE 00000964 "First element ($status_code) is an integer containing HTTP-like status code"
NSQ_SOURCE_LINE 00000965 "(200 means OK, 4xx caller error, 5xx function error). Second element"
NSQ_SOURCE_LINE 00000966 "($reason) is a string containing error message, or something like \"OK\" if status is"
NSQ_SOURCE_LINE 00000967 "200. Third element ($payload) is the actual result, but usually not present when enveloped result is an error response ($status_code is not 2xx). Fourth"
NSQ_SOURCE_LINE 00000968 "element (%result_meta) is called result metadata and is optional, a hash"
NSQ_SOURCE_LINE 00000969 "that contains extra information, much like how HTTP response headers provide additional metadata."
NSQ_SOURCE_LINE 00000970 ""
NSQ_SOURCE_LINE 00000971 "Return value:  (any)"
NSQ_SOURCE_LINE 00000972 ""
NSQ_SOURCE_LINE 00000973 ""
NSQ_SOURCE_LINE 00000974 ""
NSQ_SOURCE_LINE 00000975 "=head2 parse_cmdline"
NSQ_SOURCE_LINE 00000976 ""
NSQ_SOURCE_LINE 00000977 "Usage:"
NSQ_SOURCE_LINE 00000978 ""
NSQ_SOURCE_LINE 00000979 " parse_cmdline($cmdline, $point, $opts) -> array"
NSQ_SOURCE_LINE 00000980 ""
NSQ_SOURCE_LINE 00000981 "Parse shell command-line for processing by completion routines."
NSQ_SOURCE_LINE 00000982 ""
NSQ_SOURCE_LINE 00000983 "This function basically converts C<COMP_LINE> (str) and C<COMP_POINT> (int) into"
NSQ_SOURCE_LINE 00000984 "something like (but not exactly the same as) C<COMP_WORDS> (array) and"
NSQ_SOURCE_LINE 00000985 "C<COMP_CWORD> (int) that bash supplies to shell functions."
NSQ_SOURCE_LINE 00000986 ""
NSQ_SOURCE_LINE 00000987 "The differences with bash are (these differences are mostly for parsing"
NSQ_SOURCE_LINE 00000988 "convenience for programs that use this routine; this comparison is made against"
NSQ_SOURCE_LINE 00000989 "bash versions 4.2-4.3):"
NSQ_SOURCE_LINE 00000990 ""
NSQ_SOURCE_LINE 00000991 "1) quotes and backslashes are stripped (bash's C<COMP_WORDS> contains all the"
NSQ_SOURCE_LINE 00000992 "   quotes and backslashes);"
NSQ_SOURCE_LINE 00000993 ""
NSQ_SOURCE_LINE 00000994 "2) quoted phrase that contains spaces, or phrase that contains escaped spaces is"
NSQ_SOURCE_LINE 00000995 "   parsed as a single word. For example:"
NSQ_SOURCE_LINE 00000996 ""
NSQ_SOURCE_LINE 00000997 " command \"First argument\" Second\\ argument"
NSQ_SOURCE_LINE 00000998 ""
NSQ_SOURCE_LINE 00000999 "   bash would split it as (represented as Perl):"
NSQ_SOURCE_LINE 00001000 ""
NSQ_SOURCE_LINE 00001001 " [\"command\", \"\\\"First\", \"argument\\\"\", \"Second\\\\\", \"argument\"]"
NSQ_SOURCE_LINE 00001002 ""
NSQ_SOURCE_LINE 00001003 "   which is not very convenient. We parse it into:"
NSQ_SOURCE_LINE 00001004 ""
NSQ_SOURCE_LINE 00001005 " [\"command\", \"First argument\", \"Second argument\"]"
NSQ_SOURCE_LINE 00001006 ""
NSQ_SOURCE_LINE 00001007 "3) variables are substituted with their values from environment variables except"
NSQ_SOURCE_LINE 00001008 "   for the current word (C<COMP_WORDS[COMP_CWORD]>) (bash does not perform"
NSQ_SOURCE_LINE 00001009 "   variable substitution for C<COMP_WORDS>). However, note that special shell"
NSQ_SOURCE_LINE 00001010 "   variables that are not environment variables like C<$0>, C<$_>, C<$IFS> will not"
NSQ_SOURCE_LINE 00001011 "   be replaced correctly because bash does not export those variables for us."
NSQ_SOURCE_LINE 00001012 ""
NSQ_SOURCE_LINE 00001013 "4) tildes (C<~>) are expanded with user's home directory except for the current"
NSQ_SOURCE_LINE 00001014 "   word (bash does not perform tilde expansion for C<COMP_WORDS>);"
NSQ_SOURCE_LINE 00001015 ""
NSQ_SOURCE_LINE 00001016 "Caveats:"
NSQ_SOURCE_LINE 00001017 ""
NSQ_SOURCE_LINE 00001018 "=over"
NSQ_SOURCE_LINE 00001019 ""
NSQ_SOURCE_LINE 00001020 "=item * Like bash, we group non-whitespace word-breaking characters into its own word."
NSQ_SOURCE_LINE 00001021 "By default C<COMP_WORDBREAKS> is:"
NSQ_SOURCE_LINE 00001022 ""
NSQ_SOURCE_LINE 00001023 "\"'@><=;|&(:"
NSQ_SOURCE_LINE 00001024 ""
NSQ_SOURCE_LINE 00001025 "So if raw command-line is:"
NSQ_SOURCE_LINE 00001026 ""
NSQ_SOURCE_LINE 00001027 "command --foo=bar http://example.com:80 mail@example.org Foo::Bar"
NSQ_SOURCE_LINE 00001028 ""
NSQ_SOURCE_LINE 00001029 "then the parse result will be:"
NSQ_SOURCE_LINE 00001030 ""
NSQ_SOURCE_LINE 00001031 "[\"command\", \"--foo\", \"=\", \"bar\", \"http\", \":\", \"//example.com\", \":\", \"80\", \"Foo\", \"::\", \"Bar\"]"
NSQ_SOURCE_LINE 00001032 ""
NSQ_SOURCE_LINE 00001033 "which is annoying sometimes. But we follow bash here so we can more easily"
NSQ_SOURCE_LINE 00001034 "accept input from a joined C<COMP_WORDS> if we write completion bash functions,"
NSQ_SOURCE_LINE 00001035 "e.g. (in the example, C<foo> is a Perl script):"
NSQ_SOURCE_LINE 00001036 ""
NSQ_SOURCE_LINE 00001037 "I<foo ()"
NSQ_SOURCE_LINE 00001038 "{"
NSQ_SOURCE_LINE 00001039 "    local words=(${COMP>CWORDS[@]})"
NSQ_SOURCE_LINE 00001040 "    # add things to words, etc"
NSQ_SOURCE_LINE 00001041 "    local point=... # calculate the new point"
NSQ_SOURCE_LINE 00001042 "    COMPREPLY=( C<COMP_LINE=\"foo ${words[@]}\" COMP_POINT=$point foo> )"
NSQ_SOURCE_LINE 00001043 "}"
NSQ_SOURCE_LINE 00001044 ""
NSQ_SOURCE_LINE 00001045 "To avoid these word-breaking characters to be split/grouped, we can escape"
NSQ_SOURCE_LINE 00001046 "them with backslash or quote them, e.g.:"
NSQ_SOURCE_LINE 00001047 ""
NSQ_SOURCE_LINE 00001048 "command \"http://example.com:80\" Foo\\:\\:Bar"
NSQ_SOURCE_LINE 00001049 ""
NSQ_SOURCE_LINE 00001050 "which bash will parse as:"
NSQ_SOURCE_LINE 00001051 ""
NSQ_SOURCE_LINE 00001052 "[\"command\", \"\\\"http://example.com:80\\\"\", \"Foo\\:\\:Bar\"]"
NSQ_SOURCE_LINE 00001053 ""
NSQ_SOURCE_LINE 00001054 "and we parse as:"
NSQ_SOURCE_LINE 00001055 ""
NSQ_SOURCE_LINE 00001056 "[\"command\", \"http://example.com:80\", \"Foo::Bar\"]"
NSQ_SOURCE_LINE 00001057 ""
NSQ_SOURCE_LINE 00001058 "=item * Due to the way bash parses the command line (see above), the two below are"
NSQ_SOURCE_LINE 00001059 "equivalent:"
NSQ_SOURCE_LINE 00001060 ""
NSQ_SOURCE_LINE 00001061 "% cmd --foo=bar"
NSQ_SOURCE_LINE 00001062 "% cmd --foo = bar"
NSQ_SOURCE_LINE 00001063 ""
NSQ_SOURCE_LINE 00001064 "=back"
NSQ_SOURCE_LINE 00001065 ""
NSQ_SOURCE_LINE 00001066 "Because they both expand to C<['--foo', '=', 'bar']>. But obviously"
NSQ_SOURCE_LINE 00001067 "L<Getopt::Long> does not regard the two as equivalent."
NSQ_SOURCE_LINE 00001068 ""
NSQ_SOURCE_LINE 00001069 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00001070 ""
NSQ_SOURCE_LINE 00001071 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00001072 ""
NSQ_SOURCE_LINE 00001073 "=over 4"
NSQ_SOURCE_LINE 00001074 ""
NSQ_SOURCE_LINE 00001075 "=item * B<$cmdline> => I<str>"
NSQ_SOURCE_LINE 00001076 ""
NSQ_SOURCE_LINE 00001077 "Command-line, defaults to COMP_LINE environment."
NSQ_SOURCE_LINE 00001078 ""
NSQ_SOURCE_LINE 00001079 "=item * B<$opts> => I<hash>"
NSQ_SOURCE_LINE 00001080 ""
NSQ_SOURCE_LINE 00001081 "Options."
NSQ_SOURCE_LINE 00001082 ""
NSQ_SOURCE_LINE 00001083 "Optional. Known options:"
NSQ_SOURCE_LINE 00001084 ""
NSQ_SOURCE_LINE 00001085 "=over"
NSQ_SOURCE_LINE 00001086 ""
NSQ_SOURCE_LINE 00001087 "=item * C<truncate_current_word> (bool). If set to 1, will truncate current word to the"
NSQ_SOURCE_LINE 00001088 "position of cursor, for example (C<^> marks the position of cursor):"
NSQ_SOURCE_LINE 00001089 "C<--vers^oo> to C<--vers> instead of C<--versoo>. This is more convenient when"
NSQ_SOURCE_LINE 00001090 "doing tab completion."
NSQ_SOURCE_LINE 00001091 ""
NSQ_SOURCE_LINE 00001092 "=back"
NSQ_SOURCE_LINE 00001093 ""
NSQ_SOURCE_LINE 00001094 "=item * B<$point> => I<int>"
NSQ_SOURCE_LINE 00001095 ""
NSQ_SOURCE_LINE 00001096 "PointE<sol>position to complete in command-line, defaults to COMP_POINT."
NSQ_SOURCE_LINE 00001097 ""
NSQ_SOURCE_LINE 00001098 ""
NSQ_SOURCE_LINE 00001099 "=back"
NSQ_SOURCE_LINE 00001100 ""
NSQ_SOURCE_LINE 00001101 "Return value:  (array)"
NSQ_SOURCE_LINE 00001102 ""
NSQ_SOURCE_LINE 00001103 ""
NSQ_SOURCE_LINE 00001104 "Return a 2-element array: C<[$words, $cword]>. C<$words> is array of str,"
NSQ_SOURCE_LINE 00001105 "equivalent to C<COMP_WORDS> provided by bash to shell functions. C<$cword> is an"
NSQ_SOURCE_LINE 00001106 "integer, roughly equivalent to C<COMP_CWORD> provided by bash to shell functions."
NSQ_SOURCE_LINE 00001107 "The word to be completed is at C<< $words-E<gt>[$cword] >>."
NSQ_SOURCE_LINE 00001108 ""
NSQ_SOURCE_LINE 00001109 "Note that COMP_LINE includes the command name. If you want the command-line"
NSQ_SOURCE_LINE 00001110 "arguments only (like in C<@ARGV>), you need to strip the first element from"
NSQ_SOURCE_LINE 00001111 "C<$words> and reduce C<$cword> by 1."
NSQ_SOURCE_LINE 00001112 ""
NSQ_SOURCE_LINE 00001113 ""
NSQ_SOURCE_LINE 00001114 ""
NSQ_SOURCE_LINE 00001115 "=head2 point"
NSQ_SOURCE_LINE 00001116 ""
NSQ_SOURCE_LINE 00001117 "Usage:"
NSQ_SOURCE_LINE 00001118 ""
NSQ_SOURCE_LINE 00001119 " point($cmdline, $marker) -> any"
NSQ_SOURCE_LINE 00001120 ""
NSQ_SOURCE_LINE 00001121 "Return line with point marked by a marker."
NSQ_SOURCE_LINE 00001122 ""
NSQ_SOURCE_LINE 00001123 "This is a utility function useful for testing/debugging. C<parse_cmdline()>"
NSQ_SOURCE_LINE 00001124 "expects a command-line and a cursor position (C<$line>, C<$point>). This routine"
NSQ_SOURCE_LINE 00001125 "expects C<$line> with a marker character (by default it's the caret, C<^>) and"
NSQ_SOURCE_LINE 00001126 "return (C<$line>, C<$point>) to feed to C<parse_cmdline()>."
NSQ_SOURCE_LINE 00001127 ""
NSQ_SOURCE_LINE 00001128 "Example:"
NSQ_SOURCE_LINE 00001129 ""
NSQ_SOURCE_LINE 00001130 " point(\"^foo\") # => (\"foo\", 0)"
NSQ_SOURCE_LINE 00001131 " point(\"fo^o\") # => (\"foo\", 2)"
NSQ_SOURCE_LINE 00001132 ""
NSQ_SOURCE_LINE 00001133 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00001134 ""
NSQ_SOURCE_LINE 00001135 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00001136 ""
NSQ_SOURCE_LINE 00001137 "=over 4"
NSQ_SOURCE_LINE 00001138 ""
NSQ_SOURCE_LINE 00001139 "=item * B<$cmdline> => I<str>"
NSQ_SOURCE_LINE 00001140 ""
NSQ_SOURCE_LINE 00001141 "Command-line which contains a marker character."
NSQ_SOURCE_LINE 00001142 ""
NSQ_SOURCE_LINE 00001143 "=item * B<$marker> => I<str> (default: \"^\")"
NSQ_SOURCE_LINE 00001144 ""
NSQ_SOURCE_LINE 00001145 "Marker character."
NSQ_SOURCE_LINE 00001146 ""
NSQ_SOURCE_LINE 00001147 ""
NSQ_SOURCE_LINE 00001148 "=back"
NSQ_SOURCE_LINE 00001149 ""
NSQ_SOURCE_LINE 00001150 "Return value:  (any)"
NSQ_SOURCE_LINE 00001151 ""
NSQ_SOURCE_LINE 00001152 "=head1 ENVIRONMENT"
NSQ_SOURCE_LINE 00001153 ""
NSQ_SOURCE_LINE 00001154 "=head2 COMPLETE_BASH_DEFAULT_ESC_MODE"
NSQ_SOURCE_LINE 00001155 ""
NSQ_SOURCE_LINE 00001156 "Str. To provide default for the C<esc_mode> option in L</format_completion>."
NSQ_SOURCE_LINE 00001157 ""
NSQ_SOURCE_LINE 00001158 "=head2 COMPLETE_BASH_FZF"
NSQ_SOURCE_LINE 00001159 ""
NSQ_SOURCE_LINE 00001160 "Bool. Whether to pass large completion answer to fzf instead of directly passing"
NSQ_SOURCE_LINE 00001161 "it to bash and letting bash page it with a simpler more-like internal pager. By"
NSQ_SOURCE_LINE 00001162 "default, large is defined as having at least 100 items (same bash's"
NSQ_SOURCE_LINE 00001163 "C<completion-query-items> setting). This can be configured via"
NSQ_SOURCE_LINE 00001164 "L</COMPLETE_BASH_FZF_ITEMS>."
NSQ_SOURCE_LINE 00001165 ""
NSQ_SOURCE_LINE 00001166 "Will not pass to fzf if inside emacs (C<INSIDE_EMACS> environment is true)."
NSQ_SOURCE_LINE 00001167 ""
NSQ_SOURCE_LINE 00001168 "=head2 COMPLETE_BASH_FZF_ITEMS"
NSQ_SOURCE_LINE 00001169 ""
NSQ_SOURCE_LINE 00001170 "Uint. Default 100. The minimum number of items to trigger passing completion"
NSQ_SOURCE_LINE 00001171 "answer to C<fzf>."
NSQ_SOURCE_LINE 00001172 ""
NSQ_SOURCE_LINE 00001173 "A special value of -1 means to use terminal height. However, since terminal"
NSQ_SOURCE_LINE 00001174 "height (and width) normally cannot be read during tab completion anyway, it's"
NSQ_SOURCE_LINE 00001175 "better if you do something like this in your bash startup file:"
NSQ_SOURCE_LINE 00001176 ""
NSQ_SOURCE_LINE 00001177 " export COMPLETE_BASH_FZF_ITEMS=$LINES"
NSQ_SOURCE_LINE 00001178 ""
NSQ_SOURCE_LINE 00001179 "because without passing to C<fzf>, as soon as the number of completion answers"
NSQ_SOURCE_LINE 00001180 "exceeds C<$LINES>, C<bash> will start paging the answer to its internal pager,"
NSQ_SOURCE_LINE 00001181 "which is limited like C<more>. If you set the above, then as soon as the number"
NSQ_SOURCE_LINE 00001182 "of completion answers exceeds terminal height, you will avoid the bash internal"
NSQ_SOURCE_LINE 00001183 "pager and use the nicer C<fzf>."
NSQ_SOURCE_LINE 00001184 ""
NSQ_SOURCE_LINE 00001185 "See also: L</COMPLETE_BASH_FZF>."
NSQ_SOURCE_LINE 00001186 ""
NSQ_SOURCE_LINE 00001187 "=head2 COMPLETE_BASH_MAX_COLUMNS"
NSQ_SOURCE_LINE 00001188 ""
NSQ_SOURCE_LINE 00001189 "Uint."
NSQ_SOURCE_LINE 00001190 ""
NSQ_SOURCE_LINE 00001191 "Bash will show completion entries in one or several columns, depending on the"
NSQ_SOURCE_LINE 00001192 "terminal width and the length of the entries (much like a standard non-long"
NSQ_SOURCE_LINE 00001193 "`ls`). If you prefer completion entries to be shown in a single column no matter"
NSQ_SOURCE_LINE 00001194 "how wide your terminal is, or how short the entries are, you can set the value"
NSQ_SOURCE_LINE 00001195 "of this variable to 1. If you prefer a maximum of two columns, set to 2, and so"
NSQ_SOURCE_LINE 00001196 "on. L</format_completion> will pad the entries with sufficient spaces to limit"
NSQ_SOURCE_LINE 00001197 "the number of columns."
NSQ_SOURCE_LINE 00001198 ""
NSQ_SOURCE_LINE 00001199 "=head2 COMPLETE_BASH_SHOW_SUMMARIES"
NSQ_SOURCE_LINE 00001200 ""
NSQ_SOURCE_LINE 00001201 "Bool. Will set the default for C<show_summaries> option in"
NSQ_SOURCE_LINE 00001202 "L</format_completion>."
NSQ_SOURCE_LINE 00001203 ""
NSQ_SOURCE_LINE 00001204 "=head2 COMPLETE_BASH_SUMMARY_ALIGN"
NSQ_SOURCE_LINE 00001205 ""
NSQ_SOURCE_LINE 00001206 "String. Either C<left> (the default) or C<right>."
NSQ_SOURCE_LINE 00001207 ""
NSQ_SOURCE_LINE 00001208 "The C<left> align looks something like this:"
NSQ_SOURCE_LINE 00001209 ""
NSQ_SOURCE_LINE 00001210 " --bar      Summary about the bar option"
NSQ_SOURCE_LINE 00001211 " --baz      Summary about the baz option"
NSQ_SOURCE_LINE 00001212 " --foo      Summary about the foo option"
NSQ_SOURCE_LINE 00001213 " --schapen  Summary about the schapen option"
NSQ_SOURCE_LINE 00001214 ""
NSQ_SOURCE_LINE 00001215 "The C<right> align will make the completion answer look like what you see in the"
NSQ_SOURCE_LINE 00001216 "B<fish> shell:"
NSQ_SOURCE_LINE 00001217 ""
NSQ_SOURCE_LINE 00001218 " --bar                        Summary about the bar option"
NSQ_SOURCE_LINE 00001219 " --baz                        Summary about the baz option"
NSQ_SOURCE_LINE 00001220 " --foo                        Summary about the foo option"
NSQ_SOURCE_LINE 00001221 " --schapen                Summary about the schapen option"
NSQ_SOURCE_LINE 00001222 ""
NSQ_SOURCE_LINE 00001223 "=head2 COMPLETE_BASH_TRACE"
NSQ_SOURCE_LINE 00001224 ""
NSQ_SOURCE_LINE 00001225 "Bool. If set to true, will produce more log statements to L<Log::ger>."
NSQ_SOURCE_LINE 00001226 ""
NSQ_SOURCE_LINE 00001227 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00001228 ""
NSQ_SOURCE_LINE 00001229 "Please visit the project's homepage at L<https://metacpan.org/release/Complete-Bash>."
NSQ_SOURCE_LINE 00001230 ""
NSQ_SOURCE_LINE 00001231 "=head1 SOURCE"
NSQ_SOURCE_LINE 00001232 ""
NSQ_SOURCE_LINE 00001233 "Source repository is at L<https://github.com/perlancar/perl-Complete-Bash>."
NSQ_SOURCE_LINE 00001234 ""
NSQ_SOURCE_LINE 00001235 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00001236 ""
NSQ_SOURCE_LINE 00001237 "L<Complete>, the convention that this module follows."
NSQ_SOURCE_LINE 00001238 ""
NSQ_SOURCE_LINE 00001239 "Some higher-level modules that use this module (so you don't have to use this"
NSQ_SOURCE_LINE 00001240 "module directly): L<Getopt::Long::Complete> (via L<Complete::Getopt::Long>),"
NSQ_SOURCE_LINE 00001241 "L<Getopt::Long::Subcommand>, L<Perinci::CmdLine> (via"
NSQ_SOURCE_LINE 00001242 "L<Perinci::Sub::Complete>)."
NSQ_SOURCE_LINE 00001243 ""
NSQ_SOURCE_LINE 00001244 "Other modules related to bash shell tab completion: L<Bash::Completion>,"
NSQ_SOURCE_LINE 00001245 "L<Getopt::Complete>, L<Term::Bash::Completion::Generator>."
NSQ_SOURCE_LINE 00001246 ""
NSQ_SOURCE_LINE 00001247 "Programmable Completion section in Bash manual:"
NSQ_SOURCE_LINE 00001248 "L<https://www.gnu.org/software/bash/manual/html_node/Programmable-Completion.html>"
NSQ_SOURCE_LINE 00001249 ""
