NSQ_SOURCE_LINE 00000027 "    generate  => [qw(uuid_v1 uuid_v2 uuid_v3 uuid_v4 uuid_v5"
NSQ_SOURCE_LINE 00000028 "                     uuid_v6 uuid_v7 uuid_v8 uuid_nil uuid_max uuid_v4_bulk)],"
NSQ_SOURCE_LINE 00000029 "    util      => [qw(uuid_parse uuid_validate uuid_version uuid_variant"
NSQ_SOURCE_LINE 00000030 "                     uuid_cmp uuid_convert uuid_time uuid_is_nil uuid_is_max)],"
NSQ_SOURCE_LINE 00000031 "    format    => [qw(UUID_FMT_STR UUID_FMT_HEX UUID_FMT_BRACES UUID_FMT_URN"
NSQ_SOURCE_LINE 00000032 "                     UUID_FMT_BASE64 UUID_FMT_BASE32 UUID_FMT_CROCKFORD"
NSQ_SOURCE_LINE 00000033 "                     UUID_FMT_BINARY UUID_FMT_UPPER_STR UUID_FMT_UPPER_HEX)],"
NSQ_SOURCE_LINE 00000034 "    namespace => [qw(UUID_NS_DNS UUID_NS_URL UUID_NS_OID UUID_NS_X500)],"
NSQ_SOURCE_LINE 00000035 ");"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "require XSLoader;"
