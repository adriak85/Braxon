NSQ_SOURCE_LINE 00000019 "    UUID_FMT_BASE64 UUID_FMT_BASE32 UUID_FMT_CROCKFORD"
NSQ_SOURCE_LINE 00000020 "    UUID_FMT_BINARY UUID_FMT_UPPER_STR UUID_FMT_UPPER_HEX"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "    UUID_NS_DNS UUID_NS_URL UUID_NS_OID UUID_NS_X500"
NSQ_SOURCE_LINE 00000023 ");"
NSQ_SOURCE_LINE 00000024 ""
