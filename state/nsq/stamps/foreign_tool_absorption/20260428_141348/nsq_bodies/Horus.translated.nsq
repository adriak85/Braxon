NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "our $VERSION = '0.08';"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "use Exporter 'import';"
NSQ_SOURCE_LINE 00000010 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000011 "    uuid_v1 uuid_v2 uuid_v3 uuid_v4 uuid_v5"
NSQ_SOURCE_LINE 00000012 "    uuid_v6 uuid_v7 uuid_v8 uuid_nil uuid_max"
