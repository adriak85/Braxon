BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Aard;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.014000;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 "our $VERSION = '0.001';"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use IO::Uncompress::Inflate qw/inflate/;"
NSQ_SOURCE_LINE 00000009 "use IO::Uncompress::Bunzip2 qw/bunzip2/;"
NSQ_SOURCE_LINE 00000010 "use List::Util qw/sum/;"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "use JSON::MaybeXS qw/decode_json/;"
NSQ_SOURCE_LINE 00000013 "use UUID::Tiny qw/uuid_to_string/;"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "use constant HEADER_SPEC => ["
NSQ_SOURCE_LINE 00000016 "\t[signature             => 'Z4' , 4 ],"
NSQ_SOURCE_LINE 00000017 "\t[sha1sum               => 'Z40', 40],"
NSQ_SOURCE_LINE 00000018 "\t[version               => 'S>' , 2 ],"
NSQ_SOURCE_LINE 00000019 "\t[uuid                  => 'Z16', 16],"
NSQ_SOURCE_LINE 00000020 "\t[volume                => 'S>' , 2 ],"
NSQ_SOURCE_LINE 00000021 "\t[total_volumes         => 'S>' , 2 ],"
NSQ_SOURCE_LINE 00000022 "\t[meta_length           => 'L>' , 4 ],"
NSQ_SOURCE_LINE 00000023 "\t[index_count           => 'L>' , 4 ],"
NSQ_SOURCE_LINE 00000024 "\t[article_offset        => 'L>' , 4 ],"
NSQ_SOURCE_LINE 00000025 "\t[index1_item_format    => 'Z4' , 4 ],"
NSQ_SOURCE_LINE 00000026 "\t[key_length_format     => 'Z2' , 2 ],"
NSQ_SOURCE_LINE 00000027 "\t[article_length_format => 'Z2' , 2 ],"
NSQ_SOURCE_LINE 00000028 "];"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "my $header_length = sum map { $_->[2] } @{HEADER_SPEC()};"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "sub decompress {"
NSQ_SOURCE_LINE 00000033 "\tmy ($input) = @_;"
NSQ_SOURCE_LINE 00000034 "\tmy $output = $input;"
NSQ_SOURCE_LINE 00000035 "\tinflate \\$input => \\$output;"
NSQ_SOURCE_LINE 00000036 "\tbunzip2 \\$input => \\$output if $input =~ /^BZ/;"
NSQ_SOURCE_LINE 00000037 "\t$output"
NSQ_SOURCE_LINE 00000038 "}"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "sub read_at {"
NSQ_SOURCE_LINE 00000041 "\tmy ($self, $offset, $length) = @_;"
NSQ_SOURCE_LINE 00000042 "\tmy $fh = $self->{fh};"
NSQ_SOURCE_LINE 00000043 "\tmy $part;"
NSQ_SOURCE_LINE 00000044 "\tseek $fh, $offset, 0;"
NSQ_SOURCE_LINE 00000045 "\tread $fh, $part, $length;"
NSQ_SOURCE_LINE 00000046 "\t$part"
NSQ_SOURCE_LINE 00000047 "}"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "sub index1 {"
NSQ_SOURCE_LINE 00000050 "\tmy ($self, $index) = @_;"
NSQ_SOURCE_LINE 00000051 "\tunless (exists $self->{index1}{$index}) {"
NSQ_SOURCE_LINE 00000052 "\t\tmy $part = $self->read_at($self->{index1_offset} + $index * $self->{index_length}, $self->{index_length});"
NSQ_SOURCE_LINE 00000053 "\t\t$self->{index1}{$index} = [unpack $self->{index_format}, $part]"
NSQ_SOURCE_LINE 00000054 "\t}"
NSQ_SOURCE_LINE 00000055 "\t$self->{index1}{$index}"
NSQ_SOURCE_LINE 00000056 "}"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "sub fh            { shift->{fh} }"
NSQ_SOURCE_LINE 00000059 "sub sha1sum       { shift->{sha1sum} }"
NSQ_SOURCE_LINE 00000060 "sub uuid          { shift->{uuid} }"
NSQ_SOURCE_LINE 00000061 "sub uuid_string   { uuid_to_string shift->uuid }"
NSQ_SOURCE_LINE 00000062 "sub volume        { shift->{volume} }"
NSQ_SOURCE_LINE 00000063 "sub total_volumes { shift->{total_volumes} }"
NSQ_SOURCE_LINE 00000064 "sub count         { shift->{index_count} }"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "sub meta                          { shift->{meta} }"
NSQ_SOURCE_LINE 00000067 "sub article_count                 { shift->meta->{article_count} }"
NSQ_SOURCE_LINE 00000068 "sub article_count_is_volume_total { shift->meta->{article_count_is_volume_total} }"
NSQ_SOURCE_LINE 00000069 "sub index_language                { shift->meta->{index_language} }"
NSQ_SOURCE_LINE 00000070 "sub article_language              { shift->meta->{article_language} }"
NSQ_SOURCE_LINE 00000071 "sub title                         { shift->meta->{title} }"
NSQ_SOURCE_LINE 00000072 "sub version                       { shift->meta->{version} }"
NSQ_SOURCE_LINE 00000073 "sub description                   { shift->meta->{description} }"
NSQ_SOURCE_LINE 00000074 "sub copyright                     { shift->meta->{copyright} }"
NSQ_SOURCE_LINE 00000075 "sub license                       { shift->meta->{license} }"
NSQ_SOURCE_LINE 00000076 "sub source                        { shift->meta->{source} }"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "sub key {"
NSQ_SOURCE_LINE 00000079 "\tmy ($self, $index) = @_;"
NSQ_SOURCE_LINE 00000080 "\tunless (exists $self->{key}{$index}) {"
NSQ_SOURCE_LINE 00000081 "\t\tmy $part = $self->read_at($self->{index2_offset} + $self->index1($index)->[0], 2);"
NSQ_SOURCE_LINE 00000082 "\t\tmy $len = unpack 'S>', $part;"
NSQ_SOURCE_LINE 00000083 "\t\tread $self->{fh}, $self->{key}{$index}, $len;"
NSQ_SOURCE_LINE 00000084 "\t}"
NSQ_SOURCE_LINE 00000085 "\t$self->{key}{$index}"
NSQ_SOURCE_LINE 00000086 "}"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "sub article {"
NSQ_SOURCE_LINE 00000089 "\tmy ($self, $index) = @_;"
NSQ_SOURCE_LINE 00000090 "\tunless (exists $self->{article}{$index}) {"
NSQ_SOURCE_LINE 00000091 "\t\tmy $part = $self->read_at($self->{article_offset} + $self->index1($index)->[1], 4);"
NSQ_SOURCE_LINE 00000092 "\t\tmy $len = unpack 'L>', $part;"
NSQ_SOURCE_LINE 00000093 "\t\tread $self->{fh}, $part, $len;"
NSQ_SOURCE_LINE 00000094 "\t\t$self->{article}{$index} = decompress $part"
NSQ_SOURCE_LINE 00000095 "\t}"
NSQ_SOURCE_LINE 00000096 "\t$self->{article}{$index}"
NSQ_SOURCE_LINE 00000097 "}"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "sub new {"
NSQ_SOURCE_LINE 00000100 "\tmy ($self, $file) = @_;"
NSQ_SOURCE_LINE 00000101 "\topen my $fh, '<', $file or die $!;"
NSQ_SOURCE_LINE 00000102 "\tbinmode $fh;"
NSQ_SOURCE_LINE 00000103 "\tmy %header;"
NSQ_SOURCE_LINE 00000104 "\tfor (@{HEADER_SPEC()}) {"
NSQ_SOURCE_LINE 00000105 "\t\tread $fh, my $part, $_->[2];"
NSQ_SOURCE_LINE 00000106 "\t\t$header{$_->[0]} = unpack $_->[1], $part;"
NSQ_SOURCE_LINE 00000107 "\t}"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "\tdie 'Not a recognized aarddict dictionary file' if $header{signature} ne 'aard';"
NSQ_SOURCE_LINE 00000110 "\tdie 'Unknown file format version' if $header{version} != 1;"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "\tread $fh, my $meta, $header{meta_length};"
NSQ_SOURCE_LINE 00000113 "\t$meta = decode_json decompress $meta;"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "\tmy %obj = ("
NSQ_SOURCE_LINE 00000116 "\t\t%header,"
NSQ_SOURCE_LINE 00000117 "\t\tfh => $fh,"
NSQ_SOURCE_LINE 00000118 "\t\tmeta => $meta,"
NSQ_SOURCE_LINE 00000119 "\t\tindex_format => ($header{index1_item_format} eq '>LL' ? 'L>L>' : 'L>Q>'),"
NSQ_SOURCE_LINE 00000120 "\t\tindex_length => ($header{index1_item_format} eq '>LL' ? 8 : 12),"
NSQ_SOURCE_LINE 00000121 "\t);"
NSQ_SOURCE_LINE 00000122 "\t$obj{index1_offset} = $header_length + $obj{meta_length};"
NSQ_SOURCE_LINE 00000123 "\t$obj{index2_offset} = $obj{index1_offset} + $obj{index_count} * $obj{index_length};"
NSQ_SOURCE_LINE 00000124 "\tbless \\%obj, $self"
NSQ_SOURCE_LINE 00000125 "}"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "1;"
NSQ_SOURCE_LINE 00000128 "__END__"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "=head1 NAME"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "Aard - Read aarddict dictionaries"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "  use Aard;"
NSQ_SOURCE_LINE 00000137 "  my $dict = Aard->new('something.aar');"
NSQ_SOURCE_LINE 00000138 "  printf \"This dictionary (volume %d of %d) has %d entries\\n\", $dict->volume, $dict->total_volumes, $dict->count;"
NSQ_SOURCE_LINE 00000139 "  printf \"The tenth entry's key: %s\\n\", $dict->key(9);"
NSQ_SOURCE_LINE 00000140 "  printf \"The tenth entry's value: %s\\n\", $dict->article(9);"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "Aard is a module for reading files in the Aard Dictionary format (.aar). A dictionary is an array of I<(key, article)> pairs, with some associated metadata."
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "=over"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "=item B<new>(I<filename>)"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "Creates a new Aard object for the given file."
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "=item B<fh>"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "Returns the open filehandle to the dictionary."
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "=item B<count>"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "Returns the number of entries in this dictionary."
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "=item B<key>(I<index>)"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "Returns the key of the I<index>th element. This method caches the keys."
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "=item B<article>(I<index>)"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "Returns the article of the I<index>th element. This method caches the articles."
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "=item B<uuid>"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "Returns the UUID of this dictionary as a binary string. This is a value shared by all volumes of the same dictionary."
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "=item B<uuid_string>"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "Returns the UUID of this dictionary as a human-readable string. This is a value shared by all volumes of the same dictionary."
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "=item B<volume>"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "Returns the volume number of this file."
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "=item B<total_volumes>"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "Returns the total number of volumes for this dictionary."
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "=item B<meta>"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "Returns the raw metadata as a hashref."
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "=item B<article_count>"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "Returns the number of unique articles in this volume (if B<article_count_is_volume_total> is true) or in this dictionary (otherwise)."
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "=item B<article_count_is_volume_total>"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "Returns true if B<article_count> means number of articles in this volume. This is always true since aardtools 0.9.0."
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "=item B<index_language>"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "Returns the dictionary's \"from\" language (two or three letter ISO code)"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "=item B<article_language>"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "Returns the dictionary's \"to\" language (two or three letter ISO code)"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "=item B<title>"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "Returns the dictionary title"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "=item B<version>"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "Returns the dictionary version"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "=item B<description>"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "Returns the dictionary description"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "=item B<copyright>"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "Returns the copyright notice"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "=item B<license>"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "Returns the full license text"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "=item B<source>"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "Returns the dictionary data source"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "=back"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "L<http://aarddict.org>, L<http://aarddict.org/aardtools/doc/aardformat.html>"
