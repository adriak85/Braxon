BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Set::CrossProduct;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 ""
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 "use warnings::register;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "use Carp qw(carp);"
NSQ_SOURCE_LINE 00000008 "use List::Util qw( reduce );"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "our $VERSION = '3.001';"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "=encoding utf8"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "=head1 NAME"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "Set::CrossProduct - work with the cross product of two or more sets"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "\t# unlabeled sets"
NSQ_SOURCE_LINE 00000021 "\tmy $cross = Set::CrossProduct->new( ARRAY_OF_ARRAYS );"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "\t# or labeled sets where hash keys are the set names"
NSQ_SOURCE_LINE 00000024 "\tmy $cross = Set::CrossProduct->new( HASH_OF_ARRAYS );"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "\t# get the number of tuples"
NSQ_SOURCE_LINE 00000027 "\tmy $number_of_tuples = $cross->cardinality;"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "\t# get the next tuple"
NSQ_SOURCE_LINE 00000030 "\tmy $tuple            = $cross->get;"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "\t# move back one position"
NSQ_SOURCE_LINE 00000033 "\tmy $tuple            = $cross->unget;"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "\t# get the next tuple without resetting"
NSQ_SOURCE_LINE 00000036 "\t# the cursor (peek at it)"
NSQ_SOURCE_LINE 00000037 "\tmy $next_tuple       = $cross->next;"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "\t# get the previous tuple without resetting"
NSQ_SOURCE_LINE 00000040 "\t# the cursor"
NSQ_SOURCE_LINE 00000041 "\tmy $last_tuple       = $cross->previous;"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "\t# get a particular tuple with affecting the cursor"
NSQ_SOURCE_LINE 00000044 "\t# this is zero based"
NSQ_SOURCE_LINE 00000045 "\tmy $nth_tuple        = $cross->nth($n);"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "\t# get a random tuple"
NSQ_SOURCE_LINE 00000048 "\tmy $random_tuple     = $cross->random;"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "\t# in list context returns a list of all tuples"
NSQ_SOURCE_LINE 00000051 "\tmy @tuples           = $cross->combinations;"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "\t# in scalar context returns an array reference to all tuples"
NSQ_SOURCE_LINE 00000054 "\tmy $tuples           = $cross->combinations;"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "Given sets S(1), S(2), ..., S(k), each of cardinality n(1), n(2), ..., n(k)"
NSQ_SOURCE_LINE 00000060 "respectively, the cross product of the sets is the set CP of ordered"
NSQ_SOURCE_LINE 00000061 "tuples such that { <s1, s2, ..., sk> | s1 => S(1), s2 => S(2), ...."
NSQ_SOURCE_LINE 00000062 "sk => S(k). }"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "If you do not like that description, how about:"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "Create a list by taking one item from each array, and do that for all"
NSQ_SOURCE_LINE 00000067 "possible ways that can be done, so that the first item in the list is"
NSQ_SOURCE_LINE 00000068 "always from the first array, the second item from the second array,"
NSQ_SOURCE_LINE 00000069 "and so on."
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "If you need to see it:"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "\tA => ( a, b, c )"
NSQ_SOURCE_LINE 00000074 "\tB => ( 1, 2, 3 )"
NSQ_SOURCE_LINE 00000075 "\tC => ( foo, bar )"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "The cross product of A and B and C, A x B x C, is the set of"
NSQ_SOURCE_LINE 00000078 "tuples shown:"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "\t( a, 1, foo )"
NSQ_SOURCE_LINE 00000081 "\t( a, 1, bar )"
NSQ_SOURCE_LINE 00000082 "\t( a, 2, foo )"
NSQ_SOURCE_LINE 00000083 "\t( a, 2, bar )"
NSQ_SOURCE_LINE 00000084 "\t( a, 3, foo )"
NSQ_SOURCE_LINE 00000085 "\t( a, 3, bar )"
NSQ_SOURCE_LINE 00000086 "\t( b, 1, foo )"
NSQ_SOURCE_LINE 00000087 "\t( b, 1, bar )"
NSQ_SOURCE_LINE 00000088 "\t( b, 2, foo )"
NSQ_SOURCE_LINE 00000089 "\t( b, 2, bar )"
NSQ_SOURCE_LINE 00000090 "\t( b, 3, foo )"
NSQ_SOURCE_LINE 00000091 "\t( b, 3, bar )"
NSQ_SOURCE_LINE 00000092 "\t( c, 1, foo )"
NSQ_SOURCE_LINE 00000093 "\t( c, 1, bar )"
NSQ_SOURCE_LINE 00000094 "\t( c, 2, foo )"
NSQ_SOURCE_LINE 00000095 "\t( c, 2, bar )"
NSQ_SOURCE_LINE 00000096 "\t( c, 3, foo )"
NSQ_SOURCE_LINE 00000097 "\t( c, 3, bar )"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "In code, it looks like this:"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "\tuse v5.26;"
NSQ_SOURCE_LINE 00000102 "\tuse Set::CrossProduct;"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "\tmy $cross = Set::CrossProduct->new( {"
NSQ_SOURCE_LINE 00000105 "\t\tA => [ qw( a b c ) ],"
NSQ_SOURCE_LINE 00000106 "\t\tB => [ qw( 1 2 3 ) ],"
NSQ_SOURCE_LINE 00000107 "\t\tC => [ qw( foo bar ) ],"
NSQ_SOURCE_LINE 00000108 "\t\t} );"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "\twhile( my $t = $cross->get ) {"
NSQ_SOURCE_LINE 00000111 "\t\tprintf \"( %s, %s, %s )\\n\", $t->@{qw(A B C)};"
NSQ_SOURCE_LINE 00000112 "\t\t}"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "If one of the sets happens to be empty, the cross product is empty"
NSQ_SOURCE_LINE 00000115 "too."
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "\tA => ( a, b, c )"
NSQ_SOURCE_LINE 00000118 "\tB => ( )"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "In this case, A x B is the empty set, so you'll get no tuples."
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "This module combines the arrays that you give to it to create this"
NSQ_SOURCE_LINE 00000123 "cross product, then allows you to access the elements of the"
NSQ_SOURCE_LINE 00000124 "cross product in sequence, or to get all of the elements at"
NSQ_SOURCE_LINE 00000125 "once. Be warned! The cardinality of the cross product, that is,"
NSQ_SOURCE_LINE 00000126 "the number of elements in the cross product, is the product of"
NSQ_SOURCE_LINE 00000127 "the cardinality of all of the sets."
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "The constructor, C<new>, gives you an iterator that you can"
NSQ_SOURCE_LINE 00000130 "use to move around the cross product. You can get the next"
NSQ_SOURCE_LINE 00000131 "tuple, peek at the previous or next tuples, or get a random"
NSQ_SOURCE_LINE 00000132 "tuple. If you were inclined, you could even get all of the"
NSQ_SOURCE_LINE 00000133 "tuples at once, but that might be a very large list. This module"
NSQ_SOURCE_LINE 00000134 "lets you handle the tuples one at a time."
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "I have found this module very useful for creating regression"
NSQ_SOURCE_LINE 00000137 "tests. I identify all of the boundary conditions for all of"
NSQ_SOURCE_LINE 00000138 "the code branches, then choose bracketing values for each of them."
NSQ_SOURCE_LINE 00000139 "With this module I take all of the values for each test and"
NSQ_SOURCE_LINE 00000140 "create every possibility in the hopes of exercising all of the"
NSQ_SOURCE_LINE 00000141 "code. Of course, your use is probably more interesting. :)"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "=head2 Class Methods"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "=over 4"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "=item * new( [ [ ... ], [ ... ] ])"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "=item * new( { LABEL => [ ... ], LABEL2 => [ ... ] } )"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "Given arrays that represent some sets, return a C<Set::CrossProduct>"
NSQ_SOURCE_LINE 00000152 "instance that represents the cross product of those sets. If you don't"
NSQ_SOURCE_LINE 00000153 "provide at least two sets, C<new> returns undef and will emit a warning"
NSQ_SOURCE_LINE 00000154 "if warnings are enabled."
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "You can create the sets in two different ways: unlabeled and labeled sets."
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "For unlabeled sets, you don't give them names. You rely on position. To"
NSQ_SOURCE_LINE 00000159 "create this, pass an array of arrays:"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "\tmy $unlabeled = Set::CrossProduct->new( ["
NSQ_SOURCE_LINE 00000162 "\t\t[ qw(1 2 3) ],"
NSQ_SOURCE_LINE 00000163 "\t\t[ qw(a b c) ],"
NSQ_SOURCE_LINE 00000164 "\t\t[ qw(! @ $) ],"
NSQ_SOURCE_LINE 00000165 "\t\t] );"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "When you call C<next>, you get an array ref where the positions in the"
NSQ_SOURCE_LINE 00000168 "tuple correspond to the position of the sets you gave C<new>:"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "\tmy $tuple = $unlabeled->next;   #  [ qw(1 a !) ]"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "For labeled sets, you want to give each set a name. When you ask for a tuple,"
NSQ_SOURCE_LINE 00000173 "you get a hash reference with the labels you choose:"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "\tmy $labeled = Set::CrossProduct->new( {"
NSQ_SOURCE_LINE 00000176 "\t\tnumber => [ qw(1 2 3) ],"
NSQ_SOURCE_LINE 00000177 "\t\tletter => [ qw(a b c) ],"
NSQ_SOURCE_LINE 00000178 "\t\tsymbol => [ qw(! @ $) ],"
NSQ_SOURCE_LINE 00000179 "\t\t} );"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "\tmy $tuple = $labeled->next;   #  { number => 1, letter => 'a', symbol => '!' }"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "=cut"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "# The iterator object is a hash with these keys"
NSQ_SOURCE_LINE 00000186 "#"
NSQ_SOURCE_LINE 00000187 "#\tarrays   - holds an array ref of array refs for each list"
NSQ_SOURCE_LINE 00000188 "#   labels   - the names of the set, if applicable"
NSQ_SOURCE_LINE 00000189 "#   labeled  - boolean to note if the sets are labeled or not"
NSQ_SOURCE_LINE 00000190 "#\tcounters - the current position in each array for generating"
NSQ_SOURCE_LINE 00000191 "#\t\tcombinations"
NSQ_SOURCE_LINE 00000192 "#\tlengths  - the precomputed lengths of the lists in arrays"
NSQ_SOURCE_LINE 00000193 "#\tdone     - true if the last combination has been fetched"
NSQ_SOURCE_LINE 00000194 "#\tprevious - the previous value of counters in case we want"
NSQ_SOURCE_LINE 00000195 "#\t\tto unget something and roll back the counters"
NSQ_SOURCE_LINE 00000196 "#\tungot    - true if we just ungot something--to prevent"
NSQ_SOURCE_LINE 00000197 "#\t\tattempts at multiple ungets which we don't support"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "sub new {"
NSQ_SOURCE_LINE 00000200 "\tmy( $class, $constructor_ref ) = @_;"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "\tmy $ref_type = ref $constructor_ref;"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "\tmy $self = bless {}, $class;"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "\tif( $ref_type eq ref {} ) {"
NSQ_SOURCE_LINE 00000207 "\t\t$self->{labeled} = 1;"
NSQ_SOURCE_LINE 00000208 "\t\t$self->{labels}  = [ sort keys %$constructor_ref ];"
NSQ_SOURCE_LINE 00000209 "\t\t$self->{arrays}  = [ @$constructor_ref{ sort keys %$constructor_ref } ];"
NSQ_SOURCE_LINE 00000210 "\t\t}"
NSQ_SOURCE_LINE 00000211 "\telsif( $ref_type eq ref [] ) {"
NSQ_SOURCE_LINE 00000212 "\t\t$self->{labeled} = 0;"
NSQ_SOURCE_LINE 00000213 "\t\t$self->{arrays}  = $constructor_ref;"
NSQ_SOURCE_LINE 00000214 "\t\t}"
NSQ_SOURCE_LINE 00000215 "\telse {"
NSQ_SOURCE_LINE 00000216 "\t\twarnings::warn( \"Set::Crossproduct->new takes an array or hash reference\" ) if warnings::enabled();"
NSQ_SOURCE_LINE 00000217 "\t\treturn;"
NSQ_SOURCE_LINE 00000218 "\t\t}"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "\tmy $array_ref = $self->{arrays};"
NSQ_SOURCE_LINE 00000221 "\tunless( @$array_ref > 1 ) {"
NSQ_SOURCE_LINE 00000222 "\t\twarnings::warn( \"You need at least two sets for Set::CrossProduct to work\" ) if warnings::enabled();"
NSQ_SOURCE_LINE 00000223 "\t\treturn;"
NSQ_SOURCE_LINE 00000224 "\t\t}"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "\tforeach my $array ( @$array_ref ) {"
NSQ_SOURCE_LINE 00000227 "\t\tunless( ref $array eq ref [] ) {"
NSQ_SOURCE_LINE 00000228 "\t\t\twarnings::warn( \"Each array element or hash value needs to be an array reference\" ) if warnings::enabled();"
NSQ_SOURCE_LINE 00000229 "\t\t\treturn;"
NSQ_SOURCE_LINE 00000230 "\t\t\t}"
NSQ_SOURCE_LINE 00000231 "\t\t}"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "\t$self->_init;"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "\tmy $len_last = $#{ $self->{lengths} };"
NSQ_SOURCE_LINE 00000236 "\tfor( my $i  = 0; $i < $#{ $self->{counters} }; $i++ ) {"
NSQ_SOURCE_LINE 00000237 "\t\tmy @lengths = map { $_+1 } @{ $self->{lengths} }[$i+1 .. $len_last];"
NSQ_SOURCE_LINE 00000238 "\t\t$self->{factors}[$i] += reduce { $a * $b } @lengths;"
NSQ_SOURCE_LINE 00000239 "\t\t}"
NSQ_SOURCE_LINE 00000240 "\tpush @{ $self->{factors} }, 1;"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "\treturn $self;"
NSQ_SOURCE_LINE 00000243 "\t}"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "=back"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "=head2 Instance methods"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "=over 4"
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "=cut"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "sub _factors { @{ $_[0]{factors} } }"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "sub _increment {"
NSQ_SOURCE_LINE 00000257 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "\t# print STDERR \"_increment: counters at start: @{$self->{counters}}\\n\";"
NSQ_SOURCE_LINE 00000260 "\t# print STDERR \"_increment: previous at start: @{$self->{previous}}\\n\";"
NSQ_SOURCE_LINE 00000261 "\t$self->{previous} = [ @{$self->{counters}} ]; # need a deep copy"
NSQ_SOURCE_LINE 00000262 "\t# print STDERR \"_increment: previous after: @{$self->{previous}}\\n\";"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "\tmy $tail = $#{ $self->{counters} };"
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "\tCOUNTERS: {"
NSQ_SOURCE_LINE 00000267 "\t\tif( $self->{counters}[$tail] == $self->{lengths}[$tail] ) {"
NSQ_SOURCE_LINE 00000268 "\t\t\t$self->{counters}[$tail] = 0;"
NSQ_SOURCE_LINE 00000269 "\t\t\t$tail--;"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "\t\t\tif( $tail == 0"
NSQ_SOURCE_LINE 00000272 "\t\t\t\tand $self->{counters}[$tail] == $self->{lengths}[$tail] ) {"
NSQ_SOURCE_LINE 00000273 "\t\t\t\t$self->done(1);"
NSQ_SOURCE_LINE 00000274 "\t\t\t\treturn;"
NSQ_SOURCE_LINE 00000275 "\t\t\t\t}"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "\t\t\tredo COUNTERS;"
NSQ_SOURCE_LINE 00000278 "\t\t\t}"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "\t\t$self->{counters}[$tail]++;"
NSQ_SOURCE_LINE 00000281 "\t\t}"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "\treturn 1;"
NSQ_SOURCE_LINE 00000284 "\t}"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "sub _init {"
NSQ_SOURCE_LINE 00000287 "\tmy( $self ) = @_;"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "\t$self->{counters} = [ map { 0 } @{ $self->{arrays} } ];"
NSQ_SOURCE_LINE 00000290 "    $self->{lengths}  = [ map { $#{$_} } @{ $self->{arrays} } ];"
NSQ_SOURCE_LINE 00000291 "\t$self->{ungot}    = 1;"
NSQ_SOURCE_LINE 00000292 "\t$self->{done}     = grep( $_ == -1, @{ $self->{lengths} } );"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "\t# stolen from Set::CartesianProduct::Lazy by Stephen R. Scaffidi"
NSQ_SOURCE_LINE 00000295 "\t# https://github.com/hercynium/Set-CartesianProduct-Lazy"
NSQ_SOURCE_LINE 00000296 "\t$self->{info} = ["
NSQ_SOURCE_LINE 00000297 "\t\tmap {"
NSQ_SOURCE_LINE 00000298 "\t\t\t[ $_, (scalar @{${ $self->{arrays} }[$_]}), reduce { $a * @$b } 1, @{ $self->{arrays} }[$_ + 1 .. $#{ $self->{arrays} }] ];"
NSQ_SOURCE_LINE 00000299 "\t\t\t} 0 .. $#{ $self->{arrays} }"
NSQ_SOURCE_LINE 00000300 "\t\t];"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "\treturn $self;"
NSQ_SOURCE_LINE 00000303 "\t}"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "sub _label_tuple {"
NSQ_SOURCE_LINE 00000306 "\tmy( $self, $tuple ) = @_;"
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "\tunless( $self->{labeled} ) {"
NSQ_SOURCE_LINE 00000309 "\t\treturn wantarray ? @$tuple : $tuple;"
NSQ_SOURCE_LINE 00000310 "\t\t}"
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "\tmy %hash;"
NSQ_SOURCE_LINE 00000313 "\t@hash{ @{ $self->{labels} } } = @$tuple;"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "\treturn wantarray ? %hash : \\%hash;"
NSQ_SOURCE_LINE 00000316 "\t}"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "=item * cardinality()"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "Return the carnality of the cross product.  This is the number"
NSQ_SOURCE_LINE 00000321 "of tuples, which is the product of the number of elements in"
NSQ_SOURCE_LINE 00000322 "each set."
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "Strict set theorists will realize that this isn't necessarily"
NSQ_SOURCE_LINE 00000325 "the real cardinality since some tuples may be identical, making"
NSQ_SOURCE_LINE 00000326 "the actual cardinality smaller."
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "=cut"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "sub cardinality {"
NSQ_SOURCE_LINE 00000331 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000332 ""
NSQ_SOURCE_LINE 00000333 "\tmy $product = 1;"
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "\tforeach my $length ( @{ $self->{lengths} } ) {"
NSQ_SOURCE_LINE 00000336 "\t\t$product *= ( $length + 1 );"
NSQ_SOURCE_LINE 00000337 "\t\t}"
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "\treturn $product;"
NSQ_SOURCE_LINE 00000340 "\t}"
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "=item * combinations()"
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "In scalar context, returns a reference to an array that contains all"
NSQ_SOURCE_LINE 00000345 "of the tuples of the cross product. In list context, it returns the"
NSQ_SOURCE_LINE 00000346 "list of all tuples. You should probably always use this in scalar"
NSQ_SOURCE_LINE 00000347 "context except for very low cardinalities to avoid huge return values."
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "This can be quite large, so you might want to check the cardinality"
NSQ_SOURCE_LINE 00000350 "first. The array elements are the return values for C<get>."
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "This works by exhausting the iterator. After calling this, there will"
NSQ_SOURCE_LINE 00000353 "be no more tuples to C<get>. You can use C<reset_cursor> to start over."
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 "=cut"
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "sub combinations {"
NSQ_SOURCE_LINE 00000358 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 "\tmy @array = ();"
NSQ_SOURCE_LINE 00000361 ""
NSQ_SOURCE_LINE 00000362 "\twhile( my $ref = $self->get ) {"
NSQ_SOURCE_LINE 00000363 "\t\tpush @array, $ref;"
NSQ_SOURCE_LINE 00000364 "\t\t}"
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "\tif( wantarray ) { return  @array }"
NSQ_SOURCE_LINE 00000367 "\telse            { return \\@array }"
NSQ_SOURCE_LINE 00000368 "\t}"
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "=item * done()"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "Without an argument, C<done> returns true if there are no more"
NSQ_SOURCE_LINE 00000373 "combinations to fetch with C<get> and returns false otherwise."
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "With an argument, it acts as if there are no more arguments to fetch, no"
NSQ_SOURCE_LINE 00000376 "matter the value. If you want to start over, use C<reset_cursor> instead."
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 "=cut"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "sub done { $_[0]->{done} = 1 if @_ > 1; $_[0]->{done} }"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "=item * get()"
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "Return the next tuple from the cross product, and move the position"
NSQ_SOURCE_LINE 00000385 "to the tuple after it. If you have already gotten the last tuple in"
NSQ_SOURCE_LINE 00000386 "the cross product, then C<get> returns undef in scalar context and"
NSQ_SOURCE_LINE 00000387 "the empty list in list context."
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "What you get back depends on how you made the constructor."
NSQ_SOURCE_LINE 00000390 ""
NSQ_SOURCE_LINE 00000391 "For unlabeled sets, you get back an array reference in scalar context"
NSQ_SOURCE_LINE 00000392 "or a list in list context:"
NSQ_SOURCE_LINE 00000393 ""
NSQ_SOURCE_LINE 00000394 "For labeled sets, you get back a hash reference in scalar context or a"
NSQ_SOURCE_LINE 00000395 "list of key-value pairs in list context."
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "=cut"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "sub get {"
NSQ_SOURCE_LINE 00000400 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000401 "\treturn if $self->done;"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "\tmy $next_ref = $self->next;"
NSQ_SOURCE_LINE 00000404 "\t$self->_increment;"
NSQ_SOURCE_LINE 00000405 "\t$self->{ungot} = 0;"
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "\t$next_ref;"
NSQ_SOURCE_LINE 00000408 "\t}"
NSQ_SOURCE_LINE 00000409 ""
NSQ_SOURCE_LINE 00000410 "=item * jump_to(N)"
NSQ_SOURCE_LINE 00000411 ""
NSQ_SOURCE_LINE 00000412 "(new in 3.0)"
NSQ_SOURCE_LINE 00000413 ""
NSQ_SOURCE_LINE 00000414 "Moves the cursor such that the next call to C<get> will fetch tuple"
NSQ_SOURCE_LINE 00000415 "C<N>, which should be a positive whole number less than the cardinality."
NSQ_SOURCE_LINE 00000416 "Remember that everything is zero-based."
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 "Invalid arguments return the empty list and warn."
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "This works by doing the math to reset the cursor rather than iterating"
NSQ_SOURCE_LINE 00000421 "through the cursor to get to the right position. You can jump to any"
NSQ_SOURCE_LINE 00000422 "position, including ones before the current cursor. After calling"
NSQ_SOURCE_LINE 00000423 "C<jump_to($n)>, C<$position> should return the value of C<$n>."
NSQ_SOURCE_LINE 00000424 ""
NSQ_SOURCE_LINE 00000425 "This returns the object itself to allow you to chain methods. In previous"
NSQ_SOURCE_LINE 00000426 "versions this returned C<1> (true). It still returns true, but just"
NSQ_SOURCE_LINE 00000427 "a different value for it."
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 "=cut"
NSQ_SOURCE_LINE 00000430 ""
NSQ_SOURCE_LINE 00000431 "sub jump_to {"
NSQ_SOURCE_LINE 00000432 "\tmy($self, $n) = @_;"
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 "\tmy $message = do {"
NSQ_SOURCE_LINE 00000435 "\t\tmy $guidance = 'It should be a positive whole number up to one less than the cardinality.';"
NSQ_SOURCE_LINE 00000436 "\t\tif( @_ > 2 ) {"
NSQ_SOURCE_LINE 00000437 "\t\t\t\"too many arguments for jump_to(). $guidance\";"
NSQ_SOURCE_LINE 00000438 "\t\t\t}"
NSQ_SOURCE_LINE 00000439 "\t\telsif( ! defined $n ) {"
NSQ_SOURCE_LINE 00000440 "\t\t\t\"no or undefined argument for jump_to(). $guidance\";"
NSQ_SOURCE_LINE 00000441 "\t\t\t}"
NSQ_SOURCE_LINE 00000442 "\t\telsif( $n >= $self->cardinality ) {"
NSQ_SOURCE_LINE 00000443 "\t\t\tsprintf \"argument ($n) for jump_to() is too large for cardinality (%d). $guidance\","
NSQ_SOURCE_LINE 00000444 "\t\t\t\t$self->cardinality;"
NSQ_SOURCE_LINE 00000445 "\t\t\t}"
NSQ_SOURCE_LINE 00000446 "\t\telsif( $n =~ m/\\D/ ) {"
NSQ_SOURCE_LINE 00000447 "\t\t\t\"argument ($n) for jump_to() is inappropriate. $guidance\";"
NSQ_SOURCE_LINE 00000448 "\t\t\t}"
NSQ_SOURCE_LINE 00000449 "\t\t};"
NSQ_SOURCE_LINE 00000450 "\tif( $message ) {"
NSQ_SOURCE_LINE 00000451 "\t\tcarp $message;"
NSQ_SOURCE_LINE 00000452 "\t\treturn;"
NSQ_SOURCE_LINE 00000453 "\t\t}"
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 "\tmy $max = $self->cardinality;"
NSQ_SOURCE_LINE 00000456 "\tmy @positions = ();"
NSQ_SOURCE_LINE 00000457 "\tmy $working_n = $n;"
NSQ_SOURCE_LINE 00000458 "\tforeach my $factor ( $self->_factors ) {"
NSQ_SOURCE_LINE 00000459 "\t\tif( $factor > $working_n ) {"
NSQ_SOURCE_LINE 00000460 "\t\t\tpush @positions, 0;"
NSQ_SOURCE_LINE 00000461 "\t\t\tnext;"
NSQ_SOURCE_LINE 00000462 "\t\t\t}"
NSQ_SOURCE_LINE 00000463 ""
NSQ_SOURCE_LINE 00000464 "\t\tmy $int = int( $working_n / $factor );"
NSQ_SOURCE_LINE 00000465 "\t\t$working_n -= $int * $factor;"
NSQ_SOURCE_LINE 00000466 "\t\tpush @positions, $int;"
NSQ_SOURCE_LINE 00000467 "\t\t}"
NSQ_SOURCE_LINE 00000468 ""
NSQ_SOURCE_LINE 00000469 "\t$self->{counters} = [@positions];"
NSQ_SOURCE_LINE 00000470 ""
NSQ_SOURCE_LINE 00000471 "\t$self;"
NSQ_SOURCE_LINE 00000472 "\t}"
NSQ_SOURCE_LINE 00000473 ""
NSQ_SOURCE_LINE 00000474 "=item * labeled()"
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 "Return true if the sets are labeled (i.e. you made the object from a"
NSQ_SOURCE_LINE 00000477 "hash ref). Returns false otherwise."
NSQ_SOURCE_LINE 00000478 ""
NSQ_SOURCE_LINE 00000479 "You might use this to figure out what sort of value C<get> will"
NSQ_SOURCE_LINE 00000480 "return. When the tuple is labeled, you get hash refs. Otherwise, you"
NSQ_SOURCE_LINE 00000481 "get array refs."
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 "=cut"
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "sub labeled { !! $_[0]->{labeled} }"
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "=item * next()"
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 "Like C<get>, but does not move the cursor. This way you can look at"
NSQ_SOURCE_LINE 00000490 "the next tuple without affecting your position in the cross product."
NSQ_SOURCE_LINE 00000491 ""
NSQ_SOURCE_LINE 00000492 "Since this does not move the cursor, repeated calls to C<next> will"
NSQ_SOURCE_LINE 00000493 "return the same tuple."
NSQ_SOURCE_LINE 00000494 ""
NSQ_SOURCE_LINE 00000495 "=cut"
NSQ_SOURCE_LINE 00000496 ""
NSQ_SOURCE_LINE 00000497 "sub next {"
NSQ_SOURCE_LINE 00000498 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000499 ""
NSQ_SOURCE_LINE 00000500 "\t# At end position returns undef"
NSQ_SOURCE_LINE 00000501 "\treturn unless defined $self->position;"
NSQ_SOURCE_LINE 00000502 ""
NSQ_SOURCE_LINE 00000503 "\t$self->nth( $self->position );"
NSQ_SOURCE_LINE 00000504 "\t}"
NSQ_SOURCE_LINE 00000505 ""
NSQ_SOURCE_LINE 00000506 "=item * nth(n)"
NSQ_SOURCE_LINE 00000507 ""
NSQ_SOURCE_LINE 00000508 "(new in 3.0)"
NSQ_SOURCE_LINE 00000509 ""
NSQ_SOURCE_LINE 00000510 "Get the tuple at position C<n> in the set (zero based). This does not"
NSQ_SOURCE_LINE 00000511 "advance or affect the cursor. C<n> must be a positive whole number"
NSQ_SOURCE_LINE 00000512 "less than the cardinality. Anything else warns and returns undef."
NSQ_SOURCE_LINE 00000513 ""
NSQ_SOURCE_LINE 00000514 "This was largely stolen from L<Set::CartesianProduct::Lazy> by"
NSQ_SOURCE_LINE 00000515 "Stephen R. Scaffidi."
NSQ_SOURCE_LINE 00000516 ""
NSQ_SOURCE_LINE 00000517 "=cut"
NSQ_SOURCE_LINE 00000518 ""
NSQ_SOURCE_LINE 00000519 "# stolen from Set::CartesianProduct::Lazy by Stephen R. Scaffidi"
NSQ_SOURCE_LINE 00000520 "# https://github.com/hercynium/Set-CartesianProduct-Lazy"
NSQ_SOURCE_LINE 00000521 "sub nth {"
NSQ_SOURCE_LINE 00000522 "\tmy($self, $n) = @_;"
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 "\tmy $message = do {"
NSQ_SOURCE_LINE 00000525 "\t\tmy $guidance = 'It should be a positive whole number up to one less than the cardinality.';"
NSQ_SOURCE_LINE 00000526 "\t\tif( @_ > 2 ) {"
NSQ_SOURCE_LINE 00000527 "\t\t\t\"too many arguments for nth(). $guidance\";"
NSQ_SOURCE_LINE 00000528 "\t\t\t}"
NSQ_SOURCE_LINE 00000529 "\t\telsif( ! defined $n ) {"
NSQ_SOURCE_LINE 00000530 "\t\t\t\"no or undefined argument for nth(). $guidance\";"
NSQ_SOURCE_LINE 00000531 "\t\t\t}"
NSQ_SOURCE_LINE 00000532 "\t\telsif( $n >= $self->cardinality ) {"
NSQ_SOURCE_LINE 00000533 "\t\t\tsprintf \"argument ($n) for nth() is too large for cardinality (%d). $guidance\","
NSQ_SOURCE_LINE 00000534 "\t\t\t\t$self->cardinality;"
NSQ_SOURCE_LINE 00000535 "\t\t\t}"
NSQ_SOURCE_LINE 00000536 "\t\telsif( $n =~ m/\\D/ ) {"
NSQ_SOURCE_LINE 00000537 "\t\t\t\"argument ($n) for nth() is inappropriate. $guidance\";"
NSQ_SOURCE_LINE 00000538 "\t\t\t}"
NSQ_SOURCE_LINE 00000539 "\t\t};"
NSQ_SOURCE_LINE 00000540 "\tif( $message ) {"
NSQ_SOURCE_LINE 00000541 "\t\tcarp $message;"
NSQ_SOURCE_LINE 00000542 "\t\treturn;"
NSQ_SOURCE_LINE 00000543 "\t\t}"
NSQ_SOURCE_LINE 00000544 ""
NSQ_SOURCE_LINE 00000545 "\tmy @tuple = map {"
NSQ_SOURCE_LINE 00000546 "\t\tmy ($set_num, $set_size, $factor) = @$_;"
NSQ_SOURCE_LINE 00000547 "\t\t${ $self->{arrays} }[ $set_num ][ int( $n / $factor ) % $set_size ];"
NSQ_SOURCE_LINE 00000548 "\t\t} @{ $self->{info} };"
NSQ_SOURCE_LINE 00000549 ""
NSQ_SOURCE_LINE 00000550 "\tmy $tuple = $self->_label_tuple(\\@tuple);"
NSQ_SOURCE_LINE 00000551 ""
NSQ_SOURCE_LINE 00000552 "\treturn wantarray ? @$tuple : $tuple;"
NSQ_SOURCE_LINE 00000553 "\t}"
NSQ_SOURCE_LINE 00000554 ""
NSQ_SOURCE_LINE 00000555 "=item * position()"
NSQ_SOURCE_LINE 00000556 ""
NSQ_SOURCE_LINE 00000557 "(new in 3.0)"
NSQ_SOURCE_LINE 00000558 ""
NSQ_SOURCE_LINE 00000559 "Returns the zero-based position of the cursor. This is the same as the"
NSQ_SOURCE_LINE 00000560 "position for the next tuple that C<get> will fetch. Before you fetch"
NSQ_SOURCE_LINE 00000561 "any tuple, the position is 0. After you have fetched all the tuples,"
NSQ_SOURCE_LINE 00000562 "C<position> returns undef."
NSQ_SOURCE_LINE 00000563 ""
NSQ_SOURCE_LINE 00000564 "=cut"
NSQ_SOURCE_LINE 00000565 ""
NSQ_SOURCE_LINE 00000566 "sub position {"
NSQ_SOURCE_LINE 00000567 "\tmy( $self ) = $_[0];"
NSQ_SOURCE_LINE 00000568 "\treturn if $self->{done};"
NSQ_SOURCE_LINE 00000569 ""
NSQ_SOURCE_LINE 00000570 "\tmy $len_last = $#{ $self->{lengths} };"
NSQ_SOURCE_LINE 00000571 ""
NSQ_SOURCE_LINE 00000572 "\tmy $sum = 0;"
NSQ_SOURCE_LINE 00000573 "\tfor( my $i  = 0; $i <= $#{ $self->{counters} }; $i++ ) {"
NSQ_SOURCE_LINE 00000574 "\t\t$sum += $self->{counters}[$i] * $self->{factors}[$i];"
NSQ_SOURCE_LINE 00000575 "\t\t}"
NSQ_SOURCE_LINE 00000576 ""
NSQ_SOURCE_LINE 00000577 "\treturn $sum;"
NSQ_SOURCE_LINE 00000578 "\t}"
NSQ_SOURCE_LINE 00000579 ""
NSQ_SOURCE_LINE 00000580 "=item * previous()"
NSQ_SOURCE_LINE 00000581 ""
NSQ_SOURCE_LINE 00000582 "Like C<get>, but does not move the cursor.  This way you can look at"
NSQ_SOURCE_LINE 00000583 "the previous tuple without affecting your position in the cross product."
NSQ_SOURCE_LINE 00000584 ""
NSQ_SOURCE_LINE 00000585 "=cut"
NSQ_SOURCE_LINE 00000586 ""
NSQ_SOURCE_LINE 00000587 "sub previous {"
NSQ_SOURCE_LINE 00000588 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000589 ""
NSQ_SOURCE_LINE 00000590 "\tif( $self->position == 0 ) {"
NSQ_SOURCE_LINE 00000591 "\t\tcarp \"Can't call previous at the first tuple of the cross product\";"
NSQ_SOURCE_LINE 00000592 "\t\treturn;"
NSQ_SOURCE_LINE 00000593 "\t\t}"
NSQ_SOURCE_LINE 00000594 ""
NSQ_SOURCE_LINE 00000595 "\t$self->nth( $self->done ? $self->cardinality - 1 : $self->position - 1 );"
NSQ_SOURCE_LINE 00000596 "\t}"
NSQ_SOURCE_LINE 00000597 ""
NSQ_SOURCE_LINE 00000598 "=item * random()"
NSQ_SOURCE_LINE 00000599 ""
NSQ_SOURCE_LINE 00000600 "Return a random tuple from the cross product. The return value is the"
NSQ_SOURCE_LINE 00000601 "same as C<get>."
NSQ_SOURCE_LINE 00000602 ""
NSQ_SOURCE_LINE 00000603 "=cut"
NSQ_SOURCE_LINE 00000604 ""
NSQ_SOURCE_LINE 00000605 "sub random {"
NSQ_SOURCE_LINE 00000606 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000607 ""
NSQ_SOURCE_LINE 00000608 "\tmy $rand_ref = $self->_find_ref('rand');"
NSQ_SOURCE_LINE 00000609 ""
NSQ_SOURCE_LINE 00000610 "\tif( wantarray ) { return (ref $rand_ref eq ref []) ? @$rand_ref : %$rand_ref }"
NSQ_SOURCE_LINE 00000611 "\telse            { return $rand_ref }"
NSQ_SOURCE_LINE 00000612 "\t}"
NSQ_SOURCE_LINE 00000613 ""
NSQ_SOURCE_LINE 00000614 "=item * reset_cursor()"
NSQ_SOURCE_LINE 00000615 ""
NSQ_SOURCE_LINE 00000616 "Return the cursor to the first element of the cross product. The next"
NSQ_SOURCE_LINE 00000617 "call to C<get> will fetch the first tuple."
NSQ_SOURCE_LINE 00000618 ""
NSQ_SOURCE_LINE 00000619 "This returns the object itself to allow you to chain methods. In previous"
NSQ_SOURCE_LINE 00000620 "versions this returned C<1> (true). It still returns true, but just"
NSQ_SOURCE_LINE 00000621 "a different value for it."
NSQ_SOURCE_LINE 00000622 ""
NSQ_SOURCE_LINE 00000623 "=cut"
NSQ_SOURCE_LINE 00000624 ""
NSQ_SOURCE_LINE 00000625 "sub reset_cursor {"
NSQ_SOURCE_LINE 00000626 "\tmy( $self, $position ) = @_;"
NSQ_SOURCE_LINE 00000627 "\t$position = 0 unless defined $position;"
NSQ_SOURCE_LINE 00000628 ""
NSQ_SOURCE_LINE 00000629 "\t$self->_init;"
NSQ_SOURCE_LINE 00000630 ""
NSQ_SOURCE_LINE 00000631 "\treturn $self;"
NSQ_SOURCE_LINE 00000632 "\t}"
NSQ_SOURCE_LINE 00000633 ""
NSQ_SOURCE_LINE 00000634 "=item * unget()"
NSQ_SOURCE_LINE 00000635 ""
NSQ_SOURCE_LINE 00000636 "Pretend we did not get the tuple we just got.  The next time we get a"
NSQ_SOURCE_LINE 00000637 "tuple, we will get the same thing.  You can use this to peek at the"
NSQ_SOURCE_LINE 00000638 "next value and put it back if you do not like it."
NSQ_SOURCE_LINE 00000639 ""
NSQ_SOURCE_LINE 00000640 "You can only do this for the previous tuple.  C<unget> does not do"
NSQ_SOURCE_LINE 00000641 "multiple levels of unget."
NSQ_SOURCE_LINE 00000642 ""
NSQ_SOURCE_LINE 00000643 "This returns the object itself to allow you to chain methods. In previous"
NSQ_SOURCE_LINE 00000644 "versions this returned C<1> (true). It still returns true, but just"
NSQ_SOURCE_LINE 00000645 "a different value for it."
NSQ_SOURCE_LINE 00000646 ""
NSQ_SOURCE_LINE 00000647 "=cut"
NSQ_SOURCE_LINE 00000648 ""
NSQ_SOURCE_LINE 00000649 "sub unget {"
NSQ_SOURCE_LINE 00000650 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000651 ""
NSQ_SOURCE_LINE 00000652 "\treturn if $self->{ungot};"
NSQ_SOURCE_LINE 00000653 ""
NSQ_SOURCE_LINE 00000654 "\t$self->{counters} = $self->{previous};"
NSQ_SOURCE_LINE 00000655 ""
NSQ_SOURCE_LINE 00000656 "\t$self->{ungot} = 1;"
NSQ_SOURCE_LINE 00000657 ""
NSQ_SOURCE_LINE 00000658 "\t# if we just got the last element, we had set the done flag,"
NSQ_SOURCE_LINE 00000659 "\t# so unset it."
NSQ_SOURCE_LINE 00000660 "\t$self->{done}  = 0;"
NSQ_SOURCE_LINE 00000661 ""
NSQ_SOURCE_LINE 00000662 "\treturn $self;"
NSQ_SOURCE_LINE 00000663 "\t}"
NSQ_SOURCE_LINE 00000664 ""
NSQ_SOURCE_LINE 00000665 "=back"
NSQ_SOURCE_LINE 00000666 ""
NSQ_SOURCE_LINE 00000667 "=head1 TO DO"
NSQ_SOURCE_LINE 00000668 ""
NSQ_SOURCE_LINE 00000669 "* I need to fix the cardinality method. it returns the total number"
NSQ_SOURCE_LINE 00000670 "of possibly non-unique tuples."
NSQ_SOURCE_LINE 00000671 ""
NSQ_SOURCE_LINE 00000672 "* I'd also like to do something like this:"
NSQ_SOURCE_LINE 00000673 ""
NSQ_SOURCE_LINE 00000674 "\tuse Set::CrossProduct qw(setmap);"
NSQ_SOURCE_LINE 00000675 ""
NSQ_SOURCE_LINE 00000676 "\t# use setmap with an existing Set::CrossProduct object"
NSQ_SOURCE_LINE 00000677 "\tmy @array = setmap { ... code ... } $iterator;"
NSQ_SOURCE_LINE 00000678 ""
NSQ_SOURCE_LINE 00000679 "\t# use setmap with unnamed arrays"
NSQ_SOURCE_LINE 00000680 "\tmy @array = setmap { [ $_[0], $_[1] ] }"
NSQ_SOURCE_LINE 00000681 "\t\tkey => ARRAYREF, key2 => ARRAYREF;"
NSQ_SOURCE_LINE 00000682 ""
NSQ_SOURCE_LINE 00000683 "\t# use setmap with named arrays"
NSQ_SOURCE_LINE 00000684 "\tmy @array = setmap { [ $key1, $key2 ] }"
NSQ_SOURCE_LINE 00000685 "\t\tkey => ARRAYREF, key2 => ARRAYREF;"
NSQ_SOURCE_LINE 00000686 ""
NSQ_SOURCE_LINE 00000687 "\t# call apply() with a coderef. If the object had labels"
NSQ_SOURCE_LINE 00000688 "\t# (constructed with a hash), you can use those labels in"
NSQ_SOURCE_LINE 00000689 "\t# the coderef."
NSQ_SOURCE_LINE 00000690 "\t$set->apply( CODEREF );"
NSQ_SOURCE_LINE 00000691 ""
NSQ_SOURCE_LINE 00000692 "=head1 ISSUES"
NSQ_SOURCE_LINE 00000693 ""
NSQ_SOURCE_LINE 00000694 "Report an problems to L<http://github.com/briandfoy/set-crossproduct/issues>."
NSQ_SOURCE_LINE 00000695 ""
