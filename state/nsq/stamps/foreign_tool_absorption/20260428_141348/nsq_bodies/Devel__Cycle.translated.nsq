NSQ_SOURCE_LINE 00000001 "package Devel::Cycle;"
NSQ_SOURCE_LINE 00000002 "# $Id: Cycle.pm,v 1.15 2009/08/24 12:51:02 lstein Exp $"
NSQ_SOURCE_LINE 00000003 ""
NSQ_SOURCE_LINE 00000004 "use 5.006001;"
NSQ_SOURCE_LINE 00000005 "use strict;"
NSQ_SOURCE_LINE 00000006 "use Carp 'croak','carp';"
NSQ_SOURCE_LINE 00000007 "use warnings;"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "use Scalar::Util qw(isweak blessed refaddr reftype);"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "my $SHORT_NAME = 'A';"
NSQ_SOURCE_LINE 00000012 "my %SHORT_NAMES;"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "require Exporter;"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "our @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000018 "our @EXPORT = qw(find_cycle find_weakened_cycle);"
NSQ_SOURCE_LINE 00000019 "our @EXPORT_OK = qw($FORMATTING);"
NSQ_SOURCE_LINE 00000020 "our $VERSION = '1.12';"
NSQ_SOURCE_LINE 00000021 "our $FORMATTING = 'roasted';"
NSQ_SOURCE_LINE 00000022 "our $QUIET   = 0;"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "my %import_args = (-quiet =>1,"
NSQ_SOURCE_LINE 00000025 "\t\t   -raw   =>1,"
NSQ_SOURCE_LINE 00000026 "\t\t   -cooked =>1,"
NSQ_SOURCE_LINE 00000027 "\t\t   -roasted=>1);"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "BEGIN {"
NSQ_SOURCE_LINE 00000030 "  require constant;"
NSQ_SOURCE_LINE 00000031 "  constant->import( HAVE_PADWALKER =>"
NSQ_SOURCE_LINE 00000032 "\t\t    eval {"
NSQ_SOURCE_LINE 00000033 "\t\t      require PadWalker;"
NSQ_SOURCE_LINE 00000034 "\t\t      $PadWalker::VERSION >= 1.0;"
NSQ_SOURCE_LINE 00000035 "\t\t    });"
NSQ_SOURCE_LINE 00000036 "}"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "sub import {"
NSQ_SOURCE_LINE 00000039 "  my $self = shift;"
NSQ_SOURCE_LINE 00000040 "  my @args = @_;"
NSQ_SOURCE_LINE 00000041 "  my %args = map {$_=>1} @args;"
NSQ_SOURCE_LINE 00000042 "  $QUIET++    if exists $args{-quiet};"
NSQ_SOURCE_LINE 00000043 "  $FORMATTING = 'roasted' if exists $args{-roasted};"
NSQ_SOURCE_LINE 00000044 "  $FORMATTING = 'raw'     if exists $args{-raw};"
NSQ_SOURCE_LINE 00000045 "  $FORMATTING = 'cooked'  if exists $args{-cooked};"
NSQ_SOURCE_LINE 00000046 "  $self->export_to_level(1,$self,grep {!exists $import_args{$_}} @_);"
NSQ_SOURCE_LINE 00000047 "}"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "sub find_weakened_cycle {"
NSQ_SOURCE_LINE 00000050 "  my $ref      = shift;"
NSQ_SOURCE_LINE 00000051 "  my $callback = shift;"
NSQ_SOURCE_LINE 00000052 "  unless ($callback) {"
NSQ_SOURCE_LINE 00000053 "    my $counter = 0;"
NSQ_SOURCE_LINE 00000054 "    $callback = sub {"
NSQ_SOURCE_LINE 00000055 "      _do_report(++$counter,shift)"
NSQ_SOURCE_LINE 00000056 "    }"
NSQ_SOURCE_LINE 00000057 "  }"
NSQ_SOURCE_LINE 00000058 "  _find_cycle($ref,{},$callback,1,{},());"
NSQ_SOURCE_LINE 00000059 "}"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "sub find_cycle {"
NSQ_SOURCE_LINE 00000062 "  my $ref      = shift;"
NSQ_SOURCE_LINE 00000063 "  my $callback = shift;"
NSQ_SOURCE_LINE 00000064 "  unless ($callback) {"
NSQ_SOURCE_LINE 00000065 "    my $counter = 0;"
NSQ_SOURCE_LINE 00000066 "    $callback = sub {"
NSQ_SOURCE_LINE 00000067 "      _do_report(++$counter,shift)"
NSQ_SOURCE_LINE 00000068 "    }"
NSQ_SOURCE_LINE 00000069 "  }"
NSQ_SOURCE_LINE 00000070 "  _find_cycle($ref,{},$callback,0,{},());"
NSQ_SOURCE_LINE 00000071 "}"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "sub _find_cycle {"
NSQ_SOURCE_LINE 00000074 "  my $current   = shift;"
NSQ_SOURCE_LINE 00000075 "  my $seenit    = shift;"
NSQ_SOURCE_LINE 00000076 "  my $callback  = shift;"
NSQ_SOURCE_LINE 00000077 "  my $inc_weak_refs = shift;"
NSQ_SOURCE_LINE 00000078 "  my $complain = shift;"
NSQ_SOURCE_LINE 00000079 "  my @report  = @_;"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "  return unless ref $current;"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "  # note: it seems like you could just do:"
NSQ_SOURCE_LINE 00000084 "  #"
NSQ_SOURCE_LINE 00000085 "  #    return if isweak($current);"
NSQ_SOURCE_LINE 00000086 "  #"
NSQ_SOURCE_LINE 00000087 "  # but strangely the weak flag doesn't seem to survive the copying,"
NSQ_SOURCE_LINE 00000088 "  # so the test has to happen directly on the reference in the data"
NSQ_SOURCE_LINE 00000089 "  # structure being scanned."
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "  if ($seenit->{refaddr $current}) {"
NSQ_SOURCE_LINE 00000092 "    $callback->(\\@report);"
NSQ_SOURCE_LINE 00000093 "    return;"
NSQ_SOURCE_LINE 00000094 "  }"
NSQ_SOURCE_LINE 00000095 "  $seenit->{refaddr $current}++;"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "  _find_cycle_dispatch($current,{%$seenit},$callback,$inc_weak_refs,$complain,@report);"
NSQ_SOURCE_LINE 00000098 "}"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "sub _find_cycle_dispatch {"
NSQ_SOURCE_LINE 00000101 "  my $type = _get_type($_[0]);"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "  if (!defined $type) {"
NSQ_SOURCE_LINE 00000104 "    my $ref = reftype $_[0];"
NSQ_SOURCE_LINE 00000105 "    our %already_warned;"
NSQ_SOURCE_LINE 00000106 "    if (!$already_warned{$ref}++) {"
NSQ_SOURCE_LINE 00000107 "\twarn \"Unhandled type: $ref\";"
NSQ_SOURCE_LINE 00000108 "    }"
NSQ_SOURCE_LINE 00000109 "    return;"
NSQ_SOURCE_LINE 00000110 "  }"
NSQ_SOURCE_LINE 00000111 "  my $sub = do { no strict 'refs'; \\&{\"_find_cycle_$type\"} };"
NSQ_SOURCE_LINE 00000112 "  $sub->(@_);"
NSQ_SOURCE_LINE 00000113 "}"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "sub _find_cycle_SCALAR {"
NSQ_SOURCE_LINE 00000116 "  my $current   = shift;"
NSQ_SOURCE_LINE 00000117 "  my $seenit    = shift;"
NSQ_SOURCE_LINE 00000118 "  my $callback  = shift;"
NSQ_SOURCE_LINE 00000119 "  my $inc_weak_refs = shift;"
NSQ_SOURCE_LINE 00000120 "  my $complain  = shift;"
NSQ_SOURCE_LINE 00000121 "  my @report  = @_;"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "  return if !$inc_weak_refs && isweak($$current);"
NSQ_SOURCE_LINE 00000124 "  _find_cycle($$current,{%$seenit},$callback,$inc_weak_refs,$complain,"
NSQ_SOURCE_LINE 00000125 "              (@report,['SCALAR',undef,$current => $$current,$inc_weak_refs?isweak($$current):()]));"
NSQ_SOURCE_LINE 00000126 "}"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "sub _find_cycle_ARRAY {"
NSQ_SOURCE_LINE 00000129 "  my $current   = shift;"
NSQ_SOURCE_LINE 00000130 "  my $seenit    = shift;"
NSQ_SOURCE_LINE 00000131 "  my $callback  = shift;"
NSQ_SOURCE_LINE 00000132 "  my $inc_weak_refs = shift;"
NSQ_SOURCE_LINE 00000133 "  my $complain  = shift;"
NSQ_SOURCE_LINE 00000134 "  my @report  = @_;"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "  for (my $i=0; $i<@$current; $i++) {"
NSQ_SOURCE_LINE 00000137 "    next if !$inc_weak_refs && isweak($current->[$i]);"
NSQ_SOURCE_LINE 00000138 "    _find_cycle($current->[$i],{%$seenit},$callback,$inc_weak_refs,$complain,"
NSQ_SOURCE_LINE 00000139 "                (@report,['ARRAY',$i,$current => $current->[$i],$inc_weak_refs?isweak($current->[$i]):()]));"
NSQ_SOURCE_LINE 00000140 "    }"
NSQ_SOURCE_LINE 00000141 "}"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "sub _find_cycle_HASH {"
NSQ_SOURCE_LINE 00000144 "  my $current   = shift;"
NSQ_SOURCE_LINE 00000145 "  my $seenit    = shift;"
NSQ_SOURCE_LINE 00000146 "  my $callback  = shift;"
NSQ_SOURCE_LINE 00000147 "  my $inc_weak_refs = shift;"
NSQ_SOURCE_LINE 00000148 "  my $complain  = shift;"
NSQ_SOURCE_LINE 00000149 "  my @report  = @_;"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "  for my $key (sort keys %$current) {"
NSQ_SOURCE_LINE 00000152 "    next if !$inc_weak_refs && isweak($current->{$key});"
NSQ_SOURCE_LINE 00000153 "    _find_cycle($current->{$key},{%$seenit},$callback,$inc_weak_refs,$complain,"
NSQ_SOURCE_LINE 00000154 "                (@report,['HASH',$key,$current => $current->{$key},$inc_weak_refs?isweak($current->{$key}):()]));"
NSQ_SOURCE_LINE 00000155 "    }"
NSQ_SOURCE_LINE 00000156 "}"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "sub _find_cycle_CODE {"
NSQ_SOURCE_LINE 00000159 "  my $current   = shift;"
NSQ_SOURCE_LINE 00000160 "  my $seenit    = shift;"
NSQ_SOURCE_LINE 00000161 "  my $callback  = shift;"
NSQ_SOURCE_LINE 00000162 "  my $inc_weak_refs = shift;"
NSQ_SOURCE_LINE 00000163 "  my $complain  = shift;"
NSQ_SOURCE_LINE 00000164 "  my @report  = @_;"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "  unless (HAVE_PADWALKER) {"
NSQ_SOURCE_LINE 00000167 "    if (!$complain->{$current} && !$QUIET) {"
NSQ_SOURCE_LINE 00000168 "      carp \"A code closure was detected in but we cannot check it unless the PadWalker module is installed\";"
NSQ_SOURCE_LINE 00000169 "    }"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "    return;"
NSQ_SOURCE_LINE 00000172 "  }"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "  my $closed_vars = PadWalker::closed_over( $current );"
NSQ_SOURCE_LINE 00000175 "  foreach my $varname ( sort keys %$closed_vars ) {"
NSQ_SOURCE_LINE 00000176 "    my $value = $closed_vars->{$varname};"
NSQ_SOURCE_LINE 00000177 "    _find_cycle_dispatch($value,{%$seenit},$callback,$inc_weak_refs,$complain,"
NSQ_SOURCE_LINE 00000178 "                         (@report,['CODE',$varname,$current => $value]));"
NSQ_SOURCE_LINE 00000179 "  }"
NSQ_SOURCE_LINE 00000180 "}"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "sub _do_report {"
NSQ_SOURCE_LINE 00000183 "  my $counter = shift;"
NSQ_SOURCE_LINE 00000184 "  my $path    = shift;"
NSQ_SOURCE_LINE 00000185 "  print \"Cycle ($counter):\\n\";"
NSQ_SOURCE_LINE 00000186 "  foreach (@$path) {"
NSQ_SOURCE_LINE 00000187 "    my ($type,$index,$ref,$value,$is_weak) = @$_;"
NSQ_SOURCE_LINE 00000188 "    printf(\"\\t%30s => %-30s\\n\",($is_weak ? 'w-> ' : '')._format_reference($type,$index,$ref,0),_format_reference(undef,undef,$value,1));"
NSQ_SOURCE_LINE 00000189 "  }"
NSQ_SOURCE_LINE 00000190 "  print \"\\n\";"
NSQ_SOURCE_LINE 00000191 "}"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "sub _format_reference {"
NSQ_SOURCE_LINE 00000194 "  my ($type,$index,$ref,$deref) = @_;"
NSQ_SOURCE_LINE 00000195 "  $type ||= _get_type($ref);"
NSQ_SOURCE_LINE 00000196 "  return $ref unless $type;"
NSQ_SOURCE_LINE 00000197 "  my $suffix  = defined $index ? _format_index($type,$index) : '';"
NSQ_SOURCE_LINE 00000198 "  if ($FORMATTING eq 'raw') {"
NSQ_SOURCE_LINE 00000199 "    return $ref.$suffix;"
NSQ_SOURCE_LINE 00000200 "  }"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "  else {"
NSQ_SOURCE_LINE 00000203 "    my $package  = blessed($ref);"
NSQ_SOURCE_LINE 00000204 "    my $prefix   = $package ? ($FORMATTING eq 'roasted' ? \"${package}::\" : \"${package}=\"  ) : '';"
NSQ_SOURCE_LINE 00000205 "    my $sygil    = $deref ? '\\\\' : '';"
NSQ_SOURCE_LINE 00000206 "    my $shortname = ($SHORT_NAMES{$ref} ||= $SHORT_NAME++);"
NSQ_SOURCE_LINE 00000207 "    return $sygil . ($sygil ? '$' : '$$'). $prefix . $shortname . $suffix if $type eq 'SCALAR';"
NSQ_SOURCE_LINE 00000208 "    return $sygil . ($sygil ? '@' : '$') . $prefix . $shortname . $suffix  if $type eq 'ARRAY';"
NSQ_SOURCE_LINE 00000209 "    return $sygil . ($sygil ? '%' : '$') . $prefix . $shortname . $suffix  if $type eq 'HASH';"
NSQ_SOURCE_LINE 00000210 "    return $sygil . ($sygil ? '&' : '$') . $prefix . $shortname . $suffix if $type eq 'CODE';"
NSQ_SOURCE_LINE 00000211 "  }"
NSQ_SOURCE_LINE 00000212 "}"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "# why not Scalar::Util::reftype?"
NSQ_SOURCE_LINE 00000215 "sub _get_type {"
NSQ_SOURCE_LINE 00000216 "  my $thingy = shift;"
NSQ_SOURCE_LINE 00000217 "  return unless ref $thingy;"
NSQ_SOURCE_LINE 00000218 "  return 'SCALAR' if UNIVERSAL::isa($thingy,'SCALAR') || UNIVERSAL::isa($thingy,'REF');"
NSQ_SOURCE_LINE 00000219 "  return 'ARRAY'  if UNIVERSAL::isa($thingy,'ARRAY');"
NSQ_SOURCE_LINE 00000220 "  return 'HASH'   if UNIVERSAL::isa($thingy,'HASH');"
NSQ_SOURCE_LINE 00000221 "  return 'CODE'   if UNIVERSAL::isa($thingy,'CODE');"
NSQ_SOURCE_LINE 00000222 "  undef;"
NSQ_SOURCE_LINE 00000223 "}"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "sub _format_index {"
NSQ_SOURCE_LINE 00000226 "  my ($type,$index) = @_;"
NSQ_SOURCE_LINE 00000227 "  return \"->[$index]\" if $type eq 'ARRAY';"
NSQ_SOURCE_LINE 00000228 "  return \"->{'$index'}\" if $type eq 'HASH';"
NSQ_SOURCE_LINE 00000229 "  return \" variable $index\" if $type eq 'CODE';"
NSQ_SOURCE_LINE 00000230 "  return;"
NSQ_SOURCE_LINE 00000231 "}"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "1;"
NSQ_SOURCE_LINE 00000234 "__END__"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "=head1 NAME"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "Devel::Cycle - Find memory cycles in objects"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "  #!/usr/bin/perl"
NSQ_SOURCE_LINE 00000243 "  use Devel::Cycle;"
NSQ_SOURCE_LINE 00000244 "  my $test = {fred   => [qw(a b c d e)],"
NSQ_SOURCE_LINE 00000245 "\t    ethel  => [qw(1 2 3 4 5)],"
NSQ_SOURCE_LINE 00000246 "\t    george => {martha => 23,"
NSQ_SOURCE_LINE 00000247 "\t\t       agnes  => 19}"
NSQ_SOURCE_LINE 00000248 "\t   };"
NSQ_SOURCE_LINE 00000249 "  $test->{george}{phyllis} = $test;"
NSQ_SOURCE_LINE 00000250 "  $test->{fred}[3]      = $test->{george};"
NSQ_SOURCE_LINE 00000251 "  $test->{george}{mary} = $test->{fred};"
NSQ_SOURCE_LINE 00000252 "  find_cycle($test);"
NSQ_SOURCE_LINE 00000253 "  exit 0;"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "  # output:"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "  Cycle (1):"
NSQ_SOURCE_LINE 00000258 "\t                $A->{'george'} => \\%B"
NSQ_SOURCE_LINE 00000259 "\t               $B->{'phyllis'} => \\%A"
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "  Cycle (2):"
NSQ_SOURCE_LINE 00000262 "\t                $A->{'george'} => \\%B"
NSQ_SOURCE_LINE 00000263 "\t                  $B->{'mary'} => \\@A"
NSQ_SOURCE_LINE 00000264 "\t                       $A->[3] => \\%B"
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "  Cycle (3):"
NSQ_SOURCE_LINE 00000267 "\t                  $A->{'fred'} => \\@A"
NSQ_SOURCE_LINE 00000268 "\t                       $A->[3] => \\%B"
NSQ_SOURCE_LINE 00000269 "\t               $B->{'phyllis'} => \\%A"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "  Cycle (4):"
NSQ_SOURCE_LINE 00000272 "\t                  $A->{'fred'} => \\@A"
NSQ_SOURCE_LINE 00000273 "\t                       $A->[3] => \\%B"
NSQ_SOURCE_LINE 00000274 "\t                  $B->{'mary'} => \\@A"
NSQ_SOURCE_LINE 00000275 "  "
NSQ_SOURCE_LINE 00000276 "  # you can also check weakened references"
NSQ_SOURCE_LINE 00000277 "  weaken($test->{george}->{phyllis});"
NSQ_SOURCE_LINE 00000278 "  find_weakened_cycle($test);"
NSQ_SOURCE_LINE 00000279 "  exit 0;"
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "  # output:"
NSQ_SOURCE_LINE 00000282 "  "
NSQ_SOURCE_LINE 00000283 "  Cycle (1):"
NSQ_SOURCE_LINE 00000284 "                        $A->{'george'} => \\%B                           "
NSQ_SOURCE_LINE 00000285 "                          $B->{'mary'} => \\@C                           "
NSQ_SOURCE_LINE 00000286 "                               $C->[3] => \\%B                           "
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "  Cycle (2):"
NSQ_SOURCE_LINE 00000289 "                        $A->{'george'} => \\%B                           "
NSQ_SOURCE_LINE 00000290 "                   w-> $B->{'phyllis'} => \\%A                           "
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "  Cycle (3):"
NSQ_SOURCE_LINE 00000293 "                          $A->{'fred'} => \\@C                           "
NSQ_SOURCE_LINE 00000294 "                               $C->[3] => \\%B                           "
NSQ_SOURCE_LINE 00000295 "                          $B->{'mary'} => \\@C                           "
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "  Cycle (4):"
NSQ_SOURCE_LINE 00000298 "                          $A->{'fred'} => \\@C                           "
NSQ_SOURCE_LINE 00000299 "                               $C->[3] => \\%B                           "
NSQ_SOURCE_LINE 00000300 "                   w-> $B->{'phyllis'} => \\%A                       "
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "This is a simple developer's tool for finding circular references in"
NSQ_SOURCE_LINE 00000305 "objects and other types of references.  Because of Perl's"
NSQ_SOURCE_LINE 00000306 "reference-count based memory management, circular references will"
NSQ_SOURCE_LINE 00000307 "cause memory leaks."
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "=head2 EXPORT"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "The find_cycle() and find_weakened_cycle() subroutine are exported by default."
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "=over 4"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "=item find_cycle($object_reference,[$callback])"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "The find_cycle() function will traverse the object reference and print"
NSQ_SOURCE_LINE 00000318 "a report to STDOUT identifying any memory cycles it finds."
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "If an optional callback code reference is provided, then this callback"
NSQ_SOURCE_LINE 00000321 "will be invoked on each cycle that is found.  The callback will be"
NSQ_SOURCE_LINE 00000322 "passed an array reference pointing to a list of lists with the"
NSQ_SOURCE_LINE 00000323 "following format:"
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 " $arg = [ ['REFTYPE',$index,$reference,$reference_value],"
NSQ_SOURCE_LINE 00000326 "          ['REFTYPE',$index,$reference,$reference_value],"
NSQ_SOURCE_LINE 00000327 "          ['REFTYPE',$index,$reference,$reference_value],"
NSQ_SOURCE_LINE 00000328 "           ..."
NSQ_SOURCE_LINE 00000329 "        ]"
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "Each element in the array reference describes one edge in the memory"
NSQ_SOURCE_LINE 00000332 "cycle.  'REFTYPE' describes the type of the reference and is one of"
NSQ_SOURCE_LINE 00000333 "'SCALAR','ARRAY' or 'HASH'.  $index is the index affected by the"
NSQ_SOURCE_LINE 00000334 "reference, and is undef for a scalar, an integer for an array"
NSQ_SOURCE_LINE 00000335 "reference, or a hash key for a hash.  $reference is the memory"
NSQ_SOURCE_LINE 00000336 "reference, and $reference_value is its dereferenced value.  For"
NSQ_SOURCE_LINE 00000337 "example, if the edge is an ARRAY, then the following relationship"
NSQ_SOURCE_LINE 00000338 "holds:"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "   $reference->[$index] eq $reference_value"
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "The first element of the array reference is the $object_reference that"
NSQ_SOURCE_LINE 00000343 "you pased to find_cycle() and may not be directly involved in the"
NSQ_SOURCE_LINE 00000344 "cycle."
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "If a reference is a weak ref produced using Scalar::Util's weaken()"
NSQ_SOURCE_LINE 00000347 "function then it won't contribute to cycles."
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "=item find_weakened_cycle($object_reference,[$callback])"
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "The find_weakened_cycle() function will traverse the object reference and print"
NSQ_SOURCE_LINE 00000352 "a report to STDOUT identifying any memory cycles it finds, I<including> any weakened"
NSQ_SOURCE_LINE 00000353 "cycles produced using Scalar::Util's weaken()."
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 "If an optional callback code reference is provided, then this callback"
NSQ_SOURCE_LINE 00000356 "will be invoked on each cycle that is found.  The callback will be"
NSQ_SOURCE_LINE 00000357 "passed an array reference pointing to a list of lists with the"
NSQ_SOURCE_LINE 00000358 "following format:"
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 " $arg = [ ['REFTYPE',$index,$reference,$reference_value,$is_weakened],"
NSQ_SOURCE_LINE 00000361 "          ['REFTYPE',$index,$reference,$reference_value,$is_weakened],"
NSQ_SOURCE_LINE 00000362 "          ['REFTYPE',$index,$reference,$reference_value,$is_weakened],"
NSQ_SOURCE_LINE 00000363 "           ..."
NSQ_SOURCE_LINE 00000364 "        ]"
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "Each element in the array reference describes one edge in the memory"
NSQ_SOURCE_LINE 00000367 "cycle.  'REFTYPE' describes the type of the reference and is one of"
NSQ_SOURCE_LINE 00000368 "'SCALAR','ARRAY' or 'HASH'.  $index is the index affected by the"
NSQ_SOURCE_LINE 00000369 "reference, and is undef for a scalar, an integer for an array"
NSQ_SOURCE_LINE 00000370 "reference, or a hash key for a hash.  $reference is the memory"
NSQ_SOURCE_LINE 00000371 "reference, and $reference_value is its dereferenced value. $is_weakened"
NSQ_SOURCE_LINE 00000372 "is a boolean specifying if the reference is weakened or not. For"
NSQ_SOURCE_LINE 00000373 "example, if the edge is an ARRAY, then the following relationship"
NSQ_SOURCE_LINE 00000374 "holds:"
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "   $reference->[$index] eq $reference_value"
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 "The first element of the array reference is the $object_reference that"
NSQ_SOURCE_LINE 00000379 "you pased to find_cycle() and may not be directly involved in the"
NSQ_SOURCE_LINE 00000380 "cycle."
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "=back"
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "=head2 Cycle Report Formats"
NSQ_SOURCE_LINE 00000385 ""
NSQ_SOURCE_LINE 00000386 "The default callback prints out a trace of each cycle it finds.  You"
NSQ_SOURCE_LINE 00000387 "can control the format of the trace by setting the package variable"
NSQ_SOURCE_LINE 00000388 "$Devel::Cycle::FORMATTING to one of \"raw,\" \"cooked,\" or \"roasted\"."
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "The \"raw\" format prints out anonymous memory references using standard"
NSQ_SOURCE_LINE 00000391 "Perl memory location nomenclature.  For example, a \"Foo::Bar\" object"
NSQ_SOURCE_LINE 00000392 "that points to an ordinary hash will appear in the trace like this:"
NSQ_SOURCE_LINE 00000393 ""
NSQ_SOURCE_LINE 00000394 "\tFoo::Bar=HASH(0x8124394)->{'phyllis'} => HASH(0x81b4a90)"
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "The \"cooked\" format (the default), uses short names for anonymous"
NSQ_SOURCE_LINE 00000397 "memory locations, beginning with \"A\" and moving upward with the magic"
NSQ_SOURCE_LINE 00000398 "++ operator.  This leads to a much more readable display:"
NSQ_SOURCE_LINE 00000399 ""
NSQ_SOURCE_LINE 00000400 "        $Foo::Bar=B->{'phyllis'} => \\%A"
NSQ_SOURCE_LINE 00000401 ""
NSQ_SOURCE_LINE 00000402 "The \"roasted\" format is similar to the \"cooked\" format, except that"
NSQ_SOURCE_LINE 00000403 "object references are formatted slightly differently:"
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "\t$Foo::Bar::B->{'phyllis'} => \\%A"
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "If a reference is a weakened ref, then it will have a 'w->' prepended to"
NSQ_SOURCE_LINE 00000408 "it, like this:"
NSQ_SOURCE_LINE 00000409 ""
NSQ_SOURCE_LINE 00000410 "\tw-> $Foo::Bar::B->{'phyllis'} => \\%A"
NSQ_SOURCE_LINE 00000411 ""
NSQ_SOURCE_LINE 00000412 "For your convenience, $Devel::Cycle::FORMATTING can be imported:"
NSQ_SOURCE_LINE 00000413 ""
NSQ_SOURCE_LINE 00000414 "       use Devel::Cycle qw(:DEFAULT $FORMATTING);"
NSQ_SOURCE_LINE 00000415 "       $FORMATTING = 'raw';"
NSQ_SOURCE_LINE 00000416 ""
NSQ_SOURCE_LINE 00000417 "Alternatively, you can control the formatting at compile time by"
NSQ_SOURCE_LINE 00000418 "passing one of the options -raw, -cooked, or -roasted to \"use\" as"
NSQ_SOURCE_LINE 00000419 "illustrated here:"
NSQ_SOURCE_LINE 00000420 ""
NSQ_SOURCE_LINE 00000421 "  use Devel::Cycle -raw;"
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "=head2 Code references (closures)"
NSQ_SOURCE_LINE 00000424 ""
NSQ_SOURCE_LINE 00000425 "If the PadWalker module is installed, Devel::Cycle will also report"
NSQ_SOURCE_LINE 00000426 "cycles in code closures. If PadWalker is not installed and"
NSQ_SOURCE_LINE 00000427 "Devel::Cycle detects a CODE reference in one of the data structures,"
NSQ_SOURCE_LINE 00000428 "it will warn (once per data structure) that it cannot inspect the CODE"
NSQ_SOURCE_LINE 00000429 "unless PadWalker is available. You can turn this warning off by"
NSQ_SOURCE_LINE 00000430 "passing -quiet to Devel::Cycle at compile time:"
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 " use Devel::Cycle -quiet;"
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000435 ""
