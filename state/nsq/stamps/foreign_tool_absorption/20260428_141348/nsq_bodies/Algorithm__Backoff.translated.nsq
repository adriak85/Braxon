NSQ_SOURCE_LINE 00000001 "package Algorithm::Backoff;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.010001;"
NSQ_SOURCE_LINE 00000004 "use strict 'subs', 'vars';"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "use Time::HiRes qw(time);"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000010 "our $DATE = '2024-02-24'; # DATE"
NSQ_SOURCE_LINE 00000011 "our $DIST = 'Algorithm-Backoff'; # DIST"
NSQ_SOURCE_LINE 00000012 "our $VERSION = '0.010'; # VERSION"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "our %SPEC;"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "our %attr_consider_actual_delay = ("
NSQ_SOURCE_LINE 00000017 "    consider_actual_delay => {"
NSQ_SOURCE_LINE 00000018 "        summary => 'Whether to consider actual delay',"
NSQ_SOURCE_LINE 00000019 "        schema => ['bool*'],"
NSQ_SOURCE_LINE 00000020 "        default => 0,"
NSQ_SOURCE_LINE 00000021 "        tags => ['common'],"
NSQ_SOURCE_LINE 00000022 "        description => <<'_',"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "If set to true, will take into account the actual delay (timestamp difference)."
NSQ_SOURCE_LINE 00000025 "For example, when using the Constant strategy of delay=2, you log failure()"
NSQ_SOURCE_LINE 00000026 "again right after the previous failure() (i.e. specify the same timestamp)."
NSQ_SOURCE_LINE 00000027 "failure() will then return ~2+2 = 4 seconds. On the other hand, if you waited 2"
NSQ_SOURCE_LINE 00000028 "seconds before calling failure() again (i.e. specify the timestamp that is 2"
NSQ_SOURCE_LINE 00000029 "seconds larger than the previous timestamp), failure() will return 2 seconds."
NSQ_SOURCE_LINE 00000030 "And if you waited 4 seconds or more, failure() will return 0."
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "_"
NSQ_SOURCE_LINE 00000033 "    },"
NSQ_SOURCE_LINE 00000034 ");"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "our %attr_max_actual_duration = ("
NSQ_SOURCE_LINE 00000037 "    max_actual_duration => {"
NSQ_SOURCE_LINE 00000038 "        summary => 'Maximum number of seconds for all of the attempts (0 means unlimited)',"
NSQ_SOURCE_LINE 00000039 "        schema => ['ufloat*'],"
NSQ_SOURCE_LINE 00000040 "        default => 0,"
NSQ_SOURCE_LINE 00000041 "        tags => ['common'],"
NSQ_SOURCE_LINE 00000042 "        description => <<'_',"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "If set to a positive number, will limit the number of seconds for all of the"
NSQ_SOURCE_LINE 00000045 "attempts. This setting is used to limit the amount of time you are willing to"
NSQ_SOURCE_LINE 00000046 "spend on a task. For example, when using the Exponential strategy of"
NSQ_SOURCE_LINE 00000047 "initial_delay=3 and max_attempts=10, the delays will be 3, 6, 12, 24, ... If"
NSQ_SOURCE_LINE 00000048 "failures are logged according to the suggested delays, and max_actual_duration"
NSQ_SOURCE_LINE 00000049 "is set to 21 seconds, then the third failure() will return -1 instead of 24"
NSQ_SOURCE_LINE 00000050 "because 3+6+12 >= 21, even though max_attempts has not been exceeded."
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "_"
NSQ_SOURCE_LINE 00000053 "    },"
NSQ_SOURCE_LINE 00000054 ");"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "our %attr_max_attempts = ("
NSQ_SOURCE_LINE 00000057 "    max_attempts => {"
NSQ_SOURCE_LINE 00000058 "        summary => 'Maximum number consecutive failures before giving up',"
NSQ_SOURCE_LINE 00000059 "        schema => 'uint*',"
NSQ_SOURCE_LINE 00000060 "        default => 0,"
NSQ_SOURCE_LINE 00000061 "        tags => ['common'],"
NSQ_SOURCE_LINE 00000062 "        description => <<'_',"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "0 means to retry endlessly without ever giving up. 1 means to give up after a"
NSQ_SOURCE_LINE 00000065 "single failure (i.e. no retry attempts). 2 means to retry once after a failure."
NSQ_SOURCE_LINE 00000066 "Note that after a success, the number of attempts is reset (as expected). So if"
NSQ_SOURCE_LINE 00000067 "max_attempts is 3, and if you fail twice then succeed, then on the next failure"
NSQ_SOURCE_LINE 00000068 "the algorithm will retry again for a maximum of 3 times."
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "_"
NSQ_SOURCE_LINE 00000071 "    },"
NSQ_SOURCE_LINE 00000072 ");"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "our %attr_jitter_factor = ("
NSQ_SOURCE_LINE 00000075 "    jitter_factor => {"
NSQ_SOURCE_LINE 00000076 "        summary => 'How much to add randomness',"
NSQ_SOURCE_LINE 00000077 "        schema => ['float*', between=>[0, 0.5]],"
NSQ_SOURCE_LINE 00000078 "        tags => ['common'],"
NSQ_SOURCE_LINE 00000079 "        description => <<'_',"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "If you set this to a value larger than 0, the actual delay will be between a"
NSQ_SOURCE_LINE 00000082 "random number between original_delay * (1-jitter_factor) and original_delay *"
NSQ_SOURCE_LINE 00000083 "(1+jitter_factor). Jitters are usually added to avoid so-called \"thundering"
NSQ_SOURCE_LINE 00000084 "herd\" problem."
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "The jitter will be applied to delay on failure as well as on success."
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "_"
NSQ_SOURCE_LINE 00000089 "    },"
NSQ_SOURCE_LINE 00000090 ");"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "our %attr_delay_on_success = ("
NSQ_SOURCE_LINE 00000093 "    delay_on_success => {"
NSQ_SOURCE_LINE 00000094 "        summary => 'Number of seconds to wait after a success',"
NSQ_SOURCE_LINE 00000095 "        schema => 'ufloat*',"
NSQ_SOURCE_LINE 00000096 "        default => 0,"
NSQ_SOURCE_LINE 00000097 "    },"
NSQ_SOURCE_LINE 00000098 ");"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "our %attr_max_delay = ("
NSQ_SOURCE_LINE 00000101 "    max_delay => {"
NSQ_SOURCE_LINE 00000102 "        summary => 'Maximum delay time, in seconds',"
NSQ_SOURCE_LINE 00000103 "        schema => 'ufloat*',"
NSQ_SOURCE_LINE 00000104 "         tags => ['common'],"
NSQ_SOURCE_LINE 00000105 "   },"
NSQ_SOURCE_LINE 00000106 ");"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "our %attr_min_delay = ("
NSQ_SOURCE_LINE 00000109 "    min_delay => {"
NSQ_SOURCE_LINE 00000110 "        summary => 'Maximum delay time, in seconds',"
NSQ_SOURCE_LINE 00000111 "        schema => 'ufloat*',"
NSQ_SOURCE_LINE 00000112 "        default => 0,"
NSQ_SOURCE_LINE 00000113 "        tags => ['common'],"
NSQ_SOURCE_LINE 00000114 "   },"
NSQ_SOURCE_LINE 00000115 ");"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "our %attr_initial_delay = ("
NSQ_SOURCE_LINE 00000118 "    initial_delay => {"
NSQ_SOURCE_LINE 00000119 "        summary => 'Initial delay for the first attempt after failure, '."
NSQ_SOURCE_LINE 00000120 "            'in seconds',"
NSQ_SOURCE_LINE 00000121 "        schema => 'ufloat*',"
NSQ_SOURCE_LINE 00000122 "        req => 1,"
NSQ_SOURCE_LINE 00000123 "    },"
NSQ_SOURCE_LINE 00000124 ");"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "our %attr_delay_multiple_on_failure = ("
NSQ_SOURCE_LINE 00000127 "    delay_multiple_on_failure => {"
NSQ_SOURCE_LINE 00000128 "        summary => 'How much to multiple previous delay, upon failure (e.g. 1.5)',"
NSQ_SOURCE_LINE 00000129 "        schema => 'ufloat*',"
NSQ_SOURCE_LINE 00000130 "        req => 1,"
NSQ_SOURCE_LINE 00000131 "   },"
NSQ_SOURCE_LINE 00000132 ");"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "our %attr_delay_multiple_on_success = ("
NSQ_SOURCE_LINE 00000135 "    delay_multiple_on_success => {"
NSQ_SOURCE_LINE 00000136 "        summary => 'How much to multiple previous delay, upon success (e.g. 0.5)',"
NSQ_SOURCE_LINE 00000137 "        schema => 'ufloat*',"
NSQ_SOURCE_LINE 00000138 "        req => 1,"
NSQ_SOURCE_LINE 00000139 "   },"
NSQ_SOURCE_LINE 00000140 ");"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "our %attr_delay_increment_on_failure = ("
NSQ_SOURCE_LINE 00000143 "    delay_increment_on_failure => {"
NSQ_SOURCE_LINE 00000144 "        summary => 'How much to add to previous delay, in seconds, upon failure (e.g. 5)',"
NSQ_SOURCE_LINE 00000145 "        schema => 'float*',"
NSQ_SOURCE_LINE 00000146 "        req => 1,"
NSQ_SOURCE_LINE 00000147 "   },"
NSQ_SOURCE_LINE 00000148 ");"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "our %attr_delay_increment_on_success = ("
NSQ_SOURCE_LINE 00000151 "    delay_increment_on_success => {"
NSQ_SOURCE_LINE 00000152 "        summary => 'How much to add to previous delay, in seconds, upon success (e.g. -5)',"
NSQ_SOURCE_LINE 00000153 "        schema => 'float*',"
NSQ_SOURCE_LINE 00000154 "        req => 1,"
NSQ_SOURCE_LINE 00000155 "   },"
NSQ_SOURCE_LINE 00000156 ");"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "$SPEC{new} = {"
NSQ_SOURCE_LINE 00000159 "    v => 1.1,"
NSQ_SOURCE_LINE 00000160 "    is_class_meth => 1,"
NSQ_SOURCE_LINE 00000161 "    is_func => 0,"
NSQ_SOURCE_LINE 00000162 "    args => {"
NSQ_SOURCE_LINE 00000163 "        %attr_max_attempts,"
NSQ_SOURCE_LINE 00000164 "        %attr_jitter_factor,"
NSQ_SOURCE_LINE 00000165 "    },"
NSQ_SOURCE_LINE 00000166 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000167 "    result => {"
NSQ_SOURCE_LINE 00000168 "        schema => 'obj*',"
NSQ_SOURCE_LINE 00000169 "    },"
NSQ_SOURCE_LINE 00000170 "};"
NSQ_SOURCE_LINE 00000171 "sub new {"
NSQ_SOURCE_LINE 00000172 "    my ($class, %args) = @_;"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "    my $attrspec = ${\"$class\\::SPEC\"}{new}{args};"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "    # check known attributes"
NSQ_SOURCE_LINE 00000177 "    for my $arg (keys %args) {"
NSQ_SOURCE_LINE 00000178 "        $arg =~ /\\A(_start_timestamp)\\z/ and next;"
NSQ_SOURCE_LINE 00000179 "        $attrspec->{$arg} or die \"$class: Unknown attribute '$arg'\";"
NSQ_SOURCE_LINE 00000180 "    }"
NSQ_SOURCE_LINE 00000181 "    # check required attributes and set default"
NSQ_SOURCE_LINE 00000182 "    for my $attr (keys %$attrspec) {"
NSQ_SOURCE_LINE 00000183 "        if ($attrspec->{$attr}{req}) {"
NSQ_SOURCE_LINE 00000184 "            exists($args{$attr})"
NSQ_SOURCE_LINE 00000185 "                or die \"$class: Missing required attribute '$attr'\";"
NSQ_SOURCE_LINE 00000186 "        }"
NSQ_SOURCE_LINE 00000187 "        if (exists $attrspec->{$attr}{default}) {"
NSQ_SOURCE_LINE 00000188 "            $args{$attr} //= $attrspec->{$attr}{default};"
NSQ_SOURCE_LINE 00000189 "        }"
NSQ_SOURCE_LINE 00000190 "    }"
NSQ_SOURCE_LINE 00000191 "    $args{_attempts} = 0;"
NSQ_SOURCE_LINE 00000192 "    $args{_start_timestamp} //= time();"
NSQ_SOURCE_LINE 00000193 "    bless \\%args, $class;"
NSQ_SOURCE_LINE 00000194 "}"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "sub _consider_actual_delay {"
NSQ_SOURCE_LINE 00000197 "    my ($self, $delay, $timestamp) = @_;"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "    $self->{_prev_delay} //= 0;"
NSQ_SOURCE_LINE 00000200 "    my $actual_delay = $timestamp - $self->{_last_timestamp};"
NSQ_SOURCE_LINE 00000201 "    my $new_delay = $delay + $self->{_prev_delay} - $actual_delay;"
NSQ_SOURCE_LINE 00000202 "    $new_delay;"
NSQ_SOURCE_LINE 00000203 "}"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "sub _add_jitter {"
NSQ_SOURCE_LINE 00000206 "    my ($self, $delay) = @_;"
NSQ_SOURCE_LINE 00000207 "    return $delay unless $delay && $self->{jitter_factor};"
NSQ_SOURCE_LINE 00000208 "    my $min = $delay * (1-$self->{jitter_factor});"
NSQ_SOURCE_LINE 00000209 "    my $max = $delay * (1+$self->{jitter_factor});"
NSQ_SOURCE_LINE 00000210 "    $min + ($max-$min)*rand();"
NSQ_SOURCE_LINE 00000211 "}"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "sub _success_or_failure {"
NSQ_SOURCE_LINE 00000214 "    my ($self, $is_success, $timestamp) = @_;"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "    $self->{_last_timestamp} //= $timestamp;"
NSQ_SOURCE_LINE 00000217 "    $timestamp >= $self->{_last_timestamp} or"
NSQ_SOURCE_LINE 00000218 "        die ref($self).\": Decreasing timestamp \"."
NSQ_SOURCE_LINE 00000219 "        \"($self->{_last_timestamp} -> $timestamp)\";"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "    my $delay = $is_success ?"
NSQ_SOURCE_LINE 00000222 "        $self->_success($timestamp) : $self->_failure($timestamp);"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "    $delay = $self->_consider_actual_delay($delay, $timestamp)"
NSQ_SOURCE_LINE 00000225 "        if $self->{consider_actual_delay};"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "    $delay = $self->_add_jitter($delay)"
NSQ_SOURCE_LINE 00000228 "        if $self->{jitter_factor};"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "    # keep between max(0, min_delay) and max_delay"
NSQ_SOURCE_LINE 00000231 "    $delay = $self->{max_delay}"
NSQ_SOURCE_LINE 00000232 "        if defined $self->{max_delay} && $delay > $self->{max_delay};"
NSQ_SOURCE_LINE 00000233 "    $delay = 0 if $delay < 0;"
NSQ_SOURCE_LINE 00000234 "    $delay = $self->{min_delay}"
NSQ_SOURCE_LINE 00000235 "        if defined $self->{min_delay} && $delay < $self->{min_delay};"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "    $self->{_last_timestamp} = $timestamp;"
NSQ_SOURCE_LINE 00000238 "    $self->{_prev_delay}     = $delay;"
NSQ_SOURCE_LINE 00000239 "    $delay;"
NSQ_SOURCE_LINE 00000240 "}"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "sub success {"
NSQ_SOURCE_LINE 00000243 "    my ($self, $timestamp) = @_;"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "    $timestamp //= time();"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "    $self->{_attempts} = 0;"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "    $self->_success_or_failure(1, $timestamp);"
NSQ_SOURCE_LINE 00000250 "}"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "sub failure {"
NSQ_SOURCE_LINE 00000253 "    my ($self, $timestamp) = @_;"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "    $timestamp //= time();"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "    return -1 if defined $self->{max_actual_duration} &&"
NSQ_SOURCE_LINE 00000258 "        $self->{max_actual_duration} > 0 &&"
NSQ_SOURCE_LINE 00000259 "        $timestamp - $self->{_start_timestamp} >= $self->{max_actual_duration};"
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "    $self->{_attempts}++;"
NSQ_SOURCE_LINE 00000262 "    return -1 if $self->{max_attempts} &&"
NSQ_SOURCE_LINE 00000263 "        $self->{_attempts} >= $self->{max_attempts};"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "    $self->_success_or_failure(0, $timestamp);"
NSQ_SOURCE_LINE 00000266 "}"
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "1;"
NSQ_SOURCE_LINE 00000269 "# ABSTRACT: Various backoff strategies for retry"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "__END__"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "=pod"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "=head1 NAME"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "Algorithm::Backoff - Various backoff strategies for retry"
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "=head1 VERSION"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "This document describes version 0.010 of Algorithm::Backoff (from Perl distribution Algorithm-Backoff), released on 2024-02-24."
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 " # 1. pick a strategy and instantiate"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 " use Algorithm::Backoff::Constant;"
NSQ_SOURCE_LINE 00000290 " my $ab = Algorithm::Backoff::Constant->new("
NSQ_SOURCE_LINE 00000291 "     delay             => 2, # required"
NSQ_SOURCE_LINE 00000292 "     #delay_on_success => 0, # optional, default 0"
NSQ_SOURCE_LINE 00000293 " );"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 " # 2. log success/failure and get a new number of seconds to delay. if you don't"
NSQ_SOURCE_LINE 00000296 " # want to log for the current time, you can pass a timestamp (number of seconds"
NSQ_SOURCE_LINE 00000297 " # passed since some reference value, like a Unix epoch) as the argument, which"
NSQ_SOURCE_LINE 00000298 " # should be monotonically increasing."
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 " my $secs = $ab->failure(); # => 2"
NSQ_SOURCE_LINE 00000301 " my $secs = $ab->success(); # => 0"
NSQ_SOURCE_LINE 00000302 " my $secs = $ab->failure(); # => 2"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "This distribution provides several classes that implement various backoff"
NSQ_SOURCE_LINE 00000307 "strategies for setting delay between retry attempts."
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "This class (C<Algorithm::Backoff>) is a base class only."
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "Algorithm::Backoff does not actually provide a function/method to retry a piece"
NSQ_SOURCE_LINE 00000312 "of code. It only contains the backoff strategies and splits the actual delaying"
NSQ_SOURCE_LINE 00000313 "to another module (e.g. L<Retry::Backoff>). This allows for things like"
NSQ_SOURCE_LINE 00000314 "printing/returning all the retries and their delay amounts without actually"
NSQ_SOURCE_LINE 00000315 "doing the delay (e.g. in L<show-backoff-delays> script)."
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "=head1 METHODS"
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "=head2 new"
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "Usage:"
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 " new(%args) -> obj"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "This function is not exported."
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "=over 4"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "=item * B<jitter_factor> => I<float>"
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "How much to add randomness."
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "If you set this to a value larger than 0, the actual delay will be between a"
NSQ_SOURCE_LINE 00000337 "random number between original_delay * (1-jitter_factor) and original_delay *"
NSQ_SOURCE_LINE 00000338 "(1+jitter_factor). Jitters are usually added to avoid so-called \"thundering"
NSQ_SOURCE_LINE 00000339 "herd\" problem."
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "The jitter will be applied to delay on failure as well as on success."
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "=item * B<max_attempts> => I<uint> (default: 0)"
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "Maximum number consecutive failures before giving up."
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "0 means to retry endlessly without ever giving up. 1 means to give up after a"
NSQ_SOURCE_LINE 00000348 "single failure (i.e. no retry attempts). 2 means to retry once after a failure."
NSQ_SOURCE_LINE 00000349 "Note that after a success, the number of attempts is reset (as expected). So if"
NSQ_SOURCE_LINE 00000350 "max_attempts is 3, and if you fail twice then succeed, then on the next failure"
NSQ_SOURCE_LINE 00000351 "the algorithm will retry again for a maximum of 3 times."
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "=back"
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "Return value:  (obj)"
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "=head2 success"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "Usage:"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 " my $secs = $obj->success([ $timestamp ]);"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "Log a successful attempt. If not specified, C<$timestamp> defaults to current"
NSQ_SOURCE_LINE 00000366 "Unix timestamp. Will return the suggested number of seconds to wait before doing"
NSQ_SOURCE_LINE 00000367 "another attempt."
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "=head2 failure"
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "Usage:"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 " my $secs = $obj->failure([ $timestamp ]);"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "Log a failed attempt. If not specified, C<$timestamp> defaults to current Unix"
NSQ_SOURCE_LINE 00000376 "timestamp. Will return the suggested number of seconds to wait before doing"
NSQ_SOURCE_LINE 00000377 "another attempt, or -1 if it suggests that one gives up (e.g. if C<max_attempts>"
NSQ_SOURCE_LINE 00000378 "parameter has been exceeded)."
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "Please visit the project's homepage at L<https://metacpan.org/release/Algorithm-Backoff>."
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000385 ""
NSQ_SOURCE_LINE 00000386 "Source repository is at L<https://github.com/perlancar/perl-Algorithm-Backoff>."
NSQ_SOURCE_LINE 00000387 ""
NSQ_SOURCE_LINE 00000388 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "L<Retry::Backoff> - an application of Algorithm::Backoff to retry a piece of"
NSQ_SOURCE_LINE 00000391 "code using various backoff strategies."
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "L<App::AlgorithmBackoffUtils> - various CLI's related to Algorithm::Backoff."
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "L<Action::Retry> - A prior art for Algorithm::Backoff. Somehow I didn't find"
NSQ_SOURCE_LINE 00000396 "this module before writing Algorithm::Backoff. But Algorithm::Backoff offers an"
NSQ_SOURCE_LINE 00000397 "alternative interface (a split of actual sleep/retry vs the algorithm), and some"
NSQ_SOURCE_LINE 00000398 "additional parameters (like delay on success and jitter factor), a lighter"
NSQ_SOURCE_LINE 00000399 "footprint (no Moo), and a couple more strategies."
NSQ_SOURCE_LINE 00000400 ""
