NSQ_SOURCE_LINE 00000001 "package Getopt::Long::Negate::EN;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2019-04-23'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.060'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use 5.010001;"
NSQ_SOURCE_LINE 00000007 "use strict;"
NSQ_SOURCE_LINE 00000008 "use warnings;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use Exporter qw(import);"
NSQ_SOURCE_LINE 00000011 "our @EXPORT_OK = qw(negations_for_option);"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "sub negations_for_option {"
NSQ_SOURCE_LINE 00000014 "    my $word = shift;"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "    if    ($word =~ /\\Awith([_-].+)/   ) { return (\"without$1\") }"
NSQ_SOURCE_LINE 00000017 "    elsif ($word =~ /\\Awithout([_-].+)/) { return (\"with$1\")    }"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "    elsif ($word =~ /\\Ais([_-].+)/     ) { return (\"isnt$1\")    }"
NSQ_SOURCE_LINE 00000020 "    elsif ($word =~ /\\Aisnt([_-].+)/   ) { return (\"is$1\")      }"
NSQ_SOURCE_LINE 00000021 "    elsif ($word =~ /\\Aare([_-].+)/    ) { return (\"arent$1\")   }"
NSQ_SOURCE_LINE 00000022 "    elsif ($word =~ /\\Aarent([_-].+)/  ) { return (\"are$1\")     }"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "    elsif ($word =~ /\\Ahas([_-].+)/    ) { return (\"hasnt$1\")   }"
NSQ_SOURCE_LINE 00000025 "    elsif ($word =~ /\\Ahave([_-].+)/   ) { return (\"havent$1\")  }"
NSQ_SOURCE_LINE 00000026 "    elsif ($word =~ /\\Ahasnt([_-].+)/  ) { return (\"has$1\")     }"
NSQ_SOURCE_LINE 00000027 "    elsif ($word =~ /\\Ahavent([_-].+)/ ) { return (\"have$1\")    }"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "    elsif ($word =~ /\\Acan([_-].+)/    ) { return (\"cant$1\")    }"
NSQ_SOURCE_LINE 00000030 "    elsif ($word =~ /\\Acant([_-].+)/   ) { return (\"can$1\")     }"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "    elsif ($word =~ /\\Aenabled([_-].+)/ ) { return (\"disabled$1\") }"
NSQ_SOURCE_LINE 00000033 "    elsif ($word =~ /\\Adisabled([_-].+)/) { return (\"enabled$1\")  }"
NSQ_SOURCE_LINE 00000034 "    elsif ($word =~ /\\Aenable([_-].+)/ )  { return (\"disable$1\")  }"
NSQ_SOURCE_LINE 00000035 "    elsif ($word =~ /\\Adisable([_-].+)/)  { return (\"enable$1\")   }"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "    elsif ($word =~ /\\Aallowed([_-].+)/ )   { return (\"disallowed$1\") }"
NSQ_SOURCE_LINE 00000038 "    elsif ($word =~ /\\Adisallowed([_-].+)/) { return (\"allowed$1\")    }"
NSQ_SOURCE_LINE 00000039 "    elsif ($word =~ /\\Aallow([_-].+)/ )     { return (\"disallow$1\")   }"
NSQ_SOURCE_LINE 00000040 "    elsif ($word =~ /\\Adisallow([_-].+)/)   { return (\"allow$1\")      }"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "    elsif ($word =~ /\\Ainclude([_-].+)/ ) { return (\"exclude$1\") }"
NSQ_SOURCE_LINE 00000043 "    elsif ($word =~ /\\Aexclude([_-].+)/ ) { return (\"include$1\") }"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "    elsif ($word =~ /\\Ano[_-](.+)/     ) { return ($1)          }"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "    else {"
NSQ_SOURCE_LINE 00000048 "        # default from Getopt::Long"
NSQ_SOURCE_LINE 00000049 "        return (\"no-$word\", \"no$word\");"
NSQ_SOURCE_LINE 00000050 "    }"
NSQ_SOURCE_LINE 00000051 "}"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "1;"
NSQ_SOURCE_LINE 00000054 "# ABSTRACT: Better negation of boolean option names"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "__END__"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "=pod"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "=head1 NAME"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "Getopt::Long::Negate::EN - Better negation of boolean option names"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "=head1 VERSION"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "This document describes version 0.060 of Getopt::Long::Negate::EN (from Perl distribution Getopt-Long-Negate-EN), released on 2019-04-23."
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 " use Getopt::Long::Negate::EN qw(negations_for_option);"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 " # the Getopt::Long's default"
NSQ_SOURCE_LINE 00000075 " @negs = negations_for_option('foo'); # ('no-foo', 'nofoo')"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 " @negs = negations_for_option('with-foo');    # ('without-foo')"
NSQ_SOURCE_LINE 00000078 " @negs = negations_for_option('without-foo'); # ('with-foo')"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 " @negs = negations_for_option('is-foo');      # ('isnt-foo')"
NSQ_SOURCE_LINE 00000081 " @negs = negations_for_option('isnt-foo');    # ('is-foo')"
NSQ_SOURCE_LINE 00000082 " @negs = negations_for_option('are-foo');     # ('isnt-foo')"
NSQ_SOURCE_LINE 00000083 " @negs = negations_for_option('arent-foo');   # ('arent-foo')"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 " @negs = negations_for_option('has-foo');     # ('hasnt-foo')"
NSQ_SOURCE_LINE 00000086 " @negs = negations_for_option('hasnt-foo');   # ('has-foo')"
NSQ_SOURCE_LINE 00000087 " @negs = negations_for_option('have-foo');    # ('havent-foo')"
NSQ_SOURCE_LINE 00000088 " @negs = negations_for_option('havent-foo');  # ('have-foo')"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 " @negs = negations_for_option('can-foo');     # ('cant-foo')"
NSQ_SOURCE_LINE 00000091 " @negs = negations_for_option('cant-foo');    # ('can-foo')"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 " @negs = negations_for_option('enabled-foo'); # ('disabled-foo')"
NSQ_SOURCE_LINE 00000094 " @negs = negations_for_option('disabled-foo');# ('enabled-foo')"
NSQ_SOURCE_LINE 00000095 " @negs = negations_for_option('enable-foo');  # ('disable-foo')"
NSQ_SOURCE_LINE 00000096 " @negs = negations_for_option('disable-foo'); # ('enable-foo')"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 " @negs = negations_for_option('allowed-foo');    # ('disallowed-foo')"
NSQ_SOURCE_LINE 00000099 " @negs = negations_for_option('disallowed-foo'); # ('allowed-foo')"
NSQ_SOURCE_LINE 00000100 " @negs = negations_for_option('allow-foo');      # ('disallow-foo')"
NSQ_SOURCE_LINE 00000101 " @negs = negations_for_option('disallow-foo');   # ('allow-foo')"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 " @negs = negations_for_option('include-foo'); # ('exclude-foo')"
NSQ_SOURCE_LINE 00000104 " @negs = negations_for_option('exclude-foo'); # ('include-foo')"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 " @negs = negations_for_option('no-foo');      # ('foo')"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "This module aims to provide a nicer negative boolean option names. By default,"
NSQ_SOURCE_LINE 00000111 "L<Getopt::Long> provides options C<--foo> as well as C<--no-foo> and C<--nofoo>"
NSQ_SOURCE_LINE 00000112 "if you specify boolean option specification C<foo!>. But this produces"
NSQ_SOURCE_LINE 00000113 "awkward/incorrect English word like C<--nowith-foo> or C<--no-is-foo>. In those"
NSQ_SOURCE_LINE 00000114 "two cases, C<--without-foo> and C<--isnt-foo> are better option names."
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "None are exported by default, but they are exportable."
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "=head2 negations_for_option($str) => list"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "Please visit the project's homepage at L<https://metacpan.org/release/Getopt-Long-Negate-EN>."
