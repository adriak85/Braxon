BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "## no critic: TestingAndDebugging::RequireUseStrict"
NSQ_SOURCE_LINE 00000002 "package Log::ger;"
NSQ_SOURCE_LINE 00000003 ""
NSQ_SOURCE_LINE 00000004 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000005 "our $DATE = '2023-12-29'; # DATE"
NSQ_SOURCE_LINE 00000006 "our $DIST = 'Log-ger'; # DIST"
NSQ_SOURCE_LINE 00000007 "our $VERSION = '0.042'; # VERSION"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "#IFUNBUILT"
NSQ_SOURCE_LINE 00000010 "# use strict 'subs', 'vars';"
NSQ_SOURCE_LINE 00000011 "# use warnings;"
NSQ_SOURCE_LINE 00000012 "#END IFUNBUILT"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "our $re_addr = qr/\\(0x([0-9a-f]+)/o;"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "our %Levels = ("
NSQ_SOURCE_LINE 00000017 "    fatal   => 10,"
NSQ_SOURCE_LINE 00000018 "    error   => 20,"
NSQ_SOURCE_LINE 00000019 "    warn    => 30,"
NSQ_SOURCE_LINE 00000020 "    info    => 40,"
NSQ_SOURCE_LINE 00000021 "    debug   => 50,"
NSQ_SOURCE_LINE 00000022 "    trace   => 60,"
NSQ_SOURCE_LINE 00000023 ");"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "our %Level_Aliases = ("
NSQ_SOURCE_LINE 00000026 "    off     => 0,"
NSQ_SOURCE_LINE 00000027 "    warning => 30,"
NSQ_SOURCE_LINE 00000028 ");"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "our $Current_Level = 30;"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "our $Caller_Depth_Offset = 0;"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "# a flag that can be used by null output to skip using formatter"
NSQ_SOURCE_LINE 00000035 "our $_outputter_is_null;"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "our $_dumper;"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "our %Global_Hooks;"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "# in Log/ger/Heavy.pm"
NSQ_SOURCE_LINE 00000042 "# our %Default_Hooks = ("
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "our %Package_Targets; # key = package name, value = \\%per_target_conf"
NSQ_SOURCE_LINE 00000045 "our %Per_Package_Hooks; # key = package name, value = { phase => hooks, ... }"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "our %Hash_Targets; # key = hash address, value = [$hashref, \\%per_target_conf]"
NSQ_SOURCE_LINE 00000048 "our %Per_Hash_Hooks; # key = hash address, value = { phase => hooks, ... }"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "our %Object_Targets; # key = object address, value = [$obj, \\%per_target_conf]"
NSQ_SOURCE_LINE 00000051 "our %Per_Object_Hooks; # key = object address, value = { phase => hooks, ... }"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "my $sub0 = sub {0};"
NSQ_SOURCE_LINE 00000054 "my $sub1 = sub {1};"
NSQ_SOURCE_LINE 00000055 "my $default_null_routines;"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "sub install_routines {"
NSQ_SOURCE_LINE 00000058 "    my ($target, $target_arg, $routines, $name_routines) = @_;"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "    if ($name_routines && !defined &subname) {"
NSQ_SOURCE_LINE 00000061 "        if (eval { require Sub::Name; 1 }) {"
NSQ_SOURCE_LINE 00000062 "            *subname = \\&Sub::Name::subname;"
NSQ_SOURCE_LINE 00000063 "        } else {"
NSQ_SOURCE_LINE 00000064 "            *subname = sub {};"
NSQ_SOURCE_LINE 00000065 "        }"
NSQ_SOURCE_LINE 00000066 "    }"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "    if ($target eq 'package') {"
NSQ_SOURCE_LINE 00000069 "#IFUNBUILT"
NSQ_SOURCE_LINE 00000070 "#         no warnings 'redefine';"
NSQ_SOURCE_LINE 00000071 "#END IFUNBUILT"
NSQ_SOURCE_LINE 00000072 "        for my $r (@$routines) {"
NSQ_SOURCE_LINE 00000073 "            my ($code, $name, $lnum, $type) = @$r;"
NSQ_SOURCE_LINE 00000074 "            next unless $type =~ /_sub\\z/;"
NSQ_SOURCE_LINE 00000075 "            #print \"D:installing $name to package $target_arg\\n\";"
NSQ_SOURCE_LINE 00000076 "            *{\"$target_arg\\::$name\"} = $code;"
NSQ_SOURCE_LINE 00000077 "            subname(\"$target_arg\\::$name\", $code) if $name_routines;"
NSQ_SOURCE_LINE 00000078 "        }"
NSQ_SOURCE_LINE 00000079 "    } elsif ($target eq 'object') {"
NSQ_SOURCE_LINE 00000080 "#IFUNBUILT"
NSQ_SOURCE_LINE 00000081 "#         no warnings 'redefine';"
NSQ_SOURCE_LINE 00000082 "#END IFUNBUILT"
NSQ_SOURCE_LINE 00000083 "        my $pkg = ref $target_arg;"
NSQ_SOURCE_LINE 00000084 "        for my $r (@$routines) {"
NSQ_SOURCE_LINE 00000085 "            my ($code, $name, $lnum, $type) = @$r;"
NSQ_SOURCE_LINE 00000086 "            next unless $type =~ /_method\\z/;"
NSQ_SOURCE_LINE 00000087 "            *{\"$pkg\\::$name\"} = $code;"
NSQ_SOURCE_LINE 00000088 "            subname(\"$pkg\\::$name\", $code) if $name_routines;"
NSQ_SOURCE_LINE 00000089 "        }"
NSQ_SOURCE_LINE 00000090 "    } elsif ($target eq 'hash') {"
NSQ_SOURCE_LINE 00000091 "        for my $r (@$routines) {"
NSQ_SOURCE_LINE 00000092 "            my ($code, $name, $lnum, $type) = @$r;"
NSQ_SOURCE_LINE 00000093 "            next unless $type =~ /_sub\\z/;"
NSQ_SOURCE_LINE 00000094 "            $target_arg->{$name} = $code;"
NSQ_SOURCE_LINE 00000095 "        }"
NSQ_SOURCE_LINE 00000096 "    }"
NSQ_SOURCE_LINE 00000097 "}"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "sub add_target {"
NSQ_SOURCE_LINE 00000100 "    my ($target_type, $target_name, $per_target_conf, $replace) = @_;"
NSQ_SOURCE_LINE 00000101 "    $replace = 1 unless defined $replace;"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "    if ($target_type eq 'package') {"
NSQ_SOURCE_LINE 00000104 "        unless ($replace) { return if $Package_Targets{$target_name} }"
NSQ_SOURCE_LINE 00000105 "        $Package_Targets{$target_name} = $per_target_conf;"
NSQ_SOURCE_LINE 00000106 "    } elsif ($target_type eq 'object') {"
NSQ_SOURCE_LINE 00000107 "        my ($addr) = \"$target_name\" =~ $re_addr;"
NSQ_SOURCE_LINE 00000108 "        unless ($replace) { return if $Object_Targets{$addr} }"
NSQ_SOURCE_LINE 00000109 "        $Object_Targets{$addr} = [$target_name, $per_target_conf];"
NSQ_SOURCE_LINE 00000110 "    } elsif ($target_type eq 'hash') {"
NSQ_SOURCE_LINE 00000111 "        my ($addr) = \"$target_name\" =~ $re_addr;"
NSQ_SOURCE_LINE 00000112 "        unless ($replace) { return if $Hash_Targets{$addr} }"
NSQ_SOURCE_LINE 00000113 "        $Hash_Targets{$addr} = [$target_name, $per_target_conf];"
NSQ_SOURCE_LINE 00000114 "    }"
NSQ_SOURCE_LINE 00000115 "}"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "sub _set_default_null_routines {"
NSQ_SOURCE_LINE 00000118 "    $default_null_routines ||= ["
NSQ_SOURCE_LINE 00000119 "        (map {("
NSQ_SOURCE_LINE 00000120 "            [$sub0, \"log_$_\", $Levels{$_}, 'logger_sub'],"
NSQ_SOURCE_LINE 00000121 "            [$Levels{$_} > $Current_Level ? $sub0 : $sub1, \"log_is_$_\", $Levels{$_}, 'level_checker_sub'],"
NSQ_SOURCE_LINE 00000122 "            [$sub0, $_, $Levels{$_}, 'logger_method'],"
NSQ_SOURCE_LINE 00000123 "            [$Levels{$_} > $Current_Level ? $sub0 : $sub1, \"is_$_\", $Levels{$_}, 'level_checker_method'],"
NSQ_SOURCE_LINE 00000124 "        )} keys %Levels),"
NSQ_SOURCE_LINE 00000125 "    ];"
NSQ_SOURCE_LINE 00000126 "}"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "sub get_logger {"
NSQ_SOURCE_LINE 00000129 "    my ($package, %per_target_conf) = @_;"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "    my $caller = caller(0);"
NSQ_SOURCE_LINE 00000132 "    $per_target_conf{category} = $caller"
NSQ_SOURCE_LINE 00000133 "        if !defined($per_target_conf{category});"
NSQ_SOURCE_LINE 00000134 "    my $obj = []; $obj =~ $re_addr;"
NSQ_SOURCE_LINE 00000135 "    my $pkg = \"Log::ger::Obj$1\"; bless $obj, $pkg;"
NSQ_SOURCE_LINE 00000136 "    add_target(object => $obj, \\%per_target_conf);"
NSQ_SOURCE_LINE 00000137 "    if (keys %Global_Hooks) {"
NSQ_SOURCE_LINE 00000138 "        require Log::ger::Heavy;"
NSQ_SOURCE_LINE 00000139 "        init_target(object => $obj, \\%per_target_conf);"
NSQ_SOURCE_LINE 00000140 "    } else {"
NSQ_SOURCE_LINE 00000141 "        # if we haven't added any hooks etc, skip init_target() process and use"
NSQ_SOURCE_LINE 00000142 "        # this preconstructed routines as shortcut, to save startup overhead"
NSQ_SOURCE_LINE 00000143 "        _set_default_null_routines();"
NSQ_SOURCE_LINE 00000144 "        install_routines(object => $obj, $default_null_routines, 0);"
NSQ_SOURCE_LINE 00000145 "    }"
NSQ_SOURCE_LINE 00000146 "    $obj; # XXX add DESTROY to remove from list of targets"
NSQ_SOURCE_LINE 00000147 "}"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "sub _import_to {"
NSQ_SOURCE_LINE 00000150 "    my ($package, $target_pkg, %per_target_conf) = @_;"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "    $per_target_conf{category} = $target_pkg"
NSQ_SOURCE_LINE 00000153 "        if !defined($per_target_conf{category});"
NSQ_SOURCE_LINE 00000154 "    add_target(package => $target_pkg, \\%per_target_conf);"
NSQ_SOURCE_LINE 00000155 "    if (keys %Global_Hooks) {"
NSQ_SOURCE_LINE 00000156 "        require Log::ger::Heavy;"
NSQ_SOURCE_LINE 00000157 "        init_target(package => $target_pkg, \\%per_target_conf);"
NSQ_SOURCE_LINE 00000158 "    } else {"
NSQ_SOURCE_LINE 00000159 "        # if we haven't added any hooks etc, skip init_target() process and use"
NSQ_SOURCE_LINE 00000160 "        # this preconstructed routines as shortcut, to save startup overhead"
NSQ_SOURCE_LINE 00000161 "        _set_default_null_routines();"
NSQ_SOURCE_LINE 00000162 "        install_routines(package => $target_pkg, $default_null_routines, 0);"
NSQ_SOURCE_LINE 00000163 "    }"
NSQ_SOURCE_LINE 00000164 "}"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "sub import {"
NSQ_SOURCE_LINE 00000167 "    my ($package, %per_target_conf) = @_;"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "    my $caller = caller(0);"
NSQ_SOURCE_LINE 00000170 "    $package->_import_to($caller, %per_target_conf);"
NSQ_SOURCE_LINE 00000171 "}"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "1;"
NSQ_SOURCE_LINE 00000174 "# ABSTRACT: A lightweight, flexible logging framework"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "__END__"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "=pod"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "=head1 NAME"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "Log::ger - A lightweight, flexible logging framework"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "=head1 VERSION"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "version 0.042"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "=head2 Producing logs"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "In your module (producer):"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 " package MyModule;"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 " # this will install some logger routines. by default: log_trace, log_debug,"
NSQ_SOURCE_LINE 00000199 " # log_info, log_warn, log_error, and log_fatal. level checker routines are also"
NSQ_SOURCE_LINE 00000200 " # installed: log_is_trace, log_is_debug, and so on."
NSQ_SOURCE_LINE 00000201 " use Log::ger;"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 " sub foo {"
NSQ_SOURCE_LINE 00000204 "     ..."
NSQ_SOURCE_LINE 00000205 "     # produce some logs. no need to configure output or level. by default"
NSQ_SOURCE_LINE 00000206 "     # output goes nowhere."
NSQ_SOURCE_LINE 00000207 "     log_error \"an error occured: %03d - %s\", $errcode, $errmsg;"
NSQ_SOURCE_LINE 00000208 "     ..."
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "     # the logging routines (log_*) can automatically dump data structures"
NSQ_SOURCE_LINE 00000211 "     log_debug \"http response: %s\", $http;"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "     # log_fatal does not die by default, if you want to then die() explicitly."
NSQ_SOURCE_LINE 00000214 "     # but there are plugins that let you do this or provide log_die etc."
NSQ_SOURCE_LINE 00000215 "     if (blah) { log_fatal \"...\"; die }"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "     # use the level checker routines (log_is_*) to avoid doing unnecessary"
NSQ_SOURCE_LINE 00000218 "     # heavy calculation"
NSQ_SOURCE_LINE 00000219 "     if (log_is_trace) {"
NSQ_SOURCE_LINE 00000220 "         my $res = some_heavy_calculation();"
NSQ_SOURCE_LINE 00000221 "         log_trace \"The result is %s\", $res;"
NSQ_SOURCE_LINE 00000222 "     }"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 " }"
NSQ_SOURCE_LINE 00000225 " 1;"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "=head2 Consuming logs"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "=head3 Choosing an output"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "In your application (consumer/listener):"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 " use MyModule;"
NSQ_SOURCE_LINE 00000234 " use Log::ger::Output 'Screen'; # configure output"
NSQ_SOURCE_LINE 00000235 " # level is by default 'warn'"
NSQ_SOURCE_LINE 00000236 " foo(); # the error message is shown, but debug/trace messages are not."
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "=head3 Choosing multiple outputs"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "Instead of screen, you can output to multiple outputs (including multiple"
NSQ_SOURCE_LINE 00000241 "files):"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 " use Log::ger::Output 'Composite' => ("
NSQ_SOURCE_LINE 00000244 "     outputs => {"
NSQ_SOURCE_LINE 00000245 "         Screen => {},"
NSQ_SOURCE_LINE 00000246 "         File   => ["
NSQ_SOURCE_LINE 00000247 "             {conf=>{path=>'/path/to/app.log'}},"
NSQ_SOURCE_LINE 00000248 "             ..."
NSQ_SOURCE_LINE 00000249 "         ],"
NSQ_SOURCE_LINE 00000250 "         ..."
NSQ_SOURCE_LINE 00000251 "     },"
NSQ_SOURCE_LINE 00000252 " );"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "See L<Log::ger::Manual::Tutorial::481_Output_Composite> for more examples."
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "There is also L<Log::ger::App> that wraps this in a simple interface so you just"
NSQ_SOURCE_LINE 00000257 "need to do:"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 " # In your application or script:"
NSQ_SOURCE_LINE 00000260 " use Log::ger::App;"
NSQ_SOURCE_LINE 00000261 " use MyModule;"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "=head3 Choosing level"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "One way to set level:"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 " use Log::ger::Util;"
NSQ_SOURCE_LINE 00000268 " Log::ger::Util::set_level('debug'); # be more verbose"
NSQ_SOURCE_LINE 00000269 " foo(); # the error message as well as debug message are now shown, but the trace is not"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "There are better ways, e.g. letting users configure log level via configuration"
NSQ_SOURCE_LINE 00000272 "file or command-line option. See L<Log::ger::Manual::Tutorial::300_Level> for"
NSQ_SOURCE_LINE 00000273 "more details."
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "Log::ger is yet another logging framework with the following features:"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "=over"
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "=item * Separation of producers and consumers/listeners"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "Like L<Log::Any>, this offers a very easy way for modules to produce some logs"
NSQ_SOURCE_LINE 00000284 "without having to configure anything. Configuring output, level, etc can be done"
NSQ_SOURCE_LINE 00000285 "in the application as log consumers/listeners. To read more about this, see the"
NSQ_SOURCE_LINE 00000286 "documentation of L<Log::Any> or L<Log::ger::Manual> (but nevertheless see"
NSQ_SOURCE_LINE 00000287 "L<Log::ger::Manual> on why you might prefer Log::ger to Log::Any)."
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "=item * Lightweight and fast"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "B<Slim distribution.> No non-core dependencies, extra functionalities are"
NSQ_SOURCE_LINE 00000292 "provided in separate distributions to be pulled as needed."
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "B<Low startup overhead.> Only ~0.5-1ms. For comparison, L<strict> ~0.2-0.5ms,"
NSQ_SOURCE_LINE 00000295 "L<warnings> ~2ms, L<Log::Any> (v0.15) ~2-3ms, Log::Any (v1.049) ~8-10ms,"
NSQ_SOURCE_LINE 00000296 "L<Log::Log4perl> ~35ms. This is measured on a 2014-2015 PC and before doing any"
NSQ_SOURCE_LINE 00000297 "output configuration. I strive to make C<use Log::ger;> statement to be roughly"
NSQ_SOURCE_LINE 00000298 "as light as C<use strict;> or C<use warnings;> so the impact of adding the"
NSQ_SOURCE_LINE 00000299 "statement is really minimal and you can just add logging without much thought to"
NSQ_SOURCE_LINE 00000300 "most of your modules. This is important to me because I want logging to be"
NSQ_SOURCE_LINE 00000301 "pervasive."
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "To test for yourself, try e.g. with L<bencher-code>:"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 " % bencher-code 'use Log::ger' 'use Log::Any' --startup"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "B<Fast>. Low null-/stealth-logging overhead, about 1.5x faster than Log::Any, 3x"
NSQ_SOURCE_LINE 00000308 "faster than Log4perl, 5x faster than L<Log::Fast>, ~40x faster than"
NSQ_SOURCE_LINE 00000309 "L<Log::Contextual>, and ~100x faster than L<Log::Dispatch>."
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "For more benchmarks, see L<Bencher::Scenarios::Log::ger>."
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "B<Conditional compilation.> There is a plugin to optimize away unneeded logging"
NSQ_SOURCE_LINE 00000314 "statements, like assertion/conditional compilation, so they have zero runtime"
NSQ_SOURCE_LINE 00000315 "performance cost. See L<Log::ger::Plugin::OptAway>."
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "Being lightweight means the module can be used more universally, from CLI to"
NSQ_SOURCE_LINE 00000318 "long-running daemons to inside routines with tight loops."
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "=item * Flexible"
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "B<Customizable levels and routine/method names.> Can be used in a procedural or"
NSQ_SOURCE_LINE 00000323 "OO style. Log::ger can mimic the interface of L<Log::Any>, L<Log::Contextual>,"
NSQ_SOURCE_LINE 00000324 "L<Log::Log4perl>, or some other popular logging frameworks, to ease migration or"
NSQ_SOURCE_LINE 00000325 "adjust with your personal style."
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "B<Per-package settings.> Each importer package can use its own format/layout,"
NSQ_SOURCE_LINE 00000328 "output. For example, a module that is migrated from Log::Any uses Log::Any-style"
NSQ_SOURCE_LINE 00000329 "logging, while another uses native Log::ger style, and yet some other uses block"
NSQ_SOURCE_LINE 00000330 "formatting like Log::Contextual. This eases code migration and teamwork. Each"
NSQ_SOURCE_LINE 00000331 "module author can preserve her own logging style, if wanted, and all the modules"
NSQ_SOURCE_LINE 00000332 "still use the same framework."
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "B<Dynamic.> Outputs and levels can be changed anytime during run-time and logger"
NSQ_SOURCE_LINE 00000335 "routines will be updated automatically. This is useful in situation like a"
NSQ_SOURCE_LINE 00000336 "long-running server application: you can turn on tracing logs temporarily to"
NSQ_SOURCE_LINE 00000337 "debug problems, then turn them off again, without restarting your server."
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "B<Interoperability.> There are modules to interop with Log::Any, either consume"
NSQ_SOURCE_LINE 00000340 "Log::Any logs (see L<Log::Any::Adapter::LogGer>) or produce logs to be consumed"
NSQ_SOURCE_LINE 00000341 "by Log::Any (see L<Log::ger::Output::LogAny>)."
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "B<Many output modules and plugins.> See C<Log::ger::Output::*>,"
NSQ_SOURCE_LINE 00000344 "C<Log::ger::Format::*>, C<Log::ger::Layout::*>, C<Log::ger::Plugin::*>. Writing"
NSQ_SOURCE_LINE 00000345 "an output module in Log::ger is easier than writing a Log::Any::Adapter::*."
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "=back"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "For more documentation, start with L<Log::ger::Manual>."
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "=for Pod::Coverage ^(.+)$"
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 "Some other popular logging frameworks: L<Log::Any>, L<Log::Contextual>,"
NSQ_SOURCE_LINE 00000356 "L<Log::Log4perl>, L<Log::Dispatch>, L<Log::Dispatchouli>."
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 "If you still prefer debugging using the good old C<print()>, there's"
NSQ_SOURCE_LINE 00000359 "L<Debug::Print>."
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "perlancar <perlancar@cpan.org>"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "=head1 COPYRIGHT AND LICENSE"
