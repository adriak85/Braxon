BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Data::Section::Simple;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use 5.008_001;"
NSQ_SOURCE_LINE 00000005 "our $VERSION = '0.07';"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "use base qw(Exporter);"
NSQ_SOURCE_LINE 00000008 "our @EXPORT_OK = qw(get_data_section);"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "sub new {"
NSQ_SOURCE_LINE 00000011 "    my($class, $pkg) = @_;"
NSQ_SOURCE_LINE 00000012 "    bless { package => $pkg || caller }, $class;"
NSQ_SOURCE_LINE 00000013 "}"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "sub get_data_section {"
NSQ_SOURCE_LINE 00000016 "    my $self = ref $_[0] ? shift : __PACKAGE__->new(scalar caller);"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "    if (@_) {"
NSQ_SOURCE_LINE 00000019 "        my $all = $self->get_data_section;"
NSQ_SOURCE_LINE 00000020 "        return unless $all;"
NSQ_SOURCE_LINE 00000021 "        return $all->{$_[0]};"
NSQ_SOURCE_LINE 00000022 "    } else {"
NSQ_SOURCE_LINE 00000023 "        my $d = do { no strict 'refs'; \\*{$self->{package}.\"::DATA\"} };"
NSQ_SOURCE_LINE 00000024 "        return unless defined fileno $d;"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "        seek $d, 0, 0;"
NSQ_SOURCE_LINE 00000027 "        my $content = join '', <$d>;"
NSQ_SOURCE_LINE 00000028 "        $content =~ s/^.*\\n__DATA__\\n/\\n/s; # for win32"
NSQ_SOURCE_LINE 00000029 "        $content =~ s/\\n__END__\\n.*$/\\n/s;"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "        my @data = split /^@@\\s+(.+?)\\s*\\r?\\n/m, $content;"
NSQ_SOURCE_LINE 00000032 "        shift @data; # trailing whitespaces"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "        my $all = {};"
NSQ_SOURCE_LINE 00000035 "        while (@data) {"
NSQ_SOURCE_LINE 00000036 "            my ($name, $content) = splice @data, 0, 2;"
NSQ_SOURCE_LINE 00000037 "            $all->{$name} = $content;"
NSQ_SOURCE_LINE 00000038 "        }"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "        return $all;"
NSQ_SOURCE_LINE 00000041 "    }"
NSQ_SOURCE_LINE 00000042 "}"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "1;"
NSQ_SOURCE_LINE 00000045 "__END__"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "=encoding utf-8"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "=for stopwords"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "=head1 NAME"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "Data::Section::Simple - Read data from __DATA__"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "  use Data::Section::Simple qw(get_data_section);"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "  # Functional interface -- reads from caller package __DATA__"
NSQ_SOURCE_LINE 00000060 "  my $all = get_data_section; # All data in hash reference"
NSQ_SOURCE_LINE 00000061 "  my $foo = get_data_section('foo.html');"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "  # OO - allows reading from other packages"
NSQ_SOURCE_LINE 00000064 "  my $reader = Data::Section::Simple->new($package);"
NSQ_SOURCE_LINE 00000065 "  my $all = $reader->get_data_section;"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "  __DATA__"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "  @@ foo.html"
NSQ_SOURCE_LINE 00000070 "  <html>"
NSQ_SOURCE_LINE 00000071 "   <body>Hello</body>"
NSQ_SOURCE_LINE 00000072 "  </html>"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "  @@ bar.tt"
NSQ_SOURCE_LINE 00000075 "  [% IF true %]"
NSQ_SOURCE_LINE 00000076 "    Foo"
NSQ_SOURCE_LINE 00000077 "  [% END %]"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "Data::Section::Simple is a simple module to extract data from"
NSQ_SOURCE_LINE 00000082 "C<__DATA__> section of the file."
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "=head1 LIMITATIONS"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "As the name suggests, this module is a simpler version of the"
NSQ_SOURCE_LINE 00000087 "excellent L<Data::Section>. If you want more functionalities such as"
NSQ_SOURCE_LINE 00000088 "merging data sections or changing header patterns, use"
NSQ_SOURCE_LINE 00000089 "L<Data::Section> instead."
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "This module does not implement caching (yet) which means in every"
NSQ_SOURCE_LINE 00000092 "C<get_data_section> or C<< get_data_section($name) >> this module"
NSQ_SOURCE_LINE 00000093 "seeks and re-reads the data section. If you want to avoid doing so for"
NSQ_SOURCE_LINE 00000094 "the better performance, you should implement caching in your own"
NSQ_SOURCE_LINE 00000095 "caller code."
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "=head1 BUGS"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "=head2 __DATA__ appearing elsewhere"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "If you data section has literal C<__DATA__> in the data section, this"
NSQ_SOURCE_LINE 00000102 "module might be tricked by that. Although since its pattern match is"
NSQ_SOURCE_LINE 00000103 "greedy, C<__DATA__> appearing I<before> the actual data section"
NSQ_SOURCE_LINE 00000104 "(i.e. in the code) might be okay."
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "This is by design -- in theory you can C<tell> the DATA handle before"
NSQ_SOURCE_LINE 00000107 "reading it, but then reloading the data section of the file (handy for"
NSQ_SOURCE_LINE 00000108 "developing inline templates with PSGI web applications) would fail"
NSQ_SOURCE_LINE 00000109 "because the pos would be changed."
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "If you don't like this design, again, use the superior"
NSQ_SOURCE_LINE 00000112 "L<Data::Section>."
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "=head2 utf8 pragma"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "If you enable L<utf8> pragma in the caller's package (or the package"
NSQ_SOURCE_LINE 00000117 "you're inspecting with the OO interface), the data retrieved via"
NSQ_SOURCE_LINE 00000118 "C<get_data_section> is decoded, but otherwise undecoded. There's no"
NSQ_SOURCE_LINE 00000119 "reliable way for this module to programmatically know whether utf8"
NSQ_SOURCE_LINE 00000120 "pragma is enabled or not: it's your responsibility to handle them"
NSQ_SOURCE_LINE 00000121 "correctly."
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "Tatsuhiko Miyagawa E<lt>miyagawa@bulknews.netE<gt>"
