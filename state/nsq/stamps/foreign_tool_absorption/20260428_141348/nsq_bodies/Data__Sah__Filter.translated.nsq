NSQ_SOURCE_LINE 00000001 "package Data::Sah::Filter;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict 'subs', 'vars';"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 "no warnings 'once';"
NSQ_SOURCE_LINE 00000006 "use Log::ger;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use Data::Sah::FilterCommon;"
NSQ_SOURCE_LINE 00000009 "use Exporter qw(import);"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000012 "our $DATE = '2024-07-17'; # DATE"
NSQ_SOURCE_LINE 00000013 "our $DIST = 'Data-Sah-Filter'; # DIST"
NSQ_SOURCE_LINE 00000014 "our $VERSION = '0.025'; # VERSION"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "our @EXPORT_OK = qw(gen_filter);"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "our %SPEC;"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "our $Log_Filter_Code = $ENV{LOG_SAH_FILTER_CODE} // 0;"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "$SPEC{gen_filter} = {"
NSQ_SOURCE_LINE 00000023 "    v => 1.1,"
NSQ_SOURCE_LINE 00000024 "    summary => 'Generate filter code',"
NSQ_SOURCE_LINE 00000025 "    description => <<'_',"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "This is mostly for testing. Normally the filter rules will be used from"
NSQ_SOURCE_LINE 00000028 "<pm:Data::Sah>."
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "_"
NSQ_SOURCE_LINE 00000031 "    args => {"
NSQ_SOURCE_LINE 00000032 "        %Data::Sah::FilterCommon::gen_filter_args,"
NSQ_SOURCE_LINE 00000033 "    },"
NSQ_SOURCE_LINE 00000034 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000035 "};"
NSQ_SOURCE_LINE 00000036 "sub gen_filter {"
NSQ_SOURCE_LINE 00000037 "    my %args = @_;"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "    my $rt = $args{return_type} // 'val';"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "    my $rules = Data::Sah::FilterCommon::get_filter_rules("
NSQ_SOURCE_LINE 00000042 "        %args,"
NSQ_SOURCE_LINE 00000043 "        compiler=>'perl',"
NSQ_SOURCE_LINE 00000044 "        data_term=>'$data',"
NSQ_SOURCE_LINE 00000045 "    );"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "    my $code;"
NSQ_SOURCE_LINE 00000048 "    if (@$rules) {"
NSQ_SOURCE_LINE 00000049 "        my $code_require = '';"
NSQ_SOURCE_LINE 00000050 "        my %mem;"
NSQ_SOURCE_LINE 00000051 "        for my $rule (@$rules) {"
NSQ_SOURCE_LINE 00000052 "            next unless $rule->{modules};"
NSQ_SOURCE_LINE 00000053 "            for my $mod (keys %{$rule->{modules}}) {"
NSQ_SOURCE_LINE 00000054 "                next if $mem{$mod}++;"
NSQ_SOURCE_LINE 00000055 "                $code_require .= \"require $mod;\\n\";"
NSQ_SOURCE_LINE 00000056 "            }"
NSQ_SOURCE_LINE 00000057 "        }"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "        my $code_filter = \"\";"
NSQ_SOURCE_LINE 00000060 "        my $has_defined_tmp;"
NSQ_SOURCE_LINE 00000061 "        for my $rule (@$rules) {"
NSQ_SOURCE_LINE 00000062 "            if ($rule->{meta}{might_fail}) {"
NSQ_SOURCE_LINE 00000063 "                $code_filter .= \"    my \\$tmp;\\n\" unless $has_defined_tmp++;"
NSQ_SOURCE_LINE 00000064 "                $code_filter .= \"    \\$tmp = $rule->{expr_filter};\\n\";"
NSQ_SOURCE_LINE 00000065 "                if ($rt eq 'val') {"
NSQ_SOURCE_LINE 00000066 "                    $code_filter .= \"    return undef if \\$tmp->[0];\\n\";"
NSQ_SOURCE_LINE 00000067 "                } else {"
NSQ_SOURCE_LINE 00000068 "                    $code_filter .= \"    return \\$tmp if \\$tmp->[0];\\n\";"
NSQ_SOURCE_LINE 00000069 "                }"
NSQ_SOURCE_LINE 00000070 "                $code_filter .= \"    \\$data = \\$tmp->[1];\\n\";"
NSQ_SOURCE_LINE 00000071 "            } else {"
NSQ_SOURCE_LINE 00000072 "                $code_filter .= \"    \\$data = $rule->{expr_filter};\\n\";"
NSQ_SOURCE_LINE 00000073 "            }"
NSQ_SOURCE_LINE 00000074 "        }"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "        $code = join("
NSQ_SOURCE_LINE 00000077 "            \"\","
NSQ_SOURCE_LINE 00000078 "            $code_require,"
NSQ_SOURCE_LINE 00000079 "            \"sub {\\n\","
NSQ_SOURCE_LINE 00000080 "            \"    my \\$data = shift;\\n\","
NSQ_SOURCE_LINE 00000081 "            \"    unless (defined \\$data) {\\n\","
NSQ_SOURCE_LINE 00000082 "            \"        return \", ($rt eq 'val' ? \"undef\" : \"[undef, undef]\"), \"\\n\","
NSQ_SOURCE_LINE 00000083 "            \"    }\\n\","
NSQ_SOURCE_LINE 00000084 "            $code_filter, \"\\n\","
NSQ_SOURCE_LINE 00000085 "            \"    \", ($rt eq 'val' ? \"\\$data\" : \"[undef, \\$data]\"), \";\\n\","
NSQ_SOURCE_LINE 00000086 "            \"}\","
NSQ_SOURCE_LINE 00000087 "        );"
NSQ_SOURCE_LINE 00000088 "    } else {"
NSQ_SOURCE_LINE 00000089 "        if ($rt eq 'val') {"
NSQ_SOURCE_LINE 00000090 "            $code = 'sub { $_[0] }';"
NSQ_SOURCE_LINE 00000091 "        } else {"
NSQ_SOURCE_LINE 00000092 "            $code = 'sub { [undef, $_[0]] }';"
NSQ_SOURCE_LINE 00000093 "        }"
NSQ_SOURCE_LINE 00000094 "    }"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "    if ($Log_Filter_Code) {"
NSQ_SOURCE_LINE 00000097 "        log_trace(\"Filter code (gen args: %s): %s\", \\%args, $code);"
NSQ_SOURCE_LINE 00000098 "    }"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "    return $code if $args{source};"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "    my $filter = eval $code; ## no critic: BuiltinFunctions::ProhibitStringyEval"
NSQ_SOURCE_LINE 00000103 "    die if $@;"
NSQ_SOURCE_LINE 00000104 "    $filter;"
NSQ_SOURCE_LINE 00000105 "}"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "1;"
NSQ_SOURCE_LINE 00000108 "# ABSTRACT: Filtering for Data::Sah"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "__END__"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "=pod"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "=head1 NAME"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "Data::Sah::Filter - Filtering for Data::Sah"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "=head1 VERSION"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "This document describes version 0.025 of Data::Sah::Filter (from Perl distribution Data-Sah-Filter), released on 2024-07-17."
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 " use Data::Sah::Filter qw(gen_filter);"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 " # a utility routine: gen_filter"
NSQ_SOURCE_LINE 00000129 " my $c = gen_filter("
NSQ_SOURCE_LINE 00000130 "     filter_names       => ['Str::ltrim', 'Str::rtrim'],"
NSQ_SOURCE_LINE 00000131 " );"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 " my $val = $c->(\"foo\");        # unchanged, \"foo\""
NSQ_SOURCE_LINE 00000134 " my $val = $c->(\" foo \");      # \"foo\""
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "Another example:"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 " my $c = gen_filter("
NSQ_SOURCE_LINE 00000139 "     filter_names       => [ ['Str::remove_comment' => {style=>'shell'}] ],"
NSQ_SOURCE_LINE 00000140 "     #filter_names      => ['Str::remove_comment=style,shell'], # same as above"
NSQ_SOURCE_LINE 00000141 " );"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "This distribution contains a standard set of filter rules for L<Data::Sah> (to"
NSQ_SOURCE_LINE 00000146 "be used in C<prefilters> and C<postfilters> clauses). It is separated from the"
NSQ_SOURCE_LINE 00000147 "C<Data-Sah> distribution and can be used independently."
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "A filter rule is put in C<Data::Sah::Filter::$COMPILER::$CATEGORY:$DESCRIPTION>"
NSQ_SOURCE_LINE 00000150 "module, for example: L<Data::Sah::Filter::perl::Str::trim> for trimming"
NSQ_SOURCE_LINE 00000151 "whitespace at the beginning and end of string."
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "Basically, a filter rule will provide an expression (in C<expr_filter>) in the"
NSQ_SOURCE_LINE 00000154 "target language (e.g. Perl, JavaScript, or others) to convert one data to"
NSQ_SOURCE_LINE 00000155 "another. Multiple filter rules can be combined to form the final filtering code."
NSQ_SOURCE_LINE 00000156 "This code can be used by C<Data::Sah> when generating validator code from L<Sah>"
NSQ_SOURCE_LINE 00000157 "schema, or can be used directly. Some projects which use filtering rules"
NSQ_SOURCE_LINE 00000158 "directly include: L<App::orgadb> (which lets users specify filters from the"
NSQ_SOURCE_LINE 00000159 "command-line)."
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "=head2 meta()"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "The filter rule module must contain C<meta> subroutine which must return a"
NSQ_SOURCE_LINE 00000164 "hashref (L<DefHash>) that has the following keys (C<*> marks that the key is"
NSQ_SOURCE_LINE 00000165 "required):"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "=over"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "=item * v* => int (default: 1)"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "Metadata specification version. From L<DefHash>. Currently at 1."
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "=item * summary => str"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "From L<DefHash>."
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "=item * might_fail => bool"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "Whether coercion might fail, e.g. because of invalid input. If set to 1,"
NSQ_SOURCE_LINE 00000180 "C<expr_filter> key that the C<filter()> routine returns must be an expression"
NSQ_SOURCE_LINE 00000181 "that returns an array (envelope) of C<< (error_msg, data) >> instead of just"
NSQ_SOURCE_LINE 00000182 "filtered data. Error message should be a string that is set when filtering fails"
NSQ_SOURCE_LINE 00000183 "and explains why. Otherwise, if filtering succeeds, the error message string"
NSQ_SOURCE_LINE 00000184 "should be set to undefined value."
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "This is used for filtering rules that act as a data checker."
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "=item * args => hash"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "List of arguments that this filter accepts, in the form of hash where hash keys"
NSQ_SOURCE_LINE 00000191 "are argument names and hash values are argument specifications. Argument"
NSQ_SOURCE_LINE 00000192 "specification is a L<DefHash> similar to argument specification for functions in"
NSQ_SOURCE_LINE 00000193 "L<Rinci::function> specification."
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "=back"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "=head2 filter()"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "The filter rule module must also contain C<filter> subroutine which must"
NSQ_SOURCE_LINE 00000200 "generate the code for filtering. The subroutine must accept a hash of arguments"
NSQ_SOURCE_LINE 00000201 "and will be passed these:"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "=over"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "=item * data_term => str"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "=item * args => hash"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "The arguments for the filter. Hash keys will contain the argument names, while"
NSQ_SOURCE_LINE 00000210 "hash values will contain the argument's values."
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "=back"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "The C<filter> subroutine must return a hashref with the following keys (C<*>"
NSQ_SOURCE_LINE 00000215 "indicates required keys):"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "=over"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "=item * expr_filter* => str"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "Expression in the target language to actually convert data."
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "=item * modules => hash"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "A list of modules required by the expression, where hash keys are module names"
NSQ_SOURCE_LINE 00000226 "and hash values are modules' minimum versions."
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "=back"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "Basically, the C<filter> subroutine must generate a code that accepts a"
NSQ_SOURCE_LINE 00000231 "non-undef data and must convert this data to the desired value."
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "Program/library that uses L<Data::Sah::Filter> can collect rules from the rule"
NSQ_SOURCE_LINE 00000234 "modules then compose them into the final code, something like (in pseudo-Perl"
NSQ_SOURCE_LINE 00000235 "code):"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 " if (!defined $data) {"
NSQ_SOURCE_LINE 00000238 "   return undef;"
NSQ_SOURCE_LINE 00000239 " } else {"
NSQ_SOURCE_LINE 00000240 "   $data = expr-filter-from-rule1($data);"
NSQ_SOURCE_LINE 00000241 "   $data = expr-filter-from-rule2($data);"
NSQ_SOURCE_LINE 00000242 "   ..."
NSQ_SOURCE_LINE 00000243 "   return $data;"
NSQ_SOURCE_LINE 00000244 " }"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "=head2 Filter modules included in this distribution"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "=over"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "=item 1. L<Data::Sah::Filter::js::Str::downcase>"
