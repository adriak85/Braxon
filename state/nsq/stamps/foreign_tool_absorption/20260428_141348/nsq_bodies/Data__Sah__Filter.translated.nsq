NSQ_SOURCE_LINE 00000350 "=head1 VARIABLES"
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "=head2 $Log_Filter_Code => bool (default: from ENV or 0)"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "If set to true, will log the generated filter code (currently using L<Log::ger>"
NSQ_SOURCE_LINE 00000355 "at trace level). To see the log message, e.g. to the screen, you can use"
NSQ_SOURCE_LINE 00000356 "something like:"
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 " % TRACE=1 perl -MLog::ger::LevelFromEnv -MLog::ger::Output=Screen \\"
NSQ_SOURCE_LINE 00000359 "     -MData::Sah::Filter=gen_filter -E'my $c = gen_filter(...)'"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "=head2 gen_filter"
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "Usage:"
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 " gen_filter(%args) -> any"
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "Generate filter code."
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "This is mostly for testing. Normally the filter rules will be used from"
NSQ_SOURCE_LINE 00000373 "L<Data::Sah>."
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "=over 4"
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "=item * B<filter_names>* => I<array[str]>"
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "(No description)"
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "=item * B<return_type> => I<str> (default: \"val\")"
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "(No description)"
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "=back"
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "Return value:  (any)"
NSQ_SOURCE_LINE 00000393 ""
NSQ_SOURCE_LINE 00000394 "=for Pod::Coverage ^(.+)$"
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "=head1 ENVIRONMENT"
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "=head2 LOG_SAH_FILTER_CODE => bool"
NSQ_SOURCE_LINE 00000399 ""
NSQ_SOURCE_LINE 00000400 "Set default for C<$Log_Filter_Code>."
