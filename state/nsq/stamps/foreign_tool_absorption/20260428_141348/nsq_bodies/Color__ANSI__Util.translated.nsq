NSQ_SOURCE_LINE 00000845 ""
NSQ_SOURCE_LINE 00000846 ""
NSQ_SOURCE_LINE 00000847 ""
NSQ_SOURCE_LINE 00000848 "=head2 rgb_to_ansi_bg_code"
NSQ_SOURCE_LINE 00000849 ""
NSQ_SOURCE_LINE 00000850 "Usage:"
NSQ_SOURCE_LINE 00000851 ""
NSQ_SOURCE_LINE 00000852 " rgb_to_ansi_bg_code($color) -> str"
NSQ_SOURCE_LINE 00000853 ""
NSQ_SOURCE_LINE 00000854 "Convert RGB to ANSI color escape sequence to change background color."
NSQ_SOURCE_LINE 00000855 ""
NSQ_SOURCE_LINE 00000856 "Autodetect terminal capability and can return either empty string, 16-color,"
NSQ_SOURCE_LINE 00000857 "256-color, or 24bit-code."
NSQ_SOURCE_LINE 00000858 ""
NSQ_SOURCE_LINE 00000859 "Which color depth used is determined by C<COLOR_DEPTH> environment setting or"
NSQ_SOURCE_LINE 00000860 "from L<Term::Detect::Software> if that module is available). In other words,"
NSQ_SOURCE_LINE 00000861 "this function automatically chooses rgb_to_ansi{24b,256,16}I<bg>code()."
NSQ_SOURCE_LINE 00000862 ""
NSQ_SOURCE_LINE 00000863 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000864 ""
NSQ_SOURCE_LINE 00000865 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000866 ""
NSQ_SOURCE_LINE 00000867 "=over 4"
NSQ_SOURCE_LINE 00000868 ""
NSQ_SOURCE_LINE 00000869 "=item * B<$color>* => I<color::rgb24>"
NSQ_SOURCE_LINE 00000870 ""
NSQ_SOURCE_LINE 00000871 "(No description)"
NSQ_SOURCE_LINE 00000872 ""
NSQ_SOURCE_LINE 00000873 ""
NSQ_SOURCE_LINE 00000874 "=back"
NSQ_SOURCE_LINE 00000875 ""
NSQ_SOURCE_LINE 00000876 "Return value:  (str)"
NSQ_SOURCE_LINE 00000877 ""
NSQ_SOURCE_LINE 00000878 ""
NSQ_SOURCE_LINE 00000879 ""
NSQ_SOURCE_LINE 00000880 "=head2 rgb_to_ansi_fg_code"
NSQ_SOURCE_LINE 00000881 ""
NSQ_SOURCE_LINE 00000882 "Usage:"
NSQ_SOURCE_LINE 00000883 ""
NSQ_SOURCE_LINE 00000884 " rgb_to_ansi_fg_code($color) -> str"
NSQ_SOURCE_LINE 00000885 ""
NSQ_SOURCE_LINE 00000886 "Convert RGB to ANSI color escape sequence to change foreground color."
NSQ_SOURCE_LINE 00000887 ""
NSQ_SOURCE_LINE 00000888 "Autodetect terminal capability and can return either empty string, 16-color,"
NSQ_SOURCE_LINE 00000889 "256-color, or 24bit-code."
NSQ_SOURCE_LINE 00000890 ""
NSQ_SOURCE_LINE 00000891 "Color depth used is determined by C<COLOR_DEPTH> environment setting or from"
NSQ_SOURCE_LINE 00000892 "L<Term::Detect::Software> if that module is available. In other words, this"
NSQ_SOURCE_LINE 00000893 "function automatically chooses rgb_to_ansi{24b,256,16}I<fg>code()."
NSQ_SOURCE_LINE 00000894 ""
NSQ_SOURCE_LINE 00000895 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000896 ""
NSQ_SOURCE_LINE 00000897 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000898 ""
NSQ_SOURCE_LINE 00000899 "=over 4"
NSQ_SOURCE_LINE 00000900 ""
NSQ_SOURCE_LINE 00000901 "=item * B<$color>* => I<color::rgb24>"
NSQ_SOURCE_LINE 00000902 ""
NSQ_SOURCE_LINE 00000903 "(No description)"
NSQ_SOURCE_LINE 00000904 ""
NSQ_SOURCE_LINE 00000905 ""
NSQ_SOURCE_LINE 00000906 "=back"
NSQ_SOURCE_LINE 00000907 ""
NSQ_SOURCE_LINE 00000908 "Return value:  (str)"
NSQ_SOURCE_LINE 00000909 ""
NSQ_SOURCE_LINE 00000910 ""
NSQ_SOURCE_LINE 00000911 "=head2 ansi16fg($rgb) => STR"
NSQ_SOURCE_LINE 00000912 ""
NSQ_SOURCE_LINE 00000913 "Alias for rgb_to_ansi16_fg_code()."
NSQ_SOURCE_LINE 00000914 ""
NSQ_SOURCE_LINE 00000915 "=head2 ansi16bg($rgb) => STR"
NSQ_SOURCE_LINE 00000916 ""
NSQ_SOURCE_LINE 00000917 "Alias for rgb_to_ansi16_bg_code()."
NSQ_SOURCE_LINE 00000918 ""
NSQ_SOURCE_LINE 00000919 "=head2 ansi256fg($rgb) => STR"
NSQ_SOURCE_LINE 00000920 ""
NSQ_SOURCE_LINE 00000921 "Alias for rgb_to_ansi256_fg_code()."
NSQ_SOURCE_LINE 00000922 ""
NSQ_SOURCE_LINE 00000923 "=head2 ansi256bg($rgb) => STR"
NSQ_SOURCE_LINE 00000924 ""
NSQ_SOURCE_LINE 00000925 "Alias for rgb_to_ansi256_bg_code()."
NSQ_SOURCE_LINE 00000926 ""
NSQ_SOURCE_LINE 00000927 "=head2 ansi24bfg($rgb) => STR"
NSQ_SOURCE_LINE 00000928 ""
NSQ_SOURCE_LINE 00000929 "Alias for rgb_to_ansi24b_fg_code()."
NSQ_SOURCE_LINE 00000930 ""
NSQ_SOURCE_LINE 00000931 "=head2 ansi24bbg($rgb) => STR"
NSQ_SOURCE_LINE 00000932 ""
NSQ_SOURCE_LINE 00000933 "Alias for rgb_to_ansi24b_bg_code()."
NSQ_SOURCE_LINE 00000934 ""
NSQ_SOURCE_LINE 00000935 "=head2 rgb_to_ansi_fg_code($rgb) => STR"
NSQ_SOURCE_LINE 00000936 ""
NSQ_SOURCE_LINE 00000937 "=head2 ansifg($rgb) => STR"
NSQ_SOURCE_LINE 00000938 ""
NSQ_SOURCE_LINE 00000939 "Alias for rgb_to_ansi_fg_code()."
NSQ_SOURCE_LINE 00000940 ""
NSQ_SOURCE_LINE 00000941 "=head2 ansibg($rgb) => STR"
NSQ_SOURCE_LINE 00000942 ""
NSQ_SOURCE_LINE 00000943 "Alias for rgb_to_ansi_bg_code()."
NSQ_SOURCE_LINE 00000944 ""
NSQ_SOURCE_LINE 00000945 "=head2 ansi_reset( [ $conditional ])"
NSQ_SOURCE_LINE 00000946 ""
NSQ_SOURCE_LINE 00000947 "Returns \"\\e[0m\", which is the ANSI escape sequence to reset color. Normally you"
NSQ_SOURCE_LINE 00000948 "print this sequence after you print colored text."
NSQ_SOURCE_LINE 00000949 ""
NSQ_SOURCE_LINE 00000950 "If C<$conditional> is set to true, then ansi_reset() will return \"\" if color is"
NSQ_SOURCE_LINE 00000951 "disabled."
NSQ_SOURCE_LINE 00000952 ""
NSQ_SOURCE_LINE 00000953 "=head1 ENVIRONMENT"
NSQ_SOURCE_LINE 00000954 ""
NSQ_SOURCE_LINE 00000955 "=head2 NO_COLOR"
NSQ_SOURCE_LINE 00000956 ""
NSQ_SOURCE_LINE 00000957 "Can be used to explicitly disable color. See L<https://no-color.org> for more"
NSQ_SOURCE_LINE 00000958 "details."
NSQ_SOURCE_LINE 00000959 ""
NSQ_SOURCE_LINE 00000960 "Observed by: ansi{fg,bg}."
NSQ_SOURCE_LINE 00000961 ""
NSQ_SOURCE_LINE 00000962 "=head2 COLOR => bool"
NSQ_SOURCE_LINE 00000963 ""
NSQ_SOURCE_LINE 00000964 "Can be used to explicitly disable color by setting it to 0."
NSQ_SOURCE_LINE 00000965 ""
NSQ_SOURCE_LINE 00000966 "Observed by: ansi{fg,bg}."
NSQ_SOURCE_LINE 00000967 ""
NSQ_SOURCE_LINE 00000968 "=head2 COLOR_DEPTH => INT"
NSQ_SOURCE_LINE 00000969 ""
NSQ_SOURCE_LINE 00000970 "Can be used to explicitly set color depth instead of trying to detect"
NSQ_SOURCE_LINE 00000971 "appropriate color depth."
NSQ_SOURCE_LINE 00000972 ""
NSQ_SOURCE_LINE 00000973 "Observed by: ansi{fg,bg}."
NSQ_SOURCE_LINE 00000974 ""
