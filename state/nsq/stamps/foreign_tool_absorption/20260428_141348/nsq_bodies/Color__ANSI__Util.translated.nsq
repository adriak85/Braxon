NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "sub ansi24bbg { goto &rgb_to_ansi24b_bg_code }"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "our $_use_termdetsw = 1;"
NSQ_SOURCE_LINE 00000412 "our $_color_depth; # cache, can be set during testing"
NSQ_SOURCE_LINE 00000413 "sub _color_depth {"
NSQ_SOURCE_LINE 00000414 "    unless (defined $_color_depth) {"
NSQ_SOURCE_LINE 00000415 "        {"
NSQ_SOURCE_LINE 00000416 "            if (exists $ENV{NO_COLOR}) {"
NSQ_SOURCE_LINE 00000417 "                $_color_depth = 0;"
NSQ_SOURCE_LINE 00000418 "                last;"
NSQ_SOURCE_LINE 00000419 "            }"
NSQ_SOURCE_LINE 00000420 "            if (defined $ENV{COLOR} && !$ENV{COLOR}) {"
NSQ_SOURCE_LINE 00000421 "                $_color_depth = 0;"
NSQ_SOURCE_LINE 00000422 "                last;"
NSQ_SOURCE_LINE 00000423 "            }"
NSQ_SOURCE_LINE 00000424 "            if (defined $ENV{COLOR_DEPTH}) {"
NSQ_SOURCE_LINE 00000425 "                $_color_depth = $ENV{COLOR_DEPTH};"
NSQ_SOURCE_LINE 00000426 "                last;"
NSQ_SOURCE_LINE 00000427 "            }"
NSQ_SOURCE_LINE 00000428 "            if ($_use_termdetsw) {"
NSQ_SOURCE_LINE 00000429 "                {"
NSQ_SOURCE_LINE 00000430 "                    local $@; local $SIG{__DIE__};"
NSQ_SOURCE_LINE 00000431 "                    eval { require Term::Detect::Software };"
NSQ_SOURCE_LINE 00000432 "                    unless ($@) {"
NSQ_SOURCE_LINE 00000433 "                        $_color_depth = Term::Detect::Software::detect_terminal_cached()->{color_depth};"
NSQ_SOURCE_LINE 00000434 "                        last;"
NSQ_SOURCE_LINE 00000435 "                    }"
NSQ_SOURCE_LINE 00000436 "                };"
NSQ_SOURCE_LINE 00000437 "            }"
NSQ_SOURCE_LINE 00000438 "            # simple heuristic"
NSQ_SOURCE_LINE 00000439 "            if ($ENV{KONSOLE_DBUS_SERVICE}) {"
NSQ_SOURCE_LINE 00000440 "                $_color_depth = 2**24;"
NSQ_SOURCE_LINE 00000441 "                last;"
NSQ_SOURCE_LINE 00000442 "            }"
NSQ_SOURCE_LINE 00000443 "            # safe value"
NSQ_SOURCE_LINE 00000444 "            $_color_depth = 16;"
NSQ_SOURCE_LINE 00000445 "        }"
NSQ_SOURCE_LINE 00000446 "    };"
NSQ_SOURCE_LINE 00000447 "    $_color_depth;"
NSQ_SOURCE_LINE 00000448 "}"
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "$SPEC{rgb_to_ansi_fg_code} = {"
NSQ_SOURCE_LINE 00000451 "    v => 1.1,"
NSQ_SOURCE_LINE 00000452 "    summary => 'Convert RGB to ANSI color escape sequence to change foreground color',"
NSQ_SOURCE_LINE 00000453 "    description => <<'_',"
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 "Autodetect terminal capability and can return either empty string, 16-color,"
NSQ_SOURCE_LINE 00000456 "256-color, or 24bit-code."
NSQ_SOURCE_LINE 00000457 ""
NSQ_SOURCE_LINE 00000458 "Color depth used is determined by `COLOR_DEPTH` environment setting or from"
NSQ_SOURCE_LINE 00000459 "<pm:Term::Detect::Software> if that module is available. In other words, this"
NSQ_SOURCE_LINE 00000460 "function automatically chooses rgb_to_ansi{24b,256,16}_fg_code()."
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 "_"
NSQ_SOURCE_LINE 00000463 "    args => {"
NSQ_SOURCE_LINE 00000464 "        color => {"
NSQ_SOURCE_LINE 00000465 "            schema => 'color::rgb24*',"
NSQ_SOURCE_LINE 00000466 "            req => 1,"
NSQ_SOURCE_LINE 00000467 "            pos => 0,"
NSQ_SOURCE_LINE 00000468 "        },"
NSQ_SOURCE_LINE 00000469 "    },"
NSQ_SOURCE_LINE 00000470 "    args_as => 'array',"
NSQ_SOURCE_LINE 00000471 "    result => {"
NSQ_SOURCE_LINE 00000472 "        schema => 'str*',"
NSQ_SOURCE_LINE 00000473 "    },"
NSQ_SOURCE_LINE 00000474 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000475 "};"
NSQ_SOURCE_LINE 00000476 "sub rgb_to_ansi_fg_code {"
NSQ_SOURCE_LINE 00000477 "    my ($rgb) = @_;"
NSQ_SOURCE_LINE 00000478 "    my $cd = _color_depth();"
NSQ_SOURCE_LINE 00000479 "    if ($cd >= 2**24) {"
NSQ_SOURCE_LINE 00000480 "        rgb_to_ansi24b_fg_code($rgb);"
NSQ_SOURCE_LINE 00000481 "    } elsif ($cd >= 256) {"
NSQ_SOURCE_LINE 00000482 "        rgb_to_ansi256_fg_code($rgb);"
NSQ_SOURCE_LINE 00000483 "    } elsif ($cd >= 16) {"
NSQ_SOURCE_LINE 00000484 "        rgb_to_ansi16_fg_code($rgb);"
NSQ_SOURCE_LINE 00000485 "    } else {"
NSQ_SOURCE_LINE 00000486 "        \"\";"
NSQ_SOURCE_LINE 00000487 "    }"
NSQ_SOURCE_LINE 00000488 "}"
NSQ_SOURCE_LINE 00000489 ""
NSQ_SOURCE_LINE 00000490 "sub ansifg { goto &rgb_to_ansi_fg_code }"
NSQ_SOURCE_LINE 00000491 ""
NSQ_SOURCE_LINE 00000492 "$SPEC{rgb_to_ansi_bg_code} = {"
NSQ_SOURCE_LINE 00000493 "    v => 1.1,"
NSQ_SOURCE_LINE 00000494 "    summary => 'Convert RGB to ANSI color escape sequence to change background color',"
NSQ_SOURCE_LINE 00000495 "    description => <<'_',"
NSQ_SOURCE_LINE 00000496 ""
NSQ_SOURCE_LINE 00000497 "Autodetect terminal capability and can return either empty string, 16-color,"
NSQ_SOURCE_LINE 00000498 "256-color, or 24bit-code."
NSQ_SOURCE_LINE 00000499 ""
NSQ_SOURCE_LINE 00000500 "Which color depth used is determined by `COLOR_DEPTH` environment setting or"
NSQ_SOURCE_LINE 00000501 "from <pm:Term::Detect::Software> if that module is available). In other words,"
NSQ_SOURCE_LINE 00000502 "this function automatically chooses rgb_to_ansi{24b,256,16}_bg_code()."
NSQ_SOURCE_LINE 00000503 ""
NSQ_SOURCE_LINE 00000504 "_"
NSQ_SOURCE_LINE 00000505 "    args => {"
NSQ_SOURCE_LINE 00000506 "        color => {"
NSQ_SOURCE_LINE 00000507 "            schema => 'color::rgb24*',"
NSQ_SOURCE_LINE 00000508 "            req => 1,"
NSQ_SOURCE_LINE 00000509 "            pos => 0,"
NSQ_SOURCE_LINE 00000510 "        },"
NSQ_SOURCE_LINE 00000511 "    },"
NSQ_SOURCE_LINE 00000512 "    args_as => 'array',"
NSQ_SOURCE_LINE 00000513 "    result => {"
NSQ_SOURCE_LINE 00000514 "        schema => 'str*',"
NSQ_SOURCE_LINE 00000515 "    },"
NSQ_SOURCE_LINE 00000516 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000517 "};"
NSQ_SOURCE_LINE 00000518 "sub rgb_to_ansi_bg_code {"
NSQ_SOURCE_LINE 00000519 "    my ($rgb) = @_;"
NSQ_SOURCE_LINE 00000520 "    my $cd = _color_depth();"
NSQ_SOURCE_LINE 00000521 "    if ($cd >= 2**24) {"
NSQ_SOURCE_LINE 00000522 "        rgb_to_ansi24b_bg_code($rgb);"
NSQ_SOURCE_LINE 00000523 "    } elsif ($cd >= 256) {"
NSQ_SOURCE_LINE 00000524 "        rgb_to_ansi256_bg_code($rgb);"
NSQ_SOURCE_LINE 00000525 "    } else {"
NSQ_SOURCE_LINE 00000526 "        rgb_to_ansi16_bg_code($rgb);"
NSQ_SOURCE_LINE 00000527 "    }"
NSQ_SOURCE_LINE 00000528 "}"
NSQ_SOURCE_LINE 00000529 ""
NSQ_SOURCE_LINE 00000530 "sub ansibg { goto &rgb_to_ansi_bg_code }"
NSQ_SOURCE_LINE 00000531 ""
NSQ_SOURCE_LINE 00000532 "sub ansi_reset {"
NSQ_SOURCE_LINE 00000533 "    my $conditional = shift;"
NSQ_SOURCE_LINE 00000534 "    if ($conditional) {"
NSQ_SOURCE_LINE 00000535 "        my $cd = _color_depth();"
NSQ_SOURCE_LINE 00000536 "        return \"\" if $cd < 16;"
NSQ_SOURCE_LINE 00000537 "    }"
NSQ_SOURCE_LINE 00000538 "    \"\\e[0m\";"
NSQ_SOURCE_LINE 00000539 "}"
NSQ_SOURCE_LINE 00000540 ""
NSQ_SOURCE_LINE 00000541 "1;"
NSQ_SOURCE_LINE 00000542 "# ABSTRACT: Routines for dealing with ANSI colors"
NSQ_SOURCE_LINE 00000543 ""
NSQ_SOURCE_LINE 00000544 "__END__"
NSQ_SOURCE_LINE 00000545 ""
NSQ_SOURCE_LINE 00000546 "=pod"
NSQ_SOURCE_LINE 00000547 ""
NSQ_SOURCE_LINE 00000548 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000549 ""
NSQ_SOURCE_LINE 00000550 "=head1 NAME"
NSQ_SOURCE_LINE 00000551 ""
NSQ_SOURCE_LINE 00000552 "Color::ANSI::Util - Routines for dealing with ANSI colors"
NSQ_SOURCE_LINE 00000553 ""
NSQ_SOURCE_LINE 00000554 "=head1 VERSION"
NSQ_SOURCE_LINE 00000555 ""
NSQ_SOURCE_LINE 00000556 "This document describes version 0.165 of Color::ANSI::Util (from Perl distribution Color-ANSI-Util), released on 2024-02-23."
NSQ_SOURCE_LINE 00000557 ""
NSQ_SOURCE_LINE 00000558 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000559 ""
NSQ_SOURCE_LINE 00000560 " use Color::ANSI::Util qw("
NSQ_SOURCE_LINE 00000561 "     ansifg"
NSQ_SOURCE_LINE 00000562 "     ansibg"
NSQ_SOURCE_LINE 00000563 " );"
NSQ_SOURCE_LINE 00000564 ""
NSQ_SOURCE_LINE 00000565 " say ansifg(\"f0c010\"); # => \"\\e[33;1m\" (on 16-color terminal)"
NSQ_SOURCE_LINE 00000566 "                       # => \"\\e[38;5;11m\" (on 256-color terminal)"
NSQ_SOURCE_LINE 00000567 "                       # => \"\\e[38;2;240;192;16m\" (on 24-bit-color terminal)"
NSQ_SOURCE_LINE 00000568 ""
NSQ_SOURCE_LINE 00000569 " say ansibg(\"ff5f87\"); # => \"\\e[47m\" (on 16-color terminal)"
NSQ_SOURCE_LINE 00000570 "                       # => \"\\e[48;5;7m\" (on 256-color terminal)"
NSQ_SOURCE_LINE 00000571 "                       # => \"\\e[48;2;255;95;135m\" (on 24-bit-color terminal)"
NSQ_SOURCE_LINE 00000572 ""
NSQ_SOURCE_LINE 00000573 "There are a bunch of other exportable functions too, mostly for converting"
NSQ_SOURCE_LINE 00000574 "between RGB and ANSI color (16/256/24bit color depth)."
NSQ_SOURCE_LINE 00000575 ""
NSQ_SOURCE_LINE 00000576 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000577 ""
NSQ_SOURCE_LINE 00000578 "This module provides routines for dealing with ANSI colors. The two main"
NSQ_SOURCE_LINE 00000579 "functions are C<ansifg> and C<ansibg>. With those functions, you can specify"
NSQ_SOURCE_LINE 00000580 "colors in RGB and let it output the correct ANSI color escape code according to"
NSQ_SOURCE_LINE 00000581 "the color depth support of the terminal (whether 16-color, 256-color, or 24bit)."
NSQ_SOURCE_LINE 00000582 "There are other functions to convert RGB to ANSI in specific color depths, or"
NSQ_SOURCE_LINE 00000583 "reverse functions to convert from ANSI to RGB codes."
NSQ_SOURCE_LINE 00000584 ""
NSQ_SOURCE_LINE 00000585 "Keywords: xterm, xterm-256color, terminal"
NSQ_SOURCE_LINE 00000586 ""
NSQ_SOURCE_LINE 00000587 "=head1 BUGS/NOTES"
NSQ_SOURCE_LINE 00000588 ""
NSQ_SOURCE_LINE 00000589 "Algorithm for finding closest indexed color from RGB color currently not very"
NSQ_SOURCE_LINE 00000590 "efficient. Probably can add some threshold square distance, below which we can"
NSQ_SOURCE_LINE 00000591 "shortcut to the final answer."
NSQ_SOURCE_LINE 00000592 ""
NSQ_SOURCE_LINE 00000593 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000594 ""
NSQ_SOURCE_LINE 00000595 ""
NSQ_SOURCE_LINE 00000596 "=head2 ansi16_to_rgb"
NSQ_SOURCE_LINE 00000597 ""
NSQ_SOURCE_LINE 00000598 "Usage:"
NSQ_SOURCE_LINE 00000599 ""
NSQ_SOURCE_LINE 00000600 " ansi16_to_rgb($color) -> color::rgb24"
NSQ_SOURCE_LINE 00000601 ""
NSQ_SOURCE_LINE 00000602 "Convert ANSI-16 color to RGB."
NSQ_SOURCE_LINE 00000603 ""
NSQ_SOURCE_LINE 00000604 "Returns 6-hexdigit, e.g. 'ff00cc'."
NSQ_SOURCE_LINE 00000605 ""
NSQ_SOURCE_LINE 00000606 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000607 ""
NSQ_SOURCE_LINE 00000608 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000609 ""
NSQ_SOURCE_LINE 00000610 "=over 4"
NSQ_SOURCE_LINE 00000611 ""
NSQ_SOURCE_LINE 00000612 "=item * B<$color>* => I<color::ansi16>"
NSQ_SOURCE_LINE 00000613 ""
NSQ_SOURCE_LINE 00000614 "(No description)"
NSQ_SOURCE_LINE 00000615 ""
NSQ_SOURCE_LINE 00000616 ""
NSQ_SOURCE_LINE 00000617 "=back"
NSQ_SOURCE_LINE 00000618 ""
NSQ_SOURCE_LINE 00000619 "Return value:  (color::rgb24)"
NSQ_SOURCE_LINE 00000620 ""
NSQ_SOURCE_LINE 00000621 ""
NSQ_SOURCE_LINE 00000622 ""
