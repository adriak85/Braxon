NSQ_SOURCE_LINE 00000824 ""
NSQ_SOURCE_LINE 00000825 "Usage:"
NSQ_SOURCE_LINE 00000826 ""
NSQ_SOURCE_LINE 00000827 " rgb_to_ansi256_fg_code($color) -> str"
NSQ_SOURCE_LINE 00000828 ""
NSQ_SOURCE_LINE 00000829 "Convert RGB to ANSI-256 color escape sequence to change foreground color."
NSQ_SOURCE_LINE 00000830 ""
NSQ_SOURCE_LINE 00000831 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000832 ""
NSQ_SOURCE_LINE 00000833 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000834 ""
NSQ_SOURCE_LINE 00000835 "=over 4"
NSQ_SOURCE_LINE 00000836 ""
NSQ_SOURCE_LINE 00000837 "=item * B<$color>* => I<color::rgb24>"
NSQ_SOURCE_LINE 00000838 ""
NSQ_SOURCE_LINE 00000839 "(No description)"
NSQ_SOURCE_LINE 00000840 ""
NSQ_SOURCE_LINE 00000841 ""
NSQ_SOURCE_LINE 00000842 "=back"
NSQ_SOURCE_LINE 00000843 ""
