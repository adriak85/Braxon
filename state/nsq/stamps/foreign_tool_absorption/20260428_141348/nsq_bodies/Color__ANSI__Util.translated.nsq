NSQ_SOURCE_LINE 00000784 ""
NSQ_SOURCE_LINE 00000785 "=over 4"
NSQ_SOURCE_LINE 00000786 ""
NSQ_SOURCE_LINE 00000787 "=item * B<$color>* => I<color::rgb24>"
NSQ_SOURCE_LINE 00000788 ""
NSQ_SOURCE_LINE 00000789 "(No description)"
NSQ_SOURCE_LINE 00000790 ""
NSQ_SOURCE_LINE 00000791 ""
NSQ_SOURCE_LINE 00000792 "=back"
NSQ_SOURCE_LINE 00000793 ""
NSQ_SOURCE_LINE 00000794 "Return value:  (color::ansi256)"
NSQ_SOURCE_LINE 00000795 ""
NSQ_SOURCE_LINE 00000796 ""
NSQ_SOURCE_LINE 00000797 ""
