NSQ_SOURCE_LINE 00000773 "=head2 rgb_to_ansi256"
NSQ_SOURCE_LINE 00000774 ""
NSQ_SOURCE_LINE 00000775 "Usage:"
NSQ_SOURCE_LINE 00000776 ""
NSQ_SOURCE_LINE 00000777 " rgb_to_ansi256($color) -> color::ansi256"
NSQ_SOURCE_LINE 00000778 ""
NSQ_SOURCE_LINE 00000779 "Convert RGB to ANSI-256 color."
NSQ_SOURCE_LINE 00000780 ""
