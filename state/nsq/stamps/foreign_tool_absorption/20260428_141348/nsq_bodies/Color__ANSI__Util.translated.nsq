NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "$SPEC{rgb_to_ansi16_fg_code} = {"
NSQ_SOURCE_LINE 00000258 "    v => 1.1,"
NSQ_SOURCE_LINE 00000259 "    summary => 'Convert RGB to ANSI-16 color escape sequence to change foreground color',"
NSQ_SOURCE_LINE 00000260 "    args => {"
NSQ_SOURCE_LINE 00000261 "        color => {"
NSQ_SOURCE_LINE 00000262 "            schema => 'color::rgb24*',"
NSQ_SOURCE_LINE 00000263 "            req => 1,"
NSQ_SOURCE_LINE 00000264 "            pos => 0,"
NSQ_SOURCE_LINE 00000265 "        },"
NSQ_SOURCE_LINE 00000266 "    },"
NSQ_SOURCE_LINE 00000267 "    args_as => 'array',"
NSQ_SOURCE_LINE 00000268 "    result => {"
NSQ_SOURCE_LINE 00000269 "        schema => 'str*',"
NSQ_SOURCE_LINE 00000270 "    },"
NSQ_SOURCE_LINE 00000271 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000272 "};"
NSQ_SOURCE_LINE 00000273 "sub rgb_to_ansi16_fg_code {"
NSQ_SOURCE_LINE 00000274 "    my ($input) = @_;"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "    my $res = _rgb_to_indexed($input, \\@revansi16);"
NSQ_SOURCE_LINE 00000277 "    return \"\\e[\" . ($res >= 8 ? ($res+30-8) . \";1\" : ($res+30)) . \"m\";"
NSQ_SOURCE_LINE 00000278 "}"
NSQ_SOURCE_LINE 00000279 ""
