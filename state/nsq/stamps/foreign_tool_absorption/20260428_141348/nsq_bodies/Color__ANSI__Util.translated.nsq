NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "$SPEC{ansi16_to_rgb} = {"
NSQ_SOURCE_LINE 00000119 "    v => 1.1,"
NSQ_SOURCE_LINE 00000120 "    summary => 'Convert ANSI-16 color to RGB',"
NSQ_SOURCE_LINE 00000121 "    description => <<'_',"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "Returns 6-hexdigit, e.g. 'ff00cc'."
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "_"
NSQ_SOURCE_LINE 00000126 "    args => {"
NSQ_SOURCE_LINE 00000127 "        color => {"
NSQ_SOURCE_LINE 00000128 "            schema => 'color::ansi16*',"
NSQ_SOURCE_LINE 00000129 "            req => 1,"
NSQ_SOURCE_LINE 00000130 "            pos => 0,"
NSQ_SOURCE_LINE 00000131 "        },"
NSQ_SOURCE_LINE 00000132 "    },"
NSQ_SOURCE_LINE 00000133 "    args_as => 'array',"
NSQ_SOURCE_LINE 00000134 "    result => {"
NSQ_SOURCE_LINE 00000135 "        schema => 'color::rgb24*',"
NSQ_SOURCE_LINE 00000136 "    },"
NSQ_SOURCE_LINE 00000137 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000138 "};"
NSQ_SOURCE_LINE 00000139 "sub ansi16_to_rgb {"
NSQ_SOURCE_LINE 00000140 "    my ($input) = @_;"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "    if ($input =~ /^\\d+$/) {"
NSQ_SOURCE_LINE 00000143 "        if ($input >= 0 && $input <= 15) {"
NSQ_SOURCE_LINE 00000144 "            return $ansi16{$input + 0}; # to remove prefix zero e.g. \"06\""
NSQ_SOURCE_LINE 00000145 "        } else {"
NSQ_SOURCE_LINE 00000146 "            die \"Invalid ANSI 16-color number '$input'\";"
NSQ_SOURCE_LINE 00000147 "        }"
NSQ_SOURCE_LINE 00000148 "    } elsif ($input =~ /^(?:(bold|bright) \\s )?(black|red|green|yellow|blue|magenta|cyan|white)$/ix) {"
NSQ_SOURCE_LINE 00000149 "        my ($bold, $col) = (lc($1 // \"\"), lc($2));"
NSQ_SOURCE_LINE 00000150 "        my $i;"
NSQ_SOURCE_LINE 00000151 "        if ($col eq 'black') {"
NSQ_SOURCE_LINE 00000152 "            $i = 0;"
NSQ_SOURCE_LINE 00000153 "        } elsif ($col eq 'red') {"
NSQ_SOURCE_LINE 00000154 "            $i = 1;"
NSQ_SOURCE_LINE 00000155 "        } elsif ($col eq 'green') {"
NSQ_SOURCE_LINE 00000156 "            $i = 2;"
NSQ_SOURCE_LINE 00000157 "        } elsif ($col eq 'yellow') {"
NSQ_SOURCE_LINE 00000158 "            $i = 3;"
NSQ_SOURCE_LINE 00000159 "        } elsif ($col eq 'blue') {"
NSQ_SOURCE_LINE 00000160 "            $i = 4;"
NSQ_SOURCE_LINE 00000161 "        } elsif ($col eq 'magenta') {"
NSQ_SOURCE_LINE 00000162 "            $i = 5;"
NSQ_SOURCE_LINE 00000163 "        } elsif ($col eq 'cyan') {"
NSQ_SOURCE_LINE 00000164 "            $i = 6;"
NSQ_SOURCE_LINE 00000165 "        } elsif ($col eq 'white') {"
NSQ_SOURCE_LINE 00000166 "            $i = 7;"
NSQ_SOURCE_LINE 00000167 "        }"
NSQ_SOURCE_LINE 00000168 "        $i += 8 if $bold;"
NSQ_SOURCE_LINE 00000169 "        return $ansi16{$i};"
NSQ_SOURCE_LINE 00000170 "    } else {"
NSQ_SOURCE_LINE 00000171 "        die \"Invalid ANSI 16-color name '$input'\";"
NSQ_SOURCE_LINE 00000172 "    }"
NSQ_SOURCE_LINE 00000173 "}"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "sub _rgb_to_indexed {"
NSQ_SOURCE_LINE 00000176 "    my ($rgb, $table) = @_;"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "    my ($smallest_diff, $res);"
NSQ_SOURCE_LINE 00000179 "    for my $e (@$table) {"
NSQ_SOURCE_LINE 00000180 "        my $diff = rgb_diff($rgb, $e->[0], 'hsv_hue1');"
NSQ_SOURCE_LINE 00000181 "        # exact match, return immediately"
NSQ_SOURCE_LINE 00000182 "        return $e->[1] if $diff == 0;"
NSQ_SOURCE_LINE 00000183 "        if (!defined($smallest_diff) || $smallest_diff > $diff) {"
NSQ_SOURCE_LINE 00000184 "            $smallest_diff = $diff;"
NSQ_SOURCE_LINE 00000185 "            $res = $e->[1];"
NSQ_SOURCE_LINE 00000186 "        }"
NSQ_SOURCE_LINE 00000187 "    }"
NSQ_SOURCE_LINE 00000188 "    return $res;"
NSQ_SOURCE_LINE 00000189 "}"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "$SPEC{ansi256_to_rgb} = {"
NSQ_SOURCE_LINE 00000192 "    v => 1.1,"
NSQ_SOURCE_LINE 00000193 "    summary => 'Convert ANSI-256 color to RGB',"
NSQ_SOURCE_LINE 00000194 "    args => {"
NSQ_SOURCE_LINE 00000195 "        color => {"
NSQ_SOURCE_LINE 00000196 "            schema => 'color::ansi256*',"
NSQ_SOURCE_LINE 00000197 "            req => 1,"
NSQ_SOURCE_LINE 00000198 "            pos => 0,"
NSQ_SOURCE_LINE 00000199 "        },"
NSQ_SOURCE_LINE 00000200 "    },"
NSQ_SOURCE_LINE 00000201 "    args_as => 'array',"
NSQ_SOURCE_LINE 00000202 "    result => {"
NSQ_SOURCE_LINE 00000203 "        schema => 'color::rgb24',"
NSQ_SOURCE_LINE 00000204 "    },"
NSQ_SOURCE_LINE 00000205 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000206 "};"
NSQ_SOURCE_LINE 00000207 "sub ansi256_to_rgb {"
NSQ_SOURCE_LINE 00000208 "    my ($input) = @_;"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "    $input += 0;"
NSQ_SOURCE_LINE 00000211 "    exists($ansi256{$input}) or die \"Invalid ANSI 256-color index '$input'\";"
NSQ_SOURCE_LINE 00000212 "    $ansi256{$input};"
NSQ_SOURCE_LINE 00000213 "}"
