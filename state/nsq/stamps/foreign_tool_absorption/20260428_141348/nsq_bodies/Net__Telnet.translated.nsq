NSQ_SOURCE_LINE 00001131 "sub localfamily {"
NSQ_SOURCE_LINE 00001132 "    my ($self, $family) = @_;"
NSQ_SOURCE_LINE 00001133 "    my ("
NSQ_SOURCE_LINE 00001134 "        $prev,"
NSQ_SOURCE_LINE 00001135 "        $s,"
NSQ_SOURCE_LINE 00001136 "        );"
NSQ_SOURCE_LINE 00001137 ""
NSQ_SOURCE_LINE 00001138 "    $s = *$self->{net_telnet};"
NSQ_SOURCE_LINE 00001139 "    $prev = $s->{local_family};"
NSQ_SOURCE_LINE 00001140 ""
NSQ_SOURCE_LINE 00001141 "    if (@_ >= 2) {"
NSQ_SOURCE_LINE 00001142 "        unless (defined $family) {"
NSQ_SOURCE_LINE 00001143 "            $family = \"\";"
NSQ_SOURCE_LINE 00001144 "        }"
NSQ_SOURCE_LINE 00001145 ""
NSQ_SOURCE_LINE 00001146 "        if ($family =~ /^\\s*ipv4\\s*$/i) {  # family arg is \"ipv4\""
NSQ_SOURCE_LINE 00001147 "            $s->{local_family} = \"ipv4\";"
NSQ_SOURCE_LINE 00001148 "        }"
NSQ_SOURCE_LINE 00001149 "        elsif ($family =~ /^\\s*any\\s*$/i) {  # family arg is \"any\""
NSQ_SOURCE_LINE 00001150 "            if ($Socket::VERSION ge \"1.94\" and defined $AF_INET6) {  # has IPv6"
NSQ_SOURCE_LINE 00001151 "                $s->{local_family} = \"any\";"
NSQ_SOURCE_LINE 00001152 "            }"
NSQ_SOURCE_LINE 00001153 "            else {  # IPv6 not supported on this machine"
NSQ_SOURCE_LINE 00001154 "                $s->{local_family} = \"ipv4\";"
NSQ_SOURCE_LINE 00001155 "            }"
NSQ_SOURCE_LINE 00001156 "        }"
NSQ_SOURCE_LINE 00001157 "        elsif ($family =~ /^\\s*ipv6\\s*$/i) {  # family arg is \"ipv6\""
NSQ_SOURCE_LINE 00001158 "            return $self->error(\"Localfamily arg ipv6 not supported when \" ."
NSQ_SOURCE_LINE 00001159 "                                \"Socket.pm version < 1.94\")"
NSQ_SOURCE_LINE 00001160 "                unless $Socket::VERSION ge \"1.94\";"
NSQ_SOURCE_LINE 00001161 "            return $self->error(\"Localfamily arg ipv6 not supported by \" ."
NSQ_SOURCE_LINE 00001162 "                                \"this OS: AF_INET6 not in Socket.pm\")"
NSQ_SOURCE_LINE 00001163 "                unless defined $AF_INET6;"
NSQ_SOURCE_LINE 00001164 ""
NSQ_SOURCE_LINE 00001165 "            $s->{local_family} = \"ipv6\";"
NSQ_SOURCE_LINE 00001166 "        }"
NSQ_SOURCE_LINE 00001167 "        else {"
NSQ_SOURCE_LINE 00001168 "            return $self->error(\"bad Localfamily argument \\\"$family\\\": \" ."
NSQ_SOURCE_LINE 00001169 "                                \"must be \\\"ipv4\\\", \\\"ipv6\\\", or \\\"any\\\"\");"
NSQ_SOURCE_LINE 00001170 "        }"
NSQ_SOURCE_LINE 00001171 "    }"
NSQ_SOURCE_LINE 00001172 ""
NSQ_SOURCE_LINE 00001173 "    $prev;"
NSQ_SOURCE_LINE 00001174 "} # end sub localfamily"
NSQ_SOURCE_LINE 00001175 ""
