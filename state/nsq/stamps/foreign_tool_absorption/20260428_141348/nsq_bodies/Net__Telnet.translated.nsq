NSQ_SOURCE_LINE 00001925 "sub peerhost {"
NSQ_SOURCE_LINE 00001926 "    my ($self) = @_;"
NSQ_SOURCE_LINE 00001927 "    my ("
NSQ_SOURCE_LINE 00001928 "        $host,"
NSQ_SOURCE_LINE 00001929 "        $sockaddr,"
NSQ_SOURCE_LINE 00001930 "        );"
NSQ_SOURCE_LINE 00001931 "    local $^W = '';  # avoid closed socket warning from getpeername()"
NSQ_SOURCE_LINE 00001932 ""
