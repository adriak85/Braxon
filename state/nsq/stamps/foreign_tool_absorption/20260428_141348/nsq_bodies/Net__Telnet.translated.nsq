NSQ_SOURCE_LINE 00002486 "    die $s->{errormsg}, \"\\n\";"
NSQ_SOURCE_LINE 00002487 "} # end sub _croak"
NSQ_SOURCE_LINE 00002488 ""
NSQ_SOURCE_LINE 00002489 ""
NSQ_SOURCE_LINE 00002490 "sub _endtime {"
NSQ_SOURCE_LINE 00002491 "    my ($interval) = @_;"
NSQ_SOURCE_LINE 00002492 ""
NSQ_SOURCE_LINE 00002493 "    ## Compute wall time when timeout occurs."
NSQ_SOURCE_LINE 00002494 "    if (defined $interval) {"
NSQ_SOURCE_LINE 00002495 "        if ($interval >= $^T) {  # it's already an absolute time"
NSQ_SOURCE_LINE 00002496 "            return $interval;"
NSQ_SOURCE_LINE 00002497 "        }"
NSQ_SOURCE_LINE 00002498 "        elsif ($interval > 0) {  # it's relative to the current time"
NSQ_SOURCE_LINE 00002499 "            return int($interval + time + 0.5);"
NSQ_SOURCE_LINE 00002500 "        }"
NSQ_SOURCE_LINE 00002501 "        else {  # it's a one time poll"
NSQ_SOURCE_LINE 00002502 "            return 0;"
NSQ_SOURCE_LINE 00002503 "        }"
NSQ_SOURCE_LINE 00002504 "    }"
NSQ_SOURCE_LINE 00002505 "    else {  # there's no timeout"
NSQ_SOURCE_LINE 00002506 "        return undef;"
NSQ_SOURCE_LINE 00002507 "    }"
NSQ_SOURCE_LINE 00002508 "} # end sub _endtime"
NSQ_SOURCE_LINE 00002509 ""
NSQ_SOURCE_LINE 00002510 ""
NSQ_SOURCE_LINE 00002511 "sub _errno_include {"
NSQ_SOURCE_LINE 00002512 "    local $@;"
NSQ_SOURCE_LINE 00002513 "    local $SIG{\"__DIE__\"} = \"DEFAULT\";"
NSQ_SOURCE_LINE 00002514 ""
NSQ_SOURCE_LINE 00002515 "    eval \"require Errno\";"
NSQ_SOURCE_LINE 00002516 "} # end sub errno_include"
NSQ_SOURCE_LINE 00002517 ""
NSQ_SOURCE_LINE 00002518 ""
NSQ_SOURCE_LINE 00002519 "sub _escape_cr {"
NSQ_SOURCE_LINE 00002520 "    my ($string) = @_;"
NSQ_SOURCE_LINE 00002521 "    my ("
NSQ_SOURCE_LINE 00002522 "        $nextchar,"
NSQ_SOURCE_LINE 00002523 "        );"
NSQ_SOURCE_LINE 00002524 "    my $pos = 0;"
NSQ_SOURCE_LINE 00002525 ""
NSQ_SOURCE_LINE 00002526 "    ## Convert all CR (not followed by LF) to CR NULL."
NSQ_SOURCE_LINE 00002527 "    while (($pos = index($$string, \"\\015\", $pos)) > -1) {"
NSQ_SOURCE_LINE 00002528 "        $nextchar = substr $$string, $pos + 1, 1;"
NSQ_SOURCE_LINE 00002529 ""
NSQ_SOURCE_LINE 00002530 "        substr($$string, $pos, 1) = \"\\015\\000\""
NSQ_SOURCE_LINE 00002531 "            unless $nextchar eq \"\\012\";"
NSQ_SOURCE_LINE 00002532 ""
NSQ_SOURCE_LINE 00002533 "        $pos++;"
NSQ_SOURCE_LINE 00002534 "    }"
NSQ_SOURCE_LINE 00002535 ""
NSQ_SOURCE_LINE 00002536 "    1;"
NSQ_SOURCE_LINE 00002537 "} # end sub _escape_cr"
NSQ_SOURCE_LINE 00002538 ""
NSQ_SOURCE_LINE 00002539 ""
NSQ_SOURCE_LINE 00002540 "sub _extract_arg_errmode {"
NSQ_SOURCE_LINE 00002541 "    my ($self, $args) = @_;"
NSQ_SOURCE_LINE 00002542 "    my ("
NSQ_SOURCE_LINE 00002543 "        %args,"
NSQ_SOURCE_LINE 00002544 "        );"
NSQ_SOURCE_LINE 00002545 "    local $_;"
NSQ_SOURCE_LINE 00002546 "    my $errmode = '';"
NSQ_SOURCE_LINE 00002547 ""
NSQ_SOURCE_LINE 00002548 "    ## Check for named parameters."
NSQ_SOURCE_LINE 00002549 "    return '' unless @$args >= 2;"
NSQ_SOURCE_LINE 00002550 ""
NSQ_SOURCE_LINE 00002551 "    ## Rebuild args without errmode parameter."
NSQ_SOURCE_LINE 00002552 "    %args = @$args;"
NSQ_SOURCE_LINE 00002553 "    @$args = ();"
NSQ_SOURCE_LINE 00002554 ""
NSQ_SOURCE_LINE 00002555 "    ## Extract errmode arg."
NSQ_SOURCE_LINE 00002556 "    foreach (keys %args) {"
NSQ_SOURCE_LINE 00002557 "        if (/^-?errmode$/i) {"
NSQ_SOURCE_LINE 00002558 "            $errmode = &_parse_errmode($self, $args{$_});"
NSQ_SOURCE_LINE 00002559 "        }"
NSQ_SOURCE_LINE 00002560 "        else {"
NSQ_SOURCE_LINE 00002561 "            push @$args, $_, $args{$_};"
NSQ_SOURCE_LINE 00002562 "        }"
NSQ_SOURCE_LINE 00002563 "    }"
NSQ_SOURCE_LINE 00002564 ""
NSQ_SOURCE_LINE 00002565 "    $errmode;"
NSQ_SOURCE_LINE 00002566 "} # end sub _extract_arg_errmode"
NSQ_SOURCE_LINE 00002567 ""
NSQ_SOURCE_LINE 00002568 ""
NSQ_SOURCE_LINE 00002569 "sub _fillbuf {"
NSQ_SOURCE_LINE 00002570 "    my ($self, $s, $endtime) = @_;"
NSQ_SOURCE_LINE 00002571 "    my ("
NSQ_SOURCE_LINE 00002572 "        $msg,"
NSQ_SOURCE_LINE 00002573 "        $nfound,"
NSQ_SOURCE_LINE 00002574 "        $nread,"
NSQ_SOURCE_LINE 00002575 "        $pushback_len,"
NSQ_SOURCE_LINE 00002576 "        $read_pos,"
NSQ_SOURCE_LINE 00002577 "        $ready,"
NSQ_SOURCE_LINE 00002578 "        $timed_out,"
NSQ_SOURCE_LINE 00002579 "        $timeout,"
NSQ_SOURCE_LINE 00002580 "        $unparsed_pos,"
NSQ_SOURCE_LINE 00002581 "        );"
NSQ_SOURCE_LINE 00002582 ""
NSQ_SOURCE_LINE 00002583 "    ## If error from last read not yet reported then do it now."
NSQ_SOURCE_LINE 00002584 "    if ($s->{pending_errormsg}) {"
NSQ_SOURCE_LINE 00002585 "        $msg = $s->{pending_errormsg};"
NSQ_SOURCE_LINE 00002586 "        $s->{pending_errormsg} = \"\";"
NSQ_SOURCE_LINE 00002587 "        return $self->error($msg);"
NSQ_SOURCE_LINE 00002588 "    }"
NSQ_SOURCE_LINE 00002589 ""
NSQ_SOURCE_LINE 00002590 "    return unless $s->{opened};"
NSQ_SOURCE_LINE 00002591 ""
NSQ_SOURCE_LINE 00002592 "    while (1) {"
NSQ_SOURCE_LINE 00002593 "        ## Maximum buffer size exceeded?"
NSQ_SOURCE_LINE 00002594 "        return $self->error(\"maximum input buffer length exceeded: \","
NSQ_SOURCE_LINE 00002595 "                            $s->{maxbufsize}, \" bytes\")"
NSQ_SOURCE_LINE 00002596 "            unless length($s->{buf}) <= $s->{maxbufsize};"
NSQ_SOURCE_LINE 00002597 ""
NSQ_SOURCE_LINE 00002598 "        ## Determine how long to wait for input ready."
NSQ_SOURCE_LINE 00002599 "        ($timed_out, $timeout) = &_timeout_interval($endtime);"
NSQ_SOURCE_LINE 00002600 "        if ($timed_out) {"
NSQ_SOURCE_LINE 00002601 "            $s->{timedout} = 1;"
NSQ_SOURCE_LINE 00002602 "            return $self->error(\"read timed-out\");"
NSQ_SOURCE_LINE 00002603 "        }"
NSQ_SOURCE_LINE 00002604 ""
NSQ_SOURCE_LINE 00002605 "        ## Wait for input ready."
NSQ_SOURCE_LINE 00002606 "        $nfound = select $ready=$s->{fdmask}, \"\", \"\", $timeout;"
NSQ_SOURCE_LINE 00002607 ""
NSQ_SOURCE_LINE 00002608 "        ## Handle any errors while waiting."
NSQ_SOURCE_LINE 00002609 "        if ((!defined $nfound or $nfound <= 0) and $s->{select_supported}) {"
NSQ_SOURCE_LINE 00002610 "            if (defined $nfound and $nfound == 0) {  # timed-out"
NSQ_SOURCE_LINE 00002611 "                $s->{timedout} = 1;"
NSQ_SOURCE_LINE 00002612 "                return $self->error(\"read timed-out\");"
NSQ_SOURCE_LINE 00002613 "            }"
NSQ_SOURCE_LINE 00002614 "            else {  # error waiting for input ready"
NSQ_SOURCE_LINE 00002615 "                if (defined $EINTR) {"
NSQ_SOURCE_LINE 00002616 "                    next if $! == $EINTR;  # restart select()"
NSQ_SOURCE_LINE 00002617 "                }"
NSQ_SOURCE_LINE 00002618 "                else {"
NSQ_SOURCE_LINE 00002619 "                    next if $! =~ /^interrupted/i;  # restart select()"
NSQ_SOURCE_LINE 00002620 "                }"
NSQ_SOURCE_LINE 00002621 ""
NSQ_SOURCE_LINE 00002622 "                $s->{opened} = '';"
NSQ_SOURCE_LINE 00002623 "                return $self->error(\"read error: $!\");"
NSQ_SOURCE_LINE 00002624 "            }"
NSQ_SOURCE_LINE 00002625 "        }"
NSQ_SOURCE_LINE 00002626 ""
NSQ_SOURCE_LINE 00002627 "        ## Append to buffer any partially processed telnet or CR sequence."
NSQ_SOURCE_LINE 00002628 "        $pushback_len = length $s->{pushback_buf};"
NSQ_SOURCE_LINE 00002629 "        if ($pushback_len) {"
NSQ_SOURCE_LINE 00002630 "            $s->{buf} .= $s->{pushback_buf};"
NSQ_SOURCE_LINE 00002631 "            $s->{pushback_buf} = \"\";"
NSQ_SOURCE_LINE 00002632 "        }"
NSQ_SOURCE_LINE 00002633 ""
NSQ_SOURCE_LINE 00002634 "        ## Read the waiting data."
NSQ_SOURCE_LINE 00002635 "        $read_pos = length $s->{buf};"
NSQ_SOURCE_LINE 00002636 "        $unparsed_pos = $read_pos - $pushback_len;"
NSQ_SOURCE_LINE 00002637 "        $nread = sysread $self, $s->{buf}, $s->{blksize}, $read_pos;"
NSQ_SOURCE_LINE 00002638 ""
NSQ_SOURCE_LINE 00002639 "        ## Handle any read errors."
NSQ_SOURCE_LINE 00002640 "        if (!defined $nread) {  # read failed"
NSQ_SOURCE_LINE 00002641 "            if (defined $EINTR) {"
NSQ_SOURCE_LINE 00002642 "                next if $! == $EINTR;  # restart sysread()"
NSQ_SOURCE_LINE 00002643 "            }"
NSQ_SOURCE_LINE 00002644 "            else {"
NSQ_SOURCE_LINE 00002645 "                next if $! =~ /^interrupted/i;  # restart sysread()"
NSQ_SOURCE_LINE 00002646 "            }"
NSQ_SOURCE_LINE 00002647 ""
NSQ_SOURCE_LINE 00002648 "            $s->{opened} = '';"
NSQ_SOURCE_LINE 00002649 "            return $self->error(\"read error: $!\");"
NSQ_SOURCE_LINE 00002650 "        }"
NSQ_SOURCE_LINE 00002651 ""
NSQ_SOURCE_LINE 00002652 "        ## Handle eof."
NSQ_SOURCE_LINE 00002653 "        if ($nread == 0) {  # eof read"
NSQ_SOURCE_LINE 00002654 "            $s->{opened} = '';"
NSQ_SOURCE_LINE 00002655 "            return;"
NSQ_SOURCE_LINE 00002656 "        }"
NSQ_SOURCE_LINE 00002657 ""
NSQ_SOURCE_LINE 00002658 "        ## Display network traffic if requested."
NSQ_SOURCE_LINE 00002659 "        if ($s->{dumplog}) {"
NSQ_SOURCE_LINE 00002660 "            &_log_dump('<', $s->{dumplog}, \\$s->{buf}, $read_pos);"
NSQ_SOURCE_LINE 00002661 "        }"
NSQ_SOURCE_LINE 00002662 ""
NSQ_SOURCE_LINE 00002663 "        ## Process any telnet commands in the data stream."
NSQ_SOURCE_LINE 00002664 "        if ($s->{telnet_mode} and index($s->{buf},\"\\377\",$unparsed_pos) > -1) {"
NSQ_SOURCE_LINE 00002665 "            &_interpret_tcmd($self, $s, $unparsed_pos);"
NSQ_SOURCE_LINE 00002666 "        }"
NSQ_SOURCE_LINE 00002667 ""
NSQ_SOURCE_LINE 00002668 "        ## Process any carriage-return sequences in the data stream."
NSQ_SOURCE_LINE 00002669 "        &_interpret_cr($s, $unparsed_pos);"
NSQ_SOURCE_LINE 00002670 ""
NSQ_SOURCE_LINE 00002671 "        ## Read again if all chars read were consumed as telnet cmds."
NSQ_SOURCE_LINE 00002672 "        next if $unparsed_pos >= length $s->{buf};"
NSQ_SOURCE_LINE 00002673 ""
NSQ_SOURCE_LINE 00002674 "        ## Log the input if requested."
NSQ_SOURCE_LINE 00002675 "        if ($s->{inputlog}) {"
NSQ_SOURCE_LINE 00002676 "            &_log_print($s->{inputlog}, substr($s->{buf}, $unparsed_pos));"
NSQ_SOURCE_LINE 00002677 "        }"
NSQ_SOURCE_LINE 00002678 ""
NSQ_SOURCE_LINE 00002679 "        ## Save the last line read."
NSQ_SOURCE_LINE 00002680 "        &_save_lastline($s);"
NSQ_SOURCE_LINE 00002681 ""
NSQ_SOURCE_LINE 00002682 "        ## We've successfully read some data into the buffer."
NSQ_SOURCE_LINE 00002683 "        last;"
NSQ_SOURCE_LINE 00002684 "    } # end while(1)"
NSQ_SOURCE_LINE 00002685 ""
NSQ_SOURCE_LINE 00002686 "    1;"
NSQ_SOURCE_LINE 00002687 "} # end sub _fillbuf"
NSQ_SOURCE_LINE 00002688 ""
NSQ_SOURCE_LINE 00002689 ""
NSQ_SOURCE_LINE 00002690 "sub _flush_opts {"
NSQ_SOURCE_LINE 00002691 "    my ($self) = @_;"
NSQ_SOURCE_LINE 00002692 "    my ("
NSQ_SOURCE_LINE 00002693 "        $option_chars,"
NSQ_SOURCE_LINE 00002694 "        );"
NSQ_SOURCE_LINE 00002695 "    my $s = *$self->{net_telnet};"
NSQ_SOURCE_LINE 00002696 ""
NSQ_SOURCE_LINE 00002697 "    ## Get option and clear the output buf."
NSQ_SOURCE_LINE 00002698 "    $option_chars = $s->{unsent_opts};"
NSQ_SOURCE_LINE 00002699 "    $s->{unsent_opts} = \"\";"
NSQ_SOURCE_LINE 00002700 ""
NSQ_SOURCE_LINE 00002701 "    ## Try to send options without waiting."
NSQ_SOURCE_LINE 00002702 "    {"
NSQ_SOURCE_LINE 00002703 "        local $s->{errormode} = \"return\";"
NSQ_SOURCE_LINE 00002704 "        local $s->{time_out} = 0;"
NSQ_SOURCE_LINE 00002705 "        &_put($self, \\$option_chars, \"telnet option negotiation\")"
NSQ_SOURCE_LINE 00002706 "            or do {"
NSQ_SOURCE_LINE 00002707 "                ## Save chars not printed for later."
NSQ_SOURCE_LINE 00002708 "                substr($option_chars, 0, $self->print_length) = \"\";"
NSQ_SOURCE_LINE 00002709 "                $s->{unsent_opts} .= $option_chars;"
NSQ_SOURCE_LINE 00002710 "            };"
NSQ_SOURCE_LINE 00002711 "    }"
NSQ_SOURCE_LINE 00002712 ""
NSQ_SOURCE_LINE 00002713 "    1;"
NSQ_SOURCE_LINE 00002714 "} # end sub _flush_opts"
NSQ_SOURCE_LINE 00002715 ""
NSQ_SOURCE_LINE 00002716 ""
