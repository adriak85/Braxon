NSQ_SOURCE_LINE 00003435 "    elsif ($mode !~ /^\\d+$/) {"
NSQ_SOURCE_LINE 00003436 "        &_carp($self, \"ignoring bad Cmd_remove_mode \" ."
NSQ_SOURCE_LINE 00003437 "               \"argument \\\"$mode\\\": it's not \\\"auto\\\" or a \" ."
NSQ_SOURCE_LINE 00003438 "               \"non-negative integer\");"
NSQ_SOURCE_LINE 00003439 "        $mode = *$self->{net_telnet}{cmd_rm_mode};"
NSQ_SOURCE_LINE 00003440 "    }"
NSQ_SOURCE_LINE 00003441 ""
NSQ_SOURCE_LINE 00003442 "    $mode;"
NSQ_SOURCE_LINE 00003443 "} # end sub _parse_cmd_remove_mode"
NSQ_SOURCE_LINE 00003444 ""
