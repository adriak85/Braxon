NSQ_SOURCE_LINE 00003608 "sub _parse_timeout {"
NSQ_SOURCE_LINE 00003609 "    my ($self, $timeout) = @_;"
NSQ_SOURCE_LINE 00003610 "    local $@;"
NSQ_SOURCE_LINE 00003611 ""
NSQ_SOURCE_LINE 00003612 "    ## Ensure valid timeout."
NSQ_SOURCE_LINE 00003613 "    if (defined $timeout) {"
NSQ_SOURCE_LINE 00003614 "        ## Test for non-numeric or negative values."
NSQ_SOURCE_LINE 00003615 "        eval {"
NSQ_SOURCE_LINE 00003616 "            local $SIG{\"__DIE__\"} = \"DEFAULT\";"
NSQ_SOURCE_LINE 00003617 "            local $SIG{\"__WARN__\"} = sub { die \"non-numeric\\n\" };"
NSQ_SOURCE_LINE 00003618 "            local $^W = 1;"
NSQ_SOURCE_LINE 00003619 "            $timeout *= 1;"
NSQ_SOURCE_LINE 00003620 "        };"
NSQ_SOURCE_LINE 00003621 "        if ($@) {  # timeout arg is non-numeric"
NSQ_SOURCE_LINE 00003622 "            &_carp($self,"
NSQ_SOURCE_LINE 00003623 "                   \"ignoring non-numeric Timeout argument \\\"$timeout\\\"\");"
NSQ_SOURCE_LINE 00003624 "            $timeout = *$self->{net_telnet}{time_out};"
NSQ_SOURCE_LINE 00003625 "        }"
NSQ_SOURCE_LINE 00003626 "        elsif ($timeout < 0) {  # timeout arg is negative"
NSQ_SOURCE_LINE 00003627 "            &_carp($self, \"ignoring negative Timeout argument \\\"$timeout\\\"\");"
NSQ_SOURCE_LINE 00003628 "            $timeout = *$self->{net_telnet}{time_out};"
NSQ_SOURCE_LINE 00003629 "        }"
NSQ_SOURCE_LINE 00003630 "    }"
NSQ_SOURCE_LINE 00003631 ""
NSQ_SOURCE_LINE 00003632 "    $timeout;"
NSQ_SOURCE_LINE 00003633 "} # end sub _parse_timeout"
NSQ_SOURCE_LINE 00003634 ""
NSQ_SOURCE_LINE 00003635 ""
NSQ_SOURCE_LINE 00003636 "sub _put {"
NSQ_SOURCE_LINE 00003637 "    my ($self, $buf, $subname) = @_;"
NSQ_SOURCE_LINE 00003638 "    my ("
NSQ_SOURCE_LINE 00003639 "        $endtime,"
NSQ_SOURCE_LINE 00003640 "        $len,"
NSQ_SOURCE_LINE 00003641 "        $nfound,"
NSQ_SOURCE_LINE 00003642 "        $nwrote,"
NSQ_SOURCE_LINE 00003643 "        $offset,"
NSQ_SOURCE_LINE 00003644 "        $ready,"
NSQ_SOURCE_LINE 00003645 "        $s,"
NSQ_SOURCE_LINE 00003646 "        $timed_out,"
NSQ_SOURCE_LINE 00003647 "        $timeout,"
NSQ_SOURCE_LINE 00003648 "        $zero_wrote_count,"
NSQ_SOURCE_LINE 00003649 "        );"
NSQ_SOURCE_LINE 00003650 ""
NSQ_SOURCE_LINE 00003651 "    ## Init."
NSQ_SOURCE_LINE 00003652 "    $s = *$self->{net_telnet};"
NSQ_SOURCE_LINE 00003653 "    $s->{num_wrote} = 0;"
NSQ_SOURCE_LINE 00003654 "    $zero_wrote_count = 0;"
NSQ_SOURCE_LINE 00003655 "    $offset = 0;"
NSQ_SOURCE_LINE 00003656 "    $len = length $$buf;"
NSQ_SOURCE_LINE 00003657 "    $endtime = &_endtime($s->{time_out});"
NSQ_SOURCE_LINE 00003658 ""
NSQ_SOURCE_LINE 00003659 "    return $self->error(\"write error: filehandle isn't open\")"
NSQ_SOURCE_LINE 00003660 "        unless $s->{opened};"
NSQ_SOURCE_LINE 00003661 ""
NSQ_SOURCE_LINE 00003662 "    ## Try to send any waiting option negotiation."
NSQ_SOURCE_LINE 00003663 "    if (length $s->{unsent_opts}) {"
NSQ_SOURCE_LINE 00003664 "        &_flush_opts($self);"
NSQ_SOURCE_LINE 00003665 "    }"
NSQ_SOURCE_LINE 00003666 ""
NSQ_SOURCE_LINE 00003667 "    ## Write until all data blocks written."
NSQ_SOURCE_LINE 00003668 "    while ($len) {"
NSQ_SOURCE_LINE 00003669 "        ## Determine how long to wait for output ready."
NSQ_SOURCE_LINE 00003670 "        ($timed_out, $timeout) = &_timeout_interval($endtime);"
NSQ_SOURCE_LINE 00003671 "        if ($timed_out) {"
NSQ_SOURCE_LINE 00003672 "            $s->{timedout} = 1;"
NSQ_SOURCE_LINE 00003673 "            return $self->error(\"$subname timed-out\");"
NSQ_SOURCE_LINE 00003674 "        }"
NSQ_SOURCE_LINE 00003675 ""
NSQ_SOURCE_LINE 00003676 "        ## Wait for output ready."
NSQ_SOURCE_LINE 00003677 "        $nfound = select \"\", $ready=$s->{fdmask}, \"\", $timeout;"
NSQ_SOURCE_LINE 00003678 ""
NSQ_SOURCE_LINE 00003679 "        ## Handle any errors while waiting."
NSQ_SOURCE_LINE 00003680 "        if ((!defined $nfound or $nfound <= 0) and $s->{select_supported}) {"
NSQ_SOURCE_LINE 00003681 "            if (defined $nfound and $nfound == 0) {  # timed-out"
NSQ_SOURCE_LINE 00003682 "                $s->{timedout} = 1;"
NSQ_SOURCE_LINE 00003683 "                return $self->error(\"$subname timed-out\");"
NSQ_SOURCE_LINE 00003684 "            }"
NSQ_SOURCE_LINE 00003685 "            else {  # error waiting for output ready"
NSQ_SOURCE_LINE 00003686 "                if (defined $EINTR) {"
NSQ_SOURCE_LINE 00003687 "                    next if $! == $EINTR;  # restart select()"
NSQ_SOURCE_LINE 00003688 "                }"
NSQ_SOURCE_LINE 00003689 "                else {"
NSQ_SOURCE_LINE 00003690 "                    next if $! =~ /^interrupted/i;  # restart select()"
NSQ_SOURCE_LINE 00003691 "                }"
NSQ_SOURCE_LINE 00003692 ""
NSQ_SOURCE_LINE 00003693 "                $s->{opened} = '';"
NSQ_SOURCE_LINE 00003694 "                return $self->error(\"write error: $!\");"
NSQ_SOURCE_LINE 00003695 "            }"
NSQ_SOURCE_LINE 00003696 "        }"
NSQ_SOURCE_LINE 00003697 ""
NSQ_SOURCE_LINE 00003698 "        ## Write the data."
NSQ_SOURCE_LINE 00003699 "        $nwrote = syswrite $self, $$buf, $s->{blksize}, $offset;"
NSQ_SOURCE_LINE 00003700 ""
NSQ_SOURCE_LINE 00003701 "        ## Handle any write errors."
NSQ_SOURCE_LINE 00003702 "        if (!defined $nwrote) {  # write failed"
NSQ_SOURCE_LINE 00003703 "            if (defined $EINTR) {"
NSQ_SOURCE_LINE 00003704 "                next if $! == $EINTR;  # restart syswrite()"
NSQ_SOURCE_LINE 00003705 "            }"
NSQ_SOURCE_LINE 00003706 "            else {"
NSQ_SOURCE_LINE 00003707 "                next if $! =~ /^interrupted/i;  # restart syswrite()"
NSQ_SOURCE_LINE 00003708 "            }"
NSQ_SOURCE_LINE 00003709 ""
NSQ_SOURCE_LINE 00003710 "            $s->{opened} = '';"
NSQ_SOURCE_LINE 00003711 "            return $self->error(\"write error: $!\");"
NSQ_SOURCE_LINE 00003712 "        }"
NSQ_SOURCE_LINE 00003713 "        elsif ($nwrote == 0) {  # zero chars written"
NSQ_SOURCE_LINE 00003714 "            ## Try ten more times to write the data."
NSQ_SOURCE_LINE 00003715 "            if ($zero_wrote_count++ <= 10) {"
NSQ_SOURCE_LINE 00003716 "                &_sleep(0.01);"
NSQ_SOURCE_LINE 00003717 "                next;"
NSQ_SOURCE_LINE 00003718 "            }"
NSQ_SOURCE_LINE 00003719 ""
NSQ_SOURCE_LINE 00003720 "            $s->{opened} = '';"
NSQ_SOURCE_LINE 00003721 "            return $self->error(\"write error: zero length write: $!\");"
NSQ_SOURCE_LINE 00003722 "        }"
NSQ_SOURCE_LINE 00003723 ""
NSQ_SOURCE_LINE 00003724 "        ## Display network traffic if requested."
NSQ_SOURCE_LINE 00003725 "        if ($s->{dumplog}) {"
NSQ_SOURCE_LINE 00003726 "            &_log_dump('>', $s->{dumplog}, $buf, $offset, $nwrote);"
NSQ_SOURCE_LINE 00003727 "        }"
NSQ_SOURCE_LINE 00003728 ""
NSQ_SOURCE_LINE 00003729 "        ## Increment."
NSQ_SOURCE_LINE 00003730 "        $s->{num_wrote} += $nwrote;"
NSQ_SOURCE_LINE 00003731 "        $offset += $nwrote;"
NSQ_SOURCE_LINE 00003732 "        $len -= $nwrote;"
NSQ_SOURCE_LINE 00003733 "    }"
NSQ_SOURCE_LINE 00003734 ""
NSQ_SOURCE_LINE 00003735 "    1;"
NSQ_SOURCE_LINE 00003736 "} # end sub _put"
NSQ_SOURCE_LINE 00003737 ""
NSQ_SOURCE_LINE 00003738 ""
NSQ_SOURCE_LINE 00003739 "sub _qualify_fh {"
NSQ_SOURCE_LINE 00003740 "    my ($obj, $name) = @_;"
NSQ_SOURCE_LINE 00003741 "    my ("
NSQ_SOURCE_LINE 00003742 "        $user_class,"
NSQ_SOURCE_LINE 00003743 "        );"
NSQ_SOURCE_LINE 00003744 "    local $@;"
NSQ_SOURCE_LINE 00003745 "    local $_;"
NSQ_SOURCE_LINE 00003746 ""
NSQ_SOURCE_LINE 00003747 "    ## Get user's package name."
NSQ_SOURCE_LINE 00003748 "    ($user_class) = &_user_caller($obj);"
NSQ_SOURCE_LINE 00003749 ""
NSQ_SOURCE_LINE 00003750 "    ## Ensure name is qualified with a package name."
NSQ_SOURCE_LINE 00003751 "    $name = qualify($name, $user_class);"
NSQ_SOURCE_LINE 00003752 ""
NSQ_SOURCE_LINE 00003753 "    ## If it's not already, make it a typeglob ref."
NSQ_SOURCE_LINE 00003754 "    if (!ref $name) {"
NSQ_SOURCE_LINE 00003755 "        no strict;"
NSQ_SOURCE_LINE 00003756 "        local $SIG{\"__DIE__\"} = \"DEFAULT\";"
NSQ_SOURCE_LINE 00003757 "        local $^W = '';"
NSQ_SOURCE_LINE 00003758 ""
NSQ_SOURCE_LINE 00003759 "        $name =~ s/^\\*+//;"
NSQ_SOURCE_LINE 00003760 "        $name = eval \"\\\\*$name\";"
NSQ_SOURCE_LINE 00003761 "        return unless ref $name;"
NSQ_SOURCE_LINE 00003762 "    }"
NSQ_SOURCE_LINE 00003763 ""
NSQ_SOURCE_LINE 00003764 "    $name;"
NSQ_SOURCE_LINE 00003765 "} # end sub _qualify_fh"
NSQ_SOURCE_LINE 00003766 ""
NSQ_SOURCE_LINE 00003767 ""
NSQ_SOURCE_LINE 00003768 "sub _reset_options {"
NSQ_SOURCE_LINE 00003769 "    my ($opts) = @_;"
NSQ_SOURCE_LINE 00003770 "    my ("
NSQ_SOURCE_LINE 00003771 "        $opt,"
NSQ_SOURCE_LINE 00003772 "        );"
NSQ_SOURCE_LINE 00003773 ""
NSQ_SOURCE_LINE 00003774 "    foreach $opt (keys %$opts) {"
NSQ_SOURCE_LINE 00003775 "        $opts->{$opt}{remote_enabled} = '';"
NSQ_SOURCE_LINE 00003776 "        $opts->{$opt}{remote_state} = \"no\";"
NSQ_SOURCE_LINE 00003777 "        $opts->{$opt}{local_enabled} = '';"
NSQ_SOURCE_LINE 00003778 "        $opts->{$opt}{local_state} = \"no\";"
NSQ_SOURCE_LINE 00003779 "    }"
NSQ_SOURCE_LINE 00003780 ""
NSQ_SOURCE_LINE 00003781 "    1;"
NSQ_SOURCE_LINE 00003782 "} # end sub _reset_options"
NSQ_SOURCE_LINE 00003783 ""
NSQ_SOURCE_LINE 00003784 ""
NSQ_SOURCE_LINE 00003785 "sub _save_lastline {"
NSQ_SOURCE_LINE 00003786 "    my ($s) = @_;"
NSQ_SOURCE_LINE 00003787 "    my ("
NSQ_SOURCE_LINE 00003788 "        $firstpos,"
NSQ_SOURCE_LINE 00003789 "        $lastpos,"
NSQ_SOURCE_LINE 00003790 "        $len_w_sep,"
NSQ_SOURCE_LINE 00003791 "        $len_wo_sep,"
NSQ_SOURCE_LINE 00003792 "        $offset,"
NSQ_SOURCE_LINE 00003793 "        );"
NSQ_SOURCE_LINE 00003794 "    my $rs = \"\\n\";"
NSQ_SOURCE_LINE 00003795 ""
NSQ_SOURCE_LINE 00003796 "    if (($lastpos = rindex $s->{buf}, $rs) > -1) {  # eol found"
NSQ_SOURCE_LINE 00003797 "        while (1) {"
NSQ_SOURCE_LINE 00003798 "            ## Find beginning of line."
NSQ_SOURCE_LINE 00003799 "            $firstpos = rindex $s->{buf}, $rs, $lastpos - 1;"
NSQ_SOURCE_LINE 00003800 "            if ($firstpos == -1) {"
NSQ_SOURCE_LINE 00003801 "                $offset = 0;"
NSQ_SOURCE_LINE 00003802 "            }"
NSQ_SOURCE_LINE 00003803 "            else {"
NSQ_SOURCE_LINE 00003804 "                $offset = $firstpos + length $rs;"
NSQ_SOURCE_LINE 00003805 "            }"
NSQ_SOURCE_LINE 00003806 ""
NSQ_SOURCE_LINE 00003807 "            ## Determine length of line with and without separator."
NSQ_SOURCE_LINE 00003808 "            $len_wo_sep = $lastpos - $offset;"
NSQ_SOURCE_LINE 00003809 "            $len_w_sep = $len_wo_sep + length $rs;"
NSQ_SOURCE_LINE 00003810 ""
NSQ_SOURCE_LINE 00003811 "            ## Save line if it's not blank."
NSQ_SOURCE_LINE 00003812 "            if (substr($s->{buf}, $offset, $len_wo_sep)"
NSQ_SOURCE_LINE 00003813 "                !~ /^\\s*$/)"
NSQ_SOURCE_LINE 00003814 "            {"
NSQ_SOURCE_LINE 00003815 "                $s->{last_line} = substr($s->{buf},"
NSQ_SOURCE_LINE 00003816 "                                         $offset,"
NSQ_SOURCE_LINE 00003817 "                                         $len_w_sep);"
NSQ_SOURCE_LINE 00003818 "                last;"
NSQ_SOURCE_LINE 00003819 "            }"
NSQ_SOURCE_LINE 00003820 ""
NSQ_SOURCE_LINE 00003821 "            last if $firstpos == -1;"
NSQ_SOURCE_LINE 00003822 ""
NSQ_SOURCE_LINE 00003823 "            $lastpos = $firstpos;"
NSQ_SOURCE_LINE 00003824 "        }"
NSQ_SOURCE_LINE 00003825 "    }"
NSQ_SOURCE_LINE 00003826 ""
NSQ_SOURCE_LINE 00003827 "    1;"
NSQ_SOURCE_LINE 00003828 "} # end sub _save_lastline"
NSQ_SOURCE_LINE 00003829 ""
NSQ_SOURCE_LINE 00003830 ""
NSQ_SOURCE_LINE 00003831 "sub _set_default_option {"
NSQ_SOURCE_LINE 00003832 "    my ($s, $option) = @_;"
NSQ_SOURCE_LINE 00003833 ""
NSQ_SOURCE_LINE 00003834 "    $s->{opts}{$option} = {"
NSQ_SOURCE_LINE 00003835 "        remote_enabled   => '',"
NSQ_SOURCE_LINE 00003836 "        remote_state     => \"no\","
NSQ_SOURCE_LINE 00003837 "        remote_enable_ok => '',"
NSQ_SOURCE_LINE 00003838 "        local_enabled    => '',"
NSQ_SOURCE_LINE 00003839 "        local_state      => \"no\","
NSQ_SOURCE_LINE 00003840 "        local_enable_ok  => '',"
NSQ_SOURCE_LINE 00003841 "    };"
NSQ_SOURCE_LINE 00003842 "} # end sub _set_default_option"
NSQ_SOURCE_LINE 00003843 ""
NSQ_SOURCE_LINE 00003844 ""
NSQ_SOURCE_LINE 00003845 "sub _sleep {"
NSQ_SOURCE_LINE 00003846 "    my ($secs) = @_;"
NSQ_SOURCE_LINE 00003847 "    my $bitmask = \"\";"
NSQ_SOURCE_LINE 00003848 "    local *SOCK;"
NSQ_SOURCE_LINE 00003849 ""
NSQ_SOURCE_LINE 00003850 "    socket SOCK, AF_INET, SOCK_STREAM, 0;"
NSQ_SOURCE_LINE 00003851 "    vec($bitmask, fileno(SOCK), 1) = 1;"
NSQ_SOURCE_LINE 00003852 "    select $bitmask, \"\", \"\", $secs;"
NSQ_SOURCE_LINE 00003853 "    CORE::close SOCK;"
NSQ_SOURCE_LINE 00003854 ""
NSQ_SOURCE_LINE 00003855 "    1;"
NSQ_SOURCE_LINE 00003856 "} # end sub _sleep"
NSQ_SOURCE_LINE 00003857 ""
NSQ_SOURCE_LINE 00003858 ""
NSQ_SOURCE_LINE 00003859 "sub _timeout_interval {"
NSQ_SOURCE_LINE 00003860 "    my ($endtime) = @_;"
NSQ_SOURCE_LINE 00003861 "    my ("
NSQ_SOURCE_LINE 00003862 "        $timeout,"
NSQ_SOURCE_LINE 00003863 "        );"
NSQ_SOURCE_LINE 00003864 ""
NSQ_SOURCE_LINE 00003865 "    ## Return timed-out boolean and timeout interval."
NSQ_SOURCE_LINE 00003866 "    if (defined $endtime) {"
NSQ_SOURCE_LINE 00003867 "        ## Is it a one-time poll."
NSQ_SOURCE_LINE 00003868 "        return ('', 0) if $endtime == 0;"
NSQ_SOURCE_LINE 00003869 ""
NSQ_SOURCE_LINE 00003870 "        ## Calculate the timeout interval."
NSQ_SOURCE_LINE 00003871 "        $timeout = $endtime - time;"
NSQ_SOURCE_LINE 00003872 ""
NSQ_SOURCE_LINE 00003873 "        ## Did we already timeout."
NSQ_SOURCE_LINE 00003874 "        return (1, 0) unless $timeout > 0;"
NSQ_SOURCE_LINE 00003875 ""
NSQ_SOURCE_LINE 00003876 "        return ('', $timeout);"
NSQ_SOURCE_LINE 00003877 "    }"
NSQ_SOURCE_LINE 00003878 "    else {  # there is no timeout"
NSQ_SOURCE_LINE 00003879 "        return ('', undef);"
NSQ_SOURCE_LINE 00003880 "    }"
NSQ_SOURCE_LINE 00003881 "} # end sub _timeout_interval"
NSQ_SOURCE_LINE 00003882 ""
NSQ_SOURCE_LINE 00003883 ""
NSQ_SOURCE_LINE 00003884 "sub _unpack_sockaddr {"
NSQ_SOURCE_LINE 00003885 "    my ($self, $sockaddr) = @_;"
NSQ_SOURCE_LINE 00003886 "    my ("
NSQ_SOURCE_LINE 00003887 "        $packed_addr,"
NSQ_SOURCE_LINE 00003888 "        $sockfamily,"
NSQ_SOURCE_LINE 00003889 "        );"
NSQ_SOURCE_LINE 00003890 "    my $addr = \"\";"
NSQ_SOURCE_LINE 00003891 "    my $port = \"\";"
NSQ_SOURCE_LINE 00003892 ""
NSQ_SOURCE_LINE 00003893 "    $sockfamily = $self->sockfamily;"
NSQ_SOURCE_LINE 00003894 ""
NSQ_SOURCE_LINE 00003895 "    ## Parse sockaddr struct."
NSQ_SOURCE_LINE 00003896 "    if ($sockfamily eq \"ipv4\") {"
NSQ_SOURCE_LINE 00003897 "        ($port, $packed_addr) = sockaddr_in($sockaddr);"
NSQ_SOURCE_LINE 00003898 "        $addr = Socket::inet_ntoa($packed_addr);"
NSQ_SOURCE_LINE 00003899 "    }"
NSQ_SOURCE_LINE 00003900 "    elsif ($sockfamily eq \"ipv6\") {"
NSQ_SOURCE_LINE 00003901 "        ($port, $packed_addr) = Socket::sockaddr_in6($sockaddr);"
NSQ_SOURCE_LINE 00003902 "        $addr = Socket::inet_ntop($AF_INET6, $packed_addr);"
NSQ_SOURCE_LINE 00003903 "    }"
NSQ_SOURCE_LINE 00003904 ""
NSQ_SOURCE_LINE 00003905 "    ($port, $addr);"
NSQ_SOURCE_LINE 00003906 "} # end sub _unpack_sockaddr"
NSQ_SOURCE_LINE 00003907 ""
NSQ_SOURCE_LINE 00003908 ""
NSQ_SOURCE_LINE 00003909 "sub _user_caller {"
NSQ_SOURCE_LINE 00003910 "    my ($obj) = @_;"
NSQ_SOURCE_LINE 00003911 "    my ("
NSQ_SOURCE_LINE 00003912 "        $class,"
NSQ_SOURCE_LINE 00003913 "        $curr_pkg,"
NSQ_SOURCE_LINE 00003914 "        $file,"
NSQ_SOURCE_LINE 00003915 "        $i,"
NSQ_SOURCE_LINE 00003916 "        $line,"
NSQ_SOURCE_LINE 00003917 "        $pkg,"
NSQ_SOURCE_LINE 00003918 "        %isa,"
NSQ_SOURCE_LINE 00003919 "        @isa,"
NSQ_SOURCE_LINE 00003920 "        );"
NSQ_SOURCE_LINE 00003921 "    local $@;"
NSQ_SOURCE_LINE 00003922 "    local $_;"
NSQ_SOURCE_LINE 00003923 ""
NSQ_SOURCE_LINE 00003924 "    ## Create a boolean hash to test for isa.  Make sure current"
NSQ_SOURCE_LINE 00003925 "    ## package and the object's class are members."
NSQ_SOURCE_LINE 00003926 "    $class = ref $obj;"
NSQ_SOURCE_LINE 00003927 "    @isa = eval \"\\@${class}::ISA\";"
NSQ_SOURCE_LINE 00003928 "    push @isa, $class;"
NSQ_SOURCE_LINE 00003929 "    ($curr_pkg) = caller 1;"
NSQ_SOURCE_LINE 00003930 "    push @isa, $curr_pkg;"
NSQ_SOURCE_LINE 00003931 "    %isa = map { $_ => 1 } @isa;"
NSQ_SOURCE_LINE 00003932 ""
NSQ_SOURCE_LINE 00003933 "    ## Search back in call frames for a package that's not in isa."
NSQ_SOURCE_LINE 00003934 "    $i = 1;"
NSQ_SOURCE_LINE 00003935 "    while (($pkg, $file, $line) = caller ++$i) {"
NSQ_SOURCE_LINE 00003936 "        next if $isa{$pkg};"
NSQ_SOURCE_LINE 00003937 ""
NSQ_SOURCE_LINE 00003938 "        return ($pkg, $file, $line);"
NSQ_SOURCE_LINE 00003939 "    }"
NSQ_SOURCE_LINE 00003940 ""
NSQ_SOURCE_LINE 00003941 "    ## If not found, choose outer most call frame."
NSQ_SOURCE_LINE 00003942 "    ($pkg, $file, $line) = caller --$i;"
NSQ_SOURCE_LINE 00003943 "    return ($pkg, $file, $line);"
NSQ_SOURCE_LINE 00003944 "} # end sub _user_caller"
NSQ_SOURCE_LINE 00003945 ""
NSQ_SOURCE_LINE 00003946 ""
NSQ_SOURCE_LINE 00003947 "sub _verify_telopt_arg {"
NSQ_SOURCE_LINE 00003948 "    my ($self, $option, $argname) = @_;"
NSQ_SOURCE_LINE 00003949 "    local $@;"
NSQ_SOURCE_LINE 00003950 ""
NSQ_SOURCE_LINE 00003951 "    ## If provided, use argument name in error message."
NSQ_SOURCE_LINE 00003952 "    if (defined $argname) {"
NSQ_SOURCE_LINE 00003953 "        $argname = \"for arg $argname\";"
NSQ_SOURCE_LINE 00003954 "    }"
NSQ_SOURCE_LINE 00003955 "    else {"
NSQ_SOURCE_LINE 00003956 "        $argname = \"\";"
NSQ_SOURCE_LINE 00003957 "    }"
NSQ_SOURCE_LINE 00003958 ""
NSQ_SOURCE_LINE 00003959 "    ## Ensure telnet option is a non-negative integer."
NSQ_SOURCE_LINE 00003960 "    eval {"
NSQ_SOURCE_LINE 00003961 "        local $SIG{\"__DIE__\"} = \"DEFAULT\";"
NSQ_SOURCE_LINE 00003962 "        local $SIG{\"__WARN__\"} = sub { die \"non-numeric\\n\" };"
NSQ_SOURCE_LINE 00003963 "        local $^W = 1;"
NSQ_SOURCE_LINE 00003964 "        $option = abs(int $option);"
NSQ_SOURCE_LINE 00003965 "    };"
NSQ_SOURCE_LINE 00003966 "    return $self->error(\"bad telnet option $argname: non-numeric\")"
NSQ_SOURCE_LINE 00003967 "        if $@;"
NSQ_SOURCE_LINE 00003968 ""
NSQ_SOURCE_LINE 00003969 "    return $self->error(\"bad telnet option $argname: option > 255\")"
NSQ_SOURCE_LINE 00003970 "        unless $option <= 255;"
NSQ_SOURCE_LINE 00003971 ""
NSQ_SOURCE_LINE 00003972 "    $option;"
NSQ_SOURCE_LINE 00003973 "} # end sub _verify_telopt_arg"
NSQ_SOURCE_LINE 00003974 ""
NSQ_SOURCE_LINE 00003975 ""
