NSQ_SOURCE_LINE 00003446 "sub _parse_errmode {"
NSQ_SOURCE_LINE 00003447 "    my ($self, $errmode) = @_;"
NSQ_SOURCE_LINE 00003448 ""
NSQ_SOURCE_LINE 00003449 "    ## Set the error mode."
NSQ_SOURCE_LINE 00003450 "    if (!defined $errmode) {"
NSQ_SOURCE_LINE 00003451 "        &_carp($self, \"ignoring undefined Errmode argument\");"
NSQ_SOURCE_LINE 00003452 "        $errmode = *$self->{net_telnet}{errormode};"
NSQ_SOURCE_LINE 00003453 "    }"
NSQ_SOURCE_LINE 00003454 "    elsif ($errmode =~ /^\\s*return\\s*$/i) {"
NSQ_SOURCE_LINE 00003455 "        $errmode = \"return\";"
NSQ_SOURCE_LINE 00003456 "    }"
NSQ_SOURCE_LINE 00003457 "    elsif ($errmode =~ /^\\s*die\\s*$/i) {"
NSQ_SOURCE_LINE 00003458 "        $errmode = \"die\";"
NSQ_SOURCE_LINE 00003459 "    }"
NSQ_SOURCE_LINE 00003460 "    elsif (ref($errmode) eq \"CODE\") {"
NSQ_SOURCE_LINE 00003461 "    }"
NSQ_SOURCE_LINE 00003462 "    elsif (ref($errmode) eq \"ARRAY\") {"
NSQ_SOURCE_LINE 00003463 "        unless (ref($errmode->[0]) eq \"CODE\") {"
NSQ_SOURCE_LINE 00003464 "            &_carp($self, \"ignoring bad Errmode argument: \" ."
NSQ_SOURCE_LINE 00003465 "                   \"first list item isn't a code ref\");"
NSQ_SOURCE_LINE 00003466 "            $errmode = *$self->{net_telnet}{errormode};"
NSQ_SOURCE_LINE 00003467 "        }"
NSQ_SOURCE_LINE 00003468 "    }"
NSQ_SOURCE_LINE 00003469 "    else {"
NSQ_SOURCE_LINE 00003470 "        &_carp($self, \"ignoring bad Errmode argument \\\"$errmode\\\"\");"
NSQ_SOURCE_LINE 00003471 "        $errmode = *$self->{net_telnet}{errormode};"
NSQ_SOURCE_LINE 00003472 "    }"
NSQ_SOURCE_LINE 00003473 ""
NSQ_SOURCE_LINE 00003474 "    $errmode;"
NSQ_SOURCE_LINE 00003475 "} # end sub _parse_errmode"
NSQ_SOURCE_LINE 00003476 ""
