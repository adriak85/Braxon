NSQ_SOURCE_LINE 00001199 "sub login {"
NSQ_SOURCE_LINE 00001200 "    my ($self, @args) = @_;"
NSQ_SOURCE_LINE 00001201 "    my ("
NSQ_SOURCE_LINE 00001202 "        $arg_errmode,"
NSQ_SOURCE_LINE 00001203 "        $error,"
NSQ_SOURCE_LINE 00001204 "        $is_passwd_arg,"
