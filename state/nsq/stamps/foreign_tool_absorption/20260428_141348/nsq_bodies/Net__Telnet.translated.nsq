NSQ_SOURCE_LINE 00000599 "sub error {"
NSQ_SOURCE_LINE 00000600 "    my ($self, @errmsg) = @_;"
NSQ_SOURCE_LINE 00000601 "    my ("
NSQ_SOURCE_LINE 00000602 "        $errmsg,"
NSQ_SOURCE_LINE 00000603 "        $func,"
NSQ_SOURCE_LINE 00000604 "        $mode,"
NSQ_SOURCE_LINE 00000605 "        $s,"
NSQ_SOURCE_LINE 00000606 "        @args,"
NSQ_SOURCE_LINE 00000607 "        );"
NSQ_SOURCE_LINE 00000608 "    local $_;"
NSQ_SOURCE_LINE 00000609 ""
NSQ_SOURCE_LINE 00000610 "    $s = *$self->{net_telnet};"
NSQ_SOURCE_LINE 00000611 ""
NSQ_SOURCE_LINE 00000612 "    if (@_ >= 2) {"
NSQ_SOURCE_LINE 00000613 "        ## Put error message in the object."
NSQ_SOURCE_LINE 00000614 "        $errmsg = join \"\", @errmsg;"
NSQ_SOURCE_LINE 00000615 "        $s->{errormsg} = $errmsg;"
NSQ_SOURCE_LINE 00000616 ""
NSQ_SOURCE_LINE 00000617 "        ## Do the error action as described by error mode."
NSQ_SOURCE_LINE 00000618 "        $mode = $s->{errormode};"
NSQ_SOURCE_LINE 00000619 "        if (ref($mode) eq \"CODE\") {"
NSQ_SOURCE_LINE 00000620 "            &$mode($errmsg);"
NSQ_SOURCE_LINE 00000621 "            return;"
NSQ_SOURCE_LINE 00000622 "        }"
NSQ_SOURCE_LINE 00000623 "        elsif (ref($mode) eq \"ARRAY\") {"
NSQ_SOURCE_LINE 00000624 "            ($func, @args) = @$mode;"
NSQ_SOURCE_LINE 00000625 "            &$func(@args);"
NSQ_SOURCE_LINE 00000626 "            return;"
NSQ_SOURCE_LINE 00000627 "        }"
NSQ_SOURCE_LINE 00000628 "        elsif ($mode =~ /^return$/i) {"
NSQ_SOURCE_LINE 00000629 "            return;"
NSQ_SOURCE_LINE 00000630 "        }"
NSQ_SOURCE_LINE 00000631 "        else {  # die"
NSQ_SOURCE_LINE 00000632 "            if ($errmsg =~ /\\n$/) {"
NSQ_SOURCE_LINE 00000633 "                die $errmsg;"
NSQ_SOURCE_LINE 00000634 "            }"
NSQ_SOURCE_LINE 00000635 "            else {"
NSQ_SOURCE_LINE 00000636 "                ## Die and append caller's line number to message."
NSQ_SOURCE_LINE 00000637 "                &_croak($self, $errmsg);"
NSQ_SOURCE_LINE 00000638 "            }"
NSQ_SOURCE_LINE 00000639 "        }"
NSQ_SOURCE_LINE 00000640 "    }"
NSQ_SOURCE_LINE 00000641 "    else {"
NSQ_SOURCE_LINE 00000642 "        return $s->{errormsg} ne \"\";"
NSQ_SOURCE_LINE 00000643 "    }"
NSQ_SOURCE_LINE 00000644 "} # end sub error"
NSQ_SOURCE_LINE 00000645 ""
NSQ_SOURCE_LINE 00000646 ""
