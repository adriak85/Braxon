NSQ_SOURCE_LINE 00000718 ""
NSQ_SOURCE_LINE 00000719 "sub get {"
NSQ_SOURCE_LINE 00000720 "    my ($self, %args) = @_;"
NSQ_SOURCE_LINE 00000721 "    my ("
NSQ_SOURCE_LINE 00000722 "        $binmode,"
NSQ_SOURCE_LINE 00000723 "        $endtime,"
NSQ_SOURCE_LINE 00000724 "        $errmode,"
NSQ_SOURCE_LINE 00000725 "        $line,"
NSQ_SOURCE_LINE 00000726 "        $s,"
NSQ_SOURCE_LINE 00000727 "        $telnetmode,"
NSQ_SOURCE_LINE 00000728 "        $timeout,"
NSQ_SOURCE_LINE 00000729 "        );"
NSQ_SOURCE_LINE 00000730 "    local $_;"
NSQ_SOURCE_LINE 00000731 ""
NSQ_SOURCE_LINE 00000732 "    ## Init."
NSQ_SOURCE_LINE 00000733 "    $s = *$self->{net_telnet};"
NSQ_SOURCE_LINE 00000734 "    $timeout = $s->{time_out};"
NSQ_SOURCE_LINE 00000735 "    $s->{timedout} = '';"
NSQ_SOURCE_LINE 00000736 "    return if $s->{eofile};"
NSQ_SOURCE_LINE 00000737 ""
NSQ_SOURCE_LINE 00000738 "    ## Parse the named args."
NSQ_SOURCE_LINE 00000739 "    foreach (keys %args) {"
NSQ_SOURCE_LINE 00000740 "        if (/^-?binmode$/i) {"
NSQ_SOURCE_LINE 00000741 "            $binmode = $args{$_};"
NSQ_SOURCE_LINE 00000742 "            unless (defined $binmode) {"
NSQ_SOURCE_LINE 00000743 "                $binmode = 0;"
NSQ_SOURCE_LINE 00000744 "            }"
NSQ_SOURCE_LINE 00000745 "        }"
NSQ_SOURCE_LINE 00000746 "        elsif (/^-?errmode$/i) {"
NSQ_SOURCE_LINE 00000747 "            $errmode = &_parse_errmode($self, $args{$_});"
NSQ_SOURCE_LINE 00000748 "        }"
NSQ_SOURCE_LINE 00000749 "        elsif (/^-?telnetmode$/i) {"
NSQ_SOURCE_LINE 00000750 "            $telnetmode = $args{$_};"
NSQ_SOURCE_LINE 00000751 "            unless (defined $telnetmode) {"
NSQ_SOURCE_LINE 00000752 "                $telnetmode = 0;"
NSQ_SOURCE_LINE 00000753 "            }"
NSQ_SOURCE_LINE 00000754 "        }"
NSQ_SOURCE_LINE 00000755 "        elsif (/^-?timeout$/i) {"
NSQ_SOURCE_LINE 00000756 "            $timeout = &_parse_timeout($self, $args{$_});"
NSQ_SOURCE_LINE 00000757 "        }"
NSQ_SOURCE_LINE 00000758 "        else {"
NSQ_SOURCE_LINE 00000759 "            &_croak($self, \"bad named parameter \\\"$_\\\" given \" ."
NSQ_SOURCE_LINE 00000760 "                    \"to \" . ref($self) . \"::get()\");"
NSQ_SOURCE_LINE 00000761 "        }"
NSQ_SOURCE_LINE 00000762 "    }"
NSQ_SOURCE_LINE 00000763 ""
NSQ_SOURCE_LINE 00000764 "    ## If any args given, override corresponding instance data."
NSQ_SOURCE_LINE 00000765 "    local $s->{errormode} = $errmode"
NSQ_SOURCE_LINE 00000766 "        if defined $errmode;"
NSQ_SOURCE_LINE 00000767 "    local $s->{bin_mode} = $binmode"
NSQ_SOURCE_LINE 00000768 "        if defined $binmode;"
NSQ_SOURCE_LINE 00000769 "    local $s->{telnet_mode} = $telnetmode"
NSQ_SOURCE_LINE 00000770 "        if defined $telnetmode;"
NSQ_SOURCE_LINE 00000771 ""
NSQ_SOURCE_LINE 00000772 "    ## Set wall time when we time out."
NSQ_SOURCE_LINE 00000773 "    $endtime = &_endtime($timeout);"
NSQ_SOURCE_LINE 00000774 ""
NSQ_SOURCE_LINE 00000775 "    ## Try to send any waiting option negotiation."
NSQ_SOURCE_LINE 00000776 "    if (length $s->{unsent_opts}) {"
NSQ_SOURCE_LINE 00000777 "        &_flush_opts($self);"
NSQ_SOURCE_LINE 00000778 "    }"
NSQ_SOURCE_LINE 00000779 ""
NSQ_SOURCE_LINE 00000780 "    ## Try to read just the waiting data using return error mode."
NSQ_SOURCE_LINE 00000781 "    {"
NSQ_SOURCE_LINE 00000782 "        local $s->{errormode} = \"return\";"
NSQ_SOURCE_LINE 00000783 "        $s->{errormsg} = \"\";"
NSQ_SOURCE_LINE 00000784 "        &_fillbuf($self, $s, 0);"
NSQ_SOURCE_LINE 00000785 "    }"
NSQ_SOURCE_LINE 00000786 ""
NSQ_SOURCE_LINE 00000787 "    ## We're done if we timed-out and timeout value is set to \"poll\"."
NSQ_SOURCE_LINE 00000788 "    return $self->error($s->{errormsg})"
NSQ_SOURCE_LINE 00000789 "        if ($s->{timedout} and defined($timeout) and $timeout == 0"
NSQ_SOURCE_LINE 00000790 "            and !length $s->{buf});"
NSQ_SOURCE_LINE 00000791 ""
NSQ_SOURCE_LINE 00000792 "    ## We're done if we hit an error other than timing out."
NSQ_SOURCE_LINE 00000793 "    if ($s->{errormsg} and !$s->{timedout}) {"
NSQ_SOURCE_LINE 00000794 "        if (!length $s->{buf}) {"
NSQ_SOURCE_LINE 00000795 "            return $self->error($s->{errormsg});"
NSQ_SOURCE_LINE 00000796 "        }"
NSQ_SOURCE_LINE 00000797 "        else {  # error encountered but there's some data in buffer"
NSQ_SOURCE_LINE 00000798 "            $s->{pending_errormsg} = $s->{errormsg};"
NSQ_SOURCE_LINE 00000799 "        }"
NSQ_SOURCE_LINE 00000800 "    }"
NSQ_SOURCE_LINE 00000801 ""
NSQ_SOURCE_LINE 00000802 "    ## Clear time-out error from first read."
NSQ_SOURCE_LINE 00000803 "    $s->{timedout} = '';"
NSQ_SOURCE_LINE 00000804 "    $s->{errormsg} = \"\";"
NSQ_SOURCE_LINE 00000805 ""
NSQ_SOURCE_LINE 00000806 "    ## If buffer is still empty, try to read according to user's timeout."
NSQ_SOURCE_LINE 00000807 "    if (!length $s->{buf}) {"
NSQ_SOURCE_LINE 00000808 "        &_fillbuf($self, $s, $endtime)"
NSQ_SOURCE_LINE 00000809 "            or do {"
NSQ_SOURCE_LINE 00000810 "                return if $s->{timedout};"
NSQ_SOURCE_LINE 00000811 ""
NSQ_SOURCE_LINE 00000812 "                ## We've reached end-of-file."
NSQ_SOURCE_LINE 00000813 "                $self->close;"
NSQ_SOURCE_LINE 00000814 "                return;"
NSQ_SOURCE_LINE 00000815 "            };"
NSQ_SOURCE_LINE 00000816 "    }"
NSQ_SOURCE_LINE 00000817 ""
NSQ_SOURCE_LINE 00000818 "    ## Extract chars from buffer."
NSQ_SOURCE_LINE 00000819 "    $line = $s->{buf};"
NSQ_SOURCE_LINE 00000820 "    $s->{buf} = \"\";"
NSQ_SOURCE_LINE 00000821 ""
NSQ_SOURCE_LINE 00000822 "    $line;"
NSQ_SOURCE_LINE 00000823 "} # end sub get"
