NSQ_SOURCE_LINE 00002458 "sub _append_lineno {"
NSQ_SOURCE_LINE 00002459 "    my ($obj, @msgs) = @_;"
NSQ_SOURCE_LINE 00002460 "    my ("
NSQ_SOURCE_LINE 00002461 "        $file,"
NSQ_SOURCE_LINE 00002462 "        $line,"
NSQ_SOURCE_LINE 00002463 "        $pkg,"
NSQ_SOURCE_LINE 00002464 "        );"
NSQ_SOURCE_LINE 00002465 ""
NSQ_SOURCE_LINE 00002466 "    ## Find the caller that's not in object's class or one of its base classes."
NSQ_SOURCE_LINE 00002467 "    ($pkg, $file , $line) = &_user_caller($obj);"
NSQ_SOURCE_LINE 00002468 "    join(\"\", @msgs, \" at \", $file, \" line \", $line, \"\\n\");"
NSQ_SOURCE_LINE 00002469 "} # end sub _append_lineno"
NSQ_SOURCE_LINE 00002470 ""
NSQ_SOURCE_LINE 00002471 ""
NSQ_SOURCE_LINE 00002472 "sub _carp {"
NSQ_SOURCE_LINE 00002473 "    my ($self) = @_;"
NSQ_SOURCE_LINE 00002474 "    my $s = *$self->{net_telnet};"
NSQ_SOURCE_LINE 00002475 ""
NSQ_SOURCE_LINE 00002476 "    $s->{errormsg} = &_append_lineno(@_);"
NSQ_SOURCE_LINE 00002477 "    warn $s->{errormsg}, \"\\n\";"
NSQ_SOURCE_LINE 00002478 "} # end sub _carp"
NSQ_SOURCE_LINE 00002479 ""
NSQ_SOURCE_LINE 00002480 ""
NSQ_SOURCE_LINE 00002481 "sub _croak {"
NSQ_SOURCE_LINE 00002482 "    my ($self) = @_;"
