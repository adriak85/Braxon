NSQ_SOURCE_LINE 00003478 "sub _parse_family {"
NSQ_SOURCE_LINE 00003479 "    my ($self, $family) = @_;"
NSQ_SOURCE_LINE 00003480 "    my ("
NSQ_SOURCE_LINE 00003481 "        $parsed_family,"
NSQ_SOURCE_LINE 00003482 "        );"
NSQ_SOURCE_LINE 00003483 ""
NSQ_SOURCE_LINE 00003484 "    unless (defined $family) {"
NSQ_SOURCE_LINE 00003485 "        $family = \"\";"
NSQ_SOURCE_LINE 00003486 "    }"
NSQ_SOURCE_LINE 00003487 ""
NSQ_SOURCE_LINE 00003488 "    if ($family =~ /^\\s*ipv4\\s*$/i) {  # family arg is \"ipv4\""
NSQ_SOURCE_LINE 00003489 "        $parsed_family = \"ipv4\";"
NSQ_SOURCE_LINE 00003490 "    }"
NSQ_SOURCE_LINE 00003491 "    elsif ($family =~ /^\\s*any\\s*$/i) {  # family arg is \"any\""
NSQ_SOURCE_LINE 00003492 "        if ($Socket::VERSION ge \"1.94\" and defined $AF_INET6) {  # has IPv6"
NSQ_SOURCE_LINE 00003493 "            $parsed_family = \"any\";"
NSQ_SOURCE_LINE 00003494 "        }"
NSQ_SOURCE_LINE 00003495 "        else {  # IPv6 not supported on this machine"
NSQ_SOURCE_LINE 00003496 "            $parsed_family = \"ipv4\";"
NSQ_SOURCE_LINE 00003497 "        }"
NSQ_SOURCE_LINE 00003498 "    }"
NSQ_SOURCE_LINE 00003499 "    elsif ($family =~ /^\\s*ipv6\\s*$/i) {  # family arg is \"ipv6\""
NSQ_SOURCE_LINE 00003500 "        return $self->error(\"Family arg ipv6 not supported when \" ."
NSQ_SOURCE_LINE 00003501 "                            \"Socket.pm version < 1.94\")"
NSQ_SOURCE_LINE 00003502 "            unless $Socket::VERSION ge \"1.94\";"
NSQ_SOURCE_LINE 00003503 "        return $self->error(\"Family arg ipv6 not supported by \" ."
NSQ_SOURCE_LINE 00003504 "                            \"this OS: AF_INET6 not in Socket.pm\")"
NSQ_SOURCE_LINE 00003505 "            unless defined $AF_INET6;"
NSQ_SOURCE_LINE 00003506 ""
NSQ_SOURCE_LINE 00003507 "        $parsed_family = \"ipv6\";"
NSQ_SOURCE_LINE 00003508 "    }"
NSQ_SOURCE_LINE 00003509 "    else {"
NSQ_SOURCE_LINE 00003510 "        return $self->error(\"bad Family argument \\\"$family\\\": \" ."
NSQ_SOURCE_LINE 00003511 "                            \"must be \\\"ipv4\\\", \\\"ipv6\\\", or \\\"any\\\"\");"
NSQ_SOURCE_LINE 00003512 "    }"
NSQ_SOURCE_LINE 00003513 ""
NSQ_SOURCE_LINE 00003514 "    $parsed_family;"
NSQ_SOURCE_LINE 00003515 "} # end sub _parse_family"
NSQ_SOURCE_LINE 00003516 ""
