NSQ_SOURCE_LINE 00002046 "sub put {"
NSQ_SOURCE_LINE 00002047 "    my ($self) = @_;"
NSQ_SOURCE_LINE 00002048 "    my ("
NSQ_SOURCE_LINE 00002049 "        $binmode,"
NSQ_SOURCE_LINE 00002050 "        $buf,"
NSQ_SOURCE_LINE 00002051 "        $errmode,"
NSQ_SOURCE_LINE 00002052 "        $is_timeout_arg,"
NSQ_SOURCE_LINE 00002053 "        $s,"
NSQ_SOURCE_LINE 00002054 "        $telnetmode,"
NSQ_SOURCE_LINE 00002055 "        $timeout,"
NSQ_SOURCE_LINE 00002056 "        %args,"
NSQ_SOURCE_LINE 00002057 "        );"
NSQ_SOURCE_LINE 00002058 "    local $_;"
NSQ_SOURCE_LINE 00002059 ""
NSQ_SOURCE_LINE 00002060 "    ## Init."
NSQ_SOURCE_LINE 00002061 "    $s = *$self->{net_telnet};"
NSQ_SOURCE_LINE 00002062 "    $s->{timedout} = '';"
NSQ_SOURCE_LINE 00002063 ""
NSQ_SOURCE_LINE 00002064 "    ## Parse args."
NSQ_SOURCE_LINE 00002065 "    if (@_ == 2) {  # one positional arg given"
NSQ_SOURCE_LINE 00002066 "        $buf = $_[1];"
NSQ_SOURCE_LINE 00002067 "    }"
NSQ_SOURCE_LINE 00002068 "    elsif (@_ > 2) {  # named args given"
NSQ_SOURCE_LINE 00002069 "        ## Get the named args."
NSQ_SOURCE_LINE 00002070 "        (undef, %args) = @_;"
NSQ_SOURCE_LINE 00002071 ""
NSQ_SOURCE_LINE 00002072 "        ## Parse the named args."
NSQ_SOURCE_LINE 00002073 "        foreach (keys %args) {"
NSQ_SOURCE_LINE 00002074 "            if (/^-?binmode$/i) {"
NSQ_SOURCE_LINE 00002075 "                $binmode = $args{$_};"
NSQ_SOURCE_LINE 00002076 "                unless (defined $binmode) {"
NSQ_SOURCE_LINE 00002077 "                    $binmode = 0;"
NSQ_SOURCE_LINE 00002078 "                }"
NSQ_SOURCE_LINE 00002079 "            }"
NSQ_SOURCE_LINE 00002080 "            elsif (/^-?errmode$/i) {"
NSQ_SOURCE_LINE 00002081 "                $errmode = &_parse_errmode($self, $args{$_});"
NSQ_SOURCE_LINE 00002082 "            }"
NSQ_SOURCE_LINE 00002083 "            elsif (/^-?string$/i) {"
NSQ_SOURCE_LINE 00002084 "                $buf = $args{$_};"
NSQ_SOURCE_LINE 00002085 "            }"
NSQ_SOURCE_LINE 00002086 "            elsif (/^-?telnetmode$/i) {"
NSQ_SOURCE_LINE 00002087 "                $telnetmode = $args{$_};"
NSQ_SOURCE_LINE 00002088 "                unless (defined $telnetmode) {"
NSQ_SOURCE_LINE 00002089 "                    $telnetmode = 0;"
NSQ_SOURCE_LINE 00002090 "                }"
NSQ_SOURCE_LINE 00002091 "            }"
NSQ_SOURCE_LINE 00002092 "            elsif (/^-?timeout$/i) {"
NSQ_SOURCE_LINE 00002093 "                $timeout = &_parse_timeout($self, $args{$_});"
NSQ_SOURCE_LINE 00002094 "                $is_timeout_arg = 1;"
NSQ_SOURCE_LINE 00002095 "            }"
NSQ_SOURCE_LINE 00002096 "            else {"
NSQ_SOURCE_LINE 00002097 "                &_croak($self, \"bad named parameter \\\"$_\\\" given \","
NSQ_SOURCE_LINE 00002098 "                        \"to \" . ref($self) . \"::put()\");"
NSQ_SOURCE_LINE 00002099 "            }"
NSQ_SOURCE_LINE 00002100 "        }"
NSQ_SOURCE_LINE 00002101 "    }"
NSQ_SOURCE_LINE 00002102 ""
NSQ_SOURCE_LINE 00002103 "    ## If any args given, override corresponding instance data."
NSQ_SOURCE_LINE 00002104 "    local $s->{bin_mode} = $binmode"
NSQ_SOURCE_LINE 00002105 "        if defined $binmode;"
NSQ_SOURCE_LINE 00002106 "    local $s->{errormode} = $errmode"
NSQ_SOURCE_LINE 00002107 "        if defined $errmode;"
NSQ_SOURCE_LINE 00002108 "    local $s->{telnet_mode} = $telnetmode"
NSQ_SOURCE_LINE 00002109 "        if defined $telnetmode;"
NSQ_SOURCE_LINE 00002110 "    local $s->{time_out} = $timeout"
NSQ_SOURCE_LINE 00002111 "        if defined $is_timeout_arg;"
NSQ_SOURCE_LINE 00002112 ""
NSQ_SOURCE_LINE 00002113 "    ## Check for errors."
NSQ_SOURCE_LINE 00002114 "    return $self->error(\"write error: filehandle isn't open\")"
NSQ_SOURCE_LINE 00002115 "        unless $s->{opened};"
NSQ_SOURCE_LINE 00002116 ""
NSQ_SOURCE_LINE 00002117 "    ## Log the output if requested."
NSQ_SOURCE_LINE 00002118 "    if ($s->{outputlog}) {"
NSQ_SOURCE_LINE 00002119 "        &_log_print($s->{outputlog}, $buf);"
NSQ_SOURCE_LINE 00002120 "    }"
NSQ_SOURCE_LINE 00002121 ""
NSQ_SOURCE_LINE 00002122 "    ## Convert native newlines to CR LF."
NSQ_SOURCE_LINE 00002123 "    if (!$s->{bin_mode}) {"
NSQ_SOURCE_LINE 00002124 "        $buf =~ s(\\n)(\\015\\012)g;"
NSQ_SOURCE_LINE 00002125 "    }"
NSQ_SOURCE_LINE 00002126 ""
NSQ_SOURCE_LINE 00002127 "    ## Escape TELNET IAC and also CR not followed by LF."
NSQ_SOURCE_LINE 00002128 "    if ($s->{telnet_mode}) {"
NSQ_SOURCE_LINE 00002129 "        $buf =~ s(\\377)(\\377\\377)g;"
NSQ_SOURCE_LINE 00002130 "        &_escape_cr(\\$buf);"
NSQ_SOURCE_LINE 00002131 "    }"
NSQ_SOURCE_LINE 00002132 ""
NSQ_SOURCE_LINE 00002133 "    &_put($self, \\$buf, \"put\");"
NSQ_SOURCE_LINE 00002134 "} # end sub put"
NSQ_SOURCE_LINE 00002135 ""
NSQ_SOURCE_LINE 00002136 ""
NSQ_SOURCE_LINE 00002137 "## Make rs() synonymous input_record_separator()."
NSQ_SOURCE_LINE 00002138 "sub rs { &input_record_separator; }"
NSQ_SOURCE_LINE 00002139 ""
NSQ_SOURCE_LINE 00002140 ""
