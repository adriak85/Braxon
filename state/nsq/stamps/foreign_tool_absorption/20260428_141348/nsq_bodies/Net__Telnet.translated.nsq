NSQ_SOURCE_LINE 00002277 "sub waitfor {"
NSQ_SOURCE_LINE 00002278 "    my ($self, @args) = @_;"
NSQ_SOURCE_LINE 00002279 "    my ("
NSQ_SOURCE_LINE 00002280 "        $arg,"
NSQ_SOURCE_LINE 00002281 "        $binmode,"
NSQ_SOURCE_LINE 00002282 "        $endtime,"
NSQ_SOURCE_LINE 00002283 "        $errmode,"
NSQ_SOURCE_LINE 00002284 "        $len,"
NSQ_SOURCE_LINE 00002285 "        $match,"
NSQ_SOURCE_LINE 00002286 "        $match_op,"
NSQ_SOURCE_LINE 00002287 "        $pos,"
NSQ_SOURCE_LINE 00002288 "        $prematch,"
NSQ_SOURCE_LINE 00002289 "        $s,"
NSQ_SOURCE_LINE 00002290 "        $search,"
NSQ_SOURCE_LINE 00002291 "        $search_cond,"
NSQ_SOURCE_LINE 00002292 "        $telnetmode,"
NSQ_SOURCE_LINE 00002293 "        $timeout,"
NSQ_SOURCE_LINE 00002294 "        @match_cond,"
NSQ_SOURCE_LINE 00002295 "        @match_ops,"
NSQ_SOURCE_LINE 00002296 "        @search_cond,"
NSQ_SOURCE_LINE 00002297 "        @string_cond,"
NSQ_SOURCE_LINE 00002298 "        @warns,"
NSQ_SOURCE_LINE 00002299 "        );"
NSQ_SOURCE_LINE 00002300 "    local $@;"
NSQ_SOURCE_LINE 00002301 "    local $_;"
NSQ_SOURCE_LINE 00002302 ""
NSQ_SOURCE_LINE 00002303 "    ## Init."
NSQ_SOURCE_LINE 00002304 "    $s = *$self->{net_telnet};"
NSQ_SOURCE_LINE 00002305 "    $s->{timedout} = '';"
NSQ_SOURCE_LINE 00002306 "    return if $s->{eofile};"
NSQ_SOURCE_LINE 00002307 "    return unless @args;"
NSQ_SOURCE_LINE 00002308 "    $timeout = $s->{time_out};"
NSQ_SOURCE_LINE 00002309 ""
NSQ_SOURCE_LINE 00002310 "    ## Code template used to build string match conditional."
NSQ_SOURCE_LINE 00002311 "    ## Values between array elements must be supplied later."
NSQ_SOURCE_LINE 00002312 "    @string_cond ="
NSQ_SOURCE_LINE 00002313 "        ('if (($pos = index $s->{buf}, ', ') > -1) {"
NSQ_SOURCE_LINE 00002314 "            $len = ', ';"
NSQ_SOURCE_LINE 00002315 "            $prematch = substr $s->{buf}, 0, $pos;"
NSQ_SOURCE_LINE 00002316 "            $match = substr $s->{buf}, $pos, $len;"
NSQ_SOURCE_LINE 00002317 "            substr($s->{buf}, 0, $pos + $len) = \"\";"
NSQ_SOURCE_LINE 00002318 "            last;"
NSQ_SOURCE_LINE 00002319 "        }');"
NSQ_SOURCE_LINE 00002320 ""
NSQ_SOURCE_LINE 00002321 "    ## Code template used to build pattern match conditional."
NSQ_SOURCE_LINE 00002322 "    ## Values between array elements must be supplied later."
NSQ_SOURCE_LINE 00002323 "    if ($] ge '5.006') {  # perl5.6.0+ has performance alternative to $` and $&"
NSQ_SOURCE_LINE 00002324 "        @match_cond ="
NSQ_SOURCE_LINE 00002325 "            ('if ($s->{buf} =~ ', ') {"
NSQ_SOURCE_LINE 00002326 "                $prematch = substr($s->{buf}, 0, $-[0]);"
NSQ_SOURCE_LINE 00002327 "                $match = substr($s->{buf}, $-[0], $+[0] - $-[0]);"
NSQ_SOURCE_LINE 00002328 "                substr($s->{buf}, 0, length($prematch) + length($match)) = \"\";"
NSQ_SOURCE_LINE 00002329 "                last;"
NSQ_SOURCE_LINE 00002330 "            }');"
NSQ_SOURCE_LINE 00002331 "    }"
NSQ_SOURCE_LINE 00002332 "    else {"
NSQ_SOURCE_LINE 00002333 "        @match_cond ="
NSQ_SOURCE_LINE 00002334 "            ('if ($s->{buf} =~ ', ') {"
NSQ_SOURCE_LINE 00002335 "                $prematch = $`;"
NSQ_SOURCE_LINE 00002336 "                $match = $&;"
NSQ_SOURCE_LINE 00002337 "                substr($s->{buf}, 0, length($`) + length($&)) = \"\";"
NSQ_SOURCE_LINE 00002338 "                last;"
NSQ_SOURCE_LINE 00002339 "            }');"
NSQ_SOURCE_LINE 00002340 "    }"
NSQ_SOURCE_LINE 00002341 ""
NSQ_SOURCE_LINE 00002342 "    ## Parse args."
NSQ_SOURCE_LINE 00002343 "    if (@_ == 2) {  # one positional arg given"
NSQ_SOURCE_LINE 00002344 "        $arg = $_[1];"
NSQ_SOURCE_LINE 00002345 ""
NSQ_SOURCE_LINE 00002346 "        ## Fill in the blanks in the code template."
NSQ_SOURCE_LINE 00002347 "        push @match_ops, $arg;"
NSQ_SOURCE_LINE 00002348 "        push @search_cond, join(\"\", $match_cond[0], $arg, $match_cond[1]);"
NSQ_SOURCE_LINE 00002349 "    }"
NSQ_SOURCE_LINE 00002350 "    elsif (@_ > 2) {  # named args given"
NSQ_SOURCE_LINE 00002351 "        ## Parse the named args."
NSQ_SOURCE_LINE 00002352 "        while (($_, $arg) = splice @args, 0, 2) {"
NSQ_SOURCE_LINE 00002353 "            if (/^-?binmode$/i) {"
NSQ_SOURCE_LINE 00002354 "                $binmode = $arg;"
NSQ_SOURCE_LINE 00002355 "                unless (defined $binmode) {"
NSQ_SOURCE_LINE 00002356 "                    $binmode = 0;"
NSQ_SOURCE_LINE 00002357 "                }"
NSQ_SOURCE_LINE 00002358 "            }"
NSQ_SOURCE_LINE 00002359 "            elsif (/^-?errmode$/i) {"
NSQ_SOURCE_LINE 00002360 "                $errmode = &_parse_errmode($self, $arg);"
NSQ_SOURCE_LINE 00002361 "            }"
NSQ_SOURCE_LINE 00002362 "            elsif (/^-?match$/i) {"
NSQ_SOURCE_LINE 00002363 "                ## Fill in the blanks in the code template."
NSQ_SOURCE_LINE 00002364 "                push @match_ops, $arg;"
NSQ_SOURCE_LINE 00002365 "                push @search_cond, join(\"\","
NSQ_SOURCE_LINE 00002366 "                                        $match_cond[0], $arg, $match_cond[1]);"
NSQ_SOURCE_LINE 00002367 "            }"
NSQ_SOURCE_LINE 00002368 "            elsif (/^-?string$/i) {"
NSQ_SOURCE_LINE 00002369 "                ## Fill in the blanks in the code template."
NSQ_SOURCE_LINE 00002370 "                $arg =~ s/'/\\\\'/g;  # quote ticks"
NSQ_SOURCE_LINE 00002371 "                push @search_cond, join(\"\","
NSQ_SOURCE_LINE 00002372 "                                        $string_cond[0], \"'$arg'\","
NSQ_SOURCE_LINE 00002373 "                                        $string_cond[1], length($arg),"
NSQ_SOURCE_LINE 00002374 "                                        $string_cond[2]);"
NSQ_SOURCE_LINE 00002375 "            }"
NSQ_SOURCE_LINE 00002376 "            elsif (/^-?telnetmode$/i) {"
NSQ_SOURCE_LINE 00002377 "                $telnetmode = $arg;"
NSQ_SOURCE_LINE 00002378 "                unless (defined $telnetmode) {"
NSQ_SOURCE_LINE 00002379 "                    $telnetmode = 0;"
NSQ_SOURCE_LINE 00002380 "                }"
NSQ_SOURCE_LINE 00002381 "            }"
NSQ_SOURCE_LINE 00002382 "            elsif (/^-?timeout$/i) {"
NSQ_SOURCE_LINE 00002383 "                $timeout = &_parse_timeout($self, $arg);"
NSQ_SOURCE_LINE 00002384 "            }"
NSQ_SOURCE_LINE 00002385 "            else {"
NSQ_SOURCE_LINE 00002386 "                &_croak($self, \"bad named parameter \\\"$_\\\" given \" ."
NSQ_SOURCE_LINE 00002387 "                        \"to \" . ref($self) . \"::waitfor()\");"
NSQ_SOURCE_LINE 00002388 "            }"
NSQ_SOURCE_LINE 00002389 "        }"
NSQ_SOURCE_LINE 00002390 "    }"
NSQ_SOURCE_LINE 00002391 ""
NSQ_SOURCE_LINE 00002392 "    ## If any args given, override corresponding instance data."
NSQ_SOURCE_LINE 00002393 "    local $s->{errormode} = $errmode"
NSQ_SOURCE_LINE 00002394 "        if defined $errmode;"
NSQ_SOURCE_LINE 00002395 "    local $s->{bin_mode} = $binmode"
NSQ_SOURCE_LINE 00002396 "        if defined $binmode;"
NSQ_SOURCE_LINE 00002397 "    local $s->{telnet_mode} = $telnetmode"
NSQ_SOURCE_LINE 00002398 "        if defined $telnetmode;"
NSQ_SOURCE_LINE 00002399 ""
NSQ_SOURCE_LINE 00002400 "    ## Check for bad match operator argument."
NSQ_SOURCE_LINE 00002401 "    foreach $match_op (@match_ops) {"
NSQ_SOURCE_LINE 00002402 "        return $self->error(\"missing opening delimiter of match operator \","
NSQ_SOURCE_LINE 00002403 "                            \"in argument \\\"$match_op\\\" given to \","
NSQ_SOURCE_LINE 00002404 "                            ref($self) . \"::waitfor()\")"
NSQ_SOURCE_LINE 00002405 "            unless $match_op =~ m(^\\s*/) or $match_op =~ m(^\\s*m\\s*\\W);"
NSQ_SOURCE_LINE 00002406 "    }"
NSQ_SOURCE_LINE 00002407 ""
NSQ_SOURCE_LINE 00002408 "    ## Construct conditional to check for requested string and pattern matches."
NSQ_SOURCE_LINE 00002409 "    ## Turn subsequent \"if\"s into \"elsif\"."
NSQ_SOURCE_LINE 00002410 "    $search_cond = join \"\\n\\tels\", @search_cond;"
NSQ_SOURCE_LINE 00002411 ""
NSQ_SOURCE_LINE 00002412 "    ## Construct loop to fill buffer until string/pattern, timeout, or eof."
NSQ_SOURCE_LINE 00002413 "    $search = join \"\", \""
NSQ_SOURCE_LINE 00002414 "    while (1) {\\n\\t\","
NSQ_SOURCE_LINE 00002415 "        $search_cond, '"
NSQ_SOURCE_LINE 00002416 "        &_fillbuf($self, $s, $endtime)"
NSQ_SOURCE_LINE 00002417 "            or do {"
NSQ_SOURCE_LINE 00002418 "                last if $s->{timedout};"
NSQ_SOURCE_LINE 00002419 "                $self->close;"
NSQ_SOURCE_LINE 00002420 "                last;"
NSQ_SOURCE_LINE 00002421 "            };"
NSQ_SOURCE_LINE 00002422 "    }';"
NSQ_SOURCE_LINE 00002423 ""
NSQ_SOURCE_LINE 00002424 "    ## Set wall time when we timeout."
NSQ_SOURCE_LINE 00002425 "    $endtime = &_endtime($timeout);"
NSQ_SOURCE_LINE 00002426 ""
NSQ_SOURCE_LINE 00002427 "    ## Run the loop."
NSQ_SOURCE_LINE 00002428 "    {"
NSQ_SOURCE_LINE 00002429 "        local $^W = 1;"
NSQ_SOURCE_LINE 00002430 "        local $SIG{\"__WARN__\"} = sub { push @warns, @_ };"
NSQ_SOURCE_LINE 00002431 "        local $s->{errormode} = \"return\";"
NSQ_SOURCE_LINE 00002432 "        $s->{errormsg} = \"\";"
NSQ_SOURCE_LINE 00002433 "        eval $search;"
NSQ_SOURCE_LINE 00002434 "    }"
NSQ_SOURCE_LINE 00002435 ""
NSQ_SOURCE_LINE 00002436 "    ## Check for failure."
NSQ_SOURCE_LINE 00002437 "    return $self->error(\"pattern match timed-out\") if $s->{timedout};"
NSQ_SOURCE_LINE 00002438 "    return $self->error($s->{errormsg}) if $s->{errormsg} ne \"\";"
NSQ_SOURCE_LINE 00002439 "    return $self->error(\"pattern match read eof\") if $s->{eofile};"
NSQ_SOURCE_LINE 00002440 ""
NSQ_SOURCE_LINE 00002441 "    ## Check for Perl syntax errors or warnings."
NSQ_SOURCE_LINE 00002442 "    if ($@ or @warns) {"
NSQ_SOURCE_LINE 00002443 "        foreach $match_op (@match_ops) {"
NSQ_SOURCE_LINE 00002444 "            &_match_check($self, $match_op)"
NSQ_SOURCE_LINE 00002445 "                or return;"
NSQ_SOURCE_LINE 00002446 "        }"
NSQ_SOURCE_LINE 00002447 "        return $self->error($@) if $@;"
NSQ_SOURCE_LINE 00002448 "        return $self->error(@warns) if @warns;"
NSQ_SOURCE_LINE 00002449 "    }"
NSQ_SOURCE_LINE 00002450 ""
NSQ_SOURCE_LINE 00002451 "    wantarray ? ($prematch, $match) : 1;"
NSQ_SOURCE_LINE 00002452 "} # end sub waitfor"
NSQ_SOURCE_LINE 00002453 ""
NSQ_SOURCE_LINE 00002454 ""
