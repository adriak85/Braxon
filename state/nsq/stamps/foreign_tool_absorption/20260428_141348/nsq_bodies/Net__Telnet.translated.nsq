NSQ_SOURCE_LINE 00001981 "sub print {"
NSQ_SOURCE_LINE 00001982 "    my ($self) = shift;"
NSQ_SOURCE_LINE 00001983 "    my ("
NSQ_SOURCE_LINE 00001984 "        $buf,"
NSQ_SOURCE_LINE 00001985 "        $fh,"
NSQ_SOURCE_LINE 00001986 "        $s,"
NSQ_SOURCE_LINE 00001987 "        );"
NSQ_SOURCE_LINE 00001988 ""
NSQ_SOURCE_LINE 00001989 "    $s = *$self->{net_telnet};"
NSQ_SOURCE_LINE 00001990 "    $s->{timedout} = '';"
NSQ_SOURCE_LINE 00001991 "    return $self->error(\"write error: filehandle isn't open\")"
NSQ_SOURCE_LINE 00001992 "        unless $s->{opened};"
NSQ_SOURCE_LINE 00001993 ""
NSQ_SOURCE_LINE 00001994 "    ## Add field and record separators."
NSQ_SOURCE_LINE 00001995 "    $buf = join($s->{\"ofs\"}, @_) . $s->{\"ors\"};"
NSQ_SOURCE_LINE 00001996 ""
NSQ_SOURCE_LINE 00001997 "    ## Log the output if requested."
NSQ_SOURCE_LINE 00001998 "    if ($s->{outputlog}) {"
NSQ_SOURCE_LINE 00001999 "        &_log_print($s->{outputlog}, $buf);"
NSQ_SOURCE_LINE 00002000 "    }"
NSQ_SOURCE_LINE 00002001 ""
NSQ_SOURCE_LINE 00002002 "    ## Convert native newlines to CR LF."
NSQ_SOURCE_LINE 00002003 "    if (!$s->{bin_mode}) {"
NSQ_SOURCE_LINE 00002004 "        $buf =~ s(\\n)(\\015\\012)g;"
NSQ_SOURCE_LINE 00002005 "    }"
NSQ_SOURCE_LINE 00002006 ""
NSQ_SOURCE_LINE 00002007 "    ## Escape TELNET IAC and also CR not followed by LF."
NSQ_SOURCE_LINE 00002008 "    if ($s->{telnet_mode}) {"
NSQ_SOURCE_LINE 00002009 "        $buf =~ s(\\377)(\\377\\377)g;"
NSQ_SOURCE_LINE 00002010 "        &_escape_cr(\\$buf);"
NSQ_SOURCE_LINE 00002011 "    }"
NSQ_SOURCE_LINE 00002012 ""
NSQ_SOURCE_LINE 00002013 "    &_put($self, \\$buf, \"print\");"
NSQ_SOURCE_LINE 00002014 "} # end sub print"
NSQ_SOURCE_LINE 00002015 ""
NSQ_SOURCE_LINE 00002016 ""
