NSQ_SOURCE_LINE 00000826 "sub getline {"
NSQ_SOURCE_LINE 00000827 "    my ($self, %args) = @_;"
NSQ_SOURCE_LINE 00000828 "    my ("
NSQ_SOURCE_LINE 00000829 "        $binmode,"
NSQ_SOURCE_LINE 00000830 "        $endtime,"
NSQ_SOURCE_LINE 00000831 "        $errmode,"
NSQ_SOURCE_LINE 00000832 "        $len,"
NSQ_SOURCE_LINE 00000833 "        $line,"
NSQ_SOURCE_LINE 00000834 "        $offset,"
NSQ_SOURCE_LINE 00000835 "        $pos,"
NSQ_SOURCE_LINE 00000836 "        $rs,"
NSQ_SOURCE_LINE 00000837 "        $s,"
NSQ_SOURCE_LINE 00000838 "        $telnetmode,"
NSQ_SOURCE_LINE 00000839 "        $timeout,"
NSQ_SOURCE_LINE 00000840 "        );"
NSQ_SOURCE_LINE 00000841 "    local $_;"
NSQ_SOURCE_LINE 00000842 ""
NSQ_SOURCE_LINE 00000843 "    ## Init."
NSQ_SOURCE_LINE 00000844 "    $s = *$self->{net_telnet};"
NSQ_SOURCE_LINE 00000845 "    $s->{timedout} = '';"
NSQ_SOURCE_LINE 00000846 "    return if $s->{eofile};"
NSQ_SOURCE_LINE 00000847 "    $rs = $s->{\"rs\"};"
NSQ_SOURCE_LINE 00000848 "    $timeout = $s->{time_out};"
NSQ_SOURCE_LINE 00000849 ""
NSQ_SOURCE_LINE 00000850 "    ## Parse the named args."
NSQ_SOURCE_LINE 00000851 "    foreach (keys %args) {"
NSQ_SOURCE_LINE 00000852 "        if (/^-?binmode$/i) {"
NSQ_SOURCE_LINE 00000853 "            $binmode = $args{$_};"
NSQ_SOURCE_LINE 00000854 "            unless (defined $binmode) {"
NSQ_SOURCE_LINE 00000855 "                $binmode = 0;"
NSQ_SOURCE_LINE 00000856 "            }"
NSQ_SOURCE_LINE 00000857 "        }"
NSQ_SOURCE_LINE 00000858 "        elsif (/^-?errmode$/i) {"
NSQ_SOURCE_LINE 00000859 "            $errmode = &_parse_errmode($self, $args{$_});"
NSQ_SOURCE_LINE 00000860 "        }"
NSQ_SOURCE_LINE 00000861 "        elsif (/^-?input_record_separator$/i or /^-?rs$/i) {"
NSQ_SOURCE_LINE 00000862 "            $rs = &_parse_input_record_separator($self, $args{$_});"
NSQ_SOURCE_LINE 00000863 "        }"
NSQ_SOURCE_LINE 00000864 "        elsif (/^-?telnetmode$/i) {"
NSQ_SOURCE_LINE 00000865 "            $telnetmode = $args{$_};"
NSQ_SOURCE_LINE 00000866 "            unless (defined $telnetmode) {"
NSQ_SOURCE_LINE 00000867 "                $telnetmode = 0;"
NSQ_SOURCE_LINE 00000868 "            }"
NSQ_SOURCE_LINE 00000869 "        }"
NSQ_SOURCE_LINE 00000870 "        elsif (/^-?timeout$/i) {"
NSQ_SOURCE_LINE 00000871 "            $timeout = &_parse_timeout($self, $args{$_});"
NSQ_SOURCE_LINE 00000872 "        }"
NSQ_SOURCE_LINE 00000873 "        else {"
NSQ_SOURCE_LINE 00000874 "            &_croak($self, \"bad named parameter \\\"$_\\\" given \" ."
NSQ_SOURCE_LINE 00000875 "                    \"to \" . ref($self) . \"::getline()\");"
NSQ_SOURCE_LINE 00000876 "        }"
NSQ_SOURCE_LINE 00000877 "    }"
NSQ_SOURCE_LINE 00000878 ""
NSQ_SOURCE_LINE 00000879 "    ## If any args given, override corresponding instance data."
NSQ_SOURCE_LINE 00000880 "    local $s->{bin_mode} = $binmode"
NSQ_SOURCE_LINE 00000881 "        if defined $binmode;"
NSQ_SOURCE_LINE 00000882 "    local $s->{errormode} = $errmode"
NSQ_SOURCE_LINE 00000883 "        if defined $errmode;"
NSQ_SOURCE_LINE 00000884 "    local $s->{telnet_mode} = $telnetmode"
NSQ_SOURCE_LINE 00000885 "        if defined $telnetmode;"
NSQ_SOURCE_LINE 00000886 ""
NSQ_SOURCE_LINE 00000887 "    ## Set wall time when we time out."
NSQ_SOURCE_LINE 00000888 "    $endtime = &_endtime($timeout);"
NSQ_SOURCE_LINE 00000889 ""
NSQ_SOURCE_LINE 00000890 "    ## Try to send any waiting option negotiation."
NSQ_SOURCE_LINE 00000891 "    if (length $s->{unsent_opts}) {"
NSQ_SOURCE_LINE 00000892 "        &_flush_opts($self);"
NSQ_SOURCE_LINE 00000893 "    }"
NSQ_SOURCE_LINE 00000894 ""
NSQ_SOURCE_LINE 00000895 "    ## Keep reading into buffer until end-of-line is read."
NSQ_SOURCE_LINE 00000896 "    $offset = 0;"
NSQ_SOURCE_LINE 00000897 "    while (($pos = index($s->{buf}, $rs, $offset)) == -1) {"
NSQ_SOURCE_LINE 00000898 "        $offset = length $s->{buf};"
NSQ_SOURCE_LINE 00000899 "        &_fillbuf($self, $s, $endtime)"
NSQ_SOURCE_LINE 00000900 "            or do {"
NSQ_SOURCE_LINE 00000901 "                return if $s->{timedout};"
NSQ_SOURCE_LINE 00000902 ""
NSQ_SOURCE_LINE 00000903 "                ## We've reached end-of-file."
NSQ_SOURCE_LINE 00000904 "                $self->close;"
NSQ_SOURCE_LINE 00000905 "                if (length $s->{buf}) {"
NSQ_SOURCE_LINE 00000906 "                    return $s->{buf};"
NSQ_SOURCE_LINE 00000907 "                }"
NSQ_SOURCE_LINE 00000908 "                else {"
NSQ_SOURCE_LINE 00000909 "                    return;"
NSQ_SOURCE_LINE 00000910 "                }"
NSQ_SOURCE_LINE 00000911 "            };"
NSQ_SOURCE_LINE 00000912 "    }"
NSQ_SOURCE_LINE 00000913 ""
NSQ_SOURCE_LINE 00000914 "    ## Extract line from buffer."
NSQ_SOURCE_LINE 00000915 "    $len = $pos + length $rs;"
NSQ_SOURCE_LINE 00000916 "    $line = substr($s->{buf}, 0, $len);"
NSQ_SOURCE_LINE 00000917 "    substr($s->{buf}, 0, $len) = \"\";"
NSQ_SOURCE_LINE 00000918 ""
NSQ_SOURCE_LINE 00000919 "    $line;"
NSQ_SOURCE_LINE 00000920 "} # end sub getline"
NSQ_SOURCE_LINE 00000921 ""
NSQ_SOURCE_LINE 00000922 ""
NSQ_SOURCE_LINE 00000923 "sub getlines {"
NSQ_SOURCE_LINE 00000924 "    my ($self, %args) = @_;"
NSQ_SOURCE_LINE 00000925 "    my ("
NSQ_SOURCE_LINE 00000926 "        $binmode,"
NSQ_SOURCE_LINE 00000927 "        $errmode,"
NSQ_SOURCE_LINE 00000928 "        $line,"
NSQ_SOURCE_LINE 00000929 "        $rs,"
NSQ_SOURCE_LINE 00000930 "        $s,"
NSQ_SOURCE_LINE 00000931 "        $telnetmode,"
NSQ_SOURCE_LINE 00000932 "        $timeout,"
NSQ_SOURCE_LINE 00000933 "        );"
NSQ_SOURCE_LINE 00000934 "    my $all = 1;"
NSQ_SOURCE_LINE 00000935 "    my @lines = ();"
NSQ_SOURCE_LINE 00000936 "    local $_;"
NSQ_SOURCE_LINE 00000937 ""
NSQ_SOURCE_LINE 00000938 "    ## Init."
NSQ_SOURCE_LINE 00000939 "    $s = *$self->{net_telnet};"
NSQ_SOURCE_LINE 00000940 "    $s->{timedout} = '';"
NSQ_SOURCE_LINE 00000941 "    return if $s->{eofile};"
NSQ_SOURCE_LINE 00000942 "    $timeout = $s->{time_out};"
NSQ_SOURCE_LINE 00000943 ""
NSQ_SOURCE_LINE 00000944 "    ## Parse the named args."
NSQ_SOURCE_LINE 00000945 "    foreach (keys %args) {"
NSQ_SOURCE_LINE 00000946 "        if (/^-?all$/i) {"
NSQ_SOURCE_LINE 00000947 "            $all = $args{$_};"
NSQ_SOURCE_LINE 00000948 "            unless (defined $all) {"
NSQ_SOURCE_LINE 00000949 "                $all = '';"
NSQ_SOURCE_LINE 00000950 "            }"
NSQ_SOURCE_LINE 00000951 "        }"
NSQ_SOURCE_LINE 00000952 "        elsif (/^-?binmode$/i) {"
NSQ_SOURCE_LINE 00000953 "            $binmode = $args{$_};"
NSQ_SOURCE_LINE 00000954 "            unless (defined $binmode) {"
NSQ_SOURCE_LINE 00000955 "                $binmode = 0;"
NSQ_SOURCE_LINE 00000956 "            }"
NSQ_SOURCE_LINE 00000957 "        }"
NSQ_SOURCE_LINE 00000958 "        elsif (/^-?errmode$/i) {"
NSQ_SOURCE_LINE 00000959 "            $errmode = &_parse_errmode($self, $args{$_});"
NSQ_SOURCE_LINE 00000960 "        }"
NSQ_SOURCE_LINE 00000961 "        elsif (/^-?input_record_separator$/i or /^-?rs$/i) {"
NSQ_SOURCE_LINE 00000962 "            $rs = &_parse_input_record_separator($self, $args{$_});"
NSQ_SOURCE_LINE 00000963 "        }"
NSQ_SOURCE_LINE 00000964 "        elsif (/^-?telnetmode$/i) {"
NSQ_SOURCE_LINE 00000965 "            $telnetmode = $args{$_};"
NSQ_SOURCE_LINE 00000966 "            unless (defined $telnetmode) {"
NSQ_SOURCE_LINE 00000967 "                $telnetmode = 0;"
NSQ_SOURCE_LINE 00000968 "            }"
NSQ_SOURCE_LINE 00000969 "        }"
NSQ_SOURCE_LINE 00000970 "        elsif (/^-?timeout$/i) {"
NSQ_SOURCE_LINE 00000971 "            $timeout = &_parse_timeout($self, $args{$_});"
NSQ_SOURCE_LINE 00000972 "        }"
NSQ_SOURCE_LINE 00000973 "        else {"
NSQ_SOURCE_LINE 00000974 "            &_croak($self, \"bad named parameter \\\"$_\\\" given \" ."
NSQ_SOURCE_LINE 00000975 "                    \"to \" . ref($self) . \"::getlines()\");"
NSQ_SOURCE_LINE 00000976 "        }"
NSQ_SOURCE_LINE 00000977 "    }"
NSQ_SOURCE_LINE 00000978 ""
NSQ_SOURCE_LINE 00000979 "    ## If any args given, override corresponding instance data."
NSQ_SOURCE_LINE 00000980 "    local $s->{bin_mode} = $binmode"
NSQ_SOURCE_LINE 00000981 "        if defined $binmode;"
NSQ_SOURCE_LINE 00000982 "    local $s->{errormode} = $errmode"
NSQ_SOURCE_LINE 00000983 "        if defined $errmode;"
NSQ_SOURCE_LINE 00000984 "    local $s->{\"rs\"} = $rs"
NSQ_SOURCE_LINE 00000985 "        if defined $rs;"
NSQ_SOURCE_LINE 00000986 "    local $s->{telnet_mode} = $telnetmode"
NSQ_SOURCE_LINE 00000987 "        if defined $telnetmode;"
NSQ_SOURCE_LINE 00000988 "    local $s->{time_out} = &_endtime($timeout);"
NSQ_SOURCE_LINE 00000989 ""
NSQ_SOURCE_LINE 00000990 "    ## User requested only the currently available lines."
NSQ_SOURCE_LINE 00000991 "    if (! $all) {"
NSQ_SOURCE_LINE 00000992 "        return &_next_getlines($self, $s);"
NSQ_SOURCE_LINE 00000993 "    }"
NSQ_SOURCE_LINE 00000994 ""
NSQ_SOURCE_LINE 00000995 "    ## Read lines until eof or error."
NSQ_SOURCE_LINE 00000996 "    while (1) {"
NSQ_SOURCE_LINE 00000997 "        $line = $self->getline"
NSQ_SOURCE_LINE 00000998 "            or last;"
NSQ_SOURCE_LINE 00000999 "        push @lines, $line;"
NSQ_SOURCE_LINE 00001000 "    }"
NSQ_SOURCE_LINE 00001001 ""
NSQ_SOURCE_LINE 00001002 "    ## Check for error."
NSQ_SOURCE_LINE 00001003 "    return if ! $self->eof;"
NSQ_SOURCE_LINE 00001004 ""
NSQ_SOURCE_LINE 00001005 "    @lines;"
NSQ_SOURCE_LINE 00001006 "} # end sub getlines"
