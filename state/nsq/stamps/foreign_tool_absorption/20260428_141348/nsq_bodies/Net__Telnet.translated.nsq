NSQ_SOURCE_LINE 00000070 "sub new {"
NSQ_SOURCE_LINE 00000071 "    my ($class) = @_;"
NSQ_SOURCE_LINE 00000072 "    my ("
NSQ_SOURCE_LINE 00000073 "        $dump_log,"
NSQ_SOURCE_LINE 00000074 "        $errmode,"
NSQ_SOURCE_LINE 00000075 "        $family,"
NSQ_SOURCE_LINE 00000076 "        $fh_open,"
NSQ_SOURCE_LINE 00000077 "        $host,"
NSQ_SOURCE_LINE 00000078 "        $input_log,"
NSQ_SOURCE_LINE 00000079 "        $localfamily,"
NSQ_SOURCE_LINE 00000080 "        $option_log,"
NSQ_SOURCE_LINE 00000081 "        $output_log,"
NSQ_SOURCE_LINE 00000082 "        $port,"
NSQ_SOURCE_LINE 00000083 "        $prompt,"
NSQ_SOURCE_LINE 00000084 "        $self,"
NSQ_SOURCE_LINE 00000085 "        %args,"
NSQ_SOURCE_LINE 00000086 "        );"
NSQ_SOURCE_LINE 00000087 "    local $_;"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "    ## Create a new object with defaults."
NSQ_SOURCE_LINE 00000090 "    $self = $class->SUPER::new;"
NSQ_SOURCE_LINE 00000091 "    *$self->{net_telnet} = {"
NSQ_SOURCE_LINE 00000092 "        bin_mode         => 0,"
NSQ_SOURCE_LINE 00000093 "        blksize          => &_optimal_blksize(),"
NSQ_SOURCE_LINE 00000094 "        buf              => \"\","
NSQ_SOURCE_LINE 00000095 "        cmd_prompt       => '/[\\$%#>] $/',"
NSQ_SOURCE_LINE 00000096 "        cmd_rm_mode      => \"auto\","
NSQ_SOURCE_LINE 00000097 "        dumplog          => '',"
NSQ_SOURCE_LINE 00000098 "        eofile           => 1,"
NSQ_SOURCE_LINE 00000099 "        errormode        => \"die\","
NSQ_SOURCE_LINE 00000100 "        errormsg         => \"\","
NSQ_SOURCE_LINE 00000101 "        fdmask           => '',"
NSQ_SOURCE_LINE 00000102 "        host             => \"localhost\","
NSQ_SOURCE_LINE 00000103 "        inputlog         => '',"
NSQ_SOURCE_LINE 00000104 "        last_line        => \"\","
NSQ_SOURCE_LINE 00000105 "        last_prompt      => \"\","
NSQ_SOURCE_LINE 00000106 "        local_family     => \"ipv4\","
NSQ_SOURCE_LINE 00000107 "        local_host       => \"\","
NSQ_SOURCE_LINE 00000108 "        maxbufsize       => 1_048_576,"
NSQ_SOURCE_LINE 00000109 "        num_wrote        => 0,"
NSQ_SOURCE_LINE 00000110 "        ofs              => \"\","
NSQ_SOURCE_LINE 00000111 "        opened           => '',"
NSQ_SOURCE_LINE 00000112 "        opt_cback        => '',"
NSQ_SOURCE_LINE 00000113 "        opt_log          => '',"
NSQ_SOURCE_LINE 00000114 "        opts             => {},"
NSQ_SOURCE_LINE 00000115 "        ors              => \"\\n\","
NSQ_SOURCE_LINE 00000116 "        outputlog        => '',"
NSQ_SOURCE_LINE 00000117 "        peer_family      => \"ipv4\","
NSQ_SOURCE_LINE 00000118 "        pending_errormsg => \"\","
NSQ_SOURCE_LINE 00000119 "        port             => 23,"
NSQ_SOURCE_LINE 00000120 "        pushback_buf     => \"\","
NSQ_SOURCE_LINE 00000121 "        rs               => \"\\n\","
NSQ_SOURCE_LINE 00000122 "        select_supported => 1,"
NSQ_SOURCE_LINE 00000123 "        sock_family      => 0,"
NSQ_SOURCE_LINE 00000124 "        subopt_cback     => '',"
NSQ_SOURCE_LINE 00000125 "        telnet_mode      => 1,"
NSQ_SOURCE_LINE 00000126 "        time_out         => 10,"
NSQ_SOURCE_LINE 00000127 "        timedout         => '',"
NSQ_SOURCE_LINE 00000128 "        unsent_opts      => \"\","
NSQ_SOURCE_LINE 00000129 "    };"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "    ## Indicate that we'll accept an offer from remote side for it to echo"
NSQ_SOURCE_LINE 00000132 "    ## and suppress go aheads."
NSQ_SOURCE_LINE 00000133 "    &_opt_accept($self,"
NSQ_SOURCE_LINE 00000134 "                 { option    => &TELOPT_ECHO,"
NSQ_SOURCE_LINE 00000135 "                   is_remote => 1,"
NSQ_SOURCE_LINE 00000136 "                   is_enable => 1 },"
NSQ_SOURCE_LINE 00000137 "                 { option    => &TELOPT_SGA,"
NSQ_SOURCE_LINE 00000138 "                   is_remote => 1,"
NSQ_SOURCE_LINE 00000139 "                   is_enable => 1 },"
NSQ_SOURCE_LINE 00000140 "                 );"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "    ## Parse the args."
NSQ_SOURCE_LINE 00000143 "    if (@_ == 2) {  # one positional arg given"
NSQ_SOURCE_LINE 00000144 "        $host = $_[1];"
NSQ_SOURCE_LINE 00000145 "    }"
NSQ_SOURCE_LINE 00000146 "    elsif (@_ > 2) {  # named args given"
NSQ_SOURCE_LINE 00000147 "        ## Get the named args."
NSQ_SOURCE_LINE 00000148 "        (undef, %args) = @_;"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "        ## Parse all other named args."
NSQ_SOURCE_LINE 00000151 "        foreach (keys %args) {"
NSQ_SOURCE_LINE 00000152 "            if (/^-?binmode$/i) {"
NSQ_SOURCE_LINE 00000153 "                $self->binmode($args{$_});"
NSQ_SOURCE_LINE 00000154 "            }"
NSQ_SOURCE_LINE 00000155 "            elsif (/^-?cmd_remove_mode$/i) {"
NSQ_SOURCE_LINE 00000156 "                $self->cmd_remove_mode($args{$_});"
NSQ_SOURCE_LINE 00000157 "            }"
NSQ_SOURCE_LINE 00000158 "            elsif (/^-?dump_log$/i) {"
NSQ_SOURCE_LINE 00000159 "                $dump_log = $args{$_};"
NSQ_SOURCE_LINE 00000160 "            }"
NSQ_SOURCE_LINE 00000161 "            elsif (/^-?errmode$/i) {"
NSQ_SOURCE_LINE 00000162 "                $errmode = $args{$_};"
NSQ_SOURCE_LINE 00000163 "            }"
NSQ_SOURCE_LINE 00000164 "            elsif (/^-?family$/i) {"
NSQ_SOURCE_LINE 00000165 "                $family = $args{$_};"
NSQ_SOURCE_LINE 00000166 "            }"
NSQ_SOURCE_LINE 00000167 "            elsif (/^-?fhopen$/i) {"
NSQ_SOURCE_LINE 00000168 "                $fh_open = $args{$_};"
NSQ_SOURCE_LINE 00000169 "            }"
NSQ_SOURCE_LINE 00000170 "            elsif (/^-?host$/i) {"
NSQ_SOURCE_LINE 00000171 "                $host = $args{$_};"
NSQ_SOURCE_LINE 00000172 "            }"
NSQ_SOURCE_LINE 00000173 "            elsif (/^-?input_log$/i) {"
NSQ_SOURCE_LINE 00000174 "                $input_log = $args{$_};"
NSQ_SOURCE_LINE 00000175 "            }"
NSQ_SOURCE_LINE 00000176 "            elsif (/^-?input_record_separator$/i or /^-?rs$/i) {"
NSQ_SOURCE_LINE 00000177 "                $self->input_record_separator($args{$_});"
NSQ_SOURCE_LINE 00000178 "            }"
NSQ_SOURCE_LINE 00000179 "            elsif (/^-?localfamily$/i) {"
NSQ_SOURCE_LINE 00000180 "                $localfamily = $args{$_};"
NSQ_SOURCE_LINE 00000181 "            }"
NSQ_SOURCE_LINE 00000182 "            elsif (/^-?localhost$/i) {"
NSQ_SOURCE_LINE 00000183 "                $self->localhost($args{$_});"
NSQ_SOURCE_LINE 00000184 "            }"
NSQ_SOURCE_LINE 00000185 "            elsif (/^-?max_buffer_length$/i) {"
NSQ_SOURCE_LINE 00000186 "                $self->max_buffer_length($args{$_});"
NSQ_SOURCE_LINE 00000187 "            }"
NSQ_SOURCE_LINE 00000188 "            elsif (/^-?option_log$/i) {"
NSQ_SOURCE_LINE 00000189 "                $option_log = $args{$_};"
NSQ_SOURCE_LINE 00000190 "            }"
NSQ_SOURCE_LINE 00000191 "            elsif (/^-?output_field_separator$/i or /^-?ofs$/i) {"
NSQ_SOURCE_LINE 00000192 "                $self->output_field_separator($args{$_});"
NSQ_SOURCE_LINE 00000193 "            }"
NSQ_SOURCE_LINE 00000194 "            elsif (/^-?output_log$/i) {"
NSQ_SOURCE_LINE 00000195 "                $output_log = $args{$_};"
NSQ_SOURCE_LINE 00000196 "            }"
NSQ_SOURCE_LINE 00000197 "            elsif (/^-?output_record_separator$/i or /^-?ors$/i) {"
NSQ_SOURCE_LINE 00000198 "                $self->output_record_separator($args{$_});"
NSQ_SOURCE_LINE 00000199 "            }"
NSQ_SOURCE_LINE 00000200 "            elsif (/^-?port$/i) {"
NSQ_SOURCE_LINE 00000201 "                $port = $args{$_};"
NSQ_SOURCE_LINE 00000202 "            }"
NSQ_SOURCE_LINE 00000203 "            elsif (/^-?prompt$/i) {"
NSQ_SOURCE_LINE 00000204 "                $prompt = $args{$_};"
NSQ_SOURCE_LINE 00000205 "            }"
NSQ_SOURCE_LINE 00000206 "            elsif (/^-?telnetmode$/i) {"
NSQ_SOURCE_LINE 00000207 "                $self->telnetmode($args{$_});"
NSQ_SOURCE_LINE 00000208 "            }"
NSQ_SOURCE_LINE 00000209 "            elsif (/^-?timeout$/i) {"
NSQ_SOURCE_LINE 00000210 "                $self->timeout($args{$_});"
NSQ_SOURCE_LINE 00000211 "            }"
NSQ_SOURCE_LINE 00000212 "            else {"
NSQ_SOURCE_LINE 00000213 "                &_croak($self, \"bad named parameter \\\"$_\\\" given \" ."
NSQ_SOURCE_LINE 00000214 "                        \"to \" . ref($self) . \"::new()\");"
NSQ_SOURCE_LINE 00000215 "            }"
NSQ_SOURCE_LINE 00000216 "        }"
NSQ_SOURCE_LINE 00000217 "    }"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "    if (defined $errmode) {  # user wants to set errmode"
NSQ_SOURCE_LINE 00000220 "        $self->errmode($errmode);"
NSQ_SOURCE_LINE 00000221 "    }"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "    if (defined $host) {  # user wants to set host"
NSQ_SOURCE_LINE 00000224 "        $self->host($host);"
NSQ_SOURCE_LINE 00000225 "    }"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "    if (defined $port) {  # user wants to set port"
NSQ_SOURCE_LINE 00000228 "        defined($self->port($port))"
NSQ_SOURCE_LINE 00000229 "            or return;"
NSQ_SOURCE_LINE 00000230 "    }"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "    if (defined $family) {  # user wants to set family"
NSQ_SOURCE_LINE 00000233 "        defined($self->family($family))"
NSQ_SOURCE_LINE 00000234 "            or return;"
NSQ_SOURCE_LINE 00000235 "    }"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "    if (defined $localfamily) {  # user wants to set localfamily"
NSQ_SOURCE_LINE 00000238 "        defined($self->localfamily($localfamily))"
NSQ_SOURCE_LINE 00000239 "            or return;"
NSQ_SOURCE_LINE 00000240 "    }"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "    if (defined $prompt) {  # user wants to set prompt"
NSQ_SOURCE_LINE 00000243 "        defined($self->prompt($prompt))"
NSQ_SOURCE_LINE 00000244 "            or return;"
NSQ_SOURCE_LINE 00000245 "    }"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "    if (defined $dump_log) {  # user wants to set dump_log"
NSQ_SOURCE_LINE 00000248 "        defined($self->dump_log($dump_log))"
NSQ_SOURCE_LINE 00000249 "            or return;"
NSQ_SOURCE_LINE 00000250 "    }"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "    if (defined $input_log) {  # user wants to set input_log"
NSQ_SOURCE_LINE 00000253 "        defined($self->input_log($input_log))"
NSQ_SOURCE_LINE 00000254 "            or return;"
NSQ_SOURCE_LINE 00000255 "    }"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "    if (defined $option_log) {  # user wants to set option_log"
NSQ_SOURCE_LINE 00000258 "        defined($self->option_log($option_log))"
NSQ_SOURCE_LINE 00000259 "            or return;"
NSQ_SOURCE_LINE 00000260 "    }"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "    if (defined $output_log) {  # user wants to set output_log"
NSQ_SOURCE_LINE 00000263 "        defined($self->output_log($output_log))"
NSQ_SOURCE_LINE 00000264 "            or return;"
NSQ_SOURCE_LINE 00000265 "    }"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "    if (defined $fh_open) {  # user wants us to attach to existing filehandle"
NSQ_SOURCE_LINE 00000268 "        $self->fhopen($fh_open)"
NSQ_SOURCE_LINE 00000269 "            or return;"
NSQ_SOURCE_LINE 00000270 "    }"
NSQ_SOURCE_LINE 00000271 "    elsif (defined $host) {  # user wants us to open a connection to host"
NSQ_SOURCE_LINE 00000272 "        $self->open"
NSQ_SOURCE_LINE 00000273 "            or return;"
NSQ_SOURCE_LINE 00000274 "    }"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "    $self;"
NSQ_SOURCE_LINE 00000277 "} # end sub new"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "sub DESTROY {"
NSQ_SOURCE_LINE 00000281 "} # end sub DESTROY"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "sub binmode {"
NSQ_SOURCE_LINE 00000285 "    my ($self, $mode) = @_;"
NSQ_SOURCE_LINE 00000286 "    my ("
NSQ_SOURCE_LINE 00000287 "        $prev,"
NSQ_SOURCE_LINE 00000288 "        $s,"
NSQ_SOURCE_LINE 00000289 "        );"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "    $s = *$self->{net_telnet};"
NSQ_SOURCE_LINE 00000292 "    $prev = $s->{bin_mode};"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "    if (@_ >= 2) {"
NSQ_SOURCE_LINE 00000295 "        unless (defined $mode) {"
NSQ_SOURCE_LINE 00000296 "            $mode = 0;"
NSQ_SOURCE_LINE 00000297 "        }"
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "        $s->{bin_mode} = $mode;"
NSQ_SOURCE_LINE 00000300 "    }"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "    $prev;"
NSQ_SOURCE_LINE 00000303 "} # end sub binmode"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 ""
