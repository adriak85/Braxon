NSQ_SOURCE_LINE 00000350 "sub cmd {"
NSQ_SOURCE_LINE 00000351 "    my ($self, @args) = @_;"
NSQ_SOURCE_LINE 00000352 "    my ("
NSQ_SOURCE_LINE 00000353 "        $arg_errmode,"
NSQ_SOURCE_LINE 00000354 "        $cmd_remove_mode,"
NSQ_SOURCE_LINE 00000355 "        $firstpos,"
NSQ_SOURCE_LINE 00000356 "        $last_prompt,"
NSQ_SOURCE_LINE 00000357 "        $lastpos,"
NSQ_SOURCE_LINE 00000358 "        $lines,"
NSQ_SOURCE_LINE 00000359 "        $ors,"
NSQ_SOURCE_LINE 00000360 "        $output,"
NSQ_SOURCE_LINE 00000361 "        $output_ref,"
NSQ_SOURCE_LINE 00000362 "        $prompt,"
NSQ_SOURCE_LINE 00000363 "        $remove_echo,"
NSQ_SOURCE_LINE 00000364 "        $rs,"
NSQ_SOURCE_LINE 00000365 "        $rs_len,"
NSQ_SOURCE_LINE 00000366 "        $s,"
NSQ_SOURCE_LINE 00000367 "        $telopt_echo,"
NSQ_SOURCE_LINE 00000368 "        $timeout,"
NSQ_SOURCE_LINE 00000369 "        %args,"
NSQ_SOURCE_LINE 00000370 "        );"
NSQ_SOURCE_LINE 00000371 "    my $cmd = \"\";"
NSQ_SOURCE_LINE 00000372 "    local $_;"
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "    ## Init."
NSQ_SOURCE_LINE 00000375 "    $self->timed_out('');"
NSQ_SOURCE_LINE 00000376 "    $self->last_prompt(\"\");"
NSQ_SOURCE_LINE 00000377 "    $s = *$self->{net_telnet};"
NSQ_SOURCE_LINE 00000378 "    $output = [];"
NSQ_SOURCE_LINE 00000379 "    $cmd_remove_mode = $self->cmd_remove_mode;"
NSQ_SOURCE_LINE 00000380 "    $ors = $self->output_record_separator;"
NSQ_SOURCE_LINE 00000381 "    $prompt = $self->prompt;"
NSQ_SOURCE_LINE 00000382 "    $rs = $self->input_record_separator;"
NSQ_SOURCE_LINE 00000383 "    $timeout = $self->timeout;"
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "    ## Override errmode first, if specified."
NSQ_SOURCE_LINE 00000386 "    $arg_errmode = &_extract_arg_errmode($self, \\@args);"
NSQ_SOURCE_LINE 00000387 "    local $s->{errormode} = $arg_errmode"
NSQ_SOURCE_LINE 00000388 "        if $arg_errmode;"
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "    ## Parse args."
NSQ_SOURCE_LINE 00000391 "    if (@args == 1) {  # one positional arg given"
NSQ_SOURCE_LINE 00000392 "        $cmd = $args[0];"
NSQ_SOURCE_LINE 00000393 "    }"
NSQ_SOURCE_LINE 00000394 "    elsif (@args >= 2) {  # named args given"
NSQ_SOURCE_LINE 00000395 "        ## Get the named args."
NSQ_SOURCE_LINE 00000396 "        %args = @args;"
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "        ## Parse the named args."
NSQ_SOURCE_LINE 00000399 "        foreach (keys %args) {"
NSQ_SOURCE_LINE 00000400 "            if (/^-?cmd_remove/i) {"
NSQ_SOURCE_LINE 00000401 "                $cmd_remove_mode = &_parse_cmd_remove_mode($self, $args{$_});"
NSQ_SOURCE_LINE 00000402 "            }"
NSQ_SOURCE_LINE 00000403 "            elsif (/^-?input_record_separator$/i or /^-?rs$/i) {"
NSQ_SOURCE_LINE 00000404 "                $rs = &_parse_input_record_separator($self, $args{$_});"
NSQ_SOURCE_LINE 00000405 "            }"
NSQ_SOURCE_LINE 00000406 "            elsif (/^-?output$/i) {"
NSQ_SOURCE_LINE 00000407 "                $output_ref = $args{$_};"
NSQ_SOURCE_LINE 00000408 "                if (defined($output_ref) and ref($output_ref) eq \"ARRAY\") {"
NSQ_SOURCE_LINE 00000409 "                    $output = $output_ref;"
NSQ_SOURCE_LINE 00000410 "                }"
NSQ_SOURCE_LINE 00000411 "            }"
NSQ_SOURCE_LINE 00000412 "            elsif (/^-?output_record_separator$/i or /^-?ors$/i) {"
NSQ_SOURCE_LINE 00000413 "                $ors = $args{$_};"
NSQ_SOURCE_LINE 00000414 "            }"
NSQ_SOURCE_LINE 00000415 "            elsif (/^-?prompt$/i) {"
NSQ_SOURCE_LINE 00000416 "                $prompt = &_parse_prompt($self, $args{$_})"
NSQ_SOURCE_LINE 00000417 "                    or return;"
NSQ_SOURCE_LINE 00000418 "            }"
NSQ_SOURCE_LINE 00000419 "            elsif (/^-?string$/i) {"
NSQ_SOURCE_LINE 00000420 "                $cmd = $args{$_};"
NSQ_SOURCE_LINE 00000421 "            }"
NSQ_SOURCE_LINE 00000422 "            elsif (/^-?timeout$/i) {"
NSQ_SOURCE_LINE 00000423 "                $timeout = &_parse_timeout($self, $args{$_});"
NSQ_SOURCE_LINE 00000424 "            }"
NSQ_SOURCE_LINE 00000425 "            else {"
NSQ_SOURCE_LINE 00000426 "                &_croak($self, \"bad named parameter \\\"$_\\\" given \" ."
NSQ_SOURCE_LINE 00000427 "                        \"to \" . ref($self) . \"::cmd()\");"
NSQ_SOURCE_LINE 00000428 "            }"
NSQ_SOURCE_LINE 00000429 "        }"
NSQ_SOURCE_LINE 00000430 "    }"
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 "    ## Override some user settings."
NSQ_SOURCE_LINE 00000433 "    local $s->{time_out} = &_endtime($timeout);"
NSQ_SOURCE_LINE 00000434 "    $self->errmsg(\"\");"
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 "    ## Send command and wait for the prompt."
NSQ_SOURCE_LINE 00000437 "    {"
NSQ_SOURCE_LINE 00000438 "        local $s->{errormode} = \"return\";"
NSQ_SOURCE_LINE 00000439 ""
NSQ_SOURCE_LINE 00000440 "        $self->put($cmd . $ors)"
NSQ_SOURCE_LINE 00000441 "            and ($lines, $last_prompt) = $self->waitfor($prompt);"
NSQ_SOURCE_LINE 00000442 "    }"
NSQ_SOURCE_LINE 00000443 ""
NSQ_SOURCE_LINE 00000444 "    ## Check for failure."
NSQ_SOURCE_LINE 00000445 "    return $self->error(\"command timed-out\") if $self->timed_out;"
NSQ_SOURCE_LINE 00000446 "    return $self->error($self->errmsg) if $self->errmsg ne \"\";"
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 "    ## Save the most recently matched prompt."
NSQ_SOURCE_LINE 00000449 "    $self->last_prompt($last_prompt);"
NSQ_SOURCE_LINE 00000450 ""
NSQ_SOURCE_LINE 00000451 "    ## Split lines into an array, keeping record separator at end of line."
NSQ_SOURCE_LINE 00000452 "    $firstpos = 0;"
NSQ_SOURCE_LINE 00000453 "    $rs_len = length $rs;"
NSQ_SOURCE_LINE 00000454 "    while (($lastpos = index($lines, $rs, $firstpos)) > -1) {"
NSQ_SOURCE_LINE 00000455 "        push(@$output,"
NSQ_SOURCE_LINE 00000456 "             substr($lines, $firstpos, $lastpos - $firstpos + $rs_len));"
NSQ_SOURCE_LINE 00000457 "        $firstpos = $lastpos + $rs_len;"
NSQ_SOURCE_LINE 00000458 "    }"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "    if ($firstpos < length $lines) {"
NSQ_SOURCE_LINE 00000461 "        push @$output, substr($lines, $firstpos);"
NSQ_SOURCE_LINE 00000462 "    }"
NSQ_SOURCE_LINE 00000463 ""
NSQ_SOURCE_LINE 00000464 "    ## Determine if we should remove the first line of output based"
NSQ_SOURCE_LINE 00000465 "    ## on the assumption that it's an echoed back command."
NSQ_SOURCE_LINE 00000466 "    if ($cmd_remove_mode eq \"auto\") {"
NSQ_SOURCE_LINE 00000467 "        ## See if remote side told us they'd echo."
NSQ_SOURCE_LINE 00000468 "        $telopt_echo = $self->option_state(&TELOPT_ECHO);"
NSQ_SOURCE_LINE 00000469 "        $remove_echo = $telopt_echo->{remote_enabled};"
NSQ_SOURCE_LINE 00000470 "    }"
NSQ_SOURCE_LINE 00000471 "    else {  # user explicitly told us how many lines to remove."
NSQ_SOURCE_LINE 00000472 "        $remove_echo = $cmd_remove_mode;"
NSQ_SOURCE_LINE 00000473 "    }"
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 "    ## Get rid of possible echo back command."
NSQ_SOURCE_LINE 00000476 "    while ($remove_echo--) {"
NSQ_SOURCE_LINE 00000477 "        shift @$output;"
NSQ_SOURCE_LINE 00000478 "    }"
NSQ_SOURCE_LINE 00000479 ""
NSQ_SOURCE_LINE 00000480 "    ## Ensure at least a null string when there's no command output - so"
NSQ_SOURCE_LINE 00000481 "    ## \"true\" is returned in a list context."
NSQ_SOURCE_LINE 00000482 "    unless (@$output) {"
NSQ_SOURCE_LINE 00000483 "        @$output = (\"\");"
NSQ_SOURCE_LINE 00000484 "    }"
NSQ_SOURCE_LINE 00000485 ""
NSQ_SOURCE_LINE 00000486 "    ## Return command output via named arg, if requested."
NSQ_SOURCE_LINE 00000487 "    if (defined $output_ref) {"
NSQ_SOURCE_LINE 00000488 "        if (ref($output_ref) eq \"SCALAR\") {"
NSQ_SOURCE_LINE 00000489 "            $$output_ref = join \"\", @$output;"
NSQ_SOURCE_LINE 00000490 "        }"
NSQ_SOURCE_LINE 00000491 "        elsif (ref($output_ref) eq \"HASH\") {"
NSQ_SOURCE_LINE 00000492 "            %$output_ref = @$output;"
NSQ_SOURCE_LINE 00000493 "        }"
NSQ_SOURCE_LINE 00000494 "    }"
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "    wantarray ? @$output : 1;"
NSQ_SOURCE_LINE 00000497 "} # end sub cmd"
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 ""
