NSQ_SOURCE_LINE 00000518 "sub dump_log {"
NSQ_SOURCE_LINE 00000519 "    my ($self, $name) = @_;"
NSQ_SOURCE_LINE 00000520 "    my ("
NSQ_SOURCE_LINE 00000521 "        $fh,"
NSQ_SOURCE_LINE 00000522 "        $s,"
NSQ_SOURCE_LINE 00000523 "        );"
NSQ_SOURCE_LINE 00000524 ""
NSQ_SOURCE_LINE 00000525 "    $s = *$self->{net_telnet};"
NSQ_SOURCE_LINE 00000526 "    $fh = $s->{dumplog};"
NSQ_SOURCE_LINE 00000527 ""
NSQ_SOURCE_LINE 00000528 "    if (@_ >= 2) {"
NSQ_SOURCE_LINE 00000529 "        if (!defined($name) or $name eq \"\") {  # input arg is \"\""
NSQ_SOURCE_LINE 00000530 "            ## Turn off logging."
NSQ_SOURCE_LINE 00000531 "            $fh = \"\";"
NSQ_SOURCE_LINE 00000532 "        }"
NSQ_SOURCE_LINE 00000533 "        elsif (&_is_open_fh($name)) {  # input arg is an open fh"
NSQ_SOURCE_LINE 00000534 "            ## Use the open fh for logging."
NSQ_SOURCE_LINE 00000535 "            $fh = $name;"
NSQ_SOURCE_LINE 00000536 "            select((select($fh), $|=1)[0]);  # don't buffer writes"
NSQ_SOURCE_LINE 00000537 "        }"
NSQ_SOURCE_LINE 00000538 "        elsif (!ref $name) {  # input arg is filename"
NSQ_SOURCE_LINE 00000539 "            ## Open the file for logging."
NSQ_SOURCE_LINE 00000540 "            $fh = &_fname_to_handle($self, $name)"
NSQ_SOURCE_LINE 00000541 "                or return;"
NSQ_SOURCE_LINE 00000542 "            select((select($fh), $|=1)[0]);  # don't buffer writes"
NSQ_SOURCE_LINE 00000543 "        }"
NSQ_SOURCE_LINE 00000544 "        else {"
NSQ_SOURCE_LINE 00000545 "            return $self->error(\"bad Dump_log argument \","
NSQ_SOURCE_LINE 00000546 "                                \"\\\"$name\\\": not filename or open fh\");"
NSQ_SOURCE_LINE 00000547 "        }"
NSQ_SOURCE_LINE 00000548 ""
NSQ_SOURCE_LINE 00000549 "        $s->{dumplog} = $fh;"
NSQ_SOURCE_LINE 00000550 "    }"
NSQ_SOURCE_LINE 00000551 ""
NSQ_SOURCE_LINE 00000552 "    $fh;"
NSQ_SOURCE_LINE 00000553 "} # end sub dump_log"
