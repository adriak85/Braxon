NSQ_SOURCE_LINE 00001217 "    local $_;"
NSQ_SOURCE_LINE 00001218 ""
NSQ_SOURCE_LINE 00001219 "    ## Init."
NSQ_SOURCE_LINE 00001220 "    $self->timed_out('');"
NSQ_SOURCE_LINE 00001221 "    $self->last_prompt(\"\");"
NSQ_SOURCE_LINE 00001222 "    $s = *$self->{net_telnet};"
NSQ_SOURCE_LINE 00001223 "    $timeout = $self->timeout;"
NSQ_SOURCE_LINE 00001224 "    $ors = $self->output_record_separator;"
NSQ_SOURCE_LINE 00001225 "    $prompt = $self->prompt;"
NSQ_SOURCE_LINE 00001226 ""
NSQ_SOURCE_LINE 00001227 "    ## Parse positional args."
NSQ_SOURCE_LINE 00001228 "    if (@args == 2) {  # just username and passwd given"
NSQ_SOURCE_LINE 00001229 "        $username = $args[0];"
NSQ_SOURCE_LINE 00001230 "        $passwd = $args[1];"
NSQ_SOURCE_LINE 00001231 ""
NSQ_SOURCE_LINE 00001232 "        $is_username_arg = 1;"
NSQ_SOURCE_LINE 00001233 "        $is_passwd_arg = 1;"
NSQ_SOURCE_LINE 00001234 "    }"
NSQ_SOURCE_LINE 00001235 ""
NSQ_SOURCE_LINE 00001236 "    ## Override errmode first, if specified."
NSQ_SOURCE_LINE 00001237 "    $arg_errmode = &_extract_arg_errmode($self, \\@args);"
NSQ_SOURCE_LINE 00001238 "    local $s->{errormode} = $arg_errmode"
NSQ_SOURCE_LINE 00001239 "        if $arg_errmode;"
NSQ_SOURCE_LINE 00001240 ""
NSQ_SOURCE_LINE 00001241 "    ## Parse named args."
NSQ_SOURCE_LINE 00001242 "    if (@args > 2) {"
NSQ_SOURCE_LINE 00001243 "        ## Get the named args."
NSQ_SOURCE_LINE 00001244 "        %args = @args;"
NSQ_SOURCE_LINE 00001245 ""
NSQ_SOURCE_LINE 00001246 "        ## Parse the named args."
NSQ_SOURCE_LINE 00001247 "        foreach (keys %args) {"
NSQ_SOURCE_LINE 00001248 "            if (/^-?name$/i) {"
NSQ_SOURCE_LINE 00001249 "                $username = $args{$_};"
NSQ_SOURCE_LINE 00001250 "                unless (defined $username) {"
NSQ_SOURCE_LINE 00001251 "                    $username = \"\";"
NSQ_SOURCE_LINE 00001252 "                }"
NSQ_SOURCE_LINE 00001253 ""
NSQ_SOURCE_LINE 00001254 "                $is_username_arg = 1;"
NSQ_SOURCE_LINE 00001255 "            }"
NSQ_SOURCE_LINE 00001256 "            elsif (/^-?pass/i) {"
NSQ_SOURCE_LINE 00001257 "                $passwd = $args{$_};"
NSQ_SOURCE_LINE 00001258 "                unless (defined $passwd) {"
NSQ_SOURCE_LINE 00001259 "                    $passwd = \"\";"
NSQ_SOURCE_LINE 00001260 "                }"
NSQ_SOURCE_LINE 00001261 ""
NSQ_SOURCE_LINE 00001262 "                $is_passwd_arg = 1;"
NSQ_SOURCE_LINE 00001263 "            }"
NSQ_SOURCE_LINE 00001264 "            elsif (/^-?prompt$/i) {"
NSQ_SOURCE_LINE 00001265 "                $prompt = &_parse_prompt($self, $args{$_})"
NSQ_SOURCE_LINE 00001266 "                    or return;"
NSQ_SOURCE_LINE 00001267 "            }"
NSQ_SOURCE_LINE 00001268 "            elsif (/^-?timeout$/i) {"
NSQ_SOURCE_LINE 00001269 "                $timeout = &_parse_timeout($self, $args{$_});"
NSQ_SOURCE_LINE 00001270 "            }"
NSQ_SOURCE_LINE 00001271 "            else {"
NSQ_SOURCE_LINE 00001272 "                &_croak($self, \"bad named parameter \\\"$_\\\" given \","
NSQ_SOURCE_LINE 00001273 "                        \"to \" . ref($self) . \"::login()\");"
NSQ_SOURCE_LINE 00001274 "            }"
NSQ_SOURCE_LINE 00001275 "        }"
NSQ_SOURCE_LINE 00001276 "    }"
NSQ_SOURCE_LINE 00001277 ""
NSQ_SOURCE_LINE 00001278 "    ## Ensure both username and password argument given."
NSQ_SOURCE_LINE 00001279 "    &_croak($self,\"Name argument not given to \" . ref($self) . \"::login()\")"
NSQ_SOURCE_LINE 00001280 "        unless $is_username_arg;"
NSQ_SOURCE_LINE 00001281 "    &_croak($self,\"Password argument not given to \" . ref($self) . \"::login()\")"
NSQ_SOURCE_LINE 00001282 "        unless $is_passwd_arg;"
NSQ_SOURCE_LINE 00001283 ""
NSQ_SOURCE_LINE 00001284 "    ## Set timeout for this invocation."
NSQ_SOURCE_LINE 00001285 "    local $s->{time_out} = &_endtime($timeout);"
NSQ_SOURCE_LINE 00001286 ""
NSQ_SOURCE_LINE 00001287 "    ## Create a subroutine to generate an error."
NSQ_SOURCE_LINE 00001288 "    $error"
NSQ_SOURCE_LINE 00001289 "        = sub {"
NSQ_SOURCE_LINE 00001290 "            my ($errmsg) = @_;"
NSQ_SOURCE_LINE 00001291 ""
NSQ_SOURCE_LINE 00001292 "            if ($self->timed_out) {"
NSQ_SOURCE_LINE 00001293 "                return $self->error($errmsg);"
NSQ_SOURCE_LINE 00001294 "            }"
NSQ_SOURCE_LINE 00001295 "            elsif ($self->eof) {"
NSQ_SOURCE_LINE 00001296 "                ($lastline = $self->lastline) =~ s/\\n+//;"
NSQ_SOURCE_LINE 00001297 "                return $self->error($errmsg, \": \", $lastline);"
NSQ_SOURCE_LINE 00001298 "            }"
NSQ_SOURCE_LINE 00001299 "            else {"
NSQ_SOURCE_LINE 00001300 "                return $self->error($self->errmsg);"
NSQ_SOURCE_LINE 00001301 "            }"
NSQ_SOURCE_LINE 00001302 "        };"
NSQ_SOURCE_LINE 00001303 ""
NSQ_SOURCE_LINE 00001304 ""
NSQ_SOURCE_LINE 00001305 "    return $self->error(\"login failed: filehandle isn't open\")"
NSQ_SOURCE_LINE 00001306 "        if $self->eof;"
NSQ_SOURCE_LINE 00001307 ""
NSQ_SOURCE_LINE 00001308 "    ## Wait for login prompt."
NSQ_SOURCE_LINE 00001309 "    $self->waitfor(Match => '/login[: ]*$/i',"
NSQ_SOURCE_LINE 00001310 "                   Match => '/username[: ]*$/i',"
NSQ_SOURCE_LINE 00001311 "                   Errmode => \"return\")"
NSQ_SOURCE_LINE 00001312 "        or do {"
NSQ_SOURCE_LINE 00001313 "            return &$error(\"eof read waiting for login prompt\")"
NSQ_SOURCE_LINE 00001314 "                if $self->eof;"
NSQ_SOURCE_LINE 00001315 "            return &$error(\"timed-out waiting for login prompt\");"
NSQ_SOURCE_LINE 00001316 "        };"
NSQ_SOURCE_LINE 00001317 ""
NSQ_SOURCE_LINE 00001318 "    ## Delay sending response because of bug in Linux login program."
NSQ_SOURCE_LINE 00001319 "    &_sleep(0.01);"
NSQ_SOURCE_LINE 00001320 ""
NSQ_SOURCE_LINE 00001321 "    ## Send login name."
NSQ_SOURCE_LINE 00001322 "    $self->put(String => $username . $ors,"
NSQ_SOURCE_LINE 00001323 "               Errmode => \"return\")"
NSQ_SOURCE_LINE 00001324 "        or return &$error(\"login disconnected\");"
NSQ_SOURCE_LINE 00001325 ""
NSQ_SOURCE_LINE 00001326 "    ## Wait for password prompt."
NSQ_SOURCE_LINE 00001327 "    $self->waitfor(Match => '/password[: ]*$/i',"
NSQ_SOURCE_LINE 00001328 "                   Errmode => \"return\")"
NSQ_SOURCE_LINE 00001329 "        or do {"
NSQ_SOURCE_LINE 00001330 "            return &$error(\"eof read waiting for password prompt\")"
NSQ_SOURCE_LINE 00001331 "                if $self->eof;"
NSQ_SOURCE_LINE 00001332 "            return &$error(\"timed-out waiting for password prompt\");"
NSQ_SOURCE_LINE 00001333 "        };"
NSQ_SOURCE_LINE 00001334 ""
NSQ_SOURCE_LINE 00001335 "    ## Delay sending response because of bug in Linux login program."
NSQ_SOURCE_LINE 00001336 "    &_sleep(0.01);"
NSQ_SOURCE_LINE 00001337 ""
NSQ_SOURCE_LINE 00001338 "    ## Send password."
NSQ_SOURCE_LINE 00001339 "    $self->put(String => $passwd . $ors,"
NSQ_SOURCE_LINE 00001340 "               Errmode => \"return\")"
NSQ_SOURCE_LINE 00001341 "        or return &$error(\"login disconnected\");"
NSQ_SOURCE_LINE 00001342 ""
NSQ_SOURCE_LINE 00001343 "    ## Wait for command prompt or another login prompt."
NSQ_SOURCE_LINE 00001344 "    ($prematch, $match) = $self->waitfor(Match => '/login[: ]*$/i',"
NSQ_SOURCE_LINE 00001345 "                                         Match => '/username[: ]*$/i',"
NSQ_SOURCE_LINE 00001346 "                                         Match => $prompt,"
NSQ_SOURCE_LINE 00001347 "                                         Errmode => \"return\")"
NSQ_SOURCE_LINE 00001348 "        or do {"
NSQ_SOURCE_LINE 00001349 "            return &$error(\"eof read waiting for command prompt\")"
NSQ_SOURCE_LINE 00001350 "                if $self->eof;"
NSQ_SOURCE_LINE 00001351 "            return &$error(\"timed-out waiting for command prompt\");"
NSQ_SOURCE_LINE 00001352 "        };"
NSQ_SOURCE_LINE 00001353 ""
NSQ_SOURCE_LINE 00001354 "    ## It's a bad login if we got another login prompt."
NSQ_SOURCE_LINE 00001355 "    return $self->error(\"login failed: bad name or password\")"
NSQ_SOURCE_LINE 00001356 "        if $match =~ /login[: ]*$/i or $match =~ /username[: ]*$/i;"
NSQ_SOURCE_LINE 00001357 ""
NSQ_SOURCE_LINE 00001358 "    ## Save the most recently matched command prompt."
NSQ_SOURCE_LINE 00001359 "    $self->last_prompt($match);"
NSQ_SOURCE_LINE 00001360 ""
NSQ_SOURCE_LINE 00001361 "    1;"
NSQ_SOURCE_LINE 00001362 "} # end sub login"
NSQ_SOURCE_LINE 00001363 ""
NSQ_SOURCE_LINE 00001364 ""
NSQ_SOURCE_LINE 00001365 "sub max_buffer_length {"
NSQ_SOURCE_LINE 00001366 "    my ($self, $maxbufsize) = @_;"
NSQ_SOURCE_LINE 00001367 "    my ("
NSQ_SOURCE_LINE 00001368 "        $prev,"
NSQ_SOURCE_LINE 00001369 "        $s,"
NSQ_SOURCE_LINE 00001370 "        );"
NSQ_SOURCE_LINE 00001371 "    my $minbufsize = 512;"
NSQ_SOURCE_LINE 00001372 ""
NSQ_SOURCE_LINE 00001373 "    $s = *$self->{net_telnet};"
NSQ_SOURCE_LINE 00001374 "    $prev = $s->{maxbufsize};"
NSQ_SOURCE_LINE 00001375 ""
NSQ_SOURCE_LINE 00001376 "    if (@_ >= 2) {"
NSQ_SOURCE_LINE 00001377 "        ## Ensure a positive integer value."
NSQ_SOURCE_LINE 00001378 "        unless (defined $maxbufsize"
NSQ_SOURCE_LINE 00001379 "                and $maxbufsize =~ /^\\d+$/"
NSQ_SOURCE_LINE 00001380 "                and $maxbufsize)"
NSQ_SOURCE_LINE 00001381 "        {"
NSQ_SOURCE_LINE 00001382 "            &_carp($self, \"ignoring bad Max_buffer_length \" ."
NSQ_SOURCE_LINE 00001383 "                   \"argument \\\"$maxbufsize\\\": it's not a positive integer\");"
NSQ_SOURCE_LINE 00001384 "            $maxbufsize = $prev;"
NSQ_SOURCE_LINE 00001385 "        }"
NSQ_SOURCE_LINE 00001386 ""
NSQ_SOURCE_LINE 00001387 "        ## Adjust up values that are too small."
NSQ_SOURCE_LINE 00001388 "        if ($maxbufsize < $minbufsize) {"
NSQ_SOURCE_LINE 00001389 "            $maxbufsize = $minbufsize;"
NSQ_SOURCE_LINE 00001390 "        }"
NSQ_SOURCE_LINE 00001391 ""
NSQ_SOURCE_LINE 00001392 "        $s->{maxbufsize} = $maxbufsize;"
NSQ_SOURCE_LINE 00001393 "    }"
NSQ_SOURCE_LINE 00001394 ""
NSQ_SOURCE_LINE 00001395 "    $prev;"
NSQ_SOURCE_LINE 00001396 "} # end sub max_buffer_length"
