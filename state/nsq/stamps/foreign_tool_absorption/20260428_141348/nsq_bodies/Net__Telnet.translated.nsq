NSQ_SOURCE_LINE 00004029 "sub TELOPT_TTYLOC ()         {28}; # Terminal Location Number"
NSQ_SOURCE_LINE 00004030 "sub TELOPT_3270REGIME ()     {29}; # Telnet 3270 Regime"
NSQ_SOURCE_LINE 00004031 "sub TELOPT_X3PAD ()          {30}; # X.3 PAD"
NSQ_SOURCE_LINE 00004032 "sub TELOPT_NAWS ()           {31}; # Negotiate About Window Size"
NSQ_SOURCE_LINE 00004033 "sub TELOPT_TSPEED ()         {32}; # Terminal Speed"
NSQ_SOURCE_LINE 00004034 "sub TELOPT_LFLOW ()          {33}; # Remote Flow Control"
NSQ_SOURCE_LINE 00004035 "sub TELOPT_LINEMODE ()       {34}; # Linemode"
NSQ_SOURCE_LINE 00004036 "sub TELOPT_XDISPLOC ()       {35}; # X Display Location"
NSQ_SOURCE_LINE 00004037 "sub TELOPT_OLD_ENVIRON ()    {36}; # Environment Option"
NSQ_SOURCE_LINE 00004038 "sub TELOPT_AUTHENTICATION () {37}; # Authentication Option"
NSQ_SOURCE_LINE 00004039 "sub TELOPT_ENCRYPT ()        {38}; # Encryption Option"
NSQ_SOURCE_LINE 00004040 "sub TELOPT_NEW_ENVIRON ()    {39}; # New Environment Option"
NSQ_SOURCE_LINE 00004041 "sub TELOPT_TN3270E ()        {40}; # TN3270 Enhancements"
NSQ_SOURCE_LINE 00004042 "sub TELOPT_CHARSET ()        {42}; # CHARSET Option"
NSQ_SOURCE_LINE 00004043 "sub TELOPT_COMPORT ()        {44}; # Com Port Control Option"
NSQ_SOURCE_LINE 00004044 "sub TELOPT_KERMIT ()         {47}; # Kermit Option"
NSQ_SOURCE_LINE 00004045 "sub TELOPT_EXOPL ()         {255}; # Extended-Options-List"
NSQ_SOURCE_LINE 00004046 ""
NSQ_SOURCE_LINE 00004047 ""
NSQ_SOURCE_LINE 00004048 "1;"
NSQ_SOURCE_LINE 00004049 "__END__;"
NSQ_SOURCE_LINE 00004050 ""
NSQ_SOURCE_LINE 00004051 ""
NSQ_SOURCE_LINE 00004052 "######################## User Documentation ##########################"
NSQ_SOURCE_LINE 00004053 ""
NSQ_SOURCE_LINE 00004054 ""
NSQ_SOURCE_LINE 00004055 "## To format the following documentation into a more readable format,"
NSQ_SOURCE_LINE 00004056 "## use one of these programs: perldoc; pod2man; pod2html; pod2text."
NSQ_SOURCE_LINE 00004057 "## For example, to nicely format this documentation for printing, you"
NSQ_SOURCE_LINE 00004058 "## may use pod2man and groff to convert to postscript:"
NSQ_SOURCE_LINE 00004059 "##   pod2man Net/Telnet.pm | groff -man -Tps > Net::Telnet.ps"
NSQ_SOURCE_LINE 00004060 ""
NSQ_SOURCE_LINE 00004061 "=head1 NAME"
NSQ_SOURCE_LINE 00004062 ""
NSQ_SOURCE_LINE 00004063 "Net::Telnet - interact with TELNET port or other TCP ports"
NSQ_SOURCE_LINE 00004064 ""
NSQ_SOURCE_LINE 00004065 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00004066 ""
NSQ_SOURCE_LINE 00004067 "C<use Net::Telnet ();>"
NSQ_SOURCE_LINE 00004068 ""
NSQ_SOURCE_LINE 00004069 "see METHODS or EXAMPLES sections below"
NSQ_SOURCE_LINE 00004070 ""
NSQ_SOURCE_LINE 00004071 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00004072 ""
NSQ_SOURCE_LINE 00004073 "Net::Telnet allows you to make client connections to a TCP port and do"
NSQ_SOURCE_LINE 00004074 "network I/O, especially to a port using the TELNET protocol.  Simple"
NSQ_SOURCE_LINE 00004075 "I/O methods such as print, get, and getline are provided.  More"
NSQ_SOURCE_LINE 00004076 "sophisticated interactive features are provided because connecting to"
NSQ_SOURCE_LINE 00004077 "a TELNET port ultimately means communicating with a program designed"
NSQ_SOURCE_LINE 00004078 "for human interaction.  These interactive features include the ability"
NSQ_SOURCE_LINE 00004079 "to specify a time-out and to wait for patterns to appear in the input"
NSQ_SOURCE_LINE 00004080 "stream, such as the prompt from a shell.  IPv6 support is available"
NSQ_SOURCE_LINE 00004081 "when using perl 5.14 or later, see C<family()>."
NSQ_SOURCE_LINE 00004082 ""
NSQ_SOURCE_LINE 00004083 "Other reasons to use this module than strictly with a TELNET port are:"
NSQ_SOURCE_LINE 00004084 ""
NSQ_SOURCE_LINE 00004085 "=over 2"
NSQ_SOURCE_LINE 00004086 ""
NSQ_SOURCE_LINE 00004087 "=item *"
NSQ_SOURCE_LINE 00004088 ""
NSQ_SOURCE_LINE 00004089 "You're not familiar with sockets and you want a simple way to make"
NSQ_SOURCE_LINE 00004090 "client connections to TCP services."
NSQ_SOURCE_LINE 00004091 ""
NSQ_SOURCE_LINE 00004092 "=item *"
NSQ_SOURCE_LINE 00004093 ""
NSQ_SOURCE_LINE 00004094 "You want to be able to specify your own time-out while connecting,"
NSQ_SOURCE_LINE 00004095 "reading, or writing."
NSQ_SOURCE_LINE 00004096 ""
NSQ_SOURCE_LINE 00004097 "=item *"
NSQ_SOURCE_LINE 00004098 ""
NSQ_SOURCE_LINE 00004099 "You're communicating with an interactive program at the other end of"
NSQ_SOURCE_LINE 00004100 "some socket or pipe and you want to wait for certain patterns to"
NSQ_SOURCE_LINE 00004101 "appear."
NSQ_SOURCE_LINE 00004102 ""
NSQ_SOURCE_LINE 00004103 "=back"
NSQ_SOURCE_LINE 00004104 ""
NSQ_SOURCE_LINE 00004105 "Here's an example that prints who's logged-on to a remote host.  In"
NSQ_SOURCE_LINE 00004106 "addition to a username and password, you must also know the user's"
NSQ_SOURCE_LINE 00004107 "shell prompt, which for this example is C<\"bash$ \">"
NSQ_SOURCE_LINE 00004108 ""
NSQ_SOURCE_LINE 00004109 "    use Net::Telnet ();"
NSQ_SOURCE_LINE 00004110 "    $t = new Net::Telnet (Timeout => 10,"
NSQ_SOURCE_LINE 00004111 "                          Prompt => '/bash\\$ $/');"
NSQ_SOURCE_LINE 00004112 "    $t->open($host);"
NSQ_SOURCE_LINE 00004113 "    $t->login($username, $passwd);"
NSQ_SOURCE_LINE 00004114 "    @lines = $t->cmd(\"who\");"
NSQ_SOURCE_LINE 00004115 "    print @lines;"
NSQ_SOURCE_LINE 00004116 ""
NSQ_SOURCE_LINE 00004117 "See the B<EXAMPLES> section below for more examples."
NSQ_SOURCE_LINE 00004118 ""
NSQ_SOURCE_LINE 00004119 "Usage questions should be directed to the perlmonks.org discussion"
NSQ_SOURCE_LINE 00004120 "group.  Bugs can be viewed or reported at cpan.org on the Net::Telnet"
NSQ_SOURCE_LINE 00004121 "page."
NSQ_SOURCE_LINE 00004122 ""
NSQ_SOURCE_LINE 00004123 "=head2 What To Know Before Using"
NSQ_SOURCE_LINE 00004124 ""
NSQ_SOURCE_LINE 00004125 "=over 2"
NSQ_SOURCE_LINE 00004126 ""
NSQ_SOURCE_LINE 00004127 "=item *"
NSQ_SOURCE_LINE 00004128 ""
NSQ_SOURCE_LINE 00004129 "All output is flushed while all input is buffered.  Each object"
NSQ_SOURCE_LINE 00004130 "contains its own input buffer."
NSQ_SOURCE_LINE 00004131 ""
NSQ_SOURCE_LINE 00004132 "=item *"
NSQ_SOURCE_LINE 00004133 ""
NSQ_SOURCE_LINE 00004134 "The output record separator for C<print()> and C<cmd()> is set to"
NSQ_SOURCE_LINE 00004135 "C<\"\\n\"> by default, so that you don't have to append all your commands"
NSQ_SOURCE_LINE 00004136 "with a newline.  To avoid printing a trailing C<\"\\n\"> use C<put()> or"
NSQ_SOURCE_LINE 00004137 "set the I<output_record_separator> to C<\"\">."
NSQ_SOURCE_LINE 00004138 ""
NSQ_SOURCE_LINE 00004139 "=item *"
NSQ_SOURCE_LINE 00004140 ""
NSQ_SOURCE_LINE 00004141 "The methods C<login()> and C<cmd()> use the I<prompt> setting in the"
NSQ_SOURCE_LINE 00004142 "object to determine when a login or remote command is complete.  Those"
NSQ_SOURCE_LINE 00004143 "methods will fail with a time-out if you don't set the prompt"
NSQ_SOURCE_LINE 00004144 "correctly."
NSQ_SOURCE_LINE 00004145 ""
NSQ_SOURCE_LINE 00004146 "=item *"
NSQ_SOURCE_LINE 00004147 ""
NSQ_SOURCE_LINE 00004148 "Use a combination of C<print()> and C<waitfor()> as an alternative to"
NSQ_SOURCE_LINE 00004149 "C<login()> or C<cmd()> when they don't do what you want."
NSQ_SOURCE_LINE 00004150 ""
NSQ_SOURCE_LINE 00004151 "=item *"
NSQ_SOURCE_LINE 00004152 ""
NSQ_SOURCE_LINE 00004153 "Errors such as timing-out are handled according to the error mode"
NSQ_SOURCE_LINE 00004154 "action.  The default action is to print an error message to standard"
NSQ_SOURCE_LINE 00004155 "error and have the program die.  See the C<errmode()> method for more"
NSQ_SOURCE_LINE 00004156 "information."
NSQ_SOURCE_LINE 00004157 ""
NSQ_SOURCE_LINE 00004158 "=item *"
NSQ_SOURCE_LINE 00004159 ""
NSQ_SOURCE_LINE 00004160 "When constructing the match operator argument for C<prompt()> or"
NSQ_SOURCE_LINE 00004161 "C<waitfor()>, always use single quotes instead of double quotes to"
NSQ_SOURCE_LINE 00004162 "avoid unexpected backslash interpretation (e.g. C<'/bash\\$ $/'>).  If"
NSQ_SOURCE_LINE 00004163 "you're constructing a DOS like file path, you'll need to use four"
NSQ_SOURCE_LINE 00004164 "backslashes to represent one (e.g. C<'/c:\\\\\\\\users\\\\\\\\billE<gt>$/i'>)."
NSQ_SOURCE_LINE 00004165 ""
NSQ_SOURCE_LINE 00004166 "Of course don't forget about regexp metacharacters like C<.>, C<[>, or"
NSQ_SOURCE_LINE 00004167 "C<$>.  You'll only need a single backslash to quote them.  The anchor"
NSQ_SOURCE_LINE 00004168 "metacharacters C<^> and C<$> refer to positions in the input buffer."
NSQ_SOURCE_LINE 00004169 "To avoid matching characters read that look like a prompt, it's a good"
NSQ_SOURCE_LINE 00004170 "idea to end your prompt pattern with the C<$> anchor.  That way the"
NSQ_SOURCE_LINE 00004171 "prompt will only match if it's the last thing read."
NSQ_SOURCE_LINE 00004172 ""
NSQ_SOURCE_LINE 00004173 "=item *"
NSQ_SOURCE_LINE 00004174 ""
NSQ_SOURCE_LINE 00004175 "In the input stream, each sequence of I<carriage return> and I<line"
NSQ_SOURCE_LINE 00004176 "feed> (i.e. C<\"\\015\\012\"> or CR LF) is converted to C<\"\\n\">.  In the"
NSQ_SOURCE_LINE 00004177 "output stream, each occurrence of C<\"\\n\"> is converted to a sequence"
NSQ_SOURCE_LINE 00004178 "of CR LF.  See C<binmode()> to change the behavior.  TCP protocols"
NSQ_SOURCE_LINE 00004179 "typically use the ASCII sequence, carriage return and line feed to"
NSQ_SOURCE_LINE 00004180 "designate a newline."
NSQ_SOURCE_LINE 00004181 ""
NSQ_SOURCE_LINE 00004182 "=item *"
NSQ_SOURCE_LINE 00004183 ""
NSQ_SOURCE_LINE 00004184 "Timing-out while making a connection is disabled for machines that"
NSQ_SOURCE_LINE 00004185 "don't support the C<alarm()> function.  Most notably these include"
NSQ_SOURCE_LINE 00004186 "MS-Windows machines."
NSQ_SOURCE_LINE 00004187 ""
NSQ_SOURCE_LINE 00004188 "=item *"
NSQ_SOURCE_LINE 00004189 ""
NSQ_SOURCE_LINE 00004190 "You'll need to be running at least Perl version 5.002 to use this"
NSQ_SOURCE_LINE 00004191 "module.  This module does not require any libraries that don't already"
NSQ_SOURCE_LINE 00004192 "come with a standard Perl distribution."
NSQ_SOURCE_LINE 00004193 ""
NSQ_SOURCE_LINE 00004194 "If you have the IO:: libraries installed (they come standard with"
NSQ_SOURCE_LINE 00004195 "perl5.004 and later) then IO::Socket::INET is used as a base class,"
NSQ_SOURCE_LINE 00004196 "otherwise FileHandle is used."
NSQ_SOURCE_LINE 00004197 ""
NSQ_SOURCE_LINE 00004198 "=back"
NSQ_SOURCE_LINE 00004199 ""
NSQ_SOURCE_LINE 00004200 "=head2 Debugging"
NSQ_SOURCE_LINE 00004201 ""
NSQ_SOURCE_LINE 00004202 "The typical usage bug causes a time-out error because you've made"
NSQ_SOURCE_LINE 00004203 "incorrect assumptions about what the remote side actually sends.  The"
NSQ_SOURCE_LINE 00004204 "easiest way to reconcile what the remote side sends with your"
NSQ_SOURCE_LINE 00004205 "expectations is to use C<input_log()> or C<dump_log()>."
NSQ_SOURCE_LINE 00004206 ""
NSQ_SOURCE_LINE 00004207 "C<dump_log()> allows you to see the data being sent from the remote"
NSQ_SOURCE_LINE 00004208 "side before any translation is done, while C<input_log()> shows you"
NSQ_SOURCE_LINE 00004209 "the results after translation.  The translation includes converting"
NSQ_SOURCE_LINE 00004210 "end of line characters, removing and responding to TELNET protocol"
NSQ_SOURCE_LINE 00004211 "commands in the data stream."
NSQ_SOURCE_LINE 00004212 ""
NSQ_SOURCE_LINE 00004213 "=head2 Style of Named Parameters"
NSQ_SOURCE_LINE 00004214 ""
NSQ_SOURCE_LINE 00004215 "Two different styles of named parameters are supported.  This document"
NSQ_SOURCE_LINE 00004216 "only shows the IO:: style:"
NSQ_SOURCE_LINE 00004217 ""
NSQ_SOURCE_LINE 00004218 "    Net::Telnet->new(Timeout => 20);"
NSQ_SOURCE_LINE 00004219 ""
NSQ_SOURCE_LINE 00004220 "however the dash-option style is also allowed:"
NSQ_SOURCE_LINE 00004221 ""
NSQ_SOURCE_LINE 00004222 "    Net::Telnet->new(-timeout => 20);"
NSQ_SOURCE_LINE 00004223 ""
NSQ_SOURCE_LINE 00004224 "=head2 Connecting to a Remote MS-Windows Machine"
NSQ_SOURCE_LINE 00004225 ""
NSQ_SOURCE_LINE 00004226 "By default MS-Windows doesn't come with a TELNET server.  However"
NSQ_SOURCE_LINE 00004227 "third party TELNET servers are available.  Unfortunately many of these"
NSQ_SOURCE_LINE 00004228 "servers falsely claim to be a TELNET server.  This is especially true"
NSQ_SOURCE_LINE 00004229 "of the so-called \"Microsoft Telnet Server\" that comes installed with"
NSQ_SOURCE_LINE 00004230 "some newer versions MS-Windows."
NSQ_SOURCE_LINE 00004231 ""
NSQ_SOURCE_LINE 00004232 "When a TELNET server first accepts a connection, it must use the ASCII"
NSQ_SOURCE_LINE 00004233 "control characters carriage-return and line-feed to start a new line"
NSQ_SOURCE_LINE 00004234 "(see RFC854).  A server like the \"Microsoft Telnet Server\" that"
NSQ_SOURCE_LINE 00004235 "doesn't do this, isn't a TELNET server.  These servers send ANSI"
NSQ_SOURCE_LINE 00004236 "terminal escape sequences to position to a column on a subsequent line"
NSQ_SOURCE_LINE 00004237 "and to even position while writing characters that are adjacent to"
NSQ_SOURCE_LINE 00004238 "each other.  Worse, when sending output these servers resend"
NSQ_SOURCE_LINE 00004239 "previously sent command output in a misguided attempt to display an"
NSQ_SOURCE_LINE 00004240 "entire terminal screen."
NSQ_SOURCE_LINE 00004241 ""
NSQ_SOURCE_LINE 00004242 "Connecting Net::Telnet to one of these false TELNET servers makes your"
NSQ_SOURCE_LINE 00004243 "job of parsing command output very difficult.  It's better to replace"
NSQ_SOURCE_LINE 00004244 "a false TELNET server with a real TELNET server.  The better TELNET"
NSQ_SOURCE_LINE 00004245 "servers for MS-Windows allow you to avoid the ANSI escapes by turning"
NSQ_SOURCE_LINE 00004246 "off something some of them call I<console mode>."
NSQ_SOURCE_LINE 00004247 ""
NSQ_SOURCE_LINE 00004248 ""
NSQ_SOURCE_LINE 00004249 "=head1 METHODS"
NSQ_SOURCE_LINE 00004250 ""
NSQ_SOURCE_LINE 00004251 "In the calling sequences below, square brackets B<[]> represent"
NSQ_SOURCE_LINE 00004252 "optional parameters."
NSQ_SOURCE_LINE 00004253 ""
NSQ_SOURCE_LINE 00004254 "=over 4"
NSQ_SOURCE_LINE 00004255 ""
NSQ_SOURCE_LINE 00004256 "=item B<new> - create a new Net::Telnet object"
NSQ_SOURCE_LINE 00004257 ""
NSQ_SOURCE_LINE 00004258 "    $obj = new Net::Telnet ([$host]);"
NSQ_SOURCE_LINE 00004259 ""
NSQ_SOURCE_LINE 00004260 "    $obj = new Net::Telnet ([Binmode    => $mode,]"
NSQ_SOURCE_LINE 00004261 "                            [Cmd_remove_mode => $mode,]"
NSQ_SOURCE_LINE 00004262 "                            [Dump_Log   => $filename,]"
NSQ_SOURCE_LINE 00004263 "                            [Errmode    => $errmode,]"
NSQ_SOURCE_LINE 00004264 "                            [Family     => $family,]"
NSQ_SOURCE_LINE 00004265 "                            [Fhopen     => $filehandle,]"
NSQ_SOURCE_LINE 00004266 "                            [Host       => $host,]"
NSQ_SOURCE_LINE 00004267 "                            [Input_log  => $file,]"
NSQ_SOURCE_LINE 00004268 "                            [Input_record_separator => $chars,]"
NSQ_SOURCE_LINE 00004269 "                            [Localfamily => $family,]"
NSQ_SOURCE_LINE 00004270 "                            [Localhost   => $host,]"
NSQ_SOURCE_LINE 00004271 "                            [Max_buffer_length => $len,]"
NSQ_SOURCE_LINE 00004272 "                            [Ofs        => $chars,]"
NSQ_SOURCE_LINE 00004273 "                            [Option_log => $file,]"
NSQ_SOURCE_LINE 00004274 "                            [Ors        => $chars,]"
NSQ_SOURCE_LINE 00004275 "                            [Output_field_separator => $chars,]"
NSQ_SOURCE_LINE 00004276 "                            [Output_log => $file,]"
NSQ_SOURCE_LINE 00004277 "                            [Output_record_separator => $chars,]"
NSQ_SOURCE_LINE 00004278 "                            [Port       => $port,]"
NSQ_SOURCE_LINE 00004279 "                            [Prompt     => $matchop,]"
NSQ_SOURCE_LINE 00004280 "                            [Rs         => $chars,]"
NSQ_SOURCE_LINE 00004281 "                            [Telnetmode => $mode,]"
NSQ_SOURCE_LINE 00004282 "                            [Timeout    => $secs,]);"
NSQ_SOURCE_LINE 00004283 ""
NSQ_SOURCE_LINE 00004284 "This is the constructor for Net::Telnet objects.  A new object is"
NSQ_SOURCE_LINE 00004285 "returned on success, the error mode action is performed on failure -"
NSQ_SOURCE_LINE 00004286 "see C<errmode()>.  The optional arguments are short-cuts to methods of"
NSQ_SOURCE_LINE 00004287 "the same name."
NSQ_SOURCE_LINE 00004288 ""
NSQ_SOURCE_LINE 00004289 "If the I<$host> argument is given then the object is opened by"
NSQ_SOURCE_LINE 00004290 "connecting to TCP I<$port> on I<$host>.  Also see C<open()>.  The new"
NSQ_SOURCE_LINE 00004291 "object returned is given the following defaults in the absence of"
NSQ_SOURCE_LINE 00004292 "corresponding named parameters:"
NSQ_SOURCE_LINE 00004293 ""
NSQ_SOURCE_LINE 00004294 "=over 4"
NSQ_SOURCE_LINE 00004295 ""
NSQ_SOURCE_LINE 00004296 "=item"
NSQ_SOURCE_LINE 00004297 ""
NSQ_SOURCE_LINE 00004298 "The default I<Host> is C<\"localhost\">"
NSQ_SOURCE_LINE 00004299 ""
NSQ_SOURCE_LINE 00004300 "=item"
NSQ_SOURCE_LINE 00004301 ""
NSQ_SOURCE_LINE 00004302 "The default I<Port> is C<23>"
NSQ_SOURCE_LINE 00004303 ""
NSQ_SOURCE_LINE 00004304 "=item"
NSQ_SOURCE_LINE 00004305 ""
NSQ_SOURCE_LINE 00004306 "The default I<Family> is C<\"ipv4\">"
NSQ_SOURCE_LINE 00004307 ""
NSQ_SOURCE_LINE 00004308 "=item"
NSQ_SOURCE_LINE 00004309 ""
NSQ_SOURCE_LINE 00004310 "The default I<Prompt> is C<'/[\\$%#E<gt>] $/'>"
NSQ_SOURCE_LINE 00004311 ""
NSQ_SOURCE_LINE 00004312 "=item"
NSQ_SOURCE_LINE 00004313 ""
NSQ_SOURCE_LINE 00004314 "The default I<Timeout> is C<10>"
NSQ_SOURCE_LINE 00004315 ""
NSQ_SOURCE_LINE 00004316 "=item"
NSQ_SOURCE_LINE 00004317 ""
NSQ_SOURCE_LINE 00004318 "The default I<Errmode> is C<\"die\">"
NSQ_SOURCE_LINE 00004319 ""
NSQ_SOURCE_LINE 00004320 "=item"
NSQ_SOURCE_LINE 00004321 ""
NSQ_SOURCE_LINE 00004322 "The default I<Output_record_separator> is C<\"\\n\">.  Note that I<Ors>"
NSQ_SOURCE_LINE 00004323 "is synonymous with I<Output_record_separator>."
NSQ_SOURCE_LINE 00004324 ""
NSQ_SOURCE_LINE 00004325 "=item"
NSQ_SOURCE_LINE 00004326 ""
NSQ_SOURCE_LINE 00004327 "The default I<Input_record_separator> is C<\"\\n\">.  Note that I<Rs> is"
NSQ_SOURCE_LINE 00004328 "synonymous with I<Input_record_separator>."
NSQ_SOURCE_LINE 00004329 ""
NSQ_SOURCE_LINE 00004330 "=item"
NSQ_SOURCE_LINE 00004331 ""
NSQ_SOURCE_LINE 00004332 "The default I<Binmode> is C<0>, which means do newline translation."
NSQ_SOURCE_LINE 00004333 ""
NSQ_SOURCE_LINE 00004334 "=item"
NSQ_SOURCE_LINE 00004335 ""
NSQ_SOURCE_LINE 00004336 "The default I<Telnetmode> is C<1>, which means respond to TELNET"
NSQ_SOURCE_LINE 00004337 "commands in the data stream."
NSQ_SOURCE_LINE 00004338 ""
NSQ_SOURCE_LINE 00004339 "=item"
NSQ_SOURCE_LINE 00004340 ""
NSQ_SOURCE_LINE 00004341 "The default I<Cmd_remove_mode> is C<\"auto\">"
NSQ_SOURCE_LINE 00004342 ""
NSQ_SOURCE_LINE 00004343 "=item"
NSQ_SOURCE_LINE 00004344 ""
NSQ_SOURCE_LINE 00004345 "The defaults for I<Dump_log>, I<Input_log>, I<Option_log>, and"
NSQ_SOURCE_LINE 00004346 "I<Output_log> are C<\"\">, which means that logging is turned-off."
NSQ_SOURCE_LINE 00004347 ""
NSQ_SOURCE_LINE 00004348 "=item"
NSQ_SOURCE_LINE 00004349 ""
NSQ_SOURCE_LINE 00004350 "The default I<Max_buffer_length> is C<1048576> bytes, i.e. 1 MiB."
NSQ_SOURCE_LINE 00004351 ""
NSQ_SOURCE_LINE 00004352 "=item"
NSQ_SOURCE_LINE 00004353 ""
NSQ_SOURCE_LINE 00004354 "The default I<Output_field_separator> is C<\"\">.  Note that I<Ofs>"
NSQ_SOURCE_LINE 00004355 "is synonymous with I<Output_field_separator>."
NSQ_SOURCE_LINE 00004356 ""
NSQ_SOURCE_LINE 00004357 "=item"
NSQ_SOURCE_LINE 00004358 ""
NSQ_SOURCE_LINE 00004359 "The default I<Localhost> is C<\"\">"
NSQ_SOURCE_LINE 00004360 ""
NSQ_SOURCE_LINE 00004361 "=item"
NSQ_SOURCE_LINE 00004362 ""
NSQ_SOURCE_LINE 00004363 "The default I<Localfamily> is C<\"ipv4\">"
NSQ_SOURCE_LINE 00004364 ""
NSQ_SOURCE_LINE 00004365 "=back"
NSQ_SOURCE_LINE 00004366 ""
NSQ_SOURCE_LINE 00004367 "=back"
NSQ_SOURCE_LINE 00004368 ""
NSQ_SOURCE_LINE 00004369 ""
NSQ_SOURCE_LINE 00004370 "=over 4"
NSQ_SOURCE_LINE 00004371 ""
NSQ_SOURCE_LINE 00004372 "=item B<binmode> - toggle newline translation"
NSQ_SOURCE_LINE 00004373 ""
NSQ_SOURCE_LINE 00004374 "    $mode = $obj->binmode;"
NSQ_SOURCE_LINE 00004375 ""
NSQ_SOURCE_LINE 00004376 "    $prev = $obj->binmode($mode);"
NSQ_SOURCE_LINE 00004377 ""
NSQ_SOURCE_LINE 00004378 "This method controls whether or not sequences of carriage returns and"
NSQ_SOURCE_LINE 00004379 "line feeds (CR LF or more specifically C<\"\\015\\012\">) are translated."
NSQ_SOURCE_LINE 00004380 "By default they are translated (i.e. binmode is C<0>)."
NSQ_SOURCE_LINE 00004381 ""
NSQ_SOURCE_LINE 00004382 "If no argument is given, the current mode is returned."
NSQ_SOURCE_LINE 00004383 ""
NSQ_SOURCE_LINE 00004384 "If I<$mode> is C<1> then binmode is I<on> and newline translation is"
NSQ_SOURCE_LINE 00004385 "not done."
NSQ_SOURCE_LINE 00004386 ""
NSQ_SOURCE_LINE 00004387 "If I<$mode> is C<0> then binmode is I<off> and newline translation is"
NSQ_SOURCE_LINE 00004388 "done.  In the input stream, each sequence of CR LF is converted to"
NSQ_SOURCE_LINE 00004389 "C<\"\\n\"> and in the output stream, each occurrence of C<\"\\n\"> is"
NSQ_SOURCE_LINE 00004390 "converted to a sequence of CR LF."
NSQ_SOURCE_LINE 00004391 ""
NSQ_SOURCE_LINE 00004392 "Note that input is always buffered.  Changing binmode doesn't effect"
NSQ_SOURCE_LINE 00004393 "what's already been read into the buffer.  Output is not buffered and"
NSQ_SOURCE_LINE 00004394 "changing binmode will have an immediate effect."
NSQ_SOURCE_LINE 00004395 ""
NSQ_SOURCE_LINE 00004396 "=back"
NSQ_SOURCE_LINE 00004397 ""
NSQ_SOURCE_LINE 00004398 ""
NSQ_SOURCE_LINE 00004399 "=over 4"
NSQ_SOURCE_LINE 00004400 ""
NSQ_SOURCE_LINE 00004401 "=item B<break> - send TELNET break character"
NSQ_SOURCE_LINE 00004402 ""
NSQ_SOURCE_LINE 00004403 "    $ok = $obj->break;"
NSQ_SOURCE_LINE 00004404 ""
NSQ_SOURCE_LINE 00004405 "This method sends the TELNET break character.  This character is"
NSQ_SOURCE_LINE 00004406 "provided because it's a signal outside the ASCII character set which"
NSQ_SOURCE_LINE 00004407 "is currently given local meaning within many systems.  It's intended"
NSQ_SOURCE_LINE 00004408 "to indicate that the Break Key or the Attention Key was hit."
NSQ_SOURCE_LINE 00004409 ""
NSQ_SOURCE_LINE 00004410 "This method returns C<1> on success, or performs the error mode action"
NSQ_SOURCE_LINE 00004411 "on failure."
NSQ_SOURCE_LINE 00004412 ""
NSQ_SOURCE_LINE 00004413 "=back"
NSQ_SOURCE_LINE 00004414 ""
NSQ_SOURCE_LINE 00004415 ""
NSQ_SOURCE_LINE 00004416 "=over 4"
NSQ_SOURCE_LINE 00004417 ""
NSQ_SOURCE_LINE 00004418 "=item B<buffer> - scalar reference to object's input buffer"
NSQ_SOURCE_LINE 00004419 ""
NSQ_SOURCE_LINE 00004420 "    $ref = $obj->buffer;"
NSQ_SOURCE_LINE 00004421 ""
NSQ_SOURCE_LINE 00004422 "This method returns a scalar reference to the input buffer for"
NSQ_SOURCE_LINE 00004423 "I<$obj>.  Data in the input buffer is data that has been read from the"
NSQ_SOURCE_LINE 00004424 "remote side but has yet to be read by the user.  Modifications to the"
NSQ_SOURCE_LINE 00004425 "input buffer are returned by a subsequent read."
NSQ_SOURCE_LINE 00004426 ""
NSQ_SOURCE_LINE 00004427 "=back"
NSQ_SOURCE_LINE 00004428 ""
NSQ_SOURCE_LINE 00004429 ""
NSQ_SOURCE_LINE 00004430 "=over 4"
NSQ_SOURCE_LINE 00004431 ""
NSQ_SOURCE_LINE 00004432 "=item B<buffer_empty> - discard all data in object's input buffer"
NSQ_SOURCE_LINE 00004433 ""
NSQ_SOURCE_LINE 00004434 "    $obj->buffer_empty;"
NSQ_SOURCE_LINE 00004435 ""
NSQ_SOURCE_LINE 00004436 "This method removes all data in the input buffer for I<$obj>."
NSQ_SOURCE_LINE 00004437 ""
NSQ_SOURCE_LINE 00004438 "=back"
NSQ_SOURCE_LINE 00004439 ""
NSQ_SOURCE_LINE 00004440 ""
NSQ_SOURCE_LINE 00004441 "=over 4"
NSQ_SOURCE_LINE 00004442 ""
NSQ_SOURCE_LINE 00004443 "=item B<close> - close object"
NSQ_SOURCE_LINE 00004444 ""
NSQ_SOURCE_LINE 00004445 "    $ok = $obj->close;"
NSQ_SOURCE_LINE 00004446 ""
NSQ_SOURCE_LINE 00004447 "This method closes the socket, file, or pipe associated with the"
NSQ_SOURCE_LINE 00004448 "object.  It always returns a value of C<1>."
NSQ_SOURCE_LINE 00004449 ""
NSQ_SOURCE_LINE 00004450 "=back"
NSQ_SOURCE_LINE 00004451 ""
NSQ_SOURCE_LINE 00004452 ""
NSQ_SOURCE_LINE 00004453 "=over 4"
NSQ_SOURCE_LINE 00004454 ""
NSQ_SOURCE_LINE 00004455 "=item B<cmd> - issue command and retrieve output"
NSQ_SOURCE_LINE 00004456 ""
NSQ_SOURCE_LINE 00004457 "    $ok = $obj->cmd($string);"
NSQ_SOURCE_LINE 00004458 "    $ok = $obj->cmd(String   => $string,"
NSQ_SOURCE_LINE 00004459 "                    [Output  => $ref,]"
NSQ_SOURCE_LINE 00004460 "                    [Cmd_remove_mode => $mode,]"
NSQ_SOURCE_LINE 00004461 "                    [Errmode => $mode,]"
NSQ_SOURCE_LINE 00004462 "                    [Input_record_separator => $chars,]"
NSQ_SOURCE_LINE 00004463 "                    [Ors     => $chars,]"
NSQ_SOURCE_LINE 00004464 "                    [Output_record_separator => $chars,]"
NSQ_SOURCE_LINE 00004465 "                    [Prompt  => $match,]"
NSQ_SOURCE_LINE 00004466 "                    [Rs      => $chars,]"
NSQ_SOURCE_LINE 00004467 "                    [Timeout => $secs,]);"
NSQ_SOURCE_LINE 00004468 ""
NSQ_SOURCE_LINE 00004469 "    @output = $obj->cmd($string);"
NSQ_SOURCE_LINE 00004470 "    @output = $obj->cmd(String   => $string,"
NSQ_SOURCE_LINE 00004471 "                        [Output  => $ref,]"
NSQ_SOURCE_LINE 00004472 "                        [Cmd_remove_mode => $mode,]"
NSQ_SOURCE_LINE 00004473 "                        [Errmode => $mode,]"
NSQ_SOURCE_LINE 00004474 "                        [Input_record_separator => $chars,]"
NSQ_SOURCE_LINE 00004475 "                        [Ors     => $chars,]"
NSQ_SOURCE_LINE 00004476 "                        [Output_record_separator => $chars,]"
NSQ_SOURCE_LINE 00004477 "                        [Prompt  => $match,]"
NSQ_SOURCE_LINE 00004478 "                        [Rs      => $chars,]"
NSQ_SOURCE_LINE 00004479 "                        [Timeout => $secs,]);"
NSQ_SOURCE_LINE 00004480 ""
NSQ_SOURCE_LINE 00004481 "This method sends the command I<$string>, and reads the characters"
NSQ_SOURCE_LINE 00004482 "sent back by the command up until and including the matching prompt."
NSQ_SOURCE_LINE 00004483 "It's assumed that the program to which you're sending is some kind of"
NSQ_SOURCE_LINE 00004484 "command prompting interpreter such as a shell."
NSQ_SOURCE_LINE 00004485 ""
NSQ_SOURCE_LINE 00004486 "The command I<$string> is automatically appended with the"
NSQ_SOURCE_LINE 00004487 "output_record_separator, by default it is C<\"\\n\">.  This is similar"
NSQ_SOURCE_LINE 00004488 "to someone typing a command and hitting the return key.  Set the"
NSQ_SOURCE_LINE 00004489 "output_record_separator to change this behavior."
NSQ_SOURCE_LINE 00004490 ""
NSQ_SOURCE_LINE 00004491 "In a scalar context, the characters read from the remote side are"
NSQ_SOURCE_LINE 00004492 "discarded and C<1> is returned on success.  On time-out, eof, or other"
NSQ_SOURCE_LINE 00004493 "failures, the error mode action is performed.  See C<errmode()>."
NSQ_SOURCE_LINE 00004494 ""
NSQ_SOURCE_LINE 00004495 "In a list context, just the output generated by the command is"
NSQ_SOURCE_LINE 00004496 "returned, one line per element.  In other words, all the characters in"
NSQ_SOURCE_LINE 00004497 "between the echoed back command string and the prompt are returned."
NSQ_SOURCE_LINE 00004498 "If the command happens to return no output, a list containing one"
NSQ_SOURCE_LINE 00004499 "element, the empty string is returned.  This is so the list will"
NSQ_SOURCE_LINE 00004500 "indicate true in a boolean context.  On time-out, eof, or other"
NSQ_SOURCE_LINE 00004501 "failures, the error mode action is performed.  See C<errmode()>."
NSQ_SOURCE_LINE 00004502 ""
NSQ_SOURCE_LINE 00004503 "The characters that matched the prompt may be retrieved using"
NSQ_SOURCE_LINE 00004504 "C<last_prompt()>."
NSQ_SOURCE_LINE 00004505 ""
NSQ_SOURCE_LINE 00004506 "Many command interpreters echo back the command sent.  In most"
NSQ_SOURCE_LINE 00004507 "situations, this method removes the first line returned from the"
NSQ_SOURCE_LINE 00004508 "remote side (i.e. the echoed back command).  See C<cmd_remove_mode()>"
NSQ_SOURCE_LINE 00004509 "for more control over this feature."
NSQ_SOURCE_LINE 00004510 ""
NSQ_SOURCE_LINE 00004511 "Use C<dump_log()> to debug when this method keeps timing-out and you"
NSQ_SOURCE_LINE 00004512 "don't think it should."
NSQ_SOURCE_LINE 00004513 ""
NSQ_SOURCE_LINE 00004514 "Consider using a combination of C<print()> and C<waitfor()> as an"
NSQ_SOURCE_LINE 00004515 "alternative to this method when it doesn't do what you want, e.g. the"
NSQ_SOURCE_LINE 00004516 "command you send prompts for input."
NSQ_SOURCE_LINE 00004517 ""
NSQ_SOURCE_LINE 00004518 "The I<Output> named parameter provides an alternative method of"
NSQ_SOURCE_LINE 00004519 "receiving command output.  If you pass a scalar reference, all the"
NSQ_SOURCE_LINE 00004520 "output (even if it contains multiple lines) is returned in the"
NSQ_SOURCE_LINE 00004521 "referenced scalar.  If you pass an array or hash reference, the lines"
NSQ_SOURCE_LINE 00004522 "of output are returned in the referenced array or hash.  You can use"
NSQ_SOURCE_LINE 00004523 "C<input_record_separator()> to change the notion of what separates a"
NSQ_SOURCE_LINE 00004524 "line."
NSQ_SOURCE_LINE 00004525 ""
NSQ_SOURCE_LINE 00004526 "Optional named parameters are provided to override the current"
NSQ_SOURCE_LINE 00004527 "settings of cmd_remove_mode, errmode, input_record_separator, ors,"
NSQ_SOURCE_LINE 00004528 "output_record_separator, prompt, rs, and timeout.  Rs is synonymous"
NSQ_SOURCE_LINE 00004529 "with input_record_separator and ors is synonymous with"
NSQ_SOURCE_LINE 00004530 "output_record_separator."
NSQ_SOURCE_LINE 00004531 ""
NSQ_SOURCE_LINE 00004532 "=back"
NSQ_SOURCE_LINE 00004533 ""
NSQ_SOURCE_LINE 00004534 ""
NSQ_SOURCE_LINE 00004535 "=over 4"
NSQ_SOURCE_LINE 00004536 ""
NSQ_SOURCE_LINE 00004537 "=item B<cmd_remove_mode> - toggle removal of echoed commands"
NSQ_SOURCE_LINE 00004538 ""
NSQ_SOURCE_LINE 00004539 "    $mode = $obj->cmd_remove_mode;"
NSQ_SOURCE_LINE 00004540 ""
NSQ_SOURCE_LINE 00004541 "    $prev = $obj->cmd_remove_mode($mode);"
NSQ_SOURCE_LINE 00004542 ""
NSQ_SOURCE_LINE 00004543 "This method controls how to deal with echoed back commands in the"
NSQ_SOURCE_LINE 00004544 "output returned by cmd().  Typically, when you send a command to the"
NSQ_SOURCE_LINE 00004545 "remote side, the first line of output returned is the command echoed"
NSQ_SOURCE_LINE 00004546 "back.  Use this mode to remove the first line of output normally"
NSQ_SOURCE_LINE 00004547 "returned by cmd()."
NSQ_SOURCE_LINE 00004548 ""
NSQ_SOURCE_LINE 00004549 "If no argument is given, the current mode is returned."
NSQ_SOURCE_LINE 00004550 ""
NSQ_SOURCE_LINE 00004551 "If I<$mode> is C<0> then the command output returned from cmd() has no"
NSQ_SOURCE_LINE 00004552 "lines removed.  If I<$mode> is a positive integer, then the first"
NSQ_SOURCE_LINE 00004553 "I<$mode> lines of command output are stripped."
NSQ_SOURCE_LINE 00004554 ""
NSQ_SOURCE_LINE 00004555 "By default, I<$mode> is set to C<\"auto\">.  Auto means that whether or"
NSQ_SOURCE_LINE 00004556 "not the first line of command output is stripped, depends on whether"
NSQ_SOURCE_LINE 00004557 "or not the remote side offered to echo.  By default, Net::Telnet"
NSQ_SOURCE_LINE 00004558 "always accepts an offer to echo by the remote side.  You can change"
NSQ_SOURCE_LINE 00004559 "the default to reject such an offer using C<option_accept()>."
NSQ_SOURCE_LINE 00004560 ""
NSQ_SOURCE_LINE 00004561 "A warning is printed to STDERR when attempting to set this attribute"
NSQ_SOURCE_LINE 00004562 "to something that is not C<\"auto\"> or a non-negative integer."
NSQ_SOURCE_LINE 00004563 ""
NSQ_SOURCE_LINE 00004564 "=back"
NSQ_SOURCE_LINE 00004565 ""
NSQ_SOURCE_LINE 00004566 ""
NSQ_SOURCE_LINE 00004567 "=over 4"
NSQ_SOURCE_LINE 00004568 ""
NSQ_SOURCE_LINE 00004569 "=item B<dump_log> - log all I/O in dump format"
NSQ_SOURCE_LINE 00004570 ""
NSQ_SOURCE_LINE 00004571 "    $fh = $obj->dump_log;"
NSQ_SOURCE_LINE 00004572 ""
NSQ_SOURCE_LINE 00004573 "    $fh = $obj->dump_log($fh);"
NSQ_SOURCE_LINE 00004574 ""
NSQ_SOURCE_LINE 00004575 "    $fh = $obj->dump_log($tiefh);"
NSQ_SOURCE_LINE 00004576 ""
NSQ_SOURCE_LINE 00004577 "    $fh = $obj->dump_log($filename);"
NSQ_SOURCE_LINE 00004578 ""
NSQ_SOURCE_LINE 00004579 "This method starts or stops dump format logging of all the object's"
NSQ_SOURCE_LINE 00004580 "input and output.  The dump format shows the blocks read and written"
NSQ_SOURCE_LINE 00004581 "in a hexadecimal and printable character format.  This method is"
NSQ_SOURCE_LINE 00004582 "useful when debugging, however you might want to first try"
NSQ_SOURCE_LINE 00004583 "C<input_log()> as it's more readable."
NSQ_SOURCE_LINE 00004584 ""
NSQ_SOURCE_LINE 00004585 "If no argument is given, the log filehandle is returned.  A returned"
NSQ_SOURCE_LINE 00004586 "empty string indicates logging is off."
NSQ_SOURCE_LINE 00004587 ""
NSQ_SOURCE_LINE 00004588 "To stop logging, use an empty string as an argument.  The stopped"
NSQ_SOURCE_LINE 00004589 "filehandle is not closed."
NSQ_SOURCE_LINE 00004590 ""
NSQ_SOURCE_LINE 00004591 "If an open filehandle is given, it is used for logging and returned."
NSQ_SOURCE_LINE 00004592 "Otherwise, the argument is assumed to be the name of a file, the"
NSQ_SOURCE_LINE 00004593 "filename is opened for logging and a filehandle to it is returned.  If"
NSQ_SOURCE_LINE 00004594 "the filehandle is not already opened or the filename can't be opened"
NSQ_SOURCE_LINE 00004595 "for writing, the error mode action is performed.  The filehandle can"
NSQ_SOURCE_LINE 00004596 "be a tied filehandle."
NSQ_SOURCE_LINE 00004597 ""
NSQ_SOURCE_LINE 00004598 "=back"
NSQ_SOURCE_LINE 00004599 ""
NSQ_SOURCE_LINE 00004600 ""
NSQ_SOURCE_LINE 00004601 "=over 4"
NSQ_SOURCE_LINE 00004602 ""
NSQ_SOURCE_LINE 00004603 "=item B<eof> - end of file indicator"
NSQ_SOURCE_LINE 00004604 ""
NSQ_SOURCE_LINE 00004605 "    $eof = $obj->eof;"
NSQ_SOURCE_LINE 00004606 ""
NSQ_SOURCE_LINE 00004607 "This method returns C<1> if end of file has been read, otherwise it"
NSQ_SOURCE_LINE 00004608 "returns an empty string.  Because the input is buffered this isn't the"
NSQ_SOURCE_LINE 00004609 "same thing as I<$obj> has closed.  In other words I<$obj> can be"
NSQ_SOURCE_LINE 00004610 "closed but there still can be stuff in the buffer to be read.  Under"
NSQ_SOURCE_LINE 00004611 "this condition you can still read but you won't be able to write."
NSQ_SOURCE_LINE 00004612 ""
NSQ_SOURCE_LINE 00004613 "=back"
NSQ_SOURCE_LINE 00004614 ""
NSQ_SOURCE_LINE 00004615 ""
NSQ_SOURCE_LINE 00004616 "=over 4"
NSQ_SOURCE_LINE 00004617 ""
NSQ_SOURCE_LINE 00004618 "=item B<errmode> - define action to be performed on error"
NSQ_SOURCE_LINE 00004619 ""
NSQ_SOURCE_LINE 00004620 "    $mode = $obj->errmode;"
NSQ_SOURCE_LINE 00004621 ""
NSQ_SOURCE_LINE 00004622 "    $prev = $obj->errmode($mode);"
NSQ_SOURCE_LINE 00004623 ""
NSQ_SOURCE_LINE 00004624 "This method gets or sets the action used when errors are encountered"
NSQ_SOURCE_LINE 00004625 "using the object.  The first calling sequence returns the current"
NSQ_SOURCE_LINE 00004626 "error mode.  The second calling sequence sets it to I<$mode> and"
NSQ_SOURCE_LINE 00004627 "returns the previous mode.  Valid values for I<$mode> are C<\"die\">"
NSQ_SOURCE_LINE 00004628 "(the default), C<\"return\">, a I<coderef>, or an I<arrayref>."
NSQ_SOURCE_LINE 00004629 ""
NSQ_SOURCE_LINE 00004630 "When mode is C<\"die\"> and an error is encountered using the object,"
NSQ_SOURCE_LINE 00004631 "then an error message is printed to standard error and the program"
NSQ_SOURCE_LINE 00004632 "dies."
NSQ_SOURCE_LINE 00004633 ""
NSQ_SOURCE_LINE 00004634 "When mode is C<\"return\"> then the method generating the error places"
NSQ_SOURCE_LINE 00004635 "an error message in the object and returns an undefined value in a"
NSQ_SOURCE_LINE 00004636 "scalar context and an empty list in list context.  The error message"
NSQ_SOURCE_LINE 00004637 "may be obtained using C<errmsg()>."
NSQ_SOURCE_LINE 00004638 ""
NSQ_SOURCE_LINE 00004639 "When mode is a I<coderef>, then when an error is encountered"
NSQ_SOURCE_LINE 00004640 "I<coderef> is called with the error message as its first argument."
NSQ_SOURCE_LINE 00004641 "Using this mode you may have your own subroutine handle errors.  If"
NSQ_SOURCE_LINE 00004642 "I<coderef> itself returns then the method generating the error returns"
NSQ_SOURCE_LINE 00004643 "undefined or an empty list depending on context."
NSQ_SOURCE_LINE 00004644 ""
NSQ_SOURCE_LINE 00004645 "When mode is an I<arrayref>, the first element of the array must be a"
NSQ_SOURCE_LINE 00004646 "I<coderef>.  Any elements that follow are the arguments to I<coderef>."
NSQ_SOURCE_LINE 00004647 "When an error is encountered, the I<coderef> is called with its"
NSQ_SOURCE_LINE 00004648 "arguments.  Using this mode you may have your own subroutine handle"
NSQ_SOURCE_LINE 00004649 "errors.  If the I<coderef> itself returns then the method generating"
NSQ_SOURCE_LINE 00004650 "the error returns undefined or an empty list depending on context."
NSQ_SOURCE_LINE 00004651 ""
NSQ_SOURCE_LINE 00004652 "A warning is printed to STDERR when attempting to set this attribute"
NSQ_SOURCE_LINE 00004653 "to something that is not C<\"die\">, C<\"return\">, a I<coderef>, or an"
NSQ_SOURCE_LINE 00004654 "I<arrayref> whose first element isn't a I<coderef>."
NSQ_SOURCE_LINE 00004655 ""
NSQ_SOURCE_LINE 00004656 "=back"
NSQ_SOURCE_LINE 00004657 ""
NSQ_SOURCE_LINE 00004658 ""
NSQ_SOURCE_LINE 00004659 "=over 4"
NSQ_SOURCE_LINE 00004660 ""
NSQ_SOURCE_LINE 00004661 "=item B<errmsg> - most recent error message"
NSQ_SOURCE_LINE 00004662 ""
NSQ_SOURCE_LINE 00004663 "    $msg = $obj->errmsg;"
NSQ_SOURCE_LINE 00004664 ""
NSQ_SOURCE_LINE 00004665 "    $prev = $obj->errmsg(@msgs);"
NSQ_SOURCE_LINE 00004666 ""
NSQ_SOURCE_LINE 00004667 "The first calling sequence returns the error message associated with"
NSQ_SOURCE_LINE 00004668 "the object.  The empty string is returned if no error has been"
NSQ_SOURCE_LINE 00004669 "encountered yet.  The second calling sequence sets the error message"
NSQ_SOURCE_LINE 00004670 "for the object to the concatenation of I<@msgs> and returns the"
NSQ_SOURCE_LINE 00004671 "previous error message.  Normally, error messages are set internally"
NSQ_SOURCE_LINE 00004672 "by a method when an error is encountered."
NSQ_SOURCE_LINE 00004673 ""
NSQ_SOURCE_LINE 00004674 "=back"
NSQ_SOURCE_LINE 00004675 ""
NSQ_SOURCE_LINE 00004676 ""
NSQ_SOURCE_LINE 00004677 "=over 4"
NSQ_SOURCE_LINE 00004678 ""
NSQ_SOURCE_LINE 00004679 "=item B<error> - perform the error mode action"
NSQ_SOURCE_LINE 00004680 ""
NSQ_SOURCE_LINE 00004681 "    $obj->error(@msgs);"
NSQ_SOURCE_LINE 00004682 ""
NSQ_SOURCE_LINE 00004683 "This method concatenates I<@msgs> into a string and places it in the"
NSQ_SOURCE_LINE 00004684 "object as the error message.  Also see C<errmsg()>.  It then performs"
NSQ_SOURCE_LINE 00004685 "the error mode action.  Also see C<errmode()>."
NSQ_SOURCE_LINE 00004686 ""
NSQ_SOURCE_LINE 00004687 "If the error mode doesn't cause the program to die, then an undefined"
NSQ_SOURCE_LINE 00004688 "value or an empty list is returned depending on the context."
NSQ_SOURCE_LINE 00004689 ""
NSQ_SOURCE_LINE 00004690 "This method is primarily used by this class or a sub-class to perform"
NSQ_SOURCE_LINE 00004691 "the user requested action when an error is encountered."
NSQ_SOURCE_LINE 00004692 ""
NSQ_SOURCE_LINE 00004693 "=back"
NSQ_SOURCE_LINE 00004694 ""
NSQ_SOURCE_LINE 00004695 ""
NSQ_SOURCE_LINE 00004696 "=over 4"
NSQ_SOURCE_LINE 00004697 ""
NSQ_SOURCE_LINE 00004698 "=item B<family> - IP address family for remote host"
NSQ_SOURCE_LINE 00004699 ""
NSQ_SOURCE_LINE 00004700 "    $family = $obj->family;"
NSQ_SOURCE_LINE 00004701 ""
NSQ_SOURCE_LINE 00004702 "    $prev   = $obj->family($family);"
NSQ_SOURCE_LINE 00004703 ""
NSQ_SOURCE_LINE 00004704 "This method designates which IP address family C<host()> refers to,"
NSQ_SOURCE_LINE 00004705 "i.e. IPv4 or IPv6.  IPv6 support is available when using perl 5.14 or"
NSQ_SOURCE_LINE 00004706 "later.  With no argument it returns the current value set in the"
NSQ_SOURCE_LINE 00004707 "object.  With an argument it sets the current address family to"
NSQ_SOURCE_LINE 00004708 "I<$family> and returns the previous address family.  Valid values are"
NSQ_SOURCE_LINE 00004709 "C<\"ipv4\">, C<\"ipv6\">, or C<\"any\">.  When C<\"any\">, the C<host()> can"
NSQ_SOURCE_LINE 00004710 "be a hostname or IP address for either IPv4 or IPv6.  After"
NSQ_SOURCE_LINE 00004711 "connecting, you can use C<sockfamily()> to determine which IP address"
NSQ_SOURCE_LINE 00004712 "family was used."
NSQ_SOURCE_LINE 00004713 ""
NSQ_SOURCE_LINE 00004714 "The default value is C<\"ipv4\">."
NSQ_SOURCE_LINE 00004715 ""
NSQ_SOURCE_LINE 00004716 "The error mode action is performed when attempting to set this"
NSQ_SOURCE_LINE 00004717 "attribute to something that isn't C<\"ipv4\">, C<\"ipv6\">, or C<\"any\">."
NSQ_SOURCE_LINE 00004718 "It is also performed when attempting to set it to C<\"ipv6\"> when the"
NSQ_SOURCE_LINE 00004719 "Socket module is less than version 1.94 or IPv6 is not supported in"
NSQ_SOURCE_LINE 00004720 "the OS as indicated by Socket::AF_INET6 not being defined."
NSQ_SOURCE_LINE 00004721 ""
NSQ_SOURCE_LINE 00004722 "=back"
NSQ_SOURCE_LINE 00004723 ""
NSQ_SOURCE_LINE 00004724 ""
NSQ_SOURCE_LINE 00004725 "=over 4"
NSQ_SOURCE_LINE 00004726 ""
NSQ_SOURCE_LINE 00004727 "=item B<fhopen> - use already open filehandle for I/O"
NSQ_SOURCE_LINE 00004728 ""
NSQ_SOURCE_LINE 00004729 "    $ok = $obj->fhopen($fh);"
NSQ_SOURCE_LINE 00004730 ""
NSQ_SOURCE_LINE 00004731 "This method associates the open filehandle I<$fh> with I<$obj> for"
NSQ_SOURCE_LINE 00004732 "further I/O.  Filehandle I<$fh> must already be opened."
NSQ_SOURCE_LINE 00004733 ""
NSQ_SOURCE_LINE 00004734 "Suppose you want to use the features of this module to do I/O to"
NSQ_SOURCE_LINE 00004735 "something other than a TCP port, for example STDIN or a filehandle"
NSQ_SOURCE_LINE 00004736 "opened to read from a process.  Instead of opening the object for I/O"
NSQ_SOURCE_LINE 00004737 "to a TCP port by using C<open()> or C<new()>, call this method"
NSQ_SOURCE_LINE 00004738 "instead."
NSQ_SOURCE_LINE 00004739 ""
NSQ_SOURCE_LINE 00004740 "The value C<1> is returned success, the error mode action is performed"
NSQ_SOURCE_LINE 00004741 "on failure."
NSQ_SOURCE_LINE 00004742 ""
NSQ_SOURCE_LINE 00004743 "=back"
NSQ_SOURCE_LINE 00004744 ""
NSQ_SOURCE_LINE 00004745 ""
NSQ_SOURCE_LINE 00004746 "=over 4"
NSQ_SOURCE_LINE 00004747 ""
NSQ_SOURCE_LINE 00004748 "=item B<get> - read block of data"
NSQ_SOURCE_LINE 00004749 ""
NSQ_SOURCE_LINE 00004750 "    $data = $obj->get([Binmode    => $mode,]"
NSQ_SOURCE_LINE 00004751 "                      [Errmode    => $errmode,]"
NSQ_SOURCE_LINE 00004752 "                      [Telnetmode => $mode,]"
NSQ_SOURCE_LINE 00004753 "                      [Timeout    => $secs,]);"
NSQ_SOURCE_LINE 00004754 ""
NSQ_SOURCE_LINE 00004755 "This method reads a block of data from the object and returns it along"
NSQ_SOURCE_LINE 00004756 "with any buffered data.  If no buffered data is available to return,"
NSQ_SOURCE_LINE 00004757 "it will wait for data to read using the timeout specified in the"
NSQ_SOURCE_LINE 00004758 "object.  You can override that timeout using I<$secs>.  Also see"
NSQ_SOURCE_LINE 00004759 "C<timeout()>.  If buffered data is available to return, it also checks"
NSQ_SOURCE_LINE 00004760 "for a block of data that can be immediately read."
NSQ_SOURCE_LINE 00004761 ""
NSQ_SOURCE_LINE 00004762 "On eof an undefined value is returned.  On time-out or other failures,"
NSQ_SOURCE_LINE 00004763 "the error mode action is performed.  To distinguish between eof or an"
NSQ_SOURCE_LINE 00004764 "error occurring when the error mode is not set to C<\"die\">, use"
NSQ_SOURCE_LINE 00004765 "C<eof()>."
NSQ_SOURCE_LINE 00004766 ""
NSQ_SOURCE_LINE 00004767 "Optional named parameters are provided to override the current"
NSQ_SOURCE_LINE 00004768 "settings of binmode, errmode, telnetmode, and timeout."
NSQ_SOURCE_LINE 00004769 ""
NSQ_SOURCE_LINE 00004770 "=back"
NSQ_SOURCE_LINE 00004771 ""
NSQ_SOURCE_LINE 00004772 ""
NSQ_SOURCE_LINE 00004773 "=over 4"
NSQ_SOURCE_LINE 00004774 ""
NSQ_SOURCE_LINE 00004775 "=item B<getline> - read next line"
NSQ_SOURCE_LINE 00004776 ""
NSQ_SOURCE_LINE 00004777 "    $line = $obj->getline([Binmode    => $mode,]"
NSQ_SOURCE_LINE 00004778 "                          [Errmode    => $errmode,]"
NSQ_SOURCE_LINE 00004779 "                          [Input_record_separator => $chars,]"
NSQ_SOURCE_LINE 00004780 "                          [Rs         => $chars,]"
NSQ_SOURCE_LINE 00004781 "                          [Telnetmode => $mode,]"
NSQ_SOURCE_LINE 00004782 "                          [Timeout    => $secs,]);"
NSQ_SOURCE_LINE 00004783 ""
NSQ_SOURCE_LINE 00004784 "This method reads and returns the next line of data from the object."
NSQ_SOURCE_LINE 00004785 "You can use C<input_record_separator()> to change the notion of what"
NSQ_SOURCE_LINE 00004786 "separates a line.  The default is C<\"\\n\">.  If a line isn't"
NSQ_SOURCE_LINE 00004787 "immediately available, this method blocks waiting for a line or a"
NSQ_SOURCE_LINE 00004788 "time-out."
NSQ_SOURCE_LINE 00004789 ""
NSQ_SOURCE_LINE 00004790 "On eof an undefined value is returned.  On time-out or other failures,"
NSQ_SOURCE_LINE 00004791 "the error mode action is performed.  To distinguish between eof or an"
NSQ_SOURCE_LINE 00004792 "error occurring when the error mode is not set to C<\"die\">, use"
NSQ_SOURCE_LINE 00004793 "C<eof()>."
NSQ_SOURCE_LINE 00004794 ""
NSQ_SOURCE_LINE 00004795 "Optional named parameters are provided to override the current"
NSQ_SOURCE_LINE 00004796 "settings of binmode, errmode, input_record_separator, rs, telnetmode,"
NSQ_SOURCE_LINE 00004797 "and timeout.  Rs is synonymous with input_record_separator."
NSQ_SOURCE_LINE 00004798 ""
NSQ_SOURCE_LINE 00004799 "=back"
NSQ_SOURCE_LINE 00004800 ""
NSQ_SOURCE_LINE 00004801 ""
NSQ_SOURCE_LINE 00004802 "=over 4"
NSQ_SOURCE_LINE 00004803 ""
NSQ_SOURCE_LINE 00004804 "=item B<getlines> - read next lines"
NSQ_SOURCE_LINE 00004805 ""
NSQ_SOURCE_LINE 00004806 "    @lines = $obj->getlines([Binmode    => $mode,]"
NSQ_SOURCE_LINE 00004807 "                            [Errmode    => $errmode,]"
NSQ_SOURCE_LINE 00004808 "                            [Input_record_separator => $chars,]"
NSQ_SOURCE_LINE 00004809 "                            [Rs         => $chars,]"
NSQ_SOURCE_LINE 00004810 "                            [Telnetmode => $mode,]"
NSQ_SOURCE_LINE 00004811 "                            [Timeout    => $secs,]"
NSQ_SOURCE_LINE 00004812 "                            [All        => $boolean,]);"
NSQ_SOURCE_LINE 00004813 ""
NSQ_SOURCE_LINE 00004814 "This method reads and returns all the lines of data from the object"
NSQ_SOURCE_LINE 00004815 "until end of file is read.  You can use C<input_record_separator()> to"
NSQ_SOURCE_LINE 00004816 "change the notion of what separates a line.  The default is C<\"\\n\">."
NSQ_SOURCE_LINE 00004817 "A time-out error occurs if all the lines can't be read within the"
NSQ_SOURCE_LINE 00004818 "time-out interval.  See C<timeout()>."
NSQ_SOURCE_LINE 00004819 ""
NSQ_SOURCE_LINE 00004820 "The behavior of this method was changed in version 3.03.  Prior to"
NSQ_SOURCE_LINE 00004821 "version 3.03 this method returned just the lines available from the"
NSQ_SOURCE_LINE 00004822 "next read.  To get that old behavior, use the optional named parameter"
NSQ_SOURCE_LINE 00004823 "I<All> and set I<$boolean> to C<\"\"> or C<0>."
NSQ_SOURCE_LINE 00004824 ""
NSQ_SOURCE_LINE 00004825 "If only eof is read then an empty list is returned.  On time-out or"
NSQ_SOURCE_LINE 00004826 "other failures, the error mode action is performed.  Use C<eof()> to"
NSQ_SOURCE_LINE 00004827 "distinguish between reading only eof or an error occurring when the"
NSQ_SOURCE_LINE 00004828 "error mode is not set to C<\"die\">."
NSQ_SOURCE_LINE 00004829 ""
NSQ_SOURCE_LINE 00004830 "Optional named parameters are provided to override the current"
NSQ_SOURCE_LINE 00004831 "settings of binmode, errmode, input_record_separator, rs, telnetmode,"
NSQ_SOURCE_LINE 00004832 "and timeout.  Rs is synonymous with input_record_separator."
NSQ_SOURCE_LINE 00004833 ""
NSQ_SOURCE_LINE 00004834 "=back"
NSQ_SOURCE_LINE 00004835 ""
NSQ_SOURCE_LINE 00004836 ""
NSQ_SOURCE_LINE 00004837 "=over 4"
NSQ_SOURCE_LINE 00004838 ""
NSQ_SOURCE_LINE 00004839 "=item B<host> - name or IP address of remote host"
NSQ_SOURCE_LINE 00004840 ""
NSQ_SOURCE_LINE 00004841 "    $host = $obj->host;"
NSQ_SOURCE_LINE 00004842 ""
NSQ_SOURCE_LINE 00004843 "    $prev = $obj->host($host);"
NSQ_SOURCE_LINE 00004844 ""
NSQ_SOURCE_LINE 00004845 "This method designates the remote host for C<open()>.  It is either a"
NSQ_SOURCE_LINE 00004846 "hostname or an IP address.  With no argument it returns the current"
NSQ_SOURCE_LINE 00004847 "value set in the object.  With an argument it sets the current host"
NSQ_SOURCE_LINE 00004848 "name to I<$host> and returns the previous value.  Use C<family()> to"
NSQ_SOURCE_LINE 00004849 "control which IP address family, IPv4 or IPv6, host refers to."
NSQ_SOURCE_LINE 00004850 ""
NSQ_SOURCE_LINE 00004851 "The default value is C<\"localhost\">.  It may also be set by C<open()>"
NSQ_SOURCE_LINE 00004852 "or C<new()>."
NSQ_SOURCE_LINE 00004853 ""
NSQ_SOURCE_LINE 00004854 "=back"
NSQ_SOURCE_LINE 00004855 ""
NSQ_SOURCE_LINE 00004856 ""
NSQ_SOURCE_LINE 00004857 "=over 4"
NSQ_SOURCE_LINE 00004858 ""
NSQ_SOURCE_LINE 00004859 "=item B<input_log> - log all input"
NSQ_SOURCE_LINE 00004860 ""
NSQ_SOURCE_LINE 00004861 "    $fh = $obj->input_log;"
NSQ_SOURCE_LINE 00004862 ""
NSQ_SOURCE_LINE 00004863 "    $fh = $obj->input_log($fh);"
NSQ_SOURCE_LINE 00004864 ""
NSQ_SOURCE_LINE 00004865 "    $fh = $obj->input_log($tiefh);"
NSQ_SOURCE_LINE 00004866 ""
NSQ_SOURCE_LINE 00004867 "    $fh = $obj->input_log($filename);"
NSQ_SOURCE_LINE 00004868 ""
NSQ_SOURCE_LINE 00004869 "This method starts or stops logging of input.  This is useful when"
NSQ_SOURCE_LINE 00004870 "debugging.  Also see C<dump_log()>.  Because most command interpreters"
NSQ_SOURCE_LINE 00004871 "echo back commands received, it's likely all your output will also be"
NSQ_SOURCE_LINE 00004872 "in this log.  Note that input logging occurs after newline"
NSQ_SOURCE_LINE 00004873 "translation.  See C<binmode()> for details on newline translation."
NSQ_SOURCE_LINE 00004874 ""
NSQ_SOURCE_LINE 00004875 "If no argument is given, the log filehandle is returned.  A returned"
NSQ_SOURCE_LINE 00004876 "empty string indicates logging is off."
NSQ_SOURCE_LINE 00004877 ""
NSQ_SOURCE_LINE 00004878 "To stop logging, use an empty string as an argument.  The stopped"
NSQ_SOURCE_LINE 00004879 "filehandle is not closed."
NSQ_SOURCE_LINE 00004880 ""
NSQ_SOURCE_LINE 00004881 "If an open filehandle is given, it is used for logging and returned."
NSQ_SOURCE_LINE 00004882 "Otherwise, the argument is assumed to be the name of a file, the"
NSQ_SOURCE_LINE 00004883 "filename is opened for logging and a filehandle to it is returned.  If"
NSQ_SOURCE_LINE 00004884 "the filehandle is not already opened or the filename can't be opened"
NSQ_SOURCE_LINE 00004885 "for writing, the error mode action is performed.  The filehandle can"
NSQ_SOURCE_LINE 00004886 "be a tied filehandle."
NSQ_SOURCE_LINE 00004887 ""
NSQ_SOURCE_LINE 00004888 "=back"
NSQ_SOURCE_LINE 00004889 ""
NSQ_SOURCE_LINE 00004890 ""
NSQ_SOURCE_LINE 00004891 "=over 4"
NSQ_SOURCE_LINE 00004892 ""
NSQ_SOURCE_LINE 00004893 "=item B<input_record_separator> - input line delimiter"
NSQ_SOURCE_LINE 00004894 ""
NSQ_SOURCE_LINE 00004895 "    $chars = $obj->input_record_separator;"
NSQ_SOURCE_LINE 00004896 ""
NSQ_SOURCE_LINE 00004897 "    $prev = $obj->input_record_separator($chars);"
NSQ_SOURCE_LINE 00004898 ""
NSQ_SOURCE_LINE 00004899 "This method designates the line delimiter for input.  It's used with"
NSQ_SOURCE_LINE 00004900 "C<getline()>, C<getlines()>, and C<cmd()> to determine lines in the"
NSQ_SOURCE_LINE 00004901 "input."
NSQ_SOURCE_LINE 00004902 ""
NSQ_SOURCE_LINE 00004903 "With no argument this method returns the current input record"
NSQ_SOURCE_LINE 00004904 "separator set in the object.  With an argument it sets the input"
NSQ_SOURCE_LINE 00004905 "record separator to I<$chars> and returns the previous value.  Note"
NSQ_SOURCE_LINE 00004906 "that I<$chars> must have length."
NSQ_SOURCE_LINE 00004907 ""
NSQ_SOURCE_LINE 00004908 "A warning is printed to STDERR when attempting to set this attribute"
NSQ_SOURCE_LINE 00004909 "to a string with no length."
NSQ_SOURCE_LINE 00004910 ""
NSQ_SOURCE_LINE 00004911 "=back"
NSQ_SOURCE_LINE 00004912 ""
NSQ_SOURCE_LINE 00004913 ""
NSQ_SOURCE_LINE 00004914 "=over 4"
NSQ_SOURCE_LINE 00004915 ""
NSQ_SOURCE_LINE 00004916 "=item B<last_prompt> - last prompt read"
NSQ_SOURCE_LINE 00004917 ""
NSQ_SOURCE_LINE 00004918 "    $string = $obj->last_prompt;"
NSQ_SOURCE_LINE 00004919 ""
NSQ_SOURCE_LINE 00004920 "    $prev = $obj->last_prompt($string);"
NSQ_SOURCE_LINE 00004921 ""
NSQ_SOURCE_LINE 00004922 "With no argument this method returns the last prompt read by cmd() or"
NSQ_SOURCE_LINE 00004923 "login().  See C<prompt()>.  With an argument it sets the last prompt"
NSQ_SOURCE_LINE 00004924 "read to I<$string> and returns the previous value.  Normally, only"
NSQ_SOURCE_LINE 00004925 "internal methods set the last prompt."
NSQ_SOURCE_LINE 00004926 ""
NSQ_SOURCE_LINE 00004927 "=back"
NSQ_SOURCE_LINE 00004928 ""
NSQ_SOURCE_LINE 00004929 ""
NSQ_SOURCE_LINE 00004930 "=over 4"
NSQ_SOURCE_LINE 00004931 ""
NSQ_SOURCE_LINE 00004932 "=item B<lastline> - last line read"
NSQ_SOURCE_LINE 00004933 ""
NSQ_SOURCE_LINE 00004934 "    $line = $obj->lastline;"
NSQ_SOURCE_LINE 00004935 ""
NSQ_SOURCE_LINE 00004936 "    $prev = $obj->lastline($line);"
NSQ_SOURCE_LINE 00004937 ""
NSQ_SOURCE_LINE 00004938 "This method retrieves the last line read from the object.  This may be"
NSQ_SOURCE_LINE 00004939 "a useful error message when the remote side abnormally closes the"
NSQ_SOURCE_LINE 00004940 "connection.  Typically the remote side will print an error message"
NSQ_SOURCE_LINE 00004941 "before closing."
NSQ_SOURCE_LINE 00004942 ""
NSQ_SOURCE_LINE 00004943 "With no argument this method returns the last line read from the"
NSQ_SOURCE_LINE 00004944 "object.  With an argument it sets the last line read to I<$line> and"
NSQ_SOURCE_LINE 00004945 "returns the previous value.  Normally, only internal methods set the"
NSQ_SOURCE_LINE 00004946 "last line."
NSQ_SOURCE_LINE 00004947 ""
NSQ_SOURCE_LINE 00004948 "=back"
NSQ_SOURCE_LINE 00004949 ""
NSQ_SOURCE_LINE 00004950 ""
NSQ_SOURCE_LINE 00004951 "=over 4"
NSQ_SOURCE_LINE 00004952 ""
NSQ_SOURCE_LINE 00004953 "=item B<localfamily> - IP address family for local host"
NSQ_SOURCE_LINE 00004954 ""
NSQ_SOURCE_LINE 00004955 "    $localfamily = $obj->localfamily;"
NSQ_SOURCE_LINE 00004956 ""
NSQ_SOURCE_LINE 00004957 "    $prev   = $obj->localfamily($family);"
NSQ_SOURCE_LINE 00004958 ""
NSQ_SOURCE_LINE 00004959 "This method designates which IP address family C<localhost()> refers"
NSQ_SOURCE_LINE 00004960 "to, i.e. IPv4 or IPv6.  IPv6 support is available when using perl 5.14"
NSQ_SOURCE_LINE 00004961 "or later.  With no argument it returns the current value set in the"
NSQ_SOURCE_LINE 00004962 "object.  With an argument it sets the current local address family to"
NSQ_SOURCE_LINE 00004963 "I<$family> and returns the previous address family.  Valid values"
NSQ_SOURCE_LINE 00004964 "are C<\"ipv4\">, C<\"ipv6\">, or C<\"any\">.  When C<\"any\">, the"
NSQ_SOURCE_LINE 00004965 "C<localhost()> can be a hostname or IP address for either IPv4 or"
NSQ_SOURCE_LINE 00004966 "IPv6."
NSQ_SOURCE_LINE 00004967 ""
NSQ_SOURCE_LINE 00004968 "The default value is C<\"ipv4\">."
NSQ_SOURCE_LINE 00004969 ""
NSQ_SOURCE_LINE 00004970 "The error mode action is performed when attempting to set this"
NSQ_SOURCE_LINE 00004971 "attribute to something that isn't C<\"ipv4\">, C<\"ipv6\">, or C<\"any\">."
NSQ_SOURCE_LINE 00004972 "It is also performed when attempting to set it to C<\"ipv6\"> when the"
NSQ_SOURCE_LINE 00004973 "Socket module is less than version 1.94 or IPv6 is not supported in"
NSQ_SOURCE_LINE 00004974 "the OS as indicated by Socket::AF_INET6 not being defined."
NSQ_SOURCE_LINE 00004975 ""
NSQ_SOURCE_LINE 00004976 "=back"
NSQ_SOURCE_LINE 00004977 ""
NSQ_SOURCE_LINE 00004978 ""
NSQ_SOURCE_LINE 00004979 "=over 4"
NSQ_SOURCE_LINE 00004980 ""
NSQ_SOURCE_LINE 00004981 "=item B<localhost> - bind local socket to a specific network interface"
NSQ_SOURCE_LINE 00004982 ""
NSQ_SOURCE_LINE 00004983 "    $localhost = $obj->localhost;"
NSQ_SOURCE_LINE 00004984 ""
NSQ_SOURCE_LINE 00004985 "    $prev = $obj->localhost($host);"
NSQ_SOURCE_LINE 00004986 ""
NSQ_SOURCE_LINE 00004987 "This method designates the local socket IP address for C<open()>.  It"
NSQ_SOURCE_LINE 00004988 "is either a hostname, an IP address, or a null string (i.e. C<\"\">).  A"
NSQ_SOURCE_LINE 00004989 "null string disables this feature."
NSQ_SOURCE_LINE 00004990 ""
NSQ_SOURCE_LINE 00004991 "Normally the OS picks which local network interface to use.  This"
NSQ_SOURCE_LINE 00004992 "method is useful when the local machine has more than one network"
NSQ_SOURCE_LINE 00004993 "interface and you want to bind to a specific one.  With no argument it"
NSQ_SOURCE_LINE 00004994 "returns the current value set in the object.  With an argument it sets"
NSQ_SOURCE_LINE 00004995 "the current local host name to I<$host> and returns the previous"
NSQ_SOURCE_LINE 00004996 "value.  Use C<localfamily()> to control which IP address family, IPv4"
NSQ_SOURCE_LINE 00004997 "or IPv6, local host refers to."
NSQ_SOURCE_LINE 00004998 ""
NSQ_SOURCE_LINE 00004999 "The default value is C<\"\">."
NSQ_SOURCE_LINE 00005000 ""
NSQ_SOURCE_LINE 00005001 "=back"
NSQ_SOURCE_LINE 00005002 ""
NSQ_SOURCE_LINE 00005003 ""
NSQ_SOURCE_LINE 00005004 "=over 4"
NSQ_SOURCE_LINE 00005005 ""
NSQ_SOURCE_LINE 00005006 "=item B<login> - perform standard login"
NSQ_SOURCE_LINE 00005007 ""
NSQ_SOURCE_LINE 00005008 "    $ok = $obj->login($username, $password);"
NSQ_SOURCE_LINE 00005009 ""
NSQ_SOURCE_LINE 00005010 "    $ok = $obj->login(Name     => $username,"
NSQ_SOURCE_LINE 00005011 "                      Password => $password,"
NSQ_SOURCE_LINE 00005012 "                      [Errmode => $mode,]"
NSQ_SOURCE_LINE 00005013 "                      [Prompt  => $match,]"
NSQ_SOURCE_LINE 00005014 "                      [Timeout => $secs,]);"
NSQ_SOURCE_LINE 00005015 ""
NSQ_SOURCE_LINE 00005016 "This method performs a standard login by waiting for a login prompt"
NSQ_SOURCE_LINE 00005017 "and responding with I<$username>, then waiting for the password prompt"
NSQ_SOURCE_LINE 00005018 "and responding with I<$password>, and then waiting for the command"
NSQ_SOURCE_LINE 00005019 "interpreter prompt.  If any of those prompts sent by the remote side"
NSQ_SOURCE_LINE 00005020 "don't match what's expected, this method will time-out, unless timeout"
NSQ_SOURCE_LINE 00005021 "is turned off."
NSQ_SOURCE_LINE 00005022 ""
NSQ_SOURCE_LINE 00005023 "Login prompt must match either of these case insensitive patterns:"
NSQ_SOURCE_LINE 00005024 ""
NSQ_SOURCE_LINE 00005025 "    /login[: ]*$/i"
NSQ_SOURCE_LINE 00005026 "    /username[: ]*$/i"
NSQ_SOURCE_LINE 00005027 ""
NSQ_SOURCE_LINE 00005028 "Password prompt must match this case insensitive pattern:"
NSQ_SOURCE_LINE 00005029 ""
NSQ_SOURCE_LINE 00005030 "    /password[: ]*$/i"
NSQ_SOURCE_LINE 00005031 ""
NSQ_SOURCE_LINE 00005032 "The command interpreter prompt must match the current setting of"
NSQ_SOURCE_LINE 00005033 "prompt.  See C<prompt()>."
NSQ_SOURCE_LINE 00005034 ""
NSQ_SOURCE_LINE 00005035 "Use C<dump_log()> to debug when this method keeps timing-out and you"
NSQ_SOURCE_LINE 00005036 "don't think it should."
NSQ_SOURCE_LINE 00005037 ""
NSQ_SOURCE_LINE 00005038 "Consider using a combination of C<print()> and C<waitfor()> as an"
NSQ_SOURCE_LINE 00005039 "alternative to this method when it doesn't do what you want, e.g. the"
NSQ_SOURCE_LINE 00005040 "remote host doesn't prompt for a username."
NSQ_SOURCE_LINE 00005041 ""
NSQ_SOURCE_LINE 00005042 "On success, C<1> is returned.  On time out, eof, or other failures,"
NSQ_SOURCE_LINE 00005043 "the error mode action is performed.  See C<errmode()>."
NSQ_SOURCE_LINE 00005044 ""
NSQ_SOURCE_LINE 00005045 "Optional named parameters are provided to override the current"
NSQ_SOURCE_LINE 00005046 "settings of errmode, prompt, and timeout."
NSQ_SOURCE_LINE 00005047 ""
NSQ_SOURCE_LINE 00005048 "=back"
NSQ_SOURCE_LINE 00005049 ""
NSQ_SOURCE_LINE 00005050 ""
NSQ_SOURCE_LINE 00005051 "=over 4"
NSQ_SOURCE_LINE 00005052 ""
NSQ_SOURCE_LINE 00005053 "=item B<max_buffer_length> - maximum size of input buffer"
NSQ_SOURCE_LINE 00005054 ""
NSQ_SOURCE_LINE 00005055 "    $len = $obj->max_buffer_length;"
NSQ_SOURCE_LINE 00005056 ""
NSQ_SOURCE_LINE 00005057 "    $prev = $obj->max_buffer_length($len);"
NSQ_SOURCE_LINE 00005058 ""
NSQ_SOURCE_LINE 00005059 "This method designates the maximum size of the input buffer.  An error"
NSQ_SOURCE_LINE 00005060 "is generated when a read causes the buffer to exceed this limit.  The"
NSQ_SOURCE_LINE 00005061 "default value is 1,048,576 bytes (1 MiB).  The input buffer can grow"
NSQ_SOURCE_LINE 00005062 "much larger than the block size when you continuously read using"
NSQ_SOURCE_LINE 00005063 "C<getline()> or C<waitfor()> and the data stream contains no newlines"
NSQ_SOURCE_LINE 00005064 "or matching waitfor patterns."
NSQ_SOURCE_LINE 00005065 ""
NSQ_SOURCE_LINE 00005066 "With no argument, this method returns the current maximum buffer"
NSQ_SOURCE_LINE 00005067 "length set in the object.  With an argument it sets the maximum buffer"
NSQ_SOURCE_LINE 00005068 "length to I<$len> and returns the previous value.  Values of I<$len>"
NSQ_SOURCE_LINE 00005069 "smaller than 512 will be adjusted to 512."
NSQ_SOURCE_LINE 00005070 ""
NSQ_SOURCE_LINE 00005071 "A warning is printed to STDERR when attempting to set this attribute"
NSQ_SOURCE_LINE 00005072 "to something that isn't a positive integer."
NSQ_SOURCE_LINE 00005073 ""
NSQ_SOURCE_LINE 00005074 "=back"
NSQ_SOURCE_LINE 00005075 ""
NSQ_SOURCE_LINE 00005076 ""
NSQ_SOURCE_LINE 00005077 "=over 4"
NSQ_SOURCE_LINE 00005078 ""
NSQ_SOURCE_LINE 00005079 "=item B<ofs> - field separator for print"
NSQ_SOURCE_LINE 00005080 ""
NSQ_SOURCE_LINE 00005081 "    $chars = $obj->ofs"
NSQ_SOURCE_LINE 00005082 ""
NSQ_SOURCE_LINE 00005083 "    $prev = $obj->ofs($chars);"
NSQ_SOURCE_LINE 00005084 ""
NSQ_SOURCE_LINE 00005085 "This method is synonymous with C<output_field_separator()>."
NSQ_SOURCE_LINE 00005086 ""
NSQ_SOURCE_LINE 00005087 "=back"
NSQ_SOURCE_LINE 00005088 ""
NSQ_SOURCE_LINE 00005089 ""
NSQ_SOURCE_LINE 00005090 "=over 4"
NSQ_SOURCE_LINE 00005091 ""
NSQ_SOURCE_LINE 00005092 "=item B<open> - connect to port on remote host"
NSQ_SOURCE_LINE 00005093 ""
NSQ_SOURCE_LINE 00005094 "    $ok = $obj->open($host);"
NSQ_SOURCE_LINE 00005095 ""
NSQ_SOURCE_LINE 00005096 "    $ok = $obj->open([Host        => $host,]"
NSQ_SOURCE_LINE 00005097 "                     [Port        => $port,]"
NSQ_SOURCE_LINE 00005098 "                     [Family      => $family,]"
NSQ_SOURCE_LINE 00005099 "                     [Errmode     => $mode,]"
NSQ_SOURCE_LINE 00005100 "                     [Timeout     => $secs,]"
NSQ_SOURCE_LINE 00005101 "                     [Localhost   => $host,]"
NSQ_SOURCE_LINE 00005102 "                     [Localfamily => $family,]);"
NSQ_SOURCE_LINE 00005103 ""
NSQ_SOURCE_LINE 00005104 "This method opens a TCP connection to I<$port> on I<$host> for the IP"
NSQ_SOURCE_LINE 00005105 "address I<$family>.  If any of those arguments are missing then the"
NSQ_SOURCE_LINE 00005106 "current attribute value for the object is used.  Specifying I<Host>"
NSQ_SOURCE_LINE 00005107 "sets that attribute for the object.  Specifying any of the other"
NSQ_SOURCE_LINE 00005108 "optional named parameters overrides the current setting."
NSQ_SOURCE_LINE 00005109 ""
NSQ_SOURCE_LINE 00005110 "The default IP address family is C<\"ipv4\">.  I<$family> may be set to"
NSQ_SOURCE_LINE 00005111 "C<\"ipv4\">, C<\"ipv6\">, or C<\"any\">.  See C<family()> for more details."
NSQ_SOURCE_LINE 00005112 ""
NSQ_SOURCE_LINE 00005113 "I<Localhost> is used to bind to a specific local network interface."
NSQ_SOURCE_LINE 00005114 ""
NSQ_SOURCE_LINE 00005115 "If the object is already open, it is closed before attempting a"
NSQ_SOURCE_LINE 00005116 "connection."
NSQ_SOURCE_LINE 00005117 ""
NSQ_SOURCE_LINE 00005118 "On success C<1> is returned.  On time-out or other connection"
NSQ_SOURCE_LINE 00005119 "failures, the error mode action is performed.  See C<errmode()>."
NSQ_SOURCE_LINE 00005120 ""
NSQ_SOURCE_LINE 00005121 "Time-outs don't work for this method on machines that don't implement"
NSQ_SOURCE_LINE 00005122 "SIGALRM - most notably MS-Windows machines.  For those machines, an"
NSQ_SOURCE_LINE 00005123 "error is returned when the system reaches its own time-out while"
NSQ_SOURCE_LINE 00005124 "trying to connect."
NSQ_SOURCE_LINE 00005125 ""
NSQ_SOURCE_LINE 00005126 "A side effect of this method is to reset the alarm interval associated"
NSQ_SOURCE_LINE 00005127 "with SIGALRM."
NSQ_SOURCE_LINE 00005128 ""
NSQ_SOURCE_LINE 00005129 "=back"
NSQ_SOURCE_LINE 00005130 ""
NSQ_SOURCE_LINE 00005131 ""
NSQ_SOURCE_LINE 00005132 "=over 4"
NSQ_SOURCE_LINE 00005133 ""
NSQ_SOURCE_LINE 00005134 "=item B<option_accept> - indicate willingness to accept a TELNET option"
NSQ_SOURCE_LINE 00005135 ""
NSQ_SOURCE_LINE 00005136 "    $fh = $obj->option_accept([Do   => $telopt,]"
NSQ_SOURCE_LINE 00005137 "                              [Dont => $telopt,]"
NSQ_SOURCE_LINE 00005138 "                              [Will => $telopt,]"
NSQ_SOURCE_LINE 00005139 "                              [Wont => $telopt,]);"
NSQ_SOURCE_LINE 00005140 ""
NSQ_SOURCE_LINE 00005141 "This method is used to indicate whether to accept or reject an offer"
NSQ_SOURCE_LINE 00005142 "to enable a TELNET option made by the remote side.  If you're using"
NSQ_SOURCE_LINE 00005143 "I<Do> or I<Will> to indicate a willingness to enable, then a"
NSQ_SOURCE_LINE 00005144 "notification callback must have already been defined by a prior call"
NSQ_SOURCE_LINE 00005145 "to C<option_callback()>.  See C<option_callback()> for details on"
NSQ_SOURCE_LINE 00005146 "receiving enable/disable notification of a TELNET option."
NSQ_SOURCE_LINE 00005147 ""
NSQ_SOURCE_LINE 00005148 "You can give multiple I<Do>, I<Dont>, I<Will>, or I<Wont> arguments"
NSQ_SOURCE_LINE 00005149 "for different TELNET options in the same call to this method."
NSQ_SOURCE_LINE 00005150 ""
NSQ_SOURCE_LINE 00005151 "The following example describes the meaning of the named parameters."
NSQ_SOURCE_LINE 00005152 "A TELNET option, such as C<TELOPT_ECHO> used below, is an integer"
NSQ_SOURCE_LINE 00005153 "constant that you can import from Net::Telnet.  See the source in file"
NSQ_SOURCE_LINE 00005154 "Telnet.pm for the complete list."
NSQ_SOURCE_LINE 00005155 ""
NSQ_SOURCE_LINE 00005156 "=over 4"
NSQ_SOURCE_LINE 00005157 ""
NSQ_SOURCE_LINE 00005158 "=item"
NSQ_SOURCE_LINE 00005159 ""
NSQ_SOURCE_LINE 00005160 "I<Do> => C<TELOPT_ECHO>"
NSQ_SOURCE_LINE 00005161 ""
NSQ_SOURCE_LINE 00005162 "=over 4"
NSQ_SOURCE_LINE 00005163 ""
NSQ_SOURCE_LINE 00005164 "=item"
NSQ_SOURCE_LINE 00005165 ""
NSQ_SOURCE_LINE 00005166 "we'll accept an offer to enable the echo option on the local side"
NSQ_SOURCE_LINE 00005167 ""
NSQ_SOURCE_LINE 00005168 "=back"
NSQ_SOURCE_LINE 00005169 ""
NSQ_SOURCE_LINE 00005170 "=item"
NSQ_SOURCE_LINE 00005171 ""
NSQ_SOURCE_LINE 00005172 "I<Dont> => C<TELOPT_ECHO>"
NSQ_SOURCE_LINE 00005173 ""
NSQ_SOURCE_LINE 00005174 "=over 4"
NSQ_SOURCE_LINE 00005175 ""
NSQ_SOURCE_LINE 00005176 "=item"
NSQ_SOURCE_LINE 00005177 ""
NSQ_SOURCE_LINE 00005178 "we'll reject an offer to enable the echo option on the local side"
NSQ_SOURCE_LINE 00005179 ""
NSQ_SOURCE_LINE 00005180 "=back"
NSQ_SOURCE_LINE 00005181 ""
NSQ_SOURCE_LINE 00005182 "=item"
NSQ_SOURCE_LINE 00005183 ""
NSQ_SOURCE_LINE 00005184 "I<Will> => C<TELOPT_ECHO>"
NSQ_SOURCE_LINE 00005185 ""
NSQ_SOURCE_LINE 00005186 "=over 4"
NSQ_SOURCE_LINE 00005187 ""
NSQ_SOURCE_LINE 00005188 "=item"
NSQ_SOURCE_LINE 00005189 ""
NSQ_SOURCE_LINE 00005190 "we'll accept an offer to enable the echo option on the remote side"
NSQ_SOURCE_LINE 00005191 ""
NSQ_SOURCE_LINE 00005192 "=back"
NSQ_SOURCE_LINE 00005193 ""
NSQ_SOURCE_LINE 00005194 "=item"
NSQ_SOURCE_LINE 00005195 ""
NSQ_SOURCE_LINE 00005196 "I<Wont> => C<TELOPT_ECHO>"
NSQ_SOURCE_LINE 00005197 ""
NSQ_SOURCE_LINE 00005198 "=over 4"
NSQ_SOURCE_LINE 00005199 ""
NSQ_SOURCE_LINE 00005200 "=item"
NSQ_SOURCE_LINE 00005201 ""
NSQ_SOURCE_LINE 00005202 "we'll reject an offer to enable the echo option on the remote side"
NSQ_SOURCE_LINE 00005203 ""
NSQ_SOURCE_LINE 00005204 "=back"
NSQ_SOURCE_LINE 00005205 ""
NSQ_SOURCE_LINE 00005206 "=item"
NSQ_SOURCE_LINE 00005207 ""
NSQ_SOURCE_LINE 00005208 "Use C<option_send()> to send a request to the remote side to enable or"
NSQ_SOURCE_LINE 00005209 "disable a particular TELNET option."
NSQ_SOURCE_LINE 00005210 ""
NSQ_SOURCE_LINE 00005211 "=back"
NSQ_SOURCE_LINE 00005212 ""
NSQ_SOURCE_LINE 00005213 "=back"
NSQ_SOURCE_LINE 00005214 ""
NSQ_SOURCE_LINE 00005215 "=over 4"
NSQ_SOURCE_LINE 00005216 ""
NSQ_SOURCE_LINE 00005217 "=item B<option_callback> - define the option negotiation callback"
NSQ_SOURCE_LINE 00005218 ""
NSQ_SOURCE_LINE 00005219 "    $coderef = $obj->option_callback;"
NSQ_SOURCE_LINE 00005220 ""
NSQ_SOURCE_LINE 00005221 "    $prev = $obj->option_callback($coderef);"
NSQ_SOURCE_LINE 00005222 ""
NSQ_SOURCE_LINE 00005223 "This method defines the callback subroutine that is called when a"
NSQ_SOURCE_LINE 00005224 "TELNET option is enabled or disabled.  Once defined, the"
NSQ_SOURCE_LINE 00005225 "I<option_callback> may not be undefined.  However, calling this method"
NSQ_SOURCE_LINE 00005226 "with a different I<$coderef> changes it."
NSQ_SOURCE_LINE 00005227 ""
NSQ_SOURCE_LINE 00005228 "A warning is printed to STDERR when attempting to set this attribute"
NSQ_SOURCE_LINE 00005229 "to something that isn't a coderef."
NSQ_SOURCE_LINE 00005230 ""
NSQ_SOURCE_LINE 00005231 "Here are the circumstances that invoke I<$coderef>:"
NSQ_SOURCE_LINE 00005232 ""
NSQ_SOURCE_LINE 00005233 "=over 4"
NSQ_SOURCE_LINE 00005234 ""
NSQ_SOURCE_LINE 00005235 "=item"
NSQ_SOURCE_LINE 00005236 ""
NSQ_SOURCE_LINE 00005237 "An option becomes enabled because the remote side requested an enable"
NSQ_SOURCE_LINE 00005238 "and C<option_accept()> had been used to arrange that it be accepted."
NSQ_SOURCE_LINE 00005239 ""
NSQ_SOURCE_LINE 00005240 "=item"
NSQ_SOURCE_LINE 00005241 ""
NSQ_SOURCE_LINE 00005242 "The remote side arbitrarily decides to disable an option that is"
NSQ_SOURCE_LINE 00005243 "currently enabled.  Note that Net::Telnet always accepts a request to"
NSQ_SOURCE_LINE 00005244 "disable from the remote side."
NSQ_SOURCE_LINE 00005245 ""
NSQ_SOURCE_LINE 00005246 "=item"
NSQ_SOURCE_LINE 00005247 ""
NSQ_SOURCE_LINE 00005248 "C<option_send()> was used to send a request to enable or disable an"
NSQ_SOURCE_LINE 00005249 "option and the response from the remote side has just been received."
NSQ_SOURCE_LINE 00005250 "Note, that if a request to enable is rejected then I<$coderef> is"
NSQ_SOURCE_LINE 00005251 "still invoked even though the option didn't change."
NSQ_SOURCE_LINE 00005252 ""
NSQ_SOURCE_LINE 00005253 "=item"
NSQ_SOURCE_LINE 00005254 ""
NSQ_SOURCE_LINE 00005255 "Here are the arguments passed to I<&$coderef>:"
NSQ_SOURCE_LINE 00005256 ""
NSQ_SOURCE_LINE 00005257 "    &$coderef($obj, $option, $is_remote,"
NSQ_SOURCE_LINE 00005258 "              $is_enabled, $was_enabled, $buf_position);"
NSQ_SOURCE_LINE 00005259 ""
NSQ_SOURCE_LINE 00005260 "=back"
NSQ_SOURCE_LINE 00005261 ""
NSQ_SOURCE_LINE 00005262 "=over 4"
NSQ_SOURCE_LINE 00005263 ""
NSQ_SOURCE_LINE 00005264 "=item"
NSQ_SOURCE_LINE 00005265 ""
NSQ_SOURCE_LINE 00005266 "1.  I<$obj> is the Net::Telnet object"
NSQ_SOURCE_LINE 00005267 ""
NSQ_SOURCE_LINE 00005268 "=item"
NSQ_SOURCE_LINE 00005269 ""
NSQ_SOURCE_LINE 00005270 "2.  I<$option> is the TELNET option.  Net::Telnet exports constants"
NSQ_SOURCE_LINE 00005271 "for the various TELNET options which just equate to an integer."
NSQ_SOURCE_LINE 00005272 ""
NSQ_SOURCE_LINE 00005273 "=item"
NSQ_SOURCE_LINE 00005274 ""
NSQ_SOURCE_LINE 00005275 "3.  I<$is_remote> is a boolean indicating for which side the option"
NSQ_SOURCE_LINE 00005276 "applies."
NSQ_SOURCE_LINE 00005277 ""
NSQ_SOURCE_LINE 00005278 "=item"
NSQ_SOURCE_LINE 00005279 ""
NSQ_SOURCE_LINE 00005280 "4.  I<$is_enabled> is a boolean indicating the option is enabled or"
NSQ_SOURCE_LINE 00005281 "disabled"
NSQ_SOURCE_LINE 00005282 ""
NSQ_SOURCE_LINE 00005283 "=item"
NSQ_SOURCE_LINE 00005284 ""
NSQ_SOURCE_LINE 00005285 "5.  I<$was_enabled> is a boolean indicating the option was previously"
NSQ_SOURCE_LINE 00005286 "enabled or disabled"
NSQ_SOURCE_LINE 00005287 ""
NSQ_SOURCE_LINE 00005288 "=item"
NSQ_SOURCE_LINE 00005289 ""
NSQ_SOURCE_LINE 00005290 "6.  I<$buf_position> is an integer indicating the position in the"
NSQ_SOURCE_LINE 00005291 "object's input buffer where the option takes effect.  See C<buffer()>"
NSQ_SOURCE_LINE 00005292 "to access the object's input buffer."
NSQ_SOURCE_LINE 00005293 ""
NSQ_SOURCE_LINE 00005294 "=back"
NSQ_SOURCE_LINE 00005295 ""
NSQ_SOURCE_LINE 00005296 "=back"
NSQ_SOURCE_LINE 00005297 ""
NSQ_SOURCE_LINE 00005298 ""
NSQ_SOURCE_LINE 00005299 "=over 4"
NSQ_SOURCE_LINE 00005300 ""
NSQ_SOURCE_LINE 00005301 "=item B<option_log> - log all TELNET options sent or received"
NSQ_SOURCE_LINE 00005302 ""
NSQ_SOURCE_LINE 00005303 "    $fh = $obj->option_log;"
NSQ_SOURCE_LINE 00005304 ""
NSQ_SOURCE_LINE 00005305 "    $fh = $obj->option_log($fh);"
NSQ_SOURCE_LINE 00005306 ""
NSQ_SOURCE_LINE 00005307 "    $fh = $obj->option_log($tiefh);"
NSQ_SOURCE_LINE 00005308 ""
NSQ_SOURCE_LINE 00005309 "    $fh = $obj->option_log($filename);"
NSQ_SOURCE_LINE 00005310 ""
NSQ_SOURCE_LINE 00005311 "This method starts or stops logging of all TELNET options being sent"
NSQ_SOURCE_LINE 00005312 "or received.  This is useful for debugging when you send options via"
NSQ_SOURCE_LINE 00005313 "C<option_send()> or you arrange to accept option requests from the"
NSQ_SOURCE_LINE 00005314 "remote side via C<option_accept()>.  Also see C<dump_log()>."
NSQ_SOURCE_LINE 00005315 ""
NSQ_SOURCE_LINE 00005316 "If no argument is given, the log filehandle is returned.  An empty"
NSQ_SOURCE_LINE 00005317 "string indicates logging is off."
NSQ_SOURCE_LINE 00005318 ""
NSQ_SOURCE_LINE 00005319 "To stop logging, use an empty string as an argument.  The stopped"
NSQ_SOURCE_LINE 00005320 "filehandle is not closed."
NSQ_SOURCE_LINE 00005321 ""
NSQ_SOURCE_LINE 00005322 "If an open filehandle is given, it is used for logging and returned."
NSQ_SOURCE_LINE 00005323 "Otherwise, the argument is assumed to be the name of a file, the"
NSQ_SOURCE_LINE 00005324 "filename is opened for logging and a filehandle to it is returned.  If"
NSQ_SOURCE_LINE 00005325 "the filehandle is not already opened or the filename can't be opened"
NSQ_SOURCE_LINE 00005326 "for writing, the error mode action is performed.  The filehandle can"
NSQ_SOURCE_LINE 00005327 "be a tied filehandle."
NSQ_SOURCE_LINE 00005328 ""
NSQ_SOURCE_LINE 00005329 "=back"
NSQ_SOURCE_LINE 00005330 ""
NSQ_SOURCE_LINE 00005331 ""
NSQ_SOURCE_LINE 00005332 "=over 4"
NSQ_SOURCE_LINE 00005333 ""
NSQ_SOURCE_LINE 00005334 "=item B<option_send> - send TELNET option negotiation request"
NSQ_SOURCE_LINE 00005335 ""
NSQ_SOURCE_LINE 00005336 "    $ok = $obj->option_send([Do    => $telopt,]"
NSQ_SOURCE_LINE 00005337 "                            [Dont  => $telopt,]"
NSQ_SOURCE_LINE 00005338 "                            [Will  => $telopt,]"
NSQ_SOURCE_LINE 00005339 "                            [Wont  => $telopt,]"
NSQ_SOURCE_LINE 00005340 "                            [Async => $boolean,]);"
NSQ_SOURCE_LINE 00005341 ""
NSQ_SOURCE_LINE 00005342 "This method is not yet implemented.  Look for it in a future version."
NSQ_SOURCE_LINE 00005343 ""
NSQ_SOURCE_LINE 00005344 "=back"
NSQ_SOURCE_LINE 00005345 ""
NSQ_SOURCE_LINE 00005346 ""
NSQ_SOURCE_LINE 00005347 "=over 4"
NSQ_SOURCE_LINE 00005348 ""
NSQ_SOURCE_LINE 00005349 "=item B<option_state> - get current state of a TELNET option"
NSQ_SOURCE_LINE 00005350 ""
NSQ_SOURCE_LINE 00005351 "    $hashref = $obj->option_state($telopt);"
NSQ_SOURCE_LINE 00005352 ""
NSQ_SOURCE_LINE 00005353 "This method returns a hashref containing a copy of the current state"
NSQ_SOURCE_LINE 00005354 "of TELNET option I<$telopt>."
NSQ_SOURCE_LINE 00005355 ""
NSQ_SOURCE_LINE 00005356 "Here are the values returned in the hash:"
NSQ_SOURCE_LINE 00005357 ""
NSQ_SOURCE_LINE 00005358 "=over 4"
NSQ_SOURCE_LINE 00005359 ""
NSQ_SOURCE_LINE 00005360 "=item"
NSQ_SOURCE_LINE 00005361 ""
NSQ_SOURCE_LINE 00005362 "I<$hashref>->{remote_enabled}"
NSQ_SOURCE_LINE 00005363 ""
NSQ_SOURCE_LINE 00005364 "=over 4"
NSQ_SOURCE_LINE 00005365 ""
NSQ_SOURCE_LINE 00005366 "=item"
NSQ_SOURCE_LINE 00005367 ""
NSQ_SOURCE_LINE 00005368 "boolean that indicates if the option is enabled on the remote side."
NSQ_SOURCE_LINE 00005369 ""
NSQ_SOURCE_LINE 00005370 "=back"
NSQ_SOURCE_LINE 00005371 ""
NSQ_SOURCE_LINE 00005372 "=item"
NSQ_SOURCE_LINE 00005373 ""
NSQ_SOURCE_LINE 00005374 "I<$hashref>->{remote_enable_ok}"
NSQ_SOURCE_LINE 00005375 ""
NSQ_SOURCE_LINE 00005376 "=over 4"
NSQ_SOURCE_LINE 00005377 ""
NSQ_SOURCE_LINE 00005378 "=item"
NSQ_SOURCE_LINE 00005379 ""
NSQ_SOURCE_LINE 00005380 "boolean that indicates if it's ok to accept an offer to enable this"
NSQ_SOURCE_LINE 00005381 "option on the remote side."
NSQ_SOURCE_LINE 00005382 ""
NSQ_SOURCE_LINE 00005383 "=back"
NSQ_SOURCE_LINE 00005384 ""
NSQ_SOURCE_LINE 00005385 "=item"
NSQ_SOURCE_LINE 00005386 ""
NSQ_SOURCE_LINE 00005387 "I<$hashref>->{remote_state}"
NSQ_SOURCE_LINE 00005388 ""
NSQ_SOURCE_LINE 00005389 "=over 4"
NSQ_SOURCE_LINE 00005390 ""
NSQ_SOURCE_LINE 00005391 "=item"
NSQ_SOURCE_LINE 00005392 ""
NSQ_SOURCE_LINE 00005393 "string used to hold the internal state of option negotiation for this"
NSQ_SOURCE_LINE 00005394 "option on the remote side."
NSQ_SOURCE_LINE 00005395 ""
NSQ_SOURCE_LINE 00005396 "=back"
NSQ_SOURCE_LINE 00005397 ""
NSQ_SOURCE_LINE 00005398 "=item"
NSQ_SOURCE_LINE 00005399 ""
NSQ_SOURCE_LINE 00005400 "I<$hashref>->{local_enabled}"
NSQ_SOURCE_LINE 00005401 ""
NSQ_SOURCE_LINE 00005402 "=over 4"
NSQ_SOURCE_LINE 00005403 ""
NSQ_SOURCE_LINE 00005404 "=item"
NSQ_SOURCE_LINE 00005405 ""
NSQ_SOURCE_LINE 00005406 "boolean that indicates if the option is enabled on the local side."
NSQ_SOURCE_LINE 00005407 ""
NSQ_SOURCE_LINE 00005408 "=back"
NSQ_SOURCE_LINE 00005409 ""
NSQ_SOURCE_LINE 00005410 "=item"
NSQ_SOURCE_LINE 00005411 ""
NSQ_SOURCE_LINE 00005412 "I<$hashref>->{local_enable_ok}"
NSQ_SOURCE_LINE 00005413 ""
NSQ_SOURCE_LINE 00005414 "=over 4"
NSQ_SOURCE_LINE 00005415 ""
NSQ_SOURCE_LINE 00005416 "=item"
NSQ_SOURCE_LINE 00005417 ""
NSQ_SOURCE_LINE 00005418 "boolean that indicates if it's ok to accept an offer to enable this"
NSQ_SOURCE_LINE 00005419 "option on the local side."
NSQ_SOURCE_LINE 00005420 ""
NSQ_SOURCE_LINE 00005421 "=back"
NSQ_SOURCE_LINE 00005422 ""
NSQ_SOURCE_LINE 00005423 "=item"
NSQ_SOURCE_LINE 00005424 ""
NSQ_SOURCE_LINE 00005425 "I<$hashref>->{local_state}"
NSQ_SOURCE_LINE 00005426 ""
NSQ_SOURCE_LINE 00005427 "=over 4"
NSQ_SOURCE_LINE 00005428 ""
NSQ_SOURCE_LINE 00005429 "=item"
NSQ_SOURCE_LINE 00005430 ""
NSQ_SOURCE_LINE 00005431 "string used to hold the internal state of option negotiation for this"
NSQ_SOURCE_LINE 00005432 "option on the local side."
NSQ_SOURCE_LINE 00005433 ""
NSQ_SOURCE_LINE 00005434 "=back"
NSQ_SOURCE_LINE 00005435 ""
NSQ_SOURCE_LINE 00005436 "=back"
NSQ_SOURCE_LINE 00005437 ""
NSQ_SOURCE_LINE 00005438 "=back"
NSQ_SOURCE_LINE 00005439 ""
NSQ_SOURCE_LINE 00005440 ""
NSQ_SOURCE_LINE 00005441 "=over 4"
NSQ_SOURCE_LINE 00005442 ""
NSQ_SOURCE_LINE 00005443 "=item B<ors> - output line delimiter"
NSQ_SOURCE_LINE 00005444 ""
NSQ_SOURCE_LINE 00005445 "    $chars = $obj->ors;"
NSQ_SOURCE_LINE 00005446 ""
NSQ_SOURCE_LINE 00005447 "    $prev = $obj->ors($chars);"
NSQ_SOURCE_LINE 00005448 ""
NSQ_SOURCE_LINE 00005449 "This method is synonymous with C<output_record_separator()>."
NSQ_SOURCE_LINE 00005450 ""
NSQ_SOURCE_LINE 00005451 "=back"
NSQ_SOURCE_LINE 00005452 ""
NSQ_SOURCE_LINE 00005453 ""
NSQ_SOURCE_LINE 00005454 "=over 4"
NSQ_SOURCE_LINE 00005455 ""
NSQ_SOURCE_LINE 00005456 "=item B<output_field_separator> - field separator for print"
NSQ_SOURCE_LINE 00005457 ""
NSQ_SOURCE_LINE 00005458 "    $chars = $obj->output_field_separator;"
NSQ_SOURCE_LINE 00005459 ""
NSQ_SOURCE_LINE 00005460 "    $prev = $obj->output_field_separator($chars);"
NSQ_SOURCE_LINE 00005461 ""
NSQ_SOURCE_LINE 00005462 "This method designates the output field separator for C<print()>."
NSQ_SOURCE_LINE 00005463 "Ordinarily the print method simply prints out the comma separated"
NSQ_SOURCE_LINE 00005464 "fields you specify.  Set this to specify what's printed between"
NSQ_SOURCE_LINE 00005465 "fields."
NSQ_SOURCE_LINE 00005466 ""
NSQ_SOURCE_LINE 00005467 "With no argument this method returns the current output field"
NSQ_SOURCE_LINE 00005468 "separator set in the object.  With an argument it sets the output"
NSQ_SOURCE_LINE 00005469 "field separator to I<$chars> and returns the previous value."
NSQ_SOURCE_LINE 00005470 ""
NSQ_SOURCE_LINE 00005471 "By default it's set to an empty string."
NSQ_SOURCE_LINE 00005472 ""
NSQ_SOURCE_LINE 00005473 "=back"
NSQ_SOURCE_LINE 00005474 ""
NSQ_SOURCE_LINE 00005475 ""
NSQ_SOURCE_LINE 00005476 "=over 4"
NSQ_SOURCE_LINE 00005477 ""
NSQ_SOURCE_LINE 00005478 "=item B<output_log> - log all output"
NSQ_SOURCE_LINE 00005479 ""
NSQ_SOURCE_LINE 00005480 "    $fh = $obj->output_log;"
NSQ_SOURCE_LINE 00005481 ""
NSQ_SOURCE_LINE 00005482 "    $fh = $obj->output_log($fh);"
NSQ_SOURCE_LINE 00005483 ""
NSQ_SOURCE_LINE 00005484 "    $fh = $obj->output_log($tiefh);"
NSQ_SOURCE_LINE 00005485 ""
NSQ_SOURCE_LINE 00005486 "    $fh = $obj->output_log($filename);"
NSQ_SOURCE_LINE 00005487 ""
NSQ_SOURCE_LINE 00005488 "This method starts or stops logging of output.  This is useful when"
NSQ_SOURCE_LINE 00005489 "debugging.  Also see C<dump_log()>.  Because most command interpreters"
NSQ_SOURCE_LINE 00005490 "echo back commands received, it's likely all your output would also be"
NSQ_SOURCE_LINE 00005491 "in an input log.  See C<input_log()>.  Note that output logging occurs"
NSQ_SOURCE_LINE 00005492 "before newline translation.  See C<binmode()> for details on newline"
NSQ_SOURCE_LINE 00005493 "translation."
NSQ_SOURCE_LINE 00005494 ""
NSQ_SOURCE_LINE 00005495 "If no argument is given, the log filehandle is returned.  A returned"
NSQ_SOURCE_LINE 00005496 "empty string indicates logging is off."
NSQ_SOURCE_LINE 00005497 ""
NSQ_SOURCE_LINE 00005498 "To stop logging, use an empty string as an argument.  The stopped"
NSQ_SOURCE_LINE 00005499 "filehandle is not closed."
NSQ_SOURCE_LINE 00005500 ""
NSQ_SOURCE_LINE 00005501 "If an open filehandle is given, it is used for logging and returned."
NSQ_SOURCE_LINE 00005502 "Otherwise, the argument is assumed to be the name of a file, the"
NSQ_SOURCE_LINE 00005503 "filename is opened for logging and a filehandle to it is returned.  If"
NSQ_SOURCE_LINE 00005504 "the filehandle is not already opened or the filename can't be opened"
NSQ_SOURCE_LINE 00005505 "for writing, the error mode action is performed.  The filehandle can"
NSQ_SOURCE_LINE 00005506 "be a tied filehandle."
NSQ_SOURCE_LINE 00005507 ""
NSQ_SOURCE_LINE 00005508 "=back"
NSQ_SOURCE_LINE 00005509 ""
NSQ_SOURCE_LINE 00005510 ""
NSQ_SOURCE_LINE 00005511 "=over 4"
NSQ_SOURCE_LINE 00005512 ""
NSQ_SOURCE_LINE 00005513 "=item B<output_record_separator> - output line delimiter"
NSQ_SOURCE_LINE 00005514 ""
NSQ_SOURCE_LINE 00005515 "    $chars = $obj->output_record_separator;"
NSQ_SOURCE_LINE 00005516 ""
NSQ_SOURCE_LINE 00005517 "    $prev = $obj->output_record_separator($chars);"
NSQ_SOURCE_LINE 00005518 ""
NSQ_SOURCE_LINE 00005519 "This method designates the output line delimiter for C<print()> and"
NSQ_SOURCE_LINE 00005520 "C<cmd()>.  Set this to specify what's printed at the end of C<print()>"
NSQ_SOURCE_LINE 00005521 "and C<cmd()>."
NSQ_SOURCE_LINE 00005522 ""
NSQ_SOURCE_LINE 00005523 "The output record separator is set to C<\"\\n\"> by default, so there's"
NSQ_SOURCE_LINE 00005524 "no need to append all your commands with a newline.  To avoid printing"
NSQ_SOURCE_LINE 00005525 "the output_record_separator use C<put()> or set the"
NSQ_SOURCE_LINE 00005526 "output_record_separator to an empty string."
NSQ_SOURCE_LINE 00005527 ""
NSQ_SOURCE_LINE 00005528 "With no argument this method returns the current output record"
NSQ_SOURCE_LINE 00005529 "separator set in the object.  With an argument it sets the output"
NSQ_SOURCE_LINE 00005530 "record separator to I<$chars> and returns the previous value."
NSQ_SOURCE_LINE 00005531 ""
NSQ_SOURCE_LINE 00005532 "=back"
NSQ_SOURCE_LINE 00005533 ""
NSQ_SOURCE_LINE 00005534 ""
NSQ_SOURCE_LINE 00005535 "=over 4"
NSQ_SOURCE_LINE 00005536 ""
NSQ_SOURCE_LINE 00005537 "=item B<peerhost> - IP address of the other end of the socket connection"
NSQ_SOURCE_LINE 00005538 ""
NSQ_SOURCE_LINE 00005539 "    $ipaddr = $obj->peerhost;"
NSQ_SOURCE_LINE 00005540 ""
NSQ_SOURCE_LINE 00005541 "This method returns a string which is the IPv4 or IPv6 address the"
NSQ_SOURCE_LINE 00005542 "remote socket is bound to (i.e. it is the IP address of C<host()>)."
NSQ_SOURCE_LINE 00005543 "It returns C<\"\"> when not connected."
NSQ_SOURCE_LINE 00005544 ""
NSQ_SOURCE_LINE 00005545 "=back"
NSQ_SOURCE_LINE 00005546 ""
NSQ_SOURCE_LINE 00005547 ""
NSQ_SOURCE_LINE 00005548 "=over 4"
NSQ_SOURCE_LINE 00005549 ""
NSQ_SOURCE_LINE 00005550 "=item B<peerport> - TCP port of the other end of the socket connection"
NSQ_SOURCE_LINE 00005551 ""
NSQ_SOURCE_LINE 00005552 "    $port = $obj->peerport;"
NSQ_SOURCE_LINE 00005553 ""
NSQ_SOURCE_LINE 00005554 "This method returns the port number which the remote socket is bound"
NSQ_SOURCE_LINE 00005555 "to.  It is the same as the C<port()> number when connected.  It"
NSQ_SOURCE_LINE 00005556 "returns C<\"\"> when not connected."
NSQ_SOURCE_LINE 00005557 ""
NSQ_SOURCE_LINE 00005558 "=back"
NSQ_SOURCE_LINE 00005559 ""
NSQ_SOURCE_LINE 00005560 ""
NSQ_SOURCE_LINE 00005561 "=over 4"
NSQ_SOURCE_LINE 00005562 ""
NSQ_SOURCE_LINE 00005563 "=item B<port> - remote port"
NSQ_SOURCE_LINE 00005564 ""
NSQ_SOURCE_LINE 00005565 "    $port = $obj->port;"
NSQ_SOURCE_LINE 00005566 ""
NSQ_SOURCE_LINE 00005567 "    $prev = $obj->port($port);"
NSQ_SOURCE_LINE 00005568 ""
NSQ_SOURCE_LINE 00005569 "This method designates the remote TCP port for C<open()>.  With no"
NSQ_SOURCE_LINE 00005570 "argument this method returns the current port number.  With an"
NSQ_SOURCE_LINE 00005571 "argument it sets the current port number to I<$port> and returns the"
NSQ_SOURCE_LINE 00005572 "previous port.  If I<$port> is a TCP service name, then it's first"
NSQ_SOURCE_LINE 00005573 "converted to a port number using the perl function C<getservbyname()>."
NSQ_SOURCE_LINE 00005574 ""
NSQ_SOURCE_LINE 00005575 "The default value is C<23>."
NSQ_SOURCE_LINE 00005576 ""
NSQ_SOURCE_LINE 00005577 "The error mode action is performed when attempting to set this"
NSQ_SOURCE_LINE 00005578 "attribute to something that is not a positive integer or a valid TCP"
NSQ_SOURCE_LINE 00005579 "service name."
NSQ_SOURCE_LINE 00005580 ""
NSQ_SOURCE_LINE 00005581 "=back"
NSQ_SOURCE_LINE 00005582 ""
NSQ_SOURCE_LINE 00005583 ""
NSQ_SOURCE_LINE 00005584 "=over 4"
NSQ_SOURCE_LINE 00005585 ""
NSQ_SOURCE_LINE 00005586 "=item B<print> - write to object"
NSQ_SOURCE_LINE 00005587 ""
NSQ_SOURCE_LINE 00005588 "    $ok = $obj->print(@list);"
NSQ_SOURCE_LINE 00005589 ""
NSQ_SOURCE_LINE 00005590 "This method writes I<@list> followed by the I<output_record_separator>"
NSQ_SOURCE_LINE 00005591 "to the open object and returns C<1> if all data was successfully"
NSQ_SOURCE_LINE 00005592 "written.  On time-out or other failures, the error mode action is"
NSQ_SOURCE_LINE 00005593 "performed.  See C<errmode()>."
NSQ_SOURCE_LINE 00005594 ""
NSQ_SOURCE_LINE 00005595 "By default, the C<output_record_separator()> is set to C<\"\\n\"> so all"
NSQ_SOURCE_LINE 00005596 "your commands automatically end with a newline.  In most cases your"
NSQ_SOURCE_LINE 00005597 "output is being read by a command interpreter which won't accept a"
NSQ_SOURCE_LINE 00005598 "command until newline is read.  This is similar to someone typing a"
NSQ_SOURCE_LINE 00005599 "command and hitting the return key.  To avoid printing a trailing"
NSQ_SOURCE_LINE 00005600 "C<\"\\n\"> use C<put()> instead or set the output_record_separator to an"
NSQ_SOURCE_LINE 00005601 "empty string."
NSQ_SOURCE_LINE 00005602 ""
NSQ_SOURCE_LINE 00005603 "On failure, it's possible that some data was written.  If you choose"
NSQ_SOURCE_LINE 00005604 "to try and recover from a print timing-out, use C<print_length()> to"
NSQ_SOURCE_LINE 00005605 "determine how much was written before the error occurred."
NSQ_SOURCE_LINE 00005606 ""
NSQ_SOURCE_LINE 00005607 "You may also use the output field separator to print a string between"
NSQ_SOURCE_LINE 00005608 "the list elements.  See C<output_field_separator()>."
NSQ_SOURCE_LINE 00005609 ""
NSQ_SOURCE_LINE 00005610 "=back"
NSQ_SOURCE_LINE 00005611 ""
NSQ_SOURCE_LINE 00005612 ""
NSQ_SOURCE_LINE 00005613 "=over 4"
NSQ_SOURCE_LINE 00005614 ""
NSQ_SOURCE_LINE 00005615 "=item B<print_length> - number of bytes written by print"
NSQ_SOURCE_LINE 00005616 ""
NSQ_SOURCE_LINE 00005617 "    $num = $obj->print_length;"
NSQ_SOURCE_LINE 00005618 ""
NSQ_SOURCE_LINE 00005619 "This returns the number of bytes successfully written by the most"
NSQ_SOURCE_LINE 00005620 "recent C<print()> or C<put()>."
NSQ_SOURCE_LINE 00005621 ""
NSQ_SOURCE_LINE 00005622 "=back"
NSQ_SOURCE_LINE 00005623 ""
NSQ_SOURCE_LINE 00005624 ""
NSQ_SOURCE_LINE 00005625 "=over 4"
NSQ_SOURCE_LINE 00005626 ""
NSQ_SOURCE_LINE 00005627 "=item B<prompt> - pattern to match a prompt"
NSQ_SOURCE_LINE 00005628 ""
NSQ_SOURCE_LINE 00005629 "    $matchop = $obj->prompt;"
NSQ_SOURCE_LINE 00005630 ""
NSQ_SOURCE_LINE 00005631 "    $prev = $obj->prompt($matchop);"
NSQ_SOURCE_LINE 00005632 ""
NSQ_SOURCE_LINE 00005633 "This method sets the pattern used to find a prompt in the input"
NSQ_SOURCE_LINE 00005634 "stream.  It must be a string representing a valid perl pattern match"
NSQ_SOURCE_LINE 00005635 "operator.  The methods C<login()> and C<cmd()> try to read until"
NSQ_SOURCE_LINE 00005636 "matching the prompt.  They will fail with a time-out error if the"
NSQ_SOURCE_LINE 00005637 "pattern you've chosen doesn't match what the remote side sends."
NSQ_SOURCE_LINE 00005638 ""
NSQ_SOURCE_LINE 00005639 "With no argument this method returns the prompt set in the object."
NSQ_SOURCE_LINE 00005640 "With an argument it sets the prompt to I<$matchop> and returns the"
NSQ_SOURCE_LINE 00005641 "previous value."
NSQ_SOURCE_LINE 00005642 ""
NSQ_SOURCE_LINE 00005643 "The default prompt is C<'/[\\$%#E<gt>] $/'>"
NSQ_SOURCE_LINE 00005644 ""
NSQ_SOURCE_LINE 00005645 "Always use single quotes, instead of double quotes, to construct"
NSQ_SOURCE_LINE 00005646 "I<$matchop> (e.g. C<'/bash\\$ $/'>).  If you're constructing a DOS like"
NSQ_SOURCE_LINE 00005647 "file path, you'll need to use four backslashes to represent one"
NSQ_SOURCE_LINE 00005648 "(e.g. C<'/c:\\\\\\\\users\\\\\\\\billE<gt>$/i'>)."
NSQ_SOURCE_LINE 00005649 ""
NSQ_SOURCE_LINE 00005650 "Of course don't forget about regexp metacharacters like C<.>, C<[>, or"
NSQ_SOURCE_LINE 00005651 "C<$>.  You'll only need a single backslash to quote them.  The anchor"
NSQ_SOURCE_LINE 00005652 "metacharacters C<^> and C<$> refer to positions in the input buffer."
NSQ_SOURCE_LINE 00005653 ""
NSQ_SOURCE_LINE 00005654 "The error mode action is performed when attempting to set this"
NSQ_SOURCE_LINE 00005655 "attribute with a match operator missing its opening delimiter."
NSQ_SOURCE_LINE 00005656 ""
NSQ_SOURCE_LINE 00005657 "=back"
NSQ_SOURCE_LINE 00005658 ""
NSQ_SOURCE_LINE 00005659 ""
NSQ_SOURCE_LINE 00005660 "=over 4"
NSQ_SOURCE_LINE 00005661 ""
NSQ_SOURCE_LINE 00005662 "=item B<put> - write to object"
NSQ_SOURCE_LINE 00005663 ""
NSQ_SOURCE_LINE 00005664 "    $ok = $obj->put($string);"
NSQ_SOURCE_LINE 00005665 ""
NSQ_SOURCE_LINE 00005666 "    $ok = $obj->put(String      => $string,"
NSQ_SOURCE_LINE 00005667 "                    [Binmode    => $mode,]"
NSQ_SOURCE_LINE 00005668 "                    [Errmode    => $errmode,]"
NSQ_SOURCE_LINE 00005669 "                    [Telnetmode => $mode,]"
NSQ_SOURCE_LINE 00005670 "                    [Timeout    => $secs,]);"
NSQ_SOURCE_LINE 00005671 ""
NSQ_SOURCE_LINE 00005672 "This method writes I<$string> to the opened object and returns C<1> if"
NSQ_SOURCE_LINE 00005673 "all data was successfully written.  This method is like C<print()>"
NSQ_SOURCE_LINE 00005674 "except that it doesn't write the trailing output_record_separator"
NSQ_SOURCE_LINE 00005675 "(\"\\n\" by default).  On time-out or other failures, the error mode"
NSQ_SOURCE_LINE 00005676 "action is performed.  See C<errmode()>."
NSQ_SOURCE_LINE 00005677 ""
NSQ_SOURCE_LINE 00005678 "On failure, it's possible that some data was written.  If you choose"
NSQ_SOURCE_LINE 00005679 "to try and recover from a put timing-out, use C<print_length()> to"
NSQ_SOURCE_LINE 00005680 "determine how much was written before the error occurred."
NSQ_SOURCE_LINE 00005681 ""
NSQ_SOURCE_LINE 00005682 "Optional named parameters are provided to override the current"
NSQ_SOURCE_LINE 00005683 "settings of binmode, errmode, telnetmode, and timeout."
NSQ_SOURCE_LINE 00005684 ""
NSQ_SOURCE_LINE 00005685 "=back"
NSQ_SOURCE_LINE 00005686 ""
NSQ_SOURCE_LINE 00005687 ""
NSQ_SOURCE_LINE 00005688 "=over 4"
NSQ_SOURCE_LINE 00005689 ""
NSQ_SOURCE_LINE 00005690 "=item B<rs> - input line delimiter"
NSQ_SOURCE_LINE 00005691 ""
NSQ_SOURCE_LINE 00005692 "    $chars = $obj->rs;"
NSQ_SOURCE_LINE 00005693 ""
NSQ_SOURCE_LINE 00005694 "    $prev = $obj->rs($chars);"
NSQ_SOURCE_LINE 00005695 ""
NSQ_SOURCE_LINE 00005696 "This method is synonymous with C<input_record_separator()>."
NSQ_SOURCE_LINE 00005697 ""
NSQ_SOURCE_LINE 00005698 "=back"
NSQ_SOURCE_LINE 00005699 ""
NSQ_SOURCE_LINE 00005700 ""
NSQ_SOURCE_LINE 00005701 "=over 4"
NSQ_SOURCE_LINE 00005702 ""
NSQ_SOURCE_LINE 00005703 "=item B<sockfamily> - IP address family of connected local socket"
NSQ_SOURCE_LINE 00005704 ""
NSQ_SOURCE_LINE 00005705 "    $sockfamily = $obj->sockfamily;"
NSQ_SOURCE_LINE 00005706 ""
NSQ_SOURCE_LINE 00005707 "This method returns which IP address family C<open()> used to"
NSQ_SOURCE_LINE 00005708 "successfully connect.  It is most useful when the requested address"
NSQ_SOURCE_LINE 00005709 "C<family()> for C<open()> was C<\"any\">.  Values returned may be"
NSQ_SOURCE_LINE 00005710 "C<\"ipv4\">, C<\"ipv6\">, or C<\"\"> (when not connected)."
NSQ_SOURCE_LINE 00005711 ""
NSQ_SOURCE_LINE 00005712 "=back"
NSQ_SOURCE_LINE 00005713 ""
NSQ_SOURCE_LINE 00005714 ""
NSQ_SOURCE_LINE 00005715 "=over 4"
NSQ_SOURCE_LINE 00005716 ""
NSQ_SOURCE_LINE 00005717 "=item B<sockhost> - IP address of this end of the socket connection"
NSQ_SOURCE_LINE 00005718 ""
NSQ_SOURCE_LINE 00005719 "    $ipaddr = $obj->sockhost;"
NSQ_SOURCE_LINE 00005720 ""
NSQ_SOURCE_LINE 00005721 "This method returns a string which is the IPv4 or IPv6 address the"
NSQ_SOURCE_LINE 00005722 "local socket is bound to.  It returns C<\"\"> when not connected."
NSQ_SOURCE_LINE 00005723 ""
NSQ_SOURCE_LINE 00005724 "=back"
NSQ_SOURCE_LINE 00005725 ""
NSQ_SOURCE_LINE 00005726 ""
NSQ_SOURCE_LINE 00005727 "=over 4"
NSQ_SOURCE_LINE 00005728 ""
NSQ_SOURCE_LINE 00005729 "=item B<sockport> - TCP port of this end of the socket connection"
NSQ_SOURCE_LINE 00005730 ""
NSQ_SOURCE_LINE 00005731 "    $port = $obj->sockport;"
NSQ_SOURCE_LINE 00005732 ""
NSQ_SOURCE_LINE 00005733 "This method returns the port number which the local socket is bound"
NSQ_SOURCE_LINE 00005734 "to.  It returns C<\"\"> when not connected."
NSQ_SOURCE_LINE 00005735 ""
NSQ_SOURCE_LINE 00005736 "=back"
NSQ_SOURCE_LINE 00005737 ""
NSQ_SOURCE_LINE 00005738 ""
NSQ_SOURCE_LINE 00005739 "=over 4"
NSQ_SOURCE_LINE 00005740 ""
NSQ_SOURCE_LINE 00005741 "=item B<telnetmode> - turn off/on telnet command interpretation"
NSQ_SOURCE_LINE 00005742 ""
NSQ_SOURCE_LINE 00005743 "    $mode = $obj->telnetmode;"
NSQ_SOURCE_LINE 00005744 ""
NSQ_SOURCE_LINE 00005745 "    $prev = $obj->telnetmode($mode);"
NSQ_SOURCE_LINE 00005746 ""
NSQ_SOURCE_LINE 00005747 "This method controls whether or not TELNET commands in the data stream"
NSQ_SOURCE_LINE 00005748 "are recognized and handled.  The TELNET protocol uses certain"
NSQ_SOURCE_LINE 00005749 "character sequences sent in the data stream to control the session."
NSQ_SOURCE_LINE 00005750 "If the port you're connecting to isn't using the TELNET protocol, then"
NSQ_SOURCE_LINE 00005751 "you should turn this mode off.  The default is I<on>."
NSQ_SOURCE_LINE 00005752 ""
NSQ_SOURCE_LINE 00005753 "If no argument is given, the current mode is returned."
NSQ_SOURCE_LINE 00005754 ""
NSQ_SOURCE_LINE 00005755 "If I<$mode> is C<0> then telnet mode is off.  If I<$mode> is C<1> then"
NSQ_SOURCE_LINE 00005756 "telnet mode is on."
NSQ_SOURCE_LINE 00005757 ""
NSQ_SOURCE_LINE 00005758 "=back"
NSQ_SOURCE_LINE 00005759 ""
NSQ_SOURCE_LINE 00005760 ""
NSQ_SOURCE_LINE 00005761 "=over 4"
NSQ_SOURCE_LINE 00005762 ""
NSQ_SOURCE_LINE 00005763 "=item B<timed_out> - time-out indicator"
NSQ_SOURCE_LINE 00005764 ""
NSQ_SOURCE_LINE 00005765 "    $boolean = $obj->timed_out;"
NSQ_SOURCE_LINE 00005766 ""
NSQ_SOURCE_LINE 00005767 "    $prev = $obj->timed_out($boolean);"
NSQ_SOURCE_LINE 00005768 ""
NSQ_SOURCE_LINE 00005769 "This method indicates if a previous read, write, or open method"
NSQ_SOURCE_LINE 00005770 "timed-out.  Remember that timing-out is itself an error.  To be able"
NSQ_SOURCE_LINE 00005771 "to invoke C<timed_out()> after a time-out error, you'd have to change"
NSQ_SOURCE_LINE 00005772 "the default error mode to something other than C<\"die\">.  See"
NSQ_SOURCE_LINE 00005773 "C<errmode()>."
NSQ_SOURCE_LINE 00005774 ""
NSQ_SOURCE_LINE 00005775 "With no argument this method returns C<1> if the previous method"
NSQ_SOURCE_LINE 00005776 "timed-out.  With an argument it sets the indicator.  Normally, only"
NSQ_SOURCE_LINE 00005777 "internal methods set this indicator."
NSQ_SOURCE_LINE 00005778 ""
NSQ_SOURCE_LINE 00005779 "=back"
NSQ_SOURCE_LINE 00005780 ""
NSQ_SOURCE_LINE 00005781 ""
NSQ_SOURCE_LINE 00005782 "=over 4"
NSQ_SOURCE_LINE 00005783 ""
NSQ_SOURCE_LINE 00005784 "=item B<timeout> - I/O time-out interval"
NSQ_SOURCE_LINE 00005785 ""
NSQ_SOURCE_LINE 00005786 "    $secs = $obj->timeout;"
NSQ_SOURCE_LINE 00005787 ""
NSQ_SOURCE_LINE 00005788 "    $prev = $obj->timeout($secs);"
NSQ_SOURCE_LINE 00005789 ""
NSQ_SOURCE_LINE 00005790 "This method sets the timeout interval used when performing I/O"
NSQ_SOURCE_LINE 00005791 "or connecting to a port.  When a method doesn't complete within the"
NSQ_SOURCE_LINE 00005792 "timeout interval then it's an error and the error mode action is"
NSQ_SOURCE_LINE 00005793 "performed."
NSQ_SOURCE_LINE 00005794 ""
NSQ_SOURCE_LINE 00005795 "A timeout may be expressed as a relative or absolute value.  If"
NSQ_SOURCE_LINE 00005796 "I<$secs> is greater than or equal to the time the program started, as"
NSQ_SOURCE_LINE 00005797 "determined by $^T, then it's an absolute time value for when time-out"
NSQ_SOURCE_LINE 00005798 "occurs.  The perl function C<time()> may be used to obtain an absolute"
NSQ_SOURCE_LINE 00005799 "time value.  For a relative time-out value less than $^T, time-out"
NSQ_SOURCE_LINE 00005800 "happens I<$secs> from when the method begins."
NSQ_SOURCE_LINE 00005801 ""
NSQ_SOURCE_LINE 00005802 "If I<$secs> is C<0> then time-out occurs if the data cannot be"
NSQ_SOURCE_LINE 00005803 "immediately read or written.  Use the undefined value to turn off"
NSQ_SOURCE_LINE 00005804 "timing-out completely."
NSQ_SOURCE_LINE 00005805 ""
NSQ_SOURCE_LINE 00005806 "With no argument this method returns the timeout set in the object."
NSQ_SOURCE_LINE 00005807 "With an argument it sets the timeout to I<$secs> and returns the"
NSQ_SOURCE_LINE 00005808 "previous value.  The default timeout value is C<10> seconds."
NSQ_SOURCE_LINE 00005809 ""
NSQ_SOURCE_LINE 00005810 "A warning is printed to STDERR when attempting to set this attribute"
NSQ_SOURCE_LINE 00005811 "to something that is not an C<undef> or a non-negative integer."
NSQ_SOURCE_LINE 00005812 ""
NSQ_SOURCE_LINE 00005813 "=back"
NSQ_SOURCE_LINE 00005814 ""
NSQ_SOURCE_LINE 00005815 ""
NSQ_SOURCE_LINE 00005816 "=over 4"
NSQ_SOURCE_LINE 00005817 ""
NSQ_SOURCE_LINE 00005818 "=item B<waitfor> - wait for pattern in the input"
NSQ_SOURCE_LINE 00005819 ""
NSQ_SOURCE_LINE 00005820 "    $ok = $obj->waitfor($matchop);"
NSQ_SOURCE_LINE 00005821 "    $ok = $obj->waitfor([Match      => $matchop,]"
NSQ_SOURCE_LINE 00005822 "                        [String     => $string,]"
NSQ_SOURCE_LINE 00005823 "                        [Binmode    => $mode,]"
NSQ_SOURCE_LINE 00005824 "                        [Errmode    => $errmode,]"
NSQ_SOURCE_LINE 00005825 "                        [Telnetmode => $mode,]"
NSQ_SOURCE_LINE 00005826 "                        [Timeout    => $secs,]);"
NSQ_SOURCE_LINE 00005827 ""
NSQ_SOURCE_LINE 00005828 "    ($prematch, $match) = $obj->waitfor($matchop);"
NSQ_SOURCE_LINE 00005829 "    ($prematch, $match) = $obj->waitfor([Match      => $matchop,]"
NSQ_SOURCE_LINE 00005830 "                                        [String     => $string,]"
NSQ_SOURCE_LINE 00005831 "                                        [Binmode    => $mode,]"
NSQ_SOURCE_LINE 00005832 "                                        [Errmode    => $errmode,]"
NSQ_SOURCE_LINE 00005833 "                                        [Telnetmode => $mode,]"
NSQ_SOURCE_LINE 00005834 "                                        [Timeout    => $secs,]);"
NSQ_SOURCE_LINE 00005835 ""
NSQ_SOURCE_LINE 00005836 "This method reads until a pattern match or string is found in the"
NSQ_SOURCE_LINE 00005837 "input stream.  All the characters before and including the match are"
NSQ_SOURCE_LINE 00005838 "removed from the input stream."
NSQ_SOURCE_LINE 00005839 ""
NSQ_SOURCE_LINE 00005840 "In a list context the characters before the match and the matched"
NSQ_SOURCE_LINE 00005841 "characters are returned in I<$prematch> and I<$match>.  In a scalar"
NSQ_SOURCE_LINE 00005842 "context, the matched characters and all characters before it are"
NSQ_SOURCE_LINE 00005843 "discarded and C<1> is returned on success.  On time-out, eof, or other"
NSQ_SOURCE_LINE 00005844 "failures, for both list and scalar context, the error mode action is"
NSQ_SOURCE_LINE 00005845 "performed.  See C<errmode()>."
NSQ_SOURCE_LINE 00005846 ""
NSQ_SOURCE_LINE 00005847 "You can specify more than one pattern or string by simply providing"
NSQ_SOURCE_LINE 00005848 "multiple I<Match> and/or I<String> named parameters.  A I<$matchop>"
NSQ_SOURCE_LINE 00005849 "must be a string representing a valid Perl pattern match operator."
NSQ_SOURCE_LINE 00005850 "The I<$string> is just a substring to find in the input stream."
NSQ_SOURCE_LINE 00005851 ""
NSQ_SOURCE_LINE 00005852 "Use C<dump_log()> to debug when this method keeps timing-out and you"
NSQ_SOURCE_LINE 00005853 "don't think it should."
NSQ_SOURCE_LINE 00005854 ""
NSQ_SOURCE_LINE 00005855 "An optional named parameter is provided to override the current"
NSQ_SOURCE_LINE 00005856 "setting of timeout."
NSQ_SOURCE_LINE 00005857 ""
NSQ_SOURCE_LINE 00005858 "To avoid unexpected backslash interpretation, always use single quotes"
NSQ_SOURCE_LINE 00005859 "instead of double quotes to construct a match operator argument for"
NSQ_SOURCE_LINE 00005860 "C<prompt()> and C<waitfor()> (e.g. C<'/bash\\$ $/'>).  If you're"
NSQ_SOURCE_LINE 00005861 "constructing a DOS like file path, you'll need to use four backslashes"
NSQ_SOURCE_LINE 00005862 "to represent one (e.g. C<'/c:\\\\\\\\users\\\\\\\\billE<gt>$/i'>)."
NSQ_SOURCE_LINE 00005863 ""
NSQ_SOURCE_LINE 00005864 "Of course don't forget about regexp metacharacters like C<.>, C<[>, or"
NSQ_SOURCE_LINE 00005865 "C<$>.  You'll only need a single backslash to quote them.  The anchor"
NSQ_SOURCE_LINE 00005866 "metacharacters C<^> and C<$> refer to positions in the input buffer."
NSQ_SOURCE_LINE 00005867 ""
NSQ_SOURCE_LINE 00005868 "Optional named parameters are provided to override the current"
NSQ_SOURCE_LINE 00005869 "settings of binmode, errmode, telnetmode, and timeout."
NSQ_SOURCE_LINE 00005870 ""
NSQ_SOURCE_LINE 00005871 "=back"
NSQ_SOURCE_LINE 00005872 ""
NSQ_SOURCE_LINE 00005873 ""
NSQ_SOURCE_LINE 00005874 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00005875 ""
NSQ_SOURCE_LINE 00005876 "=over 2"
NSQ_SOURCE_LINE 00005877 ""
NSQ_SOURCE_LINE 00005878 "=item RFC 854"
NSQ_SOURCE_LINE 00005879 ""
NSQ_SOURCE_LINE 00005880 "S<TELNET Protocol Specification>"
NSQ_SOURCE_LINE 00005881 ""
NSQ_SOURCE_LINE 00005882 "S<http://tools.ietf.org/html/rfc854>"
NSQ_SOURCE_LINE 00005883 ""
NSQ_SOURCE_LINE 00005884 "=item RFC 1143"
NSQ_SOURCE_LINE 00005885 ""
NSQ_SOURCE_LINE 00005886 "S<Q Method of Implementing TELNET Option Negotiation>"
NSQ_SOURCE_LINE 00005887 ""
NSQ_SOURCE_LINE 00005888 "S<http://tools.ietf.org/html/rfc1143>"
NSQ_SOURCE_LINE 00005889 ""
NSQ_SOURCE_LINE 00005890 "=item TELNET Option Assignments"
NSQ_SOURCE_LINE 00005891 ""
NSQ_SOURCE_LINE 00005892 "S<http://www.iana.org/assignments/telnet-options>"
NSQ_SOURCE_LINE 00005893 ""
NSQ_SOURCE_LINE 00005894 "=back"
NSQ_SOURCE_LINE 00005895 ""
NSQ_SOURCE_LINE 00005896 ""
NSQ_SOURCE_LINE 00005897 "=head1 EXAMPLES"
NSQ_SOURCE_LINE 00005898 ""
NSQ_SOURCE_LINE 00005899 "Setting C<prompt()> to match a user's shell prompt can be tricky."
NSQ_SOURCE_LINE 00005900 "This example logs in without knowing the shell prompt and then sets it"
NSQ_SOURCE_LINE 00005901 "to match C<prompt()>.  It requires /usr/bin/env and /bin/sh on the"
NSQ_SOURCE_LINE 00005902 "remote host."
NSQ_SOURCE_LINE 00005903 ""
NSQ_SOURCE_LINE 00005904 "    my $host = 'your_destination_host_here';"
NSQ_SOURCE_LINE 00005905 "    my $user = 'your_username_here';"
NSQ_SOURCE_LINE 00005906 "    my $passwd = 'your_password_here';"
NSQ_SOURCE_LINE 00005907 "    my ($t, @output);"
NSQ_SOURCE_LINE 00005908 ""
NSQ_SOURCE_LINE 00005909 "    ## Create a Net::Telnet object."
NSQ_SOURCE_LINE 00005910 "    use Net::Telnet ();"
NSQ_SOURCE_LINE 00005911 "    $t = new Net::Telnet (Timeout  => 10);"
NSQ_SOURCE_LINE 00005912 ""
NSQ_SOURCE_LINE 00005913 "    ## Connect and login."
NSQ_SOURCE_LINE 00005914 "    $t->open($host);"
NSQ_SOURCE_LINE 00005915 ""
NSQ_SOURCE_LINE 00005916 "    $t->waitfor('/login: ?$/i');"
NSQ_SOURCE_LINE 00005917 "    $t->print($user);"
NSQ_SOURCE_LINE 00005918 ""
NSQ_SOURCE_LINE 00005919 "    $t->waitfor('/password: ?$/i');"
NSQ_SOURCE_LINE 00005920 "    $t->print($passwd);"
NSQ_SOURCE_LINE 00005921 ""
NSQ_SOURCE_LINE 00005922 "    ## Switch to a known shell, using a known prompt."
NSQ_SOURCE_LINE 00005923 "    $t->prompt('/<xPROMPTx> $/');"
NSQ_SOURCE_LINE 00005924 "    $t->errmode(\"return\");"
NSQ_SOURCE_LINE 00005925 ""
NSQ_SOURCE_LINE 00005926 "    $t->cmd(\"exec /usr/bin/env 'PS1=<xPROMPTx> ' /bin/sh -i\")"
NSQ_SOURCE_LINE 00005927 "        or die \"login failed to remote host $host\";"
NSQ_SOURCE_LINE 00005928 ""
NSQ_SOURCE_LINE 00005929 "    $t->errmode(\"die\");"
NSQ_SOURCE_LINE 00005930 ""
NSQ_SOURCE_LINE 00005931 "    ## Now you can do cmd() to your heart's content."
NSQ_SOURCE_LINE 00005932 "    @output = $t->cmd(\"uname -a\");"
NSQ_SOURCE_LINE 00005933 "    print @output;"
NSQ_SOURCE_LINE 00005934 ""
NSQ_SOURCE_LINE 00005935 "    exit;"
NSQ_SOURCE_LINE 00005936 ""
NSQ_SOURCE_LINE 00005937 ""
NSQ_SOURCE_LINE 00005938 "Usually you want the remote TERM environment variable to be"
NSQ_SOURCE_LINE 00005939 "set to something like \"dumb\" so you don't read escape"
NSQ_SOURCE_LINE 00005940 "sequences meant to be interpreted by a display terminal.  It"
NSQ_SOURCE_LINE 00005941 "is best to set it via C<cmd()>, or via C<waitfor()> and"
NSQ_SOURCE_LINE 00005942 "C<print()>.  It is also possible to negotiate the terminal"
NSQ_SOURCE_LINE 00005943 "type via telnet.  Here is how to do that."
NSQ_SOURCE_LINE 00005944 ""
NSQ_SOURCE_LINE 00005945 "    ## Module import."
NSQ_SOURCE_LINE 00005946 "    use Net::Telnet qw(TELNET_IAC TELNET_SB TELNET_SE TELOPT_TTYPE);"
NSQ_SOURCE_LINE 00005947 ""
NSQ_SOURCE_LINE 00005948 "    ## Global variables."
NSQ_SOURCE_LINE 00005949 "    my $Term;"
NSQ_SOURCE_LINE 00005950 ""
NSQ_SOURCE_LINE 00005951 "    ## Main program."
NSQ_SOURCE_LINE 00005952 "    {"
NSQ_SOURCE_LINE 00005953 "        my $host = \"your_destination_host_here\";"
NSQ_SOURCE_LINE 00005954 "        my $user = \"your_username_here\";"
NSQ_SOURCE_LINE 00005955 "        my $passwd = \"your_password_here\";"
NSQ_SOURCE_LINE 00005956 "        my $prompt = '/bash\\$ $/';  # your regexp for shell prompt here"
NSQ_SOURCE_LINE 00005957 "        my $t;"
NSQ_SOURCE_LINE 00005958 ""
NSQ_SOURCE_LINE 00005959 "        $t = new Net::Telnet (Prompt => $prompt);"
NSQ_SOURCE_LINE 00005960 ""
NSQ_SOURCE_LINE 00005961 "        ## Set up callbacks to negotiate terminal type."
NSQ_SOURCE_LINE 00005962 "        $t->option_callback(sub {});"
NSQ_SOURCE_LINE 00005963 "        $t->suboption_callback(\\&subopt_callback);"
NSQ_SOURCE_LINE 00005964 "        $t->option_accept(Do => TELOPT_TTYPE);"
NSQ_SOURCE_LINE 00005965 ""
NSQ_SOURCE_LINE 00005966 "        ## Login and print value of TERM."
NSQ_SOURCE_LINE 00005967 "        $Term = \"dumb\";"
NSQ_SOURCE_LINE 00005968 "        $t->open($host);"
NSQ_SOURCE_LINE 00005969 "        $t->login($user, $passwd);"
NSQ_SOURCE_LINE 00005970 "        print $t->cmd('hostname');"
NSQ_SOURCE_LINE 00005971 "        print \"TERM=\", $t->cmd('echo $TERM');"
NSQ_SOURCE_LINE 00005972 "        $t->close;"
NSQ_SOURCE_LINE 00005973 ""
NSQ_SOURCE_LINE 00005974 "        exit;"
NSQ_SOURCE_LINE 00005975 "    } # end main program"
NSQ_SOURCE_LINE 00005976 ""
NSQ_SOURCE_LINE 00005977 "    sub subopt_callback {"
NSQ_SOURCE_LINE 00005978 "        my ($t, $option, $parameters) = @_;"
NSQ_SOURCE_LINE 00005979 "        my $telcmd;"
NSQ_SOURCE_LINE 00005980 ""
NSQ_SOURCE_LINE 00005981 "        if ($option == TELOPT_TTYPE) {"
NSQ_SOURCE_LINE 00005982 "            $telcmd = pack(\"C4 A* C2\", TELNET_IAC, TELNET_SB, TELOPT_TTYPE, 0,"
NSQ_SOURCE_LINE 00005983 "                           $Term, TELNET_IAC, TELNET_SE);"
NSQ_SOURCE_LINE 00005984 "            $t->put(String => $telcmd,"
NSQ_SOURCE_LINE 00005985 "                    Telnetmode => 0);"
NSQ_SOURCE_LINE 00005986 "        }"
NSQ_SOURCE_LINE 00005987 ""
NSQ_SOURCE_LINE 00005988 "        1;"
NSQ_SOURCE_LINE 00005989 "    } # end sub subopt_callback"
NSQ_SOURCE_LINE 00005990 ""
NSQ_SOURCE_LINE 00005991 ""
NSQ_SOURCE_LINE 00005992 "You can also use Net::Telnet to interact with local programs.  This"
NSQ_SOURCE_LINE 00005993 "example changes a user's login password.  It introduces the C<spawn()>"
NSQ_SOURCE_LINE 00005994 "subroutine to start a program and associate a filehandle with its"
NSQ_SOURCE_LINE 00005995 "standard I/O.  Because the passwd program always prompts for passwords"
NSQ_SOURCE_LINE 00005996 "on its controlling terminal, the IO::Pty module is used to create a"
NSQ_SOURCE_LINE 00005997 "new pseudo terminal for use by passwd.  The Net::Telnet object reads"
NSQ_SOURCE_LINE 00005998 "and writes to that pseudo terminal.  To use the code below, substitute"
NSQ_SOURCE_LINE 00005999 "\"changeme\" with the actual old and new passwords."
NSQ_SOURCE_LINE 00006000 ""
NSQ_SOURCE_LINE 00006001 "## Main program."
NSQ_SOURCE_LINE 00006002 "{"
NSQ_SOURCE_LINE 00006003 "    my ($pty, $passwd);"
NSQ_SOURCE_LINE 00006004 "    my $oldpw = \"changeme\";"
NSQ_SOURCE_LINE 00006005 "    my $newpw = \"changeme\";"
NSQ_SOURCE_LINE 00006006 ""
NSQ_SOURCE_LINE 00006007 "    ## Start passwd program."
NSQ_SOURCE_LINE 00006008 "    $pty = spawn(\"passwd\");"
NSQ_SOURCE_LINE 00006009 ""
NSQ_SOURCE_LINE 00006010 "    ## Create a Net::Telnet object to perform I/O on passwd's tty."
NSQ_SOURCE_LINE 00006011 "    use Net::Telnet;"
NSQ_SOURCE_LINE 00006012 "    $passwd = new Net::Telnet (-fhopen => $pty,"
NSQ_SOURCE_LINE 00006013 "                               -timeout => 2,"
NSQ_SOURCE_LINE 00006014 "                               -output_record_separator => \"\\r\","
NSQ_SOURCE_LINE 00006015 "                               -telnetmode => 0,"
NSQ_SOURCE_LINE 00006016 "                               -cmd_remove_mode => 1);"
NSQ_SOURCE_LINE 00006017 "    $passwd->errmode(\"return\");"
NSQ_SOURCE_LINE 00006018 ""
NSQ_SOURCE_LINE 00006019 "    ## Send existing password."
NSQ_SOURCE_LINE 00006020 "    $passwd->waitfor('/password: ?$/i')"
NSQ_SOURCE_LINE 00006021 "        or die \"no old password prompt: \", $passwd->lastline;"
NSQ_SOURCE_LINE 00006022 "    $passwd->print($oldpw);"
NSQ_SOURCE_LINE 00006023 ""
NSQ_SOURCE_LINE 00006024 "    ## Send new password."
NSQ_SOURCE_LINE 00006025 "    $passwd->waitfor('/new (\\w+\\s)?password: ?$/i')"
NSQ_SOURCE_LINE 00006026 "        or die \"bad old password: \", $passwd->lastline;"
NSQ_SOURCE_LINE 00006027 "    $passwd->print($newpw);"
NSQ_SOURCE_LINE 00006028 ""
NSQ_SOURCE_LINE 00006029 "    ## Send new password verification."
NSQ_SOURCE_LINE 00006030 "    $passwd->waitfor('/new (\\w+\\s)?password: ?$/i')"
NSQ_SOURCE_LINE 00006031 "        or die \"bad new password: \", $passwd->lastline;"
NSQ_SOURCE_LINE 00006032 "    $passwd->print($newpw);"
NSQ_SOURCE_LINE 00006033 ""
NSQ_SOURCE_LINE 00006034 "    ## Display success or failure."
NSQ_SOURCE_LINE 00006035 "    $passwd->waitfor('/(changed|updated)/')"
NSQ_SOURCE_LINE 00006036 "        or die \"bad new password: \", $passwd->lastline;"
NSQ_SOURCE_LINE 00006037 "    print $passwd->lastline;"
NSQ_SOURCE_LINE 00006038 ""
NSQ_SOURCE_LINE 00006039 "    $passwd->close;"
NSQ_SOURCE_LINE 00006040 "    exit;"
NSQ_SOURCE_LINE 00006041 "} # end main program"
NSQ_SOURCE_LINE 00006042 ""
NSQ_SOURCE_LINE 00006043 "sub spawn {"
NSQ_SOURCE_LINE 00006044 "    my (@cmd) = @_;"
NSQ_SOURCE_LINE 00006045 "    my ($pid, $pty, $tty, $tty_fd);"
NSQ_SOURCE_LINE 00006046 ""
NSQ_SOURCE_LINE 00006047 "    ## Create a new pseudo terminal."
NSQ_SOURCE_LINE 00006048 "    use IO::Pty ();"
NSQ_SOURCE_LINE 00006049 "    $pty = new IO::Pty"
NSQ_SOURCE_LINE 00006050 "        or die $!;"
NSQ_SOURCE_LINE 00006051 ""
NSQ_SOURCE_LINE 00006052 "    ## Execute the program in another process."
NSQ_SOURCE_LINE 00006053 "    unless ($pid = fork) {  # child process"
NSQ_SOURCE_LINE 00006054 "        die \"problem spawning program: $!\\n\" unless defined $pid;"
NSQ_SOURCE_LINE 00006055 ""
NSQ_SOURCE_LINE 00006056 "        ## Disassociate process from its controlling terminal."
NSQ_SOURCE_LINE 00006057 "        use POSIX ();"
NSQ_SOURCE_LINE 00006058 "        POSIX::setsid()"
NSQ_SOURCE_LINE 00006059 "            or die \"setsid failed: $!\";"
NSQ_SOURCE_LINE 00006060 ""
NSQ_SOURCE_LINE 00006061 "        ## Associate process with a new controlling terminal."
NSQ_SOURCE_LINE 00006062 "        $pty->make_slave_controlling_terminal;"
NSQ_SOURCE_LINE 00006063 "        $tty = $pty->slave;"
NSQ_SOURCE_LINE 00006064 "        $tty_fd = $tty->fileno;"
NSQ_SOURCE_LINE 00006065 "        close $pty;"
NSQ_SOURCE_LINE 00006066 ""
NSQ_SOURCE_LINE 00006067 "        ## Make standard I/O use the new controlling terminal."
NSQ_SOURCE_LINE 00006068 "        open STDIN, \"<&$tty_fd\" or die $!;"
NSQ_SOURCE_LINE 00006069 "        open STDOUT, \">&$tty_fd\" or die $!;"
NSQ_SOURCE_LINE 00006070 "        open STDERR, \">&STDOUT\" or die $!;"
NSQ_SOURCE_LINE 00006071 "        close $tty;"
NSQ_SOURCE_LINE 00006072 ""
NSQ_SOURCE_LINE 00006073 "        ## Execute requested program."
NSQ_SOURCE_LINE 00006074 "        exec @cmd"
NSQ_SOURCE_LINE 00006075 "            or die \"problem executing $cmd[0]\\n\";"
NSQ_SOURCE_LINE 00006076 "    } # end child process"
NSQ_SOURCE_LINE 00006077 ""
NSQ_SOURCE_LINE 00006078 "    $pty;"
NSQ_SOURCE_LINE 00006079 "} # end sub spawn"
NSQ_SOURCE_LINE 00006080 ""
NSQ_SOURCE_LINE 00006081 ""
NSQ_SOURCE_LINE 00006082 "Here is an example that uses the openssh program to connect to a"
NSQ_SOURCE_LINE 00006083 "remote host.  It uses the C<spawn()> subroutine, from the password"
NSQ_SOURCE_LINE 00006084 "changing example above, to start the ssh program and then read and"
NSQ_SOURCE_LINE 00006085 "write to it via a Net::Telnet object.  This example turns off ssh host"
NSQ_SOURCE_LINE 00006086 "key checking, which reduces your ability to know when someone on the"
NSQ_SOURCE_LINE 00006087 "network is impersonating the remote host.  To use the code below,"
NSQ_SOURCE_LINE 00006088 "substitute \"changeme\" with the actual host, user, password, and"
NSQ_SOURCE_LINE 00006089 "command prompt."
NSQ_SOURCE_LINE 00006090 ""
NSQ_SOURCE_LINE 00006091 "    ## Main program."
NSQ_SOURCE_LINE 00006092 "    {"
NSQ_SOURCE_LINE 00006093 "        my $host = \"changeme\";"
NSQ_SOURCE_LINE 00006094 "        my $user = \"changeme\";"
NSQ_SOURCE_LINE 00006095 "        my $passwd = \"changeme\";"
NSQ_SOURCE_LINE 00006096 "        my $prompt = '/changeme\\$ $/';"
NSQ_SOURCE_LINE 00006097 "        my ($buf, $match, $pty, $ssh, @lines);"
NSQ_SOURCE_LINE 00006098 ""
NSQ_SOURCE_LINE 00006099 "        ## Start ssh program."
NSQ_SOURCE_LINE 00006100 "        $pty = spawn(\"ssh\","
NSQ_SOURCE_LINE 00006101 "                     \"-l\", $user,"
NSQ_SOURCE_LINE 00006102 "                     \"-e\", \"none\","
NSQ_SOURCE_LINE 00006103 "                     \"-F\", \"/dev/null\","
NSQ_SOURCE_LINE 00006104 "                     \"-o\", \"PreferredAuthentications=password\","
NSQ_SOURCE_LINE 00006105 "                     \"-o\", \"NumberOfPasswordPrompts=1\","
NSQ_SOURCE_LINE 00006106 "                     \"-o\", \"StrictHostKeyChecking=no\","
NSQ_SOURCE_LINE 00006107 "                     \"-o\", \"UserKnownHostsFile=/dev/null\","
NSQ_SOURCE_LINE 00006108 "                     $host);"
NSQ_SOURCE_LINE 00006109 ""
NSQ_SOURCE_LINE 00006110 "        ## Create a Net::Telnet object to perform I/O on ssh's tty."
NSQ_SOURCE_LINE 00006111 "        use Net::Telnet;"
NSQ_SOURCE_LINE 00006112 "        $ssh = new Net::Telnet (-fhopen => $pty,"
NSQ_SOURCE_LINE 00006113 "                                -prompt => $prompt,"
NSQ_SOURCE_LINE 00006114 "                                -telnetmode => 0,"
NSQ_SOURCE_LINE 00006115 "                                -output_record_separator => \"\\r\","
NSQ_SOURCE_LINE 00006116 "                                -cmd_remove_mode => 1);"
NSQ_SOURCE_LINE 00006117 ""
NSQ_SOURCE_LINE 00006118 "        ## Wait for the password prompt and send password."
NSQ_SOURCE_LINE 00006119 "        $ssh->waitfor(-match => '/password: ?$/i',"
NSQ_SOURCE_LINE 00006120 "                      -errmode => \"return\")"
NSQ_SOURCE_LINE 00006121 "            or die \"problem connecting to \\\"$host\\\": \", $ssh->lastline;"
NSQ_SOURCE_LINE 00006122 "        $ssh->print($passwd);"
NSQ_SOURCE_LINE 00006123 ""
NSQ_SOURCE_LINE 00006124 "        ## Wait for the shell prompt."
NSQ_SOURCE_LINE 00006125 "        (undef, $match) = $ssh->waitfor(-match => $ssh->prompt,"
NSQ_SOURCE_LINE 00006126 "                                        -match => '/^Permission denied/m',"
NSQ_SOURCE_LINE 00006127 "                                        -errmode => \"return\")"
NSQ_SOURCE_LINE 00006128 "            or return $ssh->error(\"login failed: expected shell prompt \","
NSQ_SOURCE_LINE 00006129 "                                  \"doesn't match actual\\n\");"
NSQ_SOURCE_LINE 00006130 "        return $ssh->error(\"login failed: bad login-name or password\\n\")"
NSQ_SOURCE_LINE 00006131 "            if $match =~ /^Permission denied/m;"
NSQ_SOURCE_LINE 00006132 ""
NSQ_SOURCE_LINE 00006133 "        ## Run commands on remote host."
NSQ_SOURCE_LINE 00006134 "        print $ssh->cmd(\"hostname\");"
NSQ_SOURCE_LINE 00006135 "        print $ssh->cmd(\"uptime\");"
NSQ_SOURCE_LINE 00006136 ""
NSQ_SOURCE_LINE 00006137 "        $ssh->close;"
NSQ_SOURCE_LINE 00006138 "        exit;"
NSQ_SOURCE_LINE 00006139 "    } # end main program"
NSQ_SOURCE_LINE 00006140 ""
NSQ_SOURCE_LINE 00006141 ""
NSQ_SOURCE_LINE 00006142 "Some shells have a rather restrictive 255 character line limit.  If"
NSQ_SOURCE_LINE 00006143 "you run into this problem, here is an example for sending lines longer"
NSQ_SOURCE_LINE 00006144 "than 254 as a sequence of shorter lines."
NSQ_SOURCE_LINE 00006145 ""
NSQ_SOURCE_LINE 00006146 "    ## Main program."
NSQ_SOURCE_LINE 00006147 "    {"
NSQ_SOURCE_LINE 00006148 "        my $host = \"changeme\";"
NSQ_SOURCE_LINE 00006149 "        my $user = \"changeme\";"
NSQ_SOURCE_LINE 00006150 "        my $passwd = \"changeme\";"
NSQ_SOURCE_LINE 00006151 "        my $prompt = '/changeme\\$ $/';"
NSQ_SOURCE_LINE 00006152 "        my $cmd = join(\"\", \"echo \","
NSQ_SOURCE_LINE 00006153 "                       \"11111111112222222222333333333344444444445555555555\","
NSQ_SOURCE_LINE 00006154 "                       \"66666666667777777777888888888899999999990000000000\","
NSQ_SOURCE_LINE 00006155 "                       \"11111111112222222222333333333344444444445555555555\","
NSQ_SOURCE_LINE 00006156 "                       \"66666666667777777777888888888899999999990000000000\","
NSQ_SOURCE_LINE 00006157 "                       \"11111111112222222222333333333344444444445555555555\","
NSQ_SOURCE_LINE 00006158 "                       \"66666666667777777777888888888899999999990000000000\");"
NSQ_SOURCE_LINE 00006159 ""
NSQ_SOURCE_LINE 00006160 "        use Net::Telnet ();"
NSQ_SOURCE_LINE 00006161 "        my $t = new Net::Telnet (-prompt => $prompt);"
NSQ_SOURCE_LINE 00006162 "        $t->open($host);"
NSQ_SOURCE_LINE 00006163 "        $t->login($user, $passwd);"
NSQ_SOURCE_LINE 00006164 ""
NSQ_SOURCE_LINE 00006165 "        my @output = cmd_unixlong($t, $cmd);"
NSQ_SOURCE_LINE 00006166 "        print @output;"
NSQ_SOURCE_LINE 00006167 ""
NSQ_SOURCE_LINE 00006168 "        exit;"
NSQ_SOURCE_LINE 00006169 "    } # end main program"
NSQ_SOURCE_LINE 00006170 ""
NSQ_SOURCE_LINE 00006171 "    sub cmd_unixlong {"
NSQ_SOURCE_LINE 00006172 "        my ($obj, $cmd) = @_;"
NSQ_SOURCE_LINE 00006173 "        my ($line, $pos);"
NSQ_SOURCE_LINE 00006174 "        my $max_tty_line = 254;"
NSQ_SOURCE_LINE 00006175 ""
NSQ_SOURCE_LINE 00006176 "        ## Start a Bourne shell."
NSQ_SOURCE_LINE 00006177 "        $obj->cmd(-string => \"/usr/bin/env \" ."
NSQ_SOURCE_LINE 00006178 "                  \"'PS1=<xPROMPTx> ' 'PS2=<xPROMPTx> ' /bin/sh -i\","
NSQ_SOURCE_LINE 00006179 "                  -prompt => '/<xPROMPTx> $/')"
NSQ_SOURCE_LINE 00006180 "            or return;"
NSQ_SOURCE_LINE 00006181 ""
NSQ_SOURCE_LINE 00006182 "        ## Break-up the one large command line and send as shorter lines."
NSQ_SOURCE_LINE 00006183 "        $pos = 0;"
NSQ_SOURCE_LINE 00006184 "        while (1) {"
NSQ_SOURCE_LINE 00006185 "            $line = substr $cmd, $pos, $max_tty_line;"
NSQ_SOURCE_LINE 00006186 "            $pos += length $line;"
NSQ_SOURCE_LINE 00006187 "            last unless $pos < length $cmd;"
NSQ_SOURCE_LINE 00006188 ""
NSQ_SOURCE_LINE 00006189 "            ## Send the line with continuation char."
NSQ_SOURCE_LINE 00006190 "            $obj->cmd(-string => \"$line\\\\\","
NSQ_SOURCE_LINE 00006191 "                      -prompt => '/<xPROMPTx> $/')"
NSQ_SOURCE_LINE 00006192 "                or return;"
NSQ_SOURCE_LINE 00006193 "        }"
NSQ_SOURCE_LINE 00006194 ""
NSQ_SOURCE_LINE 00006195 "        ## Send the last line and return the output."
NSQ_SOURCE_LINE 00006196 "        $obj->cmd(\"$line ; exit\");"
NSQ_SOURCE_LINE 00006197 "    } # end sub cmd_unixlong"
NSQ_SOURCE_LINE 00006198 ""
NSQ_SOURCE_LINE 00006199 ""
