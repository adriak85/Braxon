NSQ_SOURCE_LINE 00000668 "sub fhopen {"
NSQ_SOURCE_LINE 00000669 "    my ($self, $fh) = @_;"
NSQ_SOURCE_LINE 00000670 "    my ("
NSQ_SOURCE_LINE 00000671 "        $globref,"
NSQ_SOURCE_LINE 00000672 "        $s,"
NSQ_SOURCE_LINE 00000673 "        );"
NSQ_SOURCE_LINE 00000674 ""
NSQ_SOURCE_LINE 00000675 "    ## Convert given filehandle to a typeglob reference, if necessary."
NSQ_SOURCE_LINE 00000676 "    $globref = &_qualify_fh($self, $fh);"
NSQ_SOURCE_LINE 00000677 ""
NSQ_SOURCE_LINE 00000678 "    ## Ensure filehandle is already open."
NSQ_SOURCE_LINE 00000679 "    return $self->error(\"fhopen filehandle isn't already open\")"
NSQ_SOURCE_LINE 00000680 "        unless defined($globref) and defined(fileno $globref);"
NSQ_SOURCE_LINE 00000681 ""
NSQ_SOURCE_LINE 00000682 "    ## Ensure we're closed."
NSQ_SOURCE_LINE 00000683 "    $self->close;"
NSQ_SOURCE_LINE 00000684 ""
NSQ_SOURCE_LINE 00000685 "    ## Save our private data."
NSQ_SOURCE_LINE 00000686 "    $s = *$self->{net_telnet};"
NSQ_SOURCE_LINE 00000687 ""
NSQ_SOURCE_LINE 00000688 "    ## Switch ourself with the given filehandle."
NSQ_SOURCE_LINE 00000689 "    *$self = *$globref;"
NSQ_SOURCE_LINE 00000690 ""
NSQ_SOURCE_LINE 00000691 "    ## Restore our private data."
NSQ_SOURCE_LINE 00000692 "    *$self->{net_telnet} = $s;"
NSQ_SOURCE_LINE 00000693 ""
NSQ_SOURCE_LINE 00000694 "    ## Re-initialize ourself."
NSQ_SOURCE_LINE 00000695 "    select((select($self), $|=1)[0]);  # don't buffer writes"
NSQ_SOURCE_LINE 00000696 "    $s = *$self->{net_telnet};"
NSQ_SOURCE_LINE 00000697 "    $s->{blksize} = &_optimal_blksize((stat $self)[11]);"
NSQ_SOURCE_LINE 00000698 "    $s->{buf} = \"\";"
NSQ_SOURCE_LINE 00000699 "    $s->{eofile} = '';"
NSQ_SOURCE_LINE 00000700 "    $s->{errormsg} = \"\";"
NSQ_SOURCE_LINE 00000701 "    vec($s->{fdmask}='', fileno($self), 1) = 1;"
NSQ_SOURCE_LINE 00000702 "    $s->{host} = \"\";"
NSQ_SOURCE_LINE 00000703 "    $s->{last_line} = \"\";"
NSQ_SOURCE_LINE 00000704 "    $s->{last_prompt} = \"\";"
NSQ_SOURCE_LINE 00000705 "    $s->{num_wrote} = 0;"
NSQ_SOURCE_LINE 00000706 "    $s->{opened} = 1;"
NSQ_SOURCE_LINE 00000707 "    $s->{pending_errormsg} = \"\";"
NSQ_SOURCE_LINE 00000708 "    $s->{port} = '';"
NSQ_SOURCE_LINE 00000709 "    $s->{pushback_buf} = \"\";"
NSQ_SOURCE_LINE 00000710 "    $s->{select_supported} = $^O ne \"MSWin32\" || -S $self;"
NSQ_SOURCE_LINE 00000711 "    $s->{timedout} = '';"
NSQ_SOURCE_LINE 00000712 "    $s->{unsent_opts} = \"\";"
NSQ_SOURCE_LINE 00000713 "    &_reset_options($s->{opts});"
NSQ_SOURCE_LINE 00000714 ""
NSQ_SOURCE_LINE 00000715 "    1;"
NSQ_SOURCE_LINE 00000716 "} # end sub fhopen"
