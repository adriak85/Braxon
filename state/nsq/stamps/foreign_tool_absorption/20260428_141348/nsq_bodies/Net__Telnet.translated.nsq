NSQ_SOURCE_LINE 00003552 "        return $self->error(\"Localfamily arg ipv6 not supported by \" ."
NSQ_SOURCE_LINE 00003553 "                            \"this OS: AF_INET6 not in Socket.pm\")"
NSQ_SOURCE_LINE 00003554 "            unless defined $AF_INET6;"
