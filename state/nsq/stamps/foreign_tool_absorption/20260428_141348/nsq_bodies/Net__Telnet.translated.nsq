NSQ_SOURCE_LINE 00000039 "if (&_import_io_socket) {  # successfully required module IO::Socket"
NSQ_SOURCE_LINE 00000040 "    push @ISA, \"IO::Socket::INET\";"
NSQ_SOURCE_LINE 00000041 "}"
NSQ_SOURCE_LINE 00000042 "else {  # perl version < 5.004"
