NSQ_SOURCE_LINE 00001934 "    $sockaddr = getpeername $self"
NSQ_SOURCE_LINE 00001935 "        or return \"\";"
NSQ_SOURCE_LINE 00001936 "    (undef, $host) = $self->_unpack_sockaddr($sockaddr);"
NSQ_SOURCE_LINE 00001937 ""
