NSQ_SOURCE_LINE 00001399 "## Make ofs() synonymous with output_field_separator()."
NSQ_SOURCE_LINE 00001400 "sub ofs { &output_field_separator; }"
NSQ_SOURCE_LINE 00001401 ""
NSQ_SOURCE_LINE 00001402 ""
NSQ_SOURCE_LINE 00001403 "sub open {"
NSQ_SOURCE_LINE 00001404 "    my ($self, @args) = @_;"
NSQ_SOURCE_LINE 00001405 "    my ("
NSQ_SOURCE_LINE 00001406 "        $af,"
NSQ_SOURCE_LINE 00001407 "        $arg_errmode,"
NSQ_SOURCE_LINE 00001408 "        $err,"
NSQ_SOURCE_LINE 00001409 "        $errno,"
NSQ_SOURCE_LINE 00001410 "        $family,"
NSQ_SOURCE_LINE 00001411 "        $flags_hint,"
NSQ_SOURCE_LINE 00001412 "        $host,"
NSQ_SOURCE_LINE 00001413 "        $ip_addr,"
NSQ_SOURCE_LINE 00001414 "        $lfamily,"
NSQ_SOURCE_LINE 00001415 "        $localhost,"
NSQ_SOURCE_LINE 00001416 "        $port,"
NSQ_SOURCE_LINE 00001417 "        $s,"
NSQ_SOURCE_LINE 00001418 "        $timeout,"
NSQ_SOURCE_LINE 00001419 "        %args,"
NSQ_SOURCE_LINE 00001420 "        @ai,"
NSQ_SOURCE_LINE 00001421 "        );"
NSQ_SOURCE_LINE 00001422 "    local $@;"
NSQ_SOURCE_LINE 00001423 "    local $_;"
NSQ_SOURCE_LINE 00001424 "    my $local_addr = '';"
NSQ_SOURCE_LINE 00001425 "    my $remote_addr = '';"
NSQ_SOURCE_LINE 00001426 "    my %af = ("
NSQ_SOURCE_LINE 00001427 "        ipv4 => AF_INET,"
NSQ_SOURCE_LINE 00001428 "        ipv6 => defined($AF_INET6) ? $AF_INET6 : undef,"
NSQ_SOURCE_LINE 00001429 "        any => $AF_UNSPEC,"
NSQ_SOURCE_LINE 00001430 "        );"
NSQ_SOURCE_LINE 00001431 ""
NSQ_SOURCE_LINE 00001432 "    ## Init."
NSQ_SOURCE_LINE 00001433 "    $s = *$self->{net_telnet};"
NSQ_SOURCE_LINE 00001434 "    $s->{timedout} = '';"
NSQ_SOURCE_LINE 00001435 "    $s->{sock_family} = 0;"
NSQ_SOURCE_LINE 00001436 "    $port = $self->port;"
NSQ_SOURCE_LINE 00001437 "    $family = $self->family;"
NSQ_SOURCE_LINE 00001438 "    $localhost = $self->localhost;"
NSQ_SOURCE_LINE 00001439 "    $lfamily = $self->localfamily;"
NSQ_SOURCE_LINE 00001440 "    $timeout = $self->timeout;"
NSQ_SOURCE_LINE 00001441 ""
NSQ_SOURCE_LINE 00001442 "    ## Override errmode first, if specified."
NSQ_SOURCE_LINE 00001443 "    $arg_errmode = &_extract_arg_errmode($self, \\@args);"
NSQ_SOURCE_LINE 00001444 "    local $s->{errormode} = $arg_errmode"
NSQ_SOURCE_LINE 00001445 "        if $arg_errmode;"
NSQ_SOURCE_LINE 00001446 ""
NSQ_SOURCE_LINE 00001447 "    if (@args == 1) {  # one positional arg given"
NSQ_SOURCE_LINE 00001448 "        $self->host($args[0]);"
NSQ_SOURCE_LINE 00001449 "    }"
NSQ_SOURCE_LINE 00001450 "    elsif (@args >= 2) {  # named args given"
NSQ_SOURCE_LINE 00001451 "        ## Get the named args."
NSQ_SOURCE_LINE 00001452 "        %args = @args;"
NSQ_SOURCE_LINE 00001453 ""
NSQ_SOURCE_LINE 00001454 "        ## Parse the named args."
NSQ_SOURCE_LINE 00001455 "        foreach (keys %args) {"
NSQ_SOURCE_LINE 00001456 "            if (/^-?family$/i) {"
NSQ_SOURCE_LINE 00001457 "                $family = &_parse_family($self, $args{$_});"
NSQ_SOURCE_LINE 00001458 "            }"
NSQ_SOURCE_LINE 00001459 "            elsif (/^-?host$/i) {"
NSQ_SOURCE_LINE 00001460 "                $self->host($args{$_});"
NSQ_SOURCE_LINE 00001461 "            }"
NSQ_SOURCE_LINE 00001462 "            elsif (/^-?localfamily$/i) {"
NSQ_SOURCE_LINE 00001463 "                $lfamily = &_parse_localfamily($self, $args{$_});"
NSQ_SOURCE_LINE 00001464 "            }"
NSQ_SOURCE_LINE 00001465 "            elsif (/^-?localhost$/i) {"
NSQ_SOURCE_LINE 00001466 "                $args{$_} = \"\" unless defined $args{$_};"
NSQ_SOURCE_LINE 00001467 "                $localhost = $args{$_};"
NSQ_SOURCE_LINE 00001468 "            }"
NSQ_SOURCE_LINE 00001469 "            elsif (/^-?port$/i) {"
NSQ_SOURCE_LINE 00001470 "                $port = &_parse_port($self, $args{$_});"
NSQ_SOURCE_LINE 00001471 "            }"
NSQ_SOURCE_LINE 00001472 "            elsif (/^-?timeout$/i) {"
NSQ_SOURCE_LINE 00001473 "                $timeout = &_parse_timeout($self, $args{$_});"
NSQ_SOURCE_LINE 00001474 "            }"
NSQ_SOURCE_LINE 00001475 "            else {"
NSQ_SOURCE_LINE 00001476 "                &_croak($self, \"bad named parameter \\\"$_\\\" given \","
NSQ_SOURCE_LINE 00001477 "                        \"to \" . ref($self) . \"::open()\");"
NSQ_SOURCE_LINE 00001478 "            }"
NSQ_SOURCE_LINE 00001479 "        }"
NSQ_SOURCE_LINE 00001480 "    }"
NSQ_SOURCE_LINE 00001481 ""
NSQ_SOURCE_LINE 00001482 "    ## Get hostname/ip address."
NSQ_SOURCE_LINE 00001483 "    $host = $self->host;"
NSQ_SOURCE_LINE 00001484 ""
NSQ_SOURCE_LINE 00001485 "    ## Ensure we're already closed."
NSQ_SOURCE_LINE 00001486 "    $self->close;"
NSQ_SOURCE_LINE 00001487 ""
NSQ_SOURCE_LINE 00001488 "    ## Connect with or without a timeout."
NSQ_SOURCE_LINE 00001489 "    if (defined($timeout) and &_have_alarm) {  # use a timeout"
NSQ_SOURCE_LINE 00001490 "        ## Convert possible absolute timeout to relative timeout."
NSQ_SOURCE_LINE 00001491 "        if ($timeout >= $^T) {  # it's an absolute time"
NSQ_SOURCE_LINE 00001492 "            $timeout = $timeout - time;"
NSQ_SOURCE_LINE 00001493 "        }"
NSQ_SOURCE_LINE 00001494 ""
NSQ_SOURCE_LINE 00001495 "        ## Ensure a valid timeout value for alarm."
NSQ_SOURCE_LINE 00001496 "        if ($timeout < 1) {"
NSQ_SOURCE_LINE 00001497 "            $timeout = 1;"
NSQ_SOURCE_LINE 00001498 "        }"
NSQ_SOURCE_LINE 00001499 "        $timeout = int($timeout + 0.5);"
NSQ_SOURCE_LINE 00001500 ""
NSQ_SOURCE_LINE 00001501 "        ## Connect to server, timing out if it takes too long."
NSQ_SOURCE_LINE 00001502 "        eval {"
NSQ_SOURCE_LINE 00001503 "            ## Turn on timer."
NSQ_SOURCE_LINE 00001504 "            local $SIG{\"__DIE__\"} = \"DEFAULT\";"
NSQ_SOURCE_LINE 00001505 "            local $SIG{ALRM} = sub { die \"timed-out\\n\" };"
NSQ_SOURCE_LINE 00001506 "            alarm $timeout;"
NSQ_SOURCE_LINE 00001507 ""
NSQ_SOURCE_LINE 00001508 "            if ($family eq \"ipv4\") {"
NSQ_SOURCE_LINE 00001509 "                ## Lookup server's IP address."
NSQ_SOURCE_LINE 00001510 "                $ip_addr = inet_aton $host"
NSQ_SOURCE_LINE 00001511 "                    or die \"unknown remote host: $host\\n\";"
NSQ_SOURCE_LINE 00001512 "                $af = AF_INET;"
NSQ_SOURCE_LINE 00001513 "                $remote_addr = sockaddr_in($port, $ip_addr);"
NSQ_SOURCE_LINE 00001514 "            }"
NSQ_SOURCE_LINE 00001515 "            else {  # family is \"ipv6\" or \"any\""
NSQ_SOURCE_LINE 00001516 "                ## Lookup server's IP address."
NSQ_SOURCE_LINE 00001517 "                $flags_hint = $family eq \"any\" ? $AI_ADDRCONFIG : 0;"
NSQ_SOURCE_LINE 00001518 "                ($err, @ai) = Socket::getaddrinfo($host, $port,"
NSQ_SOURCE_LINE 00001519 "                                                  { socktype => SOCK_STREAM,"
NSQ_SOURCE_LINE 00001520 "                                                    \"family\" => $af{$family},"
NSQ_SOURCE_LINE 00001521 "                                                    \"flags\" => $flags_hint });"
NSQ_SOURCE_LINE 00001522 "                if ($err == $EAI_BADFLAGS) {"
NSQ_SOURCE_LINE 00001523 "                    ## Try again with no flags."
NSQ_SOURCE_LINE 00001524 "                    ($err, @ai) = Socket::getaddrinfo($host, $port,"
NSQ_SOURCE_LINE 00001525 "                                                      {socktype => SOCK_STREAM,"
NSQ_SOURCE_LINE 00001526 "                                                       \"family\"=> $af{$family},"
NSQ_SOURCE_LINE 00001527 "                                                       \"flags\" => 0 });"
NSQ_SOURCE_LINE 00001528 "                }"
NSQ_SOURCE_LINE 00001529 "                die \"unknown remote host: $host: $err\\n\""
NSQ_SOURCE_LINE 00001530 "                    if $err or !@ai;"
NSQ_SOURCE_LINE 00001531 "                $af = $ai[0]{\"family\"};"
NSQ_SOURCE_LINE 00001532 "                $remote_addr = $ai[0]{addr};"
NSQ_SOURCE_LINE 00001533 "            }"
NSQ_SOURCE_LINE 00001534 ""
NSQ_SOURCE_LINE 00001535 "            ## Create a socket and attach the filehandle to it."
NSQ_SOURCE_LINE 00001536 "            socket $self, $af, SOCK_STREAM, 0"
NSQ_SOURCE_LINE 00001537 "                or die \"problem creating socket: $!\\n\";"
NSQ_SOURCE_LINE 00001538 ""
NSQ_SOURCE_LINE 00001539 "            ## Bind to a local network interface."
NSQ_SOURCE_LINE 00001540 "            if (length $localhost) {"
NSQ_SOURCE_LINE 00001541 "                if ($lfamily eq \"ipv4\") {"
NSQ_SOURCE_LINE 00001542 "                    ## Lookup server's IP address."
NSQ_SOURCE_LINE 00001543 "                    $ip_addr = inet_aton $localhost"
NSQ_SOURCE_LINE 00001544 "                        or die \"unknown local host: $localhost\\n\";"
NSQ_SOURCE_LINE 00001545 "                    $local_addr = sockaddr_in(0, $ip_addr);"
NSQ_SOURCE_LINE 00001546 "                }"
NSQ_SOURCE_LINE 00001547 "                else {  # local family is \"ipv6\" or \"any\""
NSQ_SOURCE_LINE 00001548 "                    ## Lookup local IP address."
NSQ_SOURCE_LINE 00001549 "                    ($err, @ai) = Socket::getaddrinfo($localhost, 0,"
NSQ_SOURCE_LINE 00001550 "                                                      {socktype => SOCK_STREAM,"
NSQ_SOURCE_LINE 00001551 "                                                       \"family\"=>$af{$lfamily},"
NSQ_SOURCE_LINE 00001552 "                                                       \"flags\" => 0 });"
NSQ_SOURCE_LINE 00001553 "                    die \"unknown local host: $localhost: $err\\n\""
NSQ_SOURCE_LINE 00001554 "                        if $err or !@ai;"
NSQ_SOURCE_LINE 00001555 "                    $local_addr = $ai[0]{addr};"
NSQ_SOURCE_LINE 00001556 "                }"
NSQ_SOURCE_LINE 00001557 ""
NSQ_SOURCE_LINE 00001558 "                bind $self, $local_addr"
NSQ_SOURCE_LINE 00001559 "                    or die \"problem binding to \\\"$localhost\\\": $!\\n\";"
NSQ_SOURCE_LINE 00001560 "            }"
NSQ_SOURCE_LINE 00001561 ""
NSQ_SOURCE_LINE 00001562 "            ## Open connection to server."
NSQ_SOURCE_LINE 00001563 "            connect $self, $remote_addr"
NSQ_SOURCE_LINE 00001564 "                or die \"problem connecting to \\\"$host\\\", port $port: $!\\n\";"
NSQ_SOURCE_LINE 00001565 "        };"
NSQ_SOURCE_LINE 00001566 "        alarm 0;"
NSQ_SOURCE_LINE 00001567 ""
NSQ_SOURCE_LINE 00001568 "        ## Check for error."
NSQ_SOURCE_LINE 00001569 "        if ($@ =~ /^timed-out$/) {  # time out failure"
NSQ_SOURCE_LINE 00001570 "            $s->{timedout} = 1;"
NSQ_SOURCE_LINE 00001571 "            $self->close;"
NSQ_SOURCE_LINE 00001572 "            if (!$remote_addr) {"
NSQ_SOURCE_LINE 00001573 "                return $self->error(\"unknown remote host: $host: \","
NSQ_SOURCE_LINE 00001574 "                                    \"name lookup timed-out\");"
NSQ_SOURCE_LINE 00001575 "            }"
NSQ_SOURCE_LINE 00001576 "            elsif (length($localhost) and !$local_addr) {"
NSQ_SOURCE_LINE 00001577 "                return $self->error(\"unknown local host: $localhost: \","
NSQ_SOURCE_LINE 00001578 "                                    \"name lookup timed-out\");"
NSQ_SOURCE_LINE 00001579 "            }"
NSQ_SOURCE_LINE 00001580 "            else {"
NSQ_SOURCE_LINE 00001581 "                return $self->error(\"problem connecting to \\\"$host\\\", \","
NSQ_SOURCE_LINE 00001582 "                                    \"port $port: connect timed-out\");"
NSQ_SOURCE_LINE 00001583 "            }"
NSQ_SOURCE_LINE 00001584 "        }"
NSQ_SOURCE_LINE 00001585 "        elsif ($@) {  # hostname lookup or connect failure"
NSQ_SOURCE_LINE 00001586 "            $self->close;"
NSQ_SOURCE_LINE 00001587 "            $@ =~ s([\\015\\012]+$)();"
NSQ_SOURCE_LINE 00001588 "            return $self->error($@);"
NSQ_SOURCE_LINE 00001589 "        }"
NSQ_SOURCE_LINE 00001590 "    }"
NSQ_SOURCE_LINE 00001591 "    else {  # don't use a timeout"
NSQ_SOURCE_LINE 00001592 "        $timeout = undef;"
NSQ_SOURCE_LINE 00001593 ""
NSQ_SOURCE_LINE 00001594 "        if ($family eq \"ipv4\") {"
NSQ_SOURCE_LINE 00001595 "            ## Lookup server's IP address."
NSQ_SOURCE_LINE 00001596 "            $ip_addr = inet_aton $host"
NSQ_SOURCE_LINE 00001597 "                or return $self->error(\"unknown remote host: $host\");"
NSQ_SOURCE_LINE 00001598 "            $af = AF_INET;"
NSQ_SOURCE_LINE 00001599 "            $remote_addr = sockaddr_in($port, $ip_addr);"
NSQ_SOURCE_LINE 00001600 "        }"
NSQ_SOURCE_LINE 00001601 "        else {  # family is \"ipv6\" or \"any\""
NSQ_SOURCE_LINE 00001602 "            ## Lookup server's IP address."
NSQ_SOURCE_LINE 00001603 "            $flags_hint = $family eq \"any\" ? $AI_ADDRCONFIG : 0;"
NSQ_SOURCE_LINE 00001604 "            ($err, @ai) = Socket::getaddrinfo($host, $port,"
NSQ_SOURCE_LINE 00001605 "                                              { socktype => SOCK_STREAM,"
NSQ_SOURCE_LINE 00001606 "                                                \"family\" => $af{$family},"
NSQ_SOURCE_LINE 00001607 "                                                \"flags\" => $flags_hint });"
NSQ_SOURCE_LINE 00001608 "            if ($err == $EAI_BADFLAGS) {"
NSQ_SOURCE_LINE 00001609 "                ## Try again with no flags."
NSQ_SOURCE_LINE 00001610 "                ($err, @ai) = Socket::getaddrinfo($host, $port,"
NSQ_SOURCE_LINE 00001611 "                                                  { socktype => SOCK_STREAM,"
NSQ_SOURCE_LINE 00001612 "                                                    \"family\"=> $af{$family},"
NSQ_SOURCE_LINE 00001613 "                                                    \"flags\" => 0 });"
NSQ_SOURCE_LINE 00001614 "            }"
NSQ_SOURCE_LINE 00001615 "            return $self->error(\"unknown remote host: $host\")"
NSQ_SOURCE_LINE 00001616 "                if $err or !@ai;"
NSQ_SOURCE_LINE 00001617 "            $af = $ai[0]{\"family\"};"
NSQ_SOURCE_LINE 00001618 "            $remote_addr = $ai[0]{addr};"
NSQ_SOURCE_LINE 00001619 "        }"
NSQ_SOURCE_LINE 00001620 ""
NSQ_SOURCE_LINE 00001621 "        ## Create a socket and attach the filehandle to it."
NSQ_SOURCE_LINE 00001622 "        socket $self, $af, SOCK_STREAM, 0"
NSQ_SOURCE_LINE 00001623 "            or return $self->error(\"problem creating socket: $!\");"
NSQ_SOURCE_LINE 00001624 ""
NSQ_SOURCE_LINE 00001625 "        ## Bind to a local network interface."
NSQ_SOURCE_LINE 00001626 "        if (length $localhost) {"
NSQ_SOURCE_LINE 00001627 "            if ($lfamily eq \"ipv4\") {"
NSQ_SOURCE_LINE 00001628 "                ## Lookup server's IP address."
NSQ_SOURCE_LINE 00001629 "                $ip_addr = inet_aton $localhost"
NSQ_SOURCE_LINE 00001630 "                    or return $self->error(\"unknown local host: $localhost\");"
NSQ_SOURCE_LINE 00001631 "                $local_addr = sockaddr_in(0, $ip_addr);"
NSQ_SOURCE_LINE 00001632 "            }"
NSQ_SOURCE_LINE 00001633 "            else {  # local family is \"ipv6\" or \"any\""
NSQ_SOURCE_LINE 00001634 "                ## Lookup local IP address."
NSQ_SOURCE_LINE 00001635 "                ($err, @ai) = Socket::getaddrinfo($localhost, 0,"
NSQ_SOURCE_LINE 00001636 "                                                  { socktype => SOCK_STREAM,"
NSQ_SOURCE_LINE 00001637 "                                                    \"family\"=>$af{$lfamily},"
NSQ_SOURCE_LINE 00001638 "                                                    \"flags\" => 0 });"
NSQ_SOURCE_LINE 00001639 "                return $self->error(\"unknown local host: $localhost: $err\")"
NSQ_SOURCE_LINE 00001640 "                    if $err or !@ai;"
NSQ_SOURCE_LINE 00001641 "                $local_addr = $ai[0]{addr};"
NSQ_SOURCE_LINE 00001642 "            }"
NSQ_SOURCE_LINE 00001643 ""
NSQ_SOURCE_LINE 00001644 "            bind $self, $local_addr"
NSQ_SOURCE_LINE 00001645 "                or return $self->error(\"problem binding \","
NSQ_SOURCE_LINE 00001646 "                                       \"to \\\"$localhost\\\": $!\");"
NSQ_SOURCE_LINE 00001647 "        }"
NSQ_SOURCE_LINE 00001648 ""
NSQ_SOURCE_LINE 00001649 "        ## Open connection to server."
NSQ_SOURCE_LINE 00001650 "        connect $self, $remote_addr"
NSQ_SOURCE_LINE 00001651 "            or do {"
NSQ_SOURCE_LINE 00001652 "                $errno = \"$!\";"
NSQ_SOURCE_LINE 00001653 "                $self->close;"
NSQ_SOURCE_LINE 00001654 "                return $self->error(\"problem connecting to \\\"$host\\\", \","
NSQ_SOURCE_LINE 00001655 "                                    \"port $port: $errno\");"
NSQ_SOURCE_LINE 00001656 "            };"
NSQ_SOURCE_LINE 00001657 "    }"
NSQ_SOURCE_LINE 00001658 ""
NSQ_SOURCE_LINE 00001659 "    select((select($self), $|=1)[0]);  # don't buffer writes"
NSQ_SOURCE_LINE 00001660 "    $s->{blksize} = &_optimal_blksize((stat $self)[11]);"
NSQ_SOURCE_LINE 00001661 "    $s->{buf} = \"\";"
NSQ_SOURCE_LINE 00001662 "    $s->{eofile} = '';"
NSQ_SOURCE_LINE 00001663 "    $s->{errormsg} = \"\";"
NSQ_SOURCE_LINE 00001664 "    vec($s->{fdmask}='', fileno($self), 1) = 1;"
NSQ_SOURCE_LINE 00001665 "    $s->{last_line} = \"\";"
NSQ_SOURCE_LINE 00001666 "    $s->{sock_family} = $af;"
NSQ_SOURCE_LINE 00001667 "    $s->{num_wrote} = 0;"
NSQ_SOURCE_LINE 00001668 "    $s->{opened} = 1;"
NSQ_SOURCE_LINE 00001669 "    $s->{pending_errormsg} = \"\";"
NSQ_SOURCE_LINE 00001670 "    $s->{pushback_buf} = \"\";"
NSQ_SOURCE_LINE 00001671 "    $s->{select_supported} = 1;"
NSQ_SOURCE_LINE 00001672 "    $s->{timedout} = '';"
NSQ_SOURCE_LINE 00001673 "    $s->{unsent_opts} = \"\";"
NSQ_SOURCE_LINE 00001674 "    &_reset_options($s->{opts});"
NSQ_SOURCE_LINE 00001675 ""
NSQ_SOURCE_LINE 00001676 "    1;"
NSQ_SOURCE_LINE 00001677 "} # end sub open"
NSQ_SOURCE_LINE 00001678 ""
NSQ_SOURCE_LINE 00001679 ""
NSQ_SOURCE_LINE 00001680 "sub option_accept {"
NSQ_SOURCE_LINE 00001681 "    my ($self, @args) = @_;"
NSQ_SOURCE_LINE 00001682 "    my ("
NSQ_SOURCE_LINE 00001683 "        $arg,"
NSQ_SOURCE_LINE 00001684 "        $option,"
NSQ_SOURCE_LINE 00001685 "        $s,"
NSQ_SOURCE_LINE 00001686 "        @opt_args,"
NSQ_SOURCE_LINE 00001687 "        );"
NSQ_SOURCE_LINE 00001688 "    local $_;"
NSQ_SOURCE_LINE 00001689 ""
NSQ_SOURCE_LINE 00001690 "    ## Init."
NSQ_SOURCE_LINE 00001691 "    $s = *$self->{net_telnet};"
NSQ_SOURCE_LINE 00001692 ""
NSQ_SOURCE_LINE 00001693 "    ## Parse the named args."
NSQ_SOURCE_LINE 00001694 "    while (($_, $arg) = splice @args, 0, 2) {"
NSQ_SOURCE_LINE 00001695 "        ## Verify and save arguments."
NSQ_SOURCE_LINE 00001696 "        if (/^-?do$/i) {"
NSQ_SOURCE_LINE 00001697 "            ## Make sure a callback is defined."
NSQ_SOURCE_LINE 00001698 "            return $self->error(\"usage: an option callback must already \","
NSQ_SOURCE_LINE 00001699 "                                \"be defined when enabling with $_\")"
NSQ_SOURCE_LINE 00001700 "                unless $s->{opt_cback};"
NSQ_SOURCE_LINE 00001701 ""
NSQ_SOURCE_LINE 00001702 "            $option = &_verify_telopt_arg($self, $arg, $_);"
NSQ_SOURCE_LINE 00001703 "            return unless defined $option;"
NSQ_SOURCE_LINE 00001704 "            push @opt_args, { option    => $option,"
NSQ_SOURCE_LINE 00001705 "                              is_remote => '',"
NSQ_SOURCE_LINE 00001706 "                              is_enable => 1,"
NSQ_SOURCE_LINE 00001707 "                          };"
NSQ_SOURCE_LINE 00001708 "        }"
NSQ_SOURCE_LINE 00001709 "        elsif (/^-?dont$/i) {"
NSQ_SOURCE_LINE 00001710 "            $option = &_verify_telopt_arg($self, $arg, $_);"
NSQ_SOURCE_LINE 00001711 "            return unless defined $option;"
NSQ_SOURCE_LINE 00001712 "            push @opt_args, { option    => $option,"
NSQ_SOURCE_LINE 00001713 "                              is_remote => '',"
NSQ_SOURCE_LINE 00001714 "                              is_enable => '',"
NSQ_SOURCE_LINE 00001715 "                          };"
NSQ_SOURCE_LINE 00001716 "        }"
NSQ_SOURCE_LINE 00001717 "        elsif (/^-?will$/i) {"
NSQ_SOURCE_LINE 00001718 "            ## Make sure a callback is defined."
NSQ_SOURCE_LINE 00001719 "            return $self->error(\"usage: an option callback must already \","
NSQ_SOURCE_LINE 00001720 "                                \"be defined when enabling with $_\")"
NSQ_SOURCE_LINE 00001721 "                unless $s->{opt_cback};"
NSQ_SOURCE_LINE 00001722 ""
NSQ_SOURCE_LINE 00001723 "            $option = &_verify_telopt_arg($self, $arg, $_);"
NSQ_SOURCE_LINE 00001724 "            return unless defined $option;"
NSQ_SOURCE_LINE 00001725 "            push @opt_args, { option    => $option,"
NSQ_SOURCE_LINE 00001726 "                              is_remote => 1,"
NSQ_SOURCE_LINE 00001727 "                              is_enable => 1,"
NSQ_SOURCE_LINE 00001728 "                          };"
NSQ_SOURCE_LINE 00001729 "        }"
NSQ_SOURCE_LINE 00001730 "        elsif (/^-?wont$/i) {"
NSQ_SOURCE_LINE 00001731 "            $option = &_verify_telopt_arg($self, $arg, $_);"
NSQ_SOURCE_LINE 00001732 "            return unless defined $option;"
NSQ_SOURCE_LINE 00001733 "            push @opt_args, { option    => $option,"
NSQ_SOURCE_LINE 00001734 "                              is_remote => 1,"
NSQ_SOURCE_LINE 00001735 "                              is_enable => '',"
NSQ_SOURCE_LINE 00001736 "                          };"
NSQ_SOURCE_LINE 00001737 "        }"
NSQ_SOURCE_LINE 00001738 "        else {"
NSQ_SOURCE_LINE 00001739 "            return $self->error('usage: $obj->option_accept(' ."
NSQ_SOURCE_LINE 00001740 "                                '[Do => $telopt,] ',"
NSQ_SOURCE_LINE 00001741 "                                '[Dont => $telopt,] ',"
NSQ_SOURCE_LINE 00001742 "                                '[Will => $telopt,] ',"
NSQ_SOURCE_LINE 00001743 "                                '[Wont => $telopt,]');"
NSQ_SOURCE_LINE 00001744 "        }"
NSQ_SOURCE_LINE 00001745 "    }"
NSQ_SOURCE_LINE 00001746 ""
NSQ_SOURCE_LINE 00001747 "    ## Set \"receive ok\" for options specified."
NSQ_SOURCE_LINE 00001748 "    &_opt_accept($self, @opt_args);"
NSQ_SOURCE_LINE 00001749 "} # end sub option_accept"
NSQ_SOURCE_LINE 00001750 ""
NSQ_SOURCE_LINE 00001751 ""
NSQ_SOURCE_LINE 00001752 "sub option_callback {"
NSQ_SOURCE_LINE 00001753 "    my ($self, $callback) = @_;"
NSQ_SOURCE_LINE 00001754 "    my ("
NSQ_SOURCE_LINE 00001755 "        $prev,"
NSQ_SOURCE_LINE 00001756 "        $s,"
NSQ_SOURCE_LINE 00001757 "        );"
NSQ_SOURCE_LINE 00001758 ""
NSQ_SOURCE_LINE 00001759 "    $s = *$self->{net_telnet};"
NSQ_SOURCE_LINE 00001760 "    $prev = $s->{opt_cback};"
NSQ_SOURCE_LINE 00001761 ""
NSQ_SOURCE_LINE 00001762 "    if (@_ >= 2) {"
NSQ_SOURCE_LINE 00001763 "        unless (defined $callback and ref($callback) eq \"CODE\") {"
NSQ_SOURCE_LINE 00001764 "            &_carp($self, \"ignoring Option_callback argument because it's \" ."
NSQ_SOURCE_LINE 00001765 "                   \"not a code ref\");"
NSQ_SOURCE_LINE 00001766 "            $callback = $prev;"
NSQ_SOURCE_LINE 00001767 "        }"
NSQ_SOURCE_LINE 00001768 ""
NSQ_SOURCE_LINE 00001769 "        $s->{opt_cback} = $callback;"
NSQ_SOURCE_LINE 00001770 "    }"
NSQ_SOURCE_LINE 00001771 ""
NSQ_SOURCE_LINE 00001772 "    $prev;"
NSQ_SOURCE_LINE 00001773 "} # end sub option_callback"
NSQ_SOURCE_LINE 00001774 ""
NSQ_SOURCE_LINE 00001775 ""
NSQ_SOURCE_LINE 00001776 "sub option_log {"
NSQ_SOURCE_LINE 00001777 "    my ($self, $name) = @_;"
NSQ_SOURCE_LINE 00001778 "    my ("
NSQ_SOURCE_LINE 00001779 "        $fh,"
NSQ_SOURCE_LINE 00001780 "        $s,"
NSQ_SOURCE_LINE 00001781 "        );"
NSQ_SOURCE_LINE 00001782 ""
NSQ_SOURCE_LINE 00001783 "    $s = *$self->{net_telnet};"
NSQ_SOURCE_LINE 00001784 "    $fh = $s->{opt_log};"
NSQ_SOURCE_LINE 00001785 ""
NSQ_SOURCE_LINE 00001786 "    if (@_ >= 2) {"
NSQ_SOURCE_LINE 00001787 "        if (!defined($name) or $name eq \"\") {  # input arg is \"\""
NSQ_SOURCE_LINE 00001788 "            ## Turn off logging."
NSQ_SOURCE_LINE 00001789 "            $fh = \"\";"
NSQ_SOURCE_LINE 00001790 "        }"
NSQ_SOURCE_LINE 00001791 "        elsif (&_is_open_fh($name)) {  # input arg is an open fh"
NSQ_SOURCE_LINE 00001792 "            ## Use the open fh for logging."
NSQ_SOURCE_LINE 00001793 "            $fh = $name;"
NSQ_SOURCE_LINE 00001794 "            select((select($fh), $|=1)[0]);  # don't buffer writes"
NSQ_SOURCE_LINE 00001795 "        }"
NSQ_SOURCE_LINE 00001796 "        elsif (!ref $name) {  # input arg is filename"
NSQ_SOURCE_LINE 00001797 "            ## Open the file for logging."
NSQ_SOURCE_LINE 00001798 "            $fh = &_fname_to_handle($self, $name)"
NSQ_SOURCE_LINE 00001799 "                or return;"
NSQ_SOURCE_LINE 00001800 "            select((select($fh), $|=1)[0]);  # don't buffer writes"
NSQ_SOURCE_LINE 00001801 "        }"
NSQ_SOURCE_LINE 00001802 "        else {"
NSQ_SOURCE_LINE 00001803 "            return $self->error(\"bad Option_log argument \","
NSQ_SOURCE_LINE 00001804 "                                \"\\\"$name\\\": not filename or open fh\");"
NSQ_SOURCE_LINE 00001805 "        }"
NSQ_SOURCE_LINE 00001806 ""
NSQ_SOURCE_LINE 00001807 "        $s->{opt_log} = $fh;"
NSQ_SOURCE_LINE 00001808 "    }"
NSQ_SOURCE_LINE 00001809 ""
NSQ_SOURCE_LINE 00001810 "    $fh;"
NSQ_SOURCE_LINE 00001811 "} # end sub option_log"
NSQ_SOURCE_LINE 00001812 ""
NSQ_SOURCE_LINE 00001813 ""
NSQ_SOURCE_LINE 00001814 "sub option_state {"
NSQ_SOURCE_LINE 00001815 "    my ($self, $option) = @_;"
NSQ_SOURCE_LINE 00001816 "    my ("
NSQ_SOURCE_LINE 00001817 "        $opt_state,"
NSQ_SOURCE_LINE 00001818 "        $s,"
NSQ_SOURCE_LINE 00001819 "        %opt_state,"
NSQ_SOURCE_LINE 00001820 "        );"
NSQ_SOURCE_LINE 00001821 ""
NSQ_SOURCE_LINE 00001822 "    ## Ensure telnet option is non-negative integer."
NSQ_SOURCE_LINE 00001823 "    $option = &_verify_telopt_arg($self, $option);"
NSQ_SOURCE_LINE 00001824 "    return unless defined $option;"
NSQ_SOURCE_LINE 00001825 ""
NSQ_SOURCE_LINE 00001826 "    ## Init."
NSQ_SOURCE_LINE 00001827 "    $s = *$self->{net_telnet};"
NSQ_SOURCE_LINE 00001828 "    unless (defined $s->{opts}{$option}) {"
NSQ_SOURCE_LINE 00001829 "        &_set_default_option($s, $option);"
NSQ_SOURCE_LINE 00001830 "    }"
NSQ_SOURCE_LINE 00001831 ""
NSQ_SOURCE_LINE 00001832 "    ## Return hashref to a copy of the values."
NSQ_SOURCE_LINE 00001833 "    $opt_state = $s->{opts}{$option};"
NSQ_SOURCE_LINE 00001834 "    %opt_state = %$opt_state;"
NSQ_SOURCE_LINE 00001835 "    \\%opt_state;"
NSQ_SOURCE_LINE 00001836 "} # end sub option_state"
NSQ_SOURCE_LINE 00001837 ""
