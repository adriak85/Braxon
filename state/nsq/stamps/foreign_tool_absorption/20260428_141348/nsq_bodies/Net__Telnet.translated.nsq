NSQ_SOURCE_LINE 00001031 "sub input_log {"
NSQ_SOURCE_LINE 00001032 "    my ($self, $name) = @_;"
NSQ_SOURCE_LINE 00001033 "    my ("
NSQ_SOURCE_LINE 00001034 "        $fh,"
NSQ_SOURCE_LINE 00001035 "        $s,"
NSQ_SOURCE_LINE 00001036 "        );"
NSQ_SOURCE_LINE 00001037 ""
NSQ_SOURCE_LINE 00001038 "    $s = *$self->{net_telnet};"
NSQ_SOURCE_LINE 00001039 "    $fh = $s->{inputlog};"
NSQ_SOURCE_LINE 00001040 ""
NSQ_SOURCE_LINE 00001041 "    if (@_ >= 2) {"
NSQ_SOURCE_LINE 00001042 "        if (!defined($name) or $name eq \"\") {  # input arg is \"\""
NSQ_SOURCE_LINE 00001043 "            ## Turn off logging."
NSQ_SOURCE_LINE 00001044 "            $fh = \"\";"
NSQ_SOURCE_LINE 00001045 "        }"
NSQ_SOURCE_LINE 00001046 "        elsif (&_is_open_fh($name)) {  # input arg is an open fh"
NSQ_SOURCE_LINE 00001047 "            ## Use the open fh for logging."
NSQ_SOURCE_LINE 00001048 "            $fh = $name;"
NSQ_SOURCE_LINE 00001049 "            select((select($fh), $|=1)[0]);  # don't buffer writes"
NSQ_SOURCE_LINE 00001050 "        }"
NSQ_SOURCE_LINE 00001051 "        elsif (!ref $name) {  # input arg is filename"
NSQ_SOURCE_LINE 00001052 "            ## Open the file for logging."
NSQ_SOURCE_LINE 00001053 "            $fh = &_fname_to_handle($self, $name)"
NSQ_SOURCE_LINE 00001054 "                or return;"
NSQ_SOURCE_LINE 00001055 "            select((select($fh), $|=1)[0]);  # don't buffer writes"
NSQ_SOURCE_LINE 00001056 "        }"
NSQ_SOURCE_LINE 00001057 "        else {"
NSQ_SOURCE_LINE 00001058 "            return $self->error(\"bad Input_log argument \","
NSQ_SOURCE_LINE 00001059 "                                \"\\\"$name\\\": not filename or open fh\");"
NSQ_SOURCE_LINE 00001060 "        }"
NSQ_SOURCE_LINE 00001061 ""
NSQ_SOURCE_LINE 00001062 "        $s->{inputlog} = $fh;"
NSQ_SOURCE_LINE 00001063 "    }"
NSQ_SOURCE_LINE 00001064 ""
NSQ_SOURCE_LINE 00001065 "    $fh;"
NSQ_SOURCE_LINE 00001066 "} # end sub input_log"
