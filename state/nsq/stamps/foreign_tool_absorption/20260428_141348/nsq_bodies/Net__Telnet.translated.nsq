NSQ_SOURCE_LINE 00002819 "sub _interpret_cr {"
NSQ_SOURCE_LINE 00002820 "    my ($s, $pos) = @_;"
NSQ_SOURCE_LINE 00002821 "    my ("
NSQ_SOURCE_LINE 00002822 "        $nextchar,"
NSQ_SOURCE_LINE 00002823 "        );"
NSQ_SOURCE_LINE 00002824 ""
NSQ_SOURCE_LINE 00002825 "    while (($pos = index($s->{buf}, \"\\015\", $pos)) > -1) {"
NSQ_SOURCE_LINE 00002826 "        $nextchar = substr($s->{buf}, $pos + 1, 1);"
NSQ_SOURCE_LINE 00002827 "        if ($nextchar eq \"\\0\") {"
NSQ_SOURCE_LINE 00002828 "            ## Convert CR NULL to CR when in telnet mode."
NSQ_SOURCE_LINE 00002829 "            if ($s->{telnet_mode}) {"
NSQ_SOURCE_LINE 00002830 "                substr($s->{buf}, $pos + 1, 1) = \"\";"
NSQ_SOURCE_LINE 00002831 "            }"
NSQ_SOURCE_LINE 00002832 "        }"
NSQ_SOURCE_LINE 00002833 "        elsif ($nextchar eq \"\\012\") {"
NSQ_SOURCE_LINE 00002834 "            ## Convert CR LF to newline when not in binary mode."
NSQ_SOURCE_LINE 00002835 "            if (!$s->{bin_mode}) {"
NSQ_SOURCE_LINE 00002836 "                substr($s->{buf}, $pos, 2) = \"\\n\";"
NSQ_SOURCE_LINE 00002837 "            }"
NSQ_SOURCE_LINE 00002838 "        }"
NSQ_SOURCE_LINE 00002839 "        elsif (!length($nextchar) and ($s->{telnet_mode} or !$s->{bin_mode})) {"
NSQ_SOURCE_LINE 00002840 "            ## Save CR in alt buffer for possible CR LF or CR NULL conversion."
NSQ_SOURCE_LINE 00002841 "            $s->{pushback_buf} .= \"\\015\";"
NSQ_SOURCE_LINE 00002842 "            chop $s->{buf};"
NSQ_SOURCE_LINE 00002843 "        }"
NSQ_SOURCE_LINE 00002844 ""
NSQ_SOURCE_LINE 00002845 "        $pos++;"
NSQ_SOURCE_LINE 00002846 "    }"
NSQ_SOURCE_LINE 00002847 ""
NSQ_SOURCE_LINE 00002848 "    1;"
NSQ_SOURCE_LINE 00002849 "} # end sub _interpret_cr"
NSQ_SOURCE_LINE 00002850 ""
NSQ_SOURCE_LINE 00002851 ""
NSQ_SOURCE_LINE 00002852 "sub _interpret_tcmd {"
NSQ_SOURCE_LINE 00002853 "    my ($self, $s, $offset) = @_;"
NSQ_SOURCE_LINE 00002854 "    my ("
NSQ_SOURCE_LINE 00002855 "        $callback,"
NSQ_SOURCE_LINE 00002856 "        $endpos,"
NSQ_SOURCE_LINE 00002857 "        $nextchar,"
NSQ_SOURCE_LINE 00002858 "        $option,"
NSQ_SOURCE_LINE 00002859 "        $parameters,"
NSQ_SOURCE_LINE 00002860 "        $pos,"
NSQ_SOURCE_LINE 00002861 "        $subcmd,"
NSQ_SOURCE_LINE 00002862 "        );"
NSQ_SOURCE_LINE 00002863 "    local $_;"
NSQ_SOURCE_LINE 00002864 ""
NSQ_SOURCE_LINE 00002865 "    ## Parse telnet commands in the data stream."
NSQ_SOURCE_LINE 00002866 "    $pos = $offset;"
NSQ_SOURCE_LINE 00002867 "    while (($pos = index $s->{buf}, \"\\377\", $pos) > -1) {  # unprocessed IAC"
NSQ_SOURCE_LINE 00002868 "        $nextchar = substr $s->{buf}, $pos + 1, 1;"
NSQ_SOURCE_LINE 00002869 ""
NSQ_SOURCE_LINE 00002870 "        ## Save command if it's only partially read."
NSQ_SOURCE_LINE 00002871 "        if (!length $nextchar) {"
NSQ_SOURCE_LINE 00002872 "            $s->{pushback_buf} .= \"\\377\";"
NSQ_SOURCE_LINE 00002873 "            chop $s->{buf};"
NSQ_SOURCE_LINE 00002874 "            last;"
NSQ_SOURCE_LINE 00002875 "        }"
NSQ_SOURCE_LINE 00002876 ""
NSQ_SOURCE_LINE 00002877 "        if ($nextchar eq \"\\377\") {  # IAC is escaping \"\\377\" char"
NSQ_SOURCE_LINE 00002878 "            ## Remove escape char from data stream."
NSQ_SOURCE_LINE 00002879 "            substr($s->{buf}, $pos, 1) = \"\";"
NSQ_SOURCE_LINE 00002880 "            $pos++;"
NSQ_SOURCE_LINE 00002881 "        }"
NSQ_SOURCE_LINE 00002882 "        elsif ($nextchar eq \"\\375\" or $nextchar eq \"\\373\" or"
NSQ_SOURCE_LINE 00002883 "               $nextchar eq \"\\374\" or $nextchar eq \"\\376\") {  # opt negotiation"
NSQ_SOURCE_LINE 00002884 "            $option = substr $s->{buf}, $pos + 2, 1;"
NSQ_SOURCE_LINE 00002885 ""
NSQ_SOURCE_LINE 00002886 "            ## Save command if it's only partially read."
NSQ_SOURCE_LINE 00002887 "            if (!length $option) {"
NSQ_SOURCE_LINE 00002888 "                $s->{pushback_buf} .= \"\\377\" . $nextchar;"
NSQ_SOURCE_LINE 00002889 "                chop $s->{buf};"
NSQ_SOURCE_LINE 00002890 "                chop $s->{buf};"
NSQ_SOURCE_LINE 00002891 "                last;"
NSQ_SOURCE_LINE 00002892 "            }"
NSQ_SOURCE_LINE 00002893 ""
NSQ_SOURCE_LINE 00002894 "            ## Remove command from data stream."
NSQ_SOURCE_LINE 00002895 "            substr($s->{buf}, $pos, 3) = \"\";"
NSQ_SOURCE_LINE 00002896 ""
NSQ_SOURCE_LINE 00002897 "            ## Handle option negotiation."
NSQ_SOURCE_LINE 00002898 "            &_negotiate_recv($self, $s, $nextchar, ord($option), $pos);"
NSQ_SOURCE_LINE 00002899 "        }"
NSQ_SOURCE_LINE 00002900 "        elsif ($nextchar eq \"\\372\") {  # start of subnegotiation parameters"
NSQ_SOURCE_LINE 00002901 "            ## Save command if it's only partially read."
NSQ_SOURCE_LINE 00002902 "            $endpos = index $s->{buf}, \"\\360\", $pos;"
NSQ_SOURCE_LINE 00002903 "            if ($endpos == -1) {"
NSQ_SOURCE_LINE 00002904 "                $s->{pushback_buf} .= substr $s->{buf}, $pos;"
NSQ_SOURCE_LINE 00002905 "                substr($s->{buf}, $pos) = \"\";"
NSQ_SOURCE_LINE 00002906 "                last;"
NSQ_SOURCE_LINE 00002907 "            }"
NSQ_SOURCE_LINE 00002908 ""
NSQ_SOURCE_LINE 00002909 "            ## Remove subnegotiation cmd from buffer."
NSQ_SOURCE_LINE 00002910 "            $subcmd = substr($s->{buf}, $pos, $endpos - $pos + 1);"
NSQ_SOURCE_LINE 00002911 "            substr($s->{buf}, $pos, $endpos - $pos + 1) = \"\";"
NSQ_SOURCE_LINE 00002912 ""
NSQ_SOURCE_LINE 00002913 "            ## Invoke subnegotiation callback."
NSQ_SOURCE_LINE 00002914 "            if ($s->{subopt_cback} and length($subcmd) >= 5) {"
NSQ_SOURCE_LINE 00002915 "                $option = unpack \"C\", substr($subcmd, 2, 1);"
NSQ_SOURCE_LINE 00002916 "                if (length($subcmd) >= 6) {"
NSQ_SOURCE_LINE 00002917 "                    $parameters = substr $subcmd, 3, length($subcmd) - 5;"
NSQ_SOURCE_LINE 00002918 "                }"
NSQ_SOURCE_LINE 00002919 "                else {"
NSQ_SOURCE_LINE 00002920 "                    $parameters = \"\";"
NSQ_SOURCE_LINE 00002921 "                }"
NSQ_SOURCE_LINE 00002922 ""
NSQ_SOURCE_LINE 00002923 "                $callback = $s->{subopt_cback};"
NSQ_SOURCE_LINE 00002924 "                &$callback($self, $option, $parameters);"
NSQ_SOURCE_LINE 00002925 "            }"
NSQ_SOURCE_LINE 00002926 "        }"
NSQ_SOURCE_LINE 00002927 "        else {  # various two char telnet commands"
NSQ_SOURCE_LINE 00002928 "            ## Ignore and remove command from data stream."
NSQ_SOURCE_LINE 00002929 "            substr($s->{buf}, $pos, 2) = \"\";"
NSQ_SOURCE_LINE 00002930 "        }"
NSQ_SOURCE_LINE 00002931 "    }"
NSQ_SOURCE_LINE 00002932 ""
NSQ_SOURCE_LINE 00002933 "    ## Try to send any waiting option negotiation."
NSQ_SOURCE_LINE 00002934 "    if (length $s->{unsent_opts}) {"
NSQ_SOURCE_LINE 00002935 "        &_flush_opts($self);"
NSQ_SOURCE_LINE 00002936 "    }"
NSQ_SOURCE_LINE 00002937 ""
NSQ_SOURCE_LINE 00002938 "    1;"
NSQ_SOURCE_LINE 00002939 "} # end sub _interpret_tcmd"
NSQ_SOURCE_LINE 00002940 ""
NSQ_SOURCE_LINE 00002941 ""
NSQ_SOURCE_LINE 00002942 "sub _is_open_fh {"
NSQ_SOURCE_LINE 00002943 "    my ($fh) = @_;"
NSQ_SOURCE_LINE 00002944 "    my $is_open = '';"
NSQ_SOURCE_LINE 00002945 "    local $@;"
NSQ_SOURCE_LINE 00002946 ""
NSQ_SOURCE_LINE 00002947 "    eval {"
NSQ_SOURCE_LINE 00002948 "        local $SIG{\"__DIE__\"} = \"DEFAULT\";"
NSQ_SOURCE_LINE 00002949 "        $is_open = defined fileno($fh);"
NSQ_SOURCE_LINE 00002950 "    };"
NSQ_SOURCE_LINE 00002951 ""
NSQ_SOURCE_LINE 00002952 "    if (!$is_open and $@) {  # fileno() failed"
NSQ_SOURCE_LINE 00002953 "        ## Check if filehandle is tied and printable."
NSQ_SOURCE_LINE 00002954 "        eval {"
NSQ_SOURCE_LINE 00002955 "            local $SIG{\"__DIE__\"} = \"DEFAULT\";"
NSQ_SOURCE_LINE 00002956 "            $is_open = tied(*$fh) && $fh->can(\"print\");"
NSQ_SOURCE_LINE 00002957 "        };"
NSQ_SOURCE_LINE 00002958 "    }"
NSQ_SOURCE_LINE 00002959 ""
NSQ_SOURCE_LINE 00002960 "    $is_open;"
NSQ_SOURCE_LINE 00002961 "} # end sub _is_open_fh"
NSQ_SOURCE_LINE 00002962 ""
NSQ_SOURCE_LINE 00002963 ""
NSQ_SOURCE_LINE 00002964 "sub _log_dump {"
NSQ_SOURCE_LINE 00002965 "    my ($direction, $fh, $data, $offset, $len) = @_;"
NSQ_SOURCE_LINE 00002966 "    my ("
NSQ_SOURCE_LINE 00002967 "        $addr,"
NSQ_SOURCE_LINE 00002968 "        $hexvals,"
NSQ_SOURCE_LINE 00002969 "        $line,"
NSQ_SOURCE_LINE 00002970 "        );"
NSQ_SOURCE_LINE 00002971 ""
NSQ_SOURCE_LINE 00002972 "    $addr = 0;"
NSQ_SOURCE_LINE 00002973 "    $len = length($$data) - $offset"
NSQ_SOURCE_LINE 00002974 "        if !defined $len;"
NSQ_SOURCE_LINE 00002975 "    return 1 if $len <= 0;"
NSQ_SOURCE_LINE 00002976 ""
NSQ_SOURCE_LINE 00002977 "    ## Print data in dump format."
NSQ_SOURCE_LINE 00002978 "    while ($len > 0) {"
NSQ_SOURCE_LINE 00002979 "        ## Convert up to the next 16 chars to hex, padding w/ spaces."
NSQ_SOURCE_LINE 00002980 "        if ($len >= 16) {"
NSQ_SOURCE_LINE 00002981 "            $line = substr $$data, $offset, 16;"
NSQ_SOURCE_LINE 00002982 "        }"
NSQ_SOURCE_LINE 00002983 "        else {"
NSQ_SOURCE_LINE 00002984 "            $line = substr $$data, $offset, $len;"
NSQ_SOURCE_LINE 00002985 "        }"
NSQ_SOURCE_LINE 00002986 "        $hexvals = unpack(\"H*\", $line);"
NSQ_SOURCE_LINE 00002987 "        $hexvals .= ' ' x (32 - length $hexvals);"
NSQ_SOURCE_LINE 00002988 ""
NSQ_SOURCE_LINE 00002989 "        ## Place in 16 columns, each containing two hex digits."
NSQ_SOURCE_LINE 00002990 "        $hexvals = sprintf(\"%s %s %s %s  \" x 4,"
NSQ_SOURCE_LINE 00002991 "                           unpack(\"a2\" x 16, $hexvals));"
NSQ_SOURCE_LINE 00002992 ""
NSQ_SOURCE_LINE 00002993 "        ## For the ASCII column, change unprintable chars to a period."
NSQ_SOURCE_LINE 00002994 "        $line =~ s/[\\000-\\037,\\177-\\237]/./g;"
NSQ_SOURCE_LINE 00002995 ""
NSQ_SOURCE_LINE 00002996 "        ## Print the line in dump format."
NSQ_SOURCE_LINE 00002997 "        &_log_print($fh, sprintf(\"%s 0x%5.5lx: %s%s\\n\","
NSQ_SOURCE_LINE 00002998 "                                 $direction, $addr, $hexvals, $line));"
NSQ_SOURCE_LINE 00002999 ""
NSQ_SOURCE_LINE 00003000 "        $addr += 16;"
NSQ_SOURCE_LINE 00003001 "        $offset += 16;"
NSQ_SOURCE_LINE 00003002 "        $len -= 16;"
NSQ_SOURCE_LINE 00003003 "    }"
NSQ_SOURCE_LINE 00003004 ""
NSQ_SOURCE_LINE 00003005 "    &_log_print($fh, \"\\n\");"
NSQ_SOURCE_LINE 00003006 ""
NSQ_SOURCE_LINE 00003007 "    1;"
NSQ_SOURCE_LINE 00003008 "} # end sub _log_dump"
NSQ_SOURCE_LINE 00003009 ""
NSQ_SOURCE_LINE 00003010 ""
NSQ_SOURCE_LINE 00003011 "sub _log_option {"
NSQ_SOURCE_LINE 00003012 "    my ($fh, $direction, $request, $option) = @_;"
NSQ_SOURCE_LINE 00003013 "    my ("
NSQ_SOURCE_LINE 00003014 "        $name,"
NSQ_SOURCE_LINE 00003015 "        );"
NSQ_SOURCE_LINE 00003016 ""
NSQ_SOURCE_LINE 00003017 "    if ($option >= 0 and $option <= $#Telopts) {"
NSQ_SOURCE_LINE 00003018 "        $name = $Telopts[$option];"
NSQ_SOURCE_LINE 00003019 "    }"
NSQ_SOURCE_LINE 00003020 "    else {"
NSQ_SOURCE_LINE 00003021 "        $name = $option;"
NSQ_SOURCE_LINE 00003022 "    }"
NSQ_SOURCE_LINE 00003023 ""
NSQ_SOURCE_LINE 00003024 "    &_log_print($fh, \"$direction $request $name\\n\");"
NSQ_SOURCE_LINE 00003025 "} # end sub _log_option"
NSQ_SOURCE_LINE 00003026 ""
NSQ_SOURCE_LINE 00003027 ""
NSQ_SOURCE_LINE 00003028 "sub _log_print {"
NSQ_SOURCE_LINE 00003029 "    my ($fh, $buf) = @_;"
NSQ_SOURCE_LINE 00003030 "    local $\\ = '';"
NSQ_SOURCE_LINE 00003031 ""
NSQ_SOURCE_LINE 00003032 "    if (ref($fh) eq \"GLOB\") {  # fh is GLOB ref"
NSQ_SOURCE_LINE 00003033 "        print $fh $buf;"
NSQ_SOURCE_LINE 00003034 "    }"
NSQ_SOURCE_LINE 00003035 "    else {  # fh isn't GLOB ref"
NSQ_SOURCE_LINE 00003036 "        $fh->print($buf);"
NSQ_SOURCE_LINE 00003037 "    }"
NSQ_SOURCE_LINE 00003038 "} # end sub _log_print"
NSQ_SOURCE_LINE 00003039 ""
NSQ_SOURCE_LINE 00003040 ""
NSQ_SOURCE_LINE 00003041 "sub _match_check {"
NSQ_SOURCE_LINE 00003042 "    my ($self, $code) = @_;"
NSQ_SOURCE_LINE 00003043 "    my $error;"
NSQ_SOURCE_LINE 00003044 "    my @warns = ();"
NSQ_SOURCE_LINE 00003045 "    local $@;"
NSQ_SOURCE_LINE 00003046 ""
NSQ_SOURCE_LINE 00003047 "    ## Use eval to check for syntax errors or warnings."
NSQ_SOURCE_LINE 00003048 "    {"
NSQ_SOURCE_LINE 00003049 "        local $SIG{\"__DIE__\"} = \"DEFAULT\";"
NSQ_SOURCE_LINE 00003050 "        local $SIG{\"__WARN__\"} = sub { push @warns, @_ };"
NSQ_SOURCE_LINE 00003051 "        local $^W = 1;"
NSQ_SOURCE_LINE 00003052 "        local $_ = '';"
NSQ_SOURCE_LINE 00003053 "        eval \"\\$_ =~ $code;\";"
NSQ_SOURCE_LINE 00003054 "    }"
NSQ_SOURCE_LINE 00003055 "    if ($@) {"
NSQ_SOURCE_LINE 00003056 "        ## Remove useless lines numbers from message."
NSQ_SOURCE_LINE 00003057 "        ($error = $@) =~ s/ at \\(eval \\d+\\) line \\d+.?//;"
NSQ_SOURCE_LINE 00003058 "        chomp $error;"
NSQ_SOURCE_LINE 00003059 "        return $self->error(\"bad match operator: $error\");"
NSQ_SOURCE_LINE 00003060 "    }"
NSQ_SOURCE_LINE 00003061 "    elsif (@warns) {"
NSQ_SOURCE_LINE 00003062 "        ## Remove useless lines numbers from message."
NSQ_SOURCE_LINE 00003063 "        ($error = shift @warns) =~ s/ at \\(eval \\d+\\) line \\d+.?//;"
NSQ_SOURCE_LINE 00003064 "        $error =~ s/ while \"strict subs\" in use//;"
NSQ_SOURCE_LINE 00003065 "        chomp $error;"
NSQ_SOURCE_LINE 00003066 "        return $self->error(\"bad match operator: $error\");"
NSQ_SOURCE_LINE 00003067 "    }"
NSQ_SOURCE_LINE 00003068 ""
NSQ_SOURCE_LINE 00003069 "    1;"
NSQ_SOURCE_LINE 00003070 "} # end sub _match_check"
NSQ_SOURCE_LINE 00003071 ""
NSQ_SOURCE_LINE 00003072 ""
NSQ_SOURCE_LINE 00003073 "sub _negotiate_callback {"
NSQ_SOURCE_LINE 00003074 "    my ($self, $opt, $is_remote, $is_enabled, $was_enabled, $opt_bufpos) = @_;"
NSQ_SOURCE_LINE 00003075 "    my ("
NSQ_SOURCE_LINE 00003076 "        $callback,"
NSQ_SOURCE_LINE 00003077 "        $s,"
NSQ_SOURCE_LINE 00003078 "        );"
NSQ_SOURCE_LINE 00003079 "    local $_;"
NSQ_SOURCE_LINE 00003080 ""
NSQ_SOURCE_LINE 00003081 "    ## Keep track of remote echo."
NSQ_SOURCE_LINE 00003082 "    if ($is_remote and $opt == &TELOPT_ECHO) {  # received WILL or WONT ECHO"
NSQ_SOURCE_LINE 00003083 "        $s = *$self->{net_telnet};"
NSQ_SOURCE_LINE 00003084 ""
NSQ_SOURCE_LINE 00003085 "        if ($is_enabled and !$was_enabled) {  # received WILL ECHO"
NSQ_SOURCE_LINE 00003086 "            $s->{remote_echo} = 1;"
NSQ_SOURCE_LINE 00003087 "        }"
NSQ_SOURCE_LINE 00003088 "        elsif (!$is_enabled and $was_enabled) {  # received WONT ECHO"
NSQ_SOURCE_LINE 00003089 "            $s->{remote_echo} = '';"
NSQ_SOURCE_LINE 00003090 "        }"
NSQ_SOURCE_LINE 00003091 "    }"
NSQ_SOURCE_LINE 00003092 ""
NSQ_SOURCE_LINE 00003093 "    ## Invoke callback, if there is one."
NSQ_SOURCE_LINE 00003094 "    $callback = $self->option_callback;"
NSQ_SOURCE_LINE 00003095 "    if ($callback) {"
NSQ_SOURCE_LINE 00003096 "        &$callback($self, $opt, $is_remote,"
NSQ_SOURCE_LINE 00003097 "                   $is_enabled, $was_enabled, $opt_bufpos);"
NSQ_SOURCE_LINE 00003098 "    }"
NSQ_SOURCE_LINE 00003099 ""
NSQ_SOURCE_LINE 00003100 "    1;"
NSQ_SOURCE_LINE 00003101 "} # end sub _negotiate_callback"
NSQ_SOURCE_LINE 00003102 ""
NSQ_SOURCE_LINE 00003103 ""
NSQ_SOURCE_LINE 00003104 "sub _negotiate_recv {"
NSQ_SOURCE_LINE 00003105 "    my ($self, $s, $opt_request, $opt, $opt_bufpos) = @_;"
NSQ_SOURCE_LINE 00003106 ""
NSQ_SOURCE_LINE 00003107 "    ## Ensure data structure exists for this option."
NSQ_SOURCE_LINE 00003108 "    unless (defined $s->{opts}{$opt}) {"
NSQ_SOURCE_LINE 00003109 "        &_set_default_option($s, $opt);"
NSQ_SOURCE_LINE 00003110 "    }"
NSQ_SOURCE_LINE 00003111 ""
NSQ_SOURCE_LINE 00003112 "    ## Process the option."
NSQ_SOURCE_LINE 00003113 "    if ($opt_request eq \"\\376\") {  # DONT"
NSQ_SOURCE_LINE 00003114 "        &_negotiate_recv_disable($self, $s, $opt, \"dont\", $opt_bufpos,"
NSQ_SOURCE_LINE 00003115 "                                 $s->{opts}{$opt}{local_enable_ok},"
NSQ_SOURCE_LINE 00003116 "                                 \\$s->{opts}{$opt}{local_enabled},"
NSQ_SOURCE_LINE 00003117 "                                 \\$s->{opts}{$opt}{local_state});"
NSQ_SOURCE_LINE 00003118 "    }"
NSQ_SOURCE_LINE 00003119 "    elsif ($opt_request eq \"\\375\") {  # DO"
NSQ_SOURCE_LINE 00003120 "        &_negotiate_recv_enable($self, $s, $opt, \"do\", $opt_bufpos,"
NSQ_SOURCE_LINE 00003121 "                                $s->{opts}{$opt}{local_enable_ok},"
NSQ_SOURCE_LINE 00003122 "                                \\$s->{opts}{$opt}{local_enabled},"
NSQ_SOURCE_LINE 00003123 "                                \\$s->{opts}{$opt}{local_state});"
NSQ_SOURCE_LINE 00003124 "    }"
NSQ_SOURCE_LINE 00003125 "    elsif ($opt_request eq \"\\374\") {  # WONT"
NSQ_SOURCE_LINE 00003126 "        &_negotiate_recv_disable($self, $s, $opt, \"wont\", $opt_bufpos,"
NSQ_SOURCE_LINE 00003127 "                                 $s->{opts}{$opt}{remote_enable_ok},"
NSQ_SOURCE_LINE 00003128 "                                 \\$s->{opts}{$opt}{remote_enabled},"
NSQ_SOURCE_LINE 00003129 "                                 \\$s->{opts}{$opt}{remote_state});"
NSQ_SOURCE_LINE 00003130 "    }"
NSQ_SOURCE_LINE 00003131 "    elsif ($opt_request eq \"\\373\") {  # WILL"
NSQ_SOURCE_LINE 00003132 "        &_negotiate_recv_enable($self, $s, $opt, \"will\", $opt_bufpos,"
NSQ_SOURCE_LINE 00003133 "                                $s->{opts}{$opt}{remote_enable_ok},"
NSQ_SOURCE_LINE 00003134 "                                \\$s->{opts}{$opt}{remote_enabled},"
NSQ_SOURCE_LINE 00003135 "                                \\$s->{opts}{$opt}{remote_state});"
NSQ_SOURCE_LINE 00003136 "    }"
NSQ_SOURCE_LINE 00003137 "    else {  # internal error"
NSQ_SOURCE_LINE 00003138 "        die;"
NSQ_SOURCE_LINE 00003139 "    }"
NSQ_SOURCE_LINE 00003140 ""
NSQ_SOURCE_LINE 00003141 "    1;"
NSQ_SOURCE_LINE 00003142 "} # end sub _negotiate_recv"
NSQ_SOURCE_LINE 00003143 ""
NSQ_SOURCE_LINE 00003144 ""
NSQ_SOURCE_LINE 00003145 "sub _negotiate_recv_disable {"
NSQ_SOURCE_LINE 00003146 "    my ($self, $s, $opt, $opt_request,"
NSQ_SOURCE_LINE 00003147 "        $opt_bufpos, $enable_ok, $is_enabled, $state) = @_;"
NSQ_SOURCE_LINE 00003148 "    my ("
NSQ_SOURCE_LINE 00003149 "        $ack,"
NSQ_SOURCE_LINE 00003150 "        $disable_cmd,"
NSQ_SOURCE_LINE 00003151 "        $enable_cmd,"
NSQ_SOURCE_LINE 00003152 "        $is_remote,"
NSQ_SOURCE_LINE 00003153 "        $nak,"
NSQ_SOURCE_LINE 00003154 "        $was_enabled,"
NSQ_SOURCE_LINE 00003155 "        );"
NSQ_SOURCE_LINE 00003156 ""
NSQ_SOURCE_LINE 00003157 "    ## What do we use to request enable/disable or respond with ack/nak."
NSQ_SOURCE_LINE 00003158 "    if ($opt_request eq \"wont\") {"
NSQ_SOURCE_LINE 00003159 "        $enable_cmd  = \"\\377\\375\" . pack(\"C\", $opt);  # do command"
NSQ_SOURCE_LINE 00003160 "        $disable_cmd = \"\\377\\376\" . pack(\"C\", $opt);  # dont command"
NSQ_SOURCE_LINE 00003161 "        $is_remote = 1;"
NSQ_SOURCE_LINE 00003162 "        $ack = \"DO\";"
NSQ_SOURCE_LINE 00003163 "        $nak = \"DONT\";"
NSQ_SOURCE_LINE 00003164 ""
NSQ_SOURCE_LINE 00003165 "        &_log_option($s->{opt_log}, \"RCVD\", \"WONT\", $opt)"
NSQ_SOURCE_LINE 00003166 "            if $s->{opt_log};"
NSQ_SOURCE_LINE 00003167 "    }"
NSQ_SOURCE_LINE 00003168 "    elsif ($opt_request eq \"dont\") {"
NSQ_SOURCE_LINE 00003169 "        $enable_cmd  = \"\\377\\373\" . pack(\"C\", $opt);  # will command"
NSQ_SOURCE_LINE 00003170 "        $disable_cmd = \"\\377\\374\" . pack(\"C\", $opt);  # wont command"
NSQ_SOURCE_LINE 00003171 "        $is_remote = '';"
NSQ_SOURCE_LINE 00003172 "        $ack = \"WILL\";"
NSQ_SOURCE_LINE 00003173 "        $nak = \"WONT\";"
NSQ_SOURCE_LINE 00003174 ""
NSQ_SOURCE_LINE 00003175 "        &_log_option($s->{opt_log}, \"RCVD\", \"DONT\", $opt)"
NSQ_SOURCE_LINE 00003176 "            if $s->{opt_log};"
NSQ_SOURCE_LINE 00003177 "    }"
NSQ_SOURCE_LINE 00003178 "    else {  # internal error"
NSQ_SOURCE_LINE 00003179 "        die;"
NSQ_SOURCE_LINE 00003180 "    }"
NSQ_SOURCE_LINE 00003181 ""
NSQ_SOURCE_LINE 00003182 "    ## Respond to WONT or DONT based on the current negotiation state."
NSQ_SOURCE_LINE 00003183 "    if ($$state eq \"no\") {  # state is already disabled"
NSQ_SOURCE_LINE 00003184 "    }"
NSQ_SOURCE_LINE 00003185 "    elsif ($$state eq \"yes\") {  # they're initiating disable"
NSQ_SOURCE_LINE 00003186 "        $$is_enabled = '';"
NSQ_SOURCE_LINE 00003187 "        $$state = \"no\";"
NSQ_SOURCE_LINE 00003188 ""
NSQ_SOURCE_LINE 00003189 "        ## Send positive acknowledgment."
NSQ_SOURCE_LINE 00003190 "        $s->{unsent_opts} .= $disable_cmd;"
NSQ_SOURCE_LINE 00003191 "        &_log_option($s->{opt_log}, \"SENT\", $nak, $opt)"
NSQ_SOURCE_LINE 00003192 "            if $s->{opt_log};"
NSQ_SOURCE_LINE 00003193 ""
NSQ_SOURCE_LINE 00003194 "        ## Invoke callbacks."
NSQ_SOURCE_LINE 00003195 "        &_negotiate_callback($self, $opt, $is_remote,"
NSQ_SOURCE_LINE 00003196 "                             $$is_enabled, $was_enabled, $opt_bufpos);"
NSQ_SOURCE_LINE 00003197 "    }"
NSQ_SOURCE_LINE 00003198 "    elsif ($$state eq \"wantno\") {  # they sent positive ack"
NSQ_SOURCE_LINE 00003199 "        $$is_enabled = '';"
NSQ_SOURCE_LINE 00003200 "        $$state = \"no\";"
NSQ_SOURCE_LINE 00003201 ""
NSQ_SOURCE_LINE 00003202 "        ## Invoke callback."
NSQ_SOURCE_LINE 00003203 "        &_negotiate_callback($self, $opt, $is_remote,"
NSQ_SOURCE_LINE 00003204 "                             $$is_enabled, $was_enabled, $opt_bufpos);"
NSQ_SOURCE_LINE 00003205 "    }"
NSQ_SOURCE_LINE 00003206 "    elsif ($$state eq \"wantno opposite\") {  # pos ack but we changed our mind"
NSQ_SOURCE_LINE 00003207 "        ## Indicate disabled but now we want to enable."
NSQ_SOURCE_LINE 00003208 "        $$is_enabled = '';"
NSQ_SOURCE_LINE 00003209 "        $$state = \"wantyes\";"
NSQ_SOURCE_LINE 00003210 ""
NSQ_SOURCE_LINE 00003211 "        ## Send queued request."
NSQ_SOURCE_LINE 00003212 "        $s->{unsent_opts} .= $enable_cmd;"
NSQ_SOURCE_LINE 00003213 "        &_log_option($s->{opt_log}, \"SENT\", $ack, $opt)"
NSQ_SOURCE_LINE 00003214 "            if $s->{opt_log};"
NSQ_SOURCE_LINE 00003215 ""
NSQ_SOURCE_LINE 00003216 "        ## Invoke callback."
NSQ_SOURCE_LINE 00003217 "        &_negotiate_callback($self, $opt, $is_remote,"
NSQ_SOURCE_LINE 00003218 "                             $$is_enabled, $was_enabled, $opt_bufpos);"
NSQ_SOURCE_LINE 00003219 "    }"
NSQ_SOURCE_LINE 00003220 "    elsif ($$state eq \"wantyes\") {  # they sent negative ack"
NSQ_SOURCE_LINE 00003221 "        $$is_enabled = '';"
NSQ_SOURCE_LINE 00003222 "        $$state = \"no\";"
NSQ_SOURCE_LINE 00003223 ""
NSQ_SOURCE_LINE 00003224 "        ## Invoke callback."
NSQ_SOURCE_LINE 00003225 "        &_negotiate_callback($self, $opt, $is_remote,"
NSQ_SOURCE_LINE 00003226 "                             $$is_enabled, $was_enabled, $opt_bufpos);"
NSQ_SOURCE_LINE 00003227 "    }"
NSQ_SOURCE_LINE 00003228 "    elsif ($$state eq \"wantyes opposite\") {  # nak but we changed our mind"
NSQ_SOURCE_LINE 00003229 "        $$is_enabled = '';"
NSQ_SOURCE_LINE 00003230 "        $$state = \"no\";"
NSQ_SOURCE_LINE 00003231 ""
NSQ_SOURCE_LINE 00003232 "        ## Invoke callback."
NSQ_SOURCE_LINE 00003233 "        &_negotiate_callback($self, $opt, $is_remote,"
NSQ_SOURCE_LINE 00003234 "                             $$is_enabled, $was_enabled, $opt_bufpos);"
NSQ_SOURCE_LINE 00003235 "    }"
NSQ_SOURCE_LINE 00003236 "} # end sub _negotiate_recv_disable"
NSQ_SOURCE_LINE 00003237 ""
NSQ_SOURCE_LINE 00003238 ""
NSQ_SOURCE_LINE 00003239 "sub _negotiate_recv_enable {"
NSQ_SOURCE_LINE 00003240 "    my ($self, $s, $opt, $opt_request,"
NSQ_SOURCE_LINE 00003241 "        $opt_bufpos, $enable_ok, $is_enabled, $state) = @_;"
NSQ_SOURCE_LINE 00003242 "    my ("
NSQ_SOURCE_LINE 00003243 "        $ack,"
NSQ_SOURCE_LINE 00003244 "        $disable_cmd,"
NSQ_SOURCE_LINE 00003245 "        $enable_cmd,"
NSQ_SOURCE_LINE 00003246 "        $is_remote,"
NSQ_SOURCE_LINE 00003247 "        $nak,"
NSQ_SOURCE_LINE 00003248 "        $was_enabled,"
NSQ_SOURCE_LINE 00003249 "        );"
NSQ_SOURCE_LINE 00003250 ""
NSQ_SOURCE_LINE 00003251 "    ## What we use to send enable/disable request or send ack/nak response."
NSQ_SOURCE_LINE 00003252 "    if ($opt_request eq \"will\") {"
NSQ_SOURCE_LINE 00003253 "        $enable_cmd  = \"\\377\\375\" . pack(\"C\", $opt);  # do command"
NSQ_SOURCE_LINE 00003254 "        $disable_cmd = \"\\377\\376\" . pack(\"C\", $opt);  # dont command"
NSQ_SOURCE_LINE 00003255 "        $is_remote = 1;"
NSQ_SOURCE_LINE 00003256 "        $ack = \"DO\";"
NSQ_SOURCE_LINE 00003257 "        $nak = \"DONT\";"
NSQ_SOURCE_LINE 00003258 ""
NSQ_SOURCE_LINE 00003259 "        &_log_option($s->{opt_log}, \"RCVD\", \"WILL\", $opt)"
NSQ_SOURCE_LINE 00003260 "            if $s->{opt_log};"
NSQ_SOURCE_LINE 00003261 "    }"
NSQ_SOURCE_LINE 00003262 "    elsif ($opt_request eq \"do\") {"
NSQ_SOURCE_LINE 00003263 "        $enable_cmd  = \"\\377\\373\" . pack(\"C\", $opt);  # will command"
NSQ_SOURCE_LINE 00003264 "        $disable_cmd = \"\\377\\374\" . pack(\"C\", $opt);  # wont command"
NSQ_SOURCE_LINE 00003265 "        $is_remote = '';"
NSQ_SOURCE_LINE 00003266 "        $ack = \"WILL\";"
NSQ_SOURCE_LINE 00003267 "        $nak = \"WONT\";"
NSQ_SOURCE_LINE 00003268 ""
NSQ_SOURCE_LINE 00003269 "        &_log_option($s->{opt_log}, \"RCVD\", \"DO\", $opt)"
NSQ_SOURCE_LINE 00003270 "            if $s->{opt_log};"
NSQ_SOURCE_LINE 00003271 "    }"
NSQ_SOURCE_LINE 00003272 "    else {  # internal error"
NSQ_SOURCE_LINE 00003273 "        die;"
NSQ_SOURCE_LINE 00003274 "    }"
NSQ_SOURCE_LINE 00003275 ""
NSQ_SOURCE_LINE 00003276 "    ## Save current enabled state."
NSQ_SOURCE_LINE 00003277 "    $was_enabled = $$is_enabled;"
NSQ_SOURCE_LINE 00003278 ""
NSQ_SOURCE_LINE 00003279 "    ## Respond to WILL or DO based on the current negotiation state."
NSQ_SOURCE_LINE 00003280 "    if ($$state eq \"no\") {  # they're initiating enable"
NSQ_SOURCE_LINE 00003281 "        if ($enable_ok) {  # we agree they/us should enable"
NSQ_SOURCE_LINE 00003282 "            $$is_enabled = 1;"
NSQ_SOURCE_LINE 00003283 "            $$state = \"yes\";"
NSQ_SOURCE_LINE 00003284 ""
NSQ_SOURCE_LINE 00003285 "            ## Send positive acknowledgment."
NSQ_SOURCE_LINE 00003286 "            $s->{unsent_opts} .= $enable_cmd;"
NSQ_SOURCE_LINE 00003287 "            &_log_option($s->{opt_log}, \"SENT\", $ack, $opt)"
NSQ_SOURCE_LINE 00003288 "                if $s->{opt_log};"
NSQ_SOURCE_LINE 00003289 ""
NSQ_SOURCE_LINE 00003290 "            ## Invoke callbacks."
NSQ_SOURCE_LINE 00003291 "            &_negotiate_callback($self, $opt, $is_remote,"
NSQ_SOURCE_LINE 00003292 "                                 $$is_enabled, $was_enabled, $opt_bufpos);"
NSQ_SOURCE_LINE 00003293 "        }"
NSQ_SOURCE_LINE 00003294 "        else {  # we disagree they/us should enable"
NSQ_SOURCE_LINE 00003295 "            ## Send negative acknowledgment."
NSQ_SOURCE_LINE 00003296 "            $s->{unsent_opts} .= $disable_cmd;"
NSQ_SOURCE_LINE 00003297 "            &_log_option($s->{opt_log}, \"SENT\", $nak, $opt)"
NSQ_SOURCE_LINE 00003298 "                if $s->{opt_log};"
NSQ_SOURCE_LINE 00003299 "        }"
NSQ_SOURCE_LINE 00003300 "    }"
NSQ_SOURCE_LINE 00003301 "    elsif ($$state eq \"yes\") {  # state is already enabled"
NSQ_SOURCE_LINE 00003302 "    }"
NSQ_SOURCE_LINE 00003303 "    elsif ($$state eq \"wantno\") {  # error: our disable req answered by enable"
NSQ_SOURCE_LINE 00003304 "        $$is_enabled = '';"
NSQ_SOURCE_LINE 00003305 "        $$state = \"no\";"
NSQ_SOURCE_LINE 00003306 ""
NSQ_SOURCE_LINE 00003307 "        ## Invoke callbacks."
NSQ_SOURCE_LINE 00003308 "        &_negotiate_callback($self, $opt, $is_remote,"
NSQ_SOURCE_LINE 00003309 "                             $$is_enabled, $was_enabled, $opt_bufpos);"
NSQ_SOURCE_LINE 00003310 "    }"
NSQ_SOURCE_LINE 00003311 "    elsif ($$state eq \"wantno opposite\") { # err: disable req answerd by enable"
NSQ_SOURCE_LINE 00003312 "        $$is_enabled = 1;"
NSQ_SOURCE_LINE 00003313 "        $$state = \"yes\";"
NSQ_SOURCE_LINE 00003314 ""
NSQ_SOURCE_LINE 00003315 "        ## Invoke callbacks."
NSQ_SOURCE_LINE 00003316 "        &_negotiate_callback($self, $opt, $is_remote,"
NSQ_SOURCE_LINE 00003317 "                             $$is_enabled, $was_enabled, $opt_bufpos);"
NSQ_SOURCE_LINE 00003318 "    }"
NSQ_SOURCE_LINE 00003319 "    elsif ($$state eq \"wantyes\") {  # they sent pos ack"
NSQ_SOURCE_LINE 00003320 "        $$is_enabled = 1;"
NSQ_SOURCE_LINE 00003321 "        $$state = \"yes\";"
NSQ_SOURCE_LINE 00003322 ""
NSQ_SOURCE_LINE 00003323 "        ## Invoke callback."
NSQ_SOURCE_LINE 00003324 "        &_negotiate_callback($self, $opt, $is_remote,"
NSQ_SOURCE_LINE 00003325 "                             $$is_enabled, $was_enabled, $opt_bufpos);"
NSQ_SOURCE_LINE 00003326 "    }"
NSQ_SOURCE_LINE 00003327 "    elsif ($$state eq \"wantyes opposite\") {  # pos ack but we changed our mind"
NSQ_SOURCE_LINE 00003328 "        ## Indicate enabled but now we want to disable."
NSQ_SOURCE_LINE 00003329 "        $$is_enabled = 1;"
NSQ_SOURCE_LINE 00003330 "        $$state = \"wantno\";"
NSQ_SOURCE_LINE 00003331 ""
NSQ_SOURCE_LINE 00003332 "        ## Inform other side we changed our mind."
NSQ_SOURCE_LINE 00003333 "        $s->{unsent_opts} .= $disable_cmd;"
NSQ_SOURCE_LINE 00003334 "        &_log_option($s->{opt_log}, \"SENT\", $nak, $opt)"
NSQ_SOURCE_LINE 00003335 "            if $s->{opt_log};"
NSQ_SOURCE_LINE 00003336 ""
NSQ_SOURCE_LINE 00003337 "        ## Invoke callback."
NSQ_SOURCE_LINE 00003338 "        &_negotiate_callback($self, $opt, $is_remote,"
NSQ_SOURCE_LINE 00003339 "                             $$is_enabled, $was_enabled, $opt_bufpos);"
NSQ_SOURCE_LINE 00003340 "    }"
NSQ_SOURCE_LINE 00003341 ""
NSQ_SOURCE_LINE 00003342 "    1;"
NSQ_SOURCE_LINE 00003343 "} # end sub _negotiate_recv_enable"
NSQ_SOURCE_LINE 00003344 ""
NSQ_SOURCE_LINE 00003345 ""
NSQ_SOURCE_LINE 00003346 "sub _new_handle {"
NSQ_SOURCE_LINE 00003347 "    if ($INC{\"IO/Handle.pm\"}) {"
NSQ_SOURCE_LINE 00003348 "        return IO::Handle->new;"
NSQ_SOURCE_LINE 00003349 "    }"
NSQ_SOURCE_LINE 00003350 "    else {"
NSQ_SOURCE_LINE 00003351 "        &_import_filehandle;"
NSQ_SOURCE_LINE 00003352 "        return FileHandle->new;"
NSQ_SOURCE_LINE 00003353 "    }"
NSQ_SOURCE_LINE 00003354 "} # end sub _new_handle"
NSQ_SOURCE_LINE 00003355 ""
NSQ_SOURCE_LINE 00003356 ""
NSQ_SOURCE_LINE 00003357 "sub _next_getlines {"
NSQ_SOURCE_LINE 00003358 "    my ($self, $s) = @_;"
NSQ_SOURCE_LINE 00003359 "    my ("
NSQ_SOURCE_LINE 00003360 "        $len,"
NSQ_SOURCE_LINE 00003361 "        $line,"
NSQ_SOURCE_LINE 00003362 "        $pos,"
NSQ_SOURCE_LINE 00003363 "        @lines,"
NSQ_SOURCE_LINE 00003364 "        );"
NSQ_SOURCE_LINE 00003365 ""
NSQ_SOURCE_LINE 00003366 "    ## Fill buffer and get first line."
NSQ_SOURCE_LINE 00003367 "    $line = $self->getline"
NSQ_SOURCE_LINE 00003368 "        or return;"
NSQ_SOURCE_LINE 00003369 "    push @lines, $line;"
NSQ_SOURCE_LINE 00003370 ""
NSQ_SOURCE_LINE 00003371 "    ## Extract subsequent lines from buffer."
NSQ_SOURCE_LINE 00003372 "    while (($pos = index($s->{buf}, $s->{\"rs\"})) != -1) {"
NSQ_SOURCE_LINE 00003373 "        $len = $pos + length $s->{\"rs\"};"
NSQ_SOURCE_LINE 00003374 "        push @lines, substr($s->{buf}, 0, $len);"
NSQ_SOURCE_LINE 00003375 "        substr($s->{buf}, 0, $len) = \"\";"
NSQ_SOURCE_LINE 00003376 "    }"
NSQ_SOURCE_LINE 00003377 ""
NSQ_SOURCE_LINE 00003378 "    @lines;"
NSQ_SOURCE_LINE 00003379 "} # end sub _next_getlines"
NSQ_SOURCE_LINE 00003380 ""
NSQ_SOURCE_LINE 00003381 ""
NSQ_SOURCE_LINE 00003382 "sub _opt_accept {"
NSQ_SOURCE_LINE 00003383 "    my ($self, @args) = @_;"
NSQ_SOURCE_LINE 00003384 "    my ("
NSQ_SOURCE_LINE 00003385 "        $arg,"
NSQ_SOURCE_LINE 00003386 "        $option,"
NSQ_SOURCE_LINE 00003387 "        $s,"
NSQ_SOURCE_LINE 00003388 "        );"
NSQ_SOURCE_LINE 00003389 ""
NSQ_SOURCE_LINE 00003390 "    ## Init."
NSQ_SOURCE_LINE 00003391 "    $s = *$self->{net_telnet};"
NSQ_SOURCE_LINE 00003392 ""
NSQ_SOURCE_LINE 00003393 "    foreach $arg (@args) {"
NSQ_SOURCE_LINE 00003394 "        ## Ensure data structure defined for this option."
NSQ_SOURCE_LINE 00003395 "        $option = $arg->{option};"
NSQ_SOURCE_LINE 00003396 "        if (!defined $s->{opts}{$option}) {"
NSQ_SOURCE_LINE 00003397 "            &_set_default_option($s, $option);"
NSQ_SOURCE_LINE 00003398 "        }"
NSQ_SOURCE_LINE 00003399 ""
NSQ_SOURCE_LINE 00003400 "        ## Save whether we'll accept or reject this option."
NSQ_SOURCE_LINE 00003401 "        if ($arg->{is_remote}) {"
NSQ_SOURCE_LINE 00003402 "            $s->{opts}{$option}{remote_enable_ok} = $arg->{is_enable};"
NSQ_SOURCE_LINE 00003403 "        }"
NSQ_SOURCE_LINE 00003404 "        else {"
NSQ_SOURCE_LINE 00003405 "            $s->{opts}{$option}{local_enable_ok} = $arg->{is_enable};"
NSQ_SOURCE_LINE 00003406 "        }"
NSQ_SOURCE_LINE 00003407 "    }"
NSQ_SOURCE_LINE 00003408 ""
NSQ_SOURCE_LINE 00003409 "    1;"
NSQ_SOURCE_LINE 00003410 "} # end sub _opt_accept"
NSQ_SOURCE_LINE 00003411 ""
NSQ_SOURCE_LINE 00003412 ""
NSQ_SOURCE_LINE 00003413 "sub _optimal_blksize {"
NSQ_SOURCE_LINE 00003414 "    my ($blksize) = @_;"
NSQ_SOURCE_LINE 00003415 "    local $^W = '';  # avoid non-numeric warning for ms-windows blksize of \"\""
NSQ_SOURCE_LINE 00003416 ""
NSQ_SOURCE_LINE 00003417 "    ## Use default when block size is invalid."
NSQ_SOURCE_LINE 00003418 "    if (!defined $blksize or $blksize < 512 or $blksize > 1_048_576) {"
NSQ_SOURCE_LINE 00003419 "        $blksize = 4096;"
NSQ_SOURCE_LINE 00003420 "    }"
NSQ_SOURCE_LINE 00003421 ""
NSQ_SOURCE_LINE 00003422 "    $blksize;"
NSQ_SOURCE_LINE 00003423 "} # end sub _optimal_blksize"
NSQ_SOURCE_LINE 00003424 ""
NSQ_SOURCE_LINE 00003425 ""
