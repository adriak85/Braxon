BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "use strict;"
NSQ_SOURCE_LINE 00000002 "use warnings;"
NSQ_SOURCE_LINE 00000003 "package IPC::Run3;"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "=head1 NAME"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "IPC::Run3 - run a subprocess with input/output redirection"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "=head1 VERSION"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "version 0.049"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "=cut"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "our $VERSION = '0.049';"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "    use IPC::Run3;    # Exports run3() by default"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "    run3 \\@cmd, \\$in, \\$out, \\$err;"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "This module allows you to run a subprocess and redirect stdin, stdout,"
NSQ_SOURCE_LINE 00000026 "and/or stderr to files and perl data structures.  It aims to satisfy 99% of the"
NSQ_SOURCE_LINE 00000027 "need for using C<system>, C<qx>, and C<open3>"
NSQ_SOURCE_LINE 00000028 "with a simple, extremely Perlish API."
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "Speed, simplicity, and portability are paramount.  (That's speed of Perl code;"
NSQ_SOURCE_LINE 00000031 "which is often much slower than the kind of buffered I/O that this module uses"
NSQ_SOURCE_LINE 00000032 "to spool input to and output from the child command.)"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "=cut"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "use Exporter;"
NSQ_SOURCE_LINE 00000037 "our @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000038 "our @EXPORT = qw( run3 );"
NSQ_SOURCE_LINE 00000039 "our %EXPORT_TAGS = ( all => \\@EXPORT );"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "use constant debugging => $ENV{IPCRUN3DEBUG} || $ENV{IPCRUNDEBUG} || 0;"
NSQ_SOURCE_LINE 00000042 "use constant profiling => $ENV{IPCRUN3PROFILE} || $ENV{IPCRUNPROFILE} || 0;"
NSQ_SOURCE_LINE 00000043 "use constant is_win32  => 0 <= index $^O, \"Win32\";"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "BEGIN {"
NSQ_SOURCE_LINE 00000046 "   if ( is_win32 ) {"
NSQ_SOURCE_LINE 00000047 "      eval \"use Win32 qw( GetOSName ); use Win32::ShellQuote qw(quote_native); 1\" or die $@;"
NSQ_SOURCE_LINE 00000048 "   }"
NSQ_SOURCE_LINE 00000049 "}"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "#use constant is_win2k => is_win32 && GetOSName() =~ /Win2000/i;"
NSQ_SOURCE_LINE 00000052 "#use constant is_winXP => is_win32 && GetOSName() =~ /WinXP/i;"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "use Carp qw( croak );"
NSQ_SOURCE_LINE 00000055 "use File::Temp qw( tempfile );"
NSQ_SOURCE_LINE 00000056 "use POSIX qw( dup dup2 );"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "# We cache the handles of our temp files in order to"
NSQ_SOURCE_LINE 00000059 "# keep from having to incur the (largish) overhead of File::Temp"
NSQ_SOURCE_LINE 00000060 "my %fh_cache;"
NSQ_SOURCE_LINE 00000061 "my $fh_cache_pid = $$;"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "my $profiler;"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "sub _profiler { $profiler } # test suite access"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "BEGIN {"
NSQ_SOURCE_LINE 00000068 "    if ( profiling ) {"
NSQ_SOURCE_LINE 00000069 "        eval \"use Time::HiRes qw( gettimeofday ); 1\" or die $@;"
NSQ_SOURCE_LINE 00000070 "        if ( $ENV{IPCRUN3PROFILE} =~ /\\A\\d+\\z/ ) {"
NSQ_SOURCE_LINE 00000071 "            require IPC::Run3::ProfPP;"
NSQ_SOURCE_LINE 00000072 "            IPC::Run3::ProfPP->import;"
NSQ_SOURCE_LINE 00000073 "            $profiler = IPC::Run3::ProfPP->new(Level => $ENV{IPCRUN3PROFILE});"
NSQ_SOURCE_LINE 00000074 "        } else {"
NSQ_SOURCE_LINE 00000075 "            my ( $dest, undef, $class ) ="
NSQ_SOURCE_LINE 00000076 "               reverse split /(=)/, $ENV{IPCRUN3PROFILE}, 2;"
NSQ_SOURCE_LINE 00000077 "            $class = \"IPC::Run3::ProfLogger\""
NSQ_SOURCE_LINE 00000078 "                unless defined $class && length $class;"
NSQ_SOURCE_LINE 00000079 "            if ( not eval \"require $class\" ) {"
NSQ_SOURCE_LINE 00000080 "                my $e = $@;"
NSQ_SOURCE_LINE 00000081 "                $class = \"IPC::Run3::$class\";"
NSQ_SOURCE_LINE 00000082 "                eval \"require IPC::Run3::$class\" or die $e;"
NSQ_SOURCE_LINE 00000083 "            }"
NSQ_SOURCE_LINE 00000084 "            $profiler = $class->new( Destination => $dest );"
NSQ_SOURCE_LINE 00000085 "        }"
NSQ_SOURCE_LINE 00000086 "        $profiler->app_call( [ $0, @ARGV ], scalar gettimeofday() );"
NSQ_SOURCE_LINE 00000087 "    }"
NSQ_SOURCE_LINE 00000088 "}"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "END {"
NSQ_SOURCE_LINE 00000092 "    $profiler->app_exit( scalar gettimeofday() ) if profiling;"
NSQ_SOURCE_LINE 00000093 "}"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "sub _binmode {"
NSQ_SOURCE_LINE 00000096 "    my ( $fh, $mode, $what ) = @_;"
NSQ_SOURCE_LINE 00000097 "    # if $mode is not given, then default to \":raw\", except on Windows,"
NSQ_SOURCE_LINE 00000098 "    # where we default to \":crlf\";"
NSQ_SOURCE_LINE 00000099 "    # otherwise if a proper layer string was given, use that,"
NSQ_SOURCE_LINE 00000100 "    # else use \":raw\""
NSQ_SOURCE_LINE 00000101 "    my $layer = !$mode"
NSQ_SOURCE_LINE 00000102 "       ? (is_win32 ? \":crlf\" : \":raw\")"
NSQ_SOURCE_LINE 00000103 "       : ($mode =~ /^:/ ? $mode : \":raw\");"
NSQ_SOURCE_LINE 00000104 "    warn \"binmode $what, $layer\\n\" if debugging >= 2;"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "    binmode $fh, \":raw\" unless $layer eq \":raw\";      # remove all layers first"
NSQ_SOURCE_LINE 00000107 "    binmode $fh, $layer or croak \"binmode $layer failed: $!\";"
NSQ_SOURCE_LINE 00000108 "}"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "sub _spool_data_to_child {"
NSQ_SOURCE_LINE 00000111 "    my ( $type, $source, $binmode_it ) = @_;"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "    # If undef (not \\undef) passed, they want the child to inherit"
NSQ_SOURCE_LINE 00000114 "    # the parent's STDIN."
NSQ_SOURCE_LINE 00000115 "    return undef unless defined $source;"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "    my $fh;"
NSQ_SOURCE_LINE 00000118 "    if ( ! $type ) {"
NSQ_SOURCE_LINE 00000119 "        open $fh, \"<\", $source or croak \"$!: $source\";"
NSQ_SOURCE_LINE 00000120 "       _binmode($fh, $binmode_it, \"STDIN\");"
NSQ_SOURCE_LINE 00000121 "        warn \"run3(): feeding file '$source' to child STDIN\\n\""
NSQ_SOURCE_LINE 00000122 "            if debugging >= 2;"
NSQ_SOURCE_LINE 00000123 "    } elsif ( $type eq \"FH\" ) {"
NSQ_SOURCE_LINE 00000124 "        $fh = $source;"
NSQ_SOURCE_LINE 00000125 "        warn \"run3(): feeding filehandle '$source' to child STDIN\\n\""
NSQ_SOURCE_LINE 00000126 "            if debugging >= 2;"
NSQ_SOURCE_LINE 00000127 "    } else {"
NSQ_SOURCE_LINE 00000128 "        $fh = $fh_cache{in} ||= tempfile;"
NSQ_SOURCE_LINE 00000129 "        truncate $fh, 0;"
NSQ_SOURCE_LINE 00000130 "        seek $fh, 0, 0;"
NSQ_SOURCE_LINE 00000131 "       _binmode($fh, $binmode_it, \"STDIN\");"
NSQ_SOURCE_LINE 00000132 "        my $seekit;"
NSQ_SOURCE_LINE 00000133 "        if ( $type eq \"SCALAR\" ) {"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "            # When the run3()'s caller asks to feed an empty file"
NSQ_SOURCE_LINE 00000136 "            # to the child's stdin, we want to pass a live file"
NSQ_SOURCE_LINE 00000137 "            # descriptor to an empty file (like /dev/null) so that"
NSQ_SOURCE_LINE 00000138 "            # they don't get surprised by invalid fd errors and get"
NSQ_SOURCE_LINE 00000139 "            # normal EOF behaviors."
NSQ_SOURCE_LINE 00000140 "            return $fh unless defined $$source;  # \\undef passed"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "            warn \"run3(): feeding SCALAR to child STDIN\","
NSQ_SOURCE_LINE 00000143 "                debugging >= 3"
NSQ_SOURCE_LINE 00000144 "                   ? ( \": '\", $$source, \"' (\", length $$source, \" chars)\" )"
NSQ_SOURCE_LINE 00000145 "                   : (),"
NSQ_SOURCE_LINE 00000146 "                \"\\n\""
NSQ_SOURCE_LINE 00000147 "                if debugging >= 2;"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "            $seekit = length $$source;"
NSQ_SOURCE_LINE 00000150 "            print $fh $$source or die \"$! writing to temp file\";"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "        } elsif ( $type eq \"ARRAY\" ) {"
NSQ_SOURCE_LINE 00000153 "            warn \"run3(): feeding ARRAY to child STDIN\","
NSQ_SOURCE_LINE 00000154 "                debugging >= 3 ? ( \": '\", @$source, \"'\" ) : (),"
NSQ_SOURCE_LINE 00000155 "                \"\\n\""
NSQ_SOURCE_LINE 00000156 "            if debugging >= 2;"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "            print $fh @$source or die \"$! writing to temp file\";"
NSQ_SOURCE_LINE 00000159 "            $seekit = grep length, @$source;"
NSQ_SOURCE_LINE 00000160 "        } elsif ( $type eq \"CODE\" ) {"
NSQ_SOURCE_LINE 00000161 "            warn \"run3(): feeding output of CODE ref '$source' to child STDIN\\n\""
NSQ_SOURCE_LINE 00000162 "                if debugging >= 2;"
NSQ_SOURCE_LINE 00000163 "            my $params = [];  # TODO: get these from $options"
NSQ_SOURCE_LINE 00000164 "            while (1) {"
NSQ_SOURCE_LINE 00000165 "                my $data = $source->( @$params );"
NSQ_SOURCE_LINE 00000166 "                last unless defined $data;"
NSQ_SOURCE_LINE 00000167 "                print $fh $data or die \"$! writing to temp file\";"
NSQ_SOURCE_LINE 00000168 "                $seekit = length $data;"
NSQ_SOURCE_LINE 00000169 "            }"
NSQ_SOURCE_LINE 00000170 "        }"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "        seek $fh, 0, 0 or croak \"$! seeking on temp file for child's stdin\""
NSQ_SOURCE_LINE 00000173 "            if $seekit;"
NSQ_SOURCE_LINE 00000174 "    }"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "    croak \"run3() can't redirect $type to child stdin\""
NSQ_SOURCE_LINE 00000177 "        unless defined $fh;"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "    return $fh;"
NSQ_SOURCE_LINE 00000180 "}"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "sub _fh_for_child_output {"
NSQ_SOURCE_LINE 00000183 "    my ( $what, $type, $dest, $options ) = @_;"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "    my $fh;"
NSQ_SOURCE_LINE 00000186 "    if ( $type eq \"SCALAR\" && $dest == \\undef ) {"
NSQ_SOURCE_LINE 00000187 "        warn \"run3(): redirecting child $what to oblivion\\n\""
NSQ_SOURCE_LINE 00000188 "            if debugging >= 2;"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "        $fh = $fh_cache{nul} ||= do {"
NSQ_SOURCE_LINE 00000191 "            open $fh, \">\", File::Spec->devnull;"
NSQ_SOURCE_LINE 00000192 "           $fh;"
NSQ_SOURCE_LINE 00000193 "        };"
NSQ_SOURCE_LINE 00000194 "    } elsif ( $type eq \"FH\" ) {"
NSQ_SOURCE_LINE 00000195 "        $fh = $dest;"
NSQ_SOURCE_LINE 00000196 "        warn \"run3(): redirecting $what to filehandle '$dest'\\n\""
NSQ_SOURCE_LINE 00000197 "            if debugging >= 3;"
NSQ_SOURCE_LINE 00000198 "    } elsif ( !$type ) {"
NSQ_SOURCE_LINE 00000199 "        warn \"run3(): feeding child $what to file '$dest'\\n\""
NSQ_SOURCE_LINE 00000200 "            if debugging >= 2;"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "        open $fh, $options->{\"append_$what\"} ? \">>\" : \">\", $dest"
NSQ_SOURCE_LINE 00000203 "           or croak \"$!: $dest\";"
NSQ_SOURCE_LINE 00000204 "    } else {"
NSQ_SOURCE_LINE 00000205 "        warn \"run3(): capturing child $what\\n\""
NSQ_SOURCE_LINE 00000206 "            if debugging >= 2;"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "        $fh = $fh_cache{$what} ||= tempfile;"
NSQ_SOURCE_LINE 00000209 "        seek $fh, 0, 0;"
NSQ_SOURCE_LINE 00000210 "        truncate $fh, 0;"
NSQ_SOURCE_LINE 00000211 "    }"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "    my $binmode_it = $options->{\"binmode_$what\"};"
NSQ_SOURCE_LINE 00000214 "    _binmode($fh, $binmode_it, uc $what);"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "    return $fh;"
NSQ_SOURCE_LINE 00000217 "}"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "sub _read_child_output_fh {"
NSQ_SOURCE_LINE 00000220 "    my ( $what, $type, $dest, $fh, $options ) = @_;"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "    return if $type eq \"SCALAR\" && $dest == \\undef;"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "    seek $fh, 0, 0 or croak \"$! seeking on temp file for child $what\";"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "    if ( $type eq \"SCALAR\" ) {"
NSQ_SOURCE_LINE 00000227 "        warn \"run3(): reading child $what to SCALAR\\n\""
NSQ_SOURCE_LINE 00000228 "            if debugging >= 3;"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "        # two read()s are used instead of 1 so that the first will be"
NSQ_SOURCE_LINE 00000231 "        # logged even it reads 0 bytes; the second won't."
NSQ_SOURCE_LINE 00000232 "        my $count = read $fh, $$dest, 10_000,"
NSQ_SOURCE_LINE 00000233 "           $options->{\"append_$what\"} ? length $$dest : 0;"
NSQ_SOURCE_LINE 00000234 "        while (1) {"
NSQ_SOURCE_LINE 00000235 "            croak \"$! reading child $what from temp file\""
NSQ_SOURCE_LINE 00000236 "                unless defined $count;"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "            last unless $count;"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "            warn \"run3(): read $count bytes from child $what\","
NSQ_SOURCE_LINE 00000241 "                debugging >= 3 ? ( \": '\", substr( $$dest, -$count ), \"'\" ) : (),"
NSQ_SOURCE_LINE 00000242 "                \"\\n\""
NSQ_SOURCE_LINE 00000243 "                if debugging >= 2;"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "            $count = read $fh, $$dest, 10_000, length $$dest;"
NSQ_SOURCE_LINE 00000246 "        }"
NSQ_SOURCE_LINE 00000247 "    } elsif ( $type eq \"ARRAY\" ) {"
NSQ_SOURCE_LINE 00000248 "       if ($options->{\"append_$what\"}) {"
NSQ_SOURCE_LINE 00000249 "           push @$dest, <$fh>;"
NSQ_SOURCE_LINE 00000250 "       } else {"
NSQ_SOURCE_LINE 00000251 "           @$dest = <$fh>;"
NSQ_SOURCE_LINE 00000252 "       }"
NSQ_SOURCE_LINE 00000253 "        if ( debugging >= 2 ) {"
NSQ_SOURCE_LINE 00000254 "            my $count = 0;"
NSQ_SOURCE_LINE 00000255 "            $count += length for @$dest;"
NSQ_SOURCE_LINE 00000256 "            warn"
NSQ_SOURCE_LINE 00000257 "                \"run3(): read \","
NSQ_SOURCE_LINE 00000258 "                scalar @$dest,"
NSQ_SOURCE_LINE 00000259 "                \" records, $count bytes from child $what\","
NSQ_SOURCE_LINE 00000260 "                debugging >= 3 ? ( \": '\", @$dest, \"'\" ) : (),"
NSQ_SOURCE_LINE 00000261 "                \"\\n\";"
NSQ_SOURCE_LINE 00000262 "        }"
NSQ_SOURCE_LINE 00000263 "    } elsif ( $type eq \"CODE\" ) {"
NSQ_SOURCE_LINE 00000264 "        warn \"run3(): capturing child $what to CODE ref\\n\""
NSQ_SOURCE_LINE 00000265 "            if debugging >= 3;"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "        local $_;"
NSQ_SOURCE_LINE 00000268 "        while ( <$fh> ) {"
NSQ_SOURCE_LINE 00000269 "            warn"
NSQ_SOURCE_LINE 00000270 "                \"run3(): read \","
NSQ_SOURCE_LINE 00000271 "                length,"
NSQ_SOURCE_LINE 00000272 "                \" bytes from child $what\","
NSQ_SOURCE_LINE 00000273 "                debugging >= 3 ? ( \": '\", $_, \"'\" ) : (),"
NSQ_SOURCE_LINE 00000274 "                \"\\n\""
NSQ_SOURCE_LINE 00000275 "                if debugging >= 2;"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "            $dest->( $_ );"
NSQ_SOURCE_LINE 00000278 "        }"
NSQ_SOURCE_LINE 00000279 "    } else {"
NSQ_SOURCE_LINE 00000280 "        croak \"run3() can't redirect child $what to a $type\";"
NSQ_SOURCE_LINE 00000281 "    }"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "}"
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "sub _type {"
NSQ_SOURCE_LINE 00000286 "    my ( $redir ) = @_;"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "    return \"FH\" if eval {"
NSQ_SOURCE_LINE 00000289 "        local $SIG{'__DIE__'};"
NSQ_SOURCE_LINE 00000290 "        $redir->isa(\"IO::Handle\")"
NSQ_SOURCE_LINE 00000291 "    };"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "    my $type = ref $redir;"
NSQ_SOURCE_LINE 00000294 "    return $type eq \"GLOB\" ? \"FH\" : $type;"
NSQ_SOURCE_LINE 00000295 "}"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "sub _max_fd {"
NSQ_SOURCE_LINE 00000298 "    my $fd = dup(0);"
NSQ_SOURCE_LINE 00000299 "    POSIX::close $fd;"
NSQ_SOURCE_LINE 00000300 "    return $fd;"
NSQ_SOURCE_LINE 00000301 "}"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "my $run_call_time;"
NSQ_SOURCE_LINE 00000304 "my $sys_call_time;"
NSQ_SOURCE_LINE 00000305 "my $sys_exit_time;"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "sub run3 {"
NSQ_SOURCE_LINE 00000308 "    $run_call_time = gettimeofday() if profiling;"
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "    my $options = @_ && ref $_[-1] eq \"HASH\" ? pop : {};"
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "    my ( $cmd, $stdin, $stdout, $stderr ) = @_;"
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "    print STDERR \"run3(): running \","
NSQ_SOURCE_LINE 00000315 "       join( \" \", map \"'$_'\", ref $cmd ? @$cmd : $cmd ),"
NSQ_SOURCE_LINE 00000316 "       \"\\n\""
NSQ_SOURCE_LINE 00000317 "       if debugging;"
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "    if ( ref $cmd ) {"
NSQ_SOURCE_LINE 00000320 "        croak \"run3(): empty command\"     unless @$cmd;"
NSQ_SOURCE_LINE 00000321 "        croak \"run3(): undefined command\" unless defined $cmd->[0];"
NSQ_SOURCE_LINE 00000322 "        croak \"run3(): command name ('')\" unless length  $cmd->[0];"
NSQ_SOURCE_LINE 00000323 "    } else {"
NSQ_SOURCE_LINE 00000324 "        croak \"run3(): missing command\" unless @_;"
NSQ_SOURCE_LINE 00000325 "        croak \"run3(): undefined command\" unless defined $cmd;"
NSQ_SOURCE_LINE 00000326 "        croak \"run3(): command ('')\" unless length  $cmd;"
NSQ_SOURCE_LINE 00000327 "    }"
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "    foreach (qw/binmode_stdin binmode_stdout binmode_stderr/) {"
NSQ_SOURCE_LINE 00000330 "       if (my $mode = $options->{$_}) {"
NSQ_SOURCE_LINE 00000331 "           croak qq[option $_ must be a number or a proper layer string: \"$mode\"]"
NSQ_SOURCE_LINE 00000332 "              unless $mode =~ /^(:|\\d+$)/;"
NSQ_SOURCE_LINE 00000333 "       }"
NSQ_SOURCE_LINE 00000334 "    }"
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "    my $in_type  = _type $stdin;"
NSQ_SOURCE_LINE 00000337 "    my $out_type = _type $stdout;"
NSQ_SOURCE_LINE 00000338 "    my $err_type = _type $stderr;"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "    if ($fh_cache_pid != $$) {"
NSQ_SOURCE_LINE 00000341 "       # fork detected, close all cached filehandles and clear the cache"
NSQ_SOURCE_LINE 00000342 "       close $_ foreach values %fh_cache;"
NSQ_SOURCE_LINE 00000343 "       %fh_cache = ();"
NSQ_SOURCE_LINE 00000344 "       $fh_cache_pid = $$;"
NSQ_SOURCE_LINE 00000345 "    }"
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "    # This routine proceeds in stages so that a failure in an early"
NSQ_SOURCE_LINE 00000348 "    # stage prevents later stages from running, and thus from needing"
NSQ_SOURCE_LINE 00000349 "    # cleanup."
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "    my ($in_fh, $out_fh, $err_fh);"
NSQ_SOURCE_LINE 00000352 "    $in_fh  = _spool_data_to_child $in_type, $stdin,"
NSQ_SOURCE_LINE 00000353 "        $options->{binmode_stdin} if defined $stdin;"
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 "    $out_fh = _fh_for_child_output \"stdout\", $out_type, $stdout,"
NSQ_SOURCE_LINE 00000356 "        $options if defined $stdout;"
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 "    my $tie_err_to_out ="
NSQ_SOURCE_LINE 00000359 "        defined $stderr && defined $stdout && $stderr eq $stdout;"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "    $err_fh = $tie_err_to_out"
NSQ_SOURCE_LINE 00000362 "        ? $out_fh"
NSQ_SOURCE_LINE 00000363 "        : _fh_for_child_output \"stderr\", $err_type, $stderr,"
NSQ_SOURCE_LINE 00000364 "            $options if defined $stderr;"
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "    # this should make perl close these on exceptions"
NSQ_SOURCE_LINE 00000367 "#    local *STDIN_SAVE;"
NSQ_SOURCE_LINE 00000368 "    local *STDOUT_SAVE;"
NSQ_SOURCE_LINE 00000369 "    local *STDERR_SAVE;"
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "    my $saved_fd0 = defined $in_fh ? dup( 0 ) : undef;"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "#    open STDIN_SAVE,  \"<&STDIN\"#  or croak \"run3(): $! saving STDIN\""
NSQ_SOURCE_LINE 00000374 "#        if defined $in_fh;"
NSQ_SOURCE_LINE 00000375 "    open STDOUT_SAVE, \">&STDOUT\" or croak \"run3(): $! saving STDOUT\""
NSQ_SOURCE_LINE 00000376 "        if defined $out_fh;"
NSQ_SOURCE_LINE 00000377 "    open STDERR_SAVE, \">&STDERR\" or croak \"run3(): $! saving STDERR\""
NSQ_SOURCE_LINE 00000378 "        if defined $err_fh;"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "    my $errno;"
NSQ_SOURCE_LINE 00000381 "    my $ok = eval {"
NSQ_SOURCE_LINE 00000382 "        # The open() call here seems to not force fd 0 in some cases;"
NSQ_SOURCE_LINE 00000383 "        # I ran in to trouble when using this in VCP, not sure why."
NSQ_SOURCE_LINE 00000384 "        # the dup2() seems to work."
NSQ_SOURCE_LINE 00000385 "        dup2( fileno $in_fh, 0 )"
NSQ_SOURCE_LINE 00000386 "#        open STDIN,  \"<&=\" . fileno $in_fh"
NSQ_SOURCE_LINE 00000387 "            or croak \"run3(): $! redirecting STDIN\""
NSQ_SOURCE_LINE 00000388 "            if defined $in_fh;"
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "#        close $in_fh or croak \"$! closing STDIN temp file\""
NSQ_SOURCE_LINE 00000391 "#            if ref $stdin;"
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "        open STDOUT, \">&\" . fileno $out_fh"
NSQ_SOURCE_LINE 00000394 "            or croak \"run3(): $! redirecting STDOUT\""
NSQ_SOURCE_LINE 00000395 "            if defined $out_fh;"
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "        open STDERR, \">&\" . fileno $err_fh"
NSQ_SOURCE_LINE 00000398 "            or croak \"run3(): $! redirecting STDERR\""
NSQ_SOURCE_LINE 00000399 "            if defined $err_fh;"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "        $sys_call_time = gettimeofday() if profiling;"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "        $! = 0;                  # make sure we don't test below against some previous error"
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "        my $r = ref $cmd"
NSQ_SOURCE_LINE 00000406 "              ? system { $cmd->[0] } is_win32 ? quote_native( @$cmd ) : @$cmd"
NSQ_SOURCE_LINE 00000407 "              : system $cmd;"
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "       $errno = $!;              # save $!, because later failures will overwrite it"
NSQ_SOURCE_LINE 00000410 "        $sys_exit_time = gettimeofday() if profiling;"
NSQ_SOURCE_LINE 00000411 "        if ( debugging ) {"
NSQ_SOURCE_LINE 00000412 "            my $err_fh = defined $err_fh ? \\*STDERR_SAVE : \\*STDERR;"
NSQ_SOURCE_LINE 00000413 "           if ( defined $r && $r != -1 ) {"
NSQ_SOURCE_LINE 00000414 "              print $err_fh \"run3(): \\$? is $?\\n\";"
NSQ_SOURCE_LINE 00000415 "           } else {"
NSQ_SOURCE_LINE 00000416 "              print $err_fh \"run3(): \\$? is $?, \\$! is $errno\\n\";"
NSQ_SOURCE_LINE 00000417 "           }"
NSQ_SOURCE_LINE 00000418 "        }"
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "        if ("
NSQ_SOURCE_LINE 00000421 "            defined $r"
NSQ_SOURCE_LINE 00000422 "            && ( $r == -1 || ( is_win32 && $r == 0xFF00 && $errno != 0 ) )"
NSQ_SOURCE_LINE 00000423 "            && !$options->{return_if_system_error}"
NSQ_SOURCE_LINE 00000424 "        ) {"
NSQ_SOURCE_LINE 00000425 "            croak( $errno );"
NSQ_SOURCE_LINE 00000426 "        }"
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "        1;"
NSQ_SOURCE_LINE 00000429 "    };"
NSQ_SOURCE_LINE 00000430 "    my $x = $@;"
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 "    my @errs;"
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 "    if ( defined $saved_fd0 ) {"
NSQ_SOURCE_LINE 00000435 "        dup2( $saved_fd0, 0 );"
NSQ_SOURCE_LINE 00000436 "        POSIX::close( $saved_fd0 );"
NSQ_SOURCE_LINE 00000437 "    }"
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "#    open STDIN,  \"<&STDIN_SAVE\"#  or push @errs, \"run3(): $! restoring STDIN\""
NSQ_SOURCE_LINE 00000440 "#        if defined $in_fh;"
NSQ_SOURCE_LINE 00000441 "    open STDOUT, \">&STDOUT_SAVE\" or push @errs, \"run3(): $! restoring STDOUT\""
NSQ_SOURCE_LINE 00000442 "        if defined $out_fh;"
NSQ_SOURCE_LINE 00000443 "    open STDERR, \">&STDERR_SAVE\" or push @errs, \"run3(): $! restoring STDERR\""
NSQ_SOURCE_LINE 00000444 "        if defined $err_fh;"
NSQ_SOURCE_LINE 00000445 ""
NSQ_SOURCE_LINE 00000446 "    croak join \", \", @errs if @errs;"
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 "    die $x unless $ok;"
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "    _read_child_output_fh \"stdout\", $out_type, $stdout, $out_fh, $options"
NSQ_SOURCE_LINE 00000451 "        if defined $out_fh && $out_type && $out_type ne \"FH\";"
NSQ_SOURCE_LINE 00000452 "    _read_child_output_fh \"stderr\", $err_type, $stderr, $err_fh, $options"
NSQ_SOURCE_LINE 00000453 "        if defined $err_fh && $err_type && $err_type ne \"FH\" && !$tie_err_to_out;"
NSQ_SOURCE_LINE 00000454 "    $profiler->run_exit("
NSQ_SOURCE_LINE 00000455 "       $cmd,"
NSQ_SOURCE_LINE 00000456 "       $run_call_time,"
NSQ_SOURCE_LINE 00000457 "       $sys_call_time,"
NSQ_SOURCE_LINE 00000458 "       $sys_exit_time,"
NSQ_SOURCE_LINE 00000459 "       scalar gettimeofday()"
NSQ_SOURCE_LINE 00000460 "    ) if profiling;"
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 "    $! = $errno;              # restore $! from system()"
NSQ_SOURCE_LINE 00000463 ""
NSQ_SOURCE_LINE 00000464 "    return 1;"
NSQ_SOURCE_LINE 00000465 "}"
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "1;"
NSQ_SOURCE_LINE 00000468 ""
NSQ_SOURCE_LINE 00000469 "__END__"
NSQ_SOURCE_LINE 00000470 ""
NSQ_SOURCE_LINE 00000471 "=head2 C<< run3($cmd, $stdin, $stdout, $stderr, \\%options) >>"
NSQ_SOURCE_LINE 00000472 ""
NSQ_SOURCE_LINE 00000473 "All parameters after C<$cmd> are optional."
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 "The parameters C<$stdin>, C<$stdout> and C<$stderr> indicate how the child's"
NSQ_SOURCE_LINE 00000476 "corresponding filehandle (C<STDIN>, C<STDOUT> and C<STDERR>, resp.) will be"
NSQ_SOURCE_LINE 00000477 "redirected.  Because the redirects come last, this allows C<STDOUT> and"
NSQ_SOURCE_LINE 00000478 "C<STDERR> to default to the parent's by just not specifying them -- a common"
NSQ_SOURCE_LINE 00000479 "use case."
NSQ_SOURCE_LINE 00000480 ""
NSQ_SOURCE_LINE 00000481 "C<run3> throws an exception if the wrapped C<system> call returned -1 or"
NSQ_SOURCE_LINE 00000482 "anything went wrong with C<run3>'s processing of filehandles.  Otherwise it"
NSQ_SOURCE_LINE 00000483 "returns true.  It leaves C<$?> intact for inspection of exit and wait status."
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "Note that a true return value from C<run3> doesn't mean that the command had a"
NSQ_SOURCE_LINE 00000486 "successful exit code. Hence you should always check C<$?>."
NSQ_SOURCE_LINE 00000487 ""
NSQ_SOURCE_LINE 00000488 "See L</%options> for an option to handle the case of C<system> returning -1"
NSQ_SOURCE_LINE 00000489 "yourself."
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "=head3 C<$cmd>"
NSQ_SOURCE_LINE 00000492 ""
NSQ_SOURCE_LINE 00000493 "Usually C<$cmd> will be an ARRAY reference and the child is invoked via"
NSQ_SOURCE_LINE 00000494 ""
NSQ_SOURCE_LINE 00000495 "  system @$cmd;"
NSQ_SOURCE_LINE 00000496 ""
NSQ_SOURCE_LINE 00000497 "But C<$cmd> may also be a string in which case the child is invoked via"
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "  system $cmd;"
NSQ_SOURCE_LINE 00000500 ""
NSQ_SOURCE_LINE 00000501 "(cf. L<perlfunc/system> for the difference and the pitfalls of using"
NSQ_SOURCE_LINE 00000502 "the latter form)."
NSQ_SOURCE_LINE 00000503 ""
NSQ_SOURCE_LINE 00000504 "=head3 C<$stdin>, C<$stdout>, C<$stderr>"
NSQ_SOURCE_LINE 00000505 ""
NSQ_SOURCE_LINE 00000506 "The parameters C<$stdin>, C<$stdout> and C<$stderr> can take one of the"
NSQ_SOURCE_LINE 00000507 "following forms:"
NSQ_SOURCE_LINE 00000508 ""
NSQ_SOURCE_LINE 00000509 "=over 4"
NSQ_SOURCE_LINE 00000510 ""
NSQ_SOURCE_LINE 00000511 "=item C<undef> (or not specified at all)"
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "The child inherits the corresponding filehandle from the parent."
NSQ_SOURCE_LINE 00000514 ""
NSQ_SOURCE_LINE 00000515 "  run3 \\@cmd, $stdin;                   # child writes to same STDOUT and STDERR as parent"
NSQ_SOURCE_LINE 00000516 "  run3 \\@cmd, undef, $stdout, $stderr;  # child reads from same STDIN as parent"
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "=item C<\\undef>"
NSQ_SOURCE_LINE 00000519 ""
NSQ_SOURCE_LINE 00000520 "The child's filehandle is redirected from or to the local equivalent of"
NSQ_SOURCE_LINE 00000521 "C</dev/null> (as returned by C<< File::Spec->devnull() >>)."
NSQ_SOURCE_LINE 00000522 ""
NSQ_SOURCE_LINE 00000523 "  run3 \\@cmd, \\undef, $stdout, $stderr; # child reads from /dev/null"
NSQ_SOURCE_LINE 00000524 ""
NSQ_SOURCE_LINE 00000525 "=item a simple scalar"
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 "The parameter is taken to be the name of a file to read from"
NSQ_SOURCE_LINE 00000528 "or write to. In the latter case, the file will be opened via"
NSQ_SOURCE_LINE 00000529 ""
NSQ_SOURCE_LINE 00000530 "  open FH, \">\", ..."
NSQ_SOURCE_LINE 00000531 ""
NSQ_SOURCE_LINE 00000532 "i.e. it is created if it doesn't exist and truncated otherwise."
NSQ_SOURCE_LINE 00000533 "Note that the file is opened by the parent which will L<croak|Carp/croak>"
NSQ_SOURCE_LINE 00000534 "in case of failure."
NSQ_SOURCE_LINE 00000535 ""
NSQ_SOURCE_LINE 00000536 "  run3 \\@cmd, \\undef, \"out.txt\";        # child writes to file \"out.txt\""
NSQ_SOURCE_LINE 00000537 ""
NSQ_SOURCE_LINE 00000538 "=item a filehandle (either a reference to a GLOB or an C<IO::Handle>)"
NSQ_SOURCE_LINE 00000539 ""
NSQ_SOURCE_LINE 00000540 "The filehandle is inherited by the child."
NSQ_SOURCE_LINE 00000541 ""
NSQ_SOURCE_LINE 00000542 "  open my $fh, \">\", \"out.txt\";"
NSQ_SOURCE_LINE 00000543 "  print $fh \"prologue\\n\";"
NSQ_SOURCE_LINE 00000544 "  ..."
NSQ_SOURCE_LINE 00000545 "  run3 \\@cmd, \\undef, $fh;              # child writes to $fh"
NSQ_SOURCE_LINE 00000546 "  ..."
NSQ_SOURCE_LINE 00000547 "  print $fh \"epilogue\\n\";"
NSQ_SOURCE_LINE 00000548 "  close $fh;"
NSQ_SOURCE_LINE 00000549 ""
NSQ_SOURCE_LINE 00000550 "=item a SCALAR reference"
NSQ_SOURCE_LINE 00000551 ""
NSQ_SOURCE_LINE 00000552 "The referenced scalar is treated as a string to be read from or"
NSQ_SOURCE_LINE 00000553 "written to. In the latter case, the previous content of the string"
NSQ_SOURCE_LINE 00000554 "is overwritten."
NSQ_SOURCE_LINE 00000555 ""
NSQ_SOURCE_LINE 00000556 "  my $out;"
NSQ_SOURCE_LINE 00000557 "  run3 \\@cmd, \\undef, \\$out;           # child writes into string"
NSQ_SOURCE_LINE 00000558 "  run3 \\@cmd, \\<<EOF;                  # child reads from string (can use \"here\" notation)"
NSQ_SOURCE_LINE 00000559 "  Input"
NSQ_SOURCE_LINE 00000560 "  to"
NSQ_SOURCE_LINE 00000561 "  child"
NSQ_SOURCE_LINE 00000562 "  EOF"
NSQ_SOURCE_LINE 00000563 ""
NSQ_SOURCE_LINE 00000564 "=item an ARRAY reference"
NSQ_SOURCE_LINE 00000565 ""
NSQ_SOURCE_LINE 00000566 "For C<$stdin>, the elements of C<@$stdin> are simply spooled to the child."
NSQ_SOURCE_LINE 00000567 ""
NSQ_SOURCE_LINE 00000568 "For C<$stdout> or C<$stderr>, the child's corresponding file descriptor"
NSQ_SOURCE_LINE 00000569 "is read line by line (as determined by the current setting of C<$/>)"
NSQ_SOURCE_LINE 00000570 "into C<@$stdout> or C<@$stderr>, resp. The previous content of the array"
NSQ_SOURCE_LINE 00000571 "is overwritten."
NSQ_SOURCE_LINE 00000572 ""
NSQ_SOURCE_LINE 00000573 "  my @lines;"
NSQ_SOURCE_LINE 00000574 "  run3 \\@cmd, \\undef, \\@lines;         # child writes into array"
NSQ_SOURCE_LINE 00000575 ""
NSQ_SOURCE_LINE 00000576 "=item a CODE reference"
NSQ_SOURCE_LINE 00000577 ""
NSQ_SOURCE_LINE 00000578 "For C<$stdin>, C<&$stdin> will be called repeatedly (with no arguments) and"
NSQ_SOURCE_LINE 00000579 "the return values are spooled to the child. C<&$stdin> must signal the end of"
NSQ_SOURCE_LINE 00000580 "input by returning C<undef>."
NSQ_SOURCE_LINE 00000581 ""
NSQ_SOURCE_LINE 00000582 "For C<$stdout> or C<$stderr>, the child's corresponding file descriptor"
NSQ_SOURCE_LINE 00000583 "is read line by line (as determined by the current setting of C<$/>)"
NSQ_SOURCE_LINE 00000584 "and C<&$stdout> or C<&$stderr>, resp., is called with the contents of the line."
NSQ_SOURCE_LINE 00000585 "Note that there's no end-of-file indication."
NSQ_SOURCE_LINE 00000586 ""
NSQ_SOURCE_LINE 00000587 "  my $i = 0;"
NSQ_SOURCE_LINE 00000588 "  sub producer {"
NSQ_SOURCE_LINE 00000589 "    return $i < 10 ? \"line\".$i++.\"\\n\" : undef;"
NSQ_SOURCE_LINE 00000590 "  }"
NSQ_SOURCE_LINE 00000591 ""
NSQ_SOURCE_LINE 00000592 "  run3 \\@cmd, \\&producer;              # child reads 10 lines"
NSQ_SOURCE_LINE 00000593 ""
NSQ_SOURCE_LINE 00000594 "Note that this form of redirecting the child's I/O doesn't imply"
NSQ_SOURCE_LINE 00000595 "any form of concurrency between parent and child - run3()'s method of"
NSQ_SOURCE_LINE 00000596 "operation is the same no matter which form of redirection you specify."
NSQ_SOURCE_LINE 00000597 ""
NSQ_SOURCE_LINE 00000598 "=back"
NSQ_SOURCE_LINE 00000599 ""
NSQ_SOURCE_LINE 00000600 "If the same value is passed for C<$stdout> and C<$stderr>, then the child"
NSQ_SOURCE_LINE 00000601 "will write both C<STDOUT> and C<STDERR> to the same filehandle."
NSQ_SOURCE_LINE 00000602 "In general, this means that"
NSQ_SOURCE_LINE 00000603 ""
NSQ_SOURCE_LINE 00000604 "    run3 \\@cmd, \\undef, \"foo.txt\", \"foo.txt\";"
NSQ_SOURCE_LINE 00000605 "    run3 \\@cmd, \\undef, \\$both, \\$both;"
NSQ_SOURCE_LINE 00000606 ""
NSQ_SOURCE_LINE 00000607 "will DWIM and pass a single file handle to the child for both C<STDOUT> and"
NSQ_SOURCE_LINE 00000608 "C<STDERR>, collecting all into file \"foo.txt\" or C<$both>."
NSQ_SOURCE_LINE 00000609 ""
NSQ_SOURCE_LINE 00000610 "=head3 C<\\%options>"
NSQ_SOURCE_LINE 00000611 ""
NSQ_SOURCE_LINE 00000612 "The last parameter, C<\\%options>, must be a hash reference if present."
NSQ_SOURCE_LINE 00000613 ""
NSQ_SOURCE_LINE 00000614 "Currently the following keys are supported:"
NSQ_SOURCE_LINE 00000615 ""
NSQ_SOURCE_LINE 00000616 "=over 4"
NSQ_SOURCE_LINE 00000617 ""
NSQ_SOURCE_LINE 00000618 "=item C<binmode_stdin>, C<binmode_stdout>, C<binmode_stderr>"
NSQ_SOURCE_LINE 00000619 ""
NSQ_SOURCE_LINE 00000620 "The value must a \"layer\" as described in L<perlfunc/binmode>.  If specified the"
NSQ_SOURCE_LINE 00000621 "corresponding parameter C<$stdin>, C<$stdout> or C<$stderr>, resp., operates"
NSQ_SOURCE_LINE 00000622 "with the given layer."
NSQ_SOURCE_LINE 00000623 ""
NSQ_SOURCE_LINE 00000624 "For backward compatibility, a true value that doesn't start with \":\""
NSQ_SOURCE_LINE 00000625 "(e.g. a number) is interpreted as \":raw\". If the value is false"
NSQ_SOURCE_LINE 00000626 "or not specified, the default is \":crlf\" on Windows and \":raw\" otherwise."
NSQ_SOURCE_LINE 00000627 ""
NSQ_SOURCE_LINE 00000628 "Don't expect that values other than the built-in layers \":raw\", \":crlf\","
NSQ_SOURCE_LINE 00000629 "and (on newer Perls) \":bytes\", \":utf8\", \":encoding(...)\" will work."
NSQ_SOURCE_LINE 00000630 ""
NSQ_SOURCE_LINE 00000631 "=item C<append_stdout>, C<append_stderr>"
NSQ_SOURCE_LINE 00000632 ""
NSQ_SOURCE_LINE 00000633 "If their value is true then the corresponding parameter C<$stdout> or"
NSQ_SOURCE_LINE 00000634 "C<$stderr>, resp., will append the child's output to the existing \"contents\" of"
NSQ_SOURCE_LINE 00000635 "the redirector. This only makes sense if the redirector is a simple scalar (the"
NSQ_SOURCE_LINE 00000636 "corresponding file is opened in append mode), a SCALAR reference (the output is"
NSQ_SOURCE_LINE 00000637 "appended to the previous contents of the string) or an ARRAY reference (the"
NSQ_SOURCE_LINE 00000638 "output is C<push>ed onto the previous contents of the array)."
NSQ_SOURCE_LINE 00000639 ""
NSQ_SOURCE_LINE 00000640 "=item C<return_if_system_error>"
NSQ_SOURCE_LINE 00000641 ""
NSQ_SOURCE_LINE 00000642 "If this is true C<run3> does B<not> throw an exception if C<system> returns -1"
NSQ_SOURCE_LINE 00000643 "(cf. L<perlfunc/system> for possible failure scenarios.), but returns true"
NSQ_SOURCE_LINE 00000644 "instead.  In this case C<$?> has the value -1 and C<$!> contains the errno of"
NSQ_SOURCE_LINE 00000645 "the failing C<system> call."
NSQ_SOURCE_LINE 00000646 ""
NSQ_SOURCE_LINE 00000647 "=back"
NSQ_SOURCE_LINE 00000648 ""
NSQ_SOURCE_LINE 00000649 "=head1 HOW IT WORKS"
NSQ_SOURCE_LINE 00000650 ""
NSQ_SOURCE_LINE 00000651 "=over 4"
NSQ_SOURCE_LINE 00000652 ""
NSQ_SOURCE_LINE 00000653 "=item (1)"
NSQ_SOURCE_LINE 00000654 ""
NSQ_SOURCE_LINE 00000655 "For each redirector C<$stdin>, C<$stdout>, and C<$stderr>, C<run3()> furnishes"
NSQ_SOURCE_LINE 00000656 "a filehandle:"
NSQ_SOURCE_LINE 00000657 ""
NSQ_SOURCE_LINE 00000658 "=over 4"
NSQ_SOURCE_LINE 00000659 ""
NSQ_SOURCE_LINE 00000660 "=item *"
NSQ_SOURCE_LINE 00000661 ""
NSQ_SOURCE_LINE 00000662 "if the redirector already specifies a filehandle it just uses that"
NSQ_SOURCE_LINE 00000663 ""
NSQ_SOURCE_LINE 00000664 "=item *"
NSQ_SOURCE_LINE 00000665 ""
NSQ_SOURCE_LINE 00000666 "if the redirector specifies a filename, C<run3()> opens the file"
NSQ_SOURCE_LINE 00000667 "in the appropriate mode"
NSQ_SOURCE_LINE 00000668 ""
NSQ_SOURCE_LINE 00000669 "=item *"
NSQ_SOURCE_LINE 00000670 ""
NSQ_SOURCE_LINE 00000671 "in all other cases, C<run3()> opens a temporary file (using"
NSQ_SOURCE_LINE 00000672 "L<tempfile|Temp/tempfile>)"
NSQ_SOURCE_LINE 00000673 ""
NSQ_SOURCE_LINE 00000674 "=back"
NSQ_SOURCE_LINE 00000675 ""
NSQ_SOURCE_LINE 00000676 "=item (2)"
NSQ_SOURCE_LINE 00000677 ""
NSQ_SOURCE_LINE 00000678 "If C<run3()> opened a temporary file for C<$stdin> in step (1),"
NSQ_SOURCE_LINE 00000679 "it writes the data using the specified method (either"
NSQ_SOURCE_LINE 00000680 "from a string, an array or returned by a function) to the temporary file and rewinds it."
NSQ_SOURCE_LINE 00000681 ""
NSQ_SOURCE_LINE 00000682 "=item (3)"
NSQ_SOURCE_LINE 00000683 ""
NSQ_SOURCE_LINE 00000684 "C<run3()> saves the parent's C<STDIN>, C<STDOUT> and C<STDERR> by duplicating"
NSQ_SOURCE_LINE 00000685 "them to new filehandles. It duplicates the filehandles from step (1)"
NSQ_SOURCE_LINE 00000686 "to C<STDIN>, C<STDOUT> and C<STDERR>, resp."
NSQ_SOURCE_LINE 00000687 ""
NSQ_SOURCE_LINE 00000688 "=item (4)"
NSQ_SOURCE_LINE 00000689 ""
NSQ_SOURCE_LINE 00000690 "C<run3()> runs the child by invoking L<system|perlfunc/system> with C<$cmd> as"
NSQ_SOURCE_LINE 00000691 "specified above."
NSQ_SOURCE_LINE 00000692 ""
NSQ_SOURCE_LINE 00000693 "=item (5)"
NSQ_SOURCE_LINE 00000694 ""
NSQ_SOURCE_LINE 00000695 "C<run3()> restores the parent's C<STDIN>, C<STDOUT> and C<STDERR> saved in step (3)."
NSQ_SOURCE_LINE 00000696 ""
NSQ_SOURCE_LINE 00000697 "=item (6)"
NSQ_SOURCE_LINE 00000698 ""
NSQ_SOURCE_LINE 00000699 "If C<run3()> opened a temporary file for C<$stdout> or C<$stderr> in step (1),"
NSQ_SOURCE_LINE 00000700 "it rewinds it and reads back its contents using the specified method (either to"
NSQ_SOURCE_LINE 00000701 "a string, an array or by calling a function)."
NSQ_SOURCE_LINE 00000702 ""
NSQ_SOURCE_LINE 00000703 "=item (7)"
NSQ_SOURCE_LINE 00000704 ""
NSQ_SOURCE_LINE 00000705 "C<run3()> closes all filehandles that it opened explicitly in step (1)."
NSQ_SOURCE_LINE 00000706 ""
NSQ_SOURCE_LINE 00000707 "=back"
NSQ_SOURCE_LINE 00000708 ""
NSQ_SOURCE_LINE 00000709 "Note that when using temporary files, C<run3()> tries to amortize the overhead"
NSQ_SOURCE_LINE 00000710 "by reusing them (i.e. it keeps them open and rewinds and truncates them"
NSQ_SOURCE_LINE 00000711 "before the next operation)."
NSQ_SOURCE_LINE 00000712 ""
NSQ_SOURCE_LINE 00000713 "=head1 LIMITATIONS"
NSQ_SOURCE_LINE 00000714 ""
NSQ_SOURCE_LINE 00000715 "Often uses intermediate files (determined by File::Temp, and thus by the"
NSQ_SOURCE_LINE 00000716 "File::Spec defaults and the TMPDIR env. variable) for speed, portability and"
NSQ_SOURCE_LINE 00000717 "simplicity."
NSQ_SOURCE_LINE 00000718 ""
NSQ_SOURCE_LINE 00000719 "Use extreme caution when using C<run3> in a threaded environment if concurrent"
NSQ_SOURCE_LINE 00000720 "calls of C<run3> are possible. Most likely, I/O from different invocations will"
NSQ_SOURCE_LINE 00000721 "get mixed up. The reason is that in most thread implementations all threads in"
NSQ_SOURCE_LINE 00000722 "a process share the same STDIN/STDOUT/STDERR.  Known failures are Perl ithreads"
NSQ_SOURCE_LINE 00000723 "on Linux and Win32. Note that C<fork> on Win32 is emulated via Win32 threads"
NSQ_SOURCE_LINE 00000724 "and hence I/O mix up is possible between forked children here (C<run3> is \"fork"
NSQ_SOURCE_LINE 00000725 "safe\" on Unix, though)."
NSQ_SOURCE_LINE 00000726 ""
NSQ_SOURCE_LINE 00000727 "=head1 DEBUGGING"
NSQ_SOURCE_LINE 00000728 ""
NSQ_SOURCE_LINE 00000729 "To enable debugging use the IPCRUN3DEBUG environment variable to"
NSQ_SOURCE_LINE 00000730 "a non-zero integer value:"
NSQ_SOURCE_LINE 00000731 ""
NSQ_SOURCE_LINE 00000732 "  $ IPCRUN3DEBUG=1 myapp"
NSQ_SOURCE_LINE 00000733 ""
NSQ_SOURCE_LINE 00000734 "=head1 PROFILING"
NSQ_SOURCE_LINE 00000735 ""
NSQ_SOURCE_LINE 00000736 "To enable profiling, set IPCRUN3PROFILE to a number to enable emitting profile"
NSQ_SOURCE_LINE 00000737 "information to STDERR (1 to get timestamps, 2 to get a summary report at the"
NSQ_SOURCE_LINE 00000738 "END of the program, 3 to get mini reports after each run) or to a filename to"
NSQ_SOURCE_LINE 00000739 "emit raw data to a file for later analysis."
NSQ_SOURCE_LINE 00000740 ""
NSQ_SOURCE_LINE 00000741 "=head1 COMPARISON"
NSQ_SOURCE_LINE 00000742 ""
NSQ_SOURCE_LINE 00000743 "Here's how it stacks up to existing APIs:"
NSQ_SOURCE_LINE 00000744 ""
NSQ_SOURCE_LINE 00000745 "=head2 compared to C<system()>, C<qx''>, C<open \"...|\">, C<open \"|...\">"
NSQ_SOURCE_LINE 00000746 ""
NSQ_SOURCE_LINE 00000747 "=over"
NSQ_SOURCE_LINE 00000748 ""
NSQ_SOURCE_LINE 00000749 "=item *"
NSQ_SOURCE_LINE 00000750 ""
NSQ_SOURCE_LINE 00000751 "better: redirects more than one file descriptor"
NSQ_SOURCE_LINE 00000752 ""
NSQ_SOURCE_LINE 00000753 "=item *"
NSQ_SOURCE_LINE 00000754 ""
NSQ_SOURCE_LINE 00000755 "better: returns TRUE on success, FALSE on failure"
NSQ_SOURCE_LINE 00000756 ""
NSQ_SOURCE_LINE 00000757 "=item *"
NSQ_SOURCE_LINE 00000758 ""
NSQ_SOURCE_LINE 00000759 "better: throws an error if problems occur in the parent process (or the"
NSQ_SOURCE_LINE 00000760 "pre-exec child)"
NSQ_SOURCE_LINE 00000761 ""
NSQ_SOURCE_LINE 00000762 "=item *"
NSQ_SOURCE_LINE 00000763 ""
NSQ_SOURCE_LINE 00000764 "better: allows a very perlish interface to Perl data structures and subroutines"
NSQ_SOURCE_LINE 00000765 ""
NSQ_SOURCE_LINE 00000766 "=item *"
NSQ_SOURCE_LINE 00000767 ""
NSQ_SOURCE_LINE 00000768 "better: allows 1 word invocations to avoid the shell easily:"
NSQ_SOURCE_LINE 00000769 ""
NSQ_SOURCE_LINE 00000770 " run3 [\"foo\"];  # does not invoke shell"
NSQ_SOURCE_LINE 00000771 ""
NSQ_SOURCE_LINE 00000772 "=item *"
NSQ_SOURCE_LINE 00000773 ""
NSQ_SOURCE_LINE 00000774 "worse: does not return the exit code, leaves it in $?"
NSQ_SOURCE_LINE 00000775 ""
NSQ_SOURCE_LINE 00000776 "=back"
NSQ_SOURCE_LINE 00000777 ""
NSQ_SOURCE_LINE 00000778 "=head2 compared to C<open2()>, C<open3()>"
NSQ_SOURCE_LINE 00000779 ""
NSQ_SOURCE_LINE 00000780 "=over"
NSQ_SOURCE_LINE 00000781 ""
NSQ_SOURCE_LINE 00000782 "=item *"
NSQ_SOURCE_LINE 00000783 ""
NSQ_SOURCE_LINE 00000784 "better: no lengthy, error prone polling/select loop needed"
NSQ_SOURCE_LINE 00000785 ""
NSQ_SOURCE_LINE 00000786 "=item *"
NSQ_SOURCE_LINE 00000787 ""
NSQ_SOURCE_LINE 00000788 "better: hides OS dependencies"
NSQ_SOURCE_LINE 00000789 ""
NSQ_SOURCE_LINE 00000790 "=item *"
NSQ_SOURCE_LINE 00000791 ""
NSQ_SOURCE_LINE 00000792 "better: allows SCALAR, ARRAY, and CODE references to source and sink I/O"
NSQ_SOURCE_LINE 00000793 ""
NSQ_SOURCE_LINE 00000794 "=item *"
NSQ_SOURCE_LINE 00000795 ""
NSQ_SOURCE_LINE 00000796 "better: I/O parameter order is like C<open3()>  (not like C<open2()>)."
NSQ_SOURCE_LINE 00000797 ""
NSQ_SOURCE_LINE 00000798 "=item *"
NSQ_SOURCE_LINE 00000799 ""
NSQ_SOURCE_LINE 00000800 "worse: does not allow interaction with the subprocess"
NSQ_SOURCE_LINE 00000801 ""
NSQ_SOURCE_LINE 00000802 "=back"
NSQ_SOURCE_LINE 00000803 ""
NSQ_SOURCE_LINE 00000804 "=head2 compared to L<IPC::Run::run()|IPC::Run/run>"
NSQ_SOURCE_LINE 00000805 ""
NSQ_SOURCE_LINE 00000806 "=over"
NSQ_SOURCE_LINE 00000807 ""
NSQ_SOURCE_LINE 00000808 "=item *"
NSQ_SOURCE_LINE 00000809 ""
NSQ_SOURCE_LINE 00000810 "better: smaller, lower overhead, simpler, more portable"
NSQ_SOURCE_LINE 00000811 ""
NSQ_SOURCE_LINE 00000812 "=item *"
NSQ_SOURCE_LINE 00000813 ""
NSQ_SOURCE_LINE 00000814 "better: no select() loop portability issues"
NSQ_SOURCE_LINE 00000815 ""
NSQ_SOURCE_LINE 00000816 "=item *"
NSQ_SOURCE_LINE 00000817 ""
NSQ_SOURCE_LINE 00000818 "better: does not fall prey to Perl closure leaks"
NSQ_SOURCE_LINE 00000819 ""
NSQ_SOURCE_LINE 00000820 "=item *"
NSQ_SOURCE_LINE 00000821 ""
NSQ_SOURCE_LINE 00000822 "worse: does not allow interaction with the subprocess (which IPC::Run::run()"
NSQ_SOURCE_LINE 00000823 "allows by redirecting subroutines)"
NSQ_SOURCE_LINE 00000824 ""
NSQ_SOURCE_LINE 00000825 "=item *"
NSQ_SOURCE_LINE 00000826 ""
NSQ_SOURCE_LINE 00000827 "worse: lacks many features of C<IPC::Run::run()> (filters, pipes, redirects,"
NSQ_SOURCE_LINE 00000828 "pty support)"
NSQ_SOURCE_LINE 00000829 ""
NSQ_SOURCE_LINE 00000830 "=back"
NSQ_SOURCE_LINE 00000831 ""
