NSQ_SOURCE_LINE 00000001 "package Filesys::Cap;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.010001;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 "#use Log::Any '$log';"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use File::Temp qw(tempdir);"
NSQ_SOURCE_LINE 00000009 "use UUID::Random;"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "our $DATE = '2015-11-12'; # DATE"
NSQ_SOURCE_LINE 00000012 "our $VERSION = '0.02'; # VERSION"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "require Exporter;"
NSQ_SOURCE_LINE 00000015 "our @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000016 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000017 "                       fs_has_attr_x"
NSQ_SOURCE_LINE 00000018 "                       fs_is_ci"
NSQ_SOURCE_LINE 00000019 "                       fs_is_cs"
NSQ_SOURCE_LINE 00000020 "                       fs_can_symlink"
NSQ_SOURCE_LINE 00000021 "               );"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "sub _uniq_name {"
NSQ_SOURCE_LINE 00000024 "    # what about filesystem like DOS with 8+3 characters limit? :-)"
NSQ_SOURCE_LINE 00000025 "    UUID::Random::generate();"
NSQ_SOURCE_LINE 00000026 "}"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "sub fs_has_attr_x {"
NSQ_SOURCE_LINE 00000029 "    my $dir = shift // tempdir(CLEANUP => 1);"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "    my $file1 = _uniq_name();"
NSQ_SOURCE_LINE 00000032 "    my $file2 = _uniq_name();"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "    my $res;"
NSQ_SOURCE_LINE 00000035 "    open my $fh1, \">\", \"$dir/$file1\" or goto EXIT;"
NSQ_SOURCE_LINE 00000036 "    open my $fh2, \">\", \"$dir/$file2\" or goto EXIT;"
NSQ_SOURCE_LINE 00000037 "    chmod 0755, \"$dir/$file1\" or goto EXIT;"
NSQ_SOURCE_LINE 00000038 "    chmod 0644, \"$dir/$file2\" or goto EXIT;"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "    $res = (-x \"$dir/$file1\") && !(-x \"$dir/$file2\");"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "  EXIT:"
NSQ_SOURCE_LINE 00000043 "    unlink \"$dir/$file1\";"
NSQ_SOURCE_LINE 00000044 "    unlink \"$dir/$file2\";"
NSQ_SOURCE_LINE 00000045 "    return $res;"
NSQ_SOURCE_LINE 00000046 "}"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "sub _check_fs_case_sensitivity {"
NSQ_SOURCE_LINE 00000049 "    my $ci  = shift;"
NSQ_SOURCE_LINE 00000050 "    my $dir = shift // tempdir(CLEANUP => 1);"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "    my $res;"
NSQ_SOURCE_LINE 00000053 "    my $subdir = _uniq_name();"
NSQ_SOURCE_LINE 00000054 "    mkdir \"$dir/$subdir\" or return undef;"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "    my $file1 = \"a\" . _uniq_name();"
NSQ_SOURCE_LINE 00000057 "    my $file2 = uc($file1);"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "    open my $fh1, \">\", \"$dir/$subdir/$file1\" or goto EXIT;"
NSQ_SOURCE_LINE 00000060 "    open my $fh2, \">\", \"$dir/$subdir/$file2\" or goto EXIT;"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "    opendir my $dh, \"$dir/$subdir\" or goto EXIT;"
NSQ_SOURCE_LINE 00000063 "    my @d = grep {$_ ne '.' && $_ ne '..'} readdir($dh);"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "    $res = @d > 1;"
NSQ_SOURCE_LINE 00000066 "    $res = !$res if $ci;"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "  EXIT:"
NSQ_SOURCE_LINE 00000069 "    unlink \"$dir/$subdir/$file1\";"
NSQ_SOURCE_LINE 00000070 "    unlink \"$dir/$subdir/$file2\";"
NSQ_SOURCE_LINE 00000071 "    rmdir \"$dir/$subdir\";"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "    return $res;"
NSQ_SOURCE_LINE 00000074 "}"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "sub fs_is_ci {"
NSQ_SOURCE_LINE 00000077 "    _check_fs_case_sensitivity(1, @_);"
NSQ_SOURCE_LINE 00000078 "}"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "sub fs_is_cs {"
NSQ_SOURCE_LINE 00000081 "    _check_fs_case_sensitivity(0, @_);"
NSQ_SOURCE_LINE 00000082 "}"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "sub fs_can_symlink {"
NSQ_SOURCE_LINE 00000085 "    my $dir = shift // tempdir(CLEANUP => 1);"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "    return undef unless eval { symlink(\"\", \"\"); 1 };"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "    my $name = _uniq_name();"
NSQ_SOURCE_LINE 00000090 "    symlink \"$dir/$name.2\", \"$dir/$name\" or return undef;"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "    unlink \"$dir/$name\";"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "    return 1;"
NSQ_SOURCE_LINE 00000095 "}"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "1;"
NSQ_SOURCE_LINE 00000098 "# ABSTRACT: Test filesystem capabilities/characteristics"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "__END__"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "=pod"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "=head1 NAME"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "Filesys::Cap - Test filesystem capabilities/characteristics"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "=head1 VERSION"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "This document describes version 0.02 of Filesys::Cap (from Perl distribution Filesys-Cap), released on 2015-11-12."
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 " use Filesys::Cap qw(fs_has_attr_x fs_is_ci fs_is_cs fs_can_symlink);"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 " say \"Filesystem has x attribute\"     if fs_has_attr_x();"
NSQ_SOURCE_LINE 00000119 " say \"Filesystem is case-insensitive\" if fs_is_ci(\"/tmp\");"
NSQ_SOURCE_LINE 00000120 " say \"Filesystem is case-sensitive\"   if fs_is_cs(\"/tmp\");"
NSQ_SOURCE_LINE 00000121 " say \"Filesystem can do symlinks\"     if fs_can_symlink(\"/tmp\");"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "=head2 fs_has_attr_x([ $dir ]) => bool"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "Return true if filesystem has x attribute, meaning it can have files that pass"
NSQ_SOURCE_LINE 00000128 "C<-x> Perl file test operator as well as files that fail it. This is done by"
NSQ_SOURCE_LINE 00000129 "actually creating two temporary files under C<$dir>, one chmod-ed to 0644 and"
NSQ_SOURCE_LINE 00000130 "one to 0755 and test the two files."
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "If C<$dir> is not specified, will use a temporary directory created by"
NSQ_SOURCE_LINE 00000133 "C<tempdir()>."
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "Will return undef on failure (e.g.: permission denied, etc)."
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "=head2 fs_is_ci([ $dir ]) => bool"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "Return true if filesystem is case-insensitive, meaning it is impossible to"
NSQ_SOURCE_LINE 00000140 "create two files with the same name but differing case (e.g. \"foo\" and \"Foo\")."
NSQ_SOURCE_LINE 00000141 "This is done by actually creating two temporary files under C<$dir>."
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "If C<$dir> is not specified, will use a temporary directory created by"
NSQ_SOURCE_LINE 00000144 "C<tempdir()>."
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "Will return undef on failure (e.g.: permission denied, etc)."
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "=head2 fs_is_cs([ $dir ]) => bool"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "The opposite of C<fs_is_ci>, will return true if filesystem is case-sensitive."
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "=head2 fs_can_symlink([ $dir ]) => bool"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "Return true if filesystem can do symlinks. This is tested by creating an actual"
NSQ_SOURCE_LINE 00000155 "temporary symlink. Note that this check is performed first:"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 " return undef unless eval { symlink(\"\",\"\"); 1 };"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "If C<$dir> is not specified, will use a temporary directory created by"
NSQ_SOURCE_LINE 00000160 "C<tempdir()>."
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "Will return undef on failure (e.g.: permission denied, etc)."
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "To list filesystems and their properties (so, the more proper/rigorous version),"
NSQ_SOURCE_LINE 00000167 "see L<Sys::Filesystem>."
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "Please visit the project's homepage at L<https://metacpan.org/release/Filesys-Cap>."
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "Source repository is at L<https://github.com/perlancar/perl-Filesys-Cap>."
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "=head1 BUGS"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "Please report any bugs or feature requests on the bugtracker website L<https://rt.cpan.org/Public/Dist/Display.html?Name=Filesys-Cap>"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "When submitting a bug or request, please include a test-file or a"
NSQ_SOURCE_LINE 00000182 "patch to an existing test-file that illustrates the bug or desired"
NSQ_SOURCE_LINE 00000183 "feature."
