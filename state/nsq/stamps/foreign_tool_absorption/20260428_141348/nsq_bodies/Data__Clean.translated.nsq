NSQ_SOURCE_LINE 00000001 "package Data::Clean;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.010001;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 "use Log::ger;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000009 "our $DATE = '2022-08-28'; # DATE"
NSQ_SOURCE_LINE 00000010 "our $DIST = 'Data-Clean'; # DIST"
NSQ_SOURCE_LINE 00000011 "our $VERSION = '0.508'; # VERSION"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "sub new {"
NSQ_SOURCE_LINE 00000014 "    my ($class, %opts) = @_;"
NSQ_SOURCE_LINE 00000015 "    my $self = bless {_opts=>\\%opts}, $class;"
NSQ_SOURCE_LINE 00000016 "    log_trace(\"Cleanser options: %s\", \\%opts);"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "    my $cd = $self->_generate_cleanser_code;"
NSQ_SOURCE_LINE 00000019 "    for my $mod (keys %{ $cd->{modules} }) {"
NSQ_SOURCE_LINE 00000020 "        (my $mod_pm = \"$mod.pm\") =~ s!::!/!g;"
NSQ_SOURCE_LINE 00000021 "        require $mod_pm;"
NSQ_SOURCE_LINE 00000022 "    }"
NSQ_SOURCE_LINE 00000023 "    $self->{_cd} = $cd;"
NSQ_SOURCE_LINE 00000024 "    $self->{_code} = eval $cd->{src}; ## no critic: BuiltinFunctions::ProhibitStringyEval"
NSQ_SOURCE_LINE 00000025 "    {"
NSQ_SOURCE_LINE 00000026 "        last unless $cd->{clone_func} =~ /(.+)::(.+)/;"
NSQ_SOURCE_LINE 00000027 "        (my $mod_pm = \"$1.pm\") =~ s!::!/!g;"
NSQ_SOURCE_LINE 00000028 "        require $mod_pm;"
NSQ_SOURCE_LINE 00000029 "    }"
NSQ_SOURCE_LINE 00000030 "    die \"Can't generate code: $@\" if $@;"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "    $self;"
NSQ_SOURCE_LINE 00000033 "}"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "sub command_call_method {"
NSQ_SOURCE_LINE 00000036 "    my ($self, $cd, $args) = @_;"
NSQ_SOURCE_LINE 00000037 "    my $mn = $args->[0];"
NSQ_SOURCE_LINE 00000038 "    die \"Invalid method name syntax\" unless $mn =~ /\\A\\w+\\z/;"
NSQ_SOURCE_LINE 00000039 "    return \"{{var}} = {{var}}->$mn; \\$ref = ref({{var}})\";"
NSQ_SOURCE_LINE 00000040 "}"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "sub command_call_func {"
NSQ_SOURCE_LINE 00000043 "    my ($self, $cd, $args) = @_;"
NSQ_SOURCE_LINE 00000044 "    my $fn = $args->[0];"
NSQ_SOURCE_LINE 00000045 "    die \"Invalid func name syntax\" unless $fn =~ /\\A\\w+(::\\w+)*\\z/;"
NSQ_SOURCE_LINE 00000046 "    return \"{{var}} = $fn({{var}}); \\$ref = ref({{var}})\";"
NSQ_SOURCE_LINE 00000047 "}"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "sub command_one_or_zero {"
NSQ_SOURCE_LINE 00000050 "    my ($self, $cd, $args) = @_;"
NSQ_SOURCE_LINE 00000051 "    return \"{{var}} = {{var}} ? 1:0; \\$ref = ''\";"
NSQ_SOURCE_LINE 00000052 "}"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "sub command_deref_scalar_one_or_zero {"
NSQ_SOURCE_LINE 00000055 "    my ($self, $cd, $args) = @_;"
NSQ_SOURCE_LINE 00000056 "    return \"{{var}} = \\${ {{var}} } ? 1:0; \\$ref = ''\";"
NSQ_SOURCE_LINE 00000057 "}"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "sub command_deref_scalar {"
NSQ_SOURCE_LINE 00000060 "    my ($self, $cd, $args) = @_;"
NSQ_SOURCE_LINE 00000061 "    return '{{var}} = ${ {{var}} }; $ref = ref({{var}})';"
NSQ_SOURCE_LINE 00000062 "}"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "sub command_stringify {"
NSQ_SOURCE_LINE 00000065 "    my ($self, $cd, $args) = @_;"
NSQ_SOURCE_LINE 00000066 "    return '{{var}} = \"{{var}}\"; $ref = \"\"';"
NSQ_SOURCE_LINE 00000067 "}"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "sub command_replace_with_ref {"
NSQ_SOURCE_LINE 00000070 "    my ($self, $cd, $args) = @_;"
NSQ_SOURCE_LINE 00000071 "    return '{{var}} = $ref; $ref = \"\"';"
NSQ_SOURCE_LINE 00000072 "}"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "sub command_replace_with_str {"
NSQ_SOURCE_LINE 00000075 "    require String::PerlQuote;"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "    my ($self, $cd, $args) = @_;"
NSQ_SOURCE_LINE 00000078 "    return \"{{var}} = \".String::PerlQuote::double_quote($args->[0]).'; $ref=\"\"';"
NSQ_SOURCE_LINE 00000079 "}"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "sub command_unbless {"
NSQ_SOURCE_LINE 00000082 "    my ($self, $cd, $args) = @_;"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "    return join("
NSQ_SOURCE_LINE 00000085 "        \"\","
NSQ_SOURCE_LINE 00000086 "        'my $reftype = Scalar::Util::reftype({{var}}); ',"
NSQ_SOURCE_LINE 00000087 "        '{{var}} = $reftype eq \"HASH\" ? {%{ {{var}} }} :',"
NSQ_SOURCE_LINE 00000088 "        ' $reftype eq \"ARRAY\" ? [@{ {{var}} }] :',"
NSQ_SOURCE_LINE 00000089 "        ' $reftype eq \"SCALAR\" ? \\(my $copy = ${ {{var}} }) :',"
NSQ_SOURCE_LINE 00000090 "        ' $reftype eq \"CODE\" ? sub { goto &{ {{var}} } } :',"
NSQ_SOURCE_LINE 00000091 "        '(die \"Cannot unbless object with type $ref\")',"
NSQ_SOURCE_LINE 00000092 "    );"
NSQ_SOURCE_LINE 00000093 "}"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "sub command_clone {"
NSQ_SOURCE_LINE 00000096 "    my ($self, $cd, $args) = @_;"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "    my $limit = $args->[0] // 1;"
NSQ_SOURCE_LINE 00000099 "    return join("
NSQ_SOURCE_LINE 00000100 "        \"\","
NSQ_SOURCE_LINE 00000101 "        \"if (++\\$ctr_circ <= $limit) { \","
NSQ_SOURCE_LINE 00000102 "        \"{{var}} = $cd->{clone_func}({{var}}); redo \","
NSQ_SOURCE_LINE 00000103 "        \"} else { \","
NSQ_SOURCE_LINE 00000104 "        \"{{var}} = 'CIRCULAR'; \\$ref = '' }\","
NSQ_SOURCE_LINE 00000105 "    );"
NSQ_SOURCE_LINE 00000106 "}"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "sub command_unbless_ffc_inlined {"
NSQ_SOURCE_LINE 00000109 "    my ($self, $cd, $args) = @_;"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "    # code taken from Function::Fallback::CoreOrPP 0.07"
NSQ_SOURCE_LINE 00000112 "    $cd->{subs}{unbless} //= <<'EOC';"
NSQ_SOURCE_LINE 00000113 "    my $ref = shift;"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "    my $r = ref($ref);"
NSQ_SOURCE_LINE 00000116 "    # not a reference"
NSQ_SOURCE_LINE 00000117 "    return $ref unless $r;"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "    # return if not a blessed ref"
NSQ_SOURCE_LINE 00000120 "    my ($r2, $r3) = \"$ref\" =~ /(.+)=(.+?)\\(/"
NSQ_SOURCE_LINE 00000121 "        or return $ref;"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "    if ($r3 eq 'HASH') {"
NSQ_SOURCE_LINE 00000124 "        return { %$ref };"
NSQ_SOURCE_LINE 00000125 "    } elsif ($r3 eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000126 "        return [ @$ref ];"
NSQ_SOURCE_LINE 00000127 "    } elsif ($r3 eq 'SCALAR') {"
NSQ_SOURCE_LINE 00000128 "        return \\( my $copy = ${$ref} );"
NSQ_SOURCE_LINE 00000129 "    } else {"
NSQ_SOURCE_LINE 00000130 "        die \"Can't handle $ref\";"
NSQ_SOURCE_LINE 00000131 "    }"
NSQ_SOURCE_LINE 00000132 "EOC"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "    \"{{var}} = \\$sub_unbless->({{var}}); \\$ref = ref({{var}})\";"
NSQ_SOURCE_LINE 00000135 "}"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "# test"
NSQ_SOURCE_LINE 00000138 "sub command_die {"
NSQ_SOURCE_LINE 00000139 "    my ($self, $cd, $args) = @_;"
NSQ_SOURCE_LINE 00000140 "    return \"die\";"
NSQ_SOURCE_LINE 00000141 "}"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "sub _generate_cleanser_code {"
NSQ_SOURCE_LINE 00000144 "    my $self = shift;"
NSQ_SOURCE_LINE 00000145 "    my $opts = $self->{_opts};"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "    # compilation data, a structure that will be passed around between routines"
NSQ_SOURCE_LINE 00000148 "    # during the generation of cleanser code."
NSQ_SOURCE_LINE 00000149 "    my $cd = {"
NSQ_SOURCE_LINE 00000150 "        modules => {}, # key = module name, val = version"
NSQ_SOURCE_LINE 00000151 "        clone_func   => $self->{_opts}{'!clone_func'},"
NSQ_SOURCE_LINE 00000152 "        code => '',"
NSQ_SOURCE_LINE 00000153 "        subs => {},"
NSQ_SOURCE_LINE 00000154 "    };"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "    $cd->{modules}{'Scalar::Util'} //= 0;"
NSQ_SOURCE_LINE 00000157 "    $cd->{modules}{'Data::Dmp'} //= 0 if $opts->{'!debug'};"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "    if (!$cd->{clone_func}) {"
NSQ_SOURCE_LINE 00000160 "        $cd->{clone_func} = $ENV{PERL_DATA_CLEAN_CLONE_FUNC} //"
NSQ_SOURCE_LINE 00000161 "            'Clone::PP::clone';"
NSQ_SOURCE_LINE 00000162 "    }"
NSQ_SOURCE_LINE 00000163 "    {"
NSQ_SOURCE_LINE 00000164 "        last unless $cd->{clone_func} =~ /(.+)::(.+)/;"
NSQ_SOURCE_LINE 00000165 "        $cd->{modules}{$1} //= 0;"
NSQ_SOURCE_LINE 00000166 "    }"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "    my (@code, @stmts_ary, @stmts_hash, @stmts_main);"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "    my $n = 0;"
NSQ_SOURCE_LINE 00000171 "    my $add_stmt = sub {"
NSQ_SOURCE_LINE 00000172 "        my $which = shift;"
NSQ_SOURCE_LINE 00000173 "        if ($which eq 'if' || $which eq 'new_if') {"
NSQ_SOURCE_LINE 00000174 "            my ($cond0, $act0) = @_;"
NSQ_SOURCE_LINE 00000175 "            for ([\\@stmts_ary, '$e', 'ary'],"
NSQ_SOURCE_LINE 00000176 "                 [\\@stmts_hash, '$h->{$k}', 'hash'],"
NSQ_SOURCE_LINE 00000177 "                 [\\@stmts_main, '$_', 'main']) {"
NSQ_SOURCE_LINE 00000178 "                my $act  = $act0 ; $act  =~ s/\\Q{{var}}\\E/$_->[1]/g;"
NSQ_SOURCE_LINE 00000179 "                my $cond = $cond0; $cond =~ s/\\Q{{var}}\\E/$_->[1]/g;"
NSQ_SOURCE_LINE 00000180 "                if ($opts->{'!debug'}) { unless (@{ $_->[0] }) { push @{ $_->[0] }, '    print \"DEBUG:'.$_->[2].' cleaner: val=\", Data::Dmp::dmp_ellipsis('.$_->[1].'), \", ref=$ref\\n\"; '.\"\\n\" } }"
NSQ_SOURCE_LINE 00000181 "                push @{ $_->[0] }, \"    \".($n && $which ne 'new_if' ? \"els\":\"\").\"if ($cond) { $act }\\n\";"
NSQ_SOURCE_LINE 00000182 "            }"
NSQ_SOURCE_LINE 00000183 "            $n++;"
NSQ_SOURCE_LINE 00000184 "        } else {"
NSQ_SOURCE_LINE 00000185 "            my ($stmt0) = @_;"
NSQ_SOURCE_LINE 00000186 "            for ([\\@stmts_ary, '$e', 'ary'],"
NSQ_SOURCE_LINE 00000187 "                 [\\@stmts_hash, '$h->{$k}', 'hash'],"
NSQ_SOURCE_LINE 00000188 "                 [\\@stmts_main, '$_', 'main']) {"
NSQ_SOURCE_LINE 00000189 "                my $stmt = $stmt0; $stmt =~ s/\\Q{{var}}\\E/$_->[1]/g;"
NSQ_SOURCE_LINE 00000190 "                push @{ $_->[0] }, \"    $stmt;\\n\";"
NSQ_SOURCE_LINE 00000191 "            }"
NSQ_SOURCE_LINE 00000192 "        }"
NSQ_SOURCE_LINE 00000193 "    };"
NSQ_SOURCE_LINE 00000194 "    my $add_if = sub {"
NSQ_SOURCE_LINE 00000195 "        $add_stmt->('if', @_);"
NSQ_SOURCE_LINE 00000196 "    };"
NSQ_SOURCE_LINE 00000197 "    my $add_new_if = sub {"
NSQ_SOURCE_LINE 00000198 "        $add_stmt->('new_if', @_);"
NSQ_SOURCE_LINE 00000199 "    };"
NSQ_SOURCE_LINE 00000200 "    my $add_if_ref = sub {"
NSQ_SOURCE_LINE 00000201 "        my ($ref, $act0) = @_;"
NSQ_SOURCE_LINE 00000202 "        $add_if->(\"\\$ref eq '$ref'\", $act0);"
NSQ_SOURCE_LINE 00000203 "    };"
NSQ_SOURCE_LINE 00000204 "    my $add_new_if_ref = sub {"
NSQ_SOURCE_LINE 00000205 "        my ($ref, $act0) = @_;"
NSQ_SOURCE_LINE 00000206 "        $add_new_if->(\"\\$ref eq '$ref'\", $act0);"
NSQ_SOURCE_LINE 00000207 "    };"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "    # catch circular references"
NSQ_SOURCE_LINE 00000210 "    my $circ = $opts->{-circular};"
NSQ_SOURCE_LINE 00000211 "    if ($circ) {"
NSQ_SOURCE_LINE 00000212 "        my $meth = \"command_$circ->[0]\";"
NSQ_SOURCE_LINE 00000213 "        die \"Can't handle command $circ->[0] for option '-circular'\" unless $self->can($meth);"
NSQ_SOURCE_LINE 00000214 "        my @args = @$circ; shift @args;"
NSQ_SOURCE_LINE 00000215 "        my $act = $self->$meth($cd, \\@args);"
NSQ_SOURCE_LINE 00000216 "        if ($opts->{'!debug'}) { $add_stmt->('stmt', 'print \"DEBUG: main cleaner: ref=$ref, \" . {{var}} . \"\\n\"'); }"
NSQ_SOURCE_LINE 00000217 "        $add_new_if->('$ref && $refs{ {{var}} }++', $act);"
NSQ_SOURCE_LINE 00000218 "    }"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "    # catch object of specified classes (e.g. DateTime, etc)"
NSQ_SOURCE_LINE 00000221 "    for my $on (grep {/\\A\\w*(::\\w+)*\\z/} sort keys %$opts) {"
NSQ_SOURCE_LINE 00000222 "        my $o = $opts->{$on};"
NSQ_SOURCE_LINE 00000223 "        next unless $o;"
NSQ_SOURCE_LINE 00000224 "        my $meth = \"command_$o->[0]\";"
NSQ_SOURCE_LINE 00000225 "        die \"Can't handle command $o->[0] for option '$on'\" unless $self->can($meth);"
NSQ_SOURCE_LINE 00000226 "        my @args = @$o; shift @args;"
NSQ_SOURCE_LINE 00000227 "        my $act = $self->$meth($cd, \\@args);"
NSQ_SOURCE_LINE 00000228 "        $add_if_ref->($on, $act);"
NSQ_SOURCE_LINE 00000229 "    }"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "    # catch general object not caught by previous"
NSQ_SOURCE_LINE 00000232 "    for my $p ([-obj => 'Scalar::Util::blessed({{var}})']) {"
NSQ_SOURCE_LINE 00000233 "        my $o = $opts->{$p->[0]};"
NSQ_SOURCE_LINE 00000234 "        next unless $o;"
NSQ_SOURCE_LINE 00000235 "        my $meth = \"command_$o->[0]\";"
NSQ_SOURCE_LINE 00000236 "        die \"Can't handle command $o->[0] for option '$p->[0]'\" unless $self->can($meth);"
NSQ_SOURCE_LINE 00000237 "        my @args = @$o; shift @args;"
NSQ_SOURCE_LINE 00000238 "        $add_if->($p->[1], $self->$meth($cd, \\@args));"
NSQ_SOURCE_LINE 00000239 "    }"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "    # recurse array and hash"
NSQ_SOURCE_LINE 00000242 "    if ($opts->{'!recurse_obj'}) {"
NSQ_SOURCE_LINE 00000243 "        $add_stmt->('stmt', 'my $reftype=Scalar::Util::reftype({{var}})//\"\"');"
NSQ_SOURCE_LINE 00000244 "        $add_new_if->('$reftype eq \"ARRAY\"', '$process_array->({{var}})');"
NSQ_SOURCE_LINE 00000245 "        $add_if->('$reftype eq \"HASH\"' , '$process_hash->({{var}})');"
NSQ_SOURCE_LINE 00000246 "    } else {"
NSQ_SOURCE_LINE 00000247 "        $add_new_if_ref->(\"ARRAY\", '$process_array->({{var}})');"
NSQ_SOURCE_LINE 00000248 "        $add_if_ref->(\"HASH\" , '$process_hash->({{var}})');"
NSQ_SOURCE_LINE 00000249 "    }"
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "    # lastly, catch any reference left"
NSQ_SOURCE_LINE 00000252 "    for my $p ([-ref => '$ref']) {"
NSQ_SOURCE_LINE 00000253 "        my $o = $opts->{$p->[0]};"
NSQ_SOURCE_LINE 00000254 "        next unless $o;"
NSQ_SOURCE_LINE 00000255 "        my $meth = \"command_$o->[0]\";"
NSQ_SOURCE_LINE 00000256 "        die \"Can't handle command $o->[0] for option '$p->[0]'\" unless $self->can($meth);"
NSQ_SOURCE_LINE 00000257 "        my @args = @$o; shift @args;"
NSQ_SOURCE_LINE 00000258 "        $add_if->($p->[1], $self->$meth($cd, \\@args));"
NSQ_SOURCE_LINE 00000259 "    }"
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "    push @code, 'sub {'.\"\\n\";"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "    for (sort keys %{$cd->{subs}}) {"
NSQ_SOURCE_LINE 00000264 "        push @code, \"state \\$sub_$_ = sub { \".$cd->{subs}{$_}.\" };\\n\";"
NSQ_SOURCE_LINE 00000265 "    }"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "    push @code, 'my $data = shift;'.\"\\n\";"
NSQ_SOURCE_LINE 00000268 "    push @code, 'state %refs;'.\"\\n\" if $circ;"
NSQ_SOURCE_LINE 00000269 "    push @code, 'state $ctr_circ;'.\"\\n\" if $circ;"
NSQ_SOURCE_LINE 00000270 "    push @code, 'state $process_array;'.\"\\n\";"
NSQ_SOURCE_LINE 00000271 "    push @code, 'state $process_hash;'.\"\\n\";"
NSQ_SOURCE_LINE 00000272 "    push @code, ("
NSQ_SOURCE_LINE 00000273 "        'if (!$process_array) { $process_array = sub { my $a = shift; for my $e (@$a) { ',"
NSQ_SOURCE_LINE 00000274 "        'my $ref=ref($e);'.\"\\n\","
NSQ_SOURCE_LINE 00000275 "        join(\"\", @stmts_ary).'} } }'.\"\\n\""
NSQ_SOURCE_LINE 00000276 "    );"
NSQ_SOURCE_LINE 00000277 "    push @code, ("
NSQ_SOURCE_LINE 00000278 "        'if (!$process_hash) { $process_hash = sub { my $h = shift; for my $k (keys %$h) { ',"
NSQ_SOURCE_LINE 00000279 "        'my $ref=ref($h->{$k});'.\"\\n\","
NSQ_SOURCE_LINE 00000280 "        join(\"\", @stmts_hash).'} } }'.\"\\n\""
NSQ_SOURCE_LINE 00000281 "    );"
NSQ_SOURCE_LINE 00000282 "    push @code, '%refs = (); $ctr_circ=0;'.\"\\n\" if $circ;"
NSQ_SOURCE_LINE 00000283 "    push @code, ("
NSQ_SOURCE_LINE 00000284 "        'for ($data) { ',"
NSQ_SOURCE_LINE 00000285 "        'my $ref=ref($_);'.\"\\n\","
NSQ_SOURCE_LINE 00000286 "        join(\"\", @stmts_main).'}'.\"\\n\""
NSQ_SOURCE_LINE 00000287 "    );"
NSQ_SOURCE_LINE 00000288 "    push @code, 'print \"DEBUG: main cleaner: result: \", Data::Dmp::dmp_ellipsis($data), \"\\n\";'.\"\\n\" if $opts->{'!debug'};"
NSQ_SOURCE_LINE 00000289 "    push @code, '$data'.\"\\n\";"
NSQ_SOURCE_LINE 00000290 "    push @code, '}'.\"\\n\";"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "    my $code = join(\"\", @code).\";\";"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "    if ($ENV{LOG_CLEANSER_CODE} && log_is_trace()) {"
NSQ_SOURCE_LINE 00000295 "        require String::LineNumber;"
NSQ_SOURCE_LINE 00000296 "        log_trace(\"Cleanser code:\\n%s\","
NSQ_SOURCE_LINE 00000297 "                     $ENV{LINENUM} // 1 ?"
NSQ_SOURCE_LINE 00000298 "                         String::LineNumber::linenum($code) : $code);"
NSQ_SOURCE_LINE 00000299 "    }"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "    $cd->{src} = $code;"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "    $cd;"
NSQ_SOURCE_LINE 00000304 "}"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "sub clean_in_place {"
NSQ_SOURCE_LINE 00000307 "    my ($self, $data) = @_;"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "    $self->{_code}->($data);"
NSQ_SOURCE_LINE 00000310 "}"
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "sub clone_and_clean {"
NSQ_SOURCE_LINE 00000313 "    no strict 'refs'; ## no critic: TestingAndDebugging::ProhibitNoStrict"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "    my ($self, $data) = @_;"
NSQ_SOURCE_LINE 00000316 "    my $clone = &{$self->{_cd}{clone_func}}($data);"
NSQ_SOURCE_LINE 00000317 "    $self->clean_in_place($clone);"
NSQ_SOURCE_LINE 00000318 "}"
