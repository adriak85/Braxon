NSQ_SOURCE_LINE 00006779 "    _xlfn.FORECAST.ETS.CONFINT"
NSQ_SOURCE_LINE 00006780 "    _xlfn.FORECAST.ETS.SEASONALITY"
NSQ_SOURCE_LINE 00006781 "    _xlfn.FORECAST.ETS.STAT"
NSQ_SOURCE_LINE 00006782 "    _xlfn.FORECAST.LINEAR"
NSQ_SOURCE_LINE 00006783 "    _xlfn.FORMULATEXT"
NSQ_SOURCE_LINE 00006784 "    _xlfn.GAMMA"
NSQ_SOURCE_LINE 00006785 "    _xlfn.GAMMA.DIST"
