NSQ_SOURCE_LINE 00006760 "    _xlfn.COVARIANCE.P"
NSQ_SOURCE_LINE 00006761 "    _xlfn.COVARIANCE.S"
NSQ_SOURCE_LINE 00006762 "    _xlfn.CSC"
