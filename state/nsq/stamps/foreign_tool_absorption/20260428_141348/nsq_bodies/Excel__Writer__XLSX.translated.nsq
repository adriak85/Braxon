NSQ_SOURCE_LINE 00000013 "#"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "use 5.008002;"
NSQ_SOURCE_LINE 00000016 "use strict;"
NSQ_SOURCE_LINE 00000017 "use warnings;"
NSQ_SOURCE_LINE 00000018 "use Exporter;"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "use Excel::Writer::XLSX::Workbook;"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "our @ISA     = qw(Excel::Writer::XLSX::Workbook Exporter);"
NSQ_SOURCE_LINE 00000023 "our $VERSION = '1.15';"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "###############################################################################"
NSQ_SOURCE_LINE 00000027 "#"
NSQ_SOURCE_LINE 00000028 "# new()"
NSQ_SOURCE_LINE 00000029 "#"
NSQ_SOURCE_LINE 00000030 "sub new {"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "    my $class = shift;"
NSQ_SOURCE_LINE 00000033 "    my $self  = Excel::Writer::XLSX::Workbook->new( @_ );"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "    # Check for file creation failures before re-blessing"
NSQ_SOURCE_LINE 00000036 "    bless $self, $class if defined $self;"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "    return $self;"
NSQ_SOURCE_LINE 00000039 "}"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 ""
