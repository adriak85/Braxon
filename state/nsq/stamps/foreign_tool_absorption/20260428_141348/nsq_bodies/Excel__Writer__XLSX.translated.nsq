NSQ_SOURCE_LINE 00000005 "#"
NSQ_SOURCE_LINE 00000006 "# Excel::Writer::XLSX - Create a new file in the Excel 2007+ XLSX format."
NSQ_SOURCE_LINE 00000007 "#"
