NSQ_SOURCE_LINE 00000001 "use v5.12.0;"
NSQ_SOURCE_LINE 00000002 "use warnings;"
NSQ_SOURCE_LINE 00000003 "package Config::INI 0.029;"
NSQ_SOURCE_LINE 00000004 "# ABSTRACT: simple .ini-file format"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "#pod =head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000007 "#pod"
NSQ_SOURCE_LINE 00000008 "#pod Config-INI comes with code for reading F<.ini> files:"
NSQ_SOURCE_LINE 00000009 "#pod"
NSQ_SOURCE_LINE 00000010 "#pod   my $config_hash = Config::INI::Reader->read_file('config.ini');"
NSQ_SOURCE_LINE 00000011 "#pod"
NSQ_SOURCE_LINE 00000012 "#pod ...and for writing C<.ini> files:"
NSQ_SOURCE_LINE 00000013 "#pod"
NSQ_SOURCE_LINE 00000014 "#pod   Config::INI::Writer->write_file({ somekey => 'somevalue' }, 'config.ini');"
NSQ_SOURCE_LINE 00000015 "#pod"
NSQ_SOURCE_LINE 00000016 "#pod See L<Config::INI::Writer> and L<Config::INI::Reader> for more examples."
NSQ_SOURCE_LINE 00000017 "#pod"
NSQ_SOURCE_LINE 00000018 "#pod =head1 GRAMMAR"
NSQ_SOURCE_LINE 00000019 "#pod"
NSQ_SOURCE_LINE 00000020 "#pod This section describes the format parsed and produced by Config::INI::Reader"
NSQ_SOURCE_LINE 00000021 "#pod and ::Writer.  It is not an exhaustive and rigorously tested formal grammar,"
NSQ_SOURCE_LINE 00000022 "#pod it's just a description of this particular implementation of the"
NSQ_SOURCE_LINE 00000023 "#pod not-quite-standardized \"INI\" format."
NSQ_SOURCE_LINE 00000024 "#pod"
NSQ_SOURCE_LINE 00000025 "#pod   ini-file   = { <section> | <empty-line> }"
NSQ_SOURCE_LINE 00000026 "#pod"
NSQ_SOURCE_LINE 00000027 "#pod   empty-line = [ <space> ] <line-ending>"
NSQ_SOURCE_LINE 00000028 "#pod"
NSQ_SOURCE_LINE 00000029 "#pod   section        = <section-header> { <value-assignment> | <empty-line> }"
NSQ_SOURCE_LINE 00000030 "#pod"
NSQ_SOURCE_LINE 00000031 "#pod   section-header = [ <space> ] \"[\" <section-name> \"]\" [ <space> ] <line-ending>"
NSQ_SOURCE_LINE 00000032 "#pod   section-name   = string"
NSQ_SOURCE_LINE 00000033 "#pod"
NSQ_SOURCE_LINE 00000034 "#pod   value-assignment = [ <space> ] <property-name> [ <space> ]"
NSQ_SOURCE_LINE 00000035 "#pod                      \"=\""
NSQ_SOURCE_LINE 00000036 "#pod                      [ <space> ] <value> [ <space> ]"
NSQ_SOURCE_LINE 00000037 "#pod                      <line-ending>"
NSQ_SOURCE_LINE 00000038 "#pod   property-name    = string-without-equals"
NSQ_SOURCE_LINE 00000039 "#pod   value            = string"
NSQ_SOURCE_LINE 00000040 "#pod"
NSQ_SOURCE_LINE 00000041 "#pod   comment     = <space> \";\" [ <string> ]"
NSQ_SOURCE_LINE 00000042 "#pod   line-ending = [ <comment> ] <EOL>"
NSQ_SOURCE_LINE 00000043 "#pod"
NSQ_SOURCE_LINE 00000044 "#pod   space = ( <TAB> | \" \" ) *"
NSQ_SOURCE_LINE 00000045 "#pod   string-without-equals = string - \"=\""
NSQ_SOURCE_LINE 00000046 "#pod   string = ? 1+ characters; not \";\" or EOL; begins and ends with non-space ?"
NSQ_SOURCE_LINE 00000047 "#pod"
NSQ_SOURCE_LINE 00000048 "#pod Of special note is the fact that I<no> escaping mechanism is defined, meaning"
NSQ_SOURCE_LINE 00000049 "#pod that there is no way to include an EOL or semicolon (for example) in a value,"
NSQ_SOURCE_LINE 00000050 "#pod property name, or section name.  If you need this, either subclass, wait for a"
NSQ_SOURCE_LINE 00000051 "#pod subclass to be written for you, or find one of the many other INI-style parsers"
NSQ_SOURCE_LINE 00000052 "#pod on the CPAN."
NSQ_SOURCE_LINE 00000053 "#pod"
NSQ_SOURCE_LINE 00000054 "#pod The order of sections and value assignments within a section are not"
NSQ_SOURCE_LINE 00000055 "#pod significant, except that given multiple assignments to one property name within"
NSQ_SOURCE_LINE 00000056 "#pod a section, only the final one is used.  A section name may be used more than"
NSQ_SOURCE_LINE 00000057 "#pod once; this will have the identical meaning as having all property assignments"
NSQ_SOURCE_LINE 00000058 "#pod in all sections of that name in sequence."
NSQ_SOURCE_LINE 00000059 "#pod"
NSQ_SOURCE_LINE 00000060 "#pod =head1 DON'T FORGET"
NSQ_SOURCE_LINE 00000061 "#pod"
NSQ_SOURCE_LINE 00000062 "#pod The definitions above refer to the format used by the Reader and Writer classes"
NSQ_SOURCE_LINE 00000063 "#pod bundled in the Config-INI distribution.  These classes are designed for easy"
NSQ_SOURCE_LINE 00000064 "#pod subclassing, so it should be easy to replace their behavior with whatever"
NSQ_SOURCE_LINE 00000065 "#pod behavior your want."
NSQ_SOURCE_LINE 00000066 "#pod"
NSQ_SOURCE_LINE 00000067 "#pod Patches, feature requests, and bug reports are welcome -- but I'm more"
NSQ_SOURCE_LINE 00000068 "#pod interested in making sure you can write a subclass that does what you need, and"
NSQ_SOURCE_LINE 00000069 "#pod less in making Config-INI do what you want directly."
NSQ_SOURCE_LINE 00000070 "#pod"
NSQ_SOURCE_LINE 00000071 "#pod =head1 THANKS"
NSQ_SOURCE_LINE 00000072 "#pod"
NSQ_SOURCE_LINE 00000073 "#pod Thanks to Florian Ragwitz for improving the subclassability of Config-INI's"
NSQ_SOURCE_LINE 00000074 "#pod modules, and for helping me do some of my first merging with git(7)."
NSQ_SOURCE_LINE 00000075 "#pod"
NSQ_SOURCE_LINE 00000076 "#pod =head1 ORIGIN"
NSQ_SOURCE_LINE 00000077 "#pod"
NSQ_SOURCE_LINE 00000078 "#pod Originaly derived from L<Config::Tiny>, by Adam Kennedy."
NSQ_SOURCE_LINE 00000079 "#pod"
NSQ_SOURCE_LINE 00000080 "#pod =cut"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "1;"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "__END__"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "=pod"
