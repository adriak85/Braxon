NSQ_SOURCE_LINE 00000001 "package Exporter::Tiny;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.006001;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings; no warnings qw(void once uninitialized numeric redefine);"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "our $AUTHORITY = 'cpan:TOBYINK';"
NSQ_SOURCE_LINE 00000008 "our $VERSION   = '1.006003';"
NSQ_SOURCE_LINE 00000009 "our @EXPORT_OK = qw< mkopt mkopt_hash _croak _carp >;"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "BEGIN {"
NSQ_SOURCE_LINE 00000012 "\t*_HAS_NATIVE_LEXICAL_SUB = ( \"$]\" >= 5.037002 )"
NSQ_SOURCE_LINE 00000013 "\t\t? sub () { !!1 }"
NSQ_SOURCE_LINE 00000014 "\t\t: sub () { !!0 };"
NSQ_SOURCE_LINE 00000015 "\t*_HAS_MODULE_LEXICAL_SUB = ( \"$]\" >= 5.011002 and eval('require Lexical::Sub') )"
NSQ_SOURCE_LINE 00000016 "\t\t? sub () { !!1 }"
NSQ_SOURCE_LINE 00000017 "\t\t: sub () { !!0 };"
NSQ_SOURCE_LINE 00000018 "};"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "sub _croak ($;@) { require Carp; my $fmt = shift; @_ = sprintf($fmt, @_); goto \\&Carp::croak }"
NSQ_SOURCE_LINE 00000021 "sub _carp  ($;@) { require Carp; my $fmt = shift; @_ = sprintf($fmt, @_); goto \\&Carp::carp }"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "my $_process_optlist = sub"
NSQ_SOURCE_LINE 00000024 "{"
NSQ_SOURCE_LINE 00000025 "\tmy $class = shift;"
NSQ_SOURCE_LINE 00000026 "\tmy ($global_opts, $opts, $want, $not_want) = @_;"
NSQ_SOURCE_LINE 00000027 "\t"
NSQ_SOURCE_LINE 00000028 "\twhile (@$opts)"
NSQ_SOURCE_LINE 00000029 "\t{"
NSQ_SOURCE_LINE 00000030 "\t\tmy $opt = shift @{$opts};"
NSQ_SOURCE_LINE 00000031 "\t\tmy ($name, $value) = @$opt;"
NSQ_SOURCE_LINE 00000032 "\t\t"
NSQ_SOURCE_LINE 00000033 "\t\t($name =~ m{\\A\\!(/.+/[msixpodual]*)\\z}) ?"
NSQ_SOURCE_LINE 00000034 "\t\t\tdo {"
NSQ_SOURCE_LINE 00000035 "\t\t\t\tmy @not = $class->_exporter_expand_regexp(\"$1\", $value, $global_opts);"
NSQ_SOURCE_LINE 00000036 "\t\t\t\t++$not_want->{$_->[0]} for @not;"
NSQ_SOURCE_LINE 00000037 "\t\t\t} :"
NSQ_SOURCE_LINE 00000038 "\t\t($name =~ m{\\A\\![:-](.+)\\z}) ?"
NSQ_SOURCE_LINE 00000039 "\t\t\tdo {"
NSQ_SOURCE_LINE 00000040 "\t\t\t\tmy @not = $class->_exporter_expand_tag(\"$1\", $value, $global_opts);"
NSQ_SOURCE_LINE 00000041 "\t\t\t\t++$not_want->{$_->[0]} for @not;"
NSQ_SOURCE_LINE 00000042 "\t\t\t} :"
NSQ_SOURCE_LINE 00000043 "\t\t($name =~ m{\\A\\!(.+)\\z}) ?"
NSQ_SOURCE_LINE 00000044 "\t\t\t(++$not_want->{$1}) :"
NSQ_SOURCE_LINE 00000045 "\t\t($name =~ m{\\A[:-](.+)\\z}) ?"
NSQ_SOURCE_LINE 00000046 "\t\t\tpush(@$opts, $class->_exporter_expand_tag(\"$1\", $value, $global_opts)) :"
NSQ_SOURCE_LINE 00000047 "\t\t($name =~ m{\\A/.+/[msixpodual]*\\z}) ?"
NSQ_SOURCE_LINE 00000048 "\t\t\tpush(@$opts, $class->_exporter_expand_regexp($name, $value, $global_opts)) :"
NSQ_SOURCE_LINE 00000049 "\t\t# else ?"
NSQ_SOURCE_LINE 00000050 "\t\t\tpush(@$want, $opt);"
NSQ_SOURCE_LINE 00000051 "\t}"
NSQ_SOURCE_LINE 00000052 "};"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "sub import"
NSQ_SOURCE_LINE 00000055 "{"
NSQ_SOURCE_LINE 00000056 "\tmy $class = shift;"
NSQ_SOURCE_LINE 00000057 "\tmy $global_opts = +{ @_ && ref($_[0]) eq q(HASH) ? %{+shift} : () };"
NSQ_SOURCE_LINE 00000058 "\t"
NSQ_SOURCE_LINE 00000059 "\tif ( defined $global_opts->{into} and $global_opts->{into} eq '-lexical' ) {"
NSQ_SOURCE_LINE 00000060 "\t\t$global_opts->{lexical} = 1;"
NSQ_SOURCE_LINE 00000061 "\t\tdelete $global_opts->{into};"
NSQ_SOURCE_LINE 00000062 "\t}"
NSQ_SOURCE_LINE 00000063 "\tif ( not defined $global_opts->{into} ) {"
NSQ_SOURCE_LINE 00000064 "\t\t$global_opts->{into} = caller;"
NSQ_SOURCE_LINE 00000065 "\t}"
NSQ_SOURCE_LINE 00000066 "\t"
NSQ_SOURCE_LINE 00000067 "\tmy @want;"
NSQ_SOURCE_LINE 00000068 "\tmy %not_want; $global_opts->{not} = \\%not_want;"
NSQ_SOURCE_LINE 00000069 "\tmy @args = do { no strict qw(refs); @_ ? @_ : @{\"$class\\::EXPORT\"} };"
NSQ_SOURCE_LINE 00000070 "\tmy $opts = mkopt(\\@args);"
NSQ_SOURCE_LINE 00000071 "\t$class->$_process_optlist($global_opts, $opts, \\@want, \\%not_want);"
NSQ_SOURCE_LINE 00000072 "\t"
NSQ_SOURCE_LINE 00000073 "\t$global_opts->{installer} ||= $class->_exporter_lexical_installer( $global_opts )"
NSQ_SOURCE_LINE 00000074 "\t\tif $global_opts->{lexical};"
NSQ_SOURCE_LINE 00000075 "\t"
NSQ_SOURCE_LINE 00000076 "\tmy $permitted = $class->_exporter_permitted_regexp($global_opts);"
NSQ_SOURCE_LINE 00000077 "\t$class->_exporter_validate_opts($global_opts);"
NSQ_SOURCE_LINE 00000078 "\t"
NSQ_SOURCE_LINE 00000079 "\tfor my $wanted (@want) {"
NSQ_SOURCE_LINE 00000080 "\t\tnext if $not_want{$wanted->[0]};"
NSQ_SOURCE_LINE 00000081 "\t\t"
NSQ_SOURCE_LINE 00000082 "\t\tmy %symbols = $class->_exporter_expand_sub(@$wanted, $global_opts, $permitted);"
NSQ_SOURCE_LINE 00000083 "\t\t$class->_exporter_install_sub($_, $wanted->[1], $global_opts, $symbols{$_})"
NSQ_SOURCE_LINE 00000084 "\t\t\tfor keys %symbols;"
NSQ_SOURCE_LINE 00000085 "\t}"
NSQ_SOURCE_LINE 00000086 "}"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "sub unimport"
NSQ_SOURCE_LINE 00000089 "{"
NSQ_SOURCE_LINE 00000090 "\tmy $class = shift;"
NSQ_SOURCE_LINE 00000091 "\tmy $global_opts = +{ @_ && ref($_[0]) eq q(HASH) ? %{+shift} : () };"
NSQ_SOURCE_LINE 00000092 "\t$global_opts->{is_unimport} = 1;"
NSQ_SOURCE_LINE 00000093 "\t"
NSQ_SOURCE_LINE 00000094 "\tif ( defined $global_opts->{into} and $global_opts->{into} eq '-lexical' ) {"
NSQ_SOURCE_LINE 00000095 "\t\t$global_opts->{lexical} = 1;"
NSQ_SOURCE_LINE 00000096 "\t\tdelete $global_opts->{into};"
NSQ_SOURCE_LINE 00000097 "\t}"
NSQ_SOURCE_LINE 00000098 "\tif ( not defined $global_opts->{into} ) {"
NSQ_SOURCE_LINE 00000099 "\t\t$global_opts->{into} = caller;"
NSQ_SOURCE_LINE 00000100 "\t}"
NSQ_SOURCE_LINE 00000101 "\t"
NSQ_SOURCE_LINE 00000102 "\tmy @want;"
NSQ_SOURCE_LINE 00000103 "\tmy %not_want; $global_opts->{not} = \\%not_want;"
NSQ_SOURCE_LINE 00000104 "\tmy @args = do { our %TRACKED; @_ ? @_ : keys(%{$TRACKED{$class}{$global_opts->{into}}}) };"
NSQ_SOURCE_LINE 00000105 "\tmy $opts = mkopt(\\@args);"
NSQ_SOURCE_LINE 00000106 "\t$class->$_process_optlist($global_opts, $opts, \\@want, \\%not_want);"
NSQ_SOURCE_LINE 00000107 "\t"
NSQ_SOURCE_LINE 00000108 "\tmy $permitted = $class->_exporter_permitted_regexp($global_opts);"
NSQ_SOURCE_LINE 00000109 "\t$class->_exporter_validate_unimport_opts($global_opts);"
NSQ_SOURCE_LINE 00000110 "\t"
NSQ_SOURCE_LINE 00000111 "\tmy $expando = $class->can('_exporter_expand_sub');"
NSQ_SOURCE_LINE 00000112 "\t$expando = undef if $expando == \\&_exporter_expand_sub;"
NSQ_SOURCE_LINE 00000113 "\t"
NSQ_SOURCE_LINE 00000114 "\tfor my $wanted (@want)"
NSQ_SOURCE_LINE 00000115 "\t{"
NSQ_SOURCE_LINE 00000116 "\t\tnext if $not_want{$wanted->[0]};"
NSQ_SOURCE_LINE 00000117 "\t\t"
NSQ_SOURCE_LINE 00000118 "\t\tif ($wanted->[1])"
NSQ_SOURCE_LINE 00000119 "\t\t{"
NSQ_SOURCE_LINE 00000120 "\t\t\t_carp(\"Passing options to unimport '%s' makes no sense\", $wanted->[0])"
NSQ_SOURCE_LINE 00000121 "\t\t\t\tunless (ref($wanted->[1]) eq 'HASH' and not keys %{$wanted->[1]});"
NSQ_SOURCE_LINE 00000122 "\t\t}"
NSQ_SOURCE_LINE 00000123 "\t\t"
NSQ_SOURCE_LINE 00000124 "\t\tmy %symbols = defined($expando)"
NSQ_SOURCE_LINE 00000125 "\t\t\t? $class->$expando(@$wanted, $global_opts, $permitted)"
NSQ_SOURCE_LINE 00000126 "\t\t\t: ($wanted->[0] => sub { \"dummy\" });"
NSQ_SOURCE_LINE 00000127 "\t\t$class->_exporter_uninstall_sub($_, $wanted->[1], $global_opts)"
NSQ_SOURCE_LINE 00000128 "\t\t\tfor keys %symbols;"
NSQ_SOURCE_LINE 00000129 "\t}"
NSQ_SOURCE_LINE 00000130 "}"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "# Returns a coderef suitable to be used as a sub installer for lexical imports."
NSQ_SOURCE_LINE 00000133 "#"
NSQ_SOURCE_LINE 00000134 "sub _exporter_lexical_installer {"
NSQ_SOURCE_LINE 00000135 "\t_HAS_NATIVE_LEXICAL_SUB and return sub {"
NSQ_SOURCE_LINE 00000136 "\t\tmy ( $sigilname, $sym ) = @{ $_[1] };"
NSQ_SOURCE_LINE 00000137 "\t\tno warnings ( \"$]\" >= 5.037002 ? 'experimental::builtin' : () );"
NSQ_SOURCE_LINE 00000138 "\t\tbuiltin::export_lexically( $sigilname, $sym );"
NSQ_SOURCE_LINE 00000139 "\t};"
NSQ_SOURCE_LINE 00000140 "\t_HAS_MODULE_LEXICAL_SUB and return sub {"
NSQ_SOURCE_LINE 00000141 "\t\tmy ( $sigilname, $sym ) = @{ $_[1] };"
NSQ_SOURCE_LINE 00000142 "\t\t( $sigilname =~ /^\\w/ )"
NSQ_SOURCE_LINE 00000143 "\t\t\t? 'Lexical::Sub'->import( $sigilname, $sym )"
NSQ_SOURCE_LINE 00000144 "\t\t\t: 'Lexical::Var'->import( $sigilname, $sym );"
NSQ_SOURCE_LINE 00000145 "\t};"
NSQ_SOURCE_LINE 00000146 "\t_croak( 'Lexical export requires Perl 5.37.2+ for native support, or Perl 5.11.2+ with the Lexical::Sub module' );"
NSQ_SOURCE_LINE 00000147 "}"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "# Called once per import/unimport, passed the \"global\" import options."
NSQ_SOURCE_LINE 00000150 "# Expected to validate the options and carp or croak if there are problems."
NSQ_SOURCE_LINE 00000151 "# Can also take the opportunity to do other stuff if needed."
NSQ_SOURCE_LINE 00000152 "#"
NSQ_SOURCE_LINE 00000153 "sub _exporter_validate_opts          { 1 }"
NSQ_SOURCE_LINE 00000154 "sub _exporter_validate_unimport_opts { 1 }"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "# Called after expanding a tag or regexp to merge the tag's options with"
NSQ_SOURCE_LINE 00000157 "# any sub-specific options."
NSQ_SOURCE_LINE 00000158 "#"
NSQ_SOURCE_LINE 00000159 "sub _exporter_merge_opts"
NSQ_SOURCE_LINE 00000160 "{"
NSQ_SOURCE_LINE 00000161 "\tmy $class = shift;"
NSQ_SOURCE_LINE 00000162 "\tmy ($tag_opts, $global_opts, @stuff) = @_;"
NSQ_SOURCE_LINE 00000163 "\t"
NSQ_SOURCE_LINE 00000164 "\t$tag_opts = {} unless ref($tag_opts) eq q(HASH);"
NSQ_SOURCE_LINE 00000165 "\t_croak('Cannot provide an -as option for tags')"
NSQ_SOURCE_LINE 00000166 "\t\tif exists $tag_opts->{-as} && ref $tag_opts->{-as} ne 'CODE';"
NSQ_SOURCE_LINE 00000167 "\t"
NSQ_SOURCE_LINE 00000168 "\tmy $optlist = mkopt(\\@stuff);"
NSQ_SOURCE_LINE 00000169 "\tfor my $export (@$optlist)"
NSQ_SOURCE_LINE 00000170 "\t{"
NSQ_SOURCE_LINE 00000171 "\t\tnext if defined($export->[1]) && ref($export->[1]) ne q(HASH);"
NSQ_SOURCE_LINE 00000172 "\t\t"
NSQ_SOURCE_LINE 00000173 "\t\tmy %sub_opts = ( %{ $export->[1] or {} }, %$tag_opts );"
NSQ_SOURCE_LINE 00000174 "\t\t$sub_opts{-prefix} = sprintf('%s%s', $tag_opts->{-prefix}, $export->[1]{-prefix})"
NSQ_SOURCE_LINE 00000175 "\t\t\tif exists($export->[1]{-prefix}) && exists($tag_opts->{-prefix});"
NSQ_SOURCE_LINE 00000176 "\t\t$sub_opts{-suffix} = sprintf('%s%s', $export->[1]{-suffix}, $tag_opts->{-suffix})"
NSQ_SOURCE_LINE 00000177 "\t\t\tif exists($export->[1]{-suffix}) && exists($tag_opts->{-suffix});"
NSQ_SOURCE_LINE 00000178 "\t\t$export->[1] = \\%sub_opts;"
NSQ_SOURCE_LINE 00000179 "\t}"
NSQ_SOURCE_LINE 00000180 "\treturn @$optlist;"
NSQ_SOURCE_LINE 00000181 "}"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "# Given a tag name, looks it up in %EXPORT_TAGS and returns the list of"
NSQ_SOURCE_LINE 00000184 "# associated functions. The default implementation magically handles tags"
NSQ_SOURCE_LINE 00000185 "# \"all\" and \"default\". The default implementation interprets any undefined"
NSQ_SOURCE_LINE 00000186 "# tags as being global options."
NSQ_SOURCE_LINE 00000187 "# "
NSQ_SOURCE_LINE 00000188 "sub _exporter_expand_tag"
NSQ_SOURCE_LINE 00000189 "{"
NSQ_SOURCE_LINE 00000190 "\tno strict qw(refs);"
NSQ_SOURCE_LINE 00000191 "\t"
NSQ_SOURCE_LINE 00000192 "\tmy $class = shift;"
NSQ_SOURCE_LINE 00000193 "\tmy ($name, $value, $globals) = @_;"
NSQ_SOURCE_LINE 00000194 "\tmy $tags  = \\%{\"$class\\::EXPORT_TAGS\"};"
NSQ_SOURCE_LINE 00000195 "\t"
NSQ_SOURCE_LINE 00000196 "\treturn $class->_exporter_merge_opts($value, $globals, $tags->{$name}->($class, @_))"
NSQ_SOURCE_LINE 00000197 "\t\tif ref($tags->{$name}) eq q(CODE);"
NSQ_SOURCE_LINE 00000198 "\t"
NSQ_SOURCE_LINE 00000199 "\treturn $class->_exporter_merge_opts($value, $globals, @{$tags->{$name}})"
NSQ_SOURCE_LINE 00000200 "\t\tif exists $tags->{$name};"
NSQ_SOURCE_LINE 00000201 "\t"
NSQ_SOURCE_LINE 00000202 "\treturn $class->_exporter_merge_opts($value, $globals, @{\"$class\\::EXPORT\"}, @{\"$class\\::EXPORT_OK\"})"
NSQ_SOURCE_LINE 00000203 "\t\tif $name eq 'all';"
NSQ_SOURCE_LINE 00000204 "\t"
NSQ_SOURCE_LINE 00000205 "\treturn $class->_exporter_merge_opts($value, $globals, @{\"$class\\::EXPORT\"})"
NSQ_SOURCE_LINE 00000206 "\t\tif $name eq 'default';"
NSQ_SOURCE_LINE 00000207 "\t"
NSQ_SOURCE_LINE 00000208 "\t$globals->{$name} = $value || 1;"
NSQ_SOURCE_LINE 00000209 "\treturn;"
NSQ_SOURCE_LINE 00000210 "}"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "# Given a regexp-like string, looks it up in @EXPORT_OK and returns the"
NSQ_SOURCE_LINE 00000213 "# list of matching functions."
NSQ_SOURCE_LINE 00000214 "# "
NSQ_SOURCE_LINE 00000215 "sub _exporter_expand_regexp"
NSQ_SOURCE_LINE 00000216 "{"
NSQ_SOURCE_LINE 00000217 "\tno strict qw(refs);"
NSQ_SOURCE_LINE 00000218 "\tour %TRACKED;"
NSQ_SOURCE_LINE 00000219 "\t"
NSQ_SOURCE_LINE 00000220 "\tmy $class = shift;"
NSQ_SOURCE_LINE 00000221 "\tmy ($name, $value, $globals) = @_;"
NSQ_SOURCE_LINE 00000222 "\tmy $compiled = eval(\"qr$name\");"
NSQ_SOURCE_LINE 00000223 "\t"
NSQ_SOURCE_LINE 00000224 "\tmy @possible = $globals->{is_unimport}"
NSQ_SOURCE_LINE 00000225 "\t\t? keys( %{$TRACKED{$class}{$globals->{into}}} )"
NSQ_SOURCE_LINE 00000226 "\t\t: @{\"$class\\::EXPORT_OK\"};"
NSQ_SOURCE_LINE 00000227 "\t"
NSQ_SOURCE_LINE 00000228 "\t$class->_exporter_merge_opts($value, $globals, grep /$compiled/, @possible);"
NSQ_SOURCE_LINE 00000229 "}"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "# Helper for _exporter_expand_sub. Returns a regexp matching all subs in"
NSQ_SOURCE_LINE 00000232 "# the exporter package which are available for export."
NSQ_SOURCE_LINE 00000233 "#"
NSQ_SOURCE_LINE 00000234 "sub _exporter_permitted_regexp"
NSQ_SOURCE_LINE 00000235 "{"
NSQ_SOURCE_LINE 00000236 "\tno strict qw(refs);"
NSQ_SOURCE_LINE 00000237 "\tmy $class = shift;"
NSQ_SOURCE_LINE 00000238 "\tmy $re = join \"|\", map quotemeta, sort {"
NSQ_SOURCE_LINE 00000239 "\t\tlength($b) <=> length($a) or $a cmp $b"
NSQ_SOURCE_LINE 00000240 "\t} @{\"$class\\::EXPORT\"}, @{\"$class\\::EXPORT_OK\"};"
NSQ_SOURCE_LINE 00000241 "\tqr{^(?:$re)$}ms;"
NSQ_SOURCE_LINE 00000242 "}"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "# Given a sub name, returns a hash of subs to install (usually just one sub)."
NSQ_SOURCE_LINE 00000245 "# Keys are sub names, values are coderefs."
NSQ_SOURCE_LINE 00000246 "#"
NSQ_SOURCE_LINE 00000247 "sub _exporter_expand_sub"
NSQ_SOURCE_LINE 00000248 "{"
NSQ_SOURCE_LINE 00000249 "\tmy $class = shift;"
NSQ_SOURCE_LINE 00000250 "\tmy ($name, $value, $globals, $permitted) = @_;"
NSQ_SOURCE_LINE 00000251 "\t$permitted ||= $class->_exporter_permitted_regexp($globals);"
NSQ_SOURCE_LINE 00000252 "\t"
NSQ_SOURCE_LINE 00000253 "\tno strict qw(refs);"
NSQ_SOURCE_LINE 00000254 "\t"
NSQ_SOURCE_LINE 00000255 "\tmy $sigil = \"&\";"
NSQ_SOURCE_LINE 00000256 "\tif ($name =~ /\\A([&\\$\\%\\@\\*])(.+)\\z/) {"
NSQ_SOURCE_LINE 00000257 "\t\t$sigil = $1;"
NSQ_SOURCE_LINE 00000258 "\t\t$name  = $2;"
NSQ_SOURCE_LINE 00000259 "\t\tif ($sigil eq '*') {"
NSQ_SOURCE_LINE 00000260 "\t\t\t_croak(\"Cannot export symbols with a * sigil\");"
NSQ_SOURCE_LINE 00000261 "\t\t}"
NSQ_SOURCE_LINE 00000262 "\t}"
NSQ_SOURCE_LINE 00000263 "\tmy $sigilname = $sigil eq '&' ? $name : \"$sigil$name\";"
NSQ_SOURCE_LINE 00000264 "\t"
NSQ_SOURCE_LINE 00000265 "\tif ($sigilname =~ $permitted)"
NSQ_SOURCE_LINE 00000266 "\t{"
NSQ_SOURCE_LINE 00000267 "\t\tmy $generatorprefix = {"
NSQ_SOURCE_LINE 00000268 "\t\t\t'&' => \"_generate_\","
NSQ_SOURCE_LINE 00000269 "\t\t\t'$' => \"_generateScalar_\","
NSQ_SOURCE_LINE 00000270 "\t\t\t'@' => \"_generateArray_\","
NSQ_SOURCE_LINE 00000271 "\t\t\t'%' => \"_generateHash_\","
NSQ_SOURCE_LINE 00000272 "\t\t}->{$sigil};"
NSQ_SOURCE_LINE 00000273 "\t\t"
NSQ_SOURCE_LINE 00000274 "\t\tmy $generator = $class->can(\"$generatorprefix$name\");"
NSQ_SOURCE_LINE 00000275 "\t\treturn $sigilname => $class->$generator($sigilname, $value, $globals) if $generator;"
NSQ_SOURCE_LINE 00000276 "\t\t"
NSQ_SOURCE_LINE 00000277 "\t\tif ($sigil eq '&') {"
NSQ_SOURCE_LINE 00000278 "\t\t\tmy $sub = $class->can($name);"
NSQ_SOURCE_LINE 00000279 "\t\t\treturn $sigilname => $sub if $sub;"
NSQ_SOURCE_LINE 00000280 "\t\t}"
NSQ_SOURCE_LINE 00000281 "\t\telse {"
NSQ_SOURCE_LINE 00000282 "\t\t\t# Could do this more cleverly, but this works."
NSQ_SOURCE_LINE 00000283 "\t\t\tmy $evalled = eval \"\\\\${sigil}${class}::${name}\";"
NSQ_SOURCE_LINE 00000284 "\t\t\treturn $sigilname => $evalled if $evalled;"
NSQ_SOURCE_LINE 00000285 "\t\t}"
NSQ_SOURCE_LINE 00000286 "\t}"
NSQ_SOURCE_LINE 00000287 "\t"
NSQ_SOURCE_LINE 00000288 "\t$class->_exporter_fail(@_);"
NSQ_SOURCE_LINE 00000289 "}"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "# Called by _exporter_expand_sub if it is unable to generate a key-value"
NSQ_SOURCE_LINE 00000292 "# pair for a sub."
NSQ_SOURCE_LINE 00000293 "#"
NSQ_SOURCE_LINE 00000294 "sub _exporter_fail"
NSQ_SOURCE_LINE 00000295 "{"
NSQ_SOURCE_LINE 00000296 "\tmy $class = shift;"
NSQ_SOURCE_LINE 00000297 "\tmy ($name, $value, $globals) = @_;"
NSQ_SOURCE_LINE 00000298 "\treturn if $globals->{is_unimport};"
NSQ_SOURCE_LINE 00000299 "\t_croak(\"Could not find sub '%s' exported by %s\", $name, $class);"
NSQ_SOURCE_LINE 00000300 "}"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "# Actually performs the installation of the sub into the target package. This"
NSQ_SOURCE_LINE 00000303 "# also handles renaming the sub."
NSQ_SOURCE_LINE 00000304 "#"
NSQ_SOURCE_LINE 00000305 "sub _exporter_install_sub"
NSQ_SOURCE_LINE 00000306 "{"
NSQ_SOURCE_LINE 00000307 "\tmy $class = shift;"
NSQ_SOURCE_LINE 00000308 "\tmy ($name, $value, $globals, $sym) = @_;"
NSQ_SOURCE_LINE 00000309 "\tmy $value_hash = ( ref($value) eq 'HASH' ) ? $value : {};"
NSQ_SOURCE_LINE 00000310 "\t"
NSQ_SOURCE_LINE 00000311 "\tmy $into      = $globals->{into};"
NSQ_SOURCE_LINE 00000312 "\tmy $installer = $globals->{installer} || $globals->{exporter};"
NSQ_SOURCE_LINE 00000313 "\t"
NSQ_SOURCE_LINE 00000314 "\t$name ="
NSQ_SOURCE_LINE 00000315 "\t\tref    $globals->{as}      ? $globals->{as}->($name) :"
NSQ_SOURCE_LINE 00000316 "\t\tref    $value_hash->{-as}  ? $value_hash->{-as}->($name) :"
NSQ_SOURCE_LINE 00000317 "\t\texists $value_hash->{-as}  ? $value_hash->{-as} :"
NSQ_SOURCE_LINE 00000318 "\t\t$name;"
NSQ_SOURCE_LINE 00000319 "\t"
NSQ_SOURCE_LINE 00000320 "\treturn unless defined $name;"
NSQ_SOURCE_LINE 00000321 "\t"
NSQ_SOURCE_LINE 00000322 "\tmy $sigil = \"&\";"
NSQ_SOURCE_LINE 00000323 "\tunless (ref($name)) {"
NSQ_SOURCE_LINE 00000324 "\t\tif ($name =~ /\\A([&\\$\\%\\@\\*])(.+)\\z/) {"
NSQ_SOURCE_LINE 00000325 "\t\t\t$sigil = $1;"
NSQ_SOURCE_LINE 00000326 "\t\t\t$name  = $2;"
NSQ_SOURCE_LINE 00000327 "\t\t\tif ($sigil eq '*') {"
NSQ_SOURCE_LINE 00000328 "\t\t\t\t_croak(\"Cannot export symbols with a * sigil\");"
NSQ_SOURCE_LINE 00000329 "\t\t\t}"
NSQ_SOURCE_LINE 00000330 "\t\t}"
NSQ_SOURCE_LINE 00000331 "\t\tmy ($prefix) = grep defined, $value_hash->{-prefix}, $globals->{prefix}, q();"
NSQ_SOURCE_LINE 00000332 "\t\tmy ($suffix) = grep defined, $value_hash->{-suffix}, $globals->{suffix}, q();"
NSQ_SOURCE_LINE 00000333 "\t\t$name = \"$prefix$name$suffix\";"
NSQ_SOURCE_LINE 00000334 "\t}"
NSQ_SOURCE_LINE 00000335 "\t"
NSQ_SOURCE_LINE 00000336 "\tmy $sigilname = $sigil eq '&' ? $name : ( $sigil . $name );"
NSQ_SOURCE_LINE 00000337 "\t"
NSQ_SOURCE_LINE 00000338 "#\tif ({qw/$ SCALAR @ ARRAY % HASH & CODE/}->{$sigil} ne ref($sym)) {"
NSQ_SOURCE_LINE 00000339 "#\t\twarn $sym;"
NSQ_SOURCE_LINE 00000340 "#\t\twarn $sigilname;"
NSQ_SOURCE_LINE 00000341 "#\t\t_croak(\"Reference type %s does not match sigil %s\", ref($sym), $sigil);"
NSQ_SOURCE_LINE 00000342 "#\t}"
NSQ_SOURCE_LINE 00000343 "\t"
NSQ_SOURCE_LINE 00000344 "\treturn ($$name = $sym)              if ref($name) eq q(SCALAR);"
NSQ_SOURCE_LINE 00000345 "\treturn ($into->{$sigilname} = $sym) if ref($into) eq q(HASH);"
NSQ_SOURCE_LINE 00000346 "\t"
NSQ_SOURCE_LINE 00000347 "\tno strict qw(refs);"
NSQ_SOURCE_LINE 00000348 "\tour %TRACKED;"
NSQ_SOURCE_LINE 00000349 "\t"
NSQ_SOURCE_LINE 00000350 "\tif ( ref($sym) eq 'CODE'"
NSQ_SOURCE_LINE 00000351 "\tand ref($into) ? exists($into->{$name}) : exists(&{\"$into\\::$name\"})"
NSQ_SOURCE_LINE 00000352 "\tand $sym != ( ref($into) ? $into->{$name} : \\&{\"$into\\::$name\"} ) )"
NSQ_SOURCE_LINE 00000353 "\t{"
NSQ_SOURCE_LINE 00000354 "\t\tmy ($level) = grep defined, $value_hash->{-replace}, $globals->{replace}, q(0);"
NSQ_SOURCE_LINE 00000355 "\t\tmy $action = {"
NSQ_SOURCE_LINE 00000356 "\t\t\tcarp     => \\&_carp,"
NSQ_SOURCE_LINE 00000357 "\t\t\t0        => \\&_carp,"
NSQ_SOURCE_LINE 00000358 "\t\t\t''       => \\&_carp,"
NSQ_SOURCE_LINE 00000359 "\t\t\twarn     => \\&_carp,"
NSQ_SOURCE_LINE 00000360 "\t\t\tnonfatal => \\&_carp,"
NSQ_SOURCE_LINE 00000361 "\t\t\tcroak    => \\&_croak,"
NSQ_SOURCE_LINE 00000362 "\t\t\tfatal    => \\&_croak,"
NSQ_SOURCE_LINE 00000363 "\t\t\tdie      => \\&_croak,"
NSQ_SOURCE_LINE 00000364 "\t\t}->{$level} || sub {};"
NSQ_SOURCE_LINE 00000365 "\t\t"
NSQ_SOURCE_LINE 00000366 "\t\t# Don't complain about double-installing the same sub. This isn't ideal"
NSQ_SOURCE_LINE 00000367 "\t\t# because the same named sub might be generated in two different ways."
NSQ_SOURCE_LINE 00000368 "\t\t$action = sub {} if $TRACKED{$class}{$into}{$sigilname};"
NSQ_SOURCE_LINE 00000369 "\t\t"
NSQ_SOURCE_LINE 00000370 "\t\t$action->("
NSQ_SOURCE_LINE 00000371 "\t\t\t$action == \\&_croak"
NSQ_SOURCE_LINE 00000372 "\t\t\t\t? \"Refusing to overwrite existing sub '%s' with sub '%s' exported by %s\""
NSQ_SOURCE_LINE 00000373 "\t\t\t\t: \"Overwriting existing sub '%s' with sub '%s' exported by %s\","
NSQ_SOURCE_LINE 00000374 "\t\t\tref($into) ? $name : \"$into\\::$name\","
NSQ_SOURCE_LINE 00000375 "\t\t\t$_[0],"
NSQ_SOURCE_LINE 00000376 "\t\t\t$class,"
NSQ_SOURCE_LINE 00000377 "\t\t);"
NSQ_SOURCE_LINE 00000378 "\t}"
NSQ_SOURCE_LINE 00000379 "\t"
NSQ_SOURCE_LINE 00000380 "\t$TRACKED{$class}{$into}{$sigilname} = $sym;"
NSQ_SOURCE_LINE 00000381 "\t"
NSQ_SOURCE_LINE 00000382 "\tno warnings qw(prototype);"
NSQ_SOURCE_LINE 00000383 "\t$installer"
NSQ_SOURCE_LINE 00000384 "\t\t? $installer->($globals, [$sigilname, $sym])"
NSQ_SOURCE_LINE 00000385 "\t\t: (*{\"$into\\::$name\"} = $sym);"
NSQ_SOURCE_LINE 00000386 "}"
NSQ_SOURCE_LINE 00000387 ""
NSQ_SOURCE_LINE 00000388 "sub _exporter_uninstall_sub"
NSQ_SOURCE_LINE 00000389 "{"
NSQ_SOURCE_LINE 00000390 "\tour %TRACKED;"
NSQ_SOURCE_LINE 00000391 "\tmy $class = shift;"
NSQ_SOURCE_LINE 00000392 "\tmy ($name, $value, $globals, $sym) = @_;"
NSQ_SOURCE_LINE 00000393 "\tmy $into = $globals->{into};"
NSQ_SOURCE_LINE 00000394 "\tref $into and return;"
NSQ_SOURCE_LINE 00000395 "\t"
NSQ_SOURCE_LINE 00000396 "\tno strict qw(refs);"
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "\tmy $sigil = \"&\";"
NSQ_SOURCE_LINE 00000399 "\tif ($name =~ /\\A([&\\$\\%\\@\\*])(.+)\\z/) {"
NSQ_SOURCE_LINE 00000400 "\t\t$sigil = $1;"
NSQ_SOURCE_LINE 00000401 "\t\t$name  = $2;"
NSQ_SOURCE_LINE 00000402 "\t\tif ($sigil eq '*') {"
NSQ_SOURCE_LINE 00000403 "\t\t\t_croak(\"Cannot export symbols with a * sigil\");"
NSQ_SOURCE_LINE 00000404 "\t\t}"
NSQ_SOURCE_LINE 00000405 "\t}"
NSQ_SOURCE_LINE 00000406 "\tmy $sigilname = $sigil eq '&' ? $name : \"$sigil$name\";"
NSQ_SOURCE_LINE 00000407 "\t"
NSQ_SOURCE_LINE 00000408 "\tif ($sigil ne '&') {"
NSQ_SOURCE_LINE 00000409 "\t\t_croak(\"Unimporting non-code symbols not supported yet\");"
NSQ_SOURCE_LINE 00000410 "\t}"
NSQ_SOURCE_LINE 00000411 ""
NSQ_SOURCE_LINE 00000412 "\t# Cowardly refuse to uninstall a sub that differs from the one"
NSQ_SOURCE_LINE 00000413 "\t# we installed!"
NSQ_SOURCE_LINE 00000414 "\tmy $our_coderef = $TRACKED{$class}{$into}{$name};"
NSQ_SOURCE_LINE 00000415 "\tmy $cur_coderef = exists(&{\"$into\\::$name\"}) ? \\&{\"$into\\::$name\"} : -1;"
NSQ_SOURCE_LINE 00000416 "\treturn unless $our_coderef == $cur_coderef;"
NSQ_SOURCE_LINE 00000417 "\t"
NSQ_SOURCE_LINE 00000418 "\tmy $stash     = \\%{\"$into\\::\"};"
NSQ_SOURCE_LINE 00000419 "\tmy $old       = delete $stash->{$name};"
NSQ_SOURCE_LINE 00000420 "\tmy $full_name = join('::', $into, $name);"
NSQ_SOURCE_LINE 00000421 "\tforeach my $type (qw(SCALAR HASH ARRAY IO)) # everything but the CODE"
NSQ_SOURCE_LINE 00000422 "\t{"
NSQ_SOURCE_LINE 00000423 "\t\tnext unless defined(*{$old}{$type});"
NSQ_SOURCE_LINE 00000424 "\t\t*$full_name = *{$old}{$type};"
NSQ_SOURCE_LINE 00000425 "\t}"
NSQ_SOURCE_LINE 00000426 "\t"
NSQ_SOURCE_LINE 00000427 "\tdelete $TRACKED{$class}{$into}{$name};"
NSQ_SOURCE_LINE 00000428 "}"
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "sub mkopt"
NSQ_SOURCE_LINE 00000431 "{"
NSQ_SOURCE_LINE 00000432 "\tmy $in = shift or return [];"
NSQ_SOURCE_LINE 00000433 "\tmy @out;"
NSQ_SOURCE_LINE 00000434 "\t"
NSQ_SOURCE_LINE 00000435 "\t$in = [map(($_ => ref($in->{$_}) ? $in->{$_} : ()), sort keys %$in)]"
NSQ_SOURCE_LINE 00000436 "\t\tif ref($in) eq q(HASH);"
NSQ_SOURCE_LINE 00000437 "\t"
NSQ_SOURCE_LINE 00000438 "\tfor (my $i = 0; $i < @$in; $i++)"
NSQ_SOURCE_LINE 00000439 "\t{"
NSQ_SOURCE_LINE 00000440 "\t\tmy $k = $in->[$i];"
NSQ_SOURCE_LINE 00000441 "\t\tmy $v;"
NSQ_SOURCE_LINE 00000442 "\t\t"
NSQ_SOURCE_LINE 00000443 "\t\t($i == $#$in)         ? ($v = undef) :"
NSQ_SOURCE_LINE 00000444 "\t\t!defined($in->[$i+1]) ? (++$i, ($v = undef)) :"
NSQ_SOURCE_LINE 00000445 "\t\t!ref($in->[$i+1])     ? ($v = undef) :"
NSQ_SOURCE_LINE 00000446 "\t\t($v = $in->[++$i]);"
NSQ_SOURCE_LINE 00000447 "\t\t"
NSQ_SOURCE_LINE 00000448 "\t\tpush @out, [ $k => $v ];"
NSQ_SOURCE_LINE 00000449 "\t}"
NSQ_SOURCE_LINE 00000450 "\t"
NSQ_SOURCE_LINE 00000451 "\t\\@out;"
NSQ_SOURCE_LINE 00000452 "}"
NSQ_SOURCE_LINE 00000453 ""
NSQ_SOURCE_LINE 00000454 "sub mkopt_hash"
NSQ_SOURCE_LINE 00000455 "{"
NSQ_SOURCE_LINE 00000456 "\tmy $in  = shift or return;"
NSQ_SOURCE_LINE 00000457 "\tmy %out = map +($_->[0] => $_->[1]), @{ mkopt($in) };"
NSQ_SOURCE_LINE 00000458 "\t\\%out;"
NSQ_SOURCE_LINE 00000459 "}"
NSQ_SOURCE_LINE 00000460 ""
NSQ_SOURCE_LINE 00000461 "1;"
NSQ_SOURCE_LINE 00000462 ""
NSQ_SOURCE_LINE 00000463 "__END__"
NSQ_SOURCE_LINE 00000464 ""
NSQ_SOURCE_LINE 00000465 "=pod"
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "=encoding utf-8"
NSQ_SOURCE_LINE 00000468 ""
NSQ_SOURCE_LINE 00000469 "=for stopwords frobnicate greps regexps"
NSQ_SOURCE_LINE 00000470 ""
NSQ_SOURCE_LINE 00000471 "=head1 NAME"
NSQ_SOURCE_LINE 00000472 ""
NSQ_SOURCE_LINE 00000473 "Exporter::Tiny - an exporter with the features of Sub::Exporter but only core dependencies"
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000476 ""
NSQ_SOURCE_LINE 00000477 "   package MyUtils;"
NSQ_SOURCE_LINE 00000478 "   use base \"Exporter::Tiny\";"
NSQ_SOURCE_LINE 00000479 "   our @EXPORT = qw(frobnicate);"
NSQ_SOURCE_LINE 00000480 "   sub frobnicate { ... }"
NSQ_SOURCE_LINE 00000481 "   1;"
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 "   package MyScript;"
NSQ_SOURCE_LINE 00000484 "   use MyUtils \"frobnicate\" => { -as => \"frob\" };"
NSQ_SOURCE_LINE 00000485 "   print frob(42);"
NSQ_SOURCE_LINE 00000486 "   exit;"
NSQ_SOURCE_LINE 00000487 ""
NSQ_SOURCE_LINE 00000488 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000489 ""
NSQ_SOURCE_LINE 00000490 "Exporter::Tiny supports many of Sub::Exporter's external-facing features"
NSQ_SOURCE_LINE 00000491 "including renaming imported functions with the C<< -as >>, C<< -prefix >> and"
NSQ_SOURCE_LINE 00000492 "C<< -suffix >> options; explicit destinations with the C<< into >> option;"
NSQ_SOURCE_LINE 00000493 "and alternative installers with the C<< installer >> option. But it's written"
NSQ_SOURCE_LINE 00000494 "in only about 40% as many lines of code and with zero non-core dependencies."
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "Its internal-facing interface is closer to Exporter.pm, with configuration"
NSQ_SOURCE_LINE 00000497 "done through the C<< @EXPORT >>, C<< @EXPORT_OK >> and C<< %EXPORT_TAGS >>"
NSQ_SOURCE_LINE 00000498 "package variables."
NSQ_SOURCE_LINE 00000499 ""
NSQ_SOURCE_LINE 00000500 "If you are trying to B<write> a module that inherits from Exporter::Tiny,"
NSQ_SOURCE_LINE 00000501 "then look at:"
NSQ_SOURCE_LINE 00000502 ""
NSQ_SOURCE_LINE 00000503 "=over"
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "=item *"
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "L<Exporter::Tiny::Manual::QuickStart>"
NSQ_SOURCE_LINE 00000508 ""
NSQ_SOURCE_LINE 00000509 "=item *"
NSQ_SOURCE_LINE 00000510 ""
NSQ_SOURCE_LINE 00000511 "L<Exporter::Tiny::Manual::Exporting>"
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "=back"
NSQ_SOURCE_LINE 00000514 ""
NSQ_SOURCE_LINE 00000515 "If you are trying to B<use> a module that inherits from Exporter::Tiny,"
NSQ_SOURCE_LINE 00000516 "then look at:"
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "=over"
NSQ_SOURCE_LINE 00000519 ""
NSQ_SOURCE_LINE 00000520 "=item *"
NSQ_SOURCE_LINE 00000521 ""
NSQ_SOURCE_LINE 00000522 "L<Exporter::Tiny::Manual::Importing>"
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 "=back"
NSQ_SOURCE_LINE 00000525 ""
