BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Math::Random::ISAAC;"
NSQ_SOURCE_LINE 00000002 "BEGIN {"
NSQ_SOURCE_LINE 00000003 "  $Math::Random::ISAAC::VERSION = '1.004';"
NSQ_SOURCE_LINE 00000004 "}"
NSQ_SOURCE_LINE 00000005 "# ABSTRACT: Perl interface to the ISAAC PRNG algorithm"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "use strict;"
NSQ_SOURCE_LINE 00000008 "use warnings;"
NSQ_SOURCE_LINE 00000009 "use Carp ();"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "our $DRIVER = 'PP';"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "# Try to load the XS version first"
NSQ_SOURCE_LINE 00000014 "eval {"
NSQ_SOURCE_LINE 00000015 "  require Math::Random::ISAAC::XS;"
NSQ_SOURCE_LINE 00000016 "  $DRIVER = 'XS';"
NSQ_SOURCE_LINE 00000017 "};"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "# Fall back on the Perl version"
NSQ_SOURCE_LINE 00000020 "if ($@) {"
NSQ_SOURCE_LINE 00000021 "  require Math::Random::ISAAC::PP;"
NSQ_SOURCE_LINE 00000022 "}"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "# Wrappers around the actual methods"
NSQ_SOURCE_LINE 00000026 "sub new {"
NSQ_SOURCE_LINE 00000027 "  my ($class, @seed) = @_;"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "  Carp::croak('You must call this as a class method') if ref($class);"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "  my $self = {"
NSQ_SOURCE_LINE 00000032 "  };"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "  if ($DRIVER eq 'XS') {"
NSQ_SOURCE_LINE 00000035 "    $self->{backend} = Math::Random::ISAAC::XS->new(@seed);"
NSQ_SOURCE_LINE 00000036 "  }"
NSQ_SOURCE_LINE 00000037 "  else {"
NSQ_SOURCE_LINE 00000038 "    $self->{backend} = Math::Random::ISAAC::PP->new(@seed);"
NSQ_SOURCE_LINE 00000039 "  }"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "  bless($self, $class);"
NSQ_SOURCE_LINE 00000042 "  return $self;"
NSQ_SOURCE_LINE 00000043 "}"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "# This package should have an interface similar to the builtin Perl"
NSQ_SOURCE_LINE 00000047 "# random number routines; these are methods, not functions, so they"
NSQ_SOURCE_LINE 00000048 "# are not problematic"
NSQ_SOURCE_LINE 00000049 "## no critic (ProhibitBuiltinHomonyms)"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "sub rand {"
NSQ_SOURCE_LINE 00000052 "  my ($self) = @_;"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "  Carp::croak('You must call this method as an object') unless ref($self);"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "  return $self->{backend}->rand();"
NSQ_SOURCE_LINE 00000057 "}"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "sub irand {"
NSQ_SOURCE_LINE 00000061 "  my ($self) = @_;"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "  Carp::croak('You must call this method as an object') unless ref($self);"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "  return $self->{backend}->irand();"
NSQ_SOURCE_LINE 00000066 "}"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "1;"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "__END__"
NSQ_SOURCE_LINE 00000072 "=pod"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "=head1 NAME"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "Math::Random::ISAAC - Perl interface to the ISAAC PRNG algorithm"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "=head1 VERSION"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "version 1.004"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "  use Math::Random::ISAAC;"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "  my $rng = Math::Random::ISAAC->new(@seeds);"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "  for (0..30) {"
NSQ_SOURCE_LINE 00000089 "    print 'Result: ' . $rng->irand() . \"\\n\";"
NSQ_SOURCE_LINE 00000090 "  }"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "As with other Pseudo-Random Number Generator (PRNG) algorithms like the"
NSQ_SOURCE_LINE 00000095 "Mersenne Twister (see L<Math::Random::MT>), this algorithm is designed to"
NSQ_SOURCE_LINE 00000096 "take some seed information and produce seemingly random results as output."
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "However, ISAAC (Indirection, Shift, Accumulate, Add, and Count) has different"
NSQ_SOURCE_LINE 00000099 "goals than these commonly used algorithms. In particular, it's really fast -"
NSQ_SOURCE_LINE 00000100 "on average, it requires only 18.75 machine cycles to generate a 32-bit value."
NSQ_SOURCE_LINE 00000101 "This makes it suitable for applications where a significant amount of random"
NSQ_SOURCE_LINE 00000102 "data needs to be produced quickly, such solving using the Monte Carlo method"
NSQ_SOURCE_LINE 00000103 "or for games."
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "The results are uniformly distributed, unbiased, and unpredictable unless"
NSQ_SOURCE_LINE 00000106 "you know the seed. The algorithm was published by Bob Jenkins in the late"
NSQ_SOURCE_LINE 00000107 "90s and despite the best efforts of many security researchers, no feasible"
NSQ_SOURCE_LINE 00000108 "attacks have been found to date."
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "=head2 USAGE WARNING"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "There was no method supplied to provide the initial seed data by the author."
NSQ_SOURCE_LINE 00000113 "On his web site, Bob Jenkins writes:"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "  Seeding a random number generator is essentially the same problem as"
NSQ_SOURCE_LINE 00000116 "  encrypting the seed with a block cipher."
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "In the same spirit, by default, this module does not seed the algorithm at"
NSQ_SOURCE_LINE 00000119 "all -- it simply fills the state with zeroes -- if no seed is provided."
NSQ_SOURCE_LINE 00000120 "The idea is to remind users that selecting good seed data for their purpose"
NSQ_SOURCE_LINE 00000121 "is important, and for the module to conveniently set it to something like"
NSQ_SOURCE_LINE 00000122 "C<localtime> behind-the-scenes hurts users in the long run, since they don't"
NSQ_SOURCE_LINE 00000123 "understand the limitations of doing so."
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "The type of seed you might want to use depends entirely on the purpose of"
NSQ_SOURCE_LINE 00000126 "using this algorithm in your program in the first place. Here are some"
NSQ_SOURCE_LINE 00000127 "possible seeding methods:"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "=over"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "=item 1 Math::TrulyRandom"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "The L<Math::TrulyRandom> module provides a way of obtaining truly random"
NSQ_SOURCE_LINE 00000134 "data by using timing interrupts. This is probably one of the better ways"
NSQ_SOURCE_LINE 00000135 "to seed the algorithm."
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "=item 2 /dev/random"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "Using the system random device is, in principle, the best idea, since it"
NSQ_SOURCE_LINE 00000140 "gathers entropy from various sources including interrupt timing, other"
NSQ_SOURCE_LINE 00000141 "device interrupts, etc. However, it's not portable to anything other than"
NSQ_SOURCE_LINE 00000142 "Unix-like platforms, and might not produce good data on some systems."
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "=item 3 localtime()"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "This works for basic things like simulations, but results in not-so-random"
NSQ_SOURCE_LINE 00000147 "output, especially if you create new instances quickly (as the seeds would"
NSQ_SOURCE_LINE 00000148 "be the same within per-second resolution)."
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "=item 4 Time::HiRes"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "In theory, using L<Time::HiRes> is the same as option (2), but you get a"
NSQ_SOURCE_LINE 00000153 "higher resolution time so you're less likely to have the same seed twice."
NSQ_SOURCE_LINE 00000154 "Note that you need to transform the output into an integer somehow, perhaps"
NSQ_SOURCE_LINE 00000155 "by taking the least significant bits or using a hash function. This would"
NSQ_SOURCE_LINE 00000156 "be less prone to duplicate instances, but it's still not ideal."
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "=back"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "=head1 METHODS"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "=head2 new"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "  Math::Random::ISAAC->new( @seeds )"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "Creates a C<Math::Random::ISAAC> object, based upon either the optimized"
NSQ_SOURCE_LINE 00000167 "C/XS version of the algorithm, L<Math::Random::ISAAC::XS>, or falls back"
NSQ_SOURCE_LINE 00000168 "to the included Pure Perl module, L<Math::Random::ISAAC::PP>."
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "Example code:"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "  my $rng = Math::Random::ISAAC->new(time);"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "This method will return an appropriate B<Math::Random::ISAAC> object or"
NSQ_SOURCE_LINE 00000175 "throw an exception on error."
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "=head2 rand"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "  $rng->rand()"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "Returns a random double-precision floating point number which is normalized"
NSQ_SOURCE_LINE 00000182 "between 0 and 1 (inclusive; it's a closed interval)."
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "Internally, this simply takes the uniformly distributed unsigned integer from"
NSQ_SOURCE_LINE 00000185 "C<$rng-E<gt>irand()> and divides it by C<2**32-1> (maximum unsigned integer"
NSQ_SOURCE_LINE 00000186 "size)"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "Example code:"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "  my $next = $rng->rand();"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "This method will return a double-precision floating point number or throw an"
NSQ_SOURCE_LINE 00000193 "exception on error."
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "=head2 irand"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "  $rng->irand()"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "Returns the next unsigned 32-bit random integer. It will return a value with"
NSQ_SOURCE_LINE 00000200 "a value such that: B<0 E<lt>= x E<lt>= 2**32-1>."
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "Example code:"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "  my $next = $rng->irand();"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "This method will return a 32-bit unsigned integer or throw an exception on"
NSQ_SOURCE_LINE 00000207 "error."
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "=head1 PURPOSE"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "The intent of this module is to provide single simple interface to the two"
NSQ_SOURCE_LINE 00000212 "compatible implementations of this module, namely, L<Math::Random::ISAAC::XS>"
NSQ_SOURCE_LINE 00000213 "and L<Math::Random::ISAAC::PP>."
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "If, for some reason, you need to determine what version of the module is"
NSQ_SOURCE_LINE 00000216 "actually being included by C<Math::Random::ISAAC>, then:"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "  print 'Backend type: ', $Math::Random::ISAAC::DRIVER, \"\\n\";"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "In order to force use of one or the other, simply load the appropriate module:"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "  use Math::Random::ISAAC::XS;"
NSQ_SOURCE_LINE 00000223 "  my $rng = Math::Random::ISAAC::XS->new();"
NSQ_SOURCE_LINE 00000224 "  # or"
NSQ_SOURCE_LINE 00000225 "  use Math::Random::ISAAC::PP;"
NSQ_SOURCE_LINE 00000226 "  my $rng = Math::Random::ISAAC::PP->new();"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "=head1 ACKNOWLEDGEMENTS"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "=over"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "=item *"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "Special thanks to Bob Jenkins E<lt>bob_jenkins@burtleburtle.netE<gt> for"
NSQ_SOURCE_LINE 00000235 "devising this very clever algorithm and releasing it into the public domain."
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "=item *"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "Thanks to John L. Allen (contact unknown) for providing a Perl port of the"
NSQ_SOURCE_LINE 00000240 "original ISAAC code, upon which C<Math::Random::ISAAC::PP> is heavily based."
NSQ_SOURCE_LINE 00000241 "His version is available on Bob's web site, in the SEE ALSO section."
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "=back"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "L<Math::Random::ISAAC::XS>, the C/XS optimized version of this module, which"
NSQ_SOURCE_LINE 00000248 "will be used automatically if available."
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "L<http://burtleburtle.net/bob/rand/isaacafa.html>, Bob Jenkins' page about"
NSQ_SOURCE_LINE 00000251 "ISAAC, which explains the algorithm as well as potential attacks."
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "L<http://eprint.iacr.org/2006/438.pdf>, a paper entitled \"On the pseudo-random"
NSQ_SOURCE_LINE 00000254 "generator ISAAC,\" which claims there are many seeds which will produce"
NSQ_SOURCE_LINE 00000255 "non-uniform results. The author, Jean-Philippe Aumasson, argues ISAAC should"
NSQ_SOURCE_LINE 00000256 "be using rotations (circular shifts) instead of normal shifts to increase"
NSQ_SOURCE_LINE 00000257 "diffusion of the state, among other things."
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "L<http://eprint.iacr.org/2001/049.pdf>, a paper by Marina Pudovkina discussing"
NSQ_SOURCE_LINE 00000260 "plaintext attacks on the ISAAC keystream generator. Among other things, it"
NSQ_SOURCE_LINE 00000261 "notes that the time complexity is B<Tmet = 4.67*10^1240>, so it remains a"
NSQ_SOURCE_LINE 00000262 "secure cipher for practical applications."
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "=head1 CAVEATS"
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "=over"
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "=item *"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "There is no method that allows re-seeding of algorithms. This is not really"
NSQ_SOURCE_LINE 00000271 "necessary because one can simply call C<new> again with the new seed data"
NSQ_SOURCE_LINE 00000272 "periodically."
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "But he also provides a simple workaround:"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "  As ISAAC is intended to be a secure cipher, if you want to reseed it,"
NSQ_SOURCE_LINE 00000277 "  one way is to use some other cipher to seed some initial version of ISAAC,"
NSQ_SOURCE_LINE 00000278 "  then use ISAAC's output as a seed for other instances of ISAAC whenever"
NSQ_SOURCE_LINE 00000279 "  they need to be reseeded."
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "=item *"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "There is no way to clone a PRNG instance. I'm not sure why this is might"
NSQ_SOURCE_LINE 00000284 "even be necessary or useful. File a bug report with an explanation why and"
NSQ_SOURCE_LINE 00000285 "I'll consider adding it to the next release."
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "=back"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "=head1 BUGS"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "Please report any bugs or feature requests on the bugtracker website"
NSQ_SOURCE_LINE 00000292 "http://rt.cpan.org/NoAuth/Bugs.html?Dist=Math-Random-ISAAC"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "When submitting a bug or request, please include a test-file or a"
NSQ_SOURCE_LINE 00000295 "patch to an existing test-file that illustrates the bug or desired"
NSQ_SOURCE_LINE 00000296 "feature."
NSQ_SOURCE_LINE 00000297 ""
