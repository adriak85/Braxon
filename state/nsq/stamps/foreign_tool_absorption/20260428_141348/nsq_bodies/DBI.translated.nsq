NSQ_SOURCE_LINE 00000836 "        $@ ||= \"$driver_class->driver didn't return a handle\";"
NSQ_SOURCE_LINE 00000837 "\t# catch people on case in-sensitive systems using the wrong case"
NSQ_SOURCE_LINE 00000838 "\t$advice = \"\\nPerhaps the capitalisation of DBD '$driver' isn't right.\""
NSQ_SOURCE_LINE 00000839 "\t\tif $@ =~ /locate object method/;"
NSQ_SOURCE_LINE 00000840 "\tCarp::croak(\"$driver_class initialisation failed: $@$advice\");"
NSQ_SOURCE_LINE 00000841 "    }"
NSQ_SOURCE_LINE 00000842 ""
NSQ_SOURCE_LINE 00000843 "    $DBI::installed_drh{$driver} = $drh;"
NSQ_SOURCE_LINE 00000844 "    $class->trace_msg(\"    <- install_driver= $drh\\n\") if $DBI::dbi_debug & 0xF;"
NSQ_SOURCE_LINE 00000845 "    $drh;"
NSQ_SOURCE_LINE 00000846 "}"
