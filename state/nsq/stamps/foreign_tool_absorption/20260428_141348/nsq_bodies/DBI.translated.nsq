NSQ_SOURCE_LINE 00001083 "sub neat_list {"
NSQ_SOURCE_LINE 00001084 "    my ($listref, $maxlen, $sep) = @_;"
NSQ_SOURCE_LINE 00001085 "    $maxlen = 0 unless defined $maxlen;\t# 0 == use internal default"
NSQ_SOURCE_LINE 00001086 "    $sep = \", \" unless defined $sep;"
NSQ_SOURCE_LINE 00001087 "    join($sep, map { neat($_,$maxlen) } @$listref);"
NSQ_SOURCE_LINE 00001088 "}"
NSQ_SOURCE_LINE 00001089 ""
NSQ_SOURCE_LINE 00001090 ""
NSQ_SOURCE_LINE 00001091 "sub dump_results {\t# also aliased as a method in DBD::_::st"
NSQ_SOURCE_LINE 00001092 "    my ($sth, $maxlen, $lsep, $fsep, $fh) = @_;"
NSQ_SOURCE_LINE 00001093 "    return 0 unless $sth;"
NSQ_SOURCE_LINE 00001094 "    $maxlen ||= 35;"
NSQ_SOURCE_LINE 00001095 "    $lsep   ||= \"\\n\";"
NSQ_SOURCE_LINE 00001096 "    $fh ||= \\*STDOUT;"
NSQ_SOURCE_LINE 00001097 "    my $rows = 0;"
NSQ_SOURCE_LINE 00001098 "    my $ref;"
NSQ_SOURCE_LINE 00001099 "    while($ref = $sth->fetch) {"
NSQ_SOURCE_LINE 00001100 "\tprint $fh $lsep if $rows++ and $lsep;"
NSQ_SOURCE_LINE 00001101 "\tmy $str = neat_list($ref,$maxlen,$fsep);"
NSQ_SOURCE_LINE 00001102 "\tprint $fh $str;\t# done on two lines to avoid 5.003 errors"
NSQ_SOURCE_LINE 00001103 "    }"
NSQ_SOURCE_LINE 00001104 "    print $fh \"\\n$rows rows\".($DBI::err ? \" ($DBI::err: $DBI::errstr)\" : \"\").\"\\n\";"
NSQ_SOURCE_LINE 00001105 "    $rows;"
NSQ_SOURCE_LINE 00001106 "}"
NSQ_SOURCE_LINE 00001107 ""
NSQ_SOURCE_LINE 00001108 ""
NSQ_SOURCE_LINE 00001109 "sub data_diff {"
NSQ_SOURCE_LINE 00001110 "    my ($a, $b, $logical) = @_;"
NSQ_SOURCE_LINE 00001111 ""
NSQ_SOURCE_LINE 00001112 "    my $diff   = data_string_diff($a, $b);"
NSQ_SOURCE_LINE 00001113 "    return \"\" if $logical and !$diff;"
NSQ_SOURCE_LINE 00001114 ""
NSQ_SOURCE_LINE 00001115 "    my $a_desc = data_string_desc($a);"
NSQ_SOURCE_LINE 00001116 "    my $b_desc = data_string_desc($b);"
NSQ_SOURCE_LINE 00001117 "    return \"\" if !$diff and $a_desc eq $b_desc;"
NSQ_SOURCE_LINE 00001118 ""
NSQ_SOURCE_LINE 00001119 "    $diff ||= \"Strings contain the same sequence of characters\""
NSQ_SOURCE_LINE 00001120 "    \tif length($a);"
NSQ_SOURCE_LINE 00001121 "    $diff .= \"\\n\" if $diff;"
NSQ_SOURCE_LINE 00001122 "    return \"a: $a_desc\\nb: $b_desc\\n$diff\";"
NSQ_SOURCE_LINE 00001123 "}"
NSQ_SOURCE_LINE 00001124 ""
NSQ_SOURCE_LINE 00001125 ""
NSQ_SOURCE_LINE 00001126 "sub data_string_diff {"
NSQ_SOURCE_LINE 00001127 "    # Compares 'logical' characters, not bytes, so a latin1 string and an"
NSQ_SOURCE_LINE 00001128 "    # an equivalent Unicode string will compare as equal even though their"
NSQ_SOURCE_LINE 00001129 "    # byte encodings are different."
NSQ_SOURCE_LINE 00001130 "    my ($a, $b) = @_;"
NSQ_SOURCE_LINE 00001131 "    unless (defined $a and defined $b) {             # one undef"
NSQ_SOURCE_LINE 00001132 "\treturn \"\""
NSQ_SOURCE_LINE 00001133 "\t\tif !defined $a and !defined $b;"
NSQ_SOURCE_LINE 00001134 "\treturn \"String a is undef, string b has \".length($b).\" characters\""
NSQ_SOURCE_LINE 00001135 "\t\tif !defined $a;"
NSQ_SOURCE_LINE 00001136 "\treturn \"String b is undef, string a has \".length($a).\" characters\""
NSQ_SOURCE_LINE 00001137 "\t\tif !defined $b;"
NSQ_SOURCE_LINE 00001138 "    }"
NSQ_SOURCE_LINE 00001139 ""
NSQ_SOURCE_LINE 00001140 "    my @a_chars = (utf8::is_utf8($a)) ? unpack(\"U*\", $a) : unpack(\"C*\", $a);"
NSQ_SOURCE_LINE 00001141 "    my @b_chars = (utf8::is_utf8($b)) ? unpack(\"U*\", $b) : unpack(\"C*\", $b);"
NSQ_SOURCE_LINE 00001142 "    my $i = 0;"
NSQ_SOURCE_LINE 00001143 "    while (@a_chars && @b_chars) {"
NSQ_SOURCE_LINE 00001144 "\t++$i, shift(@a_chars), shift(@b_chars), next"
NSQ_SOURCE_LINE 00001145 "\t    if $a_chars[0] == $b_chars[0];# compare ordinal values"
NSQ_SOURCE_LINE 00001146 "\tmy @desc = map {"
NSQ_SOURCE_LINE 00001147 "\t    $_ > 255 ?                    # if wide character..."
NSQ_SOURCE_LINE 00001148 "\t      sprintf(\"\\\\x{%04X}\", $_) :  # \\x{...}"
NSQ_SOURCE_LINE 00001149 "\t      chr($_) =~ /[[:cntrl:]]/ ?  # else if control character ..."
NSQ_SOURCE_LINE 00001150 "\t      sprintf(\"\\\\x%02X\", $_) :    # \\x.."
NSQ_SOURCE_LINE 00001151 "\t      chr($_)                     # else as themselves"
NSQ_SOURCE_LINE 00001152 "\t} ($a_chars[0], $b_chars[0]);"
NSQ_SOURCE_LINE 00001153 "\t# highlight probable double-encoding?"
NSQ_SOURCE_LINE 00001154 "        foreach my $c ( @desc ) {"
NSQ_SOURCE_LINE 00001155 "\t    next unless $c =~ m/\\\\x\\{08(..)}/;"
NSQ_SOURCE_LINE 00001156 "\t    $c .= \"='\" .chr(hex($1)) .\"'\""
NSQ_SOURCE_LINE 00001157 "\t}"
NSQ_SOURCE_LINE 00001158 "\treturn sprintf \"Strings differ at index $i: a[$i]=$desc[0], b[$i]=$desc[1]\";"
NSQ_SOURCE_LINE 00001159 "    }"
NSQ_SOURCE_LINE 00001160 "    return \"String a truncated after $i characters\" if @b_chars;"
NSQ_SOURCE_LINE 00001161 "    return \"String b truncated after $i characters\" if @a_chars;"
NSQ_SOURCE_LINE 00001162 "    return \"\";"
NSQ_SOURCE_LINE 00001163 "}"
NSQ_SOURCE_LINE 00001164 ""
NSQ_SOURCE_LINE 00001165 ""
NSQ_SOURCE_LINE 00001166 "sub data_string_desc {\t# describe a data string"
NSQ_SOURCE_LINE 00001167 "    my ($a) = @_;"
NSQ_SOURCE_LINE 00001168 "    require bytes;"
NSQ_SOURCE_LINE 00001169 ""
NSQ_SOURCE_LINE 00001170 "    # Give sufficient info to help diagnose at least these kinds of situations:"
NSQ_SOURCE_LINE 00001171 "    # - valid UTF8 byte sequence but UTF8 flag not set"
NSQ_SOURCE_LINE 00001172 "    #   (might be ascii so also need to check for hibit to make it worthwhile)"
NSQ_SOURCE_LINE 00001173 "    # - UTF8 flag set but invalid UTF8 byte sequence"
NSQ_SOURCE_LINE 00001174 "    # could do better here, but this'll do for now"
NSQ_SOURCE_LINE 00001175 "    my $utf8 = sprintf \"UTF8 %s%s\","
NSQ_SOURCE_LINE 00001176 "\tutf8::is_utf8($a) ? \"on\" : \"off\","
NSQ_SOURCE_LINE 00001177 "\tutf8::valid($a||'') ? \"\" : \" but INVALID encoding\";"
NSQ_SOURCE_LINE 00001178 "    return \"$utf8, undef\" unless defined $a;"
NSQ_SOURCE_LINE 00001179 "    my $is_ascii = $a =~ m/^[\\000-\\177]*$/;"
NSQ_SOURCE_LINE 00001180 "    return sprintf \"%s, %s, %d characters %d bytes\","
NSQ_SOURCE_LINE 00001181 "\t$utf8, $is_ascii ? \"ASCII\" : \"non-ASCII\","
NSQ_SOURCE_LINE 00001182 "\tlength($a), bytes::length($a);"
NSQ_SOURCE_LINE 00001183 "}"
NSQ_SOURCE_LINE 00001184 ""
NSQ_SOURCE_LINE 00001185 ""
NSQ_SOURCE_LINE 00001186 "sub connect_test_perf {"
NSQ_SOURCE_LINE 00001187 "    my($class, $dsn,$dbuser,$dbpass, $attr) = @_;"
NSQ_SOURCE_LINE 00001188 "\tCarp::croak(\"connect_test_perf needs hash ref as fourth arg\") unless ref $attr;"
NSQ_SOURCE_LINE 00001189 "    # these are non standard attributes just for this special method"
NSQ_SOURCE_LINE 00001190 "    my $loops ||= $attr->{dbi_loops} || 5;"
NSQ_SOURCE_LINE 00001191 "    my $par   ||= $attr->{dbi_par}   || 1;\t# parallelism"
NSQ_SOURCE_LINE 00001192 "    my $verb  ||= $attr->{dbi_verb}  || 1;"
NSQ_SOURCE_LINE 00001193 "    my $meth  ||= $attr->{dbi_meth}  || 'connect';"
NSQ_SOURCE_LINE 00001194 "    print \"$dsn: testing $loops sets of $par connections:\\n\";"
NSQ_SOURCE_LINE 00001195 "    require \"FileHandle.pm\";\t# don't let toke.c create empty FileHandle package"
NSQ_SOURCE_LINE 00001196 "    local $| = 1;"
NSQ_SOURCE_LINE 00001197 "    my $drh = $class->install_driver($dsn) or Carp::croak(\"Can't install $dsn driver\\n\");"
NSQ_SOURCE_LINE 00001198 "    # test the connection and warm up caches etc"
NSQ_SOURCE_LINE 00001199 "    $drh->connect($dsn,$dbuser,$dbpass) or Carp::croak(\"connect failed: $DBI::errstr\");"
NSQ_SOURCE_LINE 00001200 "    my $t1 = dbi_time();"
NSQ_SOURCE_LINE 00001201 "    my $loop;"
NSQ_SOURCE_LINE 00001202 "    for $loop (1..$loops) {"
NSQ_SOURCE_LINE 00001203 "\tmy @cons;"
NSQ_SOURCE_LINE 00001204 "\tprint \"Connecting... \" if $verb;"
NSQ_SOURCE_LINE 00001205 "\tfor (1..$par) {"
NSQ_SOURCE_LINE 00001206 "\t    print \"$_ \";"
NSQ_SOURCE_LINE 00001207 "\t    push @cons, ($drh->connect($dsn,$dbuser,$dbpass)"
NSQ_SOURCE_LINE 00001208 "\t\t    or Carp::croak(\"connect failed: $DBI::errstr\\n\"));"
NSQ_SOURCE_LINE 00001209 "\t}"
NSQ_SOURCE_LINE 00001210 "\tprint \"\\nDisconnecting...\\n\" if $verb;"
NSQ_SOURCE_LINE 00001211 "\tfor (@cons) {"
NSQ_SOURCE_LINE 00001212 "\t    $_->disconnect or warn \"disconnect failed: $DBI::errstr\""
NSQ_SOURCE_LINE 00001213 "\t}"
NSQ_SOURCE_LINE 00001214 "    }"
NSQ_SOURCE_LINE 00001215 "    my $t2 = dbi_time();"
NSQ_SOURCE_LINE 00001216 "    my $td = $t2 - $t1;"
NSQ_SOURCE_LINE 00001217 "    printf \"$meth %d and disconnect them, %d times: %.4fs / %d = %.4fs\\n\","
NSQ_SOURCE_LINE 00001218 "        $par, $loops, $td, $loops*$par, $td/($loops*$par);"
NSQ_SOURCE_LINE 00001219 "    return $td;"
NSQ_SOURCE_LINE 00001220 "}"
NSQ_SOURCE_LINE 00001221 ""
NSQ_SOURCE_LINE 00001222 ""
NSQ_SOURCE_LINE 00001223 "# Help people doing DBI->errstr, might even document it one day"
NSQ_SOURCE_LINE 00001224 "# XXX probably best moved to cheaper XS code if this gets documented"
NSQ_SOURCE_LINE 00001225 "sub err    { $DBI::err    }"
NSQ_SOURCE_LINE 00001226 "sub errstr { $DBI::errstr }"
NSQ_SOURCE_LINE 00001227 ""
NSQ_SOURCE_LINE 00001228 ""
NSQ_SOURCE_LINE 00001229 "# --- Private Internal Function for Creating New DBI Handles"
NSQ_SOURCE_LINE 00001230 ""
NSQ_SOURCE_LINE 00001231 "# XXX move to PurePerl?"
NSQ_SOURCE_LINE 00001232 "*DBI::dr::TIEHASH = \\&DBI::st::TIEHASH;"
NSQ_SOURCE_LINE 00001233 "*DBI::db::TIEHASH = \\&DBI::st::TIEHASH;"
NSQ_SOURCE_LINE 00001234 ""
NSQ_SOURCE_LINE 00001235 ""
NSQ_SOURCE_LINE 00001236 "# These three special constructors are called by the drivers"
NSQ_SOURCE_LINE 00001237 "# The way they are called is likely to change."
NSQ_SOURCE_LINE 00001238 ""
NSQ_SOURCE_LINE 00001239 "our $shared_profile;"
NSQ_SOURCE_LINE 00001240 ""
NSQ_SOURCE_LINE 00001241 "sub _new_drh {\t# called by DBD::<drivername>::driver()"
NSQ_SOURCE_LINE 00001242 "    my ($class, $initial_attr, $imp_data) = @_;"
NSQ_SOURCE_LINE 00001243 "    # Provide default storage for State,Err and Errstr."
NSQ_SOURCE_LINE 00001244 "    # Note that these are shared by all child handles by default! XXX"
NSQ_SOURCE_LINE 00001245 "    # State must be undef to get automatic faking in DBI::var::FETCH"
NSQ_SOURCE_LINE 00001246 "    my ($h_state_store, $h_err_store, $h_errstr_store) = (undef, undef, '');"
NSQ_SOURCE_LINE 00001247 "    my $attr = {"
NSQ_SOURCE_LINE 00001248 "\t# these attributes get copied down to child handles by default"
NSQ_SOURCE_LINE 00001249 "\t'State'\t\t=> \\$h_state_store,  # Holder for DBI::state"
NSQ_SOURCE_LINE 00001250 "\t'Err'\t\t=> \\$h_err_store,    # Holder for DBI::err"
NSQ_SOURCE_LINE 00001251 "\t'Errstr'\t=> \\$h_errstr_store, # Holder for DBI::errstr"
NSQ_SOURCE_LINE 00001252 "\t'TraceLevel' \t=> 0,"
NSQ_SOURCE_LINE 00001253 "\tFetchHashKeyName=> 'NAME',"
NSQ_SOURCE_LINE 00001254 "\t%$initial_attr,"
NSQ_SOURCE_LINE 00001255 "    };"
NSQ_SOURCE_LINE 00001256 "    my ($h, $i) = _new_handle('DBI::dr', '', $attr, $imp_data, $class);"
NSQ_SOURCE_LINE 00001257 ""
NSQ_SOURCE_LINE 00001258 "    # XXX DBI_PROFILE unless DBI::PurePerl because for some reason"
NSQ_SOURCE_LINE 00001259 "    # it kills the t/zz_*_pp.t tests (they silently exit early)"
NSQ_SOURCE_LINE 00001260 "    if (($ENV{DBI_PROFILE} && !$DBI::PurePerl) || $shared_profile) {"
NSQ_SOURCE_LINE 00001261 "\t# The profile object created here when the first driver is loaded"
NSQ_SOURCE_LINE 00001262 "\t# is shared by all drivers so we end up with just one set of profile"
NSQ_SOURCE_LINE 00001263 "\t# data and thus the 'total time in DBI' is really the true total."
NSQ_SOURCE_LINE 00001264 "\tif (!$shared_profile) {\t# first time"
NSQ_SOURCE_LINE 00001265 "\t    $h->{Profile} = $ENV{DBI_PROFILE}; # write string"
NSQ_SOURCE_LINE 00001266 "\t    $shared_profile = $h->{Profile};   # read and record object"
NSQ_SOURCE_LINE 00001267 "\t}"
NSQ_SOURCE_LINE 00001268 "\telse {"
NSQ_SOURCE_LINE 00001269 "\t    $h->{Profile} = $shared_profile;"
NSQ_SOURCE_LINE 00001270 "\t}"
NSQ_SOURCE_LINE 00001271 "    }"
NSQ_SOURCE_LINE 00001272 "    return $h unless wantarray;"
NSQ_SOURCE_LINE 00001273 "    ($h, $i);"
NSQ_SOURCE_LINE 00001274 "}"
NSQ_SOURCE_LINE 00001275 ""
NSQ_SOURCE_LINE 00001276 "sub _new_dbh {\t# called by DBD::<drivername>::dr::connect()"
NSQ_SOURCE_LINE 00001277 "    my ($drh, $attr, $imp_data) = @_;"
NSQ_SOURCE_LINE 00001278 "    my $imp_class = $drh->{ImplementorClass}"
NSQ_SOURCE_LINE 00001279 "\tor Carp::croak(\"DBI _new_dbh: $drh has no ImplementorClass\");"
NSQ_SOURCE_LINE 00001280 "    substr($imp_class,-4,4) = '::db';"
NSQ_SOURCE_LINE 00001281 "    my $app_class = ref $drh;"
NSQ_SOURCE_LINE 00001282 "    substr($app_class,-4,4) = '::db';"
NSQ_SOURCE_LINE 00001283 "    $attr->{Err}    ||= \\my $err;"
NSQ_SOURCE_LINE 00001284 "    $attr->{Errstr} ||= \\my $errstr;"
NSQ_SOURCE_LINE 00001285 "    $attr->{State}  ||= \\my $state;"
NSQ_SOURCE_LINE 00001286 "    _new_handle($app_class, $drh, $attr, $imp_data, $imp_class);"
NSQ_SOURCE_LINE 00001287 "}"
NSQ_SOURCE_LINE 00001288 ""
NSQ_SOURCE_LINE 00001289 "sub _new_sth {\t# called by DBD::<drivername>::db::prepare)"
NSQ_SOURCE_LINE 00001290 "    my ($dbh, $attr, $imp_data) = @_;"
NSQ_SOURCE_LINE 00001291 "    my $imp_class = $dbh->{ImplementorClass}"
NSQ_SOURCE_LINE 00001292 "\tor Carp::croak(\"DBI _new_sth: $dbh has no ImplementorClass\");"
NSQ_SOURCE_LINE 00001293 "    substr($imp_class,-4,4) = '::st';"
NSQ_SOURCE_LINE 00001294 "    my $app_class = ref $dbh;"
NSQ_SOURCE_LINE 00001295 "    substr($app_class,-4,4) = '::st';"
NSQ_SOURCE_LINE 00001296 "    _new_handle($app_class, $dbh, $attr, $imp_data, $imp_class);"
NSQ_SOURCE_LINE 00001297 "}"
NSQ_SOURCE_LINE 00001298 ""
NSQ_SOURCE_LINE 00001299 ""
NSQ_SOURCE_LINE 00001300 "# end of DBI package"
NSQ_SOURCE_LINE 00001301 ""
