NSQ_SOURCE_LINE 00008237 ""
NSQ_SOURCE_LINE 00008238 "Programming Perl 3rd Ed. by Larry Wall, Tom Christiansen & Jon Orwant."
NSQ_SOURCE_LINE 00008239 "L<http://books.perl.org/book/134>"
NSQ_SOURCE_LINE 00008240 ""
NSQ_SOURCE_LINE 00008241 "Learning Perl by Randal Schwartz."
NSQ_SOURCE_LINE 00008242 "L<http://books.perl.org/book/101>"
NSQ_SOURCE_LINE 00008243 ""
NSQ_SOURCE_LINE 00008244 "Details of many other books related to perl can be found at L<http://books.perl.org>"
