NSQ_SOURCE_LINE 00001304 "# --------------------------------------------------------------------"
NSQ_SOURCE_LINE 00001305 "# === The internal DBI Switch pseudo 'driver' class ==="
NSQ_SOURCE_LINE 00001306 ""
NSQ_SOURCE_LINE 00001307 "{   package\t# hide from PAUSE"
NSQ_SOURCE_LINE 00001308 "\tDBD::Switch::dr;"
NSQ_SOURCE_LINE 00001309 "    DBI->setup_driver('DBD::Switch');\t# sets up @ISA"
NSQ_SOURCE_LINE 00001310 ""
NSQ_SOURCE_LINE 00001311 "    $DBD::Switch::dr::imp_data_size = 0;"
NSQ_SOURCE_LINE 00001312 "    $DBD::Switch::dr::imp_data_size = 0;\t# avoid typo warning"
NSQ_SOURCE_LINE 00001313 "    my $drh;"
NSQ_SOURCE_LINE 00001314 ""
NSQ_SOURCE_LINE 00001315 "    sub driver {"
NSQ_SOURCE_LINE 00001316 "\treturn $drh if $drh;\t# a package global"
NSQ_SOURCE_LINE 00001317 ""
NSQ_SOURCE_LINE 00001318 "\tmy $inner;"
NSQ_SOURCE_LINE 00001319 "\t($drh, $inner) = DBI::_new_drh('DBD::Switch::dr', {"
NSQ_SOURCE_LINE 00001320 "\t\t'Name'    => 'Switch',"
NSQ_SOURCE_LINE 00001321 "\t\t'Version' => $DBI::VERSION,"
NSQ_SOURCE_LINE 00001322 "\t\t'Attribution' => \"DBI $DBI::VERSION by Tim Bunce\","
NSQ_SOURCE_LINE 00001323 "\t    });"
NSQ_SOURCE_LINE 00001324 "\tCarp::croak(\"DBD::Switch init failed!\") unless ($drh && $inner);"
NSQ_SOURCE_LINE 00001325 "\treturn $drh;"
NSQ_SOURCE_LINE 00001326 "    }"
NSQ_SOURCE_LINE 00001327 "    sub CLONE {"
NSQ_SOURCE_LINE 00001328 "\tundef $drh;"
NSQ_SOURCE_LINE 00001329 "    }"
NSQ_SOURCE_LINE 00001330 ""
NSQ_SOURCE_LINE 00001331 "    sub FETCH {"
NSQ_SOURCE_LINE 00001332 "\tmy($drh, $key) = @_;"
NSQ_SOURCE_LINE 00001333 "\treturn DBI->trace if $key eq 'DebugDispatch';"
NSQ_SOURCE_LINE 00001334 "\treturn undef if $key eq 'DebugLog';\t# not worth fetching, sorry"
NSQ_SOURCE_LINE 00001335 "\treturn $drh->DBD::_::dr::FETCH($key);"
NSQ_SOURCE_LINE 00001336 "\tundef;"
NSQ_SOURCE_LINE 00001337 "    }"
NSQ_SOURCE_LINE 00001338 "    sub STORE {"
NSQ_SOURCE_LINE 00001339 "\tmy($drh, $key, $value) = @_;"
NSQ_SOURCE_LINE 00001340 "\tif ($key eq 'DebugDispatch') {"
NSQ_SOURCE_LINE 00001341 "\t    DBI->trace($value);"
NSQ_SOURCE_LINE 00001342 "\t} elsif ($key eq 'DebugLog') {"
NSQ_SOURCE_LINE 00001343 "\t    DBI->trace(-1, $value);"
NSQ_SOURCE_LINE 00001344 "\t} else {"
NSQ_SOURCE_LINE 00001345 "\t    $drh->DBD::_::dr::STORE($key, $value);"
NSQ_SOURCE_LINE 00001346 "\t}"
NSQ_SOURCE_LINE 00001347 "    }"
NSQ_SOURCE_LINE 00001348 "}"
NSQ_SOURCE_LINE 00001349 ""
NSQ_SOURCE_LINE 00001350 ""
NSQ_SOURCE_LINE 00001351 "# --------------------------------------------------------------------"
NSQ_SOURCE_LINE 00001352 "# === OPTIONAL MINIMAL BASE CLASSES FOR DBI SUBCLASSES ==="
NSQ_SOURCE_LINE 00001353 ""
NSQ_SOURCE_LINE 00001354 "# We only define default methods for harmless functions."
NSQ_SOURCE_LINE 00001355 "# We don't, for example, define a DBD::_::st::prepare()"
NSQ_SOURCE_LINE 00001356 ""
NSQ_SOURCE_LINE 00001357 "{   package\t\t# hide from PAUSE"
NSQ_SOURCE_LINE 00001358 "\tDBD::_::common; # ====== Common base class methods ======"
NSQ_SOURCE_LINE 00001359 "    use strict;"
NSQ_SOURCE_LINE 00001360 ""
NSQ_SOURCE_LINE 00001361 "    # methods common to all handle types:"
NSQ_SOURCE_LINE 00001362 ""
NSQ_SOURCE_LINE 00001363 "    # generic TIEHASH default methods:"
NSQ_SOURCE_LINE 00001364 "    sub FIRSTKEY { }"
NSQ_SOURCE_LINE 00001365 "    sub NEXTKEY  { }"
NSQ_SOURCE_LINE 00001366 "    sub EXISTS   { defined($_[0]->FETCH($_[1])) } # XXX undef?"
NSQ_SOURCE_LINE 00001367 "    sub CLEAR    { Carp::carp \"Can't CLEAR $_[0] (DBI)\" }"
NSQ_SOURCE_LINE 00001368 ""
NSQ_SOURCE_LINE 00001369 "    sub FETCH_many {    # XXX should move to C one day"
NSQ_SOURCE_LINE 00001370 "        my $h = shift;"
NSQ_SOURCE_LINE 00001371 "        # scalar is needed to workaround drivers that return an empty list"
NSQ_SOURCE_LINE 00001372 "        # for some attributes"
NSQ_SOURCE_LINE 00001373 "        return map { scalar $h->FETCH($_) } @_;"
NSQ_SOURCE_LINE 00001374 "    }"
NSQ_SOURCE_LINE 00001375 ""
NSQ_SOURCE_LINE 00001376 "    *dump_handle = \\&DBI::dump_handle;"
NSQ_SOURCE_LINE 00001377 ""
NSQ_SOURCE_LINE 00001378 "    sub install_method {"
NSQ_SOURCE_LINE 00001379 "\t# special class method called directly by apps and/or drivers"
NSQ_SOURCE_LINE 00001380 "\t# to install new methods into the DBI dispatcher"
NSQ_SOURCE_LINE 00001381 "\t# DBD::Foo::db->install_method(\"foo_mumble\", { usage => [...], options => '...' });"
NSQ_SOURCE_LINE 00001382 "\tmy ($class, $method, $attr) = @_;"
NSQ_SOURCE_LINE 00001383 "\tCarp::croak(\"Class '$class' must begin with DBD:: and end with ::db or ::st\")"
NSQ_SOURCE_LINE 00001384 "\t    unless $class =~ /^DBD::(\\w+)::(dr|db|st)$/;"
NSQ_SOURCE_LINE 00001385 "\tmy ($driver, $subtype) = ($1, $2);"
NSQ_SOURCE_LINE 00001386 "\tCarp::croak(\"invalid method name '$method'\")"
NSQ_SOURCE_LINE 00001387 "\t    unless $method =~ m/^([a-z][a-z0-9]*_)\\w+$/;"
NSQ_SOURCE_LINE 00001388 "\tmy $prefix = $1;"
NSQ_SOURCE_LINE 00001389 "\tmy $reg_info = $dbd_prefix_registry->{$prefix};"
NSQ_SOURCE_LINE 00001390 "\tCarp::carp(\"method name prefix '$prefix' is not associated with a registered driver\") unless $reg_info;"
NSQ_SOURCE_LINE 00001391 ""
NSQ_SOURCE_LINE 00001392 "\tmy $full_method = \"DBI::${subtype}::$method\";"
NSQ_SOURCE_LINE 00001393 "\t$DBI::installed_methods{$full_method} = $attr;"
NSQ_SOURCE_LINE 00001394 ""
NSQ_SOURCE_LINE 00001395 "\tmy (undef, $filename, $line) = caller;"
NSQ_SOURCE_LINE 00001396 "\t# XXX reformat $attr as needed for _install_method"
NSQ_SOURCE_LINE 00001397 "\tmy %attr = %{$attr||{}}; # copy so we can edit"
NSQ_SOURCE_LINE 00001398 "\tDBI->_install_method(\"DBI::${subtype}::$method\", \"$filename at line $line\", \\%attr);"
NSQ_SOURCE_LINE 00001399 "    }"
NSQ_SOURCE_LINE 00001400 ""
NSQ_SOURCE_LINE 00001401 "    sub parse_trace_flags {"
NSQ_SOURCE_LINE 00001402 "\tmy ($h, $spec) = @_;"
NSQ_SOURCE_LINE 00001403 "\tmy $level = 0;"
NSQ_SOURCE_LINE 00001404 "\tmy $flags = 0;"
NSQ_SOURCE_LINE 00001405 "\tmy @unknown;"
NSQ_SOURCE_LINE 00001406 "\tfor my $word (split /\\s*[|&,]\\s*/, $spec) {"
NSQ_SOURCE_LINE 00001407 "\t    if (DBI::looks_like_number($word) && $word <= 0xF && $word >= 0) {"
NSQ_SOURCE_LINE 00001408 "\t\t$level = $word;"
NSQ_SOURCE_LINE 00001409 "\t    } elsif ($word eq 'ALL') {"
NSQ_SOURCE_LINE 00001410 "\t\t$flags = 0x7FFFFFFF; # XXX last bit causes negative headaches"
NSQ_SOURCE_LINE 00001411 "\t\tlast;"
NSQ_SOURCE_LINE 00001412 "\t    } elsif (my $flag = $h->parse_trace_flag($word)) {"
NSQ_SOURCE_LINE 00001413 "\t\t$flags |= $flag;"
NSQ_SOURCE_LINE 00001414 "\t    }"
NSQ_SOURCE_LINE 00001415 "\t    else {"
NSQ_SOURCE_LINE 00001416 "\t\tpush @unknown, $word;"
NSQ_SOURCE_LINE 00001417 "\t    }"
NSQ_SOURCE_LINE 00001418 "\t}"
NSQ_SOURCE_LINE 00001419 "\tif (@unknown && (ref $h ? $h->FETCH('Warn') : 1)) {"
NSQ_SOURCE_LINE 00001420 "\t    Carp::carp(\"$h->parse_trace_flags($spec) ignored unknown trace flags: \"."
NSQ_SOURCE_LINE 00001421 "\t\tjoin(\" \", map { DBI::neat($_) } @unknown));"
NSQ_SOURCE_LINE 00001422 "\t}"
NSQ_SOURCE_LINE 00001423 "\t$flags |= $level;"
NSQ_SOURCE_LINE 00001424 "\treturn $flags;"
NSQ_SOURCE_LINE 00001425 "    }"
NSQ_SOURCE_LINE 00001426 ""
NSQ_SOURCE_LINE 00001427 "    sub parse_trace_flag {"
NSQ_SOURCE_LINE 00001428 "\tmy ($h, $name) = @_;"
NSQ_SOURCE_LINE 00001429 "\t#      0xddDDDDrL (driver, DBI, reserved, Level)"
NSQ_SOURCE_LINE 00001430 "\treturn 0x00000100 if $name eq 'SQL';"
NSQ_SOURCE_LINE 00001431 "    return 0x00000200 if $name eq 'CON';"
NSQ_SOURCE_LINE 00001432 "    return 0x00000400 if $name eq 'ENC';"
NSQ_SOURCE_LINE 00001433 "    return 0x00000800 if $name eq 'DBD';"
NSQ_SOURCE_LINE 00001434 "    return 0x00001000 if $name eq 'TXN';"
NSQ_SOURCE_LINE 00001435 "\treturn;"
NSQ_SOURCE_LINE 00001436 "    }"
NSQ_SOURCE_LINE 00001437 ""
NSQ_SOURCE_LINE 00001438 "    sub private_attribute_info {"
NSQ_SOURCE_LINE 00001439 "        return undef;"
NSQ_SOURCE_LINE 00001440 "    }"
NSQ_SOURCE_LINE 00001441 ""
NSQ_SOURCE_LINE 00001442 "    sub visit_child_handles {"
NSQ_SOURCE_LINE 00001443 "\tmy ($h, $code, $info) = @_;"
NSQ_SOURCE_LINE 00001444 "\t$info = {} if not defined $info;"
NSQ_SOURCE_LINE 00001445 "\tfor my $ch (@{ $h->{ChildHandles} || []}) {"
NSQ_SOURCE_LINE 00001446 "\t    next unless $ch;"
NSQ_SOURCE_LINE 00001447 "\t    my $child_info = $code->($ch, $info)"
NSQ_SOURCE_LINE 00001448 "\t\tor next;"
NSQ_SOURCE_LINE 00001449 "\t    $ch->visit_child_handles($code, $child_info);"
NSQ_SOURCE_LINE 00001450 "\t}"
NSQ_SOURCE_LINE 00001451 "\treturn $info;"
NSQ_SOURCE_LINE 00001452 "    }"
NSQ_SOURCE_LINE 00001453 "}"
NSQ_SOURCE_LINE 00001454 ""
NSQ_SOURCE_LINE 00001455 ""
NSQ_SOURCE_LINE 00001456 "{   package\t\t# hide from PAUSE"
NSQ_SOURCE_LINE 00001457 "\tDBD::_::dr;\t# ====== DRIVER ======"
NSQ_SOURCE_LINE 00001458 "    our @ISA = qw(DBD::_::common);"
NSQ_SOURCE_LINE 00001459 "    use strict;"
NSQ_SOURCE_LINE 00001460 ""
NSQ_SOURCE_LINE 00001461 "    sub default_user {"
NSQ_SOURCE_LINE 00001462 "\tmy ($drh, $user, $pass, $attr) = @_;"
NSQ_SOURCE_LINE 00001463 "\t$user = $ENV{DBI_USER} unless defined $user;"
NSQ_SOURCE_LINE 00001464 "\t$pass = $ENV{DBI_PASS} unless defined $pass;"
NSQ_SOURCE_LINE 00001465 "\treturn ($user, $pass);"
NSQ_SOURCE_LINE 00001466 "    }"
NSQ_SOURCE_LINE 00001467 ""
NSQ_SOURCE_LINE 00001468 "    sub connect { # normally overridden, but a handy default"
NSQ_SOURCE_LINE 00001469 "\tmy ($drh, $dsn, $user, $auth) = @_;"
NSQ_SOURCE_LINE 00001470 "\tmy ($this) = DBI::_new_dbh($drh, {"
NSQ_SOURCE_LINE 00001471 "\t    'Name' => $dsn,"
NSQ_SOURCE_LINE 00001472 "\t});"
NSQ_SOURCE_LINE 00001473 "\t# XXX debatable as there's no \"server side\" here"
NSQ_SOURCE_LINE 00001474 "\t# (and now many uses would trigger warnings on DESTROY)"
NSQ_SOURCE_LINE 00001475 "\t# $this->STORE(Active => 1);"
NSQ_SOURCE_LINE 00001476 "        # so drivers should set it in their own connect"
NSQ_SOURCE_LINE 00001477 "\t$this;"
NSQ_SOURCE_LINE 00001478 "    }"
NSQ_SOURCE_LINE 00001479 ""
NSQ_SOURCE_LINE 00001480 ""
NSQ_SOURCE_LINE 00001481 "    sub connect_cached {"
NSQ_SOURCE_LINE 00001482 "        my $drh = shift;"
NSQ_SOURCE_LINE 00001483 "\tmy ($dsn, $user, $auth, $attr) = @_;"
NSQ_SOURCE_LINE 00001484 ""
NSQ_SOURCE_LINE 00001485 "\tmy $cache = $drh->{CachedKids} ||= {};"
NSQ_SOURCE_LINE 00001486 "\tmy $key = do { no warnings;"
NSQ_SOURCE_LINE 00001487 "\t    join \"!\\001\", $dsn, $user, $auth, DBI::_concat_hash_sorted($attr, \"=\\001\", \",\\001\", 0, 0)"
NSQ_SOURCE_LINE 00001488 "\t};"
NSQ_SOURCE_LINE 00001489 "\tmy $dbh = $cache->{$key};"
NSQ_SOURCE_LINE 00001490 "        $drh->trace_msg(sprintf(\"    connect_cached: key '$key', cached dbh $dbh\\n\", DBI::neat($key), DBI::neat($dbh)))"
NSQ_SOURCE_LINE 00001491 "            if (($DBI::dbi_debug & 0xF) >= 4);"
NSQ_SOURCE_LINE 00001492 ""
NSQ_SOURCE_LINE 00001493 "        my $cb = $attr->{Callbacks}; # take care not to autovivify"
NSQ_SOURCE_LINE 00001494 "\tif ($dbh && $dbh->FETCH('Active') && eval { $dbh->ping }) {"
NSQ_SOURCE_LINE 00001495 "            # If the caller has provided a callback then call it"
NSQ_SOURCE_LINE 00001496 "            if ($cb and $cb = $cb->{\"connect_cached.reused\"}) {"
NSQ_SOURCE_LINE 00001497 "\t\tlocal $_ = \"connect_cached.reused\";"
NSQ_SOURCE_LINE 00001498 "\t\t$cb->($dbh, $dsn, $user, $auth, $attr);"
NSQ_SOURCE_LINE 00001499 "            }"
NSQ_SOURCE_LINE 00001500 "\t    return $dbh;"
NSQ_SOURCE_LINE 00001501 "\t}"
NSQ_SOURCE_LINE 00001502 ""
NSQ_SOURCE_LINE 00001503 "\t# If the caller has provided a callback then call it"
NSQ_SOURCE_LINE 00001504 "\tif ($cb and (my $new_cb = $cb->{\"connect_cached.new\"})) {"
NSQ_SOURCE_LINE 00001505 "\t    local $_ = \"connect_cached.new\";"
NSQ_SOURCE_LINE 00001506 "\t    $new_cb->($dbh, $dsn, $user, $auth, $attr); # $dbh is dead or undef"
NSQ_SOURCE_LINE 00001507 "\t}"
NSQ_SOURCE_LINE 00001508 ""
NSQ_SOURCE_LINE 00001509 "\t$dbh = $drh->connect(@_);"
NSQ_SOURCE_LINE 00001510 "\t$cache->{$key} = $dbh;\t# replace prev entry, even if connect failed"
NSQ_SOURCE_LINE 00001511 "\tif ($cb and (my $conn_cb = $cb->{\"connect_cached.connected\"})) {"
NSQ_SOURCE_LINE 00001512 "\t    local $_ = \"connect_cached.connected\";"
NSQ_SOURCE_LINE 00001513 "\t    $conn_cb->($dbh, $dsn, $user, $auth, $attr);"
NSQ_SOURCE_LINE 00001514 "\t}"
NSQ_SOURCE_LINE 00001515 "\treturn $dbh;"
NSQ_SOURCE_LINE 00001516 "    }"
NSQ_SOURCE_LINE 00001517 ""
NSQ_SOURCE_LINE 00001518 "}"
NSQ_SOURCE_LINE 00001519 ""
NSQ_SOURCE_LINE 00001520 ""
NSQ_SOURCE_LINE 00001521 "{   package\t\t# hide from PAUSE"
NSQ_SOURCE_LINE 00001522 "\tDBD::_::db;\t# ====== DATABASE ======"
NSQ_SOURCE_LINE 00001523 "    our @ISA = qw(DBD::_::common);"
NSQ_SOURCE_LINE 00001524 "    use strict;"
NSQ_SOURCE_LINE 00001525 ""
NSQ_SOURCE_LINE 00001526 "    sub clone {"
NSQ_SOURCE_LINE 00001527 "\tmy ($old_dbh, $attr) = @_;"
NSQ_SOURCE_LINE 00001528 ""
NSQ_SOURCE_LINE 00001529 "\tmy $closure = $old_dbh->{dbi_connect_closure}"
NSQ_SOURCE_LINE 00001530 "            or return $old_dbh->set_err($DBI::stderr, \"Can't clone handle\");"
NSQ_SOURCE_LINE 00001531 ""
NSQ_SOURCE_LINE 00001532 "\tunless ($attr) { # XXX deprecated, caller should always pass a hash ref"
NSQ_SOURCE_LINE 00001533 "\t    # copy attributes visible in the attribute cache"
NSQ_SOURCE_LINE 00001534 "\t    keys %$old_dbh;\t# reset iterator"
NSQ_SOURCE_LINE 00001535 "\t    while ( my ($k, $v) = each %$old_dbh ) {"
NSQ_SOURCE_LINE 00001536 "\t\t# ignore non-code refs, i.e., caches, handles, Err etc"
NSQ_SOURCE_LINE 00001537 "\t\tnext if ref $v && ref $v ne 'CODE'; # HandleError etc"
NSQ_SOURCE_LINE 00001538 "\t\t$attr->{$k} = $v;"
NSQ_SOURCE_LINE 00001539 "\t    }"
NSQ_SOURCE_LINE 00001540 "\t    # explicitly set attributes which are unlikely to be in the"
NSQ_SOURCE_LINE 00001541 "\t    # attribute cache, i.e., boolean's and some others"
NSQ_SOURCE_LINE 00001542 "\t    $attr->{$_} = $old_dbh->FETCH($_) for (qw("
NSQ_SOURCE_LINE 00001543 "\t\tAutoCommit ChopBlanks InactiveDestroy AutoInactiveDestroy"
NSQ_SOURCE_LINE 00001544 "\t\tLongTruncOk PrintError PrintWarn Profile RaiseError RaiseWarn"
NSQ_SOURCE_LINE 00001545 "\t\tShowErrorStatement TaintIn TaintOut"
NSQ_SOURCE_LINE 00001546 "\t    ));"
NSQ_SOURCE_LINE 00001547 "\t}"
NSQ_SOURCE_LINE 00001548 ""
NSQ_SOURCE_LINE 00001549 "\t# use Data::Dumper; warn Dumper([$old_dbh, $attr]);"
NSQ_SOURCE_LINE 00001550 "\tmy $new_dbh = &$closure($old_dbh, $attr);"
NSQ_SOURCE_LINE 00001551 "\tunless ($new_dbh) {"
NSQ_SOURCE_LINE 00001552 "\t    # need to copy err/errstr from driver back into $old_dbh"
NSQ_SOURCE_LINE 00001553 "\t    my $drh = $old_dbh->{Driver};"
NSQ_SOURCE_LINE 00001554 "\t    return $old_dbh->set_err($drh->err, $drh->errstr, $drh->state);"
NSQ_SOURCE_LINE 00001555 "\t}"
NSQ_SOURCE_LINE 00001556 "        $new_dbh->{dbi_connect_closure} = $closure;"
NSQ_SOURCE_LINE 00001557 "\treturn $new_dbh;"
NSQ_SOURCE_LINE 00001558 "    }"
NSQ_SOURCE_LINE 00001559 ""
NSQ_SOURCE_LINE 00001560 "    sub quote_identifier {"
NSQ_SOURCE_LINE 00001561 "\tmy ($dbh, @id) = @_;"
NSQ_SOURCE_LINE 00001562 "\tmy $attr = (@id > 3 && ref($id[-1])) ? pop @id : undef;"
NSQ_SOURCE_LINE 00001563 ""
NSQ_SOURCE_LINE 00001564 "\tmy $info = $dbh->{dbi_quote_identifier_cache} ||= ["
NSQ_SOURCE_LINE 00001565 "\t    $dbh->get_info(29)  || '\"',\t# SQL_IDENTIFIER_QUOTE_CHAR"
NSQ_SOURCE_LINE 00001566 "\t    $dbh->get_info(41)  || '.',\t# SQL_CATALOG_NAME_SEPARATOR"
NSQ_SOURCE_LINE 00001567 "\t    $dbh->get_info(114) ||   1,\t# SQL_CATALOG_LOCATION"
NSQ_SOURCE_LINE 00001568 "\t];"
NSQ_SOURCE_LINE 00001569 ""
NSQ_SOURCE_LINE 00001570 "\tmy $quote = $info->[0];"
NSQ_SOURCE_LINE 00001571 "\tforeach (@id) {\t\t\t# quote the elements"
NSQ_SOURCE_LINE 00001572 "\t    next unless defined;"
NSQ_SOURCE_LINE 00001573 "\t    s/$quote/$quote$quote/g;\t# escape embedded quotes"
NSQ_SOURCE_LINE 00001574 "\t    $_ = qq{$quote$_$quote};"
NSQ_SOURCE_LINE 00001575 "\t}"
NSQ_SOURCE_LINE 00001576 ""
NSQ_SOURCE_LINE 00001577 "\t# strip out catalog if present for special handling"
NSQ_SOURCE_LINE 00001578 "\tmy $catalog = (@id >= 3) ? shift @id : undef;"
NSQ_SOURCE_LINE 00001579 ""
NSQ_SOURCE_LINE 00001580 "\t# join the dots, ignoring any null/undef elements (ie schema)"
NSQ_SOURCE_LINE 00001581 "\tmy $quoted_id = join '.', grep { defined } @id;"
NSQ_SOURCE_LINE 00001582 ""
NSQ_SOURCE_LINE 00001583 "\tif ($catalog) {\t\t\t# add catalog correctly"
NSQ_SOURCE_LINE 00001584 "        if ($quoted_id) {"
NSQ_SOURCE_LINE 00001585 "            $quoted_id = ($info->[2] == 2)\t# SQL_CL_END"
NSQ_SOURCE_LINE 00001586 "                ? $quoted_id . $info->[1] . $catalog"
NSQ_SOURCE_LINE 00001587 "                    : $catalog   . $info->[1] . $quoted_id;"
NSQ_SOURCE_LINE 00001588 "        } else {"
NSQ_SOURCE_LINE 00001589 "            $quoted_id = $catalog;"
NSQ_SOURCE_LINE 00001590 "        }"
NSQ_SOURCE_LINE 00001591 "\t}"
NSQ_SOURCE_LINE 00001592 "\treturn $quoted_id;"
NSQ_SOURCE_LINE 00001593 "    }"
NSQ_SOURCE_LINE 00001594 ""
NSQ_SOURCE_LINE 00001595 "    sub quote {"
NSQ_SOURCE_LINE 00001596 "\tmy ($dbh, $str, $data_type) = @_;"
NSQ_SOURCE_LINE 00001597 ""
NSQ_SOURCE_LINE 00001598 "\treturn \"NULL\" unless defined $str;"
NSQ_SOURCE_LINE 00001599 "\tunless ($data_type) {"
NSQ_SOURCE_LINE 00001600 "\t    $str =~ s/'/''/g;\t\t# ISO SQL2"
NSQ_SOURCE_LINE 00001601 "\t    return \"'$str'\";"
NSQ_SOURCE_LINE 00001602 "\t}"
NSQ_SOURCE_LINE 00001603 ""
NSQ_SOURCE_LINE 00001604 "\tmy $dbi_literal_quote_cache = $dbh->{'dbi_literal_quote_cache'} ||= [ {} , {} ];"
NSQ_SOURCE_LINE 00001605 "\tmy ($prefixes, $suffixes) = @$dbi_literal_quote_cache;"
NSQ_SOURCE_LINE 00001606 ""
NSQ_SOURCE_LINE 00001607 "\tmy $lp = $prefixes->{$data_type};"
NSQ_SOURCE_LINE 00001608 "\tmy $ls = $suffixes->{$data_type};"
NSQ_SOURCE_LINE 00001609 ""
NSQ_SOURCE_LINE 00001610 "\tif ( ! defined $lp || ! defined $ls ) {"
NSQ_SOURCE_LINE 00001611 "\t    my $ti = $dbh->type_info($data_type);"
NSQ_SOURCE_LINE 00001612 "\t    $lp = $prefixes->{$data_type} = $ti ? $ti->{LITERAL_PREFIX} || \"\" : \"'\";"
NSQ_SOURCE_LINE 00001613 "\t    $ls = $suffixes->{$data_type} = $ti ? $ti->{LITERAL_SUFFIX} || \"\" : \"'\";"
NSQ_SOURCE_LINE 00001614 "\t}"
NSQ_SOURCE_LINE 00001615 "\treturn $str unless $lp || $ls; # no quoting required"
NSQ_SOURCE_LINE 00001616 ""
NSQ_SOURCE_LINE 00001617 "\t# XXX don't know what the standard says about escaping"
NSQ_SOURCE_LINE 00001618 "\t# in the 'general case' (where $lp != \"'\")."
NSQ_SOURCE_LINE 00001619 "\t# So we just do this and hope:"
NSQ_SOURCE_LINE 00001620 "\t$str =~ s/$lp/$lp$lp/g"
NSQ_SOURCE_LINE 00001621 "\t\tif $lp && $lp eq $ls && ($lp eq \"'\" || $lp eq '\"');"
NSQ_SOURCE_LINE 00001622 "\treturn \"$lp$str$ls\";"
NSQ_SOURCE_LINE 00001623 "    }"
NSQ_SOURCE_LINE 00001624 ""
NSQ_SOURCE_LINE 00001625 "    sub rows { -1 }\t# here so $DBI::rows 'works' after using $dbh"
NSQ_SOURCE_LINE 00001626 ""
NSQ_SOURCE_LINE 00001627 "    sub do {"
NSQ_SOURCE_LINE 00001628 "\tmy($dbh, $statement, $attr, @params) = @_;"
NSQ_SOURCE_LINE 00001629 "\tmy $sth = $dbh->prepare($statement, $attr) or return undef;"
NSQ_SOURCE_LINE 00001630 "\t$sth->execute(@params) or return undef;"
NSQ_SOURCE_LINE 00001631 "\tmy $rows = $sth->rows;"
NSQ_SOURCE_LINE 00001632 "\t($rows == 0) ? \"0E0\" : $rows;"
NSQ_SOURCE_LINE 00001633 "    }"
NSQ_SOURCE_LINE 00001634 ""
NSQ_SOURCE_LINE 00001635 "    sub _do_selectrow {"
NSQ_SOURCE_LINE 00001636 "\tmy ($method, $dbh, $stmt, $attr, @bind) = @_;"
NSQ_SOURCE_LINE 00001637 "\tmy $sth = ((ref $stmt) ? $stmt : $dbh->prepare($stmt, $attr))"
NSQ_SOURCE_LINE 00001638 "\t    or return undef;"
NSQ_SOURCE_LINE 00001639 "\t$sth->execute(@bind)"
NSQ_SOURCE_LINE 00001640 "\t    or return undef;"
NSQ_SOURCE_LINE 00001641 "\tmy $row = $sth->$method()"
NSQ_SOURCE_LINE 00001642 "\t    and $sth->finish;"
NSQ_SOURCE_LINE 00001643 "\treturn $row;"
NSQ_SOURCE_LINE 00001644 "    }"
NSQ_SOURCE_LINE 00001645 ""
NSQ_SOURCE_LINE 00001646 "    sub selectrow_hashref {  return _do_selectrow('fetchrow_hashref',  @_); }"
NSQ_SOURCE_LINE 00001647 ""
NSQ_SOURCE_LINE 00001648 "    # XXX selectrow_array/ref also have C implementations in Driver.xst"
NSQ_SOURCE_LINE 00001649 "    sub selectrow_arrayref { return _do_selectrow('fetchrow_arrayref', @_); }"
NSQ_SOURCE_LINE 00001650 "    sub selectrow_array {"
NSQ_SOURCE_LINE 00001651 "\tmy $row = _do_selectrow('fetchrow_arrayref', @_) or return;"
NSQ_SOURCE_LINE 00001652 "\treturn $row->[0] unless wantarray;"
NSQ_SOURCE_LINE 00001653 "\treturn @$row;"
NSQ_SOURCE_LINE 00001654 "    }"
NSQ_SOURCE_LINE 00001655 ""
NSQ_SOURCE_LINE 00001656 "    sub selectall_array {"
NSQ_SOURCE_LINE 00001657 "        return @{ shift->selectall_arrayref(@_) || [] };"
NSQ_SOURCE_LINE 00001658 "    }"
NSQ_SOURCE_LINE 00001659 ""
NSQ_SOURCE_LINE 00001660 "    # XXX selectall_arrayref also has C implementation in Driver.xst"
NSQ_SOURCE_LINE 00001661 "    # which fallsback to this if a slice is given"
NSQ_SOURCE_LINE 00001662 "    sub selectall_arrayref {"
NSQ_SOURCE_LINE 00001663 "\tmy ($dbh, $stmt, $attr, @bind) = @_;"
NSQ_SOURCE_LINE 00001664 "\tmy $sth = (ref $stmt) ? $stmt : $dbh->prepare($stmt, $attr)"
NSQ_SOURCE_LINE 00001665 "\t    or return;"
NSQ_SOURCE_LINE 00001666 "\t$sth->execute(@bind) || return;"
NSQ_SOURCE_LINE 00001667 "\tmy $slice = $attr->{Slice}; # typically undef, else hash or array ref"
NSQ_SOURCE_LINE 00001668 "\tif (!$slice and $slice=$attr->{Columns}) {"
NSQ_SOURCE_LINE 00001669 "\t    if (ref $slice eq 'ARRAY') { # map col idx to perl array idx"
NSQ_SOURCE_LINE 00001670 "\t\t$slice = [ @{$attr->{Columns}} ];\t# take a copy"
NSQ_SOURCE_LINE 00001671 "\t\tfor (@$slice) { $_-- }"
NSQ_SOURCE_LINE 00001672 "\t    }"
NSQ_SOURCE_LINE 00001673 "\t}"
NSQ_SOURCE_LINE 00001674 "\tmy $rows = $sth->fetchall_arrayref($slice, my $MaxRows = $attr->{MaxRows});"
NSQ_SOURCE_LINE 00001675 "\t$sth->finish if defined $MaxRows;"
NSQ_SOURCE_LINE 00001676 "\treturn $rows;"
NSQ_SOURCE_LINE 00001677 "    }"
NSQ_SOURCE_LINE 00001678 ""
NSQ_SOURCE_LINE 00001679 "    sub selectall_hashref {"
NSQ_SOURCE_LINE 00001680 "\tmy ($dbh, $stmt, $key_field, $attr, @bind) = @_;"
NSQ_SOURCE_LINE 00001681 "\tmy $sth = (ref $stmt) ? $stmt : $dbh->prepare($stmt, $attr);"
NSQ_SOURCE_LINE 00001682 "\treturn unless $sth;"
NSQ_SOURCE_LINE 00001683 "\t$sth->execute(@bind) || return;"
NSQ_SOURCE_LINE 00001684 "\treturn $sth->fetchall_hashref($key_field);"
NSQ_SOURCE_LINE 00001685 "    }"
NSQ_SOURCE_LINE 00001686 ""
NSQ_SOURCE_LINE 00001687 "    sub selectcol_arrayref {"
NSQ_SOURCE_LINE 00001688 "\tmy ($dbh, $stmt, $attr, @bind) = @_;"
NSQ_SOURCE_LINE 00001689 "\tmy $sth = (ref $stmt) ? $stmt : $dbh->prepare($stmt, $attr);"
NSQ_SOURCE_LINE 00001690 "\treturn unless $sth;"
NSQ_SOURCE_LINE 00001691 "\t$sth->execute(@bind) || return;"
NSQ_SOURCE_LINE 00001692 "\tmy @columns = ($attr->{Columns}) ? @{$attr->{Columns}} : (1);"
NSQ_SOURCE_LINE 00001693 "\tmy @values  = (undef) x @columns;"
NSQ_SOURCE_LINE 00001694 "\tmy $idx = 0;"
NSQ_SOURCE_LINE 00001695 "\tfor (@columns) {"
NSQ_SOURCE_LINE 00001696 "\t    $sth->bind_col($_, \\$values[$idx++]) || return;"
NSQ_SOURCE_LINE 00001697 "\t}"
NSQ_SOURCE_LINE 00001698 "\tmy @col;"
NSQ_SOURCE_LINE 00001699 "\tif (my $max = $attr->{MaxRows}) {"
NSQ_SOURCE_LINE 00001700 "\t    push @col, @values while 0 < $max-- && $sth->fetch;"
NSQ_SOURCE_LINE 00001701 "\t}"
NSQ_SOURCE_LINE 00001702 "\telse {"
NSQ_SOURCE_LINE 00001703 "\t    push @col, @values while $sth->fetch;"
NSQ_SOURCE_LINE 00001704 "\t}"
NSQ_SOURCE_LINE 00001705 "\treturn \\@col;"
NSQ_SOURCE_LINE 00001706 "    }"
NSQ_SOURCE_LINE 00001707 ""
NSQ_SOURCE_LINE 00001708 "    sub prepare_cached {"
NSQ_SOURCE_LINE 00001709 "\tmy ($dbh, $statement, $attr, $if_active) = @_;"
NSQ_SOURCE_LINE 00001710 ""
NSQ_SOURCE_LINE 00001711 "\t# Needs support at dbh level to clear cache before complaining about"
NSQ_SOURCE_LINE 00001712 "\t# active children. The XS template code does this. Drivers not using"
NSQ_SOURCE_LINE 00001713 "\t# the template must handle clearing the cache themselves."
NSQ_SOURCE_LINE 00001714 "\tmy $cache = $dbh->{CachedKids} ||= {};"
NSQ_SOURCE_LINE 00001715 "\tmy $key = do { no warnings;"
NSQ_SOURCE_LINE 00001716 "\t    join \"!\\001\", $statement, DBI::_concat_hash_sorted($attr, \"=\\001\", \",\\001\", 0, 0)"
NSQ_SOURCE_LINE 00001717 "\t};"
NSQ_SOURCE_LINE 00001718 "\tmy $sth = $cache->{$key};"
NSQ_SOURCE_LINE 00001719 ""
NSQ_SOURCE_LINE 00001720 "\tif ($sth) {"
NSQ_SOURCE_LINE 00001721 "\t    return $sth unless $sth->FETCH('Active');"
NSQ_SOURCE_LINE 00001722 "\t    Carp::carp(\"prepare_cached($statement) statement handle $sth still Active\")"
NSQ_SOURCE_LINE 00001723 "\t\tunless ($if_active ||= 0);"
NSQ_SOURCE_LINE 00001724 "\t    $sth->finish if $if_active <= 1;"
NSQ_SOURCE_LINE 00001725 "\t    return $sth  if $if_active <= 2;"
NSQ_SOURCE_LINE 00001726 "\t}"
NSQ_SOURCE_LINE 00001727 ""
NSQ_SOURCE_LINE 00001728 "\t$sth = $dbh->prepare($statement, $attr);"
NSQ_SOURCE_LINE 00001729 "\t$cache->{$key} = $sth if $sth;"
NSQ_SOURCE_LINE 00001730 ""
NSQ_SOURCE_LINE 00001731 "\treturn $sth;"
NSQ_SOURCE_LINE 00001732 "    }"
NSQ_SOURCE_LINE 00001733 ""
NSQ_SOURCE_LINE 00001734 "    sub ping {"
NSQ_SOURCE_LINE 00001735 "\tmy $dbh = shift;"
NSQ_SOURCE_LINE 00001736 "\t# \"0 but true\" is a special kind of true 0 that is used here so"
NSQ_SOURCE_LINE 00001737 "\t# applications can check if the ping was a real ping or not"
NSQ_SOURCE_LINE 00001738 "\t($dbh->FETCH('Active')) ?  \"0 but true\" : 0;"
NSQ_SOURCE_LINE 00001739 "    }"
NSQ_SOURCE_LINE 00001740 ""
NSQ_SOURCE_LINE 00001741 "    sub begin_work {"
NSQ_SOURCE_LINE 00001742 "\tmy $dbh = shift;"
NSQ_SOURCE_LINE 00001743 "\treturn $dbh->set_err($DBI::stderr, \"Already in a transaction\")"
NSQ_SOURCE_LINE 00001744 "\t\tunless $dbh->FETCH('AutoCommit');"
NSQ_SOURCE_LINE 00001745 "\t$dbh->STORE('AutoCommit', 0); # will croak if driver doesn't support it"
NSQ_SOURCE_LINE 00001746 "\t$dbh->STORE('BegunWork',  1); # trigger post commit/rollback action"
NSQ_SOURCE_LINE 00001747 "\treturn 1;"
NSQ_SOURCE_LINE 00001748 "    }"
NSQ_SOURCE_LINE 00001749 ""
NSQ_SOURCE_LINE 00001750 "    sub primary_key {"
NSQ_SOURCE_LINE 00001751 "\tmy ($dbh, @args) = @_;"
NSQ_SOURCE_LINE 00001752 "\tmy $sth = $dbh->primary_key_info(@args) or return;"
NSQ_SOURCE_LINE 00001753 "\tmy ($row, @col);"
NSQ_SOURCE_LINE 00001754 "\tpush @col, $row->[3] while ($row = $sth->fetch);"
NSQ_SOURCE_LINE 00001755 "\tCarp::croak(\"primary_key method not called in list context\")"
NSQ_SOURCE_LINE 00001756 "\t\tunless wantarray; # leave us some elbow room"
NSQ_SOURCE_LINE 00001757 "\treturn @col;"
NSQ_SOURCE_LINE 00001758 "    }"
NSQ_SOURCE_LINE 00001759 ""
NSQ_SOURCE_LINE 00001760 "    sub tables {"
NSQ_SOURCE_LINE 00001761 "\tmy ($dbh, @args) = @_;"
NSQ_SOURCE_LINE 00001762 "\tmy $sth    = $dbh->table_info(@args[0,1,2,3,4]) or return;"
NSQ_SOURCE_LINE 00001763 "\tmy $tables = $sth->fetchall_arrayref or return;"
NSQ_SOURCE_LINE 00001764 "\tmy @tables;"
NSQ_SOURCE_LINE 00001765 "\tif (defined($args[3]) && $args[3] eq '%' # special case for tables('','','','%')"
NSQ_SOURCE_LINE 00001766 "\t    && grep {defined($_) && $_ eq ''} @args[0,1,2]"
NSQ_SOURCE_LINE 00001767 "\t) {"
NSQ_SOURCE_LINE 00001768 "\t    @tables = map { $_->[3] } @$tables;"
NSQ_SOURCE_LINE 00001769 "\t} elsif ($dbh->get_info(29)) { # SQL_IDENTIFIER_QUOTE_CHAR"
NSQ_SOURCE_LINE 00001770 "\t    @tables = map { $dbh->quote_identifier( @{$_}[0,1,2] ) } @$tables;"
NSQ_SOURCE_LINE 00001771 "\t}"
NSQ_SOURCE_LINE 00001772 "\telse {\t\t# temporary old style hack (yeach)"
NSQ_SOURCE_LINE 00001773 "\t    @tables = map {"
NSQ_SOURCE_LINE 00001774 "\t\tmy $name = $_->[2];"
NSQ_SOURCE_LINE 00001775 "\t\tif ($_->[1]) {"
NSQ_SOURCE_LINE 00001776 "\t\t    my $schema = $_->[1];"
NSQ_SOURCE_LINE 00001777 "\t\t    # a sad hack (mostly for Informix I recall)"
NSQ_SOURCE_LINE 00001778 "\t\t    my $quote = ($schema eq uc($schema)) ? '' : '\"';"
NSQ_SOURCE_LINE 00001779 "\t\t    $name = \"$quote$schema$quote.$name\""
NSQ_SOURCE_LINE 00001780 "\t\t}"
NSQ_SOURCE_LINE 00001781 "\t\t$name;"
NSQ_SOURCE_LINE 00001782 "\t    } @$tables;"
NSQ_SOURCE_LINE 00001783 "\t}"
NSQ_SOURCE_LINE 00001784 "\treturn @tables;"
NSQ_SOURCE_LINE 00001785 "    }"
NSQ_SOURCE_LINE 00001786 ""
NSQ_SOURCE_LINE 00001787 "    sub type_info {\t# this should be sufficient for all drivers"
NSQ_SOURCE_LINE 00001788 "\tmy ($dbh, $data_type) = @_;"
NSQ_SOURCE_LINE 00001789 "\tmy $idx_hash;"
NSQ_SOURCE_LINE 00001790 "\tmy $tia = $dbh->{dbi_type_info_row_cache};"
NSQ_SOURCE_LINE 00001791 "\tif ($tia) {"
NSQ_SOURCE_LINE 00001792 "\t    $idx_hash = $dbh->{dbi_type_info_idx_cache};"
NSQ_SOURCE_LINE 00001793 "\t}"
NSQ_SOURCE_LINE 00001794 "\telse {"
NSQ_SOURCE_LINE 00001795 "\t    my $temp = $dbh->type_info_all;"
NSQ_SOURCE_LINE 00001796 "\t    return unless $temp && @$temp;"
NSQ_SOURCE_LINE 00001797 "\t    # we cache here because type_info_all may be expensive to call"
NSQ_SOURCE_LINE 00001798 "\t    # (and we take a copy so the following shift can't corrupt"
NSQ_SOURCE_LINE 00001799 "\t    # the data that may be returned by future calls to type_info_all)"
NSQ_SOURCE_LINE 00001800 "\t    $tia      = $dbh->{dbi_type_info_row_cache} = [ @$temp ];"
NSQ_SOURCE_LINE 00001801 "\t    $idx_hash = $dbh->{dbi_type_info_idx_cache} = shift @$tia;"
NSQ_SOURCE_LINE 00001802 "\t}"
NSQ_SOURCE_LINE 00001803 ""
NSQ_SOURCE_LINE 00001804 "\tmy $dt_idx   = $idx_hash->{DATA_TYPE} || $idx_hash->{data_type};"
NSQ_SOURCE_LINE 00001805 "\tCarp::croak(\"type_info_all returned non-standard DATA_TYPE index value ($dt_idx != 1)\")"
NSQ_SOURCE_LINE 00001806 "\t    if $dt_idx && $dt_idx != 1;"
NSQ_SOURCE_LINE 00001807 ""
NSQ_SOURCE_LINE 00001808 "\t# --- simple DATA_TYPE match filter"
NSQ_SOURCE_LINE 00001809 "\tmy @ti;"
NSQ_SOURCE_LINE 00001810 "\tmy @data_type_list = (ref $data_type) ? @$data_type : ($data_type);"
NSQ_SOURCE_LINE 00001811 "\tforeach $data_type (@data_type_list) {"
NSQ_SOURCE_LINE 00001812 "\t    if (defined($data_type) && $data_type != DBI::SQL_ALL_TYPES()) {"
NSQ_SOURCE_LINE 00001813 "\t\tpush @ti, grep { $_->[$dt_idx] == $data_type } @$tia;"
NSQ_SOURCE_LINE 00001814 "\t    }"
NSQ_SOURCE_LINE 00001815 "\t    else {\t# SQL_ALL_TYPES"
NSQ_SOURCE_LINE 00001816 "\t\tpush @ti, @$tia;"
NSQ_SOURCE_LINE 00001817 "\t    }"
NSQ_SOURCE_LINE 00001818 "\t    last if @ti;\t# found at least one match"
NSQ_SOURCE_LINE 00001819 "\t}"
NSQ_SOURCE_LINE 00001820 ""
NSQ_SOURCE_LINE 00001821 "\t# --- format results into list of hash refs"
NSQ_SOURCE_LINE 00001822 "\tmy $idx_fields = keys %$idx_hash;"
NSQ_SOURCE_LINE 00001823 "\tmy @idx_names  = map { uc($_) } keys %$idx_hash;"
NSQ_SOURCE_LINE 00001824 "\tmy @idx_values = values %$idx_hash;"
NSQ_SOURCE_LINE 00001825 "\tCarp::croak \"type_info_all result has $idx_fields keys but \".(@{$ti[0]}).\" fields\""
NSQ_SOURCE_LINE 00001826 "\t\tif @ti && @{$ti[0]} != $idx_fields;"
NSQ_SOURCE_LINE 00001827 "\tmy @out = map {"
NSQ_SOURCE_LINE 00001828 "\t    my %h; @h{@idx_names} = @{$_}[ @idx_values ]; \\%h;"
NSQ_SOURCE_LINE 00001829 "\t} @ti;"
NSQ_SOURCE_LINE 00001830 "\treturn $out[0] unless wantarray;"
NSQ_SOURCE_LINE 00001831 "\treturn @out;"
NSQ_SOURCE_LINE 00001832 "    }"
NSQ_SOURCE_LINE 00001833 ""
NSQ_SOURCE_LINE 00001834 "    sub data_sources {"
NSQ_SOURCE_LINE 00001835 "\tmy ($dbh, @other) = @_;"
NSQ_SOURCE_LINE 00001836 "\tmy $drh = $dbh->{Driver}; # XXX proxy issues?"
NSQ_SOURCE_LINE 00001837 "\treturn $drh->data_sources(@other);"
NSQ_SOURCE_LINE 00001838 "    }"
NSQ_SOURCE_LINE 00001839 ""
NSQ_SOURCE_LINE 00001840 "}"
NSQ_SOURCE_LINE 00001841 ""
NSQ_SOURCE_LINE 00001842 ""
NSQ_SOURCE_LINE 00001843 "{   package\t\t# hide from PAUSE"
NSQ_SOURCE_LINE 00001844 "\tDBD::_::st;\t# ====== STATEMENT ======"
NSQ_SOURCE_LINE 00001845 "    our @ISA = qw(DBD::_::common);"
NSQ_SOURCE_LINE 00001846 "    use strict;"
NSQ_SOURCE_LINE 00001847 ""
NSQ_SOURCE_LINE 00001848 "    sub bind_param { Carp::croak(\"Can't bind_param, not implement by driver\") }"
NSQ_SOURCE_LINE 00001849 ""
NSQ_SOURCE_LINE 00001850 "#"
NSQ_SOURCE_LINE 00001851 "# ********************************************************"
NSQ_SOURCE_LINE 00001852 "#"
NSQ_SOURCE_LINE 00001853 "#\tBEGIN ARRAY BINDING"
NSQ_SOURCE_LINE 00001854 "#"
NSQ_SOURCE_LINE 00001855 "#\tArray binding support for drivers which don't support"
NSQ_SOURCE_LINE 00001856 "#\tarray binding, but have sufficient interfaces to fake it."
NSQ_SOURCE_LINE 00001857 "#\tNOTE: mixing scalars and arrayrefs requires using bind_param_array"
NSQ_SOURCE_LINE 00001858 "#\tfor *all* params...unless we modify bind_param for the default"
NSQ_SOURCE_LINE 00001859 "#\tcase..."
NSQ_SOURCE_LINE 00001860 "#"
NSQ_SOURCE_LINE 00001861 "#\t2002-Apr-10\tD. Arnold"
NSQ_SOURCE_LINE 00001862 ""
NSQ_SOURCE_LINE 00001863 "    sub bind_param_array {"
NSQ_SOURCE_LINE 00001864 "\tmy $sth = shift;"
NSQ_SOURCE_LINE 00001865 "\tmy ($p_id, $value_array, $attr) = @_;"
NSQ_SOURCE_LINE 00001866 ""
NSQ_SOURCE_LINE 00001867 "\treturn $sth->set_err($DBI::stderr, \"Value for parameter $p_id must be a scalar or an arrayref, not a \".ref($value_array))"
NSQ_SOURCE_LINE 00001868 "\t    if defined $value_array and ref $value_array and ref $value_array ne 'ARRAY';"
NSQ_SOURCE_LINE 00001869 ""
NSQ_SOURCE_LINE 00001870 "\treturn $sth->set_err($DBI::stderr, \"Can't use named placeholder '$p_id' for non-driver supported bind_param_array\")"
NSQ_SOURCE_LINE 00001871 "\t    unless DBI::looks_like_number($p_id); # because we rely on execute(@ary) here"
NSQ_SOURCE_LINE 00001872 ""
NSQ_SOURCE_LINE 00001873 "\treturn $sth->set_err($DBI::stderr, \"Placeholder '$p_id' is out of range\")"
NSQ_SOURCE_LINE 00001874 "\t    if $p_id <= 0; # can't easily/reliably test for too big"
NSQ_SOURCE_LINE 00001875 ""
NSQ_SOURCE_LINE 00001876 "\t# get/create arrayref to hold params"
NSQ_SOURCE_LINE 00001877 "\tmy $hash_of_arrays = $sth->{ParamArrays} ||= { };"
NSQ_SOURCE_LINE 00001878 ""
NSQ_SOURCE_LINE 00001879 "\t# If the bind has attribs then we rely on the driver conforming to"
NSQ_SOURCE_LINE 00001880 "\t# the DBI spec in that a single bind_param() call with those attribs"
NSQ_SOURCE_LINE 00001881 "\t# makes them 'sticky' and apply to all later execute(@values) calls."
NSQ_SOURCE_LINE 00001882 "\t# Since we only call bind_param() if we're given attribs then"
NSQ_SOURCE_LINE 00001883 "\t# applications using drivers that don't support bind_param can still"
NSQ_SOURCE_LINE 00001884 "\t# use bind_param_array() so long as they don't pass any attribs."
NSQ_SOURCE_LINE 00001885 ""
NSQ_SOURCE_LINE 00001886 "\t$$hash_of_arrays{$p_id} = $value_array;"
NSQ_SOURCE_LINE 00001887 "\treturn $sth->bind_param($p_id, undef, $attr)"
NSQ_SOURCE_LINE 00001888 "\t\tif $attr;"
NSQ_SOURCE_LINE 00001889 "\t1;"
NSQ_SOURCE_LINE 00001890 "    }"
NSQ_SOURCE_LINE 00001891 ""
NSQ_SOURCE_LINE 00001892 "    sub bind_param_inout_array {"
NSQ_SOURCE_LINE 00001893 "\tmy $sth = shift;"
NSQ_SOURCE_LINE 00001894 "\t# XXX not supported so we just call bind_param_array instead"
NSQ_SOURCE_LINE 00001895 "\t# and then return an error"
NSQ_SOURCE_LINE 00001896 "\tmy ($p_num, $value_array, $attr) = @_;"
NSQ_SOURCE_LINE 00001897 "\t$sth->bind_param_array($p_num, $value_array, $attr);"
NSQ_SOURCE_LINE 00001898 "\treturn $sth->set_err($DBI::stderr, \"bind_param_inout_array not supported\");"
NSQ_SOURCE_LINE 00001899 "    }"
NSQ_SOURCE_LINE 00001900 ""
NSQ_SOURCE_LINE 00001901 "    sub bind_columns {"
NSQ_SOURCE_LINE 00001902 "\tmy $sth = shift;"
NSQ_SOURCE_LINE 00001903 "\tmy $fields = $sth->FETCH('NUM_OF_FIELDS') || 0;"
NSQ_SOURCE_LINE 00001904 "\tif ($fields <= 0 && !$sth->{Active}) {"
NSQ_SOURCE_LINE 00001905 "\t    return $sth->set_err($DBI::stderr, \"Statement has no result columns to bind\""
NSQ_SOURCE_LINE 00001906 "\t\t    .\" (perhaps you need to successfully call execute first, or again)\");"
NSQ_SOURCE_LINE 00001907 "\t}"
NSQ_SOURCE_LINE 00001908 "\t# Backwards compatibility for old-style call with attribute hash"
NSQ_SOURCE_LINE 00001909 "\t# ref as first arg. Skip arg if undef or a hash ref."
NSQ_SOURCE_LINE 00001910 "\tmy $attr;"
NSQ_SOURCE_LINE 00001911 "\t$attr = shift if !defined $_[0] or ref($_[0]) eq 'HASH';"
NSQ_SOURCE_LINE 00001912 ""
NSQ_SOURCE_LINE 00001913 "\tmy $idx = 0;"
NSQ_SOURCE_LINE 00001914 "\t$sth->bind_col(++$idx, shift, $attr) or return"
NSQ_SOURCE_LINE 00001915 "\t    while (@_ and $idx < $fields);"
NSQ_SOURCE_LINE 00001916 ""
NSQ_SOURCE_LINE 00001917 "\treturn $sth->set_err($DBI::stderr, \"bind_columns called with \".($idx+@_).\" values but $fields are needed\")"
NSQ_SOURCE_LINE 00001918 "\t    if @_ or $idx != $fields;"
NSQ_SOURCE_LINE 00001919 ""
NSQ_SOURCE_LINE 00001920 "\treturn 1;"
NSQ_SOURCE_LINE 00001921 "    }"
NSQ_SOURCE_LINE 00001922 ""
NSQ_SOURCE_LINE 00001923 "    sub execute_array {"
NSQ_SOURCE_LINE 00001924 "\tmy $sth = shift;"
NSQ_SOURCE_LINE 00001925 "\tmy ($attr, @array_of_arrays) = @_;"
NSQ_SOURCE_LINE 00001926 "\tmy $NUM_OF_PARAMS = $sth->FETCH('NUM_OF_PARAMS'); # may be undef at this point"
NSQ_SOURCE_LINE 00001927 ""
NSQ_SOURCE_LINE 00001928 "\t# get tuple status array or hash attribute"
NSQ_SOURCE_LINE 00001929 "\tmy $tuple_sts = $attr->{ArrayTupleStatus};"
NSQ_SOURCE_LINE 00001930 "\treturn $sth->set_err($DBI::stderr, \"ArrayTupleStatus attribute must be an arrayref\")"
NSQ_SOURCE_LINE 00001931 "\t\tif $tuple_sts and ref $tuple_sts ne 'ARRAY';"
NSQ_SOURCE_LINE 00001932 ""
NSQ_SOURCE_LINE 00001933 "\t# bind all supplied arrays"
NSQ_SOURCE_LINE 00001934 "\tif (@array_of_arrays) {"
NSQ_SOURCE_LINE 00001935 "\t    $sth->{ParamArrays} = { };\t# clear out old params"
NSQ_SOURCE_LINE 00001936 "\t    return $sth->set_err($DBI::stderr,"
NSQ_SOURCE_LINE 00001937 "\t\t    @array_of_arrays.\" bind values supplied but $NUM_OF_PARAMS expected\")"
NSQ_SOURCE_LINE 00001938 "\t\tif defined ($NUM_OF_PARAMS) && @array_of_arrays != $NUM_OF_PARAMS;"
NSQ_SOURCE_LINE 00001939 "\t    $sth->bind_param_array($_, $array_of_arrays[$_-1]) or return"
NSQ_SOURCE_LINE 00001940 "\t\tforeach (1..@array_of_arrays);"
NSQ_SOURCE_LINE 00001941 "\t}"
NSQ_SOURCE_LINE 00001942 ""
NSQ_SOURCE_LINE 00001943 "\tmy $fetch_tuple_sub;"
NSQ_SOURCE_LINE 00001944 ""
NSQ_SOURCE_LINE 00001945 "\tif ($fetch_tuple_sub = $attr->{ArrayTupleFetch}) {\t# fetch on demand"
NSQ_SOURCE_LINE 00001946 ""
NSQ_SOURCE_LINE 00001947 "\t    return $sth->set_err($DBI::stderr,"
NSQ_SOURCE_LINE 00001948 "\t\t    \"Can't use both ArrayTupleFetch and explicit bind values\")"
NSQ_SOURCE_LINE 00001949 "\t\tif @array_of_arrays; # previous bind_param_array calls will simply be ignored"
NSQ_SOURCE_LINE 00001950 ""
NSQ_SOURCE_LINE 00001951 "\t    if (UNIVERSAL::isa($fetch_tuple_sub,'DBI::st')) {"
NSQ_SOURCE_LINE 00001952 "\t\tmy $fetch_sth = $fetch_tuple_sub;"
NSQ_SOURCE_LINE 00001953 "\t\treturn $sth->set_err($DBI::stderr,"
NSQ_SOURCE_LINE 00001954 "\t\t\t\"ArrayTupleFetch sth is not Active, need to execute() it first\")"
NSQ_SOURCE_LINE 00001955 "\t\t    unless $fetch_sth->{Active};"
NSQ_SOURCE_LINE 00001956 "\t\t# check column count match to give more friendly message"
NSQ_SOURCE_LINE 00001957 "\t\tmy $NUM_OF_FIELDS = $fetch_sth->{NUM_OF_FIELDS};"
NSQ_SOURCE_LINE 00001958 "\t\treturn $sth->set_err($DBI::stderr,"
NSQ_SOURCE_LINE 00001959 "\t\t\t\"$NUM_OF_FIELDS columns from ArrayTupleFetch sth but $NUM_OF_PARAMS expected\")"
NSQ_SOURCE_LINE 00001960 "\t\t    if defined($NUM_OF_FIELDS) && defined($NUM_OF_PARAMS)"
NSQ_SOURCE_LINE 00001961 "\t\t    && $NUM_OF_FIELDS != $NUM_OF_PARAMS;"
NSQ_SOURCE_LINE 00001962 "\t\t$fetch_tuple_sub = sub { $fetch_sth->fetchrow_arrayref };"
NSQ_SOURCE_LINE 00001963 "\t    }"
NSQ_SOURCE_LINE 00001964 "\t    elsif (!UNIVERSAL::isa($fetch_tuple_sub,'CODE')) {"
NSQ_SOURCE_LINE 00001965 "\t\treturn $sth->set_err($DBI::stderr, \"ArrayTupleFetch '$fetch_tuple_sub' is not a code ref or statement handle\");"
NSQ_SOURCE_LINE 00001966 "\t    }"
NSQ_SOURCE_LINE 00001967 ""
NSQ_SOURCE_LINE 00001968 "\t}"
NSQ_SOURCE_LINE 00001969 "\telse {"
NSQ_SOURCE_LINE 00001970 "\t    my $NUM_OF_PARAMS_given = keys %{ $sth->{ParamArrays} || {} };"
NSQ_SOURCE_LINE 00001971 "\t    return $sth->set_err($DBI::stderr,"
NSQ_SOURCE_LINE 00001972 "\t\t    \"$NUM_OF_PARAMS_given bind values supplied but $NUM_OF_PARAMS expected\")"
NSQ_SOURCE_LINE 00001973 "\t\tif defined($NUM_OF_PARAMS) && $NUM_OF_PARAMS != $NUM_OF_PARAMS_given;"
NSQ_SOURCE_LINE 00001974 ""
NSQ_SOURCE_LINE 00001975 "\t    # get the length of a bound array"
NSQ_SOURCE_LINE 00001976 "\t    my $maxlen;"
NSQ_SOURCE_LINE 00001977 "\t    my %hash_of_arrays = %{$sth->{ParamArrays}};"
NSQ_SOURCE_LINE 00001978 "\t    foreach (keys(%hash_of_arrays)) {"
NSQ_SOURCE_LINE 00001979 "\t\tmy $ary = $hash_of_arrays{$_};"
NSQ_SOURCE_LINE 00001980 "\t\tnext unless ref $ary eq 'ARRAY';"
NSQ_SOURCE_LINE 00001981 "\t\t$maxlen = @$ary if !$maxlen || @$ary > $maxlen;"
NSQ_SOURCE_LINE 00001982 "\t    }"
NSQ_SOURCE_LINE 00001983 "\t    # if there are no arrays then execute scalars once"
NSQ_SOURCE_LINE 00001984 "\t    $maxlen = 1 unless defined $maxlen;"
NSQ_SOURCE_LINE 00001985 "\t    my @bind_ids = 1..keys(%hash_of_arrays);"
NSQ_SOURCE_LINE 00001986 ""
NSQ_SOURCE_LINE 00001987 "\t    my $tuple_idx = 0;"
NSQ_SOURCE_LINE 00001988 "\t    $fetch_tuple_sub = sub {"
NSQ_SOURCE_LINE 00001989 "\t\treturn if $tuple_idx >= $maxlen;"
NSQ_SOURCE_LINE 00001990 "\t\tmy @tuple = map {"
NSQ_SOURCE_LINE 00001991 "\t\t    my $a = $hash_of_arrays{$_};"
NSQ_SOURCE_LINE 00001992 "\t\t    ref($a) ? $a->[$tuple_idx] : $a"
NSQ_SOURCE_LINE 00001993 "\t\t} @bind_ids;"
NSQ_SOURCE_LINE 00001994 "\t\t++$tuple_idx;"
NSQ_SOURCE_LINE 00001995 "\t\treturn \\@tuple;"
NSQ_SOURCE_LINE 00001996 "\t    };"
NSQ_SOURCE_LINE 00001997 "\t}"
NSQ_SOURCE_LINE 00001998 "\t# pass thru the callers scalar or list context"
NSQ_SOURCE_LINE 00001999 "\treturn $sth->execute_for_fetch($fetch_tuple_sub, $tuple_sts);"
NSQ_SOURCE_LINE 00002000 "    }"
NSQ_SOURCE_LINE 00002001 ""
NSQ_SOURCE_LINE 00002002 "    sub execute_for_fetch {"
NSQ_SOURCE_LINE 00002003 "\tmy ($sth, $fetch_tuple_sub, $tuple_status) = @_;"
NSQ_SOURCE_LINE 00002004 "\t# start with empty status array"
NSQ_SOURCE_LINE 00002005 "\t($tuple_status) ? @$tuple_status = () : $tuple_status = [];"
NSQ_SOURCE_LINE 00002006 ""
NSQ_SOURCE_LINE 00002007 "        my $rc_total = 0;"
NSQ_SOURCE_LINE 00002008 "\tmy $err_count;"
NSQ_SOURCE_LINE 00002009 "\twhile ( my $tuple = &$fetch_tuple_sub() ) {"
NSQ_SOURCE_LINE 00002010 "\t    if ( my $rc = $sth->execute(@$tuple) ) {"
NSQ_SOURCE_LINE 00002011 "\t\tpush @$tuple_status, $rc;"
NSQ_SOURCE_LINE 00002012 "\t\t$rc_total = ($rc >= 0 && $rc_total >= 0) ? $rc_total + $rc : -1;"
NSQ_SOURCE_LINE 00002013 "\t    }"
NSQ_SOURCE_LINE 00002014 "\t    else {"
NSQ_SOURCE_LINE 00002015 "\t\t$err_count++;"
NSQ_SOURCE_LINE 00002016 "\t\tpush @$tuple_status, [ $sth->err, $sth->errstr, $sth->state ];"
NSQ_SOURCE_LINE 00002017 "                # XXX drivers implementing execute_for_fetch could opt to \"last;\" here"
NSQ_SOURCE_LINE 00002018 "                # if they know the error code means no further executes will work."
NSQ_SOURCE_LINE 00002019 "\t    }"
NSQ_SOURCE_LINE 00002020 "\t}"
NSQ_SOURCE_LINE 00002021 "        my $tuples = @$tuple_status;"
NSQ_SOURCE_LINE 00002022 "        return $sth->set_err($DBI::stderr, \"executing $tuples generated $err_count errors\")"
NSQ_SOURCE_LINE 00002023 "            if $err_count;"
NSQ_SOURCE_LINE 00002024 "\t$tuples ||= \"0E0\";"
NSQ_SOURCE_LINE 00002025 "\treturn $tuples unless wantarray;"
NSQ_SOURCE_LINE 00002026 "\treturn ($tuples, $rc_total);"
NSQ_SOURCE_LINE 00002027 "    }"
NSQ_SOURCE_LINE 00002028 ""
NSQ_SOURCE_LINE 00002029 "    sub last_insert_id {"
NSQ_SOURCE_LINE 00002030 "        return shift->{Database}->last_insert_id(@_);"
NSQ_SOURCE_LINE 00002031 "    }"
NSQ_SOURCE_LINE 00002032 ""
NSQ_SOURCE_LINE 00002033 "    sub fetchall_arrayref {\t# ALSO IN Driver.xst"
NSQ_SOURCE_LINE 00002034 "\tmy ($sth, $slice, $max_rows) = @_;"
NSQ_SOURCE_LINE 00002035 ""
NSQ_SOURCE_LINE 00002036 "        # when batch fetching with $max_rows were very likely to try to"
NSQ_SOURCE_LINE 00002037 "        # fetch the 'next batch' after the previous batch returned"
NSQ_SOURCE_LINE 00002038 "        # <=$max_rows. So don't treat that as an error."
NSQ_SOURCE_LINE 00002039 "        return undef if $max_rows and not $sth->FETCH('Active');"
NSQ_SOURCE_LINE 00002040 ""
NSQ_SOURCE_LINE 00002041 "\tmy $mode = ref($slice) || 'ARRAY';"
NSQ_SOURCE_LINE 00002042 "\tmy @rows;"
NSQ_SOURCE_LINE 00002043 ""
NSQ_SOURCE_LINE 00002044 "\tif ($mode eq 'ARRAY') {"
NSQ_SOURCE_LINE 00002045 "\t    my $row;"
NSQ_SOURCE_LINE 00002046 "\t    # we copy the array here because fetch (currently) always"
NSQ_SOURCE_LINE 00002047 "\t    # returns the same array ref. XXX"
NSQ_SOURCE_LINE 00002048 "\t    if ($slice && @$slice) {"
NSQ_SOURCE_LINE 00002049 "                $max_rows = -1 unless defined $max_rows;"
NSQ_SOURCE_LINE 00002050 "\t\tpush @rows, [ @{$row}[ @$slice] ]"
NSQ_SOURCE_LINE 00002051 "\t\t    while($max_rows-- and $row = $sth->fetch);"
NSQ_SOURCE_LINE 00002052 "\t    }"
NSQ_SOURCE_LINE 00002053 "\t    elsif (defined $max_rows) {"
NSQ_SOURCE_LINE 00002054 "\t\tpush @rows, [ @$row ]"
NSQ_SOURCE_LINE 00002055 "\t\t    while($max_rows-- and $row = $sth->fetch);"
NSQ_SOURCE_LINE 00002056 "\t    }"
NSQ_SOURCE_LINE 00002057 "\t    else {"
NSQ_SOURCE_LINE 00002058 "\t\tpush @rows, [ @$row ] while($row = $sth->fetch);"
NSQ_SOURCE_LINE 00002059 "\t    }"
NSQ_SOURCE_LINE 00002060 "\t    return \\@rows"
NSQ_SOURCE_LINE 00002061 "\t}"
NSQ_SOURCE_LINE 00002062 ""
NSQ_SOURCE_LINE 00002063 "\tmy %row;"
NSQ_SOURCE_LINE 00002064 "\tif ($mode eq 'REF' && ref($$slice) eq 'HASH') { # \\{ $idx => $name }"
NSQ_SOURCE_LINE 00002065 "            keys %$$slice; # reset the iterator"
NSQ_SOURCE_LINE 00002066 "            while ( my ($idx, $name) = each %$$slice ) {"
NSQ_SOURCE_LINE 00002067 "                $sth->bind_col($idx+1, \\$row{$name});"
NSQ_SOURCE_LINE 00002068 "            }"
NSQ_SOURCE_LINE 00002069 "\t}"
NSQ_SOURCE_LINE 00002070 "\telsif ($mode eq 'HASH') {"
NSQ_SOURCE_LINE 00002071 "            if (keys %$slice) { # resets the iterator"
NSQ_SOURCE_LINE 00002072 "                my $name2idx = $sth->FETCH('NAME_lc_hash');"
NSQ_SOURCE_LINE 00002073 "                while ( my ($name, $unused) = each %$slice ) {"
NSQ_SOURCE_LINE 00002074 "                    my $idx = $name2idx->{lc $name};"
NSQ_SOURCE_LINE 00002075 "                    return $sth->set_err($DBI::stderr, \"Invalid column name '$name' for slice\")"
NSQ_SOURCE_LINE 00002076 "                        if not defined $idx;"
NSQ_SOURCE_LINE 00002077 "                    $sth->bind_col($idx+1, \\$row{$name});"
NSQ_SOURCE_LINE 00002078 "                }"
NSQ_SOURCE_LINE 00002079 "\t    }"
NSQ_SOURCE_LINE 00002080 "\t    else {"
NSQ_SOURCE_LINE 00002081 "\t\tmy @column_names = @{ $sth->FETCH($sth->FETCH('FetchHashKeyName')) || [] };"
NSQ_SOURCE_LINE 00002082 "\t\treturn [] if !@column_names;"
NSQ_SOURCE_LINE 00002083 ""
NSQ_SOURCE_LINE 00002084 "\t\t$sth->bind_columns( \\( @row{@column_names} ) );"
NSQ_SOURCE_LINE 00002085 "\t    }"
NSQ_SOURCE_LINE 00002086 "\t}"
NSQ_SOURCE_LINE 00002087 "\telse {"
NSQ_SOURCE_LINE 00002088 "            return $sth->set_err($DBI::stderr, \"fetchall_arrayref($mode) invalid\");"
NSQ_SOURCE_LINE 00002089 "        }"
NSQ_SOURCE_LINE 00002090 ""
NSQ_SOURCE_LINE 00002091 "        if (not defined $max_rows) {"
NSQ_SOURCE_LINE 00002092 "            push @rows, { %row } while ($sth->fetch); # full speed ahead!"
NSQ_SOURCE_LINE 00002093 "        }"
NSQ_SOURCE_LINE 00002094 "        else {"
NSQ_SOURCE_LINE 00002095 "            push @rows, { %row } while ($max_rows-- and $sth->fetch);"
NSQ_SOURCE_LINE 00002096 "        }"
NSQ_SOURCE_LINE 00002097 ""
NSQ_SOURCE_LINE 00002098 "\treturn \\@rows;"
NSQ_SOURCE_LINE 00002099 "    }"
NSQ_SOURCE_LINE 00002100 ""
NSQ_SOURCE_LINE 00002101 "    sub fetchall_hashref {"
NSQ_SOURCE_LINE 00002102 "\tmy ($sth, $key_field) = @_;"
NSQ_SOURCE_LINE 00002103 ""
NSQ_SOURCE_LINE 00002104 "        my $hash_key_name = $sth->{FetchHashKeyName} || 'NAME';"
NSQ_SOURCE_LINE 00002105 "        my $names_hash = $sth->FETCH(\"${hash_key_name}_hash\");"
NSQ_SOURCE_LINE 00002106 "        my @key_fields = (ref $key_field) ? @$key_field : ($key_field);"
NSQ_SOURCE_LINE 00002107 "        my @key_indexes;"
NSQ_SOURCE_LINE 00002108 "        my $num_of_fields = $sth->FETCH('NUM_OF_FIELDS');"
NSQ_SOURCE_LINE 00002109 "        foreach (@key_fields) {"
NSQ_SOURCE_LINE 00002110 "           my $index = $names_hash->{$_};  # perl index not column"
NSQ_SOURCE_LINE 00002111 "           $index = $_ - 1 if !defined $index && DBI::looks_like_number($_) && $_>=1 && $_ <= $num_of_fields;"
NSQ_SOURCE_LINE 00002112 "           return $sth->set_err($DBI::stderr, \"Field '$_' does not exist (not one of @{[keys %$names_hash]})\")"
NSQ_SOURCE_LINE 00002113 "                unless defined $index;"
NSQ_SOURCE_LINE 00002114 "           push @key_indexes, $index;"
NSQ_SOURCE_LINE 00002115 "        }"
NSQ_SOURCE_LINE 00002116 "        my $rows = {};"
NSQ_SOURCE_LINE 00002117 "        my $NAME = $sth->FETCH($hash_key_name);"
NSQ_SOURCE_LINE 00002118 "        my @row = (undef) x $num_of_fields;"
NSQ_SOURCE_LINE 00002119 "        $sth->bind_columns(\\(@row));"
NSQ_SOURCE_LINE 00002120 "        while ($sth->fetch) {"
NSQ_SOURCE_LINE 00002121 "            my $ref = $rows;"
NSQ_SOURCE_LINE 00002122 "            $ref = $ref->{$row[$_]} ||= {} for @key_indexes;"
NSQ_SOURCE_LINE 00002123 "            @{$ref}{@$NAME} = @row;"
NSQ_SOURCE_LINE 00002124 "        }"
NSQ_SOURCE_LINE 00002125 "        return $rows;"
NSQ_SOURCE_LINE 00002126 "    }"
NSQ_SOURCE_LINE 00002127 ""
NSQ_SOURCE_LINE 00002128 "    *dump_results = \\&DBI::dump_results;"
NSQ_SOURCE_LINE 00002129 ""
NSQ_SOURCE_LINE 00002130 "    sub blob_copy_to_file {\t# returns length or undef on error"
NSQ_SOURCE_LINE 00002131 "\tmy($self, $field, $filename_or_handleref, $blocksize) = @_;"
NSQ_SOURCE_LINE 00002132 "\tmy $fh = $filename_or_handleref;"
NSQ_SOURCE_LINE 00002133 "\tmy($len, $buf) = (0, \"\");"
NSQ_SOURCE_LINE 00002134 "\t$blocksize ||= 512;\t# not too ambitious"
NSQ_SOURCE_LINE 00002135 "\tlocal(*FH);"
NSQ_SOURCE_LINE 00002136 "\tunless(ref $fh) {"
NSQ_SOURCE_LINE 00002137 "\t    open(FH, \">$fh\") || return undef;"
NSQ_SOURCE_LINE 00002138 "\t    $fh = \\*FH;"
NSQ_SOURCE_LINE 00002139 "\t}"
NSQ_SOURCE_LINE 00002140 "\twhile(defined($self->blob_read($field, $len, $blocksize, \\$buf))) {"
NSQ_SOURCE_LINE 00002141 "\t    print $fh $buf;"
NSQ_SOURCE_LINE 00002142 "\t    $len += length $buf;"
NSQ_SOURCE_LINE 00002143 "\t}"
NSQ_SOURCE_LINE 00002144 "\tclose(FH);"
NSQ_SOURCE_LINE 00002145 "\t$len;"
NSQ_SOURCE_LINE 00002146 "    }"
NSQ_SOURCE_LINE 00002147 ""
NSQ_SOURCE_LINE 00002148 "    sub more_results {"
NSQ_SOURCE_LINE 00002149 "\tshift->{syb_more_results};\t# handy grandfathering"
NSQ_SOURCE_LINE 00002150 "    }"
NSQ_SOURCE_LINE 00002151 ""
NSQ_SOURCE_LINE 00002152 "}"
NSQ_SOURCE_LINE 00002153 ""
NSQ_SOURCE_LINE 00002154 "unless ($DBI::PurePerl) {   # See install_driver"
NSQ_SOURCE_LINE 00002155 "    { @DBD::_mem::dr::ISA = qw(DBD::_mem::common);\t}"
NSQ_SOURCE_LINE 00002156 "    { @DBD::_mem::db::ISA = qw(DBD::_mem::common);\t}"
NSQ_SOURCE_LINE 00002157 "    { @DBD::_mem::st::ISA = qw(DBD::_mem::common);\t}"
NSQ_SOURCE_LINE 00002158 "    # DBD::_mem::common::DESTROY is implemented in DBI.xs"
NSQ_SOURCE_LINE 00002159 "}"
NSQ_SOURCE_LINE 00002160 ""
NSQ_SOURCE_LINE 00002161 "1;"
NSQ_SOURCE_LINE 00002162 "__END__"
NSQ_SOURCE_LINE 00002163 ""
NSQ_SOURCE_LINE 00002164 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00002165 ""
NSQ_SOURCE_LINE 00002166 "The DBI is a database access module for the Perl programming language.  It defines"
NSQ_SOURCE_LINE 00002167 "a set of methods, variables, and conventions that provide a consistent"
NSQ_SOURCE_LINE 00002168 "database interface, independent of the actual database being used."
NSQ_SOURCE_LINE 00002169 ""
NSQ_SOURCE_LINE 00002170 "It is important to remember that the DBI is just an interface."
NSQ_SOURCE_LINE 00002171 "The DBI is a layer"
NSQ_SOURCE_LINE 00002172 "of \"glue\" between an application and one or more database I<driver>"
NSQ_SOURCE_LINE 00002173 "modules.  It is the driver modules which do most of the real work. The DBI"
NSQ_SOURCE_LINE 00002174 "provides a standard interface and framework for the drivers to operate"
NSQ_SOURCE_LINE 00002175 "within."
NSQ_SOURCE_LINE 00002176 ""
NSQ_SOURCE_LINE 00002177 "This document often uses terms like I<references>, I<objects>,"
NSQ_SOURCE_LINE 00002178 "I<methods>.  If you're not familiar with those terms then it would"
NSQ_SOURCE_LINE 00002179 "be a good idea to read at least the following perl manuals first:"
NSQ_SOURCE_LINE 00002180 "L<perlreftut>, L<perldsc>, L<perllol>, and L<perlboot>."
NSQ_SOURCE_LINE 00002181 ""
NSQ_SOURCE_LINE 00002182 ""
NSQ_SOURCE_LINE 00002183 "=head2 Architecture of a DBI Application"
NSQ_SOURCE_LINE 00002184 ""
NSQ_SOURCE_LINE 00002185 "             |<- Scope of DBI ->|"
NSQ_SOURCE_LINE 00002186 "                  .-.   .--------------.   .-------------."
NSQ_SOURCE_LINE 00002187 "  .-------.       | |---| XYZ Driver   |---| XYZ Engine  |"
NSQ_SOURCE_LINE 00002188 "  | Perl  |       | |   `--------------'   `-------------'"
NSQ_SOURCE_LINE 00002189 "  | script|  |A|  |D|   .--------------.   .-------------."
NSQ_SOURCE_LINE 00002190 "  | using |--|P|--|B|---|Oracle Driver |---|Oracle Engine|"
NSQ_SOURCE_LINE 00002191 "  | DBI   |  |I|  |I|   `--------------'   `-------------'"
NSQ_SOURCE_LINE 00002192 "  | API   |       | |..."
NSQ_SOURCE_LINE 00002193 "  |methods|       | |... Other drivers"
NSQ_SOURCE_LINE 00002194 "  `-------'       | |..."
NSQ_SOURCE_LINE 00002195 "                  `-'"
NSQ_SOURCE_LINE 00002196 ""
NSQ_SOURCE_LINE 00002197 "The API, or Application Programming Interface, defines the"
NSQ_SOURCE_LINE 00002198 "call interface and variables for Perl scripts to use. The API"
NSQ_SOURCE_LINE 00002199 "is implemented by the Perl DBI extension."
NSQ_SOURCE_LINE 00002200 ""
NSQ_SOURCE_LINE 00002201 "The DBI \"dispatches\" the method calls to the appropriate driver for"
NSQ_SOURCE_LINE 00002202 "actual execution.  The DBI is also responsible for the dynamic loading"
NSQ_SOURCE_LINE 00002203 "of drivers, error checking and handling, providing default"
NSQ_SOURCE_LINE 00002204 "implementations for methods, and many other non-database specific duties."
NSQ_SOURCE_LINE 00002205 ""
NSQ_SOURCE_LINE 00002206 "Each driver"
NSQ_SOURCE_LINE 00002207 "contains implementations of the DBI methods using the"
NSQ_SOURCE_LINE 00002208 "private interface functions of the corresponding database engine.  Only authors"
NSQ_SOURCE_LINE 00002209 "of sophisticated/multi-database applications or generic library"
NSQ_SOURCE_LINE 00002210 "functions need be concerned with drivers."
NSQ_SOURCE_LINE 00002211 ""
NSQ_SOURCE_LINE 00002212 "=head2 Notation and Conventions"
NSQ_SOURCE_LINE 00002213 ""
NSQ_SOURCE_LINE 00002214 "The following conventions are used in this document:"
NSQ_SOURCE_LINE 00002215 ""
NSQ_SOURCE_LINE 00002216 "  $dbh    Database handle object"
NSQ_SOURCE_LINE 00002217 "  $sth    Statement handle object"
NSQ_SOURCE_LINE 00002218 "  $drh    Driver handle object (rarely seen or used in applications)"
NSQ_SOURCE_LINE 00002219 "  $h      Any of the handle types above ($dbh, $sth, or $drh)"
NSQ_SOURCE_LINE 00002220 "  $rc     General Return Code  (boolean: true=ok, false=error)"
NSQ_SOURCE_LINE 00002221 "  $rv     General Return Value (typically an integer)"
NSQ_SOURCE_LINE 00002222 "  @ary    List of values returned from the database, typically a row of data"
NSQ_SOURCE_LINE 00002223 "  $rows   Number of rows processed (if available, else -1)"
NSQ_SOURCE_LINE 00002224 "  $fh     A filehandle"
NSQ_SOURCE_LINE 00002225 "  undef   NULL values are represented by undefined values in Perl"
NSQ_SOURCE_LINE 00002226 "  \\%attr  Reference to a hash of attribute values passed to methods"
NSQ_SOURCE_LINE 00002227 ""
NSQ_SOURCE_LINE 00002228 "Note that Perl will automatically destroy database and statement handle objects"
NSQ_SOURCE_LINE 00002229 "if all references to them are deleted."
NSQ_SOURCE_LINE 00002230 ""
NSQ_SOURCE_LINE 00002231 ""
NSQ_SOURCE_LINE 00002232 "=head2 Outline Usage"
NSQ_SOURCE_LINE 00002233 ""
NSQ_SOURCE_LINE 00002234 "To use DBI,"
NSQ_SOURCE_LINE 00002235 "first you need to load the DBI module:"
NSQ_SOURCE_LINE 00002236 ""
NSQ_SOURCE_LINE 00002237 "  use DBI;"
NSQ_SOURCE_LINE 00002238 "  use strict;"
NSQ_SOURCE_LINE 00002239 ""
NSQ_SOURCE_LINE 00002240 "(The C<use strict;> isn't required but is strongly recommended.)"
NSQ_SOURCE_LINE 00002241 ""
NSQ_SOURCE_LINE 00002242 "Then you need to L</connect> to your data source and get a I<handle> for that"
NSQ_SOURCE_LINE 00002243 "connection:"
NSQ_SOURCE_LINE 00002244 ""
NSQ_SOURCE_LINE 00002245 "  $dbh = DBI->connect($dsn, $user, $password,"
NSQ_SOURCE_LINE 00002246 "                      { RaiseError => 1, AutoCommit => 0 });"
NSQ_SOURCE_LINE 00002247 ""
NSQ_SOURCE_LINE 00002248 "Since connecting can be expensive, you generally just connect at the"
NSQ_SOURCE_LINE 00002249 "start of your program and disconnect at the end."
NSQ_SOURCE_LINE 00002250 ""
NSQ_SOURCE_LINE 00002251 "Explicitly defining the required C<AutoCommit> behaviour is strongly"
NSQ_SOURCE_LINE 00002252 "recommended and may become mandatory in a later version.  This"
NSQ_SOURCE_LINE 00002253 "determines whether changes are automatically committed to the"
NSQ_SOURCE_LINE 00002254 "database when executed, or need to be explicitly committed later."
NSQ_SOURCE_LINE 00002255 ""
NSQ_SOURCE_LINE 00002256 "The DBI allows an application to \"prepare\" statements for later"
NSQ_SOURCE_LINE 00002257 "execution.  A prepared statement is identified by a statement handle"
NSQ_SOURCE_LINE 00002258 "held in a Perl variable."
NSQ_SOURCE_LINE 00002259 "We'll call the Perl variable C<$sth> in our examples."
NSQ_SOURCE_LINE 00002260 ""
NSQ_SOURCE_LINE 00002261 "The typical method call sequence for a C<SELECT> statement is:"
NSQ_SOURCE_LINE 00002262 ""
NSQ_SOURCE_LINE 00002263 "  prepare,"
NSQ_SOURCE_LINE 00002264 "    execute, fetch, fetch, ..."
NSQ_SOURCE_LINE 00002265 "    execute, fetch, fetch, ..."
NSQ_SOURCE_LINE 00002266 "    execute, fetch, fetch, ..."
NSQ_SOURCE_LINE 00002267 ""
NSQ_SOURCE_LINE 00002268 "for example:"
NSQ_SOURCE_LINE 00002269 ""
NSQ_SOURCE_LINE 00002270 "  $sth = $dbh->prepare(\"SELECT foo, bar FROM table WHERE baz=?\");"
NSQ_SOURCE_LINE 00002271 ""
NSQ_SOURCE_LINE 00002272 "  $sth->execute( $baz );"
NSQ_SOURCE_LINE 00002273 ""
NSQ_SOURCE_LINE 00002274 "  while ( @row = $sth->fetchrow_array ) {"
NSQ_SOURCE_LINE 00002275 "    print \"@row\\n\";"
NSQ_SOURCE_LINE 00002276 "  }"
NSQ_SOURCE_LINE 00002277 ""
NSQ_SOURCE_LINE 00002278 "For queries that are not executed many times at once, it is often cleaner"
NSQ_SOURCE_LINE 00002279 "to use the higher level select wrappers:"
NSQ_SOURCE_LINE 00002280 ""
NSQ_SOURCE_LINE 00002281 "  $row_hashref = $dbh->selectrow_hashref(\"SELECT foo, bar FROM table WHERE baz=?\", undef, $baz);"
NSQ_SOURCE_LINE 00002282 ""
NSQ_SOURCE_LINE 00002283 "  $arrayref_of_row_hashrefs = $dbh->selectall_arrayref("
NSQ_SOURCE_LINE 00002284 "    \"SELECT foo, bar FROM table WHERE baz BETWEEN ? AND ?\","
NSQ_SOURCE_LINE 00002285 "    { Slice => {} }, $baz_min, $baz_max);"
NSQ_SOURCE_LINE 00002286 ""
NSQ_SOURCE_LINE 00002287 "The typical method call sequence for a I<non>-C<SELECT> statement is:"
NSQ_SOURCE_LINE 00002288 ""
NSQ_SOURCE_LINE 00002289 "  prepare,"
NSQ_SOURCE_LINE 00002290 "    execute,"
NSQ_SOURCE_LINE 00002291 "    execute,"
NSQ_SOURCE_LINE 00002292 "    execute."
NSQ_SOURCE_LINE 00002293 ""
NSQ_SOURCE_LINE 00002294 "for example:"
NSQ_SOURCE_LINE 00002295 ""
NSQ_SOURCE_LINE 00002296 "  $sth = $dbh->prepare(\"INSERT INTO table(foo,bar,baz) VALUES (?,?,?)\");"
NSQ_SOURCE_LINE 00002297 ""
NSQ_SOURCE_LINE 00002298 "  while(<CSV>) {"
NSQ_SOURCE_LINE 00002299 "    chomp;"
NSQ_SOURCE_LINE 00002300 "    my ($foo,$bar,$baz) = split /,/;"
NSQ_SOURCE_LINE 00002301 "\t$sth->execute( $foo, $bar, $baz );"
NSQ_SOURCE_LINE 00002302 "  }"
NSQ_SOURCE_LINE 00002303 ""
NSQ_SOURCE_LINE 00002304 "The C<do()> method is a wrapper of prepare and execute that can be simpler"
NSQ_SOURCE_LINE 00002305 "for non repeated I<non>-C<SELECT> statements (or with drivers that don't"
NSQ_SOURCE_LINE 00002306 "support placeholders):"
NSQ_SOURCE_LINE 00002307 ""
NSQ_SOURCE_LINE 00002308 "  $rows_affected = $dbh->do(\"UPDATE your_table SET foo = foo + 1\");"
NSQ_SOURCE_LINE 00002309 ""
NSQ_SOURCE_LINE 00002310 "  $rows_affected = $dbh->do(\"DELETE FROM table WHERE foo = ?\", undef, $foo);"
NSQ_SOURCE_LINE 00002311 ""
NSQ_SOURCE_LINE 00002312 "To commit your changes to the database (when L</AutoCommit> is off):"
NSQ_SOURCE_LINE 00002313 ""
NSQ_SOURCE_LINE 00002314 "  $dbh->commit;  # or call $dbh->rollback; to undo changes"
NSQ_SOURCE_LINE 00002315 ""
NSQ_SOURCE_LINE 00002316 "Finally, when you have finished working with the data source, you should"
NSQ_SOURCE_LINE 00002317 "L</disconnect> from it:"
NSQ_SOURCE_LINE 00002318 ""
NSQ_SOURCE_LINE 00002319 "  $dbh->disconnect;"
NSQ_SOURCE_LINE 00002320 ""
NSQ_SOURCE_LINE 00002321 ""
NSQ_SOURCE_LINE 00002322 "=head2 General Interface Rules & Caveats"
NSQ_SOURCE_LINE 00002323 ""
NSQ_SOURCE_LINE 00002324 "The DBI does not have a concept of a \"current session\". Every session"
NSQ_SOURCE_LINE 00002325 "has a handle object (i.e., a C<$dbh>) returned from the C<connect> method."
NSQ_SOURCE_LINE 00002326 "That handle object is used to invoke database related methods."
NSQ_SOURCE_LINE 00002327 ""
NSQ_SOURCE_LINE 00002328 "Most data is returned to the Perl script as strings. (Null values are"
NSQ_SOURCE_LINE 00002329 "returned as C<undef>.)  This allows arbitrary precision numeric data to be"
NSQ_SOURCE_LINE 00002330 "handled without loss of accuracy.  Beware that Perl may not preserve"
NSQ_SOURCE_LINE 00002331 "the same accuracy when the string is used as a number."
NSQ_SOURCE_LINE 00002332 ""
NSQ_SOURCE_LINE 00002333 "Dates and times are returned as character strings in the current"
NSQ_SOURCE_LINE 00002334 "default format of the corresponding database engine.  Time zone effects"
NSQ_SOURCE_LINE 00002335 "are database/driver dependent."
NSQ_SOURCE_LINE 00002336 ""
NSQ_SOURCE_LINE 00002337 "Perl supports binary data in Perl strings, and the DBI will pass binary"
NSQ_SOURCE_LINE 00002338 "data to and from the driver without change. It is up to the driver"
NSQ_SOURCE_LINE 00002339 "implementors to decide how they wish to handle such binary data."
NSQ_SOURCE_LINE 00002340 ""
NSQ_SOURCE_LINE 00002341 "Perl supports two kinds of strings: Unicode (utf8 internally) and non-Unicode"
NSQ_SOURCE_LINE 00002342 "(defaults to iso-8859-1 if forced to assume an encoding).  Drivers should"
NSQ_SOURCE_LINE 00002343 "accept both kinds of strings and, if required, convert them to the character"
NSQ_SOURCE_LINE 00002344 "set of the database being used. Similarly, when fetching from the database"
NSQ_SOURCE_LINE 00002345 "character data that isn't iso-8859-1 the driver should convert it into utf8."
NSQ_SOURCE_LINE 00002346 ""
NSQ_SOURCE_LINE 00002347 "Multiple SQL statements may not be combined in a single statement"
NSQ_SOURCE_LINE 00002348 "handle (C<$sth>), although some databases and drivers do support this"
NSQ_SOURCE_LINE 00002349 "(notably Sybase and SQL Server)."
NSQ_SOURCE_LINE 00002350 ""
NSQ_SOURCE_LINE 00002351 "Non-sequential record reads are not supported in this version of the DBI."
NSQ_SOURCE_LINE 00002352 "In other words, records can only be fetched in the order that the"
NSQ_SOURCE_LINE 00002353 "database returned them, and once fetched they are forgotten."
NSQ_SOURCE_LINE 00002354 ""
NSQ_SOURCE_LINE 00002355 "Positioned updates and deletes are not directly supported by the DBI."
NSQ_SOURCE_LINE 00002356 "See the description of the C<CursorName> attribute for an alternative."
NSQ_SOURCE_LINE 00002357 ""
NSQ_SOURCE_LINE 00002358 "Individual driver implementors are free to provide any private"
NSQ_SOURCE_LINE 00002359 "functions and/or handle attributes that they feel are useful."
NSQ_SOURCE_LINE 00002360 "Private driver functions can be invoked using the DBI C<func()> method."
NSQ_SOURCE_LINE 00002361 "Private driver attributes are accessed just like standard attributes."
NSQ_SOURCE_LINE 00002362 ""
NSQ_SOURCE_LINE 00002363 "Many methods have an optional C<\\%attr> parameter which can be used to"
NSQ_SOURCE_LINE 00002364 "pass information to the driver implementing the method. Except where"
NSQ_SOURCE_LINE 00002365 "specifically documented, the C<\\%attr> parameter can only be used to pass"
NSQ_SOURCE_LINE 00002366 "driver specific hints. In general, you can ignore C<\\%attr> parameters"
NSQ_SOURCE_LINE 00002367 "or pass it as C<undef>."
NSQ_SOURCE_LINE 00002368 ""
NSQ_SOURCE_LINE 00002369 ""
NSQ_SOURCE_LINE 00002370 "=head2 Naming Conventions and Name Space"
NSQ_SOURCE_LINE 00002371 ""
NSQ_SOURCE_LINE 00002372 "The DBI package and all packages below it (C<DBI::*>) are reserved for"
NSQ_SOURCE_LINE 00002373 "use by the DBI. Extensions and related modules use the C<DBIx::>"
NSQ_SOURCE_LINE 00002374 "namespace (see L<http://www.perl.com/CPAN/modules/by-module/DBIx/>)."
NSQ_SOURCE_LINE 00002375 "Package names beginning with C<DBD::> are reserved for use"
NSQ_SOURCE_LINE 00002376 "by DBI database drivers.  All environment variables used by the DBI"
NSQ_SOURCE_LINE 00002377 "or by individual DBDs begin with \"C<DBI_>\" or \"C<DBD_>\"."
NSQ_SOURCE_LINE 00002378 ""
NSQ_SOURCE_LINE 00002379 "The letter case used for attribute names is significant and plays an"
NSQ_SOURCE_LINE 00002380 "important part in the portability of DBI scripts.  The case of the"
NSQ_SOURCE_LINE 00002381 "attribute name is used to signify who defined the meaning of that name"
NSQ_SOURCE_LINE 00002382 "and its values."
NSQ_SOURCE_LINE 00002383 ""
NSQ_SOURCE_LINE 00002384 "  Case of name  Has a meaning defined by"
NSQ_SOURCE_LINE 00002385 "  ------------  ------------------------"
NSQ_SOURCE_LINE 00002386 "  UPPER_CASE    Standards, e.g.,  X/Open, ISO SQL92 etc (portable)"
NSQ_SOURCE_LINE 00002387 "  MixedCase     DBI API (portable), underscores are not used."
NSQ_SOURCE_LINE 00002388 "  lower_case    Driver or database engine specific (non-portable)"
NSQ_SOURCE_LINE 00002389 ""
NSQ_SOURCE_LINE 00002390 "It is of the utmost importance that Driver developers only use"
NSQ_SOURCE_LINE 00002391 "lowercase attribute names when defining private attributes. Private"
NSQ_SOURCE_LINE 00002392 "attribute names must be prefixed with the driver name or suitable"
NSQ_SOURCE_LINE 00002393 "abbreviation (e.g., \"C<ora_>\" for Oracle, \"C<ing_>\" for Ingres, etc)."
NSQ_SOURCE_LINE 00002394 ""
NSQ_SOURCE_LINE 00002395 ""
NSQ_SOURCE_LINE 00002396 "=head2 SQL - A Query Language"
NSQ_SOURCE_LINE 00002397 ""
NSQ_SOURCE_LINE 00002398 "Most DBI drivers require applications to use a dialect of SQL"
NSQ_SOURCE_LINE 00002399 "(Structured Query Language) to interact with the database engine."
NSQ_SOURCE_LINE 00002400 "The L</\"Standards Reference Information\"> section provides links"
NSQ_SOURCE_LINE 00002401 "to useful information about SQL."
NSQ_SOURCE_LINE 00002402 ""
NSQ_SOURCE_LINE 00002403 "The DBI itself does not mandate or require any particular language to"
NSQ_SOURCE_LINE 00002404 "be used; it is language independent. In ODBC terms, the DBI is in"
NSQ_SOURCE_LINE 00002405 "\"pass-thru\" mode, although individual drivers might not be. The only requirement"
NSQ_SOURCE_LINE 00002406 "is that queries and other statements must be expressed as a single"
NSQ_SOURCE_LINE 00002407 "string of characters passed as the first argument to the L</prepare> or"
NSQ_SOURCE_LINE 00002408 "L</do> methods."
NSQ_SOURCE_LINE 00002409 ""
NSQ_SOURCE_LINE 00002410 "For an interesting diversion on the I<real> history of RDBMS and SQL,"
NSQ_SOURCE_LINE 00002411 "from the people who made it happen, see:"
NSQ_SOURCE_LINE 00002412 ""
NSQ_SOURCE_LINE 00002413 "  http://www.mcjones.org/System_R/SQL_Reunion_95/sqlr95.html"
NSQ_SOURCE_LINE 00002414 ""
NSQ_SOURCE_LINE 00002415 "Follow the \"Full Contents\" then \"Intergalactic dataspeak\" links for the"
NSQ_SOURCE_LINE 00002416 "SQL history."
NSQ_SOURCE_LINE 00002417 ""
NSQ_SOURCE_LINE 00002418 "=head2 Placeholders and Bind Values"
NSQ_SOURCE_LINE 00002419 ""
NSQ_SOURCE_LINE 00002420 "Some drivers support placeholders and bind values."
NSQ_SOURCE_LINE 00002421 "I<Placeholders>, also called parameter markers, are used to indicate"
NSQ_SOURCE_LINE 00002422 "values in a database statement that will be supplied later,"
NSQ_SOURCE_LINE 00002423 "before the prepared statement is executed.  For example, an application"
NSQ_SOURCE_LINE 00002424 "might use the following to insert a row of data into the SALES table:"
NSQ_SOURCE_LINE 00002425 ""
NSQ_SOURCE_LINE 00002426 "  INSERT INTO sales (product_code, qty, price) VALUES (?, ?, ?)"
NSQ_SOURCE_LINE 00002427 ""
NSQ_SOURCE_LINE 00002428 "or the following, to select the description for a product:"
NSQ_SOURCE_LINE 00002429 ""
NSQ_SOURCE_LINE 00002430 "  SELECT description FROM products WHERE product_code = ?"
NSQ_SOURCE_LINE 00002431 ""
NSQ_SOURCE_LINE 00002432 "The C<?> characters are the placeholders.  The association of actual"
NSQ_SOURCE_LINE 00002433 "values with placeholders is known as I<binding>, and the values are"
NSQ_SOURCE_LINE 00002434 "referred to as I<bind values>."
NSQ_SOURCE_LINE 00002435 "Note that the C<?> is not enclosed in quotation marks, even when the"
NSQ_SOURCE_LINE 00002436 "placeholder represents a string."
NSQ_SOURCE_LINE 00002437 ""
NSQ_SOURCE_LINE 00002438 "Some drivers also allow placeholders like C<:>I<name> and C<:>I<N> (e.g.,"
NSQ_SOURCE_LINE 00002439 "C<:1>, C<:2>, and so on) in addition to C<?>, but their use is not portable."
NSQ_SOURCE_LINE 00002440 ""
NSQ_SOURCE_LINE 00002441 "If the C<:>I<N> form of placeholder is supported by the driver you're using,"
NSQ_SOURCE_LINE 00002442 "then you should be able to use either L</bind_param> or L</execute> to bind"
NSQ_SOURCE_LINE 00002443 "values. Check your driver documentation."
NSQ_SOURCE_LINE 00002444 ""
NSQ_SOURCE_LINE 00002445 "Some drivers allow you to prevent the recognition of a placeholder by placing a"
NSQ_SOURCE_LINE 00002446 "single backslash character (C<\\>) immediately before it. The driver will remove"
NSQ_SOURCE_LINE 00002447 "the backslash character and ignore the placeholder, passing it unchanged to the"
NSQ_SOURCE_LINE 00002448 "backend. If the driver supports this then L</get_info>(9000) will return true."
NSQ_SOURCE_LINE 00002449 ""
NSQ_SOURCE_LINE 00002450 "With most drivers, placeholders can't be used for any element of a"
NSQ_SOURCE_LINE 00002451 "statement that would prevent the database server from validating the"
NSQ_SOURCE_LINE 00002452 "statement and creating a query execution plan for it. For example:"
NSQ_SOURCE_LINE 00002453 ""
NSQ_SOURCE_LINE 00002454 "  \"SELECT name, age FROM ?\"         # wrong (will probably fail)"
NSQ_SOURCE_LINE 00002455 "  \"SELECT name, ?   FROM people\"    # wrong (but may not 'fail')"
NSQ_SOURCE_LINE 00002456 ""
NSQ_SOURCE_LINE 00002457 "Also, placeholders can only represent single scalar values."
NSQ_SOURCE_LINE 00002458 "For example, the following"
NSQ_SOURCE_LINE 00002459 "statement won't work as expected for more than one value:"
NSQ_SOURCE_LINE 00002460 ""
NSQ_SOURCE_LINE 00002461 "  \"SELECT name, age FROM people WHERE name IN (?)\"    # wrong"
NSQ_SOURCE_LINE 00002462 "  \"SELECT name, age FROM people WHERE name IN (?,?)\"  # two names"
NSQ_SOURCE_LINE 00002463 ""
NSQ_SOURCE_LINE 00002464 "When using placeholders with the SQL C<LIKE> qualifier, you must"
NSQ_SOURCE_LINE 00002465 "remember that the placeholder substitutes for the whole string."
NSQ_SOURCE_LINE 00002466 "So you should use \"C<... LIKE ? ...>\" and include any wildcard"
NSQ_SOURCE_LINE 00002467 "characters in the value that you bind to the placeholder."
NSQ_SOURCE_LINE 00002468 ""
NSQ_SOURCE_LINE 00002469 "B<NULL Values>"
NSQ_SOURCE_LINE 00002470 ""
NSQ_SOURCE_LINE 00002471 "Undefined values, or C<undef>, are used to indicate NULL values."
NSQ_SOURCE_LINE 00002472 "You can insert and update columns with a NULL value as you would a"
NSQ_SOURCE_LINE 00002473 "non-NULL value.  These examples insert and update the column"
NSQ_SOURCE_LINE 00002474 "C<age> with a NULL value:"
NSQ_SOURCE_LINE 00002475 ""
NSQ_SOURCE_LINE 00002476 "  $sth = $dbh->prepare(qq{"
NSQ_SOURCE_LINE 00002477 "    INSERT INTO people (fullname, age) VALUES (?, ?)"
NSQ_SOURCE_LINE 00002478 "  });"
NSQ_SOURCE_LINE 00002479 "  $sth->execute(\"Joe Bloggs\", undef);"
NSQ_SOURCE_LINE 00002480 ""
NSQ_SOURCE_LINE 00002481 "  $sth = $dbh->prepare(qq{"
NSQ_SOURCE_LINE 00002482 "    UPDATE people SET age = ? WHERE fullname = ?"
NSQ_SOURCE_LINE 00002483 "  });"
NSQ_SOURCE_LINE 00002484 "  $sth->execute(undef, \"Joe Bloggs\");"
NSQ_SOURCE_LINE 00002485 ""
NSQ_SOURCE_LINE 00002486 "However, care must be taken when trying to use NULL values in a"
NSQ_SOURCE_LINE 00002487 "C<WHERE> clause.  Consider:"
NSQ_SOURCE_LINE 00002488 ""
NSQ_SOURCE_LINE 00002489 "  SELECT fullname FROM people WHERE age = ?"
NSQ_SOURCE_LINE 00002490 ""
NSQ_SOURCE_LINE 00002491 "Binding an C<undef> (NULL) to the placeholder will I<not> select rows"
NSQ_SOURCE_LINE 00002492 "which have a NULL C<age>!  At least for database engines that"
NSQ_SOURCE_LINE 00002493 "conform to the SQL standard.  Refer to the SQL manual for your database"
NSQ_SOURCE_LINE 00002494 "engine or any SQL book for the reasons for this.  To explicitly select"
NSQ_SOURCE_LINE 00002495 "NULLs you have to say \"C<WHERE age IS NULL>\"."
NSQ_SOURCE_LINE 00002496 ""
NSQ_SOURCE_LINE 00002497 "A common issue is to have a code fragment handle a value that could be"
NSQ_SOURCE_LINE 00002498 "either C<defined> or C<undef> (non-NULL or NULL) at runtime."
NSQ_SOURCE_LINE 00002499 "A simple technique is to prepare the appropriate statement as needed,"
NSQ_SOURCE_LINE 00002500 "and substitute the placeholder for non-NULL cases:"
NSQ_SOURCE_LINE 00002501 ""
NSQ_SOURCE_LINE 00002502 "  $sql_clause = defined $age? \"age = ?\" : \"age IS NULL\";"
NSQ_SOURCE_LINE 00002503 "  $sth = $dbh->prepare(qq{"
NSQ_SOURCE_LINE 00002504 "    SELECT fullname FROM people WHERE $sql_clause"
NSQ_SOURCE_LINE 00002505 "  });"
NSQ_SOURCE_LINE 00002506 "  $sth->execute(defined $age ? $age : ());"
NSQ_SOURCE_LINE 00002507 ""
NSQ_SOURCE_LINE 00002508 "The following technique illustrates qualifying a C<WHERE> clause with"
NSQ_SOURCE_LINE 00002509 "several columns, whose associated values (C<defined> or C<undef>) are"
NSQ_SOURCE_LINE 00002510 "in a hash %h:"
NSQ_SOURCE_LINE 00002511 ""
NSQ_SOURCE_LINE 00002512 "  for my $col (\"age\", \"phone\", \"email\") {"
NSQ_SOURCE_LINE 00002513 "    if (defined $h{$col}) {"
NSQ_SOURCE_LINE 00002514 "      push @sql_qual, \"$col = ?\";"
NSQ_SOURCE_LINE 00002515 "      push @sql_bind, $h{$col};"
NSQ_SOURCE_LINE 00002516 "    }"
NSQ_SOURCE_LINE 00002517 "    else {"
NSQ_SOURCE_LINE 00002518 "      push @sql_qual, \"$col IS NULL\";"
NSQ_SOURCE_LINE 00002519 "    }"
NSQ_SOURCE_LINE 00002520 "  }"
NSQ_SOURCE_LINE 00002521 "  $sql_clause = join(\" AND \", @sql_qual);"
NSQ_SOURCE_LINE 00002522 "  $sth = $dbh->prepare(qq{"
NSQ_SOURCE_LINE 00002523 "      SELECT fullname FROM people WHERE $sql_clause"
NSQ_SOURCE_LINE 00002524 "  });"
NSQ_SOURCE_LINE 00002525 "  $sth->execute(@sql_bind);"
NSQ_SOURCE_LINE 00002526 ""
NSQ_SOURCE_LINE 00002527 "The techniques above call prepare for the SQL statement with each call to"
NSQ_SOURCE_LINE 00002528 "execute.  Because calls to prepare() can be expensive, performance"
NSQ_SOURCE_LINE 00002529 "can suffer when an application iterates many times over statements"
NSQ_SOURCE_LINE 00002530 "like the above."
NSQ_SOURCE_LINE 00002531 ""
NSQ_SOURCE_LINE 00002532 "A better solution is a single C<WHERE> clause that supports both"
NSQ_SOURCE_LINE 00002533 "NULL and non-NULL comparisons.  Its SQL statement would need to be"
NSQ_SOURCE_LINE 00002534 "prepared only once for all cases, thus improving performance."
NSQ_SOURCE_LINE 00002535 "Several examples of C<WHERE> clauses that support this are presented"
NSQ_SOURCE_LINE 00002536 "below.  But each example lacks portability, robustness, or simplicity."
NSQ_SOURCE_LINE 00002537 "Whether an example is supported on your database engine depends on"
NSQ_SOURCE_LINE 00002538 "what SQL extensions it provides, and where it supports the C<?>"
NSQ_SOURCE_LINE 00002539 "placeholder in a statement."
NSQ_SOURCE_LINE 00002540 ""
NSQ_SOURCE_LINE 00002541 "  0)  age = ?"
NSQ_SOURCE_LINE 00002542 "  1)  NVL(age, xx) = NVL(?, xx)"
NSQ_SOURCE_LINE 00002543 "  2)  ISNULL(age, xx) = ISNULL(?, xx)"
NSQ_SOURCE_LINE 00002544 "  3)  DECODE(age, ?, 1, 0) = 1"
NSQ_SOURCE_LINE 00002545 "  4)  age = ? OR (age IS NULL AND ? IS NULL)"
NSQ_SOURCE_LINE 00002546 "  5)  age = ? OR (age IS NULL AND SP_ISNULL(?) = 1)"
NSQ_SOURCE_LINE 00002547 "  6)  age = ? OR (age IS NULL AND ? = 1)"
NSQ_SOURCE_LINE 00002548 ""
NSQ_SOURCE_LINE 00002549 "Statements formed with the above C<WHERE> clauses require execute"
NSQ_SOURCE_LINE 00002550 "statements as follows.  The arguments are required, whether their"
NSQ_SOURCE_LINE 00002551 "values are C<defined> or C<undef>."
NSQ_SOURCE_LINE 00002552 ""
NSQ_SOURCE_LINE 00002553 "  0,1,2,3)  $sth->execute($age);"
NSQ_SOURCE_LINE 00002554 "  4,5)      $sth->execute($age, $age);"
NSQ_SOURCE_LINE 00002555 "  6)        $sth->execute($age, defined($age) ? 0 : 1);"
NSQ_SOURCE_LINE 00002556 ""
NSQ_SOURCE_LINE 00002557 "Example 0 should not work (as mentioned earlier), but may work on"
NSQ_SOURCE_LINE 00002558 "a few database engines anyway (e.g. Sybase).  Example 0 is part"
NSQ_SOURCE_LINE 00002559 "of examples 4, 5, and 6, so if example 0 works, these other"
NSQ_SOURCE_LINE 00002560 "examples may work, even if the engine does not properly support"
NSQ_SOURCE_LINE 00002561 "the right hand side of the C<OR> expression."
NSQ_SOURCE_LINE 00002562 ""
NSQ_SOURCE_LINE 00002563 "Examples 1 and 2 are not robust: they require that you provide a"
NSQ_SOURCE_LINE 00002564 "valid column value xx (e.g. '~') which is not present in any row."
NSQ_SOURCE_LINE 00002565 "That means you must have some notion of what data won't be stored"
NSQ_SOURCE_LINE 00002566 "in the column, and expect clients to adhere to that."
NSQ_SOURCE_LINE 00002567 ""
NSQ_SOURCE_LINE 00002568 "Example 5 requires that you provide a stored procedure (SP_ISNULL"
NSQ_SOURCE_LINE 00002569 "in this example) that acts as a function: it checks whether a value"
NSQ_SOURCE_LINE 00002570 "is null, and returns 1 if it is, or 0 if not."
NSQ_SOURCE_LINE 00002571 ""
NSQ_SOURCE_LINE 00002572 "Example 6, the least simple, is probably the most portable, i.e., it"
NSQ_SOURCE_LINE 00002573 "should work with most, if not all, database engines."
NSQ_SOURCE_LINE 00002574 ""
NSQ_SOURCE_LINE 00002575 "Here is a table that indicates which examples above are known to"
NSQ_SOURCE_LINE 00002576 "work on various database engines:"
NSQ_SOURCE_LINE 00002577 ""
NSQ_SOURCE_LINE 00002578 "                   -----Examples------"
NSQ_SOURCE_LINE 00002579 "                   0  1  2  3  4  5  6"
NSQ_SOURCE_LINE 00002580 "                   -  -  -  -  -  -  -"
NSQ_SOURCE_LINE 00002581 "  Oracle 9         N  Y  N  Y  Y  ?  Y"
NSQ_SOURCE_LINE 00002582 "  Informix IDS 9   N  N  N  Y  N  Y  Y"
NSQ_SOURCE_LINE 00002583 "  MS SQL           N  N  Y  N  Y  ?  Y"
NSQ_SOURCE_LINE 00002584 "  Sybase           Y  N  N  N  N  N  Y"
NSQ_SOURCE_LINE 00002585 "  AnyData,DBM,CSV  Y  N  N  N  Y  Y* Y"
NSQ_SOURCE_LINE 00002586 "  SQLite 3.3       N  N  N  N  Y  N  N"
NSQ_SOURCE_LINE 00002587 "  MSAccess         N  N  N  N  Y  N  Y"
NSQ_SOURCE_LINE 00002588 ""
NSQ_SOURCE_LINE 00002589 "* Works only because Example 0 works."
NSQ_SOURCE_LINE 00002590 ""
NSQ_SOURCE_LINE 00002591 "DBI provides a sample perl script that will test the examples above"
NSQ_SOURCE_LINE 00002592 "on your database engine and tell you which ones work.  It is located"
NSQ_SOURCE_LINE 00002593 "in the F<ex/> subdirectory of the DBI source distribution, or here:"
NSQ_SOURCE_LINE 00002594 "L<https://github.com/perl5-dbi/dbi/blob/master/ex/perl_dbi_nulls_test.pl>"
NSQ_SOURCE_LINE 00002595 "Please use the script to help us fill-in and maintain this table."
NSQ_SOURCE_LINE 00002596 ""
NSQ_SOURCE_LINE 00002597 "B<Performance>"
NSQ_SOURCE_LINE 00002598 ""
NSQ_SOURCE_LINE 00002599 "Without using placeholders, the insert statement shown previously would have to"
NSQ_SOURCE_LINE 00002600 "contain the literal values to be inserted and would have to be"
NSQ_SOURCE_LINE 00002601 "re-prepared and re-executed for each row. With placeholders, the insert"
NSQ_SOURCE_LINE 00002602 "statement only needs to be prepared once. The bind values for each row"
NSQ_SOURCE_LINE 00002603 "can be given to the C<execute> method each time it's called. By avoiding"
NSQ_SOURCE_LINE 00002604 "the need to re-prepare the statement for each row, the application"
NSQ_SOURCE_LINE 00002605 "typically runs many times faster. Here's an example:"
NSQ_SOURCE_LINE 00002606 ""
NSQ_SOURCE_LINE 00002607 "  my $sth = $dbh->prepare(q{"
NSQ_SOURCE_LINE 00002608 "    INSERT INTO sales (product_code, qty, price) VALUES (?, ?, ?)"
NSQ_SOURCE_LINE 00002609 "  }) or die $dbh->errstr;"
NSQ_SOURCE_LINE 00002610 "  while (<>) {"
NSQ_SOURCE_LINE 00002611 "      chomp;"
NSQ_SOURCE_LINE 00002612 "      my ($product_code, $qty, $price) = split /,/;"
NSQ_SOURCE_LINE 00002613 "      $sth->execute($product_code, $qty, $price) or die $dbh->errstr;"
NSQ_SOURCE_LINE 00002614 "  }"
NSQ_SOURCE_LINE 00002615 "  $dbh->commit or die $dbh->errstr;"
NSQ_SOURCE_LINE 00002616 ""
NSQ_SOURCE_LINE 00002617 "See L</execute> and L</bind_param> for more details."
NSQ_SOURCE_LINE 00002618 ""
NSQ_SOURCE_LINE 00002619 "The C<q{...}> style quoting used in this example avoids clashing with"
NSQ_SOURCE_LINE 00002620 "quotes that may be used in the SQL statement. Use the double-quote like"
NSQ_SOURCE_LINE 00002621 "C<qq{...}> operator if you want to interpolate variables into the string."
NSQ_SOURCE_LINE 00002622 "See L<perlop/\"Quote and Quote-like Operators\"> for more details."
NSQ_SOURCE_LINE 00002623 ""
NSQ_SOURCE_LINE 00002624 "See also the L</bind_columns> method, which is used to associate Perl"
NSQ_SOURCE_LINE 00002625 "variables with the output columns of a C<SELECT> statement."
NSQ_SOURCE_LINE 00002626 ""
NSQ_SOURCE_LINE 00002627 "=head1 THE DBI PACKAGE AND CLASS"
NSQ_SOURCE_LINE 00002628 ""
NSQ_SOURCE_LINE 00002629 "In this section, we cover the DBI class methods, utility functions,"
NSQ_SOURCE_LINE 00002630 "and the dynamic attributes associated with generic DBI handles."
NSQ_SOURCE_LINE 00002631 ""
NSQ_SOURCE_LINE 00002632 "=head2 DBI Constants"
NSQ_SOURCE_LINE 00002633 ""
NSQ_SOURCE_LINE 00002634 "Constants representing the values of the SQL standard types can be"
NSQ_SOURCE_LINE 00002635 "imported individually by name, or all together by importing the"
NSQ_SOURCE_LINE 00002636 "special C<:sql_types> tag."
NSQ_SOURCE_LINE 00002637 ""
NSQ_SOURCE_LINE 00002638 "The names and values of all the defined SQL standard types can be"
NSQ_SOURCE_LINE 00002639 "produced like this:"
NSQ_SOURCE_LINE 00002640 ""
NSQ_SOURCE_LINE 00002641 "  foreach (@{ $DBI::EXPORT_TAGS{sql_types} }) {"
NSQ_SOURCE_LINE 00002642 "    printf \"%s=%d\\n\", $_, &{\"DBI::$_\"};"
NSQ_SOURCE_LINE 00002643 "  }"
NSQ_SOURCE_LINE 00002644 ""
NSQ_SOURCE_LINE 00002645 "These constants are defined by SQL/CLI, ODBC or both."
NSQ_SOURCE_LINE 00002646 "C<SQL_BIGINT> has conflicting codes in SQL/CLI and ODBC,"
NSQ_SOURCE_LINE 00002647 "DBI uses the ODBC one."
NSQ_SOURCE_LINE 00002648 ""
NSQ_SOURCE_LINE 00002649 "See the L</type_info>, L</type_info_all>, and L</bind_param> methods"
NSQ_SOURCE_LINE 00002650 "for possible uses."
NSQ_SOURCE_LINE 00002651 ""
NSQ_SOURCE_LINE 00002652 "Note that just because the DBI defines a named constant for a given"
NSQ_SOURCE_LINE 00002653 "data type doesn't mean that drivers will support that data type."
NSQ_SOURCE_LINE 00002654 ""
NSQ_SOURCE_LINE 00002655 ""
NSQ_SOURCE_LINE 00002656 "=head2 DBI Class Methods"
NSQ_SOURCE_LINE 00002657 ""
NSQ_SOURCE_LINE 00002658 "The following methods are provided by the DBI class:"
NSQ_SOURCE_LINE 00002659 ""
NSQ_SOURCE_LINE 00002660 "=head3 C<parse_dsn>"
NSQ_SOURCE_LINE 00002661 ""
NSQ_SOURCE_LINE 00002662 "  ($scheme, $driver, $attr_string, $attr_hash, $driver_dsn) = DBI->parse_dsn($dsn)"
NSQ_SOURCE_LINE 00002663 "      or die \"Can't parse DBI DSN '$dsn'\";"
NSQ_SOURCE_LINE 00002664 ""
NSQ_SOURCE_LINE 00002665 "Breaks apart a DBI Data Source Name (DSN) and returns the individual"
NSQ_SOURCE_LINE 00002666 "parts. If $dsn doesn't contain a valid DSN then parse_dsn() returns"
NSQ_SOURCE_LINE 00002667 "an empty list."
NSQ_SOURCE_LINE 00002668 ""
NSQ_SOURCE_LINE 00002669 "$scheme is the first part of the DSN and is currently always 'dbi'."
NSQ_SOURCE_LINE 00002670 "$driver is the driver name, possibly defaulted to $ENV{DBI_DRIVER},"
NSQ_SOURCE_LINE 00002671 "and may be undefined.  $attr_string is the contents of the optional attribute"
NSQ_SOURCE_LINE 00002672 "string, which may be undefined.  If $attr_string is not empty then $attr_hash"
NSQ_SOURCE_LINE 00002673 "is a reference to a hash containing the parsed attribute names and values."
NSQ_SOURCE_LINE 00002674 "$driver_dsn is the last part of the DBI DSN string. For example:"
NSQ_SOURCE_LINE 00002675 ""
NSQ_SOURCE_LINE 00002676 "  ($scheme, $driver, $attr_string, $attr_hash, $driver_dsn)"
NSQ_SOURCE_LINE 00002677 "      = DBI->parse_dsn(\"dbi:MyDriver(RaiseError=>1):db=test;port=42\");"
NSQ_SOURCE_LINE 00002678 "  $scheme      = 'dbi';"
NSQ_SOURCE_LINE 00002679 "  $driver      = 'MyDriver';"
NSQ_SOURCE_LINE 00002680 "  $attr_string = 'RaiseError=>1';"
NSQ_SOURCE_LINE 00002681 "  $attr_hash   = { 'RaiseError' => '1' };"
NSQ_SOURCE_LINE 00002682 "  $driver_dsn  = 'db=test;port=42';"
NSQ_SOURCE_LINE 00002683 ""
NSQ_SOURCE_LINE 00002684 "The parse_dsn() method was added in DBI 1.43."
NSQ_SOURCE_LINE 00002685 ""
NSQ_SOURCE_LINE 00002686 "=head3 C<connect>"
NSQ_SOURCE_LINE 00002687 ""
NSQ_SOURCE_LINE 00002688 "  $dbh = DBI->connect($data_source, $username, $password)"
NSQ_SOURCE_LINE 00002689 "            or die $DBI::errstr;"
NSQ_SOURCE_LINE 00002690 "  $dbh = DBI->connect($data_source, $username, $password, \\%attr)"
NSQ_SOURCE_LINE 00002691 "            or die $DBI::errstr;"
NSQ_SOURCE_LINE 00002692 ""
NSQ_SOURCE_LINE 00002693 "Establishes a database connection, or session, to the requested C<$data_source>."
NSQ_SOURCE_LINE 00002694 "Returns a database handle object if the connection succeeds. Use"
NSQ_SOURCE_LINE 00002695 "C<$dbh-E<gt>disconnect> to terminate the connection."
NSQ_SOURCE_LINE 00002696 ""
NSQ_SOURCE_LINE 00002697 "If the connect fails (see below), it returns C<undef> and sets both C<$DBI::err>"
NSQ_SOURCE_LINE 00002698 "and C<$DBI::errstr>. (It does I<not> explicitly set C<$!>.) You should generally"
NSQ_SOURCE_LINE 00002699 "test the return status of C<connect> and C<print $DBI::errstr> if it has failed."
NSQ_SOURCE_LINE 00002700 ""
NSQ_SOURCE_LINE 00002701 "Multiple simultaneous connections to multiple databases through multiple"
NSQ_SOURCE_LINE 00002702 "drivers can be made via the DBI. Simply make one C<connect> call for each"
NSQ_SOURCE_LINE 00002703 "database and keep a copy of each returned database handle."
NSQ_SOURCE_LINE 00002704 ""
NSQ_SOURCE_LINE 00002705 "The C<$data_source> value must begin with \"C<dbi:>I<driver_name>C<:>\"."
NSQ_SOURCE_LINE 00002706 "The I<driver_name> specifies the driver that will be used to make the"
NSQ_SOURCE_LINE 00002707 "connection. (Letter case is significant.)"
NSQ_SOURCE_LINE 00002708 ""
NSQ_SOURCE_LINE 00002709 "As a convenience, if the C<$data_source> parameter is undefined or empty,"
NSQ_SOURCE_LINE 00002710 "the DBI will substitute the value of the environment variable C<DBI_DSN>."
NSQ_SOURCE_LINE 00002711 "If just the I<driver_name> part is empty (i.e., the C<$data_source>"
NSQ_SOURCE_LINE 00002712 "prefix is \"C<dbi::>\"), the environment variable C<DBI_DRIVER> is"
NSQ_SOURCE_LINE 00002713 "used. If neither variable is set, then C<connect> dies."
NSQ_SOURCE_LINE 00002714 ""
NSQ_SOURCE_LINE 00002715 "Examples of C<$data_source> values are:"
NSQ_SOURCE_LINE 00002716 ""
NSQ_SOURCE_LINE 00002717 "  dbi:DriverName:database_name"
NSQ_SOURCE_LINE 00002718 "  dbi:DriverName:database_name@hostname:port"
NSQ_SOURCE_LINE 00002719 "  dbi:DriverName:database=database_name;host=hostname;port=port"
NSQ_SOURCE_LINE 00002720 ""
NSQ_SOURCE_LINE 00002721 "There is I<no standard> for the text following the driver name. Each"
NSQ_SOURCE_LINE 00002722 "driver is free to use whatever syntax it wants. The only requirement the"
NSQ_SOURCE_LINE 00002723 "DBI makes is that all the information is supplied in a single string."
NSQ_SOURCE_LINE 00002724 "You must consult the documentation for the drivers you are using for a"
NSQ_SOURCE_LINE 00002725 "description of the syntax they require."
NSQ_SOURCE_LINE 00002726 ""
NSQ_SOURCE_LINE 00002727 "It is recommended that drivers support the ODBC style, shown in the"
NSQ_SOURCE_LINE 00002728 "last example above. It is also recommended that they support the"
NSQ_SOURCE_LINE 00002729 "three common names 'C<host>', 'C<port>', and 'C<database>' (plus 'C<db>'"
NSQ_SOURCE_LINE 00002730 "as an alias for C<database>). This simplifies automatic construction"
NSQ_SOURCE_LINE 00002731 "of basic DSNs: C<\"dbi:$driver:database=$db;host=$host;port=$port\">."
NSQ_SOURCE_LINE 00002732 "Drivers should aim to 'do something reasonable' when given a DSN"
NSQ_SOURCE_LINE 00002733 "in this form, but if any part is meaningless for that driver (such"
NSQ_SOURCE_LINE 00002734 "as 'port' for Informix) it should generate an error if that part"
NSQ_SOURCE_LINE 00002735 "is not empty."
NSQ_SOURCE_LINE 00002736 ""
NSQ_SOURCE_LINE 00002737 "If the environment variable C<DBI_AUTOPROXY> is defined (and the"
NSQ_SOURCE_LINE 00002738 "driver in C<$data_source> is not \"C<Proxy>\") then the connect request"
NSQ_SOURCE_LINE 00002739 "will automatically be changed to:"
NSQ_SOURCE_LINE 00002740 ""
NSQ_SOURCE_LINE 00002741 "  $ENV{DBI_AUTOPROXY};dsn=$data_source"
NSQ_SOURCE_LINE 00002742 ""
NSQ_SOURCE_LINE 00002743 "C<DBI_AUTOPROXY> is typically set as \"C<dbi:Proxy:hostname=...;port=...>\"."
NSQ_SOURCE_LINE 00002744 "If $ENV{DBI_AUTOPROXY} doesn't begin with 'C<dbi:>' then \"dbi:Proxy:\""
NSQ_SOURCE_LINE 00002745 "will be prepended to it first.  See the DBD::Proxy documentation"
NSQ_SOURCE_LINE 00002746 "for more details."
NSQ_SOURCE_LINE 00002747 ""
NSQ_SOURCE_LINE 00002748 "If C<$username> or C<$password> are undefined (rather than just empty),"
NSQ_SOURCE_LINE 00002749 "then the DBI will substitute the values of the C<DBI_USER> and C<DBI_PASS>"
NSQ_SOURCE_LINE 00002750 "environment variables, respectively.  The DBI will warn if the"
NSQ_SOURCE_LINE 00002751 "environment variables are not defined.  However, the everyday use"
NSQ_SOURCE_LINE 00002752 "of these environment variables is not recommended for security"
NSQ_SOURCE_LINE 00002753 "reasons. The mechanism is primarily intended to simplify testing."
NSQ_SOURCE_LINE 00002754 "See below for alternative way to specify the username and password."
NSQ_SOURCE_LINE 00002755 ""
NSQ_SOURCE_LINE 00002756 "C<DBI-E<gt>connect> automatically installs the driver if it has not been"
NSQ_SOURCE_LINE 00002757 "installed yet. Driver installation either returns a valid driver"
NSQ_SOURCE_LINE 00002758 "handle, or it I<dies> with an error message that includes the string"
NSQ_SOURCE_LINE 00002759 "\"C<install_driver>\" and the underlying problem. So C<DBI-E<gt>connect>"
NSQ_SOURCE_LINE 00002760 "will die"
NSQ_SOURCE_LINE 00002761 "on a driver installation failure and will only return C<undef> on a"
NSQ_SOURCE_LINE 00002762 "connect failure, in which case C<$DBI::errstr> will hold the error message."
NSQ_SOURCE_LINE 00002763 "Use C<eval> if you need to catch the \"C<install_driver>\" error."
NSQ_SOURCE_LINE 00002764 ""
NSQ_SOURCE_LINE 00002765 "The C<$data_source> argument (with the \"C<dbi:...:>\" prefix removed) and the"
NSQ_SOURCE_LINE 00002766 "C<$username> and C<$password> arguments are then passed to the driver for"
NSQ_SOURCE_LINE 00002767 "processing. The DBI does not define any interpretation for the"
NSQ_SOURCE_LINE 00002768 "contents of these fields.  The driver is free to interpret the"
NSQ_SOURCE_LINE 00002769 "C<$data_source>, C<$username>, and C<$password> fields in any way, and supply"
NSQ_SOURCE_LINE 00002770 "whatever defaults are appropriate for the engine being accessed."
NSQ_SOURCE_LINE 00002771 "(Oracle, for example, uses the ORACLE_SID and TWO_TASK environment"
NSQ_SOURCE_LINE 00002772 "variables if no C<$data_source> is specified.)"
NSQ_SOURCE_LINE 00002773 ""
NSQ_SOURCE_LINE 00002774 "The C<AutoCommit> and C<PrintError> attributes for each connection"
NSQ_SOURCE_LINE 00002775 "default to \"on\". (See L</AutoCommit> and L</PrintError> for more information.)"
NSQ_SOURCE_LINE 00002776 "However, it is strongly recommended that you explicitly define C<AutoCommit>"
NSQ_SOURCE_LINE 00002777 "rather than rely on the default. The C<PrintWarn> attribute defaults to true."
NSQ_SOURCE_LINE 00002778 "The C<RaiseWarn> attribute defaults to false."
NSQ_SOURCE_LINE 00002779 ""
NSQ_SOURCE_LINE 00002780 "The C<\\%attr> parameter can be used to alter the default settings of"
NSQ_SOURCE_LINE 00002781 "C<PrintError>, C<RaiseError>, C<AutoCommit>, and other attributes. For example:"
NSQ_SOURCE_LINE 00002782 ""
NSQ_SOURCE_LINE 00002783 "  $dbh = DBI->connect($data_source, $user, $pass, {"
NSQ_SOURCE_LINE 00002784 "\tPrintError => 0,"
NSQ_SOURCE_LINE 00002785 "\tAutoCommit => 0"
NSQ_SOURCE_LINE 00002786 "  });"
NSQ_SOURCE_LINE 00002787 ""
NSQ_SOURCE_LINE 00002788 "The username and password can also be specified using the attributes"
NSQ_SOURCE_LINE 00002789 "C<Username> and C<Password>, in which case they take precedence"
NSQ_SOURCE_LINE 00002790 "over the C<$username> and C<$password> parameters."
NSQ_SOURCE_LINE 00002791 ""
NSQ_SOURCE_LINE 00002792 "You can also define connection attribute values within the C<$data_source>"
NSQ_SOURCE_LINE 00002793 "parameter. For example:"
NSQ_SOURCE_LINE 00002794 ""
NSQ_SOURCE_LINE 00002795 "  dbi:DriverName(PrintWarn=>0,PrintError=>0,Taint=>1):..."
NSQ_SOURCE_LINE 00002796 ""
NSQ_SOURCE_LINE 00002797 "Individual attributes values specified in this way take precedence over"
NSQ_SOURCE_LINE 00002798 "any conflicting values specified via the C<\\%attr> parameter to C<connect>."
NSQ_SOURCE_LINE 00002799 ""
NSQ_SOURCE_LINE 00002800 "The C<dbi_connect_method> attribute can be used to specify which driver"
NSQ_SOURCE_LINE 00002801 "method should be called to establish the connection. The only useful"
NSQ_SOURCE_LINE 00002802 "values are 'connect', 'connect_cached', or some specialized case like"
NSQ_SOURCE_LINE 00002803 "'Apache::DBI::connect' (which is automatically the default when running"
NSQ_SOURCE_LINE 00002804 "within Apache)."
NSQ_SOURCE_LINE 00002805 ""
NSQ_SOURCE_LINE 00002806 "Where possible, each session (C<$dbh>) is independent from the transactions"
NSQ_SOURCE_LINE 00002807 "in other sessions. This is useful when you need to hold cursors open"
NSQ_SOURCE_LINE 00002808 "across transactions--for example, if you use one session for your long lifespan"
NSQ_SOURCE_LINE 00002809 "cursors (typically read-only) and another for your short update"
NSQ_SOURCE_LINE 00002810 "transactions."
NSQ_SOURCE_LINE 00002811 ""
NSQ_SOURCE_LINE 00002812 "For compatibility with old DBI scripts, the driver can be specified by"
NSQ_SOURCE_LINE 00002813 "passing its name as the fourth argument to C<connect> (instead of C<\\%attr>):"
NSQ_SOURCE_LINE 00002814 ""
NSQ_SOURCE_LINE 00002815 "  $dbh = DBI->connect($data_source, $user, $pass, $driver);"
NSQ_SOURCE_LINE 00002816 ""
NSQ_SOURCE_LINE 00002817 "In this \"old-style\" form of C<connect>, the C<$data_source> should not start"
NSQ_SOURCE_LINE 00002818 "with \"C<dbi:driver_name:>\". (If it does, the embedded driver_name"
NSQ_SOURCE_LINE 00002819 "will be ignored). Also note that in this older form of C<connect>,"
NSQ_SOURCE_LINE 00002820 "the C<$dbh-E<gt>{AutoCommit}> attribute is I<undefined>, the"
NSQ_SOURCE_LINE 00002821 "C<$dbh-E<gt>{PrintError}> attribute is off, and the old C<DBI_DBNAME>"
NSQ_SOURCE_LINE 00002822 "environment variable is"
NSQ_SOURCE_LINE 00002823 "checked if C<DBI_DSN> is not defined. Beware that this \"old-style\""
NSQ_SOURCE_LINE 00002824 "C<connect> will soon be withdrawn in a future version of DBI."
NSQ_SOURCE_LINE 00002825 ""
NSQ_SOURCE_LINE 00002826 "=head3 C<connect_cached>"
NSQ_SOURCE_LINE 00002827 ""
NSQ_SOURCE_LINE 00002828 "  $dbh = DBI->connect_cached($data_source, $username, $password)"
NSQ_SOURCE_LINE 00002829 "            or die $DBI::errstr;"
NSQ_SOURCE_LINE 00002830 "  $dbh = DBI->connect_cached($data_source, $username, $password, \\%attr)"
NSQ_SOURCE_LINE 00002831 "            or die $DBI::errstr;"
NSQ_SOURCE_LINE 00002832 ""
NSQ_SOURCE_LINE 00002833 "C<connect_cached> is like L</connect>, except that the database handle"
NSQ_SOURCE_LINE 00002834 "returned is also"
NSQ_SOURCE_LINE 00002835 "stored in a hash associated with the given parameters. If another call"
NSQ_SOURCE_LINE 00002836 "is made to C<connect_cached> with the same parameter values, then the"
NSQ_SOURCE_LINE 00002837 "corresponding cached C<$dbh> will be returned if it is still valid."
NSQ_SOURCE_LINE 00002838 "The cached database handle is replaced with a new connection if it"
NSQ_SOURCE_LINE 00002839 "has been disconnected or if the C<ping> method fails."
NSQ_SOURCE_LINE 00002840 ""
NSQ_SOURCE_LINE 00002841 "Note that the behaviour of this method differs in several respects from the"
NSQ_SOURCE_LINE 00002842 "behaviour of persistent connections implemented by Apache::DBI."
NSQ_SOURCE_LINE 00002843 "However, if Apache::DBI is loaded then C<connect_cached> will use it."
NSQ_SOURCE_LINE 00002844 ""
NSQ_SOURCE_LINE 00002845 "Caching connections can be useful in some applications, but it can"
NSQ_SOURCE_LINE 00002846 "also cause problems, such as too many connections, and so should"
NSQ_SOURCE_LINE 00002847 "be used with care. In particular, avoid changing the attributes of"
NSQ_SOURCE_LINE 00002848 "a database handle created via connect_cached() because it will affect"
NSQ_SOURCE_LINE 00002849 "other code that may be using the same handle. When connect_cached()"
NSQ_SOURCE_LINE 00002850 "returns a handle the attributes will be reset to their initial values."
NSQ_SOURCE_LINE 00002851 "This can cause problems, especially with the C<AutoCommit> attribute."
NSQ_SOURCE_LINE 00002852 ""
NSQ_SOURCE_LINE 00002853 "Also, to ensure that the attributes passed are always the same, avoid passing"
NSQ_SOURCE_LINE 00002854 "references inline. For example, the C<Callbacks> attribute is specified as a"
NSQ_SOURCE_LINE 00002855 "hash reference. Be sure to declare it external to the call to"
NSQ_SOURCE_LINE 00002856 "connect_cached(), such that the hash reference is not re-created on every"
NSQ_SOURCE_LINE 00002857 "call. A package-level lexical works well:"
NSQ_SOURCE_LINE 00002858 ""
NSQ_SOURCE_LINE 00002859 "  package MyDBH;"
NSQ_SOURCE_LINE 00002860 "  my $cb = {"
NSQ_SOURCE_LINE 00002861 "      'connect_cached.reused' => sub { delete $_[4]->{AutoCommit} },"
NSQ_SOURCE_LINE 00002862 "  };"
NSQ_SOURCE_LINE 00002863 ""
NSQ_SOURCE_LINE 00002864 "  sub dbh {"
NSQ_SOURCE_LINE 00002865 "      DBI->connect_cached( $dsn, $username, $auth, { Callbacks => $cb });"
NSQ_SOURCE_LINE 00002866 "  }"
NSQ_SOURCE_LINE 00002867 ""
NSQ_SOURCE_LINE 00002868 "Where multiple separate parts of a program are using connect_cached()"
NSQ_SOURCE_LINE 00002869 "to connect to the same database with the same (initial) attributes"
NSQ_SOURCE_LINE 00002870 "it is a good idea to add a private attribute to the connect_cached()"
NSQ_SOURCE_LINE 00002871 "call to effectively limit the scope of the caching. For example:"
NSQ_SOURCE_LINE 00002872 ""
NSQ_SOURCE_LINE 00002873 "  DBI->connect_cached(..., { private_foo_cachekey => \"Bar\", ... });"
NSQ_SOURCE_LINE 00002874 ""
NSQ_SOURCE_LINE 00002875 "Handles returned from that connect_cached() call will only be returned"
NSQ_SOURCE_LINE 00002876 "by other connect_cached() call elsewhere in the code if those other"
NSQ_SOURCE_LINE 00002877 "calls also pass in the same attribute values, including the private one."
NSQ_SOURCE_LINE 00002878 "(I've used C<private_foo_cachekey> here as an example, you can use"
NSQ_SOURCE_LINE 00002879 "any attribute name with a C<private_> prefix.)"
NSQ_SOURCE_LINE 00002880 ""
NSQ_SOURCE_LINE 00002881 "Taking that one step further, you can limit a particular connect_cached()"
NSQ_SOURCE_LINE 00002882 "call to return handles unique to that one place in the code by setting the"
NSQ_SOURCE_LINE 00002883 "private attribute to a unique value for that place:"
NSQ_SOURCE_LINE 00002884 ""
NSQ_SOURCE_LINE 00002885 "  DBI->connect_cached(..., { private_foo_cachekey => __FILE__.__LINE__, ... });"
NSQ_SOURCE_LINE 00002886 ""
NSQ_SOURCE_LINE 00002887 "By using a private attribute you still get connection caching for"
NSQ_SOURCE_LINE 00002888 "the individual calls to connect_cached() but, by making separate"
NSQ_SOURCE_LINE 00002889 "database connections for separate parts of the code, the database"
NSQ_SOURCE_LINE 00002890 "handles are isolated from any attribute changes made to other handles."
NSQ_SOURCE_LINE 00002891 ""
NSQ_SOURCE_LINE 00002892 "The cache can be accessed (and cleared) via the L</CachedKids> attribute:"
NSQ_SOURCE_LINE 00002893 ""
NSQ_SOURCE_LINE 00002894 "  my $CachedKids_hashref = $dbh->{Driver}->{CachedKids};"
NSQ_SOURCE_LINE 00002895 "  %$CachedKids_hashref = () if $CachedKids_hashref;"
NSQ_SOURCE_LINE 00002896 ""
NSQ_SOURCE_LINE 00002897 ""
NSQ_SOURCE_LINE 00002898 "=head3 C<available_drivers>"
NSQ_SOURCE_LINE 00002899 ""
NSQ_SOURCE_LINE 00002900 "  @ary = DBI->available_drivers;"
NSQ_SOURCE_LINE 00002901 "  @ary = DBI->available_drivers($quiet);"
NSQ_SOURCE_LINE 00002902 ""
NSQ_SOURCE_LINE 00002903 "Returns a list of all available drivers by searching for C<DBD::*> modules"
NSQ_SOURCE_LINE 00002904 "through the directories in C<@INC>. By default, a warning is given if"
NSQ_SOURCE_LINE 00002905 "some drivers are hidden by others of the same name in earlier"
NSQ_SOURCE_LINE 00002906 "directories. Passing a true value for C<$quiet> will inhibit the warning."
NSQ_SOURCE_LINE 00002907 ""
NSQ_SOURCE_LINE 00002908 "=head3 C<installed_drivers>"
NSQ_SOURCE_LINE 00002909 ""
NSQ_SOURCE_LINE 00002910 "  %drivers = DBI->installed_drivers();"
NSQ_SOURCE_LINE 00002911 ""
NSQ_SOURCE_LINE 00002912 "Returns a list of driver name and driver handle pairs for all drivers"
NSQ_SOURCE_LINE 00002913 "'installed' (loaded) into the current process.  The driver name does not"
NSQ_SOURCE_LINE 00002914 "include the 'DBD::' prefix."
NSQ_SOURCE_LINE 00002915 ""
NSQ_SOURCE_LINE 00002916 "To get a list of all drivers available in your perl installation you can use"
NSQ_SOURCE_LINE 00002917 "L</available_drivers>."
NSQ_SOURCE_LINE 00002918 ""
NSQ_SOURCE_LINE 00002919 "Added in DBI 1.49."
NSQ_SOURCE_LINE 00002920 ""
NSQ_SOURCE_LINE 00002921 "=head3 C<installed_versions>"
NSQ_SOURCE_LINE 00002922 ""
NSQ_SOURCE_LINE 00002923 "  DBI->installed_versions;"
NSQ_SOURCE_LINE 00002924 "  @ary  = DBI->installed_versions;"
NSQ_SOURCE_LINE 00002925 "  $hash = DBI->installed_versions;"
NSQ_SOURCE_LINE 00002926 ""
NSQ_SOURCE_LINE 00002927 "Calls available_drivers() and attempts to load each of them in turn"
NSQ_SOURCE_LINE 00002928 "using install_driver().  For each load that succeeds the driver"
NSQ_SOURCE_LINE 00002929 "name and version number are added to a hash. When running under"
NSQ_SOURCE_LINE 00002930 "L<DBI::PurePerl> drivers which appear not be pure-perl are ignored."
NSQ_SOURCE_LINE 00002931 ""
NSQ_SOURCE_LINE 00002932 "When called in array context the list of successfully loaded drivers"
NSQ_SOURCE_LINE 00002933 "is returned (without the 'DBD::' prefix)."
NSQ_SOURCE_LINE 00002934 ""
NSQ_SOURCE_LINE 00002935 "When called in scalar context an extra entry for the C<DBI> is added (and"
NSQ_SOURCE_LINE 00002936 "C<DBI::PurePerl> if appropriate) and a reference to the hash is returned."
NSQ_SOURCE_LINE 00002937 ""
NSQ_SOURCE_LINE 00002938 "When called in a void context the installed_versions() method will"
NSQ_SOURCE_LINE 00002939 "print out a formatted list of the hash contents, one per line, along with some"
NSQ_SOURCE_LINE 00002940 "other information about the DBI version and OS."
NSQ_SOURCE_LINE 00002941 ""
NSQ_SOURCE_LINE 00002942 "Due to the potentially high memory cost and unknown risks of loading"
NSQ_SOURCE_LINE 00002943 "in an unknown number of drivers that just happen to be installed"
NSQ_SOURCE_LINE 00002944 "on the system, this method is not recommended for general use."
NSQ_SOURCE_LINE 00002945 "Use available_drivers() instead."
NSQ_SOURCE_LINE 00002946 ""
NSQ_SOURCE_LINE 00002947 "The installed_versions() method is primarily intended as a quick"
NSQ_SOURCE_LINE 00002948 "way to see from the command line what's installed. For example:"
NSQ_SOURCE_LINE 00002949 ""
NSQ_SOURCE_LINE 00002950 "  perl -MDBI -e 'DBI->installed_versions'"
NSQ_SOURCE_LINE 00002951 ""
NSQ_SOURCE_LINE 00002952 "The installed_versions() method was added in DBI 1.38."
NSQ_SOURCE_LINE 00002953 ""
NSQ_SOURCE_LINE 00002954 "=head3 C<data_sources>"
NSQ_SOURCE_LINE 00002955 ""
NSQ_SOURCE_LINE 00002956 "  @ary = DBI->data_sources($driver);"
NSQ_SOURCE_LINE 00002957 "  @ary = DBI->data_sources($driver, \\%attr);"
NSQ_SOURCE_LINE 00002958 ""
NSQ_SOURCE_LINE 00002959 "Returns a list of data sources (databases) available via the named"
NSQ_SOURCE_LINE 00002960 "driver.  If C<$driver> is empty or C<undef>, then the value of the"
NSQ_SOURCE_LINE 00002961 "C<DBI_DRIVER> environment variable is used."
NSQ_SOURCE_LINE 00002962 ""
NSQ_SOURCE_LINE 00002963 "The driver will be loaded if it hasn't been already. Note that if the"
NSQ_SOURCE_LINE 00002964 "driver loading fails then data_sources() I<dies> with an error message"
NSQ_SOURCE_LINE 00002965 "that includes the string \"C<install_driver>\" and the underlying problem."
NSQ_SOURCE_LINE 00002966 ""
NSQ_SOURCE_LINE 00002967 "Data sources are returned in a form suitable for passing to the"
NSQ_SOURCE_LINE 00002968 "L</connect> method (that is, they will include the \"C<dbi:$driver:>\" prefix)."
NSQ_SOURCE_LINE 00002969 ""
NSQ_SOURCE_LINE 00002970 "Note that many drivers have no way of knowing what data sources might"
NSQ_SOURCE_LINE 00002971 "be available for it. These drivers return an empty or incomplete list"
NSQ_SOURCE_LINE 00002972 "or may require driver-specific attributes."
NSQ_SOURCE_LINE 00002973 ""
NSQ_SOURCE_LINE 00002974 "There is also a data_sources() method defined for database handles."
NSQ_SOURCE_LINE 00002975 ""
NSQ_SOURCE_LINE 00002976 ""
NSQ_SOURCE_LINE 00002977 "=head3 C<trace>"
NSQ_SOURCE_LINE 00002978 ""
NSQ_SOURCE_LINE 00002979 "  DBI->trace($trace_setting)"
NSQ_SOURCE_LINE 00002980 "  DBI->trace($trace_setting, $trace_filename)"
NSQ_SOURCE_LINE 00002981 "  DBI->trace($trace_setting, $trace_filehandle)"
NSQ_SOURCE_LINE 00002982 "  $trace_setting = DBI->trace;"
NSQ_SOURCE_LINE 00002983 ""
NSQ_SOURCE_LINE 00002984 "The C<DBI-E<gt>trace> method sets the I<global default> trace"
NSQ_SOURCE_LINE 00002985 "settings and returns the I<previous> trace settings. It can also"
NSQ_SOURCE_LINE 00002986 "be used to change where the trace output is sent."
NSQ_SOURCE_LINE 00002987 ""
NSQ_SOURCE_LINE 00002988 "There's a similar method, C<$h-E<gt>trace>, which sets the trace"
NSQ_SOURCE_LINE 00002989 "settings for the specific handle it's called on."
NSQ_SOURCE_LINE 00002990 ""
NSQ_SOURCE_LINE 00002991 "See the L</TRACING> section for full details about the DBI's powerful"
NSQ_SOURCE_LINE 00002992 "tracing facilities."
NSQ_SOURCE_LINE 00002993 ""
NSQ_SOURCE_LINE 00002994 ""
NSQ_SOURCE_LINE 00002995 "=head3 C<visit_handles>"
NSQ_SOURCE_LINE 00002996 ""
NSQ_SOURCE_LINE 00002997 "  DBI->visit_handles( $coderef );"
NSQ_SOURCE_LINE 00002998 "  DBI->visit_handles( $coderef, $info );"
NSQ_SOURCE_LINE 00002999 ""
NSQ_SOURCE_LINE 00003000 "Where $coderef is a reference to a subroutine and $info is an arbitrary value"
NSQ_SOURCE_LINE 00003001 "which, if undefined, defaults to a reference to an empty hash. Returns $info."
NSQ_SOURCE_LINE 00003002 ""
NSQ_SOURCE_LINE 00003003 "For each installed driver handle, if any, $coderef is invoked as:"
NSQ_SOURCE_LINE 00003004 ""
NSQ_SOURCE_LINE 00003005 "  $coderef->($driver_handle, $info);"
NSQ_SOURCE_LINE 00003006 ""
NSQ_SOURCE_LINE 00003007 "If the execution of $coderef returns a true value then L</visit_child_handles>"
NSQ_SOURCE_LINE 00003008 "is called on that child handle and passed the returned value as $info."
NSQ_SOURCE_LINE 00003009 ""
NSQ_SOURCE_LINE 00003010 "For example:"
NSQ_SOURCE_LINE 00003011 ""
NSQ_SOURCE_LINE 00003012 "  my $info = $dbh->{Driver}->visit_child_handles(sub {"
NSQ_SOURCE_LINE 00003013 "      my ($h, $info) = @_;"
NSQ_SOURCE_LINE 00003014 "      ++$info->{ $h->{Type} }; # count types of handles (dr/db/st)"
NSQ_SOURCE_LINE 00003015 "      return $info; # visit kids"
NSQ_SOURCE_LINE 00003016 "  });"
NSQ_SOURCE_LINE 00003017 ""
NSQ_SOURCE_LINE 00003018 "See also L</visit_child_handles>."
NSQ_SOURCE_LINE 00003019 ""
NSQ_SOURCE_LINE 00003020 "=head2 DBI Utility Functions"
NSQ_SOURCE_LINE 00003021 ""
NSQ_SOURCE_LINE 00003022 "In addition to the DBI methods listed in the previous section,"
NSQ_SOURCE_LINE 00003023 "the DBI package also provides several utility functions."
NSQ_SOURCE_LINE 00003024 ""
NSQ_SOURCE_LINE 00003025 "These can be imported into your code by listing them in"
NSQ_SOURCE_LINE 00003026 "the C<use> statement. For example:"
NSQ_SOURCE_LINE 00003027 ""
NSQ_SOURCE_LINE 00003028 "  use DBI qw(neat data_diff);"
NSQ_SOURCE_LINE 00003029 ""
NSQ_SOURCE_LINE 00003030 "Alternatively, all these utility functions (except hash) can be"
NSQ_SOURCE_LINE 00003031 "imported using the C<:utils> import tag. For example:"
NSQ_SOURCE_LINE 00003032 ""
NSQ_SOURCE_LINE 00003033 "  use DBI qw(:utils);"
NSQ_SOURCE_LINE 00003034 ""
NSQ_SOURCE_LINE 00003035 "=head3 C<data_string_desc>"
NSQ_SOURCE_LINE 00003036 ""
NSQ_SOURCE_LINE 00003037 "  $description = data_string_desc($string);"
NSQ_SOURCE_LINE 00003038 ""
NSQ_SOURCE_LINE 00003039 "Returns an informal description of the string. For example:"
NSQ_SOURCE_LINE 00003040 ""
NSQ_SOURCE_LINE 00003041 "  UTF8 off, ASCII, 42 characters 42 bytes"
NSQ_SOURCE_LINE 00003042 "  UTF8 off, non-ASCII, 42 characters 42 bytes"
NSQ_SOURCE_LINE 00003043 "  UTF8 on, non-ASCII, 4 characters 6 bytes"
NSQ_SOURCE_LINE 00003044 "  UTF8 on but INVALID encoding, non-ASCII, 4 characters 6 bytes"
NSQ_SOURCE_LINE 00003045 "  UTF8 off, undef"
NSQ_SOURCE_LINE 00003046 ""
NSQ_SOURCE_LINE 00003047 "The initial C<UTF8> on/off refers to Perl's internal SvUTF8 flag."
NSQ_SOURCE_LINE 00003048 "If $string has the SvUTF8 flag set but the sequence of bytes it"
NSQ_SOURCE_LINE 00003049 "contains are not a valid UTF-8 encoding then data_string_desc()"
NSQ_SOURCE_LINE 00003050 "will report C<UTF8 on but INVALID encoding>."
NSQ_SOURCE_LINE 00003051 ""
NSQ_SOURCE_LINE 00003052 "The C<ASCII> vs C<non-ASCII> portion shows C<ASCII> if I<all> the"
NSQ_SOURCE_LINE 00003053 "characters in the string are ASCII (have code points <= 127)."
NSQ_SOURCE_LINE 00003054 ""
NSQ_SOURCE_LINE 00003055 "The data_string_desc() function was added in DBI 1.46."
NSQ_SOURCE_LINE 00003056 ""
NSQ_SOURCE_LINE 00003057 "=head3 C<data_string_diff>"
NSQ_SOURCE_LINE 00003058 ""
NSQ_SOURCE_LINE 00003059 "  $diff = data_string_diff($a, $b);"
NSQ_SOURCE_LINE 00003060 ""
NSQ_SOURCE_LINE 00003061 "Returns an informal description of the first character difference"
NSQ_SOURCE_LINE 00003062 "between the strings. If both $a and $b contain the same sequence"
NSQ_SOURCE_LINE 00003063 "of characters then data_string_diff() returns an empty string."
NSQ_SOURCE_LINE 00003064 "For example:"
NSQ_SOURCE_LINE 00003065 ""
NSQ_SOURCE_LINE 00003066 " Params a & b     Result"
NSQ_SOURCE_LINE 00003067 " ------------     ------"
NSQ_SOURCE_LINE 00003068 " 'aaa', 'aaa'     ''"
NSQ_SOURCE_LINE 00003069 " 'aaa', 'abc'     'Strings differ at index 2: a[2]=a, b[2]=b'"
NSQ_SOURCE_LINE 00003070 " 'aaa', undef     'String b is undef, string a has 3 characters'"
NSQ_SOURCE_LINE 00003071 " 'aaa', 'aa'      'String b truncated after 2 characters'"
NSQ_SOURCE_LINE 00003072 ""
NSQ_SOURCE_LINE 00003073 "Unicode characters are reported in C<\\x{XXXX}> format. Unicode"
NSQ_SOURCE_LINE 00003074 "code points in the range U+0800 to U+08FF are unassigned and most"
NSQ_SOURCE_LINE 00003075 "likely to occur due to double-encoding. Characters in this range"
NSQ_SOURCE_LINE 00003076 "are reported as C<\\x{08XX}='C'> where C<C> is the corresponding"
NSQ_SOURCE_LINE 00003077 "latin-1 character."
NSQ_SOURCE_LINE 00003078 ""
NSQ_SOURCE_LINE 00003079 "The data_string_diff() function only considers logical I<characters>"
NSQ_SOURCE_LINE 00003080 "and not the underlying encoding. See L</data_diff> for an alternative."
NSQ_SOURCE_LINE 00003081 ""
NSQ_SOURCE_LINE 00003082 "The data_string_diff() function was added in DBI 1.46."
NSQ_SOURCE_LINE 00003083 ""
NSQ_SOURCE_LINE 00003084 "=head3 C<data_diff>"
NSQ_SOURCE_LINE 00003085 ""
NSQ_SOURCE_LINE 00003086 "  $diff = data_diff($a, $b);"
NSQ_SOURCE_LINE 00003087 "  $diff = data_diff($a, $b, $logical);"
NSQ_SOURCE_LINE 00003088 ""
NSQ_SOURCE_LINE 00003089 "Returns an informal description of the difference between two strings."
NSQ_SOURCE_LINE 00003090 "It calls L</data_string_desc> and L</data_string_diff>"
NSQ_SOURCE_LINE 00003091 "and returns the combined results as a multi-line string."
NSQ_SOURCE_LINE 00003092 ""
NSQ_SOURCE_LINE 00003093 "For example, C<data_diff(\"abc\", \"ab\\x{263a}\")> will return:"
NSQ_SOURCE_LINE 00003094 ""
NSQ_SOURCE_LINE 00003095 "  a: UTF8 off, ASCII, 3 characters 3 bytes"
NSQ_SOURCE_LINE 00003096 "  b: UTF8 on, non-ASCII, 3 characters 5 bytes"
NSQ_SOURCE_LINE 00003097 "  Strings differ at index 2: a[2]=c, b[2]=\\x{263A}"
NSQ_SOURCE_LINE 00003098 ""
NSQ_SOURCE_LINE 00003099 "If $a and $b are identical in both the characters they contain I<and>"
NSQ_SOURCE_LINE 00003100 "their physical encoding then data_diff() returns an empty string."
NSQ_SOURCE_LINE 00003101 "If $logical is true then physical encoding differences are ignored"
NSQ_SOURCE_LINE 00003102 "(but are still reported if there is a difference in the characters)."
NSQ_SOURCE_LINE 00003103 ""
NSQ_SOURCE_LINE 00003104 "The data_diff() function was added in DBI 1.46."
NSQ_SOURCE_LINE 00003105 ""
NSQ_SOURCE_LINE 00003106 "=head3 C<neat>"
NSQ_SOURCE_LINE 00003107 ""
NSQ_SOURCE_LINE 00003108 "  $str = neat($value);"
NSQ_SOURCE_LINE 00003109 "  $str = neat($value, $maxlen);"
NSQ_SOURCE_LINE 00003110 ""
NSQ_SOURCE_LINE 00003111 "Return a string containing a neat (and tidy) representation of the"
NSQ_SOURCE_LINE 00003112 "supplied value."
NSQ_SOURCE_LINE 00003113 ""
NSQ_SOURCE_LINE 00003114 "Strings will be quoted, although internal quotes will I<not> be escaped."
NSQ_SOURCE_LINE 00003115 "Values known to be numeric will be unquoted. Undefined (NULL) values"
NSQ_SOURCE_LINE 00003116 "will be shown as C<undef> (without quotes)."
NSQ_SOURCE_LINE 00003117 ""
NSQ_SOURCE_LINE 00003118 "If the string is flagged internally as utf8 then double quotes will"
NSQ_SOURCE_LINE 00003119 "be used, otherwise single quotes are used and unprintable characters"
NSQ_SOURCE_LINE 00003120 "will be replaced by dot (.)."
NSQ_SOURCE_LINE 00003121 ""
NSQ_SOURCE_LINE 00003122 "For result strings longer than C<$maxlen> the result string will be"
NSQ_SOURCE_LINE 00003123 "truncated to C<$maxlen-4> and \"C<...'>\" will be appended.  If C<$maxlen> is 0"
NSQ_SOURCE_LINE 00003124 "or C<undef>, it defaults to C<$DBI::neat_maxlen> which, in turn, defaults to 400."
NSQ_SOURCE_LINE 00003125 ""
NSQ_SOURCE_LINE 00003126 "This function is designed to format values for human consumption."
NSQ_SOURCE_LINE 00003127 "It is used internally by the DBI for L</trace> output. It should"
NSQ_SOURCE_LINE 00003128 "typically I<not> be used for formatting values for database use."
NSQ_SOURCE_LINE 00003129 "(See also L</quote>.)"
NSQ_SOURCE_LINE 00003130 ""
NSQ_SOURCE_LINE 00003131 "=head3 C<neat_list>"
NSQ_SOURCE_LINE 00003132 ""
NSQ_SOURCE_LINE 00003133 "  $str = neat_list(\\@listref, $maxlen, $field_sep);"
NSQ_SOURCE_LINE 00003134 ""
NSQ_SOURCE_LINE 00003135 "Calls C<neat> on each element of the list and returns a string"
NSQ_SOURCE_LINE 00003136 "containing the results joined with C<$field_sep>. C<$field_sep> defaults"
NSQ_SOURCE_LINE 00003137 "to C<\", \">."
NSQ_SOURCE_LINE 00003138 ""
NSQ_SOURCE_LINE 00003139 "=head3 C<looks_like_number>"
NSQ_SOURCE_LINE 00003140 ""
NSQ_SOURCE_LINE 00003141 "  @bool = looks_like_number(@array);"
NSQ_SOURCE_LINE 00003142 ""
NSQ_SOURCE_LINE 00003143 "Returns true for each element that looks like a number."
NSQ_SOURCE_LINE 00003144 "Returns false for each element that does not look like a number."
NSQ_SOURCE_LINE 00003145 "Returns C<undef> for each element that is undefined or empty."
NSQ_SOURCE_LINE 00003146 ""
NSQ_SOURCE_LINE 00003147 "=head3 C<hash>"
NSQ_SOURCE_LINE 00003148 ""
NSQ_SOURCE_LINE 00003149 "  $hash_value = DBI::hash($buffer, $type);"
NSQ_SOURCE_LINE 00003150 ""
NSQ_SOURCE_LINE 00003151 "Return a 32-bit integer 'hash' value corresponding to the contents of $buffer."
NSQ_SOURCE_LINE 00003152 "The $type parameter selects which kind of hash algorithm should be used."
NSQ_SOURCE_LINE 00003153 ""
NSQ_SOURCE_LINE 00003154 "For the technically curious, type 0 (which is the default if $type"
NSQ_SOURCE_LINE 00003155 "isn't specified) is based on the Perl 5.1 hash except that the value"
NSQ_SOURCE_LINE 00003156 "is forced to be negative (for obscure historical reasons)."
NSQ_SOURCE_LINE 00003157 "Type 1 is the better \"Fowler / Noll / Vo\" (FNV) hash. See"
NSQ_SOURCE_LINE 00003158 "L<http://www.isthe.com/chongo/tech/comp/fnv/> for more information."
NSQ_SOURCE_LINE 00003159 "Both types are implemented in C and are very fast."
NSQ_SOURCE_LINE 00003160 ""
NSQ_SOURCE_LINE 00003161 "This function doesn't have much to do with databases, except that"
NSQ_SOURCE_LINE 00003162 "it can sometimes be handy to store such values in a database."
NSQ_SOURCE_LINE 00003163 "It also doesn't have much to do with perl hashes, like %foo."
NSQ_SOURCE_LINE 00003164 ""
NSQ_SOURCE_LINE 00003165 "=head3 C<sql_type_cast>"
NSQ_SOURCE_LINE 00003166 ""
NSQ_SOURCE_LINE 00003167 "  $sts = DBI::sql_type_cast($sv, $sql_type, $flags);"
NSQ_SOURCE_LINE 00003168 ""
NSQ_SOURCE_LINE 00003169 "sql_type_cast attempts to cast C<$sv> to the SQL type (see L<DBI"
NSQ_SOURCE_LINE 00003170 "Constants>) specified in C<$sql_type>. At present only the SQL types"
NSQ_SOURCE_LINE 00003171 "C<SQL_INTEGER>, C<SQL_DOUBLE> and C<SQL_NUMERIC> are supported."
NSQ_SOURCE_LINE 00003172 ""
NSQ_SOURCE_LINE 00003173 "For C<SQL_INTEGER> the effect is similar to using the value in an expression"
NSQ_SOURCE_LINE 00003174 "that requires an integer. It gives the perl scalar an 'integer aspect'."
NSQ_SOURCE_LINE 00003175 "(Technically the value gains an IV, or possibly a UV or NV if the value is too"
NSQ_SOURCE_LINE 00003176 "large for an IV.)"
NSQ_SOURCE_LINE 00003177 ""
NSQ_SOURCE_LINE 00003178 "For C<SQL_DOUBLE> the effect is similar to using the value in an expression"
NSQ_SOURCE_LINE 00003179 "that requires a general numeric value. It gives the perl scalar a 'numeric"
NSQ_SOURCE_LINE 00003180 "aspect'.  (Technically the value gains an NV.)"
NSQ_SOURCE_LINE 00003181 ""
NSQ_SOURCE_LINE 00003182 "C<SQL_NUMERIC> is similar to C<SQL_INTEGER> or C<SQL_DOUBLE> but more"
NSQ_SOURCE_LINE 00003183 "general and more cautious.  It will look at the string first and if it"
NSQ_SOURCE_LINE 00003184 "looks like an integer (that will fit in an IV or UV) it will act like"
NSQ_SOURCE_LINE 00003185 "C<SQL_INTEGER>, if it looks like a floating point value it will act"
NSQ_SOURCE_LINE 00003186 "like C<SQL_DOUBLE>, if it looks like neither then it will do nothing -"
NSQ_SOURCE_LINE 00003187 "and thereby avoid the warnings that would be generated by"
NSQ_SOURCE_LINE 00003188 "C<SQL_INTEGER> and C<SQL_DOUBLE> when given non-numeric data."
NSQ_SOURCE_LINE 00003189 ""
NSQ_SOURCE_LINE 00003190 "C<$flags> may be:"
NSQ_SOURCE_LINE 00003191 ""
NSQ_SOURCE_LINE 00003192 "=over 4"
NSQ_SOURCE_LINE 00003193 ""
NSQ_SOURCE_LINE 00003194 "=item C<DBIstcf_DISCARD_STRING>"
NSQ_SOURCE_LINE 00003195 ""
NSQ_SOURCE_LINE 00003196 "If this flag is specified then when the driver successfully casts the"
NSQ_SOURCE_LINE 00003197 "bound perl scalar to a non-string type then the string portion of the"
NSQ_SOURCE_LINE 00003198 "scalar will be discarded."
NSQ_SOURCE_LINE 00003199 ""
NSQ_SOURCE_LINE 00003200 "=item C<DBIstcf_STRICT>"
NSQ_SOURCE_LINE 00003201 ""
NSQ_SOURCE_LINE 00003202 "If C<$sv> cannot be cast to the requested C<$sql_type> then by default"
NSQ_SOURCE_LINE 00003203 "it is left untouched and no error is generated. If you specify"
NSQ_SOURCE_LINE 00003204 "C<DBIstcf_STRICT> and the cast fails, this will generate an error."
NSQ_SOURCE_LINE 00003205 ""
NSQ_SOURCE_LINE 00003206 "=back"
NSQ_SOURCE_LINE 00003207 ""
NSQ_SOURCE_LINE 00003208 "The returned C<$sts> value is:"
NSQ_SOURCE_LINE 00003209 ""
NSQ_SOURCE_LINE 00003210 "  -2 sql_type is not handled"
NSQ_SOURCE_LINE 00003211 "  -1 sv is undef so unchanged"
NSQ_SOURCE_LINE 00003212 "   0 sv could not be cast cleanly and DBIstcf_STRICT was used"
NSQ_SOURCE_LINE 00003213 "   1 sv could not be cast and DBIstcf_STRICT was not used"
NSQ_SOURCE_LINE 00003214 "   2 sv was cast successfully"
NSQ_SOURCE_LINE 00003215 ""
NSQ_SOURCE_LINE 00003216 "This method is exported by the :utils tag and was introduced in DBI"
NSQ_SOURCE_LINE 00003217 "1.611."
NSQ_SOURCE_LINE 00003218 ""
NSQ_SOURCE_LINE 00003219 "=head2 DBI Dynamic Attributes"
NSQ_SOURCE_LINE 00003220 ""
NSQ_SOURCE_LINE 00003221 "Dynamic attributes are always associated with the I<last handle used>"
NSQ_SOURCE_LINE 00003222 "(that handle is represented by C<$h> in the descriptions below)."
NSQ_SOURCE_LINE 00003223 ""
NSQ_SOURCE_LINE 00003224 "Where an attribute is equivalent to a method call, then refer to"
NSQ_SOURCE_LINE 00003225 "the method call for all related documentation."
NSQ_SOURCE_LINE 00003226 ""
NSQ_SOURCE_LINE 00003227 "Warning: these attributes are provided as a convenience but they"
NSQ_SOURCE_LINE 00003228 "do have limitations. Specifically, they have a short lifespan:"
NSQ_SOURCE_LINE 00003229 "because they are associated with"
NSQ_SOURCE_LINE 00003230 "the last handle used, they should only be used I<immediately> after"
NSQ_SOURCE_LINE 00003231 "calling the method that \"sets\" them."
NSQ_SOURCE_LINE 00003232 "If in any doubt, use the corresponding method call."
NSQ_SOURCE_LINE 00003233 ""
NSQ_SOURCE_LINE 00003234 "=head3 C<$DBI::err>"
NSQ_SOURCE_LINE 00003235 ""
NSQ_SOURCE_LINE 00003236 "Equivalent to C<$h-E<gt>err>."
NSQ_SOURCE_LINE 00003237 ""
NSQ_SOURCE_LINE 00003238 "=head3 C<$DBI::errstr>"
NSQ_SOURCE_LINE 00003239 ""
NSQ_SOURCE_LINE 00003240 "Equivalent to C<$h-E<gt>errstr>."
NSQ_SOURCE_LINE 00003241 ""
NSQ_SOURCE_LINE 00003242 "=head3 C<$DBI::state>"
NSQ_SOURCE_LINE 00003243 ""
NSQ_SOURCE_LINE 00003244 "Equivalent to C<$h-E<gt>state>."
NSQ_SOURCE_LINE 00003245 ""
NSQ_SOURCE_LINE 00003246 "=head3 C<$DBI::rows>"
NSQ_SOURCE_LINE 00003247 ""
NSQ_SOURCE_LINE 00003248 "Equivalent to C<$h-E<gt>rows>. Please refer to the documentation"
NSQ_SOURCE_LINE 00003249 "for the L</rows> method."
NSQ_SOURCE_LINE 00003250 ""
NSQ_SOURCE_LINE 00003251 "=head3 C<$DBI::lasth>"
NSQ_SOURCE_LINE 00003252 ""
NSQ_SOURCE_LINE 00003253 "Returns the DBI object handle used for the most recent DBI method call."
NSQ_SOURCE_LINE 00003254 "If the last DBI method call was a DESTROY then $DBI::lasth will return"
NSQ_SOURCE_LINE 00003255 "the handle of the parent of the destroyed handle, if there is one."
NSQ_SOURCE_LINE 00003256 ""
NSQ_SOURCE_LINE 00003257 ""
NSQ_SOURCE_LINE 00003258 "=head1 METHODS COMMON TO ALL HANDLES"
NSQ_SOURCE_LINE 00003259 ""
NSQ_SOURCE_LINE 00003260 "The following methods can be used by all types of DBI handles."
NSQ_SOURCE_LINE 00003261 ""
NSQ_SOURCE_LINE 00003262 "=head3 C<err>"
NSQ_SOURCE_LINE 00003263 ""
NSQ_SOURCE_LINE 00003264 "  $rv = $h->err;"
NSQ_SOURCE_LINE 00003265 ""
NSQ_SOURCE_LINE 00003266 "Returns the I<native> database engine error code from the last driver"
NSQ_SOURCE_LINE 00003267 "method called. The code is typically an integer but you should not"
NSQ_SOURCE_LINE 00003268 "assume that."
NSQ_SOURCE_LINE 00003269 ""
NSQ_SOURCE_LINE 00003270 "The DBI resets $h->err to undef before almost all DBI method calls, so the"
NSQ_SOURCE_LINE 00003271 "value only has a short lifespan. Also, for most drivers, the statement"
NSQ_SOURCE_LINE 00003272 "handles share the same error variable as the parent database handle,"
NSQ_SOURCE_LINE 00003273 "so calling a method on one handle may reset the error on the"
NSQ_SOURCE_LINE 00003274 "related handles."
NSQ_SOURCE_LINE 00003275 ""
NSQ_SOURCE_LINE 00003276 "(Methods which don't reset err before being called include err() and errstr(),"
NSQ_SOURCE_LINE 00003277 "obviously, state(), rows(), func(), trace(), trace_msg(), ping(), and the"
NSQ_SOURCE_LINE 00003278 "tied hash attribute FETCH() and STORE() methods.)"
NSQ_SOURCE_LINE 00003279 ""
NSQ_SOURCE_LINE 00003280 "If you need to test for specific error conditions I<and> have your program be"
NSQ_SOURCE_LINE 00003281 "portable to different database engines, then you'll need to determine what the"
NSQ_SOURCE_LINE 00003282 "corresponding error codes are for all those engines and test for all of them."
NSQ_SOURCE_LINE 00003283 ""
NSQ_SOURCE_LINE 00003284 "The DBI uses the value of $DBI::stderr as the C<err> value for internal errors."
NSQ_SOURCE_LINE 00003285 "Drivers should also do likewise.  The default value for $DBI::stderr is 2000000000."
NSQ_SOURCE_LINE 00003286 ""
NSQ_SOURCE_LINE 00003287 "A driver may return C<0> from err() to indicate a warning condition"
NSQ_SOURCE_LINE 00003288 "after a method call. Similarly, a driver may return an empty string"
NSQ_SOURCE_LINE 00003289 "to indicate a 'success with information' condition. In both these"
NSQ_SOURCE_LINE 00003290 "cases the value is false but not undef. The errstr() and state()"
NSQ_SOURCE_LINE 00003291 "methods may be used to retrieve extra information in these cases."
NSQ_SOURCE_LINE 00003292 ""
NSQ_SOURCE_LINE 00003293 "See L</set_err> for more information."
NSQ_SOURCE_LINE 00003294 ""
NSQ_SOURCE_LINE 00003295 "=head3 C<errstr>"
NSQ_SOURCE_LINE 00003296 ""
NSQ_SOURCE_LINE 00003297 "  $str = $h->errstr;"
NSQ_SOURCE_LINE 00003298 ""
NSQ_SOURCE_LINE 00003299 "Returns the native database engine error message from the last DBI"
NSQ_SOURCE_LINE 00003300 "method called. This has the same lifespan issues as the L</err> method"
NSQ_SOURCE_LINE 00003301 "described above."
NSQ_SOURCE_LINE 00003302 ""
NSQ_SOURCE_LINE 00003303 "The returned string may contain multiple messages separated by"
NSQ_SOURCE_LINE 00003304 "newline characters."
NSQ_SOURCE_LINE 00003305 ""
NSQ_SOURCE_LINE 00003306 "The errstr() method should not be used to test for errors, use err()"
NSQ_SOURCE_LINE 00003307 "for that, because drivers may return 'success with information' or"
NSQ_SOURCE_LINE 00003308 "warning messages via errstr() for methods that have not 'failed'."
NSQ_SOURCE_LINE 00003309 ""
NSQ_SOURCE_LINE 00003310 "See L</set_err> for more information."
NSQ_SOURCE_LINE 00003311 ""
NSQ_SOURCE_LINE 00003312 "=head3 C<state>"
NSQ_SOURCE_LINE 00003313 ""
NSQ_SOURCE_LINE 00003314 "  $str = $h->state;"
NSQ_SOURCE_LINE 00003315 ""
NSQ_SOURCE_LINE 00003316 "Returns a state code in the standard SQLSTATE five character format."
NSQ_SOURCE_LINE 00003317 "Note that the specific success code C<00000> is translated to any empty string"
NSQ_SOURCE_LINE 00003318 "(false). If the driver does not support SQLSTATE (and most don't),"
NSQ_SOURCE_LINE 00003319 "then state() will return C<S1000> (General Error) for all errors."
NSQ_SOURCE_LINE 00003320 ""
NSQ_SOURCE_LINE 00003321 "The driver is free to return any value via C<state>, e.g., warning"
NSQ_SOURCE_LINE 00003322 "codes, even if it has not declared an error by returning a true value"
NSQ_SOURCE_LINE 00003323 "via the L</err> method described above."
NSQ_SOURCE_LINE 00003324 ""
NSQ_SOURCE_LINE 00003325 "The state() method should not be used to test for errors, use err()"
NSQ_SOURCE_LINE 00003326 "for that, because drivers may return a 'success with information' or"
NSQ_SOURCE_LINE 00003327 "warning state code via state() for methods that have not 'failed'."
NSQ_SOURCE_LINE 00003328 ""
NSQ_SOURCE_LINE 00003329 "=head3 C<set_err>"
NSQ_SOURCE_LINE 00003330 ""
NSQ_SOURCE_LINE 00003331 "  $rv = $h->set_err($err, $errstr);"
NSQ_SOURCE_LINE 00003332 "  $rv = $h->set_err($err, $errstr, $state);"
NSQ_SOURCE_LINE 00003333 "  $rv = $h->set_err($err, $errstr, $state, $method);"
NSQ_SOURCE_LINE 00003334 "  $rv = $h->set_err($err, $errstr, $state, $method, $rv);"
NSQ_SOURCE_LINE 00003335 ""
NSQ_SOURCE_LINE 00003336 "Set the C<err>, C<errstr>, and C<state> values for the handle."
NSQ_SOURCE_LINE 00003337 "This method is typically only used by DBI drivers and DBI subclasses."
NSQ_SOURCE_LINE 00003338 ""
NSQ_SOURCE_LINE 00003339 "If the L</HandleSetErr> attribute holds a reference to a subroutine"
NSQ_SOURCE_LINE 00003340 "it is called first. The subroutine can alter the $err, $errstr, $state,"
NSQ_SOURCE_LINE 00003341 "and $method values. See L</HandleSetErr> for full details."
NSQ_SOURCE_LINE 00003342 "If the subroutine returns a true value then the handle C<err>,"
NSQ_SOURCE_LINE 00003343 "C<errstr>, and C<state> values are not altered and set_err() returns"
NSQ_SOURCE_LINE 00003344 "an empty list (it normally returns $rv which defaults to undef, see below)."
NSQ_SOURCE_LINE 00003345 ""
NSQ_SOURCE_LINE 00003346 "Setting C<err> to a I<true> value indicates an error and will trigger"
NSQ_SOURCE_LINE 00003347 "the normal DBI error handling mechanisms, such as C<RaiseError> and"
NSQ_SOURCE_LINE 00003348 "C<HandleError>, if they are enabled, when execution returns from"
NSQ_SOURCE_LINE 00003349 "the DBI back to the application."
NSQ_SOURCE_LINE 00003350 ""
NSQ_SOURCE_LINE 00003351 "Setting C<err> to C<\"\"> indicates an 'information' state, and setting"
NSQ_SOURCE_LINE 00003352 "it to C<\"0\"> indicates a 'warning' state. Setting C<err> to C<undef>"
NSQ_SOURCE_LINE 00003353 "also sets C<errstr> to undef, and C<state> to C<\"\">, irrespective"
NSQ_SOURCE_LINE 00003354 "of the values of the $errstr and $state parameters."
NSQ_SOURCE_LINE 00003355 ""
NSQ_SOURCE_LINE 00003356 "The $method parameter provides an alternate method name for the"
NSQ_SOURCE_LINE 00003357 "C<RaiseError>/C<PrintError>/C<RaiseWarn>/C<PrintWarn> error string instead of"
NSQ_SOURCE_LINE 00003358 "the fairly unhelpful 'C<set_err>'."
NSQ_SOURCE_LINE 00003359 ""
NSQ_SOURCE_LINE 00003360 "The C<set_err> method normally returns undef.  The $rv parameter"
NSQ_SOURCE_LINE 00003361 "provides an alternate return value."
NSQ_SOURCE_LINE 00003362 ""
NSQ_SOURCE_LINE 00003363 "Some special rules apply if the C<err> or C<errstr>"
NSQ_SOURCE_LINE 00003364 "values for the handle are I<already> set..."
NSQ_SOURCE_LINE 00003365 ""
NSQ_SOURCE_LINE 00003366 "If C<errstr> is true then: \"C< [err was %s now %s]>\" is appended if $err is"
NSQ_SOURCE_LINE 00003367 "true and C<err> is already true and the new err value differs from the original"
NSQ_SOURCE_LINE 00003368 "one. Similarly \"C< [state was %s now %s]>\" is appended if $state is true and C<state> is"
NSQ_SOURCE_LINE 00003369 "already true and the new state value differs from the original one. Finally"
NSQ_SOURCE_LINE 00003370 "\"C<\\n>\" and the new $errstr are appended if $errstr differs from the existing"
NSQ_SOURCE_LINE 00003371 "errstr value. Obviously the C<%s>'s above are replaced by the corresponding values."
NSQ_SOURCE_LINE 00003372 ""
NSQ_SOURCE_LINE 00003373 "The handle C<err> value is set to $err if: $err is true; or handle"
NSQ_SOURCE_LINE 00003374 "C<err> value is undef; or $err is defined and the length is greater"
NSQ_SOURCE_LINE 00003375 "than the handle C<err> length. The effect is that an 'information'"
NSQ_SOURCE_LINE 00003376 "state only overrides undef; a 'warning' overrides undef or 'information',"
NSQ_SOURCE_LINE 00003377 "and an 'error' state overrides anything."
NSQ_SOURCE_LINE 00003378 ""
NSQ_SOURCE_LINE 00003379 "The handle C<state> value is set to $state if $state is true and"
NSQ_SOURCE_LINE 00003380 "the handle C<err> value was set (by the rules above)."
NSQ_SOURCE_LINE 00003381 ""
NSQ_SOURCE_LINE 00003382 "Support for warning and information states was added in DBI 1.41."
NSQ_SOURCE_LINE 00003383 ""
NSQ_SOURCE_LINE 00003384 "=head3 C<trace>"
NSQ_SOURCE_LINE 00003385 ""
NSQ_SOURCE_LINE 00003386 "  $h->trace($trace_settings);"
NSQ_SOURCE_LINE 00003387 "  $h->trace($trace_settings, $trace_filename);"
NSQ_SOURCE_LINE 00003388 "  $trace_settings = $h->trace;"
NSQ_SOURCE_LINE 00003389 ""
NSQ_SOURCE_LINE 00003390 "The trace() method is used to alter the trace settings for a handle"
NSQ_SOURCE_LINE 00003391 "(and any future children of that handle).  It can also be used to"
NSQ_SOURCE_LINE 00003392 "change where the trace output is sent."
NSQ_SOURCE_LINE 00003393 ""
NSQ_SOURCE_LINE 00003394 "There's a similar method, C<DBI-E<gt>trace>, which sets the global"
NSQ_SOURCE_LINE 00003395 "default trace settings."
NSQ_SOURCE_LINE 00003396 ""
NSQ_SOURCE_LINE 00003397 "See the L</TRACING> section for full details about the DBI's powerful"
NSQ_SOURCE_LINE 00003398 "tracing facilities."
NSQ_SOURCE_LINE 00003399 ""
NSQ_SOURCE_LINE 00003400 "=head3 C<trace_msg>"
NSQ_SOURCE_LINE 00003401 ""
NSQ_SOURCE_LINE 00003402 "  $h->trace_msg($message_text);"
NSQ_SOURCE_LINE 00003403 "  $h->trace_msg($message_text, $min_level);"
NSQ_SOURCE_LINE 00003404 ""
NSQ_SOURCE_LINE 00003405 "Writes C<$message_text> to the trace file if the trace level is"
NSQ_SOURCE_LINE 00003406 "greater than or equal to $min_level (which defaults to 1)."
NSQ_SOURCE_LINE 00003407 "Can also be called as C<DBI-E<gt>trace_msg($msg)>."
NSQ_SOURCE_LINE 00003408 ""
NSQ_SOURCE_LINE 00003409 "See L</TRACING> for more details."
NSQ_SOURCE_LINE 00003410 ""
NSQ_SOURCE_LINE 00003411 "=head3 C<func>"
NSQ_SOURCE_LINE 00003412 ""
NSQ_SOURCE_LINE 00003413 "  $h->func(@func_arguments, $func_name) or die ...;"
NSQ_SOURCE_LINE 00003414 ""
NSQ_SOURCE_LINE 00003415 "The C<func> method can be used to call private non-standard and"
NSQ_SOURCE_LINE 00003416 "non-portable methods implemented by the driver. Note that the function"
NSQ_SOURCE_LINE 00003417 "name is given as the I<last> argument."
NSQ_SOURCE_LINE 00003418 ""
NSQ_SOURCE_LINE 00003419 "It's also important to note that the func() method does not clear"
NSQ_SOURCE_LINE 00003420 "a previous error ($DBI::err etc.) and it does not trigger automatic"
NSQ_SOURCE_LINE 00003421 "error detection (RaiseError etc.) so you must check the return"
NSQ_SOURCE_LINE 00003422 "status and/or $h->err to detect errors."
NSQ_SOURCE_LINE 00003423 ""
NSQ_SOURCE_LINE 00003424 "(This method is not directly related to calling stored procedures."
NSQ_SOURCE_LINE 00003425 "Calling stored procedures is currently not defined by the DBI."
NSQ_SOURCE_LINE 00003426 "Some drivers, such as DBD::Oracle, support it in non-portable ways."
NSQ_SOURCE_LINE 00003427 "See driver documentation for more details.)"
NSQ_SOURCE_LINE 00003428 ""
NSQ_SOURCE_LINE 00003429 "See also install_method() in L<DBI::DBD> for how you can avoid needing to"
NSQ_SOURCE_LINE 00003430 "use func() and gain direct access to driver-private methods."
NSQ_SOURCE_LINE 00003431 ""
NSQ_SOURCE_LINE 00003432 "=head3 C<can>"
NSQ_SOURCE_LINE 00003433 ""
NSQ_SOURCE_LINE 00003434 "  $is_implemented = $h->can($method_name);"
NSQ_SOURCE_LINE 00003435 ""
NSQ_SOURCE_LINE 00003436 "Returns true if $method_name is implemented by the driver or a"
NSQ_SOURCE_LINE 00003437 "default method is provided by the DBI's driver base class."
NSQ_SOURCE_LINE 00003438 "It returns false where a driver hasn't implemented a method and the"
NSQ_SOURCE_LINE 00003439 "default method is provided by the DBI's driver base class is just an empty stub."
NSQ_SOURCE_LINE 00003440 ""
NSQ_SOURCE_LINE 00003441 "=head3 C<parse_trace_flags>"
NSQ_SOURCE_LINE 00003442 ""
NSQ_SOURCE_LINE 00003443 "  $trace_settings_integer = $h->parse_trace_flags($trace_settings);"
NSQ_SOURCE_LINE 00003444 ""
NSQ_SOURCE_LINE 00003445 "Parses a string containing trace settings and returns the corresponding"
NSQ_SOURCE_LINE 00003446 "integer value used internally by the DBI and drivers."
NSQ_SOURCE_LINE 00003447 ""
NSQ_SOURCE_LINE 00003448 "The $trace_settings argument is a string containing a trace level"
NSQ_SOURCE_LINE 00003449 "between 0 and 15 and/or trace flag names separated by vertical bar"
NSQ_SOURCE_LINE 00003450 "(\"C<|>\") or comma (\"C<,>\") characters. For example: C<\"SQL|3|foo\">."
NSQ_SOURCE_LINE 00003451 ""
NSQ_SOURCE_LINE 00003452 "It uses the parse_trace_flag() method, described below, to process"
NSQ_SOURCE_LINE 00003453 "the individual trace flag names."
NSQ_SOURCE_LINE 00003454 ""
NSQ_SOURCE_LINE 00003455 "The parse_trace_flags() method was added in DBI 1.42."
NSQ_SOURCE_LINE 00003456 ""
NSQ_SOURCE_LINE 00003457 "=head3 C<parse_trace_flag>"
NSQ_SOURCE_LINE 00003458 ""
NSQ_SOURCE_LINE 00003459 "  $bit_flag = $h->parse_trace_flag($trace_flag_name);"
NSQ_SOURCE_LINE 00003460 ""
NSQ_SOURCE_LINE 00003461 "Returns the bit flag corresponding to the trace flag name in"
NSQ_SOURCE_LINE 00003462 "$trace_flag_name.  Drivers are expected to override this method and"
NSQ_SOURCE_LINE 00003463 "check if $trace_flag_name is a driver specific trace flags and, if"
NSQ_SOURCE_LINE 00003464 "not, then call the DBI's default parse_trace_flag()."
NSQ_SOURCE_LINE 00003465 ""
NSQ_SOURCE_LINE 00003466 "The parse_trace_flag() method was added in DBI 1.42."
NSQ_SOURCE_LINE 00003467 ""
NSQ_SOURCE_LINE 00003468 "=head3 C<private_attribute_info>"
NSQ_SOURCE_LINE 00003469 ""
NSQ_SOURCE_LINE 00003470 "  $hash_ref = $h->private_attribute_info();"
NSQ_SOURCE_LINE 00003471 ""
NSQ_SOURCE_LINE 00003472 "Returns a reference to a hash whose keys are the names of driver-private"
NSQ_SOURCE_LINE 00003473 "handle attributes available for the kind of handle (driver, database, statement)"
NSQ_SOURCE_LINE 00003474 "that the method was called on."
NSQ_SOURCE_LINE 00003475 ""
NSQ_SOURCE_LINE 00003476 "For example, the return value when called with a DBD::Sybase $dbh could look like this:"
NSQ_SOURCE_LINE 00003477 ""
NSQ_SOURCE_LINE 00003478 "  {"
NSQ_SOURCE_LINE 00003479 "      syb_dynamic_supported => undef,"
NSQ_SOURCE_LINE 00003480 "      syb_oc_version => undef,"
NSQ_SOURCE_LINE 00003481 "      syb_server_version => undef,"
NSQ_SOURCE_LINE 00003482 "      syb_server_version_string => undef,"
NSQ_SOURCE_LINE 00003483 "  }"
NSQ_SOURCE_LINE 00003484 ""
NSQ_SOURCE_LINE 00003485 "and when called with a DBD::Sybase $sth they could look like this:"
NSQ_SOURCE_LINE 00003486 ""
NSQ_SOURCE_LINE 00003487 "  {"
NSQ_SOURCE_LINE 00003488 "      syb_types => undef,"
NSQ_SOURCE_LINE 00003489 "      syb_proc_status => undef,"
NSQ_SOURCE_LINE 00003490 "      syb_result_type => undef,"
NSQ_SOURCE_LINE 00003491 "  }"
NSQ_SOURCE_LINE 00003492 ""
NSQ_SOURCE_LINE 00003493 "The values should be undef. Meanings may be assigned to particular values in future."
NSQ_SOURCE_LINE 00003494 ""
NSQ_SOURCE_LINE 00003495 "=head3 C<swap_inner_handle>"
NSQ_SOURCE_LINE 00003496 ""
NSQ_SOURCE_LINE 00003497 "  $rc = $h1->swap_inner_handle( $h2 );"
NSQ_SOURCE_LINE 00003498 "  $rc = $h1->swap_inner_handle( $h2, $allow_reparent );"
NSQ_SOURCE_LINE 00003499 ""
NSQ_SOURCE_LINE 00003500 "Brain transplants for handles. You don't need to know about this"
NSQ_SOURCE_LINE 00003501 "unless you want to become a handle surgeon."
NSQ_SOURCE_LINE 00003502 ""
NSQ_SOURCE_LINE 00003503 "A DBI handle is a reference to a tied hash. A tied hash has an"
NSQ_SOURCE_LINE 00003504 "I<inner> hash that actually holds the contents.  The swap_inner_handle()"
NSQ_SOURCE_LINE 00003505 "method swaps the inner hashes between two handles. The $h1 and $h2"
NSQ_SOURCE_LINE 00003506 "handles still point to the same tied hashes, but what those hashes"
NSQ_SOURCE_LINE 00003507 "are tied to has been swapped.  In effect $h1 I<becomes> $h2 and"
NSQ_SOURCE_LINE 00003508 "vice-versa. This is powerful stuff, expect problems. Use with care."
NSQ_SOURCE_LINE 00003509 ""
NSQ_SOURCE_LINE 00003510 "As a small safety measure, the two handles, $h1 and $h2, have to"
NSQ_SOURCE_LINE 00003511 "share the same parent unless $allow_reparent is true."
NSQ_SOURCE_LINE 00003512 ""
NSQ_SOURCE_LINE 00003513 "The swap_inner_handle() method was added in DBI 1.44."
NSQ_SOURCE_LINE 00003514 ""
NSQ_SOURCE_LINE 00003515 "Here's a quick kind of 'diagram' as a worked example to help think about what's"
NSQ_SOURCE_LINE 00003516 "happening:"
NSQ_SOURCE_LINE 00003517 ""
NSQ_SOURCE_LINE 00003518 "    Original state:"
NSQ_SOURCE_LINE 00003519 "            dbh1o -> dbh1i"
NSQ_SOURCE_LINE 00003520 "            sthAo -> sthAi(dbh1i)"
NSQ_SOURCE_LINE 00003521 "            dbh2o -> dbh2i"
NSQ_SOURCE_LINE 00003522 ""
NSQ_SOURCE_LINE 00003523 "    swap_inner_handle dbh1o with dbh2o:"
NSQ_SOURCE_LINE 00003524 "            dbh2o -> dbh1i"
NSQ_SOURCE_LINE 00003525 "            sthAo -> sthAi(dbh1i)"
NSQ_SOURCE_LINE 00003526 "            dbh1o -> dbh2i"
NSQ_SOURCE_LINE 00003527 ""
NSQ_SOURCE_LINE 00003528 "    create new sth from dbh1o:"
NSQ_SOURCE_LINE 00003529 "            dbh2o -> dbh1i"
NSQ_SOURCE_LINE 00003530 "            sthAo -> sthAi(dbh1i)"
NSQ_SOURCE_LINE 00003531 "            dbh1o -> dbh2i"
NSQ_SOURCE_LINE 00003532 "            sthBo -> sthBi(dbh2i)"
NSQ_SOURCE_LINE 00003533 ""
NSQ_SOURCE_LINE 00003534 "    swap_inner_handle sthAo with sthBo:"
NSQ_SOURCE_LINE 00003535 "            dbh2o -> dbh1i"
NSQ_SOURCE_LINE 00003536 "            sthBo -> sthAi(dbh1i)"
NSQ_SOURCE_LINE 00003537 "            dbh1o -> dbh2i"
NSQ_SOURCE_LINE 00003538 "            sthAo -> sthBi(dbh2i)"
NSQ_SOURCE_LINE 00003539 ""
NSQ_SOURCE_LINE 00003540 "=head3 C<visit_child_handles>"
NSQ_SOURCE_LINE 00003541 ""
NSQ_SOURCE_LINE 00003542 "  $h->visit_child_handles( $coderef );"
NSQ_SOURCE_LINE 00003543 "  $h->visit_child_handles( $coderef, $info );"
NSQ_SOURCE_LINE 00003544 ""
NSQ_SOURCE_LINE 00003545 "Where $coderef is a reference to a subroutine and $info is an arbitrary value"
NSQ_SOURCE_LINE 00003546 "which, if undefined, defaults to a reference to an empty hash. Returns $info."
NSQ_SOURCE_LINE 00003547 ""
NSQ_SOURCE_LINE 00003548 "For each child handle of $h, if any, $coderef is invoked as:"
NSQ_SOURCE_LINE 00003549 ""
NSQ_SOURCE_LINE 00003550 "  $coderef->($child_handle, $info);"
NSQ_SOURCE_LINE 00003551 ""
NSQ_SOURCE_LINE 00003552 "If the execution of $coderef returns a true value then C<visit_child_handles>"
NSQ_SOURCE_LINE 00003553 "is called on that child handle and passed the returned value as $info."
NSQ_SOURCE_LINE 00003554 ""
NSQ_SOURCE_LINE 00003555 "For example:"
NSQ_SOURCE_LINE 00003556 ""
NSQ_SOURCE_LINE 00003557 "  # count database connections with names (DSN) matching a pattern"
NSQ_SOURCE_LINE 00003558 "  my $connections = 0;"
NSQ_SOURCE_LINE 00003559 "  $dbh->{Driver}->visit_child_handles(sub {"
NSQ_SOURCE_LINE 00003560 "      my ($h, $info) = @_;"
NSQ_SOURCE_LINE 00003561 "      ++$connections if $h->{Name} =~ /foo/;"
NSQ_SOURCE_LINE 00003562 "      return 0; # don't visit kids"
NSQ_SOURCE_LINE 00003563 "  })"
NSQ_SOURCE_LINE 00003564 ""
NSQ_SOURCE_LINE 00003565 "See also L</visit_handles>."
NSQ_SOURCE_LINE 00003566 ""
NSQ_SOURCE_LINE 00003567 "=head1 ATTRIBUTES COMMON TO ALL HANDLES"
NSQ_SOURCE_LINE 00003568 ""
NSQ_SOURCE_LINE 00003569 "These attributes are common to all types of DBI handles."
NSQ_SOURCE_LINE 00003570 ""
NSQ_SOURCE_LINE 00003571 "Some attributes are inherited by child handles. That is, the value"
NSQ_SOURCE_LINE 00003572 "of an inherited attribute in a newly created statement handle is the"
NSQ_SOURCE_LINE 00003573 "same as the value in the parent database handle. Changes to attributes"
NSQ_SOURCE_LINE 00003574 "in the new statement handle do not affect the parent database handle"
NSQ_SOURCE_LINE 00003575 "and changes to the database handle do not affect existing statement"
NSQ_SOURCE_LINE 00003576 "handles, only future ones."
NSQ_SOURCE_LINE 00003577 ""
NSQ_SOURCE_LINE 00003578 "Attempting to set or get the value of an unknown attribute generates a warning,"
NSQ_SOURCE_LINE 00003579 "except for private driver specific attributes (which all have names"
NSQ_SOURCE_LINE 00003580 "starting with a lowercase letter)."
NSQ_SOURCE_LINE 00003581 ""
NSQ_SOURCE_LINE 00003582 "Example:"
NSQ_SOURCE_LINE 00003583 ""
NSQ_SOURCE_LINE 00003584 "  $h->{AttributeName} = ...;\t# set/write"
NSQ_SOURCE_LINE 00003585 "  ... = $h->{AttributeName};\t# get/read"
NSQ_SOURCE_LINE 00003586 ""
NSQ_SOURCE_LINE 00003587 "=head3 C<Warn>"
NSQ_SOURCE_LINE 00003588 ""
NSQ_SOURCE_LINE 00003589 "Type: boolean, inherited"
NSQ_SOURCE_LINE 00003590 ""
NSQ_SOURCE_LINE 00003591 "The C<Warn> attribute enables useful warnings for certain bad"
NSQ_SOURCE_LINE 00003592 "practices. It is enabled by default and should only be disabled in"
NSQ_SOURCE_LINE 00003593 "rare circumstances.  Since warnings are generated using the Perl"
NSQ_SOURCE_LINE 00003594 "C<warn> function, they can be intercepted using the Perl C<$SIG{__WARN__}>"
NSQ_SOURCE_LINE 00003595 "hook."
NSQ_SOURCE_LINE 00003596 ""
NSQ_SOURCE_LINE 00003597 "The C<Warn> attribute is not related to the C<PrintWarn> attribute."
NSQ_SOURCE_LINE 00003598 ""
NSQ_SOURCE_LINE 00003599 "=head3 C<Active>"
NSQ_SOURCE_LINE 00003600 ""
NSQ_SOURCE_LINE 00003601 "Type: boolean, read-only"
NSQ_SOURCE_LINE 00003602 ""
NSQ_SOURCE_LINE 00003603 "The C<Active> attribute is true if the handle object is \"active\". This is rarely used in"
NSQ_SOURCE_LINE 00003604 "applications. The exact meaning of active is somewhat vague at the"
NSQ_SOURCE_LINE 00003605 "moment. For a database handle it typically means that the handle is"
NSQ_SOURCE_LINE 00003606 "connected to a database (C<$dbh-E<gt>disconnect> sets C<Active> off).  For"
NSQ_SOURCE_LINE 00003607 "a statement handle it typically means that the handle is a C<SELECT>"
NSQ_SOURCE_LINE 00003608 "that may have more data to fetch. (Fetching all the data or calling C<$sth-E<gt>finish>"
NSQ_SOURCE_LINE 00003609 "sets C<Active> off.)"
NSQ_SOURCE_LINE 00003610 ""
NSQ_SOURCE_LINE 00003611 "=head3 C<Executed>"
NSQ_SOURCE_LINE 00003612 ""
NSQ_SOURCE_LINE 00003613 "Type: boolean"
NSQ_SOURCE_LINE 00003614 ""
NSQ_SOURCE_LINE 00003615 "The C<Executed> attribute is true if the handle object has been \"executed\"."
NSQ_SOURCE_LINE 00003616 "Currently only the $dbh do() method and the $sth execute(), execute_array(),"
NSQ_SOURCE_LINE 00003617 "and execute_for_fetch() methods set the C<Executed> attribute."
NSQ_SOURCE_LINE 00003618 ""
NSQ_SOURCE_LINE 00003619 "When it's set on a handle it is also set on the parent handle at the"
NSQ_SOURCE_LINE 00003620 "same time. So calling execute() on a $sth also sets the C<Executed>"
NSQ_SOURCE_LINE 00003621 "attribute on the parent $dbh."
NSQ_SOURCE_LINE 00003622 ""
NSQ_SOURCE_LINE 00003623 "The C<Executed> attribute for a database handle is cleared by the commit() and"
NSQ_SOURCE_LINE 00003624 "rollback() methods (even if they fail). The C<Executed> attribute of a"
NSQ_SOURCE_LINE 00003625 "statement handle is not cleared by the DBI under any circumstances and so acts"
NSQ_SOURCE_LINE 00003626 "as a permanent record of whether the statement handle was ever used."
NSQ_SOURCE_LINE 00003627 ""
NSQ_SOURCE_LINE 00003628 "The C<Executed> attribute was added in DBI 1.41."
NSQ_SOURCE_LINE 00003629 ""
NSQ_SOURCE_LINE 00003630 "=head3 C<Kids>"
NSQ_SOURCE_LINE 00003631 ""
NSQ_SOURCE_LINE 00003632 "Type: integer, read-only"
NSQ_SOURCE_LINE 00003633 ""
NSQ_SOURCE_LINE 00003634 "For a driver handle, C<Kids> is the number of currently existing database"
NSQ_SOURCE_LINE 00003635 "handles that were created from that driver handle.  For a database"
NSQ_SOURCE_LINE 00003636 "handle, C<Kids> is the number of currently existing statement handles that"
NSQ_SOURCE_LINE 00003637 "were created from that database handle."
NSQ_SOURCE_LINE 00003638 "For a statement handle, the value is zero."
NSQ_SOURCE_LINE 00003639 ""
NSQ_SOURCE_LINE 00003640 "=head3 C<ActiveKids>"
NSQ_SOURCE_LINE 00003641 ""
NSQ_SOURCE_LINE 00003642 "Type: integer, read-only"
NSQ_SOURCE_LINE 00003643 ""
NSQ_SOURCE_LINE 00003644 "Like C<Kids>, but only counting those that are C<Active> (as above)."
NSQ_SOURCE_LINE 00003645 ""
NSQ_SOURCE_LINE 00003646 "=head3 C<CachedKids>"
NSQ_SOURCE_LINE 00003647 ""
NSQ_SOURCE_LINE 00003648 "Type: hash ref"
NSQ_SOURCE_LINE 00003649 ""
NSQ_SOURCE_LINE 00003650 "For a database handle, C<CachedKids> returns a reference to the cache (hash) of"
NSQ_SOURCE_LINE 00003651 "statement handles created by the L</prepare_cached> method.  For a"
NSQ_SOURCE_LINE 00003652 "driver handle, returns a reference to the cache (hash) of"
NSQ_SOURCE_LINE 00003653 "database handles created by the L</connect_cached> method."
NSQ_SOURCE_LINE 00003654 ""
NSQ_SOURCE_LINE 00003655 "=head3 C<Type>"
NSQ_SOURCE_LINE 00003656 ""
NSQ_SOURCE_LINE 00003657 "Type: scalar, read-only"
NSQ_SOURCE_LINE 00003658 ""
NSQ_SOURCE_LINE 00003659 "The C<Type> attribute identifies the type of a DBI handle.  Returns"
NSQ_SOURCE_LINE 00003660 "\"dr\" for driver handles, \"db\" for database handles and \"st\" for"
NSQ_SOURCE_LINE 00003661 "statement handles."
NSQ_SOURCE_LINE 00003662 ""
NSQ_SOURCE_LINE 00003663 "=head3 C<ChildHandles>"
NSQ_SOURCE_LINE 00003664 ""
NSQ_SOURCE_LINE 00003665 "Type: array ref"
NSQ_SOURCE_LINE 00003666 ""
NSQ_SOURCE_LINE 00003667 "The ChildHandles attribute contains a reference to an array of all the"
NSQ_SOURCE_LINE 00003668 "handles created by this handle which are still accessible.  The"
NSQ_SOURCE_LINE 00003669 "contents of the array are weak-refs and will become undef when the"
NSQ_SOURCE_LINE 00003670 "handle goes out of scope. (They're cleared out occasionally.)"
NSQ_SOURCE_LINE 00003671 ""
NSQ_SOURCE_LINE 00003672 "C<ChildHandles> returns undef if your perl version does not support weak"
NSQ_SOURCE_LINE 00003673 "references (check the L<Scalar::Util|Scalar::Util> module).  The referenced"
NSQ_SOURCE_LINE 00003674 "array returned should be treated as read-only."
NSQ_SOURCE_LINE 00003675 ""
NSQ_SOURCE_LINE 00003676 "For example, to enumerate all driver handles, database handles and"
NSQ_SOURCE_LINE 00003677 "statement handles:"
NSQ_SOURCE_LINE 00003678 ""
NSQ_SOURCE_LINE 00003679 "    sub show_child_handles {"
NSQ_SOURCE_LINE 00003680 "        my ($h, $level) = @_;"
NSQ_SOURCE_LINE 00003681 "        printf \"%sh %s %s\\n\", $h->{Type}, \"\\t\" x $level, $h;"
NSQ_SOURCE_LINE 00003682 "        show_child_handles($_, $level + 1)"
NSQ_SOURCE_LINE 00003683 "            for (grep { defined } @{$h->{ChildHandles}});"
NSQ_SOURCE_LINE 00003684 "    }"
NSQ_SOURCE_LINE 00003685 ""
NSQ_SOURCE_LINE 00003686 "    my %drivers = DBI->installed_drivers();"
NSQ_SOURCE_LINE 00003687 "    show_child_handles($_, 0) for (values %drivers);"
NSQ_SOURCE_LINE 00003688 ""
NSQ_SOURCE_LINE 00003689 "=head3 C<CompatMode>"
NSQ_SOURCE_LINE 00003690 ""
NSQ_SOURCE_LINE 00003691 "Type: boolean, inherited"
NSQ_SOURCE_LINE 00003692 ""
NSQ_SOURCE_LINE 00003693 "The C<CompatMode> attribute is used by emulation layers (such as"
NSQ_SOURCE_LINE 00003694 "Oraperl) to enable compatible behaviour in the underlying driver"
NSQ_SOURCE_LINE 00003695 "(e.g., DBD::Oracle) for this handle. Not normally set by application code."
NSQ_SOURCE_LINE 00003696 ""
NSQ_SOURCE_LINE 00003697 "It also has the effect of disabling the 'quick FETCH' of attribute"
NSQ_SOURCE_LINE 00003698 "values from the handles attribute cache. So all attribute values"
NSQ_SOURCE_LINE 00003699 "are handled by the drivers own FETCH method. This makes them slightly"
NSQ_SOURCE_LINE 00003700 "slower but is useful for special-purpose drivers like DBD::Multiplex."
NSQ_SOURCE_LINE 00003701 ""
NSQ_SOURCE_LINE 00003702 "=head3 C<InactiveDestroy>"
NSQ_SOURCE_LINE 00003703 ""
NSQ_SOURCE_LINE 00003704 "Type: boolean"
NSQ_SOURCE_LINE 00003705 ""
NSQ_SOURCE_LINE 00003706 "The default value, false, means a handle will be fully destroyed"
NSQ_SOURCE_LINE 00003707 "as normal when the last reference to it is removed, just as you'd expect."
NSQ_SOURCE_LINE 00003708 ""
NSQ_SOURCE_LINE 00003709 "If set true then the handle will be treated by the DESTROY as if it was no"
NSQ_SOURCE_LINE 00003710 "longer Active, and so the I<database engine> related effects of DESTROYing a"
NSQ_SOURCE_LINE 00003711 "handle will be skipped.  Think of the name as meaning 'treat the handle as"
NSQ_SOURCE_LINE 00003712 "not-Active in the DESTROY method'."
NSQ_SOURCE_LINE 00003713 ""
NSQ_SOURCE_LINE 00003714 "For a database handle, this attribute does not disable an I<explicit>"
NSQ_SOURCE_LINE 00003715 "call to the disconnect method, only the implicit call from DESTROY"
NSQ_SOURCE_LINE 00003716 "that happens if the handle is still marked as C<Active>."
NSQ_SOURCE_LINE 00003717 ""
NSQ_SOURCE_LINE 00003718 "This attribute is specifically designed for use in Unix applications"
NSQ_SOURCE_LINE 00003719 "that \"fork\" child processes.  For some drivers, when the child process exits"
NSQ_SOURCE_LINE 00003720 "the destruction of inherited handles cause the corresponding handles in the"
NSQ_SOURCE_LINE 00003721 "parent process to cease working."
NSQ_SOURCE_LINE 00003722 ""
NSQ_SOURCE_LINE 00003723 "Either the parent or the child process, but not both, should set"
NSQ_SOURCE_LINE 00003724 "C<InactiveDestroy> true on all their shared handles. Alternatively, and"
NSQ_SOURCE_LINE 00003725 "preferably, the L</AutoInactiveDestroy> can be set in the parent on connect."
NSQ_SOURCE_LINE 00003726 ""
NSQ_SOURCE_LINE 00003727 "To help tracing applications using fork the process id is shown in"
NSQ_SOURCE_LINE 00003728 "the trace log whenever a DBI or handle trace() method is called."
NSQ_SOURCE_LINE 00003729 "The process id also shown for I<every> method call if the DBI trace"
NSQ_SOURCE_LINE 00003730 "level (not handle trace level) is set high enough to show the trace"
NSQ_SOURCE_LINE 00003731 "from the DBI's method dispatcher, e.g. >= 9."
NSQ_SOURCE_LINE 00003732 ""
NSQ_SOURCE_LINE 00003733 "=head3 C<AutoInactiveDestroy>"
NSQ_SOURCE_LINE 00003734 ""
NSQ_SOURCE_LINE 00003735 "Type: boolean, inherited"
NSQ_SOURCE_LINE 00003736 ""
NSQ_SOURCE_LINE 00003737 "The L</InactiveDestroy> attribute, described above, needs to be explicitly set"
NSQ_SOURCE_LINE 00003738 "in the child process after a fork(), on every active database and statement handle."
NSQ_SOURCE_LINE 00003739 "This is a problem if the code that performs the fork() is not under your"
NSQ_SOURCE_LINE 00003740 "control, perhaps in a third-party module.  Use C<AutoInactiveDestroy> to get"
NSQ_SOURCE_LINE 00003741 "around this situation."
NSQ_SOURCE_LINE 00003742 ""
NSQ_SOURCE_LINE 00003743 "If set true, the DESTROY method will check the process id of the handle and, if"
NSQ_SOURCE_LINE 00003744 "different from the current process id, it will set the I<InactiveDestroy> attribute."
NSQ_SOURCE_LINE 00003745 "It is strongly recommended that C<AutoInactiveDestroy> is enabled on all new code"
NSQ_SOURCE_LINE 00003746 "(it's only not enabled by default to avoid backwards compatibility problems)."
NSQ_SOURCE_LINE 00003747 ""
NSQ_SOURCE_LINE 00003748 "This is the example it's designed to deal with:"
NSQ_SOURCE_LINE 00003749 ""
NSQ_SOURCE_LINE 00003750 "    my $dbh = DBI->connect(...);"
NSQ_SOURCE_LINE 00003751 "    some_code_that_forks(); # Perhaps without your knowledge"
NSQ_SOURCE_LINE 00003752 "    # Child process dies, destroying the inherited dbh"
NSQ_SOURCE_LINE 00003753 "    $dbh->do(...); # Breaks because parent $dbh is now broken"
NSQ_SOURCE_LINE 00003754 ""
NSQ_SOURCE_LINE 00003755 "The C<AutoInactiveDestroy> attribute was added in DBI 1.614."
NSQ_SOURCE_LINE 00003756 ""
NSQ_SOURCE_LINE 00003757 "=head3 C<PrintWarn>"
NSQ_SOURCE_LINE 00003758 ""
NSQ_SOURCE_LINE 00003759 "Type: boolean, inherited"
NSQ_SOURCE_LINE 00003760 ""
NSQ_SOURCE_LINE 00003761 "The C<PrintWarn> attribute controls the printing of warnings recorded"
NSQ_SOURCE_LINE 00003762 "by the driver.  When set to a true value (the default) the DBI will check method"
NSQ_SOURCE_LINE 00003763 "calls to see if a warning condition has been set. If so, the DBI"
NSQ_SOURCE_LINE 00003764 "will effectively do a C<warn(\"$class $method warning: $DBI::errstr\")>"
NSQ_SOURCE_LINE 00003765 "where C<$class> is the driver class and C<$method> is the name of"
NSQ_SOURCE_LINE 00003766 "the method which failed. E.g.,"
NSQ_SOURCE_LINE 00003767 ""
NSQ_SOURCE_LINE 00003768 "  DBD::Oracle::db execute warning: ... warning text here ..."
NSQ_SOURCE_LINE 00003769 ""
NSQ_SOURCE_LINE 00003770 "If desired, the warnings can be caught and processed using a C<$SIG{__WARN__}>"
NSQ_SOURCE_LINE 00003771 "handler or modules like CGI::Carp and CGI::ErrorWrap."
NSQ_SOURCE_LINE 00003772 ""
NSQ_SOURCE_LINE 00003773 "See also L</set_err> for how warnings are recorded and L</HandleSetErr>"
NSQ_SOURCE_LINE 00003774 "for how to influence it."
NSQ_SOURCE_LINE 00003775 ""
NSQ_SOURCE_LINE 00003776 "Fetching the full details of warnings can require an extra round-trip"
NSQ_SOURCE_LINE 00003777 "to the database server for some drivers. In which case the driver"
NSQ_SOURCE_LINE 00003778 "may opt to only fetch the full details of warnings if the C<PrintWarn>"
NSQ_SOURCE_LINE 00003779 "attribute is true. If C<PrintWarn> is false then these drivers should"
NSQ_SOURCE_LINE 00003780 "still indicate the fact that there were warnings by setting the"
NSQ_SOURCE_LINE 00003781 "warning string to, for example: \"3 warnings\"."
NSQ_SOURCE_LINE 00003782 ""
NSQ_SOURCE_LINE 00003783 "=head3 C<PrintError>"
NSQ_SOURCE_LINE 00003784 ""
NSQ_SOURCE_LINE 00003785 "Type: boolean, inherited"
NSQ_SOURCE_LINE 00003786 ""
NSQ_SOURCE_LINE 00003787 "The C<PrintError> attribute can be used to force errors to generate warnings (using"
NSQ_SOURCE_LINE 00003788 "C<warn>) in addition to returning error codes in the normal way.  When set"
NSQ_SOURCE_LINE 00003789 "\"on\", any method which results in an error occurring will cause the DBI to"
NSQ_SOURCE_LINE 00003790 "effectively do a C<warn(\"$class $method failed: $DBI::errstr\")> where C<$class>"
NSQ_SOURCE_LINE 00003791 "is the driver class and C<$method> is the name of the method which failed. E.g.,"
NSQ_SOURCE_LINE 00003792 ""
NSQ_SOURCE_LINE 00003793 "  DBD::Oracle::db prepare failed: ... error text here ..."
NSQ_SOURCE_LINE 00003794 ""
NSQ_SOURCE_LINE 00003795 "By default, C<DBI-E<gt>connect> sets C<PrintError> \"on\"."
NSQ_SOURCE_LINE 00003796 ""
NSQ_SOURCE_LINE 00003797 "If desired, the warnings can be caught and processed using a C<$SIG{__WARN__}>"
NSQ_SOURCE_LINE 00003798 "handler or modules like CGI::Carp and CGI::ErrorWrap."
NSQ_SOURCE_LINE 00003799 ""
NSQ_SOURCE_LINE 00003800 "=head3 C<RaiseWarn>"
NSQ_SOURCE_LINE 00003801 ""
NSQ_SOURCE_LINE 00003802 "Type: boolean, inherited"
NSQ_SOURCE_LINE 00003803 ""
NSQ_SOURCE_LINE 00003804 "The C<RaiseWarn> attribute can be used to force warnings to raise exceptions rather"
NSQ_SOURCE_LINE 00003805 "then simply printing them. It is \"off\" by default."
NSQ_SOURCE_LINE 00003806 "When set \"on\", any method which sets warning condition will cause"
NSQ_SOURCE_LINE 00003807 "the DBI to effectively do a C<die(\"$class $method warning: $DBI::errstr\")>,"
NSQ_SOURCE_LINE 00003808 "where C<$class> is the driver class and C<$method> is the name of the method"
NSQ_SOURCE_LINE 00003809 "that sets warning condition. E.g.,"
NSQ_SOURCE_LINE 00003810 ""
NSQ_SOURCE_LINE 00003811 "  DBD::Oracle::db execute warning: ... warning text here ..."
NSQ_SOURCE_LINE 00003812 ""
NSQ_SOURCE_LINE 00003813 "If you turn C<RaiseWarn> on then you'd normally turn C<PrintWarn> off."
NSQ_SOURCE_LINE 00003814 "If C<PrintWarn> is also on, then the C<PrintWarn> is done first (naturally)."
NSQ_SOURCE_LINE 00003815 ""
NSQ_SOURCE_LINE 00003816 "This attribute was added in DBI 1.643."
NSQ_SOURCE_LINE 00003817 ""
NSQ_SOURCE_LINE 00003818 "=head3 C<RaiseError>"
NSQ_SOURCE_LINE 00003819 ""
NSQ_SOURCE_LINE 00003820 "Type: boolean, inherited"
NSQ_SOURCE_LINE 00003821 ""
NSQ_SOURCE_LINE 00003822 "The C<RaiseError> attribute can be used to force errors to raise exceptions rather"
NSQ_SOURCE_LINE 00003823 "than simply return error codes in the normal way. It is \"off\" by default."
NSQ_SOURCE_LINE 00003824 "When set \"on\", any method which results in an error will cause"
NSQ_SOURCE_LINE 00003825 "the DBI to effectively do a C<die(\"$class $method failed: $DBI::errstr\")>,"
NSQ_SOURCE_LINE 00003826 "where C<$class> is the driver class and C<$method> is the name of the method"
NSQ_SOURCE_LINE 00003827 "that failed. E.g.,"
NSQ_SOURCE_LINE 00003828 ""
NSQ_SOURCE_LINE 00003829 "  DBD::Oracle::db prepare failed: ... error text here ..."
NSQ_SOURCE_LINE 00003830 ""
NSQ_SOURCE_LINE 00003831 "If you turn C<RaiseError> on then you'd normally turn C<PrintError> off."
NSQ_SOURCE_LINE 00003832 "If C<PrintError> is also on, then the C<PrintError> is done first (naturally)."
NSQ_SOURCE_LINE 00003833 ""
NSQ_SOURCE_LINE 00003834 "Typically C<RaiseError> is used in conjunction with C<eval>,"
NSQ_SOURCE_LINE 00003835 "or a module like L<Try::Tiny> or L<TryCatch>,"
NSQ_SOURCE_LINE 00003836 "to catch the exception that's been thrown and handle it."
NSQ_SOURCE_LINE 00003837 "For example:"
NSQ_SOURCE_LINE 00003838 ""
NSQ_SOURCE_LINE 00003839 "  use Try::Tiny;"
NSQ_SOURCE_LINE 00003840 ""
NSQ_SOURCE_LINE 00003841 "  try {"
NSQ_SOURCE_LINE 00003842 "    ..."
NSQ_SOURCE_LINE 00003843 "    $sth->execute();"
NSQ_SOURCE_LINE 00003844 "    ..."
NSQ_SOURCE_LINE 00003845 "  } catch {"
NSQ_SOURCE_LINE 00003846 "    # $sth->err and $DBI::err will be true if error was from DBI"
NSQ_SOURCE_LINE 00003847 "    warn $_; # print the error (which Try::Tiny puts into $_)"
NSQ_SOURCE_LINE 00003848 "    ... # do whatever you need to deal with the error"
NSQ_SOURCE_LINE 00003849 "  };"
NSQ_SOURCE_LINE 00003850 ""
NSQ_SOURCE_LINE 00003851 "In the catch block the $DBI::lasth variable can be useful for"
NSQ_SOURCE_LINE 00003852 "diagnosis and reporting if you can't be sure which handle triggered"
NSQ_SOURCE_LINE 00003853 "the error.  For example, $DBI::lasth->{Type} and $DBI::lasth->{Statement}."
NSQ_SOURCE_LINE 00003854 ""
NSQ_SOURCE_LINE 00003855 "See also L</Transactions>."
NSQ_SOURCE_LINE 00003856 ""
NSQ_SOURCE_LINE 00003857 "If you want to temporarily turn C<RaiseError> off (inside a library function"
NSQ_SOURCE_LINE 00003858 "that is likely to fail, for example), the recommended way is like this:"
NSQ_SOURCE_LINE 00003859 ""
NSQ_SOURCE_LINE 00003860 "  {"
NSQ_SOURCE_LINE 00003861 "    local $h->{RaiseError};  # localize and turn off for this block"
NSQ_SOURCE_LINE 00003862 "    ..."
NSQ_SOURCE_LINE 00003863 "  }"
NSQ_SOURCE_LINE 00003864 ""
NSQ_SOURCE_LINE 00003865 "The original value will automatically and reliably be restored by Perl,"
NSQ_SOURCE_LINE 00003866 "regardless of how the block is exited."
NSQ_SOURCE_LINE 00003867 "The same logic applies to other attributes, including C<PrintError>."
NSQ_SOURCE_LINE 00003868 ""
NSQ_SOURCE_LINE 00003869 "=head3 C<HandleError>"
NSQ_SOURCE_LINE 00003870 ""
NSQ_SOURCE_LINE 00003871 "Type: code ref, inherited"
NSQ_SOURCE_LINE 00003872 ""
NSQ_SOURCE_LINE 00003873 "The C<HandleError> attribute can be used to provide your own alternative behaviour"
NSQ_SOURCE_LINE 00003874 "in case of errors. If set to a reference to a subroutine then that"
NSQ_SOURCE_LINE 00003875 "subroutine is called when an error is detected (at the same point that"
NSQ_SOURCE_LINE 00003876 "C<RaiseError> and C<PrintError> are handled). It is called also when"
NSQ_SOURCE_LINE 00003877 "C<RaiseWarn> is enabled and a warning is detected."
NSQ_SOURCE_LINE 00003878 ""
NSQ_SOURCE_LINE 00003879 "The subroutine is called with three parameters: the error message"
NSQ_SOURCE_LINE 00003880 "string that C<RaiseError>, C<RaiseWarn> or C<PrintError> would use,"
NSQ_SOURCE_LINE 00003881 "the DBI handle being used, and the first value being returned by"
NSQ_SOURCE_LINE 00003882 "the method that failed (typically undef)."
NSQ_SOURCE_LINE 00003883 ""
NSQ_SOURCE_LINE 00003884 "If the subroutine returns a false value then the C<RaiseError>, C<RaiseWarn>"
NSQ_SOURCE_LINE 00003885 "and/or C<PrintError> attributes are checked and acted upon as normal."
NSQ_SOURCE_LINE 00003886 ""
NSQ_SOURCE_LINE 00003887 "For example, to C<die> with a full stack trace for any error:"
NSQ_SOURCE_LINE 00003888 ""
NSQ_SOURCE_LINE 00003889 "  use Carp;"
NSQ_SOURCE_LINE 00003890 "  $h->{HandleError} = sub { confess(shift) };"
NSQ_SOURCE_LINE 00003891 ""
NSQ_SOURCE_LINE 00003892 "Or to turn errors into exceptions:"
NSQ_SOURCE_LINE 00003893 ""
NSQ_SOURCE_LINE 00003894 "  use Exception; # or your own favourite exception module"
NSQ_SOURCE_LINE 00003895 "  $h->{HandleError} = sub { Exception->new('DBI')->raise($_[0]) };"
NSQ_SOURCE_LINE 00003896 ""
NSQ_SOURCE_LINE 00003897 "It is possible to 'stack' multiple HandleError handlers by using"
NSQ_SOURCE_LINE 00003898 "closures:"
NSQ_SOURCE_LINE 00003899 ""
NSQ_SOURCE_LINE 00003900 "  sub your_subroutine {"
NSQ_SOURCE_LINE 00003901 "    my $previous_handler = $h->{HandleError};"
NSQ_SOURCE_LINE 00003902 "    $h->{HandleError} = sub {"
NSQ_SOURCE_LINE 00003903 "      return 1 if $previous_handler and &$previous_handler(@_);"
NSQ_SOURCE_LINE 00003904 "      ... your code here ..."
NSQ_SOURCE_LINE 00003905 "    };"
NSQ_SOURCE_LINE 00003906 "  }"
NSQ_SOURCE_LINE 00003907 ""
NSQ_SOURCE_LINE 00003908 "Using a C<my> inside a subroutine to store the previous C<HandleError>"
NSQ_SOURCE_LINE 00003909 "value is important.  See L<perlsub> and L<perlref> for more information"
NSQ_SOURCE_LINE 00003910 "about I<closures>."
NSQ_SOURCE_LINE 00003911 ""
NSQ_SOURCE_LINE 00003912 "It is possible for C<HandleError> to alter the error message that"
NSQ_SOURCE_LINE 00003913 "will be used by C<RaiseError>, C<RaiseWarn> and C<PrintError> if it returns false."
NSQ_SOURCE_LINE 00003914 "It can do that by altering the value of $_[0]. This example appends"
NSQ_SOURCE_LINE 00003915 "a stack trace to all errors and, unlike the previous example using"
NSQ_SOURCE_LINE 00003916 "Carp::confess, this will work C<PrintError> as well as C<RaiseError>:"
NSQ_SOURCE_LINE 00003917 ""
NSQ_SOURCE_LINE 00003918 "  $h->{HandleError} = sub { $_[0]=Carp::longmess($_[0]); 0; };"
NSQ_SOURCE_LINE 00003919 ""
NSQ_SOURCE_LINE 00003920 "It is also possible for C<HandleError> to hide an error, to a limited"
NSQ_SOURCE_LINE 00003921 "degree, by using L</set_err> to reset $DBI::err and $DBI::errstr,"
NSQ_SOURCE_LINE 00003922 "and altering the return value of the failed method. For example:"
NSQ_SOURCE_LINE 00003923 ""
NSQ_SOURCE_LINE 00003924 "  $h->{HandleError} = sub {"
NSQ_SOURCE_LINE 00003925 "    return 0 unless $_[0] =~ /^\\S+ fetchrow_arrayref failed:/;"
NSQ_SOURCE_LINE 00003926 "    return 0 unless $_[1]->err == 1234; # the error to 'hide'"
NSQ_SOURCE_LINE 00003927 "    $h->set_err(undef,undef);\t# turn off the error"
NSQ_SOURCE_LINE 00003928 "    $_[2] = [ ... ];\t# supply alternative return value"
NSQ_SOURCE_LINE 00003929 "    return 1;"
NSQ_SOURCE_LINE 00003930 "  };"
NSQ_SOURCE_LINE 00003931 ""
NSQ_SOURCE_LINE 00003932 "This only works for methods which return a single value and is hard"
NSQ_SOURCE_LINE 00003933 "to make reliable (avoiding infinite loops, for example) and so isn't"
NSQ_SOURCE_LINE 00003934 "recommended for general use!  If you find a I<good> use for it then"
NSQ_SOURCE_LINE 00003935 "please let me know."
NSQ_SOURCE_LINE 00003936 ""
NSQ_SOURCE_LINE 00003937 "=head3 C<HandleSetErr>"
NSQ_SOURCE_LINE 00003938 ""
NSQ_SOURCE_LINE 00003939 "Type: code ref, inherited"
NSQ_SOURCE_LINE 00003940 ""
NSQ_SOURCE_LINE 00003941 "The C<HandleSetErr> attribute can be used to intercept"
NSQ_SOURCE_LINE 00003942 "the setting of handle C<err>, C<errstr>, and C<state> values."
NSQ_SOURCE_LINE 00003943 "If set to a reference to a subroutine then that subroutine is called"
NSQ_SOURCE_LINE 00003944 "whenever set_err() is called, typically by the driver or a subclass."
NSQ_SOURCE_LINE 00003945 ""
NSQ_SOURCE_LINE 00003946 "The subroutine is called with five arguments, the first five that"
NSQ_SOURCE_LINE 00003947 "were passed to set_err(): the handle, the C<err>, C<errstr>, and"
NSQ_SOURCE_LINE 00003948 "C<state> values being set, and the method name. These can be altered"
NSQ_SOURCE_LINE 00003949 "by changing the values in the @_ array. The return value affects"
NSQ_SOURCE_LINE 00003950 "set_err() behaviour, see L</set_err> for details."
NSQ_SOURCE_LINE 00003951 ""
NSQ_SOURCE_LINE 00003952 "It is possible to 'stack' multiple HandleSetErr handlers by using"
NSQ_SOURCE_LINE 00003953 "closures. See L</HandleError> for an example."
NSQ_SOURCE_LINE 00003954 ""
NSQ_SOURCE_LINE 00003955 "The C<HandleSetErr> and C<HandleError> subroutines differ in subtle"
NSQ_SOURCE_LINE 00003956 "but significant ways. HandleError is only invoked at the point where"
NSQ_SOURCE_LINE 00003957 "the DBI is about to return to the application with C<err> set true."
NSQ_SOURCE_LINE 00003958 "It's not invoked by the failure of a method that's been called by"
NSQ_SOURCE_LINE 00003959 "another DBI method.  HandleSetErr, on the other hand, is called"
NSQ_SOURCE_LINE 00003960 "whenever set_err() is called with a defined C<err> value, even if false."
NSQ_SOURCE_LINE 00003961 "So it's not just for errors, despite the name, but also warn and info states."
NSQ_SOURCE_LINE 00003962 "The set_err() method, and thus HandleSetErr, may be called multiple"
NSQ_SOURCE_LINE 00003963 "times within a method and is usually invoked from deep within driver code."
NSQ_SOURCE_LINE 00003964 ""
NSQ_SOURCE_LINE 00003965 "In theory a driver can use the return value from HandleSetErr via"
NSQ_SOURCE_LINE 00003966 "set_err() to decide whether to continue or not. If set_err() returns"
NSQ_SOURCE_LINE 00003967 "an empty list, indicating that the HandleSetErr code has 'handled'"
NSQ_SOURCE_LINE 00003968 "the 'error', the driver could then continue instead of failing (if"
NSQ_SOURCE_LINE 00003969 "that's a reasonable thing to do).  This isn't excepted to be"
NSQ_SOURCE_LINE 00003970 "common and any such cases should be clearly marked in the driver"
NSQ_SOURCE_LINE 00003971 "documentation and discussed on the dbi-dev mailing list."
NSQ_SOURCE_LINE 00003972 ""
NSQ_SOURCE_LINE 00003973 "The C<HandleSetErr> attribute was added in DBI 1.41."
NSQ_SOURCE_LINE 00003974 ""
NSQ_SOURCE_LINE 00003975 "=head3 C<ErrCount>"
NSQ_SOURCE_LINE 00003976 ""
NSQ_SOURCE_LINE 00003977 "Type: unsigned integer"
NSQ_SOURCE_LINE 00003978 ""
NSQ_SOURCE_LINE 00003979 "The C<ErrCount> attribute is incremented whenever the set_err()"
NSQ_SOURCE_LINE 00003980 "method records an error. It isn't incremented by warnings or"
NSQ_SOURCE_LINE 00003981 "information states. It is not reset by the DBI at any time."
NSQ_SOURCE_LINE 00003982 ""
NSQ_SOURCE_LINE 00003983 "The C<ErrCount> attribute was added in DBI 1.41. Older drivers may"
NSQ_SOURCE_LINE 00003984 "not have been updated to use set_err() to record errors and so this"
NSQ_SOURCE_LINE 00003985 "attribute may not be incremented when using them."
NSQ_SOURCE_LINE 00003986 ""
NSQ_SOURCE_LINE 00003987 ""
NSQ_SOURCE_LINE 00003988 "=head3 C<ShowErrorStatement>"
NSQ_SOURCE_LINE 00003989 ""
NSQ_SOURCE_LINE 00003990 "Type: boolean, inherited"
NSQ_SOURCE_LINE 00003991 ""
NSQ_SOURCE_LINE 00003992 "The C<ShowErrorStatement> attribute can be used to cause the relevant"
NSQ_SOURCE_LINE 00003993 "Statement text to be appended to the error messages generated by"
NSQ_SOURCE_LINE 00003994 "the C<RaiseError>, C<PrintError>, C<RaiseWarn> and C<PrintWarn> attributes."
NSQ_SOURCE_LINE 00003995 "Only applies to errors on statement handles"
NSQ_SOURCE_LINE 00003996 "plus the prepare(), do(), and the various C<select*()> database handle methods."
NSQ_SOURCE_LINE 00003997 "(The exact format of the appended text is subject to change.)"
NSQ_SOURCE_LINE 00003998 ""
NSQ_SOURCE_LINE 00003999 "If C<$h-E<gt>{ParamValues}> returns a hash reference of parameter"
NSQ_SOURCE_LINE 00004000 "(placeholder) values then those are formatted and appended to the"
NSQ_SOURCE_LINE 00004001 "end of the Statement text in the error message."
NSQ_SOURCE_LINE 00004002 ""
NSQ_SOURCE_LINE 00004003 "=head3 C<TraceLevel>"
NSQ_SOURCE_LINE 00004004 ""
NSQ_SOURCE_LINE 00004005 "Type: integer, inherited"
NSQ_SOURCE_LINE 00004006 ""
NSQ_SOURCE_LINE 00004007 "The C<TraceLevel> attribute can be used as an alternative to the"
NSQ_SOURCE_LINE 00004008 "L</trace> method to set the DBI trace level and trace flags for a"
NSQ_SOURCE_LINE 00004009 "specific handle.  See L</TRACING> for more details."
NSQ_SOURCE_LINE 00004010 ""
NSQ_SOURCE_LINE 00004011 "The C<TraceLevel> attribute is especially useful combined with"
NSQ_SOURCE_LINE 00004012 "C<local> to alter the trace settings for just a single block of code."
NSQ_SOURCE_LINE 00004013 ""
NSQ_SOURCE_LINE 00004014 "=head3 C<FetchHashKeyName>"
NSQ_SOURCE_LINE 00004015 ""
NSQ_SOURCE_LINE 00004016 "Type: string, inherited"
NSQ_SOURCE_LINE 00004017 ""
NSQ_SOURCE_LINE 00004018 "The C<FetchHashKeyName> attribute is used to specify whether the fetchrow_hashref()"
NSQ_SOURCE_LINE 00004019 "method should perform case conversion on the field names used for"
NSQ_SOURCE_LINE 00004020 "the hash keys. For historical reasons it defaults to 'C<NAME>' but"
NSQ_SOURCE_LINE 00004021 "it is recommended to set it to 'C<NAME_lc>' (convert to lower case)"
NSQ_SOURCE_LINE 00004022 "or 'C<NAME_uc>' (convert to upper case) according to your preference."
NSQ_SOURCE_LINE 00004023 "It can only be set for driver and database handles.  For statement"
NSQ_SOURCE_LINE 00004024 "handles the value is frozen when prepare() is called."
NSQ_SOURCE_LINE 00004025 ""
NSQ_SOURCE_LINE 00004026 ""
NSQ_SOURCE_LINE 00004027 "=head3 C<ChopBlanks>"
NSQ_SOURCE_LINE 00004028 ""
NSQ_SOURCE_LINE 00004029 "Type: boolean, inherited"
NSQ_SOURCE_LINE 00004030 ""
NSQ_SOURCE_LINE 00004031 "The C<ChopBlanks> attribute can be used to control the trimming of trailing space"
NSQ_SOURCE_LINE 00004032 "characters from fixed width character (CHAR) fields. No other field"
NSQ_SOURCE_LINE 00004033 "types are affected, even where field values have trailing spaces."
NSQ_SOURCE_LINE 00004034 ""
NSQ_SOURCE_LINE 00004035 "The default is false (although it is possible that the default may change)."
NSQ_SOURCE_LINE 00004036 "Applications that need specific behaviour should set the attribute as"
NSQ_SOURCE_LINE 00004037 "needed."
NSQ_SOURCE_LINE 00004038 ""
NSQ_SOURCE_LINE 00004039 "Drivers are not required to support this attribute, but any driver which"
NSQ_SOURCE_LINE 00004040 "does not support it must arrange to return C<undef> as the attribute value."
NSQ_SOURCE_LINE 00004041 ""
NSQ_SOURCE_LINE 00004042 ""
NSQ_SOURCE_LINE 00004043 "=head3 C<LongReadLen>"
NSQ_SOURCE_LINE 00004044 ""
NSQ_SOURCE_LINE 00004045 "Type: unsigned integer, inherited"
NSQ_SOURCE_LINE 00004046 ""
NSQ_SOURCE_LINE 00004047 "The C<LongReadLen> attribute may be used to control the maximum"
NSQ_SOURCE_LINE 00004048 "length of 'long' type fields (LONG, BLOB, CLOB, MEMO, etc.) which the driver will"
NSQ_SOURCE_LINE 00004049 "read from the database automatically when it fetches each row of data."
NSQ_SOURCE_LINE 00004050 ""
NSQ_SOURCE_LINE 00004051 "The C<LongReadLen> attribute only relates to fetching and reading"
NSQ_SOURCE_LINE 00004052 "long values; it is not involved in inserting or updating them."
NSQ_SOURCE_LINE 00004053 ""
NSQ_SOURCE_LINE 00004054 "A value of 0 means not to automatically fetch any long data."
NSQ_SOURCE_LINE 00004055 "Drivers may return undef or an empty string for long fields when"
NSQ_SOURCE_LINE 00004056 "C<LongReadLen> is 0."
NSQ_SOURCE_LINE 00004057 ""
NSQ_SOURCE_LINE 00004058 "The default is typically 0 (zero) or 80 bytes but may vary between drivers."
NSQ_SOURCE_LINE 00004059 "Applications fetching long fields should set this value to slightly"
NSQ_SOURCE_LINE 00004060 "larger than the longest long field value to be fetched."
NSQ_SOURCE_LINE 00004061 ""
NSQ_SOURCE_LINE 00004062 "Some databases return some long types encoded as pairs of hex digits."
NSQ_SOURCE_LINE 00004063 "For these types, C<LongReadLen> relates to the underlying data"
NSQ_SOURCE_LINE 00004064 "length and not the doubled-up length of the encoded string."
NSQ_SOURCE_LINE 00004065 ""
NSQ_SOURCE_LINE 00004066 "Changing the value of C<LongReadLen> for a statement handle after it"
NSQ_SOURCE_LINE 00004067 "has been C<prepare>'d will typically have no effect, so it's common to"
NSQ_SOURCE_LINE 00004068 "set C<LongReadLen> on the C<$dbh> before calling C<prepare>."
NSQ_SOURCE_LINE 00004069 ""
NSQ_SOURCE_LINE 00004070 "For most drivers the value used here has a direct effect on the"
NSQ_SOURCE_LINE 00004071 "memory used by the statement handle while it's active, so don't be"
NSQ_SOURCE_LINE 00004072 "too generous. If you can't be sure what value to use you could"
NSQ_SOURCE_LINE 00004073 "execute an extra select statement to determine the longest value."
NSQ_SOURCE_LINE 00004074 "For example:"
NSQ_SOURCE_LINE 00004075 ""
NSQ_SOURCE_LINE 00004076 "  $dbh->{LongReadLen} = $dbh->selectrow_array(qq{"
NSQ_SOURCE_LINE 00004077 "      SELECT MAX(OCTET_LENGTH(long_column_name))"
NSQ_SOURCE_LINE 00004078 "      FROM table WHERE ..."
NSQ_SOURCE_LINE 00004079 "  });"
NSQ_SOURCE_LINE 00004080 "  $sth = $dbh->prepare(qq{"
NSQ_SOURCE_LINE 00004081 "      SELECT long_column_name, ... FROM table WHERE ..."
NSQ_SOURCE_LINE 00004082 "  });"
NSQ_SOURCE_LINE 00004083 ""
NSQ_SOURCE_LINE 00004084 "You may need to take extra care if the table can be modified between"
NSQ_SOURCE_LINE 00004085 "the first select and the second being executed. You may also need to"
NSQ_SOURCE_LINE 00004086 "use a different function if OCTET_LENGTH() does not work for long"
NSQ_SOURCE_LINE 00004087 "types in your database. For example, for Sybase use DATALENGTH() and"
NSQ_SOURCE_LINE 00004088 "for Oracle use LENGTHB()."
NSQ_SOURCE_LINE 00004089 ""
NSQ_SOURCE_LINE 00004090 "See also L</LongTruncOk> for information on truncation of long types."
NSQ_SOURCE_LINE 00004091 ""
NSQ_SOURCE_LINE 00004092 "=head3 C<LongTruncOk>"
NSQ_SOURCE_LINE 00004093 ""
NSQ_SOURCE_LINE 00004094 "Type: boolean, inherited"
NSQ_SOURCE_LINE 00004095 ""
NSQ_SOURCE_LINE 00004096 "The C<LongTruncOk> attribute may be used to control the effect of"
NSQ_SOURCE_LINE 00004097 "fetching a long field value which has been truncated (typically"
NSQ_SOURCE_LINE 00004098 "because it's longer than the value of the C<LongReadLen> attribute)."
NSQ_SOURCE_LINE 00004099 ""
NSQ_SOURCE_LINE 00004100 "By default, C<LongTruncOk> is false and so fetching a long value that"
NSQ_SOURCE_LINE 00004101 "needs to be truncated will cause the fetch to fail."
NSQ_SOURCE_LINE 00004102 "(Applications should always be sure to"
NSQ_SOURCE_LINE 00004103 "check for errors after a fetch loop in case an error, such as a divide"
NSQ_SOURCE_LINE 00004104 "by zero or long field truncation, caused the fetch to terminate"
NSQ_SOURCE_LINE 00004105 "prematurely.)"
NSQ_SOURCE_LINE 00004106 ""
NSQ_SOURCE_LINE 00004107 "If a fetch fails due to a long field truncation when C<LongTruncOk> is"
NSQ_SOURCE_LINE 00004108 "false, many drivers will allow you to continue fetching further rows."
NSQ_SOURCE_LINE 00004109 ""
NSQ_SOURCE_LINE 00004110 "See also L</LongReadLen>."
NSQ_SOURCE_LINE 00004111 ""
NSQ_SOURCE_LINE 00004112 "=head3 C<TaintIn>"
NSQ_SOURCE_LINE 00004113 ""
NSQ_SOURCE_LINE 00004114 "Type: boolean, inherited"
NSQ_SOURCE_LINE 00004115 ""
NSQ_SOURCE_LINE 00004116 "If the C<TaintIn> attribute is set to a true value I<and> Perl is running in"
NSQ_SOURCE_LINE 00004117 "taint mode (e.g., started with the C<-T> option), then all the arguments"
NSQ_SOURCE_LINE 00004118 "to most DBI method calls are checked for being tainted. I<This may change.>"
NSQ_SOURCE_LINE 00004119 ""
NSQ_SOURCE_LINE 00004120 "The attribute defaults to off, even if Perl is in taint mode."
NSQ_SOURCE_LINE 00004121 "See L<perlsec> for more about taint mode.  If Perl is not"
NSQ_SOURCE_LINE 00004122 "running in taint mode, this attribute has no effect."
NSQ_SOURCE_LINE 00004123 ""
NSQ_SOURCE_LINE 00004124 "When fetching data that you trust you can turn off the TaintIn attribute,"
NSQ_SOURCE_LINE 00004125 "for that statement handle, for the duration of the fetch loop."
NSQ_SOURCE_LINE 00004126 ""
NSQ_SOURCE_LINE 00004127 "The C<TaintIn> attribute was added in DBI 1.31."
NSQ_SOURCE_LINE 00004128 ""
NSQ_SOURCE_LINE 00004129 "=head3 C<TaintOut>"
NSQ_SOURCE_LINE 00004130 ""
NSQ_SOURCE_LINE 00004131 "Type: boolean, inherited"
NSQ_SOURCE_LINE 00004132 ""
NSQ_SOURCE_LINE 00004133 "If the C<TaintOut> attribute is set to a true value I<and> Perl is running in"
NSQ_SOURCE_LINE 00004134 "taint mode (e.g., started with the C<-T> option), then most data fetched"
NSQ_SOURCE_LINE 00004135 "from the database is considered tainted. I<This may change.>"
NSQ_SOURCE_LINE 00004136 ""
NSQ_SOURCE_LINE 00004137 "The attribute defaults to off, even if Perl is in taint mode."
NSQ_SOURCE_LINE 00004138 "See L<perlsec> for more about taint mode.  If Perl is not"
NSQ_SOURCE_LINE 00004139 "running in taint mode, this attribute has no effect."
NSQ_SOURCE_LINE 00004140 ""
NSQ_SOURCE_LINE 00004141 "When fetching data that you trust you can turn off the TaintOut attribute,"
NSQ_SOURCE_LINE 00004142 "for that statement handle, for the duration of the fetch loop."
NSQ_SOURCE_LINE 00004143 ""
NSQ_SOURCE_LINE 00004144 "Currently only fetched data is tainted. It is possible that the results"
NSQ_SOURCE_LINE 00004145 "of other DBI method calls, and the value of fetched attributes, may"
NSQ_SOURCE_LINE 00004146 "also be tainted in future versions. That change may well break your"
NSQ_SOURCE_LINE 00004147 "applications unless you take great care now. If you use DBI Taint mode,"
NSQ_SOURCE_LINE 00004148 "please report your experience and any suggestions for changes."
NSQ_SOURCE_LINE 00004149 ""
NSQ_SOURCE_LINE 00004150 "The C<TaintOut> attribute was added in DBI 1.31."
NSQ_SOURCE_LINE 00004151 ""
NSQ_SOURCE_LINE 00004152 "=head3 C<Taint>"
NSQ_SOURCE_LINE 00004153 ""
NSQ_SOURCE_LINE 00004154 "Type: boolean, inherited"
NSQ_SOURCE_LINE 00004155 ""
NSQ_SOURCE_LINE 00004156 "The C<Taint> attribute is a shortcut for L</TaintIn> and L</TaintOut> (it is also present"
NSQ_SOURCE_LINE 00004157 "for backwards compatibility)."
NSQ_SOURCE_LINE 00004158 ""
NSQ_SOURCE_LINE 00004159 "Setting this attribute sets both L</TaintIn> and L</TaintOut>, and retrieving"
NSQ_SOURCE_LINE 00004160 "it returns a true value if and only if L</TaintIn> and L</TaintOut> are"
NSQ_SOURCE_LINE 00004161 "both set to true values."
NSQ_SOURCE_LINE 00004162 ""
NSQ_SOURCE_LINE 00004163 "=head3 C<Profile>"
NSQ_SOURCE_LINE 00004164 ""
NSQ_SOURCE_LINE 00004165 "Type: inherited"
NSQ_SOURCE_LINE 00004166 ""
NSQ_SOURCE_LINE 00004167 "The C<Profile> attribute enables the collection and reporting of"
NSQ_SOURCE_LINE 00004168 "method call timing statistics.  See the L<DBI::Profile> module"
NSQ_SOURCE_LINE 00004169 "documentation for I<much> more detail."
NSQ_SOURCE_LINE 00004170 ""
NSQ_SOURCE_LINE 00004171 "The C<Profile> attribute was added in DBI 1.24."
NSQ_SOURCE_LINE 00004172 ""
NSQ_SOURCE_LINE 00004173 "=head3 C<ReadOnly>"
NSQ_SOURCE_LINE 00004174 ""
NSQ_SOURCE_LINE 00004175 "Type: boolean, inherited"
NSQ_SOURCE_LINE 00004176 ""
NSQ_SOURCE_LINE 00004177 "An application can set the C<ReadOnly> attribute of a handle to a true value to"
NSQ_SOURCE_LINE 00004178 "indicate that it will not be attempting to make any changes using that handle"
NSQ_SOURCE_LINE 00004179 "or any children of it."
NSQ_SOURCE_LINE 00004180 ""
NSQ_SOURCE_LINE 00004181 "Note that the exact definition of 'read only' is rather fuzzy."
NSQ_SOURCE_LINE 00004182 "For more details see the documentation for the driver you're using."
NSQ_SOURCE_LINE 00004183 ""
NSQ_SOURCE_LINE 00004184 "If the driver can make the handle truly read-only then it should"
NSQ_SOURCE_LINE 00004185 "(unless doing so would have unpleasant side effect, like changing the"
NSQ_SOURCE_LINE 00004186 "consistency level from per-statement to per-session)."
NSQ_SOURCE_LINE 00004187 "Otherwise the attribute is simply advisory."
NSQ_SOURCE_LINE 00004188 ""
NSQ_SOURCE_LINE 00004189 "A driver can set the C<ReadOnly> attribute itself to indicate that the data it"
NSQ_SOURCE_LINE 00004190 "is connected to cannot be changed for some reason."
NSQ_SOURCE_LINE 00004191 ""
NSQ_SOURCE_LINE 00004192 "If the driver cannot ensure the C<ReadOnly> attribute is adhered to it"
NSQ_SOURCE_LINE 00004193 "will record a warning.  In this case reading the C<ReadOnly> attribute"
NSQ_SOURCE_LINE 00004194 "back after it is set true will return true even if the underlying"
NSQ_SOURCE_LINE 00004195 "driver cannot ensure this (so any application knows the application"
NSQ_SOURCE_LINE 00004196 "declared itself ReadOnly)."
NSQ_SOURCE_LINE 00004197 ""
NSQ_SOURCE_LINE 00004198 "Library modules and proxy drivers can use the attribute to influence"
NSQ_SOURCE_LINE 00004199 "their behavior.  For example, the DBD::Gofer driver considers the"
NSQ_SOURCE_LINE 00004200 "C<ReadOnly> attribute when making a decision about whether to retry an"
NSQ_SOURCE_LINE 00004201 "operation that failed."
NSQ_SOURCE_LINE 00004202 ""
NSQ_SOURCE_LINE 00004203 "The attribute should be set to 1 or 0 (or undef). Other values are reserved."
NSQ_SOURCE_LINE 00004204 ""
NSQ_SOURCE_LINE 00004205 "=head3 C<Callbacks>"
NSQ_SOURCE_LINE 00004206 ""
NSQ_SOURCE_LINE 00004207 "Type: hash ref"
NSQ_SOURCE_LINE 00004208 ""
NSQ_SOURCE_LINE 00004209 "The DBI callback mechanism lets you intercept, and optionally replace, any"
NSQ_SOURCE_LINE 00004210 "method call on a DBI handle. At the extreme, it lets you become a puppet"
NSQ_SOURCE_LINE 00004211 "master, deceiving the application in any way you want."
NSQ_SOURCE_LINE 00004212 ""
NSQ_SOURCE_LINE 00004213 "The C<Callbacks> attribute is a hash reference where the keys are DBI method"
NSQ_SOURCE_LINE 00004214 "names and the values are code references. For each key naming a method, the"
NSQ_SOURCE_LINE 00004215 "DBI will execute the associated code reference before executing the method."
NSQ_SOURCE_LINE 00004216 ""
NSQ_SOURCE_LINE 00004217 "The arguments to the code reference will be the same as to the method,"
NSQ_SOURCE_LINE 00004218 "including the invocant (a database handle or statement handle). For example,"
NSQ_SOURCE_LINE 00004219 "say that to callback to some code on a call to C<prepare()>:"
NSQ_SOURCE_LINE 00004220 ""
NSQ_SOURCE_LINE 00004221 "  $dbh->{Callbacks} = {"
NSQ_SOURCE_LINE 00004222 "      prepare => sub {"
NSQ_SOURCE_LINE 00004223 "          my ($dbh, $query, $attrs) = @_;"
NSQ_SOURCE_LINE 00004224 "          print \"Preparing q{$query}\\n\""
NSQ_SOURCE_LINE 00004225 "      },"
NSQ_SOURCE_LINE 00004226 "  };"
NSQ_SOURCE_LINE 00004227 ""
NSQ_SOURCE_LINE 00004228 "The callback would then be executed when you called the C<prepare()> method:"
NSQ_SOURCE_LINE 00004229 ""
NSQ_SOURCE_LINE 00004230 "  $dbh->prepare('SELECT 1');"
NSQ_SOURCE_LINE 00004231 ""
NSQ_SOURCE_LINE 00004232 "And the output of course would be:"
NSQ_SOURCE_LINE 00004233 ""
NSQ_SOURCE_LINE 00004234 "  Preparing q{SELECT 1}"
NSQ_SOURCE_LINE 00004235 ""
NSQ_SOURCE_LINE 00004236 "Because callbacks are executed I<before> the methods"
NSQ_SOURCE_LINE 00004237 "they're associated with, you can modify the arguments before they're passed on"
NSQ_SOURCE_LINE 00004238 "to the method call. For example, to make sure that all calls to C<prepare()>"
NSQ_SOURCE_LINE 00004239 "are immediately prepared by L<DBD::Pg>, add a callback that makes sure that"
NSQ_SOURCE_LINE 00004240 "the C<pg_prepare_now> attribute is always set:"
NSQ_SOURCE_LINE 00004241 ""
NSQ_SOURCE_LINE 00004242 "  my $dbh = DBI->connect($dsn, $username, $auth, {"
NSQ_SOURCE_LINE 00004243 "      Callbacks => {"
NSQ_SOURCE_LINE 00004244 "          prepare => sub {"
NSQ_SOURCE_LINE 00004245 "              $_[2] ||= {};"
NSQ_SOURCE_LINE 00004246 "              $_[2]->{pg_prepare_now} = 1;"
NSQ_SOURCE_LINE 00004247 "              return; # must return nothing"
NSQ_SOURCE_LINE 00004248 "          },"
NSQ_SOURCE_LINE 00004249 "      }"
NSQ_SOURCE_LINE 00004250 "  });"
NSQ_SOURCE_LINE 00004251 ""
NSQ_SOURCE_LINE 00004252 "Note that we are editing the contents of C<@_> directly. In this case we've"
NSQ_SOURCE_LINE 00004253 "created the attributes hash if it's not passed to the C<prepare> call."
NSQ_SOURCE_LINE 00004254 ""
NSQ_SOURCE_LINE 00004255 "You can also prevent the associated method from ever executing. While a"
NSQ_SOURCE_LINE 00004256 "callback executes, C<$_> holds the method name. (This allows multiple callbacks"
NSQ_SOURCE_LINE 00004257 "to share the same code reference and still know what method was called.)"
NSQ_SOURCE_LINE 00004258 "To prevent the method from"
NSQ_SOURCE_LINE 00004259 "executing, simply C<undef $_>. For example, if you wanted to disable calls to"
NSQ_SOURCE_LINE 00004260 "C<ping()>, you could do this:"
NSQ_SOURCE_LINE 00004261 ""
NSQ_SOURCE_LINE 00004262 "  $dbh->{Callbacks} = {"
NSQ_SOURCE_LINE 00004263 "      ping => sub {"
NSQ_SOURCE_LINE 00004264 "          # tell dispatch to not call the method:"
NSQ_SOURCE_LINE 00004265 "          undef $_;"
NSQ_SOURCE_LINE 00004266 "          # return this value instead:"
NSQ_SOURCE_LINE 00004267 "          return \"42 bells\";"
NSQ_SOURCE_LINE 00004268 "      }"
NSQ_SOURCE_LINE 00004269 "  };"
NSQ_SOURCE_LINE 00004270 ""
NSQ_SOURCE_LINE 00004271 "As with other attributes, Callbacks can be specified on a handle or via the"
NSQ_SOURCE_LINE 00004272 "attributes to C<connect()>. Callbacks can also be applied to a statement"
NSQ_SOURCE_LINE 00004273 "methods on a statement handle. For example:"
NSQ_SOURCE_LINE 00004274 ""
NSQ_SOURCE_LINE 00004275 "  $sth->{Callbacks} = {"
NSQ_SOURCE_LINE 00004276 "      execute => sub {"
NSQ_SOURCE_LINE 00004277 "          print \"Executing \", shift->{Statement}, \"\\n\";"
NSQ_SOURCE_LINE 00004278 "      }"
NSQ_SOURCE_LINE 00004279 "  };"
NSQ_SOURCE_LINE 00004280 ""
NSQ_SOURCE_LINE 00004281 "The C<Callbacks> attribute of a database handle isn't copied to any statement"
NSQ_SOURCE_LINE 00004282 "handles it creates. So setting callbacks for a statement handle requires you to"
NSQ_SOURCE_LINE 00004283 "set the C<Callbacks> attribute on the statement handle yourself, as in the"
NSQ_SOURCE_LINE 00004284 "example above, or use the special C<ChildCallbacks> key described below."
NSQ_SOURCE_LINE 00004285 ""
NSQ_SOURCE_LINE 00004286 "B<Special Keys in Callbacks Attribute>"
NSQ_SOURCE_LINE 00004287 ""
NSQ_SOURCE_LINE 00004288 "In addition to DBI handle method names, the C<Callbacks> hash reference"
NSQ_SOURCE_LINE 00004289 "supports four additional keys."
NSQ_SOURCE_LINE 00004290 ""
NSQ_SOURCE_LINE 00004291 "The first is the C<ChildCallbacks> key. When a statement handle is created from"
NSQ_SOURCE_LINE 00004292 "a database handle the C<ChildCallbacks> key of the database handle's"
NSQ_SOURCE_LINE 00004293 "C<Callbacks> attribute, if any, becomes the new C<Callbacks> attribute of the"
NSQ_SOURCE_LINE 00004294 "statement handle."
NSQ_SOURCE_LINE 00004295 "This allows you to define callbacks for all statement handles created from a"
NSQ_SOURCE_LINE 00004296 "database handle. For example, if you wanted to count how many times C<execute>"
NSQ_SOURCE_LINE 00004297 "was called in your application, you could write:"
NSQ_SOURCE_LINE 00004298 ""
NSQ_SOURCE_LINE 00004299 "  my $exec_count = 0;"
NSQ_SOURCE_LINE 00004300 "  my $dbh = DBI->connect( $dsn, $username, $auth, {"
NSQ_SOURCE_LINE 00004301 "      Callbacks => {"
NSQ_SOURCE_LINE 00004302 "          ChildCallbacks => {"
NSQ_SOURCE_LINE 00004303 "              execute => sub { $exec_count++; return; }"
NSQ_SOURCE_LINE 00004304 "          }"
NSQ_SOURCE_LINE 00004305 "      }"
NSQ_SOURCE_LINE 00004306 "  });"
NSQ_SOURCE_LINE 00004307 ""
NSQ_SOURCE_LINE 00004308 "  END {"
NSQ_SOURCE_LINE 00004309 "      print \"The execute method was called $exec_count times\\n\";"
NSQ_SOURCE_LINE 00004310 "  }"
NSQ_SOURCE_LINE 00004311 ""
NSQ_SOURCE_LINE 00004312 "The other three special keys are C<connect_cached.new>,"
NSQ_SOURCE_LINE 00004313 "C<connect_cached.connected>, and C<connect_cached.reused>. These keys define"
NSQ_SOURCE_LINE 00004314 "callbacks that are called when C<connect_cached()> is called, but allow"
NSQ_SOURCE_LINE 00004315 "different behaviors depending on whether a new handle is created or a handle"
NSQ_SOURCE_LINE 00004316 "is returned. The callback is invoked with these arguments:"
NSQ_SOURCE_LINE 00004317 "C<$dbh, $dsn, $user, $auth, $attr>."
NSQ_SOURCE_LINE 00004318 ""
NSQ_SOURCE_LINE 00004319 "For example, some applications uses C<connect_cached()> to connect with"
NSQ_SOURCE_LINE 00004320 "C<AutoCommit> enabled and then disable C<AutoCommit> temporarily for"
NSQ_SOURCE_LINE 00004321 "transactions. If C<connect_cached()> is called during a transaction, perhaps in"
NSQ_SOURCE_LINE 00004322 "a utility method, then it might select the same cached handle and then force"
NSQ_SOURCE_LINE 00004323 "C<AutoCommit> on, forcing a commit of the transaction. See the L</connect_cached>"
NSQ_SOURCE_LINE 00004324 "documentation for one way to deal with that. Here we'll describe an alternative"
NSQ_SOURCE_LINE 00004325 "approach using a callback."
NSQ_SOURCE_LINE 00004326 ""
NSQ_SOURCE_LINE 00004327 "Because the C<connect_cached.new> and C<connect_cached.reused> callbacks are"
NSQ_SOURCE_LINE 00004328 "invoked before C<connect_cached()> has applied the connect attributes, you can"
NSQ_SOURCE_LINE 00004329 "use them to edit the attributes that will be applied. To prevent a cached"
NSQ_SOURCE_LINE 00004330 "handle from having its transactions committed before it's returned, you can"
NSQ_SOURCE_LINE 00004331 "eliminate the C<AutoCommit> attribute in a C<connect_cached.reused> callback,"
NSQ_SOURCE_LINE 00004332 "like so:"
NSQ_SOURCE_LINE 00004333 ""
NSQ_SOURCE_LINE 00004334 "  my $cb = {"
NSQ_SOURCE_LINE 00004335 "      'connect_cached.reused' => sub { delete $_[4]->{AutoCommit} },"
NSQ_SOURCE_LINE 00004336 "  };"
NSQ_SOURCE_LINE 00004337 ""
NSQ_SOURCE_LINE 00004338 "  sub dbh {"
NSQ_SOURCE_LINE 00004339 "      my $self = shift;"
NSQ_SOURCE_LINE 00004340 "      DBI->connect_cached( $dsn, $username, $auth, {"
NSQ_SOURCE_LINE 00004341 "          PrintError => 0,"
NSQ_SOURCE_LINE 00004342 "          RaiseError => 1,"
NSQ_SOURCE_LINE 00004343 "          AutoCommit => 1,"
NSQ_SOURCE_LINE 00004344 "          Callbacks  => $cb,"
NSQ_SOURCE_LINE 00004345 "      });"
NSQ_SOURCE_LINE 00004346 "  }"
NSQ_SOURCE_LINE 00004347 ""
NSQ_SOURCE_LINE 00004348 "The upshot is that new database handles are created with C<AutoCommit>"
NSQ_SOURCE_LINE 00004349 "enabled, while cached database handles are left in whatever transaction state"
NSQ_SOURCE_LINE 00004350 "they happened to be in when retrieved from the cache."
NSQ_SOURCE_LINE 00004351 ""
NSQ_SOURCE_LINE 00004352 "Note that we've also used a lexical for the callbacks hash reference. This is"
NSQ_SOURCE_LINE 00004353 "because C<connect_cached()> returns a new database handle if any of the"
NSQ_SOURCE_LINE 00004354 "attributes passed to is have changed. If we used an inline hash reference,"
NSQ_SOURCE_LINE 00004355 "C<connect_cached()> would return a new database handle every time. Which would"
NSQ_SOURCE_LINE 00004356 "rather defeat the purpose."
NSQ_SOURCE_LINE 00004357 ""
NSQ_SOURCE_LINE 00004358 "A more common application for callbacks is setting connection state only when"
NSQ_SOURCE_LINE 00004359 "a new connection is made (by connect() or connect_cached()). Adding a callback"
NSQ_SOURCE_LINE 00004360 "to the connected method (when using C<connect>) or via"
NSQ_SOURCE_LINE 00004361 "C<connect_cached.connected> (when useing connect_cached()>) makes this easy."
NSQ_SOURCE_LINE 00004362 "The connected() method is a no-op by default (unless you subclass the DBI and"
NSQ_SOURCE_LINE 00004363 "change it). The DBI calls it to indicate that a new connection has been made"
NSQ_SOURCE_LINE 00004364 "and the connection attributes have all been set. You can give it a bit of"
NSQ_SOURCE_LINE 00004365 "added functionality by applying a callback to it. For example, to make sure"
NSQ_SOURCE_LINE 00004366 "that MySQL understands your application's ANSI-compliant SQL, set it up like"
NSQ_SOURCE_LINE 00004367 "so:"
NSQ_SOURCE_LINE 00004368 ""
NSQ_SOURCE_LINE 00004369 "  my $dbh = DBI->connect($dsn, $username, $auth, {"
NSQ_SOURCE_LINE 00004370 "      Callbacks => {"
NSQ_SOURCE_LINE 00004371 "          connected => sub {"
NSQ_SOURCE_LINE 00004372 "              shift->do(q{"
NSQ_SOURCE_LINE 00004373 "                  SET SESSION sql_mode='ansi,strict_trans_tables,no_auto_value_on_zero';"
NSQ_SOURCE_LINE 00004374 "              });"
NSQ_SOURCE_LINE 00004375 "              return;"
NSQ_SOURCE_LINE 00004376 "          },"
NSQ_SOURCE_LINE 00004377 "      }"
NSQ_SOURCE_LINE 00004378 "  });"
NSQ_SOURCE_LINE 00004379 ""
NSQ_SOURCE_LINE 00004380 "If you're using C<connect_cached()>, use the C<connect_cached.connected>"
NSQ_SOURCE_LINE 00004381 "callback, instead. This is because C<connected()> is called for both new and"
NSQ_SOURCE_LINE 00004382 "reused database handles, but you want to execute a callback only the when a"
NSQ_SOURCE_LINE 00004383 "new database handle is returned. For example, to set the time zone on"
NSQ_SOURCE_LINE 00004384 "connection to a PostgreSQL database, try this:"
NSQ_SOURCE_LINE 00004385 ""
NSQ_SOURCE_LINE 00004386 "  my $cb = {"
NSQ_SOURCE_LINE 00004387 "      'connect_cached.connected' => sub {"
NSQ_SOURCE_LINE 00004388 "          shift->do('SET timezone = UTC');"
NSQ_SOURCE_LINE 00004389 "      }"
NSQ_SOURCE_LINE 00004390 "  };"
NSQ_SOURCE_LINE 00004391 ""
NSQ_SOURCE_LINE 00004392 "  sub dbh {"
NSQ_SOURCE_LINE 00004393 "      my $self = shift;"
NSQ_SOURCE_LINE 00004394 "      DBI->connect_cached( $dsn, $username, $auth, { Callbacks => $cb });"
NSQ_SOURCE_LINE 00004395 "  }"
NSQ_SOURCE_LINE 00004396 ""
NSQ_SOURCE_LINE 00004397 "One significant limitation with callbacks is that there can only be one per"
NSQ_SOURCE_LINE 00004398 "method per handle. This means it's easy for one use of callbacks to interfere"
NSQ_SOURCE_LINE 00004399 "with, or typically simply overwrite, another use of callbacks. For this reason"
NSQ_SOURCE_LINE 00004400 "modules using callbacks should document the fact clearly so application authors"
NSQ_SOURCE_LINE 00004401 "can tell if use of callbacks by the module will clash with use of callbacks by"
NSQ_SOURCE_LINE 00004402 "the application."
NSQ_SOURCE_LINE 00004403 ""
NSQ_SOURCE_LINE 00004404 "You might be able to work around this issue by taking a copy of the original"
NSQ_SOURCE_LINE 00004405 "callback and calling it within your own. For example:"
NSQ_SOURCE_LINE 00004406 ""
NSQ_SOURCE_LINE 00004407 "  my $prev_cb = $h->{Callbacks}{method_name};"
NSQ_SOURCE_LINE 00004408 "  $h->{Callbacks}{method_name} = sub {"
NSQ_SOURCE_LINE 00004409 "    if ($prev_cb) {"
NSQ_SOURCE_LINE 00004410 "        my @result = $prev_cb->(@_);"
NSQ_SOURCE_LINE 00004411 "\treturn @result if not $_; # $prev_cb vetoed call"
NSQ_SOURCE_LINE 00004412 "    }"
NSQ_SOURCE_LINE 00004413 "    ... your callback logic here ..."
NSQ_SOURCE_LINE 00004414 "  };"
NSQ_SOURCE_LINE 00004415 ""
NSQ_SOURCE_LINE 00004416 "=head3 C<private_your_module_name_*>"
NSQ_SOURCE_LINE 00004417 ""
NSQ_SOURCE_LINE 00004418 "The DBI provides a way to store extra information in a DBI handle as"
NSQ_SOURCE_LINE 00004419 "\"private\" attributes. The DBI will allow you to store and retrieve any"
NSQ_SOURCE_LINE 00004420 "attribute which has a name starting with \"C<private_>\"."
NSQ_SOURCE_LINE 00004421 ""
NSQ_SOURCE_LINE 00004422 "It is I<strongly> recommended that you use just I<one> private"
NSQ_SOURCE_LINE 00004423 "attribute (e.g., use a hash ref) I<and> give it a long and unambiguous"
NSQ_SOURCE_LINE 00004424 "name that includes the module or application name that the attribute"
NSQ_SOURCE_LINE 00004425 "relates to (e.g., \"C<private_YourFullModuleName_thingy>\")."
NSQ_SOURCE_LINE 00004426 ""
NSQ_SOURCE_LINE 00004427 "Because of the way the Perl tie mechanism works you cannot reliably"
NSQ_SOURCE_LINE 00004428 "use the C<||=> operator directly to initialise the attribute, like this:"
NSQ_SOURCE_LINE 00004429 ""
NSQ_SOURCE_LINE 00004430 "  my $foo = $dbh->{private_yourmodname_foo} ||= { ... }; # WRONG"
NSQ_SOURCE_LINE 00004431 ""
NSQ_SOURCE_LINE 00004432 "you should use a two step approach like this:"
NSQ_SOURCE_LINE 00004433 ""
NSQ_SOURCE_LINE 00004434 "  my $foo = $dbh->{private_yourmodname_foo};"
NSQ_SOURCE_LINE 00004435 "  $foo ||= $dbh->{private_yourmodname_foo} = { ... };"
NSQ_SOURCE_LINE 00004436 ""
NSQ_SOURCE_LINE 00004437 "This attribute is primarily of interest to people sub-classing DBI,"
NSQ_SOURCE_LINE 00004438 "or for applications to piggy-back extra information onto DBI handles."
NSQ_SOURCE_LINE 00004439 ""
NSQ_SOURCE_LINE 00004440 "=head1 DBI DATABASE HANDLE OBJECTS"
NSQ_SOURCE_LINE 00004441 ""
NSQ_SOURCE_LINE 00004442 "This section covers the methods and attributes associated with"
NSQ_SOURCE_LINE 00004443 "database handles."
NSQ_SOURCE_LINE 00004444 ""
NSQ_SOURCE_LINE 00004445 "=head2 Database Handle Methods"
NSQ_SOURCE_LINE 00004446 ""
NSQ_SOURCE_LINE 00004447 "The following methods are specified for DBI database handles:"
NSQ_SOURCE_LINE 00004448 ""
NSQ_SOURCE_LINE 00004449 "=head3 C<clone>"
NSQ_SOURCE_LINE 00004450 ""
NSQ_SOURCE_LINE 00004451 "  $new_dbh = $dbh->clone(\\%attr);"
NSQ_SOURCE_LINE 00004452 ""
NSQ_SOURCE_LINE 00004453 "The C<clone> method duplicates the $dbh connection by connecting"
NSQ_SOURCE_LINE 00004454 "with the same parameters ($dsn, $user, $password) as originally used."
NSQ_SOURCE_LINE 00004455 ""
NSQ_SOURCE_LINE 00004456 "The attributes for the cloned connect are the same as those used"
NSQ_SOURCE_LINE 00004457 "for the I<original> connect, with any other attributes in C<\\%attr>"
NSQ_SOURCE_LINE 00004458 "merged over them.  Effectively the same as doing:"
NSQ_SOURCE_LINE 00004459 ""
NSQ_SOURCE_LINE 00004460 "  %attributes_used = ( %original_attributes, %attr );"
NSQ_SOURCE_LINE 00004461 ""
NSQ_SOURCE_LINE 00004462 "If \\%attr is not given then it defaults to a hash containing all"
NSQ_SOURCE_LINE 00004463 "the attributes in the attribute cache of $dbh excluding any non-code"
NSQ_SOURCE_LINE 00004464 "references, plus the main boolean attributes (RaiseError, PrintError,"
NSQ_SOURCE_LINE 00004465 "AutoCommit, etc.). I<This behaviour is unreliable and so use of clone without"
NSQ_SOURCE_LINE 00004466 "an argument is deprecated and may cause a warning in a future release.>"
NSQ_SOURCE_LINE 00004467 ""
NSQ_SOURCE_LINE 00004468 "The clone method can be used even if the database handle is disconnected."
NSQ_SOURCE_LINE 00004469 ""
NSQ_SOURCE_LINE 00004470 "The C<clone> method was added in DBI 1.33."
NSQ_SOURCE_LINE 00004471 ""
NSQ_SOURCE_LINE 00004472 "=head3 C<data_sources>"
NSQ_SOURCE_LINE 00004473 ""
NSQ_SOURCE_LINE 00004474 "  @ary = $dbh->data_sources();"
NSQ_SOURCE_LINE 00004475 "  @ary = $dbh->data_sources(\\%attr);"
NSQ_SOURCE_LINE 00004476 ""
NSQ_SOURCE_LINE 00004477 "Returns a list of data sources (databases) available via the $dbh"
NSQ_SOURCE_LINE 00004478 "driver's data_sources() method, plus any extra data sources that"
NSQ_SOURCE_LINE 00004479 "the driver can discover via the connected $dbh. Typically the extra"
NSQ_SOURCE_LINE 00004480 "data sources are other databases managed by the same server process"
NSQ_SOURCE_LINE 00004481 "that the $dbh is connected to."
NSQ_SOURCE_LINE 00004482 ""
NSQ_SOURCE_LINE 00004483 "Data sources are returned in a form suitable for passing to the"
NSQ_SOURCE_LINE 00004484 "L</connect> method (that is, they will include the \"C<dbi:$driver:>\" prefix)."
NSQ_SOURCE_LINE 00004485 ""
NSQ_SOURCE_LINE 00004486 "The data_sources() method, for a $dbh, was added in DBI 1.38."
NSQ_SOURCE_LINE 00004487 ""
NSQ_SOURCE_LINE 00004488 "=head3 C<do>"
NSQ_SOURCE_LINE 00004489 ""
NSQ_SOURCE_LINE 00004490 "  $rows = $dbh->do($statement)           or die $dbh->errstr;"
NSQ_SOURCE_LINE 00004491 "  $rows = $dbh->do($statement, \\%attr)   or die $dbh->errstr;"
NSQ_SOURCE_LINE 00004492 "  $rows = $dbh->do($statement, \\%attr, @bind_values) or die ..."
NSQ_SOURCE_LINE 00004493 ""
NSQ_SOURCE_LINE 00004494 "Prepare and execute a single statement. Returns the number of rows"
NSQ_SOURCE_LINE 00004495 "affected or C<undef> on error. A return value of C<-1> means the"
NSQ_SOURCE_LINE 00004496 "number of rows is not known, not applicable, or not available."
NSQ_SOURCE_LINE 00004497 ""
NSQ_SOURCE_LINE 00004498 "This method is typically most useful for I<non>-C<SELECT> statements that"
NSQ_SOURCE_LINE 00004499 "either cannot be prepared in advance (due to a limitation of the"
NSQ_SOURCE_LINE 00004500 "driver) or do not need to be executed repeatedly. It should not"
NSQ_SOURCE_LINE 00004501 "be used for C<SELECT> statements because it does not return a statement"
NSQ_SOURCE_LINE 00004502 "handle (so you can't fetch any data)."
NSQ_SOURCE_LINE 00004503 ""
NSQ_SOURCE_LINE 00004504 "The default C<do> method is logically similar to:"
NSQ_SOURCE_LINE 00004505 ""
NSQ_SOURCE_LINE 00004506 "  sub do {"
NSQ_SOURCE_LINE 00004507 "      my($dbh, $statement, $attr, @bind_values) = @_;"
NSQ_SOURCE_LINE 00004508 "      my $sth = $dbh->prepare($statement, $attr) or return undef;"
NSQ_SOURCE_LINE 00004509 "      $sth->execute(@bind_values) or return undef;"
NSQ_SOURCE_LINE 00004510 "      my $rows = $sth->rows;"
NSQ_SOURCE_LINE 00004511 "      ($rows == 0) ? \"0E0\" : $rows; # always return true if no error"
NSQ_SOURCE_LINE 00004512 "  }"
NSQ_SOURCE_LINE 00004513 ""
NSQ_SOURCE_LINE 00004514 "For example:"
NSQ_SOURCE_LINE 00004515 ""
NSQ_SOURCE_LINE 00004516 "  my $rows_deleted = $dbh->do(q{"
NSQ_SOURCE_LINE 00004517 "      DELETE FROM table"
NSQ_SOURCE_LINE 00004518 "      WHERE status = ?"
NSQ_SOURCE_LINE 00004519 "  }, undef, 'DONE') or die $dbh->errstr;"
NSQ_SOURCE_LINE 00004520 ""
NSQ_SOURCE_LINE 00004521 "Using placeholders and C<@bind_values> with the C<do> method can be"
NSQ_SOURCE_LINE 00004522 "useful because it avoids the need to correctly quote any variables"
NSQ_SOURCE_LINE 00004523 "in the C<$statement>. But if you'll be executing the statement many"
NSQ_SOURCE_LINE 00004524 "times then it's more efficient to C<prepare> it once and call"
NSQ_SOURCE_LINE 00004525 "C<execute> many times instead."
NSQ_SOURCE_LINE 00004526 ""
NSQ_SOURCE_LINE 00004527 "The C<q{...}> style quoting used in this example avoids clashing with"
NSQ_SOURCE_LINE 00004528 "quotes that may be used in the SQL statement. Use the double-quote-like"
NSQ_SOURCE_LINE 00004529 "C<qq{...}> operator if you want to interpolate variables into the string."
NSQ_SOURCE_LINE 00004530 "See L<perlop/\"Quote and Quote-like Operators\"> for more details."
NSQ_SOURCE_LINE 00004531 ""
NSQ_SOURCE_LINE 00004532 "Note drivers are free to avoid the overhead of creating an DBI"
NSQ_SOURCE_LINE 00004533 "statement handle for do(), especially if there are no parameters. In"
NSQ_SOURCE_LINE 00004534 "this case error handlers, if invoked during do(), will be passed the"
NSQ_SOURCE_LINE 00004535 "database handle."
NSQ_SOURCE_LINE 00004536 ""
NSQ_SOURCE_LINE 00004537 "=head3 C<last_insert_id>"
NSQ_SOURCE_LINE 00004538 ""
NSQ_SOURCE_LINE 00004539 "  $rv = $dbh->last_insert_id();"
NSQ_SOURCE_LINE 00004540 "  $rv = $dbh->last_insert_id($catalog, $schema, $table, $field);"
NSQ_SOURCE_LINE 00004541 "  $rv = $dbh->last_insert_id($catalog, $schema, $table, $field, \\%attr);"
NSQ_SOURCE_LINE 00004542 ""
NSQ_SOURCE_LINE 00004543 "Returns a value 'identifying' the row just inserted, if possible."
NSQ_SOURCE_LINE 00004544 "Typically this would be a value assigned by the database server"
NSQ_SOURCE_LINE 00004545 "to a column with an I<auto_increment> or I<serial> type."
NSQ_SOURCE_LINE 00004546 "Returns undef if the driver does not support the method or can't"
NSQ_SOURCE_LINE 00004547 "determine the value."
NSQ_SOURCE_LINE 00004548 ""
NSQ_SOURCE_LINE 00004549 "The $catalog, $schema, $table, and $field parameters may be required"
NSQ_SOURCE_LINE 00004550 "for some drivers (see below).  If you don't know the parameter values"
NSQ_SOURCE_LINE 00004551 "and your driver does not need them, then use C<undef> for each."
NSQ_SOURCE_LINE 00004552 ""
NSQ_SOURCE_LINE 00004553 "There are several caveats to be aware of with this method if you want"
NSQ_SOURCE_LINE 00004554 "to use it for portable applications:"
NSQ_SOURCE_LINE 00004555 ""
NSQ_SOURCE_LINE 00004556 "B<*> For some drivers the value may only be available immediately after"
NSQ_SOURCE_LINE 00004557 "the insert statement has executed (e.g., mysql, Informix)."
NSQ_SOURCE_LINE 00004558 ""
NSQ_SOURCE_LINE 00004559 "B<*> For some drivers the $catalog, $schema, $table, and $field parameters"
NSQ_SOURCE_LINE 00004560 "are required, for others they are ignored (e.g., mysql)."
NSQ_SOURCE_LINE 00004561 ""
NSQ_SOURCE_LINE 00004562 "B<*> Drivers may return an indeterminate value if no insert has"
NSQ_SOURCE_LINE 00004563 "been performed yet."
NSQ_SOURCE_LINE 00004564 ""
NSQ_SOURCE_LINE 00004565 "B<*> For some drivers the value may only be available if placeholders"
NSQ_SOURCE_LINE 00004566 "have I<not> been used (e.g., Sybase, MS SQL). In this case the value"
NSQ_SOURCE_LINE 00004567 "returned would be from the last non-placeholder insert statement."
NSQ_SOURCE_LINE 00004568 ""
NSQ_SOURCE_LINE 00004569 "B<*> Some drivers may need driver-specific hints about how to get"
NSQ_SOURCE_LINE 00004570 "the value. For example, being told the name of the database 'sequence'"
NSQ_SOURCE_LINE 00004571 "object that holds the value. Any such hints are passed as driver-specific"
NSQ_SOURCE_LINE 00004572 "attributes in the \\%attr parameter."
NSQ_SOURCE_LINE 00004573 ""
NSQ_SOURCE_LINE 00004574 "B<*> If the underlying database offers nothing better, then some"
NSQ_SOURCE_LINE 00004575 "drivers may attempt to implement this method by executing"
NSQ_SOURCE_LINE 00004576 "\"C<select max($field) from $table>\". Drivers using any approach"
NSQ_SOURCE_LINE 00004577 "like this should issue a warning if C<AutoCommit> is true because"
NSQ_SOURCE_LINE 00004578 "it is generally unsafe - another process may have modified the table"
NSQ_SOURCE_LINE 00004579 "between your insert and the select. For situations where you know"
NSQ_SOURCE_LINE 00004580 "it is safe, such as when you have locked the table, you can silence"
NSQ_SOURCE_LINE 00004581 "the warning by passing C<Warn> => 0 in \\%attr."
NSQ_SOURCE_LINE 00004582 ""
NSQ_SOURCE_LINE 00004583 "B<*> If no insert has been performed yet, or the last insert failed,"
NSQ_SOURCE_LINE 00004584 "then the value is implementation defined."
NSQ_SOURCE_LINE 00004585 ""
NSQ_SOURCE_LINE 00004586 "Given all the caveats above, it's clear that this method must be"
NSQ_SOURCE_LINE 00004587 "used with care."
NSQ_SOURCE_LINE 00004588 ""
NSQ_SOURCE_LINE 00004589 "The C<last_insert_id> method was added in DBI 1.38."
NSQ_SOURCE_LINE 00004590 ""
NSQ_SOURCE_LINE 00004591 "=head3 C<selectrow_array>"
NSQ_SOURCE_LINE 00004592 ""
NSQ_SOURCE_LINE 00004593 "  @row_ary = $dbh->selectrow_array($statement);"
NSQ_SOURCE_LINE 00004594 "  @row_ary = $dbh->selectrow_array($statement, \\%attr);"
NSQ_SOURCE_LINE 00004595 "  @row_ary = $dbh->selectrow_array($statement, \\%attr, @bind_values);"
NSQ_SOURCE_LINE 00004596 ""
NSQ_SOURCE_LINE 00004597 "This utility method combines L</prepare>, L</execute> and"
NSQ_SOURCE_LINE 00004598 "L</fetchrow_array> into a single call. If called in a list context, it"
NSQ_SOURCE_LINE 00004599 "returns the first row of data from the statement.  The C<$statement>"
NSQ_SOURCE_LINE 00004600 "parameter can be a previously prepared statement handle, in which case"
NSQ_SOURCE_LINE 00004601 "the C<prepare> is skipped."
NSQ_SOURCE_LINE 00004602 ""
NSQ_SOURCE_LINE 00004603 "If any method fails, and L</RaiseError> is not set, C<selectrow_array>"
NSQ_SOURCE_LINE 00004604 "will return an empty list."
NSQ_SOURCE_LINE 00004605 ""
NSQ_SOURCE_LINE 00004606 "If called in a scalar context for a statement handle that has more"
NSQ_SOURCE_LINE 00004607 "than one column, it is undefined whether the driver will return"
NSQ_SOURCE_LINE 00004608 "the value of the first column or the last. So don't do that."
NSQ_SOURCE_LINE 00004609 "Also, in a scalar context, an C<undef> is returned if there are no"
NSQ_SOURCE_LINE 00004610 "more rows or if an error occurred. That C<undef> can't be distinguished"
NSQ_SOURCE_LINE 00004611 "from an C<undef> returned because the first field value was NULL."
NSQ_SOURCE_LINE 00004612 "For these reasons you should exercise some caution if you use"
NSQ_SOURCE_LINE 00004613 "C<selectrow_array> in a scalar context, or just don't do that."
NSQ_SOURCE_LINE 00004614 ""
NSQ_SOURCE_LINE 00004615 ""
NSQ_SOURCE_LINE 00004616 "=head3 C<selectrow_arrayref>"
NSQ_SOURCE_LINE 00004617 ""
NSQ_SOURCE_LINE 00004618 "  $ary_ref = $dbh->selectrow_arrayref($statement);"
NSQ_SOURCE_LINE 00004619 "  $ary_ref = $dbh->selectrow_arrayref($statement, \\%attr);"
NSQ_SOURCE_LINE 00004620 "  $ary_ref = $dbh->selectrow_arrayref($statement, \\%attr, @bind_values);"
NSQ_SOURCE_LINE 00004621 ""
NSQ_SOURCE_LINE 00004622 "This utility method combines L</prepare>, L</execute> and"
NSQ_SOURCE_LINE 00004623 "L</fetchrow_arrayref> into a single call. It returns the first row of"
NSQ_SOURCE_LINE 00004624 "data from the statement.  The C<$statement> parameter can be a previously"
NSQ_SOURCE_LINE 00004625 "prepared statement handle, in which case the C<prepare> is skipped."
NSQ_SOURCE_LINE 00004626 ""
NSQ_SOURCE_LINE 00004627 "If any method fails, and L</RaiseError> is not set, C<selectrow_arrayref>"
NSQ_SOURCE_LINE 00004628 "will return undef."
NSQ_SOURCE_LINE 00004629 ""
NSQ_SOURCE_LINE 00004630 ""
NSQ_SOURCE_LINE 00004631 "=head3 C<selectrow_hashref>"
NSQ_SOURCE_LINE 00004632 ""
NSQ_SOURCE_LINE 00004633 "  $hash_ref = $dbh->selectrow_hashref($statement);"
NSQ_SOURCE_LINE 00004634 "  $hash_ref = $dbh->selectrow_hashref($statement, \\%attr);"
NSQ_SOURCE_LINE 00004635 "  $hash_ref = $dbh->selectrow_hashref($statement, \\%attr, @bind_values);"
NSQ_SOURCE_LINE 00004636 ""
NSQ_SOURCE_LINE 00004637 "This utility method combines L</prepare>, L</execute> and"
NSQ_SOURCE_LINE 00004638 "L</fetchrow_hashref> into a single call. It returns the first row of"
NSQ_SOURCE_LINE 00004639 "data from the statement.  The C<$statement> parameter can be a previously"
NSQ_SOURCE_LINE 00004640 "prepared statement handle, in which case the C<prepare> is skipped."
NSQ_SOURCE_LINE 00004641 ""
NSQ_SOURCE_LINE 00004642 "If any method fails, and L</RaiseError> is not set, C<selectrow_hashref>"
NSQ_SOURCE_LINE 00004643 "will return undef."
NSQ_SOURCE_LINE 00004644 ""
NSQ_SOURCE_LINE 00004645 ""
NSQ_SOURCE_LINE 00004646 "=head3 C<selectall_arrayref>"
NSQ_SOURCE_LINE 00004647 ""
NSQ_SOURCE_LINE 00004648 "  $ary_ref = $dbh->selectall_arrayref($statement);"
NSQ_SOURCE_LINE 00004649 "  $ary_ref = $dbh->selectall_arrayref($statement, \\%attr);"
NSQ_SOURCE_LINE 00004650 "  $ary_ref = $dbh->selectall_arrayref($statement, \\%attr, @bind_values);"
NSQ_SOURCE_LINE 00004651 ""
NSQ_SOURCE_LINE 00004652 "This utility method combines L</prepare>, L</execute> and"
NSQ_SOURCE_LINE 00004653 "L</fetchall_arrayref> into a single call. It returns a reference to an"
NSQ_SOURCE_LINE 00004654 "array containing a reference to an array (or hash, see below) for each row of"
NSQ_SOURCE_LINE 00004655 "data fetched."
NSQ_SOURCE_LINE 00004656 ""
NSQ_SOURCE_LINE 00004657 "The C<$statement> parameter can be a previously prepared statement handle,"
NSQ_SOURCE_LINE 00004658 "in which case the C<prepare> is skipped. This is recommended if the"
NSQ_SOURCE_LINE 00004659 "statement is going to be executed many times."
NSQ_SOURCE_LINE 00004660 ""
NSQ_SOURCE_LINE 00004661 "If L</RaiseError> is not set and any method except C<fetchall_arrayref>"
NSQ_SOURCE_LINE 00004662 "fails then C<selectall_arrayref> will return C<undef>; if"
NSQ_SOURCE_LINE 00004663 "C<fetchall_arrayref> fails then it will return with whatever data"
NSQ_SOURCE_LINE 00004664 "has been fetched thus far. You should check C<$dbh-E<gt>err>"
NSQ_SOURCE_LINE 00004665 "afterwards (or use the C<RaiseError> attribute) to discover if the data is"
NSQ_SOURCE_LINE 00004666 "complete or was truncated due to an error."
NSQ_SOURCE_LINE 00004667 ""
NSQ_SOURCE_LINE 00004668 "The L</fetchall_arrayref> method called by C<selectall_arrayref>"
NSQ_SOURCE_LINE 00004669 "supports a $max_rows parameter. You can specify a value for $max_rows"
NSQ_SOURCE_LINE 00004670 "by including a 'C<MaxRows>' attribute in \\%attr. In which case finish()"
NSQ_SOURCE_LINE 00004671 "is called for you after fetchall_arrayref() returns."
NSQ_SOURCE_LINE 00004672 ""
NSQ_SOURCE_LINE 00004673 "The L</fetchall_arrayref> method called by C<selectall_arrayref>"
NSQ_SOURCE_LINE 00004674 "also supports a $slice parameter. You can specify a value for $slice by"
NSQ_SOURCE_LINE 00004675 "including a 'C<Slice>' or 'C<Columns>' attribute in \\%attr. The only"
NSQ_SOURCE_LINE 00004676 "difference between the two is that if C<Slice> is not defined and"
NSQ_SOURCE_LINE 00004677 "C<Columns> is an array ref, then the array is assumed to contain column"
NSQ_SOURCE_LINE 00004678 "index values (which count from 1), rather than perl array index values."
NSQ_SOURCE_LINE 00004679 "In which case the array is copied and each value decremented before"
NSQ_SOURCE_LINE 00004680 "passing to C</fetchall_arrayref>."
NSQ_SOURCE_LINE 00004681 ""
NSQ_SOURCE_LINE 00004682 "You may often want to fetch an array of rows where each row is stored as a"
NSQ_SOURCE_LINE 00004683 "hash. That can be done simply using:"
NSQ_SOURCE_LINE 00004684 ""
NSQ_SOURCE_LINE 00004685 "  my $emps = $dbh->selectall_arrayref("
NSQ_SOURCE_LINE 00004686 "      \"SELECT ename FROM emp ORDER BY ename\","
NSQ_SOURCE_LINE 00004687 "      { Slice => {} }"
NSQ_SOURCE_LINE 00004688 "  );"
NSQ_SOURCE_LINE 00004689 "  foreach my $emp ( @$emps ) {"
NSQ_SOURCE_LINE 00004690 "      print \"Employee: $emp->{ename}\\n\";"
NSQ_SOURCE_LINE 00004691 "  }"
NSQ_SOURCE_LINE 00004692 ""
NSQ_SOURCE_LINE 00004693 "Or, to fetch into an array instead of an array ref:"
NSQ_SOURCE_LINE 00004694 ""
NSQ_SOURCE_LINE 00004695 "  @result = @{ $dbh->selectall_arrayref($sql, { Slice => {} }) };"
NSQ_SOURCE_LINE 00004696 ""
NSQ_SOURCE_LINE 00004697 "See L</fetchall_arrayref> method for more details."
NSQ_SOURCE_LINE 00004698 ""
NSQ_SOURCE_LINE 00004699 "=head3 C<selectall_array>"
NSQ_SOURCE_LINE 00004700 ""
NSQ_SOURCE_LINE 00004701 "  @ary = $dbh->selectall_array($statement);"
NSQ_SOURCE_LINE 00004702 "  @ary = $dbh->selectall_array($statement, \\%attr);"
NSQ_SOURCE_LINE 00004703 "  @ary = $dbh->selectall_array($statement, \\%attr, @bind_values);"
NSQ_SOURCE_LINE 00004704 ""
NSQ_SOURCE_LINE 00004705 "This is a convenience wrapper around L</selectall_arrayref> that returns"
NSQ_SOURCE_LINE 00004706 "the rows directly as a list, rather than a reference to an array of rows."
NSQ_SOURCE_LINE 00004707 ""
NSQ_SOURCE_LINE 00004708 "Note that if L</RaiseError> is not set then you can't tell the difference"
NSQ_SOURCE_LINE 00004709 "between returning no rows and an error. Using RaiseError is best practice."
NSQ_SOURCE_LINE 00004710 ""
NSQ_SOURCE_LINE 00004711 "The C<selectall_array> method was added in DBI 1.635."
NSQ_SOURCE_LINE 00004712 ""
NSQ_SOURCE_LINE 00004713 "=head3 C<selectall_hashref>"
NSQ_SOURCE_LINE 00004714 ""
NSQ_SOURCE_LINE 00004715 "  $hash_ref = $dbh->selectall_hashref($statement, $key_field);"
NSQ_SOURCE_LINE 00004716 "  $hash_ref = $dbh->selectall_hashref($statement, $key_field, \\%attr);"
NSQ_SOURCE_LINE 00004717 "  $hash_ref = $dbh->selectall_hashref($statement, $key_field, \\%attr, @bind_values);"
NSQ_SOURCE_LINE 00004718 ""
NSQ_SOURCE_LINE 00004719 "This utility method combines L</prepare>, L</execute> and"
NSQ_SOURCE_LINE 00004720 "L</fetchall_hashref> into a single call. It returns a reference to a"
NSQ_SOURCE_LINE 00004721 "hash containing one entry, at most, for each row, as returned by fetchall_hashref()."
NSQ_SOURCE_LINE 00004722 ""
NSQ_SOURCE_LINE 00004723 "The C<$statement> parameter can be a previously prepared statement handle,"
NSQ_SOURCE_LINE 00004724 "in which case the C<prepare> is skipped.  This is recommended if the"
NSQ_SOURCE_LINE 00004725 "statement is going to be executed many times."
NSQ_SOURCE_LINE 00004726 ""
NSQ_SOURCE_LINE 00004727 "The C<$key_field> parameter defines which column, or columns, are used as keys"
NSQ_SOURCE_LINE 00004728 "in the returned hash. It can either be the name of a single field, or a"
NSQ_SOURCE_LINE 00004729 "reference to an array containing multiple field names. Using multiple names"
NSQ_SOURCE_LINE 00004730 "yields a tree of nested hashes."
NSQ_SOURCE_LINE 00004731 ""
NSQ_SOURCE_LINE 00004732 "If a row has the same key as an earlier row then it replaces the earlier row."
NSQ_SOURCE_LINE 00004733 ""
NSQ_SOURCE_LINE 00004734 "If any method except C<fetchall_hashref> fails, and L</RaiseError> is not set,"
NSQ_SOURCE_LINE 00004735 "C<selectall_hashref> will return C<undef>.  If C<fetchall_hashref> fails and"
NSQ_SOURCE_LINE 00004736 "L</RaiseError> is not set, then it will return with whatever data it"
NSQ_SOURCE_LINE 00004737 "has fetched thus far. $DBI::err should be checked to catch that."
NSQ_SOURCE_LINE 00004738 ""
NSQ_SOURCE_LINE 00004739 "See fetchall_hashref() for more details."
NSQ_SOURCE_LINE 00004740 ""
NSQ_SOURCE_LINE 00004741 "=head3 C<selectcol_arrayref>"
NSQ_SOURCE_LINE 00004742 ""
NSQ_SOURCE_LINE 00004743 "  $ary_ref = $dbh->selectcol_arrayref($statement);"
NSQ_SOURCE_LINE 00004744 "  $ary_ref = $dbh->selectcol_arrayref($statement, \\%attr);"
NSQ_SOURCE_LINE 00004745 "  $ary_ref = $dbh->selectcol_arrayref($statement, \\%attr, @bind_values);"
NSQ_SOURCE_LINE 00004746 ""
NSQ_SOURCE_LINE 00004747 "This utility method combines L</prepare>, L</execute>, and fetching one"
NSQ_SOURCE_LINE 00004748 "column from all the rows, into a single call. It returns a reference to"
NSQ_SOURCE_LINE 00004749 "an array containing the values of the first column from each row."
NSQ_SOURCE_LINE 00004750 ""
NSQ_SOURCE_LINE 00004751 "The C<$statement> parameter can be a previously prepared statement handle,"
NSQ_SOURCE_LINE 00004752 "in which case the C<prepare> is skipped. This is recommended if the"
NSQ_SOURCE_LINE 00004753 "statement is going to be executed many times."
NSQ_SOURCE_LINE 00004754 ""
NSQ_SOURCE_LINE 00004755 "If any method except C<fetch> fails, and L</RaiseError> is not set,"
NSQ_SOURCE_LINE 00004756 "C<selectcol_arrayref> will return C<undef>.  If C<fetch> fails and"
NSQ_SOURCE_LINE 00004757 "L</RaiseError> is not set, then it will return with whatever data it"
NSQ_SOURCE_LINE 00004758 "has fetched thus far. $DBI::err should be checked to catch that."
NSQ_SOURCE_LINE 00004759 ""
NSQ_SOURCE_LINE 00004760 "The C<selectcol_arrayref> method defaults to pushing a single column"
NSQ_SOURCE_LINE 00004761 "value (the first) from each row into the result array. However, it can"
NSQ_SOURCE_LINE 00004762 "also push another column, or even multiple columns per row, into the"
NSQ_SOURCE_LINE 00004763 "result array. This behaviour can be specified via a 'C<Columns>'"
NSQ_SOURCE_LINE 00004764 "attribute which must be a ref to an array containing the column number"
NSQ_SOURCE_LINE 00004765 "or numbers to use. For example:"
NSQ_SOURCE_LINE 00004766 ""
NSQ_SOURCE_LINE 00004767 "  # get array of id and name pairs:"
NSQ_SOURCE_LINE 00004768 "  my $ary_ref = $dbh->selectcol_arrayref(\"select id, name from table\", { Columns=>[1,2] });"
NSQ_SOURCE_LINE 00004769 "  my %hash = @$ary_ref; # build hash from key-value pairs so $hash{$id} => name"
NSQ_SOURCE_LINE 00004770 ""
NSQ_SOURCE_LINE 00004771 "You can specify a maximum number of rows to fetch by including a"
NSQ_SOURCE_LINE 00004772 "'C<MaxRows>' attribute in \\%attr."
NSQ_SOURCE_LINE 00004773 ""
NSQ_SOURCE_LINE 00004774 "=head3 C<prepare>"
NSQ_SOURCE_LINE 00004775 ""
NSQ_SOURCE_LINE 00004776 "  $sth = $dbh->prepare($statement)          or die $dbh->errstr;"
NSQ_SOURCE_LINE 00004777 "  $sth = $dbh->prepare($statement, \\%attr)  or die $dbh->errstr;"
NSQ_SOURCE_LINE 00004778 ""
NSQ_SOURCE_LINE 00004779 "Prepares a statement for later execution by the database"
NSQ_SOURCE_LINE 00004780 "engine and returns a reference to a statement handle object."
NSQ_SOURCE_LINE 00004781 ""
NSQ_SOURCE_LINE 00004782 "The returned statement handle can be used to get attributes of the"
NSQ_SOURCE_LINE 00004783 "statement and invoke the L</execute> method. See L</Statement Handle Methods>."
NSQ_SOURCE_LINE 00004784 ""
NSQ_SOURCE_LINE 00004785 "Drivers for engines without the concept of preparing a"
NSQ_SOURCE_LINE 00004786 "statement will typically just store the statement in the returned"
NSQ_SOURCE_LINE 00004787 "handle and process it when C<$sth-E<gt>execute> is called. Such drivers are"
NSQ_SOURCE_LINE 00004788 "unlikely to give much useful information about the"
NSQ_SOURCE_LINE 00004789 "statement, such as C<$sth-E<gt>{NUM_OF_FIELDS}>, until after C<$sth-E<gt>execute>"
NSQ_SOURCE_LINE 00004790 "has been called. Portable applications should take this into account."
NSQ_SOURCE_LINE 00004791 ""
NSQ_SOURCE_LINE 00004792 "In general, DBI drivers do not parse the contents of the statement"
NSQ_SOURCE_LINE 00004793 "(other than simply counting any L<Placeholders|/Placeholders and Bind Values>)."
NSQ_SOURCE_LINE 00004794 "The statement is"
NSQ_SOURCE_LINE 00004795 "passed directly to the database engine, sometimes known as pass-thru"
NSQ_SOURCE_LINE 00004796 "mode. This has advantages and disadvantages. On the plus side, you can"
NSQ_SOURCE_LINE 00004797 "access all the functionality of the engine being used. On the downside,"
NSQ_SOURCE_LINE 00004798 "you're limited if you're using a simple engine, and you need to take extra care if"
NSQ_SOURCE_LINE 00004799 "writing applications intended to be portable between engines."
NSQ_SOURCE_LINE 00004800 ""
NSQ_SOURCE_LINE 00004801 "Portable applications should not assume that a new statement can be"
NSQ_SOURCE_LINE 00004802 "prepared and/or executed while still fetching results from a previous"
NSQ_SOURCE_LINE 00004803 "statement."
NSQ_SOURCE_LINE 00004804 ""
NSQ_SOURCE_LINE 00004805 "Some command-line SQL tools use statement terminators, like a semicolon,"
NSQ_SOURCE_LINE 00004806 "to indicate the end of a statement. Such terminators should not normally"
NSQ_SOURCE_LINE 00004807 "be used with the DBI."
NSQ_SOURCE_LINE 00004808 ""
NSQ_SOURCE_LINE 00004809 ""
NSQ_SOURCE_LINE 00004810 "=head3 C<prepare_cached>"
NSQ_SOURCE_LINE 00004811 ""
NSQ_SOURCE_LINE 00004812 "  $sth = $dbh->prepare_cached($statement)"
NSQ_SOURCE_LINE 00004813 "  $sth = $dbh->prepare_cached($statement, \\%attr)"
NSQ_SOURCE_LINE 00004814 "  $sth = $dbh->prepare_cached($statement, \\%attr, $if_active)"
NSQ_SOURCE_LINE 00004815 ""
NSQ_SOURCE_LINE 00004816 "Like L</prepare> except that the statement handle returned will be"
NSQ_SOURCE_LINE 00004817 "stored in a hash associated with the C<$dbh>. If another call is made to"
NSQ_SOURCE_LINE 00004818 "C<prepare_cached> with the same C<$statement> and C<%attr> parameter values,"
NSQ_SOURCE_LINE 00004819 "then the corresponding cached C<$sth> will be returned without contacting the"
NSQ_SOURCE_LINE 00004820 "database server. Be sure to understand the cautions and caveats noted below."
NSQ_SOURCE_LINE 00004821 ""
NSQ_SOURCE_LINE 00004822 "The C<$if_active> parameter lets you adjust the behaviour if an"
NSQ_SOURCE_LINE 00004823 "already cached statement handle is still Active.  There are several"
NSQ_SOURCE_LINE 00004824 "alternatives:"
NSQ_SOURCE_LINE 00004825 ""
NSQ_SOURCE_LINE 00004826 "=over 4"
NSQ_SOURCE_LINE 00004827 ""
NSQ_SOURCE_LINE 00004828 "=item B<0>: A warning will be generated, and finish() will be called on"
NSQ_SOURCE_LINE 00004829 "the statement handle before it is returned.  This is the default"
NSQ_SOURCE_LINE 00004830 "behaviour if $if_active is not passed."
NSQ_SOURCE_LINE 00004831 ""
NSQ_SOURCE_LINE 00004832 "=item B<1>: finish() will be called on the statement handle, but the"
NSQ_SOURCE_LINE 00004833 "warning is suppressed."
NSQ_SOURCE_LINE 00004834 ""
NSQ_SOURCE_LINE 00004835 "=item B<2>: Disables any checking."
NSQ_SOURCE_LINE 00004836 ""
NSQ_SOURCE_LINE 00004837 "=item B<3>: The existing active statement handle will be removed from the"
NSQ_SOURCE_LINE 00004838 "cache and a new statement handle prepared and cached in its place."
NSQ_SOURCE_LINE 00004839 "This is the safest option because it doesn't affect the state of the"
NSQ_SOURCE_LINE 00004840 "old handle, it just removes it from the cache. [Added in DBI 1.40]"
NSQ_SOURCE_LINE 00004841 ""
NSQ_SOURCE_LINE 00004842 "=back"
NSQ_SOURCE_LINE 00004843 ""
NSQ_SOURCE_LINE 00004844 "Here are some examples of C<prepare_cached>:"
NSQ_SOURCE_LINE 00004845 ""
NSQ_SOURCE_LINE 00004846 "  sub insert_hash {"
NSQ_SOURCE_LINE 00004847 "    my ($table, $field_values) = @_;"
NSQ_SOURCE_LINE 00004848 "    # sort to keep field order, and thus sql, stable for prepare_cached"
NSQ_SOURCE_LINE 00004849 "    my @fields = sort keys %$field_values;"
NSQ_SOURCE_LINE 00004850 "    my @values = @{$field_values}{@fields};"
NSQ_SOURCE_LINE 00004851 "    my $sql = sprintf \"insert into %s (%s) values (%s)\","
NSQ_SOURCE_LINE 00004852 "\t$table, join(\",\", @fields), join(\",\", (\"?\")x@fields);"
NSQ_SOURCE_LINE 00004853 "    my $sth = $dbh->prepare_cached($sql);"
NSQ_SOURCE_LINE 00004854 "    return $sth->execute(@values);"
NSQ_SOURCE_LINE 00004855 "  }"
NSQ_SOURCE_LINE 00004856 ""
NSQ_SOURCE_LINE 00004857 "  sub search_hash {"
NSQ_SOURCE_LINE 00004858 "    my ($table, $field_values) = @_;"
NSQ_SOURCE_LINE 00004859 "    # sort to keep field order, and thus sql, stable for prepare_cached"
NSQ_SOURCE_LINE 00004860 "    my @fields = sort keys %$field_values;"
NSQ_SOURCE_LINE 00004861 "    my @values = @{$field_values}{@fields};"
NSQ_SOURCE_LINE 00004862 "    my $qualifier = \"\";"
NSQ_SOURCE_LINE 00004863 "    $qualifier = \"where \".join(\" and \", map { \"$_=?\" } @fields) if @fields;"
NSQ_SOURCE_LINE 00004864 "    $sth = $dbh->prepare_cached(\"SELECT * FROM $table $qualifier\");"
NSQ_SOURCE_LINE 00004865 "    return $dbh->selectall_arrayref($sth, {}, @values);"
NSQ_SOURCE_LINE 00004866 "  }"
NSQ_SOURCE_LINE 00004867 ""
NSQ_SOURCE_LINE 00004868 "I<Caveat emptor:> This caching can be useful in some applications,"
NSQ_SOURCE_LINE 00004869 "but it can also cause problems and should be used with care. Here"
NSQ_SOURCE_LINE 00004870 "is a contrived case where caching would cause a significant problem:"
NSQ_SOURCE_LINE 00004871 ""
NSQ_SOURCE_LINE 00004872 "  my $sth = $dbh->prepare_cached('SELECT * FROM foo WHERE bar=?');"
NSQ_SOURCE_LINE 00004873 "  $sth->execute(...);"
NSQ_SOURCE_LINE 00004874 "  while (my $data = $sth->fetchrow_hashref) {"
NSQ_SOURCE_LINE 00004875 ""
NSQ_SOURCE_LINE 00004876 "    # later, in some other code called within the loop..."
NSQ_SOURCE_LINE 00004877 "    my $sth2 = $dbh->prepare_cached('SELECT * FROM foo WHERE bar=?');"
NSQ_SOURCE_LINE 00004878 "    $sth2->execute(...);"
NSQ_SOURCE_LINE 00004879 "    while (my $data2 = $sth2->fetchrow_arrayref) {"
NSQ_SOURCE_LINE 00004880 "      do_stuff(...);"
NSQ_SOURCE_LINE 00004881 "    }"
NSQ_SOURCE_LINE 00004882 "  }"
NSQ_SOURCE_LINE 00004883 ""
NSQ_SOURCE_LINE 00004884 "In this example, since both handles are preparing the exact same statement,"
NSQ_SOURCE_LINE 00004885 "C<$sth2> will not be its own statement handle, but a duplicate of C<$sth>"
NSQ_SOURCE_LINE 00004886 "returned from the cache. The results will certainly not be what you expect."
NSQ_SOURCE_LINE 00004887 "Typically the inner fetch loop will work normally, fetching all"
NSQ_SOURCE_LINE 00004888 "the records and terminating when there are no more, but now that $sth"
NSQ_SOURCE_LINE 00004889 "is the same as $sth2 the outer fetch loop will also terminate."
NSQ_SOURCE_LINE 00004890 ""
NSQ_SOURCE_LINE 00004891 "You'll know if you run into this problem because prepare_cached()"
NSQ_SOURCE_LINE 00004892 "will generate a warning by default (when $if_active is false)."
NSQ_SOURCE_LINE 00004893 ""
NSQ_SOURCE_LINE 00004894 "The cache used by prepare_cached() is keyed by both the statement"
NSQ_SOURCE_LINE 00004895 "and any attributes so you can also avoid this issue by doing something"
NSQ_SOURCE_LINE 00004896 "like:"
NSQ_SOURCE_LINE 00004897 ""
NSQ_SOURCE_LINE 00004898 "  $sth = $dbh->prepare_cached(\"...\", { dbi_dummy => __FILE__.__LINE__ });"
NSQ_SOURCE_LINE 00004899 ""
NSQ_SOURCE_LINE 00004900 "which will ensure that prepare_cached only returns statements cached"
NSQ_SOURCE_LINE 00004901 "by that line of code in that source file."
NSQ_SOURCE_LINE 00004902 ""
NSQ_SOURCE_LINE 00004903 "Also, to ensure the attributes passed are always the same, avoid passing"
NSQ_SOURCE_LINE 00004904 "references inline. For example, the Slice attribute is specified as a"
NSQ_SOURCE_LINE 00004905 "reference. Be sure to declare it external to the call to prepare_cached(), such"
NSQ_SOURCE_LINE 00004906 "that a new hash reference is not created on every call. See L</connect_cached>"
NSQ_SOURCE_LINE 00004907 "for more details and examples."
NSQ_SOURCE_LINE 00004908 ""
NSQ_SOURCE_LINE 00004909 "If you'd like the cache to managed intelligently, you can tie the"
NSQ_SOURCE_LINE 00004910 "hashref returned by C<CachedKids> to an appropriate caching module,"
NSQ_SOURCE_LINE 00004911 "such as L<Tie::Cache::LRU>:"
NSQ_SOURCE_LINE 00004912 ""
NSQ_SOURCE_LINE 00004913 "  my $cache;"
NSQ_SOURCE_LINE 00004914 "  tie %$cache, 'Tie::Cache::LRU', 500;"
NSQ_SOURCE_LINE 00004915 "  $dbh->{CachedKids} = $cache;"
NSQ_SOURCE_LINE 00004916 ""
NSQ_SOURCE_LINE 00004917 "=head3 C<commit>"
NSQ_SOURCE_LINE 00004918 ""
NSQ_SOURCE_LINE 00004919 "  $rc  = $dbh->commit     or die $dbh->errstr;"
NSQ_SOURCE_LINE 00004920 ""
NSQ_SOURCE_LINE 00004921 "Commit (make permanent) the most recent series of database changes"
NSQ_SOURCE_LINE 00004922 "if the database supports transactions and AutoCommit is off."
NSQ_SOURCE_LINE 00004923 ""
NSQ_SOURCE_LINE 00004924 "If C<AutoCommit> is on, then calling"
NSQ_SOURCE_LINE 00004925 "C<commit> will issue a \"commit ineffective with AutoCommit\" warning."
NSQ_SOURCE_LINE 00004926 ""
NSQ_SOURCE_LINE 00004927 "See also L</Transactions> in the L</FURTHER INFORMATION> section below."
NSQ_SOURCE_LINE 00004928 ""
NSQ_SOURCE_LINE 00004929 "=head3 C<rollback>"
NSQ_SOURCE_LINE 00004930 ""
NSQ_SOURCE_LINE 00004931 "  $rc  = $dbh->rollback   or die $dbh->errstr;"
NSQ_SOURCE_LINE 00004932 ""
NSQ_SOURCE_LINE 00004933 "Rollback (undo) the most recent series of uncommitted database"
NSQ_SOURCE_LINE 00004934 "changes if the database supports transactions and AutoCommit is off."
NSQ_SOURCE_LINE 00004935 ""
NSQ_SOURCE_LINE 00004936 "If C<AutoCommit> is on, then calling"
NSQ_SOURCE_LINE 00004937 "C<rollback> will issue a \"rollback ineffective with AutoCommit\" warning."
NSQ_SOURCE_LINE 00004938 ""
NSQ_SOURCE_LINE 00004939 "See also L</Transactions> in the L</FURTHER INFORMATION> section below."
NSQ_SOURCE_LINE 00004940 ""
NSQ_SOURCE_LINE 00004941 "=head3 C<begin_work>"
NSQ_SOURCE_LINE 00004942 ""
NSQ_SOURCE_LINE 00004943 "  $rc  = $dbh->begin_work   or die $dbh->errstr;"
NSQ_SOURCE_LINE 00004944 ""
NSQ_SOURCE_LINE 00004945 "Enable transactions (by turning C<AutoCommit> off) until the next call"
NSQ_SOURCE_LINE 00004946 "to C<commit> or C<rollback>. After the next C<commit> or C<rollback>,"
NSQ_SOURCE_LINE 00004947 "C<AutoCommit> will automatically be turned on again."
NSQ_SOURCE_LINE 00004948 ""
NSQ_SOURCE_LINE 00004949 "If C<AutoCommit> is already off when C<begin_work> is called then"
NSQ_SOURCE_LINE 00004950 "it does nothing except return an error. If the driver does not support"
NSQ_SOURCE_LINE 00004951 "transactions then when C<begin_work> attempts to set C<AutoCommit> off"
NSQ_SOURCE_LINE 00004952 "the driver will trigger a fatal error."
NSQ_SOURCE_LINE 00004953 ""
NSQ_SOURCE_LINE 00004954 "See also L</Transactions> in the L</FURTHER INFORMATION> section below."
NSQ_SOURCE_LINE 00004955 ""
NSQ_SOURCE_LINE 00004956 ""
NSQ_SOURCE_LINE 00004957 "=head3 C<disconnect>"
NSQ_SOURCE_LINE 00004958 ""
NSQ_SOURCE_LINE 00004959 "  $rc = $dbh->disconnect  or warn $dbh->errstr;"
NSQ_SOURCE_LINE 00004960 ""
NSQ_SOURCE_LINE 00004961 "Disconnects the database from the database handle. C<disconnect> is typically only used"
NSQ_SOURCE_LINE 00004962 "before exiting the program. The handle is of little use after disconnecting."
NSQ_SOURCE_LINE 00004963 ""
NSQ_SOURCE_LINE 00004964 "The transaction behaviour of the C<disconnect> method is, sadly,"
NSQ_SOURCE_LINE 00004965 "undefined.  Some database systems (such as Oracle and Ingres) will"
NSQ_SOURCE_LINE 00004966 "automatically commit any outstanding changes, but others (such as"
NSQ_SOURCE_LINE 00004967 "Informix) will rollback any outstanding changes.  Applications not"
NSQ_SOURCE_LINE 00004968 "using C<AutoCommit> should explicitly call C<commit> or C<rollback> before"
NSQ_SOURCE_LINE 00004969 "calling C<disconnect>."
NSQ_SOURCE_LINE 00004970 ""
NSQ_SOURCE_LINE 00004971 "The database is automatically disconnected by the C<DESTROY> method if"
NSQ_SOURCE_LINE 00004972 "still connected when there are no longer any references to the handle."
NSQ_SOURCE_LINE 00004973 "The C<DESTROY> method for each driver should implicitly call C<rollback> to"
NSQ_SOURCE_LINE 00004974 "undo any uncommitted changes. This is vital behaviour to ensure that"
NSQ_SOURCE_LINE 00004975 "incomplete transactions don't get committed simply because Perl calls"
NSQ_SOURCE_LINE 00004976 "C<DESTROY> on every object before exiting. Also, do not rely on the order"
NSQ_SOURCE_LINE 00004977 "of object destruction during \"global destruction\", as it is undefined."
NSQ_SOURCE_LINE 00004978 ""
NSQ_SOURCE_LINE 00004979 "Generally, if you want your changes to be committed or rolled back when"
NSQ_SOURCE_LINE 00004980 "you disconnect, then you should explicitly call L</commit> or L</rollback>"
NSQ_SOURCE_LINE 00004981 "before disconnecting."
NSQ_SOURCE_LINE 00004982 ""
NSQ_SOURCE_LINE 00004983 "If you disconnect from a database while you still have active"
NSQ_SOURCE_LINE 00004984 "statement handles (e.g., SELECT statement handles that may have"
NSQ_SOURCE_LINE 00004985 "more data to fetch), you will get a warning. The warning may indicate"
NSQ_SOURCE_LINE 00004986 "that a fetch loop terminated early, perhaps due to an uncaught error."
NSQ_SOURCE_LINE 00004987 "To avoid the warning call the C<finish> method on the active handles."
NSQ_SOURCE_LINE 00004988 ""
NSQ_SOURCE_LINE 00004989 ""
NSQ_SOURCE_LINE 00004990 "=head3 C<ping>"
NSQ_SOURCE_LINE 00004991 ""
NSQ_SOURCE_LINE 00004992 "  $rc = $dbh->ping;"
NSQ_SOURCE_LINE 00004993 ""
NSQ_SOURCE_LINE 00004994 "Attempts to determine, in a reasonably efficient way, if the database"
NSQ_SOURCE_LINE 00004995 "server is still running and the connection to it is still working."
NSQ_SOURCE_LINE 00004996 "Individual drivers should implement this function in the most suitable"
NSQ_SOURCE_LINE 00004997 "manner for their database engine."
NSQ_SOURCE_LINE 00004998 ""
NSQ_SOURCE_LINE 00004999 "The current I<default> implementation always returns true without"
NSQ_SOURCE_LINE 00005000 "actually doing anything. Actually, it returns \"C<0 but true>\" which is"
NSQ_SOURCE_LINE 00005001 "true but zero. That way you can tell if the return value is genuine or"
NSQ_SOURCE_LINE 00005002 "just the default. Drivers should override this method with one that"
NSQ_SOURCE_LINE 00005003 "does the right thing for their type of database."
NSQ_SOURCE_LINE 00005004 ""
NSQ_SOURCE_LINE 00005005 "Few applications would have direct use for this method. See the specialized"
NSQ_SOURCE_LINE 00005006 "Apache::DBI module for one example usage."
NSQ_SOURCE_LINE 00005007 ""
NSQ_SOURCE_LINE 00005008 ""
NSQ_SOURCE_LINE 00005009 "=head3 C<get_info>"
NSQ_SOURCE_LINE 00005010 ""
NSQ_SOURCE_LINE 00005011 "  $value = $dbh->get_info( $info_type );"
NSQ_SOURCE_LINE 00005012 ""
NSQ_SOURCE_LINE 00005013 "Returns information about the implementation, i.e. driver and data"
NSQ_SOURCE_LINE 00005014 "source capabilities, restrictions etc. It returns C<undef> for"
NSQ_SOURCE_LINE 00005015 "unknown or unimplemented information types. For example:"
NSQ_SOURCE_LINE 00005016 ""
NSQ_SOURCE_LINE 00005017 "  $database_version  = $dbh->get_info(  18 ); # SQL_DBMS_VER"
NSQ_SOURCE_LINE 00005018 "  $max_select_tables = $dbh->get_info( 106 ); # SQL_MAXIMUM_TABLES_IN_SELECT"
NSQ_SOURCE_LINE 00005019 ""
NSQ_SOURCE_LINE 00005020 "See L</\"Standards Reference Information\"> for more detailed information"
NSQ_SOURCE_LINE 00005021 "about the information types and their meanings and possible return values."
NSQ_SOURCE_LINE 00005022 ""
NSQ_SOURCE_LINE 00005023 "The L<DBI::Const::GetInfoType> module exports a %GetInfoType hash that"
NSQ_SOURCE_LINE 00005024 "can be used to map info type names to numbers. For example:"
NSQ_SOURCE_LINE 00005025 ""
NSQ_SOURCE_LINE 00005026 "  $database_version = $dbh->get_info( $GetInfoType{SQL_DBMS_VER} );"
NSQ_SOURCE_LINE 00005027 ""
NSQ_SOURCE_LINE 00005028 "The names are a merging of the ANSI and ODBC standards (which differ"
NSQ_SOURCE_LINE 00005029 "in some cases). See L<DBI::Const::GetInfoType> for more details."
NSQ_SOURCE_LINE 00005030 ""
NSQ_SOURCE_LINE 00005031 "Because some DBI methods make use of get_info(), drivers are strongly"
NSQ_SOURCE_LINE 00005032 "encouraged to support I<at least> the following very minimal set"
NSQ_SOURCE_LINE 00005033 "of information types to ensure the DBI itself works properly:"
NSQ_SOURCE_LINE 00005034 ""
NSQ_SOURCE_LINE 00005035 " Type  Name                        Example A     Example B"
NSQ_SOURCE_LINE 00005036 " ----  --------------------------  ------------  ----------------"
NSQ_SOURCE_LINE 00005037 "   17  SQL_DBMS_NAME               'ACCESS'      'Oracle'"
NSQ_SOURCE_LINE 00005038 "   18  SQL_DBMS_VER                '03.50.0000'  '08.01.0721 ...'"
NSQ_SOURCE_LINE 00005039 "   29  SQL_IDENTIFIER_QUOTE_CHAR   '`'           '\"'"
NSQ_SOURCE_LINE 00005040 "   41  SQL_CATALOG_NAME_SEPARATOR  '.'           '@'"
NSQ_SOURCE_LINE 00005041 "  114  SQL_CATALOG_LOCATION        1             2"
NSQ_SOURCE_LINE 00005042 ""
NSQ_SOURCE_LINE 00005043 "Values from 9000 to 9999 for get_info are officially reserved for use by Perl DBI."
NSQ_SOURCE_LINE 00005044 "Values in that range which have been assigned a meaning are defined here:"
NSQ_SOURCE_LINE 00005045 ""
NSQ_SOURCE_LINE 00005046 "C<9000>: true if a backslash character (C<\\>) before placeholder-like text"
NSQ_SOURCE_LINE 00005047 "(e.g. C<?>, C<:foo>) will prevent it being treated as a placeholder by the driver."
NSQ_SOURCE_LINE 00005048 "The backslash will be removed before the text is passed to the backend."
NSQ_SOURCE_LINE 00005049 ""
NSQ_SOURCE_LINE 00005050 "=head3 C<table_info>"
NSQ_SOURCE_LINE 00005051 ""
NSQ_SOURCE_LINE 00005052 "  $sth = $dbh->table_info( $catalog, $schema, $table, $type );"
NSQ_SOURCE_LINE 00005053 "  $sth = $dbh->table_info( $catalog, $schema, $table, $type, \\%attr );"
NSQ_SOURCE_LINE 00005054 ""
NSQ_SOURCE_LINE 00005055 "  # then $sth->fetchall_arrayref or $sth->fetchall_hashref etc"
NSQ_SOURCE_LINE 00005056 ""
NSQ_SOURCE_LINE 00005057 "Returns an active statement handle that can be used to fetch"
NSQ_SOURCE_LINE 00005058 "information about tables and views that exist in the database."
NSQ_SOURCE_LINE 00005059 ""
NSQ_SOURCE_LINE 00005060 "The arguments $catalog, $schema and $table may accept search patterns"
NSQ_SOURCE_LINE 00005061 "according to the database/driver, for example: $table = '%FOO%';"
NSQ_SOURCE_LINE 00005062 "Remember that the underscore character ('C<_>') is a search pattern"
NSQ_SOURCE_LINE 00005063 "that means match any character, so 'FOO_%' is the same as 'FOO%'"
NSQ_SOURCE_LINE 00005064 "and 'FOO_BAR%' will match names like 'FOO1BAR'."
NSQ_SOURCE_LINE 00005065 ""
NSQ_SOURCE_LINE 00005066 "The value of $type is a comma-separated list of one or more types of"
NSQ_SOURCE_LINE 00005067 "tables to be returned in the result set. Each value may optionally be"
NSQ_SOURCE_LINE 00005068 "quoted, e.g.:"
NSQ_SOURCE_LINE 00005069 ""
NSQ_SOURCE_LINE 00005070 "  $type = \"TABLE\";"
NSQ_SOURCE_LINE 00005071 "  $type = \"'TABLE','VIEW'\";"
NSQ_SOURCE_LINE 00005072 ""
NSQ_SOURCE_LINE 00005073 "In addition the following special cases may also be supported by some drivers:"
NSQ_SOURCE_LINE 00005074 ""
NSQ_SOURCE_LINE 00005075 "=over 4"
NSQ_SOURCE_LINE 00005076 ""
NSQ_SOURCE_LINE 00005077 "=item *"
NSQ_SOURCE_LINE 00005078 "If the value of $catalog is '%' and $schema and $table name"
NSQ_SOURCE_LINE 00005079 "are empty strings, the result set contains a list of catalog names."
NSQ_SOURCE_LINE 00005080 "For example:"
NSQ_SOURCE_LINE 00005081 ""
NSQ_SOURCE_LINE 00005082 "  $sth = $dbh->table_info('%', '', '');"
NSQ_SOURCE_LINE 00005083 ""
NSQ_SOURCE_LINE 00005084 "=item *"
NSQ_SOURCE_LINE 00005085 "If the value of $schema is '%' and $catalog and $table are empty"
NSQ_SOURCE_LINE 00005086 "strings, the result set contains a list of schema names."
NSQ_SOURCE_LINE 00005087 ""
NSQ_SOURCE_LINE 00005088 "=item *"
NSQ_SOURCE_LINE 00005089 "If the value of $type is '%' and $catalog, $schema, and $table are all"
NSQ_SOURCE_LINE 00005090 "empty strings, the result set contains a list of table types."
NSQ_SOURCE_LINE 00005091 ""
NSQ_SOURCE_LINE 00005092 "=back"
NSQ_SOURCE_LINE 00005093 ""
NSQ_SOURCE_LINE 00005094 "If your driver doesn't support one or more of the selection filter"
NSQ_SOURCE_LINE 00005095 "parameters then you may get back more than you asked for and can"
NSQ_SOURCE_LINE 00005096 "do the filtering yourself."
NSQ_SOURCE_LINE 00005097 ""
NSQ_SOURCE_LINE 00005098 "This method can be expensive, and can return a large amount of data."
NSQ_SOURCE_LINE 00005099 "(For example, small Oracle installation returns over 2000 rows.)"
NSQ_SOURCE_LINE 00005100 "So it's a good idea to use the filters to limit the data as much as possible."
NSQ_SOURCE_LINE 00005101 ""
NSQ_SOURCE_LINE 00005102 "The statement handle returned has at least the following fields in the"
NSQ_SOURCE_LINE 00005103 "order show below. Other fields, after these, may also be present."
NSQ_SOURCE_LINE 00005104 ""
NSQ_SOURCE_LINE 00005105 "B<TABLE_CAT>: Table catalog identifier. This field is NULL (C<undef>) if not"
NSQ_SOURCE_LINE 00005106 "applicable to the data source, which is usually the case. This field"
NSQ_SOURCE_LINE 00005107 "is empty if not applicable to the table."
NSQ_SOURCE_LINE 00005108 ""
NSQ_SOURCE_LINE 00005109 "B<TABLE_SCHEM>: The name of the schema containing the TABLE_NAME value."
NSQ_SOURCE_LINE 00005110 "This field is NULL (C<undef>) if not applicable to data source, and"
NSQ_SOURCE_LINE 00005111 "empty if not applicable to the table."
NSQ_SOURCE_LINE 00005112 ""
NSQ_SOURCE_LINE 00005113 "B<TABLE_NAME>: Name of the table (or view, synonym, etc)."
NSQ_SOURCE_LINE 00005114 ""
NSQ_SOURCE_LINE 00005115 "B<TABLE_TYPE>: One of the following: \"TABLE\", \"VIEW\", \"SYSTEM TABLE\","
NSQ_SOURCE_LINE 00005116 "\"GLOBAL TEMPORARY\", \"LOCAL TEMPORARY\", \"ALIAS\", \"SYNONYM\" or a type"
NSQ_SOURCE_LINE 00005117 "identifier that is specific to the data"
NSQ_SOURCE_LINE 00005118 "source."
NSQ_SOURCE_LINE 00005119 ""
NSQ_SOURCE_LINE 00005120 "B<REMARKS>: A description of the table. May be NULL (C<undef>)."
NSQ_SOURCE_LINE 00005121 ""
NSQ_SOURCE_LINE 00005122 "Note that C<table_info> might not return records for all tables."
NSQ_SOURCE_LINE 00005123 "Applications can use any valid table regardless of whether it's"
NSQ_SOURCE_LINE 00005124 "returned by C<table_info>."
NSQ_SOURCE_LINE 00005125 ""
NSQ_SOURCE_LINE 00005126 "See also L</tables>, L</\"Catalog Methods\"> and"
NSQ_SOURCE_LINE 00005127 "L</\"Standards Reference Information\">."
NSQ_SOURCE_LINE 00005128 ""
NSQ_SOURCE_LINE 00005129 "=head3 C<column_info>"
NSQ_SOURCE_LINE 00005130 ""
NSQ_SOURCE_LINE 00005131 "  $sth = $dbh->column_info( $catalog, $schema, $table, $column );"
NSQ_SOURCE_LINE 00005132 ""
NSQ_SOURCE_LINE 00005133 "  # then $sth->fetchall_arrayref or $sth->fetchall_hashref etc"
NSQ_SOURCE_LINE 00005134 ""
NSQ_SOURCE_LINE 00005135 "Returns an active statement handle that can be used to fetch"
NSQ_SOURCE_LINE 00005136 "information about columns in specified tables."
NSQ_SOURCE_LINE 00005137 ""
NSQ_SOURCE_LINE 00005138 "The arguments $schema, $table and $column may accept search patterns"
NSQ_SOURCE_LINE 00005139 "according to the database/driver, for example: $table = '%FOO%';"
NSQ_SOURCE_LINE 00005140 ""
NSQ_SOURCE_LINE 00005141 "Note: The support for the selection criteria is driver specific. If the"
NSQ_SOURCE_LINE 00005142 "driver doesn't support one or more of them then you may get back more"
NSQ_SOURCE_LINE 00005143 "than you asked for and can do the filtering yourself."
NSQ_SOURCE_LINE 00005144 ""
NSQ_SOURCE_LINE 00005145 "Note: If your driver does not support column_info an undef is"
NSQ_SOURCE_LINE 00005146 "returned.  This is distinct from asking for something which does not"
NSQ_SOURCE_LINE 00005147 "exist in a driver which supports column_info as a valid statement"
NSQ_SOURCE_LINE 00005148 "handle to an empty result-set will be returned in this case."
NSQ_SOURCE_LINE 00005149 ""
NSQ_SOURCE_LINE 00005150 "If the arguments don't match any tables then you'll still get a statement"
NSQ_SOURCE_LINE 00005151 "handle, it'll just return no rows."
NSQ_SOURCE_LINE 00005152 ""
NSQ_SOURCE_LINE 00005153 "The statement handle returned has at least the following fields in the"
NSQ_SOURCE_LINE 00005154 "order shown below. Other fields, after these, may also be present."
NSQ_SOURCE_LINE 00005155 ""
NSQ_SOURCE_LINE 00005156 "B<TABLE_CAT>: The catalog identifier."
NSQ_SOURCE_LINE 00005157 "This field is NULL (C<undef>) if not applicable to the data source,"
NSQ_SOURCE_LINE 00005158 "which is often the case.  This field is empty if not applicable to the"
NSQ_SOURCE_LINE 00005159 "table."
NSQ_SOURCE_LINE 00005160 ""
NSQ_SOURCE_LINE 00005161 "B<TABLE_SCHEM>: The schema identifier."
NSQ_SOURCE_LINE 00005162 "This field is NULL (C<undef>) if not applicable to the data source,"
NSQ_SOURCE_LINE 00005163 "and empty if not applicable to the table."
NSQ_SOURCE_LINE 00005164 ""
NSQ_SOURCE_LINE 00005165 "B<TABLE_NAME>: The table identifier."
NSQ_SOURCE_LINE 00005166 "Note: A driver may provide column metadata not only for base tables, but"
NSQ_SOURCE_LINE 00005167 "also for derived objects like SYNONYMS etc."
NSQ_SOURCE_LINE 00005168 ""
NSQ_SOURCE_LINE 00005169 "B<COLUMN_NAME>: The column identifier."
NSQ_SOURCE_LINE 00005170 ""
NSQ_SOURCE_LINE 00005171 "B<DATA_TYPE>: The concise data type code."
NSQ_SOURCE_LINE 00005172 ""
NSQ_SOURCE_LINE 00005173 "B<TYPE_NAME>: A data source dependent data type name."
NSQ_SOURCE_LINE 00005174 ""
NSQ_SOURCE_LINE 00005175 "B<COLUMN_SIZE>: The column size."
NSQ_SOURCE_LINE 00005176 "This is the maximum length in characters for character data types,"
NSQ_SOURCE_LINE 00005177 "the number of digits or bits for numeric data types or the length"
NSQ_SOURCE_LINE 00005178 "in the representation of temporal types."
NSQ_SOURCE_LINE 00005179 "See the relevant specifications for detailed information."
NSQ_SOURCE_LINE 00005180 ""
NSQ_SOURCE_LINE 00005181 "B<BUFFER_LENGTH>: The length in bytes of transferred data."
NSQ_SOURCE_LINE 00005182 ""
NSQ_SOURCE_LINE 00005183 "B<DECIMAL_DIGITS>: The total number of significant digits to the right of"
NSQ_SOURCE_LINE 00005184 "the decimal point."
NSQ_SOURCE_LINE 00005185 ""
NSQ_SOURCE_LINE 00005186 "B<NUM_PREC_RADIX>: The radix for numeric precision."
NSQ_SOURCE_LINE 00005187 "The value is 10 or 2 for numeric data types and NULL (C<undef>) if not"
NSQ_SOURCE_LINE 00005188 "applicable."
NSQ_SOURCE_LINE 00005189 ""
NSQ_SOURCE_LINE 00005190 "B<NULLABLE>: Indicates if a column can accept NULLs."
NSQ_SOURCE_LINE 00005191 "The following values are defined:"
NSQ_SOURCE_LINE 00005192 ""
NSQ_SOURCE_LINE 00005193 "  SQL_NO_NULLS          0"
NSQ_SOURCE_LINE 00005194 "  SQL_NULLABLE          1"
NSQ_SOURCE_LINE 00005195 "  SQL_NULLABLE_UNKNOWN  2"
NSQ_SOURCE_LINE 00005196 ""
NSQ_SOURCE_LINE 00005197 "B<REMARKS>: A description of the column."
NSQ_SOURCE_LINE 00005198 ""
NSQ_SOURCE_LINE 00005199 "B<COLUMN_DEF>: The default value of the column, in a format that can be used"
NSQ_SOURCE_LINE 00005200 "directly in an SQL statement."
NSQ_SOURCE_LINE 00005201 ""
NSQ_SOURCE_LINE 00005202 "Note that this may be an expression and not simply the text used for the"
NSQ_SOURCE_LINE 00005203 "default value in the original CREATE TABLE statement. For example, given:"
NSQ_SOURCE_LINE 00005204 ""
NSQ_SOURCE_LINE 00005205 "    col1 char(30) default current_user    -- a 'function'"
NSQ_SOURCE_LINE 00005206 "    col2 char(30) default 'string'        -- a string literal"
NSQ_SOURCE_LINE 00005207 ""
NSQ_SOURCE_LINE 00005208 "where \"current_user\" is the name of a function, the corresponding C<COLUMN_DEF>"
NSQ_SOURCE_LINE 00005209 "values would be:"
NSQ_SOURCE_LINE 00005210 ""
NSQ_SOURCE_LINE 00005211 "    Database        col1                     col2"
NSQ_SOURCE_LINE 00005212 "    --------        ----                     ----"
NSQ_SOURCE_LINE 00005213 "    Oracle:         current_user             'string'"
NSQ_SOURCE_LINE 00005214 "    Postgres:       \"current_user\"()         'string'::text"
NSQ_SOURCE_LINE 00005215 "    MS SQL:         (user_name())            ('string')"
NSQ_SOURCE_LINE 00005216 ""
NSQ_SOURCE_LINE 00005217 "B<SQL_DATA_TYPE>: The SQL data type."
NSQ_SOURCE_LINE 00005218 ""
NSQ_SOURCE_LINE 00005219 "B<SQL_DATETIME_SUB>: The subtype code for datetime and interval data types."
NSQ_SOURCE_LINE 00005220 ""
NSQ_SOURCE_LINE 00005221 "B<CHAR_OCTET_LENGTH>: The maximum length in bytes of a character or binary"
NSQ_SOURCE_LINE 00005222 "data type column."
NSQ_SOURCE_LINE 00005223 ""
NSQ_SOURCE_LINE 00005224 "B<ORDINAL_POSITION>: The column sequence number (starting with 1)."
NSQ_SOURCE_LINE 00005225 ""
NSQ_SOURCE_LINE 00005226 "B<IS_NULLABLE>: Indicates if the column can accept NULLs."
NSQ_SOURCE_LINE 00005227 "Possible values are: 'NO', 'YES' and ''."
NSQ_SOURCE_LINE 00005228 ""
NSQ_SOURCE_LINE 00005229 "SQL/CLI defines the following additional columns:"
NSQ_SOURCE_LINE 00005230 ""
NSQ_SOURCE_LINE 00005231 "  CHAR_SET_CAT"
NSQ_SOURCE_LINE 00005232 "  CHAR_SET_SCHEM"
NSQ_SOURCE_LINE 00005233 "  CHAR_SET_NAME"
NSQ_SOURCE_LINE 00005234 "  COLLATION_CAT"
NSQ_SOURCE_LINE 00005235 "  COLLATION_SCHEM"
NSQ_SOURCE_LINE 00005236 "  COLLATION_NAME"
NSQ_SOURCE_LINE 00005237 "  UDT_CAT"
NSQ_SOURCE_LINE 00005238 "  UDT_SCHEM"
NSQ_SOURCE_LINE 00005239 "  UDT_NAME"
NSQ_SOURCE_LINE 00005240 "  DOMAIN_CAT"
NSQ_SOURCE_LINE 00005241 "  DOMAIN_SCHEM"
NSQ_SOURCE_LINE 00005242 "  DOMAIN_NAME"
NSQ_SOURCE_LINE 00005243 "  SCOPE_CAT"
NSQ_SOURCE_LINE 00005244 "  SCOPE_SCHEM"
NSQ_SOURCE_LINE 00005245 "  SCOPE_NAME"
NSQ_SOURCE_LINE 00005246 "  MAX_CARDINALITY"
NSQ_SOURCE_LINE 00005247 "  DTD_IDENTIFIER"
NSQ_SOURCE_LINE 00005248 "  IS_SELF_REF"
NSQ_SOURCE_LINE 00005249 ""
NSQ_SOURCE_LINE 00005250 "Drivers capable of supplying any of those values should do so in"
NSQ_SOURCE_LINE 00005251 "the corresponding column and supply undef values for the others."
NSQ_SOURCE_LINE 00005252 ""
NSQ_SOURCE_LINE 00005253 "Drivers wishing to provide extra database/driver specific information"
NSQ_SOURCE_LINE 00005254 "should do so in extra columns beyond all those listed above, and"
NSQ_SOURCE_LINE 00005255 "use lowercase field names with the driver-specific prefix (i.e.,"
NSQ_SOURCE_LINE 00005256 "'ora_...'). Applications accessing such fields should do so by name"
NSQ_SOURCE_LINE 00005257 "and not by column number."
NSQ_SOURCE_LINE 00005258 ""
NSQ_SOURCE_LINE 00005259 "The result set is ordered by TABLE_CAT, TABLE_SCHEM, TABLE_NAME"
NSQ_SOURCE_LINE 00005260 "and ORDINAL_POSITION."
NSQ_SOURCE_LINE 00005261 ""
NSQ_SOURCE_LINE 00005262 "Note: There is some overlap with statement handle attributes (in perl) and"
NSQ_SOURCE_LINE 00005263 "SQLDescribeCol (in ODBC). However, SQLColumns provides more metadata."
NSQ_SOURCE_LINE 00005264 ""
NSQ_SOURCE_LINE 00005265 "See also L</\"Catalog Methods\"> and L</\"Standards Reference Information\">."
NSQ_SOURCE_LINE 00005266 ""
NSQ_SOURCE_LINE 00005267 "=head3 C<primary_key_info>"
NSQ_SOURCE_LINE 00005268 ""
NSQ_SOURCE_LINE 00005269 "  $sth = $dbh->primary_key_info( $catalog, $schema, $table );"
NSQ_SOURCE_LINE 00005270 ""
NSQ_SOURCE_LINE 00005271 "  # then $sth->fetchall_arrayref or $sth->fetchall_hashref etc"
NSQ_SOURCE_LINE 00005272 ""
NSQ_SOURCE_LINE 00005273 "Returns an active statement handle that can be used to fetch information"
NSQ_SOURCE_LINE 00005274 "about columns that make up the primary key for a table."
NSQ_SOURCE_LINE 00005275 "The arguments don't accept search patterns (unlike table_info())."
NSQ_SOURCE_LINE 00005276 ""
NSQ_SOURCE_LINE 00005277 "The statement handle will return one row per column, ordered by"
NSQ_SOURCE_LINE 00005278 "TABLE_CAT, TABLE_SCHEM, TABLE_NAME, and KEY_SEQ."
NSQ_SOURCE_LINE 00005279 "If there is no primary key then the statement handle will fetch no rows."
NSQ_SOURCE_LINE 00005280 ""
NSQ_SOURCE_LINE 00005281 "Note: The support for the selection criteria, such as $catalog, is"
NSQ_SOURCE_LINE 00005282 "driver specific.  If the driver doesn't support catalogs and/or"
NSQ_SOURCE_LINE 00005283 "schemas, it may ignore these criteria."
NSQ_SOURCE_LINE 00005284 ""
NSQ_SOURCE_LINE 00005285 "The statement handle returned has at least the following fields in the"
NSQ_SOURCE_LINE 00005286 "order shown below. Other fields, after these, may also be present."
NSQ_SOURCE_LINE 00005287 ""
NSQ_SOURCE_LINE 00005288 "B<TABLE_CAT>: The catalog identifier."
NSQ_SOURCE_LINE 00005289 "This field is NULL (C<undef>) if not applicable to the data source,"
NSQ_SOURCE_LINE 00005290 "which is often the case.  This field is empty if not applicable to the"
NSQ_SOURCE_LINE 00005291 "table."
NSQ_SOURCE_LINE 00005292 ""
NSQ_SOURCE_LINE 00005293 "B<TABLE_SCHEM>: The schema identifier."
NSQ_SOURCE_LINE 00005294 "This field is NULL (C<undef>) if not applicable to the data source,"
NSQ_SOURCE_LINE 00005295 "and empty if not applicable to the table."
NSQ_SOURCE_LINE 00005296 ""
NSQ_SOURCE_LINE 00005297 "B<TABLE_NAME>: The table identifier."
NSQ_SOURCE_LINE 00005298 ""
NSQ_SOURCE_LINE 00005299 "B<COLUMN_NAME>: The column identifier."
NSQ_SOURCE_LINE 00005300 ""
NSQ_SOURCE_LINE 00005301 "B<KEY_SEQ>: The column sequence number (starting with 1)."
NSQ_SOURCE_LINE 00005302 "Note: This field is named B<ORDINAL_POSITION> in SQL/CLI."
NSQ_SOURCE_LINE 00005303 ""
NSQ_SOURCE_LINE 00005304 "B<PK_NAME>: The primary key constraint identifier."
NSQ_SOURCE_LINE 00005305 "This field is NULL (C<undef>) if not applicable to the data source."
NSQ_SOURCE_LINE 00005306 ""
NSQ_SOURCE_LINE 00005307 "See also L</\"Catalog Methods\"> and L</\"Standards Reference Information\">."
NSQ_SOURCE_LINE 00005308 ""
NSQ_SOURCE_LINE 00005309 "=head3 C<primary_key>"
NSQ_SOURCE_LINE 00005310 ""
NSQ_SOURCE_LINE 00005311 "  @key_column_names = $dbh->primary_key( $catalog, $schema, $table );"
NSQ_SOURCE_LINE 00005312 ""
NSQ_SOURCE_LINE 00005313 "Simple interface to the primary_key_info() method. Returns a list of"
NSQ_SOURCE_LINE 00005314 "the column names that comprise the primary key of the specified table."
NSQ_SOURCE_LINE 00005315 "The list is in primary key column sequence order."
NSQ_SOURCE_LINE 00005316 "If there is no primary key then an empty list is returned."
NSQ_SOURCE_LINE 00005317 ""
NSQ_SOURCE_LINE 00005318 "=head3 C<foreign_key_info>"
NSQ_SOURCE_LINE 00005319 ""
NSQ_SOURCE_LINE 00005320 "  $sth = $dbh->foreign_key_info( $pk_catalog, $pk_schema, $pk_table"
NSQ_SOURCE_LINE 00005321 "                               , $fk_catalog, $fk_schema, $fk_table );"
NSQ_SOURCE_LINE 00005322 ""
NSQ_SOURCE_LINE 00005323 "  $sth = $dbh->foreign_key_info( $pk_catalog, $pk_schema, $pk_table"
NSQ_SOURCE_LINE 00005324 "                               , $fk_catalog, $fk_schema, $fk_table"
NSQ_SOURCE_LINE 00005325 "                               , \\%attr );"
NSQ_SOURCE_LINE 00005326 ""
NSQ_SOURCE_LINE 00005327 "  # then $sth->fetchall_arrayref or $sth->fetchall_hashref etc"
NSQ_SOURCE_LINE 00005328 ""
NSQ_SOURCE_LINE 00005329 "Returns an active statement handle that can be used to fetch information"
NSQ_SOURCE_LINE 00005330 "about foreign keys in and/or referencing the specified table(s)."
NSQ_SOURCE_LINE 00005331 "The arguments don't accept search patterns (unlike table_info())."
NSQ_SOURCE_LINE 00005332 ""
NSQ_SOURCE_LINE 00005333 "C<$pk_catalog>, C<$pk_schema>, C<$pk_table>"
NSQ_SOURCE_LINE 00005334 "identify the primary (unique) key table (B<PKT>)."
NSQ_SOURCE_LINE 00005335 ""
NSQ_SOURCE_LINE 00005336 "C<$fk_catalog>, C<$fk_schema>, C<$fk_table>"
NSQ_SOURCE_LINE 00005337 "identify the foreign key table (B<FKT>)."
NSQ_SOURCE_LINE 00005338 ""
NSQ_SOURCE_LINE 00005339 "If both B<PKT> and B<FKT> are given, the function returns the foreign key, if"
NSQ_SOURCE_LINE 00005340 "any, in table B<FKT> that refers to the primary (unique) key of table B<PKT>."
NSQ_SOURCE_LINE 00005341 "(Note: In SQL/CLI, the result is implementation-defined.)"
NSQ_SOURCE_LINE 00005342 ""
NSQ_SOURCE_LINE 00005343 "If only B<PKT> is given, then the result set contains the primary key"
NSQ_SOURCE_LINE 00005344 "of that table and all foreign keys that refer to it."
NSQ_SOURCE_LINE 00005345 ""
NSQ_SOURCE_LINE 00005346 "If only B<FKT> is given, then the result set contains all foreign keys"
NSQ_SOURCE_LINE 00005347 "in that table and the primary keys to which they refer."
NSQ_SOURCE_LINE 00005348 "(Note: In SQL/CLI, the result includes unique keys too.)"
NSQ_SOURCE_LINE 00005349 ""
NSQ_SOURCE_LINE 00005350 "For example:"
NSQ_SOURCE_LINE 00005351 ""
NSQ_SOURCE_LINE 00005352 "  $sth = $dbh->foreign_key_info( undef, $user, 'master');"
NSQ_SOURCE_LINE 00005353 "  $sth = $dbh->foreign_key_info( undef, undef,   undef , undef, $user, 'detail');"
NSQ_SOURCE_LINE 00005354 "  $sth = $dbh->foreign_key_info( undef, $user, 'master', undef, $user, 'detail');"
NSQ_SOURCE_LINE 00005355 ""
NSQ_SOURCE_LINE 00005356 "  # then $sth->fetchall_arrayref or $sth->fetchall_hashref etc"
NSQ_SOURCE_LINE 00005357 ""
NSQ_SOURCE_LINE 00005358 "Note: The support for the selection criteria, such as C<$catalog>, is"
NSQ_SOURCE_LINE 00005359 "driver specific.  If the driver doesn't support catalogs and/or"
NSQ_SOURCE_LINE 00005360 "schemas, it may ignore these criteria."
NSQ_SOURCE_LINE 00005361 ""
NSQ_SOURCE_LINE 00005362 "The statement handle returned has the following fields in the order shown below."
NSQ_SOURCE_LINE 00005363 "Because ODBC never includes unique keys, they define different columns in the"
NSQ_SOURCE_LINE 00005364 "result set than SQL/CLI. SQL/CLI column names are shown in parentheses."
NSQ_SOURCE_LINE 00005365 ""
NSQ_SOURCE_LINE 00005366 "B<PKTABLE_CAT    ( UK_TABLE_CAT      )>:"
NSQ_SOURCE_LINE 00005367 "The primary (unique) key table catalog identifier."
NSQ_SOURCE_LINE 00005368 "This field is NULL (C<undef>) if not applicable to the data source,"
NSQ_SOURCE_LINE 00005369 "which is often the case.  This field is empty if not applicable to the"
NSQ_SOURCE_LINE 00005370 "table."
NSQ_SOURCE_LINE 00005371 ""
NSQ_SOURCE_LINE 00005372 "B<PKTABLE_SCHEM  ( UK_TABLE_SCHEM    )>:"
NSQ_SOURCE_LINE 00005373 "The primary (unique) key table schema identifier."
NSQ_SOURCE_LINE 00005374 "This field is NULL (C<undef>) if not applicable to the data source,"
NSQ_SOURCE_LINE 00005375 "and empty if not applicable to the table."
NSQ_SOURCE_LINE 00005376 ""
NSQ_SOURCE_LINE 00005377 "B<PKTABLE_NAME   ( UK_TABLE_NAME     )>:"
NSQ_SOURCE_LINE 00005378 "The primary (unique) key table identifier."
NSQ_SOURCE_LINE 00005379 ""
NSQ_SOURCE_LINE 00005380 "B<PKCOLUMN_NAME  (UK_COLUMN_NAME    )>:"
NSQ_SOURCE_LINE 00005381 "The primary (unique) key column identifier."
NSQ_SOURCE_LINE 00005382 ""
NSQ_SOURCE_LINE 00005383 "B<FKTABLE_CAT    ( FK_TABLE_CAT      )>:"
NSQ_SOURCE_LINE 00005384 "The foreign key table catalog identifier."
NSQ_SOURCE_LINE 00005385 "This field is NULL (C<undef>) if not applicable to the data source,"
NSQ_SOURCE_LINE 00005386 "which is often the case.  This field is empty if not applicable to the"
NSQ_SOURCE_LINE 00005387 "table."
NSQ_SOURCE_LINE 00005388 ""
NSQ_SOURCE_LINE 00005389 "B<FKTABLE_SCHEM  ( FK_TABLE_SCHEM    )>:"
NSQ_SOURCE_LINE 00005390 "The foreign key table schema identifier."
NSQ_SOURCE_LINE 00005391 "This field is NULL (C<undef>) if not applicable to the data source,"
NSQ_SOURCE_LINE 00005392 "and empty if not applicable to the table."
NSQ_SOURCE_LINE 00005393 ""
NSQ_SOURCE_LINE 00005394 "B<FKTABLE_NAME   ( FK_TABLE_NAME     )>:"
NSQ_SOURCE_LINE 00005395 "The foreign key table identifier."
NSQ_SOURCE_LINE 00005396 ""
NSQ_SOURCE_LINE 00005397 "B<FKCOLUMN_NAME  ( FK_COLUMN_NAME    )>:"
NSQ_SOURCE_LINE 00005398 "The foreign key column identifier."
NSQ_SOURCE_LINE 00005399 ""
NSQ_SOURCE_LINE 00005400 "B<KEY_SEQ        ( ORDINAL_POSITION  )>:"
NSQ_SOURCE_LINE 00005401 "The column sequence number (starting with 1)."
NSQ_SOURCE_LINE 00005402 ""
NSQ_SOURCE_LINE 00005403 "B<UPDATE_RULE    ( UPDATE_RULE       )>:"
NSQ_SOURCE_LINE 00005404 "The referential action for the UPDATE rule."
NSQ_SOURCE_LINE 00005405 "The following codes are defined:"
NSQ_SOURCE_LINE 00005406 ""
NSQ_SOURCE_LINE 00005407 "  CASCADE              0"
NSQ_SOURCE_LINE 00005408 "  RESTRICT             1"
NSQ_SOURCE_LINE 00005409 "  SET NULL             2"
NSQ_SOURCE_LINE 00005410 "  NO ACTION            3"
NSQ_SOURCE_LINE 00005411 "  SET DEFAULT          4"
NSQ_SOURCE_LINE 00005412 ""
NSQ_SOURCE_LINE 00005413 "B<DELETE_RULE    ( DELETE_RULE       )>:"
NSQ_SOURCE_LINE 00005414 "The referential action for the DELETE rule."
NSQ_SOURCE_LINE 00005415 "The codes are the same as for UPDATE_RULE."
NSQ_SOURCE_LINE 00005416 ""
NSQ_SOURCE_LINE 00005417 "B<FK_NAME        ( FK_NAME           )>:"
NSQ_SOURCE_LINE 00005418 "The foreign key name."
NSQ_SOURCE_LINE 00005419 ""
NSQ_SOURCE_LINE 00005420 "B<PK_NAME        ( UK_NAME           )>:"
NSQ_SOURCE_LINE 00005421 "The primary (unique) key name."
NSQ_SOURCE_LINE 00005422 ""
NSQ_SOURCE_LINE 00005423 "B<DEFERRABILITY  ( DEFERABILITY      )>:"
NSQ_SOURCE_LINE 00005424 "The deferrability of the foreign key constraint."
NSQ_SOURCE_LINE 00005425 "The following codes are defined:"
NSQ_SOURCE_LINE 00005426 ""
NSQ_SOURCE_LINE 00005427 "  INITIALLY DEFERRED   5"
NSQ_SOURCE_LINE 00005428 "  INITIALLY IMMEDIATE  6"
NSQ_SOURCE_LINE 00005429 "  NOT DEFERRABLE       7"
NSQ_SOURCE_LINE 00005430 ""
NSQ_SOURCE_LINE 00005431 "B<               ( UNIQUE_OR_PRIMARY )>:"
NSQ_SOURCE_LINE 00005432 "This column is necessary if a driver includes all candidate (i.e. primary and"
NSQ_SOURCE_LINE 00005433 "alternate) keys in the result set (as specified by SQL/CLI)."
NSQ_SOURCE_LINE 00005434 "The value of this column is UNIQUE if the foreign key references an alternate"
NSQ_SOURCE_LINE 00005435 "key and PRIMARY if the foreign key references a primary key, or it"
NSQ_SOURCE_LINE 00005436 "may be undefined if the driver doesn't have access to the information."
NSQ_SOURCE_LINE 00005437 ""
NSQ_SOURCE_LINE 00005438 "See also L</\"Catalog Methods\"> and L</\"Standards Reference Information\">."
NSQ_SOURCE_LINE 00005439 ""
NSQ_SOURCE_LINE 00005440 "=head3 C<statistics_info>"
NSQ_SOURCE_LINE 00005441 ""
NSQ_SOURCE_LINE 00005442 "  $sth = $dbh->statistics_info( $catalog, $schema, $table, $unique_only, $quick );"
NSQ_SOURCE_LINE 00005443 ""
NSQ_SOURCE_LINE 00005444 "  # then $sth->fetchall_arrayref or $sth->fetchall_hashref etc"
NSQ_SOURCE_LINE 00005445 ""
NSQ_SOURCE_LINE 00005446 "Returns an active statement handle that can be used to fetch statistical"
NSQ_SOURCE_LINE 00005447 "information about a table and its indexes."
NSQ_SOURCE_LINE 00005448 ""
NSQ_SOURCE_LINE 00005449 "The arguments don't accept search patterns (unlike L</table_info>)."
NSQ_SOURCE_LINE 00005450 ""
NSQ_SOURCE_LINE 00005451 "If the boolean argument $unique_only is true, only UNIQUE indexes will be"
NSQ_SOURCE_LINE 00005452 "returned in the result set, otherwise all indexes will be returned."
NSQ_SOURCE_LINE 00005453 ""
NSQ_SOURCE_LINE 00005454 "If the boolean argument $quick is set, the actual statistical information"
NSQ_SOURCE_LINE 00005455 "columns (CARDINALITY and PAGES) will only be returned if they are readily"
NSQ_SOURCE_LINE 00005456 "available from the server, and might not be current.  Some databases may"
NSQ_SOURCE_LINE 00005457 "return stale statistics or no statistics at all with this flag set."
NSQ_SOURCE_LINE 00005458 ""
NSQ_SOURCE_LINE 00005459 "The statement handle will return at most one row per column name per index,"
NSQ_SOURCE_LINE 00005460 "plus at most one row for the entire table itself, ordered by NON_UNIQUE, TYPE,"
NSQ_SOURCE_LINE 00005461 "INDEX_QUALIFIER, INDEX_NAME, and ORDINAL_POSITION."
NSQ_SOURCE_LINE 00005462 ""
NSQ_SOURCE_LINE 00005463 "Note: The support for the selection criteria, such as $catalog, is"
NSQ_SOURCE_LINE 00005464 "driver specific.  If the driver doesn't support catalogs and/or"
NSQ_SOURCE_LINE 00005465 "schemas, it may ignore these criteria."
NSQ_SOURCE_LINE 00005466 ""
NSQ_SOURCE_LINE 00005467 "The statement handle returned has at least the following fields in the"
NSQ_SOURCE_LINE 00005468 "order shown below. Other fields, after these, may also be present."
NSQ_SOURCE_LINE 00005469 ""
NSQ_SOURCE_LINE 00005470 "B<TABLE_CAT>: The catalog identifier."
NSQ_SOURCE_LINE 00005471 "This field is NULL (C<undef>) if not applicable to the data source,"
NSQ_SOURCE_LINE 00005472 "which is often the case.  This field is empty if not applicable to the"
NSQ_SOURCE_LINE 00005473 "table."
NSQ_SOURCE_LINE 00005474 ""
NSQ_SOURCE_LINE 00005475 "B<TABLE_SCHEM>: The schema identifier."
NSQ_SOURCE_LINE 00005476 "This field is NULL (C<undef>) if not applicable to the data source,"
NSQ_SOURCE_LINE 00005477 "and empty if not applicable to the table."
NSQ_SOURCE_LINE 00005478 ""
NSQ_SOURCE_LINE 00005479 "B<TABLE_NAME>: The table identifier."
NSQ_SOURCE_LINE 00005480 ""
NSQ_SOURCE_LINE 00005481 "B<NON_UNIQUE>: Unique index indicator."
NSQ_SOURCE_LINE 00005482 "Returns 0 for unique indexes, 1 for non-unique indexes"
NSQ_SOURCE_LINE 00005483 ""
NSQ_SOURCE_LINE 00005484 "B<INDEX_QUALIFIER>: Index qualifier identifier."
NSQ_SOURCE_LINE 00005485 "The identifier that is used to qualify the index name when doing a"
NSQ_SOURCE_LINE 00005486 "C<DROP INDEX>; NULL (C<undef>) is returned if an index qualifier is not"
NSQ_SOURCE_LINE 00005487 "supported by the data source."
NSQ_SOURCE_LINE 00005488 "If a non-NULL (defined) value is returned in this column, it must be used"
NSQ_SOURCE_LINE 00005489 "to qualify the index name on a C<DROP INDEX> statement; otherwise,"
NSQ_SOURCE_LINE 00005490 "the TABLE_SCHEM should be used to qualify the index name."
NSQ_SOURCE_LINE 00005491 ""
NSQ_SOURCE_LINE 00005492 "B<INDEX_NAME>: The index identifier."
NSQ_SOURCE_LINE 00005493 ""
NSQ_SOURCE_LINE 00005494 "B<TYPE>: The type of information being returned.  Can be any of the"
NSQ_SOURCE_LINE 00005495 "following values: 'table', 'btree', 'clustered', 'content', 'hashed',"
NSQ_SOURCE_LINE 00005496 "or 'other'."
NSQ_SOURCE_LINE 00005497 ""
NSQ_SOURCE_LINE 00005498 "In the case that this field is 'table', all fields"
NSQ_SOURCE_LINE 00005499 "other than TABLE_CAT, TABLE_SCHEM, TABLE_NAME, TYPE,"
NSQ_SOURCE_LINE 00005500 "CARDINALITY, and PAGES will be NULL (C<undef>)."
NSQ_SOURCE_LINE 00005501 ""
NSQ_SOURCE_LINE 00005502 "B<ORDINAL_POSITION>: Column sequence number (starting with 1)."
NSQ_SOURCE_LINE 00005503 ""
NSQ_SOURCE_LINE 00005504 "B<COLUMN_NAME>: The column identifier."
NSQ_SOURCE_LINE 00005505 ""
NSQ_SOURCE_LINE 00005506 "B<ASC_OR_DESC>: Column sort sequence."
NSQ_SOURCE_LINE 00005507 "C<A> for Ascending, C<D> for Descending, or NULL (C<undef>) if"
NSQ_SOURCE_LINE 00005508 "not supported for this index."
NSQ_SOURCE_LINE 00005509 ""
NSQ_SOURCE_LINE 00005510 "B<CARDINALITY>: Cardinality of the table or index."
NSQ_SOURCE_LINE 00005511 "For indexes, this is the number of unique values in the index."
NSQ_SOURCE_LINE 00005512 "For tables, this is the number of rows in the table."
NSQ_SOURCE_LINE 00005513 "If not supported, the value will be NULL (C<undef>)."
NSQ_SOURCE_LINE 00005514 ""
NSQ_SOURCE_LINE 00005515 "B<PAGES>: Number of storage pages used by this table or index."
NSQ_SOURCE_LINE 00005516 "If not supported, the value will be NULL (C<undef>)."
NSQ_SOURCE_LINE 00005517 ""
NSQ_SOURCE_LINE 00005518 "B<FILTER_CONDITION>: The index filter condition as a string."
NSQ_SOURCE_LINE 00005519 "If the index is not a filtered index, or it cannot be determined"
NSQ_SOURCE_LINE 00005520 "whether the index is a filtered index, this value is NULL (C<undef>)."
NSQ_SOURCE_LINE 00005521 "If the index is a filtered index, but the filter condition"
NSQ_SOURCE_LINE 00005522 "cannot be determined, this value is the empty string C<''>."
NSQ_SOURCE_LINE 00005523 "Otherwise it will be the literal filter condition as a string,"
NSQ_SOURCE_LINE 00005524 "such as C<SALARY <= 4500>."
NSQ_SOURCE_LINE 00005525 ""
NSQ_SOURCE_LINE 00005526 "See also L</\"Catalog Methods\"> and L</\"Standards Reference Information\">."
NSQ_SOURCE_LINE 00005527 ""
NSQ_SOURCE_LINE 00005528 "=head3 C<tables>"
NSQ_SOURCE_LINE 00005529 ""
NSQ_SOURCE_LINE 00005530 "  @names = $dbh->tables( $catalog, $schema, $table, $type );"
NSQ_SOURCE_LINE 00005531 "  @names = $dbh->tables;\t# deprecated"
NSQ_SOURCE_LINE 00005532 ""
NSQ_SOURCE_LINE 00005533 "Simple interface to table_info(). Returns a list of matching"
NSQ_SOURCE_LINE 00005534 "table names, possibly including a catalog/schema prefix."
NSQ_SOURCE_LINE 00005535 ""
NSQ_SOURCE_LINE 00005536 "See L</table_info> for a description of the parameters."
NSQ_SOURCE_LINE 00005537 ""
NSQ_SOURCE_LINE 00005538 "If C<$dbh-E<gt>get_info(29)> returns true (29 is SQL_IDENTIFIER_QUOTE_CHAR)"
NSQ_SOURCE_LINE 00005539 "then the table names are constructed and quoted by L</quote_identifier>"
NSQ_SOURCE_LINE 00005540 "to ensure they are usable even if they contain whitespace or reserved"
NSQ_SOURCE_LINE 00005541 "words etc. This means that the table names returned will include"
NSQ_SOURCE_LINE 00005542 "quote characters."
NSQ_SOURCE_LINE 00005543 ""
NSQ_SOURCE_LINE 00005544 "=head3 C<type_info_all>"
NSQ_SOURCE_LINE 00005545 ""
NSQ_SOURCE_LINE 00005546 "  $type_info_all = $dbh->type_info_all;"
NSQ_SOURCE_LINE 00005547 ""
NSQ_SOURCE_LINE 00005548 "Returns a reference to an array which holds information about each data"
NSQ_SOURCE_LINE 00005549 "type variant supported by the database and driver. The array and its"
NSQ_SOURCE_LINE 00005550 "contents should be treated as read-only."
NSQ_SOURCE_LINE 00005551 ""
NSQ_SOURCE_LINE 00005552 "The first item is a reference to an 'index' hash of C<Name =>E<gt> C<Index> pairs."
NSQ_SOURCE_LINE 00005553 "The items following that are references to arrays, one per supported data"
NSQ_SOURCE_LINE 00005554 "type variant. The leading index hash defines the names and order of the"
NSQ_SOURCE_LINE 00005555 "fields within the arrays that follow it."
NSQ_SOURCE_LINE 00005556 "For example:"
NSQ_SOURCE_LINE 00005557 ""
NSQ_SOURCE_LINE 00005558 "  $type_info_all = ["
NSQ_SOURCE_LINE 00005559 "    {   TYPE_NAME         => 0,"
NSQ_SOURCE_LINE 00005560 "\tDATA_TYPE         => 1,"
NSQ_SOURCE_LINE 00005561 "\tCOLUMN_SIZE       => 2,     # was PRECISION originally"
NSQ_SOURCE_LINE 00005562 "\tLITERAL_PREFIX    => 3,"
NSQ_SOURCE_LINE 00005563 "\tLITERAL_SUFFIX    => 4,"
NSQ_SOURCE_LINE 00005564 "\tCREATE_PARAMS     => 5,"
NSQ_SOURCE_LINE 00005565 "\tNULLABLE          => 6,"
NSQ_SOURCE_LINE 00005566 "\tCASE_SENSITIVE    => 7,"
NSQ_SOURCE_LINE 00005567 "\tSEARCHABLE        => 8,"
NSQ_SOURCE_LINE 00005568 "\tUNSIGNED_ATTRIBUTE=> 9,"
NSQ_SOURCE_LINE 00005569 "\tFIXED_PREC_SCALE  => 10,    # was MONEY originally"
NSQ_SOURCE_LINE 00005570 "\tAUTO_UNIQUE_VALUE => 11,    # was AUTO_INCREMENT originally"
NSQ_SOURCE_LINE 00005571 "\tLOCAL_TYPE_NAME   => 12,"
NSQ_SOURCE_LINE 00005572 "\tMINIMUM_SCALE     => 13,"
NSQ_SOURCE_LINE 00005573 "\tMAXIMUM_SCALE     => 14,"
NSQ_SOURCE_LINE 00005574 "\tSQL_DATA_TYPE     => 15,"
NSQ_SOURCE_LINE 00005575 "\tSQL_DATETIME_SUB  => 16,"
NSQ_SOURCE_LINE 00005576 "\tNUM_PREC_RADIX    => 17,"
NSQ_SOURCE_LINE 00005577 "\tINTERVAL_PRECISION=> 18,"
NSQ_SOURCE_LINE 00005578 "    },"
NSQ_SOURCE_LINE 00005579 "    [ 'VARCHAR', SQL_VARCHAR,"
NSQ_SOURCE_LINE 00005580 "\tundef, \"'\",\"'\", undef,0, 1,1,0,0,0,undef,1,255, undef"
NSQ_SOURCE_LINE 00005581 "    ],"
NSQ_SOURCE_LINE 00005582 "    [ 'INTEGER', SQL_INTEGER,"
NSQ_SOURCE_LINE 00005583 "\tundef,  \"\", \"\", undef,0, 0,1,0,0,0,undef,0,  0, 10"
NSQ_SOURCE_LINE 00005584 "    ],"
NSQ_SOURCE_LINE 00005585 "  ];"
NSQ_SOURCE_LINE 00005586 ""
NSQ_SOURCE_LINE 00005587 "More than one row may have the same value in the C<DATA_TYPE>"
NSQ_SOURCE_LINE 00005588 "field if there are different ways to spell the type name and/or there"
NSQ_SOURCE_LINE 00005589 "are variants of the type with different attributes (e.g., with and"
NSQ_SOURCE_LINE 00005590 "without C<AUTO_UNIQUE_VALUE> set, with and without C<UNSIGNED_ATTRIBUTE>, etc)."
NSQ_SOURCE_LINE 00005591 ""
NSQ_SOURCE_LINE 00005592 "The rows are ordered by C<DATA_TYPE> first and then by how closely each"
NSQ_SOURCE_LINE 00005593 "type maps to the corresponding ODBC SQL data type, closest first."
NSQ_SOURCE_LINE 00005594 ""
NSQ_SOURCE_LINE 00005595 "The meaning of the fields is described in the documentation for"
NSQ_SOURCE_LINE 00005596 "the L</type_info> method."
NSQ_SOURCE_LINE 00005597 ""
NSQ_SOURCE_LINE 00005598 "An 'index' hash is provided so you don't need to rely on index"
NSQ_SOURCE_LINE 00005599 "values defined above.  However, using DBD::ODBC with some old ODBC"
NSQ_SOURCE_LINE 00005600 "drivers may return older names, shown as comments in the example above."
NSQ_SOURCE_LINE 00005601 "Another issue with the index hash is that the lettercase of the"
NSQ_SOURCE_LINE 00005602 "keys is not defined. It is usually uppercase, as show here, but"
NSQ_SOURCE_LINE 00005603 "drivers may return names with any lettercase."
NSQ_SOURCE_LINE 00005604 ""
NSQ_SOURCE_LINE 00005605 "Drivers are also free to return extra driver-specific columns of"
NSQ_SOURCE_LINE 00005606 "information - though it's recommended that they start at column"
NSQ_SOURCE_LINE 00005607 "index 50 to leave room for expansion of the DBI/ODBC specification."
NSQ_SOURCE_LINE 00005608 ""
NSQ_SOURCE_LINE 00005609 "The type_info_all() method is not normally used directly."
NSQ_SOURCE_LINE 00005610 "The L</type_info> method provides a more usable and useful interface"
NSQ_SOURCE_LINE 00005611 "to the data."
NSQ_SOURCE_LINE 00005612 ""
NSQ_SOURCE_LINE 00005613 "=head3 C<type_info>"
NSQ_SOURCE_LINE 00005614 ""
NSQ_SOURCE_LINE 00005615 "  @type_info = $dbh->type_info($data_type);"
NSQ_SOURCE_LINE 00005616 ""
NSQ_SOURCE_LINE 00005617 "Returns a list of hash references holding information about one or more"
NSQ_SOURCE_LINE 00005618 "variants of $data_type. The list is ordered by C<DATA_TYPE> first and"
NSQ_SOURCE_LINE 00005619 "then by how closely each type maps to the corresponding ODBC SQL data"
NSQ_SOURCE_LINE 00005620 "type, closest first.  If called in a scalar context then only the first"
NSQ_SOURCE_LINE 00005621 "(best) element is returned."
NSQ_SOURCE_LINE 00005622 ""
NSQ_SOURCE_LINE 00005623 "If $data_type is undefined or C<SQL_ALL_TYPES>, then the list will"
NSQ_SOURCE_LINE 00005624 "contain hashes for all data type variants supported by the database and driver."
NSQ_SOURCE_LINE 00005625 ""
NSQ_SOURCE_LINE 00005626 "If $data_type is an array reference then C<type_info> returns the"
NSQ_SOURCE_LINE 00005627 "information for the I<first> type in the array that has any matches."
NSQ_SOURCE_LINE 00005628 ""
NSQ_SOURCE_LINE 00005629 "The keys of the hash follow the same letter case conventions as the"
NSQ_SOURCE_LINE 00005630 "rest of the DBI (see L</Naming Conventions and Name Space>). The"
NSQ_SOURCE_LINE 00005631 "following uppercase items should always exist, though may be undef:"
NSQ_SOURCE_LINE 00005632 ""
NSQ_SOURCE_LINE 00005633 "=over 4"
NSQ_SOURCE_LINE 00005634 ""
NSQ_SOURCE_LINE 00005635 "=item TYPE_NAME (string)"
NSQ_SOURCE_LINE 00005636 ""
NSQ_SOURCE_LINE 00005637 "Data type name for use in CREATE TABLE statements etc."
NSQ_SOURCE_LINE 00005638 ""
NSQ_SOURCE_LINE 00005639 "=item DATA_TYPE (integer)"
NSQ_SOURCE_LINE 00005640 ""
NSQ_SOURCE_LINE 00005641 "SQL data type number."
NSQ_SOURCE_LINE 00005642 ""
NSQ_SOURCE_LINE 00005643 "=item COLUMN_SIZE (integer)"
NSQ_SOURCE_LINE 00005644 ""
NSQ_SOURCE_LINE 00005645 "For numeric types, this is either the total number of digits (if the"
NSQ_SOURCE_LINE 00005646 "NUM_PREC_RADIX value is 10) or the total number of bits allowed in the"
NSQ_SOURCE_LINE 00005647 "column (if NUM_PREC_RADIX is 2)."
NSQ_SOURCE_LINE 00005648 ""
NSQ_SOURCE_LINE 00005649 "For string types, this is the maximum size of the string in characters."
NSQ_SOURCE_LINE 00005650 ""
NSQ_SOURCE_LINE 00005651 "For date and interval types, this is the maximum number of characters"
NSQ_SOURCE_LINE 00005652 "needed to display the value."
NSQ_SOURCE_LINE 00005653 ""
NSQ_SOURCE_LINE 00005654 "=item LITERAL_PREFIX (string)"
NSQ_SOURCE_LINE 00005655 ""
NSQ_SOURCE_LINE 00005656 "Characters used to prefix a literal. A typical prefix is \"C<'>\" for characters,"
NSQ_SOURCE_LINE 00005657 "or possibly \"C<0x>\" for binary values passed as hexadecimal.  NULL (C<undef>) is"
NSQ_SOURCE_LINE 00005658 "returned for data types for which this is not applicable."
NSQ_SOURCE_LINE 00005659 ""
NSQ_SOURCE_LINE 00005660 ""
NSQ_SOURCE_LINE 00005661 "=item LITERAL_SUFFIX (string)"
NSQ_SOURCE_LINE 00005662 ""
NSQ_SOURCE_LINE 00005663 "Characters used to suffix a literal. Typically \"C<'>\" for characters."
NSQ_SOURCE_LINE 00005664 "NULL (C<undef>) is returned for data types where this is not applicable."
NSQ_SOURCE_LINE 00005665 ""
NSQ_SOURCE_LINE 00005666 "=item CREATE_PARAMS (string)"
NSQ_SOURCE_LINE 00005667 ""
NSQ_SOURCE_LINE 00005668 "Parameter names for data type definition. For example, C<CREATE_PARAMS> for a"
NSQ_SOURCE_LINE 00005669 "C<DECIMAL> would be \"C<precision,scale>\" if the DECIMAL type should be"
NSQ_SOURCE_LINE 00005670 "declared as C<DECIMAL(>I<precision,scale>C<)> where I<precision> and I<scale>"
NSQ_SOURCE_LINE 00005671 "are integer values.  For a C<VARCHAR> it would be \"C<max length>\"."
NSQ_SOURCE_LINE 00005672 "NULL (C<undef>) is returned for data types for which this is not applicable."
NSQ_SOURCE_LINE 00005673 ""
NSQ_SOURCE_LINE 00005674 "=item NULLABLE (integer)"
NSQ_SOURCE_LINE 00005675 ""
NSQ_SOURCE_LINE 00005676 "Indicates whether the data type accepts a NULL value:"
NSQ_SOURCE_LINE 00005677 "C<0> or an empty string = no, C<1> = yes, C<2> = unknown."
NSQ_SOURCE_LINE 00005678 ""
NSQ_SOURCE_LINE 00005679 "=item CASE_SENSITIVE (boolean)"
NSQ_SOURCE_LINE 00005680 ""
NSQ_SOURCE_LINE 00005681 "Indicates whether the data type is case sensitive in collations and"
NSQ_SOURCE_LINE 00005682 "comparisons."
NSQ_SOURCE_LINE 00005683 ""
NSQ_SOURCE_LINE 00005684 "=item SEARCHABLE (integer)"
NSQ_SOURCE_LINE 00005685 ""
NSQ_SOURCE_LINE 00005686 "Indicates how the data type can be used in a WHERE clause, as"
NSQ_SOURCE_LINE 00005687 "follows:"
NSQ_SOURCE_LINE 00005688 ""
NSQ_SOURCE_LINE 00005689 "  0 - Cannot be used in a WHERE clause"
NSQ_SOURCE_LINE 00005690 "  1 - Only with a LIKE predicate"
NSQ_SOURCE_LINE 00005691 "  2 - All comparison operators except LIKE"
NSQ_SOURCE_LINE 00005692 "  3 - Can be used in a WHERE clause with any comparison operator"
NSQ_SOURCE_LINE 00005693 ""
NSQ_SOURCE_LINE 00005694 "=item UNSIGNED_ATTRIBUTE (boolean)"
NSQ_SOURCE_LINE 00005695 ""
NSQ_SOURCE_LINE 00005696 "Indicates whether the data type is unsigned.  NULL (C<undef>) is returned"
NSQ_SOURCE_LINE 00005697 "for data types for which this is not applicable."
NSQ_SOURCE_LINE 00005698 ""
NSQ_SOURCE_LINE 00005699 "=item FIXED_PREC_SCALE (boolean)"
NSQ_SOURCE_LINE 00005700 ""
NSQ_SOURCE_LINE 00005701 "Indicates whether the data type always has the same precision and scale"
NSQ_SOURCE_LINE 00005702 "(such as a money type).  NULL (C<undef>) is returned for data types"
NSQ_SOURCE_LINE 00005703 "for which"
NSQ_SOURCE_LINE 00005704 "this is not applicable."
NSQ_SOURCE_LINE 00005705 ""
NSQ_SOURCE_LINE 00005706 "=item AUTO_UNIQUE_VALUE (boolean)"
NSQ_SOURCE_LINE 00005707 ""
NSQ_SOURCE_LINE 00005708 "Indicates whether a column of this data type is automatically set to a"
NSQ_SOURCE_LINE 00005709 "unique value whenever a new row is inserted.  NULL (C<undef>) is returned"
NSQ_SOURCE_LINE 00005710 "for data types for which this is not applicable."
NSQ_SOURCE_LINE 00005711 ""
NSQ_SOURCE_LINE 00005712 "=item LOCAL_TYPE_NAME (string)"
NSQ_SOURCE_LINE 00005713 ""
NSQ_SOURCE_LINE 00005714 "Localized version of the C<TYPE_NAME> for use in dialog with users."
NSQ_SOURCE_LINE 00005715 "NULL (C<undef>) is returned if a localized name is not available (in which"
NSQ_SOURCE_LINE 00005716 "case C<TYPE_NAME> should be used)."
NSQ_SOURCE_LINE 00005717 ""
NSQ_SOURCE_LINE 00005718 "=item MINIMUM_SCALE (integer)"
NSQ_SOURCE_LINE 00005719 ""
NSQ_SOURCE_LINE 00005720 "The minimum scale of the data type. If a data type has a fixed scale,"
NSQ_SOURCE_LINE 00005721 "then C<MAXIMUM_SCALE> holds the same value.  NULL (C<undef>) is returned for"
NSQ_SOURCE_LINE 00005722 "data types for which this is not applicable."
NSQ_SOURCE_LINE 00005723 ""
NSQ_SOURCE_LINE 00005724 "=item MAXIMUM_SCALE (integer)"
NSQ_SOURCE_LINE 00005725 ""
NSQ_SOURCE_LINE 00005726 "The maximum scale of the data type. If a data type has a fixed scale,"
NSQ_SOURCE_LINE 00005727 "then C<MINIMUM_SCALE> holds the same value.  NULL (C<undef>) is returned for"
NSQ_SOURCE_LINE 00005728 "data types for which this is not applicable."
NSQ_SOURCE_LINE 00005729 ""
NSQ_SOURCE_LINE 00005730 "=item SQL_DATA_TYPE (integer)"
NSQ_SOURCE_LINE 00005731 ""
NSQ_SOURCE_LINE 00005732 "This column is the same as the C<DATA_TYPE> column, except for interval"
NSQ_SOURCE_LINE 00005733 "and datetime data types.  For interval and datetime data types, the"
NSQ_SOURCE_LINE 00005734 "C<SQL_DATA_TYPE> field will return C<SQL_INTERVAL> or C<SQL_DATETIME>, and the"
NSQ_SOURCE_LINE 00005735 "C<SQL_DATETIME_SUB> field below will return the subcode for the specific"
NSQ_SOURCE_LINE 00005736 "interval or datetime data type. If this field is NULL, then the driver"
NSQ_SOURCE_LINE 00005737 "does not support or report on interval or datetime subtypes."
NSQ_SOURCE_LINE 00005738 ""
NSQ_SOURCE_LINE 00005739 "=item SQL_DATETIME_SUB (integer)"
NSQ_SOURCE_LINE 00005740 ""
NSQ_SOURCE_LINE 00005741 "For interval or datetime data types, where the C<SQL_DATA_TYPE>"
NSQ_SOURCE_LINE 00005742 "field above is C<SQL_INTERVAL> or C<SQL_DATETIME>, this field will"
NSQ_SOURCE_LINE 00005743 "hold the I<subcode> for the specific interval or datetime data type."
NSQ_SOURCE_LINE 00005744 "Otherwise it will be NULL (C<undef>)."
NSQ_SOURCE_LINE 00005745 ""
NSQ_SOURCE_LINE 00005746 "Although not mentioned explicitly in the standards, it seems there"
NSQ_SOURCE_LINE 00005747 "is a simple relationship between these values:"
NSQ_SOURCE_LINE 00005748 ""
NSQ_SOURCE_LINE 00005749 "  DATA_TYPE == (10 * SQL_DATA_TYPE) + SQL_DATETIME_SUB"
NSQ_SOURCE_LINE 00005750 ""
NSQ_SOURCE_LINE 00005751 "=item NUM_PREC_RADIX (integer)"
NSQ_SOURCE_LINE 00005752 ""
NSQ_SOURCE_LINE 00005753 "The radix value of the data type. For approximate numeric types,"
NSQ_SOURCE_LINE 00005754 "C<NUM_PREC_RADIX>"
NSQ_SOURCE_LINE 00005755 "contains the value 2 and C<COLUMN_SIZE> holds the number of bits. For"
NSQ_SOURCE_LINE 00005756 "exact numeric types, C<NUM_PREC_RADIX> contains the value 10 and C<COLUMN_SIZE> holds"
NSQ_SOURCE_LINE 00005757 "the number of decimal digits. NULL (C<undef>) is returned either for data types"
NSQ_SOURCE_LINE 00005758 "for which this is not applicable or if the driver cannot report this information."
NSQ_SOURCE_LINE 00005759 ""
NSQ_SOURCE_LINE 00005760 "=item INTERVAL_PRECISION (integer)"
NSQ_SOURCE_LINE 00005761 ""
NSQ_SOURCE_LINE 00005762 "The interval leading precision for interval types. NULL is returned"
NSQ_SOURCE_LINE 00005763 "either for data types for which this is not applicable or if the driver"
NSQ_SOURCE_LINE 00005764 "cannot report this information."
NSQ_SOURCE_LINE 00005765 ""
NSQ_SOURCE_LINE 00005766 "=back"
NSQ_SOURCE_LINE 00005767 ""
NSQ_SOURCE_LINE 00005768 "For example, to find the type name for the fields in a select statement"
NSQ_SOURCE_LINE 00005769 "you can do:"
NSQ_SOURCE_LINE 00005770 ""
NSQ_SOURCE_LINE 00005771 "  @names = map { scalar $dbh->type_info($_)->{TYPE_NAME} } @{ $sth->{TYPE} }"
NSQ_SOURCE_LINE 00005772 ""
NSQ_SOURCE_LINE 00005773 "Since DBI and ODBC drivers vary in how they map their types into the"
NSQ_SOURCE_LINE 00005774 "ISO standard types you may need to search for more than one type."
NSQ_SOURCE_LINE 00005775 "Here's an example looking for a usable type to store a date:"
NSQ_SOURCE_LINE 00005776 ""
NSQ_SOURCE_LINE 00005777 "  $my_date_type = $dbh->type_info( [ SQL_DATE, SQL_TIMESTAMP ] );"
NSQ_SOURCE_LINE 00005778 ""
NSQ_SOURCE_LINE 00005779 "Similarly, to more reliably find a type to store small integers, you could"
NSQ_SOURCE_LINE 00005780 "use a list starting with C<SQL_SMALLINT>, C<SQL_INTEGER>, C<SQL_DECIMAL>, etc."
NSQ_SOURCE_LINE 00005781 ""
NSQ_SOURCE_LINE 00005782 "See also L</\"Standards Reference Information\">."
NSQ_SOURCE_LINE 00005783 ""
NSQ_SOURCE_LINE 00005784 ""
NSQ_SOURCE_LINE 00005785 "=head3 C<quote>"
NSQ_SOURCE_LINE 00005786 ""
NSQ_SOURCE_LINE 00005787 "  $sql = $dbh->quote($value);"
NSQ_SOURCE_LINE 00005788 "  $sql = $dbh->quote($value, $data_type);"
NSQ_SOURCE_LINE 00005789 ""
NSQ_SOURCE_LINE 00005790 "Quote a string literal for use as a literal value in an SQL statement,"
NSQ_SOURCE_LINE 00005791 "by escaping any special characters (such as quotation marks)"
NSQ_SOURCE_LINE 00005792 "contained within the string and adding the required type of outer"
NSQ_SOURCE_LINE 00005793 "quotation marks."
NSQ_SOURCE_LINE 00005794 ""
NSQ_SOURCE_LINE 00005795 "  $sql = sprintf \"SELECT foo FROM bar WHERE baz = %s\","
NSQ_SOURCE_LINE 00005796 "                $dbh->quote(\"Don't\");"
NSQ_SOURCE_LINE 00005797 ""
NSQ_SOURCE_LINE 00005798 "For most database types, at least those that conform to SQL standards, quote"
NSQ_SOURCE_LINE 00005799 "would return C<'Don''t'> (including the outer quotation marks). For others it"
NSQ_SOURCE_LINE 00005800 "may return something like C<'Don\\'t'>"
NSQ_SOURCE_LINE 00005801 ""
NSQ_SOURCE_LINE 00005802 "An undefined C<$value> value will be returned as the string C<NULL> (without"
NSQ_SOURCE_LINE 00005803 "single quotation marks) to match how NULLs are represented in SQL."
NSQ_SOURCE_LINE 00005804 ""
NSQ_SOURCE_LINE 00005805 "If C<$data_type> is supplied, it is used to try to determine the required"
NSQ_SOURCE_LINE 00005806 "quoting behaviour by using the information returned by L</type_info>."
NSQ_SOURCE_LINE 00005807 "As a special case, the standard numeric types are optimized to return"
NSQ_SOURCE_LINE 00005808 "C<$value> without calling C<type_info>."
NSQ_SOURCE_LINE 00005809 ""
NSQ_SOURCE_LINE 00005810 "Quote will probably I<not> be able to deal with all possible input"
NSQ_SOURCE_LINE 00005811 "(such as binary data or data containing newlines), and is not related in"
NSQ_SOURCE_LINE 00005812 "any way with escaping or quoting shell meta-characters."
NSQ_SOURCE_LINE 00005813 ""
NSQ_SOURCE_LINE 00005814 "It is valid for the quote() method to return an SQL expression that"
NSQ_SOURCE_LINE 00005815 "evaluates to the desired string. For example:"
NSQ_SOURCE_LINE 00005816 ""
NSQ_SOURCE_LINE 00005817 "  $quoted = $dbh->quote(\"one\\ntwo\\0three\")"
NSQ_SOURCE_LINE 00005818 ""
NSQ_SOURCE_LINE 00005819 "may return something like:"
NSQ_SOURCE_LINE 00005820 ""
NSQ_SOURCE_LINE 00005821 "  CONCAT('one', CHAR(12), 'two', CHAR(0), 'three')"
NSQ_SOURCE_LINE 00005822 ""
NSQ_SOURCE_LINE 00005823 "The quote() method should I<not> be used with L</\"Placeholders and"
NSQ_SOURCE_LINE 00005824 "Bind Values\">."
NSQ_SOURCE_LINE 00005825 ""
NSQ_SOURCE_LINE 00005826 "=head3 C<quote_identifier>"
NSQ_SOURCE_LINE 00005827 ""
NSQ_SOURCE_LINE 00005828 "  $sql = $dbh->quote_identifier( $name );"
NSQ_SOURCE_LINE 00005829 "  $sql = $dbh->quote_identifier( $catalog, $schema, $table, \\%attr );"
NSQ_SOURCE_LINE 00005830 ""
NSQ_SOURCE_LINE 00005831 "Quote an identifier (table name etc.) for use in an SQL statement,"
NSQ_SOURCE_LINE 00005832 "by escaping any special characters (such as double quotation marks)"
NSQ_SOURCE_LINE 00005833 "it contains and adding the required type of outer quotation marks."
NSQ_SOURCE_LINE 00005834 ""
NSQ_SOURCE_LINE 00005835 "Undefined names are ignored and the remainder are quoted and then"
NSQ_SOURCE_LINE 00005836 "joined together, typically with a dot (C<.>) character. For example:"
NSQ_SOURCE_LINE 00005837 ""
NSQ_SOURCE_LINE 00005838 "  $id = $dbh->quote_identifier( undef, 'Her schema', 'My table' );"
NSQ_SOURCE_LINE 00005839 ""
NSQ_SOURCE_LINE 00005840 "would, for most database types, return C<\"Her schema\".\"My table\">"
NSQ_SOURCE_LINE 00005841 "(including all the double quotation marks)."
NSQ_SOURCE_LINE 00005842 ""
NSQ_SOURCE_LINE 00005843 "If three names are supplied then the first is assumed to be a"
NSQ_SOURCE_LINE 00005844 "catalog name and special rules may be applied based on what L</get_info>"
NSQ_SOURCE_LINE 00005845 "returns for SQL_CATALOG_NAME_SEPARATOR (41) and SQL_CATALOG_LOCATION (114)."
NSQ_SOURCE_LINE 00005846 "For example, for Oracle:"
NSQ_SOURCE_LINE 00005847 ""
NSQ_SOURCE_LINE 00005848 "  $id = $dbh->quote_identifier( 'link', 'schema', 'table' );"
NSQ_SOURCE_LINE 00005849 ""
NSQ_SOURCE_LINE 00005850 "would return C<\"schema\".\"table\"@\"link\">."
NSQ_SOURCE_LINE 00005851 ""
NSQ_SOURCE_LINE 00005852 "=head3 C<take_imp_data>"
NSQ_SOURCE_LINE 00005853 ""
NSQ_SOURCE_LINE 00005854 "  $imp_data = $dbh->take_imp_data;"
NSQ_SOURCE_LINE 00005855 ""
NSQ_SOURCE_LINE 00005856 "Leaves the $dbh in an almost dead, zombie-like, state and returns"
NSQ_SOURCE_LINE 00005857 "a binary string of raw implementation data from the driver which"
NSQ_SOURCE_LINE 00005858 "describes the current database connection. Effectively it detaches"
NSQ_SOURCE_LINE 00005859 "the underlying database API connection data from the DBI handle."
NSQ_SOURCE_LINE 00005860 "After calling take_imp_data(), all other methods except C<DESTROY>"
NSQ_SOURCE_LINE 00005861 "will generate a warning and return undef."
NSQ_SOURCE_LINE 00005862 ""
NSQ_SOURCE_LINE 00005863 "Why would you want to do this? You don't, forget I even mentioned it."
NSQ_SOURCE_LINE 00005864 "Unless, that is, you're implementing something advanced like a"
NSQ_SOURCE_LINE 00005865 "multi-threaded connection pool like C<DBI::Pool>."
NSQ_SOURCE_LINE 00005866 ""
NSQ_SOURCE_LINE 00005867 "The returned $imp_data can be passed as a C<dbi_imp_data> attribute"
NSQ_SOURCE_LINE 00005868 "to a later connect() call, even in a separate thread in the same"
NSQ_SOURCE_LINE 00005869 "process, where the driver can use it to 'adopt' the existing"
NSQ_SOURCE_LINE 00005870 "connection that the implementation data was taken from."
NSQ_SOURCE_LINE 00005871 ""
NSQ_SOURCE_LINE 00005872 "Some things to keep in mind..."
NSQ_SOURCE_LINE 00005873 ""
NSQ_SOURCE_LINE 00005874 "B<*> the $imp_data holds the only reference to the underlying"
NSQ_SOURCE_LINE 00005875 "database API connection data. That connection is still 'live' and"
NSQ_SOURCE_LINE 00005876 "won't be cleaned up properly unless the $imp_data is used to create"
NSQ_SOURCE_LINE 00005877 "a new $dbh which is then allowed to disconnect() normally."
NSQ_SOURCE_LINE 00005878 ""
NSQ_SOURCE_LINE 00005879 "B<*> using the same $imp_data to create more than one other new"
NSQ_SOURCE_LINE 00005880 "$dbh at a time may well lead to unpleasant problems. Don't do that."
NSQ_SOURCE_LINE 00005881 ""
NSQ_SOURCE_LINE 00005882 "Any child statement handles are effectively destroyed when take_imp_data() is"
NSQ_SOURCE_LINE 00005883 "called."
NSQ_SOURCE_LINE 00005884 ""
NSQ_SOURCE_LINE 00005885 "The C<take_imp_data> method was added in DBI 1.36 but wasn't useful till 1.49."
NSQ_SOURCE_LINE 00005886 ""
NSQ_SOURCE_LINE 00005887 ""
NSQ_SOURCE_LINE 00005888 "=head2 Database Handle Attributes"
NSQ_SOURCE_LINE 00005889 ""
NSQ_SOURCE_LINE 00005890 "This section describes attributes specific to database handles."
NSQ_SOURCE_LINE 00005891 ""
NSQ_SOURCE_LINE 00005892 "Changes to these database handle attributes do not affect any other"
NSQ_SOURCE_LINE 00005893 "existing or future database handles."
NSQ_SOURCE_LINE 00005894 ""
NSQ_SOURCE_LINE 00005895 "Attempting to set or get the value of an unknown attribute generates a warning,"
NSQ_SOURCE_LINE 00005896 "except for private driver-specific attributes (which all have names"
NSQ_SOURCE_LINE 00005897 "starting with a lowercase letter)."
NSQ_SOURCE_LINE 00005898 ""
NSQ_SOURCE_LINE 00005899 "Example:"
NSQ_SOURCE_LINE 00005900 ""
NSQ_SOURCE_LINE 00005901 "  $h->{AutoCommit} = ...;\t# set/write"
NSQ_SOURCE_LINE 00005902 "  ... = $h->{AutoCommit};\t# get/read"
NSQ_SOURCE_LINE 00005903 ""
NSQ_SOURCE_LINE 00005904 "=head3 C<AutoCommit>"
NSQ_SOURCE_LINE 00005905 ""
NSQ_SOURCE_LINE 00005906 "Type: boolean"
NSQ_SOURCE_LINE 00005907 ""
NSQ_SOURCE_LINE 00005908 "If true, then database changes cannot be rolled-back (undone).  If false,"
NSQ_SOURCE_LINE 00005909 "then database changes automatically occur within a \"transaction\", which"
NSQ_SOURCE_LINE 00005910 "must either be committed or rolled back using the C<commit> or C<rollback>"
NSQ_SOURCE_LINE 00005911 "methods."
NSQ_SOURCE_LINE 00005912 ""
NSQ_SOURCE_LINE 00005913 "Drivers should always default to C<AutoCommit> mode (an unfortunate"
NSQ_SOURCE_LINE 00005914 "choice largely forced on the DBI by ODBC and JDBC conventions.)"
NSQ_SOURCE_LINE 00005915 ""
NSQ_SOURCE_LINE 00005916 "Attempting to set C<AutoCommit> to an unsupported value is a fatal error."
NSQ_SOURCE_LINE 00005917 "This is an important feature of the DBI. Applications that need"
NSQ_SOURCE_LINE 00005918 "full transaction behaviour can set C<$dbh-E<gt>{AutoCommit} = 0> (or"
NSQ_SOURCE_LINE 00005919 "set C<AutoCommit> to 0 via L</connect>)"
NSQ_SOURCE_LINE 00005920 "without having to check that the value was assigned successfully."
NSQ_SOURCE_LINE 00005921 ""
NSQ_SOURCE_LINE 00005922 "For the purposes of this description, we can divide databases into three"
NSQ_SOURCE_LINE 00005923 "categories:"
NSQ_SOURCE_LINE 00005924 ""
NSQ_SOURCE_LINE 00005925 "  Databases which don't support transactions at all."
NSQ_SOURCE_LINE 00005926 "  Databases in which a transaction is always active."
NSQ_SOURCE_LINE 00005927 "  Databases in which a transaction must be explicitly started (C<'BEGIN WORK'>)."
NSQ_SOURCE_LINE 00005928 ""
NSQ_SOURCE_LINE 00005929 "B<* Databases which don't support transactions at all>"
NSQ_SOURCE_LINE 00005930 ""
NSQ_SOURCE_LINE 00005931 "For these databases, attempting to turn C<AutoCommit> off is a fatal error."
NSQ_SOURCE_LINE 00005932 "C<commit> and C<rollback> both issue warnings about being ineffective while"
NSQ_SOURCE_LINE 00005933 "C<AutoCommit> is in effect."
NSQ_SOURCE_LINE 00005934 ""
NSQ_SOURCE_LINE 00005935 "B<* Databases in which a transaction is always active>"
NSQ_SOURCE_LINE 00005936 ""
NSQ_SOURCE_LINE 00005937 "These are typically mainstream commercial relational databases with"
NSQ_SOURCE_LINE 00005938 "\"ANSI standard\" transaction behaviour."
NSQ_SOURCE_LINE 00005939 "If C<AutoCommit> is off, then changes to the database won't have any"
NSQ_SOURCE_LINE 00005940 "lasting effect unless L</commit> is called (but see also"
NSQ_SOURCE_LINE 00005941 "L</disconnect>). If L</rollback> is called then any changes since the"
NSQ_SOURCE_LINE 00005942 "last commit are undone."
NSQ_SOURCE_LINE 00005943 ""
NSQ_SOURCE_LINE 00005944 "If C<AutoCommit> is on, then the effect is the same as if the DBI"
NSQ_SOURCE_LINE 00005945 "called C<commit> automatically after every successful database"
NSQ_SOURCE_LINE 00005946 "operation. So calling C<commit> or C<rollback> explicitly while"
NSQ_SOURCE_LINE 00005947 "C<AutoCommit> is on would be ineffective because the changes would"
NSQ_SOURCE_LINE 00005948 "have already been committed."
NSQ_SOURCE_LINE 00005949 ""
NSQ_SOURCE_LINE 00005950 "Changing C<AutoCommit> from off to on will trigger a L</commit>."
NSQ_SOURCE_LINE 00005951 ""
NSQ_SOURCE_LINE 00005952 "For databases which don't support a specific auto-commit mode, the"
NSQ_SOURCE_LINE 00005953 "driver has to commit each statement automatically using an explicit"
NSQ_SOURCE_LINE 00005954 "C<COMMIT> after it completes successfully (and roll it back using an"
NSQ_SOURCE_LINE 00005955 "explicit C<ROLLBACK> if it fails).  The error information reported to the"
NSQ_SOURCE_LINE 00005956 "application will correspond to the statement which was executed, unless"
NSQ_SOURCE_LINE 00005957 "it succeeded and the commit or rollback failed."
NSQ_SOURCE_LINE 00005958 ""
NSQ_SOURCE_LINE 00005959 "B<* Databases in which a transaction must be explicitly started>"
NSQ_SOURCE_LINE 00005960 ""
NSQ_SOURCE_LINE 00005961 "For these databases, the intention is to have them act like databases in"
NSQ_SOURCE_LINE 00005962 "which a transaction is always active (as described above)."
NSQ_SOURCE_LINE 00005963 ""
NSQ_SOURCE_LINE 00005964 "To do this, the driver will automatically begin an explicit transaction"
NSQ_SOURCE_LINE 00005965 "when C<AutoCommit> is turned off, or after a L</commit> or"
NSQ_SOURCE_LINE 00005966 "L</rollback> (or when the application issues the next database"
NSQ_SOURCE_LINE 00005967 "operation after one of those events)."
NSQ_SOURCE_LINE 00005968 ""
NSQ_SOURCE_LINE 00005969 "In this way, the application does not have to treat these databases"
NSQ_SOURCE_LINE 00005970 "as a special case."
NSQ_SOURCE_LINE 00005971 ""
NSQ_SOURCE_LINE 00005972 "See L</commit>, L</disconnect> and L</Transactions> for other important"
NSQ_SOURCE_LINE 00005973 "notes about transactions."
NSQ_SOURCE_LINE 00005974 ""
NSQ_SOURCE_LINE 00005975 ""
NSQ_SOURCE_LINE 00005976 "=head3 C<Driver>"
NSQ_SOURCE_LINE 00005977 ""
NSQ_SOURCE_LINE 00005978 "Type: handle"
NSQ_SOURCE_LINE 00005979 ""
NSQ_SOURCE_LINE 00005980 "Holds the handle of the parent driver. The only recommended use for this"
NSQ_SOURCE_LINE 00005981 "is to find the name of the driver using:"
NSQ_SOURCE_LINE 00005982 ""
NSQ_SOURCE_LINE 00005983 "  $dbh->{Driver}->{Name}"
NSQ_SOURCE_LINE 00005984 ""
NSQ_SOURCE_LINE 00005985 ""
NSQ_SOURCE_LINE 00005986 "=head3 C<Name>"
NSQ_SOURCE_LINE 00005987 ""
NSQ_SOURCE_LINE 00005988 "Type: string"
NSQ_SOURCE_LINE 00005989 ""
NSQ_SOURCE_LINE 00005990 "Holds the \"name\" of the database. Usually (and recommended to be) the"
NSQ_SOURCE_LINE 00005991 "same as the \"C<dbi:DriverName:...>\" string used to connect to the database,"
NSQ_SOURCE_LINE 00005992 "but with the leading \"C<dbi:DriverName:>\" removed."
NSQ_SOURCE_LINE 00005993 ""
NSQ_SOURCE_LINE 00005994 ""
NSQ_SOURCE_LINE 00005995 "=head3 C<Statement>"
NSQ_SOURCE_LINE 00005996 ""
NSQ_SOURCE_LINE 00005997 "Type: string, read-only"
NSQ_SOURCE_LINE 00005998 ""
NSQ_SOURCE_LINE 00005999 "Returns the statement string passed to the most recent L</prepare> or"
NSQ_SOURCE_LINE 00006000 "L</do> method called in this database handle, even if that method"
NSQ_SOURCE_LINE 00006001 "failed. This is especially useful where C<RaiseError> is enabled and"
NSQ_SOURCE_LINE 00006002 "the exception handler checks $@ and sees that a 'prepare' method call"
NSQ_SOURCE_LINE 00006003 "failed."
NSQ_SOURCE_LINE 00006004 ""
NSQ_SOURCE_LINE 00006005 ""
NSQ_SOURCE_LINE 00006006 "=head3 C<RowCacheSize>"
NSQ_SOURCE_LINE 00006007 ""
NSQ_SOURCE_LINE 00006008 "Type: integer"
NSQ_SOURCE_LINE 00006009 ""
NSQ_SOURCE_LINE 00006010 "A hint to the driver indicating the size of the local row cache that the"
NSQ_SOURCE_LINE 00006011 "application would like the driver to use for future C<SELECT> statements."
NSQ_SOURCE_LINE 00006012 "If a row cache is not implemented, then setting C<RowCacheSize> is ignored"
NSQ_SOURCE_LINE 00006013 "and getting the value returns C<undef>."
NSQ_SOURCE_LINE 00006014 ""
NSQ_SOURCE_LINE 00006015 "Some C<RowCacheSize> values have special meaning, as follows:"
NSQ_SOURCE_LINE 00006016 ""
NSQ_SOURCE_LINE 00006017 "  0 - Automatically determine a reasonable cache size for each C<SELECT>"
NSQ_SOURCE_LINE 00006018 "  1 - Disable the local row cache"
NSQ_SOURCE_LINE 00006019 " >1 - Cache this many rows"
NSQ_SOURCE_LINE 00006020 " <0 - Cache as many rows that will fit into this much memory for each C<SELECT>."
NSQ_SOURCE_LINE 00006021 ""
NSQ_SOURCE_LINE 00006022 "Note that large cache sizes may require a very large amount of memory"
NSQ_SOURCE_LINE 00006023 "(I<cached rows * maximum size of row>). Also, a large cache will cause"
NSQ_SOURCE_LINE 00006024 "a longer delay not only for the first fetch, but also whenever the"
NSQ_SOURCE_LINE 00006025 "cache needs refilling."
NSQ_SOURCE_LINE 00006026 ""
NSQ_SOURCE_LINE 00006027 "See also the L</RowsInCache> statement handle attribute."
NSQ_SOURCE_LINE 00006028 ""
NSQ_SOURCE_LINE 00006029 "=head3 C<Username>"
NSQ_SOURCE_LINE 00006030 ""
NSQ_SOURCE_LINE 00006031 "Type: string"
NSQ_SOURCE_LINE 00006032 ""
NSQ_SOURCE_LINE 00006033 "Returns the username used to connect to the database."
NSQ_SOURCE_LINE 00006034 ""
NSQ_SOURCE_LINE 00006035 ""
NSQ_SOURCE_LINE 00006036 "=head1 DBI STATEMENT HANDLE OBJECTS"
NSQ_SOURCE_LINE 00006037 ""
NSQ_SOURCE_LINE 00006038 "This section lists the methods and attributes associated with DBI"
NSQ_SOURCE_LINE 00006039 "statement handles."
NSQ_SOURCE_LINE 00006040 ""
NSQ_SOURCE_LINE 00006041 "=head2 Statement Handle Methods"
NSQ_SOURCE_LINE 00006042 ""
NSQ_SOURCE_LINE 00006043 "The DBI defines the following methods for use on DBI statement handles:"
NSQ_SOURCE_LINE 00006044 ""
NSQ_SOURCE_LINE 00006045 "=head3 C<bind_param>"
NSQ_SOURCE_LINE 00006046 ""
NSQ_SOURCE_LINE 00006047 "  $sth->bind_param($p_num, $bind_value)"
NSQ_SOURCE_LINE 00006048 "  $sth->bind_param($p_num, $bind_value, \\%attr)"
NSQ_SOURCE_LINE 00006049 "  $sth->bind_param($p_num, $bind_value, $bind_type)"
NSQ_SOURCE_LINE 00006050 ""
NSQ_SOURCE_LINE 00006051 "The C<bind_param> method takes a copy of $bind_value and associates it"
NSQ_SOURCE_LINE 00006052 "(binds it) with a placeholder, identified by $p_num, embedded in"
NSQ_SOURCE_LINE 00006053 "the prepared statement. Placeholders are indicated with question"
NSQ_SOURCE_LINE 00006054 "mark character (C<?>). For example:"
NSQ_SOURCE_LINE 00006055 ""
NSQ_SOURCE_LINE 00006056 "  $dbh->{RaiseError} = 1;        # save having to check each method call"
NSQ_SOURCE_LINE 00006057 "  $sth = $dbh->prepare(\"SELECT name, age FROM people WHERE name LIKE ?\");"
NSQ_SOURCE_LINE 00006058 "  $sth->bind_param(1, \"John%\");  # placeholders are numbered from 1"
NSQ_SOURCE_LINE 00006059 "  $sth->execute;"
NSQ_SOURCE_LINE 00006060 "  DBI::dump_results($sth);"
NSQ_SOURCE_LINE 00006061 ""
NSQ_SOURCE_LINE 00006062 "See L</Placeholders and Bind Values> for more information."
NSQ_SOURCE_LINE 00006063 ""
NSQ_SOURCE_LINE 00006064 ""
NSQ_SOURCE_LINE 00006065 "B<Data Types for Placeholders>"
NSQ_SOURCE_LINE 00006066 ""
NSQ_SOURCE_LINE 00006067 "The C<\\%attr> parameter can be used to hint at the data type the"
NSQ_SOURCE_LINE 00006068 "placeholder should have. This is rarely needed. Typically, the driver is only"
NSQ_SOURCE_LINE 00006069 "interested in knowing if the placeholder should be bound as a number or a string."
NSQ_SOURCE_LINE 00006070 ""
NSQ_SOURCE_LINE 00006071 "  $sth->bind_param(1, $value, { TYPE => SQL_INTEGER });"
NSQ_SOURCE_LINE 00006072 ""
NSQ_SOURCE_LINE 00006073 "As a short-cut for the common case, the data type can be passed"
NSQ_SOURCE_LINE 00006074 "directly, in place of the C<\\%attr> hash reference. This example is"
NSQ_SOURCE_LINE 00006075 "equivalent to the one above:"
NSQ_SOURCE_LINE 00006076 ""
NSQ_SOURCE_LINE 00006077 "  $sth->bind_param(1, $value, SQL_INTEGER);"
NSQ_SOURCE_LINE 00006078 ""
NSQ_SOURCE_LINE 00006079 "The C<TYPE> value indicates the standard (non-driver-specific) type for"
NSQ_SOURCE_LINE 00006080 "this parameter. To specify the driver-specific type, the driver may"
NSQ_SOURCE_LINE 00006081 "support a driver-specific attribute, such as C<{ ora_type =E<gt> 97 }>."
NSQ_SOURCE_LINE 00006082 ""
NSQ_SOURCE_LINE 00006083 "The SQL_INTEGER and other related constants can be imported using"
NSQ_SOURCE_LINE 00006084 ""
NSQ_SOURCE_LINE 00006085 "  use DBI qw(:sql_types);"
NSQ_SOURCE_LINE 00006086 ""
NSQ_SOURCE_LINE 00006087 "See L</\"DBI Constants\"> for more information."
NSQ_SOURCE_LINE 00006088 ""
NSQ_SOURCE_LINE 00006089 "The data type is 'sticky' in that bind values passed to execute() are bound"
NSQ_SOURCE_LINE 00006090 "with the data type specified by earlier bind_param() calls, if any."
NSQ_SOURCE_LINE 00006091 "Portable applications should not rely on being able to change the data type"
NSQ_SOURCE_LINE 00006092 "after the first C<bind_param> call."
NSQ_SOURCE_LINE 00006093 ""
NSQ_SOURCE_LINE 00006094 "Perl only has string and number scalar data types. All database types"
NSQ_SOURCE_LINE 00006095 "that aren't numbers are bound as strings and must be in a format the"
NSQ_SOURCE_LINE 00006096 "database will understand except where the bind_param() TYPE attribute"
NSQ_SOURCE_LINE 00006097 "specifies a type that implies a particular format. For example, given:"
NSQ_SOURCE_LINE 00006098 ""
NSQ_SOURCE_LINE 00006099 "  $sth->bind_param(1, $value, SQL_DATETIME);"
NSQ_SOURCE_LINE 00006100 ""
NSQ_SOURCE_LINE 00006101 "the driver should expect $value to be in the ODBC standard SQL_DATETIME"
NSQ_SOURCE_LINE 00006102 "format, which is 'YYYY-MM-DD HH:MM:SS'. Similarly for SQL_DATE, SQL_TIME etc."
NSQ_SOURCE_LINE 00006103 ""
NSQ_SOURCE_LINE 00006104 "As an alternative to specifying the data type in the C<bind_param> call,"
NSQ_SOURCE_LINE 00006105 "you can let the driver pass the value as the default type (C<VARCHAR>)."
NSQ_SOURCE_LINE 00006106 "You can then use an SQL function to convert the type within the statement."
NSQ_SOURCE_LINE 00006107 "For example:"
NSQ_SOURCE_LINE 00006108 ""
NSQ_SOURCE_LINE 00006109 "  INSERT INTO price(code, price) VALUES (?, CONVERT(MONEY,?))"
NSQ_SOURCE_LINE 00006110 ""
NSQ_SOURCE_LINE 00006111 "The C<CONVERT> function used here is just an example. The actual function"
NSQ_SOURCE_LINE 00006112 "and syntax will vary between different databases and is non-portable."
NSQ_SOURCE_LINE 00006113 ""
NSQ_SOURCE_LINE 00006114 "See also L</Placeholders and Bind Values> for more information."
NSQ_SOURCE_LINE 00006115 ""
NSQ_SOURCE_LINE 00006116 ""
NSQ_SOURCE_LINE 00006117 "=head3 C<bind_param_inout>"
NSQ_SOURCE_LINE 00006118 ""
NSQ_SOURCE_LINE 00006119 "  $rc = $sth->bind_param_inout($p_num, \\$bind_value, $max_len)  or die $sth->errstr;"
NSQ_SOURCE_LINE 00006120 "  $rv = $sth->bind_param_inout($p_num, \\$bind_value, $max_len, \\%attr)     or ..."
NSQ_SOURCE_LINE 00006121 "  $rv = $sth->bind_param_inout($p_num, \\$bind_value, $max_len, $bind_type) or ..."
NSQ_SOURCE_LINE 00006122 ""
NSQ_SOURCE_LINE 00006123 "This method acts like L</bind_param>, but also enables values to be"
NSQ_SOURCE_LINE 00006124 "updated by the statement. The statement is typically"
NSQ_SOURCE_LINE 00006125 "a call to a stored procedure. The C<$bind_value> must be passed as a"
NSQ_SOURCE_LINE 00006126 "reference to the actual value to be used."
NSQ_SOURCE_LINE 00006127 ""
NSQ_SOURCE_LINE 00006128 "Note that unlike L</bind_param>, the C<$bind_value> variable is not"
NSQ_SOURCE_LINE 00006129 "copied when C<bind_param_inout> is called. Instead, the value in the"
NSQ_SOURCE_LINE 00006130 "variable is read at the time L</execute> is called."
NSQ_SOURCE_LINE 00006131 ""
NSQ_SOURCE_LINE 00006132 "The additional C<$max_len> parameter specifies the minimum amount of"
NSQ_SOURCE_LINE 00006133 "memory to allocate to C<$bind_value> for the new value. If the value"
NSQ_SOURCE_LINE 00006134 "returned from the database is too"
NSQ_SOURCE_LINE 00006135 "big to fit, then the execution should fail. If unsure what value to use,"
NSQ_SOURCE_LINE 00006136 "pick a generous length, i.e., a length larger than the longest value that would ever be"
NSQ_SOURCE_LINE 00006137 "returned.  The only cost of using a larger value than needed is wasted memory."
NSQ_SOURCE_LINE 00006138 ""
NSQ_SOURCE_LINE 00006139 "Undefined values or C<undef> are used to indicate null values."
NSQ_SOURCE_LINE 00006140 "See also L</Placeholders and Bind Values> for more information."
NSQ_SOURCE_LINE 00006141 ""
NSQ_SOURCE_LINE 00006142 ""
NSQ_SOURCE_LINE 00006143 "=head3 C<bind_param_array>"
NSQ_SOURCE_LINE 00006144 ""
NSQ_SOURCE_LINE 00006145 "  $rc = $sth->bind_param_array($p_num, $array_ref_or_value)"
NSQ_SOURCE_LINE 00006146 "  $rc = $sth->bind_param_array($p_num, $array_ref_or_value, \\%attr)"
NSQ_SOURCE_LINE 00006147 "  $rc = $sth->bind_param_array($p_num, $array_ref_or_value, $bind_type)"
NSQ_SOURCE_LINE 00006148 ""
NSQ_SOURCE_LINE 00006149 "The C<bind_param_array> method is used to bind an array of values"
NSQ_SOURCE_LINE 00006150 "to a placeholder embedded in the prepared statement which is to be executed"
NSQ_SOURCE_LINE 00006151 "with L</execute_array>. For example:"
NSQ_SOURCE_LINE 00006152 ""
NSQ_SOURCE_LINE 00006153 "  $dbh->{RaiseError} = 1;        # save having to check each method call"
NSQ_SOURCE_LINE 00006154 "  $sth = $dbh->prepare(\"INSERT INTO staff (first_name, last_name, dept) VALUES(?, ?, ?)\");"
NSQ_SOURCE_LINE 00006155 "  $sth->bind_param_array(1, [ 'John', 'Mary', 'Tim' ]);"
NSQ_SOURCE_LINE 00006156 "  $sth->bind_param_array(2, [ 'Booth', 'Todd', 'Robinson' ]);"
NSQ_SOURCE_LINE 00006157 "  $sth->bind_param_array(3, \"SALES\"); # scalar will be reused for each row"
NSQ_SOURCE_LINE 00006158 "  $sth->execute_array( { ArrayTupleStatus => \\my @tuple_status } );"
NSQ_SOURCE_LINE 00006159 ""
NSQ_SOURCE_LINE 00006160 "The C<%attr> ($bind_type) argument is the same as defined for L</bind_param>."
NSQ_SOURCE_LINE 00006161 "Refer to L</bind_param> for general details on using placeholders."
NSQ_SOURCE_LINE 00006162 ""
NSQ_SOURCE_LINE 00006163 "(Note that bind_param_array() can I<not> be used to expand a"
NSQ_SOURCE_LINE 00006164 "placeholder into a list of values for a statement like \"SELECT foo"
NSQ_SOURCE_LINE 00006165 "WHERE bar IN (?)\".  A placeholder can only ever represent one value"
NSQ_SOURCE_LINE 00006166 "per execution.)"
NSQ_SOURCE_LINE 00006167 ""
NSQ_SOURCE_LINE 00006168 "Scalar values, including C<undef>, may also be bound by"
NSQ_SOURCE_LINE 00006169 "C<bind_param_array>. In which case the same value will be used for each"
NSQ_SOURCE_LINE 00006170 "L</execute> call. Driver-specific implementations may behave"
NSQ_SOURCE_LINE 00006171 "differently, e.g., when binding to a stored procedure call, some"
NSQ_SOURCE_LINE 00006172 "databases may permit mixing scalars and arrays as arguments."
NSQ_SOURCE_LINE 00006173 ""
NSQ_SOURCE_LINE 00006174 "The default implementation provided by DBI (for drivers that have"
NSQ_SOURCE_LINE 00006175 "not implemented array binding) is to iteratively call L</execute> for"
NSQ_SOURCE_LINE 00006176 "each parameter tuple provided in the bound arrays.  Drivers may"
NSQ_SOURCE_LINE 00006177 "provide more optimized implementations using whatever bulk operation"
NSQ_SOURCE_LINE 00006178 "support the database API provides. The default driver behaviour should"
NSQ_SOURCE_LINE 00006179 "match the default DBI behaviour, but always consult your driver"
NSQ_SOURCE_LINE 00006180 "documentation as there may be driver specific issues to consider."
NSQ_SOURCE_LINE 00006181 ""
NSQ_SOURCE_LINE 00006182 "Note that the default implementation currently only supports non-data"
NSQ_SOURCE_LINE 00006183 "returning statements (INSERT, UPDATE, but not SELECT). Also,"
NSQ_SOURCE_LINE 00006184 "C<bind_param_array> and L</bind_param> cannot be mixed in the same"
NSQ_SOURCE_LINE 00006185 "statement execution, and C<bind_param_array> must be used with"
NSQ_SOURCE_LINE 00006186 "L</execute_array>; using C<bind_param_array> will have no effect"
NSQ_SOURCE_LINE 00006187 "for L</execute>."
NSQ_SOURCE_LINE 00006188 ""
NSQ_SOURCE_LINE 00006189 "The C<bind_param_array> method was added in DBI 1.22."
NSQ_SOURCE_LINE 00006190 ""
NSQ_SOURCE_LINE 00006191 "=head3 C<execute>"
NSQ_SOURCE_LINE 00006192 ""
NSQ_SOURCE_LINE 00006193 "  $rv = $sth->execute                or die $sth->errstr;"
NSQ_SOURCE_LINE 00006194 "  $rv = $sth->execute(@bind_values)  or die $sth->errstr;"
NSQ_SOURCE_LINE 00006195 ""
NSQ_SOURCE_LINE 00006196 "Perform whatever processing is necessary to execute the prepared"
NSQ_SOURCE_LINE 00006197 "statement.  An C<undef> is returned if an error occurs.  A successful"
NSQ_SOURCE_LINE 00006198 "C<execute> always returns true regardless of the number of rows affected,"
NSQ_SOURCE_LINE 00006199 "even if it's zero (see below). It is always important to check the"
NSQ_SOURCE_LINE 00006200 "return status of C<execute> (and most other DBI methods) for errors"
NSQ_SOURCE_LINE 00006201 "if you're not using L</RaiseError>."
NSQ_SOURCE_LINE 00006202 ""
NSQ_SOURCE_LINE 00006203 "For a I<non>-C<SELECT> statement, C<execute> returns the number of rows"
NSQ_SOURCE_LINE 00006204 "affected, if known. If no rows were affected, then C<execute> returns"
NSQ_SOURCE_LINE 00006205 "\"C<0E0>\", which Perl will treat as 0 but will regard as true. Note that it"
NSQ_SOURCE_LINE 00006206 "is I<not> an error for no rows to be affected by a statement. If the"
NSQ_SOURCE_LINE 00006207 "number of rows affected is not known, then C<execute> returns -1."
NSQ_SOURCE_LINE 00006208 ""
NSQ_SOURCE_LINE 00006209 "For C<SELECT> statements, execute simply \"starts\" the query within the"
NSQ_SOURCE_LINE 00006210 "database engine. Use one of the fetch methods to retrieve the data after"
NSQ_SOURCE_LINE 00006211 "calling C<execute>.  The C<execute> method does I<not> return the number of"
NSQ_SOURCE_LINE 00006212 "rows that will be returned by the query (because most databases can't"
NSQ_SOURCE_LINE 00006213 "tell in advance), it simply returns a true value."
NSQ_SOURCE_LINE 00006214 ""
NSQ_SOURCE_LINE 00006215 "You can tell if the statement was a C<SELECT> statement by checking if"
NSQ_SOURCE_LINE 00006216 "C<$sth-E<gt>{NUM_OF_FIELDS}> is greater than zero after calling C<execute>."
NSQ_SOURCE_LINE 00006217 ""
NSQ_SOURCE_LINE 00006218 "If any arguments are given, then C<execute> will effectively call"
NSQ_SOURCE_LINE 00006219 "L</bind_param> for each value before executing the statement.  Values"
NSQ_SOURCE_LINE 00006220 "bound in this way are usually treated as C<SQL_VARCHAR> types unless"
NSQ_SOURCE_LINE 00006221 "the driver can determine the correct type (which is rare), or unless"
NSQ_SOURCE_LINE 00006222 "C<bind_param> (or C<bind_param_inout>) has already been used to"
NSQ_SOURCE_LINE 00006223 "specify the type."
NSQ_SOURCE_LINE 00006224 ""
NSQ_SOURCE_LINE 00006225 "Note that passing C<execute> an empty array is the same as passing no arguments"
NSQ_SOURCE_LINE 00006226 "at all, which will execute the statement with previously bound values."
NSQ_SOURCE_LINE 00006227 "That's probably not what you want."
NSQ_SOURCE_LINE 00006228 ""
NSQ_SOURCE_LINE 00006229 "If execute() is called on a statement handle that's still active"
NSQ_SOURCE_LINE 00006230 "($sth->{Active} is true) then it should effectively call finish()"
NSQ_SOURCE_LINE 00006231 "to tidy up the previous execution results before starting this new"
NSQ_SOURCE_LINE 00006232 "execution."
NSQ_SOURCE_LINE 00006233 ""
NSQ_SOURCE_LINE 00006234 "=head3 C<execute_array>"
NSQ_SOURCE_LINE 00006235 ""
NSQ_SOURCE_LINE 00006236 "  $tuples = $sth->execute_array(\\%attr) or die $sth->errstr;"
NSQ_SOURCE_LINE 00006237 "  $tuples = $sth->execute_array(\\%attr, @bind_values) or die $sth->errstr;"
NSQ_SOURCE_LINE 00006238 ""
NSQ_SOURCE_LINE 00006239 "  ($tuples, $rows) = $sth->execute_array(\\%attr) or die $sth->errstr;"
NSQ_SOURCE_LINE 00006240 "  ($tuples, $rows) = $sth->execute_array(\\%attr, @bind_values) or die $sth->errstr;"
NSQ_SOURCE_LINE 00006241 ""
NSQ_SOURCE_LINE 00006242 "Execute the prepared statement once for each parameter tuple"
NSQ_SOURCE_LINE 00006243 "(group of values) provided either in the @bind_values, or by prior"
NSQ_SOURCE_LINE 00006244 "calls to L</bind_param_array>, or via a reference passed in \\%attr."
NSQ_SOURCE_LINE 00006245 ""
NSQ_SOURCE_LINE 00006246 "When called in scalar context the execute_array() method returns the"
NSQ_SOURCE_LINE 00006247 "number of tuples executed, or C<undef> if an error occurred.  Like"
NSQ_SOURCE_LINE 00006248 "execute(), a successful execute_array() always returns true regardless"
NSQ_SOURCE_LINE 00006249 "of the number of tuples executed, even if it's zero. If there were any"
NSQ_SOURCE_LINE 00006250 "errors the ArrayTupleStatus array can be used to discover which tuples"
NSQ_SOURCE_LINE 00006251 "failed and with what errors."
NSQ_SOURCE_LINE 00006252 ""
NSQ_SOURCE_LINE 00006253 "When called in list context the execute_array() method returns two scalars;"
NSQ_SOURCE_LINE 00006254 "$tuples is the same as calling execute_array() in scalar context and $rows is"
NSQ_SOURCE_LINE 00006255 "the number of rows affected for each tuple, if available or"
NSQ_SOURCE_LINE 00006256 "-1 if the driver cannot determine this. NOTE, some drivers cannot determine"
NSQ_SOURCE_LINE 00006257 "the number of rows affected per tuple but can provide the number of rows"
NSQ_SOURCE_LINE 00006258 "affected for the batch."
NSQ_SOURCE_LINE 00006259 "If you are doing an update operation the returned rows affected may not be what"
NSQ_SOURCE_LINE 00006260 "you expect if, for instance, one or more of the tuples affected the same row"
NSQ_SOURCE_LINE 00006261 "multiple times.  Some drivers may not yet support list context, in which case"
NSQ_SOURCE_LINE 00006262 "$rows will be undef, or may not be able to provide the number of rows affected"
NSQ_SOURCE_LINE 00006263 "when performing this batch operation, in which case $rows will be -1."
NSQ_SOURCE_LINE 00006264 ""
NSQ_SOURCE_LINE 00006265 "Bind values for the tuples to be executed may be supplied row-wise"
NSQ_SOURCE_LINE 00006266 "by an C<ArrayTupleFetch> attribute, or else column-wise in the"
NSQ_SOURCE_LINE 00006267 "C<@bind_values> argument, or else column-wise by prior calls to"
NSQ_SOURCE_LINE 00006268 "L</bind_param_array>."
NSQ_SOURCE_LINE 00006269 ""
NSQ_SOURCE_LINE 00006270 "Where column-wise binding is used (via the C<@bind_values> argument"
NSQ_SOURCE_LINE 00006271 "or calls to bind_param_array()) the maximum number of elements in"
NSQ_SOURCE_LINE 00006272 "any one of the bound value arrays determines the number of tuples"
NSQ_SOURCE_LINE 00006273 "executed. Placeholders with fewer values in their parameter arrays"
NSQ_SOURCE_LINE 00006274 "are treated as if padded with undef (NULL) values."
NSQ_SOURCE_LINE 00006275 ""
NSQ_SOURCE_LINE 00006276 "If a scalar value is bound, instead of an array reference, it is"
NSQ_SOURCE_LINE 00006277 "treated as a I<variable> length array with all elements having the"
NSQ_SOURCE_LINE 00006278 "same value. It does not influence the number of tuples executed,"
NSQ_SOURCE_LINE 00006279 "so if all bound arrays have zero elements then zero tuples will"
NSQ_SOURCE_LINE 00006280 "be executed. If I<all> bound values are scalars then one tuple"
NSQ_SOURCE_LINE 00006281 "will be executed, making execute_array() act just like execute()."
NSQ_SOURCE_LINE 00006282 ""
NSQ_SOURCE_LINE 00006283 "The C<ArrayTupleFetch> attribute can be used to specify a reference"
NSQ_SOURCE_LINE 00006284 "to a subroutine that will be called to provide the bind values for"
NSQ_SOURCE_LINE 00006285 "each tuple execution. The subroutine should return an reference to"
NSQ_SOURCE_LINE 00006286 "an array which contains the appropriate number of bind values, or"
NSQ_SOURCE_LINE 00006287 "return an undef if there is no more data to execute."
NSQ_SOURCE_LINE 00006288 ""
NSQ_SOURCE_LINE 00006289 "As a convenience, the C<ArrayTupleFetch> attribute can also be"
NSQ_SOURCE_LINE 00006290 "used to specify a statement handle. In which case the fetchrow_arrayref()"
NSQ_SOURCE_LINE 00006291 "method will be called on the given statement handle in order to"
NSQ_SOURCE_LINE 00006292 "provide the bind values for each tuple execution."
NSQ_SOURCE_LINE 00006293 ""
NSQ_SOURCE_LINE 00006294 "The values specified via bind_param_array() or the @bind_values"
NSQ_SOURCE_LINE 00006295 "parameter may be either scalars, or arrayrefs.  If any C<@bind_values>"
NSQ_SOURCE_LINE 00006296 "are given, then C<execute_array> will effectively call L</bind_param_array>"
NSQ_SOURCE_LINE 00006297 "for each value before executing the statement.  Values bound in"
NSQ_SOURCE_LINE 00006298 "this way are usually treated as C<SQL_VARCHAR> types unless the"
NSQ_SOURCE_LINE 00006299 "driver can determine the correct type (which is rare), or unless"
NSQ_SOURCE_LINE 00006300 "C<bind_param>, C<bind_param_inout>, C<bind_param_array>, or"
NSQ_SOURCE_LINE 00006301 "C<bind_param_inout_array> has already been used to specify the type."
NSQ_SOURCE_LINE 00006302 "See L</bind_param_array> for details."
NSQ_SOURCE_LINE 00006303 ""
NSQ_SOURCE_LINE 00006304 "The C<ArrayTupleStatus> attribute can be used to specify a"
NSQ_SOURCE_LINE 00006305 "reference to an array which will receive the execute status of each"
NSQ_SOURCE_LINE 00006306 "executed parameter tuple. Note the C<ArrayTupleStatus> attribute was"
NSQ_SOURCE_LINE 00006307 "mandatory until DBI 1.38."
NSQ_SOURCE_LINE 00006308 ""
NSQ_SOURCE_LINE 00006309 "For tuples which are successfully executed, the element at the same"
NSQ_SOURCE_LINE 00006310 "ordinal position in the status array is the resulting rowcount (or -1"
NSQ_SOURCE_LINE 00006311 "if unknown)."
NSQ_SOURCE_LINE 00006312 "If the execution of a tuple causes an error, then the corresponding"
NSQ_SOURCE_LINE 00006313 "status array element will be set to a reference to an array containing"
NSQ_SOURCE_LINE 00006314 "L</err>, L</errstr> and L</state> set by the failed execution."
NSQ_SOURCE_LINE 00006315 ""
NSQ_SOURCE_LINE 00006316 "If B<any> tuple execution returns an error, C<execute_array> will"
NSQ_SOURCE_LINE 00006317 "return C<undef>. In that case, the application should inspect the"
NSQ_SOURCE_LINE 00006318 "status array to determine which parameter tuples failed."
NSQ_SOURCE_LINE 00006319 "Some databases may not continue executing tuples beyond the first"
NSQ_SOURCE_LINE 00006320 "failure. In this case the status array will either hold fewer"
NSQ_SOURCE_LINE 00006321 "elements, or the elements beyond the failure will be undef."
NSQ_SOURCE_LINE 00006322 ""
NSQ_SOURCE_LINE 00006323 "If all parameter tuples are successfully executed, C<execute_array>"
NSQ_SOURCE_LINE 00006324 "returns the number tuples executed.  If no tuples were executed,"
NSQ_SOURCE_LINE 00006325 "then execute_array() returns \"C<0E0>\", just like execute() does,"
NSQ_SOURCE_LINE 00006326 "which Perl will treat as 0 but will regard as true."
NSQ_SOURCE_LINE 00006327 ""
NSQ_SOURCE_LINE 00006328 "For example:"
NSQ_SOURCE_LINE 00006329 ""
NSQ_SOURCE_LINE 00006330 "  $sth = $dbh->prepare(\"INSERT INTO staff (first_name, last_name) VALUES (?, ?)\");"
NSQ_SOURCE_LINE 00006331 "  my $tuples = $sth->execute_array("
NSQ_SOURCE_LINE 00006332 "      { ArrayTupleStatus => \\my @tuple_status },"
NSQ_SOURCE_LINE 00006333 "      \\@first_names,"
NSQ_SOURCE_LINE 00006334 "      \\@last_names,"
NSQ_SOURCE_LINE 00006335 "  );"
NSQ_SOURCE_LINE 00006336 "  if ($tuples) {"
NSQ_SOURCE_LINE 00006337 "      print \"Successfully inserted $tuples records\\n\";"
NSQ_SOURCE_LINE 00006338 "  }"
NSQ_SOURCE_LINE 00006339 "  else {"
NSQ_SOURCE_LINE 00006340 "      for my $tuple (0..@last_names-1) {"
NSQ_SOURCE_LINE 00006341 "          my $status = $tuple_status[$tuple];"
NSQ_SOURCE_LINE 00006342 "          $status = [0, \"Skipped\"] unless defined $status;"
NSQ_SOURCE_LINE 00006343 "          next unless ref $status;"
NSQ_SOURCE_LINE 00006344 "          printf \"Failed to insert (%s, %s): %s\\n\","
NSQ_SOURCE_LINE 00006345 "              $first_names[$tuple], $last_names[$tuple], $status->[1];"
NSQ_SOURCE_LINE 00006346 "      }"
NSQ_SOURCE_LINE 00006347 "  }"
NSQ_SOURCE_LINE 00006348 ""
NSQ_SOURCE_LINE 00006349 "Support for data returning statements such as SELECT is driver-specific"
NSQ_SOURCE_LINE 00006350 "and subject to change. At present, the default implementation"
NSQ_SOURCE_LINE 00006351 "provided by DBI only supports non-data returning statements."
NSQ_SOURCE_LINE 00006352 ""
NSQ_SOURCE_LINE 00006353 "Transaction semantics when using array binding are driver and"
NSQ_SOURCE_LINE 00006354 "database specific.  If C<AutoCommit> is on, the default DBI"
NSQ_SOURCE_LINE 00006355 "implementation will cause each parameter tuple to be individually"
NSQ_SOURCE_LINE 00006356 "committed (or rolled back in the event of an error). If C<AutoCommit>"
NSQ_SOURCE_LINE 00006357 "is off, the application is responsible for explicitly committing"
NSQ_SOURCE_LINE 00006358 "the entire set of bound parameter tuples.  Note that different"
NSQ_SOURCE_LINE 00006359 "drivers and databases may have different behaviours when some"
NSQ_SOURCE_LINE 00006360 "parameter tuples cause failures. In some cases, the driver or"
NSQ_SOURCE_LINE 00006361 "database may automatically rollback the effect of all prior parameter"
NSQ_SOURCE_LINE 00006362 "tuples that succeeded in the transaction; other drivers or databases"
NSQ_SOURCE_LINE 00006363 "may retain the effect of prior successfully executed parameter"
NSQ_SOURCE_LINE 00006364 "tuples. Be sure to check your driver and database for its specific"
NSQ_SOURCE_LINE 00006365 "behaviour."
NSQ_SOURCE_LINE 00006366 ""
NSQ_SOURCE_LINE 00006367 "Note that, in general, performance will usually be better with"
NSQ_SOURCE_LINE 00006368 "C<AutoCommit> turned off, and using explicit C<commit> after each"
NSQ_SOURCE_LINE 00006369 "C<execute_array> call."
NSQ_SOURCE_LINE 00006370 ""
NSQ_SOURCE_LINE 00006371 "The C<execute_array> method was added in DBI 1.22, and ArrayTupleFetch"
NSQ_SOURCE_LINE 00006372 "was added in 1.36."
NSQ_SOURCE_LINE 00006373 ""
NSQ_SOURCE_LINE 00006374 "=head3 C<execute_for_fetch>"
NSQ_SOURCE_LINE 00006375 ""
NSQ_SOURCE_LINE 00006376 "  $tuples = $sth->execute_for_fetch($fetch_tuple_sub);"
NSQ_SOURCE_LINE 00006377 "  $tuples = $sth->execute_for_fetch($fetch_tuple_sub, \\@tuple_status);"
NSQ_SOURCE_LINE 00006378 ""
NSQ_SOURCE_LINE 00006379 "  ($tuples, $rows) = $sth->execute_for_fetch($fetch_tuple_sub);"
NSQ_SOURCE_LINE 00006380 "  ($tuples, $rows) = $sth->execute_for_fetch($fetch_tuple_sub, \\@tuple_status);"
NSQ_SOURCE_LINE 00006381 ""
NSQ_SOURCE_LINE 00006382 "The execute_for_fetch() method is used to perform bulk operations and"
NSQ_SOURCE_LINE 00006383 "although it is most often used via the execute_array() method you can"
NSQ_SOURCE_LINE 00006384 "use it directly. The main difference between execute_array and"
NSQ_SOURCE_LINE 00006385 "execute_for_fetch is the former does column or row-wise binding and"
NSQ_SOURCE_LINE 00006386 "the latter uses row-wise binding."
NSQ_SOURCE_LINE 00006387 ""
NSQ_SOURCE_LINE 00006388 "The fetch subroutine, referenced by $fetch_tuple_sub, is expected"
NSQ_SOURCE_LINE 00006389 "to return a reference to an array (known as a 'tuple') or undef."
NSQ_SOURCE_LINE 00006390 ""
NSQ_SOURCE_LINE 00006391 "The execute_for_fetch() method calls $fetch_tuple_sub, without any"
NSQ_SOURCE_LINE 00006392 "parameters, until it returns a false value. Each tuple returned is"
NSQ_SOURCE_LINE 00006393 "used to provide bind values for an $sth->execute(@$tuple) call."
NSQ_SOURCE_LINE 00006394 ""
NSQ_SOURCE_LINE 00006395 "In scalar context execute_for_fetch() returns C<undef> if there were any"
NSQ_SOURCE_LINE 00006396 "errors and the number of tuples executed otherwise. Like execute() and"
NSQ_SOURCE_LINE 00006397 "execute_array() a zero is returned as \"0E0\" so execute_for_fetch() is"
NSQ_SOURCE_LINE 00006398 "only false on error.  If there were any errors the @tuple_status array"
NSQ_SOURCE_LINE 00006399 "can be used to discover which tuples failed and with what errors."
NSQ_SOURCE_LINE 00006400 ""
NSQ_SOURCE_LINE 00006401 "When called in list context execute_for_fetch() returns two scalars;"
NSQ_SOURCE_LINE 00006402 "$tuples is the same as calling execute_for_fetch() in scalar context and $rows is"
NSQ_SOURCE_LINE 00006403 "the sum of the number of rows affected for each tuple, if available or -1"
NSQ_SOURCE_LINE 00006404 "if the driver cannot determine this."
NSQ_SOURCE_LINE 00006405 "If you are doing an update operation the returned rows affected may not be what"
NSQ_SOURCE_LINE 00006406 "you expect if, for instance, one or more of the tuples affected the same row"
NSQ_SOURCE_LINE 00006407 "multiple times.  Some drivers may not yet support list context, in which case"
NSQ_SOURCE_LINE 00006408 "$rows will be undef, or may not be able to provide the number of rows affected"
NSQ_SOURCE_LINE 00006409 "when performing this batch operation, in which case $rows will be -1."
NSQ_SOURCE_LINE 00006410 ""
NSQ_SOURCE_LINE 00006411 "If \\@tuple_status is passed then the execute_for_fetch method uses"
NSQ_SOURCE_LINE 00006412 "it to return status information. The tuple_status array holds one"
NSQ_SOURCE_LINE 00006413 "element per tuple. If the corresponding execute() did not fail then"
NSQ_SOURCE_LINE 00006414 "the element holds the return value from execute(), which is typically"
NSQ_SOURCE_LINE 00006415 "a row count. If the execute() did fail then the element holds a"
NSQ_SOURCE_LINE 00006416 "reference to an array containing ($sth->err, $sth->errstr, $sth->state)."
NSQ_SOURCE_LINE 00006417 ""
NSQ_SOURCE_LINE 00006418 "If the driver detects an error that it knows means no further tuples can be"
NSQ_SOURCE_LINE 00006419 "executed then it may return, with an error status, even though $fetch_tuple_sub"
NSQ_SOURCE_LINE 00006420 "may still have more tuples to be executed."
NSQ_SOURCE_LINE 00006421 ""
NSQ_SOURCE_LINE 00006422 "Although each tuple returned by $fetch_tuple_sub is effectively used"
NSQ_SOURCE_LINE 00006423 "to call $sth->execute(@$tuple_array_ref) the exact timing may vary."
NSQ_SOURCE_LINE 00006424 "Drivers are free to accumulate sets of tuples to pass to the"
NSQ_SOURCE_LINE 00006425 "database server in bulk group operations for more efficient execution."
NSQ_SOURCE_LINE 00006426 "However, the $fetch_tuple_sub is specifically allowed to return"
NSQ_SOURCE_LINE 00006427 "the same array reference each time (which is what fetchrow_arrayref()"
NSQ_SOURCE_LINE 00006428 "usually does)."
NSQ_SOURCE_LINE 00006429 ""
NSQ_SOURCE_LINE 00006430 "For example:"
NSQ_SOURCE_LINE 00006431 ""
NSQ_SOURCE_LINE 00006432 "  my $sel = $dbh1->prepare(\"select foo, bar from table1\");"
NSQ_SOURCE_LINE 00006433 "  $sel->execute;"
NSQ_SOURCE_LINE 00006434 ""
NSQ_SOURCE_LINE 00006435 "  my $ins = $dbh2->prepare(\"insert into table2 (foo, bar) values (?,?)\");"
NSQ_SOURCE_LINE 00006436 "  my $fetch_tuple_sub = sub { $sel->fetchrow_arrayref };"
NSQ_SOURCE_LINE 00006437 ""
NSQ_SOURCE_LINE 00006438 "  my @tuple_status;"
NSQ_SOURCE_LINE 00006439 "  $rc = $ins->execute_for_fetch($fetch_tuple_sub, \\@tuple_status);"
NSQ_SOURCE_LINE 00006440 "  my @errors = grep { ref $_ } @tuple_status;"
NSQ_SOURCE_LINE 00006441 ""
NSQ_SOURCE_LINE 00006442 "Similarly, if you already have an array containing the data rows"
NSQ_SOURCE_LINE 00006443 "to be processed you'd use a subroutine to shift off and return"
NSQ_SOURCE_LINE 00006444 "each array ref in turn:"
NSQ_SOURCE_LINE 00006445 ""
NSQ_SOURCE_LINE 00006446 "  $ins->execute_for_fetch( sub { shift @array_of_arrays }, \\@tuple_status);"
NSQ_SOURCE_LINE 00006447 ""
NSQ_SOURCE_LINE 00006448 "The C<execute_for_fetch> method was added in DBI 1.38."
NSQ_SOURCE_LINE 00006449 ""
NSQ_SOURCE_LINE 00006450 "=head3 C<last_insert_id>"
NSQ_SOURCE_LINE 00006451 ""
NSQ_SOURCE_LINE 00006452 "  $rv = $sth->last_insert_id();"
NSQ_SOURCE_LINE 00006453 "  $rv = $sth->last_insert_id($catalog, $schema, $table, $field);"
NSQ_SOURCE_LINE 00006454 "  $rv = $sth->last_insert_id($catalog, $schema, $table, $field, \\%attr);"
NSQ_SOURCE_LINE 00006455 ""
NSQ_SOURCE_LINE 00006456 "Returns a value 'identifying' the row inserted by last execution of the"
NSQ_SOURCE_LINE 00006457 "statement C<$sth>, if possible."
NSQ_SOURCE_LINE 00006458 ""
NSQ_SOURCE_LINE 00006459 "For some drivers the value may be 'identifying' the row inserted by the"
NSQ_SOURCE_LINE 00006460 "last executed statement, not by C<$sth>."
NSQ_SOURCE_LINE 00006461 ""
NSQ_SOURCE_LINE 00006462 "See database handle method last_insert_id for all details."
NSQ_SOURCE_LINE 00006463 ""
NSQ_SOURCE_LINE 00006464 "The C<last_insert_id> statement method was added in DBI 1.642."
NSQ_SOURCE_LINE 00006465 ""
NSQ_SOURCE_LINE 00006466 "=head3 C<fetchrow_arrayref>"
NSQ_SOURCE_LINE 00006467 ""
NSQ_SOURCE_LINE 00006468 "  $ary_ref = $sth->fetchrow_arrayref;"
NSQ_SOURCE_LINE 00006469 "  $ary_ref = $sth->fetch;    # alias"
NSQ_SOURCE_LINE 00006470 ""
NSQ_SOURCE_LINE 00006471 "Fetches the next row of data and returns a reference to an array"
NSQ_SOURCE_LINE 00006472 "holding the field values.  Null fields are returned as C<undef>"
NSQ_SOURCE_LINE 00006473 "values in the array."
NSQ_SOURCE_LINE 00006474 "This is the fastest way to fetch data, particularly if used with"
NSQ_SOURCE_LINE 00006475 "C<$sth-E<gt>bind_columns>."
NSQ_SOURCE_LINE 00006476 ""
NSQ_SOURCE_LINE 00006477 "If there are no more rows or if an error occurs, then C<fetchrow_arrayref>"
NSQ_SOURCE_LINE 00006478 "returns an C<undef>. You should check C<$sth-E<gt>err> afterwards (or use the"
NSQ_SOURCE_LINE 00006479 "C<RaiseError> attribute) to discover if the C<undef> returned was due to an"
NSQ_SOURCE_LINE 00006480 "error."
NSQ_SOURCE_LINE 00006481 ""
NSQ_SOURCE_LINE 00006482 "Note that the same array reference is returned for each fetch, so don't"
NSQ_SOURCE_LINE 00006483 "store the reference and then use it after a later fetch.  Also, the"
NSQ_SOURCE_LINE 00006484 "elements of the array are also reused for each row, so take care if you"
NSQ_SOURCE_LINE 00006485 "want to take a reference to an element. See also L</bind_columns>."
NSQ_SOURCE_LINE 00006486 ""
NSQ_SOURCE_LINE 00006487 "=head3 C<fetchrow_array>"
NSQ_SOURCE_LINE 00006488 ""
NSQ_SOURCE_LINE 00006489 " @ary = $sth->fetchrow_array;"
NSQ_SOURCE_LINE 00006490 ""
NSQ_SOURCE_LINE 00006491 "An alternative to C<fetchrow_arrayref>. Fetches the next row of data"
NSQ_SOURCE_LINE 00006492 "and returns it as a list containing the field values.  Null fields"
NSQ_SOURCE_LINE 00006493 "are returned as C<undef> values in the list."
NSQ_SOURCE_LINE 00006494 ""
NSQ_SOURCE_LINE 00006495 "If there are no more rows or if an error occurs, then C<fetchrow_array>"
NSQ_SOURCE_LINE 00006496 "returns an empty list. You should check C<$sth-E<gt>err> afterwards (or use"
NSQ_SOURCE_LINE 00006497 "the C<RaiseError> attribute) to discover if the empty list returned was"
NSQ_SOURCE_LINE 00006498 "due to an error."
NSQ_SOURCE_LINE 00006499 ""
NSQ_SOURCE_LINE 00006500 "If called in a scalar context for a statement handle that has more"
NSQ_SOURCE_LINE 00006501 "than one column, it is undefined whether the driver will return"
NSQ_SOURCE_LINE 00006502 "the value of the first column or the last. So don't do that."
NSQ_SOURCE_LINE 00006503 "Also, in a scalar context, an C<undef> is returned if there are no"
NSQ_SOURCE_LINE 00006504 "more rows or if an error occurred. That C<undef> can't be distinguished"
NSQ_SOURCE_LINE 00006505 "from an C<undef> returned because the first field value was NULL."
NSQ_SOURCE_LINE 00006506 "For these reasons you should exercise some caution if you use"
NSQ_SOURCE_LINE 00006507 "C<fetchrow_array> in a scalar context."
NSQ_SOURCE_LINE 00006508 ""
NSQ_SOURCE_LINE 00006509 "=head3 C<fetchrow_hashref>"
NSQ_SOURCE_LINE 00006510 ""
NSQ_SOURCE_LINE 00006511 " $hash_ref = $sth->fetchrow_hashref;"
NSQ_SOURCE_LINE 00006512 " $hash_ref = $sth->fetchrow_hashref($name);"
NSQ_SOURCE_LINE 00006513 ""
NSQ_SOURCE_LINE 00006514 "An alternative to C<fetchrow_arrayref>. Fetches the next row of data"
NSQ_SOURCE_LINE 00006515 "and returns it as a reference to a hash containing field name and field"
NSQ_SOURCE_LINE 00006516 "value pairs.  Null fields are returned as C<undef> values in the hash."
NSQ_SOURCE_LINE 00006517 ""
NSQ_SOURCE_LINE 00006518 "If there are no more rows or if an error occurs, then C<fetchrow_hashref>"
NSQ_SOURCE_LINE 00006519 "returns an C<undef>. You should check C<$sth-E<gt>err> afterwards (or use the"
NSQ_SOURCE_LINE 00006520 "C<RaiseError> attribute) to discover if the C<undef> returned was due to an"
NSQ_SOURCE_LINE 00006521 "error."
NSQ_SOURCE_LINE 00006522 ""
NSQ_SOURCE_LINE 00006523 "The optional C<$name> parameter specifies the name of the statement handle"
NSQ_SOURCE_LINE 00006524 "attribute. For historical reasons it defaults to \"C<NAME>\", however using"
NSQ_SOURCE_LINE 00006525 "either \"C<NAME_lc>\" or \"C<NAME_uc>\" is recommended for portability."
NSQ_SOURCE_LINE 00006526 ""
NSQ_SOURCE_LINE 00006527 "The keys of the hash are the same names returned by C<$sth-E<gt>{$name}>. If"
NSQ_SOURCE_LINE 00006528 "more than one field has the same name, there will only be one entry in the"
NSQ_SOURCE_LINE 00006529 "returned hash for those fields, so statements like \"C<select foo, foo from bar>\""
NSQ_SOURCE_LINE 00006530 "will return only a single key from C<fetchrow_hashref>. In these cases use"
NSQ_SOURCE_LINE 00006531 "column aliases or C<fetchrow_arrayref>.  Note that it is the database server"
NSQ_SOURCE_LINE 00006532 "(and not the DBD implementation) which provides the I<name> for fields"
NSQ_SOURCE_LINE 00006533 "containing functions like \"C<count(*)>\" or \"C<max(c_foo)>\" and they may clash"
NSQ_SOURCE_LINE 00006534 "with existing column names (most databases don't care about duplicate column"
NSQ_SOURCE_LINE 00006535 "names in a result-set). If you want these to return as unique names that are"
NSQ_SOURCE_LINE 00006536 "the same across databases, use I<aliases>, as in \"C<select count(*) as cnt>\""
NSQ_SOURCE_LINE 00006537 "or \"C<select max(c_foo) mx_foo, ...>\" depending on the syntax your database"
NSQ_SOURCE_LINE 00006538 "supports."
NSQ_SOURCE_LINE 00006539 ""
NSQ_SOURCE_LINE 00006540 "Because of the extra work C<fetchrow_hashref> and Perl have to perform, it"
NSQ_SOURCE_LINE 00006541 "is not as efficient as C<fetchrow_arrayref> or C<fetchrow_array>."
NSQ_SOURCE_LINE 00006542 ""
NSQ_SOURCE_LINE 00006543 "By default a reference to a new hash is returned for each row."
NSQ_SOURCE_LINE 00006544 "It is likely that a future version of the DBI will support an"
NSQ_SOURCE_LINE 00006545 "attribute which will enable the same hash to be reused for each"
NSQ_SOURCE_LINE 00006546 "row. This will give a significant performance boost, but it won't"
NSQ_SOURCE_LINE 00006547 "be enabled by default because of the risk of breaking old code."
NSQ_SOURCE_LINE 00006548 ""
NSQ_SOURCE_LINE 00006549 ""
NSQ_SOURCE_LINE 00006550 "=head3 C<fetchall_arrayref>"
NSQ_SOURCE_LINE 00006551 ""
NSQ_SOURCE_LINE 00006552 "  $tbl_ary_ref = $sth->fetchall_arrayref;"
NSQ_SOURCE_LINE 00006553 "  $tbl_ary_ref = $sth->fetchall_arrayref( $slice );"
NSQ_SOURCE_LINE 00006554 "  $tbl_ary_ref = $sth->fetchall_arrayref( $slice, $max_rows  );"
NSQ_SOURCE_LINE 00006555 ""
NSQ_SOURCE_LINE 00006556 "The C<fetchall_arrayref> method can be used to fetch all the data to be"
NSQ_SOURCE_LINE 00006557 "returned from a prepared and executed statement handle. It returns a"
NSQ_SOURCE_LINE 00006558 "reference to an array that contains one reference per row."
NSQ_SOURCE_LINE 00006559 ""
NSQ_SOURCE_LINE 00006560 "If called on an I<inactive> statement handle, C<fetchall_arrayref> returns undef."
NSQ_SOURCE_LINE 00006561 ""
NSQ_SOURCE_LINE 00006562 "If there are no rows left to return from an I<active> statement handle, C<fetchall_arrayref> returns a reference"
NSQ_SOURCE_LINE 00006563 "to an empty array. If an error occurs, C<fetchall_arrayref> returns the"
NSQ_SOURCE_LINE 00006564 "data fetched thus far, which may be none.  You should check C<$sth-E<gt>err>"
NSQ_SOURCE_LINE 00006565 "afterwards (or use the C<RaiseError> attribute) to discover if the data is"
NSQ_SOURCE_LINE 00006566 "complete or was truncated due to an error."
NSQ_SOURCE_LINE 00006567 ""
NSQ_SOURCE_LINE 00006568 "If $slice is an array reference, C<fetchall_arrayref> uses L</fetchrow_arrayref>"
NSQ_SOURCE_LINE 00006569 "to fetch each row as an array ref. If the $slice array is not empty"
NSQ_SOURCE_LINE 00006570 "then it is used as a slice to select individual columns by perl array"
NSQ_SOURCE_LINE 00006571 "index number (starting at 0, unlike column and parameter numbers which"
NSQ_SOURCE_LINE 00006572 "start at 1)."
NSQ_SOURCE_LINE 00006573 ""
NSQ_SOURCE_LINE 00006574 "With no parameters, or if $slice is undefined, C<fetchall_arrayref>"
NSQ_SOURCE_LINE 00006575 "acts as if passed an empty array ref."
NSQ_SOURCE_LINE 00006576 ""
NSQ_SOURCE_LINE 00006577 "For example, to fetch just the first column of every row:"
NSQ_SOURCE_LINE 00006578 ""
NSQ_SOURCE_LINE 00006579 "  $tbl_ary_ref = $sth->fetchall_arrayref([0]);"
NSQ_SOURCE_LINE 00006580 ""
NSQ_SOURCE_LINE 00006581 "To fetch the second to last and last column of every row:"
NSQ_SOURCE_LINE 00006582 ""
NSQ_SOURCE_LINE 00006583 "  $tbl_ary_ref = $sth->fetchall_arrayref([-2,-1]);"
NSQ_SOURCE_LINE 00006584 ""
NSQ_SOURCE_LINE 00006585 "Those two examples both return a reference to an array of array refs."
NSQ_SOURCE_LINE 00006586 ""
NSQ_SOURCE_LINE 00006587 "If $slice is a hash reference, C<fetchall_arrayref> fetches each row as a hash"
NSQ_SOURCE_LINE 00006588 "reference. If the $slice hash is empty then the keys in the hashes have"
NSQ_SOURCE_LINE 00006589 "whatever name lettercase is returned by default. (See L</FetchHashKeyName>"
NSQ_SOURCE_LINE 00006590 "attribute.) If the $slice hash is I<not> empty, then it is used as a slice to"
NSQ_SOURCE_LINE 00006591 "select individual columns by name. The values of the hash should be set to 1."
NSQ_SOURCE_LINE 00006592 "The key names of the returned hashes match the letter case of the names in the"
NSQ_SOURCE_LINE 00006593 "parameter hash, regardless of the L</FetchHashKeyName> attribute."
NSQ_SOURCE_LINE 00006594 ""
NSQ_SOURCE_LINE 00006595 "For example, to fetch all fields of every row as a hash ref:"
NSQ_SOURCE_LINE 00006596 ""
NSQ_SOURCE_LINE 00006597 "  $tbl_ary_ref = $sth->fetchall_arrayref({});"
NSQ_SOURCE_LINE 00006598 ""
NSQ_SOURCE_LINE 00006599 "To fetch only the fields called \"foo\" and \"bar\" of every row as a hash ref"
NSQ_SOURCE_LINE 00006600 "(with keys named \"foo\" and \"BAR\", regardless of the original capitalization):"
NSQ_SOURCE_LINE 00006601 ""
NSQ_SOURCE_LINE 00006602 "  $tbl_ary_ref = $sth->fetchall_arrayref({ foo=>1, BAR=>1 });"
NSQ_SOURCE_LINE 00006603 ""
NSQ_SOURCE_LINE 00006604 "Those two examples both return a reference to an array of hash refs."
NSQ_SOURCE_LINE 00006605 ""
NSQ_SOURCE_LINE 00006606 "If $slice is a I<reference to a hash reference>, that hash is used to select"
NSQ_SOURCE_LINE 00006607 "and rename columns. The keys are 0-based column index numbers and the values"
NSQ_SOURCE_LINE 00006608 "are the corresponding keys for the returned row hashes."
NSQ_SOURCE_LINE 00006609 ""
NSQ_SOURCE_LINE 00006610 "For example, to fetch only the first and second columns of every row as a hash"
NSQ_SOURCE_LINE 00006611 "ref (with keys named \"k\" and \"v\" regardless of their original names):"
NSQ_SOURCE_LINE 00006612 ""
NSQ_SOURCE_LINE 00006613 "  $tbl_ary_ref = $sth->fetchall_arrayref( \\{ 0 => 'k', 1 => 'v' } );"
NSQ_SOURCE_LINE 00006614 ""
NSQ_SOURCE_LINE 00006615 "If $max_rows is defined and greater than or equal to zero then it"
NSQ_SOURCE_LINE 00006616 "is used to limit the number of rows fetched before returning."
NSQ_SOURCE_LINE 00006617 "fetchall_arrayref() can then be called again to fetch more rows."
NSQ_SOURCE_LINE 00006618 "This is especially useful when you need the better performance of"
NSQ_SOURCE_LINE 00006619 "fetchall_arrayref() but don't have enough memory to fetch and return"
NSQ_SOURCE_LINE 00006620 "all the rows in one go."
NSQ_SOURCE_LINE 00006621 ""
NSQ_SOURCE_LINE 00006622 "Here's an example (assumes RaiseError is enabled):"
NSQ_SOURCE_LINE 00006623 ""
NSQ_SOURCE_LINE 00006624 "  my $rows = []; # cache for batches of rows"
NSQ_SOURCE_LINE 00006625 "  while( my $row = ( shift(@$rows) || # get row from cache, or reload cache:"
NSQ_SOURCE_LINE 00006626 "                     shift(@{$rows=$sth->fetchall_arrayref(undef,10_000)||[]}) )"
NSQ_SOURCE_LINE 00006627 "  ) {"
NSQ_SOURCE_LINE 00006628 "    ..."
NSQ_SOURCE_LINE 00006629 "  }"
NSQ_SOURCE_LINE 00006630 ""
NSQ_SOURCE_LINE 00006631 "That I<might> be the fastest way to fetch and process lots of rows using the DBI,"
NSQ_SOURCE_LINE 00006632 "but it depends on the relative cost of method calls vs memory allocation."
NSQ_SOURCE_LINE 00006633 ""
NSQ_SOURCE_LINE 00006634 "A standard C<while> loop with column binding is often faster because"
NSQ_SOURCE_LINE 00006635 "the cost of allocating memory for the batch of rows is greater than"
NSQ_SOURCE_LINE 00006636 "the saving by reducing method calls. It's possible that the DBI may"
NSQ_SOURCE_LINE 00006637 "provide a way to reuse the memory of a previous batch in future, which"
NSQ_SOURCE_LINE 00006638 "would then shift the balance back towards fetchall_arrayref()."
NSQ_SOURCE_LINE 00006639 ""
NSQ_SOURCE_LINE 00006640 ""
NSQ_SOURCE_LINE 00006641 "=head3 C<fetchall_hashref>"
NSQ_SOURCE_LINE 00006642 ""
NSQ_SOURCE_LINE 00006643 "  $hash_ref = $sth->fetchall_hashref($key_field);"
NSQ_SOURCE_LINE 00006644 ""
NSQ_SOURCE_LINE 00006645 "The C<fetchall_hashref> method can be used to fetch all the data to be"
NSQ_SOURCE_LINE 00006646 "returned from a prepared and executed statement handle. It returns a reference"
NSQ_SOURCE_LINE 00006647 "to a hash containing a key for each distinct value of the $key_field column"
NSQ_SOURCE_LINE 00006648 "that was fetched. For each key the corresponding value is a reference to a hash"
NSQ_SOURCE_LINE 00006649 "containing all the selected columns and their values, as returned by"
NSQ_SOURCE_LINE 00006650 "C<fetchrow_hashref()>."
NSQ_SOURCE_LINE 00006651 ""
NSQ_SOURCE_LINE 00006652 "If there are no rows to return, C<fetchall_hashref> returns a reference"
NSQ_SOURCE_LINE 00006653 "to an empty hash. If an error occurs, C<fetchall_hashref> returns the"
NSQ_SOURCE_LINE 00006654 "data fetched thus far, which may be none.  You should check"
NSQ_SOURCE_LINE 00006655 "C<$sth-E<gt>err> afterwards (or use the C<RaiseError> attribute) to"
NSQ_SOURCE_LINE 00006656 "discover if the data is complete or was truncated due to an error."
NSQ_SOURCE_LINE 00006657 ""
NSQ_SOURCE_LINE 00006658 "The $key_field parameter provides the name of the field that holds the"
NSQ_SOURCE_LINE 00006659 "value to be used for the key for the returned hash.  For example:"
NSQ_SOURCE_LINE 00006660 ""
NSQ_SOURCE_LINE 00006661 "  $dbh->{FetchHashKeyName} = 'NAME_lc';"
NSQ_SOURCE_LINE 00006662 "  $sth = $dbh->prepare(\"SELECT FOO, BAR, ID, NAME, BAZ FROM TABLE\");"
NSQ_SOURCE_LINE 00006663 "  $sth->execute;"
NSQ_SOURCE_LINE 00006664 "  $hash_ref = $sth->fetchall_hashref('id');"
NSQ_SOURCE_LINE 00006665 "  print \"Name for id 42 is $hash_ref->{42}->{name}\\n\";"
NSQ_SOURCE_LINE 00006666 ""
NSQ_SOURCE_LINE 00006667 "The $key_field parameter can also be specified as an integer column"
NSQ_SOURCE_LINE 00006668 "number (counting from 1).  If $key_field doesn't match any column in"
NSQ_SOURCE_LINE 00006669 "the statement, as a name first then as a number, then an error is"
NSQ_SOURCE_LINE 00006670 "returned."
NSQ_SOURCE_LINE 00006671 ""
NSQ_SOURCE_LINE 00006672 "For queries returning more than one 'key' column, you can specify"
NSQ_SOURCE_LINE 00006673 "multiple column names by passing $key_field as a reference to an"
NSQ_SOURCE_LINE 00006674 "array containing one or more key column names (or index numbers)."
NSQ_SOURCE_LINE 00006675 "For example:"
NSQ_SOURCE_LINE 00006676 ""
NSQ_SOURCE_LINE 00006677 "  $sth = $dbh->prepare(\"SELECT foo, bar, baz FROM table\");"
NSQ_SOURCE_LINE 00006678 "  $sth->execute;"
NSQ_SOURCE_LINE 00006679 "  $hash_ref = $sth->fetchall_hashref( [ qw(foo bar) ] );"
NSQ_SOURCE_LINE 00006680 "  print \"For foo 42 and bar 38, baz is $hash_ref->{42}->{38}->{baz}\\n\";"
NSQ_SOURCE_LINE 00006681 ""
NSQ_SOURCE_LINE 00006682 "The fetchall_hashref() method is normally used only where the key"
NSQ_SOURCE_LINE 00006683 "fields values for each row are unique.  If multiple rows are returned"
NSQ_SOURCE_LINE 00006684 "with the same values for the key fields then later rows overwrite"
NSQ_SOURCE_LINE 00006685 "earlier ones."
NSQ_SOURCE_LINE 00006686 ""
NSQ_SOURCE_LINE 00006687 "=head3 C<more_results>"
NSQ_SOURCE_LINE 00006688 ""
NSQ_SOURCE_LINE 00006689 "... not yet documented ..."
NSQ_SOURCE_LINE 00006690 ""
NSQ_SOURCE_LINE 00006691 "=head3 C<finish>"
NSQ_SOURCE_LINE 00006692 ""
NSQ_SOURCE_LINE 00006693 "  $rc  = $sth->finish;"
NSQ_SOURCE_LINE 00006694 ""
NSQ_SOURCE_LINE 00006695 "Indicate that no more data will be fetched from this statement handle"
NSQ_SOURCE_LINE 00006696 "before it is either executed again or destroyed.  You almost certainly"
NSQ_SOURCE_LINE 00006697 "do I<not> need to call this method."
NSQ_SOURCE_LINE 00006698 ""
NSQ_SOURCE_LINE 00006699 "Adding calls to C<finish> after loop that fetches all rows is a common mistake,"
NSQ_SOURCE_LINE 00006700 "don't do it, it can mask genuine problems like uncaught fetch errors."
NSQ_SOURCE_LINE 00006701 ""
NSQ_SOURCE_LINE 00006702 "When all the data has been fetched from a C<SELECT> statement, the driver will"
NSQ_SOURCE_LINE 00006703 "automatically call C<finish> for you. So you should I<not> call it explicitly"
NSQ_SOURCE_LINE 00006704 "I<except> when you know that you've not fetched all the data from a statement"
NSQ_SOURCE_LINE 00006705 "handle I<and> the handle won't be destroyed soon."
NSQ_SOURCE_LINE 00006706 ""
NSQ_SOURCE_LINE 00006707 "The most common example is when you only want to fetch just one row,"
NSQ_SOURCE_LINE 00006708 "but in that case the C<selectrow_*> methods are usually better anyway."
NSQ_SOURCE_LINE 00006709 ""
NSQ_SOURCE_LINE 00006710 "Consider a query like:"
NSQ_SOURCE_LINE 00006711 ""
NSQ_SOURCE_LINE 00006712 "  SELECT foo FROM table WHERE bar=? ORDER BY baz"
NSQ_SOURCE_LINE 00006713 ""
NSQ_SOURCE_LINE 00006714 "on a very large table. When executed, the database server will have to use"
NSQ_SOURCE_LINE 00006715 "temporary buffer space to store the sorted rows. If, after executing"
NSQ_SOURCE_LINE 00006716 "the handle and selecting just a few rows, the handle won't be re-executed for"
NSQ_SOURCE_LINE 00006717 "some time and won't be destroyed, the C<finish> method can be used to tell"
NSQ_SOURCE_LINE 00006718 "the server that the buffer space can be freed."
NSQ_SOURCE_LINE 00006719 ""
NSQ_SOURCE_LINE 00006720 "Calling C<finish> resets the L</Active> attribute for the statement.  It"
NSQ_SOURCE_LINE 00006721 "may also make some statement handle attributes (such as C<NAME> and C<TYPE>)"
NSQ_SOURCE_LINE 00006722 "unavailable if they have not already been accessed (and thus cached)."
NSQ_SOURCE_LINE 00006723 ""
NSQ_SOURCE_LINE 00006724 "The C<finish> method does not affect the transaction status of the"
NSQ_SOURCE_LINE 00006725 "database connection.  It has nothing to do with transactions. It's mostly an"
NSQ_SOURCE_LINE 00006726 "internal \"housekeeping\" method that is rarely needed."
NSQ_SOURCE_LINE 00006727 "See also L</disconnect> and the L</Active> attribute."
NSQ_SOURCE_LINE 00006728 ""
NSQ_SOURCE_LINE 00006729 "The C<finish> method should have been called C<discard_pending_rows>."
NSQ_SOURCE_LINE 00006730 ""
NSQ_SOURCE_LINE 00006731 ""
NSQ_SOURCE_LINE 00006732 "=head3 C<rows>"
NSQ_SOURCE_LINE 00006733 ""
NSQ_SOURCE_LINE 00006734 "  $rv = $sth->rows;"
NSQ_SOURCE_LINE 00006735 ""
NSQ_SOURCE_LINE 00006736 "Returns the number of rows affected by the last row affecting command,"
NSQ_SOURCE_LINE 00006737 "or -1 if the number of rows is not known or not available."
NSQ_SOURCE_LINE 00006738 ""
NSQ_SOURCE_LINE 00006739 "Generally, you can only rely on a row count after a I<non>-C<SELECT>"
NSQ_SOURCE_LINE 00006740 "C<execute> (for some specific operations like C<UPDATE> and C<DELETE>), or"
NSQ_SOURCE_LINE 00006741 "after fetching all the rows of a C<SELECT> statement."
NSQ_SOURCE_LINE 00006742 ""
NSQ_SOURCE_LINE 00006743 "For C<SELECT> statements, it is generally not possible to know how many"
NSQ_SOURCE_LINE 00006744 "rows will be returned except by fetching them all.  Some drivers will"
NSQ_SOURCE_LINE 00006745 "return the number of rows the application has fetched so far, but"
NSQ_SOURCE_LINE 00006746 "others may return -1 until all rows have been fetched.  So use of the"
NSQ_SOURCE_LINE 00006747 "C<rows> method or C<$DBI::rows> with C<SELECT> statements is not"
NSQ_SOURCE_LINE 00006748 "recommended."
NSQ_SOURCE_LINE 00006749 ""
NSQ_SOURCE_LINE 00006750 "One alternative method to get a row count for a C<SELECT> is to execute a"
NSQ_SOURCE_LINE 00006751 "\"SELECT COUNT(*) FROM ...\" SQL statement with the same \"...\" as your"
NSQ_SOURCE_LINE 00006752 "query and then fetch the row count from that."
NSQ_SOURCE_LINE 00006753 ""
NSQ_SOURCE_LINE 00006754 ""
NSQ_SOURCE_LINE 00006755 "=head3 C<bind_col>"
NSQ_SOURCE_LINE 00006756 ""
NSQ_SOURCE_LINE 00006757 "  $rc = $sth->bind_col($column_number, \\$var_to_bind);"
NSQ_SOURCE_LINE 00006758 "  $rc = $sth->bind_col($column_number, \\$var_to_bind, \\%attr );"
NSQ_SOURCE_LINE 00006759 "  $rc = $sth->bind_col($column_number, \\$var_to_bind, $bind_type );"
NSQ_SOURCE_LINE 00006760 ""
NSQ_SOURCE_LINE 00006761 "Binds a Perl variable and/or some attributes to an output column"
NSQ_SOURCE_LINE 00006762 "(field) of a C<SELECT> statement.  Column numbers count up from 1."
NSQ_SOURCE_LINE 00006763 "You do not need to bind output columns in order to fetch data."
NSQ_SOURCE_LINE 00006764 "For maximum portability between drivers, bind_col() should be called"
NSQ_SOURCE_LINE 00006765 "after execute() and not before."
NSQ_SOURCE_LINE 00006766 "See also L</bind_columns> for an example."
NSQ_SOURCE_LINE 00006767 ""
NSQ_SOURCE_LINE 00006768 "The binding is performed at a low level using Perl aliasing."
NSQ_SOURCE_LINE 00006769 "Whenever a row is fetched from the database $var_to_bind appears"
NSQ_SOURCE_LINE 00006770 "to be automatically updated simply because it now refers to the same"
NSQ_SOURCE_LINE 00006771 "memory location as the corresponding column value.  This makes using"
NSQ_SOURCE_LINE 00006772 "bound variables very efficient."
NSQ_SOURCE_LINE 00006773 "Binding a tied variable doesn't work, currently."
NSQ_SOURCE_LINE 00006774 ""
NSQ_SOURCE_LINE 00006775 "The L</bind_param> method"
NSQ_SOURCE_LINE 00006776 "performs a similar, but opposite, function for input variables."
NSQ_SOURCE_LINE 00006777 ""
NSQ_SOURCE_LINE 00006778 "B<Data Types for Column Binding>"
NSQ_SOURCE_LINE 00006779 ""
NSQ_SOURCE_LINE 00006780 "The C<\\%attr> parameter can be used to hint at the data type"
NSQ_SOURCE_LINE 00006781 "formatting the column should have. For example, you can use:"
NSQ_SOURCE_LINE 00006782 ""
NSQ_SOURCE_LINE 00006783 "  $sth->bind_col(1, undef, { TYPE => SQL_DATETIME });"
NSQ_SOURCE_LINE 00006784 ""
NSQ_SOURCE_LINE 00006785 "to specify that you'd like the column (which presumably is some"
NSQ_SOURCE_LINE 00006786 "kind of datetime type) to be returned in the standard format for"
NSQ_SOURCE_LINE 00006787 "SQL_DATETIME, which is 'YYYY-MM-DD HH:MM:SS', rather than the"
NSQ_SOURCE_LINE 00006788 "native formatting the database would normally use."
NSQ_SOURCE_LINE 00006789 ""
NSQ_SOURCE_LINE 00006790 "There's no $var_to_bind in that example to emphasize the point"
NSQ_SOURCE_LINE 00006791 "that bind_col() works on the underlying column and not just"
NSQ_SOURCE_LINE 00006792 "a particular bound variable."
NSQ_SOURCE_LINE 00006793 ""
NSQ_SOURCE_LINE 00006794 "As a short-cut for the common case, the data type can be passed"
NSQ_SOURCE_LINE 00006795 "directly, in place of the C<\\%attr> hash reference. This example is"
NSQ_SOURCE_LINE 00006796 "equivalent to the one above:"
NSQ_SOURCE_LINE 00006797 ""
NSQ_SOURCE_LINE 00006798 "  $sth->bind_col(1, undef, SQL_DATETIME);"
NSQ_SOURCE_LINE 00006799 ""
NSQ_SOURCE_LINE 00006800 "The C<TYPE> value indicates the standard (non-driver-specific) type for"
NSQ_SOURCE_LINE 00006801 "this parameter. To specify the driver-specific type, the driver may"
NSQ_SOURCE_LINE 00006802 "support a driver-specific attribute, such as C<{ ora_type =E<gt> 97 }>."
NSQ_SOURCE_LINE 00006803 ""
NSQ_SOURCE_LINE 00006804 "The SQL_DATETIME and other related constants can be imported using"
NSQ_SOURCE_LINE 00006805 ""
NSQ_SOURCE_LINE 00006806 "  use DBI qw(:sql_types);"
NSQ_SOURCE_LINE 00006807 ""
NSQ_SOURCE_LINE 00006808 "See L</\"DBI Constants\"> for more information."
NSQ_SOURCE_LINE 00006809 ""
NSQ_SOURCE_LINE 00006810 "Few drivers support specifying a data type via a C<bind_col> call"
NSQ_SOURCE_LINE 00006811 "(most will simply ignore the data type). Fewer still allow the data"
NSQ_SOURCE_LINE 00006812 "type to be altered once set. If you do set a column type the type"
NSQ_SOURCE_LINE 00006813 "should remain sticky through further calls to bind_col for the same"
NSQ_SOURCE_LINE 00006814 "column if the type is not overridden (this is important for instance"
NSQ_SOURCE_LINE 00006815 "when you are using a slice in fetchall_arrayref)."
NSQ_SOURCE_LINE 00006816 ""
NSQ_SOURCE_LINE 00006817 "The TYPE attribute for bind_col() was first specified in DBI 1.41."
NSQ_SOURCE_LINE 00006818 ""
NSQ_SOURCE_LINE 00006819 "From DBI 1.611, drivers can use the C<TYPE> attribute to attempt to"
NSQ_SOURCE_LINE 00006820 "cast the bound scalar to a perl type which more closely matches"
NSQ_SOURCE_LINE 00006821 "C<TYPE>. At present DBI supports C<SQL_INTEGER>, C<SQL_DOUBLE> and"
NSQ_SOURCE_LINE 00006822 "C<SQL_NUMERIC>. See L</sql_type_cast> for details of how types are"
NSQ_SOURCE_LINE 00006823 "cast."
NSQ_SOURCE_LINE 00006824 ""
NSQ_SOURCE_LINE 00006825 "B<Other attributes for Column Binding>"
NSQ_SOURCE_LINE 00006826 ""
NSQ_SOURCE_LINE 00006827 "The C<\\%attr> parameter may also contain the following attributes:"
NSQ_SOURCE_LINE 00006828 ""
NSQ_SOURCE_LINE 00006829 "=over"
NSQ_SOURCE_LINE 00006830 ""
NSQ_SOURCE_LINE 00006831 "=item C<StrictlyTyped>"
NSQ_SOURCE_LINE 00006832 ""
NSQ_SOURCE_LINE 00006833 "If a C<TYPE> attribute is passed to bind_col, then the driver will"
NSQ_SOURCE_LINE 00006834 "attempt to change the bound perl scalar to match the type more"
NSQ_SOURCE_LINE 00006835 "closely. If the bound value cannot be cast to the requested C<TYPE>"
NSQ_SOURCE_LINE 00006836 "then by default it is left untouched and no error is generated. If you"
NSQ_SOURCE_LINE 00006837 "specify C<StrictlyTyped> as 1 and the cast fails, this will generate"
NSQ_SOURCE_LINE 00006838 "an error."
NSQ_SOURCE_LINE 00006839 ""
NSQ_SOURCE_LINE 00006840 "This attribute was first added in DBI 1.611. When 1.611 was released"
NSQ_SOURCE_LINE 00006841 "few drivers actually supported this attribute but DBD::Oracle and"
NSQ_SOURCE_LINE 00006842 "DBD::ODBC should from versions 1.24."
NSQ_SOURCE_LINE 00006843 ""
NSQ_SOURCE_LINE 00006844 "=item C<DiscardString>"
NSQ_SOURCE_LINE 00006845 ""
NSQ_SOURCE_LINE 00006846 "When the C<TYPE> attribute is passed to L</bind_col> and the driver"
NSQ_SOURCE_LINE 00006847 "successfully casts the bound perl scalar to a non-string type"
NSQ_SOURCE_LINE 00006848 "then if C<DiscardString> is set to 1, the string portion of the"
NSQ_SOURCE_LINE 00006849 "scalar will be discarded. By default, C<DiscardString> is not set."
NSQ_SOURCE_LINE 00006850 ""
NSQ_SOURCE_LINE 00006851 "This attribute was first added in DBI 1.611. When 1.611 was released"
NSQ_SOURCE_LINE 00006852 "few drivers actually supported this attribute but DBD::Oracle and"
NSQ_SOURCE_LINE 00006853 "DBD::ODBC should from versions 1.24."
NSQ_SOURCE_LINE 00006854 ""
NSQ_SOURCE_LINE 00006855 "=back"
NSQ_SOURCE_LINE 00006856 ""
NSQ_SOURCE_LINE 00006857 ""
NSQ_SOURCE_LINE 00006858 "=head3 C<bind_columns>"
NSQ_SOURCE_LINE 00006859 ""
NSQ_SOURCE_LINE 00006860 "  $rc = $sth->bind_columns(@list_of_refs_to_vars_to_bind);"
NSQ_SOURCE_LINE 00006861 ""
NSQ_SOURCE_LINE 00006862 "Calls L</bind_col> for each column of the C<SELECT> statement."
NSQ_SOURCE_LINE 00006863 ""
NSQ_SOURCE_LINE 00006864 "The list of references should have the same number of elements as the number of"
NSQ_SOURCE_LINE 00006865 "columns in the C<SELECT> statement. If it doesn't then C<bind_columns> will"
NSQ_SOURCE_LINE 00006866 "bind the elements given, up to the number of columns, and then return an error."
NSQ_SOURCE_LINE 00006867 ""
NSQ_SOURCE_LINE 00006868 "For maximum portability between drivers, bind_columns() should be called"
NSQ_SOURCE_LINE 00006869 "after execute() and not before."
NSQ_SOURCE_LINE 00006870 ""
NSQ_SOURCE_LINE 00006871 "For example:"
NSQ_SOURCE_LINE 00006872 ""
NSQ_SOURCE_LINE 00006873 "  $dbh->{RaiseError} = 1; # do this, or check every call for errors"
NSQ_SOURCE_LINE 00006874 "  $sth = $dbh->prepare(q{ SELECT region, sales FROM sales_by_region });"
NSQ_SOURCE_LINE 00006875 "  $sth->execute;"
NSQ_SOURCE_LINE 00006876 "  my ($region, $sales);"
NSQ_SOURCE_LINE 00006877 ""
NSQ_SOURCE_LINE 00006878 "  # Bind Perl variables to columns:"
NSQ_SOURCE_LINE 00006879 "  $rv = $sth->bind_columns(\\$region, \\$sales);"
NSQ_SOURCE_LINE 00006880 ""
NSQ_SOURCE_LINE 00006881 "  # you can also use Perl's \\(...) syntax (see perlref docs):"
NSQ_SOURCE_LINE 00006882 "  #     $sth->bind_columns(\\($region, $sales));"
NSQ_SOURCE_LINE 00006883 ""
NSQ_SOURCE_LINE 00006884 "  # Column binding is the most efficient way to fetch data"
NSQ_SOURCE_LINE 00006885 "  while ($sth->fetch) {"
NSQ_SOURCE_LINE 00006886 "      print \"$region: $sales\\n\";"
NSQ_SOURCE_LINE 00006887 "  }"
NSQ_SOURCE_LINE 00006888 ""
NSQ_SOURCE_LINE 00006889 "For compatibility with old scripts, the first parameter will be"
NSQ_SOURCE_LINE 00006890 "ignored if it is C<undef> or a hash reference."
NSQ_SOURCE_LINE 00006891 ""
NSQ_SOURCE_LINE 00006892 "Here's a more fancy example that binds columns to the values I<inside>"
NSQ_SOURCE_LINE 00006893 "a hash (thanks to H.Merijn Brand):"
NSQ_SOURCE_LINE 00006894 ""
NSQ_SOURCE_LINE 00006895 "  $sth->execute;"
NSQ_SOURCE_LINE 00006896 "  my %row;"
NSQ_SOURCE_LINE 00006897 "  $sth->bind_columns (\\( @row{ @{$sth->{NAME_lc} }} ));"
NSQ_SOURCE_LINE 00006898 "  while ($sth->fetch) {"
NSQ_SOURCE_LINE 00006899 "      print \"$row{region}: $row{sales}\\n\";"
NSQ_SOURCE_LINE 00006900 "  }"
NSQ_SOURCE_LINE 00006901 ""
NSQ_SOURCE_LINE 00006902 "but has a small drawback: If data already fetched call to L</bind_columns>"
NSQ_SOURCE_LINE 00006903 "will flush current values.  If you want to bind_columns after you have fetched"
NSQ_SOURCE_LINE 00006904 "you can use:"
NSQ_SOURCE_LINE 00006905 ""
NSQ_SOURCE_LINE 00006906 "  use feature \"refaliasing\";"
NSQ_SOURCE_LINE 00006907 "  no warnings \"experimental::refaliasing\";"
NSQ_SOURCE_LINE 00006908 "  while (my $row = $sth->fetchrow_arrayref) {"
NSQ_SOURCE_LINE 00006909 "      \\(@$data{ $sth->{NAME_lc}->@* }) =  \\(@$row);"
NSQ_SOURCE_LINE 00006910 "  }"
NSQ_SOURCE_LINE 00006911 ""
NSQ_SOURCE_LINE 00006912 "or, with older perl versions:"
NSQ_SOURCE_LINE 00006913 ""
NSQ_SOURCE_LINE 00006914 "  use Data::Alias;"
NSQ_SOURCE_LINE 00006915 "  alias @$data{ $sth->{NAME_lc}->@* } =  @$row;"
NSQ_SOURCE_LINE 00006916 ""
NSQ_SOURCE_LINE 00006917 "This is useful in situations when you have many left joins, but wanna to join"
NSQ_SOURCE_LINE 00006918 "your %$data hash to only subset of fetched values."
NSQ_SOURCE_LINE 00006919 ""
NSQ_SOURCE_LINE 00006920 "=head3 C<dump_results>"
NSQ_SOURCE_LINE 00006921 ""
NSQ_SOURCE_LINE 00006922 "  $rows = $sth->dump_results($maxlen, $lsep, $fsep, $fh);"
NSQ_SOURCE_LINE 00006923 ""
NSQ_SOURCE_LINE 00006924 "Fetches all the rows from C<$sth>, calls C<DBI::neat_list> for each row, and"
NSQ_SOURCE_LINE 00006925 "prints the results to C<$fh> (defaults to C<STDOUT>) separated by C<$lsep>"
NSQ_SOURCE_LINE 00006926 "(default C<\"\\n\">). C<$fsep> defaults to C<\", \"> and C<$maxlen> defaults to 35."
NSQ_SOURCE_LINE 00006927 ""
NSQ_SOURCE_LINE 00006928 "This method is designed as a handy utility for prototyping and"
NSQ_SOURCE_LINE 00006929 "testing queries. Since it uses L</neat_list> to"
NSQ_SOURCE_LINE 00006930 "format and edit the string for reading by humans, it is not recommended"
NSQ_SOURCE_LINE 00006931 "for data transfer applications."
NSQ_SOURCE_LINE 00006932 ""
NSQ_SOURCE_LINE 00006933 ""
NSQ_SOURCE_LINE 00006934 "=head2 Statement Handle Attributes"
NSQ_SOURCE_LINE 00006935 ""
NSQ_SOURCE_LINE 00006936 "This section describes attributes specific to statement handles. Most"
NSQ_SOURCE_LINE 00006937 "of these attributes are read-only."
NSQ_SOURCE_LINE 00006938 ""
NSQ_SOURCE_LINE 00006939 "Changes to these statement handle attributes do not affect any other"
NSQ_SOURCE_LINE 00006940 "existing or future statement handles."
NSQ_SOURCE_LINE 00006941 ""
NSQ_SOURCE_LINE 00006942 "Attempting to set or get the value of an unknown attribute generates a warning,"
NSQ_SOURCE_LINE 00006943 "except for private driver specific attributes (which all have names"
NSQ_SOURCE_LINE 00006944 "starting with a lowercase letter)."
NSQ_SOURCE_LINE 00006945 ""
NSQ_SOURCE_LINE 00006946 "Example:"
NSQ_SOURCE_LINE 00006947 ""
NSQ_SOURCE_LINE 00006948 "  ... = $h->{NUM_OF_FIELDS};\t# get/read"
NSQ_SOURCE_LINE 00006949 ""
NSQ_SOURCE_LINE 00006950 "Some drivers cannot provide valid values for some or all of these"
NSQ_SOURCE_LINE 00006951 "attributes until after C<$sth-E<gt>execute> has been successfully"
NSQ_SOURCE_LINE 00006952 "called. Typically the attribute will be C<undef> in these situations."
NSQ_SOURCE_LINE 00006953 ""
NSQ_SOURCE_LINE 00006954 "Some attributes, like NAME, are not appropriate to some types of"
NSQ_SOURCE_LINE 00006955 "statement, like SELECT. Typically the attribute will be C<undef>"
NSQ_SOURCE_LINE 00006956 "in these situations."
NSQ_SOURCE_LINE 00006957 ""
NSQ_SOURCE_LINE 00006958 "For drivers which support stored procedures and multiple result sets"
NSQ_SOURCE_LINE 00006959 "(see L</more_results>) these attributes relate to the I<current> result set."
NSQ_SOURCE_LINE 00006960 ""
NSQ_SOURCE_LINE 00006961 "See also L</finish> to learn more about the effect it"
NSQ_SOURCE_LINE 00006962 "may have on some attributes."
NSQ_SOURCE_LINE 00006963 ""
NSQ_SOURCE_LINE 00006964 "=head3 C<NUM_OF_FIELDS>"
NSQ_SOURCE_LINE 00006965 ""
NSQ_SOURCE_LINE 00006966 "Type: integer, read-only"
NSQ_SOURCE_LINE 00006967 ""
NSQ_SOURCE_LINE 00006968 "Number of fields (columns) in the data the prepared statement may return."
NSQ_SOURCE_LINE 00006969 "Statements that don't return rows of data, like C<DELETE> and C<CREATE>"
NSQ_SOURCE_LINE 00006970 "set C<NUM_OF_FIELDS> to 0 (though it may be undef in some drivers)."
NSQ_SOURCE_LINE 00006971 ""
NSQ_SOURCE_LINE 00006972 ""
NSQ_SOURCE_LINE 00006973 "=head3 C<NUM_OF_PARAMS>"
NSQ_SOURCE_LINE 00006974 ""
NSQ_SOURCE_LINE 00006975 "Type: integer, read-only"
NSQ_SOURCE_LINE 00006976 ""
NSQ_SOURCE_LINE 00006977 "The number of parameters (placeholders) in the prepared statement."
NSQ_SOURCE_LINE 00006978 "See SUBSTITUTION VARIABLES below for more details."
NSQ_SOURCE_LINE 00006979 ""
NSQ_SOURCE_LINE 00006980 ""
NSQ_SOURCE_LINE 00006981 "=head3 C<NAME>"
NSQ_SOURCE_LINE 00006982 ""
NSQ_SOURCE_LINE 00006983 "Type: array-ref, read-only"
NSQ_SOURCE_LINE 00006984 ""
NSQ_SOURCE_LINE 00006985 "Returns a reference to an array of field names for each column. The"
NSQ_SOURCE_LINE 00006986 "names may contain spaces but should not be truncated or have any"
NSQ_SOURCE_LINE 00006987 "trailing space. Note that the names have the letter case (upper, lower"
NSQ_SOURCE_LINE 00006988 "or mixed) as returned by the driver being used. Portable applications"
NSQ_SOURCE_LINE 00006989 "should use L</NAME_lc> or L</NAME_uc>."
NSQ_SOURCE_LINE 00006990 ""
NSQ_SOURCE_LINE 00006991 "  print \"First column name: $sth->{NAME}->[0]\\n\";"
NSQ_SOURCE_LINE 00006992 ""
NSQ_SOURCE_LINE 00006993 "Also note that the name returned for (aggregate) functions like C<count(*)>"
NSQ_SOURCE_LINE 00006994 "or C<max(c_foo)> is determined by the database server and not by C<DBI> or"
NSQ_SOURCE_LINE 00006995 "the C<DBD> backend."
NSQ_SOURCE_LINE 00006996 ""
NSQ_SOURCE_LINE 00006997 "=head3 C<NAME_lc>"
NSQ_SOURCE_LINE 00006998 ""
NSQ_SOURCE_LINE 00006999 "Type: array-ref, read-only"
NSQ_SOURCE_LINE 00007000 ""
NSQ_SOURCE_LINE 00007001 "Like C</NAME> but always returns lowercase names."
NSQ_SOURCE_LINE 00007002 ""
NSQ_SOURCE_LINE 00007003 "=head3 C<NAME_uc>"
NSQ_SOURCE_LINE 00007004 ""
NSQ_SOURCE_LINE 00007005 "Type: array-ref, read-only"
NSQ_SOURCE_LINE 00007006 ""
NSQ_SOURCE_LINE 00007007 "Like C</NAME> but always returns uppercase names."
NSQ_SOURCE_LINE 00007008 ""
NSQ_SOURCE_LINE 00007009 "=head3 C<NAME_hash>"
NSQ_SOURCE_LINE 00007010 ""
NSQ_SOURCE_LINE 00007011 "Type: hash-ref, read-only"
NSQ_SOURCE_LINE 00007012 ""
NSQ_SOURCE_LINE 00007013 "=head3 C<NAME_lc_hash>"
NSQ_SOURCE_LINE 00007014 ""
NSQ_SOURCE_LINE 00007015 "Type: hash-ref, read-only"
NSQ_SOURCE_LINE 00007016 ""
NSQ_SOURCE_LINE 00007017 "=head3 C<NAME_uc_hash>"
NSQ_SOURCE_LINE 00007018 ""
NSQ_SOURCE_LINE 00007019 "Type: hash-ref, read-only"
NSQ_SOURCE_LINE 00007020 ""
NSQ_SOURCE_LINE 00007021 "The C<NAME_hash>, C<NAME_lc_hash>, and C<NAME_uc_hash> attributes"
NSQ_SOURCE_LINE 00007022 "return column name information as a reference to a hash."
NSQ_SOURCE_LINE 00007023 ""
NSQ_SOURCE_LINE 00007024 "The keys of the hash are the names of the columns.  The letter case of"
NSQ_SOURCE_LINE 00007025 "the keys corresponds to the letter case returned by the C<NAME>,"
NSQ_SOURCE_LINE 00007026 "C<NAME_lc>, and C<NAME_uc> attributes respectively (as described above)."
NSQ_SOURCE_LINE 00007027 ""
NSQ_SOURCE_LINE 00007028 "The value of each hash entry is the perl index number of the"
NSQ_SOURCE_LINE 00007029 "corresponding column (counting from 0). For example:"
NSQ_SOURCE_LINE 00007030 ""
NSQ_SOURCE_LINE 00007031 "  $sth = $dbh->prepare(\"select Id, Name from table\");"
NSQ_SOURCE_LINE 00007032 "  $sth->execute;"
NSQ_SOURCE_LINE 00007033 "  @row = $sth->fetchrow_array;"
NSQ_SOURCE_LINE 00007034 "  print \"Name $row[ $sth->{NAME_lc_hash}{name} ]\\n\";"
NSQ_SOURCE_LINE 00007035 ""
NSQ_SOURCE_LINE 00007036 ""
NSQ_SOURCE_LINE 00007037 "=head3 C<TYPE>"
NSQ_SOURCE_LINE 00007038 ""
NSQ_SOURCE_LINE 00007039 "Type: array-ref, read-only"
NSQ_SOURCE_LINE 00007040 ""
NSQ_SOURCE_LINE 00007041 "Returns a reference to an array of integer values for each"
NSQ_SOURCE_LINE 00007042 "column. The value indicates the data type of the corresponding column."
NSQ_SOURCE_LINE 00007043 ""
NSQ_SOURCE_LINE 00007044 "The values correspond to the international standards (ANSI X3.135"
NSQ_SOURCE_LINE 00007045 "and ISO/IEC 9075) which, in general terms, means ODBC. Driver-specific"
NSQ_SOURCE_LINE 00007046 "types that don't exactly match standard types should generally return"
NSQ_SOURCE_LINE 00007047 "the same values as an ODBC driver supplied by the makers of the"
NSQ_SOURCE_LINE 00007048 "database. That might include private type numbers in ranges the vendor"
NSQ_SOURCE_LINE 00007049 "has officially registered with the ISO working group:"
NSQ_SOURCE_LINE 00007050 ""
NSQ_SOURCE_LINE 00007051 "  ftp://sqlstandards.org/SC32/SQL_Registry/"
NSQ_SOURCE_LINE 00007052 ""
NSQ_SOURCE_LINE 00007053 "Where there's no vendor-supplied ODBC driver to be compatible with,"
NSQ_SOURCE_LINE 00007054 "the DBI driver can use type numbers in the range that is now"
NSQ_SOURCE_LINE 00007055 "officially reserved for use by the DBI: -9999 to -9000."
NSQ_SOURCE_LINE 00007056 ""
NSQ_SOURCE_LINE 00007057 "All possible values for C<TYPE> should have at least one entry in the"
NSQ_SOURCE_LINE 00007058 "output of the C<type_info_all> method (see L</type_info_all>)."
NSQ_SOURCE_LINE 00007059 ""
NSQ_SOURCE_LINE 00007060 "=head3 C<PRECISION>"
NSQ_SOURCE_LINE 00007061 ""
NSQ_SOURCE_LINE 00007062 "Type: array-ref, read-only"
NSQ_SOURCE_LINE 00007063 ""
NSQ_SOURCE_LINE 00007064 "Returns a reference to an array of integer values for each column."
NSQ_SOURCE_LINE 00007065 ""
NSQ_SOURCE_LINE 00007066 "For numeric columns, the value is the maximum number of digits"
NSQ_SOURCE_LINE 00007067 "(without considering a sign character or decimal point). Note that"
NSQ_SOURCE_LINE 00007068 "the \"display size\" for floating point types (REAL, FLOAT, DOUBLE)"
NSQ_SOURCE_LINE 00007069 "can be up to 7 characters greater than the precision (for the"
NSQ_SOURCE_LINE 00007070 "sign + decimal point + the letter E + a sign + 2 or 3 digits)."
NSQ_SOURCE_LINE 00007071 ""
NSQ_SOURCE_LINE 00007072 "For any character type column the value is the OCTET_LENGTH,"
NSQ_SOURCE_LINE 00007073 "in other words the number of bytes, not characters."
NSQ_SOURCE_LINE 00007074 ""
NSQ_SOURCE_LINE 00007075 "(More recent standards refer to this as COLUMN_SIZE but we stick"
NSQ_SOURCE_LINE 00007076 "with PRECISION for backwards compatibility.)"
NSQ_SOURCE_LINE 00007077 ""
NSQ_SOURCE_LINE 00007078 "=head3 C<SCALE>"
NSQ_SOURCE_LINE 00007079 ""
NSQ_SOURCE_LINE 00007080 "Type: array-ref, read-only"
NSQ_SOURCE_LINE 00007081 ""
NSQ_SOURCE_LINE 00007082 "Returns a reference to an array of integer values for each column."
NSQ_SOURCE_LINE 00007083 "NULL (C<undef>) values indicate columns where scale is not applicable."
NSQ_SOURCE_LINE 00007084 ""
NSQ_SOURCE_LINE 00007085 "=head3 C<NULLABLE>"
NSQ_SOURCE_LINE 00007086 ""
NSQ_SOURCE_LINE 00007087 "Type: array-ref, read-only"
NSQ_SOURCE_LINE 00007088 ""
NSQ_SOURCE_LINE 00007089 "Returns a reference to an array indicating the possibility of each"
NSQ_SOURCE_LINE 00007090 "column returning a null.  Possible values are C<0>"
NSQ_SOURCE_LINE 00007091 "(or an empty string) = no, C<1> = yes, C<2> = unknown."
NSQ_SOURCE_LINE 00007092 ""
NSQ_SOURCE_LINE 00007093 "  print \"First column may return NULL\\n\" if $sth->{NULLABLE}->[0];"
NSQ_SOURCE_LINE 00007094 ""
NSQ_SOURCE_LINE 00007095 ""
NSQ_SOURCE_LINE 00007096 "=head3 C<CursorName>"
NSQ_SOURCE_LINE 00007097 ""
NSQ_SOURCE_LINE 00007098 "Type: string, read-only"
NSQ_SOURCE_LINE 00007099 ""
NSQ_SOURCE_LINE 00007100 "Returns the name of the cursor associated with the statement handle, if"
NSQ_SOURCE_LINE 00007101 "available. If not available or if the database driver does not support the"
NSQ_SOURCE_LINE 00007102 "C<\"where current of ...\"> SQL syntax, then it returns C<undef>."
NSQ_SOURCE_LINE 00007103 ""
NSQ_SOURCE_LINE 00007104 ""
NSQ_SOURCE_LINE 00007105 "=head3 C<Database>"
NSQ_SOURCE_LINE 00007106 ""
NSQ_SOURCE_LINE 00007107 "Type: dbh, read-only"
NSQ_SOURCE_LINE 00007108 ""
NSQ_SOURCE_LINE 00007109 "Returns the parent $dbh of the statement handle."
NSQ_SOURCE_LINE 00007110 ""
NSQ_SOURCE_LINE 00007111 ""
NSQ_SOURCE_LINE 00007112 "=head3 C<Statement>"
NSQ_SOURCE_LINE 00007113 ""
NSQ_SOURCE_LINE 00007114 "Type: string, read-only"
NSQ_SOURCE_LINE 00007115 ""
NSQ_SOURCE_LINE 00007116 "Returns the statement string passed to the L</prepare> method."
NSQ_SOURCE_LINE 00007117 ""
NSQ_SOURCE_LINE 00007118 ""
NSQ_SOURCE_LINE 00007119 "=head3 C<ParamValues>"
NSQ_SOURCE_LINE 00007120 ""
NSQ_SOURCE_LINE 00007121 "Type: hash ref, read-only"
NSQ_SOURCE_LINE 00007122 ""
NSQ_SOURCE_LINE 00007123 "Returns a reference to a hash containing the values currently bound"
NSQ_SOURCE_LINE 00007124 "to placeholders.  The keys of the hash are the 'names' of the"
NSQ_SOURCE_LINE 00007125 "placeholders, typically integers starting at 1.  Returns undef if"
NSQ_SOURCE_LINE 00007126 "not supported by the driver."
NSQ_SOURCE_LINE 00007127 ""
NSQ_SOURCE_LINE 00007128 "See L</ShowErrorStatement> for an example of how this is used."
NSQ_SOURCE_LINE 00007129 ""
NSQ_SOURCE_LINE 00007130 "* Keys:"
NSQ_SOURCE_LINE 00007131 ""
NSQ_SOURCE_LINE 00007132 "If the driver supports C<ParamValues> but no values have been bound"
NSQ_SOURCE_LINE 00007133 "yet then the driver should return a hash with placeholders names"
NSQ_SOURCE_LINE 00007134 "in the keys but all the values undef, but some drivers may return"
NSQ_SOURCE_LINE 00007135 "a ref to an empty hash because they can't pre-determine the names."
NSQ_SOURCE_LINE 00007136 ""
NSQ_SOURCE_LINE 00007137 "It is possible that the keys in the hash returned by C<ParamValues>"
NSQ_SOURCE_LINE 00007138 "are not exactly the same as those implied by the prepared statement."
NSQ_SOURCE_LINE 00007139 "For example, DBD::Oracle translates 'C<?>' placeholders into 'C<:pN>'"
NSQ_SOURCE_LINE 00007140 "where N is a sequence number starting at 1."
NSQ_SOURCE_LINE 00007141 ""
NSQ_SOURCE_LINE 00007142 "* Values:"
NSQ_SOURCE_LINE 00007143 ""
NSQ_SOURCE_LINE 00007144 "It is possible that the values in the hash returned by C<ParamValues>"
NSQ_SOURCE_LINE 00007145 "are not I<exactly> the same as those passed to bind_param() or execute()."
NSQ_SOURCE_LINE 00007146 "The driver may have slightly modified values in some way based on the"
NSQ_SOURCE_LINE 00007147 "TYPE the value was bound with. For example a floating point value"
NSQ_SOURCE_LINE 00007148 "bound as an SQL_INTEGER type may be returned as an integer."
NSQ_SOURCE_LINE 00007149 "The values returned by C<ParamValues> can be passed to another"
NSQ_SOURCE_LINE 00007150 "bind_param() method with the same TYPE and will be seen by the"
NSQ_SOURCE_LINE 00007151 "database as the same value. See also L</ParamTypes> below."
NSQ_SOURCE_LINE 00007152 ""
NSQ_SOURCE_LINE 00007153 "The C<ParamValues> attribute was added in DBI 1.28."
NSQ_SOURCE_LINE 00007154 ""
NSQ_SOURCE_LINE 00007155 "=head3 C<ParamTypes>"
NSQ_SOURCE_LINE 00007156 ""
NSQ_SOURCE_LINE 00007157 "Type: hash ref, read-only"
NSQ_SOURCE_LINE 00007158 ""
NSQ_SOURCE_LINE 00007159 "Returns a reference to a hash containing the type information"
NSQ_SOURCE_LINE 00007160 "currently bound to placeholders."
NSQ_SOURCE_LINE 00007161 "Returns undef if not supported by the driver."
NSQ_SOURCE_LINE 00007162 ""
NSQ_SOURCE_LINE 00007163 "* Keys:"
NSQ_SOURCE_LINE 00007164 ""
NSQ_SOURCE_LINE 00007165 "See L</ParamValues> above."
NSQ_SOURCE_LINE 00007166 ""
NSQ_SOURCE_LINE 00007167 "* Values:"
NSQ_SOURCE_LINE 00007168 ""
NSQ_SOURCE_LINE 00007169 "The hash values are hashrefs of type information in the same form as that"
NSQ_SOURCE_LINE 00007170 "passed to the various bind_param() methods (See L</bind_param> for the format"
NSQ_SOURCE_LINE 00007171 "and values)."
NSQ_SOURCE_LINE 00007172 ""
NSQ_SOURCE_LINE 00007173 "It is possible that the values in the hash returned by C<ParamTypes>"
NSQ_SOURCE_LINE 00007174 "are not exactly the same as those passed to bind_param() or execute()."
NSQ_SOURCE_LINE 00007175 "Param attributes specified using the abbreviated form, like this:"
NSQ_SOURCE_LINE 00007176 ""
NSQ_SOURCE_LINE 00007177 "    $sth->bind_param(1, SQL_INTEGER);"
NSQ_SOURCE_LINE 00007178 ""
NSQ_SOURCE_LINE 00007179 "are returned in the expanded form, as if called like this:"
NSQ_SOURCE_LINE 00007180 ""
NSQ_SOURCE_LINE 00007181 "    $sth->bind_param(1, { TYPE => SQL_INTEGER });"
NSQ_SOURCE_LINE 00007182 ""
NSQ_SOURCE_LINE 00007183 "The driver may have modified the type information in some way based"
NSQ_SOURCE_LINE 00007184 "on the bound values, other hints provided by the prepare()'d"
NSQ_SOURCE_LINE 00007185 "SQL statement, or alternate type mappings required by the driver or target"
NSQ_SOURCE_LINE 00007186 "database system. The driver may also add private keys (with names beginning"
NSQ_SOURCE_LINE 00007187 "with the drivers reserved prefix, e.g., odbc_xxx)."
NSQ_SOURCE_LINE 00007188 ""
NSQ_SOURCE_LINE 00007189 "* Example:"
NSQ_SOURCE_LINE 00007190 ""
NSQ_SOURCE_LINE 00007191 "The keys and values in the returned hash can be passed to the various"
NSQ_SOURCE_LINE 00007192 "bind_param() methods to effectively reproduce a previous param binding."
NSQ_SOURCE_LINE 00007193 "For example:"
NSQ_SOURCE_LINE 00007194 ""
NSQ_SOURCE_LINE 00007195 "  # assuming $sth1 is a previously prepared statement handle"
NSQ_SOURCE_LINE 00007196 "  my $sth2 = $dbh->prepare( $sth1->{Statement} );"
NSQ_SOURCE_LINE 00007197 "  my $ParamValues = $sth1->{ParamValues} || {};"
NSQ_SOURCE_LINE 00007198 "  my $ParamTypes  = $sth1->{ParamTypes}  || {};"
NSQ_SOURCE_LINE 00007199 "  $sth2->bind_param($_, $ParamValues->{$_}, $ParamTypes->{$_})"
NSQ_SOURCE_LINE 00007200 "    for keys %{ {%$ParamValues, %$ParamTypes} };"
NSQ_SOURCE_LINE 00007201 "  $sth2->execute();"
NSQ_SOURCE_LINE 00007202 ""
NSQ_SOURCE_LINE 00007203 "The C<ParamTypes> attribute was added in DBI 1.49. Implementation"
NSQ_SOURCE_LINE 00007204 "is the responsibility of individual drivers; the DBI layer default"
NSQ_SOURCE_LINE 00007205 "implementation simply returns undef."
NSQ_SOURCE_LINE 00007206 ""
NSQ_SOURCE_LINE 00007207 ""
NSQ_SOURCE_LINE 00007208 "=head3 C<ParamArrays>"
NSQ_SOURCE_LINE 00007209 ""
NSQ_SOURCE_LINE 00007210 "Type: hash ref, read-only"
NSQ_SOURCE_LINE 00007211 ""
NSQ_SOURCE_LINE 00007212 "Returns a reference to a hash containing the values currently bound to"
NSQ_SOURCE_LINE 00007213 "placeholders with L</execute_array> or L</bind_param_array>.  The"
NSQ_SOURCE_LINE 00007214 "keys of the hash are the 'names' of the placeholders, typically"
NSQ_SOURCE_LINE 00007215 "integers starting at 1.  Returns undef if not supported by the driver"
NSQ_SOURCE_LINE 00007216 "or no arrays of parameters are bound."
NSQ_SOURCE_LINE 00007217 ""
NSQ_SOURCE_LINE 00007218 "Each key value is an array reference containing a list of the bound"
NSQ_SOURCE_LINE 00007219 "parameters for that column."
NSQ_SOURCE_LINE 00007220 ""
NSQ_SOURCE_LINE 00007221 "For example:"
NSQ_SOURCE_LINE 00007222 ""
NSQ_SOURCE_LINE 00007223 "  $sth = $dbh->prepare(\"INSERT INTO staff (id, name) values (?,?)\");"
NSQ_SOURCE_LINE 00007224 "  $sth->execute_array({},[1,2], ['fred','dave']);"
NSQ_SOURCE_LINE 00007225 "  if ($sth->{ParamArrays}) {"
NSQ_SOURCE_LINE 00007226 "      foreach $param (keys %{$sth->{ParamArrays}}) {"
NSQ_SOURCE_LINE 00007227 "\t  printf \"Parameters for %s : %s\\n\", $param,"
NSQ_SOURCE_LINE 00007228 "\t  join(\",\", @{$sth->{ParamArrays}->{$param}});"
NSQ_SOURCE_LINE 00007229 "      }"
NSQ_SOURCE_LINE 00007230 "  }"
NSQ_SOURCE_LINE 00007231 ""
NSQ_SOURCE_LINE 00007232 "It is possible that the values in the hash returned by C<ParamArrays>"
NSQ_SOURCE_LINE 00007233 "are not I<exactly> the same as those passed to L</bind_param_array> or"
NSQ_SOURCE_LINE 00007234 "L</execute_array>.  The driver may have slightly modified values in some"
NSQ_SOURCE_LINE 00007235 "way based on the TYPE the value was bound with. For example a floating"
NSQ_SOURCE_LINE 00007236 "point value bound as an SQL_INTEGER type may be returned as an"
NSQ_SOURCE_LINE 00007237 "integer."
NSQ_SOURCE_LINE 00007238 ""
NSQ_SOURCE_LINE 00007239 "It is also possible that the keys in the hash returned by"
NSQ_SOURCE_LINE 00007240 "C<ParamArrays> are not exactly the same as those implied by the"
NSQ_SOURCE_LINE 00007241 "prepared statement.  For example, DBD::Oracle translates 'C<?>'"
NSQ_SOURCE_LINE 00007242 "placeholders into 'C<:pN>' where N is a sequence number starting at 1."
NSQ_SOURCE_LINE 00007243 ""
NSQ_SOURCE_LINE 00007244 "=head3 C<RowsInCache>"
NSQ_SOURCE_LINE 00007245 ""
NSQ_SOURCE_LINE 00007246 "Type: integer, read-only"
NSQ_SOURCE_LINE 00007247 ""
NSQ_SOURCE_LINE 00007248 "If the driver supports a local row cache for C<SELECT> statements, then"
NSQ_SOURCE_LINE 00007249 "this attribute holds the number of un-fetched rows in the cache. If the"
NSQ_SOURCE_LINE 00007250 "driver doesn't, then it returns C<undef>. Note that some drivers pre-fetch"
NSQ_SOURCE_LINE 00007251 "rows on execute, whereas others wait till the first fetch."
NSQ_SOURCE_LINE 00007252 ""
NSQ_SOURCE_LINE 00007253 "See also the L</RowCacheSize> database handle attribute."
NSQ_SOURCE_LINE 00007254 ""
NSQ_SOURCE_LINE 00007255 "=head1 FURTHER INFORMATION"
NSQ_SOURCE_LINE 00007256 ""
NSQ_SOURCE_LINE 00007257 "=head2 Catalog Methods"
NSQ_SOURCE_LINE 00007258 ""
NSQ_SOURCE_LINE 00007259 "An application can retrieve metadata information from the DBMS by issuing"
NSQ_SOURCE_LINE 00007260 "appropriate queries on the views of the Information Schema. Unfortunately,"
NSQ_SOURCE_LINE 00007261 "C<INFORMATION_SCHEMA> views are seldom supported by the DBMS."
NSQ_SOURCE_LINE 00007262 "Special methods (catalog methods) are available to return result sets"
NSQ_SOURCE_LINE 00007263 "for a small but important portion of that metadata:"
NSQ_SOURCE_LINE 00007264 ""
NSQ_SOURCE_LINE 00007265 "  column_info"
NSQ_SOURCE_LINE 00007266 "  foreign_key_info"
NSQ_SOURCE_LINE 00007267 "  primary_key_info"
NSQ_SOURCE_LINE 00007268 "  table_info"
NSQ_SOURCE_LINE 00007269 "  statistics_info"
NSQ_SOURCE_LINE 00007270 ""
NSQ_SOURCE_LINE 00007271 "All catalog methods accept arguments in order to restrict the result sets."
NSQ_SOURCE_LINE 00007272 "Passing C<undef> to an optional argument does not constrain the search for"
NSQ_SOURCE_LINE 00007273 "that argument."
NSQ_SOURCE_LINE 00007274 "However, an empty string ('') is treated as a regular search criteria"
NSQ_SOURCE_LINE 00007275 "and will only match an empty value."
NSQ_SOURCE_LINE 00007276 ""
NSQ_SOURCE_LINE 00007277 "B<Note>: SQL/CLI and ODBC differ in the handling of empty strings. An"
NSQ_SOURCE_LINE 00007278 "empty string will not restrict the result set in SQL/CLI."
NSQ_SOURCE_LINE 00007279 ""
NSQ_SOURCE_LINE 00007280 "Most arguments in the catalog methods accept only I<ordinary values>, e.g."
NSQ_SOURCE_LINE 00007281 "the arguments of C<primary_key_info()>."
NSQ_SOURCE_LINE 00007282 "Such arguments are treated as a literal string, i.e. the case is significant"
NSQ_SOURCE_LINE 00007283 "and quote characters are taken literally."
NSQ_SOURCE_LINE 00007284 ""
NSQ_SOURCE_LINE 00007285 "Some arguments in the catalog methods accept I<search patterns> (strings"
NSQ_SOURCE_LINE 00007286 "containing '_' and/or '%'), e.g. the C<$table> argument of C<column_info()>."
NSQ_SOURCE_LINE 00007287 "Passing '%' is equivalent to leaving the argument C<undef>."
NSQ_SOURCE_LINE 00007288 ""
NSQ_SOURCE_LINE 00007289 "B<Caveat>: The underscore ('_') is valid and often used in SQL identifiers."
NSQ_SOURCE_LINE 00007290 "Passing such a value to a search pattern argument may return more rows than"
NSQ_SOURCE_LINE 00007291 "expected!"
NSQ_SOURCE_LINE 00007292 "To include pattern characters as literals, they must be preceded by an"
NSQ_SOURCE_LINE 00007293 "escape character which can be achieved with"
NSQ_SOURCE_LINE 00007294 ""
NSQ_SOURCE_LINE 00007295 "  $esc = $dbh->get_info( 14 );  # SQL_SEARCH_PATTERN_ESCAPE"
NSQ_SOURCE_LINE 00007296 "  $search_pattern =~ s/([_%])/$esc$1/g;"
NSQ_SOURCE_LINE 00007297 ""
NSQ_SOURCE_LINE 00007298 "The ODBC and SQL/CLI specifications define a way to change the default"
NSQ_SOURCE_LINE 00007299 "behaviour described above: All arguments (except I<list value arguments>)"
NSQ_SOURCE_LINE 00007300 "are treated as I<identifier> if the C<SQL_ATTR_METADATA_ID> attribute is"
NSQ_SOURCE_LINE 00007301 "set to C<SQL_TRUE>."
NSQ_SOURCE_LINE 00007302 "I<Quoted identifiers> are very similar to I<ordinary values>, i.e. their"
NSQ_SOURCE_LINE 00007303 "body (the string within the quotes) is interpreted literally."
NSQ_SOURCE_LINE 00007304 "I<Unquoted identifiers> are compared in UPPERCASE."
NSQ_SOURCE_LINE 00007305 ""
NSQ_SOURCE_LINE 00007306 "The DBI (currently) does not support the C<SQL_ATTR_METADATA_ID> attribute,"
NSQ_SOURCE_LINE 00007307 "i.e. it behaves like an ODBC driver where C<SQL_ATTR_METADATA_ID> is set to"
NSQ_SOURCE_LINE 00007308 "C<SQL_FALSE>."
NSQ_SOURCE_LINE 00007309 ""
NSQ_SOURCE_LINE 00007310 ""
NSQ_SOURCE_LINE 00007311 "=head2 Transactions"
NSQ_SOURCE_LINE 00007312 ""
NSQ_SOURCE_LINE 00007313 "Transactions are a fundamental part of any robust database system. They"
NSQ_SOURCE_LINE 00007314 "protect against errors and database corruption by ensuring that sets of"
NSQ_SOURCE_LINE 00007315 "related changes to the database take place in atomic (indivisible,"
NSQ_SOURCE_LINE 00007316 "all-or-nothing) units."
NSQ_SOURCE_LINE 00007317 ""
NSQ_SOURCE_LINE 00007318 "This section applies to databases that support transactions and where"
NSQ_SOURCE_LINE 00007319 "C<AutoCommit> is off.  See L</AutoCommit> for details of using C<AutoCommit>"
NSQ_SOURCE_LINE 00007320 "with various types of databases."
NSQ_SOURCE_LINE 00007321 ""
NSQ_SOURCE_LINE 00007322 "The recommended way to implement robust transactions in Perl"
NSQ_SOURCE_LINE 00007323 "applications is to enable L</RaiseError> and catch the error that's 'thrown' as"
NSQ_SOURCE_LINE 00007324 "an exception.  For example, using L<Try::Tiny>:"
NSQ_SOURCE_LINE 00007325 ""
NSQ_SOURCE_LINE 00007326 "  use Try::Tiny;"
NSQ_SOURCE_LINE 00007327 "  $dbh->{AutoCommit} = 0;  # enable transactions, if possible"
NSQ_SOURCE_LINE 00007328 "  $dbh->{RaiseError} = 1;"
NSQ_SOURCE_LINE 00007329 "  try {"
NSQ_SOURCE_LINE 00007330 "      foo(...)        # do lots of work here"
NSQ_SOURCE_LINE 00007331 "      bar(...)        # including inserts"
NSQ_SOURCE_LINE 00007332 "      baz(...)        # and updates"
NSQ_SOURCE_LINE 00007333 "      $dbh->commit;   # commit the changes if we get this far"
NSQ_SOURCE_LINE 00007334 "  } catch {"
NSQ_SOURCE_LINE 00007335 "      warn \"Transaction aborted because $_\"; # Try::Tiny copies $@ into $_"
NSQ_SOURCE_LINE 00007336 "      # now rollback to undo the incomplete changes"
NSQ_SOURCE_LINE 00007337 "      # but do it in an eval{} as it may also fail"
NSQ_SOURCE_LINE 00007338 "      eval { $dbh->rollback };"
NSQ_SOURCE_LINE 00007339 "      # add other application on-error-clean-up code here"
NSQ_SOURCE_LINE 00007340 "  };"
NSQ_SOURCE_LINE 00007341 ""
NSQ_SOURCE_LINE 00007342 "If the C<RaiseError> attribute is not set, then DBI calls would need to be"
NSQ_SOURCE_LINE 00007343 "manually checked for errors, typically like this:"
NSQ_SOURCE_LINE 00007344 ""
NSQ_SOURCE_LINE 00007345 "  $h->method(@args) or die $h->errstr;"
NSQ_SOURCE_LINE 00007346 ""
NSQ_SOURCE_LINE 00007347 "With C<RaiseError> set, the DBI will automatically C<die> if any DBI method"
NSQ_SOURCE_LINE 00007348 "call on that handle (or a child handle) fails, so you don't have to"
NSQ_SOURCE_LINE 00007349 "test the return value of each method call. See L</RaiseError> for more"
NSQ_SOURCE_LINE 00007350 "details."
NSQ_SOURCE_LINE 00007351 ""
NSQ_SOURCE_LINE 00007352 "A major advantage of the C<eval> approach is that the transaction will be"
NSQ_SOURCE_LINE 00007353 "properly rolled back if I<any> code (not just DBI calls) in the inner"
NSQ_SOURCE_LINE 00007354 "application dies for any reason. The major advantage of using the"
NSQ_SOURCE_LINE 00007355 "C<$h-E<gt>{RaiseError}> attribute is that all DBI calls will be checked"
NSQ_SOURCE_LINE 00007356 "automatically. Both techniques are strongly recommended."
NSQ_SOURCE_LINE 00007357 ""
NSQ_SOURCE_LINE 00007358 "After calling C<commit> or C<rollback> many drivers will not let you"
NSQ_SOURCE_LINE 00007359 "fetch from a previously active C<SELECT> statement handle that's a child"
NSQ_SOURCE_LINE 00007360 "of the same database handle. A typical way round this is to connect the"
NSQ_SOURCE_LINE 00007361 "the database twice and use one connection for C<SELECT> statements."
NSQ_SOURCE_LINE 00007362 ""
NSQ_SOURCE_LINE 00007363 "See L</AutoCommit> and L</disconnect> for other important information"
NSQ_SOURCE_LINE 00007364 "about transactions."
NSQ_SOURCE_LINE 00007365 ""
NSQ_SOURCE_LINE 00007366 ""
NSQ_SOURCE_LINE 00007367 "=head2 Handling BLOB / LONG / Memo Fields"
NSQ_SOURCE_LINE 00007368 ""
NSQ_SOURCE_LINE 00007369 "Many databases support \"blob\" (binary large objects), \"long\", or similar"
NSQ_SOURCE_LINE 00007370 "datatypes for holding very long strings or large amounts of binary"
NSQ_SOURCE_LINE 00007371 "data in a single field. Some databases support variable length long"
NSQ_SOURCE_LINE 00007372 "values over 2,000,000,000 bytes in length."
NSQ_SOURCE_LINE 00007373 ""
NSQ_SOURCE_LINE 00007374 "Since values of that size can't usually be held in memory, and because"
NSQ_SOURCE_LINE 00007375 "databases can't usually know in advance the length of the longest long"
NSQ_SOURCE_LINE 00007376 "that will be returned from a C<SELECT> statement (unlike other data"
NSQ_SOURCE_LINE 00007377 "types), some special handling is required."
NSQ_SOURCE_LINE 00007378 ""
NSQ_SOURCE_LINE 00007379 "In this situation, the value of the C<$h-E<gt>{LongReadLen}>"
NSQ_SOURCE_LINE 00007380 "attribute is used to determine how much buffer space to allocate"
NSQ_SOURCE_LINE 00007381 "when fetching such fields.  The C<$h-E<gt>{LongTruncOk}> attribute"
NSQ_SOURCE_LINE 00007382 "is used to determine how to behave if a fetched value can't fit"
NSQ_SOURCE_LINE 00007383 "into the buffer."
NSQ_SOURCE_LINE 00007384 ""
NSQ_SOURCE_LINE 00007385 "See the description of L</LongReadLen> for more information."
NSQ_SOURCE_LINE 00007386 ""
NSQ_SOURCE_LINE 00007387 "When trying to insert long or binary values, placeholders should be used"
NSQ_SOURCE_LINE 00007388 "since there are often limits on the maximum size of an C<INSERT>"
NSQ_SOURCE_LINE 00007389 "statement and the L</quote> method generally can't cope with binary"
NSQ_SOURCE_LINE 00007390 "data.  See L</Placeholders and Bind Values>."
NSQ_SOURCE_LINE 00007391 ""
NSQ_SOURCE_LINE 00007392 ""
NSQ_SOURCE_LINE 00007393 "=head2 Simple Examples"
NSQ_SOURCE_LINE 00007394 ""
NSQ_SOURCE_LINE 00007395 "Here's a complete example program to select and fetch some data:"
NSQ_SOURCE_LINE 00007396 ""
NSQ_SOURCE_LINE 00007397 "  my $data_source = \"dbi::DriverName:db_name\";"
NSQ_SOURCE_LINE 00007398 "  my $dbh = DBI->connect($data_source, $user, $password)"
NSQ_SOURCE_LINE 00007399 "      or die \"Can't connect to $data_source: $DBI::errstr\";"
NSQ_SOURCE_LINE 00007400 ""
NSQ_SOURCE_LINE 00007401 "  my $sth = $dbh->prepare( q{"
NSQ_SOURCE_LINE 00007402 "          SELECT name, phone"
NSQ_SOURCE_LINE 00007403 "          FROM mytelbook"
NSQ_SOURCE_LINE 00007404 "  }) or die \"Can't prepare statement: $DBI::errstr\";"
NSQ_SOURCE_LINE 00007405 ""
NSQ_SOURCE_LINE 00007406 "  my $rc = $sth->execute"
NSQ_SOURCE_LINE 00007407 "      or die \"Can't execute statement: $DBI::errstr\";"
NSQ_SOURCE_LINE 00007408 ""
NSQ_SOURCE_LINE 00007409 "  print \"Query will return $sth->{NUM_OF_FIELDS} fields.\\n\\n\";"
NSQ_SOURCE_LINE 00007410 "  print \"Field names: @{ $sth->{NAME} }\\n\";"
NSQ_SOURCE_LINE 00007411 ""
NSQ_SOURCE_LINE 00007412 "  while (($name, $phone) = $sth->fetchrow_array) {"
NSQ_SOURCE_LINE 00007413 "      print \"$name: $phone\\n\";"
NSQ_SOURCE_LINE 00007414 "  }"
NSQ_SOURCE_LINE 00007415 "  # check for problems which may have terminated the fetch early"
NSQ_SOURCE_LINE 00007416 "  die $sth->errstr if $sth->err;"
NSQ_SOURCE_LINE 00007417 ""
NSQ_SOURCE_LINE 00007418 "  $dbh->disconnect;"
NSQ_SOURCE_LINE 00007419 ""
NSQ_SOURCE_LINE 00007420 "Here's a complete example program to insert some data from a file."
NSQ_SOURCE_LINE 00007421 "(This example uses C<RaiseError> to avoid needing to check each call)."
NSQ_SOURCE_LINE 00007422 ""
NSQ_SOURCE_LINE 00007423 "  my $dbh = DBI->connect(\"dbi:DriverName:db_name\", $user, $password, {"
NSQ_SOURCE_LINE 00007424 "      RaiseError => 1, AutoCommit => 0"
NSQ_SOURCE_LINE 00007425 "  });"
NSQ_SOURCE_LINE 00007426 ""
NSQ_SOURCE_LINE 00007427 "  my $sth = $dbh->prepare( q{"
NSQ_SOURCE_LINE 00007428 "      INSERT INTO table (name, phone) VALUES (?, ?)"
NSQ_SOURCE_LINE 00007429 "  });"
NSQ_SOURCE_LINE 00007430 ""
NSQ_SOURCE_LINE 00007431 "  open FH, \"<phone.csv\" or die \"Unable to open phone.csv: $!\";"
NSQ_SOURCE_LINE 00007432 "  while (<FH>) {"
NSQ_SOURCE_LINE 00007433 "      chomp;"
NSQ_SOURCE_LINE 00007434 "      my ($name, $phone) = split /,/;"
NSQ_SOURCE_LINE 00007435 "      $sth->execute($name, $phone);"
NSQ_SOURCE_LINE 00007436 "  }"
NSQ_SOURCE_LINE 00007437 "  close FH;"
NSQ_SOURCE_LINE 00007438 ""
NSQ_SOURCE_LINE 00007439 "  $dbh->commit;"
NSQ_SOURCE_LINE 00007440 "  $dbh->disconnect;"
NSQ_SOURCE_LINE 00007441 ""
NSQ_SOURCE_LINE 00007442 "Here's how to convert fetched NULLs (undefined values) into empty strings:"
NSQ_SOURCE_LINE 00007443 ""
NSQ_SOURCE_LINE 00007444 "  while($row = $sth->fetchrow_arrayref) {"
NSQ_SOURCE_LINE 00007445 "    # this is a fast and simple way to deal with nulls:"
NSQ_SOURCE_LINE 00007446 "    foreach (@$row) { $_ = '' unless defined }"
NSQ_SOURCE_LINE 00007447 "    print \"@$row\\n\";"
NSQ_SOURCE_LINE 00007448 "  }"
NSQ_SOURCE_LINE 00007449 ""
NSQ_SOURCE_LINE 00007450 "The C<q{...}> style quoting used in these examples avoids clashing with"
NSQ_SOURCE_LINE 00007451 "quotes that may be used in the SQL statement. Use the double-quote like"
NSQ_SOURCE_LINE 00007452 "C<qq{...}> operator if you want to interpolate variables into the string."
NSQ_SOURCE_LINE 00007453 "See L<perlop/\"Quote and Quote-like Operators\"> for more details."
NSQ_SOURCE_LINE 00007454 ""
NSQ_SOURCE_LINE 00007455 "=head2 Threads and Thread Safety"
NSQ_SOURCE_LINE 00007456 ""
NSQ_SOURCE_LINE 00007457 "Perl 5.7 and later support a new threading model called iThreads."
NSQ_SOURCE_LINE 00007458 "(The old \"5.005 style\" threads are not supported by the DBI.)"
NSQ_SOURCE_LINE 00007459 ""
NSQ_SOURCE_LINE 00007460 "In the iThreads model each thread has its own copy of the perl"
NSQ_SOURCE_LINE 00007461 "interpreter.  When a new thread is created the original perl"
NSQ_SOURCE_LINE 00007462 "interpreter is 'cloned' to create a new copy for the new thread."
NSQ_SOURCE_LINE 00007463 ""
NSQ_SOURCE_LINE 00007464 "If the DBI and drivers are loaded and handles created before the"
NSQ_SOURCE_LINE 00007465 "thread is created then it will get a cloned copy of the DBI, the"
NSQ_SOURCE_LINE 00007466 "drivers and the handles."
NSQ_SOURCE_LINE 00007467 ""
NSQ_SOURCE_LINE 00007468 "However, the internal pointer data within the handles will refer"
NSQ_SOURCE_LINE 00007469 "to the DBI and drivers in the original interpreter. Using those"
NSQ_SOURCE_LINE 00007470 "handles in the new interpreter thread is not safe, so the DBI detects"
NSQ_SOURCE_LINE 00007471 "this and croaks on any method call using handles that don't belong"
NSQ_SOURCE_LINE 00007472 "to the current thread (except for DESTROY)."
NSQ_SOURCE_LINE 00007473 ""
NSQ_SOURCE_LINE 00007474 "Because of this (possibly temporary) restriction, newly created"
NSQ_SOURCE_LINE 00007475 "threads must make their own connections to the database. Handles"
NSQ_SOURCE_LINE 00007476 "can't be shared across threads."
NSQ_SOURCE_LINE 00007477 ""
NSQ_SOURCE_LINE 00007478 "But BEWARE, some underlying database APIs (the code the DBD driver"
NSQ_SOURCE_LINE 00007479 "uses to talk to the database, often supplied by the database vendor)"
NSQ_SOURCE_LINE 00007480 "are not thread safe. If it's not thread safe, then allowing more"
NSQ_SOURCE_LINE 00007481 "than one thread to enter the code at the same time may cause"
NSQ_SOURCE_LINE 00007482 "subtle/serious problems. In some cases allowing more than"
NSQ_SOURCE_LINE 00007483 "one thread to enter the code, even if I<not> at the same time,"
NSQ_SOURCE_LINE 00007484 "can cause problems. You have been warned."
NSQ_SOURCE_LINE 00007485 ""
NSQ_SOURCE_LINE 00007486 "Using DBI with perl threads is not yet recommended for production"
NSQ_SOURCE_LINE 00007487 "environments. For more information see"
NSQ_SOURCE_LINE 00007488 "L<http://www.perlmonks.org/index.pl?node_id=288022>"
NSQ_SOURCE_LINE 00007489 ""
NSQ_SOURCE_LINE 00007490 "Note: There is a bug in perl 5.8.2 when configured with threads and"
NSQ_SOURCE_LINE 00007491 "debugging enabled (bug #24463) which would cause some DBI tests to fail."
NSQ_SOURCE_LINE 00007492 "These tests have been disabled for perl-5.8.2 and below."
NSQ_SOURCE_LINE 00007493 ""
NSQ_SOURCE_LINE 00007494 "Tests for inner method cache are disabled for perl-5.10.x"
NSQ_SOURCE_LINE 00007495 ""
NSQ_SOURCE_LINE 00007496 "=head2 Signal Handling and Canceling Operations"
NSQ_SOURCE_LINE 00007497 ""
NSQ_SOURCE_LINE 00007498 "[The following only applies to systems with unix-like signal handling."
NSQ_SOURCE_LINE 00007499 "I'd welcome additions for other systems, especially Windows.]"
NSQ_SOURCE_LINE 00007500 ""
NSQ_SOURCE_LINE 00007501 "The first thing to say is that signal handling in Perl versions less"
NSQ_SOURCE_LINE 00007502 "than 5.8 is I<not> safe. There is always a small risk of Perl"
NSQ_SOURCE_LINE 00007503 "crashing and/or core dumping when, or after, handling a signal"
NSQ_SOURCE_LINE 00007504 "because the signal could arrive and be handled while internal data"
NSQ_SOURCE_LINE 00007505 "structures are being changed. If the signal handling code"
NSQ_SOURCE_LINE 00007506 "used those same internal data structures it could cause all manner"
NSQ_SOURCE_LINE 00007507 "of subtle and not-so-subtle problems.  The risk was reduced with"
NSQ_SOURCE_LINE 00007508 "5.4.4 but was still present in all perls up through 5.8.0."
NSQ_SOURCE_LINE 00007509 ""
NSQ_SOURCE_LINE 00007510 "Beginning in perl 5.8.0 perl implements 'safe' signal handling if"
NSQ_SOURCE_LINE 00007511 "your system has the POSIX sigaction() routine. Now when a signal"
NSQ_SOURCE_LINE 00007512 "is delivered perl just makes a note of it but does I<not> run the"
NSQ_SOURCE_LINE 00007513 "%SIG handler. The handling is 'deferred' until a 'safe' moment."
NSQ_SOURCE_LINE 00007514 ""
NSQ_SOURCE_LINE 00007515 "Although this change made signal handling safe, it also lead to"
NSQ_SOURCE_LINE 00007516 "a problem with signals being deferred for longer than you'd like."
NSQ_SOURCE_LINE 00007517 "If a signal arrived while executing a system call, such as waiting"
NSQ_SOURCE_LINE 00007518 "for data on a network connection, the signal is noted and then the"
NSQ_SOURCE_LINE 00007519 "system call that was executing returns with an EINTR error code"
NSQ_SOURCE_LINE 00007520 "to indicate that it was interrupted. All fine so far."
NSQ_SOURCE_LINE 00007521 ""
NSQ_SOURCE_LINE 00007522 "The problem comes when the code that made the system call sees the"
NSQ_SOURCE_LINE 00007523 "EINTR code and decides it's going to call it again. Perl doesn't"
NSQ_SOURCE_LINE 00007524 "do that, but database code sometimes does. If that happens then the"
NSQ_SOURCE_LINE 00007525 "signal handler doesn't get called until later. Maybe much later."
NSQ_SOURCE_LINE 00007526 ""
NSQ_SOURCE_LINE 00007527 "Fortunately there are ways around this which we'll discuss below."
NSQ_SOURCE_LINE 00007528 "Unfortunately they make signals unsafe again."
NSQ_SOURCE_LINE 00007529 ""
NSQ_SOURCE_LINE 00007530 "The two most common uses of signals in relation to the DBI are for"
NSQ_SOURCE_LINE 00007531 "canceling operations when the user types Ctrl-C (interrupt), and for"
NSQ_SOURCE_LINE 00007532 "implementing a timeout using C<alarm()> and C<$SIG{ALRM}>."
NSQ_SOURCE_LINE 00007533 ""
NSQ_SOURCE_LINE 00007534 "=over 4"
NSQ_SOURCE_LINE 00007535 ""
NSQ_SOURCE_LINE 00007536 "=item Cancel"
NSQ_SOURCE_LINE 00007537 ""
NSQ_SOURCE_LINE 00007538 "The DBI provides a C<cancel> method for statement handles. The"
NSQ_SOURCE_LINE 00007539 "C<cancel> method should abort the current operation and is designed"
NSQ_SOURCE_LINE 00007540 "to be called from a signal handler.  For example:"
NSQ_SOURCE_LINE 00007541 ""
NSQ_SOURCE_LINE 00007542 "  $SIG{INT} = sub { $sth->cancel };"
NSQ_SOURCE_LINE 00007543 ""
NSQ_SOURCE_LINE 00007544 "However, few drivers implement this (the DBI provides a default"
NSQ_SOURCE_LINE 00007545 "method that just returns C<undef>) and, even if implemented, there"
NSQ_SOURCE_LINE 00007546 "is still a possibility that the statement handle, and even the"
NSQ_SOURCE_LINE 00007547 "parent database handle, will not be usable afterwards."
NSQ_SOURCE_LINE 00007548 ""
NSQ_SOURCE_LINE 00007549 "If C<cancel> returns true, then it has successfully"
NSQ_SOURCE_LINE 00007550 "invoked the database engine's own cancel function.  If it returns false,"
NSQ_SOURCE_LINE 00007551 "then C<cancel> failed. If it returns C<undef>, then the database"
NSQ_SOURCE_LINE 00007552 "driver does not have cancel implemented - very few do."
NSQ_SOURCE_LINE 00007553 ""
NSQ_SOURCE_LINE 00007554 "=item Timeout"
NSQ_SOURCE_LINE 00007555 ""
NSQ_SOURCE_LINE 00007556 "The traditional way to implement a timeout is to set C<$SIG{ALRM}>"
NSQ_SOURCE_LINE 00007557 "to refer to some code that will be executed when an ALRM signal"
NSQ_SOURCE_LINE 00007558 "arrives and then to call alarm($seconds) to schedule an ALRM signal"
NSQ_SOURCE_LINE 00007559 "to be delivered $seconds in the future. For example:"
NSQ_SOURCE_LINE 00007560 ""
NSQ_SOURCE_LINE 00007561 "  my $failed;"
NSQ_SOURCE_LINE 00007562 "  eval {"
NSQ_SOURCE_LINE 00007563 "    local $SIG{ALRM} = sub { die \"TIMEOUT\\n\" }; # N.B. \\n required"
NSQ_SOURCE_LINE 00007564 "    eval {"
NSQ_SOURCE_LINE 00007565 "      alarm($seconds);"
NSQ_SOURCE_LINE 00007566 "      ... code to execute with timeout here (which may die) ..."
NSQ_SOURCE_LINE 00007567 "      1;"
NSQ_SOURCE_LINE 00007568 "    } or $failed = 1;"
NSQ_SOURCE_LINE 00007569 "    # outer eval catches alarm that might fire JUST before this alarm(0)"
NSQ_SOURCE_LINE 00007570 "    alarm(0);  # cancel alarm (if code ran fast)"
NSQ_SOURCE_LINE 00007571 "    die \"$@\" if $failed;"
NSQ_SOURCE_LINE 00007572 "    1;"
NSQ_SOURCE_LINE 00007573 "  } or $failed = 1;"
NSQ_SOURCE_LINE 00007574 "  if ( $failed ) {"
NSQ_SOURCE_LINE 00007575 "    if ( defined $@ and $@ eq \"TIMEOUT\\n\" ) { ... }"
NSQ_SOURCE_LINE 00007576 "    else { ... } # some other error"
NSQ_SOURCE_LINE 00007577 "  }"
NSQ_SOURCE_LINE 00007578 ""
NSQ_SOURCE_LINE 00007579 "The first (outer) eval is used to avoid the unlikely but possible"
NSQ_SOURCE_LINE 00007580 "chance that the \"code to execute\" dies and the alarm fires before it"
NSQ_SOURCE_LINE 00007581 "is cancelled. Without the outer eval, if this happened your program"
NSQ_SOURCE_LINE 00007582 "will die if you have no ALRM handler or a non-local alarm handler"
NSQ_SOURCE_LINE 00007583 "will be called."
NSQ_SOURCE_LINE 00007584 ""
NSQ_SOURCE_LINE 00007585 "Unfortunately, as described above, this won't always work as expected,"
NSQ_SOURCE_LINE 00007586 "depending on your perl version and the underlying database code."
NSQ_SOURCE_LINE 00007587 ""
NSQ_SOURCE_LINE 00007588 "With Oracle for instance (DBD::Oracle), if the system which hosts"
NSQ_SOURCE_LINE 00007589 "the database is down the DBI->connect() call will hang for several"
NSQ_SOURCE_LINE 00007590 "minutes before returning an error."
NSQ_SOURCE_LINE 00007591 ""
NSQ_SOURCE_LINE 00007592 "=back"
NSQ_SOURCE_LINE 00007593 ""
NSQ_SOURCE_LINE 00007594 "The solution on these systems is to use the C<POSIX::sigaction()>"
NSQ_SOURCE_LINE 00007595 "routine to gain low level access to how the signal handler is installed."
NSQ_SOURCE_LINE 00007596 ""
NSQ_SOURCE_LINE 00007597 "The code would look something like this (for the DBD-Oracle connect()):"
NSQ_SOURCE_LINE 00007598 ""
NSQ_SOURCE_LINE 00007599 "   use POSIX qw(:signal_h);"
NSQ_SOURCE_LINE 00007600 ""
NSQ_SOURCE_LINE 00007601 "   my $mask = POSIX::SigSet->new( SIGALRM ); # signals to mask in the handler"
NSQ_SOURCE_LINE 00007602 "   my $action = POSIX::SigAction->new("
NSQ_SOURCE_LINE 00007603 "       sub { die \"connect timeout\\n\" },        # the handler code ref"
NSQ_SOURCE_LINE 00007604 "       $mask,"
NSQ_SOURCE_LINE 00007605 "       # not using (perl 5.8.2 and later) 'safe' switch or sa_flags"
NSQ_SOURCE_LINE 00007606 "   );"
NSQ_SOURCE_LINE 00007607 "   my $oldaction = POSIX::SigAction->new();"
NSQ_SOURCE_LINE 00007608 "   sigaction( SIGALRM, $action, $oldaction );"
NSQ_SOURCE_LINE 00007609 "   my $dbh;"
NSQ_SOURCE_LINE 00007610 "   my $failed;"
NSQ_SOURCE_LINE 00007611 "   eval {"
NSQ_SOURCE_LINE 00007612 "      eval {"
NSQ_SOURCE_LINE 00007613 "        alarm(5); # seconds before time out"
NSQ_SOURCE_LINE 00007614 "        $dbh = DBI->connect(\"dbi:Oracle:$dsn\" ... );"
NSQ_SOURCE_LINE 00007615 "        1;"
NSQ_SOURCE_LINE 00007616 "      } or $failed = 1;"
NSQ_SOURCE_LINE 00007617 "      alarm(0); # cancel alarm (if connect worked fast)"
NSQ_SOURCE_LINE 00007618 "      die \"$@\\n\" if $failed; # connect died"
NSQ_SOURCE_LINE 00007619 "      1;"
NSQ_SOURCE_LINE 00007620 "   } or $failed = 1;"
NSQ_SOURCE_LINE 00007621 "   sigaction( SIGALRM, $oldaction );  # restore original signal handler"
NSQ_SOURCE_LINE 00007622 "   if ( $failed ) {"
NSQ_SOURCE_LINE 00007623 "     if ( defined $@ and $@ eq \"connect timeout\\n\" ) {...}"
NSQ_SOURCE_LINE 00007624 "     else { # connect died }"
NSQ_SOURCE_LINE 00007625 "   }"
NSQ_SOURCE_LINE 00007626 ""
NSQ_SOURCE_LINE 00007627 "See previous example for the reasoning around the double eval."
NSQ_SOURCE_LINE 00007628 ""
NSQ_SOURCE_LINE 00007629 "Similar techniques can be used for canceling statement execution."
NSQ_SOURCE_LINE 00007630 ""
NSQ_SOURCE_LINE 00007631 "Unfortunately, this solution is somewhat messy, and it does I<not> work with"
NSQ_SOURCE_LINE 00007632 "perl versions less than perl 5.8 where C<POSIX::sigaction()> appears to be broken."
NSQ_SOURCE_LINE 00007633 ""
NSQ_SOURCE_LINE 00007634 "For a cleaner implementation that works across perl versions, see Lincoln Baxter's"
NSQ_SOURCE_LINE 00007635 "Sys::SigAction module at L<Sys::SigAction>."
NSQ_SOURCE_LINE 00007636 "The documentation for Sys::SigAction includes an longer discussion"
NSQ_SOURCE_LINE 00007637 "of this problem, and a DBD::Oracle test script."
NSQ_SOURCE_LINE 00007638 ""
NSQ_SOURCE_LINE 00007639 "Be sure to read all the signal handling sections of the L<perlipc> manual."
NSQ_SOURCE_LINE 00007640 ""
NSQ_SOURCE_LINE 00007641 "And finally, two more points to keep firmly in mind. Firstly,"
NSQ_SOURCE_LINE 00007642 "remember that what we've done here is essentially revert to old"
NSQ_SOURCE_LINE 00007643 "style I<unsafe> handling of these signals. So do as little as"
NSQ_SOURCE_LINE 00007644 "possible in the handler.  Ideally just die(). Secondly, the handles"
NSQ_SOURCE_LINE 00007645 "in use at the time the signal is handled may not be safe to use"
NSQ_SOURCE_LINE 00007646 "afterwards."
NSQ_SOURCE_LINE 00007647 ""
NSQ_SOURCE_LINE 00007648 ""
NSQ_SOURCE_LINE 00007649 "=head2 Subclassing the DBI"
NSQ_SOURCE_LINE 00007650 ""
NSQ_SOURCE_LINE 00007651 "DBI can be subclassed and extended just like any other object"
NSQ_SOURCE_LINE 00007652 "oriented module.  Before we talk about how to do that, it's important"
NSQ_SOURCE_LINE 00007653 "to be clear about the various DBI classes and how they work together."
NSQ_SOURCE_LINE 00007654 ""
NSQ_SOURCE_LINE 00007655 "By default C<$dbh = DBI-E<gt>connect(...)> returns a $dbh blessed"
NSQ_SOURCE_LINE 00007656 "into the C<DBI::db> class.  And the C<$dbh-E<gt>prepare> method"
NSQ_SOURCE_LINE 00007657 "returns an $sth blessed into the C<DBI::st> class (actually it"
NSQ_SOURCE_LINE 00007658 "simply changes the last four characters of the calling handle class"
NSQ_SOURCE_LINE 00007659 "to be C<::st>)."
NSQ_SOURCE_LINE 00007660 ""
NSQ_SOURCE_LINE 00007661 "The leading 'C<DBI>' is known as the 'root class' and the extra"
NSQ_SOURCE_LINE 00007662 "'C<::db>' or 'C<::st>' are the 'handle type suffixes'. If you want"
NSQ_SOURCE_LINE 00007663 "to subclass the DBI you'll need to put your overriding methods into"
NSQ_SOURCE_LINE 00007664 "the appropriate classes.  For example, if you want to use a root class"
NSQ_SOURCE_LINE 00007665 "of C<MySubDBI> and override the do(), prepare() and execute() methods,"
NSQ_SOURCE_LINE 00007666 "then your do() and prepare() methods should be in the C<MySubDBI::db>"
NSQ_SOURCE_LINE 00007667 "class and the execute() method should be in the C<MySubDBI::st> class."
NSQ_SOURCE_LINE 00007668 ""
NSQ_SOURCE_LINE 00007669 "To setup the inheritance hierarchy the @ISA variable in C<MySubDBI::db>"
NSQ_SOURCE_LINE 00007670 "should include C<DBI::db> and the @ISA variable in C<MySubDBI::st>"
NSQ_SOURCE_LINE 00007671 "should include C<DBI::st>.  The C<MySubDBI> root class itself isn't"
NSQ_SOURCE_LINE 00007672 "currently used for anything visible and so, apart from setting @ISA"
NSQ_SOURCE_LINE 00007673 "to include C<DBI>, it can be left empty."
NSQ_SOURCE_LINE 00007674 ""
NSQ_SOURCE_LINE 00007675 "So, having put your overriding methods into the right classes, and"
NSQ_SOURCE_LINE 00007676 "setup the inheritance hierarchy, how do you get the DBI to use them?"
NSQ_SOURCE_LINE 00007677 "You have two choices, either a static method call using the name"
NSQ_SOURCE_LINE 00007678 "of your subclass:"
NSQ_SOURCE_LINE 00007679 ""
NSQ_SOURCE_LINE 00007680 "  $dbh = MySubDBI->connect(...);"
NSQ_SOURCE_LINE 00007681 ""
NSQ_SOURCE_LINE 00007682 "or specifying a C<RootClass> attribute:"
NSQ_SOURCE_LINE 00007683 ""
NSQ_SOURCE_LINE 00007684 "  $dbh = DBI->connect(..., { RootClass => 'MySubDBI' });"
NSQ_SOURCE_LINE 00007685 ""
NSQ_SOURCE_LINE 00007686 "If both forms are used then the attribute takes precedence."
NSQ_SOURCE_LINE 00007687 ""
NSQ_SOURCE_LINE 00007688 "The only differences between the two are that using an explicit"
NSQ_SOURCE_LINE 00007689 "RootClass attribute will a) make the DBI automatically attempt to load"
NSQ_SOURCE_LINE 00007690 "a module by that name if the class doesn't exist, and b) won't call"
NSQ_SOURCE_LINE 00007691 "your MySubDBI::connect() method, if you have one."
NSQ_SOURCE_LINE 00007692 ""
NSQ_SOURCE_LINE 00007693 "When subclassing is being used then, after a successful new"
NSQ_SOURCE_LINE 00007694 "connect, the DBI->connect method automatically calls:"
NSQ_SOURCE_LINE 00007695 ""
NSQ_SOURCE_LINE 00007696 "  $dbh->connected($dsn, $user, $pass, \\%attr);"
NSQ_SOURCE_LINE 00007697 ""
NSQ_SOURCE_LINE 00007698 "The default method does nothing. The call is made just to simplify"
NSQ_SOURCE_LINE 00007699 "any post-connection setup that your subclass may want to perform."
NSQ_SOURCE_LINE 00007700 "The parameters are the same as passed to DBI->connect."
NSQ_SOURCE_LINE 00007701 "If your subclass supplies a connected method, it should be part of the"
NSQ_SOURCE_LINE 00007702 "MySubDBI::db package."
NSQ_SOURCE_LINE 00007703 ""
NSQ_SOURCE_LINE 00007704 "One more thing to note: you must let the DBI do the handle creation.  If you"
NSQ_SOURCE_LINE 00007705 "want to override the connect() method in your *::dr class then it must still"
NSQ_SOURCE_LINE 00007706 "call SUPER::connect to get a $dbh to work with. Similarly, an overridden"
NSQ_SOURCE_LINE 00007707 "prepare() method in *::db must still call SUPER::prepare to get a $sth."
NSQ_SOURCE_LINE 00007708 "If you try to create your own handles using bless() then you'll find the DBI"
NSQ_SOURCE_LINE 00007709 "will reject them with an \"is not a DBI handle (has no magic)\" error."
NSQ_SOURCE_LINE 00007710 ""
NSQ_SOURCE_LINE 00007711 "Here's a brief example of a DBI subclass.  A more thorough example"
NSQ_SOURCE_LINE 00007712 "can be found in F<t/subclass.t> in the DBI distribution."
NSQ_SOURCE_LINE 00007713 ""
NSQ_SOURCE_LINE 00007714 "  package MySubDBI;"
NSQ_SOURCE_LINE 00007715 ""
NSQ_SOURCE_LINE 00007716 "  use strict;"
NSQ_SOURCE_LINE 00007717 ""
NSQ_SOURCE_LINE 00007718 "  use DBI;"
NSQ_SOURCE_LINE 00007719 "  our @ISA = qw(DBI);"
NSQ_SOURCE_LINE 00007720 ""
NSQ_SOURCE_LINE 00007721 "  package MySubDBI::db;"
NSQ_SOURCE_LINE 00007722 "  our @ISA = qw(DBI::db);"
NSQ_SOURCE_LINE 00007723 ""
NSQ_SOURCE_LINE 00007724 "  sub prepare {"
NSQ_SOURCE_LINE 00007725 "    my ($dbh, @args) = @_;"
NSQ_SOURCE_LINE 00007726 "    my $sth = $dbh->SUPER::prepare(@args)"
NSQ_SOURCE_LINE 00007727 "        or return;"
NSQ_SOURCE_LINE 00007728 "    $sth->{private_mysubdbi_info} = { foo => 'bar' };"
NSQ_SOURCE_LINE 00007729 "    return $sth;"
NSQ_SOURCE_LINE 00007730 "  }"
NSQ_SOURCE_LINE 00007731 ""
NSQ_SOURCE_LINE 00007732 "  package MySubDBI::st;"
NSQ_SOURCE_LINE 00007733 "  our @ISA = qw(DBI::st);"
NSQ_SOURCE_LINE 00007734 ""
NSQ_SOURCE_LINE 00007735 "  sub fetch {"
NSQ_SOURCE_LINE 00007736 "    my ($sth, @args) = @_;"
NSQ_SOURCE_LINE 00007737 "    my $row = $sth->SUPER::fetch(@args)"
NSQ_SOURCE_LINE 00007738 "        or return;"
NSQ_SOURCE_LINE 00007739 "    do_something_magical_with_row_data($row)"
NSQ_SOURCE_LINE 00007740 "        or return $sth->set_err(1234, \"The magic failed\", undef, \"fetch\");"
NSQ_SOURCE_LINE 00007741 "    return $row;"
NSQ_SOURCE_LINE 00007742 "  }"
NSQ_SOURCE_LINE 00007743 ""
NSQ_SOURCE_LINE 00007744 "When calling a SUPER::method that returns a handle, be careful to"
NSQ_SOURCE_LINE 00007745 "check the return value before trying to do other things with it in"
NSQ_SOURCE_LINE 00007746 "your overridden method. This is especially important if you want to"
NSQ_SOURCE_LINE 00007747 "set a hash attribute on the handle, as Perl's autovivification will"
NSQ_SOURCE_LINE 00007748 "bite you by (in)conveniently creating an unblessed hashref, which your"
NSQ_SOURCE_LINE 00007749 "method will then return with usually baffling results later on like"
NSQ_SOURCE_LINE 00007750 "the error \"dbih_getcom handle HASH(0xa4451a8) is not a DBI handle (has"
NSQ_SOURCE_LINE 00007751 "no magic\".  It's best to check right after the call and return undef"
NSQ_SOURCE_LINE 00007752 "immediately on error, just like DBI would and just like the example"
NSQ_SOURCE_LINE 00007753 "above."
NSQ_SOURCE_LINE 00007754 ""
NSQ_SOURCE_LINE 00007755 "If your method needs to record an error it should call the set_err()"
NSQ_SOURCE_LINE 00007756 "method with the error code and error string, as shown in the example"
NSQ_SOURCE_LINE 00007757 "above. The error code and error string will be recorded in the"
NSQ_SOURCE_LINE 00007758 "handle and available via C<$h-E<gt>err> and C<$DBI::errstr> etc."
NSQ_SOURCE_LINE 00007759 "The set_err() method always returns an undef or empty list as"
NSQ_SOURCE_LINE 00007760 "appropriate. Since your method should nearly always return an undef"
NSQ_SOURCE_LINE 00007761 "or empty list as soon as an error is detected it's handy to simply"
NSQ_SOURCE_LINE 00007762 "return what set_err() returns, as shown in the example above."
NSQ_SOURCE_LINE 00007763 ""
NSQ_SOURCE_LINE 00007764 "If the handle has C<RaiseError>, C<PrintError>, or C<HandleError>"
NSQ_SOURCE_LINE 00007765 "etc. set then the set_err() method will honour them. This means"
NSQ_SOURCE_LINE 00007766 "that if C<RaiseError> is set then set_err() won't return in the"
NSQ_SOURCE_LINE 00007767 "normal way but will 'throw an exception' that can be caught with"
NSQ_SOURCE_LINE 00007768 "an C<eval> block."
NSQ_SOURCE_LINE 00007769 ""
NSQ_SOURCE_LINE 00007770 "You can stash private data into DBI handles"
NSQ_SOURCE_LINE 00007771 "via C<$h-E<gt>{private_..._*}>.  See the entry under L</ATTRIBUTES"
NSQ_SOURCE_LINE 00007772 "COMMON TO ALL HANDLES> for info and important caveats."
NSQ_SOURCE_LINE 00007773 ""
NSQ_SOURCE_LINE 00007774 "=head2 Memory Leaks"
NSQ_SOURCE_LINE 00007775 ""
NSQ_SOURCE_LINE 00007776 "When tracking down memory leaks using tools like L<Devel::Leak>"
NSQ_SOURCE_LINE 00007777 "you'll find that some DBI internals are reported as 'leaking' memory."
NSQ_SOURCE_LINE 00007778 "This is very unlikely to be a real leak.  The DBI has various caches to improve"
NSQ_SOURCE_LINE 00007779 "performance and the apparrent leaks are simply the normal operation of these"
NSQ_SOURCE_LINE 00007780 "caches."
NSQ_SOURCE_LINE 00007781 ""
NSQ_SOURCE_LINE 00007782 "The most frequent sources of the apparrent leaks are L</ChildHandles>,"
NSQ_SOURCE_LINE 00007783 "L</prepare_cached> and L</connect_cached>."
NSQ_SOURCE_LINE 00007784 ""
NSQ_SOURCE_LINE 00007785 "For example http://stackoverflow.com/questions/13338308/perl-dbi-memory-leak"
NSQ_SOURCE_LINE 00007786 ""
NSQ_SOURCE_LINE 00007787 "Given how widely the DBI is used, you can rest assured that if a new release of"
NSQ_SOURCE_LINE 00007788 "the DBI did have a real leak it would be discovered, reported, and fixed"
NSQ_SOURCE_LINE 00007789 "immediately. The leak you're looking for is probably elsewhere. Good luck!"
NSQ_SOURCE_LINE 00007790 ""
NSQ_SOURCE_LINE 00007791 ""
NSQ_SOURCE_LINE 00007792 "=head1 TRACING"
NSQ_SOURCE_LINE 00007793 ""
NSQ_SOURCE_LINE 00007794 "The DBI has a powerful tracing mechanism built in. It enables you"
NSQ_SOURCE_LINE 00007795 "to see what's going on 'behind the scenes', both within the DBI and"
NSQ_SOURCE_LINE 00007796 "the drivers you're using."
NSQ_SOURCE_LINE 00007797 ""
NSQ_SOURCE_LINE 00007798 "=head2 Trace Settings"
NSQ_SOURCE_LINE 00007799 ""
NSQ_SOURCE_LINE 00007800 "Which details are written to the trace output is controlled by a"
NSQ_SOURCE_LINE 00007801 "combination of a I<trace level>, an integer from 0 to 15, and a set"
NSQ_SOURCE_LINE 00007802 "of I<trace flags> that are either on or off. Together these are known"
NSQ_SOURCE_LINE 00007803 "as the I<trace settings> and are stored together in a single integer."
NSQ_SOURCE_LINE 00007804 "For normal use you only need to set the trace level, and generally"
NSQ_SOURCE_LINE 00007805 "only to a value between 1 and 4."
NSQ_SOURCE_LINE 00007806 ""
NSQ_SOURCE_LINE 00007807 "Each handle has its own trace settings, and so does the DBI."
NSQ_SOURCE_LINE 00007808 "When you call a method the DBI merges the handles settings into its"
NSQ_SOURCE_LINE 00007809 "own for the duration of the call: the trace flags of the handle are"
NSQ_SOURCE_LINE 00007810 "OR'd into the trace flags of the DBI, and if the handle has a higher"
NSQ_SOURCE_LINE 00007811 "trace level then the DBI trace level is raised to match it."
NSQ_SOURCE_LINE 00007812 "The previous DBI trace settings are restored when the called method"
NSQ_SOURCE_LINE 00007813 "returns."
NSQ_SOURCE_LINE 00007814 ""
NSQ_SOURCE_LINE 00007815 "=head2 Trace Levels"
NSQ_SOURCE_LINE 00007816 ""
NSQ_SOURCE_LINE 00007817 "Trace I<levels> are as follows:"
NSQ_SOURCE_LINE 00007818 ""
NSQ_SOURCE_LINE 00007819 "  0 - Trace disabled."
NSQ_SOURCE_LINE 00007820 "  1 - Trace top-level DBI method calls returning with results or errors."
NSQ_SOURCE_LINE 00007821 "  2 - As above, adding tracing of top-level method entry with parameters."
NSQ_SOURCE_LINE 00007822 "  3 - As above, adding some high-level information from the driver"
NSQ_SOURCE_LINE 00007823 "      and some internal information from the DBI."
NSQ_SOURCE_LINE 00007824 "  4 - As above, adding more detailed information from the driver."
NSQ_SOURCE_LINE 00007825 "      This is the first level to trace all the rows being fetched."
NSQ_SOURCE_LINE 00007826 "  5 to 15 - As above but with more and more internal information."
NSQ_SOURCE_LINE 00007827 ""
NSQ_SOURCE_LINE 00007828 "Trace level 1 is best for a simple overview of what's happening."
NSQ_SOURCE_LINE 00007829 "Trace levels 2 thru 4 a good choice for general purpose tracing."
NSQ_SOURCE_LINE 00007830 "Levels 5 and above are best reserved for investigating a specific"
NSQ_SOURCE_LINE 00007831 "problem, when you need to see \"inside\" the driver and DBI."
NSQ_SOURCE_LINE 00007832 ""
NSQ_SOURCE_LINE 00007833 "The trace output is detailed and typically very useful. Much of the"
NSQ_SOURCE_LINE 00007834 "trace output is formatted using the L</neat> function, so strings"
NSQ_SOURCE_LINE 00007835 "in the trace output may be edited and truncated by that function."
NSQ_SOURCE_LINE 00007836 ""
NSQ_SOURCE_LINE 00007837 "=head2 Trace Flags"
NSQ_SOURCE_LINE 00007838 ""
NSQ_SOURCE_LINE 00007839 "Trace I<flags> are used to enable tracing of specific activities"
NSQ_SOURCE_LINE 00007840 "within the DBI and drivers. The DBI defines some trace flags and"
NSQ_SOURCE_LINE 00007841 "drivers can define others. DBI trace flag names begin with a capital"
NSQ_SOURCE_LINE 00007842 "letter and driver specific names begin with a lowercase letter, as"
NSQ_SOURCE_LINE 00007843 "usual."
NSQ_SOURCE_LINE 00007844 ""
NSQ_SOURCE_LINE 00007845 "Currently the DBI defines these trace flags:"
NSQ_SOURCE_LINE 00007846 ""
NSQ_SOURCE_LINE 00007847 "  ALL - turn on all DBI and driver flags (not recommended)"
NSQ_SOURCE_LINE 00007848 "  SQL - trace SQL statements executed"
NSQ_SOURCE_LINE 00007849 "        (not yet implemented in DBI but implemented in some DBDs)"
NSQ_SOURCE_LINE 00007850 "  CON - trace connection process"
NSQ_SOURCE_LINE 00007851 "  ENC - trace encoding (unicode translations etc)"
NSQ_SOURCE_LINE 00007852 "        (not yet implemented in DBI but implemented in some DBDs)"
NSQ_SOURCE_LINE 00007853 "  DBD - trace only DBD messages"
NSQ_SOURCE_LINE 00007854 "        (not implemented by all DBDs yet)"
NSQ_SOURCE_LINE 00007855 "  TXN - trace transactions"
NSQ_SOURCE_LINE 00007856 "        (not implemented in all DBDs yet)"
NSQ_SOURCE_LINE 00007857 ""
NSQ_SOURCE_LINE 00007858 "The L</parse_trace_flags> and L</parse_trace_flag> methods are used"
NSQ_SOURCE_LINE 00007859 "to convert trace flag names into the corresponding integer bit flags."
NSQ_SOURCE_LINE 00007860 ""
NSQ_SOURCE_LINE 00007861 "=head2 Enabling Trace"
NSQ_SOURCE_LINE 00007862 ""
NSQ_SOURCE_LINE 00007863 "The C<$h-E<gt>trace> method sets the trace settings for a handle"
NSQ_SOURCE_LINE 00007864 "and C<DBI-E<gt>trace> does the same for the DBI."
NSQ_SOURCE_LINE 00007865 ""
NSQ_SOURCE_LINE 00007866 "In addition to the L</trace> method, you can enable the same trace"
NSQ_SOURCE_LINE 00007867 "information, and direct the output to a file, by setting the"
NSQ_SOURCE_LINE 00007868 "C<DBI_TRACE> environment variable before starting Perl."
NSQ_SOURCE_LINE 00007869 "See L</DBI_TRACE> for more information."
NSQ_SOURCE_LINE 00007870 ""
NSQ_SOURCE_LINE 00007871 "Finally, you can set, or get, the trace settings for a handle using"
NSQ_SOURCE_LINE 00007872 "the C<TraceLevel> attribute."
NSQ_SOURCE_LINE 00007873 ""
NSQ_SOURCE_LINE 00007874 "All of those methods use parse_trace_flags() and so allow you set"
NSQ_SOURCE_LINE 00007875 "both the trace level and multiple trace flags by using a string"
NSQ_SOURCE_LINE 00007876 "containing the trace level and/or flag names separated by vertical"
NSQ_SOURCE_LINE 00007877 "bar (\"C<|>\") or comma (\"C<,>\") characters. For example:"
NSQ_SOURCE_LINE 00007878 ""
NSQ_SOURCE_LINE 00007879 "  local $h->{TraceLevel} = \"3|SQL|foo\";"
NSQ_SOURCE_LINE 00007880 ""
NSQ_SOURCE_LINE 00007881 "=head2 Trace Output"
NSQ_SOURCE_LINE 00007882 ""
NSQ_SOURCE_LINE 00007883 "Initially trace output is written to C<STDERR>.  Both the"
NSQ_SOURCE_LINE 00007884 "C<$h-E<gt>trace> and C<DBI-E<gt>trace> methods take an optional"
NSQ_SOURCE_LINE 00007885 "$trace_file parameter, which may be either the name of a file to be"
NSQ_SOURCE_LINE 00007886 "opened by DBI in append mode, or a reference to an existing writable"
NSQ_SOURCE_LINE 00007887 "(possibly layered) filehandle. If $trace_file is a filename,"
NSQ_SOURCE_LINE 00007888 "and can be opened in append mode, or $trace_file is a writable"
NSQ_SOURCE_LINE 00007889 "filehandle, then I<all> trace output (currently including that from"
NSQ_SOURCE_LINE 00007890 "other handles) is redirected to that file. A warning is generated"
NSQ_SOURCE_LINE 00007891 "if $trace_file can't be opened or is not writable."
NSQ_SOURCE_LINE 00007892 ""
NSQ_SOURCE_LINE 00007893 "Further calls to trace() without $trace_file do not alter where"
NSQ_SOURCE_LINE 00007894 "the trace output is sent. If $trace_file is undefined, then"
NSQ_SOURCE_LINE 00007895 "trace output is sent to C<STDERR> and, if the prior trace was opened with"
NSQ_SOURCE_LINE 00007896 "$trace_file as a filename, the previous trace file is closed; if $trace_file was"
NSQ_SOURCE_LINE 00007897 "a filehandle, the filehandle is B<not> closed."
NSQ_SOURCE_LINE 00007898 ""
NSQ_SOURCE_LINE 00007899 "B<NOTE>: If $trace_file is specified as a filehandle, the filehandle"
NSQ_SOURCE_LINE 00007900 "should not be closed until all DBI operations are completed, or the"
NSQ_SOURCE_LINE 00007901 "application has reset the trace file via another call to"
NSQ_SOURCE_LINE 00007902 "C<trace()> that changes the trace file."
NSQ_SOURCE_LINE 00007903 ""
NSQ_SOURCE_LINE 00007904 "=head2 Tracing to Layered Filehandles"
NSQ_SOURCE_LINE 00007905 ""
NSQ_SOURCE_LINE 00007906 "B<NOTE>:"
NSQ_SOURCE_LINE 00007907 ""
NSQ_SOURCE_LINE 00007908 "=over 4"
NSQ_SOURCE_LINE 00007909 ""
NSQ_SOURCE_LINE 00007910 "=item *"
NSQ_SOURCE_LINE 00007911 "Tied filehandles are not currently supported, as"
NSQ_SOURCE_LINE 00007912 "tie operations are not available to the PerlIO"
NSQ_SOURCE_LINE 00007913 "methods used by the DBI."
NSQ_SOURCE_LINE 00007914 ""
NSQ_SOURCE_LINE 00007915 "=item *"
NSQ_SOURCE_LINE 00007916 "PerlIO layer support requires Perl version 5.8 or higher."
NSQ_SOURCE_LINE 00007917 ""
NSQ_SOURCE_LINE 00007918 "=back"
NSQ_SOURCE_LINE 00007919 ""
NSQ_SOURCE_LINE 00007920 "As of version 5.8, Perl provides the ability to layer various"
NSQ_SOURCE_LINE 00007921 "\"disciplines\" on an open filehandle via the L<PerlIO> module."
NSQ_SOURCE_LINE 00007922 ""
NSQ_SOURCE_LINE 00007923 "A simple example of using PerlIO layers is to use a scalar as the output:"
NSQ_SOURCE_LINE 00007924 ""
NSQ_SOURCE_LINE 00007925 "    my $scalar = '';"
NSQ_SOURCE_LINE 00007926 "    open( my $fh, \"+>:scalar\", \\$scalar );"
NSQ_SOURCE_LINE 00007927 "    $dbh->trace( 2, $fh );"
NSQ_SOURCE_LINE 00007928 ""
NSQ_SOURCE_LINE 00007929 "Now all trace output is simply appended to $scalar."
NSQ_SOURCE_LINE 00007930 ""
NSQ_SOURCE_LINE 00007931 "A more complex application of tracing to a layered filehandle is the"
NSQ_SOURCE_LINE 00007932 "use of a custom layer (I<Refer to >L<Perlio::via> I<for details"
NSQ_SOURCE_LINE 00007933 "on creating custom PerlIO layers.>). Consider an application with the"
NSQ_SOURCE_LINE 00007934 "following logger module:"
NSQ_SOURCE_LINE 00007935 ""
NSQ_SOURCE_LINE 00007936 "    package MyFancyLogger;"
NSQ_SOURCE_LINE 00007937 ""
NSQ_SOURCE_LINE 00007938 "    sub new"
NSQ_SOURCE_LINE 00007939 "    {"
NSQ_SOURCE_LINE 00007940 "        my $self = {};"
NSQ_SOURCE_LINE 00007941 "        my $fh;"
NSQ_SOURCE_LINE 00007942 "        open $fh, '>', 'fancylog.log';"
NSQ_SOURCE_LINE 00007943 "        $self->{_fh} = $fh;"
NSQ_SOURCE_LINE 00007944 "        $self->{_buf} = '';"
NSQ_SOURCE_LINE 00007945 "        return bless $self, shift;"
NSQ_SOURCE_LINE 00007946 "    }"
NSQ_SOURCE_LINE 00007947 ""
NSQ_SOURCE_LINE 00007948 "    sub log"
NSQ_SOURCE_LINE 00007949 "    {"
NSQ_SOURCE_LINE 00007950 "        my $self = shift;"
NSQ_SOURCE_LINE 00007951 "        return unless exists $self->{_fh};"
NSQ_SOURCE_LINE 00007952 "        my $fh = $self->{_fh};"
NSQ_SOURCE_LINE 00007953 "        $self->{_buf} .= shift;"
NSQ_SOURCE_LINE 00007954 "    #"
NSQ_SOURCE_LINE 00007955 "    # DBI feeds us pieces at a time, so accumulate a complete line"
NSQ_SOURCE_LINE 00007956 "    # before outputting"
NSQ_SOURCE_LINE 00007957 "    #"
NSQ_SOURCE_LINE 00007958 "        print $fh \"At \", scalar localtime(), ':', $self->{_buf}, \"\\n\" and"
NSQ_SOURCE_LINE 00007959 "        $self->{_buf} = ''"
NSQ_SOURCE_LINE 00007960 "            if $self->{_buf}=~tr/\\n//;"
NSQ_SOURCE_LINE 00007961 "    }"
NSQ_SOURCE_LINE 00007962 ""
NSQ_SOURCE_LINE 00007963 "    sub close {"
NSQ_SOURCE_LINE 00007964 "        my $self = shift;"
NSQ_SOURCE_LINE 00007965 "        return unless exists $self->{_fh};"
NSQ_SOURCE_LINE 00007966 "        my $fh = $self->{_fh};"
NSQ_SOURCE_LINE 00007967 "        print $fh \"At \", scalar localtime(), ':', $self->{_buf}, \"\\n\" and"
NSQ_SOURCE_LINE 00007968 "        $self->{_buf} = ''"
NSQ_SOURCE_LINE 00007969 "            if $self->{_buf};"
NSQ_SOURCE_LINE 00007970 "        close $fh;"
NSQ_SOURCE_LINE 00007971 "        delete $self->{_fh};"
NSQ_SOURCE_LINE 00007972 "    }"
NSQ_SOURCE_LINE 00007973 ""
NSQ_SOURCE_LINE 00007974 "    1;"
NSQ_SOURCE_LINE 00007975 ""
NSQ_SOURCE_LINE 00007976 "To redirect DBI traces to this logger requires creating"
NSQ_SOURCE_LINE 00007977 "a package for the layer:"
NSQ_SOURCE_LINE 00007978 ""
NSQ_SOURCE_LINE 00007979 "    package PerlIO::via::MyFancyLogLayer;"
NSQ_SOURCE_LINE 00007980 ""
NSQ_SOURCE_LINE 00007981 "    sub PUSHED"
NSQ_SOURCE_LINE 00007982 "    {"
NSQ_SOURCE_LINE 00007983 "        my ($class,$mode,$fh) = @_;"
NSQ_SOURCE_LINE 00007984 "        my $logger;"
NSQ_SOURCE_LINE 00007985 "        return bless \\$logger,$class;"
NSQ_SOURCE_LINE 00007986 "    }"
NSQ_SOURCE_LINE 00007987 ""
NSQ_SOURCE_LINE 00007988 "    sub OPEN {"
NSQ_SOURCE_LINE 00007989 "        my ($self, $path, $mode, $fh) = @_;"
NSQ_SOURCE_LINE 00007990 "        #"
NSQ_SOURCE_LINE 00007991 "        # $path is actually our logger object"
NSQ_SOURCE_LINE 00007992 "        #"
NSQ_SOURCE_LINE 00007993 "        $$self = $path;"
NSQ_SOURCE_LINE 00007994 "        return 1;"
NSQ_SOURCE_LINE 00007995 "    }"
NSQ_SOURCE_LINE 00007996 ""
NSQ_SOURCE_LINE 00007997 "    sub WRITE"
NSQ_SOURCE_LINE 00007998 "    {"
NSQ_SOURCE_LINE 00007999 "        my ($self, $buf, $fh) = @_;"
NSQ_SOURCE_LINE 00008000 "        $$self->log($buf);"
NSQ_SOURCE_LINE 00008001 "        return length($buf);"
NSQ_SOURCE_LINE 00008002 "    }"
NSQ_SOURCE_LINE 00008003 ""
NSQ_SOURCE_LINE 00008004 "    sub CLOSE {"
NSQ_SOURCE_LINE 00008005 "        my $self = shift;"
NSQ_SOURCE_LINE 00008006 "        $$self->close();"
NSQ_SOURCE_LINE 00008007 "        return 0;"
NSQ_SOURCE_LINE 00008008 "    }"
NSQ_SOURCE_LINE 00008009 ""
NSQ_SOURCE_LINE 00008010 "    1;"
NSQ_SOURCE_LINE 00008011 ""
NSQ_SOURCE_LINE 00008012 ""
NSQ_SOURCE_LINE 00008013 "The application can then cause DBI traces to be routed to the"
NSQ_SOURCE_LINE 00008014 "logger using"
NSQ_SOURCE_LINE 00008015 ""
NSQ_SOURCE_LINE 00008016 "    use PerlIO::via::MyFancyLogLayer;"
NSQ_SOURCE_LINE 00008017 ""
NSQ_SOURCE_LINE 00008018 "    open my $fh, '>:via(MyFancyLogLayer)', MyFancyLogger->new();"
NSQ_SOURCE_LINE 00008019 ""
NSQ_SOURCE_LINE 00008020 "    $dbh->trace('SQL', $fh);"
NSQ_SOURCE_LINE 00008021 ""
NSQ_SOURCE_LINE 00008022 "Now all trace output will be processed by MyFancyLogger's"
NSQ_SOURCE_LINE 00008023 "log() method."
NSQ_SOURCE_LINE 00008024 ""
NSQ_SOURCE_LINE 00008025 "=head2 Trace Content"
NSQ_SOURCE_LINE 00008026 ""
NSQ_SOURCE_LINE 00008027 "Many of the values embedded in trace output are formatted using the neat()"
NSQ_SOURCE_LINE 00008028 "utility function. This means they may be quoted, sanitized, and possibly"
NSQ_SOURCE_LINE 00008029 "truncated if longer than C<$DBI::neat_maxlen>. See L</neat> for more details."
NSQ_SOURCE_LINE 00008030 ""
NSQ_SOURCE_LINE 00008031 "=head2 Tracing Tips"
NSQ_SOURCE_LINE 00008032 ""
NSQ_SOURCE_LINE 00008033 "You can add tracing to your own application code using the L</trace_msg> method."
NSQ_SOURCE_LINE 00008034 ""
NSQ_SOURCE_LINE 00008035 "It can sometimes be handy to compare trace files from two different runs of the"
NSQ_SOURCE_LINE 00008036 "same script. However using a tool like C<diff> on the original log output"
NSQ_SOURCE_LINE 00008037 "doesn't work well because the trace file is full of object addresses that may"
NSQ_SOURCE_LINE 00008038 "differ on each run."
NSQ_SOURCE_LINE 00008039 ""
NSQ_SOURCE_LINE 00008040 "The DBI includes a handy utility called dbilogstrip that can be used to"
NSQ_SOURCE_LINE 00008041 "'normalize' the log content. It can be used as a filter like this:"
NSQ_SOURCE_LINE 00008042 ""
NSQ_SOURCE_LINE 00008043 "    DBI_TRACE=2 perl yourscript.pl ...args1... 2>&1 | dbilogstrip > dbitrace1.log"
NSQ_SOURCE_LINE 00008044 "    DBI_TRACE=2 perl yourscript.pl ...args2... 2>&1 | dbilogstrip > dbitrace2.log"
NSQ_SOURCE_LINE 00008045 "    diff -u dbitrace1.log dbitrace2.log"
NSQ_SOURCE_LINE 00008046 ""
NSQ_SOURCE_LINE 00008047 "See L<dbilogstrip> for more information."
NSQ_SOURCE_LINE 00008048 ""
NSQ_SOURCE_LINE 00008049 "=head1 DBI ENVIRONMENT VARIABLES"
NSQ_SOURCE_LINE 00008050 ""
NSQ_SOURCE_LINE 00008051 "The DBI module recognizes a number of environment variables, but most of"
NSQ_SOURCE_LINE 00008052 "them should not be used most of the time."
NSQ_SOURCE_LINE 00008053 "It is better to be explicit about what you are doing to avoid the need"
NSQ_SOURCE_LINE 00008054 "for environment variables, especially in a web serving system where web"
NSQ_SOURCE_LINE 00008055 "servers are stingy about which environment variables are available."
NSQ_SOURCE_LINE 00008056 ""
NSQ_SOURCE_LINE 00008057 "=head2 DBI_DSN"
NSQ_SOURCE_LINE 00008058 ""
NSQ_SOURCE_LINE 00008059 "The DBI_DSN environment variable is used by DBI->connect if you do not"
NSQ_SOURCE_LINE 00008060 "specify a data source when you issue the connect."
NSQ_SOURCE_LINE 00008061 "It should have a format such as \"dbi:Driver:databasename\"."
NSQ_SOURCE_LINE 00008062 ""
NSQ_SOURCE_LINE 00008063 "=head2 DBI_DRIVER"
NSQ_SOURCE_LINE 00008064 ""
NSQ_SOURCE_LINE 00008065 "The DBI_DRIVER environment variable is used to fill in the database"
NSQ_SOURCE_LINE 00008066 "driver name in DBI->connect if the data source string starts \"dbi::\""
NSQ_SOURCE_LINE 00008067 "(thereby omitting the driver)."
NSQ_SOURCE_LINE 00008068 "If DBI_DSN omits the driver name, DBI_DRIVER can fill the gap."
NSQ_SOURCE_LINE 00008069 ""
NSQ_SOURCE_LINE 00008070 "=head2 DBI_AUTOPROXY"
NSQ_SOURCE_LINE 00008071 ""
NSQ_SOURCE_LINE 00008072 "The DBI_AUTOPROXY environment variable takes a string value that starts"
NSQ_SOURCE_LINE 00008073 "\"dbi:Proxy:\" and is typically followed by \"hostname=...;port=...\"."
NSQ_SOURCE_LINE 00008074 "It is used to alter the behaviour of DBI->connect."
NSQ_SOURCE_LINE 00008075 "For full details, see DBI::Proxy documentation."
NSQ_SOURCE_LINE 00008076 ""
NSQ_SOURCE_LINE 00008077 "=head2 DBI_USER"
NSQ_SOURCE_LINE 00008078 ""
NSQ_SOURCE_LINE 00008079 "The DBI_USER environment variable takes a string value that is used as"
NSQ_SOURCE_LINE 00008080 "the user name if the DBI->connect call is given undef (as distinct from"
NSQ_SOURCE_LINE 00008081 "an empty string) as the username argument."
NSQ_SOURCE_LINE 00008082 "Be wary of the security implications of using this."
NSQ_SOURCE_LINE 00008083 ""
NSQ_SOURCE_LINE 00008084 "=head2 DBI_PASS"
NSQ_SOURCE_LINE 00008085 ""
NSQ_SOURCE_LINE 00008086 "The DBI_PASS environment variable takes a string value that is used as"
NSQ_SOURCE_LINE 00008087 "the password if the DBI->connect call is given undef (as distinct from"
NSQ_SOURCE_LINE 00008088 "an empty string) as the password argument."
NSQ_SOURCE_LINE 00008089 "Be extra wary of the security implications of using this."
NSQ_SOURCE_LINE 00008090 ""
NSQ_SOURCE_LINE 00008091 "=head2 DBI_DBNAME (obsolete)"
NSQ_SOURCE_LINE 00008092 ""
NSQ_SOURCE_LINE 00008093 "The DBI_DBNAME environment variable takes a string value that is used only when the"
NSQ_SOURCE_LINE 00008094 "obsolescent style of DBI->connect (with driver name as fourth parameter) is used, and"
NSQ_SOURCE_LINE 00008095 "when no value is provided for the first (database name) argument."
NSQ_SOURCE_LINE 00008096 ""
NSQ_SOURCE_LINE 00008097 "=head2 DBI_TRACE"
NSQ_SOURCE_LINE 00008098 ""
NSQ_SOURCE_LINE 00008099 "The DBI_TRACE environment variable specifies the global default"
NSQ_SOURCE_LINE 00008100 "trace settings for the DBI at startup. Can also be used to direct"
NSQ_SOURCE_LINE 00008101 "trace output to a file. When the DBI is loaded it does:"
NSQ_SOURCE_LINE 00008102 ""
NSQ_SOURCE_LINE 00008103 "  DBI->trace(split /=/, $ENV{DBI_TRACE}, 2) if $ENV{DBI_TRACE};"
NSQ_SOURCE_LINE 00008104 ""
NSQ_SOURCE_LINE 00008105 "So if C<DBI_TRACE> contains an \"C<=>\" character then what follows"
NSQ_SOURCE_LINE 00008106 "it is used as the name of the file to append the trace to."
NSQ_SOURCE_LINE 00008107 ""
NSQ_SOURCE_LINE 00008108 "output appended to that file. If the name begins with a number"
NSQ_SOURCE_LINE 00008109 "followed by an equal sign (C<=>), then the number and the equal sign are"
NSQ_SOURCE_LINE 00008110 "stripped off from the name, and the number is used to set the trace"
NSQ_SOURCE_LINE 00008111 "level. For example:"
NSQ_SOURCE_LINE 00008112 ""
NSQ_SOURCE_LINE 00008113 "  DBI_TRACE=1=dbitrace.log perl your_test_script.pl"
NSQ_SOURCE_LINE 00008114 ""
NSQ_SOURCE_LINE 00008115 "On Unix-like systems using a Bourne-like shell, you can do this easily"
NSQ_SOURCE_LINE 00008116 "on the command line:"
NSQ_SOURCE_LINE 00008117 ""
NSQ_SOURCE_LINE 00008118 "  DBI_TRACE=2 perl your_test_script.pl"
NSQ_SOURCE_LINE 00008119 ""
NSQ_SOURCE_LINE 00008120 "See L</TRACING> for more information."
NSQ_SOURCE_LINE 00008121 ""
NSQ_SOURCE_LINE 00008122 "=head2 PERL_DBI_DEBUG (obsolete)"
NSQ_SOURCE_LINE 00008123 ""
NSQ_SOURCE_LINE 00008124 "An old variable that should no longer be used; equivalent to DBI_TRACE."
NSQ_SOURCE_LINE 00008125 ""
NSQ_SOURCE_LINE 00008126 "=head2 DBI_PROFILE"
NSQ_SOURCE_LINE 00008127 ""
NSQ_SOURCE_LINE 00008128 "The DBI_PROFILE environment variable can be used to enable profiling"
NSQ_SOURCE_LINE 00008129 "of DBI method calls. See L<DBI::Profile> for more information."
NSQ_SOURCE_LINE 00008130 ""
NSQ_SOURCE_LINE 00008131 "=head2 DBI_PUREPERL"
NSQ_SOURCE_LINE 00008132 ""
NSQ_SOURCE_LINE 00008133 "The DBI_PUREPERL environment variable can be used to enable the"
NSQ_SOURCE_LINE 00008134 "use of DBI::PurePerl.  See L<DBI::PurePerl> for more information."
NSQ_SOURCE_LINE 00008135 ""
NSQ_SOURCE_LINE 00008136 "=head1 WARNING AND ERROR MESSAGES"
NSQ_SOURCE_LINE 00008137 ""
NSQ_SOURCE_LINE 00008138 "=head2 Fatal Errors"
NSQ_SOURCE_LINE 00008139 ""
NSQ_SOURCE_LINE 00008140 "=over 4"
NSQ_SOURCE_LINE 00008141 ""
NSQ_SOURCE_LINE 00008142 "=item Can't call method \"prepare\" without a package or object reference"
NSQ_SOURCE_LINE 00008143 ""
NSQ_SOURCE_LINE 00008144 "The C<$dbh> handle you're using to call C<prepare> is probably undefined because"
NSQ_SOURCE_LINE 00008145 "the preceding C<connect> failed. You should always check the return status of"
NSQ_SOURCE_LINE 00008146 "DBI methods, or use the L</RaiseError> attribute."
NSQ_SOURCE_LINE 00008147 ""
NSQ_SOURCE_LINE 00008148 "=item Can't call method \"execute\" without a package or object reference"
NSQ_SOURCE_LINE 00008149 ""
NSQ_SOURCE_LINE 00008150 "The C<$sth> handle you're using to call C<execute> is probably undefined because"
NSQ_SOURCE_LINE 00008151 "the preceding C<prepare> failed. You should always check the return status of"
NSQ_SOURCE_LINE 00008152 "DBI methods, or use the L</RaiseError> attribute."
NSQ_SOURCE_LINE 00008153 ""
NSQ_SOURCE_LINE 00008154 "=item DBI/DBD internal version mismatch"
NSQ_SOURCE_LINE 00008155 ""
NSQ_SOURCE_LINE 00008156 "The DBD driver module was built with a different version of DBI than"
NSQ_SOURCE_LINE 00008157 "the one currently being used.  You should rebuild the DBD module under"
NSQ_SOURCE_LINE 00008158 "the current version of DBI."
NSQ_SOURCE_LINE 00008159 ""
NSQ_SOURCE_LINE 00008160 "(Some rare platforms require \"static linking\". On those platforms, there"
NSQ_SOURCE_LINE 00008161 "may be an old DBI or DBD driver version actually embedded in the Perl"
NSQ_SOURCE_LINE 00008162 "executable being used.)"
NSQ_SOURCE_LINE 00008163 ""
NSQ_SOURCE_LINE 00008164 "=item DBD driver has not implemented the AutoCommit attribute"
NSQ_SOURCE_LINE 00008165 ""
NSQ_SOURCE_LINE 00008166 "The DBD driver implementation is incomplete. Consult the author."
NSQ_SOURCE_LINE 00008167 ""
NSQ_SOURCE_LINE 00008168 "=item Can't [sg]et %s->{%s}: unrecognised attribute"
NSQ_SOURCE_LINE 00008169 ""
NSQ_SOURCE_LINE 00008170 "You attempted to set or get an unknown attribute of a handle.  Make"
NSQ_SOURCE_LINE 00008171 "sure you have spelled the attribute name correctly; case is significant"
NSQ_SOURCE_LINE 00008172 "(e.g., \"Autocommit\" is not the same as \"AutoCommit\")."
NSQ_SOURCE_LINE 00008173 ""
NSQ_SOURCE_LINE 00008174 "=back"
NSQ_SOURCE_LINE 00008175 ""
NSQ_SOURCE_LINE 00008176 "=head1 Pure-Perl DBI"
NSQ_SOURCE_LINE 00008177 ""
NSQ_SOURCE_LINE 00008178 "A pure-perl emulation of the DBI is included in the distribution"
NSQ_SOURCE_LINE 00008179 "for people using pure-perl drivers who, for whatever reason, can't"
NSQ_SOURCE_LINE 00008180 "install the compiled DBI. See L<DBI::PurePerl>."
NSQ_SOURCE_LINE 00008181 ""
NSQ_SOURCE_LINE 00008182 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00008183 ""
NSQ_SOURCE_LINE 00008184 "=head2 Driver and Database Documentation"
NSQ_SOURCE_LINE 00008185 ""
NSQ_SOURCE_LINE 00008186 "Refer to the documentation for the DBD driver that you are using."
NSQ_SOURCE_LINE 00008187 ""
NSQ_SOURCE_LINE 00008188 "Refer to the SQL Language Reference Manual for the database engine that you are using."
NSQ_SOURCE_LINE 00008189 ""
NSQ_SOURCE_LINE 00008190 "=head2 ODBC and SQL/CLI Standards Reference Information"
NSQ_SOURCE_LINE 00008191 ""
NSQ_SOURCE_LINE 00008192 "More detailed information about the semantics of certain DBI methods"
NSQ_SOURCE_LINE 00008193 "that are based on ODBC and SQL/CLI standards is available on-line"
NSQ_SOURCE_LINE 00008194 "via microsoft.com, for ODBC, and www.jtc1sc32.org for the SQL/CLI"
NSQ_SOURCE_LINE 00008195 "standard:"
NSQ_SOURCE_LINE 00008196 ""
NSQ_SOURCE_LINE 00008197 " DBI method        ODBC function     SQL/CLI Working Draft"
NSQ_SOURCE_LINE 00008198 " ----------        -------------     ---------------------"
NSQ_SOURCE_LINE 00008199 " column_info       SQLColumns        Page 124"
NSQ_SOURCE_LINE 00008200 " foreign_key_info  SQLForeignKeys    Page 163"
NSQ_SOURCE_LINE 00008201 " get_info          SQLGetInfo        Page 214"
NSQ_SOURCE_LINE 00008202 " primary_key_info  SQLPrimaryKeys    Page 254"
NSQ_SOURCE_LINE 00008203 " table_info        SQLTables         Page 294"
NSQ_SOURCE_LINE 00008204 " type_info         SQLGetTypeInfo    Page 239"
NSQ_SOURCE_LINE 00008205 " statistics_info   SQLStatistics"
NSQ_SOURCE_LINE 00008206 ""
NSQ_SOURCE_LINE 00008207 "To find documentation on the ODBC function you can use"
NSQ_SOURCE_LINE 00008208 "the MSDN search facility at:"
NSQ_SOURCE_LINE 00008209 ""
NSQ_SOURCE_LINE 00008210 "    http://msdn.microsoft.com/Search"
NSQ_SOURCE_LINE 00008211 ""
NSQ_SOURCE_LINE 00008212 "and search for something like C<\"SQLColumns returns\">."
NSQ_SOURCE_LINE 00008213 ""
NSQ_SOURCE_LINE 00008214 "And for SQL/CLI standard information on SQLColumns you'd read page 124 of"
NSQ_SOURCE_LINE 00008215 "the (very large) SQL/CLI Working Draft available from:"
NSQ_SOURCE_LINE 00008216 ""
NSQ_SOURCE_LINE 00008217 "  http://jtc1sc32.org/doc/N0701-0750/32N0744T.pdf"
NSQ_SOURCE_LINE 00008218 ""
NSQ_SOURCE_LINE 00008219 "=head2 Standards Reference Information"
NSQ_SOURCE_LINE 00008220 ""
NSQ_SOURCE_LINE 00008221 "A hyperlinked, browsable version of the BNF syntax for SQL92 (plus"
NSQ_SOURCE_LINE 00008222 "Oracle 7 SQL and PL/SQL) is available here:"
NSQ_SOURCE_LINE 00008223 ""
NSQ_SOURCE_LINE 00008224 "  http://cui.unige.ch/db-research/Enseignement/analyseinfo/SQL92/BNFindex.html"
NSQ_SOURCE_LINE 00008225 ""
NSQ_SOURCE_LINE 00008226 "You can find more information about SQL standards online by searching for the"
NSQ_SOURCE_LINE 00008227 "appropriate standard names and numbers. For example, searching for"
NSQ_SOURCE_LINE 00008228 "\"ANSI/ISO/IEC International Standard (IS) Database Language SQL - Part 1:"
NSQ_SOURCE_LINE 00008229 "SQL/Framework\" you'll find a copy at:"
NSQ_SOURCE_LINE 00008230 ""
NSQ_SOURCE_LINE 00008231 "  ftp://ftp.iks-jena.de/mitarb/lutz/standards/sql/ansi-iso-9075-1-1999.pdf"
NSQ_SOURCE_LINE 00008232 ""
NSQ_SOURCE_LINE 00008233 "=head2 Books and Articles"
NSQ_SOURCE_LINE 00008234 ""
NSQ_SOURCE_LINE 00008235 "Programming the Perl DBI, by Alligator Descartes and Tim Bunce."
