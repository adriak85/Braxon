NSQ_SOURCE_LINE 00000851 "sub setup_driver {"
NSQ_SOURCE_LINE 00000852 "    my ($class, $driver_class) = @_;"
NSQ_SOURCE_LINE 00000853 "    my $h_type;"
NSQ_SOURCE_LINE 00000854 "    foreach $h_type (qw(dr db st)){"
NSQ_SOURCE_LINE 00000855 "\tmy $h_class = $driver_class.\"::$h_type\";"
NSQ_SOURCE_LINE 00000856 "\tno strict 'refs';"
NSQ_SOURCE_LINE 00000857 "\tpush @{\"${h_class}::ISA\"},     \"DBD::_::$h_type\""
NSQ_SOURCE_LINE 00000858 "\t    unless UNIVERSAL::isa($h_class, \"DBD::_::$h_type\");"
NSQ_SOURCE_LINE 00000859 "\t# The _mem class stuff is (IIRC) a crufty hack for global destruction"
NSQ_SOURCE_LINE 00000860 "\t# timing issues in early versions of perl5 and possibly no longer needed."
NSQ_SOURCE_LINE 00000861 "\tmy $mem_class = \"DBD::_mem::$h_type\";"
NSQ_SOURCE_LINE 00000862 "\tpush @{\"${h_class}_mem::ISA\"}, $mem_class"
NSQ_SOURCE_LINE 00000863 "\t    unless UNIVERSAL::isa(\"${h_class}_mem\", $mem_class)"
NSQ_SOURCE_LINE 00000864 "\t    or $DBI::PurePerl;"
NSQ_SOURCE_LINE 00000865 "    }"
NSQ_SOURCE_LINE 00000866 "}"
