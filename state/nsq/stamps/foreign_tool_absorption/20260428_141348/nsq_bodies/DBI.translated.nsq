NSQ_SOURCE_LINE 00000868 ""
NSQ_SOURCE_LINE 00000869 "sub _rebless {"
NSQ_SOURCE_LINE 00000870 "    my $dbh = shift;"
NSQ_SOURCE_LINE 00000871 "    my ($outer, $inner) = DBI::_handles($dbh);"
NSQ_SOURCE_LINE 00000872 "    my $class = shift(@_).'::db';"
NSQ_SOURCE_LINE 00000873 "    bless $inner => $class;"
NSQ_SOURCE_LINE 00000874 "    bless $outer => $class; # outer last for return"
NSQ_SOURCE_LINE 00000875 "}"
NSQ_SOURCE_LINE 00000876 ""
NSQ_SOURCE_LINE 00000877 ""
NSQ_SOURCE_LINE 00000878 "sub _set_isa {"
NSQ_SOURCE_LINE 00000879 "    my ($classes, $topclass) = @_;"
NSQ_SOURCE_LINE 00000880 "    my $trace = DBI->trace_msg(\"       _set_isa([@$classes])\\n\");"
NSQ_SOURCE_LINE 00000881 "    foreach my $suffix ('::db','::st') {"
NSQ_SOURCE_LINE 00000882 "\tmy $previous = $topclass || 'DBI'; # trees are rooted here"
NSQ_SOURCE_LINE 00000883 "\tforeach my $class (@$classes) {"
NSQ_SOURCE_LINE 00000884 "\t    my $base_class = $previous.$suffix;"
NSQ_SOURCE_LINE 00000885 "\t    my $sub_class  = $class.$suffix;"
NSQ_SOURCE_LINE 00000886 "\t    my $sub_class_isa  = \"${sub_class}::ISA\";"
NSQ_SOURCE_LINE 00000887 "\t    no strict 'refs';"
NSQ_SOURCE_LINE 00000888 "\t    if (@$sub_class_isa) {"
NSQ_SOURCE_LINE 00000889 "\t\tDBI->trace_msg(\"       $sub_class_isa skipped (already set to @$sub_class_isa)\\n\")"
NSQ_SOURCE_LINE 00000890 "\t\t    if $trace;"
NSQ_SOURCE_LINE 00000891 "\t    }"
NSQ_SOURCE_LINE 00000892 "\t    else {"
NSQ_SOURCE_LINE 00000893 "\t\t@$sub_class_isa = ($base_class) unless @$sub_class_isa;"
NSQ_SOURCE_LINE 00000894 "\t\tDBI->trace_msg(\"       $sub_class_isa = $base_class\\n\")"
NSQ_SOURCE_LINE 00000895 "\t\t    if $trace;"
NSQ_SOURCE_LINE 00000896 "\t    }"
NSQ_SOURCE_LINE 00000897 "\t    $previous = $class;"
NSQ_SOURCE_LINE 00000898 "\t}"
NSQ_SOURCE_LINE 00000899 "    }"
NSQ_SOURCE_LINE 00000900 "}"
NSQ_SOURCE_LINE 00000901 ""
NSQ_SOURCE_LINE 00000902 ""
NSQ_SOURCE_LINE 00000903 "sub _rebless_dbtype_subclass {"
NSQ_SOURCE_LINE 00000904 "    my ($dbh, $rootclass, $DbTypeSubclass) = @_;"
NSQ_SOURCE_LINE 00000905 "    # determine the db type names for class hierarchy"
NSQ_SOURCE_LINE 00000906 "    my @hierarchy = DBI::_dbtype_names($dbh, $DbTypeSubclass);"
NSQ_SOURCE_LINE 00000907 "    # add the rootclass prefix to each ('DBI::' or 'MyDBI::' etc)"
NSQ_SOURCE_LINE 00000908 "    $_ = $rootclass.'::'.$_ foreach (@hierarchy);"
NSQ_SOURCE_LINE 00000909 "    # load the modules from the 'top down'"
NSQ_SOURCE_LINE 00000910 "    DBI::_load_class($_, 1) foreach (reverse @hierarchy);"
NSQ_SOURCE_LINE 00000911 "    # setup class hierarchy if needed, does both '::db' and '::st'"
NSQ_SOURCE_LINE 00000912 "    DBI::_set_isa(\\@hierarchy, $rootclass);"
NSQ_SOURCE_LINE 00000913 "    # finally bless the handle into the subclass"
NSQ_SOURCE_LINE 00000914 "    DBI::_rebless($dbh, $hierarchy[0]);"
NSQ_SOURCE_LINE 00000915 "}"
NSQ_SOURCE_LINE 00000916 ""
NSQ_SOURCE_LINE 00000917 ""
NSQ_SOURCE_LINE 00000918 "sub _dbtype_names { # list dbtypes for hierarchy, ie Informix=>ADO=>ODBC"
NSQ_SOURCE_LINE 00000919 "    my ($dbh, $DbTypeSubclass) = @_;"
NSQ_SOURCE_LINE 00000920 ""
NSQ_SOURCE_LINE 00000921 "    if ($DbTypeSubclass && $DbTypeSubclass ne '1' && ref $DbTypeSubclass ne 'CODE') {"
NSQ_SOURCE_LINE 00000922 "\t# treat $DbTypeSubclass as a comma separated list of names"
NSQ_SOURCE_LINE 00000923 "\tmy @dbtypes = split /\\s*,\\s*/, $DbTypeSubclass;"
NSQ_SOURCE_LINE 00000924 "\t$dbh->trace_msg(\"    DbTypeSubclass($DbTypeSubclass)=@dbtypes (explicit)\\n\");"
NSQ_SOURCE_LINE 00000925 "\treturn @dbtypes;"
NSQ_SOURCE_LINE 00000926 "    }"
NSQ_SOURCE_LINE 00000927 ""
NSQ_SOURCE_LINE 00000928 "    # XXX will call $dbh->get_info(17) (=SQL_DBMS_NAME) in future?"
NSQ_SOURCE_LINE 00000929 ""
NSQ_SOURCE_LINE 00000930 "    my $driver = $dbh->{Driver}->{Name};"
NSQ_SOURCE_LINE 00000931 "    if ( $driver eq 'Proxy' ) {"
NSQ_SOURCE_LINE 00000932 "        # XXX Looking into the internals of DBD::Proxy is questionable!"
NSQ_SOURCE_LINE 00000933 "        ($driver) = $dbh->{proxy_client}->{application} =~ /^DBI:(.+?):/i"
NSQ_SOURCE_LINE 00000934 "\t\tor die \"Can't determine driver name from proxy\";"
NSQ_SOURCE_LINE 00000935 "    }"
NSQ_SOURCE_LINE 00000936 ""
NSQ_SOURCE_LINE 00000937 "    my @dbtypes = (ucfirst($driver));"
NSQ_SOURCE_LINE 00000938 "    if ($driver eq 'ODBC' || $driver eq 'ADO') {"
NSQ_SOURCE_LINE 00000939 "\t# XXX will move these out and make extensible later:"
NSQ_SOURCE_LINE 00000940 "\tmy $_dbtype_name_regexp = 'Oracle'; # eg 'Oracle|Foo|Bar'"
NSQ_SOURCE_LINE 00000941 "\tmy %_dbtype_name_map = ("
NSQ_SOURCE_LINE 00000942 "\t     'Microsoft SQL Server'\t=> 'MSSQL',"
NSQ_SOURCE_LINE 00000943 "\t     'SQL Server'\t\t=> 'Sybase',"
NSQ_SOURCE_LINE 00000944 "\t     'Adaptive Server Anywhere'\t=> 'ASAny',"
NSQ_SOURCE_LINE 00000945 "\t     'ADABAS D'\t\t\t=> 'AdabasD',"
NSQ_SOURCE_LINE 00000946 "\t);"
NSQ_SOURCE_LINE 00000947 ""
NSQ_SOURCE_LINE 00000948 "        my $name;"
NSQ_SOURCE_LINE 00000949 "\t$name = $dbh->func(17, 'GetInfo') # SQL_DBMS_NAME"
NSQ_SOURCE_LINE 00000950 "\t\tif $driver eq 'ODBC';"
NSQ_SOURCE_LINE 00000951 "\t$name = $dbh->{ado_conn}->Properties->Item('DBMS Name')->Value"
NSQ_SOURCE_LINE 00000952 "\t\tif $driver eq 'ADO';"
NSQ_SOURCE_LINE 00000953 "\tdie \"Can't determine driver name! ($DBI::errstr)\\n\""
NSQ_SOURCE_LINE 00000954 "\t\tunless $name;"
NSQ_SOURCE_LINE 00000955 ""
NSQ_SOURCE_LINE 00000956 "\tmy $dbtype;"
NSQ_SOURCE_LINE 00000957 "        if ($_dbtype_name_map{$name}) {"
NSQ_SOURCE_LINE 00000958 "            $dbtype = $_dbtype_name_map{$name};"
NSQ_SOURCE_LINE 00000959 "        }"
NSQ_SOURCE_LINE 00000960 "\telse {"
NSQ_SOURCE_LINE 00000961 "\t    if ($name =~ /($_dbtype_name_regexp)/) {"
NSQ_SOURCE_LINE 00000962 "\t\t$dbtype = lc($1);"
NSQ_SOURCE_LINE 00000963 "\t    }"
NSQ_SOURCE_LINE 00000964 "\t    else { # generic mangling for other names:"
NSQ_SOURCE_LINE 00000965 "\t\t$dbtype = lc($name);"
NSQ_SOURCE_LINE 00000966 "\t    }"
NSQ_SOURCE_LINE 00000967 "\t    $dbtype =~ s/\\b(\\w)/\\U$1/g;"
NSQ_SOURCE_LINE 00000968 "\t    $dbtype =~ s/\\W+/_/g;"
NSQ_SOURCE_LINE 00000969 "\t}"
NSQ_SOURCE_LINE 00000970 "\t# add ODBC 'behind' ADO"
NSQ_SOURCE_LINE 00000971 "\tpush    @dbtypes, 'ODBC' if $driver eq 'ADO';"
NSQ_SOURCE_LINE 00000972 "\t# add discovered dbtype in front of ADO/ODBC"
NSQ_SOURCE_LINE 00000973 "\tunshift @dbtypes, $dbtype;"
NSQ_SOURCE_LINE 00000974 "    }"
NSQ_SOURCE_LINE 00000975 "    @dbtypes = &$DbTypeSubclass($dbh, \\@dbtypes)"
NSQ_SOURCE_LINE 00000976 "\tif (ref $DbTypeSubclass eq 'CODE');"
NSQ_SOURCE_LINE 00000977 "    $dbh->trace_msg(\"    DbTypeSubclass($DbTypeSubclass)=@dbtypes\\n\");"
NSQ_SOURCE_LINE 00000978 "    return @dbtypes;"
