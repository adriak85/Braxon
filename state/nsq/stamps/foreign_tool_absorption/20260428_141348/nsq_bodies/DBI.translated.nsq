NSQ_SOURCE_LINE 00000188 "# Make some utility functions available if asked for"
NSQ_SOURCE_LINE 00000189 "@EXPORT    = ();\t\t    # we export nothing by default"
NSQ_SOURCE_LINE 00000190 "@EXPORT_OK = qw(%DBI %DBI_methods hash); # also populated by export_ok_tags:"
NSQ_SOURCE_LINE 00000191 "%EXPORT_TAGS = ("
NSQ_SOURCE_LINE 00000192 "   sql_types => [ qw("
