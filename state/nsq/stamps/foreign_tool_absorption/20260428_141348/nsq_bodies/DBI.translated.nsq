NSQ_SOURCE_LINE 00000511 ");"
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "while ( my ($class, $meths) = each %DBI::DBI_methods ) {"
NSQ_SOURCE_LINE 00000514 "    my $ima_trace = 0+($ENV{DBI_IMA_TRACE}||0);"
NSQ_SOURCE_LINE 00000515 "    while ( my ($method, $info) = each %$meths ) {"
NSQ_SOURCE_LINE 00000516 "\tmy $fullmeth = \"DBI::${class}::$method\";"
NSQ_SOURCE_LINE 00000517 "\tif (($DBI::dbi_debug & 0xF) == 15) { # quick hack to list DBI methods"
NSQ_SOURCE_LINE 00000518 "\t    # and optionally filter by IMA flags"
NSQ_SOURCE_LINE 00000519 "\t    my $O = $info->{O}||0;"
NSQ_SOURCE_LINE 00000520 "\t    printf \"0x%04x %-20s\\n\", $O, $fullmeth"
NSQ_SOURCE_LINE 00000521 "\t        unless $ima_trace && !($O & $ima_trace);"
NSQ_SOURCE_LINE 00000522 "\t}"
NSQ_SOURCE_LINE 00000523 "\tDBI->_install_method($fullmeth, 'DBI.pm', $info);"
NSQ_SOURCE_LINE 00000524 "    }"
NSQ_SOURCE_LINE 00000525 "}"
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 "{"
NSQ_SOURCE_LINE 00000528 "    package DBI::common;"
NSQ_SOURCE_LINE 00000529 "    @DBI::dr::ISA = ('DBI::common');"
NSQ_SOURCE_LINE 00000530 "    @DBI::db::ISA = ('DBI::common');"
NSQ_SOURCE_LINE 00000531 "    @DBI::st::ISA = ('DBI::common');"
NSQ_SOURCE_LINE 00000532 "}"
NSQ_SOURCE_LINE 00000533 ""
NSQ_SOURCE_LINE 00000534 "# End of init code"
NSQ_SOURCE_LINE 00000535 ""
NSQ_SOURCE_LINE 00000536 "END {"
NSQ_SOURCE_LINE 00000537 "    return unless defined &DBI::trace_msg; # return unless bootstrap'd ok"
NSQ_SOURCE_LINE 00000538 "    local ($!,$?);"
NSQ_SOURCE_LINE 00000539 "    DBI->trace_msg(sprintf(\"    -- DBI::END (\\$\\@: %s, \\$!: %s)\\n\", $@||'', $!||''), 2);"
NSQ_SOURCE_LINE 00000540 "    # Let drivers know why we are calling disconnect_all:"
NSQ_SOURCE_LINE 00000541 "    $DBI::PERL_ENDING = $DBI::PERL_ENDING = 1;\t# avoid typo warning"
NSQ_SOURCE_LINE 00000542 "    DBI->disconnect_all() if %DBI::installed_drh;"
NSQ_SOURCE_LINE 00000543 "}"
NSQ_SOURCE_LINE 00000544 ""
NSQ_SOURCE_LINE 00000545 ""
NSQ_SOURCE_LINE 00000546 "sub CLONE {"
NSQ_SOURCE_LINE 00000547 "    _clone_dbis() unless $DBI::PurePerl; # clone the DBIS structure"
NSQ_SOURCE_LINE 00000548 "    DBI->trace_msg(\"CLONE DBI for new thread\\n\");"
NSQ_SOURCE_LINE 00000549 "    while ( my ($driver, $drh) = each %DBI::installed_drh) {"
NSQ_SOURCE_LINE 00000550 "\tno strict 'refs';"
NSQ_SOURCE_LINE 00000551 "\tnext if defined &{\"DBD::${driver}::CLONE\"};"
NSQ_SOURCE_LINE 00000552 "\twarn(\"$driver has no driver CLONE() function so is unsafe threaded\\n\");"
NSQ_SOURCE_LINE 00000553 "    }"
NSQ_SOURCE_LINE 00000554 "    %DBI::installed_drh = ();\t# clear loaded drivers so they have a chance to reinitialize"
NSQ_SOURCE_LINE 00000555 "}"
NSQ_SOURCE_LINE 00000556 ""
NSQ_SOURCE_LINE 00000557 "sub parse_dsn {"
NSQ_SOURCE_LINE 00000558 "    my ($class, $dsn) = @_;"
NSQ_SOURCE_LINE 00000559 "    $dsn =~ s/^(dbi):(\\w*?)(?:\\((.*?)\\))?://i or return;"
NSQ_SOURCE_LINE 00000560 "    my ($scheme, $driver, $attr, $attr_hash) = (lc($1), $2, $3);"
NSQ_SOURCE_LINE 00000561 "    $driver ||= $ENV{DBI_DRIVER} || '';"
NSQ_SOURCE_LINE 00000562 "    $attr_hash = { split /\\s*=>?\\s*|\\s*,\\s*/, $attr, -1 } if $attr;"
NSQ_SOURCE_LINE 00000563 "    return ($scheme, $driver, $attr, $attr_hash, $dsn);"
NSQ_SOURCE_LINE 00000564 "}"
NSQ_SOURCE_LINE 00000565 ""
NSQ_SOURCE_LINE 00000566 "sub visit_handles {"
NSQ_SOURCE_LINE 00000567 "    my ($class, $code, $outer_info) = @_;"
NSQ_SOURCE_LINE 00000568 "    $outer_info = {} if not defined $outer_info;"
NSQ_SOURCE_LINE 00000569 "    my %drh = DBI->installed_drivers;"
NSQ_SOURCE_LINE 00000570 "    for my $h (values %drh) {"
NSQ_SOURCE_LINE 00000571 "\tmy $child_info = $code->($h, $outer_info)"
NSQ_SOURCE_LINE 00000572 "\t    or next;"
NSQ_SOURCE_LINE 00000573 "\t$h->visit_child_handles($code, $child_info);"
NSQ_SOURCE_LINE 00000574 "    }"
NSQ_SOURCE_LINE 00000575 "    return $outer_info;"
NSQ_SOURCE_LINE 00000576 "}"
NSQ_SOURCE_LINE 00000577 ""
NSQ_SOURCE_LINE 00000578 ""
NSQ_SOURCE_LINE 00000579 "# --- The DBI->connect Front Door methods"
NSQ_SOURCE_LINE 00000580 ""
NSQ_SOURCE_LINE 00000581 "sub connect_cached {"
NSQ_SOURCE_LINE 00000582 "    # For library code using connect_cached() with mod_perl"
NSQ_SOURCE_LINE 00000583 "    # we redirect those calls to Apache::DBI::connect() as well"
NSQ_SOURCE_LINE 00000584 "    my ($class, $dsn, $user, $pass, $attr) = @_;"
NSQ_SOURCE_LINE 00000585 "    my $dbi_connect_method = ($DBI::connect_via eq \"Apache::DBI::connect\")"
NSQ_SOURCE_LINE 00000586 "\t    ? 'Apache::DBI::connect' : 'connect_cached';"
NSQ_SOURCE_LINE 00000587 "    $attr = {"
NSQ_SOURCE_LINE 00000588 "        $attr ? %$attr : (), # clone, don't modify callers data"
NSQ_SOURCE_LINE 00000589 "        dbi_connect_method => $dbi_connect_method,"
NSQ_SOURCE_LINE 00000590 "    };"
NSQ_SOURCE_LINE 00000591 "    return $class->connect($dsn, $user, $pass, $attr);"
NSQ_SOURCE_LINE 00000592 "}"
NSQ_SOURCE_LINE 00000593 ""
NSQ_SOURCE_LINE 00000594 "sub connect {"
NSQ_SOURCE_LINE 00000595 "    my $class = shift;"
NSQ_SOURCE_LINE 00000596 "    my ($dsn, $user, $pass, $attr, $old_driver) = my @orig_args = @_;"
NSQ_SOURCE_LINE 00000597 "    my $driver;"
NSQ_SOURCE_LINE 00000598 ""
NSQ_SOURCE_LINE 00000599 "    if ($attr and !ref($attr)) { # switch $old_driver<->$attr if called in old style"
NSQ_SOURCE_LINE 00000600 "\tCarp::carp(\"DBI->connect using 'old-style' syntax is deprecated and will be an error in future versions\");"
NSQ_SOURCE_LINE 00000601 "        ($old_driver, $attr) = ($attr, $old_driver);"
NSQ_SOURCE_LINE 00000602 "    }"
NSQ_SOURCE_LINE 00000603 ""
NSQ_SOURCE_LINE 00000604 "    my $connect_meth = $attr->{dbi_connect_method};"
NSQ_SOURCE_LINE 00000605 "    $connect_meth ||= $DBI::connect_via;\t# fallback to default"
NSQ_SOURCE_LINE 00000606 ""
NSQ_SOURCE_LINE 00000607 "    $dsn ||= $ENV{DBI_DSN} || $ENV{DBI_DBNAME} || '' unless $old_driver;"
NSQ_SOURCE_LINE 00000608 ""
NSQ_SOURCE_LINE 00000609 "    if ($DBI::dbi_debug) {"
NSQ_SOURCE_LINE 00000610 "\tno warnings;"
NSQ_SOURCE_LINE 00000611 "\tpop @_ if $connect_meth ne 'connect';"
NSQ_SOURCE_LINE 00000612 "\tmy @args = @_; $args[2] = '****'; # hide password"
NSQ_SOURCE_LINE 00000613 "\tDBI->trace_msg(\"    -> $class->$connect_meth(\".join(\", \",@args).\")\\n\");"
NSQ_SOURCE_LINE 00000614 "    }"
NSQ_SOURCE_LINE 00000615 "    Carp::croak('Usage: $class->connect([$dsn [,$user [,$passwd [,\\%attr]]]])')"
