NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "=head1 NAME"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "DBI - Database independent interface for Perl"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "  use DBI;"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "  @driver_names = DBI->available_drivers;"
NSQ_SOURCE_LINE 00000033 "  %drivers      = DBI->installed_drivers;"
NSQ_SOURCE_LINE 00000034 "  @data_sources = DBI->data_sources($driver_name, \\%attr);"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "  $dbh = DBI->connect($data_source, $username, $auth, \\%attr);"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "  $rv  = $dbh->do($statement);"
NSQ_SOURCE_LINE 00000039 "  $rv  = $dbh->do($statement, \\%attr);"
NSQ_SOURCE_LINE 00000040 "  $rv  = $dbh->do($statement, \\%attr, @bind_values);"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "  $ary_ref  = $dbh->selectall_arrayref($statement);"
NSQ_SOURCE_LINE 00000043 "  $hash_ref = $dbh->selectall_hashref($statement, $key_field);"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "  $ary_ref  = $dbh->selectcol_arrayref($statement);"
NSQ_SOURCE_LINE 00000046 "  $ary_ref  = $dbh->selectcol_arrayref($statement, \\%attr);"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "  @row_ary  = $dbh->selectrow_array($statement);"
NSQ_SOURCE_LINE 00000049 "  $ary_ref  = $dbh->selectrow_arrayref($statement);"
NSQ_SOURCE_LINE 00000050 "  $hash_ref = $dbh->selectrow_hashref($statement);"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "  $sth = $dbh->prepare($statement);"
NSQ_SOURCE_LINE 00000053 "  $sth = $dbh->prepare_cached($statement);"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "  $rc = $sth->bind_param($p_num, $bind_value);"
NSQ_SOURCE_LINE 00000056 "  $rc = $sth->bind_param($p_num, $bind_value, $bind_type);"
NSQ_SOURCE_LINE 00000057 "  $rc = $sth->bind_param($p_num, $bind_value, \\%attr);"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "  $rv = $sth->execute;"
NSQ_SOURCE_LINE 00000060 "  $rv = $sth->execute(@bind_values);"
NSQ_SOURCE_LINE 00000061 "  $rv = $sth->execute_array(\\%attr, ...);"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "  $rc = $sth->bind_col($col_num, \\$col_variable);"
NSQ_SOURCE_LINE 00000064 "  $rc = $sth->bind_columns(@list_of_refs_to_vars_to_bind);"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "  @row_ary  = $sth->fetchrow_array;"
NSQ_SOURCE_LINE 00000067 "  $ary_ref  = $sth->fetchrow_arrayref;"
NSQ_SOURCE_LINE 00000068 "  $hash_ref = $sth->fetchrow_hashref;"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "  $ary_ref  = $sth->fetchall_arrayref;"
NSQ_SOURCE_LINE 00000071 "  $ary_ref  = $sth->fetchall_arrayref( $slice, $max_rows );"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "  $hash_ref = $sth->fetchall_hashref( $key_field );"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "  $rv  = $sth->rows;"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "  $rc  = $dbh->begin_work;"
NSQ_SOURCE_LINE 00000078 "  $rc  = $dbh->commit;"
NSQ_SOURCE_LINE 00000079 "  $rc  = $dbh->rollback;"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "  $quoted_string = $dbh->quote($string);"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "  $rc  = $h->err;"
NSQ_SOURCE_LINE 00000084 "  $str = $h->errstr;"
NSQ_SOURCE_LINE 00000085 "  $rv  = $h->state;"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "  $rc  = $dbh->disconnect;"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "I<The synopsis above only lists the major methods and parameters.>"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "=head2 GETTING HELP"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "=head3 General"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "Before asking any questions, reread this document, consult the archives and"
NSQ_SOURCE_LINE 00000097 "read the DBI FAQ. The archives are listed at the end of this document and on"
NSQ_SOURCE_LINE 00000098 "the DBI home page L<http://dbi.perl.org/support/>"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "You might also like to read the Advanced DBI Tutorial at"
NSQ_SOURCE_LINE 00000101 "L<http://www.slideshare.net/Tim.Bunce/dbi-advanced-tutorial-2007>"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "To help you make the best use of the dbi-users mailing list,"
NSQ_SOURCE_LINE 00000104 "and any other lists or forums you may use, I recommend that you read"
NSQ_SOURCE_LINE 00000105 "\"Getting Answers\" by Mike Ash: L<http://mikeash.com/getting_answers.html>."
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "=head3 Mailing Lists"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "If you have questions about DBI, or DBD driver modules, you can get"
NSQ_SOURCE_LINE 00000110 "help from the I<dbi-users@perl.org> mailing list. This is the best way to get"
NSQ_SOURCE_LINE 00000111 "help. You don't have to subscribe to the list in order to post, though I'd"
NSQ_SOURCE_LINE 00000112 "recommend it. You can get help on subscribing and using the list by emailing"
NSQ_SOURCE_LINE 00000113 "I<dbi-users-help@perl.org>."
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "Please note that Tim Bunce does not maintain the mailing lists or the"
NSQ_SOURCE_LINE 00000116 "web pages (generous volunteers do that).  So please don't send mail"
NSQ_SOURCE_LINE 00000117 "directly to him; he just doesn't have the time to answer questions"
NSQ_SOURCE_LINE 00000118 "personally. The I<dbi-users> mailing list has lots of experienced"
NSQ_SOURCE_LINE 00000119 "people who should be able to help you if you need it. If you do email"
NSQ_SOURCE_LINE 00000120 "Tim he is very likely to just forward it to the mailing list."
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "=head3 IRC"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "DBI IRC Channel: #dbi on irc.perl.org (L<irc://irc.perl.org/#dbi>)"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "=for html <a href=\"http://chat.mibbit.com/#dbi@irc.perl.org\">(click for instant chatroom login)</a>"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "=head3 Online"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "StackOverflow has a DBI tag L<https://stackoverflow.com/questions/tagged/dbi>"
NSQ_SOURCE_LINE 00000131 "with over 800 questions."
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "The DBI home page at L<https://dbi.perl.org/> might be worth a visit."
NSQ_SOURCE_LINE 00000134 "It includes links to other resources, but I<is rather out-dated>."
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "=head3 Reporting a Bug"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "If you think you've found a bug then please read"
NSQ_SOURCE_LINE 00000139 "\"How to Report Bugs Effectively\" by Simon Tatham:"
NSQ_SOURCE_LINE 00000140 "L<https://www.chiark.greenend.org.uk/~sgtatham/bugs.html>."
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "If you think you've found a memory leak then read L</Memory Leaks>."
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "Your problem is most likely related to the specific DBD driver module you're"
NSQ_SOURCE_LINE 00000145 "using. If that's the case then click on the 'Bugs' link on the L<https://metacpan.org>"
NSQ_SOURCE_LINE 00000146 "page for your driver. Only submit a bug report against the DBI itself if you're"
NSQ_SOURCE_LINE 00000147 "sure that your issue isn't related to the driver you're using."
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "=head2 NOTES"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "This is the DBI specification that corresponds to DBI version 1.647"
NSQ_SOURCE_LINE 00000152 "(see L<DBI::Changes> for details)."
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "The DBI is evolving at a steady pace, so it's good to check that"
NSQ_SOURCE_LINE 00000155 "you have the latest copy."
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "The significant user-visible changes in each release are documented"
NSQ_SOURCE_LINE 00000158 "in the L<DBI::Changes> module so you can read them by executing"
NSQ_SOURCE_LINE 00000159 "C<perldoc DBI::Changes>."
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "Some DBI changes require changes in the drivers, but the drivers"
NSQ_SOURCE_LINE 00000162 "can take some time to catch up. Newer versions of the DBI have"
NSQ_SOURCE_LINE 00000163 "added features that may not yet be supported by the drivers you"
NSQ_SOURCE_LINE 00000164 "use.  Talk to the authors of your drivers if you need a new feature"
NSQ_SOURCE_LINE 00000165 "that is not yet supported."
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "Features added after DBI 1.21 (February 2002) are marked in the"
NSQ_SOURCE_LINE 00000168 "text with the version number of the DBI release they first appeared in."
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "Extensions to the DBI API often use the C<DBIx::*> namespace."
NSQ_SOURCE_LINE 00000171 "See L</Naming Conventions and Name Space>. DBI extension modules"
NSQ_SOURCE_LINE 00000172 "can be found at L<https://metacpan.org/search?q=DBIx>.  And all modules"
NSQ_SOURCE_LINE 00000173 "related to the DBI can be found at L<https://metacpan.org/search?q=DBI>."
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "=cut"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "# The POD text continues at the end of the file."
