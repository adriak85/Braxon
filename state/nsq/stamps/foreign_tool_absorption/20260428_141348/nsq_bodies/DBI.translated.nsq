NSQ_SOURCE_LINE 00001008 "sub available_drivers {"
NSQ_SOURCE_LINE 00001009 "    my($quiet) = @_;"
NSQ_SOURCE_LINE 00001010 "    my(@drivers, $d, $f);"
NSQ_SOURCE_LINE 00001011 "    local(*DBI::DIR, $@);"
NSQ_SOURCE_LINE 00001012 "    my(%seen_dir, %seen_dbd);"
NSQ_SOURCE_LINE 00001013 "    my $haveFileSpec = eval { require File::Spec };"
NSQ_SOURCE_LINE 00001014 "    foreach $d (@INC){"
NSQ_SOURCE_LINE 00001015 "\tchomp($d); # Perl 5 beta 3 bug in #!./perl -Ilib from Test::Harness"
NSQ_SOURCE_LINE 00001016 "\tmy $dbd_dir ="
NSQ_SOURCE_LINE 00001017 "\t    ($haveFileSpec ? File::Spec->catdir($d, 'DBD') : \"$d/DBD\");"
NSQ_SOURCE_LINE 00001018 "\tnext unless -d $dbd_dir;"
NSQ_SOURCE_LINE 00001019 "\tnext if $seen_dir{$d};"
NSQ_SOURCE_LINE 00001020 "\t$seen_dir{$d} = 1;"
NSQ_SOURCE_LINE 00001021 "\t# XXX we have a problem here with case insensitive file systems"
NSQ_SOURCE_LINE 00001022 "\t# XXX since we can't tell what case must be used when loading."
NSQ_SOURCE_LINE 00001023 "\topendir(DBI::DIR, $dbd_dir) || Carp::carp \"opendir $dbd_dir: $!\\n\";"
NSQ_SOURCE_LINE 00001024 "\tforeach $f (readdir(DBI::DIR)){"
NSQ_SOURCE_LINE 00001025 "\t    next unless $f =~ s/\\.pm$//;"
NSQ_SOURCE_LINE 00001026 "\t    next if $f eq 'NullP';"
NSQ_SOURCE_LINE 00001027 "\t    if ($seen_dbd{$f}){"
NSQ_SOURCE_LINE 00001028 "\t\tCarp::carp \"DBD::$f in $d is hidden by DBD::$f in $seen_dbd{$f}\\n\""
NSQ_SOURCE_LINE 00001029 "\t\t    unless $quiet;"
NSQ_SOURCE_LINE 00001030 "            } else {"
NSQ_SOURCE_LINE 00001031 "\t\tpush(@drivers, $f);"
NSQ_SOURCE_LINE 00001032 "\t    }"
NSQ_SOURCE_LINE 00001033 "\t    $seen_dbd{$f} = $d;"
NSQ_SOURCE_LINE 00001034 "\t}"
NSQ_SOURCE_LINE 00001035 "\tclosedir(DBI::DIR);"
NSQ_SOURCE_LINE 00001036 "    }"
NSQ_SOURCE_LINE 00001037 ""
NSQ_SOURCE_LINE 00001038 "    # \"return sort @drivers\" will not DWIM in scalar context."
NSQ_SOURCE_LINE 00001039 "    return wantarray ? sort @drivers : @drivers;"
NSQ_SOURCE_LINE 00001040 "}"
NSQ_SOURCE_LINE 00001041 ""
NSQ_SOURCE_LINE 00001042 "sub installed_versions {"
NSQ_SOURCE_LINE 00001043 "    my ($class, $quiet) = @_;"
NSQ_SOURCE_LINE 00001044 "    my %error;"
NSQ_SOURCE_LINE 00001045 "    my %version;"
NSQ_SOURCE_LINE 00001046 "    for my $driver ($class->available_drivers($quiet)) {"
NSQ_SOURCE_LINE 00001047 "\tnext if $DBI::PurePerl && grep { -d \"$_/auto/DBD/$driver\" } @INC;"
NSQ_SOURCE_LINE 00001048 "\tmy $drh = eval {"
NSQ_SOURCE_LINE 00001049 "\t    local $SIG{__WARN__} = sub {};"
NSQ_SOURCE_LINE 00001050 "\t    $class->install_driver($driver);"
NSQ_SOURCE_LINE 00001051 "\t};"
NSQ_SOURCE_LINE 00001052 "\t($error{\"DBD::$driver\"}=$@),next if $@;"
NSQ_SOURCE_LINE 00001053 "\tno strict 'refs';"
NSQ_SOURCE_LINE 00001054 "\tmy $vers = ${\"DBD::$driver\" . '::VERSION'};"
NSQ_SOURCE_LINE 00001055 "\t$version{\"DBD::$driver\"} = $vers || '?';"
NSQ_SOURCE_LINE 00001056 "    }"
NSQ_SOURCE_LINE 00001057 "    if (wantarray) {"
NSQ_SOURCE_LINE 00001058 "       return map { m/^DBD::(\\w+)/ ? ($1) : () } sort keys %version;"
NSQ_SOURCE_LINE 00001059 "    }"
NSQ_SOURCE_LINE 00001060 "    $version{\"DBI\"}           = $DBI::VERSION;"
NSQ_SOURCE_LINE 00001061 "    $version{\"DBI::PurePerl\"} = $DBI::PurePerl::VERSION if $DBI::PurePerl;"
NSQ_SOURCE_LINE 00001062 "    if (!defined wantarray) {\t# void context"
NSQ_SOURCE_LINE 00001063 "\trequire Config;\t\t# add more detail"
NSQ_SOURCE_LINE 00001064 "\t$version{OS}   = \"$^O\\t($Config::Config{osvers})\";"
NSQ_SOURCE_LINE 00001065 "\t$version{Perl} = \"$]\\t($Config::Config{archname})\";"
NSQ_SOURCE_LINE 00001066 "\t$version{$_}   = (($error{$_} =~ s/ \\(\\@INC.*//s),$error{$_})"
NSQ_SOURCE_LINE 00001067 "\t    for keys %error;"
NSQ_SOURCE_LINE 00001068 "\tprintf \"  %-16s: %s\\n\",$_,$version{$_}"
NSQ_SOURCE_LINE 00001069 "\t    for reverse sort keys %version;"
NSQ_SOURCE_LINE 00001070 "    }"
NSQ_SOURCE_LINE 00001071 "    return \\%version;"
NSQ_SOURCE_LINE 00001072 "}"
NSQ_SOURCE_LINE 00001073 ""
NSQ_SOURCE_LINE 00001074 ""
