NSQ_SOURCE_LINE 00001077 "    my $drh = $class->install_driver($driver);"
NSQ_SOURCE_LINE 00001078 "    my @ds = $drh->data_sources(@other);"
NSQ_SOURCE_LINE 00001079 "    return @ds;"
NSQ_SOURCE_LINE 00001080 "}"
