NSQ_SOURCE_LINE 00000981 "sub _load_class {"
NSQ_SOURCE_LINE 00000982 "    my ($load_class, $missing_ok) = @_;"
NSQ_SOURCE_LINE 00000983 "    DBI->trace_msg(\"    _load_class($load_class, $missing_ok)\\n\", 2);"
NSQ_SOURCE_LINE 00000984 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000985 "    return 1 if @{\"$load_class\\::ISA\"};\t# already loaded/exists"
NSQ_SOURCE_LINE 00000986 "    (my $module = $load_class) =~ s!::!/!g;"
NSQ_SOURCE_LINE 00000987 "    DBI->trace_msg(\"    _load_class require $module\\n\", 2);"
NSQ_SOURCE_LINE 00000988 "    eval { require \"$module.pm\"; };"
NSQ_SOURCE_LINE 00000989 "    return 1 unless $@;"
NSQ_SOURCE_LINE 00000990 "    return 0 if $missing_ok && $@ =~ /^Can't locate \\Q$module.pm\\E/;"
NSQ_SOURCE_LINE 00000991 "    die $@;"
NSQ_SOURCE_LINE 00000992 "}"
