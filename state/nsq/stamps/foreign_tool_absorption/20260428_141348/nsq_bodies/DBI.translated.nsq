NSQ_SOURCE_LINE 00000261 "\tdata_string_diff data_string_desc data_diff sql_type_cast"
NSQ_SOURCE_LINE 00000262 "\tDBIstcf_DISCARD_STRING"
NSQ_SOURCE_LINE 00000263 "\tDBIstcf_STRICT"
NSQ_SOURCE_LINE 00000264 "   ) ],"
NSQ_SOURCE_LINE 00000265 "   profile   => [ qw("
NSQ_SOURCE_LINE 00000266 "\tdbi_profile dbi_profile_merge dbi_profile_merge_nodes dbi_time"
NSQ_SOURCE_LINE 00000267 "   ) ], # notionally \"in\" DBI::Profile and normally imported from there"
NSQ_SOURCE_LINE 00000268 ");"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "$DBI::dbi_debug = 0;          # mixture of bit fields and int sub-fields"
NSQ_SOURCE_LINE 00000271 "$DBI::neat_maxlen = 1000;"
NSQ_SOURCE_LINE 00000272 "$DBI::stderr = 2_000_000_000; # a very round number below 2**31"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "# If you get an error here like \"Can't find loadable object ...\""
NSQ_SOURCE_LINE 00000275 "# then you haven't installed the DBI correctly. Read the README"
NSQ_SOURCE_LINE 00000276 "# then install it again."
NSQ_SOURCE_LINE 00000277 "if ( $ENV{DBI_PUREPERL} ) {"
NSQ_SOURCE_LINE 00000278 "    eval { XSLoader::load('DBI', $XS_VERSION) } if       $ENV{DBI_PUREPERL} == 1;"
NSQ_SOURCE_LINE 00000279 "    require DBI::PurePerl  if $@ or $ENV{DBI_PUREPERL} >= 2;"
NSQ_SOURCE_LINE 00000280 "    $DBI::PurePerl ||= 0; # just to silence \"only used once\" warnings"
NSQ_SOURCE_LINE 00000281 "}"
NSQ_SOURCE_LINE 00000282 "else {"
NSQ_SOURCE_LINE 00000283 "    XSLoader::load( 'DBI', $XS_VERSION);"
NSQ_SOURCE_LINE 00000284 "}"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "$EXPORT_TAGS{preparse_flags} = [ grep { /^DBIpp_\\w\\w_/ } keys %DBI:: ];"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "Exporter::export_ok_tags(keys %EXPORT_TAGS);"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "}"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "# Alias some handle methods to also be DBI class methods"
NSQ_SOURCE_LINE 00000293 "for (qw(trace_msg set_err parse_trace_flag parse_trace_flags)) {"
NSQ_SOURCE_LINE 00000294 "  no strict;"
NSQ_SOURCE_LINE 00000295 "  *$_ = \\&{\"DBD::_::common::$_\"};"
NSQ_SOURCE_LINE 00000296 "}"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "DBI->trace(split /=/, $ENV{DBI_TRACE}, 2) if $ENV{DBI_TRACE};"
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "$DBI::connect_via ||= \"connect\";"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "# check if user wants a persistent database connection ( Apache + mod_perl )"
NSQ_SOURCE_LINE 00000303 "if ($INC{'Apache/DBI.pm'} && $ENV{MOD_PERL}) {"
NSQ_SOURCE_LINE 00000304 "    $DBI::connect_via = \"Apache::DBI::connect\";"
NSQ_SOURCE_LINE 00000305 "    DBI->trace_msg(\"DBI connect via $DBI::connect_via in $INC{'Apache/DBI.pm'}\\n\");"
NSQ_SOURCE_LINE 00000306 "}"
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "%DBI::installed_drh = ();  # maps driver names to installed driver handles"
NSQ_SOURCE_LINE 00000309 "sub installed_drivers { %DBI::installed_drh }"
NSQ_SOURCE_LINE 00000310 "%DBI::installed_methods = (); # XXX undocumented, may change"
NSQ_SOURCE_LINE 00000311 "sub installed_methods { %DBI::installed_methods }"
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "# Setup special DBI dynamic variables. See DBI::var::FETCH for details."
NSQ_SOURCE_LINE 00000314 "# These are dynamically associated with the last handle used."
NSQ_SOURCE_LINE 00000315 "tie $DBI::err,    'DBI::var', '*err';    # special case: referenced via IHA list"
NSQ_SOURCE_LINE 00000316 "tie $DBI::state,  'DBI::var', '\"state';  # special case: referenced via IHA list"
NSQ_SOURCE_LINE 00000317 "tie $DBI::lasth,  'DBI::var', '!lasth';  # special case: return boolean"
NSQ_SOURCE_LINE 00000318 "tie $DBI::errstr, 'DBI::var', '&errstr'; # call &errstr in last used pkg"
NSQ_SOURCE_LINE 00000319 "tie $DBI::rows,   'DBI::var', '&rows';   # call &rows   in last used pkg"
NSQ_SOURCE_LINE 00000320 "sub DBI::var::TIESCALAR{ my $var = $_[1]; bless \\$var, 'DBI::var'; }"
NSQ_SOURCE_LINE 00000321 "sub DBI::var::STORE    { Carp::croak(\"Can't modify \\$DBI::${$_[0]} special variable\") }"
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "# --- Driver Specific Prefix Registry ---"
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "my $dbd_prefix_registry = {"
NSQ_SOURCE_LINE 00000326 "  ad_          => { class => 'DBD::AnyData',        },"
NSQ_SOURCE_LINE 00000327 "  ad2_         => { class => 'DBD::AnyData2',       },"
NSQ_SOURCE_LINE 00000328 "  ado_         => { class => 'DBD::ADO',            },"
NSQ_SOURCE_LINE 00000329 "  amzn_        => { class => 'DBD::Amazon',         },"
NSQ_SOURCE_LINE 00000330 "  best_        => { class => 'DBD::BestWins',       },"
NSQ_SOURCE_LINE 00000331 "  csv_         => { class => 'DBD::CSV',            },"
NSQ_SOURCE_LINE 00000332 "  cubrid_      => { class => 'DBD::cubrid',         },"
NSQ_SOURCE_LINE 00000333 "  db2_         => { class => 'DBD::DB2',            },"
NSQ_SOURCE_LINE 00000334 "  dbi_         => { class => 'DBI',                 },"
NSQ_SOURCE_LINE 00000335 "  dbm_         => { class => 'DBD::DBM',            },"
NSQ_SOURCE_LINE 00000336 "  df_          => { class => 'DBD::DF',             },"
NSQ_SOURCE_LINE 00000337 "  examplep_    => { class => 'DBD::ExampleP',       },"
NSQ_SOURCE_LINE 00000338 "  f_           => { class => 'DBD::File',           },"
NSQ_SOURCE_LINE 00000339 "  file_        => { class => 'DBD::TextFile',       },"
NSQ_SOURCE_LINE 00000340 "  go_          => { class => 'DBD::Gofer',          },"
NSQ_SOURCE_LINE 00000341 "  ib_          => { class => 'DBD::InterBase',      },"
NSQ_SOURCE_LINE 00000342 "  ing_         => { class => 'DBD::Ingres',         },"
NSQ_SOURCE_LINE 00000343 "  ix_          => { class => 'DBD::Informix',       },"
NSQ_SOURCE_LINE 00000344 "  jdbc_        => { class => 'DBD::JDBC',           },"
NSQ_SOURCE_LINE 00000345 "  mariadb_     => { class => 'DBD::MariaDB',        },"
NSQ_SOURCE_LINE 00000346 "  mem_         => { class => 'DBD::Mem',            },"
NSQ_SOURCE_LINE 00000347 "  mo_          => { class => 'DBD::MO',             },"
