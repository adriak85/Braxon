NSQ_SOURCE_LINE 00000010 "package DBI;"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "require 5.008001;"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "use strict;"
NSQ_SOURCE_LINE 00000015 "use warnings;"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "our ($XS_VERSION, $VERSION);"
NSQ_SOURCE_LINE 00000018 "BEGIN {"
NSQ_SOURCE_LINE 00000019 "$VERSION = \"1.647\"; # ==> ALSO update the version in the pod text below!"
NSQ_SOURCE_LINE 00000020 "$XS_VERSION = $VERSION;"
NSQ_SOURCE_LINE 00000021 "$VERSION =~ tr/_//d;"
