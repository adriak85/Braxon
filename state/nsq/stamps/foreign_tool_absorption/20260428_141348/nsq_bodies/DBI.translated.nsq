NSQ_SOURCE_LINE 00000773 "sub install_driver {\t\t# croaks on failure"
NSQ_SOURCE_LINE 00000774 "    my $class = shift;"
NSQ_SOURCE_LINE 00000775 "    my($driver, $attr) = @_;"
NSQ_SOURCE_LINE 00000776 "    my $drh;"
NSQ_SOURCE_LINE 00000777 ""
NSQ_SOURCE_LINE 00000778 "    $driver ||= $ENV{DBI_DRIVER} || '';"
NSQ_SOURCE_LINE 00000779 ""
NSQ_SOURCE_LINE 00000780 "    # allow driver to be specified as a 'dbi:driver:' string"
NSQ_SOURCE_LINE 00000781 "    $driver = $1 if $driver =~ s/^DBI:(.*?)://i;"
NSQ_SOURCE_LINE 00000782 ""
NSQ_SOURCE_LINE 00000783 "    Carp::croak(\"usage: $class->install_driver(\\$driver [, \\%attr])\")"
NSQ_SOURCE_LINE 00000784 "\t\tunless ($driver and @_<=3);"
NSQ_SOURCE_LINE 00000785 ""
NSQ_SOURCE_LINE 00000786 "    # already installed"
NSQ_SOURCE_LINE 00000787 "    return $drh if $drh = $DBI::installed_drh{$driver};"
NSQ_SOURCE_LINE 00000788 ""
NSQ_SOURCE_LINE 00000789 "    $class->trace_msg(\"    -> $class->install_driver($driver\""
NSQ_SOURCE_LINE 00000790 "\t\t\t.\") for $^O perl=$] pid=$$ ruid=$< euid=$>\\n\")"
NSQ_SOURCE_LINE 00000791 "\tif $DBI::dbi_debug & 0xF;"
NSQ_SOURCE_LINE 00000792 ""
NSQ_SOURCE_LINE 00000793 "    # --- load the code"
NSQ_SOURCE_LINE 00000794 "    my $driver_class = \"DBD::$driver\";"
NSQ_SOURCE_LINE 00000795 "    eval qq{package\t\t\t# hide from PAUSE"
NSQ_SOURCE_LINE 00000796 "\t\tDBI::_firesafe;\t\t# just in case"
NSQ_SOURCE_LINE 00000797 "\t    require $driver_class;\t# load the driver"
NSQ_SOURCE_LINE 00000798 "    };"
NSQ_SOURCE_LINE 00000799 "    if ($@) {"
NSQ_SOURCE_LINE 00000800 "\tmy $err = $@;"
NSQ_SOURCE_LINE 00000801 "\tmy $advice = \"\";"
NSQ_SOURCE_LINE 00000802 "\tif ($err =~ /Can't find loadable object/) {"
NSQ_SOURCE_LINE 00000803 "\t    $advice = \"Perhaps DBD::$driver was statically linked into a new perl binary.\""
NSQ_SOURCE_LINE 00000804 "\t\t .\"\\nIn which case you need to use that new perl binary.\""
NSQ_SOURCE_LINE 00000805 "\t\t .\"\\nOr perhaps only the .pm file was installed but not the shared object file.\""
NSQ_SOURCE_LINE 00000806 "\t}"
NSQ_SOURCE_LINE 00000807 "\telsif ($err =~ /Can't locate.*?DBD\\/$driver\\.pm in \\@INC/) {"
NSQ_SOURCE_LINE 00000808 "\t    my @drv = $class->available_drivers(1);"
NSQ_SOURCE_LINE 00000809 "\t    $advice = \"Perhaps the DBD::$driver perl module hasn't been fully installed,\\n\""
NSQ_SOURCE_LINE 00000810 "\t\t     .\"or perhaps the capitalisation of '$driver' isn't right.\\n\""
NSQ_SOURCE_LINE 00000811 "\t\t     .\"Available drivers: \".join(\", \", @drv).\".\";"
NSQ_SOURCE_LINE 00000812 "\t}"
NSQ_SOURCE_LINE 00000813 "\telsif ($err =~ /Can't load .*? for module DBD::/) {"
NSQ_SOURCE_LINE 00000814 "\t    $advice = \"Perhaps a required shared library or dll isn't installed where expected\";"
NSQ_SOURCE_LINE 00000815 "\t}"
NSQ_SOURCE_LINE 00000816 "\telsif ($err =~ /Can't locate .*? in \\@INC/) {"
NSQ_SOURCE_LINE 00000817 "\t    $advice = \"Perhaps a module that DBD::$driver requires hasn't been fully installed\";"
NSQ_SOURCE_LINE 00000818 "\t}"
NSQ_SOURCE_LINE 00000819 "\tCarp::croak(\"install_driver($driver) failed: $err$advice\\n\");"
NSQ_SOURCE_LINE 00000820 "    }"
NSQ_SOURCE_LINE 00000821 "    if ($DBI::dbi_debug & 0xF) {"
NSQ_SOURCE_LINE 00000822 "\tno strict 'refs';"
NSQ_SOURCE_LINE 00000823 "\t(my $driver_file = $driver_class) =~ s/::/\\//g;"
NSQ_SOURCE_LINE 00000824 "\tmy $dbd_ver = ${\"$driver_class\\::VERSION\"} || \"undef\";"
NSQ_SOURCE_LINE 00000825 "\t$class->trace_msg(\"       install_driver: $driver_class version $dbd_ver\""
NSQ_SOURCE_LINE 00000826 "\t\t.\" loaded from $INC{qq($driver_file.pm)}\\n\");"
NSQ_SOURCE_LINE 00000827 "    }"
NSQ_SOURCE_LINE 00000828 ""
NSQ_SOURCE_LINE 00000829 "    # --- do some behind-the-scenes checks and setups on the driver"
NSQ_SOURCE_LINE 00000830 "    $class->setup_driver($driver_class);"
NSQ_SOURCE_LINE 00000831 ""
NSQ_SOURCE_LINE 00000832 "    # --- run the driver function"
NSQ_SOURCE_LINE 00000833 "    $drh = eval { $driver_class->driver($attr || {}) };"
NSQ_SOURCE_LINE 00000834 "    unless ($drh && ref $drh && !$@) {"
