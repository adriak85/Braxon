NSQ_SOURCE_LINE 00000001 "package IO::Pager;"
NSQ_SOURCE_LINE 00000002 "our $VERSION = \"2.10\"; #Untouched since 1.03"
NSQ_SOURCE_LINE 00000003 ""
NSQ_SOURCE_LINE 00000004 "use 5.008; #At least, for decent perlio, and other modernisms"
NSQ_SOURCE_LINE 00000005 "use strict;"
NSQ_SOURCE_LINE 00000006 "use warnings;"
NSQ_SOURCE_LINE 00000007 "use base qw( Tie::Handle );"
NSQ_SOURCE_LINE 00000008 "use Env qw( PAGER );"
NSQ_SOURCE_LINE 00000009 "use File::Spec;"
NSQ_SOURCE_LINE 00000010 "use PerlIO;"
NSQ_SOURCE_LINE 00000011 "use Symbol;"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "use overload '+' => \"PID\", bool=> \"PID\";"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "our $SIGPIPE;"
NSQ_SOURCE_LINE 00000016 "#use Carp; $SIG{__WARN__} = sub{ print STDERR @_, Carp::longmess(),\"\\n\\n\"; };"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "sub find_pager {"
NSQ_SOURCE_LINE 00000019 "  # Return the name (or path) of a pager that IO::Pager can use"
NSQ_SOURCE_LINE 00000020 "  my $io_pager;"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "  #Permit explicit use of pure perl pager"
NSQ_SOURCE_LINE 00000023 "  local $_ = 'IO::Pager::less';"
NSQ_SOURCE_LINE 00000024 "  return $_ if (defined($_[0]) && ($_[0] eq $_)) or"
NSQ_SOURCE_LINE 00000025 "      (defined($PAGER) && ($PAGER eq $_));"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "  # Use File::Which if available (strongly recommended)"
NSQ_SOURCE_LINE 00000028 "  my $which = eval { require File::Which };"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "  # Look for pager in PAGER first"
NSQ_SOURCE_LINE 00000031 "  if ($PAGER) {"
NSQ_SOURCE_LINE 00000032 "    # Strip arguments e.g. 'less --quiet'"
NSQ_SOURCE_LINE 00000033 "    my ($pager, @options) = (split ' ', $PAGER);"
NSQ_SOURCE_LINE 00000034 "    $pager = _check_pagers([$pager], $which);"
NSQ_SOURCE_LINE 00000035 "    $io_pager = join ' ', ($pager, @options) if defined $pager;"
NSQ_SOURCE_LINE 00000036 "  }"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "  # Then search pager amongst usual suspects"
NSQ_SOURCE_LINE 00000039 "  if (not defined $io_pager) {"
NSQ_SOURCE_LINE 00000040 "    my @pagers = ('/etc/alternatives/pager',"
NSQ_SOURCE_LINE 00000041 "\t\t  '/usr/local/bin/less', '/usr/bin/less', '/usr/bin/more');"
NSQ_SOURCE_LINE 00000042 "    $io_pager = _check_pagers(\\@pagers, $which) "
NSQ_SOURCE_LINE 00000043 "  }"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "  # Then check PATH for other pagers"
NSQ_SOURCE_LINE 00000046 "  if ( (not defined $io_pager) && $which ) {"
NSQ_SOURCE_LINE 00000047 "    my @pagers = ('less', 'most', 'w3m', 'lv', 'pg', 'more');"
NSQ_SOURCE_LINE 00000048 "    $io_pager = _check_pagers(\\@pagers, $which );"
NSQ_SOURCE_LINE 00000049 "  }"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "  # If all else fails, default to more (actually IO::Pager::less first)"
NSQ_SOURCE_LINE 00000052 "  $io_pager ||= 'more';"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "  return $io_pager;"
NSQ_SOURCE_LINE 00000055 "}"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "sub _check_pagers {"
NSQ_SOURCE_LINE 00000058 "  my ($pagers, $which) = @_;"
NSQ_SOURCE_LINE 00000059 "  # Return the first pager in the list that is usable. For each given pager, "
NSQ_SOURCE_LINE 00000060 "  # given a pager name, try to finds its full path with File::Which if possible."
NSQ_SOURCE_LINE 00000061 "  # Given a pager path, verify that it exists."
NSQ_SOURCE_LINE 00000062 "  my $io_pager = undef;"
NSQ_SOURCE_LINE 00000063 "  for my $pager (@$pagers) {"
NSQ_SOURCE_LINE 00000064 "    # Get full path"
NSQ_SOURCE_LINE 00000065 "    my $loc;"
NSQ_SOURCE_LINE 00000066 "    if ( $which && (not File::Spec->file_name_is_absolute($pager)) ) {"
NSQ_SOURCE_LINE 00000067 "      $loc = File::Which::which($pager);"
NSQ_SOURCE_LINE 00000068 "    } else {"
NSQ_SOURCE_LINE 00000069 "      $loc = $pager;"
NSQ_SOURCE_LINE 00000070 "    }"
NSQ_SOURCE_LINE 00000071 "    # Test that full path is valid (some platforms don't do -x so we use -e)"
NSQ_SOURCE_LINE 00000072 "    if ( defined($loc) && (-e $loc) ) {"
NSQ_SOURCE_LINE 00000073 "      $io_pager = $loc;"
NSQ_SOURCE_LINE 00000074 "      last;"
NSQ_SOURCE_LINE 00000075 "    }"
NSQ_SOURCE_LINE 00000076 "  }"
NSQ_SOURCE_LINE 00000077 "  return $io_pager;"
NSQ_SOURCE_LINE 00000078 "}"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "#Should have this as first block for clarity, but not with its use of a sub"
NSQ_SOURCE_LINE 00000081 "BEGIN { # Set the $ENV{PAGER} to something reasonable"
NSQ_SOURCE_LINE 00000082 "  our $oldPAGER = $PAGER || '';"
NSQ_SOURCE_LINE 00000083 "  $PAGER = find_pager();"
NSQ_SOURCE_LINE 00000084 "  "
NSQ_SOURCE_LINE 00000085 "  if( ($PAGER =~ 'more' and $oldPAGER ne 'more') or"
NSQ_SOURCE_LINE 00000086 "       $PAGER eq 'IO::Pager::less' ){"
NSQ_SOURCE_LINE 00000087 "    my $io_pager = $PAGER;"
NSQ_SOURCE_LINE 00000088 "    eval \"use IO::Pager::less\";"
NSQ_SOURCE_LINE 00000089 "    $PAGER = $io_pager if $@ or not defined $PAGER;"
NSQ_SOURCE_LINE 00000090 "  }"
NSQ_SOURCE_LINE 00000091 "}"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "#Factory"
NSQ_SOURCE_LINE 00000095 "sub open(*;$@) { # FH, [MODE], [CLASS]"
NSQ_SOURCE_LINE 00000096 "  my $args = {procedural=>1};"
NSQ_SOURCE_LINE 00000097 "  $args->{mode} = splice(@_, 1, 1) if scalar(@_) == 3;"
NSQ_SOURCE_LINE 00000098 "  $args->{subclass} = pop if scalar(@_) == 2;"
NSQ_SOURCE_LINE 00000099 "  &new(undef, @_, $args);"
NSQ_SOURCE_LINE 00000100 "}"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "#Alternate entrance: drop class but leave FH, subclass"
NSQ_SOURCE_LINE 00000103 "sub new(*;$@) { # FH, [MODE], [CLASS]"
NSQ_SOURCE_LINE 00000104 "  shift;"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "  my %args;"
NSQ_SOURCE_LINE 00000107 "  if( ref($_[-1]) eq 'HASH' ){"
NSQ_SOURCE_LINE 00000108 "    %args = %{pop()};"
NSQ_SOURCE_LINE 00000109 "    #warn \"REMAINDER? (@_)\", scalar @_;"
NSQ_SOURCE_LINE 00000110 "    push(@_, $args{procedural});"
NSQ_SOURCE_LINE 00000111 "  }"
NSQ_SOURCE_LINE 00000112 "  elsif( defined($_[1]) ){"
NSQ_SOURCE_LINE 00000113 "    $args{mode} = splice(@_, 1, 1) if $_[1] =~ /^:/;"
NSQ_SOURCE_LINE 00000114 "    $args{subclass} = pop if exists($_[1]);"
NSQ_SOURCE_LINE 00000115 "  }"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "  #Leave filehandle in @_ for pass by reference to allow gensym"
NSQ_SOURCE_LINE 00000118 "  $args{subclass} ||= 'IO::Pager::Unbuffered';"
NSQ_SOURCE_LINE 00000119 "  $args{subclass} =~ s/^(?!IO::Pager::)/IO::Pager::/;"
NSQ_SOURCE_LINE 00000120 "  eval \"require $args{subclass}\" or die \"Could not load $args{subclass}: $@\\n\";"
NSQ_SOURCE_LINE 00000121 "  my $token = $args{subclass}->new(@_);"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "  if( defined($args{mode}) ){"
NSQ_SOURCE_LINE 00000124 "    $args{mode} =~ s/^\\|-//;"
NSQ_SOURCE_LINE 00000125 "    $token->BINMODE($args{mode});"
NSQ_SOURCE_LINE 00000126 "  }"
NSQ_SOURCE_LINE 00000127 "  return $token;"
NSQ_SOURCE_LINE 00000128 "}"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "sub _init{ # CLASS, [FH] ## Note reversal of order due to CLASS from new()"
NSQ_SOURCE_LINE 00000132 "  #Assign by reference if empty scalar given as filehandle"
NSQ_SOURCE_LINE 00000133 "  $_[1] = gensym() if !defined($_[1]);"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "  no strict 'refs';"
NSQ_SOURCE_LINE 00000136 "  $_[1] ||= *{select()};"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "  # Are we on a TTY? STDOUT & STDERR are separately bound"
NSQ_SOURCE_LINE 00000139 "  if ( defined( my $FHn = fileno($_[1]) ) ) {"
NSQ_SOURCE_LINE 00000140 "    if ( $FHn == fileno(STDOUT) ) {"
NSQ_SOURCE_LINE 00000141 "      die '!TTY' unless -t $_[1];"
NSQ_SOURCE_LINE 00000142 "    }"
NSQ_SOURCE_LINE 00000143 "    if ( $FHn == fileno(STDERR) ) {"
NSQ_SOURCE_LINE 00000144 "      die '!TTY' unless -t $_[1];"
NSQ_SOURCE_LINE 00000145 "    }"
NSQ_SOURCE_LINE 00000146 "  }"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "  #XXX This allows us to have multiple pseudo-STDOUT"
NSQ_SOURCE_LINE 00000149 "  #return 0 unless -t STDOUT;"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "  return ($_[0], $_[1]);"
NSQ_SOURCE_LINE 00000152 "}"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "# Methods required for implementing a tied filehandle class"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "sub TIEHANDLE {"
NSQ_SOURCE_LINE 00000158 "  my ($class, $tied_fh) = @_;"
NSQ_SOURCE_LINE 00000159 "  unless ( $PAGER ){"
NSQ_SOURCE_LINE 00000160 "    die \"The PAGER environment variable is not defined, you may need to set it manually.\";"
NSQ_SOURCE_LINE 00000161 "  }"
NSQ_SOURCE_LINE 00000162 "  my($real_fh, $child, $dupe_fh);"
NSQ_SOURCE_LINE 00000163 "# XXX What about localized GLOBs?!"
NSQ_SOURCE_LINE 00000164 "#  if( $tied_fh =~ /\\*(?:\\w+::)?STD(?:OUT|ERR)$/ ){"
NSQ_SOURCE_LINE 00000165 "#      open($dupe_fh, '>&', $tied_fh) or warn \"Unable to dupe $tied_fh\";"
NSQ_SOURCE_LINE 00000166 "#  }"
NSQ_SOURCE_LINE 00000167 "  do{ no warnings; $child = CORE::open($real_fh, '|-', $PAGER) };"
NSQ_SOURCE_LINE 00000168 "  if ( $child ){"
NSQ_SOURCE_LINE 00000169 "    my @oLayers = PerlIO::get_layers($tied_fh, details=>1, output=>1);"
NSQ_SOURCE_LINE 00000170 "    my $layers = '';"
NSQ_SOURCE_LINE 00000171 "    for(my $i=0;$i<$#oLayers;$i+=3){"
NSQ_SOURCE_LINE 00000172 "      #An extra base layer requires more keystrokes to exit"
NSQ_SOURCE_LINE 00000173 "      next if $oLayers[$i] =~ /unix|stdio/ && !defined($oLayers[+1]);"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "      $layers .= \":$oLayers[$i]\";"
NSQ_SOURCE_LINE 00000176 "      $layers .=  '(' . ($oLayers[$i+1]) . ')' if defined($oLayers[$i+1]);"
NSQ_SOURCE_LINE 00000177 "    }"
NSQ_SOURCE_LINE 00000178 "    CORE::binmode($real_fh, $layers);"
NSQ_SOURCE_LINE 00000179 "  }"
NSQ_SOURCE_LINE 00000180 "  else{"
NSQ_SOURCE_LINE 00000181 "    die \"Could not pipe to PAGER ('$PAGER'): $!\\n\";"
NSQ_SOURCE_LINE 00000182 "  }"
NSQ_SOURCE_LINE 00000183 "  return bless {"
NSQ_SOURCE_LINE 00000184 "                'real_fh' => $real_fh,"
NSQ_SOURCE_LINE 00000185 "#\t\t'dupe_fh' => $dupe_fh,"
NSQ_SOURCE_LINE 00000186 "\t\t'tied_fh' => \"$tied_fh\", #Avoid self-reference leak"
NSQ_SOURCE_LINE 00000187 "                'child'   => $child,"
NSQ_SOURCE_LINE 00000188 "\t\t'pager'   => $PAGER,"
NSQ_SOURCE_LINE 00000189 "               }, $class;"
NSQ_SOURCE_LINE 00000190 "}"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "sub BINMODE {"
NSQ_SOURCE_LINE 00000194 "  my ($self, $layer) = @_;"
NSQ_SOURCE_LINE 00000195 "  if( $layer =~ /^:LOG\\((>{0,2})(.*)\\)$/ ){"
NSQ_SOURCE_LINE 00000196 "    CORE::open($self->{LOG}, $1||'>', $2||\"$$.log\") or die $!;"
NSQ_SOURCE_LINE 00000197 "  }"
NSQ_SOURCE_LINE 00000198 "  else{"
NSQ_SOURCE_LINE 00000199 "    CORE::binmode($self->{real_fh}, $layer||':raw');"
NSQ_SOURCE_LINE 00000200 "  }"
NSQ_SOURCE_LINE 00000201 "}"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "sub WNOHANG();"
NSQ_SOURCE_LINE 00000204 "sub EOF {"
NSQ_SOURCE_LINE 00000205 "  my $self = shift;"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "  unless( defined($SIGPIPE) ){"
NSQ_SOURCE_LINE 00000208 "    eval 'use POSIX \":sys_wait_h\";';"
NSQ_SOURCE_LINE 00000209 "    $SIGPIPE = 0;"
NSQ_SOURCE_LINE 00000210 "  }"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "  $SIG{PIPE} = sub { $SIGPIPE = 1 unless $ENV{IP_EOF};"
NSQ_SOURCE_LINE 00000213 "\t\t     CORE::close($self->{real_fh});"
NSQ_SOURCE_LINE 00000214 "\t\t     waitpid($self->{child}, WNOHANG);"
NSQ_SOURCE_LINE 00000215 "\t\t     CORE::open($self->{real_fh}, '>&1');"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "\t\t     close($self->{LOG});"
NSQ_SOURCE_LINE 00000218 "\t\t   };"
NSQ_SOURCE_LINE 00000219 "  return $SIGPIPE;"
NSQ_SOURCE_LINE 00000220 "}"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "sub PRINT {"
NSQ_SOURCE_LINE 00000224 "  my ($self, @args) = @_;"
NSQ_SOURCE_LINE 00000225 "  CORE::print {$self->{LOG}} @args if exists($self->{LOG});"
NSQ_SOURCE_LINE 00000226 "  CORE::print {$self->{real_fh}} @args or die \"Could not print to PAGER: $!\\n\";"
NSQ_SOURCE_LINE 00000227 "}"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "sub PRINTF {"
NSQ_SOURCE_LINE 00000230 "  my ($self, $format, @args) = @_;"
NSQ_SOURCE_LINE 00000231 "  $self->PRINT(sprintf($format, @args));"
NSQ_SOURCE_LINE 00000232 "}"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "sub say {"
NSQ_SOURCE_LINE 00000236 "  my ($self, @args) = @_;"
NSQ_SOURCE_LINE 00000237 "  $args[-1] .= \"\\n\";"
NSQ_SOURCE_LINE 00000238 "  $self->PRINT(@args);"
NSQ_SOURCE_LINE 00000239 "}"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "sub WRITE {"
NSQ_SOURCE_LINE 00000242 "  my ($self, $scalar, $length, $offset) = @_;"
NSQ_SOURCE_LINE 00000243 "  $self->PRINT(substr($scalar, $offset||0, $length));"
NSQ_SOURCE_LINE 00000244 "}"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "sub TELL {"
NSQ_SOURCE_LINE 00000248 "  #Buffered classes provide their own, and others may use this in another way"
NSQ_SOURCE_LINE 00000249 "  return undef;"
NSQ_SOURCE_LINE 00000250 "}"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "sub FILENO {"
NSQ_SOURCE_LINE 00000254 "  CORE::fileno($_[0]->{real_fh});"
NSQ_SOURCE_LINE 00000255 "}"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "sub CLOSE {"
NSQ_SOURCE_LINE 00000258 "  my ($self) = @_;"
NSQ_SOURCE_LINE 00000259 "  CORE::close($self->{real_fh});"
NSQ_SOURCE_LINE 00000260 "#  untie($self->{tied_fh});"
NSQ_SOURCE_LINE 00000261 "#  *{$self->{tied_fh}} = *{$self->{dupe_fh}};"
NSQ_SOURCE_LINE 00000262 "}"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "{ no warnings 'once'; *DESTROY = \\&CLOSE; }"
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "#Non-IO methods"
NSQ_SOURCE_LINE 00000268 "sub PID{"
NSQ_SOURCE_LINE 00000269 "  my ($self) = @_;"
NSQ_SOURCE_LINE 00000270 "  return $self->{child};"
NSQ_SOURCE_LINE 00000271 "}"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "#Provide lowercase aliases for accessors"
NSQ_SOURCE_LINE 00000275 "foreach my $method ( qw(BINMODE CLOSE EOF PRINT PRINTF TELL WRITE PID) ){"
NSQ_SOURCE_LINE 00000276 "  no strict 'refs';"
NSQ_SOURCE_LINE 00000277 "  *{lc($method)} = \\&{$method};"
NSQ_SOURCE_LINE 00000278 "}"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "1;"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "__END__"
NSQ_SOURCE_LINE 00000284 "=pod"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "=head1 NAME"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "IO::Pager - Select a pager (possibly perl-based) & pipe it text if a TTY"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "  # Select an appropriate pager and set the PAGER environment variable"
NSQ_SOURCE_LINE 00000293 "  use IO::Pager;"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "  # TIMTOWTDI Object-oriented"
NSQ_SOURCE_LINE 00000296 "  {"
NSQ_SOURCE_LINE 00000297 "    # open()                           # Use all the defaults."
NSQ_SOURCE_LINE 00000298 "    my $object = new IO::Pager;"
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "    # open FILEHANDLE                  # Unbuffered is default subclass"
NSQ_SOURCE_LINE 00000301 "    my $object = new IO::Pager *STDOUT;"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "    # open FILEHANDLE,EXPR             # Specify subclass"
NSQ_SOURCE_LINE 00000304 "    my $object = new IO::Pager *STDOUT,  'Unbuffered';"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "    # Direct subclass instantiation    # FH is optional"
NSQ_SOURCE_LINE 00000307 "    use IO::Pager::Unbuffered;"
NSQ_SOURCE_LINE 00000308 "    my $object = new IO::Pager::Unbuffered  *STDOUT;"
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "    $object->print(\"OO shiny...\\n\") while 1;"
NSQ_SOURCE_LINE 00000312 "    print \"Some other text sent to STODUT, perhaps from a foreign routine.\""
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "    # $object passes out of scope and filehandle is automagically closed"
NSQ_SOURCE_LINE 00000315 "  }"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "  # TIMTOWTDI Procedural"
NSQ_SOURCE_LINE 00000318 "  {"
NSQ_SOURCE_LINE 00000319 "    # open FILEHANDLE                    # Unbuffered is default subclass"
NSQ_SOURCE_LINE 00000320 "    my $token = IO::Pager::open *STDOUT;"
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "    # open FILEHANDLE,EXPR               # Specify subclass"
NSQ_SOURCE_LINE 00000323 "    my $token = IO::Pager::open *STDOUT,  'Unbuffered';"
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "    # open FILEHANDLE,MODE,EXPR          # En lieu of a separate binmode()"
NSQ_SOURCE_LINE 00000326 "    my $token = IO::Pager::open *STDOUT, '|-:utf8', 'Unbuffered';"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "    print <<\"  HEREDOC\" ;"
NSQ_SOURCE_LINE 00000330 "    ..."
NSQ_SOURCE_LINE 00000331 "    A bunch of text later"
NSQ_SOURCE_LINE 00000332 "    HEREDOC"
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "    # $token passes out of scope and filehandle is automagically closed"
NSQ_SOURCE_LINE 00000335 "  }"
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "  {"
NSQ_SOURCE_LINE 00000338 "    # You can also use scalar filehandles..."
NSQ_SOURCE_LINE 00000339 "    my $token = IO::Pager::open(my $FH) or warn($!); XXX"
NSQ_SOURCE_LINE 00000340 "    print $FH \"No globs or barewords for us thanks!\\n\" while 1;"
NSQ_SOURCE_LINE 00000341 "  }"
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "IO::Pager can be used to locate an available pager and set the I<PAGER>"
NSQ_SOURCE_LINE 00000347 "environment variable (see L</NOTES>). It is also a factory for creating"
NSQ_SOURCE_LINE 00000348 "I/O objects such as L<IO::Pager::Buffered> and L<IO::Pager::Unbuffered>."
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "IO::Pager subclasses are designed to programmatically decide whether"
NSQ_SOURCE_LINE 00000351 "or not to pipe a filehandle's output to a program specified in I<PAGER>."
NSQ_SOURCE_LINE 00000352 "Subclasses may implement only the IO handle methods desired and inherit"
NSQ_SOURCE_LINE 00000353 "the remainder of those outlined below from IO::Pager. For anything else,"
NSQ_SOURCE_LINE 00000354 "YMMV. See the appropriate subclass for implementation specific details."
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "=head1 METHODS"
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 "=head2 new( FILEHANDLE, [MODE], [SUBCLASS] )"
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 "Almost identical to open, except that you will get an L<IO::Handle>"
NSQ_SOURCE_LINE 00000361 "back if there's no TTY to allow for IO::Pager-agnostic programming."
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "=head2 open( FILEHANDLE, [MODE], [SUBCLASS] )"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "Instantiate a new IO::Pager, which will paginate output sent to"
NSQ_SOURCE_LINE 00000366 "FILEHANDLE if interacting with a TTY."
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 "Save the return value to check for errors, use as an object,"
NSQ_SOURCE_LINE 00000369 "or for implict close of OO handles when the variable passes out of scope."
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "=over"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "=item FILEHANDLE"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "You may provide a glob or scalar."
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "Defaults to currently select()-ed F<FILEHANDLE>."
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "=item SUBCLASS"
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "Specifies which variety of IO::Pager to create."
NSQ_SOURCE_LINE 00000382 "This accepts fully qualified packages I<IO::Pager::Buffered>,"
NSQ_SOURCE_LINE 00000383 "or simply the third portion of the package name I<Buffered> for brevity."
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "Defaults to L<IO::Pager::Unbuffered>."
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "Returns false and sets I<$!> on failure, same as perl's C<open>."
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "=back"
NSQ_SOURCE_LINE 00000390 ""
NSQ_SOURCE_LINE 00000391 "=head2 PID"
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "Call this method on the token returned by C<open> to get the process"
NSQ_SOURCE_LINE 00000394 "identifier for the child process i.e; pager; if you need to perform"
NSQ_SOURCE_LINE 00000395 "some long term process management e.g; perl's C<waitpid>"
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "You can also access the PID by numifying the instantiation token like so:"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "  my $child = $token+0;"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "=head2 close( FILEHANDLE )"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "Explicitly close the filehandle, this stops any redirection of output"
NSQ_SOURCE_LINE 00000404 "on FILEHANDLE that may have been warranted."
NSQ_SOURCE_LINE 00000405 ""
NSQ_SOURCE_LINE 00000406 "I<This does not default to the current filehandle>."
NSQ_SOURCE_LINE 00000407 ""
NSQ_SOURCE_LINE 00000408 "Alternatively, you may rely upon the implicit close of lexical handles"
NSQ_SOURCE_LINE 00000409 "as they pass out of scope e.g;"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "  {"
NSQ_SOURCE_LINE 00000412 "     IO::Pager::open local *RIBBIT;"
NSQ_SOURCE_LINE 00000413 "     print RIBBIT \"No toad sexing allowed\";"
NSQ_SOURCE_LINE 00000414 "     ..."
NSQ_SOURCE_LINE 00000415 "  }"
NSQ_SOURCE_LINE 00000416 "  #The filehandle is closed to additional output"
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 "  {"
NSQ_SOURCE_LINE 00000419 "     my $token = new IO::Pager::Buffered;"
NSQ_SOURCE_LINE 00000420 "     $token->print(\"I like trains\");"
NSQ_SOURCE_LINE 00000421 "     ..."
NSQ_SOURCE_LINE 00000422 "  }"
NSQ_SOURCE_LINE 00000423 "  #The string \"I like trains\" is flushed to the pager, and the handle closed"
NSQ_SOURCE_LINE 00000424 ""
NSQ_SOURCE_LINE 00000425 "=head2 binmode( FILEHANDLE, [LAYER] )"
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 "Used to set the I/O layer a.k.a. discipline of a filehandle,"
NSQ_SOURCE_LINE 00000428 "such as C<':utf8'> for UTF-8 encoding."
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "=head3 :LOG([>>FILE])"
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 "IO::Pager implements a pseudo-IO-layer for capturing output and sending it"
NSQ_SOURCE_LINE 00000433 "to a file, similar to L<tee(1)>. Although it is limited to one file, this"
NSQ_SOURCE_LINE 00000434 "feature is pure-perl and adds no dependencies."
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 "You may indicate what file to store in parentheses, otherwise the default is"
NSQ_SOURCE_LINE 00000437 "C<$$.log>. You may also use an implicit (no indicator) or explicit (I<E<gt>>)"
NSQ_SOURCE_LINE 00000438 "indicator to overwrite an existing file, or an explicit (I<E<gt>E<gt>>) for"
NSQ_SOURCE_LINE 00000439 "appending to a log file. For example:"
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "    binmode(*STDOUT, ':LOG(clobber.log)');"
NSQ_SOURCE_LINE 00000442 "    ..."
NSQ_SOURCE_LINE 00000443 "    $STDOUT->binmode(':LOG(>>noclobber.log)');"
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "For full tee-style support, use L<PerlIO::Util> like so:"
NSQ_SOURCE_LINE 00000446 ""
NSQ_SOURCE_LINE 00000447 "    binmode(*STDOUT, \":tee(TH)\");"
NSQ_SOURCE_LINE 00000448 "    #OR"
NSQ_SOURCE_LINE 00000449 "    $STDOUT->binmode(':tee(TH)');"
NSQ_SOURCE_LINE 00000450 ""
NSQ_SOURCE_LINE 00000451 "=head2 eof( FILEHANDLE )"
NSQ_SOURCE_LINE 00000452 ""
NSQ_SOURCE_LINE 00000453 "Used in the eval-until-eof idiom below, I<IO::Pager> will handle broken pipes"
NSQ_SOURCE_LINE 00000454 "from deceased children for you in one of two ways. If I<$ENV{IP_EOF}> is"
NSQ_SOURCE_LINE 00000455 "false then program flow will pass out of the loop on I<SIGPIPE>, this is the"
NSQ_SOURCE_LINE 00000456 "default. If the variable is true, then the program continues running with"
NSQ_SOURCE_LINE 00000457 "output for the previously paged filehandle directed to the I<STDOUT> stream;"
NSQ_SOURCE_LINE 00000458 "more accurately, the filehandle is reopened to file descriptor 1."
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "  use IO::Pager::Page; #or whichever you prefer;"
NSQ_SOURCE_LINE 00000461 "  ..."
NSQ_SOURCE_LINE 00000462 "  eval{"
NSQ_SOURCE_LINE 00000463 "    say \"Producing prodigious portions of product\";"
NSQ_SOURCE_LINE 00000464 "    ..."
NSQ_SOURCE_LINE 00000465 "  } until( eof(*STDOUT) );"
NSQ_SOURCE_LINE 00000466 "  print \"Cleaning up after our child before terminating.\""
NSQ_SOURCE_LINE 00000467 ""
NSQ_SOURCE_LINE 00000468 "If using eof() with L<less>, especially when IP_EOF is set, you may want to"
NSQ_SOURCE_LINE 00000469 "use the I<--no-init> option by setting I<$ENV{IP_EOF}='X'> to prevent the"
NSQ_SOURCE_LINE 00000470 "paged output from being erased when the pager exits."
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "=head2 fileno( FILEHANDLE )"
NSQ_SOURCE_LINE 00000473 ""
NSQ_SOURCE_LINE 00000474 "Return the filehandle number of the write-only pipe to the pager."
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 "=head2 print( FILEHANDLE LIST )"
NSQ_SOURCE_LINE 00000477 ""
NSQ_SOURCE_LINE 00000478 "print() to the filehandle."
NSQ_SOURCE_LINE 00000479 ""
NSQ_SOURCE_LINE 00000480 "=head2 printf( FILEHANDLE FORMAT, LIST )"
NSQ_SOURCE_LINE 00000481 ""
NSQ_SOURCE_LINE 00000482 "printf() to the filehandle."
NSQ_SOURCE_LINE 00000483 ""
NSQ_SOURCE_LINE 00000484 "=head2 syswrite( FILEHANDLE, SCALAR, [LENGTH], [OFFSET] )"
NSQ_SOURCE_LINE 00000485 ""
NSQ_SOURCE_LINE 00000486 "syswrite() to the filehandle."
NSQ_SOURCE_LINE 00000487 ""
NSQ_SOURCE_LINE 00000488 "=head1 ENVIRONMENT"
NSQ_SOURCE_LINE 00000489 ""
NSQ_SOURCE_LINE 00000490 "=over"
NSQ_SOURCE_LINE 00000491 ""
NSQ_SOURCE_LINE 00000492 "=item IP_EOF"
NSQ_SOURCE_LINE 00000493 ""
NSQ_SOURCE_LINE 00000494 "Controls IO:Pager behavior when C<eof> is used."
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "=item PAGER"
NSQ_SOURCE_LINE 00000497 ""
NSQ_SOURCE_LINE 00000498 "The location of the default pager."
NSQ_SOURCE_LINE 00000499 ""
NSQ_SOURCE_LINE 00000500 "=item PATH"
NSQ_SOURCE_LINE 00000501 ""
NSQ_SOURCE_LINE 00000502 "If the location in PAGER is not absolute, PATH may be searched."
NSQ_SOURCE_LINE 00000503 ""
NSQ_SOURCE_LINE 00000504 "See L</NOTES> for more information."
NSQ_SOURCE_LINE 00000505 ""
NSQ_SOURCE_LINE 00000506 "=back"
NSQ_SOURCE_LINE 00000507 ""
NSQ_SOURCE_LINE 00000508 "=head1 FILES"
NSQ_SOURCE_LINE 00000509 ""
NSQ_SOURCE_LINE 00000510 "IO::Pager may fall back to these binaries in order if I<PAGER> is not"
NSQ_SOURCE_LINE 00000511 "executable."
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "=over"
NSQ_SOURCE_LINE 00000514 ""
NSQ_SOURCE_LINE 00000515 "=item /etc/alternatives/pager"
NSQ_SOURCE_LINE 00000516 ""
NSQ_SOURCE_LINE 00000517 "=item /usr/local/bin/less"
NSQ_SOURCE_LINE 00000518 ""
NSQ_SOURCE_LINE 00000519 "=item /usr/bin/less"
NSQ_SOURCE_LINE 00000520 ""
NSQ_SOURCE_LINE 00000521 "=item L<IO::Pager::Perl> as C<tp> via L<IO::Pager::less>"
NSQ_SOURCE_LINE 00000522 ""
NSQ_SOURCE_LINE 00000523 "=item /usr/bin/more"
NSQ_SOURCE_LINE 00000524 ""
NSQ_SOURCE_LINE 00000525 "=back"
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 "See L</NOTES> for more information."
NSQ_SOURCE_LINE 00000528 ""
NSQ_SOURCE_LINE 00000529 "=head1 NOTES"
NSQ_SOURCE_LINE 00000530 ""
NSQ_SOURCE_LINE 00000531 "The algorithm for determining which pager to use is as follows:"
NSQ_SOURCE_LINE 00000532 ""
NSQ_SOURCE_LINE 00000533 "=over"
NSQ_SOURCE_LINE 00000534 ""
NSQ_SOURCE_LINE 00000535 "=item 1. Defer to I<PAGER>"
NSQ_SOURCE_LINE 00000536 ""
NSQ_SOURCE_LINE 00000537 "If the I<PAGER> environment variable is set, use the pager it identifies,"
NSQ_SOURCE_LINE 00000538 "unless this pager is not available."
NSQ_SOURCE_LINE 00000539 ""
NSQ_SOURCE_LINE 00000540 "=item 2. Usual suspects"
NSQ_SOURCE_LINE 00000541 ""
NSQ_SOURCE_LINE 00000542 "Try the standard, hardcoded paths in L</FILES>."
NSQ_SOURCE_LINE 00000543 ""
NSQ_SOURCE_LINE 00000544 "=item 3. File::Which"
NSQ_SOURCE_LINE 00000545 ""
NSQ_SOURCE_LINE 00000546 "If File::Which is available, use the first pager possible amongst"
NSQ_SOURCE_LINE 00000547 "C<less>, C<most>, C<w3m>, C<lv>, C<pg> and L<more>."
NSQ_SOURCE_LINE 00000548 ""
NSQ_SOURCE_LINE 00000549 "=item 4. Term::Pager via IO::Pager::Perl"
NSQ_SOURCE_LINE 00000550 ""
NSQ_SOURCE_LINE 00000551 "You may also set $ENV{PAGER} to"
NSQ_SOURCE_LINE 00000552 "Term::Pager to select this extensible, pure perl pager for display."
NSQ_SOURCE_LINE 00000553 ""
NSQ_SOURCE_LINE 00000554 "=item 5. more"
NSQ_SOURCE_LINE 00000555 ""
NSQ_SOURCE_LINE 00000556 "Set I<PAGER> to C<more>, and cross our fingers."
NSQ_SOURCE_LINE 00000557 ""
NSQ_SOURCE_LINE 00000558 "=back"
NSQ_SOURCE_LINE 00000559 ""
NSQ_SOURCE_LINE 00000560 "Steps 1, 3 and 5 rely upon the I<PATH> environment variable."
NSQ_SOURCE_LINE 00000561 ""
NSQ_SOURCE_LINE 00000562 "=head1 CAVEATS"
NSQ_SOURCE_LINE 00000563 ""
NSQ_SOURCE_LINE 00000564 "You probably want to do something with SIGPIPE eg;"
NSQ_SOURCE_LINE 00000565 ""
NSQ_SOURCE_LINE 00000566 "  eval {"
NSQ_SOURCE_LINE 00000567 "    local $SIG{PIPE} = sub { die };"
NSQ_SOURCE_LINE 00000568 "    local $STDOUT = IO::Pager::open(*STDOUT);"
NSQ_SOURCE_LINE 00000569 ""
NSQ_SOURCE_LINE 00000570 "    while (1) {"
NSQ_SOURCE_LINE 00000571 "      # Do something"
NSQ_SOURCE_LINE 00000572 "    }"
NSQ_SOURCE_LINE 00000573 "  }"
NSQ_SOURCE_LINE 00000574 ""
NSQ_SOURCE_LINE 00000575 "  # Do something else"
NSQ_SOURCE_LINE 00000576 ""
NSQ_SOURCE_LINE 00000577 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000578 ""
NSQ_SOURCE_LINE 00000579 "L<IO::Pager::Buffered>, L<IO::Pager::Unbuffered>, L<I::Pager::Perl>,"
NSQ_SOURCE_LINE 00000580 "L<IO::Pager::Page>, L<IO::Page>, L<Meta::Tool::Less>"
NSQ_SOURCE_LINE 00000581 ""
