BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Carp::Assert;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "require 5.006;"
NSQ_SOURCE_LINE 00000004 "use strict qw(subs vars);"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 "use Exporter;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use vars qw(@ISA $VERSION %EXPORT_TAGS);"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "BEGIN {"
NSQ_SOURCE_LINE 00000011 "    $VERSION = '0.22';"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "    @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "    %EXPORT_TAGS = ("
NSQ_SOURCE_LINE 00000016 "                    NDEBUG => [qw(assert affirm should shouldnt DEBUG)],"
NSQ_SOURCE_LINE 00000017 "                   );"
NSQ_SOURCE_LINE 00000018 "    $EXPORT_TAGS{DEBUG} = $EXPORT_TAGS{NDEBUG};"
NSQ_SOURCE_LINE 00000019 "    Exporter::export_tags(qw(NDEBUG DEBUG));"
NSQ_SOURCE_LINE 00000020 "}"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "# constant.pm, alas, adds too much load time (yes, I benchmarked it)"
NSQ_SOURCE_LINE 00000023 "sub REAL_DEBUG  ()  { 1 }       # CONSTANT"
NSQ_SOURCE_LINE 00000024 "sub NDEBUG      ()  { 0 }       # CONSTANT"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "# Export the proper DEBUG flag according to if :NDEBUG is set."
NSQ_SOURCE_LINE 00000027 "# Also export noop versions of our routines if NDEBUG"
NSQ_SOURCE_LINE 00000028 "sub noop { undef }"
NSQ_SOURCE_LINE 00000029 "sub noop_affirm (&;$) { undef };"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "sub import {"
NSQ_SOURCE_LINE 00000032 "    my $env_ndebug = exists $ENV{PERL_NDEBUG} ? $ENV{PERL_NDEBUG}"
NSQ_SOURCE_LINE 00000033 "                                              : $ENV{'NDEBUG'};"
NSQ_SOURCE_LINE 00000034 "    if( grep(/^:NDEBUG$/, @_) or $env_ndebug ) {"
NSQ_SOURCE_LINE 00000035 "        my $caller = caller;"
NSQ_SOURCE_LINE 00000036 "        foreach my $func (grep !/^DEBUG$/, @{$EXPORT_TAGS{'NDEBUG'}}) {"
NSQ_SOURCE_LINE 00000037 "            if( $func eq 'affirm' ) {"
NSQ_SOURCE_LINE 00000038 "                *{$caller.'::'.$func} = \\&noop_affirm;"
NSQ_SOURCE_LINE 00000039 "            } else {"
NSQ_SOURCE_LINE 00000040 "                *{$caller.'::'.$func} = \\&noop;"
NSQ_SOURCE_LINE 00000041 "            }"
NSQ_SOURCE_LINE 00000042 "        }"
NSQ_SOURCE_LINE 00000043 "        *{$caller.'::DEBUG'} = \\&NDEBUG;"
NSQ_SOURCE_LINE 00000044 "    }"
NSQ_SOURCE_LINE 00000045 "    else {"
NSQ_SOURCE_LINE 00000046 "        *DEBUG = *REAL_DEBUG;"
NSQ_SOURCE_LINE 00000047 "        Carp::Assert->_export_to_level(1, @_);"
NSQ_SOURCE_LINE 00000048 "    }"
NSQ_SOURCE_LINE 00000049 "}"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "# 5.004's Exporter doesn't have export_to_level."
NSQ_SOURCE_LINE 00000053 "sub _export_to_level"
NSQ_SOURCE_LINE 00000054 "{"
NSQ_SOURCE_LINE 00000055 "      my $pkg = shift;"
NSQ_SOURCE_LINE 00000056 "      my $level = shift;"
NSQ_SOURCE_LINE 00000057 "      (undef) = shift;                  # XXX redundant arg"
NSQ_SOURCE_LINE 00000058 "      my $callpkg = caller($level);"
NSQ_SOURCE_LINE 00000059 "      $pkg->export($callpkg, @_);"
NSQ_SOURCE_LINE 00000060 "}"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "sub unimport {"
NSQ_SOURCE_LINE 00000064 "    *DEBUG = *NDEBUG;"
NSQ_SOURCE_LINE 00000065 "    push @_, ':NDEBUG';"
NSQ_SOURCE_LINE 00000066 "    goto &import;"
NSQ_SOURCE_LINE 00000067 "}"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "# Can't call confess() here or the stack trace will be wrong."
NSQ_SOURCE_LINE 00000071 "sub _fail_msg {"
NSQ_SOURCE_LINE 00000072 "    my($name) = shift;"
NSQ_SOURCE_LINE 00000073 "    my $msg = 'Assertion';"
NSQ_SOURCE_LINE 00000074 "    $msg   .= \" ($name)\" if defined $name;"
NSQ_SOURCE_LINE 00000075 "    $msg   .= \" failed!\\n\";"
NSQ_SOURCE_LINE 00000076 "    return $msg;"
NSQ_SOURCE_LINE 00000077 "}"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "=head1 NAME"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "Carp::Assert - executable comments"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "    # Assertions are on."
NSQ_SOURCE_LINE 00000087 "    use Carp::Assert;"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "    $next_sunrise_time = sunrise();"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "    # Assert that the sun must rise in the next 24 hours."
NSQ_SOURCE_LINE 00000092 "    assert(($next_sunrise_time - time) < 24*60*60) if DEBUG;"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "    # Assert that your customer's primary credit card is active"
NSQ_SOURCE_LINE 00000095 "    affirm {"
NSQ_SOURCE_LINE 00000096 "        my @cards = @{$customer->credit_cards};"
NSQ_SOURCE_LINE 00000097 "        $cards[0]->is_active;"
NSQ_SOURCE_LINE 00000098 "    };"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "    # Assertions are off."
NSQ_SOURCE_LINE 00000102 "    no Carp::Assert;"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "    $next_pres = divine_next_president();"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "    # Assert that if you predict Dan Quayle will be the next president"
NSQ_SOURCE_LINE 00000107 "    # your crystal ball might need some polishing.  However, since"
NSQ_SOURCE_LINE 00000108 "    # assertions are off, IT COULD HAPPEN!"
NSQ_SOURCE_LINE 00000109 "    shouldnt($next_pres, 'Dan Quayle') if DEBUG;"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "=begin testing"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "BEGIN {"
NSQ_SOURCE_LINE 00000117 "    local %ENV = %ENV;"
NSQ_SOURCE_LINE 00000118 "    delete @ENV{qw(PERL_NDEBUG NDEBUG)};"
NSQ_SOURCE_LINE 00000119 "    require Carp::Assert;"
NSQ_SOURCE_LINE 00000120 "    Carp::Assert->import;"
NSQ_SOURCE_LINE 00000121 "}"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "local %ENV = %ENV;"
NSQ_SOURCE_LINE 00000124 "delete @ENV{qw(PERL_NDEBUG NDEBUG)};"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "=end testing"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "    \"We are ready for any unforseen event that may or may not "
NSQ_SOURCE_LINE 00000129 "    occur.\""
NSQ_SOURCE_LINE 00000130 "        - Dan Quayle"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "Carp::Assert is intended for a purpose like the ANSI C library"
NSQ_SOURCE_LINE 00000133 "L<assert.h|http://en.wikipedia.org/wiki/Assert.h>."
NSQ_SOURCE_LINE 00000134 "If you're already familiar with assert.h, then you can"
NSQ_SOURCE_LINE 00000135 "probably skip this and go straight to the FUNCTIONS section."
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "Assertions are the explicit expressions of your assumptions about the"
NSQ_SOURCE_LINE 00000138 "reality your program is expected to deal with, and a declaration of"
NSQ_SOURCE_LINE 00000139 "those which it is not.  They are used to prevent your program from"
NSQ_SOURCE_LINE 00000140 "blissfully processing garbage inputs (garbage in, garbage out becomes"
NSQ_SOURCE_LINE 00000141 "garbage in, error out) and to tell you when you've produced garbage"
NSQ_SOURCE_LINE 00000142 "output.  (If I was going to be a cynic about Perl and the user nature,"
NSQ_SOURCE_LINE 00000143 "I'd say there are no user inputs but garbage, and Perl produces"
NSQ_SOURCE_LINE 00000144 "nothing but...)"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "An assertion is used to prevent the impossible from being asked of"
NSQ_SOURCE_LINE 00000147 "your code, or at least tell you when it does.  For example:"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "=for example begin"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "    # Take the square root of a number."
NSQ_SOURCE_LINE 00000152 "    sub my_sqrt {"
NSQ_SOURCE_LINE 00000153 "        my($num) = shift;"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "        # the square root of a negative number is imaginary."
NSQ_SOURCE_LINE 00000156 "        assert($num >= 0);"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "        return sqrt $num;"
NSQ_SOURCE_LINE 00000159 "    }"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "=for example end"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "=for example_testing"
NSQ_SOURCE_LINE 00000164 "is( my_sqrt(4),  2,            'my_sqrt example with good input' );"
NSQ_SOURCE_LINE 00000165 "ok( !eval{ my_sqrt(-1); 1 },   '  and pukes on bad' );"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "The assertion will warn you if a negative number was handed to your"
NSQ_SOURCE_LINE 00000168 "subroutine, a reality the routine has no intention of dealing with."
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "An assertion should also be used as something of a reality check, to"
NSQ_SOURCE_LINE 00000171 "make sure what your code just did really did happen:"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "    open(FILE, $filename) || die $!;"
NSQ_SOURCE_LINE 00000174 "    @stuff = <FILE>;"
NSQ_SOURCE_LINE 00000175 "    @stuff = do_something(@stuff);"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "    # I should have some stuff."
NSQ_SOURCE_LINE 00000178 "    assert(@stuff > 0);"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "The assertion makes sure you have some @stuff at the end.  Maybe the"
NSQ_SOURCE_LINE 00000181 "file was empty, maybe do_something() returned an empty list... either"
NSQ_SOURCE_LINE 00000182 "way, the assert() will give you a clue as to where the problem lies,"
NSQ_SOURCE_LINE 00000183 "rather than 50 lines down at when you wonder why your program isn't"
NSQ_SOURCE_LINE 00000184 "printing anything."
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "Since assertions are designed for debugging and will remove themelves"
NSQ_SOURCE_LINE 00000187 "from production code, your assertions should be carefully crafted so"
NSQ_SOURCE_LINE 00000188 "as to not have any side-effects, change any variables, or otherwise"
NSQ_SOURCE_LINE 00000189 "have any effect on your program.  Here is an example of a bad"
NSQ_SOURCE_LINE 00000190 "assertation:"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "    assert($error = 1 if $king ne 'Henry');  # Bad!"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "It sets an error flag which may then be used somewhere else in your"
NSQ_SOURCE_LINE 00000195 "program. When you shut off your assertions with the $DEBUG flag,"
NSQ_SOURCE_LINE 00000196 "$error will no longer be set."
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "Here's another example of B<bad> use:"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "    assert($next_pres ne 'Dan Quayle' or goto Canada);  # Bad!"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "This assertion has the side effect of moving to Canada should it fail."
NSQ_SOURCE_LINE 00000203 "This is a very bad assertion since error handling should not be"
NSQ_SOURCE_LINE 00000204 "placed in an assertion, nor should it have side-effects."
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "In short, an assertion is an executable comment.  For instance, instead"
NSQ_SOURCE_LINE 00000207 "of writing this"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "    # $life ends with a '!'"
NSQ_SOURCE_LINE 00000210 "    $life = begin_life();"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "you'd replace the comment with an assertion which B<enforces> the comment."
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "    $life = begin_life();"
NSQ_SOURCE_LINE 00000215 "    assert( $life =~ /!$/ );"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "=for testing"
NSQ_SOURCE_LINE 00000218 "my $life = 'Whimper!';"
NSQ_SOURCE_LINE 00000219 "ok( eval { assert( $life =~ /!$/ ); 1 },   'life ends with a bang' );"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "=over 4"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "=item B<assert>"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "    assert(EXPR) if DEBUG;"
NSQ_SOURCE_LINE 00000229 "    assert(EXPR, $name) if DEBUG;"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "assert's functionality is effected by compile time value of the DEBUG"
NSQ_SOURCE_LINE 00000232 "constant, controlled by saying C<use Carp::Assert> or C<no"
NSQ_SOURCE_LINE 00000233 "Carp::Assert>.  In the former case, assert will function as below."
NSQ_SOURCE_LINE 00000234 "Otherwise, the assert function will compile itself out of the program."
NSQ_SOURCE_LINE 00000235 "See L<Debugging vs Production> for details."
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "=for testing"
NSQ_SOURCE_LINE 00000238 "{"
NSQ_SOURCE_LINE 00000239 "  package Some::Other;"
NSQ_SOURCE_LINE 00000240 "  no Carp::Assert;"
NSQ_SOURCE_LINE 00000241 "  ::ok( eval { assert(0) if DEBUG; 1 } );"
NSQ_SOURCE_LINE 00000242 "}"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "Give assert an expression, assert will Carp::confess() if that"
NSQ_SOURCE_LINE 00000245 "expression is false, otherwise it does nothing.  (DO NOT use the"
NSQ_SOURCE_LINE 00000246 "return value of assert for anything, I mean it... really!)."
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "=for testing"
NSQ_SOURCE_LINE 00000249 "ok( eval { assert(1); 1 } );"
NSQ_SOURCE_LINE 00000250 "ok( !eval { assert(0); 1 } );"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "The error from assert will look something like this:"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "    Assertion failed!"
NSQ_SOURCE_LINE 00000255 "            Carp::Assert::assert(0) called at prog line 23"
NSQ_SOURCE_LINE 00000256 "            main::foo called at prog line 50"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "=for testing"
NSQ_SOURCE_LINE 00000259 "eval { assert(0) };"
NSQ_SOURCE_LINE 00000260 "like( $@, '/^Assertion failed!/',       'error format' );"
NSQ_SOURCE_LINE 00000261 "like( $@, '/Carp::Assert::assert\\(0\\) called at/',      '  with stack trace' );"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "Indicating that in the file \"prog\" an assert failed inside the"
NSQ_SOURCE_LINE 00000264 "function main::foo() on line 23 and that foo() was in turn called from"
NSQ_SOURCE_LINE 00000265 "line 50 in the same file."
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "If given a $name, assert() will incorporate this into your error message,"
NSQ_SOURCE_LINE 00000268 "giving users something of a better idea what's going on."
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "    assert( Dogs->isa('People'), 'Dogs are people, too!' ) if DEBUG;"
NSQ_SOURCE_LINE 00000271 "    # Result - \"Assertion (Dogs are people, too!) failed!\""
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "=for testing"
NSQ_SOURCE_LINE 00000274 "eval { assert( Dogs->isa('People'), 'Dogs are people, too!' ); };"
NSQ_SOURCE_LINE 00000275 "like( $@, '/^Assertion \\(Dogs are people, too!\\) failed!/', 'names' );"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "=cut"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "sub assert ($;$) {"
NSQ_SOURCE_LINE 00000280 "    unless($_[0]) {"
NSQ_SOURCE_LINE 00000281 "        require Carp;"
NSQ_SOURCE_LINE 00000282 "        Carp::confess( _fail_msg($_[1]) );"
NSQ_SOURCE_LINE 00000283 "    }"
NSQ_SOURCE_LINE 00000284 "    return undef;"
NSQ_SOURCE_LINE 00000285 "}"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "=item B<affirm>"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "    affirm BLOCK if DEBUG;"
NSQ_SOURCE_LINE 00000291 "    affirm BLOCK $name if DEBUG;"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "Very similar to assert(), but instead of taking just a simple"
NSQ_SOURCE_LINE 00000294 "expression it takes an entire block of code and evaluates it to make"
NSQ_SOURCE_LINE 00000295 "sure its true.  This can allow more complicated assertions than"
NSQ_SOURCE_LINE 00000296 "assert() can without letting the debugging code leak out into"
NSQ_SOURCE_LINE 00000297 "production and without having to smash together several"
NSQ_SOURCE_LINE 00000298 "statements into one."
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "=for example begin"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "    affirm {"
NSQ_SOURCE_LINE 00000303 "        my $customer = Customer->new($customerid);"
NSQ_SOURCE_LINE 00000304 "        my @cards = $customer->credit_cards;"
NSQ_SOURCE_LINE 00000305 "        grep { $_->is_active } @cards;"
NSQ_SOURCE_LINE 00000306 "    } \"Our customer has an active credit card\";"
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "=for example end"
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "=for testing"
NSQ_SOURCE_LINE 00000311 "my $foo = 1;  my $bar = 2;"
NSQ_SOURCE_LINE 00000312 "eval { affirm { $foo == $bar } };"
NSQ_SOURCE_LINE 00000313 "like( $@, '/\\$foo == \\$bar/' );"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "affirm() also has the nice side effect that if you forgot the C<if DEBUG>"
NSQ_SOURCE_LINE 00000317 "suffix its arguments will not be evaluated at all.  This can be nice"
NSQ_SOURCE_LINE 00000318 "if you stick affirm()s with expensive checks into hot loops and other"
NSQ_SOURCE_LINE 00000319 "time-sensitive parts of your program."
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "If the $name is left off and your Perl version is 5.6 or higher the"
NSQ_SOURCE_LINE 00000322 "affirm() diagnostics will include the code begin affirmed."
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "=cut"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "sub affirm (&;$) {"
NSQ_SOURCE_LINE 00000327 "    unless( eval { &{$_[0]}; } ) {"
NSQ_SOURCE_LINE 00000328 "        my $name = $_[1];"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "        if( !defined $name ) {"
NSQ_SOURCE_LINE 00000331 "            eval {"
NSQ_SOURCE_LINE 00000332 "                require B::Deparse;"
NSQ_SOURCE_LINE 00000333 "                $name = B::Deparse->new->coderef2text($_[0]);"
NSQ_SOURCE_LINE 00000334 "            };"
NSQ_SOURCE_LINE 00000335 "            $name = "
NSQ_SOURCE_LINE 00000336 "              'code display non-functional on this version of Perl, sorry'"
NSQ_SOURCE_LINE 00000337 "                if $@;"
NSQ_SOURCE_LINE 00000338 "        }"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "        require Carp;"
NSQ_SOURCE_LINE 00000341 "        Carp::confess( _fail_msg($name) );"
NSQ_SOURCE_LINE 00000342 "    }"
NSQ_SOURCE_LINE 00000343 "    return undef;"
NSQ_SOURCE_LINE 00000344 "}"
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "=item B<should>"
NSQ_SOURCE_LINE 00000347 ""
NSQ_SOURCE_LINE 00000348 "=item B<shouldnt>"
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "    should  ($this, $shouldbe)   if DEBUG;"
NSQ_SOURCE_LINE 00000351 "    shouldnt($this, $shouldntbe) if DEBUG;"
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "Similar to assert(), it is specially for simple \"this should be that\""
NSQ_SOURCE_LINE 00000354 "or \"this should be anything but that\" style of assertions."
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "Due to Perl's lack of a good macro system, assert() can only report"
NSQ_SOURCE_LINE 00000357 "where something failed, but it can't report I<what> failed or I<how>."
NSQ_SOURCE_LINE 00000358 "should() and shouldnt() can produce more informative error messages:"
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 "    Assertion ('this' should be 'that'!) failed!"
NSQ_SOURCE_LINE 00000361 "            Carp::Assert::should('this', 'that') called at moof line 29"
NSQ_SOURCE_LINE 00000362 "            main::foo() called at moof line 58"
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "So this:"
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "    should($this, $that) if DEBUG;"
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 "is similar to this:"
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "    assert($this eq $that) if DEBUG;"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "except for the better error message."
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "Currently, should() and shouldnt() can only do simple eq and ne tests"
NSQ_SOURCE_LINE 00000375 "(respectively).  Future versions may allow regexes."
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "=cut"
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "sub should ($$) {"
NSQ_SOURCE_LINE 00000380 "    unless($_[0] eq $_[1]) {"
NSQ_SOURCE_LINE 00000381 "        require Carp;"
NSQ_SOURCE_LINE 00000382 "        &Carp::confess( _fail_msg(\"'$_[0]' should be '$_[1]'!\") );"
NSQ_SOURCE_LINE 00000383 "    }"
NSQ_SOURCE_LINE 00000384 "    return undef;"
NSQ_SOURCE_LINE 00000385 "}"
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "sub shouldnt ($$) {"
NSQ_SOURCE_LINE 00000388 "    unless($_[0] ne $_[1]) {"
NSQ_SOURCE_LINE 00000389 "        require Carp;"
NSQ_SOURCE_LINE 00000390 "        &Carp::confess( _fail_msg(\"'$_[0]' shouldn't be that!\") );"
NSQ_SOURCE_LINE 00000391 "    }"
NSQ_SOURCE_LINE 00000392 "    return undef;"
NSQ_SOURCE_LINE 00000393 "}"
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "=back"
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "=head1 Debugging vs Production"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "Because assertions are extra code and because it is sometimes necessary to"
NSQ_SOURCE_LINE 00000400 "place them in 'hot' portions of your code where speed is paramount,"
NSQ_SOURCE_LINE 00000401 "Carp::Assert provides the option to remove its assert() calls from your"
NSQ_SOURCE_LINE 00000402 "program."
NSQ_SOURCE_LINE 00000403 ""
NSQ_SOURCE_LINE 00000404 "So, we provide a way to force Perl to inline the switched off assert()"
NSQ_SOURCE_LINE 00000405 "routine, thereby removing almost all performance impact on your production"
NSQ_SOURCE_LINE 00000406 "code."
NSQ_SOURCE_LINE 00000407 ""
NSQ_SOURCE_LINE 00000408 "    no Carp::Assert;  # assertions are off."
NSQ_SOURCE_LINE 00000409 "    assert(1==1) if DEBUG;"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "DEBUG is a constant set to 0.  Adding the 'if DEBUG' condition on your"
NSQ_SOURCE_LINE 00000412 "assert() call gives perl the cue to go ahead and remove assert() call from"
NSQ_SOURCE_LINE 00000413 "your program entirely, since the if conditional will always be false."
NSQ_SOURCE_LINE 00000414 ""
NSQ_SOURCE_LINE 00000415 "    # With C<no Carp::Assert> the assert() has no impact."
NSQ_SOURCE_LINE 00000416 "    for (1..100) {"
NSQ_SOURCE_LINE 00000417 "        assert( do_some_really_time_consuming_check ) if DEBUG;"
NSQ_SOURCE_LINE 00000418 "    }"
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "If C<if DEBUG> gets too annoying, you can always use affirm()."
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "    # Once again, affirm() has (almost) no impact with C<no Carp::Assert>"
NSQ_SOURCE_LINE 00000423 "    for (1..100) {"
NSQ_SOURCE_LINE 00000424 "        affirm { do_some_really_time_consuming_check };"
NSQ_SOURCE_LINE 00000425 "    }"
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 "Another way to switch off all asserts, system wide, is to define the"
NSQ_SOURCE_LINE 00000428 "NDEBUG or the PERL_NDEBUG environment variable."
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "You can safely leave out the \"if DEBUG\" part, but then your assert()"
NSQ_SOURCE_LINE 00000431 "function will always execute (and its arguments evaluated and time"
NSQ_SOURCE_LINE 00000432 "spent).  To get around this, use affirm().  You still have the"
NSQ_SOURCE_LINE 00000433 "overhead of calling a function but at least its arguments will not be"
NSQ_SOURCE_LINE 00000434 "evaluated."
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 ""
NSQ_SOURCE_LINE 00000437 "=head1 Differences from ANSI C"
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "assert() is intended to act like the function from ANSI C fame. "
NSQ_SOURCE_LINE 00000440 "Unfortunately, due to Perl's lack of macros or strong inlining, it's not"
NSQ_SOURCE_LINE 00000441 "nearly as unobtrusive."
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "Well, the obvious one is the \"if DEBUG\" part.  This is cleanest way I could"
NSQ_SOURCE_LINE 00000444 "think of to cause each assert() call and its arguments to be removed from"
NSQ_SOURCE_LINE 00000445 "the program at compile-time, like the ANSI C macro does."
NSQ_SOURCE_LINE 00000446 ""
NSQ_SOURCE_LINE 00000447 "Also, this version of assert does not report the statement which"
NSQ_SOURCE_LINE 00000448 "failed, just the line number and call frame via Carp::confess.  You"
NSQ_SOURCE_LINE 00000449 "can't do C<assert('$a == $b')> because $a and $b will probably be"
NSQ_SOURCE_LINE 00000450 "lexical, and thus unavailable to assert().  But with Perl, unlike C,"
NSQ_SOURCE_LINE 00000451 "you always have the source to look through, so the need isn't as"
NSQ_SOURCE_LINE 00000452 "great."
NSQ_SOURCE_LINE 00000453 ""
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 "=head1 EFFICIENCY"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "With C<no Carp::Assert> (or NDEBUG) and using the C<if DEBUG> suffixes"
NSQ_SOURCE_LINE 00000458 "on all your assertions, Carp::Assert has almost no impact on your"
NSQ_SOURCE_LINE 00000459 "production code.  I say almost because it does still add some load-time"
NSQ_SOURCE_LINE 00000460 "to your code (I've tried to reduce this as much as possible)."
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 "If you forget the C<if DEBUG> on an C<assert()>, C<should()> or"
NSQ_SOURCE_LINE 00000463 "C<shouldnt()>, its arguments are still evaluated and thus will impact"
NSQ_SOURCE_LINE 00000464 "your code.  You'll also have the extra overhead of calling a"
NSQ_SOURCE_LINE 00000465 "subroutine (even if that subroutine does nothing)."
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "Forgetting the C<if DEBUG> on an C<affirm()> is not so bad.  While you"
NSQ_SOURCE_LINE 00000468 "still have the overhead of calling a subroutine (one that does"
NSQ_SOURCE_LINE 00000469 "nothing) it will B<not> evaluate its code block and that can save"
NSQ_SOURCE_LINE 00000470 "a lot."
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "Try to remember the B<if DEBUG>."
NSQ_SOURCE_LINE 00000473 ""
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 "=head1 ENVIRONMENT"
NSQ_SOURCE_LINE 00000476 ""
NSQ_SOURCE_LINE 00000477 "=over 4"
NSQ_SOURCE_LINE 00000478 ""
NSQ_SOURCE_LINE 00000479 "=item NDEBUG"
NSQ_SOURCE_LINE 00000480 ""
NSQ_SOURCE_LINE 00000481 "Defining NDEBUG switches off all assertions.  It has the same effect"
NSQ_SOURCE_LINE 00000482 "as changing \"use Carp::Assert\" to \"no Carp::Assert\" but it effects all"
NSQ_SOURCE_LINE 00000483 "code."
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "=item PERL_NDEBUG"
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "Same as NDEBUG and will override it.  Its provided to give you"
NSQ_SOURCE_LINE 00000488 "something which won't conflict with any C programs you might be"
NSQ_SOURCE_LINE 00000489 "working on at the same time."
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "=back"
NSQ_SOURCE_LINE 00000492 ""
NSQ_SOURCE_LINE 00000493 ""
NSQ_SOURCE_LINE 00000494 "=head1 BUGS, CAVETS and other MUSINGS"
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "=head2 Conflicts with C<POSIX.pm>"
NSQ_SOURCE_LINE 00000497 ""
NSQ_SOURCE_LINE 00000498 "The C<POSIX> module exports an C<assert> routine which will conflict with C<Carp::Assert> if both are used in the same namespace.  If you are using both together, prevent C<POSIX> from exporting like so:"
NSQ_SOURCE_LINE 00000499 ""
NSQ_SOURCE_LINE 00000500 "    use POSIX ();"
NSQ_SOURCE_LINE 00000501 "    use Carp::Assert;"
NSQ_SOURCE_LINE 00000502 ""
NSQ_SOURCE_LINE 00000503 "Since C<POSIX> exports way too much, you should be using it like that anyway."
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "=head2 C<affirm> and C<$^S>"
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "affirm() mucks with the expression's caller and it is run in an eval"
NSQ_SOURCE_LINE 00000508 "so anything that checks $^S will be wrong."
NSQ_SOURCE_LINE 00000509 ""
NSQ_SOURCE_LINE 00000510 "=head2 missing C<if DEBUG>"
NSQ_SOURCE_LINE 00000511 ""
NSQ_SOURCE_LINE 00000512 "It would be nice if we could warn about missing C<if DEBUG>."
NSQ_SOURCE_LINE 00000513 ""
NSQ_SOURCE_LINE 00000514 ""
NSQ_SOURCE_LINE 00000515 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000516 ""
NSQ_SOURCE_LINE 00000517 "L<assert.h|http://en.wikipedia.org/wiki/Assert.h> - the wikipedia"
NSQ_SOURCE_LINE 00000518 "page about C<assert.h>."
NSQ_SOURCE_LINE 00000519 ""
NSQ_SOURCE_LINE 00000520 "L<Carp::Assert::More> provides a set of convenience functions"
NSQ_SOURCE_LINE 00000521 "that are wrappers around C<Carp::Assert>."
NSQ_SOURCE_LINE 00000522 ""
NSQ_SOURCE_LINE 00000523 "L<Sub::Assert> provides support for subroutine pre- and post-conditions."
NSQ_SOURCE_LINE 00000524 "The documentation says it's slow."
NSQ_SOURCE_LINE 00000525 ""
NSQ_SOURCE_LINE 00000526 "L<PerlX::Assert> provides compile-time assertions, which are usually"
NSQ_SOURCE_LINE 00000527 "optimised away at compile time. Currently part of the L<Moops>"
NSQ_SOURCE_LINE 00000528 "distribution, but may get its own distribution sometime in 2014."
NSQ_SOURCE_LINE 00000529 ""
NSQ_SOURCE_LINE 00000530 "L<Devel::Assert> also provides an C<assert> function, for Perl >= 5.8.1."
NSQ_SOURCE_LINE 00000531 ""
NSQ_SOURCE_LINE 00000532 "L<assertions> provides an assertion mechanism for Perl >= 5.9.0."
NSQ_SOURCE_LINE 00000533 ""
NSQ_SOURCE_LINE 00000534 "=head1 REPOSITORY"
NSQ_SOURCE_LINE 00000535 ""
