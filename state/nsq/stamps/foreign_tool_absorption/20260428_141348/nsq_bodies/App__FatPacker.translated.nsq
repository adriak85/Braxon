NSQ_SOURCE_LINE 00000001 "package App::FatPacker;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings FATAL => 'all';"
NSQ_SOURCE_LINE 00000005 "use 5.008001;"
NSQ_SOURCE_LINE 00000006 "use Getopt::Long;"
NSQ_SOURCE_LINE 00000007 "use Cwd qw(cwd);"
NSQ_SOURCE_LINE 00000008 "use File::Find qw(find);"
NSQ_SOURCE_LINE 00000009 "use File::Spec::Functions qw("
NSQ_SOURCE_LINE 00000010 "  catdir splitpath splitdir catpath rel2abs abs2rel"
NSQ_SOURCE_LINE 00000011 ");"
NSQ_SOURCE_LINE 00000012 "use File::Spec::Unix;"
NSQ_SOURCE_LINE 00000013 "use File::Copy qw(copy);"
NSQ_SOURCE_LINE 00000014 "use File::Path qw(mkpath rmtree);"
NSQ_SOURCE_LINE 00000015 "use B qw(perlstring);"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "our $VERSION = '0.010008'; # v0.10.8"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "$VERSION = eval $VERSION;"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "sub call_parser {"
NSQ_SOURCE_LINE 00000022 "  my $self = shift;"
NSQ_SOURCE_LINE 00000023 "  my ($args, $options) = @_;"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "  local *ARGV = [ @{$args} ];"
NSQ_SOURCE_LINE 00000026 "  $self->{option_parser}->getoptions(@$options);"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "  return [ @ARGV ];"
NSQ_SOURCE_LINE 00000029 "}"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "sub lines_of {"
NSQ_SOURCE_LINE 00000032 "  map +(chomp,$_)[1], do { local @ARGV = ($_[0]); <> };"
NSQ_SOURCE_LINE 00000033 "}"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "sub stripspace {"
NSQ_SOURCE_LINE 00000036 "  my ($text) = @_;"
NSQ_SOURCE_LINE 00000037 "  $text =~ /^(\\s+)/ && $text =~ s/^$1//mg;"
NSQ_SOURCE_LINE 00000038 "  $text;"
NSQ_SOURCE_LINE 00000039 "}"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "sub import {"
NSQ_SOURCE_LINE 00000042 "  $_[1] && $_[1] eq '-run_script'"
NSQ_SOURCE_LINE 00000043 "    and return shift->new->run_script;"
NSQ_SOURCE_LINE 00000044 "}"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "sub new {"
NSQ_SOURCE_LINE 00000047 "  bless {"
NSQ_SOURCE_LINE 00000048 "    option_parser => Getopt::Long::Parser->new("
NSQ_SOURCE_LINE 00000049 "      config => [ qw(require_order pass_through bundling no_auto_abbrev) ]"
NSQ_SOURCE_LINE 00000050 "    ),"
NSQ_SOURCE_LINE 00000051 "  }, $_[0];"
NSQ_SOURCE_LINE 00000052 "}"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "sub run_script {"
NSQ_SOURCE_LINE 00000055 "  my ($self, $args) = @_;"
NSQ_SOURCE_LINE 00000056 "  my @args = $args ? @$args : @ARGV;"
NSQ_SOURCE_LINE 00000057 "  (my $cmd = shift @args || 'help') =~ s/-/_/g;"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "  if (my $meth = $self->can(\"script_command_${cmd}\")) {"
NSQ_SOURCE_LINE 00000060 "    $self->$meth(\\@args);"
NSQ_SOURCE_LINE 00000061 "  } else {"
NSQ_SOURCE_LINE 00000062 "    die \"No such command ${cmd}\";"
NSQ_SOURCE_LINE 00000063 "  }"
NSQ_SOURCE_LINE 00000064 "}"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "sub script_command_help {"
NSQ_SOURCE_LINE 00000067 "  print \"Try `perldoc fatpack` for how to use me\\n\";"
NSQ_SOURCE_LINE 00000068 "}"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "sub script_command_pack {"
NSQ_SOURCE_LINE 00000071 "  my ($self, $args) = @_;"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "  my @modules = split /\\r?\\n/, $self->trace(args => $args);"
NSQ_SOURCE_LINE 00000074 "  my @packlists = $self->packlists_containing(\\@modules);"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "  my $base = catdir(cwd, 'fatlib');"
NSQ_SOURCE_LINE 00000077 "  $self->packlists_to_tree($base, \\@packlists);"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "  my $file = shift @$args;"
NSQ_SOURCE_LINE 00000080 "  print $self->fatpack_file($file);"
NSQ_SOURCE_LINE 00000081 "}"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "sub script_command_trace {"
NSQ_SOURCE_LINE 00000084 "  my ($self, $args) = @_;"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "  $args = $self->call_parser($args => ["
NSQ_SOURCE_LINE 00000087 "    'to=s' => \\my $file,"
NSQ_SOURCE_LINE 00000088 "    'to-stderr' => \\my $to_stderr,"
NSQ_SOURCE_LINE 00000089 "    'use=s' => \\my @additional_use"
NSQ_SOURCE_LINE 00000090 "  ]);"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "  die \"Can't use to and to-stderr on same call\" if $file && $to_stderr;"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "  $file ||= 'fatpacker.trace';"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "  if (!$to_stderr and -e $file) {"
NSQ_SOURCE_LINE 00000097 "    unlink $file or die \"Couldn't remove old trace file: $!\";"
NSQ_SOURCE_LINE 00000098 "  }"
NSQ_SOURCE_LINE 00000099 "  my $arg = do {"
NSQ_SOURCE_LINE 00000100 "    if ($to_stderr) {"
NSQ_SOURCE_LINE 00000101 "      \">&STDERR\""
NSQ_SOURCE_LINE 00000102 "    } elsif ($file) {"
NSQ_SOURCE_LINE 00000103 "      \">>${file}\""
NSQ_SOURCE_LINE 00000104 "    }"
NSQ_SOURCE_LINE 00000105 "  };"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "  $self->trace("
NSQ_SOURCE_LINE 00000108 "    use => \\@additional_use,"
NSQ_SOURCE_LINE 00000109 "    args => $args,"
NSQ_SOURCE_LINE 00000110 "    output => $arg,"
NSQ_SOURCE_LINE 00000111 "  );"
NSQ_SOURCE_LINE 00000112 "}"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "sub trace {"
NSQ_SOURCE_LINE 00000115 "  my ($self, %opts) = @_;"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "  my $output = $opts{output};"
NSQ_SOURCE_LINE 00000118 "  my $trace_opts = join ',', $output||'>&STDOUT', @{$opts{use}||[]};"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "  local $ENV{PERL5OPT} = join ' ',"
NSQ_SOURCE_LINE 00000121 "    ($ENV{PERL5OPT}||()), '-MApp::FatPacker::Trace='.$trace_opts;"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "  my @args = @{$opts{args}||[]};"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "  if ($output) {"
NSQ_SOURCE_LINE 00000126 "    # user specified output target, JFDI"
NSQ_SOURCE_LINE 00000127 "    system $^X, @args;"
NSQ_SOURCE_LINE 00000128 "    return;"
NSQ_SOURCE_LINE 00000129 "  } else {"
NSQ_SOURCE_LINE 00000130 "    # no output target specified, slurp"
NSQ_SOURCE_LINE 00000131 "    open my $out_fh, \"$^X @args |\";"
NSQ_SOURCE_LINE 00000132 "    return do { local $/; <$out_fh> };"
NSQ_SOURCE_LINE 00000133 "  }"
NSQ_SOURCE_LINE 00000134 "}"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "sub script_command_packlists_for {"
NSQ_SOURCE_LINE 00000137 "  my ($self, $args) = @_;"
NSQ_SOURCE_LINE 00000138 "  foreach my $pl ($self->packlists_containing($args)) {"
NSQ_SOURCE_LINE 00000139 "    print \"${pl}\\n\";"
NSQ_SOURCE_LINE 00000140 "  }"
NSQ_SOURCE_LINE 00000141 "}"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "sub packlists_containing {"
NSQ_SOURCE_LINE 00000144 "  my ($self, $targets) = @_;"
NSQ_SOURCE_LINE 00000145 "  my @targets;"
NSQ_SOURCE_LINE 00000146 "  {"
NSQ_SOURCE_LINE 00000147 "    local @INC = ('lib', @INC);"
NSQ_SOURCE_LINE 00000148 "    foreach my $t (@$targets) {"
NSQ_SOURCE_LINE 00000149 "      unless (eval { require $t; 1}) {"
NSQ_SOURCE_LINE 00000150 "        warn \"Failed to load ${t}: $@\\n\""
NSQ_SOURCE_LINE 00000151 "            .\"Make sure you're not missing a packlist as a result\\n\";"
NSQ_SOURCE_LINE 00000152 "        next;"
NSQ_SOURCE_LINE 00000153 "      }"
NSQ_SOURCE_LINE 00000154 "      push @targets, $t;"
NSQ_SOURCE_LINE 00000155 "    }"
NSQ_SOURCE_LINE 00000156 "  }"
NSQ_SOURCE_LINE 00000157 "  my @search = grep -d $_, map catdir($_, 'auto'), @INC;"
NSQ_SOURCE_LINE 00000158 "  my %pack_rev;"
NSQ_SOURCE_LINE 00000159 "  find({"
NSQ_SOURCE_LINE 00000160 "    no_chdir => 1,"
NSQ_SOURCE_LINE 00000161 "    wanted => sub {"
NSQ_SOURCE_LINE 00000162 "      return unless /[\\\\\\/]\\.packlist$/ && -f $_;"
NSQ_SOURCE_LINE 00000163 "      $pack_rev{$_} = $File::Find::name for lines_of $File::Find::name;"
NSQ_SOURCE_LINE 00000164 "    },"
NSQ_SOURCE_LINE 00000165 "  }, @search);"
NSQ_SOURCE_LINE 00000166 "  my %found; @found{map +($pack_rev{Cwd::abs_path($INC{$_})}||()), @targets} = ();"
NSQ_SOURCE_LINE 00000167 "  sort keys %found;"
NSQ_SOURCE_LINE 00000168 "}"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "sub script_command_tree {"
NSQ_SOURCE_LINE 00000171 "  my ($self, $args) = @_;"
NSQ_SOURCE_LINE 00000172 "  my $base = catdir(cwd,'fatlib');"
NSQ_SOURCE_LINE 00000173 "  $self->packlists_to_tree($base, $args);"
NSQ_SOURCE_LINE 00000174 "}"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "sub packlists_to_tree {"
NSQ_SOURCE_LINE 00000177 "  my ($self, $where, $packlists) = @_;"
NSQ_SOURCE_LINE 00000178 "  rmtree $where;"
NSQ_SOURCE_LINE 00000179 "  mkpath $where;"
NSQ_SOURCE_LINE 00000180 "  foreach my $pl (@$packlists) {"
NSQ_SOURCE_LINE 00000181 "    my ($vol, $dirs, $file) = splitpath $pl;"
NSQ_SOURCE_LINE 00000182 "    my @dir_parts = splitdir $dirs;"
NSQ_SOURCE_LINE 00000183 "    my $pack_base;"
NSQ_SOURCE_LINE 00000184 "    PART: foreach my $p (0 .. $#dir_parts) {"
NSQ_SOURCE_LINE 00000185 "      if ($dir_parts[$p] eq 'auto') {"
NSQ_SOURCE_LINE 00000186 "        # $p-2 normally since it's <wanted path>/$Config{archname}/auto but"
NSQ_SOURCE_LINE 00000187 "        # if the last bit is a number it's $Config{archname}/$version/auto"
NSQ_SOURCE_LINE 00000188 "        # so use $p-3 in that case"
NSQ_SOURCE_LINE 00000189 "        my $version_lib = 0+!!($dir_parts[$p-1] =~ /^[0-9.]+$/);"
NSQ_SOURCE_LINE 00000190 "        $pack_base = catpath $vol, catdir @dir_parts[0..$p-(2+$version_lib)];"
NSQ_SOURCE_LINE 00000191 "        last PART;"
NSQ_SOURCE_LINE 00000192 "      }"
NSQ_SOURCE_LINE 00000193 "    }"
NSQ_SOURCE_LINE 00000194 "    die \"Couldn't figure out base path of packlist ${pl}\" unless $pack_base;"
NSQ_SOURCE_LINE 00000195 "    foreach my $source (lines_of $pl) {"
NSQ_SOURCE_LINE 00000196 "      # there is presumably a better way to do \"is this under this base?\""
NSQ_SOURCE_LINE 00000197 "      # but if so, it's not obvious to me in File::Spec"
NSQ_SOURCE_LINE 00000198 "      next unless substr($source,0,length $pack_base) eq $pack_base;"
NSQ_SOURCE_LINE 00000199 "      my $target = rel2abs( abs2rel($source, $pack_base), $where );"
NSQ_SOURCE_LINE 00000200 "      my $target_dir = catpath((splitpath $target)[0,1]);"
NSQ_SOURCE_LINE 00000201 "      mkpath $target_dir;"
NSQ_SOURCE_LINE 00000202 "      copy $source => $target;"
NSQ_SOURCE_LINE 00000203 "    }"
NSQ_SOURCE_LINE 00000204 "  }"
NSQ_SOURCE_LINE 00000205 "}"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "sub script_command_file {"
NSQ_SOURCE_LINE 00000208 "  my ($self, $args) = @_;"
NSQ_SOURCE_LINE 00000209 "  my $file = shift @$args;"
NSQ_SOURCE_LINE 00000210 "  print $self->fatpack_file($file);"
NSQ_SOURCE_LINE 00000211 "}"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "sub fatpack_file {"
NSQ_SOURCE_LINE 00000214 "  my ($self, $file) = @_;"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "  my $shebang = \"\";"
NSQ_SOURCE_LINE 00000217 "  my $script = \"\";"
NSQ_SOURCE_LINE 00000218 "  if ( defined $file and -r $file ) {"
NSQ_SOURCE_LINE 00000219 "    ($shebang, $script) = $self->load_main_script($file);"
NSQ_SOURCE_LINE 00000220 "  }"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "  my @dirs = $self->collect_dirs();"
NSQ_SOURCE_LINE 00000223 "  my %files;"
NSQ_SOURCE_LINE 00000224 "  $self->collect_files($_, \\%files) for @dirs;"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "  return join \"\\n\", $shebang, $self->fatpack_code(\\%files), $script;"
NSQ_SOURCE_LINE 00000227 "}"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "# This method can be overload in sub classes"
NSQ_SOURCE_LINE 00000230 "# For example to skip POD"
NSQ_SOURCE_LINE 00000231 "sub load_file {"
NSQ_SOURCE_LINE 00000232 "  my ($self, $file) = @_;"
NSQ_SOURCE_LINE 00000233 "  my $content = do {"
NSQ_SOURCE_LINE 00000234 "    local (@ARGV, $/) = ($file);"
NSQ_SOURCE_LINE 00000235 "    <>"
NSQ_SOURCE_LINE 00000236 "  };"
NSQ_SOURCE_LINE 00000237 "  close ARGV;"
NSQ_SOURCE_LINE 00000238 "  return $content;"
NSQ_SOURCE_LINE 00000239 "}"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "sub collect_dirs {"
NSQ_SOURCE_LINE 00000242 "  my ($self) = @_;"
NSQ_SOURCE_LINE 00000243 "  my $cwd = cwd;"
NSQ_SOURCE_LINE 00000244 "  return grep -d, map rel2abs($_, $cwd), ('lib','fatlib');"
NSQ_SOURCE_LINE 00000245 "}"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "sub collect_files {"
NSQ_SOURCE_LINE 00000248 "  my ($self, $dir, $files) = @_;"
NSQ_SOURCE_LINE 00000249 "  find(sub {"
NSQ_SOURCE_LINE 00000250 "    return unless -f $_;"
NSQ_SOURCE_LINE 00000251 "    !/\\.pm$/ and warn \"File ${File::Find::name} isn't a .pm file - can't pack this -- if you hoped we were going to, things may not be what you expected later\\n\" and return;"
NSQ_SOURCE_LINE 00000252 "    $files->{File::Spec::Unix->abs2rel($File::Find::name,$dir)} ="
NSQ_SOURCE_LINE 00000253 "      $self->load_file($File::Find::name);"
NSQ_SOURCE_LINE 00000254 "  }, $dir);"
NSQ_SOURCE_LINE 00000255 "}"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "sub load_main_script {"
NSQ_SOURCE_LINE 00000258 "  my ($self, $file) = @_;"
NSQ_SOURCE_LINE 00000259 "  open my $fh, \"<\", $file or die(\"Can't read $file: $!\");"
NSQ_SOURCE_LINE 00000260 "  my $shebang = <$fh>;"
NSQ_SOURCE_LINE 00000261 "  my $script = join \"\", <$fh>;"
NSQ_SOURCE_LINE 00000262 "  close $fh;"
NSQ_SOURCE_LINE 00000263 "  unless ( index($shebang, '#!') == 0 ) {"
NSQ_SOURCE_LINE 00000264 "    $script = $shebang . $script;"
NSQ_SOURCE_LINE 00000265 "    $shebang = \"\";"
NSQ_SOURCE_LINE 00000266 "  }"
NSQ_SOURCE_LINE 00000267 "  return ($shebang, $script);"
NSQ_SOURCE_LINE 00000268 "}"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "sub fatpack_start {"
NSQ_SOURCE_LINE 00000271 "  return stripspace <<'  END_START';"
NSQ_SOURCE_LINE 00000272 "    # This chunk of stuff was generated by App::FatPacker. To find the original"
NSQ_SOURCE_LINE 00000273 "    # file's code, look for the end of this BEGIN block or the string 'FATPACK'"
NSQ_SOURCE_LINE 00000274 "    BEGIN {"
NSQ_SOURCE_LINE 00000275 "    my %fatpacked;"
NSQ_SOURCE_LINE 00000276 "  END_START"
NSQ_SOURCE_LINE 00000277 "}"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "sub fatpack_end {"
NSQ_SOURCE_LINE 00000280 "  return stripspace <<'  END_END';"
NSQ_SOURCE_LINE 00000281 "    s/^  //mg for values %fatpacked;"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "    my $class = 'FatPacked::'.(0+\\%fatpacked);"
NSQ_SOURCE_LINE 00000284 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000285 "    *{\"${class}::files\"} = sub { keys %{$_[0]} };"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "    if ($] < 5.008) {"
NSQ_SOURCE_LINE 00000288 "      *{\"${class}::INC\"} = sub {"
NSQ_SOURCE_LINE 00000289 "        if (my $fat = $_[0]{$_[1]}) {"
NSQ_SOURCE_LINE 00000290 "          my $pos = 0;"
NSQ_SOURCE_LINE 00000291 "          my $last = length $fat;"
NSQ_SOURCE_LINE 00000292 "          return (sub {"
NSQ_SOURCE_LINE 00000293 "            return 0 if $pos == $last;"
NSQ_SOURCE_LINE 00000294 "            my $next = (1 + index $fat, \"\\n\", $pos) || $last;"
NSQ_SOURCE_LINE 00000295 "            $_ .= substr $fat, $pos, $next - $pos;"
NSQ_SOURCE_LINE 00000296 "            $pos = $next;"
NSQ_SOURCE_LINE 00000297 "            return 1;"
NSQ_SOURCE_LINE 00000298 "          });"
NSQ_SOURCE_LINE 00000299 "        }"
NSQ_SOURCE_LINE 00000300 "      };"
NSQ_SOURCE_LINE 00000301 "    }"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "    else {"
NSQ_SOURCE_LINE 00000304 "      *{\"${class}::INC\"} = sub {"
NSQ_SOURCE_LINE 00000305 "        if (my $fat = $_[0]{$_[1]}) {"
NSQ_SOURCE_LINE 00000306 "          open my $fh, '<', \\$fat"
NSQ_SOURCE_LINE 00000307 "            or die \"FatPacker error loading $_[1] (could be a perl installation issue?)\";"
NSQ_SOURCE_LINE 00000308 "          return $fh;"
NSQ_SOURCE_LINE 00000309 "        }"
NSQ_SOURCE_LINE 00000310 "        return;"
NSQ_SOURCE_LINE 00000311 "      };"
NSQ_SOURCE_LINE 00000312 "    }"
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "    unshift @INC, bless \\%fatpacked, $class;"
NSQ_SOURCE_LINE 00000315 "  } # END OF FATPACK CODE"
NSQ_SOURCE_LINE 00000316 "  END_END"
NSQ_SOURCE_LINE 00000317 "}"
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "sub fatpack_code {"
NSQ_SOURCE_LINE 00000320 "  my ($self, $files) = @_;"
NSQ_SOURCE_LINE 00000321 "  my @segments = map {"
NSQ_SOURCE_LINE 00000322 "    (my $stub = $_) =~ s/\\.pm$//;"
NSQ_SOURCE_LINE 00000323 "    my $name = uc join '_', split '/', $stub;"
NSQ_SOURCE_LINE 00000324 "    my $data = $files->{$_}; $data =~ s/^/  /mg; $data =~ s/(?<!\\n)\\z/\\n/;"
NSQ_SOURCE_LINE 00000325 "    '$fatpacked{'.perlstring($_).qq!} = '#line '.(1+__LINE__).' \"'.__FILE__.\"\\\\\"\\\\n\".<<'${name}';\\n!"
NSQ_SOURCE_LINE 00000326 "    .qq!${data}${name}\\n!;"
NSQ_SOURCE_LINE 00000327 "  } sort keys %$files;"
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "  return join \"\\n\", $self->fatpack_start, @segments, $self->fatpack_end;"
NSQ_SOURCE_LINE 00000330 "}"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "=head1 NAME"
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "App::FatPacker - pack your dependencies onto your script file"
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "  $ fatpack pack myscript.pl >myscript.packed.pl"
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "Or, with more step-by-step control:"
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "  $ fatpack trace myscript.pl"
NSQ_SOURCE_LINE 00000345 "  $ fatpack packlists-for `cat fatpacker.trace` >packlists"
NSQ_SOURCE_LINE 00000346 "  $ fatpack tree `cat packlists`"
NSQ_SOURCE_LINE 00000347 "  $ fatpack file myscript.pl >myscript.packed.pl"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "Each command is designed to be simple and self-contained so that you can modify"
NSQ_SOURCE_LINE 00000350 "the input/output of each step as needed. See the documentation for the"
NSQ_SOURCE_LINE 00000351 "L<fatpack> script itself for more information."
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "The programmatic API for this code is not yet fully decided, hence the 0.x"
NSQ_SOURCE_LINE 00000354 "release version. Expect that to be cleaned up for 1.0."
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "=head1 CAVEATS"
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 "As dependency module code is copied into the resulting file as text, only"
NSQ_SOURCE_LINE 00000359 "pure-perl dependencies can be packed, not compiled XS code."
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "The currently-installed dependencies to pack are found via F<.packlist> files,"
NSQ_SOURCE_LINE 00000362 "which are generally only included in non-core distributions that were installed"
NSQ_SOURCE_LINE 00000363 "by a CPAN installer. This is a feature; see L<fatpack/packlists-for> for"
NSQ_SOURCE_LINE 00000364 "details. (a notable exception to this is FreeBSD, which, since its packaging"
NSQ_SOURCE_LINE 00000365 "system is designed to work equivalently to a source install, does preserve"
NSQ_SOURCE_LINE 00000366 "the packlist files)"
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "L<article for Perl Advent 2012|http://www.perladvent.org/2012/2012-12-14.html>"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "L<pp> - PAR Packager, a much more complex architecture-dependent packer that"
NSQ_SOURCE_LINE 00000373 "can pack compiled code and even a Perl interpreter"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "=head1 SUPPORT"
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "Bugs may be submitted through L<the RT bug tracker|https://rt.cpan.org/Public/Dist/Display.html?Name=App-FatPacker>"
NSQ_SOURCE_LINE 00000378 "(or L<bug-App-FatPacker@rt.cpan.org|mailto:bug-App-FatPacker@rt.cpan.org>)."
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "You can normally also obtain assistance on irc, in #toolchain on irc.perl.org."
NSQ_SOURCE_LINE 00000381 ""
