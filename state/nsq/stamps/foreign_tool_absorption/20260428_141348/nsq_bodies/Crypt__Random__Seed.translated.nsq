NSQ_SOURCE_LINE 00000001 "package Crypt::Random::Seed;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use warnings;"
NSQ_SOURCE_LINE 00000004 "use Fcntl;"
NSQ_SOURCE_LINE 00000005 "use Carp qw/carp croak/;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "# cert insists on using constant, but regular critic doesn't like it."
NSQ_SOURCE_LINE 00000008 "## no critic (constant)"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "BEGIN {"
NSQ_SOURCE_LINE 00000011 "  $Crypt::Random::Seed::AUTHORITY = 'cpan:DANAJ';"
NSQ_SOURCE_LINE 00000012 "  $Crypt::Random::Seed::VERSION = '0.03';"
NSQ_SOURCE_LINE 00000013 "}"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "use base qw( Exporter );"
NSQ_SOURCE_LINE 00000016 "our @EXPORT_OK = qw( );"
NSQ_SOURCE_LINE 00000017 "our %EXPORT_TAGS = (all => [ @EXPORT_OK ]);"
NSQ_SOURCE_LINE 00000018 "# Export nothing by default"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "use constant UINT32_SIZE => 4;"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "# These are the pre-defined names.  We don't let user methods use these."
NSQ_SOURCE_LINE 00000023 "my %defined_methods = map { $_ => 1 }"
NSQ_SOURCE_LINE 00000024 "  (qw(CryptGenRandom RtlGenRand EGD /dev/random /dev/urandom"
NSQ_SOURCE_LINE 00000025 "      TESHA2-strong TESHA2-weak));"
NSQ_SOURCE_LINE 00000026 "# If given one of these names as whitelist/blacklist, we add these also."
NSQ_SOURCE_LINE 00000027 "my %name_aliases = ("
NSQ_SOURCE_LINE 00000028 "  'Win32'  => [qw(RtlGenRand CryptGenRandom)],"
NSQ_SOURCE_LINE 00000029 "  'TESHA2' => [qw(TESHA2-strong TESHA2-weak)],"
NSQ_SOURCE_LINE 00000030 ");"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "sub new {"
NSQ_SOURCE_LINE 00000033 "  my ($class, %params) = @_;"
NSQ_SOURCE_LINE 00000034 "  my $self = {};"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "  # Trying to handle strong vs. weak is fraught with complication, so just"
NSQ_SOURCE_LINE 00000037 "  # remove the idea entirely."
NSQ_SOURCE_LINE 00000038 "  if (defined $params{Weak}) {"
NSQ_SOURCE_LINE 00000039 "    # In this release, just silently don't use it."
NSQ_SOURCE_LINE 00000040 "    delete $params{Weak};"
NSQ_SOURCE_LINE 00000041 "  }"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "  if (defined $params{Source}) {"
NSQ_SOURCE_LINE 00000044 "    if (ref($params{Source}) eq 'CODE') {"
NSQ_SOURCE_LINE 00000045 "      $self->{Name}      = 'User';"
NSQ_SOURCE_LINE 00000046 "      $self->{SourceSub} = $params{Source};"
NSQ_SOURCE_LINE 00000047 "      # We don't know if it is blocking or strong, assume neither"
NSQ_SOURCE_LINE 00000048 "      $self->{Blocking} = 0;"
NSQ_SOURCE_LINE 00000049 "      $self->{Strong} = 0;"
NSQ_SOURCE_LINE 00000050 "    } elsif (ref($params{Source}) eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000051 "      ($self->{Name}, $self->{SourceSub}, $self->{Blocking}, $self->{Strong})"
NSQ_SOURCE_LINE 00000052 "      = @{$params{Source}};"
NSQ_SOURCE_LINE 00000053 "      # For sanity, don't let them redefine the standard names."
NSQ_SOURCE_LINE 00000054 "      croak \"Invalid name: $self->{Name}.  Name reserved.\""
NSQ_SOURCE_LINE 00000055 "        if defined $defined_methods{$self->{Name}};"
NSQ_SOURCE_LINE 00000056 "    } else {"
NSQ_SOURCE_LINE 00000057 "      croak \"Invalid 'Source'.  Should be code or array reference.\";"
NSQ_SOURCE_LINE 00000058 "    }"
NSQ_SOURCE_LINE 00000059 "  } else {"
NSQ_SOURCE_LINE 00000060 "    # This is a sorted list -- the first one that returns true gets used."
NSQ_SOURCE_LINE 00000061 "    my @methodlist = ("
NSQ_SOURCE_LINE 00000062 "       \\&_try_win32,"
NSQ_SOURCE_LINE 00000063 "       \\&_try_egd,"
NSQ_SOURCE_LINE 00000064 "       \\&_try_dev_random,"
NSQ_SOURCE_LINE 00000065 "       \\&_try_dev_urandom,"
NSQ_SOURCE_LINE 00000066 "       \\&_try_tesha2,"
NSQ_SOURCE_LINE 00000067 "    );"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "    my %whitelist;"
NSQ_SOURCE_LINE 00000070 "    my $have_whitelist = 0;"
NSQ_SOURCE_LINE 00000071 "    if (defined $params{Only}) {"
NSQ_SOURCE_LINE 00000072 "      croak \"Parameter 'Only' must be an array ref\" unless ref($params{Only}) eq 'ARRAY';"
NSQ_SOURCE_LINE 00000073 "      $have_whitelist = 1;"
NSQ_SOURCE_LINE 00000074 "      $whitelist{$_} = 1 for @{$params{Only}};"
NSQ_SOURCE_LINE 00000075 "      while ( my($name, $list) = each %name_aliases) {"
NSQ_SOURCE_LINE 00000076 "        @whitelist{@$list} = (1) x scalar @$list if $whitelist{$name};"
NSQ_SOURCE_LINE 00000077 "      }"
NSQ_SOURCE_LINE 00000078 "    }"
NSQ_SOURCE_LINE 00000079 "    my %blacklist;"
NSQ_SOURCE_LINE 00000080 "    if (defined $params{Never}) {"
NSQ_SOURCE_LINE 00000081 "      croak \"Parameter 'Never' must be an array ref\" unless ref($params{Never}) eq 'ARRAY';"
NSQ_SOURCE_LINE 00000082 "      $blacklist{$_} = 1 for @{$params{Never}};"
NSQ_SOURCE_LINE 00000083 "      while ( my($name, $list) = each %name_aliases) {"
NSQ_SOURCE_LINE 00000084 "        @blacklist{@$list} = (1) x scalar @$list if $blacklist{$name};"
NSQ_SOURCE_LINE 00000085 "      }"
NSQ_SOURCE_LINE 00000086 "    }"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "    foreach my $m (@methodlist) {"
NSQ_SOURCE_LINE 00000089 "      my ($name, $rsub, $isblocking, $isstrong) = $m->();"
NSQ_SOURCE_LINE 00000090 "      next unless defined $name;"
NSQ_SOURCE_LINE 00000091 "      next if $isblocking && ($params{NonBlocking} || $params{Nonblocking} || $params{nonblocking});"
NSQ_SOURCE_LINE 00000092 "      #next if !$isstrong && !$params{Weak};"
NSQ_SOURCE_LINE 00000093 "      next if $blacklist{$name};"
NSQ_SOURCE_LINE 00000094 "      next if $have_whitelist && !$whitelist{$name};"
NSQ_SOURCE_LINE 00000095 "      $self->{Name}      = $name;"
NSQ_SOURCE_LINE 00000096 "      $self->{SourceSub} = $rsub;"
NSQ_SOURCE_LINE 00000097 "      $self->{Blocking}  = $isblocking;"
NSQ_SOURCE_LINE 00000098 "      $self->{Strong}    = $isstrong;"
NSQ_SOURCE_LINE 00000099 "      last;"
NSQ_SOURCE_LINE 00000100 "    }"
NSQ_SOURCE_LINE 00000101 "  }"
NSQ_SOURCE_LINE 00000102 "  # Couldn't find anything appropriate"
NSQ_SOURCE_LINE 00000103 "  return unless defined $self->{SourceSub};"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "  bless $self, $class;"
NSQ_SOURCE_LINE 00000106 "  return $self;"
NSQ_SOURCE_LINE 00000107 "}"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "# Nothing special to do on destroy"
NSQ_SOURCE_LINE 00000110 "#sub DESTROY {"
NSQ_SOURCE_LINE 00000111 "#  my $self = shift;"
NSQ_SOURCE_LINE 00000112 "#  delete $self->{$_} for keys $self;"
NSQ_SOURCE_LINE 00000113 "#  return;"
NSQ_SOURCE_LINE 00000114 "#}"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "sub name {"
NSQ_SOURCE_LINE 00000117 "  my $self = shift;"
NSQ_SOURCE_LINE 00000118 "  return $self->{Name};"
NSQ_SOURCE_LINE 00000119 "}"
NSQ_SOURCE_LINE 00000120 "sub is_blocking {"
NSQ_SOURCE_LINE 00000121 "  my $self = shift;"
NSQ_SOURCE_LINE 00000122 "  return $self->{Blocking};"
NSQ_SOURCE_LINE 00000123 "}"
NSQ_SOURCE_LINE 00000124 "sub is_strong {"
NSQ_SOURCE_LINE 00000125 "  my $self = shift;"
NSQ_SOURCE_LINE 00000126 "  return $self->{Strong};"
NSQ_SOURCE_LINE 00000127 "}"
NSQ_SOURCE_LINE 00000128 "sub random_bytes {"
NSQ_SOURCE_LINE 00000129 "  my ($self, $nbytes) = @_;"
NSQ_SOURCE_LINE 00000130 "  return '' unless defined $nbytes && int($nbytes) > 0;"
NSQ_SOURCE_LINE 00000131 "  my $rsub = $self->{SourceSub};"
NSQ_SOURCE_LINE 00000132 "  return unless defined $rsub;"
NSQ_SOURCE_LINE 00000133 "  return $rsub->(int($nbytes));"
NSQ_SOURCE_LINE 00000134 "}"
NSQ_SOURCE_LINE 00000135 "sub random_values {"
NSQ_SOURCE_LINE 00000136 "  my ($self, $nvalues) = @_;"
NSQ_SOURCE_LINE 00000137 "  return unless defined $nvalues && int($nvalues) > 0;"
NSQ_SOURCE_LINE 00000138 "  my $rsub = $self->{SourceSub};"
NSQ_SOURCE_LINE 00000139 "  return unless defined $rsub;"
NSQ_SOURCE_LINE 00000140 "  return unpack( 'L*', $rsub->(UINT32_SIZE * int($nvalues)) );"
NSQ_SOURCE_LINE 00000141 "}"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "sub _try_tesha2 {"
NSQ_SOURCE_LINE 00000145 "  eval { require Crypt::Random::TESHA2; Crypt::Random::TESHA2->import(); 1; }"
NSQ_SOURCE_LINE 00000146 "  or return;"
NSQ_SOURCE_LINE 00000147 "  my $isstrong = Crypt::Random::TESHA2::is_strong();"
NSQ_SOURCE_LINE 00000148 "  my $name = join('-', 'TESHA2', ($isstrong) ? 'strong' : 'weak');"
NSQ_SOURCE_LINE 00000149 "  return ($name, \\&Crypt::Random::TESHA2::random_bytes, 0, 1);"
NSQ_SOURCE_LINE 00000150 "}"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "sub _try_dev_urandom {"
NSQ_SOURCE_LINE 00000153 "  return unless -r \"/dev/urandom\";"
NSQ_SOURCE_LINE 00000154 "  return ('/dev/urandom', sub { __read_file('/dev/urandom', @_); }, 0, 0);"
NSQ_SOURCE_LINE 00000155 "}"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "sub _try_dev_random {"
NSQ_SOURCE_LINE 00000158 "  return unless -r \"/dev/random\";"
NSQ_SOURCE_LINE 00000159 "  # FreeBSD's /dev/random is 256-bit Yarrow non-blocking."
NSQ_SOURCE_LINE 00000160 "  # Is it 'strong'?  Debatable -- we'll say it is."
NSQ_SOURCE_LINE 00000161 "  my $blocking = ($^O eq 'freebsd') ? 0 : 1;"
NSQ_SOURCE_LINE 00000162 "  return ('/dev/random', sub { __read_file('/dev/random', @_); }, $blocking, 1);"
NSQ_SOURCE_LINE 00000163 "}"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "sub __read_file {"
NSQ_SOURCE_LINE 00000166 "  my ($file, $nbytes) = @_;"
NSQ_SOURCE_LINE 00000167 "  return unless defined $nbytes && $nbytes > 0;"
NSQ_SOURCE_LINE 00000168 "  sysopen(my $fh, $file, O_RDONLY);"
NSQ_SOURCE_LINE 00000169 "  binmode $fh;"
NSQ_SOURCE_LINE 00000170 "  my($s, $buffer, $nread) = ('', '', 0);"
NSQ_SOURCE_LINE 00000171 "  while ($nread < $nbytes) {"
NSQ_SOURCE_LINE 00000172 "    my $thisread = sysread $fh, $buffer, $nbytes-$nread;"
NSQ_SOURCE_LINE 00000173 "    # Count EOF as an error."
NSQ_SOURCE_LINE 00000174 "    croak \"Error reading $file: $!\\n\" unless defined $thisread && $thisread > 0;"
NSQ_SOURCE_LINE 00000175 "    $s .= $buffer;"
NSQ_SOURCE_LINE 00000176 "    $nread += length($buffer);"
NSQ_SOURCE_LINE 00000177 "    #die unless $nread == length($s);  # assert"
NSQ_SOURCE_LINE 00000178 "  }"
NSQ_SOURCE_LINE 00000179 "  croak \"Internal file read error: wanted $nbytes, read $nread\""
NSQ_SOURCE_LINE 00000180 "      unless $nbytes == length($s);  # assert"
NSQ_SOURCE_LINE 00000181 "  return $s;"
NSQ_SOURCE_LINE 00000182 "}"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "# Most of this is taken without notice from Crypt::URandom 0.28 and"
NSQ_SOURCE_LINE 00000185 "# Crypt::Random::Source::Strong::Win32 0.07."
NSQ_SOURCE_LINE 00000186 "# Kudos to David Dick and Max Kanat-Alexander for doing all the work."
NSQ_SOURCE_LINE 00000187 "#"
NSQ_SOURCE_LINE 00000188 "# See some documentation here:"
NSQ_SOURCE_LINE 00000189 "#   http://msdn.microsoft.com/en-us/library/aa379942.aspx"
NSQ_SOURCE_LINE 00000190 "# where they note that the output of these is really a well seeded CSPRNG:"
NSQ_SOURCE_LINE 00000191 "# either FIPS 186-2 (older) or AES-CTR (Vista SP1 and newer)."
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "sub _try_win32 {"
NSQ_SOURCE_LINE 00000194 "  return unless $^O eq 'MSWin32';"
NSQ_SOURCE_LINE 00000195 "  # Cygwin has /dev/random at least as far back as 2000."
NSQ_SOURCE_LINE 00000196 "  eval { require Win32; require Win32::API; require Win32::API::Type; 1; }"
NSQ_SOURCE_LINE 00000197 "  or return;"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "  use constant CRYPT_SILENT      => 0x40;       # Never display a UI."
NSQ_SOURCE_LINE 00000200 "  use constant PROV_RSA_FULL     => 1;          # Which service provider."
NSQ_SOURCE_LINE 00000201 "  use constant VERIFY_CONTEXT    => 0xF0000000; # Don't need existing keypairs."
NSQ_SOURCE_LINE 00000202 "  use constant W2K_MAJOR_VERSION => 5;          # Windows 2000"
NSQ_SOURCE_LINE 00000203 "  use constant W2K_MINOR_VERSION => 0;"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "  my ($major, $minor) = (Win32::GetOSVersion())[1, 2];"
NSQ_SOURCE_LINE 00000206 "  return if $major < W2K_MAJOR_VERSION;"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "  if ($major == W2K_MAJOR_VERSION && $minor == W2K_MINOR_VERSION) {"
NSQ_SOURCE_LINE 00000209 "    # We are Windows 2000.  Use the older CryptGenRandom interface."
NSQ_SOURCE_LINE 00000210 "    my $crypt_acquire_context_a ="
NSQ_SOURCE_LINE 00000211 "              Win32::API->new( 'advapi32', 'CryptAcquireContextA', 'PPPNN',"
NSQ_SOURCE_LINE 00000212 "                'I' );"
NSQ_SOURCE_LINE 00000213 "    return unless defined $crypt_acquire_context_a;"
NSQ_SOURCE_LINE 00000214 "    my $context = chr(0) x Win32::API::Type->sizeof('PULONG');"
NSQ_SOURCE_LINE 00000215 "    my $result = $crypt_acquire_context_a->Call("
NSQ_SOURCE_LINE 00000216 "             $context, 0, 0, PROV_RSA_FULL, CRYPT_SILENT | VERIFY_CONTEXT );"
NSQ_SOURCE_LINE 00000217 "    return unless $result;"
NSQ_SOURCE_LINE 00000218 "    my $pack_type = Win32::API::Type::packing('PULONG');"
NSQ_SOURCE_LINE 00000219 "    $context = unpack $pack_type, $context;"
NSQ_SOURCE_LINE 00000220 "    my $crypt_gen_random ="
NSQ_SOURCE_LINE 00000221 "              Win32::API->new( 'advapi32', 'CryptGenRandom', 'NNP', 'I' );"
NSQ_SOURCE_LINE 00000222 "    return unless defined $crypt_gen_random;"
NSQ_SOURCE_LINE 00000223 "    return ('CryptGenRandom',"
NSQ_SOURCE_LINE 00000224 "            sub {"
NSQ_SOURCE_LINE 00000225 "              my $nbytes = shift;"
NSQ_SOURCE_LINE 00000226 "              my $buffer = chr(0) x $nbytes;"
NSQ_SOURCE_LINE 00000227 "              my $result = $crypt_gen_random->Call($context, $nbytes, $buffer);"
NSQ_SOURCE_LINE 00000228 "              croak \"CryptGenRandom failed: $^E\" unless $result;"
NSQ_SOURCE_LINE 00000229 "              return $buffer;"
NSQ_SOURCE_LINE 00000230 "            },"
NSQ_SOURCE_LINE 00000231 "            0, 1);  # Assume non-blocking and strong"
NSQ_SOURCE_LINE 00000232 "  } else {"
NSQ_SOURCE_LINE 00000233 "    my $rtlgenrand = Win32::API->new( 'advapi32', <<'_RTLGENRANDOM_PROTO_');"
NSQ_SOURCE_LINE 00000234 "INT SystemFunction036("
NSQ_SOURCE_LINE 00000235 "  PVOID RandomBuffer,"
NSQ_SOURCE_LINE 00000236 "  ULONG RandomBufferLength"
NSQ_SOURCE_LINE 00000237 ")"
NSQ_SOURCE_LINE 00000238 "_RTLGENRANDOM_PROTO_"
NSQ_SOURCE_LINE 00000239 "    return unless defined $rtlgenrand;"
NSQ_SOURCE_LINE 00000240 "    return ('RtlGenRand',"
NSQ_SOURCE_LINE 00000241 "            sub {"
NSQ_SOURCE_LINE 00000242 "              my $nbytes = shift;"
NSQ_SOURCE_LINE 00000243 "              my $buffer = chr(0) x $nbytes;"
NSQ_SOURCE_LINE 00000244 "              my $result = $rtlgenrand->Call($buffer, $nbytes);"
NSQ_SOURCE_LINE 00000245 "              croak \"RtlGenRand failed: $^E\" unless $result;"
NSQ_SOURCE_LINE 00000246 "              return $buffer;"
NSQ_SOURCE_LINE 00000247 "            },"
NSQ_SOURCE_LINE 00000248 "            0, 1);  # Assume non-blocking and strong"
NSQ_SOURCE_LINE 00000249 "  }"
NSQ_SOURCE_LINE 00000250 "  return;"
NSQ_SOURCE_LINE 00000251 "}"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "sub _try_egd {"
NSQ_SOURCE_LINE 00000254 "  # For locations, we'll look in the files OpenSSL's RAND_egd looks, as well"
NSQ_SOURCE_LINE 00000255 "  # as /etc/entropy which egd 0.9 recommends.  This also works with PRNGD."
NSQ_SOURCE_LINE 00000256 "  # PRNGD uses a seed+CSPRNG so is non-blocking, but we can't tell them apart."
NSQ_SOURCE_LINE 00000257 "  foreach my $device (qw( /var/run/egd-pool /dev/egd-pool /etc/egd-pool /etc/entropy )) {"
NSQ_SOURCE_LINE 00000258 "    next unless -r $device && -S $device;"
NSQ_SOURCE_LINE 00000259 "    eval { require IO::Socket; 1; } or return;"
NSQ_SOURCE_LINE 00000260 "    # We're looking for a socket that returns the entropy available when given"
NSQ_SOURCE_LINE 00000261 "    # that command.  Set timeout to 1 to prevent hanging -- if it is a socket"
NSQ_SOURCE_LINE 00000262 "    # but won't return the available entropy in under a second, move on."
NSQ_SOURCE_LINE 00000263 "    my $socket = IO::Socket::UNIX->new(Peer => $device, Timeout => 1);"
NSQ_SOURCE_LINE 00000264 "    next unless $socket;"
NSQ_SOURCE_LINE 00000265 "    $socket->syswrite( pack(\"C\", 0x00), 1) or next;"
NSQ_SOURCE_LINE 00000266 "    die if $socket->error;"
NSQ_SOURCE_LINE 00000267 "    my($entropy_string, $nread);"
NSQ_SOURCE_LINE 00000268 "    # Sadly this doesn't honor the timeout.  We'll have to do an eval / alarm."
NSQ_SOURCE_LINE 00000269 "    # We only timeout here if this is a live socket to a sleeping process."
NSQ_SOURCE_LINE 00000270 "    eval {"
NSQ_SOURCE_LINE 00000271 "      local $SIG{ALRM} = sub { die \"alarm\\n\" };"
NSQ_SOURCE_LINE 00000272 "      alarm 1;"
NSQ_SOURCE_LINE 00000273 "      $nread = $socket->sysread($entropy_string, 4);"
NSQ_SOURCE_LINE 00000274 "      alarm 0;"
NSQ_SOURCE_LINE 00000275 "    };"
NSQ_SOURCE_LINE 00000276 "    if ($@) {"
NSQ_SOURCE_LINE 00000277 "      die unless $@ eq \"alarm\\n\";"
NSQ_SOURCE_LINE 00000278 "      next;"
NSQ_SOURCE_LINE 00000279 "    }"
NSQ_SOURCE_LINE 00000280 "    next unless defined $nread && $nread == 4;"
NSQ_SOURCE_LINE 00000281 "    my $entropy_avail = unpack(\"N\", $entropy_string);"
NSQ_SOURCE_LINE 00000282 "    return ('EGD', sub { __read_egd($device, @_); }, 1, 1);"
NSQ_SOURCE_LINE 00000283 "  }"
NSQ_SOURCE_LINE 00000284 "  return;"
NSQ_SOURCE_LINE 00000285 "}"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "sub __read_egd {"
NSQ_SOURCE_LINE 00000288 "  my ($device, $nbytes) = @_;"
NSQ_SOURCE_LINE 00000289 "  return unless defined $device;"
NSQ_SOURCE_LINE 00000290 "  return unless defined $nbytes && int($nbytes) > 0;"
NSQ_SOURCE_LINE 00000291 "  croak \"$device doesn't exist!\" unless -r $device && -S $device;"
NSQ_SOURCE_LINE 00000292 "  my $socket = IO::Socket::UNIX->new(Peer => $device);"
NSQ_SOURCE_LINE 00000293 "  croak \"Can't talk to EGD on $device. $!\" unless $socket;"
NSQ_SOURCE_LINE 00000294 "  my($s, $buffer, $toread) = ('', '', $nbytes);"
NSQ_SOURCE_LINE 00000295 "  while ($toread > 0) {"
NSQ_SOURCE_LINE 00000296 "    my $this_request = ($toread > 255) ? 255 : $toread;"
NSQ_SOURCE_LINE 00000297 "    # Use the blocking interface."
NSQ_SOURCE_LINE 00000298 "    $socket->syswrite( pack(\"CC\", 0x02, $this_request), 2);"
NSQ_SOURCE_LINE 00000299 "    my $this_grant = $socket->sysread($buffer, $this_request);"
NSQ_SOURCE_LINE 00000300 "    croak \"Error reading EDG data from $device: $!\\n\""
NSQ_SOURCE_LINE 00000301 "          unless defined $this_grant && $this_grant == $this_request;"
NSQ_SOURCE_LINE 00000302 "    $s .= $buffer;"
NSQ_SOURCE_LINE 00000303 "    $toread -= length($buffer);"
NSQ_SOURCE_LINE 00000304 "  }"
NSQ_SOURCE_LINE 00000305 "  croak \"Internal EGD read error: wanted $nbytes, read \", length($s), \"\""
NSQ_SOURCE_LINE 00000306 "      unless $nbytes == length($s);  # assert"
NSQ_SOURCE_LINE 00000307 "  return $s;"
NSQ_SOURCE_LINE 00000308 "}"
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "1;"
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "__END__"
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "# ABSTRACT: Simple method to get strong randomness"
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "=pod"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "=head1 NAME"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "Crypt::Random::Seed - Simple method to get strong randomness"
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "=head1 VERSION"
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "Version 0.03"
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "  use Crypt::Random::Seed;"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "  my $source = new Crypt::Random::Seed;"
NSQ_SOURCE_LINE 00000333 "  die \"No strong sources exist\" unless defined $source;"
NSQ_SOURCE_LINE 00000334 "  my $seed_string = $source->random_bytes(4);"
NSQ_SOURCE_LINE 00000335 "  my @seed_values = $source->random_values(4);"
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "  # Only non-blocking sources"
NSQ_SOURCE_LINE 00000338 "  my $nonblocking_source = Crypt::Random::Seed->new( NonBlocking=>1 );"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "  # Blacklist sources (never choose the listed sources)"
NSQ_SOURCE_LINE 00000341 "  my $nowin32_source = Crypt::Random::Seed->new( Never=>['Win32'] );"
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "  # Whitelist sources (only choose from these sources)"
NSQ_SOURCE_LINE 00000344 "  my $devr_source = Crypt::Random::Seed->new( Only=>['TESHA2'] );"
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "  # Supply a custom source."
NSQ_SOURCE_LINE 00000347 "  my $user_src = Crypt::Random::Seed->new( Source=>sub { myfunc(shift) } );"
NSQ_SOURCE_LINE 00000348 "  # Or supply a list of [name, sub, is_blocking, is_strong]"
NSQ_SOURCE_LINE 00000349 "  $user_src = Crypt::Random::Seed->new("
NSQ_SOURCE_LINE 00000350 "     Source=>['MyRandomFunction',sub {myfunc(shift)},0,1] );"
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "  # Given a source there are a few things we can do:"
NSQ_SOURCE_LINE 00000353 "  say \"My randomness source is \", $source->name();"
NSQ_SOURCE_LINE 00000354 "  say \"I am a blocking source\" if $source->is_blocking();"
NSQ_SOURCE_LINE 00000355 "  say \"I am a strong randomness source\" if $source->is_strong()"
NSQ_SOURCE_LINE 00000356 "  say \"Four 8-bit numbers:\","
NSQ_SOURCE_LINE 00000357 "      join(\",\", map { ord $source->random_bytes(1) } 1..4);'"
NSQ_SOURCE_LINE 00000358 "  say \"Four 32-bit numbers:\", join(\",\", $source->random_values(4));"
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "A simple mechanism to get strong randomness.  The main purpose of this"
NSQ_SOURCE_LINE 00000364 "module is to provide a simple way to generate a seed for a PRNG such as"
NSQ_SOURCE_LINE 00000365 "L<Math::Random::ISAAC>, for use in cryptographic key generation, or as the"
NSQ_SOURCE_LINE 00000366 "seed for an upstream module such as L<Bytes::Random::Secure>.  Flags for"
NSQ_SOURCE_LINE 00000367 "requiring non-blocking sources are allowed, as well as a very simple"
NSQ_SOURCE_LINE 00000368 "method for plugging in a source."
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "The randomness sources used are, in order:"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "=over 4"
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "=item User supplied."
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "If the constructor is called with a Source defined, then it is used.  It"
NSQ_SOURCE_LINE 00000377 "is not checked vs. other flags (NonBlocking, Never, Only)."
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "=item Win32 Crypto API."
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "This will use C<CryptGenRandom> on Windows 2000 and C<RtlGenRand> on"
NSQ_SOURCE_LINE 00000382 "Windows XP and newer.  According to MSDN, these are well-seeded CSPRNGs"
NSQ_SOURCE_LINE 00000383 "(FIPS 186-2 or AES-CTR), so will be non-blocking."
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "=item EGD / PRNGD."
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "This looks for sockets that speak the L<EGD|http://egd.sourceforge.net/>"
NSQ_SOURCE_LINE 00000388 "protocol, including L<PRNGD|http://prngd.sourceforge.net/>.  These are"
NSQ_SOURCE_LINE 00000389 "userspace entropy daemons that are commonly used by OpenSSL, OpenSSH, and"
NSQ_SOURCE_LINE 00000390 "GnuGP.  The locations searched are C</var/run/egd-pool>, C</dev/egd-pool>,"
NSQ_SOURCE_LINE 00000391 "C</etc/egd-pool>, and C</etc/entropy>.  EGD is blocking, while PRNGD is"
NSQ_SOURCE_LINE 00000392 "non-blocking (like the Win32 API, it is really a seeded CSPRNG).  However"
NSQ_SOURCE_LINE 00000393 "there is no way to tell them apart, so we treat it as blocking.  If your"
NSQ_SOURCE_LINE 00000394 "O/S supports /dev/random, consider L<HAVEGED|http://www.issihosts.com/haveged/>"
NSQ_SOURCE_LINE 00000395 "as an alternative (a system daemon that refills /dev/random as needed)."
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "=item /dev/random."
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "The strong source of randomness on most UNIX-like systems.  Cygwin uses"
NSQ_SOURCE_LINE 00000400 "this, though it maps to the Win32 API.  On almost all systems this is a"
NSQ_SOURCE_LINE 00000401 "blocking source of randomness -- if it runs out of estimated entropy, it"
NSQ_SOURCE_LINE 00000402 "will hang until more has come into the system.  If this is an issue,"
NSQ_SOURCE_LINE 00000403 "which it often is on embedded devices, running a tool such as"
NSQ_SOURCE_LINE 00000404 "L<HAVEGED|http://www.issihosts.com/haveged/> will help immensely."
NSQ_SOURCE_LINE 00000405 ""
NSQ_SOURCE_LINE 00000406 "=item /dev/urandom."
NSQ_SOURCE_LINE 00000407 ""
NSQ_SOURCE_LINE 00000408 "A nonblocking source of randomness that we label as weak, since it will"
NSQ_SOURCE_LINE 00000409 "continue providing output even if the actual entropy has been exhausted."
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "=item TESHA2."
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "L<Crypt::Random::TESHA2> is a Perl module that generates random bytes from"
NSQ_SOURCE_LINE 00000414 "an entropy pool fed with timer/scheduler variations.  Measurements and"
NSQ_SOURCE_LINE 00000415 "tests are performed on installation to determine whether the source is"
NSQ_SOURCE_LINE 00000416 "considered strong or weak.  This is entirely in portable userspace,"
NSQ_SOURCE_LINE 00000417 "which is good for ease of use, but really requires user verification"
NSQ_SOURCE_LINE 00000418 "that it is working as expected if we expect it to be strong.  The"
NSQ_SOURCE_LINE 00000419 "concept is similar to L<Math::TrulyRandom> though updated to something"
NSQ_SOURCE_LINE 00000420 "closer to what TrueRand 2.1 does vs. the obsolete version 1 that"
NSQ_SOURCE_LINE 00000421 "L<Math::TrulyRandom> implements.  It is very slow and has wide speed"
NSQ_SOURCE_LINE 00000422 "variability across platforms : I've seen numbers ranging from 40 to"
NSQ_SOURCE_LINE 00000423 "150,000 bits per second."
NSQ_SOURCE_LINE 00000424 ""
NSQ_SOURCE_LINE 00000425 "=back"
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 "A source can also be supplied in the constructor.  Each of these sources will"
NSQ_SOURCE_LINE 00000428 "have its debatable points about perceived strength.  E.g. Why is /dev/urandom"
NSQ_SOURCE_LINE 00000429 "considered weak while Win32 is strong?  Can any userspace method such as"
NSQ_SOURCE_LINE 00000430 "TrueRand or TESHA2 be considered strong?"
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "=head2 SOURCE TABLE"
NSQ_SOURCE_LINE 00000434 ""
NSQ_SOURCE_LINE 00000435 "This table summarizes the default sources:"
NSQ_SOURCE_LINE 00000436 ""
NSQ_SOURCE_LINE 00000437 "  +------------------+-------------+------------+--------------------+"
NSQ_SOURCE_LINE 00000438 "  |      SOURCE      |  STRENGTH   |  BLOCKING  |       NOTE         |"
NSQ_SOURCE_LINE 00000439 "  |------------------+-------------+------------+--------------------|"
NSQ_SOURCE_LINE 00000440 "  | RtlGenRandom     |   Strong(1) |     No     | Default WinXP+     |"
NSQ_SOURCE_LINE 00000441 "  |------------------+-------------+------------+--------------------|"
NSQ_SOURCE_LINE 00000442 "  | CryptGenRandom   |   Strong(1) |     No     | Default Win2000    |"
NSQ_SOURCE_LINE 00000443 "  |------------------+-------------+------------+--------------------|"
NSQ_SOURCE_LINE 00000444 "  | EGD              |   Strong    |    Yes(2)  | also PRNGD, etc.   |"
NSQ_SOURCE_LINE 00000445 "  |------------------+-------------+------------+--------------------|"
NSQ_SOURCE_LINE 00000446 "  | /dev/random      |   Strong    |    Yes     | Typical UNIX       |"
NSQ_SOURCE_LINE 00000447 "  |------------------+-------------+------------+--------------------|"
NSQ_SOURCE_LINE 00000448 "  | /dev/urandom     |    Weak     |     No     | Typical UNIX NB    |"
NSQ_SOURCE_LINE 00000449 "  |------------------+-------------+------------+--------------------|"
NSQ_SOURCE_LINE 00000450 "  | TESHA2-strong    |   Strong    |     No     |                    |"
NSQ_SOURCE_LINE 00000451 "  |------------------+-------------+------------+--------------------|"
NSQ_SOURCE_LINE 00000452 "  | TESHA2-weak      |    Weak     |     No     |                    |"
NSQ_SOURCE_LINE 00000453 "  +------------------+-------------+------------+--------------------+"
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 "The alias 'Win32' can be used in whitelist and blacklist and will match both"
NSQ_SOURCE_LINE 00000456 "the Win32 sources C<RtlGenRandom> and C<CryptGenRandom>.  The alias 'TESHA2'"
NSQ_SOURCE_LINE 00000457 "may be similarly used and matches both the weak and strong sources."
NSQ_SOURCE_LINE 00000458 ""
NSQ_SOURCE_LINE 00000459 "  1) Both CryptGenRandom and RtlGenRandom are considered strong by this"
NSQ_SOURCE_LINE 00000460 "     package, even though both are seeded CSPRNGs so should be the equal of"
NSQ_SOURCE_LINE 00000461 "     /dev/urandom in this respect.  The CryptGenRandom function used in"
NSQ_SOURCE_LINE 00000462 "     Windows 2000 has some known issues so should be considered weaker."
NSQ_SOURCE_LINE 00000463 ""
NSQ_SOURCE_LINE 00000464 "  2) EGD is blocking, PRNGD is not.  We cannot tell the two apart.  There are"
NSQ_SOURCE_LINE 00000465 "     other software products that use the same protocol, and each will act"
NSQ_SOURCE_LINE 00000466 "     differently.  E.g. EGD mixes in system entropy on every request, while"
NSQ_SOURCE_LINE 00000467 "     PRNGD mixes on a time schedule."
NSQ_SOURCE_LINE 00000468 ""
NSQ_SOURCE_LINE 00000469 ""
NSQ_SOURCE_LINE 00000470 "=head2 STRENGTH"
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "In theory, a strong generator will provide true entropy.  Even if a third"
NSQ_SOURCE_LINE 00000473 "party knew a previous result and the entire state of the generator at any"
NSQ_SOURCE_LINE 00000474 "time up to when their value was returned, they could still not effectively"
NSQ_SOURCE_LINE 00000475 "predict the result of the next returned value.  This implies the generator"
NSQ_SOURCE_LINE 00000476 "must either be blocking to wait for entropy (e.g. /dev/random) or go through"
NSQ_SOURCE_LINE 00000477 "some possibly time-consuming process to gather it (TESHA2, EGD, the HAVEGE"
NSQ_SOURCE_LINE 00000478 "daemon refilling /dev/random).  Note: strong in this context means practically"
NSQ_SOURCE_LINE 00000479 "strong, as most computers don't have a true hardware entropy generator.  The"
NSQ_SOURCE_LINE 00000480 "goal is to make all the attackers ill-gotten knowledge give them no better"
NSQ_SOURCE_LINE 00000481 "solution than if they did not have the information."
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 "Creating a satisfactory strength measurement is problematic.  The Win32"
NSQ_SOURCE_LINE 00000484 "Crypto API is considered \"strong\" by most customers and every other Perl"
NSQ_SOURCE_LINE 00000485 "module, however it is a well seeded CSPRNG according to the MSDN docs,"
NSQ_SOURCE_LINE 00000486 "so is not a strong source based on the definition in the previous paragraph."
NSQ_SOURCE_LINE 00000487 "Similarly, almost all sources consider /dev/urandom to be weak, as once it"
NSQ_SOURCE_LINE 00000488 "runs out of entropy it returns a deterministic function based on its state"
NSQ_SOURCE_LINE 00000489 "(albeit one that cannot be run either direction from a returned result if the"
NSQ_SOURCE_LINE 00000490 "internal state is not known)."
NSQ_SOURCE_LINE 00000491 ""
NSQ_SOURCE_LINE 00000492 "Because of this confusion, I have removed the C<Weak> configuration option"
NSQ_SOURCE_LINE 00000493 "that was present in version 0.01.  It will now be ignored.  You should be"
NSQ_SOURCE_LINE 00000494 "able to use a combination of whitelist, blacklist, and the source's"
NSQ_SOURCE_LINE 00000495 "C<is_strong> return value to decide if this meets your needs.  On Win32, you"
NSQ_SOURCE_LINE 00000496 "really only have a choice of Win32 and TESHA2.  The former is going to be"
NSQ_SOURCE_LINE 00000497 "what most people want, and can be chosen even with non-blocking set.  On most"
NSQ_SOURCE_LINE 00000498 "UNIX systems, C</dev/random> will be chosen for blocking and C</dev/urandom>"
NSQ_SOURCE_LINE 00000499 "for non-blocking, which is what should be done in most cases."
NSQ_SOURCE_LINE 00000500 ""
NSQ_SOURCE_LINE 00000501 ""
NSQ_SOURCE_LINE 00000502 "=head2 BLOCKING"
NSQ_SOURCE_LINE 00000503 ""
NSQ_SOURCE_LINE 00000504 "EGD and /dev/random are blocking sources.  This means that if they run out of"
NSQ_SOURCE_LINE 00000505 "estimated entropy, they will pause until they've collected more.  This means"
NSQ_SOURCE_LINE 00000506 "your program also pauses.  On typical workstations this may be a few seconds"
NSQ_SOURCE_LINE 00000507 "or even minutes.  On an isolated network server this may cause a delay of"
NSQ_SOURCE_LINE 00000508 "hours or days.  EGD is proactive about gathering more entropy as fast as it"
NSQ_SOURCE_LINE 00000509 "can.  Running a tool such as the HAVEGE daemon or timer_entropyd can make"
NSQ_SOURCE_LINE 00000510 "/dev/random act like a non-blocking source, as the entropy daemon will wake"
NSQ_SOURCE_LINE 00000511 "up and refill the pool almost instantly."
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "Win32, PRNGD, and /dev/urandom are fast nonblocking sources.  When they run"
NSQ_SOURCE_LINE 00000514 "out of entropy, they use a CSPRNG to keep supplying data at high speed."
NSQ_SOURCE_LINE 00000515 "However this means that there is no additional entropy being supplied."
NSQ_SOURCE_LINE 00000516 ""
NSQ_SOURCE_LINE 00000517 "TESHA2 is nonblocking, but can be very slow.  /dev/random can be faster if run"
NSQ_SOURCE_LINE 00000518 "on a machine with lots of activity.  On an isolated server, TESHA2 may be"
NSQ_SOURCE_LINE 00000519 "much faster.  Also note that the blocking sources such as EGD and /dev/random"
NSQ_SOURCE_LINE 00000520 "both try to maintain reasonably large entropy pools, so small requests can be"
NSQ_SOURCE_LINE 00000521 "supplied without blocking."
NSQ_SOURCE_LINE 00000522 ""
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 "=head2 IN PRACTICE"
NSQ_SOURCE_LINE 00000525 ""
NSQ_SOURCE_LINE 00000526 "Use the default to get the best source known.  If you know more about the"
NSQ_SOURCE_LINE 00000527 "sources available, you can use a whitelist, blacklist, or a custom source."
NSQ_SOURCE_LINE 00000528 "In general, to get the best source (typically Win32 or /dev/random):"
NSQ_SOURCE_LINE 00000529 ""
NSQ_SOURCE_LINE 00000530 "  my $source = Crypt::Random::Seed->new();"
NSQ_SOURCE_LINE 00000531 ""
NSQ_SOURCE_LINE 00000532 "To get a good non-blocking source (Win32 or /dev/urandom):"
NSQ_SOURCE_LINE 00000533 ""
NSQ_SOURCE_LINE 00000534 "  my $source = Crypt::Random::Seed->new(NonBlocking => 1);"
NSQ_SOURCE_LINE 00000535 ""
NSQ_SOURCE_LINE 00000536 ""
NSQ_SOURCE_LINE 00000537 "=head1 METHODS"
NSQ_SOURCE_LINE 00000538 ""
NSQ_SOURCE_LINE 00000539 "=head2 new"
NSQ_SOURCE_LINE 00000540 ""
NSQ_SOURCE_LINE 00000541 "The constructor with no arguments will find the first available source in its"
NSQ_SOURCE_LINE 00000542 "fixed list and return an object that performs the defined methods.  If no"
NSQ_SOURCE_LINE 00000543 "sources could be found (quite unusual) then the returned value will be undef."
NSQ_SOURCE_LINE 00000544 ""
NSQ_SOURCE_LINE 00000545 "Optional parameters are passed in as a hash and may be mixed."
NSQ_SOURCE_LINE 00000546 ""
NSQ_SOURCE_LINE 00000547 "=head3 NonBlocking => I<boolean>"
NSQ_SOURCE_LINE 00000548 ""
NSQ_SOURCE_LINE 00000549 "Only non-blocking sources will be allowed.  In practice this means EGD"
NSQ_SOURCE_LINE 00000550 "and /dev/random will not be chosen (except on FreeBSD where it is"
NSQ_SOURCE_LINE 00000551 "non-blocking)."
NSQ_SOURCE_LINE 00000552 ""
NSQ_SOURCE_LINE 00000553 "=head3 Only => [I<list of strings>]"
NSQ_SOURCE_LINE 00000554 ""
NSQ_SOURCE_LINE 00000555 "Takes an array reference containing one or more string source names.  No"
NSQ_SOURCE_LINE 00000556 "source whose name does not match one of these strings will be chosen.  The"
NSQ_SOURCE_LINE 00000557 "string 'Win32' will match either of the Win32 sources, and 'TESHA2' will match"
NSQ_SOURCE_LINE 00000558 "both the strong and weak versions."
NSQ_SOURCE_LINE 00000559 ""
NSQ_SOURCE_LINE 00000560 "=head3 Never => [I<list of strings>]"
NSQ_SOURCE_LINE 00000561 ""
NSQ_SOURCE_LINE 00000562 "Takes an array reference containing one or more string source names.  No"
NSQ_SOURCE_LINE 00000563 "source whose name matches one of these strings will be chosen.  The string"
NSQ_SOURCE_LINE 00000564 "'Win32' will match either of the Win32 sources, and 'TESHA2' will match both"
NSQ_SOURCE_LINE 00000565 "the strong and weak versions."
NSQ_SOURCE_LINE 00000566 ""
NSQ_SOURCE_LINE 00000567 "=head3 Source => sub { I<...> }"
NSQ_SOURCE_LINE 00000568 ""
NSQ_SOURCE_LINE 00000569 "Uses the given anonymous subroutine as the generator.  The subroutine will"
NSQ_SOURCE_LINE 00000570 "be given an integer (the argument to C<random_bytes>) and should return"
NSQ_SOURCE_LINE 00000571 "random data in a string of the given length.  For the purposes of the other"
NSQ_SOURCE_LINE 00000572 "object methods, the returned object will have the name 'User', and be"
NSQ_SOURCE_LINE 00000573 "considered non-blocking and non-strong."
NSQ_SOURCE_LINE 00000574 ""
NSQ_SOURCE_LINE 00000575 "=head3 Source => ['I<name>', sub { I<...> }, I<is_blocking>, I<is_strong>]"
NSQ_SOURCE_LINE 00000576 ""
NSQ_SOURCE_LINE 00000577 "Similar to the simpler source routine, but also allows the other source"
NSQ_SOURCE_LINE 00000578 "parameters to be defined.  The name may not be one of the standard names"
NSQ_SOURCE_LINE 00000579 "listed in the L</\"name\"> section."
NSQ_SOURCE_LINE 00000580 ""
NSQ_SOURCE_LINE 00000581 ""
NSQ_SOURCE_LINE 00000582 "=head2 random_bytes($n)"
NSQ_SOURCE_LINE 00000583 ""
NSQ_SOURCE_LINE 00000584 "Takes an integer and returns a string of that size filled with random data."
NSQ_SOURCE_LINE 00000585 "Returns an empty string if the argument is not defined or is not more than"
NSQ_SOURCE_LINE 00000586 "zero."
NSQ_SOURCE_LINE 00000587 ""
NSQ_SOURCE_LINE 00000588 "=head2 random_values($n)"
NSQ_SOURCE_LINE 00000589 ""
NSQ_SOURCE_LINE 00000590 "Takes an integer and returns an array of that many random 32-bit values."
NSQ_SOURCE_LINE 00000591 "Returns an empty array if the argument is not defined or is not more than"
NSQ_SOURCE_LINE 00000592 "zero."
NSQ_SOURCE_LINE 00000593 ""
NSQ_SOURCE_LINE 00000594 "=head2 name"
NSQ_SOURCE_LINE 00000595 ""
NSQ_SOURCE_LINE 00000596 "Returns the text name of the random source.  This will be one of:"
NSQ_SOURCE_LINE 00000597 "C<User> for user defined,"
NSQ_SOURCE_LINE 00000598 "C<CryptGenRandom> for Windows 2000 Crypto API,"
NSQ_SOURCE_LINE 00000599 "C<RtlGenRand> for Windows XP and newer Crypto API,"
NSQ_SOURCE_LINE 00000600 "C<EGD> for a known socket speaking the EGD protocol,"
NSQ_SOURCE_LINE 00000601 "C</dev/random> for the UNIX-like strong randomness source,"
NSQ_SOURCE_LINE 00000602 "C</dev/urandom> for the UNIX-like non-blocking randomness source,"
NSQ_SOURCE_LINE 00000603 "C<TESHA2-strong> for the userspace entropy method when considered strong,"
NSQ_SOURCE_LINE 00000604 "C<TESHA2-weak> for the userspace entropy method when considered weak."
NSQ_SOURCE_LINE 00000605 "Other methods may be supported in the future.  User supplied sources may be"
NSQ_SOURCE_LINE 00000606 "named anything other than one of the defined names."
NSQ_SOURCE_LINE 00000607 ""
NSQ_SOURCE_LINE 00000608 "=head2 is_strong"
NSQ_SOURCE_LINE 00000609 ""
NSQ_SOURCE_LINE 00000610 "Returns 1 or 0 indicating whether the source is considered a strong source"
NSQ_SOURCE_LINE 00000611 "of randomness.  See the L</\"STRENGTH\"> section for more discussion of what"
NSQ_SOURCE_LINE 00000612 "this means, and the L<source table|/\"SOURCE TABLE\"> for what we think of each"
NSQ_SOURCE_LINE 00000613 "source."
NSQ_SOURCE_LINE 00000614 ""
NSQ_SOURCE_LINE 00000615 "=head2 is_blocking"
NSQ_SOURCE_LINE 00000616 ""
NSQ_SOURCE_LINE 00000617 "Returns 1 or 0 indicating whether the source can block on read.  Be aware"
NSQ_SOURCE_LINE 00000618 "that even if a source doesn't block, it may be extremely slow."
NSQ_SOURCE_LINE 00000619 ""
NSQ_SOURCE_LINE 00000620 ""
NSQ_SOURCE_LINE 00000621 "=head1 AUTHORS"
NSQ_SOURCE_LINE 00000622 ""
NSQ_SOURCE_LINE 00000623 "Dana Jacobsen E<lt>dana@acm.orgE<gt>"
NSQ_SOURCE_LINE 00000624 ""
NSQ_SOURCE_LINE 00000625 ""
NSQ_SOURCE_LINE 00000626 "=head1 ACKNOWLEDGEMENTS"
NSQ_SOURCE_LINE 00000627 ""
NSQ_SOURCE_LINE 00000628 "To the best of my knowledge, Max Kanat-Alexander was the original author of"
NSQ_SOURCE_LINE 00000629 "the Perl code that uses the Win32 API.  I used his code as a reference."
NSQ_SOURCE_LINE 00000630 ""
NSQ_SOURCE_LINE 00000631 "David Oswald gave me a lot of help with API discussions and code reviews."
NSQ_SOURCE_LINE 00000632 ""
NSQ_SOURCE_LINE 00000633 ""
NSQ_SOURCE_LINE 00000634 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000635 ""
NSQ_SOURCE_LINE 00000636 "The first question one may ask is \"Why yet another module of this type?\""
NSQ_SOURCE_LINE 00000637 "None of the modules on CPAN quite fit my needs, hence this.  Some alternatives:"
NSQ_SOURCE_LINE 00000638 ""
NSQ_SOURCE_LINE 00000639 "=head2 L<Crypt::Random::Source>"
NSQ_SOURCE_LINE 00000640 ""
NSQ_SOURCE_LINE 00000641 "A comprehensive system using multiple plugins.  It has a nice API, but"
NSQ_SOURCE_LINE 00000642 "uses L<Any::Moose> which means you're loading up Moose or Mouse just to"
NSQ_SOURCE_LINE 00000643 "read a few bytes from /dev/random.  It also has a very long dependency chain,"
NSQ_SOURCE_LINE 00000644 "with on the order of 40 modules being installed as prerequisites (depending"
NSQ_SOURCE_LINE 00000645 "of course on whether you use any of them on other projects).  Lastly, it"
NSQ_SOURCE_LINE 00000646 "requires at least Perl 5.8, which may or may not matter to you.  But it"
NSQ_SOURCE_LINE 00000647 "matters to some other module builders who end up with the restriction in"
NSQ_SOURCE_LINE 00000648 "their modules."
NSQ_SOURCE_LINE 00000649 ""
NSQ_SOURCE_LINE 00000650 "=head2 L<Crypt::URandom>"
NSQ_SOURCE_LINE 00000651 ""
NSQ_SOURCE_LINE 00000652 "A great little module that is almost what I was looking for."
NSQ_SOURCE_LINE 00000653 "L<Crypt::Random::Seed> will act the same if given the constructor:"
NSQ_SOURCE_LINE 00000654 ""
NSQ_SOURCE_LINE 00000655 "  my $source = Crypt::Random::Seed->new("
NSQ_SOURCE_LINE 00000656 "     NonBlocking => 1,"
NSQ_SOURCE_LINE 00000657 "     Only => [qw(/dev/random /dev/urandom Win32)]"
NSQ_SOURCE_LINE 00000658 "  );"
NSQ_SOURCE_LINE 00000659 "  croak \"No randomness source available\" unless defined $source;"
NSQ_SOURCE_LINE 00000660 ""
NSQ_SOURCE_LINE 00000661 "Or you can leave out the C<Only> and have TESHA2 as a backup."
NSQ_SOURCE_LINE 00000662 ""
NSQ_SOURCE_LINE 00000663 "=head2 L<Crypt::Random>"
NSQ_SOURCE_LINE 00000664 ""
NSQ_SOURCE_LINE 00000665 "Requires L<Math::Pari> which makes it unacceptable in some environments."
NSQ_SOURCE_LINE 00000666 "Has more features (numbers in arbitrary bigint intervals or bit sizes)."
NSQ_SOURCE_LINE 00000667 "L<Crypt::Random::Seed> is taking a simpler approach, just handling returning"
NSQ_SOURCE_LINE 00000668 "octets and letting upstream modules handle the rest."
NSQ_SOURCE_LINE 00000669 ""
NSQ_SOURCE_LINE 00000670 "=head2 L<Data::Entropy>"
NSQ_SOURCE_LINE 00000671 ""
NSQ_SOURCE_LINE 00000672 "An interesting module that contains a source encapsulation (defaults to system"
NSQ_SOURCE_LINE 00000673 "rand, but has many plugins), a good CSPRNG (AES in counter mode), and the"
NSQ_SOURCE_LINE 00000674 "L<Data::Entropy::Algorithms> module with many ways to get bits, ints, bigints,"
NSQ_SOURCE_LINE 00000675 "floats, bigfloats, shuffles, and so forth.  From my perspective, the"
NSQ_SOURCE_LINE 00000676 "algorithms module is the highlight, with a lot of interesting code."
NSQ_SOURCE_LINE 00000677 ""
NSQ_SOURCE_LINE 00000678 ""
NSQ_SOURCE_LINE 00000679 "=head2 Upstream modules"
NSQ_SOURCE_LINE 00000680 ""
NSQ_SOURCE_LINE 00000681 "Some modules that could use this module to help them:"
NSQ_SOURCE_LINE 00000682 "L<Bytes::Random::Secure>,"
NSQ_SOURCE_LINE 00000683 "L<Math::Random::ISAAC>,"
NSQ_SOURCE_LINE 00000684 "L<Math::Random::Secure>,"
NSQ_SOURCE_LINE 00000685 "and L<Math::Random::MT>"
NSQ_SOURCE_LINE 00000686 "to name a few."
NSQ_SOURCE_LINE 00000687 ""
NSQ_SOURCE_LINE 00000688 ""
