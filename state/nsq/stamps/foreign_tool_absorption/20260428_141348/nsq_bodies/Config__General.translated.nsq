NSQ_SOURCE_LINE 00001157 ""
NSQ_SOURCE_LINE 00001158 "sub _copy {"
NSQ_SOURCE_LINE 00001159 "  #"
NSQ_SOURCE_LINE 00001160 "  # copy the contents of one hash into another"
NSQ_SOURCE_LINE 00001161 "  # to circumvent invalid references"
NSQ_SOURCE_LINE 00001162 "  # fixes rt.cpan.org bug #35122"
NSQ_SOURCE_LINE 00001163 "  my($this, $source) = @_;"
NSQ_SOURCE_LINE 00001164 "  my %hash = ();"
NSQ_SOURCE_LINE 00001165 "  while (my ($key, $value) = each %{$source}) {"
NSQ_SOURCE_LINE 00001166 "    $hash{$key} = $value;"
NSQ_SOURCE_LINE 00001167 "  }"
NSQ_SOURCE_LINE 00001168 "  return \\%hash;"
NSQ_SOURCE_LINE 00001169 "}"
NSQ_SOURCE_LINE 00001170 ""
NSQ_SOURCE_LINE 00001171 ""
NSQ_SOURCE_LINE 00001172 "sub _parse_value {"
NSQ_SOURCE_LINE 00001173 "  #"
NSQ_SOURCE_LINE 00001174 "  # parse the value if value parsing is turned on"
NSQ_SOURCE_LINE 00001175 "  # by either -AutoTrue and/or -FlagBits"
NSQ_SOURCE_LINE 00001176 "  # otherwise just return the given value unchanged"
NSQ_SOURCE_LINE 00001177 "  #"
NSQ_SOURCE_LINE 00001178 "  my($this, $config, $option, $value) =@_;"
NSQ_SOURCE_LINE 00001179 ""
NSQ_SOURCE_LINE 00001180 "  my $cont;"
NSQ_SOURCE_LINE 00001181 "  ($cont, $option, $value) = $this->_hook('pre_parse_value', $option, $value);"
NSQ_SOURCE_LINE 00001182 "  return $value if(!$cont);"
NSQ_SOURCE_LINE 00001183 ""
NSQ_SOURCE_LINE 00001184 "  # avoid \"Use of uninitialized value\""
NSQ_SOURCE_LINE 00001185 "  if (! defined $value) {"
NSQ_SOURCE_LINE 00001186 "    # patch fix rt#54583"
NSQ_SOURCE_LINE 00001187 "    # Return an input undefined value without trying transformations"
NSQ_SOURCE_LINE 00001188 "    return $value;"
NSQ_SOURCE_LINE 00001189 "  }"
NSQ_SOURCE_LINE 00001190 ""
NSQ_SOURCE_LINE 00001191 "  if($this->{NormalizeValue}) {"
NSQ_SOURCE_LINE 00001192 "    $value = $this->{NormalizeValue}($value);"
NSQ_SOURCE_LINE 00001193 "  }"
NSQ_SOURCE_LINE 00001194 ""
NSQ_SOURCE_LINE 00001195 "  if ($this->{InterPolateVars}) {"
NSQ_SOURCE_LINE 00001196 "    $value = $this->_interpolate($config, $option, $value);"
NSQ_SOURCE_LINE 00001197 "  }"
NSQ_SOURCE_LINE 00001198 ""
NSQ_SOURCE_LINE 00001199 "  # make true/false values to 1 or 0 (-AutoTrue)"
NSQ_SOURCE_LINE 00001200 "  if ($this->{AutoTrue}) {"
NSQ_SOURCE_LINE 00001201 "    if ($value =~ /$this->{AutoTrueFlags}->{true}/io) {"
NSQ_SOURCE_LINE 00001202 "      $value = 1;"
NSQ_SOURCE_LINE 00001203 "    }"
NSQ_SOURCE_LINE 00001204 "    elsif ($value =~ /$this->{AutoTrueFlags}->{false}/io) {"
NSQ_SOURCE_LINE 00001205 "      $value = 0;"
NSQ_SOURCE_LINE 00001206 "    }"
NSQ_SOURCE_LINE 00001207 "  }"
NSQ_SOURCE_LINE 00001208 ""
NSQ_SOURCE_LINE 00001209 "  # assign predefined flags or undef for every flag | flag ... (-FlagBits)"
NSQ_SOURCE_LINE 00001210 "  if ($this->{FlagBits}) {"
NSQ_SOURCE_LINE 00001211 "    if (exists $this->{FlagBitsFlags}->{$option}) {"
NSQ_SOURCE_LINE 00001212 "      my %__flags = map { $_ => 1 } split /\\s*\\|\\s*/, $value;"
NSQ_SOURCE_LINE 00001213 "      foreach my $flag (keys %{$this->{FlagBitsFlags}->{$option}}) {"
NSQ_SOURCE_LINE 00001214 "        if (exists $__flags{$flag}) {"
NSQ_SOURCE_LINE 00001215 "          $__flags{$flag} = $this->{FlagBitsFlags}->{$option}->{$flag};"
NSQ_SOURCE_LINE 00001216 "        }"
NSQ_SOURCE_LINE 00001217 "        else {"
NSQ_SOURCE_LINE 00001218 "          $__flags{$flag} = undef;"
NSQ_SOURCE_LINE 00001219 "        }"
NSQ_SOURCE_LINE 00001220 "      }"
NSQ_SOURCE_LINE 00001221 "      $value = \\%__flags;"
NSQ_SOURCE_LINE 00001222 "    }"
NSQ_SOURCE_LINE 00001223 "  }"
NSQ_SOURCE_LINE 00001224 ""
NSQ_SOURCE_LINE 00001225 "  if (!$this->{NoEscape}) {"
NSQ_SOURCE_LINE 00001226 "    # are there any escaped characters left? put them out as is"
NSQ_SOURCE_LINE 00001227 "    $value =~ s/\\\\([\\$\\\\\\\"#])/$1/g;"
NSQ_SOURCE_LINE 00001228 "  }"
NSQ_SOURCE_LINE 00001229 ""
NSQ_SOURCE_LINE 00001230 "  ($cont, $option, $value) = $this->_hook('post_parse_value', $option, $value);"
NSQ_SOURCE_LINE 00001231 ""
NSQ_SOURCE_LINE 00001232 "  return $value;"
NSQ_SOURCE_LINE 00001233 "}"
NSQ_SOURCE_LINE 00001234 ""
NSQ_SOURCE_LINE 00001235 ""
NSQ_SOURCE_LINE 00001236 ""
NSQ_SOURCE_LINE 00001237 "sub _hook {"
NSQ_SOURCE_LINE 00001238 "  my ($this, $hook, @arguments) = @_;"
NSQ_SOURCE_LINE 00001239 "  if(exists $this->{Plug}->{$hook}) {"
NSQ_SOURCE_LINE 00001240 "    my $sub = $this->{Plug}->{$hook};"
NSQ_SOURCE_LINE 00001241 "    my @hooked = &$sub(@arguments);"
NSQ_SOURCE_LINE 00001242 "    return @hooked;"
NSQ_SOURCE_LINE 00001243 "  }"
NSQ_SOURCE_LINE 00001244 "  return (1, @arguments);"
NSQ_SOURCE_LINE 00001245 "}"
NSQ_SOURCE_LINE 00001246 ""
NSQ_SOURCE_LINE 00001247 ""
NSQ_SOURCE_LINE 00001248 ""
NSQ_SOURCE_LINE 00001249 "sub save {"
NSQ_SOURCE_LINE 00001250 "  #"
NSQ_SOURCE_LINE 00001251 "  # this is the old version of save() whose API interface"
NSQ_SOURCE_LINE 00001252 "  # has been changed. I'm very sorry 'bout this."
NSQ_SOURCE_LINE 00001253 "  #"
NSQ_SOURCE_LINE 00001254 "  # I'll try to figure out, if it has been called correctly"
NSQ_SOURCE_LINE 00001255 "  # and if yes, feed the call to Save(), otherwise croak."
NSQ_SOURCE_LINE 00001256 "  #"
NSQ_SOURCE_LINE 00001257 "  my($this, $one, @two) = @_;"
NSQ_SOURCE_LINE 00001258 ""
NSQ_SOURCE_LINE 00001259 "  if ( (@two && $one) && ( (scalar @two) % 2 == 0) ) {"
NSQ_SOURCE_LINE 00001260 "    # @two seems to be a hash"
NSQ_SOURCE_LINE 00001261 "    my %h = @two;"
NSQ_SOURCE_LINE 00001262 "    $this->save_file($one, \\%h);"
NSQ_SOURCE_LINE 00001263 "  }"
NSQ_SOURCE_LINE 00001264 "  else {"
NSQ_SOURCE_LINE 00001265 "    croak q(Config::General: The save() method is deprecated. Use the new save_file() method instead!);"
NSQ_SOURCE_LINE 00001266 "  }"
NSQ_SOURCE_LINE 00001267 "  return;"
NSQ_SOURCE_LINE 00001268 "}"
NSQ_SOURCE_LINE 00001269 ""
NSQ_SOURCE_LINE 00001270 ""
NSQ_SOURCE_LINE 00001271 "sub save_file {"
NSQ_SOURCE_LINE 00001272 "  #"
NSQ_SOURCE_LINE 00001273 "  # save the config back to disk"
NSQ_SOURCE_LINE 00001274 "  #"
NSQ_SOURCE_LINE 00001275 "  my($this, $file, $config) = @_;"
NSQ_SOURCE_LINE 00001276 "  my $fh;"
NSQ_SOURCE_LINE 00001277 "  my $config_string;"
NSQ_SOURCE_LINE 00001278 ""
NSQ_SOURCE_LINE 00001279 "  if (!$file) {"
NSQ_SOURCE_LINE 00001280 "    croak \"Config::General: Filename is required!\";"
NSQ_SOURCE_LINE 00001281 "  }"
NSQ_SOURCE_LINE 00001282 "  else {"
NSQ_SOURCE_LINE 00001283 "    if ($this->{UTF8}) {"
NSQ_SOURCE_LINE 00001284 "      $fh = IO::File->new;"
NSQ_SOURCE_LINE 00001285 "      open($fh, \">:utf8\", $file)"
NSQ_SOURCE_LINE 00001286 "        or croak \"Config::General: Could not open $file in UTF8 mode!($!)\\n\";"
NSQ_SOURCE_LINE 00001287 "    }"
NSQ_SOURCE_LINE 00001288 "    else {"
NSQ_SOURCE_LINE 00001289 "      $fh = IO::File->new( \"$file\", 'w')"
NSQ_SOURCE_LINE 00001290 "        or croak \"Config::General: Could not open $file!($!)\\n\";"
NSQ_SOURCE_LINE 00001291 "    }"
NSQ_SOURCE_LINE 00001292 "    if (!$config) {"
NSQ_SOURCE_LINE 00001293 "      if (exists $this->{config}) {"
NSQ_SOURCE_LINE 00001294 "        $config_string = $this->_store(0, $this->{config});"
NSQ_SOURCE_LINE 00001295 "      }"
NSQ_SOURCE_LINE 00001296 "      else {"
NSQ_SOURCE_LINE 00001297 "        croak \"Config::General: No config hash supplied which could be saved to disk!\\n\";"
NSQ_SOURCE_LINE 00001298 "      }"
NSQ_SOURCE_LINE 00001299 "    }"
NSQ_SOURCE_LINE 00001300 "    else {"
NSQ_SOURCE_LINE 00001301 "      $config_string = $this->_store(0, $config);"
NSQ_SOURCE_LINE 00001302 "    }"
NSQ_SOURCE_LINE 00001303 ""
NSQ_SOURCE_LINE 00001304 "    if ($config_string) {"
NSQ_SOURCE_LINE 00001305 "      print {$fh} $config_string;"
NSQ_SOURCE_LINE 00001306 "    }"
NSQ_SOURCE_LINE 00001307 "    else {"
NSQ_SOURCE_LINE 00001308 "      # empty config for whatever reason, I don't care"
NSQ_SOURCE_LINE 00001309 "      print {$fh} q();"
NSQ_SOURCE_LINE 00001310 "    }"
NSQ_SOURCE_LINE 00001311 ""
NSQ_SOURCE_LINE 00001312 "    close $fh;"
NSQ_SOURCE_LINE 00001313 "  }"
NSQ_SOURCE_LINE 00001314 "  return;"
NSQ_SOURCE_LINE 00001315 "}"
NSQ_SOURCE_LINE 00001316 ""
NSQ_SOURCE_LINE 00001317 ""
NSQ_SOURCE_LINE 00001318 ""
NSQ_SOURCE_LINE 00001319 "sub save_string {"
NSQ_SOURCE_LINE 00001320 "  #"
NSQ_SOURCE_LINE 00001321 "  # return the saved config as a string"
NSQ_SOURCE_LINE 00001322 "  #"
NSQ_SOURCE_LINE 00001323 "  my($this, $config) = @_;"
NSQ_SOURCE_LINE 00001324 ""
NSQ_SOURCE_LINE 00001325 "  if (!$config || ref($config) ne 'HASH') {"
NSQ_SOURCE_LINE 00001326 "    if (exists $this->{config}) {"
NSQ_SOURCE_LINE 00001327 "      return $this->_store(0, $this->{config});"
NSQ_SOURCE_LINE 00001328 "    }"
NSQ_SOURCE_LINE 00001329 "    else {"
NSQ_SOURCE_LINE 00001330 "      croak \"Config::General: No config hash supplied which could be saved to disk!\\n\";"
NSQ_SOURCE_LINE 00001331 "    }"
NSQ_SOURCE_LINE 00001332 "  }"
NSQ_SOURCE_LINE 00001333 "  else {"
NSQ_SOURCE_LINE 00001334 "    return $this->_store(0, $config);"
NSQ_SOURCE_LINE 00001335 "  }"
NSQ_SOURCE_LINE 00001336 "  return;"
NSQ_SOURCE_LINE 00001337 "}"
NSQ_SOURCE_LINE 00001338 ""
NSQ_SOURCE_LINE 00001339 ""
NSQ_SOURCE_LINE 00001340 ""
NSQ_SOURCE_LINE 00001341 "sub _store {"
NSQ_SOURCE_LINE 00001342 "  #"
NSQ_SOURCE_LINE 00001343 "  # internal sub for saving a block"
NSQ_SOURCE_LINE 00001344 "  #"
NSQ_SOURCE_LINE 00001345 "  my($this, $level, $config) = @_;"
NSQ_SOURCE_LINE 00001346 "  local $_;"
NSQ_SOURCE_LINE 00001347 "  my $indent = q(    ) x $level;"
NSQ_SOURCE_LINE 00001348 ""
NSQ_SOURCE_LINE 00001349 "  my $config_string = q();"
NSQ_SOURCE_LINE 00001350 ""
NSQ_SOURCE_LINE 00001351 "  foreach my $entry ( $this->{SaveSorted} ? sort keys %$config : keys %$config ) {"
NSQ_SOURCE_LINE 00001352 "    # fix rt#104548"
NSQ_SOURCE_LINE 00001353 "    if ($entry =~ /[<>\\n\\r]/) {"
NSQ_SOURCE_LINE 00001354 "      croak \"Config::General: current key contains invalid characters: $entry!\\n\";"
NSQ_SOURCE_LINE 00001355 "    }"
NSQ_SOURCE_LINE 00001356 ""
NSQ_SOURCE_LINE 00001357 "    if (ref($config->{$entry}) eq 'ARRAY') {"
NSQ_SOURCE_LINE 00001358 "      if( $this->{ForceArray} && scalar @{$config->{$entry}} == 1 && ! ref($config->{$entry}->[0]) ) {"
NSQ_SOURCE_LINE 00001359 "        # a single value array forced to stay as array"
NSQ_SOURCE_LINE 00001360 "        $config_string .= $this->_write_scalar($level, $entry, '[' . $config->{$entry}->[0] . ']');"
NSQ_SOURCE_LINE 00001361 "      }"
NSQ_SOURCE_LINE 00001362 "      else {"
NSQ_SOURCE_LINE 00001363 "        foreach my $line ( $this->{SaveSorted} ? sort @{$config->{$entry}} : @{$config->{$entry}} ) {"
NSQ_SOURCE_LINE 00001364 "          if (ref($line) eq 'HASH') {"
NSQ_SOURCE_LINE 00001365 "            $config_string .= $this->_write_hash($level, $entry, $line);"
NSQ_SOURCE_LINE 00001366 "          }"
NSQ_SOURCE_LINE 00001367 "          else {"
NSQ_SOURCE_LINE 00001368 "            $config_string .= $this->_write_scalar($level, $entry, $line);"
NSQ_SOURCE_LINE 00001369 "          }"
NSQ_SOURCE_LINE 00001370 "        }"
NSQ_SOURCE_LINE 00001371 "      }"
NSQ_SOURCE_LINE 00001372 "    }"
NSQ_SOURCE_LINE 00001373 "    elsif (ref($config->{$entry}) eq 'HASH') {"
NSQ_SOURCE_LINE 00001374 "      $config_string .= $this->_write_hash($level, $entry, $config->{$entry});"
NSQ_SOURCE_LINE 00001375 "    }"
NSQ_SOURCE_LINE 00001376 "    else {"
NSQ_SOURCE_LINE 00001377 "      $config_string .= $this->_write_scalar($level, $entry, $config->{$entry});"
NSQ_SOURCE_LINE 00001378 "    }"
NSQ_SOURCE_LINE 00001379 "  }"
NSQ_SOURCE_LINE 00001380 ""
NSQ_SOURCE_LINE 00001381 "  return $config_string;"
NSQ_SOURCE_LINE 00001382 "}"
NSQ_SOURCE_LINE 00001383 ""
NSQ_SOURCE_LINE 00001384 ""
NSQ_SOURCE_LINE 00001385 "sub _write_scalar {"
NSQ_SOURCE_LINE 00001386 "  #"
NSQ_SOURCE_LINE 00001387 "  # internal sub, which writes a scalar"
NSQ_SOURCE_LINE 00001388 "  # it returns it, in fact"
NSQ_SOURCE_LINE 00001389 "  #"
NSQ_SOURCE_LINE 00001390 "  my($this, $level, $entry, $line) = @_;"
NSQ_SOURCE_LINE 00001391 ""
NSQ_SOURCE_LINE 00001392 "  my $indent = q(    ) x $level;"
NSQ_SOURCE_LINE 00001393 ""
NSQ_SOURCE_LINE 00001394 "  my $config_string;"
NSQ_SOURCE_LINE 00001395 ""
NSQ_SOURCE_LINE 00001396 "  # patch fix rt#54583"
NSQ_SOURCE_LINE 00001397 "  if ( ! defined $line ) {"
NSQ_SOURCE_LINE 00001398 "    $config_string .= $indent . $entry . \"\\n\";"
NSQ_SOURCE_LINE 00001399 "  }"
NSQ_SOURCE_LINE 00001400 "  elsif ($line =~ /\\n/ || $line =~ /\\\\$/) {"
NSQ_SOURCE_LINE 00001401 "    # it is a here doc"
NSQ_SOURCE_LINE 00001402 "    my $delimiter;"
NSQ_SOURCE_LINE 00001403 "    my $tmplimiter = 'EOF';"
NSQ_SOURCE_LINE 00001404 "    while (!$delimiter) {"
NSQ_SOURCE_LINE 00001405 "      # create a unique here-doc identifier"
NSQ_SOURCE_LINE 00001406 "      if ($line =~ /$tmplimiter/s) {"
NSQ_SOURCE_LINE 00001407 "        $tmplimiter .= '%';"
NSQ_SOURCE_LINE 00001408 "      }"
NSQ_SOURCE_LINE 00001409 "      else {"
NSQ_SOURCE_LINE 00001410 "        $delimiter = $tmplimiter;"
NSQ_SOURCE_LINE 00001411 "      }"
NSQ_SOURCE_LINE 00001412 "    }"
NSQ_SOURCE_LINE 00001413 "    my @lines = split /\\n/, $line;"
NSQ_SOURCE_LINE 00001414 "    $config_string .= $indent . $entry . $this->{StoreDelimiter} . \"<<$delimiter\\n\";"
NSQ_SOURCE_LINE 00001415 "    foreach (@lines) {"
NSQ_SOURCE_LINE 00001416 "      $config_string .= $indent . $_ . \"\\n\";"
NSQ_SOURCE_LINE 00001417 "    }"
NSQ_SOURCE_LINE 00001418 "    $config_string .= $indent . \"$delimiter\\n\";"
NSQ_SOURCE_LINE 00001419 "  }"
NSQ_SOURCE_LINE 00001420 "  else {"
NSQ_SOURCE_LINE 00001421 "    # a simple stupid scalar entry"
NSQ_SOURCE_LINE 00001422 ""
NSQ_SOURCE_LINE 00001423 "    if (!$this->{NoEscape}) {"
NSQ_SOURCE_LINE 00001424 "      # re-escape contained $ or # or \\ chars"
NSQ_SOURCE_LINE 00001425 "      $line =~ s/([#\\$\\\\\\\"])/\\\\$1/g;"
NSQ_SOURCE_LINE 00001426 "    }"
NSQ_SOURCE_LINE 00001427 ""
NSQ_SOURCE_LINE 00001428 "    if ($line =~ /^\\s/ || $line =~ /\\s$/ || $this->{AlwaysQuoteOutput}) {"
NSQ_SOURCE_LINE 00001429 "      # quote lines containing whitespace"
NSQ_SOURCE_LINE 00001430 "      $line = \"\\\"$line\\\"\";"
NSQ_SOURCE_LINE 00001431 "    }"
NSQ_SOURCE_LINE 00001432 ""
NSQ_SOURCE_LINE 00001433 "    $config_string .= $indent . $entry . $this->{StoreDelimiter} . $line . \"\\n\";"
NSQ_SOURCE_LINE 00001434 "  }"
NSQ_SOURCE_LINE 00001435 ""
NSQ_SOURCE_LINE 00001436 "  return $config_string;"
NSQ_SOURCE_LINE 00001437 "}"
NSQ_SOURCE_LINE 00001438 ""
NSQ_SOURCE_LINE 00001439 "sub _write_hash {"
NSQ_SOURCE_LINE 00001440 "  #"
NSQ_SOURCE_LINE 00001441 "  # internal sub, which writes a hash (block)"
NSQ_SOURCE_LINE 00001442 "  # it returns it, in fact"
NSQ_SOURCE_LINE 00001443 "  #"
NSQ_SOURCE_LINE 00001444 "  my($this, $level, $entry, $line) = @_;"
NSQ_SOURCE_LINE 00001445 ""
NSQ_SOURCE_LINE 00001446 "  my $indent = q(    ) x $level;"
NSQ_SOURCE_LINE 00001447 "  my $config_string;"
NSQ_SOURCE_LINE 00001448 ""
NSQ_SOURCE_LINE 00001449 "  if ($entry =~ /\\s/) {"
NSQ_SOURCE_LINE 00001450 "    # quote the entry if it contains whitespaces"
NSQ_SOURCE_LINE 00001451 "    $entry = q(\") . $entry . q(\");"
NSQ_SOURCE_LINE 00001452 "  }"
NSQ_SOURCE_LINE 00001453 ""
NSQ_SOURCE_LINE 00001454 "  # check if the next level key points to a hash and is the only one"
NSQ_SOURCE_LINE 00001455 "  # in this case put out a named block"
NSQ_SOURCE_LINE 00001456 "  # fixes rt.77667"
NSQ_SOURCE_LINE 00001457 "  my $num = scalar keys %{$line};"
NSQ_SOURCE_LINE 00001458 "  if($num == 1) {"
NSQ_SOURCE_LINE 00001459 "    my $key = (keys %{$line})[0];"
NSQ_SOURCE_LINE 00001460 "    if(ref($line->{$key}) eq 'HASH') {"
NSQ_SOURCE_LINE 00001461 "      $config_string .= $indent . qq(<$entry $key>\\n);"
NSQ_SOURCE_LINE 00001462 "      $config_string .= $this->_store($level + 1, $line->{$key});"
NSQ_SOURCE_LINE 00001463 "      $config_string .= $indent . qq(</) . $entry . \">\\n\";"
NSQ_SOURCE_LINE 00001464 "      return $config_string;"
NSQ_SOURCE_LINE 00001465 "    }"
NSQ_SOURCE_LINE 00001466 "  }"
NSQ_SOURCE_LINE 00001467 " "
NSQ_SOURCE_LINE 00001468 "  $config_string .= $indent . q(<) . $entry . \">\\n\";"
NSQ_SOURCE_LINE 00001469 "  $config_string .= $this->_store($level + 1, $line);"
NSQ_SOURCE_LINE 00001470 "  $config_string .= $indent . q(</) . $entry . \">\\n\";"
NSQ_SOURCE_LINE 00001471 ""
NSQ_SOURCE_LINE 00001472 "  return $config_string"
NSQ_SOURCE_LINE 00001473 "}"
NSQ_SOURCE_LINE 00001474 ""
NSQ_SOURCE_LINE 00001475 ""
NSQ_SOURCE_LINE 00001476 "sub _hashref {"
NSQ_SOURCE_LINE 00001477 "  #"
NSQ_SOURCE_LINE 00001478 "  # return a probably tied new empty hash ref"
NSQ_SOURCE_LINE 00001479 "  #"
NSQ_SOURCE_LINE 00001480 "  my($this) = @_;"
NSQ_SOURCE_LINE 00001481 "  if ($this->{Tie}) {"
NSQ_SOURCE_LINE 00001482 "    eval {"
NSQ_SOURCE_LINE 00001483 "      eval qq{require $this->{Tie}};"
NSQ_SOURCE_LINE 00001484 "    };"
NSQ_SOURCE_LINE 00001485 "    if ($EVAL_ERROR) {"
NSQ_SOURCE_LINE 00001486 "      croak q(Config::General: Could not create a tied hash of type: ) . $this->{Tie} . q(: ) . $EVAL_ERROR;"
NSQ_SOURCE_LINE 00001487 "    }"
NSQ_SOURCE_LINE 00001488 "    my %hash;"
NSQ_SOURCE_LINE 00001489 "    tie %hash, $this->{Tie};"
NSQ_SOURCE_LINE 00001490 "    return \\%hash;"
NSQ_SOURCE_LINE 00001491 "  }"
NSQ_SOURCE_LINE 00001492 "  else {"
NSQ_SOURCE_LINE 00001493 "    return {};"
NSQ_SOURCE_LINE 00001494 "  }"
NSQ_SOURCE_LINE 00001495 "}"
NSQ_SOURCE_LINE 00001496 ""
NSQ_SOURCE_LINE 00001497 ""
NSQ_SOURCE_LINE 00001498 "#"
NSQ_SOURCE_LINE 00001499 "# Procedural interface"
NSQ_SOURCE_LINE 00001500 "#"
NSQ_SOURCE_LINE 00001501 "sub ParseConfig {"
NSQ_SOURCE_LINE 00001502 "  #"
NSQ_SOURCE_LINE 00001503 "  # @_ may contain everything which is allowed for new()"
NSQ_SOURCE_LINE 00001504 "  #"
NSQ_SOURCE_LINE 00001505 "  return (new Config::General(@_))->getall();"
NSQ_SOURCE_LINE 00001506 "}"
NSQ_SOURCE_LINE 00001507 ""
NSQ_SOURCE_LINE 00001508 "sub SaveConfig {"
NSQ_SOURCE_LINE 00001509 "  #"
NSQ_SOURCE_LINE 00001510 "  # 2 parameters are required, filename and hash ref"
NSQ_SOURCE_LINE 00001511 "  #"
NSQ_SOURCE_LINE 00001512 "  my ($file, $hash) = @_;"
NSQ_SOURCE_LINE 00001513 ""
NSQ_SOURCE_LINE 00001514 "  if (!$file || !$hash) {"
NSQ_SOURCE_LINE 00001515 "    croak q{Config::General::SaveConfig(): filename and hash argument required.};"
NSQ_SOURCE_LINE 00001516 "  }"
NSQ_SOURCE_LINE 00001517 "  else {"
NSQ_SOURCE_LINE 00001518 "    if (ref($hash) ne 'HASH') {"
NSQ_SOURCE_LINE 00001519 "      croak q(Config::General::SaveConfig() The second parameter must be a reference to a hash!);"
NSQ_SOURCE_LINE 00001520 "    }"
NSQ_SOURCE_LINE 00001521 "    else {"
NSQ_SOURCE_LINE 00001522 "      (new Config::General(-ConfigHash => $hash))->save_file($file);"
NSQ_SOURCE_LINE 00001523 "    }"
NSQ_SOURCE_LINE 00001524 "  }"
NSQ_SOURCE_LINE 00001525 "  return;"
NSQ_SOURCE_LINE 00001526 "}"
NSQ_SOURCE_LINE 00001527 ""
NSQ_SOURCE_LINE 00001528 "sub SaveConfigString {"
NSQ_SOURCE_LINE 00001529 "  #"
NSQ_SOURCE_LINE 00001530 "  # same as SaveConfig, but return the config,"
NSQ_SOURCE_LINE 00001531 "  # instead of saving it"
NSQ_SOURCE_LINE 00001532 "  #"
NSQ_SOURCE_LINE 00001533 "  my ($hash) = @_;"
NSQ_SOURCE_LINE 00001534 ""
NSQ_SOURCE_LINE 00001535 "  if (!$hash) {"
NSQ_SOURCE_LINE 00001536 "    croak q{Config::General::SaveConfigString(): Hash argument required.};"
NSQ_SOURCE_LINE 00001537 "  }"
NSQ_SOURCE_LINE 00001538 "  else {"
NSQ_SOURCE_LINE 00001539 "    if (ref($hash) ne 'HASH') {"
NSQ_SOURCE_LINE 00001540 "      croak q(Config::General::SaveConfigString() The parameter must be a reference to a hash!);"
NSQ_SOURCE_LINE 00001541 "    }"
NSQ_SOURCE_LINE 00001542 "    else {"
NSQ_SOURCE_LINE 00001543 "      return (new Config::General(-ConfigHash => $hash))->save_string();"
NSQ_SOURCE_LINE 00001544 "    }"
NSQ_SOURCE_LINE 00001545 "  }"
NSQ_SOURCE_LINE 00001546 "  return;"
NSQ_SOURCE_LINE 00001547 "}"
NSQ_SOURCE_LINE 00001548 ""
NSQ_SOURCE_LINE 00001549 ""
NSQ_SOURCE_LINE 00001550 ""
NSQ_SOURCE_LINE 00001551 "# keep this one"
NSQ_SOURCE_LINE 00001552 "  1;"
NSQ_SOURCE_LINE 00001553 "__END__"
NSQ_SOURCE_LINE 00001554 ""
NSQ_SOURCE_LINE 00001555 ""
NSQ_SOURCE_LINE 00001556 ""
NSQ_SOURCE_LINE 00001557 ""
NSQ_SOURCE_LINE 00001558 "=head1 NAME"
NSQ_SOURCE_LINE 00001559 ""
NSQ_SOURCE_LINE 00001560 "Config::General - Generic Config Module"
NSQ_SOURCE_LINE 00001561 ""
NSQ_SOURCE_LINE 00001562 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00001563 ""
NSQ_SOURCE_LINE 00001564 " #"
NSQ_SOURCE_LINE 00001565 " # the OOP way"
NSQ_SOURCE_LINE 00001566 " use Config::General;"
NSQ_SOURCE_LINE 00001567 " $conf = Config::General->new(\"rcfile\");"
NSQ_SOURCE_LINE 00001568 " my %config = $conf->getall;"
NSQ_SOURCE_LINE 00001569 ""
NSQ_SOURCE_LINE 00001570 " #"
NSQ_SOURCE_LINE 00001571 " # the procedural way"
NSQ_SOURCE_LINE 00001572 " use Config::General qw(ParseConfig SaveConfig SaveConfigString);"
NSQ_SOURCE_LINE 00001573 " my %config = ParseConfig(\"rcfile\");"
NSQ_SOURCE_LINE 00001574 ""
NSQ_SOURCE_LINE 00001575 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00001576 ""
NSQ_SOURCE_LINE 00001577 "This module opens a config file and parses its contents for you. The B<new> method"
NSQ_SOURCE_LINE 00001578 "requires one parameter which needs to be a filename. The method B<getall> returns a hash"
NSQ_SOURCE_LINE 00001579 "which contains all options and its associated values of your config file."
NSQ_SOURCE_LINE 00001580 ""
NSQ_SOURCE_LINE 00001581 "The format of config files supported by B<Config::General> is inspired by the well known Apache config"
NSQ_SOURCE_LINE 00001582 "format, in fact, this module is 100% compatible to Apache configs, but you can also just use simple"
NSQ_SOURCE_LINE 00001583 " name/value pairs in your config files."
NSQ_SOURCE_LINE 00001584 ""
NSQ_SOURCE_LINE 00001585 "In addition to the capabilities of an Apache config file it supports some enhancements such as here-documents,"
NSQ_SOURCE_LINE 00001586 "C-style comments or multiline options."
NSQ_SOURCE_LINE 00001587 ""
NSQ_SOURCE_LINE 00001588 ""
NSQ_SOURCE_LINE 00001589 "=head1 SUBROUTINES/METHODS"
NSQ_SOURCE_LINE 00001590 ""
NSQ_SOURCE_LINE 00001591 "=over"
NSQ_SOURCE_LINE 00001592 ""
NSQ_SOURCE_LINE 00001593 "=item new()"
NSQ_SOURCE_LINE 00001594 ""
NSQ_SOURCE_LINE 00001595 "Possible ways to call B<new()>:"
NSQ_SOURCE_LINE 00001596 ""
NSQ_SOURCE_LINE 00001597 " $conf = Config::General->new(\"rcfile\");"
NSQ_SOURCE_LINE 00001598 ""
NSQ_SOURCE_LINE 00001599 " $conf = Config::General->new(\\%somehash);"
NSQ_SOURCE_LINE 00001600 ""
NSQ_SOURCE_LINE 00001601 " $conf = Config::General->new( %options ); # see below for description of possible options"
NSQ_SOURCE_LINE 00001602 ""
NSQ_SOURCE_LINE 00001603 ""
NSQ_SOURCE_LINE 00001604 "This method returns a B<Config::General> object (a hash blessed into \"Config::General\" namespace."
NSQ_SOURCE_LINE 00001605 "All further methods must be used from that returned object. see below."
NSQ_SOURCE_LINE 00001606 ""
NSQ_SOURCE_LINE 00001607 "You can use the new style with hash parameters or the old style which is of course"
NSQ_SOURCE_LINE 00001608 "still supported. Possible parameters to B<new()> are:"
NSQ_SOURCE_LINE 00001609 ""
NSQ_SOURCE_LINE 00001610 "* a filename of a configfile, which will be opened and parsed by the parser"
NSQ_SOURCE_LINE 00001611 ""
NSQ_SOURCE_LINE 00001612 "or"
NSQ_SOURCE_LINE 00001613 ""
NSQ_SOURCE_LINE 00001614 "* a hash reference, which will be used as the config."
NSQ_SOURCE_LINE 00001615 ""
NSQ_SOURCE_LINE 00001616 "An alternative way to call B<new()> is supplying an option- hash with one or more of"
NSQ_SOURCE_LINE 00001617 "the following keys set:"
NSQ_SOURCE_LINE 00001618 ""
NSQ_SOURCE_LINE 00001619 "=over"
NSQ_SOURCE_LINE 00001620 ""
NSQ_SOURCE_LINE 00001621 "=item B<-ConfigFile>"
NSQ_SOURCE_LINE 00001622 ""
NSQ_SOURCE_LINE 00001623 "A filename or a filehandle, i.e.:"
NSQ_SOURCE_LINE 00001624 ""
NSQ_SOURCE_LINE 00001625 " -ConfigFile => \"rcfile\" or -ConfigFile => \\$FileHandle"
NSQ_SOURCE_LINE 00001626 ""
NSQ_SOURCE_LINE 00001627 ""
NSQ_SOURCE_LINE 00001628 ""
NSQ_SOURCE_LINE 00001629 "=item B<-ConfigHash>"
NSQ_SOURCE_LINE 00001630 ""
NSQ_SOURCE_LINE 00001631 "A hash reference, which will be used as the config, i.e.:"
NSQ_SOURCE_LINE 00001632 ""
NSQ_SOURCE_LINE 00001633 " -ConfigHash => \\%somehash"
NSQ_SOURCE_LINE 00001634 ""
NSQ_SOURCE_LINE 00001635 ""
NSQ_SOURCE_LINE 00001636 ""
NSQ_SOURCE_LINE 00001637 "=item B<-String>"
NSQ_SOURCE_LINE 00001638 ""
NSQ_SOURCE_LINE 00001639 "A string which contains a whole config, or an arrayref"
NSQ_SOURCE_LINE 00001640 "containing the whole config line by line."
NSQ_SOURCE_LINE 00001641 "The parser will parse the contents of the string instead"
NSQ_SOURCE_LINE 00001642 "of a file. i.e:"
NSQ_SOURCE_LINE 00001643 ""
NSQ_SOURCE_LINE 00001644 " -String => $complete_config"
NSQ_SOURCE_LINE 00001645 ""
NSQ_SOURCE_LINE 00001646 "it is also possible to feed an array reference to -String:"
NSQ_SOURCE_LINE 00001647 ""
NSQ_SOURCE_LINE 00001648 " -String => \\@config_lines"
NSQ_SOURCE_LINE 00001649 ""
NSQ_SOURCE_LINE 00001650 ""
NSQ_SOURCE_LINE 00001651 ""
NSQ_SOURCE_LINE 00001652 "=item B<-AllowMultiOptions>"
NSQ_SOURCE_LINE 00001653 ""
NSQ_SOURCE_LINE 00001654 "If the value is \"no\", then multiple identical options are disallowed."
NSQ_SOURCE_LINE 00001655 "The default is \"yes\"."
NSQ_SOURCE_LINE 00001656 "i.e.:"
NSQ_SOURCE_LINE 00001657 ""
NSQ_SOURCE_LINE 00001658 " -AllowMultiOptions => \"yes\""
NSQ_SOURCE_LINE 00001659 ""
NSQ_SOURCE_LINE 00001660 "see B<IDENTICAL OPTIONS> for details."
NSQ_SOURCE_LINE 00001661 ""
NSQ_SOURCE_LINE 00001662 "=item B<-LowerCaseNames>"
NSQ_SOURCE_LINE 00001663 ""
NSQ_SOURCE_LINE 00001664 "If set to a true value, then all options found in the config will be converted"
NSQ_SOURCE_LINE 00001665 "to lowercase. This allows you to provide case-in-sensitive configs. The"
NSQ_SOURCE_LINE 00001666 "values of the options will B<not> lowercased."
NSQ_SOURCE_LINE 00001667 ""
NSQ_SOURCE_LINE 00001668 ""
NSQ_SOURCE_LINE 00001669 ""
NSQ_SOURCE_LINE 00001670 "=item B<-UseApacheInclude>"
NSQ_SOURCE_LINE 00001671 ""
NSQ_SOURCE_LINE 00001672 "If set to a true value, the parser will consider \"include ...\" as valid include"
NSQ_SOURCE_LINE 00001673 "statement (just like the well known Apache include statement)."
NSQ_SOURCE_LINE 00001674 ""
NSQ_SOURCE_LINE 00001675 "It also supports apache's \"IncludeOptional\" statement with the same behavior,"
NSQ_SOURCE_LINE 00001676 "that is, if the include file doesn't exist no error will be thrown."
NSQ_SOURCE_LINE 00001677 ""
NSQ_SOURCE_LINE 00001678 "=item B<-IncludeRelative>"
NSQ_SOURCE_LINE 00001679 ""
NSQ_SOURCE_LINE 00001680 "If set to a true value, included files with a relative path (i.e. \"cfg/blah.conf\")"
NSQ_SOURCE_LINE 00001681 "will be opened from within the location of the configfile instead from within the"
NSQ_SOURCE_LINE 00001682 "location of the script($0). This works only if the configfile has a absolute pathname"
NSQ_SOURCE_LINE 00001683 "(i.e. \"/etc/main.conf\")."
NSQ_SOURCE_LINE 00001684 ""
NSQ_SOURCE_LINE 00001685 "If the variable B<-ConfigPath> has been set and if the file to be included could"
NSQ_SOURCE_LINE 00001686 "not be found in the location relative to the current config file, the module"
NSQ_SOURCE_LINE 00001687 "will search within B<-ConfigPath> for the file. See the description of B<-ConfigPath>"
NSQ_SOURCE_LINE 00001688 "for more details."
NSQ_SOURCE_LINE 00001689 ""
NSQ_SOURCE_LINE 00001690 ""
NSQ_SOURCE_LINE 00001691 "=item B<-IncludeDirectories>"
NSQ_SOURCE_LINE 00001692 ""
NSQ_SOURCE_LINE 00001693 "If set to a true value, you may specify include a directory, in which case all"
NSQ_SOURCE_LINE 00001694 "files inside the directory will be loaded in ASCII order.  Directory includes"
NSQ_SOURCE_LINE 00001695 "will not recurse into subdirectories.  This is comparable to including a"
NSQ_SOURCE_LINE 00001696 "directory in Apache-style config files."
NSQ_SOURCE_LINE 00001697 ""
NSQ_SOURCE_LINE 00001698 ""
NSQ_SOURCE_LINE 00001699 "=item B<-IncludeGlob>"
NSQ_SOURCE_LINE 00001700 ""
NSQ_SOURCE_LINE 00001701 "If set to a true value, you may specify a glob pattern for an include to"
NSQ_SOURCE_LINE 00001702 "include all matching files (e.g. <<include conf.d/*.conf>>).  Also note that as"
NSQ_SOURCE_LINE 00001703 "with standard file patterns, * will not match dot-files, so <<include dir/*>>"
NSQ_SOURCE_LINE 00001704 "is often more desirable than including a directory with B<-IncludeDirectories>."
NSQ_SOURCE_LINE 00001705 ""
NSQ_SOURCE_LINE 00001706 "An include option will not cause a parser error if the glob didn't return anything."
NSQ_SOURCE_LINE 00001707 ""
NSQ_SOURCE_LINE 00001708 "=item B<-IncludeAgain>"
NSQ_SOURCE_LINE 00001709 ""
NSQ_SOURCE_LINE 00001710 "If set to a true value, you will be able to include a sub-configfile"
NSQ_SOURCE_LINE 00001711 "multiple times.  With the default, false, you will get a warning about"
NSQ_SOURCE_LINE 00001712 "duplicate includes and only the first include will succeed."
NSQ_SOURCE_LINE 00001713 ""
NSQ_SOURCE_LINE 00001714 "Reincluding a configfile can be useful if it contains data that you want to"
NSQ_SOURCE_LINE 00001715 "be present in multiple places in the data tree.  See the example under"
NSQ_SOURCE_LINE 00001716 "L</INCLUDES>."
NSQ_SOURCE_LINE 00001717 ""
NSQ_SOURCE_LINE 00001718 "Note, however, that there is currently no check for include recursion."
NSQ_SOURCE_LINE 00001719 ""
NSQ_SOURCE_LINE 00001720 ""
NSQ_SOURCE_LINE 00001721 "=item B<-ConfigPath>"
NSQ_SOURCE_LINE 00001722 ""
NSQ_SOURCE_LINE 00001723 "As mentioned above, you can use this variable to specify a search path for relative"
NSQ_SOURCE_LINE 00001724 "config files which have to be included. Config::General will search within this"
NSQ_SOURCE_LINE 00001725 "path for the file if it cannot find the file at the location relative to the"
NSQ_SOURCE_LINE 00001726 "current config file."
NSQ_SOURCE_LINE 00001727 ""
NSQ_SOURCE_LINE 00001728 "To provide multiple search paths you can specify an array reference for the"
NSQ_SOURCE_LINE 00001729 "path.  For example:"
NSQ_SOURCE_LINE 00001730 ""
NSQ_SOURCE_LINE 00001731 " @path = qw(/usr/lib/perl /nfs/apps/lib /home/lib);"
NSQ_SOURCE_LINE 00001732 " .."
NSQ_SOURCE_LINE 00001733 " -ConfigPath => \\@path"
NSQ_SOURCE_LINE 00001734 ""
NSQ_SOURCE_LINE 00001735 ""
NSQ_SOURCE_LINE 00001736 ""
NSQ_SOURCE_LINE 00001737 "=item B<-MergeDuplicateBlocks>"
NSQ_SOURCE_LINE 00001738 ""
NSQ_SOURCE_LINE 00001739 "If set to a true value, then duplicate blocks, that means blocks and named blocks,"
NSQ_SOURCE_LINE 00001740 "will be merged into a single one (see below for more details on this)."
NSQ_SOURCE_LINE 00001741 "The default behavior of Config::General is to create an array if some junk in a"
NSQ_SOURCE_LINE 00001742 "config appears more than once."
NSQ_SOURCE_LINE 00001743 ""
NSQ_SOURCE_LINE 00001744 ""
NSQ_SOURCE_LINE 00001745 "=item B<-MergeDuplicateOptions>"
NSQ_SOURCE_LINE 00001746 ""
NSQ_SOURCE_LINE 00001747 "If set to a true value, then duplicate options will be merged. That means, if the"
NSQ_SOURCE_LINE 00001748 "same option occurs more than once, the last one will be used in the resulting"
NSQ_SOURCE_LINE 00001749 "config hash."
NSQ_SOURCE_LINE 00001750 ""
NSQ_SOURCE_LINE 00001751 "Setting this option implies B<-AllowMultiOptions == false> unless you set"
NSQ_SOURCE_LINE 00001752 "B<-AllowMultiOptions> explicit to 'true'. In this case duplicate blocks are"
NSQ_SOURCE_LINE 00001753 "allowed and put into an array but duplicate options will be merged."
NSQ_SOURCE_LINE 00001754 ""
NSQ_SOURCE_LINE 00001755 ""
NSQ_SOURCE_LINE 00001756 "=item B<-AutoLaunder>"
NSQ_SOURCE_LINE 00001757 ""
NSQ_SOURCE_LINE 00001758 "If set to a true value, then all values in your config file will be laundered"
NSQ_SOURCE_LINE 00001759 "to allow them to be used under a -T taint flag.  This could be regarded as circumventing"
NSQ_SOURCE_LINE 00001760 "the purpose of the -T flag, however, if the bad guys can mess with your config file,"
NSQ_SOURCE_LINE 00001761 "you have problems that -T will not be able to stop.  AutoLaunder will only handle"
NSQ_SOURCE_LINE 00001762 "a config file being read from -ConfigFile."
NSQ_SOURCE_LINE 00001763 ""
NSQ_SOURCE_LINE 00001764 ""
NSQ_SOURCE_LINE 00001765 ""
NSQ_SOURCE_LINE 00001766 "=item B<-AutoTrue>"
NSQ_SOURCE_LINE 00001767 ""
NSQ_SOURCE_LINE 00001768 "If set to a true value, then options in your config file, whose values are set to"
NSQ_SOURCE_LINE 00001769 "true or false values, will be normalised to 1 or 0 respectively."
NSQ_SOURCE_LINE 00001770 ""
NSQ_SOURCE_LINE 00001771 "The following values will be considered as B<true>:"
NSQ_SOURCE_LINE 00001772 ""
NSQ_SOURCE_LINE 00001773 " yes, on, 1, true"
NSQ_SOURCE_LINE 00001774 ""
NSQ_SOURCE_LINE 00001775 "The following values will be considered as B<false>:"
NSQ_SOURCE_LINE 00001776 ""
NSQ_SOURCE_LINE 00001777 " no, off, 0, false"
NSQ_SOURCE_LINE 00001778 ""
NSQ_SOURCE_LINE 00001779 "This effect is case-insensitive, i.e. both \"Yes\" or \"No\" will result in 1."
NSQ_SOURCE_LINE 00001780 ""
NSQ_SOURCE_LINE 00001781 ""
NSQ_SOURCE_LINE 00001782 "=item B<-FlagBits>"
NSQ_SOURCE_LINE 00001783 ""
NSQ_SOURCE_LINE 00001784 "This option takes one required parameter, which must be a hash reference."
NSQ_SOURCE_LINE 00001785 ""
NSQ_SOURCE_LINE 00001786 "The supplied hash reference needs to define variables for which you"
NSQ_SOURCE_LINE 00001787 "want to preset values. Each variable you have defined in this hash-ref"
NSQ_SOURCE_LINE 00001788 "and which occurs in your config file, will cause this variable being"
NSQ_SOURCE_LINE 00001789 "set to the preset values to which the value in the config file refers to."
NSQ_SOURCE_LINE 00001790 ""
NSQ_SOURCE_LINE 00001791 "Multiple flags can be used, separated by the pipe character |."
NSQ_SOURCE_LINE 00001792 ""
NSQ_SOURCE_LINE 00001793 "Well, an example will clarify things:"
NSQ_SOURCE_LINE 00001794 ""
NSQ_SOURCE_LINE 00001795 " my $conf = Config::General->new("
NSQ_SOURCE_LINE 00001796 "         -ConfigFile => \"rcfile\","
NSQ_SOURCE_LINE 00001797 "         -FlagBits => {"
NSQ_SOURCE_LINE 00001798 "              Mode => {"
NSQ_SOURCE_LINE 00001799 "                 CLEAR    => 1,"
NSQ_SOURCE_LINE 00001800 "                 STRONG   => 1,"
NSQ_SOURCE_LINE 00001801 "                 UNSECURE => \"32bit\" }"
NSQ_SOURCE_LINE 00001802 "         }"
NSQ_SOURCE_LINE 00001803 " );"
NSQ_SOURCE_LINE 00001804 ""
NSQ_SOURCE_LINE 00001805 "In this example we are defining a variable named I<\"Mode\"> which"
NSQ_SOURCE_LINE 00001806 "may contain one or more of \"CLEAR\", \"STRONG\" and \"UNSECURE\" as value."
NSQ_SOURCE_LINE 00001807 ""
NSQ_SOURCE_LINE 00001808 "The appropriate config entry may look like this:"
NSQ_SOURCE_LINE 00001809 ""
NSQ_SOURCE_LINE 00001810 " # rcfile"
NSQ_SOURCE_LINE 00001811 " Mode = CLEAR | UNSECURE"
NSQ_SOURCE_LINE 00001812 ""
NSQ_SOURCE_LINE 00001813 "The parser will create a hash which will be the value of the key \"Mode\". This"
NSQ_SOURCE_LINE 00001814 "hash will contain B<all> flags which you have pre-defined, but only those"
NSQ_SOURCE_LINE 00001815 "which were set in the config will contain the pre-defined value, the other"
NSQ_SOURCE_LINE 00001816 "ones will be undefined."
NSQ_SOURCE_LINE 00001817 ""
NSQ_SOURCE_LINE 00001818 "The resulting config structure would look like this after parsing:"
NSQ_SOURCE_LINE 00001819 ""
NSQ_SOURCE_LINE 00001820 " %config = ("
NSQ_SOURCE_LINE 00001821 "             Mode => {"
NSQ_SOURCE_LINE 00001822 "                       CLEAR    => 1,"
NSQ_SOURCE_LINE 00001823 "                       UNSECURE => \"32bit\","
NSQ_SOURCE_LINE 00001824 "                       STRONG   => undef,"
NSQ_SOURCE_LINE 00001825 "                     }"
NSQ_SOURCE_LINE 00001826 "           );"
NSQ_SOURCE_LINE 00001827 ""
NSQ_SOURCE_LINE 00001828 "This method allows the user (or, the \"maintainer\" of the configfile for your"
NSQ_SOURCE_LINE 00001829 "application) to set multiple pre-defined values for one option."
NSQ_SOURCE_LINE 00001830 ""
NSQ_SOURCE_LINE 00001831 "Please beware, that all occurrences of those variables will be handled this"
NSQ_SOURCE_LINE 00001832 "way, there is no way to distinguish between variables in different scopes."
NSQ_SOURCE_LINE 00001833 "That means, if \"Mode\" would also occur inside a named block, it would"
NSQ_SOURCE_LINE 00001834 "also parsed this way."
NSQ_SOURCE_LINE 00001835 ""
NSQ_SOURCE_LINE 00001836 "Values which are not defined in the hash-ref supplied to the parameter B<-FlagBits>"
NSQ_SOURCE_LINE 00001837 "and used in the corresponding variable in the config will be ignored."
NSQ_SOURCE_LINE 00001838 ""
NSQ_SOURCE_LINE 00001839 "Example:"
NSQ_SOURCE_LINE 00001840 ""
NSQ_SOURCE_LINE 00001841 " # rcfile"
NSQ_SOURCE_LINE 00001842 " Mode = BLAH | CLEAR"
NSQ_SOURCE_LINE 00001843 ""
NSQ_SOURCE_LINE 00001844 "would result in this hash structure:"
NSQ_SOURCE_LINE 00001845 ""
NSQ_SOURCE_LINE 00001846 "  %config = ("
NSQ_SOURCE_LINE 00001847 "             Mode => {"
NSQ_SOURCE_LINE 00001848 "                       CLEAR    => 1,"
NSQ_SOURCE_LINE 00001849 "                       UNSECURE => undef,"
NSQ_SOURCE_LINE 00001850 "                       STRONG   => undef,"
NSQ_SOURCE_LINE 00001851 "                     }"
NSQ_SOURCE_LINE 00001852 "           );"
NSQ_SOURCE_LINE 00001853 ""
NSQ_SOURCE_LINE 00001854 "\"BLAH\" will be ignored silently."
NSQ_SOURCE_LINE 00001855 ""
NSQ_SOURCE_LINE 00001856 ""
NSQ_SOURCE_LINE 00001857 "=item B<-DefaultConfig>"
NSQ_SOURCE_LINE 00001858 ""
NSQ_SOURCE_LINE 00001859 "This can be a hash reference or a simple scalar (string) of a config. This"
NSQ_SOURCE_LINE 00001860 "causes the module to preset the resulting config hash with the given values,"
NSQ_SOURCE_LINE 00001861 "which allows you to set default values for particular config options directly."
NSQ_SOURCE_LINE 00001862 ""
NSQ_SOURCE_LINE 00001863 "Note that you probably want to use this with B<-MergeDuplicateOptions>, otherwise"
NSQ_SOURCE_LINE 00001864 "a default value already in the configuration file will produce an array of two"
NSQ_SOURCE_LINE 00001865 "values."
NSQ_SOURCE_LINE 00001866 ""
NSQ_SOURCE_LINE 00001867 "=item B<-Tie>"
NSQ_SOURCE_LINE 00001868 ""
NSQ_SOURCE_LINE 00001869 "B<-Tie> takes the name of a Tie class as argument that each new hash should be"
NSQ_SOURCE_LINE 00001870 "based off of."
NSQ_SOURCE_LINE 00001871 ""
NSQ_SOURCE_LINE 00001872 "This hash will be used as the 'backing hash' instead of a standard Perl hash,"
NSQ_SOURCE_LINE 00001873 "which allows you to affect the way, variable storing will be done. You could, for"
NSQ_SOURCE_LINE 00001874 "example supply a tied hash, say Tie::DxHash, which preserves ordering of the"
NSQ_SOURCE_LINE 00001875 "keys in the config (which a standard Perl hash won't do). Or, you could supply"
NSQ_SOURCE_LINE 00001876 "a hash tied to a DBM file to save the parsed variables to disk."
NSQ_SOURCE_LINE 00001877 ""
NSQ_SOURCE_LINE 00001878 "There are many more things to do in tie-land, see L<tie> to get some interesting"
NSQ_SOURCE_LINE 00001879 "ideas."
NSQ_SOURCE_LINE 00001880 ""
NSQ_SOURCE_LINE 00001881 "If you want to use the B<-Tie> feature together with B<-DefaultConfig> make sure"
NSQ_SOURCE_LINE 00001882 "that the hash supplied to B<-DefaultConfig> must be tied to the same Tie class."
NSQ_SOURCE_LINE 00001883 ""
NSQ_SOURCE_LINE 00001884 "Make sure that the hash which receives the generated hash structure (e.g. which"
NSQ_SOURCE_LINE 00001885 "you are using in the assignment: %hash = $config->getall()) must be tied to"
NSQ_SOURCE_LINE 00001886 "the same Tie class."
NSQ_SOURCE_LINE 00001887 ""
NSQ_SOURCE_LINE 00001888 "Example:"
NSQ_SOURCE_LINE 00001889 ""
NSQ_SOURCE_LINE 00001890 " use Config::General qw(ParseConfig);"
NSQ_SOURCE_LINE 00001891 " use Tie::IxHash;"
NSQ_SOURCE_LINE 00001892 " tie my %hash, \"Tie::IxHash\";"
NSQ_SOURCE_LINE 00001893 " %hash = ParseConfig("
NSQ_SOURCE_LINE 00001894 "           -ConfigFile => shift(),"
NSQ_SOURCE_LINE 00001895 "           -Tie => \"Tie::IxHash\""
NSQ_SOURCE_LINE 00001896 "\t );"
NSQ_SOURCE_LINE 00001897 ""
NSQ_SOURCE_LINE 00001898 ""
NSQ_SOURCE_LINE 00001899 "=item B<-InterPolateVars>"
NSQ_SOURCE_LINE 00001900 ""
NSQ_SOURCE_LINE 00001901 "If set to a true value, variable interpolation will be done on your config"
NSQ_SOURCE_LINE 00001902 "input. See L<Config::General::Interpolated> for more information."
NSQ_SOURCE_LINE 00001903 ""
NSQ_SOURCE_LINE 00001904 "=item B<-InterPolateEnv>"
NSQ_SOURCE_LINE 00001905 ""
NSQ_SOURCE_LINE 00001906 "If set to a true value, environment variables can be used in"
NSQ_SOURCE_LINE 00001907 "configs."
NSQ_SOURCE_LINE 00001908 ""
NSQ_SOURCE_LINE 00001909 "This implies B<-InterPolateVars>."
NSQ_SOURCE_LINE 00001910 ""
NSQ_SOURCE_LINE 00001911 "=item B<-AllowSingleQuoteInterpolation>"
NSQ_SOURCE_LINE 00001912 ""
NSQ_SOURCE_LINE 00001913 "By default variables inside single quotes will not be interpolated. If"
NSQ_SOURCE_LINE 00001914 "you turn on this option, they will be interpolated as well."
NSQ_SOURCE_LINE 00001915 ""
NSQ_SOURCE_LINE 00001916 "=item B<-ExtendedAccess>"
NSQ_SOURCE_LINE 00001917 ""
NSQ_SOURCE_LINE 00001918 "If set to a true value, you can use object oriented (extended) methods to"
NSQ_SOURCE_LINE 00001919 "access the parsed config. See L<Config::General::Extended> for more information."
NSQ_SOURCE_LINE 00001920 ""
NSQ_SOURCE_LINE 00001921 "=item B<-StrictObjects>"
NSQ_SOURCE_LINE 00001922 ""
NSQ_SOURCE_LINE 00001923 "By default this is turned on, which causes Config::General to croak with an"
NSQ_SOURCE_LINE 00001924 "error if you try to access a non-existent key using the OOP-way (B<-ExtendedAcess>"
NSQ_SOURCE_LINE 00001925 "enabled). If you turn B<-StrictObjects> off (by setting to 0 or \"no\") it will"
NSQ_SOURCE_LINE 00001926 "just return an empty object/hash/scalar. This is valid for OOP-access 8via AUTOLOAD"
NSQ_SOURCE_LINE 00001927 "and for the methods obj(), hash() and value()."
NSQ_SOURCE_LINE 00001928 ""
NSQ_SOURCE_LINE 00001929 ""
NSQ_SOURCE_LINE 00001930 "=item B<-StrictVars>"
NSQ_SOURCE_LINE 00001931 ""
NSQ_SOURCE_LINE 00001932 "By default this is turned on, which causes Config::General to croak with an"
NSQ_SOURCE_LINE 00001933 "error if an undefined variable with B<InterPolateVars> turned on occurs"
NSQ_SOURCE_LINE 00001934 "in a config. Set to I<false> (i.e. 0) to avoid such error messages."
NSQ_SOURCE_LINE 00001935 ""
NSQ_SOURCE_LINE 00001936 "=item B<-SplitPolicy>"
NSQ_SOURCE_LINE 00001937 ""
NSQ_SOURCE_LINE 00001938 "You can influence the way how Config::General decides which part of a line"
NSQ_SOURCE_LINE 00001939 "in a config file is the key and which one is the value. By default it tries"
NSQ_SOURCE_LINE 00001940 "its best to guess. That means you can mix equalsign assignments and whitespace"
NSQ_SOURCE_LINE 00001941 "assignments."
NSQ_SOURCE_LINE 00001942 ""
NSQ_SOURCE_LINE 00001943 "However, sometime you may wish to make it more strictly for some reason. In"
NSQ_SOURCE_LINE 00001944 "this case you can set B<-SplitPolicy>. The possible values are: 'guess' which"
NSQ_SOURCE_LINE 00001945 "is the default, 'whitespace' which causes the module to split by whitespace,"
NSQ_SOURCE_LINE 00001946 "'equalsign' which causes it to split strictly by equal sign, or 'custom'. In the"
NSQ_SOURCE_LINE 00001947 "latter case you must also set B<-SplitDelimiter> to some regular expression"
NSQ_SOURCE_LINE 00001948 "of your choice. For example:"
NSQ_SOURCE_LINE 00001949 ""
NSQ_SOURCE_LINE 00001950 " -SplitDelimiter => '\\s*:\\s*'"
NSQ_SOURCE_LINE 00001951 ""
NSQ_SOURCE_LINE 00001952 "will cause the module to split by colon while whitespace which surrounds"
NSQ_SOURCE_LINE 00001953 "the delimiter will be removed."
NSQ_SOURCE_LINE 00001954 ""
NSQ_SOURCE_LINE 00001955 "Please note that the delimiter used when saving a config (save_file() or save_string())"
NSQ_SOURCE_LINE 00001956 "will be chosen according to the current B<-SplitPolicy>. If -SplitPolicy is"
NSQ_SOURCE_LINE 00001957 "set to 'guess' or 'whitespace', 3 spaces will be used to delimit saved"
NSQ_SOURCE_LINE 00001958 "options. If 'custom' is set, then you need to set B<-StoreDelimiter>."
NSQ_SOURCE_LINE 00001959 ""
NSQ_SOURCE_LINE 00001960 "=item B<-SplitDelimiter>"
NSQ_SOURCE_LINE 00001961 ""
NSQ_SOURCE_LINE 00001962 "Set this to any arbitrary regular expression which will be used for option/value"
NSQ_SOURCE_LINE 00001963 "splitting. B<-SplitPolicy> must be set to 'custom' to make this work."
NSQ_SOURCE_LINE 00001964 ""
NSQ_SOURCE_LINE 00001965 "=item B<-StoreDelimiter>"
NSQ_SOURCE_LINE 00001966 ""
NSQ_SOURCE_LINE 00001967 "You can use this parameter to specify a custom delimiter to use when saving"
NSQ_SOURCE_LINE 00001968 "configs to a file or string. You only need to set it if you want to store"
NSQ_SOURCE_LINE 00001969 "the config back to disk and if you have B<-SplitPolicy> set to 'custom'."
NSQ_SOURCE_LINE 00001970 ""
NSQ_SOURCE_LINE 00001971 "However, this parameter takes precedence over whatever is set for B<-SplitPolicy>."
NSQ_SOURCE_LINE 00001972 ""
NSQ_SOURCE_LINE 00001973 "Be very careful with this parameter."
NSQ_SOURCE_LINE 00001974 ""
NSQ_SOURCE_LINE 00001975 ""
NSQ_SOURCE_LINE 00001976 "=item B<-CComments>"
NSQ_SOURCE_LINE 00001977 ""
NSQ_SOURCE_LINE 00001978 "Config::General is able to notice c-style comments (see section COMMENTS)."
NSQ_SOURCE_LINE 00001979 "But for some reason you might no need this. In this case you can turn"
NSQ_SOURCE_LINE 00001980 "this feature off by setting B<-CComments> to a false value('no', 0, 'off')."
NSQ_SOURCE_LINE 00001981 ""
NSQ_SOURCE_LINE 00001982 "By default B<-CComments> is turned on."
NSQ_SOURCE_LINE 00001983 ""
NSQ_SOURCE_LINE 00001984 ""
NSQ_SOURCE_LINE 00001985 "=item B<-BackslashEscape>"
NSQ_SOURCE_LINE 00001986 ""
NSQ_SOURCE_LINE 00001987 "B<Deprecated Option>."
NSQ_SOURCE_LINE 00001988 ""
NSQ_SOURCE_LINE 00001989 "=item B<-SlashIsDirectory>"
NSQ_SOURCE_LINE 00001990 ""
NSQ_SOURCE_LINE 00001991 "If you turn on this parameter, a single slash as the last character"
NSQ_SOURCE_LINE 00001992 "of a named block will be considered as a directory name."
NSQ_SOURCE_LINE 00001993 ""
NSQ_SOURCE_LINE 00001994 "By default this flag is turned off, which makes the module somewhat"
NSQ_SOURCE_LINE 00001995 "incompatible to Apache configs, since such a setup will be normally"
NSQ_SOURCE_LINE 00001996 "considered as an explicit empty block, just as XML defines it."
NSQ_SOURCE_LINE 00001997 ""
NSQ_SOURCE_LINE 00001998 "For example, if you have the following config:"
NSQ_SOURCE_LINE 00001999 ""
NSQ_SOURCE_LINE 00002000 " <Directory />"
NSQ_SOURCE_LINE 00002001 "   Index index.awk"
NSQ_SOURCE_LINE 00002002 " </Directory>"
NSQ_SOURCE_LINE 00002003 ""
NSQ_SOURCE_LINE 00002004 "you will get such an error message from the parser:"
NSQ_SOURCE_LINE 00002005 ""
NSQ_SOURCE_LINE 00002006 " EndBlock \"</Directory>\" has no StartBlock statement (level: 1, chunk 10)!"
NSQ_SOURCE_LINE 00002007 ""
NSQ_SOURCE_LINE 00002008 "This is caused by the fact that the config chunk below will be"
NSQ_SOURCE_LINE 00002009 "internally converted to:"
NSQ_SOURCE_LINE 00002010 ""
NSQ_SOURCE_LINE 00002011 " <Directory></Directory>"
NSQ_SOURCE_LINE 00002012 "   Index index.awk"
NSQ_SOURCE_LINE 00002013 " </Directory>"
NSQ_SOURCE_LINE 00002014 ""
NSQ_SOURCE_LINE 00002015 "Now there is one '</Directory>' too much. The proper solution is"
NSQ_SOURCE_LINE 00002016 "to use quotation to circumvent this error:"
NSQ_SOURCE_LINE 00002017 ""
NSQ_SOURCE_LINE 00002018 " <Directory \"/\">"
NSQ_SOURCE_LINE 00002019 "   Index index.awk"
NSQ_SOURCE_LINE 00002020 " </Directory>"
NSQ_SOURCE_LINE 00002021 ""
NSQ_SOURCE_LINE 00002022 "However, a raw apache config comes without such quotes. In this"
NSQ_SOURCE_LINE 00002023 "case you may consider to turn on B<-SlashIsDirectory>."
NSQ_SOURCE_LINE 00002024 ""
NSQ_SOURCE_LINE 00002025 "Please note that this is a new option (incorporated in version 2.30),"
NSQ_SOURCE_LINE 00002026 "it may lead to various unexpected side effects or other failures."
NSQ_SOURCE_LINE 00002027 "You've been warned."
NSQ_SOURCE_LINE 00002028 ""
NSQ_SOURCE_LINE 00002029 "=item B<-UseApacheIfDefine>"
NSQ_SOURCE_LINE 00002030 ""
NSQ_SOURCE_LINE 00002031 "Enables support for Apache <IfDefine> ... </IfDefine>. See -Define."
NSQ_SOURCE_LINE 00002032 ""
NSQ_SOURCE_LINE 00002033 "=item B<-Define>"
NSQ_SOURCE_LINE 00002034 ""
NSQ_SOURCE_LINE 00002035 "Defines the symbols to be used for conditional configuration files."
NSQ_SOURCE_LINE 00002036 "Allowed arguments: scalar, scalar ref, array ref or hash ref."
NSQ_SOURCE_LINE 00002037 ""
NSQ_SOURCE_LINE 00002038 "Examples:"
NSQ_SOURCE_LINE 00002039 ""
NSQ_SOURCE_LINE 00002040 " -Define => 'TEST'"
NSQ_SOURCE_LINE 00002041 " -Define => \\$testOrProduction"
NSQ_SOURCE_LINE 00002042 " -Define => [qw(TEST VERBOSE)]"
NSQ_SOURCE_LINE 00002043 " -Define => {TEST => 1, VERBOSE => 1}"
NSQ_SOURCE_LINE 00002044 ""
NSQ_SOURCE_LINE 00002045 "Sample configuration:"
NSQ_SOURCE_LINE 00002046 ""
NSQ_SOURCE_LINE 00002047 "  <Logging>"
NSQ_SOURCE_LINE 00002048 "    <IfDefine TEST>"
NSQ_SOURCE_LINE 00002049 "       Level Debug"
NSQ_SOURCE_LINE 00002050 "       include test/*.cfg"
NSQ_SOURCE_LINE 00002051 "    </IfDef>"
NSQ_SOURCE_LINE 00002052 "    <IfDefine !TEST>"
NSQ_SOURCE_LINE 00002053 "      Level Notice"
NSQ_SOURCE_LINE 00002054 "       include production/*.cfg"
NSQ_SOURCE_LINE 00002055 "    </IfDefine>"
NSQ_SOURCE_LINE 00002056 "  </Logging>"
NSQ_SOURCE_LINE 00002057 ""
NSQ_SOURCE_LINE 00002058 "=item B<-ApacheCompatible>"
NSQ_SOURCE_LINE 00002059 ""
NSQ_SOURCE_LINE 00002060 "Over the past years a lot of options has been incorporated"
NSQ_SOURCE_LINE 00002061 "into Config::General to be able to parse real Apache configs."
NSQ_SOURCE_LINE 00002062 ""
NSQ_SOURCE_LINE 00002063 "The new B<-ApacheCompatible> option now makes it possible to"
NSQ_SOURCE_LINE 00002064 "tweak all options in a way that Apache configs can be parsed."
NSQ_SOURCE_LINE 00002065 ""
NSQ_SOURCE_LINE 00002066 "This is called \"apache compatibility mode\" - if you will ever"
NSQ_SOURCE_LINE 00002067 "have problems with parsing Apache configs without this option"
NSQ_SOURCE_LINE 00002068 "being set, you'll get no help by me. Thanks :)"
NSQ_SOURCE_LINE 00002069 ""
NSQ_SOURCE_LINE 00002070 "The following options will be set:"
NSQ_SOURCE_LINE 00002071 ""
NSQ_SOURCE_LINE 00002072 " UseApacheInclude   = 1"
NSQ_SOURCE_LINE 00002073 " IncludeRelative    = 1"
NSQ_SOURCE_LINE 00002074 " IncludeDirectories = 1"
NSQ_SOURCE_LINE 00002075 " IncludeGlob        = 1"
NSQ_SOURCE_LINE 00002076 " SlashIsDirectory   = 1"
NSQ_SOURCE_LINE 00002077 " SplitPolicy        = 'whitespace'"
NSQ_SOURCE_LINE 00002078 " CComments          = 0"
NSQ_SOURCE_LINE 00002079 " UseApacheIfDefine  = 1"
NSQ_SOURCE_LINE 00002080 ""
NSQ_SOURCE_LINE 00002081 "Take a look into the particular documentation sections what"
NSQ_SOURCE_LINE 00002082 "those options are doing."
NSQ_SOURCE_LINE 00002083 ""
NSQ_SOURCE_LINE 00002084 "Beside setting some options it also turns off support for"
NSQ_SOURCE_LINE 00002085 "explicit empty blocks."
NSQ_SOURCE_LINE 00002086 ""
NSQ_SOURCE_LINE 00002087 "=item B<-UTF8>"
NSQ_SOURCE_LINE 00002088 ""
NSQ_SOURCE_LINE 00002089 "If turned on, all files will be opened in utf8 mode. This may"
NSQ_SOURCE_LINE 00002090 "not work properly with older versions of Perl."
NSQ_SOURCE_LINE 00002091 ""
NSQ_SOURCE_LINE 00002092 "=item B<-SaveSorted>"
NSQ_SOURCE_LINE 00002093 ""
NSQ_SOURCE_LINE 00002094 "If you want to save configs in a sorted manner, turn this"
NSQ_SOURCE_LINE 00002095 "parameter on. It is not enabled by default."
NSQ_SOURCE_LINE 00002096 ""
NSQ_SOURCE_LINE 00002097 "=item B<-NoEscape>"
NSQ_SOURCE_LINE 00002098 ""
NSQ_SOURCE_LINE 00002099 "If you want to use the data ( scalar or final leaf ) without escaping special character, turn this"
NSQ_SOURCE_LINE 00002100 "parameter on. It is not enabled by default."
NSQ_SOURCE_LINE 00002101 ""
NSQ_SOURCE_LINE 00002102 "=item B<-NormalizeBlock>"
NSQ_SOURCE_LINE 00002103 ""
NSQ_SOURCE_LINE 00002104 "Takes a subroutine reference as parameter and gets the current"
NSQ_SOURCE_LINE 00002105 "block or blockname passed as parameter and is expected to return"
NSQ_SOURCE_LINE 00002106 "it in some altered way as a scalar string. The sub will be called"
NSQ_SOURCE_LINE 00002107 "before anything else will be done by the module itself (e.g. interpolation)."
NSQ_SOURCE_LINE 00002108 ""
NSQ_SOURCE_LINE 00002109 "Example:"
NSQ_SOURCE_LINE 00002110 ""
NSQ_SOURCE_LINE 00002111 " -NormalizeBlock => sub { my $x = shift; $x =~ s/\\s*$//; $x; }"
NSQ_SOURCE_LINE 00002112 ""
NSQ_SOURCE_LINE 00002113 "This removes trailing whitespaces of block names."
NSQ_SOURCE_LINE 00002114 ""
NSQ_SOURCE_LINE 00002115 "=item B<-NormalizeOption>"
NSQ_SOURCE_LINE 00002116 ""
NSQ_SOURCE_LINE 00002117 "Same as B<-NormalizeBlock> but applied on options only."
NSQ_SOURCE_LINE 00002118 ""
NSQ_SOURCE_LINE 00002119 "=item B<-NormalizeValue>"
NSQ_SOURCE_LINE 00002120 ""
NSQ_SOURCE_LINE 00002121 "Same as B<-NormalizeBlock> but applied on values only."
NSQ_SOURCE_LINE 00002122 ""
NSQ_SOURCE_LINE 00002123 "=item B<-AlwaysQuoteOutput>"
NSQ_SOURCE_LINE 00002124 ""
NSQ_SOURCE_LINE 00002125 "If set to  true, then values containing whitespace  will always quoted"
NSQ_SOURCE_LINE 00002126 "when calling C<save_string()> or C<save_file()>."
NSQ_SOURCE_LINE 00002127 ""
NSQ_SOURCE_LINE 00002128 "=back"
NSQ_SOURCE_LINE 00002129 ""
NSQ_SOURCE_LINE 00002130 ""
NSQ_SOURCE_LINE 00002131 ""
NSQ_SOURCE_LINE 00002132 ""
NSQ_SOURCE_LINE 00002133 "=item getall()"
NSQ_SOURCE_LINE 00002134 ""
NSQ_SOURCE_LINE 00002135 "Returns a hash structure which represents the whole config."
NSQ_SOURCE_LINE 00002136 ""
NSQ_SOURCE_LINE 00002137 "=item files()"
NSQ_SOURCE_LINE 00002138 ""
NSQ_SOURCE_LINE 00002139 "Returns a list of all files read in."
NSQ_SOURCE_LINE 00002140 ""
NSQ_SOURCE_LINE 00002141 "=item save_file()"
NSQ_SOURCE_LINE 00002142 ""
NSQ_SOURCE_LINE 00002143 "Writes the config hash back to the hard disk. This method takes one or two"
NSQ_SOURCE_LINE 00002144 "parameters. The first parameter must be the filename where the config"
NSQ_SOURCE_LINE 00002145 "should be written to. The second parameter is optional, it must be a"
NSQ_SOURCE_LINE 00002146 "reference to a hash structure, if you set it. If you do not supply this second parameter"
NSQ_SOURCE_LINE 00002147 "then the internal config hash, which has already been parsed, will be"
NSQ_SOURCE_LINE 00002148 "used."
NSQ_SOURCE_LINE 00002149 ""
NSQ_SOURCE_LINE 00002150 "Please note that any occurrence of comments will be ignored by getall()"
NSQ_SOURCE_LINE 00002151 "and thus be lost after you call this method."
NSQ_SOURCE_LINE 00002152 ""
NSQ_SOURCE_LINE 00002153 "You need also to know that named blocks will be converted to nested blocks"
NSQ_SOURCE_LINE 00002154 "(which is the same from the perl point of view). An example:"
NSQ_SOURCE_LINE 00002155 ""
NSQ_SOURCE_LINE 00002156 " <user hans>"
NSQ_SOURCE_LINE 00002157 "   id 13"
NSQ_SOURCE_LINE 00002158 " </user>"
NSQ_SOURCE_LINE 00002159 ""
NSQ_SOURCE_LINE 00002160 "will become the following after saving:"
NSQ_SOURCE_LINE 00002161 ""
NSQ_SOURCE_LINE 00002162 " <user>"
NSQ_SOURCE_LINE 00002163 "   <hans>"
NSQ_SOURCE_LINE 00002164 "      id 13"
NSQ_SOURCE_LINE 00002165 "   </hans>"
NSQ_SOURCE_LINE 00002166 " </user>"
NSQ_SOURCE_LINE 00002167 ""
NSQ_SOURCE_LINE 00002168 "Example:"
NSQ_SOURCE_LINE 00002169 ""
NSQ_SOURCE_LINE 00002170 " $conf_obj->save_file(\"newrcfile\", \\%config);"
NSQ_SOURCE_LINE 00002171 ""
NSQ_SOURCE_LINE 00002172 "or, if the config has already been parsed, or if it didn't change:"
NSQ_SOURCE_LINE 00002173 ""
NSQ_SOURCE_LINE 00002174 " $conf_obj->save_file(\"newrcfile\");"
NSQ_SOURCE_LINE 00002175 ""
NSQ_SOURCE_LINE 00002176 ""
NSQ_SOURCE_LINE 00002177 "=item save_string()"
NSQ_SOURCE_LINE 00002178 ""
NSQ_SOURCE_LINE 00002179 "This method is equivalent to the previous save_file(), but it does not"
NSQ_SOURCE_LINE 00002180 "store the generated config to a file. Instead it returns it as a string,"
NSQ_SOURCE_LINE 00002181 "which you can save yourself afterwards."
NSQ_SOURCE_LINE 00002182 ""
NSQ_SOURCE_LINE 00002183 "It takes one optional parameter, which must be a reference to a hash structure."
NSQ_SOURCE_LINE 00002184 "If you omit this parameter, the internal config hash, which has already been parsed,"
NSQ_SOURCE_LINE 00002185 "will be used."
NSQ_SOURCE_LINE 00002186 ""
NSQ_SOURCE_LINE 00002187 "Example:"
NSQ_SOURCE_LINE 00002188 ""
NSQ_SOURCE_LINE 00002189 " my $content = $conf_obj->save_string(\\%config);"
NSQ_SOURCE_LINE 00002190 ""
NSQ_SOURCE_LINE 00002191 "or:"
NSQ_SOURCE_LINE 00002192 ""
NSQ_SOURCE_LINE 00002193 " my $content = $conf_obj->save_string();"
NSQ_SOURCE_LINE 00002194 ""
NSQ_SOURCE_LINE 00002195 ""
NSQ_SOURCE_LINE 00002196 "=back"
NSQ_SOURCE_LINE 00002197 ""
NSQ_SOURCE_LINE 00002198 ""
NSQ_SOURCE_LINE 00002199 "=head1 CONFIG FILE FORMAT"
NSQ_SOURCE_LINE 00002200 ""
NSQ_SOURCE_LINE 00002201 "Lines beginning with B<#> and empty lines will be ignored. (see section COMMENTS!)"
NSQ_SOURCE_LINE 00002202 "Spaces at the beginning and the end of a line will also be ignored as well as tabulators."
NSQ_SOURCE_LINE 00002203 "If you need spaces at the end or the beginning of a value you can surround it with"
NSQ_SOURCE_LINE 00002204 "double quotes."
NSQ_SOURCE_LINE 00002205 "An option line starts with its name followed by a value. An equal sign is optional."
NSQ_SOURCE_LINE 00002206 "Some possible examples:"
NSQ_SOURCE_LINE 00002207 ""
NSQ_SOURCE_LINE 00002208 " user    max"
NSQ_SOURCE_LINE 00002209 " user  = max"
NSQ_SOURCE_LINE 00002210 " user            max"
NSQ_SOURCE_LINE 00002211 ""
NSQ_SOURCE_LINE 00002212 "If there are more than one statements with the same name, it will create an array"
NSQ_SOURCE_LINE 00002213 "instead of a scalar. See the example below."
NSQ_SOURCE_LINE 00002214 ""
NSQ_SOURCE_LINE 00002215 "The method B<getall> returns a hash of all values."
NSQ_SOURCE_LINE 00002216 ""
NSQ_SOURCE_LINE 00002217 ""
NSQ_SOURCE_LINE 00002218 "=head1 BLOCKS"
NSQ_SOURCE_LINE 00002219 ""
NSQ_SOURCE_LINE 00002220 "You can define a B<block> of options. A B<block> looks much like a block"
NSQ_SOURCE_LINE 00002221 "in the wellknown Apache config format. It starts with E<lt>B<blockname>E<gt> and ends"
NSQ_SOURCE_LINE 00002222 "with E<lt>/B<blockname>E<gt>."
NSQ_SOURCE_LINE 00002223 ""
NSQ_SOURCE_LINE 00002224 "A block start and end cannot be on the same line."
NSQ_SOURCE_LINE 00002225 ""
NSQ_SOURCE_LINE 00002226 "An example:"
NSQ_SOURCE_LINE 00002227 ""
NSQ_SOURCE_LINE 00002228 " <database>"
NSQ_SOURCE_LINE 00002229 "  host   = muli"
NSQ_SOURCE_LINE 00002230 "  user   = moare"
NSQ_SOURCE_LINE 00002231 "  dbname = modb"
NSQ_SOURCE_LINE 00002232 "  dbpass = D4r_9Iu"
NSQ_SOURCE_LINE 00002233 " </database>"
NSQ_SOURCE_LINE 00002234 ""
NSQ_SOURCE_LINE 00002235 "Blocks can also be nested. Here is a more complicated example:"
NSQ_SOURCE_LINE 00002236 ""
NSQ_SOURCE_LINE 00002237 " user   = hans"
NSQ_SOURCE_LINE 00002238 " server = mc200"
NSQ_SOURCE_LINE 00002239 " db     = maxis"
NSQ_SOURCE_LINE 00002240 " passwd = D3rf$"
NSQ_SOURCE_LINE 00002241 " <jonas>"
NSQ_SOURCE_LINE 00002242 "  user    = tom"
NSQ_SOURCE_LINE 00002243 "  db      = unknown"
NSQ_SOURCE_LINE 00002244 "  host    = mila"
NSQ_SOURCE_LINE 00002245 "  <tablestructure>"
NSQ_SOURCE_LINE 00002246 "   index   int(100000)"
NSQ_SOURCE_LINE 00002247 "   name    char(100)"
NSQ_SOURCE_LINE 00002248 "   prename char(100)"
NSQ_SOURCE_LINE 00002249 "   city    char(100)"
NSQ_SOURCE_LINE 00002250 "   status  int(10)"
NSQ_SOURCE_LINE 00002251 "   allowed moses"
NSQ_SOURCE_LINE 00002252 "   allowed ingram"
NSQ_SOURCE_LINE 00002253 "   allowed joice"
NSQ_SOURCE_LINE 00002254 "  </tablestructure>"
NSQ_SOURCE_LINE 00002255 " </jonas>"
NSQ_SOURCE_LINE 00002256 ""
NSQ_SOURCE_LINE 00002257 "The hash which the method B<getall> returns look like that:"
NSQ_SOURCE_LINE 00002258 ""
NSQ_SOURCE_LINE 00002259 "  print Data::Dumper(\\%hash);"
NSQ_SOURCE_LINE 00002260 "  $VAR1 = {"
NSQ_SOURCE_LINE 00002261 "           'passwd' => 'D3rf$',"
NSQ_SOURCE_LINE 00002262 "           'jonas'  => {"
NSQ_SOURCE_LINE 00002263 "                        'tablestructure' => {"
NSQ_SOURCE_LINE 00002264 "                                             'prename' => 'char(100)',"
NSQ_SOURCE_LINE 00002265 "                                             'index'   => 'int(100000)',"
NSQ_SOURCE_LINE 00002266 "                                             'city'    => 'char(100)',"
NSQ_SOURCE_LINE 00002267 "                                             'name'    => 'char(100)',"
NSQ_SOURCE_LINE 00002268 "                                             'status'  => 'int(10)',"
NSQ_SOURCE_LINE 00002269 "                                             'allowed' => ["
NSQ_SOURCE_LINE 00002270 "                                                           'moses',"
NSQ_SOURCE_LINE 00002271 "                                                           'ingram',"
NSQ_SOURCE_LINE 00002272 "                                                           'joice',"
NSQ_SOURCE_LINE 00002273 "                                                          ]"
NSQ_SOURCE_LINE 00002274 "                                            },"
NSQ_SOURCE_LINE 00002275 "                        'host'           => 'mila',"
NSQ_SOURCE_LINE 00002276 "                        'db'             => 'unknown',"
NSQ_SOURCE_LINE 00002277 "                        'user'           => 'tom'"
NSQ_SOURCE_LINE 00002278 "                       },"
NSQ_SOURCE_LINE 00002279 "           'db'     => 'maxis',"
NSQ_SOURCE_LINE 00002280 "           'server' => 'mc200',"
NSQ_SOURCE_LINE 00002281 "           'user'   => 'hans'"
NSQ_SOURCE_LINE 00002282 "          };"
NSQ_SOURCE_LINE 00002283 ""
NSQ_SOURCE_LINE 00002284 "If you have turned on B<-LowerCaseNames> (see new()) then blocks as in the"
NSQ_SOURCE_LINE 00002285 "following example:"
NSQ_SOURCE_LINE 00002286 ""
NSQ_SOURCE_LINE 00002287 " <Dir>"
NSQ_SOURCE_LINE 00002288 "  <AttriBUTES>"
NSQ_SOURCE_LINE 00002289 "   Owner  root"
NSQ_SOURCE_LINE 00002290 "  </attributes>"
NSQ_SOURCE_LINE 00002291 " </dir>"
NSQ_SOURCE_LINE 00002292 ""
NSQ_SOURCE_LINE 00002293 "would produce the following hash structure:"
NSQ_SOURCE_LINE 00002294 ""
NSQ_SOURCE_LINE 00002295 "  $VAR1 = {"
NSQ_SOURCE_LINE 00002296 "           'dir' => {"
NSQ_SOURCE_LINE 00002297 "                     'attributes' => {"
NSQ_SOURCE_LINE 00002298 "                                      'owner'  => \"root\","
NSQ_SOURCE_LINE 00002299 "                                     }"
NSQ_SOURCE_LINE 00002300 "                    }"
NSQ_SOURCE_LINE 00002301 "          };"
NSQ_SOURCE_LINE 00002302 ""
NSQ_SOURCE_LINE 00002303 "As you can see, the keys inside the config hash are normalized."
NSQ_SOURCE_LINE 00002304 ""
NSQ_SOURCE_LINE 00002305 "Please note, that the above config block would result in a"
NSQ_SOURCE_LINE 00002306 "valid hash structure, even if B<-LowerCaseNames> is not set!"
NSQ_SOURCE_LINE 00002307 "This is because I<Config::General> does not"
NSQ_SOURCE_LINE 00002308 "use the block names to check if a block ends, instead it uses an internal"
NSQ_SOURCE_LINE 00002309 "state counter, which indicates a block end."
NSQ_SOURCE_LINE 00002310 ""
NSQ_SOURCE_LINE 00002311 "If the module cannot find an end-block statement, then this block will be ignored."
NSQ_SOURCE_LINE 00002312 ""
NSQ_SOURCE_LINE 00002313 ""
NSQ_SOURCE_LINE 00002314 ""
NSQ_SOURCE_LINE 00002315 "=head1 NAMED BLOCKS"
NSQ_SOURCE_LINE 00002316 ""
NSQ_SOURCE_LINE 00002317 "If you need multiple blocks of the same name, then you have to name every block."
NSQ_SOURCE_LINE 00002318 "This works much like Apache config. If the module finds a named block, it will"
NSQ_SOURCE_LINE 00002319 "create a hashref with the left part of the named block as the key containing"
NSQ_SOURCE_LINE 00002320 "one or more hashrefs with the right part of the block as key containing everything"
NSQ_SOURCE_LINE 00002321 "inside the block(which may again be nested!). As examples says more than words:"
NSQ_SOURCE_LINE 00002322 ""
NSQ_SOURCE_LINE 00002323 "# given the following sample"
NSQ_SOURCE_LINE 00002324 " <Directory /usr/frisco>"
NSQ_SOURCE_LINE 00002325 "  Limit Deny"
NSQ_SOURCE_LINE 00002326 "  Options ExecCgi Index"
NSQ_SOURCE_LINE 00002327 " </Directory>"
NSQ_SOURCE_LINE 00002328 " <Directory /usr/frik>"
NSQ_SOURCE_LINE 00002329 "  Limit DenyAll"
NSQ_SOURCE_LINE 00002330 "  Options None"
NSQ_SOURCE_LINE 00002331 " </Directory>"
NSQ_SOURCE_LINE 00002332 ""
NSQ_SOURCE_LINE 00002333 "# you will get:"
NSQ_SOURCE_LINE 00002334 ""
NSQ_SOURCE_LINE 00002335 "  $VAR1 = {"
NSQ_SOURCE_LINE 00002336 "           'Directory' => {"
NSQ_SOURCE_LINE 00002337 "                           '/usr/frik' => {"
NSQ_SOURCE_LINE 00002338 "                                           'Options' => 'None',"
NSQ_SOURCE_LINE 00002339 "                                           'Limit' => 'DenyAll'"
NSQ_SOURCE_LINE 00002340 "                                          },"
NSQ_SOURCE_LINE 00002341 "                           '/usr/frisco' => {"
NSQ_SOURCE_LINE 00002342 "                                             'Options' => 'ExecCgi Index',"
NSQ_SOURCE_LINE 00002343 "                                             'Limit' => 'Deny'"
NSQ_SOURCE_LINE 00002344 "                                            }"
NSQ_SOURCE_LINE 00002345 "                          }"
NSQ_SOURCE_LINE 00002346 "          };"
NSQ_SOURCE_LINE 00002347 ""
NSQ_SOURCE_LINE 00002348 "You cannot have more than one named block with the same name because it will"
NSQ_SOURCE_LINE 00002349 "be stored in a hashref and therefore be overwritten if a block occurs once more."
NSQ_SOURCE_LINE 00002350 ""
NSQ_SOURCE_LINE 00002351 ""
NSQ_SOURCE_LINE 00002352 "=head1 WHITESPACE IN BLOCKS"
NSQ_SOURCE_LINE 00002353 ""
NSQ_SOURCE_LINE 00002354 "The normal behavior of Config::General is to look for whitespace in"
NSQ_SOURCE_LINE 00002355 "block names to decide if it's a named block or just a simple block."
NSQ_SOURCE_LINE 00002356 ""
NSQ_SOURCE_LINE 00002357 "Sometimes you may need blocknames which have whitespace in their names."
NSQ_SOURCE_LINE 00002358 ""
NSQ_SOURCE_LINE 00002359 "With named blocks this is no problem, as the module only looks for the"
NSQ_SOURCE_LINE 00002360 "first whitespace:"
NSQ_SOURCE_LINE 00002361 ""
NSQ_SOURCE_LINE 00002362 " <person hugo gera>"
NSQ_SOURCE_LINE 00002363 " </person>"
NSQ_SOURCE_LINE 00002364 ""
NSQ_SOURCE_LINE 00002365 "would be parsed to:"
NSQ_SOURCE_LINE 00002366 ""
NSQ_SOURCE_LINE 00002367 "  $VAR1 = {"
NSQ_SOURCE_LINE 00002368 "           'person' => {"
NSQ_SOURCE_LINE 00002369 "                        'hugo gera' => {"
NSQ_SOURCE_LINE 00002370 "                                       },"
NSQ_SOURCE_LINE 00002371 "                       }"
NSQ_SOURCE_LINE 00002372 "          };"
NSQ_SOURCE_LINE 00002373 ""
NSQ_SOURCE_LINE 00002374 "The problem occurs, if you want to have a simple block containing whitespace:"
NSQ_SOURCE_LINE 00002375 ""
NSQ_SOURCE_LINE 00002376 " <hugo gera>"
NSQ_SOURCE_LINE 00002377 " </hugo gera>"
NSQ_SOURCE_LINE 00002378 ""
NSQ_SOURCE_LINE 00002379 "This would be parsed as a named block, which is not what you wanted. In this"
NSQ_SOURCE_LINE 00002380 "very case you may use quotation marks to indicate that it is not a named block:"
NSQ_SOURCE_LINE 00002381 ""
NSQ_SOURCE_LINE 00002382 " <\"hugo gera\">"
NSQ_SOURCE_LINE 00002383 " </\"hugo gera\">"
NSQ_SOURCE_LINE 00002384 ""
NSQ_SOURCE_LINE 00002385 "The save() method of the module inserts automatically quotation marks in such"
NSQ_SOURCE_LINE 00002386 "cases."
NSQ_SOURCE_LINE 00002387 ""
NSQ_SOURCE_LINE 00002388 ""
NSQ_SOURCE_LINE 00002389 "=head1 EXPLICIT EMPTY BLOCKS"
NSQ_SOURCE_LINE 00002390 ""
NSQ_SOURCE_LINE 00002391 "Beside the notation of blocks mentioned above it is possible to use"
NSQ_SOURCE_LINE 00002392 "explicit empty blocks."
NSQ_SOURCE_LINE 00002393 ""
NSQ_SOURCE_LINE 00002394 "Normally you would write this in your config to define an empty"
NSQ_SOURCE_LINE 00002395 "block:"
NSQ_SOURCE_LINE 00002396 ""
NSQ_SOURCE_LINE 00002397 " <driver Apache>"
NSQ_SOURCE_LINE 00002398 " </driver>"
NSQ_SOURCE_LINE 00002399 ""
NSQ_SOURCE_LINE 00002400 "To save writing you can also write:"
NSQ_SOURCE_LINE 00002401 ""
NSQ_SOURCE_LINE 00002402 " <driver Apache/>"
NSQ_SOURCE_LINE 00002403 ""
NSQ_SOURCE_LINE 00002404 "which is the very same as above. This works for normal blocks and"
NSQ_SOURCE_LINE 00002405 "for named blocks."
NSQ_SOURCE_LINE 00002406 ""
NSQ_SOURCE_LINE 00002407 ""
NSQ_SOURCE_LINE 00002408 ""
NSQ_SOURCE_LINE 00002409 "=head1 IDENTICAL OPTIONS (ARRAYS)"
NSQ_SOURCE_LINE 00002410 ""
NSQ_SOURCE_LINE 00002411 "You may have more than one line of the same option with different values."
NSQ_SOURCE_LINE 00002412 "Example:"
NSQ_SOURCE_LINE 00002413 ""
NSQ_SOURCE_LINE 00002414 " log  log1"
NSQ_SOURCE_LINE 00002415 " log  log2"
NSQ_SOURCE_LINE 00002416 " log  log2"
NSQ_SOURCE_LINE 00002417 ""
NSQ_SOURCE_LINE 00002418 "You will get a scalar if the option occurred only once or an array if it occurred"
NSQ_SOURCE_LINE 00002419 "more than once. If you expect multiple identical options, then you may need to"
NSQ_SOURCE_LINE 00002420 "check if an option occurred more than once:"
NSQ_SOURCE_LINE 00002421 ""
NSQ_SOURCE_LINE 00002422 "  $allowed = $hash{jonas}->{tablestructure}->{allowed};"
NSQ_SOURCE_LINE 00002423 "  if (ref($allowed) eq \"ARRAY\") {"
NSQ_SOURCE_LINE 00002424 "    @ALLOWED = @{$allowed};"
NSQ_SOURCE_LINE 00002425 "    else {"
NSQ_SOURCE_LINE 00002426 "      @ALLOWED = ($allowed);"
NSQ_SOURCE_LINE 00002427 "    }"
NSQ_SOURCE_LINE 00002428 "  }"
NSQ_SOURCE_LINE 00002429 ""
NSQ_SOURCE_LINE 00002430 "The same applies to blocks and named blocks too (they are described in more detail"
NSQ_SOURCE_LINE 00002431 "below). For example, if you have the following config:"
NSQ_SOURCE_LINE 00002432 ""
NSQ_SOURCE_LINE 00002433 " <dir blah>"
NSQ_SOURCE_LINE 00002434 "  user max"
NSQ_SOURCE_LINE 00002435 " </dir>"
NSQ_SOURCE_LINE 00002436 " <dir blah>"
NSQ_SOURCE_LINE 00002437 "  user hannes"
NSQ_SOURCE_LINE 00002438 " </dir>"
NSQ_SOURCE_LINE 00002439 ""
NSQ_SOURCE_LINE 00002440 "then you would end up with a data structure like this:"
NSQ_SOURCE_LINE 00002441 ""
NSQ_SOURCE_LINE 00002442 "  $VAR1 = {"
NSQ_SOURCE_LINE 00002443 "           'dir' => {"
NSQ_SOURCE_LINE 00002444 "                     'blah' => ["
NSQ_SOURCE_LINE 00002445 "                                {"
NSQ_SOURCE_LINE 00002446 "                                 'user' => 'max'"
NSQ_SOURCE_LINE 00002447 "                                },"
NSQ_SOURCE_LINE 00002448 "                                {"
NSQ_SOURCE_LINE 00002449 "                                 'user' => 'hannes'"
NSQ_SOURCE_LINE 00002450 "                                }"
NSQ_SOURCE_LINE 00002451 "                               ]"
NSQ_SOURCE_LINE 00002452 "                    }"
NSQ_SOURCE_LINE 00002453 "          };"
NSQ_SOURCE_LINE 00002454 ""
NSQ_SOURCE_LINE 00002455 "As you can see, the two identical blocks are stored in a hash which contains"
NSQ_SOURCE_LINE 00002456 "an array(-reference) of hashes."
NSQ_SOURCE_LINE 00002457 ""
NSQ_SOURCE_LINE 00002458 "Under some rare conditions you might not want this behavior with blocks (and"
NSQ_SOURCE_LINE 00002459 "named blocks too). If you want to get one single hash with the contents of"
NSQ_SOURCE_LINE 00002460 "both identical blocks, then you need to turn the B<new()> parameter B<-MergeDuplicateBlocks>"
NSQ_SOURCE_LINE 00002461 "on (see above). The parsed structure of the example above would then look like"
NSQ_SOURCE_LINE 00002462 "this:"
NSQ_SOURCE_LINE 00002463 ""
NSQ_SOURCE_LINE 00002464 ""
NSQ_SOURCE_LINE 00002465 "  $VAR1 = {"
NSQ_SOURCE_LINE 00002466 "           'dir' => {"
NSQ_SOURCE_LINE 00002467 "                     'blah' => {"
NSQ_SOURCE_LINE 00002468 "                                'user' => ["
NSQ_SOURCE_LINE 00002469 "                                           'max',"
NSQ_SOURCE_LINE 00002470 "                                           'hannes'"
NSQ_SOURCE_LINE 00002471 "                                          ]"
NSQ_SOURCE_LINE 00002472 "                               }"
NSQ_SOURCE_LINE 00002473 "                    }"
NSQ_SOURCE_LINE 00002474 "          };"
NSQ_SOURCE_LINE 00002475 ""
NSQ_SOURCE_LINE 00002476 "As you can see, there is only one hash \"dir->{blah}\" containing multiple"
NSQ_SOURCE_LINE 00002477 "\"user\" entries. As you can also see, turning on  B<-MergeDuplicateBlocks>"
NSQ_SOURCE_LINE 00002478 "does not affect scalar options (i.e. \"option = value\"). In fact you can"
NSQ_SOURCE_LINE 00002479 "tune merging of duplicate blocks and options independent from each other."
NSQ_SOURCE_LINE 00002480 ""
NSQ_SOURCE_LINE 00002481 "If you don't want to allow more than one identical options, you may turn it off"
NSQ_SOURCE_LINE 00002482 "by setting the flag I<AllowMultiOptions> in the B<new()> method to \"no\"."
NSQ_SOURCE_LINE 00002483 "If turned off, Config::General will complain about multiple occurring options"
NSQ_SOURCE_LINE 00002484 "with identical names!"
NSQ_SOURCE_LINE 00002485 ""
NSQ_SOURCE_LINE 00002486 "=head2 FORCE SINGLE VALUE ARRAYS"
NSQ_SOURCE_LINE 00002487 ""
NSQ_SOURCE_LINE 00002488 "You may also force a single config line to get parsed into an array by"
NSQ_SOURCE_LINE 00002489 "turning on the option B<-ForceArray> and by surrounding the value of the"
NSQ_SOURCE_LINE 00002490 "config entry by []. Example:"
NSQ_SOURCE_LINE 00002491 ""
NSQ_SOURCE_LINE 00002492 " hostlist = [ foo.bar ]"
NSQ_SOURCE_LINE 00002493 ""
NSQ_SOURCE_LINE 00002494 "Will be a singlevalue array entry if the option is turned on. If you want"
NSQ_SOURCE_LINE 00002495 "it to remain to be an array you have to turn on B<-ForceArray> during save too."
NSQ_SOURCE_LINE 00002496 ""
NSQ_SOURCE_LINE 00002497 "=head1 LONG LINES"
NSQ_SOURCE_LINE 00002498 ""
NSQ_SOURCE_LINE 00002499 "If you have a config value, which is too long and would take more than one line,"
NSQ_SOURCE_LINE 00002500 "you can break it into multiple lines by using the backslash character at the end"
NSQ_SOURCE_LINE 00002501 "of the line. The Config::General module will concatenate those lines to one single-value."
NSQ_SOURCE_LINE 00002502 ""
NSQ_SOURCE_LINE 00002503 "Example:"
NSQ_SOURCE_LINE 00002504 ""
NSQ_SOURCE_LINE 00002505 " command = cat /var/log/secure/tripwire | \\"
NSQ_SOURCE_LINE 00002506 " mail C<-s> \"report from tripwire\" \\"
NSQ_SOURCE_LINE 00002507 " honey@myotherhost.nl"
NSQ_SOURCE_LINE 00002508 ""
NSQ_SOURCE_LINE 00002509 "command will become:"
NSQ_SOURCE_LINE 00002510 "\"cat /var/log/secure/tripwire | mail C<-s> 'report from twire' honey@myotherhost.nl\""
NSQ_SOURCE_LINE 00002511 ""
NSQ_SOURCE_LINE 00002512 ""
NSQ_SOURCE_LINE 00002513 "=head1 HERE DOCUMENTS"
NSQ_SOURCE_LINE 00002514 ""
NSQ_SOURCE_LINE 00002515 "You can also define a config value as a so called \"here-document\". You must tell"
NSQ_SOURCE_LINE 00002516 "the module an identifier which indicates the end of a here document. An"
NSQ_SOURCE_LINE 00002517 "identifier must follow a \"<<\"."
NSQ_SOURCE_LINE 00002518 ""
NSQ_SOURCE_LINE 00002519 "Example:"
NSQ_SOURCE_LINE 00002520 ""
NSQ_SOURCE_LINE 00002521 " message <<EOF"
NSQ_SOURCE_LINE 00002522 "  we want to"
NSQ_SOURCE_LINE 00002523 "  remove the"
NSQ_SOURCE_LINE 00002524 "  homedir of"
NSQ_SOURCE_LINE 00002525 "  root."
NSQ_SOURCE_LINE 00002526 " EOF"
NSQ_SOURCE_LINE 00002527 ""
NSQ_SOURCE_LINE 00002528 "Everything between the two \"EOF\" strings will be in the option I<message>."
NSQ_SOURCE_LINE 00002529 ""
NSQ_SOURCE_LINE 00002530 "There is a special feature which allows you to use indentation with here documents."
NSQ_SOURCE_LINE 00002531 "You can have any amount of whitespace or tabulators in front of the end"
NSQ_SOURCE_LINE 00002532 "identifier. If the module finds spaces or tabs then it will remove exactly those"
NSQ_SOURCE_LINE 00002533 "amount of spaces from every line inside the here-document."
NSQ_SOURCE_LINE 00002534 ""
NSQ_SOURCE_LINE 00002535 "Example:"
NSQ_SOURCE_LINE 00002536 ""
NSQ_SOURCE_LINE 00002537 " message <<EOF"
NSQ_SOURCE_LINE 00002538 "    we want to"
NSQ_SOURCE_LINE 00002539 "    remove the"
NSQ_SOURCE_LINE 00002540 "    homedir of"
NSQ_SOURCE_LINE 00002541 "    root."
NSQ_SOURCE_LINE 00002542 "    EOF"
NSQ_SOURCE_LINE 00002543 ""
NSQ_SOURCE_LINE 00002544 "After parsing, message will become:"
NSQ_SOURCE_LINE 00002545 ""
NSQ_SOURCE_LINE 00002546 " we want to"
NSQ_SOURCE_LINE 00002547 " remove the"
NSQ_SOURCE_LINE 00002548 " homedir of"
NSQ_SOURCE_LINE 00002549 " root."
NSQ_SOURCE_LINE 00002550 ""
NSQ_SOURCE_LINE 00002551 "because there were the string \"     \" in front of EOF, which were cut from every"
NSQ_SOURCE_LINE 00002552 "line inside the here-document."
NSQ_SOURCE_LINE 00002553 ""
NSQ_SOURCE_LINE 00002554 ""
NSQ_SOURCE_LINE 00002555 ""
NSQ_SOURCE_LINE 00002556 "=head1 INCLUDES"
NSQ_SOURCE_LINE 00002557 ""
NSQ_SOURCE_LINE 00002558 "You can include an external file at any position in your config file using the following statement"
NSQ_SOURCE_LINE 00002559 "in your config file:"
NSQ_SOURCE_LINE 00002560 ""
NSQ_SOURCE_LINE 00002561 " <<include externalconfig.rc>>"
NSQ_SOURCE_LINE 00002562 ""
NSQ_SOURCE_LINE 00002563 "If you turned on B<-UseApacheInclude> (see B<new()>), then you can also use the following"
NSQ_SOURCE_LINE 00002564 "statement to include an external file:"
NSQ_SOURCE_LINE 00002565 ""
NSQ_SOURCE_LINE 00002566 " include externalconfig.rc"
NSQ_SOURCE_LINE 00002567 ""
NSQ_SOURCE_LINE 00002568 "This file will be inserted at the position where it was found as if the contents of this file"
NSQ_SOURCE_LINE 00002569 "were directly at this position."
NSQ_SOURCE_LINE 00002570 ""
NSQ_SOURCE_LINE 00002571 "You can also recursively include files, so an included file may include another one and so on."
NSQ_SOURCE_LINE 00002572 "Beware that you do not recursively load the same file, you will end with an error message like"
NSQ_SOURCE_LINE 00002573 "\"too many open files in system!\"."
NSQ_SOURCE_LINE 00002574 ""
NSQ_SOURCE_LINE 00002575 "By default included files with a relative pathname will be opened from within the current"
NSQ_SOURCE_LINE 00002576 "working directory. Under some circumstances it maybe possible to"
NSQ_SOURCE_LINE 00002577 "open included files from the directory, where the configfile resides. You need to turn on"
NSQ_SOURCE_LINE 00002578 "the option B<-IncludeRelative> (see B<new()>) if you want that. An example:"
NSQ_SOURCE_LINE 00002579 ""
NSQ_SOURCE_LINE 00002580 " my $conf = Config::General("
NSQ_SOURCE_LINE 00002581 "  -ConfigFile => \"/etc/crypt.d/server.cfg\""
NSQ_SOURCE_LINE 00002582 "  -IncludeRelative => 1"
NSQ_SOURCE_LINE 00002583 " );"
NSQ_SOURCE_LINE 00002584 ""
NSQ_SOURCE_LINE 00002585 "/etc/crypt.d/server.cfg:"
NSQ_SOURCE_LINE 00002586 ""
NSQ_SOURCE_LINE 00002587 " <<include acl.cfg>>"
NSQ_SOURCE_LINE 00002588 ""
NSQ_SOURCE_LINE 00002589 "In this example Config::General will try to include I<acl.cfg> from I</etc/crypt.d>:"
NSQ_SOURCE_LINE 00002590 ""
NSQ_SOURCE_LINE 00002591 " /etc/crypt.d/acl.cfg"
NSQ_SOURCE_LINE 00002592 ""
NSQ_SOURCE_LINE 00002593 "The default behavior (if B<-IncludeRelative> is B<not> set!) will be to open just I<acl.cfg>,"
NSQ_SOURCE_LINE 00002594 "wherever it is, i.e. if you did a chdir(\"/usr/local/etc\"), then Config::General will include:"
NSQ_SOURCE_LINE 00002595 ""
NSQ_SOURCE_LINE 00002596 " /usr/local/etc/acl.cfg"
NSQ_SOURCE_LINE 00002597 ""
NSQ_SOURCE_LINE 00002598 "Include statements can be case insensitive (added in version 1.25)."
NSQ_SOURCE_LINE 00002599 ""
NSQ_SOURCE_LINE 00002600 "Include statements will be ignored within C-Comments and here-documents."
NSQ_SOURCE_LINE 00002601 ""
NSQ_SOURCE_LINE 00002602 "By default, a config file will only be included the first time it is"
NSQ_SOURCE_LINE 00002603 "referenced.  If you wish to include a file in multiple places, set"
NSQ_SOURCE_LINE 00002604 "B</-IncludeAgain> to true. But be warned: this may lead to infinite loops,"
NSQ_SOURCE_LINE 00002605 "so make sure, you're not including the same file from within itself!"
NSQ_SOURCE_LINE 00002606 ""
NSQ_SOURCE_LINE 00002607 "Example:"
NSQ_SOURCE_LINE 00002608 ""
NSQ_SOURCE_LINE 00002609 " # main.cfg"
NSQ_SOURCE_LINE 00002610 " <object billy>"
NSQ_SOURCE_LINE 00002611 "  class=Some::Class"
NSQ_SOURCE_LINE 00002612 " <printers>"
NSQ_SOURCE_LINE 00002613 "  include printers.cfg"
NSQ_SOURCE_LINE 00002614 " </printers>"
NSQ_SOURCE_LINE 00002615 " # ..."
NSQ_SOURCE_LINE 00002616 " </object>"
NSQ_SOURCE_LINE 00002617 "  <object bob>"
NSQ_SOURCE_LINE 00002618 "   class=Another::Class"
NSQ_SOURCE_LINE 00002619 "  <printers>"
NSQ_SOURCE_LINE 00002620 "  include printers.cfg"
NSQ_SOURCE_LINE 00002621 "  </printers>"
NSQ_SOURCE_LINE 00002622 "  # ..."
NSQ_SOURCE_LINE 00002623 " </object>"
NSQ_SOURCE_LINE 00002624 ""
NSQ_SOURCE_LINE 00002625 "Now C<printers.cfg> will be include in both the C<billy> and C<bob> objects."
NSQ_SOURCE_LINE 00002626 ""
NSQ_SOURCE_LINE 00002627 "You will have to be careful to not recursively include a file.  Behaviour"
NSQ_SOURCE_LINE 00002628 "in this case is undefined."
NSQ_SOURCE_LINE 00002629 ""
NSQ_SOURCE_LINE 00002630 ""
NSQ_SOURCE_LINE 00002631 ""
NSQ_SOURCE_LINE 00002632 "=head1 COMMENTS"
NSQ_SOURCE_LINE 00002633 ""
NSQ_SOURCE_LINE 00002634 "A comment starts with the number sign B<#>, there can be any number of spaces and/or"
NSQ_SOURCE_LINE 00002635 "tab stops in front of the #."
NSQ_SOURCE_LINE 00002636 ""
NSQ_SOURCE_LINE 00002637 "A comment can also occur after a config statement. Example:"
NSQ_SOURCE_LINE 00002638 ""
NSQ_SOURCE_LINE 00002639 " username = max  # this is the comment"
NSQ_SOURCE_LINE 00002640 ""
NSQ_SOURCE_LINE 00002641 "If you want to comment out a large block you can use C-style comments. A B</*> signals"
NSQ_SOURCE_LINE 00002642 "the begin of a comment block and the B<*/> signals the end of the comment block."
NSQ_SOURCE_LINE 00002643 "Example:"
NSQ_SOURCE_LINE 00002644 ""
NSQ_SOURCE_LINE 00002645 " user  = max # valid option"
NSQ_SOURCE_LINE 00002646 " db    = tothemax"
NSQ_SOURCE_LINE 00002647 " /*"
NSQ_SOURCE_LINE 00002648 " user  = andors"
NSQ_SOURCE_LINE 00002649 " db    = toand"
NSQ_SOURCE_LINE 00002650 " */"
NSQ_SOURCE_LINE 00002651 ""
NSQ_SOURCE_LINE 00002652 "In this example the second options of user and db will be ignored. Please beware of the fact,"
NSQ_SOURCE_LINE 00002653 "if the Module finds a B</*> string which is the start of a comment block, but no matching"
NSQ_SOURCE_LINE 00002654 "end block, it will ignore the whole rest of the config file!"
NSQ_SOURCE_LINE 00002655 ""
NSQ_SOURCE_LINE 00002656 "B<NOTE:> If you require the B<#> character (number sign) to remain in the option value, then"
NSQ_SOURCE_LINE 00002657 "you can use a backslash in front of it, to escape it. Example:"
NSQ_SOURCE_LINE 00002658 ""
NSQ_SOURCE_LINE 00002659 " bgcolor = \\#ffffcc"
NSQ_SOURCE_LINE 00002660 ""
NSQ_SOURCE_LINE 00002661 "In this example the value of $config{bgcolor} will be \"#ffffcc\", Config::General will not treat"
NSQ_SOURCE_LINE 00002662 "the number sign as the begin of a comment because of the leading backslash."
NSQ_SOURCE_LINE 00002663 ""
NSQ_SOURCE_LINE 00002664 "Inside here-documents escaping of number signs is NOT required!"
NSQ_SOURCE_LINE 00002665 ""
NSQ_SOURCE_LINE 00002666 ""
NSQ_SOURCE_LINE 00002667 "=head1 PARSER PLUGINS"
NSQ_SOURCE_LINE 00002668 ""
NSQ_SOURCE_LINE 00002669 "You can alter the behavior of the parser by supplying closures"
NSQ_SOURCE_LINE 00002670 "which will be called on certain hooks during config file processing"
NSQ_SOURCE_LINE 00002671 "and parsing."
NSQ_SOURCE_LINE 00002672 ""
NSQ_SOURCE_LINE 00002673 "The general aproach works like this:"
NSQ_SOURCE_LINE 00002674 ""
NSQ_SOURCE_LINE 00002675 "  sub ck {"
NSQ_SOURCE_LINE 00002676 "    my($file, $base) = @_;"
NSQ_SOURCE_LINE 00002677 "    print \"_open() tries $file ... \";"
NSQ_SOURCE_LINE 00002678 "    if ($file =~ /blah/) {"
NSQ_SOURCE_LINE 00002679 "      print \"ignored\\n\";"
NSQ_SOURCE_LINE 00002680 "      return (0);"
NSQ_SOURCE_LINE 00002681 "    } else {"
NSQ_SOURCE_LINE 00002682 "      print \"allowed\\n\";"
NSQ_SOURCE_LINE 00002683 "      return (1, @_);"
NSQ_SOURCE_LINE 00002684 "    }"
NSQ_SOURCE_LINE 00002685 "  }"
NSQ_SOURCE_LINE 00002686 " "
NSQ_SOURCE_LINE 00002687 "  my %c = ParseConfig("
NSQ_SOURCE_LINE 00002688 "                      -IncludeGlob      => 1,"
NSQ_SOURCE_LINE 00002689 "                      -UseApacheInclude => 1,"
NSQ_SOURCE_LINE 00002690 "                      -ConfigFile       => shift,"
NSQ_SOURCE_LINE 00002691 "                      -Plug             => { pre_open => *ck }"
NSQ_SOURCE_LINE 00002692 "                     );"
NSQ_SOURCE_LINE 00002693 ""
NSQ_SOURCE_LINE 00002694 "Output:"
NSQ_SOURCE_LINE 00002695 ""
NSQ_SOURCE_LINE 00002696 " _open() tries cfg ... allowed"
NSQ_SOURCE_LINE 00002697 " _open() tries x/*.conf ... allowed"
NSQ_SOURCE_LINE 00002698 " _open() tries x/1.conf ... allowed"
NSQ_SOURCE_LINE 00002699 " _open() tries x/2.conf ... allowed"
NSQ_SOURCE_LINE 00002700 " _open() tries x/blah.conf ... ignored"
NSQ_SOURCE_LINE 00002701 ""
NSQ_SOURCE_LINE 00002702 "As you can see, we wrote a little sub which takes a filename"
NSQ_SOURCE_LINE 00002703 "and a base directory as parameters. We tell Config::General via"
NSQ_SOURCE_LINE 00002704 "the B<Plug> parameter of B<new()> to call this sub everytime"
NSQ_SOURCE_LINE 00002705 "before it attempts to open a file."
NSQ_SOURCE_LINE 00002706 ""
NSQ_SOURCE_LINE 00002707 "General processing continues as usual if the first value of"
NSQ_SOURCE_LINE 00002708 "the returned array is true. The second value of that array"
NSQ_SOURCE_LINE 00002709 "depends on the kind of hook being called."
NSQ_SOURCE_LINE 00002710 ""
NSQ_SOURCE_LINE 00002711 "The following hooks are available so far:"
NSQ_SOURCE_LINE 00002712 ""
NSQ_SOURCE_LINE 00002713 "=over"
NSQ_SOURCE_LINE 00002714 ""
NSQ_SOURCE_LINE 00002715 "=item B<pre_open>"
NSQ_SOURCE_LINE 00002716 ""
NSQ_SOURCE_LINE 00002717 "Takes two parameters: filename and basedirectory."
NSQ_SOURCE_LINE 00002718 ""
NSQ_SOURCE_LINE 00002719 "Has to return an array consisting of 3 values:"
NSQ_SOURCE_LINE 00002720 ""
NSQ_SOURCE_LINE 00002721 " - 1 or 0 (continue processing or not)"
NSQ_SOURCE_LINE 00002722 " - filename"
NSQ_SOURCE_LINE 00002723 " - base directory"
NSQ_SOURCE_LINE 00002724 ""
NSQ_SOURCE_LINE 00002725 "=item B<pre_read>"
NSQ_SOURCE_LINE 00002726 ""
NSQ_SOURCE_LINE 00002727 "Takes two parameters: the filehandle of the file to be read"
NSQ_SOURCE_LINE 00002728 "and an array containing the raw contents of said file."
NSQ_SOURCE_LINE 00002729 ""
NSQ_SOURCE_LINE 00002730 "This hook will be applied in _read(). File contents are already"
NSQ_SOURCE_LINE 00002731 "available at this stage, comments will be removed, here-docs normalized"
NSQ_SOURCE_LINE 00002732 "and the like. This hook gets the unaltered, original contents."
NSQ_SOURCE_LINE 00002733 ""
NSQ_SOURCE_LINE 00002734 "Has to return an array of 3 values:"
NSQ_SOURCE_LINE 00002735 ""
NSQ_SOURCE_LINE 00002736 " - 1 or 0 (continue processing or not)"
NSQ_SOURCE_LINE 00002737 " - the filehandle"
NSQ_SOURCE_LINE 00002738 " - an array of strings"
NSQ_SOURCE_LINE 00002739 ""
NSQ_SOURCE_LINE 00002740 "You can use this hook to apply your own normalizations or whatever."
NSQ_SOURCE_LINE 00002741 ""
NSQ_SOURCE_LINE 00002742 "Be careful when returning the abort value (1st value of returned array 0),"
NSQ_SOURCE_LINE 00002743 "since in this case nothing else would be done on the contents. If it still"
NSQ_SOURCE_LINE 00002744 "contains comments or something, they will be parsed as legal config options."
NSQ_SOURCE_LINE 00002745 ""
NSQ_SOURCE_LINE 00002746 "=item B<post_read>"
NSQ_SOURCE_LINE 00002747 ""
NSQ_SOURCE_LINE 00002748 "Takes one parameter: a reference to an array containing the prepared"
NSQ_SOURCE_LINE 00002749 "config lines (after being processed by _read())."
NSQ_SOURCE_LINE 00002750 ""
NSQ_SOURCE_LINE 00002751 "This hook will be applied in _read() when everything else has been done."
NSQ_SOURCE_LINE 00002752 ""
NSQ_SOURCE_LINE 00002753 "Has to return an array of 2 values:"
NSQ_SOURCE_LINE 00002754 ""
NSQ_SOURCE_LINE 00002755 " - 1 or 0 (continue processing or not) [Ignored for post hooks]"
NSQ_SOURCE_LINE 00002756 " - a reference to an array containing the config lines"
NSQ_SOURCE_LINE 00002757 ""
NSQ_SOURCE_LINE 00002758 "=item B<pre_parse_value>"
NSQ_SOURCE_LINE 00002759 ""
NSQ_SOURCE_LINE 00002760 "Takes 2 parameters: an option name and its value."
NSQ_SOURCE_LINE 00002761 ""
NSQ_SOURCE_LINE 00002762 "This hook will be applied in _parse_value() before any processing."
NSQ_SOURCE_LINE 00002763 ""
NSQ_SOURCE_LINE 00002764 "Has to return an array of 3 values:"
NSQ_SOURCE_LINE 00002765 ""
NSQ_SOURCE_LINE 00002766 " - 1 or 0 (continue processing or not)"
NSQ_SOURCE_LINE 00002767 " - option name"
NSQ_SOURCE_LINE 00002768 " - value of the option"
NSQ_SOURCE_LINE 00002769 ""
NSQ_SOURCE_LINE 00002770 "=item B<post_parse_value>"
NSQ_SOURCE_LINE 00002771 ""
NSQ_SOURCE_LINE 00002772 "Almost identical to pre_parse_value, but will be applied after _parse_value()"
NSQ_SOURCE_LINE 00002773 "is finished and all usual processing and normalization is done."
NSQ_SOURCE_LINE 00002774 ""
NSQ_SOURCE_LINE 00002775 "=back"
NSQ_SOURCE_LINE 00002776 ""
NSQ_SOURCE_LINE 00002777 "Not implemented yet: hooks for variable interpolation and block"
NSQ_SOURCE_LINE 00002778 "parsing."
NSQ_SOURCE_LINE 00002779 ""
NSQ_SOURCE_LINE 00002780 ""
NSQ_SOURCE_LINE 00002781 "=head1 OBJECT ORIENTED INTERFACE"
NSQ_SOURCE_LINE 00002782 ""
NSQ_SOURCE_LINE 00002783 "There is a way to access a parsed config the OO-way."
NSQ_SOURCE_LINE 00002784 "Use the module B<Config::General::Extended>, which is"
NSQ_SOURCE_LINE 00002785 "supplied with the Config::General distribution."
NSQ_SOURCE_LINE 00002786 ""
NSQ_SOURCE_LINE 00002787 "=head1 VARIABLE INTERPOLATION"
NSQ_SOURCE_LINE 00002788 ""
NSQ_SOURCE_LINE 00002789 "You can use variables inside your config files if you like. To do"
NSQ_SOURCE_LINE 00002790 "that you have to use the module B<Config::General::Interpolated>,"
NSQ_SOURCE_LINE 00002791 "which is supplied with the Config::General distribution."
NSQ_SOURCE_LINE 00002792 ""
NSQ_SOURCE_LINE 00002793 ""
NSQ_SOURCE_LINE 00002794 "=head1 EXPORTED FUNCTIONS"
NSQ_SOURCE_LINE 00002795 ""
NSQ_SOURCE_LINE 00002796 "Config::General exports some functions too, which makes it somewhat"
NSQ_SOURCE_LINE 00002797 "easier to use it, if you like this."
NSQ_SOURCE_LINE 00002798 ""
NSQ_SOURCE_LINE 00002799 "How to import the functions:"
NSQ_SOURCE_LINE 00002800 ""
NSQ_SOURCE_LINE 00002801 " use Config::General qw(ParseConfig SaveConfig SaveConfigString);"
NSQ_SOURCE_LINE 00002802 ""
NSQ_SOURCE_LINE 00002803 "=over"
NSQ_SOURCE_LINE 00002804 ""
NSQ_SOURCE_LINE 00002805 "=item B<ParseConfig()>"
NSQ_SOURCE_LINE 00002806 ""
NSQ_SOURCE_LINE 00002807 "This function takes exactly all those parameters, which are"
NSQ_SOURCE_LINE 00002808 "allowed to the B<new()> method of the standard interface."
NSQ_SOURCE_LINE 00002809 ""
NSQ_SOURCE_LINE 00002810 "Example:"
NSQ_SOURCE_LINE 00002811 ""
NSQ_SOURCE_LINE 00002812 " use Config::General qw(ParseConfig);"
NSQ_SOURCE_LINE 00002813 " my %config = ParseConfig(-ConfigFile => \"rcfile\", -AutoTrue => 1);"
NSQ_SOURCE_LINE 00002814 ""
NSQ_SOURCE_LINE 00002815 ""
NSQ_SOURCE_LINE 00002816 "=item B<SaveConfig()>"
NSQ_SOURCE_LINE 00002817 ""
NSQ_SOURCE_LINE 00002818 "This function requires two arguments, a filename and a reference"
NSQ_SOURCE_LINE 00002819 "to a hash structure."
NSQ_SOURCE_LINE 00002820 ""
NSQ_SOURCE_LINE 00002821 "Example:"
NSQ_SOURCE_LINE 00002822 ""
NSQ_SOURCE_LINE 00002823 " use Config::General qw(SaveConfig);"
NSQ_SOURCE_LINE 00002824 " .."
NSQ_SOURCE_LINE 00002825 " SaveConfig(\"rcfile\", \\%some_hash);"
NSQ_SOURCE_LINE 00002826 ""
NSQ_SOURCE_LINE 00002827 ""
NSQ_SOURCE_LINE 00002828 "=item B<SaveConfigString()>"
NSQ_SOURCE_LINE 00002829 ""
NSQ_SOURCE_LINE 00002830 "This function requires a reference to a config hash as parameter."
NSQ_SOURCE_LINE 00002831 "It generates a configuration based on this hash as the object-interface"
NSQ_SOURCE_LINE 00002832 "method B<save_string()> does."
NSQ_SOURCE_LINE 00002833 ""
NSQ_SOURCE_LINE 00002834 "Example:"
NSQ_SOURCE_LINE 00002835 ""
NSQ_SOURCE_LINE 00002836 " use Config::General qw(ParseConfig SaveConfigString);"
NSQ_SOURCE_LINE 00002837 " my %config = ParseConfig(-ConfigFile => \"rcfile\");"
NSQ_SOURCE_LINE 00002838 " .. # change %config something"
NSQ_SOURCE_LINE 00002839 " my $content = SaveConfigString(\\%config);"
NSQ_SOURCE_LINE 00002840 ""
NSQ_SOURCE_LINE 00002841 ""
NSQ_SOURCE_LINE 00002842 "=back"
NSQ_SOURCE_LINE 00002843 ""
NSQ_SOURCE_LINE 00002844 "=head1 CONFIGURATION AND ENVIRONMENT"
NSQ_SOURCE_LINE 00002845 ""
NSQ_SOURCE_LINE 00002846 "No environment variables will be used."
NSQ_SOURCE_LINE 00002847 ""
NSQ_SOURCE_LINE 00002848 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00002849 ""
NSQ_SOURCE_LINE 00002850 "I recommend you to read the following documents, which are supplied with Perl:"
NSQ_SOURCE_LINE 00002851 ""
NSQ_SOURCE_LINE 00002852 " perlreftut                     Perl references short introduction"
NSQ_SOURCE_LINE 00002853 " perlref                        Perl references, the rest of the story"
NSQ_SOURCE_LINE 00002854 " perldsc                        Perl data structures intro"
NSQ_SOURCE_LINE 00002855 " perllol                        Perl data structures: arrays of arrays"
NSQ_SOURCE_LINE 00002856 ""
NSQ_SOURCE_LINE 00002857 " Config::General::Extended      Object oriented interface to parsed configs"
