NSQ_SOURCE_LINE 00000001 "#"
NSQ_SOURCE_LINE 00000002 "# Config::General.pm - Generic Config Module"
NSQ_SOURCE_LINE 00000003 "#"
NSQ_SOURCE_LINE 00000004 "# Purpose: Provide a convenient way for loading"
NSQ_SOURCE_LINE 00000005 "#          config values from a given file and"
NSQ_SOURCE_LINE 00000006 "#          return it as hash structure"
NSQ_SOURCE_LINE 00000007 "#"
NSQ_SOURCE_LINE 00000008 "# Copyright (c) 2000-2025 Thomas Linden <tlinden |AT| cpan.org>."
NSQ_SOURCE_LINE 00000009 "# All Rights Reserved. Std. disclaimer applies."
NSQ_SOURCE_LINE 00000010 "# Licensed under the Artistic License 2.0."
NSQ_SOURCE_LINE 00000011 "#"
NSQ_SOURCE_LINE 00000012 "# namespace"
NSQ_SOURCE_LINE 00000013 "package Config::General;"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "use strict;"
NSQ_SOURCE_LINE 00000016 "use warnings;"
NSQ_SOURCE_LINE 00000017 "use English '-no_match_vars';"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "use IO::File;"
NSQ_SOURCE_LINE 00000020 "use FileHandle;"
NSQ_SOURCE_LINE 00000021 "use File::Spec::Functions qw(splitpath file_name_is_absolute catfile catpath);"
NSQ_SOURCE_LINE 00000022 "use File::Glob qw/:glob/;"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "# on debian with perl > 5.8.4 croak() doesn't work anymore without this."
NSQ_SOURCE_LINE 00000026 "# There is some require statement which dies 'cause it can't find Carp::Heavy,"
NSQ_SOURCE_LINE 00000027 "# I really don't understand, what the hell they made, but the debian perl"
NSQ_SOURCE_LINE 00000028 "# installation is definitely bullshit, damn!"
NSQ_SOURCE_LINE 00000029 "use Carp::Heavy;"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "use Carp;"
NSQ_SOURCE_LINE 00000033 "use Exporter;"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "$Config::General::VERSION = \"2.67\";"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "use base qw(Exporter);"
NSQ_SOURCE_LINE 00000038 "our @EXPORT_OK = qw(ParseConfig SaveConfig SaveConfigString);"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "use constant _UTF8_BOM => \"\\x{ef}\\x{bb}\\x{bf}\";"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "sub new {"
NSQ_SOURCE_LINE 00000043 "  #"
NSQ_SOURCE_LINE 00000044 "  # create new Config::General object"
NSQ_SOURCE_LINE 00000045 "  #"
NSQ_SOURCE_LINE 00000046 "  my($this, @param ) = @_;"
NSQ_SOURCE_LINE 00000047 "  my $class = ref($this) || $this;"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "  # define default options"
NSQ_SOURCE_LINE 00000050 "  my $self = {"
NSQ_SOURCE_LINE 00000051 "              # sha256 of current date"
NSQ_SOURCE_LINE 00000052 "              # hopefully this lowers the probability that"
NSQ_SOURCE_LINE 00000053 "              # this matches any configuration key or value out there"
NSQ_SOURCE_LINE 00000054 "              # bugfix for rt.40925"
NSQ_SOURCE_LINE 00000055 "              EOFseparator          => 'ad7d7b87f5b81d2a0d5cb75294afeb91aa4801b1f8e8532dc1b633c0e1d47037',"
NSQ_SOURCE_LINE 00000056 "              SlashIsDirectory      => 0,"
NSQ_SOURCE_LINE 00000057 "              AllowMultiOptions     => 1,"
NSQ_SOURCE_LINE 00000058 "              MergeDuplicateOptions => 0,"
NSQ_SOURCE_LINE 00000059 "              MergeDuplicateBlocks  => 0,"
NSQ_SOURCE_LINE 00000060 "              LowerCaseNames        => 0,"
NSQ_SOURCE_LINE 00000061 "              ApacheCompatible      => 0,"
NSQ_SOURCE_LINE 00000062 "              UseApacheInclude      => 0,"
NSQ_SOURCE_LINE 00000063 "              IncludeRelative       => 0,"
NSQ_SOURCE_LINE 00000064 "              IncludeDirectories    => 0,"
NSQ_SOURCE_LINE 00000065 "              IncludeGlob           => 0,"
NSQ_SOURCE_LINE 00000066 "              IncludeAgain          => 0,"
NSQ_SOURCE_LINE 00000067 "              AutoLaunder           => 0,"
NSQ_SOURCE_LINE 00000068 "              AutoTrue              => 0,"
NSQ_SOURCE_LINE 00000069 "              AutoTrueFlags         => {"
NSQ_SOURCE_LINE 00000070 "                                        true  => '^(on|yes|true|1)$',"
NSQ_SOURCE_LINE 00000071 "                                        false => '^(off|no|false|0)$',"
NSQ_SOURCE_LINE 00000072 "                                       },"
NSQ_SOURCE_LINE 00000073 "              DefaultConfig         => {},"
NSQ_SOURCE_LINE 00000074 "              String                => '',"
NSQ_SOURCE_LINE 00000075 "              level                 => 1,"
NSQ_SOURCE_LINE 00000076 "              InterPolateVars       => 0,"
NSQ_SOURCE_LINE 00000077 "              InterPolateEnv        => 0,"
NSQ_SOURCE_LINE 00000078 "              ExtendedAccess        => 0,"
NSQ_SOURCE_LINE 00000079 "              SplitPolicy           => 'guess', # also possible: whitespace, equalsign and custom"
NSQ_SOURCE_LINE 00000080 "              SplitDelimiter        => 0,       # must be set by the user if SplitPolicy is 'custom'"
NSQ_SOURCE_LINE 00000081 "              StoreDelimiter        => 0,       # will be set by me unless user uses 'custom' policy"
NSQ_SOURCE_LINE 00000082 "              CComments             => 1,       # by default turned on"
NSQ_SOURCE_LINE 00000083 "              BackslashEscape       => 0,       # deprecated"
NSQ_SOURCE_LINE 00000084 "              StrictObjects         => 1,       # be strict on non-existent keys in OOP mode"
NSQ_SOURCE_LINE 00000085 "              StrictVars            => 1,       # be strict on undefined variables in Interpolate mode"
NSQ_SOURCE_LINE 00000086 "              Tie                   => q(),      # could be set to a perl module for tie'ing new hashes"
NSQ_SOURCE_LINE 00000087 "              parsed                => 0,       # internal state stuff for variable interpolation"
NSQ_SOURCE_LINE 00000088 "              files                 => {},      # which files we have read, if any"
NSQ_SOURCE_LINE 00000089 "              UTF8                  => 0,"
NSQ_SOURCE_LINE 00000090 "              SaveSorted            => 0,"
NSQ_SOURCE_LINE 00000091 "              ForceArray            => 0,       # force single value array if value enclosed in []"
NSQ_SOURCE_LINE 00000092 "              AllowSingleQuoteInterpolation => 0,"
NSQ_SOURCE_LINE 00000093 "              NoEscape              => 0,"
NSQ_SOURCE_LINE 00000094 "              NormalizeBlock        => 0,"
NSQ_SOURCE_LINE 00000095 "              NormalizeOption       => 0,"
NSQ_SOURCE_LINE 00000096 "              NormalizeValue        => 0,"
NSQ_SOURCE_LINE 00000097 "              Plug                  => {},"
NSQ_SOURCE_LINE 00000098 "              UseApacheIfDefine     => 0,"
NSQ_SOURCE_LINE 00000099 "              Define                => {},"
NSQ_SOURCE_LINE 00000100 "              AlwaysQuoteOutput     => 0"
NSQ_SOURCE_LINE 00000101 "             };"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "  # create the class instance"
NSQ_SOURCE_LINE 00000104 "  bless $self, $class;"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "  if ($#param >= 1) {"
NSQ_SOURCE_LINE 00000107 "    # use of the new hash interface!"
NSQ_SOURCE_LINE 00000108 "    $self->_prepare(@param);"
NSQ_SOURCE_LINE 00000109 "  }"
NSQ_SOURCE_LINE 00000110 "  elsif ($#param == 0) {"
NSQ_SOURCE_LINE 00000111 "    # use of the old style"
NSQ_SOURCE_LINE 00000112 "    $self->{ConfigFile} = $param[0];"
NSQ_SOURCE_LINE 00000113 "    if (ref($self->{ConfigFile}) eq 'HASH') {"
NSQ_SOURCE_LINE 00000114 "      $self->{ConfigHash} = delete $self->{ConfigFile};"
NSQ_SOURCE_LINE 00000115 "    }"
NSQ_SOURCE_LINE 00000116 "  }"
NSQ_SOURCE_LINE 00000117 "  else {"
NSQ_SOURCE_LINE 00000118 "    # this happens if $#param == -1,1 thus no param was given to new!"
NSQ_SOURCE_LINE 00000119 "    $self->{config} = $self->_hashref();"
NSQ_SOURCE_LINE 00000120 "    $self->{parsed} = 1;"
NSQ_SOURCE_LINE 00000121 "  }"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "  # find split policy to use for option/value separation"
NSQ_SOURCE_LINE 00000124 "  $self->_splitpolicy();"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "  # bless into variable interpolation module if necessary"
NSQ_SOURCE_LINE 00000127 "  $self->_blessvars();"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "  # process as usual"
NSQ_SOURCE_LINE 00000130 "  if (!$self->{parsed}) {"
NSQ_SOURCE_LINE 00000131 "    $self->_process();"
NSQ_SOURCE_LINE 00000132 "  }"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "  if ($self->{InterPolateVars}) {"
NSQ_SOURCE_LINE 00000135 "    $self->{config} = $self->_clean_stack($self->{config});"
NSQ_SOURCE_LINE 00000136 "  }"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "  # bless into OOP namespace if required"
NSQ_SOURCE_LINE 00000139 "  $self->_blessoop();"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "  return $self;"
NSQ_SOURCE_LINE 00000142 "}"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "sub _process {"
NSQ_SOURCE_LINE 00000147 "  #"
NSQ_SOURCE_LINE 00000148 "  # call _read() and _parse() on the given config"
NSQ_SOURCE_LINE 00000149 "  my($self) = @_;"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "  if ($self->{DefaultConfig} && $self->{InterPolateVars}) {"
NSQ_SOURCE_LINE 00000152 "    $self->{DefaultConfig} = $self->_interpolate_hash($self->{DefaultConfig}); # FIXME: _hashref() ?"
NSQ_SOURCE_LINE 00000153 "  }"
NSQ_SOURCE_LINE 00000154 "  if (exists $self->{StringContent}) {"
NSQ_SOURCE_LINE 00000155 "    # consider the supplied string as config file"
NSQ_SOURCE_LINE 00000156 "    $self->_read($self->{StringContent}, 'SCALAR');"
NSQ_SOURCE_LINE 00000157 "    $self->{config} = $self->_parse($self->{DefaultConfig}, $self->{content});"
NSQ_SOURCE_LINE 00000158 "  }"
NSQ_SOURCE_LINE 00000159 "  elsif (exists $self->{ConfigHash}) {"
NSQ_SOURCE_LINE 00000160 "    if (ref($self->{ConfigHash}) eq 'HASH') {"
NSQ_SOURCE_LINE 00000161 "      # initialize with given hash"
NSQ_SOURCE_LINE 00000162 "      $self->{config} = $self->{ConfigHash};"
NSQ_SOURCE_LINE 00000163 "      $self->{parsed} = 1;"
NSQ_SOURCE_LINE 00000164 "    }"
NSQ_SOURCE_LINE 00000165 "    else {"
NSQ_SOURCE_LINE 00000166 "      croak \"Config::General: Parameter -ConfigHash must be a hash reference!\\n\";"
NSQ_SOURCE_LINE 00000167 "    }"
NSQ_SOURCE_LINE 00000168 "  }"
NSQ_SOURCE_LINE 00000169 "  elsif (ref($self->{ConfigFile}) eq 'GLOB' || ref($self->{ConfigFile}) eq 'FileHandle') {"
NSQ_SOURCE_LINE 00000170 "    # use the file the glob points to"
NSQ_SOURCE_LINE 00000171 "    $self->_read($self->{ConfigFile});"
NSQ_SOURCE_LINE 00000172 "    $self->{config} = $self->_parse($self->{DefaultConfig}, $self->{content});"
NSQ_SOURCE_LINE 00000173 "  }"
NSQ_SOURCE_LINE 00000174 "  else {"
NSQ_SOURCE_LINE 00000175 "    if ($self->{ConfigFile}) {"
NSQ_SOURCE_LINE 00000176 "      # open the file and read the contents in"
NSQ_SOURCE_LINE 00000177 "      $self->{configfile} = $self->{ConfigFile};"
NSQ_SOURCE_LINE 00000178 "      if ( file_name_is_absolute($self->{ConfigFile}) ) {"
NSQ_SOURCE_LINE 00000179 "        # look if this is an absolute path and save the basename if it is absolute"
NSQ_SOURCE_LINE 00000180 "        my ($volume, $path, undef) = splitpath($self->{ConfigFile});"
NSQ_SOURCE_LINE 00000181 "        $path =~ s#/$##; # remove eventually existing trailing slash"
NSQ_SOURCE_LINE 00000182 "        if (! $self->{ConfigPath}) {"
NSQ_SOURCE_LINE 00000183 "          $self->{ConfigPath} = [];"
NSQ_SOURCE_LINE 00000184 "        }"
NSQ_SOURCE_LINE 00000185 "        unshift @{$self->{ConfigPath}}, catpath($volume, $path, q());"
NSQ_SOURCE_LINE 00000186 "      }"
NSQ_SOURCE_LINE 00000187 "      $self->_open($self->{configfile});"
NSQ_SOURCE_LINE 00000188 "      # now, we parse immediately, getall simply returns the whole hash"
NSQ_SOURCE_LINE 00000189 "      $self->{config} = $self->_hashref();"
NSQ_SOURCE_LINE 00000190 "      $self->{config} = $self->_parse($self->{DefaultConfig}, $self->{content});"
NSQ_SOURCE_LINE 00000191 "    }"
NSQ_SOURCE_LINE 00000192 "    else {"
NSQ_SOURCE_LINE 00000193 "      # hm, no valid config file given, so try it as an empty object"
NSQ_SOURCE_LINE 00000194 "      $self->{config} = $self->_hashref();"
NSQ_SOURCE_LINE 00000195 "      $self->{parsed} = 1;"
NSQ_SOURCE_LINE 00000196 "    }"
NSQ_SOURCE_LINE 00000197 "  }"
NSQ_SOURCE_LINE 00000198 "}"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "sub _blessoop {"
NSQ_SOURCE_LINE 00000202 "  #"
NSQ_SOURCE_LINE 00000203 "  # bless into ::Extended if necessary"
NSQ_SOURCE_LINE 00000204 "  my($self) = @_;"
NSQ_SOURCE_LINE 00000205 "  if ($self->{ExtendedAccess}) {"
NSQ_SOURCE_LINE 00000206 "    # we are blessing here again, to get into the ::Extended namespace"
NSQ_SOURCE_LINE 00000207 "    # for inheriting the methods available over there, which we doesn't have."
NSQ_SOURCE_LINE 00000208 "    bless $self, 'Config::General::Extended';"
NSQ_SOURCE_LINE 00000209 "    eval {"
NSQ_SOURCE_LINE 00000210 "      require Config::General::Extended;"
NSQ_SOURCE_LINE 00000211 "    };"
NSQ_SOURCE_LINE 00000212 "    if ($EVAL_ERROR) {"
NSQ_SOURCE_LINE 00000213 "      croak \"Config::General: \" . $EVAL_ERROR;"
NSQ_SOURCE_LINE 00000214 "    }"
NSQ_SOURCE_LINE 00000215 "  }"
NSQ_SOURCE_LINE 00000216 "#  return $self;"
NSQ_SOURCE_LINE 00000217 "}"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "sub _blessvars {"
NSQ_SOURCE_LINE 00000220 "  #"
NSQ_SOURCE_LINE 00000221 "  # bless into ::Interpolated if necessary"
NSQ_SOURCE_LINE 00000222 "  my($self) = @_;"
NSQ_SOURCE_LINE 00000223 "  if ($self->{InterPolateVars} || $self->{InterPolateEnv}) {"
NSQ_SOURCE_LINE 00000224 "    # InterPolateEnv implies InterPolateVars"
NSQ_SOURCE_LINE 00000225 "    $self->{InterPolateVars} = 1;"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "    # we are blessing here again, to get into the ::InterPolated namespace"
NSQ_SOURCE_LINE 00000228 "    # for inheriting the methods available overthere, which we doesn't have here."
NSQ_SOURCE_LINE 00000229 "    bless $self, 'Config::General::Interpolated';"
NSQ_SOURCE_LINE 00000230 "    eval {"
NSQ_SOURCE_LINE 00000231 "      require Config::General::Interpolated;"
NSQ_SOURCE_LINE 00000232 "    };"
NSQ_SOURCE_LINE 00000233 "    if ($EVAL_ERROR) {"
NSQ_SOURCE_LINE 00000234 "      croak \"Config::General: \" . $EVAL_ERROR;"
NSQ_SOURCE_LINE 00000235 "    }"
NSQ_SOURCE_LINE 00000236 "    # pre-compile the variable regexp"
NSQ_SOURCE_LINE 00000237 "    $self->{regex} = $self->_set_regex();"
NSQ_SOURCE_LINE 00000238 "  }"
NSQ_SOURCE_LINE 00000239 "}"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "sub _splitpolicy {"
NSQ_SOURCE_LINE 00000243 "  #"
NSQ_SOURCE_LINE 00000244 "  # find out what split policy to use"
NSQ_SOURCE_LINE 00000245 "  my($self) = @_;"
NSQ_SOURCE_LINE 00000246 "  if ($self->{SplitPolicy} ne 'guess') {"
NSQ_SOURCE_LINE 00000247 "    if ($self->{SplitPolicy} eq 'whitespace') {"
NSQ_SOURCE_LINE 00000248 "      $self->{SplitDelimiter} = '\\s+';"
NSQ_SOURCE_LINE 00000249 "      if (!$self->{StoreDelimiter}) {"
NSQ_SOURCE_LINE 00000250 "        $self->{StoreDelimiter} = q(   );"
NSQ_SOURCE_LINE 00000251 "      }"
NSQ_SOURCE_LINE 00000252 "    }"
NSQ_SOURCE_LINE 00000253 "    elsif ($self->{SplitPolicy} eq 'equalsign') {"
NSQ_SOURCE_LINE 00000254 "      $self->{SplitDelimiter} = '\\s*=\\s*';"
NSQ_SOURCE_LINE 00000255 "      if (!$self->{StoreDelimiter}) {"
NSQ_SOURCE_LINE 00000256 "        $self->{StoreDelimiter} = ' = ';"
NSQ_SOURCE_LINE 00000257 "      }"
NSQ_SOURCE_LINE 00000258 "    }"
NSQ_SOURCE_LINE 00000259 "    elsif ($self->{SplitPolicy} eq 'custom') {"
NSQ_SOURCE_LINE 00000260 "      if (! $self->{SplitDelimiter} ) {"
NSQ_SOURCE_LINE 00000261 "        croak \"Config::General: SplitPolicy set to 'custom' but no SplitDelimiter set.\\n\";"
NSQ_SOURCE_LINE 00000262 "      }"
NSQ_SOURCE_LINE 00000263 "    }"
NSQ_SOURCE_LINE 00000264 "    else {"
NSQ_SOURCE_LINE 00000265 "      croak \"Config::General: Unsupported SplitPolicy: $self->{SplitPolicy}.\\n\";"
NSQ_SOURCE_LINE 00000266 "    }"
NSQ_SOURCE_LINE 00000267 "  }"
NSQ_SOURCE_LINE 00000268 "  else {"
NSQ_SOURCE_LINE 00000269 "    if (!$self->{StoreDelimiter}) {"
NSQ_SOURCE_LINE 00000270 "      $self->{StoreDelimiter} = q(   );"
NSQ_SOURCE_LINE 00000271 "    }"
NSQ_SOURCE_LINE 00000272 "  }"
NSQ_SOURCE_LINE 00000273 "}"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "sub _prepare {"
NSQ_SOURCE_LINE 00000276 "  #"
NSQ_SOURCE_LINE 00000277 "  # prepare the class parameters, mangle them, if there"
NSQ_SOURCE_LINE 00000278 "  # are options to reset or to override, do it here."
NSQ_SOURCE_LINE 00000279 "  my ($self, %conf) = @_;"
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "  # save the parameter list for ::Extended's new() calls"
NSQ_SOURCE_LINE 00000282 "  $self->{Params} = \\%conf;"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "  # be backwards compatible"
NSQ_SOURCE_LINE 00000285 "  if (exists $conf{-file}) {"
NSQ_SOURCE_LINE 00000286 "    $self->{ConfigFile} = delete $conf{-file};"
NSQ_SOURCE_LINE 00000287 "  }"
NSQ_SOURCE_LINE 00000288 "  if (exists $conf{-hash}) {"
NSQ_SOURCE_LINE 00000289 "    $self->{ConfigHash} = delete $conf{-hash};"
NSQ_SOURCE_LINE 00000290 "  }"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "  # store input, file, handle, or array"
NSQ_SOURCE_LINE 00000293 "  if (exists $conf{-ConfigFile}) {"
NSQ_SOURCE_LINE 00000294 "    $self->{ConfigFile} = delete $conf{-ConfigFile};"
NSQ_SOURCE_LINE 00000295 "  }"
NSQ_SOURCE_LINE 00000296 "  if (exists $conf{-ConfigHash}) {"
NSQ_SOURCE_LINE 00000297 "    $self->{ConfigHash} = delete $conf{-ConfigHash};"
NSQ_SOURCE_LINE 00000298 "  }"
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "  # store search path for relative configs, if any"
NSQ_SOURCE_LINE 00000301 "  if (exists $conf{-ConfigPath}) {"
NSQ_SOURCE_LINE 00000302 "    my $configpath = delete $conf{-ConfigPath};"
NSQ_SOURCE_LINE 00000303 "    $self->{ConfigPath} = ref $configpath eq 'ARRAY' ? $configpath : [$configpath];"
NSQ_SOURCE_LINE 00000304 "  }"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "  # handle options which contains values we need (strings, hashrefs or the like)"
NSQ_SOURCE_LINE 00000307 "  if (exists $conf{-String} ) {"
NSQ_SOURCE_LINE 00000308 "    if (not ref $conf{-String}) {"
NSQ_SOURCE_LINE 00000309 "      if ( $conf{-String}) {"
NSQ_SOURCE_LINE 00000310 "        $self->{StringContent} = $conf{-String};"
NSQ_SOURCE_LINE 00000311 "      }"
NSQ_SOURCE_LINE 00000312 "      delete $conf{-String};"
NSQ_SOURCE_LINE 00000313 "    }"
NSQ_SOURCE_LINE 00000314 "    # re-implement arrayref support, removed after 2.22 as _read were"
NSQ_SOURCE_LINE 00000315 "    # re-organized"
NSQ_SOURCE_LINE 00000316 "    # fixed bug#33385"
NSQ_SOURCE_LINE 00000317 "    elsif(ref($conf{-String}) eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000318 "      $self->{StringContent} = join \"\\n\", @{$conf{-String}};"
NSQ_SOURCE_LINE 00000319 "    }"
NSQ_SOURCE_LINE 00000320 "    else {"
NSQ_SOURCE_LINE 00000321 "      croak \"Config::General: Parameter -String must be a SCALAR or ARRAYREF!\\n\";"
NSQ_SOURCE_LINE 00000322 "    }"
NSQ_SOURCE_LINE 00000323 "    delete $conf{-String};"
NSQ_SOURCE_LINE 00000324 "  }"
NSQ_SOURCE_LINE 00000325 "  if (exists $conf{-Tie}) {"
NSQ_SOURCE_LINE 00000326 "    if ($conf{-Tie}) {"
NSQ_SOURCE_LINE 00000327 "      $self->{Tie} = delete $conf{-Tie};"
NSQ_SOURCE_LINE 00000328 "      $self->{DefaultConfig} = $self->_hashref();"
NSQ_SOURCE_LINE 00000329 "    }"
NSQ_SOURCE_LINE 00000330 "  }"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "  if (exists $conf{-FlagBits}) {"
NSQ_SOURCE_LINE 00000333 "    if ($conf{-FlagBits} && ref($conf{-FlagBits}) eq 'HASH') {"
NSQ_SOURCE_LINE 00000334 "      $self->{FlagBits} = 1;"
NSQ_SOURCE_LINE 00000335 "      $self->{FlagBitsFlags} = $conf{-FlagBits};"
NSQ_SOURCE_LINE 00000336 "    }"
NSQ_SOURCE_LINE 00000337 "    delete $conf{-FlagBits};"
NSQ_SOURCE_LINE 00000338 "  }"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "  if (exists $conf{-DefaultConfig}) {"
NSQ_SOURCE_LINE 00000341 "    if ($conf{-DefaultConfig} && ref($conf{-DefaultConfig}) eq 'HASH') {"
NSQ_SOURCE_LINE 00000342 "      # copy the hashref so that it is not being modified by subsequent calls, fixes bug#142095"
NSQ_SOURCE_LINE 00000343 "      $self->{DefaultConfig} = $self->_copy($conf{-DefaultConfig});"
NSQ_SOURCE_LINE 00000344 "    }"
NSQ_SOURCE_LINE 00000345 "    elsif ($conf{-DefaultConfig} && ref($conf{-DefaultConfig}) eq q()) {"
NSQ_SOURCE_LINE 00000346 "      $self->_read($conf{-DefaultConfig}, 'SCALAR');"
NSQ_SOURCE_LINE 00000347 "      $self->{DefaultConfig} = $self->_parse($self->_hashref(), $self->{content});"
NSQ_SOURCE_LINE 00000348 "      $self->{content} = ();"
NSQ_SOURCE_LINE 00000349 "    }"
NSQ_SOURCE_LINE 00000350 "    delete $conf{-DefaultConfig};"
NSQ_SOURCE_LINE 00000351 "  }"
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "  # handle options which may either be true or false"
NSQ_SOURCE_LINE 00000354 "  # allowing \"human\" logic about what is true and what is not"
NSQ_SOURCE_LINE 00000355 "  foreach my $entry (keys %conf) {"
NSQ_SOURCE_LINE 00000356 "    my $key = $entry;"
NSQ_SOURCE_LINE 00000357 "    $key =~ s/^\\-//;"
NSQ_SOURCE_LINE 00000358 "    if (! exists $self->{$key}) {"
NSQ_SOURCE_LINE 00000359 "      croak \"Config::General: Unknown parameter: $entry => \\\"$conf{$entry}\\\" (key: <$key>)\\n\";"
NSQ_SOURCE_LINE 00000360 "    }"
NSQ_SOURCE_LINE 00000361 "    if ($conf{$entry} =~ /$self->{AutoTrueFlags}->{true}/io) {"
NSQ_SOURCE_LINE 00000362 "      $self->{$key} = 1;"
NSQ_SOURCE_LINE 00000363 "    }"
NSQ_SOURCE_LINE 00000364 "    elsif ($conf{$entry} =~ /$self->{AutoTrueFlags}->{false}/io) {"
NSQ_SOURCE_LINE 00000365 "      $self->{$key} = 0;"
NSQ_SOURCE_LINE 00000366 "    }"
NSQ_SOURCE_LINE 00000367 "    else {"
NSQ_SOURCE_LINE 00000368 "      # keep it untouched"
NSQ_SOURCE_LINE 00000369 "      $self->{$key} = $conf{$entry};"
NSQ_SOURCE_LINE 00000370 "    }"
NSQ_SOURCE_LINE 00000371 "  }"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "  if ($self->{MergeDuplicateOptions}) {"
NSQ_SOURCE_LINE 00000374 "    # override if not set by user"
NSQ_SOURCE_LINE 00000375 "    if (! exists $conf{-AllowMultiOptions}) {"
NSQ_SOURCE_LINE 00000376 "      $self->{AllowMultiOptions} = 0;"
NSQ_SOURCE_LINE 00000377 "    }"
NSQ_SOURCE_LINE 00000378 "  }"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "  if ($self->{ApacheCompatible}) {"
NSQ_SOURCE_LINE 00000381 "    # turn on all apache compatibility options which has"
NSQ_SOURCE_LINE 00000382 "    # been incorporated during the years..."
NSQ_SOURCE_LINE 00000383 "    $self->{UseApacheInclude}   = 1;"
NSQ_SOURCE_LINE 00000384 "    $self->{IncludeRelative}    = 1;"
NSQ_SOURCE_LINE 00000385 "    $self->{IncludeDirectories} = 1;"
NSQ_SOURCE_LINE 00000386 "    $self->{IncludeGlob}        = 1;"
NSQ_SOURCE_LINE 00000387 "    $self->{SlashIsDirectory}   = 1;"
NSQ_SOURCE_LINE 00000388 "    $self->{SplitPolicy}        = 'whitespace';"
NSQ_SOURCE_LINE 00000389 "    $self->{CComments}          = 0;"
NSQ_SOURCE_LINE 00000390 "    $self->{UseApacheIfDefine}  = 1;"
NSQ_SOURCE_LINE 00000391 "  }"
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "  if ($self->{UseApacheIfDefine}) {"
NSQ_SOURCE_LINE 00000394 "    if (exists $conf{-Define}) {"
NSQ_SOURCE_LINE 00000395 "      my $ref = ref($conf{-Define});"
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "      if ($ref eq '') {"
NSQ_SOURCE_LINE 00000398 "        $self->{Define} = {$conf{-Define} => 1};"
NSQ_SOURCE_LINE 00000399 "      }"
NSQ_SOURCE_LINE 00000400 "      elsif ($ref eq 'SCALAR') {"
NSQ_SOURCE_LINE 00000401 "        $self->{Define} = {${$conf{-Define}} = 1};"
NSQ_SOURCE_LINE 00000402 "      }"
NSQ_SOURCE_LINE 00000403 "      elsif ($ref eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000404 "        my %h = map { $_ => 1 } @{$conf{-Define}};"
NSQ_SOURCE_LINE 00000405 "        $self->{Define} = \\%h;"
NSQ_SOURCE_LINE 00000406 "      }"
NSQ_SOURCE_LINE 00000407 "      elsif ($ref eq 'HASH') {"
NSQ_SOURCE_LINE 00000408 "        $self->{Define} = $conf{-Define};"
NSQ_SOURCE_LINE 00000409 "      }"
NSQ_SOURCE_LINE 00000410 "      else {"
NSQ_SOURCE_LINE 00000411 "        croak qq{Config::General: Unsupported ref '$ref' for 'Define'};"
NSQ_SOURCE_LINE 00000412 "      }"
NSQ_SOURCE_LINE 00000413 ""
NSQ_SOURCE_LINE 00000414 "      delete $conf{-Define};"
NSQ_SOURCE_LINE 00000415 "    }"
NSQ_SOURCE_LINE 00000416 ""
NSQ_SOURCE_LINE 00000417 "  }"
NSQ_SOURCE_LINE 00000418 "}"
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "sub getall {"
NSQ_SOURCE_LINE 00000421 "  #"
NSQ_SOURCE_LINE 00000422 "  # just return the whole config hash"
NSQ_SOURCE_LINE 00000423 "  #"
NSQ_SOURCE_LINE 00000424 "  my($this) = @_;"
NSQ_SOURCE_LINE 00000425 "  return (exists $this->{config} ? %{$this->{config}} : () );"
NSQ_SOURCE_LINE 00000426 "}"
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 "sub files {"
NSQ_SOURCE_LINE 00000430 "  #"
NSQ_SOURCE_LINE 00000431 "  # return a list of files opened so far"
NSQ_SOURCE_LINE 00000432 "  #"
NSQ_SOURCE_LINE 00000433 "  my($this) = @_;"
NSQ_SOURCE_LINE 00000434 "  return (exists $this->{files} ? keys %{$this->{files}} : () );"
NSQ_SOURCE_LINE 00000435 "}"
NSQ_SOURCE_LINE 00000436 ""
NSQ_SOURCE_LINE 00000437 ""
NSQ_SOURCE_LINE 00000438 "sub _open {"
NSQ_SOURCE_LINE 00000439 "  #"
NSQ_SOURCE_LINE 00000440 "  # open the config file, or expand a directory or glob or include"
NSQ_SOURCE_LINE 00000441 "  #"
NSQ_SOURCE_LINE 00000442 "  my($this, $basefile, $basepath) = @_;"
NSQ_SOURCE_LINE 00000443 "  my $cont;"
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "  ($cont, $basefile, $basepath) = $this->_hook('pre_open', $basefile, $basepath);"
NSQ_SOURCE_LINE 00000446 "  return if(!$cont);"
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 "  my($fh, $configfile);"
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "  if($basepath) {"
NSQ_SOURCE_LINE 00000451 "    # if this doesn't work we can still try later the global config path to use"
NSQ_SOURCE_LINE 00000452 "    $configfile = catfile($basepath, $basefile);"
NSQ_SOURCE_LINE 00000453 "  }"
NSQ_SOURCE_LINE 00000454 "  else {"
NSQ_SOURCE_LINE 00000455 "    $configfile = $basefile;"
NSQ_SOURCE_LINE 00000456 "  }"
NSQ_SOURCE_LINE 00000457 ""
NSQ_SOURCE_LINE 00000458 "  my $glob = qr/[*?\\[\\{\\\\]/;"
NSQ_SOURCE_LINE 00000459 "  if ($^O =~ /win/i) {"
NSQ_SOURCE_LINE 00000460 "    # fix for rt.cpan.org#116340: do only consider a backslash"
NSQ_SOURCE_LINE 00000461 "    # as meta escape char, but not if it appears on it's own,"
NSQ_SOURCE_LINE 00000462 "    # as it happens on windows platforms."
NSQ_SOURCE_LINE 00000463 "    $glob = qr/(\\\\[*?\\[\\{\\\\]|[*?\\[\\{])/;"
NSQ_SOURCE_LINE 00000464 "  }"
NSQ_SOURCE_LINE 00000465 ""
NSQ_SOURCE_LINE 00000466 "  if ($this->{IncludeGlob} and $configfile =~ /$glob/) {"
NSQ_SOURCE_LINE 00000467 "    # Something like: *.conf (or maybe dir/*.conf) was included; expand it and"
NSQ_SOURCE_LINE 00000468 "    # pass each expansion through this method again."
NSQ_SOURCE_LINE 00000469 "    local $_;"
NSQ_SOURCE_LINE 00000470 "    my @include = grep { -f $_ } bsd_glob($configfile, GLOB_BRACE | GLOB_QUOTE);"
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "    # applied patch by AlexK fixing rt.cpan.org#41030"
NSQ_SOURCE_LINE 00000473 "    if ( !@include && defined $this->{ConfigPath} ) {"
NSQ_SOURCE_LINE 00000474 "      foreach my $dir (@{$this->{ConfigPath}}) {"
NSQ_SOURCE_LINE 00000475 "        my ($volume, $path, undef) = splitpath($basefile);"
NSQ_SOURCE_LINE 00000476 "        if ( -d catfile( $dir, $path )  ) {"
NSQ_SOURCE_LINE 00000477 "          push @include, grep { -f $_ } bsd_glob(catfile($dir, $basefile), GLOB_BRACE | GLOB_QUOTE);"
NSQ_SOURCE_LINE 00000478 "          last;"
NSQ_SOURCE_LINE 00000479 "        }"
NSQ_SOURCE_LINE 00000480 "      }"
NSQ_SOURCE_LINE 00000481 "    }"
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 "    # Multiple results or no expansion results (which is fine,"
NSQ_SOURCE_LINE 00000484 "    # include foo/* shouldn't fail if there isn't anything matching)"
NSQ_SOURCE_LINE 00000485 "    # rt.cpan.org#79869: local $this->{IncludeGlob};"
NSQ_SOURCE_LINE 00000486 "    foreach my $file (@include) {"
NSQ_SOURCE_LINE 00000487 "      $this->_open($file);"
NSQ_SOURCE_LINE 00000488 "    }"
NSQ_SOURCE_LINE 00000489 "    return;"
NSQ_SOURCE_LINE 00000490 "  }"
NSQ_SOURCE_LINE 00000491 ""
NSQ_SOURCE_LINE 00000492 "  if (!-e $configfile) {"
NSQ_SOURCE_LINE 00000493 "    my $found;"
NSQ_SOURCE_LINE 00000494 "    if (defined $this->{ConfigPath}) {"
NSQ_SOURCE_LINE 00000495 "      # try to find the file within ConfigPath"
NSQ_SOURCE_LINE 00000496 "      foreach my $dir (@{$this->{ConfigPath}}) {"
NSQ_SOURCE_LINE 00000497 "        if( -e catfile($dir, $basefile) ) {"
NSQ_SOURCE_LINE 00000498 "          $configfile = catfile($dir, $basefile);"
NSQ_SOURCE_LINE 00000499 "          $found = 1;"
NSQ_SOURCE_LINE 00000500 "          last; # found it"
NSQ_SOURCE_LINE 00000501 "        }"
NSQ_SOURCE_LINE 00000502 "      }"
NSQ_SOURCE_LINE 00000503 "    }"
NSQ_SOURCE_LINE 00000504 "    if (!$found) {"
NSQ_SOURCE_LINE 00000505 "      my $path_message = defined $this->{ConfigPath} ? q( within ConfigPath: ) . join(q(.), @{$this->{ConfigPath}}) : q();"
NSQ_SOURCE_LINE 00000506 "      croak qq{Config::General The file \"$basefile\" does not exist$path_message!};"
NSQ_SOURCE_LINE 00000507 "    }"
NSQ_SOURCE_LINE 00000508 "  }"
NSQ_SOURCE_LINE 00000509 ""
NSQ_SOURCE_LINE 00000510 "  local ($RS) = $RS;"
NSQ_SOURCE_LINE 00000511 "  if (! $RS) {"
NSQ_SOURCE_LINE 00000512 "    carp(q(\\$RS (INPUT_RECORD_SEPARATOR) is undefined.  Guessing you want a line feed character));"
NSQ_SOURCE_LINE 00000513 "    $RS = \"\\n\";"
NSQ_SOURCE_LINE 00000514 "  }"
NSQ_SOURCE_LINE 00000515 ""
NSQ_SOURCE_LINE 00000516 "  if (-d $configfile and $this->{IncludeDirectories}) {"
NSQ_SOURCE_LINE 00000517 "    # A directory was included; include all the files inside that directory in ASCII order"
NSQ_SOURCE_LINE 00000518 "    local *INCLUDEDIR;"
NSQ_SOURCE_LINE 00000519 "    opendir INCLUDEDIR, $configfile or croak \"Config::General: Could not open directory $configfile!($!)\\n\";"
NSQ_SOURCE_LINE 00000520 "    #my @files = sort grep { -f catfile($configfile, $_) } catfile($configfile, $_), readdir INCLUDEDIR;"
NSQ_SOURCE_LINE 00000521 "    # fixes rt.cpan.org#139261"
NSQ_SOURCE_LINE 00000522 "    my @files = sort grep { -f catfile($configfile, $_) } readdir INCLUDEDIR;"
NSQ_SOURCE_LINE 00000523 "    closedir INCLUDEDIR;"
NSQ_SOURCE_LINE 00000524 "    local $this->{CurrentConfigFilePath} = $configfile;"
NSQ_SOURCE_LINE 00000525 "    for (@files) {"
NSQ_SOURCE_LINE 00000526 "      my $file = catfile($configfile, $_);"
NSQ_SOURCE_LINE 00000527 "      if (! exists $this->{files}->{$file} or $this->{IncludeAgain} ) {"
NSQ_SOURCE_LINE 00000528 "        # support re-read if used urged us to do so, otherwise ignore the file"
NSQ_SOURCE_LINE 00000529 "        $fh = $this->_openfile_for_read($file);"
NSQ_SOURCE_LINE 00000530 "        $this->{files}->{\"$file\"} = 1;"
NSQ_SOURCE_LINE 00000531 "        $this->_read($fh);"
NSQ_SOURCE_LINE 00000532 "      }"
NSQ_SOURCE_LINE 00000533 "      else {"
NSQ_SOURCE_LINE 00000534 "        warn \"File $file already loaded.  Use -IncludeAgain to load it again.\\n\";"
NSQ_SOURCE_LINE 00000535 "      }"
NSQ_SOURCE_LINE 00000536 "    }"
NSQ_SOURCE_LINE 00000537 "  }"
NSQ_SOURCE_LINE 00000538 "  elsif (-d $configfile) {"
NSQ_SOURCE_LINE 00000539 "    croak \"Config::General: config file argument is a directory, expecting a file!\\n\";"
NSQ_SOURCE_LINE 00000540 "  }"
NSQ_SOURCE_LINE 00000541 "  elsif (-e _) {"
NSQ_SOURCE_LINE 00000542 "    if (exists $this->{files}->{$configfile} and not $this->{IncludeAgain}) {"
NSQ_SOURCE_LINE 00000543 "      # do not read the same file twice, just return"
NSQ_SOURCE_LINE 00000544 "      warn \"File $configfile already loaded.  Use -IncludeAgain to load it again.\\n\";"
NSQ_SOURCE_LINE 00000545 "      return;"
NSQ_SOURCE_LINE 00000546 "    }"
NSQ_SOURCE_LINE 00000547 "    else {"
NSQ_SOURCE_LINE 00000548 "      $fh = $this->_openfile_for_read($configfile);"
NSQ_SOURCE_LINE 00000549 "      $this->{files}->{$configfile}    = 1;"
NSQ_SOURCE_LINE 00000550 ""
NSQ_SOURCE_LINE 00000551 "      my ($volume, $path, undef)           = splitpath($configfile);"
NSQ_SOURCE_LINE 00000552 "      local $this->{CurrentConfigFilePath} = catpath($volume, $path, q());"
NSQ_SOURCE_LINE 00000553 ""
NSQ_SOURCE_LINE 00000554 "      $this->_read($fh);"
NSQ_SOURCE_LINE 00000555 "    }"
NSQ_SOURCE_LINE 00000556 "  }"
NSQ_SOURCE_LINE 00000557 "  return;"
NSQ_SOURCE_LINE 00000558 "}"
NSQ_SOURCE_LINE 00000559 ""
NSQ_SOURCE_LINE 00000560 ""
NSQ_SOURCE_LINE 00000561 "sub _openfile_for_read {"
NSQ_SOURCE_LINE 00000562 "  #"
NSQ_SOURCE_LINE 00000563 "  # actually open a file, turn on utf8 mode if requested by bom"
NSQ_SOURCE_LINE 00000564 "  #"
NSQ_SOURCE_LINE 00000565 "  my ($this, $file) = @_;"
NSQ_SOURCE_LINE 00000566 ""
NSQ_SOURCE_LINE 00000567 "  my $fh = IO::File->new( $file, 'r')"
NSQ_SOURCE_LINE 00000568 "    or croak \"Config::General: Could not open $file!($!)\\n\";"
NSQ_SOURCE_LINE 00000569 ""
NSQ_SOURCE_LINE 00000570 "  # attempt to read an initial utf8 byte-order mark (BOM)"
NSQ_SOURCE_LINE 00000571 "  my $n_read  = sysread $fh, my $read_BOM, length(_UTF8_BOM);"
NSQ_SOURCE_LINE 00000572 "  my $has_BOM = $n_read == length(_UTF8_BOM) && $read_BOM eq _UTF8_BOM;"
NSQ_SOURCE_LINE 00000573 ""
NSQ_SOURCE_LINE 00000574 "  # set utf8 perlio layer if BOM was found or if option -UTF8 is turned on"
NSQ_SOURCE_LINE 00000575 "  binmode $fh, \":utf8\" if $this->{UTF8} || $has_BOM;"
NSQ_SOURCE_LINE 00000576 ""
NSQ_SOURCE_LINE 00000577 "  # rewind to beginning of file if we read chars that were not the BOM"
NSQ_SOURCE_LINE 00000578 "  sysseek $fh, 0, 0 if $n_read && !$has_BOM;"
NSQ_SOURCE_LINE 00000579 ""
NSQ_SOURCE_LINE 00000580 "  return $fh;"
NSQ_SOURCE_LINE 00000581 "}"
NSQ_SOURCE_LINE 00000582 ""
NSQ_SOURCE_LINE 00000583 ""
NSQ_SOURCE_LINE 00000584 ""
NSQ_SOURCE_LINE 00000585 "sub _read {"
NSQ_SOURCE_LINE 00000586 "  #"
NSQ_SOURCE_LINE 00000587 "  # store the config contents in @content"
NSQ_SOURCE_LINE 00000588 "  # and prepare it somewhat for easier parsing later"
NSQ_SOURCE_LINE 00000589 "  # (comments, continuing lines, and stuff)"
NSQ_SOURCE_LINE 00000590 "  #"
NSQ_SOURCE_LINE 00000591 "  my($this, $fh, $flag) = @_;"
NSQ_SOURCE_LINE 00000592 ""
NSQ_SOURCE_LINE 00000593 ""
NSQ_SOURCE_LINE 00000594 "  my(@stuff, @content, $c_comment, $longline, $hier, $hierend, @hierdoc);"
NSQ_SOURCE_LINE 00000595 "  local $_ = q();"
NSQ_SOURCE_LINE 00000596 ""
NSQ_SOURCE_LINE 00000597 "  if ($flag && $flag eq 'SCALAR') {"
NSQ_SOURCE_LINE 00000598 "    if (ref($fh) eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000599 "      @stuff = @{$fh};"
NSQ_SOURCE_LINE 00000600 "    }"
NSQ_SOURCE_LINE 00000601 "    else {"
NSQ_SOURCE_LINE 00000602 "      @stuff = split /\\n/, $fh;"
NSQ_SOURCE_LINE 00000603 "    }"
NSQ_SOURCE_LINE 00000604 "  }"
NSQ_SOURCE_LINE 00000605 "  else {"
NSQ_SOURCE_LINE 00000606 "    @stuff = <$fh>;"
NSQ_SOURCE_LINE 00000607 "  }"
NSQ_SOURCE_LINE 00000608 ""
NSQ_SOURCE_LINE 00000609 "  my $cont;"
NSQ_SOURCE_LINE 00000610 "  ($cont, $fh, @stuff) = $this->_hook('pre_read', $fh, @stuff);"
NSQ_SOURCE_LINE 00000611 "  return if(!$cont);"
NSQ_SOURCE_LINE 00000612 ""
NSQ_SOURCE_LINE 00000613 "  if ($this->{UseApacheIfDefine}) {"
NSQ_SOURCE_LINE 00000614 "    $this->_process_apache_ifdefine(\\@stuff);"
NSQ_SOURCE_LINE 00000615 "  }"
NSQ_SOURCE_LINE 00000616 ""
NSQ_SOURCE_LINE 00000617 "  foreach (@stuff) {"
NSQ_SOURCE_LINE 00000618 "    if ($this->{AutoLaunder}) {"
NSQ_SOURCE_LINE 00000619 "      if (m/^(.*)$/) {"
NSQ_SOURCE_LINE 00000620 "        $_ = $1;"
NSQ_SOURCE_LINE 00000621 "      }"
NSQ_SOURCE_LINE 00000622 "    }"
NSQ_SOURCE_LINE 00000623 ""
NSQ_SOURCE_LINE 00000624 "    chomp;"
NSQ_SOURCE_LINE 00000625 ""
NSQ_SOURCE_LINE 00000626 ""
NSQ_SOURCE_LINE 00000627 "    if ($hier) {"
NSQ_SOURCE_LINE 00000628 "      # inside here-doc, only look for $hierend marker"
NSQ_SOURCE_LINE 00000629 "      if (/^(\\s*)\\Q$hierend\\E\\s*$/) {"
NSQ_SOURCE_LINE 00000630 "        my $indent = $1;                 # preserve indentation"
NSQ_SOURCE_LINE 00000631 "        $hier .= ' ' . $this->{EOFseparator}; # bugfix of rt.40925"
NSQ_SOURCE_LINE 00000632 "        # _parse will also preserver indentation"
NSQ_SOURCE_LINE 00000633 "        if ($indent) {"
NSQ_SOURCE_LINE 00000634 "          foreach (@hierdoc) {"
NSQ_SOURCE_LINE 00000635 "            s/^$indent//;                # i.e. the end was: \"    EOF\" then we remove \"    \" from every here-doc line"
NSQ_SOURCE_LINE 00000636 "            $hier .= $_ . \"\\n\";          # and store it in $hier"
NSQ_SOURCE_LINE 00000637 "          }"
NSQ_SOURCE_LINE 00000638 "        }"
NSQ_SOURCE_LINE 00000639 "        else {"
NSQ_SOURCE_LINE 00000640 "          $hier .= join \"\\n\", @hierdoc;  # there was no indentation of the end-string, so join it 1:1"
NSQ_SOURCE_LINE 00000641 "        }"
NSQ_SOURCE_LINE 00000642 "        push @{$this->{content}}, $hier; # push it onto the content stack"
NSQ_SOURCE_LINE 00000643 "        @hierdoc = ();"
NSQ_SOURCE_LINE 00000644 "        undef $hier;"
NSQ_SOURCE_LINE 00000645 "        undef $hierend;"
NSQ_SOURCE_LINE 00000646 "      }"
NSQ_SOURCE_LINE 00000647 "      else {"
NSQ_SOURCE_LINE 00000648 "        # everything else onto the stack"
NSQ_SOURCE_LINE 00000649 "        push @hierdoc, $_;"
NSQ_SOURCE_LINE 00000650 "      }"
NSQ_SOURCE_LINE 00000651 "      next;"
NSQ_SOURCE_LINE 00000652 "    }"
NSQ_SOURCE_LINE 00000653 ""
NSQ_SOURCE_LINE 00000654 "    if ($this->{CComments}) {"
NSQ_SOURCE_LINE 00000655 "      # look for C-Style comments, if activated"
NSQ_SOURCE_LINE 00000656 "      if (/(\\s*\\/\\*.*\\*\\/\\s*)/) {"
NSQ_SOURCE_LINE 00000657 "        # single c-comment on one line"
NSQ_SOURCE_LINE 00000658 "        s/\\s*\\/\\*.*\\*\\/\\s*//;"
NSQ_SOURCE_LINE 00000659 "      }"
NSQ_SOURCE_LINE 00000660 "      elsif (/^\\s*\\/\\*/) {"
NSQ_SOURCE_LINE 00000661 "        # the beginning of a C-comment (\"/*\"), from now on ignore everything."
NSQ_SOURCE_LINE 00000662 "        if (/\\*\\/\\s*$/) {"
NSQ_SOURCE_LINE 00000663 "          # C-comment end is already there, so just ignore this line!"
NSQ_SOURCE_LINE 00000664 "          $c_comment = 0;"
NSQ_SOURCE_LINE 00000665 "        }"
NSQ_SOURCE_LINE 00000666 "        else {"
NSQ_SOURCE_LINE 00000667 "          $c_comment = 1;"
NSQ_SOURCE_LINE 00000668 "        }"
NSQ_SOURCE_LINE 00000669 "      }"
NSQ_SOURCE_LINE 00000670 "      elsif (/\\*\\//) {"
NSQ_SOURCE_LINE 00000671 "        if (!$c_comment) {"
NSQ_SOURCE_LINE 00000672 "          warn \"invalid syntax: found end of C-comment without previous start!\\n\";"
NSQ_SOURCE_LINE 00000673 "        }"
NSQ_SOURCE_LINE 00000674 "        $c_comment = 0;    # the current C-comment ends here, go on"
NSQ_SOURCE_LINE 00000675 "        s/^.*\\*\\///;       # if there is still stuff, it will be read"
NSQ_SOURCE_LINE 00000676 "      }"
NSQ_SOURCE_LINE 00000677 "      next if($c_comment); # ignore EVERYTHING from now on, IF it IS a C-Comment"
NSQ_SOURCE_LINE 00000678 "    }"
NSQ_SOURCE_LINE 00000679 ""
NSQ_SOURCE_LINE 00000680 "    # Remove comments and empty lines"
NSQ_SOURCE_LINE 00000681 "    s/(?<!\\\\)#.*$//; # .+ => .* bugfix rt.cpan.org#44600"
NSQ_SOURCE_LINE 00000682 "    next if /^\\s*#/;"
NSQ_SOURCE_LINE 00000683 ""
NSQ_SOURCE_LINE 00000684 "    # look for multiline option, indicated by a trailing backslash"
NSQ_SOURCE_LINE 00000685 "    if (/(?<!\\\\)\\\\$/) {"
NSQ_SOURCE_LINE 00000686 "      chop; # remove trailing backslash"
NSQ_SOURCE_LINE 00000687 "      s/^\\s*//;"
NSQ_SOURCE_LINE 00000688 "      $longline .= $_;"
NSQ_SOURCE_LINE 00000689 "      next;"
NSQ_SOURCE_LINE 00000690 "    }"
NSQ_SOURCE_LINE 00000691 ""
NSQ_SOURCE_LINE 00000692 "    # transform explicit-empty blocks to conforming blocks"
NSQ_SOURCE_LINE 00000693 "    # rt.cpan.org#80006 added \\s* before $/"
NSQ_SOURCE_LINE 00000694 "    if (!$this->{ApacheCompatible} && /\\s*<([^\\/]+?.*?)\\/>\\s*$/) {"
NSQ_SOURCE_LINE 00000695 "      my $block = $1;"
NSQ_SOURCE_LINE 00000696 "      if ($block !~ /\\\"/) {"
NSQ_SOURCE_LINE 00000697 "        if ($block !~ /\\s[^\\s]/) {"
NSQ_SOURCE_LINE 00000698 "          # fix of bug 7957, add quotation to pure slash at the"
NSQ_SOURCE_LINE 00000699 "          # end of a block so that it will be considered as directory"
NSQ_SOURCE_LINE 00000700 "          # unless the block is already quoted or contains whitespaces"
NSQ_SOURCE_LINE 00000701 "          # and no quotes."
NSQ_SOURCE_LINE 00000702 "          if ($this->{SlashIsDirectory}) {"
NSQ_SOURCE_LINE 00000703 "            push @{$this->{content}}, '<' . $block . '\"/\">';"
NSQ_SOURCE_LINE 00000704 "            next;"
NSQ_SOURCE_LINE 00000705 "          }"
NSQ_SOURCE_LINE 00000706 "        }"
NSQ_SOURCE_LINE 00000707 "      }"
NSQ_SOURCE_LINE 00000708 "      my $orig  = $_;"
NSQ_SOURCE_LINE 00000709 "      $orig     =~ s/\\/>$/>/;"
NSQ_SOURCE_LINE 00000710 "      $block    =~ s/\\s\\s*.*$//;"
NSQ_SOURCE_LINE 00000711 "      push @{$this->{content}}, $orig, \"</${block}>\";"
NSQ_SOURCE_LINE 00000712 "      next;"
NSQ_SOURCE_LINE 00000713 "    }"
NSQ_SOURCE_LINE 00000714 ""
NSQ_SOURCE_LINE 00000715 ""
NSQ_SOURCE_LINE 00000716 "    # look for here-doc identifier"
NSQ_SOURCE_LINE 00000717 "    if ($this->{SplitPolicy} eq 'guess') {"
NSQ_SOURCE_LINE 00000718 "      if (/^\\s*([^=]+?)\\s*=\\s*<<\\s*(.+?)\\s*$/) {"
NSQ_SOURCE_LINE 00000719 "        # try equal sign (fix bug rt#36607)"
NSQ_SOURCE_LINE 00000720 "        $hier    = $1;  # the actual here-doc variable name"
NSQ_SOURCE_LINE 00000721 "        $hierend = $2;  # the here-doc identifier, i.e. \"EOF\""
NSQ_SOURCE_LINE 00000722 "        next;"
NSQ_SOURCE_LINE 00000723 "      }"
NSQ_SOURCE_LINE 00000724 "      elsif (/^\\s*(\\S+?)\\s+<<\\s*(.+?)\\s*$/) {"
NSQ_SOURCE_LINE 00000725 "        # try whitespace"
NSQ_SOURCE_LINE 00000726 "        $hier    = $1;  # the actual here-doc variable name"
NSQ_SOURCE_LINE 00000727 "        $hierend = $2;  # the here-doc identifier, i.e. \"EOF\""
NSQ_SOURCE_LINE 00000728 "        next;"
NSQ_SOURCE_LINE 00000729 "      }"
NSQ_SOURCE_LINE 00000730 "    }"
NSQ_SOURCE_LINE 00000731 "    else {"
NSQ_SOURCE_LINE 00000732 "      # no guess, use one of the configured strict split policies"
NSQ_SOURCE_LINE 00000733 "      if (/^\\s*(.+?)($this->{SplitDelimiter})<<\\s*(.+?)\\s*$/) {"
NSQ_SOURCE_LINE 00000734 "        $hier    = $1;  # the actual here-doc variable name"
NSQ_SOURCE_LINE 00000735 "        $hierend = $3;  # the here-doc identifier, i.e. \"EOF\""
NSQ_SOURCE_LINE 00000736 "        next;"
NSQ_SOURCE_LINE 00000737 "      }"
NSQ_SOURCE_LINE 00000738 "    }"
NSQ_SOURCE_LINE 00000739 ""
NSQ_SOURCE_LINE 00000740 ""
NSQ_SOURCE_LINE 00000741 ""
NSQ_SOURCE_LINE 00000742 "    ###"
NSQ_SOURCE_LINE 00000743 "    ### any \"normal\" config lines from now on"
NSQ_SOURCE_LINE 00000744 "    ###"
NSQ_SOURCE_LINE 00000745 ""
NSQ_SOURCE_LINE 00000746 "    if ($longline) {"
NSQ_SOURCE_LINE 00000747 "      # previous stuff was a longline and this is the last line of the longline"
NSQ_SOURCE_LINE 00000748 "      s/^\\s*//;"
NSQ_SOURCE_LINE 00000749 "      $longline .= $_;"
NSQ_SOURCE_LINE 00000750 "      push @{$this->{content}}, $longline;    # push it onto the content stack"
NSQ_SOURCE_LINE 00000751 "      undef $longline;"
NSQ_SOURCE_LINE 00000752 "      next;"
NSQ_SOURCE_LINE 00000753 "    }"
NSQ_SOURCE_LINE 00000754 "    else {"
NSQ_SOURCE_LINE 00000755 "      # ignore empty lines"
NSQ_SOURCE_LINE 00000756 "      next if /^\\s*$/;"
NSQ_SOURCE_LINE 00000757 ""
NSQ_SOURCE_LINE 00000758 "      # look for include statement(s)"
NSQ_SOURCE_LINE 00000759 "      my $incl_file;"
NSQ_SOURCE_LINE 00000760 "      my $path = '';"
NSQ_SOURCE_LINE 00000761 "      if ( $this->{IncludeRelative} and defined $this->{CurrentConfigFilePath}) {"
NSQ_SOURCE_LINE 00000762 "        $path = $this->{CurrentConfigFilePath};"
NSQ_SOURCE_LINE 00000763 "      }"
NSQ_SOURCE_LINE 00000764 "      elsif (defined $this->{ConfigPath}) {"
NSQ_SOURCE_LINE 00000765 "        # fetch pathname of base config file, assuming the 1st one is the path of it"
NSQ_SOURCE_LINE 00000766 "        $path = $this->{ConfigPath}->[0];"
NSQ_SOURCE_LINE 00000767 "      }"
NSQ_SOURCE_LINE 00000768 ""
NSQ_SOURCE_LINE 00000769 "      # bugfix rt.cpan.org#38635: support quoted filenames"
NSQ_SOURCE_LINE 00000770 "      if ($this->{UseApacheInclude}) {"
NSQ_SOURCE_LINE 00000771 "        my $opt = '';"
NSQ_SOURCE_LINE 00000772 "        if (/^\\s*(include|includeoptional)\\s*([\"'])(.*?)(?<!\\\\)\\2$/i) {"
NSQ_SOURCE_LINE 00000773 "          $incl_file = $3;"
NSQ_SOURCE_LINE 00000774 "          $opt = $1;"
NSQ_SOURCE_LINE 00000775 "        }"
NSQ_SOURCE_LINE 00000776 "        elsif (/^\\s*(include|includeoptional)\\s+(.+?)\\s*$/i) {"
NSQ_SOURCE_LINE 00000777 "          $incl_file = $2;"
NSQ_SOURCE_LINE 00000778 "          $opt = $1;"
NSQ_SOURCE_LINE 00000779 "        }"
NSQ_SOURCE_LINE 00000780 "        if ($incl_file) {"
NSQ_SOURCE_LINE 00000781 "          if ($this->{IncludeGlob} && $opt =~ /opt/i && $incl_file !~ /[*?\\[\\{\\\\]/) {"
NSQ_SOURCE_LINE 00000782 "            # fix rt#107108"
NSQ_SOURCE_LINE 00000783 "            # glob enabled && optional include && file is not already a glob:"
NSQ_SOURCE_LINE 00000784 "            # turn it into a singular matching glob, like:"
NSQ_SOURCE_LINE 00000785 "            # \"file\" => \"[f][i][l][e]\"  and:"
NSQ_SOURCE_LINE 00000786 "            # \"dir/file\" => \"dir/[f][i][l][e]\""
NSQ_SOURCE_LINE 00000787 "            # which IS a glob but only matches that particular file. if it"
NSQ_SOURCE_LINE 00000788 "            # doesn't exist, it will be ignored by _open(), just what"
NSQ_SOURCE_LINE 00000789 "            # we'd like to have when using IncludeOptional."
NSQ_SOURCE_LINE 00000790 "            my ($vol,$dirs,$file) = splitpath( $incl_file );"
NSQ_SOURCE_LINE 00000791 "            $incl_file = catpath($vol, $dirs, join '', map { \"[$_]\" } split //, $file);"
NSQ_SOURCE_LINE 00000792 "          }"
NSQ_SOURCE_LINE 00000793 "        }"
NSQ_SOURCE_LINE 00000794 "      }"
NSQ_SOURCE_LINE 00000795 "      else {"
NSQ_SOURCE_LINE 00000796 "        if (/^\\s*<<include\\s+([\"'])(.+?)>>\\\\s*$/i) {"
NSQ_SOURCE_LINE 00000797 "          $incl_file = $2;"
NSQ_SOURCE_LINE 00000798 "        }"
NSQ_SOURCE_LINE 00000799 "        elsif (/^\\s*<<include\\s+(.+?)>>\\s*$/i) {"
NSQ_SOURCE_LINE 00000800 "          $incl_file = $1;"
NSQ_SOURCE_LINE 00000801 "        }"
NSQ_SOURCE_LINE 00000802 "      }"
NSQ_SOURCE_LINE 00000803 ""
NSQ_SOURCE_LINE 00000804 "      if ($incl_file) {"
NSQ_SOURCE_LINE 00000805 "        if ( $this->{IncludeRelative} && $path && !file_name_is_absolute($incl_file) ) {"
NSQ_SOURCE_LINE 00000806 "          # include the file from within location of $this->{configfile}"
NSQ_SOURCE_LINE 00000807 "          $this->_open( $incl_file, $path );"
NSQ_SOURCE_LINE 00000808 "        }"
NSQ_SOURCE_LINE 00000809 "        else {"
NSQ_SOURCE_LINE 00000810 "          # include the file from within pwd, or absolute"
NSQ_SOURCE_LINE 00000811 "          $this->_open($incl_file);"
NSQ_SOURCE_LINE 00000812 "        }"
NSQ_SOURCE_LINE 00000813 "      }"
NSQ_SOURCE_LINE 00000814 "      else {"
NSQ_SOURCE_LINE 00000815 "        # standard entry, (option = value)"
NSQ_SOURCE_LINE 00000816 "        push @{$this->{content}}, $_;"
NSQ_SOURCE_LINE 00000817 "      }"
NSQ_SOURCE_LINE 00000818 ""
NSQ_SOURCE_LINE 00000819 "    }"
NSQ_SOURCE_LINE 00000820 ""
NSQ_SOURCE_LINE 00000821 "  }"
NSQ_SOURCE_LINE 00000822 ""
NSQ_SOURCE_LINE 00000823 "  ($cont, $this->{content}) = $this->_hook('post_read', $this->{content});"
NSQ_SOURCE_LINE 00000824 "  return 1;"
NSQ_SOURCE_LINE 00000825 "}"
NSQ_SOURCE_LINE 00000826 ""
NSQ_SOURCE_LINE 00000827 ""
NSQ_SOURCE_LINE 00000828 "sub _process_apache_ifdefine {"
NSQ_SOURCE_LINE 00000829 "  #"
NSQ_SOURCE_LINE 00000830 "  # Loop trough config lines and exclude all those entries"
NSQ_SOURCE_LINE 00000831 "  # for which there's no IFDEF but which reside inside an IFDEF."
NSQ_SOURCE_LINE 00000832 "  #"
NSQ_SOURCE_LINE 00000833 "  # Called from _read(), if UseApacheIfDefine is enabled, returns"
NSQ_SOURCE_LINE 00000834 "  # the modified array."
NSQ_SOURCE_LINE 00000835 "  my($this, $rawlines) = @_;"
NSQ_SOURCE_LINE 00000836 ""
NSQ_SOURCE_LINE 00000837 "  my @filtered;"
NSQ_SOURCE_LINE 00000838 "  my @includeFlag = (1);"
NSQ_SOURCE_LINE 00000839 ""
NSQ_SOURCE_LINE 00000840 "  foreach (@{$rawlines}) {"
NSQ_SOURCE_LINE 00000841 "    if (/^\\s*<\\s*IfDefine\\s+([!]*)(\"[^\"]+\"|\\S+)\\s*>/i) {"
NSQ_SOURCE_LINE 00000842 "      # new IFDEF block, mark following content to be included if"
NSQ_SOURCE_LINE 00000843 "      # the DEF is known, otherwise skip it til end of IFDEF"
NSQ_SOURCE_LINE 00000844 "      my ($negate, $define) = ($1 eq '!',$2);"
NSQ_SOURCE_LINE 00000845 ""
NSQ_SOURCE_LINE 00000846 "      push(@includeFlag,"
NSQ_SOURCE_LINE 00000847 "           $includeFlag[-1] & "
NSQ_SOURCE_LINE 00000848 "           ((not $negate) & (exists $this->{Define}{$define}))"
NSQ_SOURCE_LINE 00000849 "      );"
NSQ_SOURCE_LINE 00000850 "    }"
NSQ_SOURCE_LINE 00000851 "    elsif (/^\\s*<\\s*\\/IfDefine\\s*>/i) {"
NSQ_SOURCE_LINE 00000852 "      if (scalar(@includeFlag) <= 1) {"
NSQ_SOURCE_LINE 00000853 "        croak qq(Config::General: </IfDefine> without a <IfDefine>!\\n);"
NSQ_SOURCE_LINE 00000854 "      }"
NSQ_SOURCE_LINE 00000855 "      pop(@includeFlag);"
NSQ_SOURCE_LINE 00000856 "    }"
NSQ_SOURCE_LINE 00000857 "    elsif ($includeFlag[-1] && /^\\s*Define\\s+(\"[^\"]+\"|\\S+)/i) {"
NSQ_SOURCE_LINE 00000858 "      # inline Define, add it to our list"
NSQ_SOURCE_LINE 00000859 "      $this->{Define}{$1} = 1;"
NSQ_SOURCE_LINE 00000860 "    }"
NSQ_SOURCE_LINE 00000861 "    elsif ($includeFlag[-1]) {"
NSQ_SOURCE_LINE 00000862 "      push @filtered, $_;"
NSQ_SOURCE_LINE 00000863 "    }"
NSQ_SOURCE_LINE 00000864 "  }"
NSQ_SOURCE_LINE 00000865 ""
NSQ_SOURCE_LINE 00000866 "  if (scalar(@includeFlag) > 1) {"
NSQ_SOURCE_LINE 00000867 "    croak qq(Config::General: Block <IfDefine> has no EndBlock statement!\\n);"
NSQ_SOURCE_LINE 00000868 "  }"
NSQ_SOURCE_LINE 00000869 ""
NSQ_SOURCE_LINE 00000870 "  @$rawlines = @filtered;       # replace caller array"
NSQ_SOURCE_LINE 00000871 "}"
NSQ_SOURCE_LINE 00000872 ""
NSQ_SOURCE_LINE 00000873 ""
NSQ_SOURCE_LINE 00000874 "sub _parse {"
NSQ_SOURCE_LINE 00000875 "  #"
NSQ_SOURCE_LINE 00000876 "  # parse the contents of the file"
NSQ_SOURCE_LINE 00000877 "  #"
NSQ_SOURCE_LINE 00000878 "  my($this, $config, $content) = @_;"
NSQ_SOURCE_LINE 00000879 "  my(@newcontent, $block, $blockname, $chunk,$block_level);"
NSQ_SOURCE_LINE 00000880 "  local $_;"
NSQ_SOURCE_LINE 00000881 ""
NSQ_SOURCE_LINE 00000882 "  foreach (@{$content}) {                                  # loop over content stack"
NSQ_SOURCE_LINE 00000883 "    chomp;"
NSQ_SOURCE_LINE 00000884 "    $chunk++;"
NSQ_SOURCE_LINE 00000885 "    $_ =~ s/^\\s+//;                                        # strip spaces @ end and begin"
NSQ_SOURCE_LINE 00000886 "    $_ =~ s/\\s+$//;"
NSQ_SOURCE_LINE 00000887 ""
NSQ_SOURCE_LINE 00000888 "    #"
NSQ_SOURCE_LINE 00000889 "    # build option value assignment, split current input"
NSQ_SOURCE_LINE 00000890 "    # using whitespace, equal sign or optionally here-doc"
NSQ_SOURCE_LINE 00000891 "    # separator EOFseparator"
NSQ_SOURCE_LINE 00000892 "    my ($option,$value);"
NSQ_SOURCE_LINE 00000893 "    if (/$this->{EOFseparator}/) {"
NSQ_SOURCE_LINE 00000894 "      ($option,$value) = split /\\s*$this->{EOFseparator}\\s*/, $_, 2;   # separated by heredoc-finding in _open()"
NSQ_SOURCE_LINE 00000895 "    }"
NSQ_SOURCE_LINE 00000896 "    else {"
NSQ_SOURCE_LINE 00000897 "      if ($this->{SplitPolicy} eq 'guess') {"
NSQ_SOURCE_LINE 00000898 "        # again the old regex. use equalsign SplitPolicy to get the"
NSQ_SOURCE_LINE 00000899 "        # 2.00 behavior. the new regexes were too odd."
NSQ_SOURCE_LINE 00000900 "        ($option,$value) = split /\\s*=\\s*|\\s+/, $_, 2;"
NSQ_SOURCE_LINE 00000901 "      }"
NSQ_SOURCE_LINE 00000902 "      else {"
NSQ_SOURCE_LINE 00000903 "        # no guess, use one of the configured strict split policies"
NSQ_SOURCE_LINE 00000904 "        ($option,$value) = split /$this->{SplitDelimiter}/, $_, 2;"
NSQ_SOURCE_LINE 00000905 "      }"
NSQ_SOURCE_LINE 00000906 "    }"
NSQ_SOURCE_LINE 00000907 ""
NSQ_SOURCE_LINE 00000908 "    if($this->{NormalizeOption}) {"
NSQ_SOURCE_LINE 00000909 "      $option = $this->{NormalizeOption}($option);"
NSQ_SOURCE_LINE 00000910 "    }"
NSQ_SOURCE_LINE 00000911 ""
NSQ_SOURCE_LINE 00000912 "    if ($value && $value =~ /^\"/ && $value =~ /\"$/) {"
NSQ_SOURCE_LINE 00000913 "      $value =~ s/^\"//;                                    # remove leading and trailing \""
NSQ_SOURCE_LINE 00000914 "      $value =~ s/\"$//;"
NSQ_SOURCE_LINE 00000915 "    }"
NSQ_SOURCE_LINE 00000916 "    if (! defined $block) {                                # not inside a block @ the moment"
NSQ_SOURCE_LINE 00000917 "      if (/^<([^\\/]+?.*?)>$/) {                            # look if it is a block"
NSQ_SOURCE_LINE 00000918 "        $block = $1;                                       # store block name"
NSQ_SOURCE_LINE 00000919 "        if ($block =~ /^\"([^\"]+)\"$/) {"
NSQ_SOURCE_LINE 00000920 "# quoted block, unquote it and do not split"
NSQ_SOURCE_LINE 00000921 "          $block =~ s/\"//g;"
NSQ_SOURCE_LINE 00000922 "        }"
NSQ_SOURCE_LINE 00000923 "        else {"
NSQ_SOURCE_LINE 00000924 "          # If it is a named block store the name separately; allow the block and name to each be quoted"
NSQ_SOURCE_LINE 00000925 "          if ($block =~ /^(?:\"([^\"]+)\"|(\\S+))(?:\\s+(?:\"([^\"]+)\"|(.*)))?$/) {"
NSQ_SOURCE_LINE 00000926 "            $block = $1 || $2;"
NSQ_SOURCE_LINE 00000927 "            $blockname = $3 || $4;"
NSQ_SOURCE_LINE 00000928 "          }"
NSQ_SOURCE_LINE 00000929 "        }"
NSQ_SOURCE_LINE 00000930 "        if($this->{NormalizeBlock}) {"
NSQ_SOURCE_LINE 00000931 "          $block = $this->{NormalizeBlock}($block);"
NSQ_SOURCE_LINE 00000932 "          if (defined $blockname) {"
NSQ_SOURCE_LINE 00000933 "            $blockname = $this->{NormalizeBlock}($blockname);"
NSQ_SOURCE_LINE 00000934 "            if($blockname eq \"\") {"
NSQ_SOURCE_LINE 00000935 "              # if, after normalization no blockname is left, remove it"
NSQ_SOURCE_LINE 00000936 "              $blockname = undef;"
NSQ_SOURCE_LINE 00000937 "            }"
NSQ_SOURCE_LINE 00000938 "          }"
NSQ_SOURCE_LINE 00000939 "        }"
NSQ_SOURCE_LINE 00000940 "        if ($this->{InterPolateVars}) {"
NSQ_SOURCE_LINE 00000941 "          # interpolate block(name), add \"<\" and \">\" to the key, because"
NSQ_SOURCE_LINE 00000942 "          # it is sure that such keys does not exist otherwise."
NSQ_SOURCE_LINE 00000943 "          $block     = $this->_interpolate($config, \"<$block>\", $block);"
NSQ_SOURCE_LINE 00000944 "          if (defined $blockname) {"
NSQ_SOURCE_LINE 00000945 "            $blockname = $this->_interpolate($config, \"<$blockname>\", \"$blockname\");"
NSQ_SOURCE_LINE 00000946 "          }"
NSQ_SOURCE_LINE 00000947 "        }"
NSQ_SOURCE_LINE 00000948 "        if ($this->{LowerCaseNames}) {"
NSQ_SOURCE_LINE 00000949 "          $block = lc $block;    # only for blocks lc(), if configured via new()"
NSQ_SOURCE_LINE 00000950 "        }"
NSQ_SOURCE_LINE 00000951 "        $this->{level} += 1;"
NSQ_SOURCE_LINE 00000952 "        undef @newcontent;"
NSQ_SOURCE_LINE 00000953 "        next;"
NSQ_SOURCE_LINE 00000954 "      }"
NSQ_SOURCE_LINE 00000955 "      elsif (/^<\\/(.+?)>$/) { # it is an end block, but we don't have a matching block!"
NSQ_SOURCE_LINE 00000956 "        croak \"Config::General: EndBlock \\\"<\\/$1>\\\" has no StartBlock statement (level: $this->{level}, chunk $chunk)!\\n\";"
NSQ_SOURCE_LINE 00000957 "      }"
NSQ_SOURCE_LINE 00000958 "      else {                                               # insert key/value pair into actual node"
NSQ_SOURCE_LINE 00000959 "        if ($this->{LowerCaseNames}) {"
NSQ_SOURCE_LINE 00000960 "          $option = lc $option;"
NSQ_SOURCE_LINE 00000961 "        }"
NSQ_SOURCE_LINE 00000962 ""
NSQ_SOURCE_LINE 00000963 "        if (exists $config->{$option}) {"
NSQ_SOURCE_LINE 00000964 "          if ($this->{MergeDuplicateOptions}) {"
NSQ_SOURCE_LINE 00000965 "            $config->{$option} = $this->_parse_value($config, $option, $value);"
NSQ_SOURCE_LINE 00000966 ""
NSQ_SOURCE_LINE 00000967 "            # bugfix rt.cpan.org#33216"
NSQ_SOURCE_LINE 00000968 "            if ($this->{InterPolateVars}) {"
NSQ_SOURCE_LINE 00000969 "              # save pair on local stack"
NSQ_SOURCE_LINE 00000970 "              $config->{__stack}->{$option} = $config->{$option};"
NSQ_SOURCE_LINE 00000971 "            }"
NSQ_SOURCE_LINE 00000972 "          }"
NSQ_SOURCE_LINE 00000973 "          else {"
NSQ_SOURCE_LINE 00000974 "            if (! $this->{AllowMultiOptions} ) {"
NSQ_SOURCE_LINE 00000975 "              # no, duplicates not allowed"
NSQ_SOURCE_LINE 00000976 "              croak \"Config::General: Option \\\"$option\\\" occurs more than once (level: $this->{level}, chunk $chunk)!\\n\";"
NSQ_SOURCE_LINE 00000977 "            }"
NSQ_SOURCE_LINE 00000978 "            else {"
NSQ_SOURCE_LINE 00000979 "              # yes, duplicates allowed"
NSQ_SOURCE_LINE 00000980 "              if (ref($config->{$option}) ne 'ARRAY') {      # convert scalar to array"
NSQ_SOURCE_LINE 00000981 "                my $savevalue = $config->{$option};"
NSQ_SOURCE_LINE 00000982 "                delete $config->{$option};"
NSQ_SOURCE_LINE 00000983 "                push @{$config->{$option}}, $savevalue;"
NSQ_SOURCE_LINE 00000984 "              }"
NSQ_SOURCE_LINE 00000985 "              eval {"
NSQ_SOURCE_LINE 00000986 "                # check if arrays are supported by the underlying hash"
NSQ_SOURCE_LINE 00000987 "                my $i = scalar @{$config->{$option}};"
NSQ_SOURCE_LINE 00000988 "              };"
NSQ_SOURCE_LINE 00000989 "              if ($EVAL_ERROR) {"
NSQ_SOURCE_LINE 00000990 "                $config->{$option} = $this->_parse_value($config, $option, $value);"
NSQ_SOURCE_LINE 00000991 "              }"
NSQ_SOURCE_LINE 00000992 "              else {"
NSQ_SOURCE_LINE 00000993 "                # it's already an array, just push"
NSQ_SOURCE_LINE 00000994 "                push @{$config->{$option}}, $this->_parse_value($config, $option, $value);"
NSQ_SOURCE_LINE 00000995 "              }"
NSQ_SOURCE_LINE 00000996 "            }"
NSQ_SOURCE_LINE 00000997 "          }"
NSQ_SOURCE_LINE 00000998 "        }"
NSQ_SOURCE_LINE 00000999 "        else {"
NSQ_SOURCE_LINE 00001000 "          if($this->{ForceArray} && defined $value && $value =~ /^\\[\\s*(.+?)\\s*\\]$/) {"
NSQ_SOURCE_LINE 00001001 "            # force single value array entry"
NSQ_SOURCE_LINE 00001002 "            push @{$config->{$option}}, $this->_parse_value($config, $option, $1);"
NSQ_SOURCE_LINE 00001003 "          }"
NSQ_SOURCE_LINE 00001004 "          else {"
NSQ_SOURCE_LINE 00001005 "            # standard config option, insert key/value pair into node"
NSQ_SOURCE_LINE 00001006 "            $config->{$option} = $this->_parse_value($config, $option, $value);"
NSQ_SOURCE_LINE 00001007 ""
NSQ_SOURCE_LINE 00001008 "            if ($this->{InterPolateVars}) {"
NSQ_SOURCE_LINE 00001009 "              # save pair on local stack"
NSQ_SOURCE_LINE 00001010 "              $config->{__stack}->{$option} = $config->{$option};"
NSQ_SOURCE_LINE 00001011 "            }"
NSQ_SOURCE_LINE 00001012 "          }"
NSQ_SOURCE_LINE 00001013 "        }"
NSQ_SOURCE_LINE 00001014 "      }"
NSQ_SOURCE_LINE 00001015 "    }"
NSQ_SOURCE_LINE 00001016 "    elsif (/^<([^\\/]+?.*?)>$/) {    # found a start block inside a block, don't forget it"
NSQ_SOURCE_LINE 00001017 "      $block_level++;               # $block_level indicates wether we are still inside a node"
NSQ_SOURCE_LINE 00001018 "      push @newcontent, $_;         # push onto new content stack for later recursive call of _parse()"
NSQ_SOURCE_LINE 00001019 "    }"
NSQ_SOURCE_LINE 00001020 "    elsif (/^<\\/(.+?)>$/) {"
NSQ_SOURCE_LINE 00001021 "      if ($block_level) {           # this endblock is not the one we are searching for, decrement and push"
NSQ_SOURCE_LINE 00001022 "        $block_level--;             # if it is 0, then the endblock was the one we searched for, see below"
NSQ_SOURCE_LINE 00001023 "        push @newcontent, $_;       # push onto new content stack"
NSQ_SOURCE_LINE 00001024 "      }"
NSQ_SOURCE_LINE 00001025 "      else {                        # calling myself recursively, end of $block reached, $block_level is 0"
NSQ_SOURCE_LINE 00001026 "        if (defined $blockname) {"
NSQ_SOURCE_LINE 00001027 "          # a named block, make it a hashref inside a hash within the current node"
NSQ_SOURCE_LINE 00001028 ""
NSQ_SOURCE_LINE 00001029 "          if (! exists $config->{$block}) {"
NSQ_SOURCE_LINE 00001030 "            # Make sure that the hash is not created implicitly"
NSQ_SOURCE_LINE 00001031 "            $config->{$block} = $this->_hashref();"
NSQ_SOURCE_LINE 00001032 ""
NSQ_SOURCE_LINE 00001033 "            if ($this->{InterPolateVars}) {"
NSQ_SOURCE_LINE 00001034 "              # inherit current __stack to new block"
NSQ_SOURCE_LINE 00001035 "              $config->{$block}->{__stack} = $this->_copy($config->{__stack});"
NSQ_SOURCE_LINE 00001036 "            }"
NSQ_SOURCE_LINE 00001037 "          }"
NSQ_SOURCE_LINE 00001038 ""
NSQ_SOURCE_LINE 00001039 "          if (ref($config->{$block}) eq '') {"
NSQ_SOURCE_LINE 00001040 "            croak \"Config::General: Block <$block> already exists as scalar entry!\\n\";"
NSQ_SOURCE_LINE 00001041 "          }"
NSQ_SOURCE_LINE 00001042 "          elsif (ref($config->{$block}) eq 'ARRAY') {"
NSQ_SOURCE_LINE 00001043 "            croak \"Config::General: Cannot append named block <$block $blockname> to array of scalars!\\n\""
NSQ_SOURCE_LINE 00001044 "              .\"Block <$block> or scalar '$block' occurs more than once.\\n\""
NSQ_SOURCE_LINE 00001045 "              .\"Turn on -MergeDuplicateBlocks or make sure <$block> occurs only once in the config.\\n\";"
NSQ_SOURCE_LINE 00001046 "          }"
NSQ_SOURCE_LINE 00001047 "          elsif (exists $config->{$block}->{$blockname}) {"
NSQ_SOURCE_LINE 00001048 "            # the named block already exists, make it an array"
NSQ_SOURCE_LINE 00001049 "            if ($this->{MergeDuplicateBlocks}) {"
NSQ_SOURCE_LINE 00001050 "              # just merge the new block with the same name as an existing one into"
NSQ_SOURCE_LINE 00001051 "              # this one."
NSQ_SOURCE_LINE 00001052 "              $config->{$block}->{$blockname} = $this->_parse($config->{$block}->{$blockname}, \\@newcontent);"
NSQ_SOURCE_LINE 00001053 "            }"
NSQ_SOURCE_LINE 00001054 "            else {"
NSQ_SOURCE_LINE 00001055 "              if (! $this->{AllowMultiOptions}) {"
NSQ_SOURCE_LINE 00001056 "                croak \"Config::General: Named block \\\"<$block $blockname>\\\" occurs more than once (level: $this->{level}, chunk $chunk)!\\n\";"
NSQ_SOURCE_LINE 00001057 "              }"
NSQ_SOURCE_LINE 00001058 "              else {                                       # preserve existing data"
NSQ_SOURCE_LINE 00001059 "                my $savevalue = $config->{$block}->{$blockname};"
NSQ_SOURCE_LINE 00001060 "                delete $config->{$block}->{$blockname};"
NSQ_SOURCE_LINE 00001061 "                my @ar;"
NSQ_SOURCE_LINE 00001062 "                if (ref $savevalue eq 'ARRAY') {"
NSQ_SOURCE_LINE 00001063 "                  push @ar, @{$savevalue};                   # preserve array if any"
NSQ_SOURCE_LINE 00001064 "                }"
NSQ_SOURCE_LINE 00001065 "                else {"
NSQ_SOURCE_LINE 00001066 "                  push @ar, $savevalue;"
NSQ_SOURCE_LINE 00001067 "                }"
NSQ_SOURCE_LINE 00001068 "                push @ar, $this->_parse( $this->_hashref(), \\@newcontent);  # append it"
NSQ_SOURCE_LINE 00001069 "                $config->{$block}->{$blockname} = \\@ar;"
NSQ_SOURCE_LINE 00001070 "              }"
NSQ_SOURCE_LINE 00001071 "            }"
NSQ_SOURCE_LINE 00001072 "          }"
NSQ_SOURCE_LINE 00001073 "          else {"
NSQ_SOURCE_LINE 00001074 "            # the first occurrence of this particular named block"
NSQ_SOURCE_LINE 00001075 "            my $tmphash = $this->_hashref();"
NSQ_SOURCE_LINE 00001076 ""
NSQ_SOURCE_LINE 00001077 "            if ($this->{InterPolateVars}) {"
NSQ_SOURCE_LINE 00001078 "              # inherit current __stack to new block"
NSQ_SOURCE_LINE 00001079 "              $tmphash->{__stack} = $this->_copy($config->{__stack});"
NSQ_SOURCE_LINE 00001080 "            }"
NSQ_SOURCE_LINE 00001081 ""
NSQ_SOURCE_LINE 00001082 "            $config->{$block}->{$blockname} = $this->_parse($tmphash, \\@newcontent);"
NSQ_SOURCE_LINE 00001083 "          }"
NSQ_SOURCE_LINE 00001084 "        }"
NSQ_SOURCE_LINE 00001085 "        else {"
NSQ_SOURCE_LINE 00001086 "          # standard block"
NSQ_SOURCE_LINE 00001087 "          if (exists $config->{$block}) {"
NSQ_SOURCE_LINE 00001088 "            if (ref($config->{$block}) eq '') {"
NSQ_SOURCE_LINE 00001089 "              croak \"Config::General: Cannot create hashref from <$block> because there is\\n\""
NSQ_SOURCE_LINE 00001090 "                .\"already a scalar option '$block' with value '$config->{$block}'\\n\";"
NSQ_SOURCE_LINE 00001091 "            }"
NSQ_SOURCE_LINE 00001092 ""
NSQ_SOURCE_LINE 00001093 "            # the block already exists, make it an array"
NSQ_SOURCE_LINE 00001094 "            if ($this->{MergeDuplicateBlocks}) {"
NSQ_SOURCE_LINE 00001095 "              # just merge the new block with the same name as an existing one into"
NSQ_SOURCE_LINE 00001096 "              # this one."
NSQ_SOURCE_LINE 00001097 "              $config->{$block} = $this->_parse($config->{$block}, \\@newcontent);"
NSQ_SOURCE_LINE 00001098 "            }"
NSQ_SOURCE_LINE 00001099 "            else {"
NSQ_SOURCE_LINE 00001100 "              if (! $this->{AllowMultiOptions}) {"
NSQ_SOURCE_LINE 00001101 "                croak \"Config::General: Block \\\"<$block>\\\" occurs more than once (level: $this->{level}, chunk $chunk)!\\n\";"
NSQ_SOURCE_LINE 00001102 "              }"
NSQ_SOURCE_LINE 00001103 "              else {"
NSQ_SOURCE_LINE 00001104 "                my $savevalue = $config->{$block};"
NSQ_SOURCE_LINE 00001105 "                delete $config->{$block};"
NSQ_SOURCE_LINE 00001106 "                my @ar;"
NSQ_SOURCE_LINE 00001107 "                if (ref $savevalue eq \"ARRAY\") {"
NSQ_SOURCE_LINE 00001108 "                  push @ar, @{$savevalue};"
NSQ_SOURCE_LINE 00001109 "                }"
NSQ_SOURCE_LINE 00001110 "                else {"
NSQ_SOURCE_LINE 00001111 "                  push @ar, $savevalue;"
NSQ_SOURCE_LINE 00001112 "                }"
NSQ_SOURCE_LINE 00001113 ""
NSQ_SOURCE_LINE 00001114 "                # fixes rt#31529"
NSQ_SOURCE_LINE 00001115 "                my $tmphash = $this->_hashref();"
NSQ_SOURCE_LINE 00001116 "                if ($this->{InterPolateVars}) {"
NSQ_SOURCE_LINE 00001117 "                  # inherit current __stack to new block"
NSQ_SOURCE_LINE 00001118 "                  $tmphash->{__stack} = $this->_copy($config->{__stack});"
NSQ_SOURCE_LINE 00001119 "                }"
NSQ_SOURCE_LINE 00001120 ""
NSQ_SOURCE_LINE 00001121 "                push @ar, $this->_parse( $tmphash, \\@newcontent);"
NSQ_SOURCE_LINE 00001122 ""
NSQ_SOURCE_LINE 00001123 "                $config->{$block} = \\@ar;"
NSQ_SOURCE_LINE 00001124 "              }"
NSQ_SOURCE_LINE 00001125 "            }"
NSQ_SOURCE_LINE 00001126 "          }"
NSQ_SOURCE_LINE 00001127 "          else {"
NSQ_SOURCE_LINE 00001128 "            # the first occurrence of this particular block"
NSQ_SOURCE_LINE 00001129 "            my $tmphash = $this->_hashref();"
NSQ_SOURCE_LINE 00001130 ""
NSQ_SOURCE_LINE 00001131 "            if ($this->{InterPolateVars}) {"
NSQ_SOURCE_LINE 00001132 "              # inherit current __stack to new block"
NSQ_SOURCE_LINE 00001133 "              $tmphash->{__stack} = $this->_copy($config->{__stack});"
NSQ_SOURCE_LINE 00001134 "            }"
NSQ_SOURCE_LINE 00001135 ""
NSQ_SOURCE_LINE 00001136 "            $config->{$block} = $this->_parse($tmphash, \\@newcontent);"
NSQ_SOURCE_LINE 00001137 "          }"
NSQ_SOURCE_LINE 00001138 "        }"
NSQ_SOURCE_LINE 00001139 "        undef $blockname;"
NSQ_SOURCE_LINE 00001140 "        undef $block;"
NSQ_SOURCE_LINE 00001141 "        $this->{level} -= 1;"
NSQ_SOURCE_LINE 00001142 "        next;"
NSQ_SOURCE_LINE 00001143 "      }"
NSQ_SOURCE_LINE 00001144 "    }"
NSQ_SOURCE_LINE 00001145 "    else { # inside $block, just push onto new content stack"
NSQ_SOURCE_LINE 00001146 "      push @newcontent, $_;"
NSQ_SOURCE_LINE 00001147 "    }"
NSQ_SOURCE_LINE 00001148 "  }"
NSQ_SOURCE_LINE 00001149 "  if ($block) {"
NSQ_SOURCE_LINE 00001150 "    # $block is still defined, which means, that it had"
NSQ_SOURCE_LINE 00001151 "    # no matching endblock!"
NSQ_SOURCE_LINE 00001152 "    croak \"Config::General: Block \\\"<$block>\\\" has no EndBlock statement (level: $this->{level}, chunk $chunk)!\\n\";"
NSQ_SOURCE_LINE 00001153 "  }"
NSQ_SOURCE_LINE 00001154 "  return $config;"
NSQ_SOURCE_LINE 00001155 "}"
