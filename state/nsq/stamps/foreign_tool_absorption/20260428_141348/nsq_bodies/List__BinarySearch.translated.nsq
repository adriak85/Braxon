BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "## no critic (RCS,prototypes)"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "package List::BinarySearch;"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "use 5.008000;"
NSQ_SOURCE_LINE 00000006 "use strict;"
NSQ_SOURCE_LINE 00000007 "use warnings;"
NSQ_SOURCE_LINE 00000008 "use Carp;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use Scalar::Util qw( looks_like_number );"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "BEGIN {"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "  my @imports = qw( binsearch binsearch_pos );"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "  # Import XS by default, pure-Perl if XS is unavailable, or if"
NSQ_SOURCE_LINE 00000018 "  # $ENV{List_BinarySearch_PP} is set."
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "  # This conditional has been tested manually.  Can't be automatically tested."
NSQ_SOURCE_LINE 00000021 "  # uncoverable condition right false"
NSQ_SOURCE_LINE 00000022 "  if ("
NSQ_SOURCE_LINE 00000023 "       $ENV{List_BinarySearch_PP}"
NSQ_SOURCE_LINE 00000024 "    || ! eval 'use List::BinarySearch::XS @imports; 1;'  ## no critic (eval)"
NSQ_SOURCE_LINE 00000025 "  ) {"
NSQ_SOURCE_LINE 00000026 "    eval 'use List::BinarySearch::PP  @imports;';        ## no critic (eval)"
NSQ_SOURCE_LINE 00000027 "  }"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "}"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "require Exporter;"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "our @ISA       = qw(Exporter);    ## no critic (ISA)"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "# Note: binsearch and binsearch_pos come from List::BinarySearch::PP"
NSQ_SOURCE_LINE 00000036 "our @EXPORT_OK = qw(  binsearch         binsearch_pos       binsearch_range  );"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "our %EXPORT_TAGS = ( all => \\@EXPORT_OK );"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "# The prototyping gives List::BinarySearch a similar feel to List::Util,"
NSQ_SOURCE_LINE 00000041 "# and List::MoreUtils."
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "our $VERSION = '0.25';"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "# Needed for developer's releases: See perlmodstyle."
NSQ_SOURCE_LINE 00000046 "# $VERSION = eval $VERSION;    ## no critic (eval,version)"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "# Custom import() to touch $a and $b in Perl version < 5.20, to eliminate"
NSQ_SOURCE_LINE 00000050 "# \"used only once\" warnings."
NSQ_SOURCE_LINE 00000051 "{"
NSQ_SOURCE_LINE 00000052 "  if( $] < 5.020 ) {"
NSQ_SOURCE_LINE 00000053 "    *import = sub {"
NSQ_SOURCE_LINE 00000054 "      my $pkg = caller;"
NSQ_SOURCE_LINE 00000055 "      no strict 'refs'; ## no critic(strict)"
NSQ_SOURCE_LINE 00000056 "      ${\"${pkg}::a\"} = ${\"${pkg}::a\"};"
NSQ_SOURCE_LINE 00000057 "      ${\"${pkg}::b\"} = ${\"${pkg}::b\"};"
NSQ_SOURCE_LINE 00000058 "      # It would feel nicer to call shift->SUPER::import(@_), but "
NSQ_SOURCE_LINE 00000059 "      # Exporter::import appears to be too fragile for this type of wrapper."
NSQ_SOURCE_LINE 00000060 "      goto &Exporter::import;"
NSQ_SOURCE_LINE 00000061 "    };"
NSQ_SOURCE_LINE 00000062 "  }"
NSQ_SOURCE_LINE 00000063 "}"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "# binsearch and binsearch_pos will be loaded from List::BinarySearch::PP or"
NSQ_SOURCE_LINE 00000068 "# List::BinarySearch::XS."
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "sub binsearch_range (&$$\\@) {"
NSQ_SOURCE_LINE 00000073 "  my( $code, $low_target, $high_target, $aref ) = @_;"
NSQ_SOURCE_LINE 00000074 "  my( $index_low, $index_high );"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "  # Forward along the caller's $a and $b."
NSQ_SOURCE_LINE 00000077 "  local( *a, *b ) = do{"
NSQ_SOURCE_LINE 00000078 "    no strict 'refs';  ## no critic (strict)"
NSQ_SOURCE_LINE 00000079 "    my $pkg = caller();"
NSQ_SOURCE_LINE 00000080 "    ( *{$pkg.'::a'}, *{$pkg.'::b'} );"
NSQ_SOURCE_LINE 00000081 "  };"
NSQ_SOURCE_LINE 00000082 "  $index_low  = binsearch_pos( \\&$code, $low_target,  @$aref );"
NSQ_SOURCE_LINE 00000083 "  $index_high = binsearch_pos( \\&$code, $high_target, @$aref );"
NSQ_SOURCE_LINE 00000084 "  local( $a, $b ) = ( $aref->[$index_high], $high_target ); # Use our own."
NSQ_SOURCE_LINE 00000085 "  if(  $index_high == scalar @$aref    or    $code->( $a, $b ) > 0  )"
NSQ_SOURCE_LINE 00000086 "  {"
NSQ_SOURCE_LINE 00000087 "    $index_high--;"
NSQ_SOURCE_LINE 00000088 "  }"
NSQ_SOURCE_LINE 00000089 "  return ( $index_low, $index_high );"
NSQ_SOURCE_LINE 00000090 "}"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "1;    # End of List::BinarySearch"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "__END__"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "=head1 NAME"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "List::BinarySearch - Binary Search within a sorted array."
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "This module performs a binary search on an array."
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "Examples:"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "    use List::BinarySearch qw( :all );  # ... or ..."
NSQ_SOURCE_LINE 00000110 "    use List::BinarySearch qw( binsearch  binsearch_pos  binsearch_range );"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "    # Some ordered arrays to search within."
NSQ_SOURCE_LINE 00000114 "    @num_array =   ( 100, 200, 300, 400, 500 );"
NSQ_SOURCE_LINE 00000115 "    @str_array = qw( Bach Beethoven Brahms Mozart Schubert );"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "    # Find the lowest index of a matching element."
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "    $index = binsearch {$a <=> $b} 300, @num_array;"
NSQ_SOURCE_LINE 00000121 "    $index = binsearch {$a cmp $b} 'Mozart', @str_array;      # Stringy cmp."
NSQ_SOURCE_LINE 00000122 "    $index = binsearch {$a <=> $b} 42, @num_array;            # not found: undef"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "    # Find the lowest index of a matching element, or best insert point."
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "    $index = binsearch_pos {$a cmp $b} 'Chopin', @str_array;  # Insert at [3]."
NSQ_SOURCE_LINE 00000128 "    $index = binsearch_pos {$a <=> $b} 600, @num_array;       # Insert at [5]."
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "    splice @num_array, $index, 0, 600"
NSQ_SOURCE_LINE 00000131 "      if( $num_array[$index] != 600 );                        # Insertion at [5]"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "    $index = binsearch_pos { $a <=> $b } 200, @num_array;     # Matched at [1]."
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "    # The following functions return an inclusive range."
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "    my( $low_ix, $high_ix )"
NSQ_SOURCE_LINE 00000139 "        = binsearch_range { $a cmp $b } 'Beethoven', 'Mozart', @str_array;"
NSQ_SOURCE_LINE 00000140 "        # Returns ( 1, 3 ), meaning ( 1 .. 3 )."
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "    my( $low_ix, $high_ix )"
NSQ_SOURCE_LINE 00000143 "        = binsearch_range { $a <=> $b } 200, 400, @num_array;"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "A binary search searches B<sorted> lists using a divide and conquer technique."
NSQ_SOURCE_LINE 00000150 "On each iteration the search domain is cut in half, until the result is found."
NSQ_SOURCE_LINE 00000151 "The computational complexity of a binary search is O(log n)."
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "The binary search algorithm implemented in this module is known as a"
NSQ_SOURCE_LINE 00000154 "I<Deferred Detection> variant on the traditional Binary Search.  Deferred"
NSQ_SOURCE_LINE 00000155 "Detection provides B<stable searches>.  Stable binary search algorithms have"
NSQ_SOURCE_LINE 00000156 "the following characteristics, contrasted with their unstable binary search"
NSQ_SOURCE_LINE 00000157 "cousins:"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "=over 4"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "=item * In the case of non-unique keys, a stable binary search will always"
NSQ_SOURCE_LINE 00000162 "return the lowest-indexed matching element.  An unstable binary search would"
NSQ_SOURCE_LINE 00000163 "return the first one found, which may not be the chronological first."
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "=item * Best and worst case time complexity is always O(log n).  Unstable"
NSQ_SOURCE_LINE 00000166 "searches may stop once the target is found, but in the worst case are still"
NSQ_SOURCE_LINE 00000167 "O(log n).  In practical terms, this difference is usually not meaningful."
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "=item * Stable binary searches only require one relational comparison of a"
NSQ_SOURCE_LINE 00000170 "given pair of data elements per iteration, where unstable binary searches"
NSQ_SOURCE_LINE 00000171 "require two comparisons per iteration."
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "=item * The net result is that although an unstable binary search might have"
NSQ_SOURCE_LINE 00000174 "better \"best case\" performance, the fact that a stable binary search gets away"
NSQ_SOURCE_LINE 00000175 "with fewer comparisons per iteration gives it better performance in the worst"
NSQ_SOURCE_LINE 00000176 "case, and approximately equal performance in the average case. By trading away"
NSQ_SOURCE_LINE 00000177 "slightly better \"best case\" performance, the stable search gains the guarantee"
NSQ_SOURCE_LINE 00000178 "that the element found will always be the lowest-indexed element in a range of"
NSQ_SOURCE_LINE 00000179 "non-unique keys."
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "=back"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "B<< This module has a companion \"XS\" module: L<List::BinarySearch::XS> which"
NSQ_SOURCE_LINE 00000184 "users are strongly encouraged to install as well. >>  If List::BinarySearch::XS"
NSQ_SOURCE_LINE 00000185 "is also installed, C<binsearch> and C<binsearch_pos> will use XS code.  This"
NSQ_SOURCE_LINE 00000186 "behavior may be overridden by setting C<$ENV{List_BinarySearch_PP}> to a"
NSQ_SOURCE_LINE 00000187 "true value.  Most CPAN installers will either automatically install the XS"
NSQ_SOURCE_LINE 00000188 "module, or prompt to automatically install it.  See CONFIGURATION for details."
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "=head1 RATIONALE"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "B<A binary search is pretty simple, right?  Why use a module for this?>"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "Quoting from"
NSQ_SOURCE_LINE 00000196 "L<Wikipedia|http://en.wikipedia.org/wiki/Binary_search_algorithm>:  I<When Jon"
NSQ_SOURCE_LINE 00000197 "Bentley assigned it as a problem in a course for professional"
NSQ_SOURCE_LINE 00000198 "programmers, he found that an astounding ninety percent failed to code a"
NSQ_SOURCE_LINE 00000199 "binary search correctly after several hours of working on it, and another"
NSQ_SOURCE_LINE 00000200 "study shows that accurate code for it is only found in five out of twenty"
NSQ_SOURCE_LINE 00000201 "textbooks. Furthermore, Bentley's own implementation of binary search,"
NSQ_SOURCE_LINE 00000202 "published in his 1986 book Programming Pearls, contains an error that remained"
NSQ_SOURCE_LINE 00000203 "undetected for over twenty years.>"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "So to answer the question, you might use a module so that you"
NSQ_SOURCE_LINE 00000206 "don't have to write, test, and debug your own implementation."
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "B<< Perl has C<grep>, hashes, and other alternatives, right? >>"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "Yes, before using this module the user should weigh the other options such as"
NSQ_SOURCE_LINE 00000212 "linear searches ( C<grep> or C<List::Util::first> ), or hash based searches. A"
NSQ_SOURCE_LINE 00000213 "binary search requires an ordered list, so one must weigh the cost of sorting or"
NSQ_SOURCE_LINE 00000214 "maintaining the list in sorted order.  Ordered lists have O(n) time complexity"
NSQ_SOURCE_LINE 00000215 "for inserts.  Binary Searches are best when the data set is already ordered, or"
NSQ_SOURCE_LINE 00000216 "will be searched enough times to justify the cost of an initial sort."
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "There are cases where a binary search may be an excellent choice. Finding the"
NSQ_SOURCE_LINE 00000219 "first matching element in a list of 1,000,000 items with a linear search would"
NSQ_SOURCE_LINE 00000220 "have a worst-case of 1,000,000 iterations, whereas the worst case for a binary"
NSQ_SOURCE_LINE 00000221 "search of 1,000,000 elements is about 20 iterations.  In fact, if many lookups"
NSQ_SOURCE_LINE 00000222 "will be performed on a seldom-changed list, the savings of O(log n) lookups may"
NSQ_SOURCE_LINE 00000223 "outweigh the cost of sorting or performing occasional linear time inserts."
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "=head1 EXPORT"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "Nothing is exported by default.  C<binsearch>, C<binsearch_pos>, and"
NSQ_SOURCE_LINE 00000229 "C<binsearch_range> may be exported by listing them on the export list."
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "Or import all functions by specifying C<:all>."
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "=head1 SUBROUTINES/METHODS"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "=head2 WHICH SEARCH ROUTINE TO USE"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "=over 4"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "=item * C<binsearch>: Returns lowest index where match is found, or undef."
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "=item * C<binsearch_pos>: Returns lowest index where match is found, or the"
NSQ_SOURCE_LINE 00000242 "index of the best insert point for needle if the needle isn't found."
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "=item * C<binsearch_range>: Performs a search for both low and high needles."
NSQ_SOURCE_LINE 00000245 "Returns a pair of indices refering to a range of elements corresponding to"
NSQ_SOURCE_LINE 00000246 "low and high needles."
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "=back"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "=head2 binsearch CODE NEEDLE ARRAY_HAYSTACK"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "    $first_found_ix = binsearch { $a cmp $b } $needle, @haystack;"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "Pass a code block, a search target, and an array to search.  Uses"
NSQ_SOURCE_LINE 00000255 "the supplied code block C<$needle> to test the needle against elements"
NSQ_SOURCE_LINE 00000256 "in C<@haystack>."
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "See the section entitled B<The Callback Block>, below, for an explanation"
NSQ_SOURCE_LINE 00000259 "of how the comparator works"
NSQ_SOURCE_LINE 00000260 "(hint: very similar to C<< sort { $a <=> $b } ... >> )."
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "Return value will be the lowest index of an element that matches target, or"
NSQ_SOURCE_LINE 00000263 "undef if target isn't found."
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "=head2 binsearch_pos CODE NEEDLE ARRAY_HAYSTACK"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "    $first_found_ix = binsearch_pos { $a cmp $b } $needle, @haystack;"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "The only difference between this function and C<binsearch> is its return"
NSQ_SOURCE_LINE 00000270 "value upon failure.  C<binsearch> returns undef upon failure."
NSQ_SOURCE_LINE 00000271 "C<binsearch_pos> returns the index of a valid insert point for"
NSQ_SOURCE_LINE 00000272 "C<$needle>."
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "Pass a code block, a search target, and an array to search.  Uses"
NSQ_SOURCE_LINE 00000275 "the code block to test C<$needle> against elements in C<@haystack>."
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "Return value is the index of the first element equaling C<$needle>.  If no"
NSQ_SOURCE_LINE 00000278 "element is found, the best insert-point for C<$needle> is returned."
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "=head2 binsearch_range CODE LOW_NEEDLE HIGH_NEEDLE ARRAY_HAYSTACK"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "    my( $low, $high )"
NSQ_SOURCE_LINE 00000284 "      = binsearch_range { $a <=> $b }, $low_needle, $high_needle, @haystack;"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "Given C<$low_needle> and C<$high_needle>, returns a set of indices that"
NSQ_SOURCE_LINE 00000287 "represent the range of elements fitting within C<$low_needle> and"
NSQ_SOURCE_LINE 00000288 "C<$high_needle>'s bounds.  This might be useful, for example, in finding all"
NSQ_SOURCE_LINE 00000289 "transations that occurred between 02012013 and 02292013."
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "I<This algorithm was adapted from Mastering Algorithms with Perl, page 172 and"
NSQ_SOURCE_LINE 00000292 "173.>"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "=head2 The callback block (The comparator)"
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "Comparators in L<List::BinarySearch> are used to compare the target (needle)"
NSQ_SOURCE_LINE 00000297 "with individual haystack elements, returning the result of the relational"
NSQ_SOURCE_LINE 00000298 "comparison of the two values.  A good example would be the code block in a"
NSQ_SOURCE_LINE 00000299 "C<sort> function."
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "Basic comparators might be defined like this:"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "    # Numeric comparisons:"
NSQ_SOURCE_LINE 00000304 "    binsearch { $a <=> $b } $needle, @haystack;"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "    # Stringwise comparisons:"
NSQ_SOURCE_LINE 00000307 "    binsearch { $a cmp $b } $needle, @haystack;"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "    # Unicode Collation Algorithm comparisons"
NSQ_SOURCE_LINE 00000310 "    $Collator = Unicode::Collate->new;"
NSQ_SOURCE_LINE 00000311 "    binsearch { $Collator->( $a, $b ) } $needle, @haystack;"
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "C<$a> represents the target.  C<$b> represents the contents of the haystack"
NSQ_SOURCE_LINE 00000314 "element being tested.  This leads to an asymmetry that might be prone to"
NSQ_SOURCE_LINE 00000315 "\"gotchas\" when writing custom comparators for searching complex data structures."
NSQ_SOURCE_LINE 00000316 "As an example, consider the following data structure:"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "    my @structure = ("
NSQ_SOURCE_LINE 00000319 "        [ 100, 'ape'  ],"
NSQ_SOURCE_LINE 00000320 "        [ 200, 'cat'  ],"
NSQ_SOURCE_LINE 00000321 "        [ 300, 'dog'  ],"
NSQ_SOURCE_LINE 00000322 "        [ 400, 'frog' ]"
NSQ_SOURCE_LINE 00000323 "    );"
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "A numeric custom comparator for such a data structure would look like this:"
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "    sub{ $a <=> $b->[0] }"
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "In this regard, the callback is unlike C<sort>, because C<sort> is always"
NSQ_SOURCE_LINE 00000330 "comparing to elements, whereas C<binsearch> is comparing a target with an"
NSQ_SOURCE_LINE 00000331 "element."
NSQ_SOURCE_LINE 00000332 ""
NSQ_SOURCE_LINE 00000333 "Just as with C<sort>, the comparator must return -1, 0, or 1 to signify \"less"
NSQ_SOURCE_LINE 00000334 "than\", \"equal to\", or \"greater than\"."
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "=head1 DATA SET REQUIREMENTS"
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "A well written general algorithm should place as few demands on its data as"
NSQ_SOURCE_LINE 00000340 "practical.  The requirements that these Binary Search algorithms impose are:"
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "=over 4"
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "=item * B<The list must be in ascending sorted order>."
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "This is a big one.  The best sort routines run in O(n log n) time.  It makes no"
NSQ_SOURCE_LINE 00000347 "sense to sort a list in O(n log n) time, and then perform a single O(log n)"
NSQ_SOURCE_LINE 00000348 "binary search when List::Util C<first> could accomplish the same thing in O(n)"
NSQ_SOURCE_LINE 00000349 "time without sorting."
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "=item * B<The list must be in ascending sorted order.>"
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "A Binary Search consumes O(log n) time. We don't want to waste linear time"
NSQ_SOURCE_LINE 00000354 "verifying the list is sordted, so B<there is no validity checking. You have"
NSQ_SOURCE_LINE 00000355 "been warned.>"
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "=item * B<These functions are prototyped> as (&$\\@) or ($\\@)."
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "What this implementation detail means is that C<@haystack> is implicitly passed"
NSQ_SOURCE_LINE 00000360 "by reference.  This is the price we pay for a familiar user interface, cleaner"
NSQ_SOURCE_LINE 00000361 "calling syntax, and the automatic efficiency of pass-by-reference."
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "=item * B<Objects in the search lists must be capable of being evaluated for"
NSQ_SOURCE_LINE 00000364 "relationaity.>"
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "I threw that in for C++ folks who have spent some time with Effective STL.  For"
NSQ_SOURCE_LINE 00000367 "everyone else don't worry; if you know how to C<sort> you know how to"
NSQ_SOURCE_LINE 00000368 "C<binsearch>."
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "=back"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "=head1 UNICODE SUPPORT"
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "Lists sorted according to the Unicode Collation Algorithm must be searched using"
NSQ_SOURCE_LINE 00000375 "the same Unicode Collation Algorithm, Here's an example using"
NSQ_SOURCE_LINE 00000376 "L<Unicode::Collate>'s C<< $Collator->cmp($a,$b) >>:"
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 "    my $found_index = binsearch { $Collator->cmp($a, $b) } $needle, @haystack;"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "=head1 CONFIGURATION AND ENVIRONMENT"
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "List::BinarySearch is a thin layer that will attempt to load"
NSQ_SOURCE_LINE 00000384 "List::BinarySearch::XS first, and if that module is unavailable, will fall back"
NSQ_SOURCE_LINE 00000385 "to List::BinarySearch::PP which is provided with this distribution."
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "Most CPAN installers will automatically pull in and install the XS plugin "
NSQ_SOURCE_LINE 00000388 "for this module.  If in interactive mode, they will prompt first. To override "
NSQ_SOURCE_LINE 00000389 "default behavior, forcing CPAN installers to I<not> pull in the XS module, "
NSQ_SOURCE_LINE 00000390 "set the environment variable LBS_NO_XS true prior to installation.  There"
NSQ_SOURCE_LINE 00000391 "will be no prompt, and the XS module won't be pulled in and installed."
NSQ_SOURCE_LINE 00000392 "However, the List::BinarySearch::XS plugin is strongly recommended, and should"
NSQ_SOURCE_LINE 00000393 "only be skipped in environments where XS modules cannot be compiled."
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "If one wishes to install the XS module beforhand, or at any time later on, just"
NSQ_SOURCE_LINE 00000396 "installing it in the usual fashion is sufficient for List::BinarySearch to"
NSQ_SOURCE_LINE 00000397 "recognize and start using it."
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "By installing L<List::BinarySearch::XS>, the pure-Perl versions of C<binsearch>"
NSQ_SOURCE_LINE 00000400 "and C<binsearch_pos> will be automatically replaced with XS versions for"
NSQ_SOURCE_LINE 00000401 "markedly improved performance.  C<binsearch_range> also benefits from the XS"
NSQ_SOURCE_LINE 00000402 "plug-in, since internally it makes calls to C<binsearch_pos>."
NSQ_SOURCE_LINE 00000403 ""
NSQ_SOURCE_LINE 00000404 "Users are strongly advised to install L<List::BinarySearch::XS>.  If, after"
NSQ_SOURCE_LINE 00000405 "installing List::BinarySearch::XS, one wishes to disable the XS plugin, setting"
NSQ_SOURCE_LINE 00000406 "C<$ENV{List_BinarySearch_PP}> to a true value will prevent the XS module from"
NSQ_SOURCE_LINE 00000407 "being used by L<List::BinarySearch>.  This setting will have no effect on users"
NSQ_SOURCE_LINE 00000408 "who use List::BinarySearch::XS directly."
NSQ_SOURCE_LINE 00000409 ""
NSQ_SOURCE_LINE 00000410 "For the sake of code portability, it is recommended to use List::BinarySearch "
NSQ_SOURCE_LINE 00000411 "as the front-end, as it will automatically and portably downgrade to the "
NSQ_SOURCE_LINE 00000412 "pure-Perl version if the XS module can't be loaded."
NSQ_SOURCE_LINE 00000413 ""
NSQ_SOURCE_LINE 00000414 ""
NSQ_SOURCE_LINE 00000415 "=head1 DEPENDENCIES"
NSQ_SOURCE_LINE 00000416 ""
NSQ_SOURCE_LINE 00000417 "This module uses L<Exporter|Exporter>, and automatically makes use of"
NSQ_SOURCE_LINE 00000418 "L<List::BinarySearch::XS> if it's installed on the user's system."
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "This module will attempt to install List::BinarySearch::XS unless the"
NSQ_SOURCE_LINE 00000421 "environment variable C<LBS_NO_XS> is set prior to install, or if in interactive"
NSQ_SOURCE_LINE 00000422 "mode, the user opts to skip this recommended step."
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "This module supports Perl versions 5.8 and newer."
NSQ_SOURCE_LINE 00000425 "The optional XS extension also supports Perl 5.8 and newer."
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "=head1 INCOMPATIBILITIES"
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "This module is incompatible with Perl versions prior to 5.8.  In particular,"
NSQ_SOURCE_LINE 00000431 "its use of prototypes isn't compatible with Perl 5.6 or older.  It would be"
NSQ_SOURCE_LINE 00000432 "easy to eliminate the use of prototypes, but doing so would change calling"
NSQ_SOURCE_LINE 00000433 "syntax."
NSQ_SOURCE_LINE 00000434 ""
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 "=head1 DIAGNOSTICS"
NSQ_SOURCE_LINE 00000437 ""
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "L<List::BinarySearch::XS>: An XS plugin for this module; install it, and this"
NSQ_SOURCE_LINE 00000442 "module will use it automatically for a nice performance improvement.  May also"
NSQ_SOURCE_LINE 00000443 "be used on its own."
NSQ_SOURCE_LINE 00000444 ""
