NSQ_SOURCE_LINE 00000001 "package Perinci::AccessUtil;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2015-09-06'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.06'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use 5.010001;"
NSQ_SOURCE_LINE 00000007 "use strict;"
NSQ_SOURCE_LINE 00000008 "use warnings;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use MIME::Base64;"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "require Exporter;"
NSQ_SOURCE_LINE 00000013 "our @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000014 "our @EXPORT_OK = qw(insert_riap_stuffs_to_res"
NSQ_SOURCE_LINE 00000015 "                    strip_riap_stuffs_from_res"
NSQ_SOURCE_LINE 00000016 "                    decode_args_in_riap_req);"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "sub insert_riap_stuffs_to_res {"
NSQ_SOURCE_LINE 00000019 "    my ($res, $def_ver, $nmeta, $encode) = @_;"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "    $res->[3]{'riap.v'} //= $def_ver // 1.1;"
NSQ_SOURCE_LINE 00000022 "    if ($res->[3]{'riap.v'} >= 1.2) {"
NSQ_SOURCE_LINE 00000023 "        # do we need to base64-encode?"
NSQ_SOURCE_LINE 00000024 "        {"
NSQ_SOURCE_LINE 00000025 "            last unless $encode // 1;"
NSQ_SOURCE_LINE 00000026 "            last if $res->[3]{'riap.result_encoding'};"
NSQ_SOURCE_LINE 00000027 "            if ($nmeta) {"
NSQ_SOURCE_LINE 00000028 "                last unless $nmeta->{result}{schema} &&"
NSQ_SOURCE_LINE 00000029 "                    $nmeta->{result}{schema}[0] eq 'buf';"
NSQ_SOURCE_LINE 00000030 "            }"
NSQ_SOURCE_LINE 00000031 "            last unless defined($res->[2]) && !ref($res->[2]) &&"
NSQ_SOURCE_LINE 00000032 "                $res->[2] =~ /[^\\x20-\\x7f]/;"
NSQ_SOURCE_LINE 00000033 "            $res->[2] = encode_base64($res->[2], \"\");"
NSQ_SOURCE_LINE 00000034 "            $res->[3]{'riap.result_encoding'} = 'base64';"
NSQ_SOURCE_LINE 00000035 "        }"
NSQ_SOURCE_LINE 00000036 "    }"
NSQ_SOURCE_LINE 00000037 "    $res;"
NSQ_SOURCE_LINE 00000038 "}"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "sub strip_riap_stuffs_from_res {"
NSQ_SOURCE_LINE 00000041 "    my $res = shift;"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "    my $ver = $res->[3]{'riap.v'} // 1.1;"
NSQ_SOURCE_LINE 00000044 "    return [501, \"Riap version returned by server ($ver) is not supported, \"."
NSQ_SOURCE_LINE 00000045 "                \"only recognize v1.1 and v1.2\"]"
NSQ_SOURCE_LINE 00000046 "        unless $ver == 1.1 || $ver == 1.2;"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "    if ($ver >= 1.2) {"
NSQ_SOURCE_LINE 00000049 "        # check and strip riap.*"
NSQ_SOURCE_LINE 00000050 "        for my $k (keys %{$res->[3]}) {"
NSQ_SOURCE_LINE 00000051 "            next unless $k =~ /\\Ariap\\./;"
NSQ_SOURCE_LINE 00000052 "            my $val = $res->[3]{$k};"
NSQ_SOURCE_LINE 00000053 "            if ($k eq 'riap.v') {"
NSQ_SOURCE_LINE 00000054 "            } elsif ($k eq 'riap.result_encoding') {"
NSQ_SOURCE_LINE 00000055 "                return [501, \"Unknown result_encoding returned by server \"."
NSQ_SOURCE_LINE 00000056 "                            \"($val), only base64 is supported\"]"
NSQ_SOURCE_LINE 00000057 "                    unless $val eq 'base64';"
NSQ_SOURCE_LINE 00000058 "                $res->[2] = decode_base64($res->[2]//'');"
NSQ_SOURCE_LINE 00000059 "            } else {"
NSQ_SOURCE_LINE 00000060 "                return [501, \"Unknown Riap attribute in result metadata \"."
NSQ_SOURCE_LINE 00000061 "                            \"returned by server ($k)\"];"
NSQ_SOURCE_LINE 00000062 "            }"
NSQ_SOURCE_LINE 00000063 "            delete $res->[3]{$k};"
NSQ_SOURCE_LINE 00000064 "        }"
NSQ_SOURCE_LINE 00000065 "    }"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "    $res;"
NSQ_SOURCE_LINE 00000068 "}"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "sub decode_args_in_riap_req {"
NSQ_SOURCE_LINE 00000071 "    my $req = shift;"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "    my $v = $req->{v} // 1.1;"
NSQ_SOURCE_LINE 00000074 "    if ($v >= 1.2) {"
NSQ_SOURCE_LINE 00000075 "        if ($req->{args}) {"
NSQ_SOURCE_LINE 00000076 "            my $args = $req->{args};"
NSQ_SOURCE_LINE 00000077 "            for (keys %$args) {"
NSQ_SOURCE_LINE 00000078 "                next unless /\\A(.+):base64\\z/;"
NSQ_SOURCE_LINE 00000079 "                $args->{$1} = decode_base64($args->{$_});"
NSQ_SOURCE_LINE 00000080 "                delete $args->{$_};"
NSQ_SOURCE_LINE 00000081 "            }"
NSQ_SOURCE_LINE 00000082 "        }"
NSQ_SOURCE_LINE 00000083 "    }"
NSQ_SOURCE_LINE 00000084 "    $req;"
NSQ_SOURCE_LINE 00000085 "}"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "1;"
NSQ_SOURCE_LINE 00000088 "# ABSTRACT: Utility module for Riap client/server"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "__END__"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "=pod"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "=head1 NAME"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "Perinci::AccessUtil - Utility module for Riap client/server"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "=head1 VERSION"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "This document describes version 0.06 of Perinci::AccessUtil (from Perl distribution Perinci-AccessUtil), released on 2015-09-06."
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 " use Perinci::AccessUtil qw("
NSQ_SOURCE_LINE 00000107 "     strip_riap_stuffs_from_res"
NSQ_SOURCE_LINE 00000108 "     insert_riap_stuffs_to_res"
NSQ_SOURCE_LINE 00000109 "     decode_args_in_riap_req"
NSQ_SOURCE_LINE 00000110 " );"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 " strip_riap_stuffs_from_res([200,\"OK\",undef,{\"riap.v\"=>1.1}]); # => [200,\"OK\",undef]"
NSQ_SOURCE_LINE 00000113 " strip_riap_stuffs_from_res([200,\"OK\",undef,{\"riap.foo\"=>1}]); # => [501, \"Unknown Riap attribute in result metadata: riap.foo\"]"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 " insert_riap_stuffs_to_res([200,\"OK\",undef); # => [200,\"OK\",undef,{\"riap.v\"=>1.1}]"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 " decode_args_in_riap_req({v=>1.2, args=>{\"a:base64\"=>\"AAAA\"}}); # => {v=>1.2, args=>{a=>\"\\0\\0\\0\"}}"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "=head2 insert_riap_stuffs_to_res($envres[, $def_ver, $nmeta, $decode]) => array"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "Starting in Riap protocol v1.2, server is required to return C<riap.v> in result"
NSQ_SOURCE_LINE 00000126 "metadata. This routine does just that. In addition to that, this routine also"
NSQ_SOURCE_LINE 00000127 "encodes result with base64 when necessary."
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "This routine is used by Riap network server libraries, e.g."
NSQ_SOURCE_LINE 00000130 "L<Perinci::Access::HTTP::Server> and L<Perinci::Access::Simple::Server>."
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "=head2 strip_riap_stuffs_from_res($envres) => array"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "Starting in Riap protocol v1.2, client is required to check and strip all"
NSQ_SOURCE_LINE 00000135 "C<riap.*> keys in result metadata (C<< $envres->[3] >>). This routine does just"
NSQ_SOURCE_LINE 00000136 "that. In addition, this routine also decode result if C<riap.result_encoding> is"
NSQ_SOURCE_LINE 00000137 "set, so the user already gets the decoded content."
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "This routine is used by Riap client libraries, e.g. L<Perinci::Access::Lite>,"
NSQ_SOURCE_LINE 00000140 "L<Perinci::Access::Perl>, and L<Perinci::Access::HTTP::Client>,"
NSQ_SOURCE_LINE 00000141 "L<Perinci::Access::Simple::Client>."
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "If there is no error, will return C<$envres> with all C<riap.*> keys already"
NSQ_SOURCE_LINE 00000144 "stripped. If there is an error, an error response will be returned instead."
NSQ_SOURCE_LINE 00000145 "Either way, you can use the response returned by this function to user."
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "=head2 decode_args_in_riap_req($req) => $req"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "Replace C<ARGNAME:base64> keys in C<arg> in Riap request C<$req> with their"
NSQ_SOURCE_LINE 00000150 "decoded values. Only done when C<v> key is at least 1.2."
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "This routine is used in Riap server libraries like in"
NSQ_SOURCE_LINE 00000153 "L<Perinci::Access::HTTP::Server> and Perinci::Access::Simple::Server::*."
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "L<Riap>, L<Perinci::Access>."
NSQ_SOURCE_LINE 00000158 ""
