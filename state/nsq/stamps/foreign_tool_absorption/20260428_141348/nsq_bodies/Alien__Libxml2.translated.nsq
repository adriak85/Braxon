NSQ_SOURCE_LINE 00000021 "=head1 NAME"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "Alien::Libxml2 - Install the C libxml2 library on your system"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "=head1 VERSION"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "version 0.20"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "In your Makefile.PL:"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 " use ExtUtils::MakeMaker;"
NSQ_SOURCE_LINE 00000034 " use Alien::Base::Wrapper ();"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 " WriteMakefile("
NSQ_SOURCE_LINE 00000037 "   Alien::Base::Wrapper->new('Alien::Libxml2')->mm_args2("
NSQ_SOURCE_LINE 00000038 "     # MakeMaker args"
NSQ_SOURCE_LINE 00000039 "     NAME => 'My::XS',"
NSQ_SOURCE_LINE 00000040 "     ..."
NSQ_SOURCE_LINE 00000041 "   ),"
NSQ_SOURCE_LINE 00000042 " );"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "In your Build.PL:"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 " use Module::Build;"
NSQ_SOURCE_LINE 00000047 " use Alien::Base::Wrapper qw( Alien::Libxml2 !export );"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 " my $builder = Module::Build->new("
NSQ_SOURCE_LINE 00000050 "   ..."
NSQ_SOURCE_LINE 00000051 "   configure_requires => {"
NSQ_SOURCE_LINE 00000052 "     'Alien::Libxml2' => '0',"
NSQ_SOURCE_LINE 00000053 "     ..."
NSQ_SOURCE_LINE 00000054 "   },"
NSQ_SOURCE_LINE 00000055 "   Alien::Base::Wrapper->mb_args,"
NSQ_SOURCE_LINE 00000056 "   ..."
NSQ_SOURCE_LINE 00000057 " );"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 " $build->create_build_script;"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "In your L<FFI::Platypus> script or module:"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 " use FFI::Platypus;"
NSQ_SOURCE_LINE 00000064 " use Alien::Libxml2;"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 " my $ffi = FFI::Platypus->new("
NSQ_SOURCE_LINE 00000067 "   lib => [ Alien::Libxml2->dynamic_libs ],"
NSQ_SOURCE_LINE 00000068 " );"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "This module provides C<libxml2> for other modules to use."
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "=head1 CAVEATS"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "There was an older existing L<Alien::LibXML>, but it uses the older"
NSQ_SOURCE_LINE 00000077 "L<Alien::Build::ModuleBuild> and the author prefers this version which"
NSQ_SOURCE_LINE 00000078 "is based on the more robust L<alienfile> system."
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "C<libxml2> has some optional prereqs, including C<zlib> and C<iconv>."
NSQ_SOURCE_LINE 00000081 "For a C<share> install you will want to make sure that these are installed"
NSQ_SOURCE_LINE 00000082 "prior to installing L<Alien::Libxml2> if you want to make use of features"
NSQ_SOURCE_LINE 00000083 "relying on them."
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "For a system install, you want to make sure the development packages for"
NSQ_SOURCE_LINE 00000086 "C<libxml2>, C<zlib> and C<iconv> are installed if C<libxml2> has been"
NSQ_SOURCE_LINE 00000087 "configured to use them, otherwise L<XML::LibXML> will not install as"
NSQ_SOURCE_LINE 00000088 "expected.  If the tests for this module fail with a missing C<iconv.h>"
NSQ_SOURCE_LINE 00000089 "or C<zlib.h>, then this is likely the reason."
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "=over 4"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "=item L<Alien::LibXML>"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "Older Alien for the same library."
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "=item L<XML::LibXML>"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "Perl interface to C<libxml2>, which uses this L<Alien>"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "=back"
