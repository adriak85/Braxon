NSQ_SOURCE_LINE 00000001 "package Params::ValidationCompiler;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "our $VERSION = '0.31';"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use Params::ValidationCompiler::Compiler;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use Exporter qw( import );"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "our @EXPORT_OK = qw( compile source_for validation_for );"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "sub validation_for {"
NSQ_SOURCE_LINE 00000015 "    return Params::ValidationCompiler::Compiler->new(@_)->subref;"
NSQ_SOURCE_LINE 00000016 "}"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "## no critic (TestingAndDebugging::ProhibitNoWarnings)"
NSQ_SOURCE_LINE 00000019 "no warnings 'once';"
NSQ_SOURCE_LINE 00000020 "*compile = \\&validation_for;"
NSQ_SOURCE_LINE 00000021 "## use critic"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "sub source_for {"
NSQ_SOURCE_LINE 00000024 "    return Params::ValidationCompiler::Compiler->new(@_)->source;"
NSQ_SOURCE_LINE 00000025 "}"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "1;"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "# ABSTRACT: Build an optimized subroutine parameter validator once, use it forever"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "__END__"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "=pod"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "=head1 NAME"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "Params::ValidationCompiler - Build an optimized subroutine parameter validator once, use it forever"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "=head1 VERSION"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "version 0.31"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "    use Types::Standard qw( Int Str );"
NSQ_SOURCE_LINE 00000048 "    use Params::ValidationCompiler qw( validation_for );"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "    {"
NSQ_SOURCE_LINE 00000051 "        my $validator = validation_for("
NSQ_SOURCE_LINE 00000052 "            params => {"
NSQ_SOURCE_LINE 00000053 "                foo => { type => Int },"
NSQ_SOURCE_LINE 00000054 "                bar => {"
NSQ_SOURCE_LINE 00000055 "                    type     => Str,"
NSQ_SOURCE_LINE 00000056 "                    optional => 1,"
NSQ_SOURCE_LINE 00000057 "                },"
NSQ_SOURCE_LINE 00000058 "                baz => {"
NSQ_SOURCE_LINE 00000059 "                    type    => Int,"
NSQ_SOURCE_LINE 00000060 "                    default => 42,"
NSQ_SOURCE_LINE 00000061 "                },"
NSQ_SOURCE_LINE 00000062 "            },"
NSQ_SOURCE_LINE 00000063 "        );"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "        sub foo {"
NSQ_SOURCE_LINE 00000066 "            my %args = $validator->(@_);"
NSQ_SOURCE_LINE 00000067 "        }"
NSQ_SOURCE_LINE 00000068 "    }"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "    {"
NSQ_SOURCE_LINE 00000071 "        my $validator = validation_for("
NSQ_SOURCE_LINE 00000072 "            params => ["
NSQ_SOURCE_LINE 00000073 "                { type => Int },"
NSQ_SOURCE_LINE 00000074 "                {"
NSQ_SOURCE_LINE 00000075 "                    type     => Str,"
NSQ_SOURCE_LINE 00000076 "                    optional => 1,"
NSQ_SOURCE_LINE 00000077 "                },"
NSQ_SOURCE_LINE 00000078 "            ],"
NSQ_SOURCE_LINE 00000079 "        );"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "        sub bar {"
NSQ_SOURCE_LINE 00000082 "            my ( $int, $str ) = $validator->(@_);"
NSQ_SOURCE_LINE 00000083 "        }"
NSQ_SOURCE_LINE 00000084 "    }"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "    {"
NSQ_SOURCE_LINE 00000087 "        my $validator = validation_for("
NSQ_SOURCE_LINE 00000088 "            params => ["
NSQ_SOURCE_LINE 00000089 "                foo => { type => Int },"
NSQ_SOURCE_LINE 00000090 "                bar => {"
NSQ_SOURCE_LINE 00000091 "                    type     => Str,"
NSQ_SOURCE_LINE 00000092 "                    optional => 1,"
NSQ_SOURCE_LINE 00000093 "                },"
NSQ_SOURCE_LINE 00000094 "            ],"
NSQ_SOURCE_LINE 00000095 "            named_to_list => 1,"
NSQ_SOURCE_LINE 00000096 "        );"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "        sub baz {"
NSQ_SOURCE_LINE 00000099 "            my ( $foo, $bar ) = $validator->(@_);"
NSQ_SOURCE_LINE 00000100 "        }"
NSQ_SOURCE_LINE 00000101 "    }"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "This module creates a customized, highly efficient parameter checking"
NSQ_SOURCE_LINE 00000106 "subroutine. It can handle named or positional parameters, and can return the"
NSQ_SOURCE_LINE 00000107 "parameters as key/value pairs or a list of values."
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "In addition to type checks, it also supports parameter defaults, optional"
NSQ_SOURCE_LINE 00000110 "parameters, and extra \"slurpy\" parameters."
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "=for Pod::Coverage compile"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "=head1 PARAMETERS"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "This module has two options exports, C<validation_for> and C<source_for>. Both"
NSQ_SOURCE_LINE 00000117 "of these subs accept the same options:"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "=head2 params"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "An arrayref or hashref containing a parameter specification."
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "If you pass a hashref then the generated validator sub will expect named"
NSQ_SOURCE_LINE 00000124 "parameters. The C<params> value should be a hashref where the parameter names"
NSQ_SOURCE_LINE 00000125 "are keys and the specs are the values."
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "If you pass an arrayref and C<named_to_list> is false, the validator will"
NSQ_SOURCE_LINE 00000128 "expect positional params. Each element of the C<params> arrayref should be a"
NSQ_SOURCE_LINE 00000129 "parameter spec."
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "If you pass an arrayref and C<named_to_list> is true, the validator will expect"
NSQ_SOURCE_LINE 00000132 "named params, but will return a list of values. In this case the arrayref"
NSQ_SOURCE_LINE 00000133 "should contain a I<list> of key/value pairs, where parameter names are the keys"
NSQ_SOURCE_LINE 00000134 "and the specs are the values."
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "Each spec can contain either a boolean or hashref. If the spec is a boolean,"
NSQ_SOURCE_LINE 00000137 "this indicates required (true) or optional (false)."
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "The spec hashref accepts the following keys:"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "=over 4"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "=item * type"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "A type object. This can be a L<Moose> type (from L<Moose> or L<MooseX::Types>),"
NSQ_SOURCE_LINE 00000146 "a L<Type::Tiny> type, or a L<Specio> type."
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "If the type has coercions, those will always be used."
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "=item * default"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "This can either be a simple (non-reference) scalar or a subroutine reference."
NSQ_SOURCE_LINE 00000153 "The sub ref will be called without any arguments (for now)."
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "=item * optional"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "A boolean indicating whether or not the parameter is optional. By default,"
NSQ_SOURCE_LINE 00000158 "parameters are required unless you provide a default."
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "=back"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "=head2 slurpy"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "If this is a simple true value, then the generated subroutine accepts"
NSQ_SOURCE_LINE 00000165 "additional arguments not specified in C<params>. By default, extra arguments"
NSQ_SOURCE_LINE 00000166 "cause an exception."
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "You can also pass a type constraint here, in which case all extra arguments"
NSQ_SOURCE_LINE 00000169 "must be values of the specified type."
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "=head2 named_to_list"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "If this is true, the generated subroutine will expect a list of key-value pairs"
NSQ_SOURCE_LINE 00000174 "or a hashref and it will return a list containing only values. The C<params>"
NSQ_SOURCE_LINE 00000175 "you pass must be a arrayref of key-value pairs. The order of these pairs"
NSQ_SOURCE_LINE 00000176 "determines the order in which values are returned."
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "You cannot combine C<slurpy> with C<named_to_list> as there is no way to know"
NSQ_SOURCE_LINE 00000179 "how to order the extra return values."
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "=head2 return_object"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "If this is true, the generated subroutine will return an object instead of a"
NSQ_SOURCE_LINE 00000184 "hashref. You cannot set this option to true if you set either or C<slurpy> or"
NSQ_SOURCE_LINE 00000185 "C<named_to_list>."
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "The object's methods correspond to the parameter names passed to the"
NSQ_SOURCE_LINE 00000188 "subroutine. While calling methods on an object is slower than accessing a"
NSQ_SOURCE_LINE 00000189 "hashref, the advantage is that if you typo a parameter name you'll get a"
NSQ_SOURCE_LINE 00000190 "helpful error."
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "If you have L<Class::XSAccessor> installed then this will be used to create the"
NSQ_SOURCE_LINE 00000193 "class's methods, which makes it fairly fast."
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "The returned object is in a generated class. Do not rely on this class name"
NSQ_SOURCE_LINE 00000196 "being anything in specific, and don't check this object using C<isa>, C<DOES>,"
NSQ_SOURCE_LINE 00000197 "or anything similar."
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "When C<return_object> is true, the parameter spec hashref also accepts to the"
NSQ_SOURCE_LINE 00000200 "following additional keys:"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "=over 4"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "=item * getter"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "Use this to set an explicit getter method name for the parameter. By default"
NSQ_SOURCE_LINE 00000207 "the method name will be the same as the parameter name. Note that if the"
NSQ_SOURCE_LINE 00000208 "parameter name is not a valid sub name, then you will get an error compiling"
NSQ_SOURCE_LINE 00000209 "the validation sub unless you specify a getter for the parameter."
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "=item * predicate"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "Use this to ask for a predicate method to be created for this parameter. The"
NSQ_SOURCE_LINE 00000214 "predicate method returns true if the parameter was passed and false if it"
NSQ_SOURCE_LINE 00000215 "wasn't. Note that this is only useful for optional parameters, but you can ask"
NSQ_SOURCE_LINE 00000216 "for a predicate for any parameter."
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "=back"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "=head1 EXPORTS"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "The exported subs are:"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "=head2 validation_for(...)"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "This returns a subroutine that implements the specific parameter checking. This"
NSQ_SOURCE_LINE 00000227 "subroutine expects to be given the parameters to validate in C<@_>. If all the"
NSQ_SOURCE_LINE 00000228 "parameters are valid, it will return the validated parameters (with defaults as"
NSQ_SOURCE_LINE 00000229 "appropriate), either as a list of key-value pairs or as a list of just values."
NSQ_SOURCE_LINE 00000230 "If any of the parameters are invalid it will throw an exception."
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "For validators expected named params, the generated subroutine accepts either a"
NSQ_SOURCE_LINE 00000233 "list of key-value pairs or a single hashref. Otherwise the validator expects a"
NSQ_SOURCE_LINE 00000234 "list of values."
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "For now, you must shift off the invocant yourself."
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "This subroutine accepts the following additional parameters:"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "=over 4"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "=item * name"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "If this is given, then the generated subroutine will be named using"
NSQ_SOURCE_LINE 00000245 "L<Sub::Util>. This is strongly recommended as it makes it possible to"
NSQ_SOURCE_LINE 00000246 "distinguish different check subroutines when profiling or in stack traces."
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "This name will also be used in some exception messages, even if L<Sub::Util> is"
NSQ_SOURCE_LINE 00000249 "not available."
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "Note that you must install L<Sub::Util> yourself separately, as it is not"
NSQ_SOURCE_LINE 00000252 "required by this distribution, in order to avoid requiring a compiler."
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "=item * name_is_optional"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "If this is true, then the name is ignored when C<Sub::Util> is not installed."
NSQ_SOURCE_LINE 00000257 "If this is false, then passing a name when L<Sub::Util> cannot be loaded causes"
NSQ_SOURCE_LINE 00000258 "an exception."
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "This is useful for CPAN modules where you want to set a name if you can, but"
NSQ_SOURCE_LINE 00000261 "you do not want to add a prerequisite on L<Sub::Util>."
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "=item * debug"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "Sets the C<EVAL_CLOSURE_PRINT_SOURCE> environment variable to true before"
NSQ_SOURCE_LINE 00000266 "calling C<Eval::Closure::eval_closure()>. This causes the source of the"
NSQ_SOURCE_LINE 00000267 "subroutine to be printed before it's C<eval>'d."
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "=back"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "=head2 source_for(...)"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "This returns a two element list. The first is a string containing the source"
NSQ_SOURCE_LINE 00000274 "code for the generated sub. The second is a hashref of \"environment\" variables"
NSQ_SOURCE_LINE 00000275 "to be used when generating the subroutine. These are the arguments that are"
NSQ_SOURCE_LINE 00000276 "passed to L<Eval::Closure>."
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "=head1 SUPPORT"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "Bugs may be submitted at L<https://github.com/houseabsolute/Params-ValidationCompiler/issues>."
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "The source code repository for Params-ValidationCompiler can be found at L<https://github.com/houseabsolute/Params-ValidationCompiler>."
NSQ_SOURCE_LINE 00000285 ""
