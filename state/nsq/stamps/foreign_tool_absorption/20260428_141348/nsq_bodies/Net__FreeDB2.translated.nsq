NSQ_SOURCE_LINE 00000001 "package Net::FreeDB2;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "# Copyright 2002, Vincenzo Zocca."
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "# See LICENSE section for usage and distribution rights."
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "require 5.005_62;"
NSQ_SOURCE_LINE 00000008 "use strict;"
NSQ_SOURCE_LINE 00000009 "use warnings;"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "require Exporter;"
NSQ_SOURCE_LINE 00000012 "use AutoLoader qw(AUTOLOAD);"
NSQ_SOURCE_LINE 00000013 "use Error qw (:try);"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "our @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "# Items to export into callers namespace by default. Note: do not export"
NSQ_SOURCE_LINE 00000018 "# names by default without a very good reason. Use EXPORT_OK instead."
NSQ_SOURCE_LINE 00000019 "# Do not simply export all your public functions/methods/constants."
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "# This allows declaration\tuse Net::FreeDB2 ':all';"
NSQ_SOURCE_LINE 00000022 "# If you do not need this, moving things directly into @EXPORT or @EXPORT_OK"
NSQ_SOURCE_LINE 00000023 "# will save memory."
NSQ_SOURCE_LINE 00000024 "our %EXPORT_TAGS = ( 'all' => [ qw("
NSQ_SOURCE_LINE 00000025 "\t"
NSQ_SOURCE_LINE 00000026 ") ] );"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "our @EXPORT_OK = ( @{ $EXPORT_TAGS{'all'} } );"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "our @EXPORT = qw("
NSQ_SOURCE_LINE 00000031 "\t"
NSQ_SOURCE_LINE 00000032 ");"
NSQ_SOURCE_LINE 00000033 "our ( $VERSION ) = '$Revision: 0.8.2.6 $ ' =~ /\\$Revision:\\s+([^\\s]+)/;"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "sub connection {"
NSQ_SOURCE_LINE 00000036 "\t# Allow both styles Net::FreeDB2->connection and Net::FreeDB2::connection"
NSQ_SOURCE_LINE 00000037 "\t$_[0] eq 'Net::FreeDB2' && shift;"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "\t# Get options"
NSQ_SOURCE_LINE 00000040 "\tmy $opt;"
NSQ_SOURCE_LINE 00000041 "\tif (ref ($_[0]) eq 'HASH') {"
NSQ_SOURCE_LINE 00000042 "\t\t$opt = shift;"
NSQ_SOURCE_LINE 00000043 "\t} else {"
NSQ_SOURCE_LINE 00000044 "\t\t$opt = {};"
NSQ_SOURCE_LINE 00000045 "\t\tforeach my $av (split (/\\s*;+\\s*/, shift)) {"
NSQ_SOURCE_LINE 00000046 "\t\t\tmy ($a, $v) = split (/\\s*=\\s*/, $av);"
NSQ_SOURCE_LINE 00000047 "\t\t\t$a && $v || next;"
NSQ_SOURCE_LINE 00000048 "\t\t\t$opt->{$a} = $v;"
NSQ_SOURCE_LINE 00000049 "\t\t}"
NSQ_SOURCE_LINE 00000050 "\t}"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "\tif (defined ($opt->{protocol}) && $opt->{protocol} eq 'CDDBP') {"
NSQ_SOURCE_LINE 00000053 "\t\trequire Net::FreeDB2::Connection::CDDBP;"
NSQ_SOURCE_LINE 00000054 "\t\timport Net::FreeDB2::Connection::CDDBP;"
NSQ_SOURCE_LINE 00000055 "\t\treturn (Net::FreeDB2::Connection::CDDBP->new ($opt));"
NSQ_SOURCE_LINE 00000056 "\t} else {"
NSQ_SOURCE_LINE 00000057 "\t\trequire Net::FreeDB2::Connection::HTTP;"
NSQ_SOURCE_LINE 00000058 "\t\timport Net::FreeDB2::Connection::HTTP;"
NSQ_SOURCE_LINE 00000059 "\t\treturn (Net::FreeDB2::Connection::HTTP->new ($opt));"
NSQ_SOURCE_LINE 00000060 "\t}"
NSQ_SOURCE_LINE 00000061 "}"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "1;"
NSQ_SOURCE_LINE 00000065 "__END__"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "=head1 NAME"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "Net::FreeDB2 - FreeDB generic connection class"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 " # quick and dirty CD ripper"
NSQ_SOURCE_LINE 00000074 " "
NSQ_SOURCE_LINE 00000075 " use strict;"
NSQ_SOURCE_LINE 00000076 " "
NSQ_SOURCE_LINE 00000077 " # Make device name"
NSQ_SOURCE_LINE 00000078 " use Getopt::Std;"
NSQ_SOURCE_LINE 00000079 " $::opt_d = '';"
NSQ_SOURCE_LINE 00000080 " getopts ('d:');"
NSQ_SOURCE_LINE 00000081 " my $dev = $::opt_d || '/dev/cdrom';"
NSQ_SOURCE_LINE 00000082 " "
NSQ_SOURCE_LINE 00000083 " # Make a Net::FreeDB2::connection"
NSQ_SOURCE_LINE 00000084 " use Net::FreeDB2;"
NSQ_SOURCE_LINE 00000085 " my $conn = Net::FreeDB2->connection ({"
NSQ_SOURCE_LINE 00000086 " \tclient_name => 'quickrip',"
NSQ_SOURCE_LINE 00000087 " \tclient_version => '1.0',"
NSQ_SOURCE_LINE 00000088 " });"
NSQ_SOURCE_LINE 00000089 " "
NSQ_SOURCE_LINE 00000090 " # Create a Net::FreeDB2::Entry object with the information in it from the CD"
NSQ_SOURCE_LINE 00000091 " # in $dev"
NSQ_SOURCE_LINE 00000092 " use Net::FreeDB2::Entry;"
NSQ_SOURCE_LINE 00000093 " my $entry = Net::FreeDB2::Entry->new ({dev => $dev});"
NSQ_SOURCE_LINE 00000094 " "
NSQ_SOURCE_LINE 00000095 " # Query the FreeDB/CDDB database"
NSQ_SOURCE_LINE 00000096 " my $res = $conn->query ($entry);"
NSQ_SOURCE_LINE 00000097 " $res->hasError () && die ('Oops, error quering FreeDB');"
NSQ_SOURCE_LINE 00000098 " "
NSQ_SOURCE_LINE 00000099 " # Check for matches"
NSQ_SOURCE_LINE 00000100 " if (! scalar ($res->getMatches ())) {"
NSQ_SOURCE_LINE 00000101 " \twarn ('No matches found');"
NSQ_SOURCE_LINE 00000102 " \texit (0);"
NSQ_SOURCE_LINE 00000103 " }"
NSQ_SOURCE_LINE 00000104 " "
NSQ_SOURCE_LINE 00000105 " # Get the first match"
NSQ_SOURCE_LINE 00000106 " my $match = ($res->getMatches ())[0];"
NSQ_SOURCE_LINE 00000107 " "
NSQ_SOURCE_LINE 00000108 " # Read the match into an entry"
NSQ_SOURCE_LINE 00000109 " my $res = $conn->read ($match);"
NSQ_SOURCE_LINE 00000110 " $res->hasError () && die ('Oops, error reading FreeDB');"
NSQ_SOURCE_LINE 00000111 " my $entry = $res->getEntry ();"
NSQ_SOURCE_LINE 00000112 " "
NSQ_SOURCE_LINE 00000113 " # Make cdparanoia commands to rip the tracks"
NSQ_SOURCE_LINE 00000114 " my $tracks = scalar ($entry->getFrameOffset ());"
NSQ_SOURCE_LINE 00000115 " my @cmd = qw (cdparanoia);"
NSQ_SOURCE_LINE 00000116 " push (@cmd, '-d', $dev);"
NSQ_SOURCE_LINE 00000117 " push (@cmd, '-B');"
NSQ_SOURCE_LINE 00000118 " for (my $i = 1; $i <= $tracks; $i++) {"
NSQ_SOURCE_LINE 00000119 " \tmy $title = $entry->getTtitlen ($i);"
NSQ_SOURCE_LINE 00000120 " \t$title =~ s/\\s+/-/g;"
NSQ_SOURCE_LINE 00000121 " \tmy @cmd = (@cmd, $i);"
NSQ_SOURCE_LINE 00000122 " "
NSQ_SOURCE_LINE 00000123 " \t# Execute command"
NSQ_SOURCE_LINE 00000124 " \tprint STDERR \"@cmd\\n\";"
NSQ_SOURCE_LINE 00000125 " \tsystem (@cmd);"
NSQ_SOURCE_LINE 00000126 " \tdie ('Oops, command failed') if ($?>>8);"
NSQ_SOURCE_LINE 00000127 " "
NSQ_SOURCE_LINE 00000128 " \t# Rename output file"
NSQ_SOURCE_LINE 00000129 " \tmy $src = sprintf (\"track%02d.cdda.wav\", $i);"
NSQ_SOURCE_LINE 00000130 " \tmy $dest = sprintf (\"%02d-%s.wav\", $i, $title);"
NSQ_SOURCE_LINE 00000131 " \tprint STDERR \"mv $src $dest\\n\";"
NSQ_SOURCE_LINE 00000132 " \trename ($src, $dest);"
NSQ_SOURCE_LINE 00000133 " }"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "C<Net::FreeDB2> is another FreeDB/CDDB access class hierarchy. The basics are similar to the other FreeDB/CDDB Perl modules."
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "However, in the writers opinion, the details differ enough for it to have a certain right of existance. It's organization is inspired by C<Net::LDAP>."
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "=over Information is captured into sensible objects."
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "=item Net::FreeDB"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "FreeDB/CDDB connection factory."
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "=item Net::FreeDB2::Connection"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "Abstract connection"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "=item Net::FreeDB2::Connection::HTTP"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "Concrete connection for the HTTP protocol"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "=item Net::FreeDB2::Connection::CDDBP"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "Concrete connection for the CDDBP protocol"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "=item Net::FreeDB2::Entry"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "A FreeDB/CDDB entry. Can be read/written from/to a FreeDB/CDDB connection or a file."
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "=item Net::FreeDB2::Match"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "Match obtained from a FreeDB/CDDB query comand"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "=item Net::FreeDB2::Site"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "Site obtained from a FreeDB/CDDB sites command"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "=item Net::FreeDB2::Response*"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "Responses from FreeDB/CDDB commands"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "=back"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "=head1 CONSTRUCTOR"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "none"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "=head1 METHODS"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "=over"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "=item connection (OPT_HASH_REF || OPT_STRING)"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "Returns an instanciated C<Net::FreeDB2::Connection> object. C<Error::Simple> exceptions generated by instanciated classes are passed through."
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "Allowed/mandatory options for C<OPT_HASH_REF> are:"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "=over"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "=item protocol"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "Protocol to use. Allowed vaulues: C<HTTP> and C<CDDBP>. Defaults to C<HTTP>. C<HTTP> causes a C<Net::FreeDB2::Connection::HTTP> object to be instanciated. C<CDDBP> causes a C<Net::FreeDB2::Connection::CDDBP> object to be instanciated."
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "=item client_name"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "Mandatory option to name the connecting client software."
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "=item client_version"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "Mandatory option with the client software version string."
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "=item client_host"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "The hostname of the client. Defaults to C<&Sys::Hostname::hostname ()>."
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "=item client_user"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "The user of the client. Defaults to C<scalar (getpwuid ($E<gt>))>;"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "=item freedb_host"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "The FreeDB/CDDB host to use (e.g. C<www.freedb.org>). If defined together with C<freedb_cgi> the connection is actually made during costruction."
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "=item freedb_port"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "The port on the FreeDB/CDDB host to use."
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "=item freedb_cgi"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "The FreeDB/CDDB host to use (e.g. C<~cddb/cddb.cgi>). If defined together with C<freedb_host> the connection is actually made during costruction. Only for C<HTTP> protocol. Will not cause error if set for protocol <CDDBP>."
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "=item proxy_host"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "Proxy host to use. Only supported for C<HTTP> protocol. Will not cause error if set for protocol <CDDBP>."
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "=item proxy_port"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "Proxy port to use. Defaults to C<8080>. Only supported for C<HTTP> protocol. Will not cause error if set for protocol <CDDBP>."
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "=item proxy_user"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "Proxy user name to use. Only supported for C<HTTP> protocol. Will not cause error if set for protocol <CDDBP>."
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "=item proxy_passwd"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "Proxy password to use. Only supported for C<HTTP> protocol. Will not cause error if set for protocol <CDDBP>."
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "=back"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "Options are allowed to be passed as strings. In this case, C<OPT_STRING> must be in the format:"
NSQ_SOURCE_LINE 00000244 " <attribute1>=<value1>;<attribute2>=<value2>;..."
NSQ_SOURCE_LINE 00000245 "Example:"
NSQ_SOURCE_LINE 00000246 " client_name=my-client;client_version=0.0.1"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "=back"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "L<Net::FreeDB2::Entry>, L<Net::FreeDB2::Match>, L<Net::FreeDB2::Response>, L<Net::FreeDB2::Response::Query> and L<Net::FreeDB2::Response::Read>"
NSQ_SOURCE_LINE 00000253 ""
