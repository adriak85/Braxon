NSQ_SOURCE_LINE 00000059 "1;"
NSQ_SOURCE_LINE 00000060 "# ABSTRACT: Object-oriented interface for Rinci metadata"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "__END__"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "=pod"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "=head1 NAME"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "Perinci::Object - Object-oriented interface for Rinci metadata"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "=head1 VERSION"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "This document describes version 0.311 of Perinci::Object (from Perl distribution Perinci-Object), released on 2020-01-02."
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 " use Perinci::Object; # automatically exports risub(), rivar(), ripkg(),"
NSQ_SOURCE_LINE 00000079 "                      # envres(), envresmulti(), envrestable(), riresmeta()"
NSQ_SOURCE_LINE 00000080 " use Data::Dump; # for dd()"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 " # OO interface to function metadata."
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 " my $risub = risub {"
NSQ_SOURCE_LINE 00000085 "     v => 1.1,"
NSQ_SOURCE_LINE 00000086 "     summary => 'Calculate foo and bar',"
NSQ_SOURCE_LINE 00000087 "     \"summary.alt.lang.id_ID\" => 'Menghitung foo dan bar',"
NSQ_SOURCE_LINE 00000088 "     args => { a1 => { schema => 'int*' }, a2 => { schema => 'str' } },"
NSQ_SOURCE_LINE 00000089 "     features => { pure=>1 },"
NSQ_SOURCE_LINE 00000090 " };"
NSQ_SOURCE_LINE 00000091 " dd $risub->type,                                 # \"function\""
NSQ_SOURCE_LINE 00000092 "    $risub->v,                                    # 1.1"
NSQ_SOURCE_LINE 00000093 "    $risub->arg('a1'),                            # { schema=>'int*' }"
NSQ_SOURCE_LINE 00000094 "    $risub->arg('a3'),                            # undef"
NSQ_SOURCE_LINE 00000095 "    $risub->feature('pure'),                      # 1"
NSQ_SOURCE_LINE 00000096 "    $risub->feature('foo'),                       # undef"
NSQ_SOURCE_LINE 00000097 "    $risub->langprop('summary'),                  # 'Calculate foo and bar'"
NSQ_SOURCE_LINE 00000098 "    $risub->langprop({lang=>'id_ID'}, 'summary'), # 'Menghitung foo dan bar'"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 " # setting arg and property"
NSQ_SOURCE_LINE 00000101 " $risub->arg('a3', 'array');  # will actually fail for 1.0 metadata"
NSQ_SOURCE_LINE 00000102 " $risub->feature('foo', 2);   # ditto"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 " # OO interface to variable metadata"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 " my $rivar = rivar { ... };"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 " # OO interface to package metadata"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 " my $ripkg = ripkg { ... };"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 " # OO interface to enveloped result"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 " my $envres = envres [200, \"OK\", [1, 2, 3]];"
NSQ_SOURCE_LINE 00000115 " dd $envres->is_success, # 1"
NSQ_SOURCE_LINE 00000116 "    $envres->status,     # 200"
NSQ_SOURCE_LINE 00000117 "    $envres->message,    # \"OK\""
NSQ_SOURCE_LINE 00000118 "    $envres->result,     # [1, 2, 3]"
NSQ_SOURCE_LINE 00000119 "    $envres->meta;       # undef"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 " # setting status, message, result, extra"
NSQ_SOURCE_LINE 00000122 " $envres->status(404);"
NSQ_SOURCE_LINE 00000123 " $envres->message('Not found');"
NSQ_SOURCE_LINE 00000124 " $envres->result(undef);"
NSQ_SOURCE_LINE 00000125 " $envres->meta({errno=>-100});"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 " # OO interface to function/method result metadata"
NSQ_SOURCE_LINE 00000128 " my $riresmeta = riresmeta { ... };"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 " # an example of using envresmulti()"
NSQ_SOURCE_LINE 00000131 " sub myfunc {"
NSQ_SOURCE_LINE 00000132 "     ..."
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "     my $envres = envresmulti();"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "     # add result for each item"
NSQ_SOURCE_LINE 00000137 "     $envres->add_result(200, \"OK\", {item_id=>1, payload=>\"a\"});"
NSQ_SOURCE_LINE 00000138 "     $envres->add_result(202, \"OK\", {item_id=>2, note=>\"blah\", payload=>\"b\"});"
NSQ_SOURCE_LINE 00000139 "     $envres->add_result(404, \"Not found\", {item_id=>3});"
NSQ_SOURCE_LINE 00000140 "     ..."
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "     # finally, return the result"
NSQ_SOURCE_LINE 00000143 "     return $envres->as_struct;"
NSQ_SOURCE_LINE 00000144 " }"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 " # an example of using envrestable()"
NSQ_SOURCE_LINE 00000147 " sub myfunc {"
NSQ_SOURCE_LINE 00000148 "     ..."
NSQ_SOURCE_LINE 00000149 "     my $envres = envrestable();"
NSQ_SOURCE_LINE 00000150 "     $envres->add_field('foo');"
NSQ_SOURCE_LINE 00000151 "     $envres->add_field('bar');"
NSQ_SOURCE_LINE 00000152 "     ..."
NSQ_SOURCE_LINE 00000153 "     return $envres->as_struct;"
NSQ_SOURCE_LINE 00000154 " }"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "L<Rinci> works using pure data structures, but sometimes it's convenient to have"
NSQ_SOURCE_LINE 00000159 "an object-oriented interface (wrapper) for those data. This module provides just"
NSQ_SOURCE_LINE 00000160 "that."
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "=head2 rimeta $meta => OBJECT"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "Exported by default. A shortcut for Perinci::Object::Metadata->new($meta)."
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "=head2 risub $meta => OBJECT"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "Exported by default. A shortcut for Perinci::Object::Function->new($meta)."
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "=head2 rivar $meta => OBJECT"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "Exported by default. A shortcut for Perinci::Object::Variable->new($meta)."
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "=head2 ripkg $meta => OBJECT"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "Exported by default. A shortcut for Perinci::Object::Package->new($meta)."
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "=head2 envres $res => OBJECT"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "Exported by default. A shortcut for Perinci::Object::EnvResult->new($res)."
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "=head2 envresmulti $res => OBJECT"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "Exported by default. A shortcut for Perinci::Object::EnvResultMulti->new($res)."
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "=head2 envrestable $res => OBJECT"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "Exported by default. A shortcut for Perinci::Object::EnvResultTable->new($res)."
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "=head2 riresmeta $resmeta => OBJECT"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "Exported by default. A shortcut for Perinci::Object::ResMeta->new($res)."
NSQ_SOURCE_LINE 00000195 ""
