NSQ_SOURCE_LINE 00000001 "package Data::Printer;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use warnings;"
NSQ_SOURCE_LINE 00000004 "use Data::Printer::Object;"
NSQ_SOURCE_LINE 00000005 "use Data::Printer::Common;"
NSQ_SOURCE_LINE 00000006 "use Data::Printer::Config;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "our $VERSION = '1.002001';"
NSQ_SOURCE_LINE 00000009 "$VERSION = eval $VERSION;"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "my $rc_arguments;"
NSQ_SOURCE_LINE 00000012 "my %arguments_for;"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "sub import {"
NSQ_SOURCE_LINE 00000015 "    my $class = shift;"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "    _initialize();"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "    my $args;"
NSQ_SOURCE_LINE 00000020 "    if (@_ > 0) {"
NSQ_SOURCE_LINE 00000021 "        $args = @_ == 1 ? shift : {@_};"
NSQ_SOURCE_LINE 00000022 "        Data::Printer::Common::_warn("
NSQ_SOURCE_LINE 00000023 "            undef,"
NSQ_SOURCE_LINE 00000024 "            'Data::Printer can receive either a hash or a hash reference'"
NSQ_SOURCE_LINE 00000025 "        ) unless ref $args eq 'HASH';"
NSQ_SOURCE_LINE 00000026 "        $args = Data::Printer::Config::_expand_profile($args)"
NSQ_SOURCE_LINE 00000027 "            if exists $args->{profile};"
NSQ_SOURCE_LINE 00000028 "    }"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "    # every time you load it, we override the version from *your* caller"
NSQ_SOURCE_LINE 00000031 "    my $caller = caller;"
NSQ_SOURCE_LINE 00000032 "    $arguments_for{$caller} = $args;"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "    my $use_prototypes = _find_option('use_prototypes', $args, $caller, 1);"
NSQ_SOURCE_LINE 00000035 "    my $exported = ($use_prototypes ? \\&p : \\&_p_without_prototypes);"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "    my $imported = _find_option('alias', $args, $caller, 'p');"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "    { no strict 'refs';"
NSQ_SOURCE_LINE 00000040 "        *{\"$caller\\::$imported\"} = $exported;"
NSQ_SOURCE_LINE 00000041 "        *{\"$caller\\::np\"}        = \\&np;"
NSQ_SOURCE_LINE 00000042 "    }"
NSQ_SOURCE_LINE 00000043 "}"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "sub _initialize {"
NSQ_SOURCE_LINE 00000046 "    # potential race but worst case is we read it twice :)"
NSQ_SOURCE_LINE 00000047 "    { no warnings 'redefine'; *_initialize = sub {} }"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "    my $rc_filename = Data::Printer::Config::_get_first_rc_file_available();"
NSQ_SOURCE_LINE 00000050 "    $rc_arguments = Data::Printer::Config::load_rc_file($rc_filename);"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "    if ("
NSQ_SOURCE_LINE 00000053 "           exists $rc_arguments->{'_'}{live_update}"
NSQ_SOURCE_LINE 00000054 "        && defined $rc_arguments->{'_'}{live_update}"
NSQ_SOURCE_LINE 00000055 "        && $rc_arguments->{'_'}{live_update} =~ /\\A\\d+\\z/"
NSQ_SOURCE_LINE 00000056 "        && $rc_arguments->{'_'}{live_update} > 0) {"
NSQ_SOURCE_LINE 00000057 "        my $now = time;"
NSQ_SOURCE_LINE 00000058 "        my $last_mod = (stat $rc_filename)[9];"
NSQ_SOURCE_LINE 00000059 "        {"
NSQ_SOURCE_LINE 00000060 "            no warnings 'redefine';"
NSQ_SOURCE_LINE 00000061 "            *_initialize = sub {"
NSQ_SOURCE_LINE 00000062 "                if (time - $now > $rc_arguments->{'_'}{live_update}) {"
NSQ_SOURCE_LINE 00000063 "                    my $new_last_mod = (stat $rc_filename)[9];"
NSQ_SOURCE_LINE 00000064 "                    if (defined $new_last_mod && $new_last_mod > $last_mod) {"
NSQ_SOURCE_LINE 00000065 "                        $now = time;"
NSQ_SOURCE_LINE 00000066 "                        $last_mod = $new_last_mod;"
NSQ_SOURCE_LINE 00000067 "                        $rc_arguments = Data::Printer::Config::load_rc_file($rc_filename);"
NSQ_SOURCE_LINE 00000068 "                        if (!exists $rc_arguments->{'_'}{live_update} || !$rc_arguments->{'_'}{live_update}) {"
NSQ_SOURCE_LINE 00000069 "                            *_initialize = sub {};"
NSQ_SOURCE_LINE 00000070 "                        }"
NSQ_SOURCE_LINE 00000071 "                    }"
NSQ_SOURCE_LINE 00000072 "                }"
NSQ_SOURCE_LINE 00000073 "            };"
NSQ_SOURCE_LINE 00000074 "        }"
NSQ_SOURCE_LINE 00000075 "    }"
NSQ_SOURCE_LINE 00000076 "}"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "sub np (\\[@$%&];%) {"
NSQ_SOURCE_LINE 00000079 "    my (undef, %properties) = @_;"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "    _initialize();"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "    my $caller = caller;"
NSQ_SOURCE_LINE 00000084 "    my $args_to_use = _fetch_args_with($caller, \\%properties);"
NSQ_SOURCE_LINE 00000085 "    return '' if $args_to_use->{quiet};"
NSQ_SOURCE_LINE 00000086 "    my $printer = Data::Printer::Object->new($args_to_use);"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "    # force color level 0 on 'auto' colors:"
NSQ_SOURCE_LINE 00000089 "    if ($printer->colored eq 'auto') {"
NSQ_SOURCE_LINE 00000090 "        $printer->{_output_color_level} = 0;"
NSQ_SOURCE_LINE 00000091 "    }"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "    my $ref = ref $_[0];"
NSQ_SOURCE_LINE 00000094 "    if ($ref eq 'ARRAY' || $ref eq 'HASH' || ($ref eq 'REF' && ref ${$_[0]} eq 'REF')) {"
NSQ_SOURCE_LINE 00000095 "        $printer->{_refcount_base}++;"
NSQ_SOURCE_LINE 00000096 "    }"
NSQ_SOURCE_LINE 00000097 "    my $output = $printer->parse($_[0]);"
NSQ_SOURCE_LINE 00000098 "    if ($printer->caller_message_position eq 'after') {"
NSQ_SOURCE_LINE 00000099 "        $output .= $printer->_write_label;"
NSQ_SOURCE_LINE 00000100 "    }"
NSQ_SOURCE_LINE 00000101 "    else {"
NSQ_SOURCE_LINE 00000102 "        $output = $printer->_write_label . $output;"
NSQ_SOURCE_LINE 00000103 "    }"
NSQ_SOURCE_LINE 00000104 "    return $output;"
NSQ_SOURCE_LINE 00000105 "}"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "sub p (\\[@$%&];%) {"
NSQ_SOURCE_LINE 00000109 "    my (undef, %properties) = @_;"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "    _initialize();"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "    my $caller = caller;"
NSQ_SOURCE_LINE 00000114 "    my $args_to_use = _fetch_args_with($caller, \\%properties);"
NSQ_SOURCE_LINE 00000115 "    my $want_value = defined wantarray;"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "    # return as quickly as possible under 'quiet'."
NSQ_SOURCE_LINE 00000118 "    if ($args_to_use->{quiet}) {"
NSQ_SOURCE_LINE 00000119 "        # we avoid creating a Data::Printer::Object instance"
NSQ_SOURCE_LINE 00000120 "        # to speed things up, since we don't do anything under 'quiet'."
NSQ_SOURCE_LINE 00000121 "        my $return_type = Data::Printer::Common::_fetch_anyof("
NSQ_SOURCE_LINE 00000122 "            $args_to_use, 'return_value', 'pass', [qw(pass dump void)]"
NSQ_SOURCE_LINE 00000123 "        );"
NSQ_SOURCE_LINE 00000124 "        return _handle_output(undef, undef, $want_value, $_[0], $return_type, 1);"
NSQ_SOURCE_LINE 00000125 "    }"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "    my $printer = Data::Printer::Object->new($args_to_use);"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "    if ($printer->colored eq 'auto' && $printer->return_value eq 'dump' && $want_value) {"
NSQ_SOURCE_LINE 00000130 "        $printer->{_output_color_level} = 0;"
NSQ_SOURCE_LINE 00000131 "    }"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "    my $ref = ref $_[0];"
NSQ_SOURCE_LINE 00000134 "    if ($ref eq 'ARRAY' || $ref eq 'HASH' || ($ref eq 'REF' && ref ${$_[0]} eq 'REF')) {"
NSQ_SOURCE_LINE 00000135 "        $printer->{_refcount_base}++;"
NSQ_SOURCE_LINE 00000136 "    }"
NSQ_SOURCE_LINE 00000137 "    my $output = $printer->parse($_[0]);"
NSQ_SOURCE_LINE 00000138 "    if ($printer->caller_message_position eq 'after') {"
NSQ_SOURCE_LINE 00000139 "        $output .= $printer->_write_label;"
NSQ_SOURCE_LINE 00000140 "    }"
NSQ_SOURCE_LINE 00000141 "    else {"
NSQ_SOURCE_LINE 00000142 "        $output = $printer->_write_label . $output;"
NSQ_SOURCE_LINE 00000143 "    }"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "    return _handle_output($output, $printer->{output_handle}, $want_value, $_[0], $printer->return_value, undef);"
NSQ_SOURCE_LINE 00000146 "}"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "# This is a p() clone without prototypes. Just like regular Data::Dumper,"
NSQ_SOURCE_LINE 00000149 "# this version expects a reference as its first argument. We make a single"
NSQ_SOURCE_LINE 00000150 "# exception for when we only get one argument, in which case we ref it"
NSQ_SOURCE_LINE 00000151 "# for the user and keep going."
NSQ_SOURCE_LINE 00000152 "sub _p_without_prototypes  {"
NSQ_SOURCE_LINE 00000153 "    my (undef, %properties) = @_;"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "    my $item;"
NSQ_SOURCE_LINE 00000156 "    if (!ref $_[0] && @_ == 1) {"
NSQ_SOURCE_LINE 00000157 "        my $item_value = $_[0];"
NSQ_SOURCE_LINE 00000158 "        $item = \\$item_value;"
NSQ_SOURCE_LINE 00000159 "    }"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "    _initialize();"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "    my $caller = caller;"
NSQ_SOURCE_LINE 00000164 "    my $args_to_use = _fetch_args_with($caller, \\%properties);"
NSQ_SOURCE_LINE 00000165 "    my $want_value = defined wantarray;"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "    # return as quickly as possible under 'quiet'."
NSQ_SOURCE_LINE 00000168 "    if ($args_to_use->{quiet}) {"
NSQ_SOURCE_LINE 00000169 "        # we avoid creating a Data::Printer::Object instance"
NSQ_SOURCE_LINE 00000170 "        # to speed things up, since we don't do anything under 'quiet'."
NSQ_SOURCE_LINE 00000171 "        my $return_type = Data::Printer::Common::_fetch_anyof("
NSQ_SOURCE_LINE 00000172 "            $args_to_use, 'return_value', 'pass', [qw(pass dump void)]"
NSQ_SOURCE_LINE 00000173 "        );"
NSQ_SOURCE_LINE 00000174 "        return _handle_output(undef, undef, $want_value, $_[0], $return_type, 1);"
NSQ_SOURCE_LINE 00000175 "    }"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "    my $printer = Data::Printer::Object->new($args_to_use);"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "    if ($printer->colored eq 'auto' && $printer->return_value eq 'dump' && $want_value) {"
NSQ_SOURCE_LINE 00000180 "        $printer->{_output_color_level} = 0;"
NSQ_SOURCE_LINE 00000181 "    }"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "    my $ref = ref( defined $item ? $item : $_[0] );"
NSQ_SOURCE_LINE 00000184 "    if ($ref eq 'ARRAY' || $ref eq 'HASH' || ($ref eq 'REF'"
NSQ_SOURCE_LINE 00000185 "        && ref(defined $item ? $item : ${$_[0]}) eq 'REF')) {"
NSQ_SOURCE_LINE 00000186 "        $printer->{_refcount_base}++;"
NSQ_SOURCE_LINE 00000187 "    }"
NSQ_SOURCE_LINE 00000188 "    my $output = $printer->parse((defined $item ? $item : $_[0]));"
NSQ_SOURCE_LINE 00000189 "    if ($printer->caller_message_position eq 'after') {"
NSQ_SOURCE_LINE 00000190 "        $output .= $printer->_write_label;"
NSQ_SOURCE_LINE 00000191 "    }"
NSQ_SOURCE_LINE 00000192 "    else {"
NSQ_SOURCE_LINE 00000193 "        $output = $printer->_write_label . $output;"
NSQ_SOURCE_LINE 00000194 "    }"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "    return _handle_output($output, $printer->{output_handle}, $want_value, $_[0], $printer->return_value, undef);"
NSQ_SOURCE_LINE 00000197 "}"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "sub _handle_output {"
NSQ_SOURCE_LINE 00000201 "    my ($output, $out_handle, $wantarray, $data, $return_type, $quiet) = @_;"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "    if ($return_type eq 'pass') {"
NSQ_SOURCE_LINE 00000204 "        print { $out_handle } $output . \"\\n\" unless $quiet;"
NSQ_SOURCE_LINE 00000205 "        require Scalar::Util;"
NSQ_SOURCE_LINE 00000206 "        my $ref = Scalar::Util::blessed($data);"
NSQ_SOURCE_LINE 00000207 "        return $data if defined $ref;"
NSQ_SOURCE_LINE 00000208 "        $ref = Scalar::Util::reftype($data);"
NSQ_SOURCE_LINE 00000209 "        if (!$ref) {"
NSQ_SOURCE_LINE 00000210 "            return $data;"
NSQ_SOURCE_LINE 00000211 "        }"
NSQ_SOURCE_LINE 00000212 "        elsif ($ref eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000213 "            return @$data;"
NSQ_SOURCE_LINE 00000214 "        }"
NSQ_SOURCE_LINE 00000215 "        elsif ($ref eq 'HASH') {"
NSQ_SOURCE_LINE 00000216 "            return %$data;"
NSQ_SOURCE_LINE 00000217 "        }"
NSQ_SOURCE_LINE 00000218 "        elsif ( grep { $ref eq $_ } qw(REF SCALAR VSTRING) ) {"
NSQ_SOURCE_LINE 00000219 "            return $$data;"
NSQ_SOURCE_LINE 00000220 "        }"
NSQ_SOURCE_LINE 00000221 "        else {"
NSQ_SOURCE_LINE 00000222 "            return $data;"
NSQ_SOURCE_LINE 00000223 "        }"
NSQ_SOURCE_LINE 00000224 "    }"
NSQ_SOURCE_LINE 00000225 "    elsif ($return_type eq 'void' || !$wantarray) {"
NSQ_SOURCE_LINE 00000226 "        print { $out_handle} $output . \"\\n\" unless $quiet;"
NSQ_SOURCE_LINE 00000227 "        return;"
NSQ_SOURCE_LINE 00000228 "    }"
NSQ_SOURCE_LINE 00000229 "    else {"
NSQ_SOURCE_LINE 00000230 "        return $output;"
NSQ_SOURCE_LINE 00000231 "    }"
NSQ_SOURCE_LINE 00000232 "}"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "sub _fetch_args_with {"
NSQ_SOURCE_LINE 00000235 "    my ($caller, $run_properties) = @_;"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "    my $args_to_use = {};"
NSQ_SOURCE_LINE 00000238 "    if (keys %$rc_arguments) {"
NSQ_SOURCE_LINE 00000239 "        $args_to_use = Data::Printer::Config::_merge_options("
NSQ_SOURCE_LINE 00000240 "            $args_to_use, $rc_arguments->{'_'}"
NSQ_SOURCE_LINE 00000241 "        );"
NSQ_SOURCE_LINE 00000242 "        if (exists $rc_arguments->{$caller}) {"
NSQ_SOURCE_LINE 00000243 "            $args_to_use = Data::Printer::Config::_merge_options("
NSQ_SOURCE_LINE 00000244 "                $args_to_use, $rc_arguments->{$caller}"
NSQ_SOURCE_LINE 00000245 "            );"
NSQ_SOURCE_LINE 00000246 "        }"
NSQ_SOURCE_LINE 00000247 "    }"
NSQ_SOURCE_LINE 00000248 "    if ($arguments_for{$caller}) {"
NSQ_SOURCE_LINE 00000249 "        $args_to_use = Data::Printer::Config::_merge_options("
NSQ_SOURCE_LINE 00000250 "            $args_to_use, $arguments_for{$caller}"
NSQ_SOURCE_LINE 00000251 "        );"
NSQ_SOURCE_LINE 00000252 "    }"
NSQ_SOURCE_LINE 00000253 "    if (keys %$run_properties) {"
NSQ_SOURCE_LINE 00000254 "        $run_properties = Data::Printer::Config::_expand_profile($run_properties)"
NSQ_SOURCE_LINE 00000255 "            if exists $run_properties->{profile};"
NSQ_SOURCE_LINE 00000256 "        $args_to_use = Data::Printer::Config::_merge_options("
NSQ_SOURCE_LINE 00000257 "            $args_to_use, $run_properties"
NSQ_SOURCE_LINE 00000258 "        );"
NSQ_SOURCE_LINE 00000259 "    }"
NSQ_SOURCE_LINE 00000260 "    return $args_to_use;"
NSQ_SOURCE_LINE 00000261 "}"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "sub _find_option {"
NSQ_SOURCE_LINE 00000265 "    my ($key, $args, $caller, $default) = @_;"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "    my $value;"
NSQ_SOURCE_LINE 00000268 "    if (exists $args->{$key}) {"
NSQ_SOURCE_LINE 00000269 "        $value =  $args->{$key};"
NSQ_SOURCE_LINE 00000270 "    }"
NSQ_SOURCE_LINE 00000271 "    elsif ("
NSQ_SOURCE_LINE 00000272 "          exists $rc_arguments->{$caller}"
NSQ_SOURCE_LINE 00000273 "       && exists $rc_arguments->{$caller}{$key}"
NSQ_SOURCE_LINE 00000274 "    ) {"
NSQ_SOURCE_LINE 00000275 "        $value = $rc_arguments->{$caller}{$key};"
NSQ_SOURCE_LINE 00000276 "    }"
NSQ_SOURCE_LINE 00000277 "    elsif (exists $rc_arguments->{'_'}{$key}) {"
NSQ_SOURCE_LINE 00000278 "        $value = $rc_arguments->{'_'}{$key};"
NSQ_SOURCE_LINE 00000279 "    }"
NSQ_SOURCE_LINE 00000280 "    else {"
NSQ_SOURCE_LINE 00000281 "        $value = $default;"
NSQ_SOURCE_LINE 00000282 "    }"
NSQ_SOURCE_LINE 00000283 "    return $value;"
NSQ_SOURCE_LINE 00000284 "}"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "'Marielle, presente.';"
NSQ_SOURCE_LINE 00000288 "__END__"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "=encoding utf8"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "=head1 NAME"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "Data::Printer - colored & full-featured pretty print of Perl data structures and objects"
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "Want to see what's inside a variable in a complete, colored and human-friendly way?"
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "    use DDP;  # same as 'use Data::Printer'"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "    p $some_var;"
NSQ_SOURCE_LINE 00000303 "    p $some_var, as => \"This label will be printed too!\";"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "    # no need to use '\\' before arrays or hashes!"
NSQ_SOURCE_LINE 00000306 "    p @array;"
NSQ_SOURCE_LINE 00000307 "    p %hash;"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "    # printing anonymous array references:"
NSQ_SOURCE_LINE 00000310 "    p [ $one, $two, $three ]->@*;    # perl 5.24 or later!"
NSQ_SOURCE_LINE 00000311 "    p @{[ $one, $two, $three ]};     # same, older perls"
NSQ_SOURCE_LINE 00000312 "    &p( [ $one, $two, $three ] );    # same, older perls"
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "    # printing anonymous hash references:"
NSQ_SOURCE_LINE 00000315 "    p { foo => $foo, bar => $bar }->%*;   # perl 5.24 or later!"
NSQ_SOURCE_LINE 00000316 "    p %{{ foo => $foo, bar => $bar }};    # same, older perls"
NSQ_SOURCE_LINE 00000317 "    &p( { foo => $foo, bar => $bar } );   # same, older perls"
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "The snippets above will print the contents of the chosen variables to STDERR"
NSQ_SOURCE_LINE 00000321 "on your terminal, with colors and a few extra features to help you debug"
NSQ_SOURCE_LINE 00000322 "your code."
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "If you wish to grab the output and handle it yourself, call C<np()>:"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "    my $dump = np $var;"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "    die \"this is what happened: \" . np %data;"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "The C<np()> function is the same as C<p()> but will return the string"
NSQ_SOURCE_LINE 00000331 "containing the dump. By default it has no colors, but you can change that"
NSQ_SOURCE_LINE 00000332 "easily too."
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "That's pretty much it :)"
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "=for html <img alt=\"samples of Data::Printer output for several kinds of data and objects\" src=\"https://raw.githubusercontent.com/garu/Data-Printer/master/examples/ddp.gif\" />"
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "Data::Printer is L<fully customizable|/Properties Quick Reference>, even"
NSQ_SOURCE_LINE 00000340 "on a per-module basis! Once you figure out your own preferences, create a"
NSQ_SOURCE_LINE 00000341 "L<< .dataprinter configuration file|/The .dataprinter configuration file >>"
NSQ_SOURCE_LINE 00000342 "for yourself (or one for each project) and Data::Printer will automatically"
NSQ_SOURCE_LINE 00000343 "use it!"
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "=head1 FEATURES"
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "Here's what Data::Printer offers Perl developers, out of the box:"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "=over 4"
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "=item * Variable dumps designed for B<< easy parsing by the human brain >>,"
NSQ_SOURCE_LINE 00000352 "not a machine."
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "=back"
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "=over 4"
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 "=item * B<< Highly customizable >>, from indentation size to depth level."
NSQ_SOURCE_LINE 00000359 "You can even rename the exported C<p()> function!"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "=back"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "=over 4"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "=item * B<< Beautiful (and customizable) colors >> to highlight variable dumps"
NSQ_SOURCE_LINE 00000366 "and make issues stand-out quickly on your console. Comes bundled with"
NSQ_SOURCE_LINE 00000367 "L<several themes|Data::Printer::Theme> for you to pick that work on light"
NSQ_SOURCE_LINE 00000368 "and dark terminal backgrounds, and you can create your own as well."
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "=back"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "=over 4"
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "=item * B<< L<Filters|/Filters> for specific data structures and objects >> to make"
NSQ_SOURCE_LINE 00000375 "debugging much, much easier. Includes filters for many popular classes"
NSQ_SOURCE_LINE 00000376 "from CPAN like JSON::*, URI, HTTP::*, LWP, Digest::*, DBI and DBIx::Class."
NSQ_SOURCE_LINE 00000377 "printing what really matters to developers debugging code. It also lets you"
NSQ_SOURCE_LINE 00000378 "create your own custom filters easily."
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "=back"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "=over 4"
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "=item * Lets you B<< inspect information that's otherwise difficult to find/debug >>"
NSQ_SOURCE_LINE 00000385 "in Perl 5, like circular references, reference counting (refcount),"
NSQ_SOURCE_LINE 00000386 "weak/read-only information, overloaded operators, tainted data, ties,"
NSQ_SOURCE_LINE 00000387 "dual vars, even estimated data size - all to help you spot issues with your"
NSQ_SOURCE_LINE 00000388 "data like leaks without having to know a lot about internal data structures"
NSQ_SOURCE_LINE 00000389 "or install hardcore tools like Devel::Peek and Devel::Gladiator."
NSQ_SOURCE_LINE 00000390 ""
NSQ_SOURCE_LINE 00000391 "=back"
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "=over 4"
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "=item * B<< Full support for dumping perl 5.38 native classes >>."
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "=back"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "=over 4"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "=item * keep your custom settings on a"
NSQ_SOURCE_LINE 00000402 "L<< .dataprinter|/The .dataprinter configuration file >> file that allows"
NSQ_SOURCE_LINE 00000403 "B<< different options per module >> being analyzed! You can have"
NSQ_SOURCE_LINE 00000404 "B<< one C<.dataprinter> file per project >>, or default to one in your home"
NSQ_SOURCE_LINE 00000405 "directory. You may also create a custom L<profile|Data::Printer::Profile> class"
NSQ_SOURCE_LINE 00000406 "with your preferences and filters and upload it to CPAN."
NSQ_SOURCE_LINE 00000407 ""
NSQ_SOURCE_LINE 00000408 "=back"
NSQ_SOURCE_LINE 00000409 ""
NSQ_SOURCE_LINE 00000410 "=over 4"
NSQ_SOURCE_LINE 00000411 ""
NSQ_SOURCE_LINE 00000412 "=item * B<< output to many different targets >> like files, variables or open"
NSQ_SOURCE_LINE 00000413 "handles (defaults to STDERR). You can send your dumps to the screen"
NSQ_SOURCE_LINE 00000414 "or anywhere else, and customize this setting on a per-project or even"
NSQ_SOURCE_LINE 00000415 "per-module basis, like print everything from Some::Module to a debug.log"
NSQ_SOURCE_LINE 00000416 "file with extra info, and everything else to STDERR."
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 "=back"
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "=over 4"
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "=item * B<< Easy to learn, easy to master >>. Seriously, the synopsis above"
NSQ_SOURCE_LINE 00000423 "and the customization section below cover about 90% of all use cases."
NSQ_SOURCE_LINE 00000424 ""
NSQ_SOURCE_LINE 00000425 "=back"
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 "=over 4"
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 "=item * Works on B<< Perl 5.8 and later >>. Because you can't control where"
NSQ_SOURCE_LINE 00000430 "you debug, we try our best to be compatible with all versions of Perl 5, from"
NSQ_SOURCE_LINE 00000431 "the oldest available to the bleeding edge."
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "=back"
NSQ_SOURCE_LINE 00000434 ""
NSQ_SOURCE_LINE 00000435 "=over 4"
NSQ_SOURCE_LINE 00000436 ""
NSQ_SOURCE_LINE 00000437 "=item * Best of all? All that with B<< No non-core dependencies >>,"
NSQ_SOURCE_LINE 00000438 "Zero. Nada. So don't worry about adding extra weight to your project, as"
NSQ_SOURCE_LINE 00000439 "Data::Printer can be easily added/removed."
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "=back"
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "The ever-popular Data::Dumper is a fantastic tool, meant to stringify"
NSQ_SOURCE_LINE 00000446 "data structures in a way they are suitable for being \"eval\"'ed back in."
NSQ_SOURCE_LINE 00000447 "The thing is, a lot of people keep using it (and similar ones, like"
NSQ_SOURCE_LINE 00000448 "Data::Dump) to print data structures and objects on screen for inspection"
NSQ_SOURCE_LINE 00000449 "and debugging, and while you I<can> use those modules for that, it doesn't"
NSQ_SOURCE_LINE 00000450 "mean you I<should>."
NSQ_SOURCE_LINE 00000451 ""
NSQ_SOURCE_LINE 00000452 "This is where Data::Printer comes in. It is meant to do one thing and one"
NSQ_SOURCE_LINE 00000453 "thing only:"
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 "I<< format Perl variables and objects to be inspected by a human >>"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "If you want to serialize/store/restore Perl data structures, this module"
NSQ_SOURCE_LINE 00000458 "will NOT help you. Try Storable, Data::Dumper, JSON, or whatever. CPAN is"
NSQ_SOURCE_LINE 00000459 "full of such solutions!"
NSQ_SOURCE_LINE 00000460 ""
NSQ_SOURCE_LINE 00000461 "Whenever you type C<use Data::Printer> or C<use DDP>, we export two functions"
NSQ_SOURCE_LINE 00000462 "to your namespace:"
NSQ_SOURCE_LINE 00000463 ""
NSQ_SOURCE_LINE 00000464 "=head2 p()"
NSQ_SOURCE_LINE 00000465 ""
NSQ_SOURCE_LINE 00000466 "This function pretty-prints the contents of whatever variable to STDERR"
NSQ_SOURCE_LINE 00000467 "(by default), and will use colors by default if your terminal supports it."
NSQ_SOURCE_LINE 00000468 ""
NSQ_SOURCE_LINE 00000469 "    p @some_array;"
NSQ_SOURCE_LINE 00000470 "    p %some_hash;"
NSQ_SOURCE_LINE 00000471 "    p $scalar_or_ref;"
NSQ_SOURCE_LINE 00000472 ""
NSQ_SOURCE_LINE 00000473 "Note that anonymous structures will only work if you postderef them:"
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 "    p [$foo, $bar, $baz]->@*;"
NSQ_SOURCE_LINE 00000476 ""
NSQ_SOURCE_LINE 00000477 "you may also deref it manually:"
NSQ_SOURCE_LINE 00000478 ""
NSQ_SOURCE_LINE 00000479 "    p %{{ foo => $foo }};"
NSQ_SOURCE_LINE 00000480 ""
NSQ_SOURCE_LINE 00000481 "or prefix C<p()> with C<&>:"
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 "    &p( [$foo, $bar, $baz] );    # & (note mandatory parenthesis)"
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "You can pass custom options that will work only on that particular call:"
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "    p @var, as => \"some label\", colored => 0;"
NSQ_SOURCE_LINE 00000488 "    p %var, show_memsize => 1;"
NSQ_SOURCE_LINE 00000489 ""
NSQ_SOURCE_LINE 00000490 "By default, C<p()> prints to STDERR and returns the same variable being"
NSQ_SOURCE_LINE 00000491 "dumped. This lets you quickly wrap variables with C<p()> without worrying"
NSQ_SOURCE_LINE 00000492 "about changing return values. It means that if you change this:"
NSQ_SOURCE_LINE 00000493 ""
NSQ_SOURCE_LINE 00000494 "    sub foo { my $x = shift + 13; $x }"
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "to this:"
NSQ_SOURCE_LINE 00000497 ""
NSQ_SOURCE_LINE 00000498 "    sub foo { my $x = shift + 13; p($x) }"
NSQ_SOURCE_LINE 00000499 ""
NSQ_SOURCE_LINE 00000500 "The function will still return C<$x> after printing the contents. This form"
NSQ_SOURCE_LINE 00000501 "of handling data even allows method chaining, so if you want to inspect what's"
NSQ_SOURCE_LINE 00000502 "going on in the middle of this:"
NSQ_SOURCE_LINE 00000503 ""
NSQ_SOURCE_LINE 00000504 "    $object->foo->bar->baz;"
NSQ_SOURCE_LINE 00000505 ""
NSQ_SOURCE_LINE 00000506 "You can just add C<DDP::p> anywhere:"
NSQ_SOURCE_LINE 00000507 ""
NSQ_SOURCE_LINE 00000508 "    $object->foo->DDP::p->bar->baz; # what happens to $object after ->foo?"
NSQ_SOURCE_LINE 00000509 ""
NSQ_SOURCE_LINE 00000510 "Check out the L<customization quick reference|/Properties Quick Reference>"
NSQ_SOURCE_LINE 00000511 "section below for all available options, including changing the return type,"
NSQ_SOURCE_LINE 00000512 "output target and a lot more."
NSQ_SOURCE_LINE 00000513 ""
NSQ_SOURCE_LINE 00000514 "=head2 np()"
NSQ_SOURCE_LINE 00000515 ""
NSQ_SOURCE_LINE 00000516 "The C<np()> function behaves exactly like C<p()> except it always returns"
NSQ_SOURCE_LINE 00000517 "the string containing the dump (thus ignoring any setting regarding dump"
NSQ_SOURCE_LINE 00000518 "mode or destination), and contains no colors by default. In fact, the only"
NSQ_SOURCE_LINE 00000519 "way to force a colored C<np()> is to pass C<< colored => 1 >> as an argument"
NSQ_SOURCE_LINE 00000520 "to each call. It is meant to provide an easy way to fetch the dump and send"
NSQ_SOURCE_LINE 00000521 "it to some unsupported target, or appended to some other text (like part of"
NSQ_SOURCE_LINE 00000522 "a log message)."
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 ""
NSQ_SOURCE_LINE 00000525 "=head1 CUSTOMIZATION"
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 "There are 3 possible ways to customize Data::Printer:"
NSQ_SOURCE_LINE 00000528 ""
NSQ_SOURCE_LINE 00000529 "1. B<[RECOMMENDED]> Creating a C<.dataprinter> file either on your home"
NSQ_SOURCE_LINE 00000530 "directory or your project's base directory, or both,  or wherever you set"
NSQ_SOURCE_LINE 00000531 "the C<DATAPRINTERRC> environment variable to."
NSQ_SOURCE_LINE 00000532 ""
NSQ_SOURCE_LINE 00000533 "2. Setting custom properties on module load. This will override any"
NSQ_SOURCE_LINE 00000534 "setting from your config file on the namespace (package/module) it was called:"
NSQ_SOURCE_LINE 00000535 ""
NSQ_SOURCE_LINE 00000536 "    use DDP max_depth => 2, deparse => 1;"
NSQ_SOURCE_LINE 00000537 ""
NSQ_SOURCE_LINE 00000538 "3. Setting custom properties on the actual call to C<p()> or C<np()>. This"
NSQ_SOURCE_LINE 00000539 "overrides all other settings:"
NSQ_SOURCE_LINE 00000540 ""
NSQ_SOURCE_LINE 00000541 "    p $var, show_tainted => 1, indent => 2;"
NSQ_SOURCE_LINE 00000542 ""
NSQ_SOURCE_LINE 00000543 ""
NSQ_SOURCE_LINE 00000544 "=head2 The .dataprinter configuration file"
NSQ_SOURCE_LINE 00000545 ""
NSQ_SOURCE_LINE 00000546 "The most powerful way to customize Data::Printer is to have a C<.dataprinter>"
NSQ_SOURCE_LINE 00000547 "file in your home directory or your project's root directory. The format"
NSQ_SOURCE_LINE 00000548 "is super simple and can be understood in the example below:"
NSQ_SOURCE_LINE 00000549 ""
NSQ_SOURCE_LINE 00000550 "    # global settings (note that only full line comments are accepted)"
NSQ_SOURCE_LINE 00000551 "    max_depth       = 1"
NSQ_SOURCE_LINE 00000552 "    theme           = Monokai"
NSQ_SOURCE_LINE 00000553 "    class.stringify = 0"
NSQ_SOURCE_LINE 00000554 ""
NSQ_SOURCE_LINE 00000555 "    # use quotes if you want spaces to be significant:"
NSQ_SOURCE_LINE 00000556 "    hash_separator  = \" => \""
NSQ_SOURCE_LINE 00000557 ""
NSQ_SOURCE_LINE 00000558 "    # You can set rules that apply only to a specific"
NSQ_SOURCE_LINE 00000559 "    # caller module (in this case, MyApp::Some::Module):"
NSQ_SOURCE_LINE 00000560 "    [MyApp::Some::Module]"
NSQ_SOURCE_LINE 00000561 "    max_depth    = 2"
NSQ_SOURCE_LINE 00000562 "    class.expand = 0"
NSQ_SOURCE_LINE 00000563 "    escape_chars = nonlatin1"
NSQ_SOURCE_LINE 00000564 ""
NSQ_SOURCE_LINE 00000565 "    [MyApp::Other::Module]"
NSQ_SOURCE_LINE 00000566 "    multiline = 0"
NSQ_SOURCE_LINE 00000567 "    output    = /var/log/myapp/debug.data"
NSQ_SOURCE_LINE 00000568 ""
NSQ_SOURCE_LINE 00000569 "    # use 'quiet' to silence all output from p() and np()"
NSQ_SOURCE_LINE 00000570 "    # called from the specified package."
NSQ_SOURCE_LINE 00000571 "    [MyApp::Yet::Another]"
NSQ_SOURCE_LINE 00000572 "    quiet = 1"
NSQ_SOURCE_LINE 00000573 ""
NSQ_SOURCE_LINE 00000574 "Note that if you set custom properties as arguments to C<p()> or C<np()>, you"
NSQ_SOURCE_LINE 00000575 "should group suboptions as a hashref. So while the C<.dataprinter> file has"
NSQ_SOURCE_LINE 00000576 "\"C<< class.expand = 0 >>\" and \"C<< class.inherited = none >>\", the equivalent"
NSQ_SOURCE_LINE 00000577 "code is \"C<< class => { expand => 0, inherited => 'none' } >>\"."
NSQ_SOURCE_LINE 00000578 ""
NSQ_SOURCE_LINE 00000579 "=head3 live updating your .dataprinter without restarts"
NSQ_SOURCE_LINE 00000580 ""
NSQ_SOURCE_LINE 00000581 "Data::Printer 1.1 introduces a new 'live_update' flag that can be set to a"
NSQ_SOURCE_LINE 00000582 "positive integer to enable live updates. When this mode is on, Data::Printer"
NSQ_SOURCE_LINE 00000583 "will check if the C<.dataprinter> file has been updated and, if so, it will"
NSQ_SOURCE_LINE 00000584 "reload it. This way you can toggle features on and off and control output"
NSQ_SOURCE_LINE 00000585 "verbosity directly from your C<.dataprinter> file without needing to change"
NSQ_SOURCE_LINE 00000586 "or restart running code."
NSQ_SOURCE_LINE 00000587 ""
NSQ_SOURCE_LINE 00000588 "=head2 Properties Quick Reference"
NSQ_SOURCE_LINE 00000589 ""
NSQ_SOURCE_LINE 00000590 "Below are (almost) all available properties and their (hopefully sane)"
NSQ_SOURCE_LINE 00000591 "default values. See L<Data::Printer::Object> for further information on"
NSQ_SOURCE_LINE 00000592 "each of them:"
NSQ_SOURCE_LINE 00000593 ""
NSQ_SOURCE_LINE 00000594 "    # scalar options"
NSQ_SOURCE_LINE 00000595 "    show_tainted      = 1"
NSQ_SOURCE_LINE 00000596 "    show_unicode      = 1"
NSQ_SOURCE_LINE 00000597 "    show_lvalue       = 1"
NSQ_SOURCE_LINE 00000598 "    print_escapes     = 0"
NSQ_SOURCE_LINE 00000599 "    scalar_quotes     = \""
NSQ_SOURCE_LINE 00000600 "    escape_chars      = none"
NSQ_SOURCE_LINE 00000601 "    string_max        = 4096"
NSQ_SOURCE_LINE 00000602 "    string_preserve   = begin"
NSQ_SOURCE_LINE 00000603 "    string_overflow   = '(...skipping __SKIPPED__ chars...)'"
NSQ_SOURCE_LINE 00000604 "    unicode_charnames = 0"
NSQ_SOURCE_LINE 00000605 ""
NSQ_SOURCE_LINE 00000606 "    # array options"
NSQ_SOURCE_LINE 00000607 "    array_max      = 100"
NSQ_SOURCE_LINE 00000608 "    array_preserve = begin"
NSQ_SOURCE_LINE 00000609 "    array_overflow = '(...skipping __SKIPPED__ items...)'"
NSQ_SOURCE_LINE 00000610 "    index          = 1"
NSQ_SOURCE_LINE 00000611 ""
NSQ_SOURCE_LINE 00000612 "    # hash options"
NSQ_SOURCE_LINE 00000613 "    hash_max       = 100"
NSQ_SOURCE_LINE 00000614 "    hash_preserve  = begin"
NSQ_SOURCE_LINE 00000615 "    hash_overflow  = '(...skipping __SKIPPED__ keys...)'"
NSQ_SOURCE_LINE 00000616 "    hash_separator = '   '"
NSQ_SOURCE_LINE 00000617 "    align_hash     = 1"
NSQ_SOURCE_LINE 00000618 "    sort_keys      = 1"
NSQ_SOURCE_LINE 00000619 "    quote_keys     = auto"
NSQ_SOURCE_LINE 00000620 ""
NSQ_SOURCE_LINE 00000621 "    # general options"
NSQ_SOURCE_LINE 00000622 "    name           = var"
NSQ_SOURCE_LINE 00000623 "    return_value   = pass"
NSQ_SOURCE_LINE 00000624 "    output         = stderr"
NSQ_SOURCE_LINE 00000625 "    use_prototypes = 1"
NSQ_SOURCE_LINE 00000626 "    indent         = 4"
NSQ_SOURCE_LINE 00000627 "    show_readonly  = 1"
NSQ_SOURCE_LINE 00000628 "    show_tied      = 1"
NSQ_SOURCE_LINE 00000629 "    show_dualvar   = lax"
NSQ_SOURCE_LINE 00000630 "    show_weak      = 1"
NSQ_SOURCE_LINE 00000631 "    show_refcount  = 0"
NSQ_SOURCE_LINE 00000632 "    show_memsize   = 0"
NSQ_SOURCE_LINE 00000633 "    memsize_unit   = auto"
NSQ_SOURCE_LINE 00000634 "    separator      = ,"
NSQ_SOURCE_LINE 00000635 "    end_separator  = 0"
NSQ_SOURCE_LINE 00000636 "    caller_info    = 0"
NSQ_SOURCE_LINE 00000637 "    caller_message = 'Printing in line __LINE__ of __FILENAME__'"
NSQ_SOURCE_LINE 00000638 "    max_depth      = 0"
NSQ_SOURCE_LINE 00000639 "    deparse        = 0"
NSQ_SOURCE_LINE 00000640 "    alias          = p"
NSQ_SOURCE_LINE 00000641 "    warnings       = 1"
NSQ_SOURCE_LINE 00000642 ""
NSQ_SOURCE_LINE 00000643 "    # colorization (see Colors & Themes below)"
NSQ_SOURCE_LINE 00000644 "    colored = auto"
NSQ_SOURCE_LINE 00000645 "    theme   = Material"
NSQ_SOURCE_LINE 00000646 ""
NSQ_SOURCE_LINE 00000647 "    # object output"
NSQ_SOURCE_LINE 00000648 "    class_method             = _data_printer"
NSQ_SOURCE_LINE 00000649 "    class.parents            = 1"
NSQ_SOURCE_LINE 00000650 "    class.linear_isa         = auto"
NSQ_SOURCE_LINE 00000651 "    class.universal          = 1"
NSQ_SOURCE_LINE 00000652 "    class.expand             = 1"
NSQ_SOURCE_LINE 00000653 "    class.stringify          = 1"
NSQ_SOURCE_LINE 00000654 "    class.show_reftype       = 0"
NSQ_SOURCE_LINE 00000655 "    class.show_overloads     = 1"
NSQ_SOURCE_LINE 00000656 "    class.show_methods       = all"
NSQ_SOURCE_LINE 00000657 "    class.sort_methods       = 1"
NSQ_SOURCE_LINE 00000658 "    class.inherited          = none"
NSQ_SOURCE_LINE 00000659 "    class.format_inheritance = string"
NSQ_SOURCE_LINE 00000660 "    class.parent_filters     = 1"
NSQ_SOURCE_LINE 00000661 "    class.internals          = 1"
NSQ_SOURCE_LINE 00000662 ""
NSQ_SOURCE_LINE 00000663 ""
NSQ_SOURCE_LINE 00000664 "=head3 Settings' shortcuts"
NSQ_SOURCE_LINE 00000665 ""
NSQ_SOURCE_LINE 00000666 "=over 4"
NSQ_SOURCE_LINE 00000667 ""
NSQ_SOURCE_LINE 00000668 "=item * B<as> - prints a string before the dump. So:"
NSQ_SOURCE_LINE 00000669 ""
NSQ_SOURCE_LINE 00000670 "    p $some_var, as => 'here!';"
NSQ_SOURCE_LINE 00000671 ""
NSQ_SOURCE_LINE 00000672 "is a shortcut to:"
NSQ_SOURCE_LINE 00000673 ""
NSQ_SOURCE_LINE 00000674 "    p $some_var, caller_info => 1, caller_message => 'here!';"
NSQ_SOURCE_LINE 00000675 ""
NSQ_SOURCE_LINE 00000676 "=item * B<multiline> - lets you create shorter dumps. By setting it to 0,"
NSQ_SOURCE_LINE 00000677 "we use a single space as linebreak and disable the array index. Setting it"
NSQ_SOURCE_LINE 00000678 "to 1 (the default) goes back to using \"\\n\" as linebreak and restore whatever"
NSQ_SOURCE_LINE 00000679 "array index you had originally."
NSQ_SOURCE_LINE 00000680 ""
NSQ_SOURCE_LINE 00000681 "=item * B<fulldump> - when set to 1, disables all max string/hash/array"
NSQ_SOURCE_LINE 00000682 "values. Use this to generate complete (full) dumps of all your content,"
NSQ_SOURCE_LINE 00000683 "which is trimmed by default."
NSQ_SOURCE_LINE 00000684 ""
NSQ_SOURCE_LINE 00000685 "=item * B<quiet> - when set to 1, disables all data parsing and returns as"
NSQ_SOURCE_LINE 00000686 "quickly as possible. Use this to disable all output from C<p()> and C<np()>"
NSQ_SOURCE_LINE 00000687 "inside a particular package, either from the 'use' call or from .dataprinter."
NSQ_SOURCE_LINE 00000688 "(introduced in version 1.1)"
NSQ_SOURCE_LINE 00000689 ""
NSQ_SOURCE_LINE 00000690 "=back"
NSQ_SOURCE_LINE 00000691 ""
NSQ_SOURCE_LINE 00000692 ""
NSQ_SOURCE_LINE 00000693 "=head2 Colors & Themes"
NSQ_SOURCE_LINE 00000694 ""
NSQ_SOURCE_LINE 00000695 "Data::Printer lets you set custom colors for pretty much every part of the"
NSQ_SOURCE_LINE 00000696 "content being printed. For example, if you want numbers to be shown in"
NSQ_SOURCE_LINE 00000697 "bright green, just put C<< colors.number = #00ff00 >> on your configuration"
NSQ_SOURCE_LINE 00000698 "file."
NSQ_SOURCE_LINE 00000699 ""
NSQ_SOURCE_LINE 00000700 "See L<Data::Printer::Theme> for the full list of labels, ways to represent"
NSQ_SOURCE_LINE 00000701 "and customize colors, and even how to group them in your own custom theme."
NSQ_SOURCE_LINE 00000702 ""
NSQ_SOURCE_LINE 00000703 "The colorization is set by the C<colored> property. It can be set to 0"
NSQ_SOURCE_LINE 00000704 "(never colorize), 1 (always colorize) or 'auto' (the default), which will"
NSQ_SOURCE_LINE 00000705 "colorize C<p()> only when there is no C<ANSI_COLORS_DISABLED> environment"
NSQ_SOURCE_LINE 00000706 "variable, the output is going to the terminal (STDOUT or STDERR) and your"
NSQ_SOURCE_LINE 00000707 "terminal actually supports colors."
NSQ_SOURCE_LINE 00000708 ""
NSQ_SOURCE_LINE 00000709 ""
NSQ_SOURCE_LINE 00000710 "=head2 Profiles"
NSQ_SOURCE_LINE 00000711 ""
NSQ_SOURCE_LINE 00000712 "You may bundle your settings and filters into a profile module."
NSQ_SOURCE_LINE 00000713 "It works like a configuration file but gives you the power and flexibility"
NSQ_SOURCE_LINE 00000714 "to use Perl code to find out what to print and how to print. It also lets"
NSQ_SOURCE_LINE 00000715 "you use CPAN to store your preferred settings and install them into your"
NSQ_SOURCE_LINE 00000716 "projects just like a regular dependency."
NSQ_SOURCE_LINE 00000717 ""
NSQ_SOURCE_LINE 00000718 "    use DDP profile => 'ProfileName';"
NSQ_SOURCE_LINE 00000719 ""
NSQ_SOURCE_LINE 00000720 "See L<Data::Printer::Profile> for all the ways to load a profile, a list"
NSQ_SOURCE_LINE 00000721 "of available profiles and how to make one yourself."
NSQ_SOURCE_LINE 00000722 ""
NSQ_SOURCE_LINE 00000723 ""
NSQ_SOURCE_LINE 00000724 "=head2 Filters"
NSQ_SOURCE_LINE 00000725 ""
NSQ_SOURCE_LINE 00000726 "Data::Printer works by passing your variable to a different set of filters,"
NSQ_SOURCE_LINE 00000727 "depending on whether it's a scalar, a hash, an array, an object, etc. It"
NSQ_SOURCE_LINE 00000728 "comes bundled with filters for all native data types (always enabled, but"
NSQ_SOURCE_LINE 00000729 "overwritable), including a generic object filter that pretty-prints regular"
NSQ_SOURCE_LINE 00000730 "and Moo(se) objects and is even aware of Role::Tiny."
NSQ_SOURCE_LINE 00000731 ""
NSQ_SOURCE_LINE 00000732 "Data::Printer also comes with filter bundles that can be quickly activated"
NSQ_SOURCE_LINE 00000733 "to make it easier to debug L<binary data|Data::Printer::Filter::ContentType>"
NSQ_SOURCE_LINE 00000734 "and many popular CPAN modules that handle"
NSQ_SOURCE_LINE 00000735 "L<date and time|Data::Printer::Filter::DateTime>,"
NSQ_SOURCE_LINE 00000736 "L<databases|Data::Printer::Filter::DB> (yes, even DBIx::Class),"
NSQ_SOURCE_LINE 00000737 "L<message digests|Data::Printer::Filter::Digest> like MD5 and SHA1, and"
NSQ_SOURCE_LINE 00000738 "L<JSON and Web|Data::Printer::Filter::Web> content like HTTP requests and"
NSQ_SOURCE_LINE 00000739 "responses."
NSQ_SOURCE_LINE 00000740 ""
NSQ_SOURCE_LINE 00000741 "So much so we recommend everyone to activate all bundled filters by putting"
NSQ_SOURCE_LINE 00000742 "the following line on your C<.dataprinter> file:"
NSQ_SOURCE_LINE 00000743 ""
NSQ_SOURCE_LINE 00000744 "    filters = ContentType, DateTime, DB, Digest, Web"
NSQ_SOURCE_LINE 00000745 ""
NSQ_SOURCE_LINE 00000746 "Creating your custom filters is very easy, and"
NSQ_SOURCE_LINE 00000747 "you're encouraged to upload them to CPAN. There are many options available"
NSQ_SOURCE_LINE 00000748 "under the C<< Data::Printer::Filter::* >> namespace. Check"
NSQ_SOURCE_LINE 00000749 "L<Data::Printer::Filter> for more information!"
NSQ_SOURCE_LINE 00000750 ""
NSQ_SOURCE_LINE 00000751 ""
NSQ_SOURCE_LINE 00000752 "=head2 Making your classes DDP-aware (without adding any dependencies!)"
NSQ_SOURCE_LINE 00000753 ""
NSQ_SOURCE_LINE 00000754 "The default object filter will first check if the class implements a sub"
NSQ_SOURCE_LINE 00000755 "called 'C<_data_printer()>' (or whatever you set the \"class_method\" option"
NSQ_SOURCE_LINE 00000756 "to in your settings). If so, Data::Printer will use it to get the string to"
NSQ_SOURCE_LINE 00000757 "print instead of making a regular class dump."
NSQ_SOURCE_LINE 00000758 ""
NSQ_SOURCE_LINE 00000759 "This means you could have the following in one of your classes:"
NSQ_SOURCE_LINE 00000760 ""
NSQ_SOURCE_LINE 00000761 "  sub _data_printer {"
NSQ_SOURCE_LINE 00000762 "      my ($self, $ddp) = @_;"
NSQ_SOURCE_LINE 00000763 "      return 'Hey, no peeking! But foo contains ' . $self->foo;"
NSQ_SOURCE_LINE 00000764 "  }"
NSQ_SOURCE_LINE 00000765 ""
NSQ_SOURCE_LINE 00000766 "Notice that B<< you can do this without adding Data::Printer as a dependency >>"
NSQ_SOURCE_LINE 00000767 "to your project! Just write your sub and it will be called with the object to"
NSQ_SOURCE_LINE 00000768 "be printed and a C<$ddp> object ready for you. See"
NSQ_SOURCE_LINE 00000769 "L<< Data::Printer::Object|Data::Printer::Object/\"Methods and Accessors for Filter Writers\" >>"
NSQ_SOURCE_LINE 00000770 "for how to use it to pretty-print your data."
NSQ_SOURCE_LINE 00000771 ""
NSQ_SOURCE_LINE 00000772 "Finally, if your object implements string overload or provides a method called"
NSQ_SOURCE_LINE 00000773 "\"to_string\", \"as_string\" or \"stringify\", Data::Printer will use it. To disable"
NSQ_SOURCE_LINE 00000774 "this behaviour, set C<< class.stringify = 0 >> on your C<.dataprinter>"
NSQ_SOURCE_LINE 00000775 "file, or call p() with C<< class => { stringify => 0 } >>."
NSQ_SOURCE_LINE 00000776 ""
NSQ_SOURCE_LINE 00000777 "Loading a filter for that particular class will of course override these settings."
NSQ_SOURCE_LINE 00000778 ""
NSQ_SOURCE_LINE 00000779 ""
NSQ_SOURCE_LINE 00000780 "=head1 CAVEATS"
NSQ_SOURCE_LINE 00000781 ""
NSQ_SOURCE_LINE 00000782 "You can't pass more than one variable at a time."
NSQ_SOURCE_LINE 00000783 ""
NSQ_SOURCE_LINE 00000784 "   p $foo, $bar;       # wrong"
NSQ_SOURCE_LINE 00000785 "   p $foo; p $bar;     # right"
NSQ_SOURCE_LINE 00000786 ""
NSQ_SOURCE_LINE 00000787 "You can't use it in variable declarations (it will most likely not do what"
NSQ_SOURCE_LINE 00000788 "you want):"
NSQ_SOURCE_LINE 00000789 ""
NSQ_SOURCE_LINE 00000790 "    p my @array = qw(a b c d);          # wrong"
NSQ_SOURCE_LINE 00000791 "    my @array = qw(a b c d); p @array;  # right"
NSQ_SOURCE_LINE 00000792 ""
NSQ_SOURCE_LINE 00000793 "If you pass a nonexistent key/index to DDP using prototypes, they"
NSQ_SOURCE_LINE 00000794 "will trigger autovivification:"
NSQ_SOURCE_LINE 00000795 ""
NSQ_SOURCE_LINE 00000796 "    use DDP;"
NSQ_SOURCE_LINE 00000797 "    my %foo;"
NSQ_SOURCE_LINE 00000798 "    p $foo{bar}; # undef, but will create the 'bar' key (with undef)"
NSQ_SOURCE_LINE 00000799 ""
NSQ_SOURCE_LINE 00000800 "    my @x;"
NSQ_SOURCE_LINE 00000801 "    p $x[5]; # undef, but will initialize the array with 5 elements (all undef)"
NSQ_SOURCE_LINE 00000802 ""
NSQ_SOURCE_LINE 00000803 "Slices (both array and hash) must be coerced into actual arrays (or hashes)"
NSQ_SOURCE_LINE 00000804 "to properly shown. So if you want to print a slice, instead of doing something"
NSQ_SOURCE_LINE 00000805 "like this:"
NSQ_SOURCE_LINE 00000806 ""
NSQ_SOURCE_LINE 00000807 "    p @somevar[1..10]; # WRONG! DON'T DO THIS!"
NSQ_SOURCE_LINE 00000808 ""
NSQ_SOURCE_LINE 00000809 "try one of those:"
NSQ_SOURCE_LINE 00000810 ""
NSQ_SOURCE_LINE 00000811 "    my @x = @somevar[1..10]; p @x;   # works!"
NSQ_SOURCE_LINE 00000812 "    p [ @somevar[1..0] ]->@*;        # also works!"
NSQ_SOURCE_LINE 00000813 "    p @{[@somevar[1..0]]};           # this works too!!"
NSQ_SOURCE_LINE 00000814 ""
NSQ_SOURCE_LINE 00000815 "Finally, as mentioned before, you cannot pass anonymous references on the"
NSQ_SOURCE_LINE 00000816 "default mode of C<< use_prototypes = 1 >>:"
NSQ_SOURCE_LINE 00000817 ""
NSQ_SOURCE_LINE 00000818 "    p { foo => 1 };       # wrong!"
NSQ_SOURCE_LINE 00000819 "    p %{{ foo => 1 }};    # right"
NSQ_SOURCE_LINE 00000820 "    p { foo => 1 }->%*;   # right on perl 5.24+"
NSQ_SOURCE_LINE 00000821 "    &p( { foo => 1 } );   # right, but requires the parenthesis"
NSQ_SOURCE_LINE 00000822 "    sub pp { p @_ };      # wrapping it also lets you use anonymous data."
NSQ_SOURCE_LINE 00000823 ""
NSQ_SOURCE_LINE 00000824 "    use DDP use_prototypes => 0;"
NSQ_SOURCE_LINE 00000825 "    p { foo => 1 };   # works, but now p(@foo) will fail, you must always pass a ref,"
NSQ_SOURCE_LINE 00000826 "                      # e.g. p(\\@foo)"
NSQ_SOURCE_LINE 00000827 ""
NSQ_SOURCE_LINE 00000828 "=head1 BACKWARDS INCOMPATIBLE CHANGES"
NSQ_SOURCE_LINE 00000829 ""
NSQ_SOURCE_LINE 00000830 "While we make a genuine effort not to break anything on new releases,"
NSQ_SOURCE_LINE 00000831 "sometimes we do. To make things easier for people migrating their"
NSQ_SOURCE_LINE 00000832 "code, we have aggregated here a list of all incompatible changes since ever:"
NSQ_SOURCE_LINE 00000833 ""
NSQ_SOURCE_LINE 00000834 "=over 4"
NSQ_SOURCE_LINE 00000835 ""
NSQ_SOURCE_LINE 00000836 "=item * 1.00 - some defaults changed!"
NSQ_SOURCE_LINE 00000837 "Because we added a bunch of new features (including color themes), you may"
NSQ_SOURCE_LINE 00000838 "notice some difference on the default output of Data::Printer. Hopefully it's"
NSQ_SOURCE_LINE 00000839 "for the best."
NSQ_SOURCE_LINE 00000840 ""
NSQ_SOURCE_LINE 00000841 "=item * 1.00 - new C<.dataprinter> file format."
NSQ_SOURCE_LINE 00000842 "I<< This should only affect you if you have a C<.dataprinter> file. >>"
NSQ_SOURCE_LINE 00000843 "The change was required to avoid calling C<eval> on potentially tainted/unknown"
NSQ_SOURCE_LINE 00000844 "code. It also provided a much cleaner interface."
NSQ_SOURCE_LINE 00000845 ""
NSQ_SOURCE_LINE 00000846 "=item * 1.00 - new way of creating external filters."
NSQ_SOURCE_LINE 00000847 "I<< This only affects you if you write or use external filters. >>"
NSQ_SOURCE_LINE 00000848 "Previously, the sub in your C<filters> call would get the reference to be"
NSQ_SOURCE_LINE 00000849 "parsed and a properties hash. The properties hash has been replaced with a"
NSQ_SOURCE_LINE 00000850 "L<Data::Printer::Object> instance, providing much more power and flexibility."
NSQ_SOURCE_LINE 00000851 "Because of that, the filter call does not export C<p()>/C<np()> anymore,"
NSQ_SOURCE_LINE 00000852 "replaced by methods in Data::Printer::Object."
NSQ_SOURCE_LINE 00000853 ""
NSQ_SOURCE_LINE 00000854 "=item * 1.00 - new way to call filters."
NSQ_SOURCE_LINE 00000855 "I<< This affects you if you load your own inline filters >>."
NSQ_SOURCE_LINE 00000856 "The fix is quick and Data::Printer will generate a warning explaining how"
NSQ_SOURCE_LINE 00000857 "to do it. Basically, C<< filters => { ... } >> became"
NSQ_SOURCE_LINE 00000858 "C<< filters => [{ ... }] >> and you must replace C<< -external => [1,2] >>"
NSQ_SOURCE_LINE 00000859 "with C<< filters => [1, 2] >>, or C<< filters => [1, 2, {...}] >> if you"
NSQ_SOURCE_LINE 00000860 "also have inline filters. This allowed us much more power and flexibility"
NSQ_SOURCE_LINE 00000861 "with filters, and hopefully also makes things clearer."
NSQ_SOURCE_LINE 00000862 ""
NSQ_SOURCE_LINE 00000863 "=item * 0.36 - C<p()>'s default return value changed from 'dump' to 'pass'."
NSQ_SOURCE_LINE 00000864 "This was a very important change to ensure chained calls and to prevent"
NSQ_SOURCE_LINE 00000865 "weird side-effects when C<p()> is the last statement in a sub."
NSQ_SOURCE_LINE 00000866 "L<< Read the full discussion|https://github.com/garu/Data-Printer/issues/16 >>."
NSQ_SOURCE_LINE 00000867 ""
NSQ_SOURCE_LINE 00000868 "=back"
NSQ_SOURCE_LINE 00000869 ""
NSQ_SOURCE_LINE 00000870 "Any undocumented change was probably unintended. If you bump into one,"
NSQ_SOURCE_LINE 00000871 "please file an issue on Github!"
NSQ_SOURCE_LINE 00000872 ""
NSQ_SOURCE_LINE 00000873 "=head1 TIPS & TRICKS"
NSQ_SOURCE_LINE 00000874 ""
NSQ_SOURCE_LINE 00000875 "=head2 Using p() in some/all of your loaded modules"
NSQ_SOURCE_LINE 00000876 ""
NSQ_SOURCE_LINE 00000877 "I<< (contributed by Matt S. Trout (mst)) >>"
NSQ_SOURCE_LINE 00000878 ""
NSQ_SOURCE_LINE 00000879 "While debugging your software, you may want to use Data::Printer in some or"
NSQ_SOURCE_LINE 00000880 "all loaded modules and not bother having to load it in each and every one of"
NSQ_SOURCE_LINE 00000881 "them. To do this, in any module loaded by C<myapp.pl>, simply write:"
NSQ_SOURCE_LINE 00000882 ""
NSQ_SOURCE_LINE 00000883 "  ::p @myvar;  # note the '::' in front of p()"
NSQ_SOURCE_LINE 00000884 ""
NSQ_SOURCE_LINE 00000885 "Then call your program like:"
NSQ_SOURCE_LINE 00000886 ""
NSQ_SOURCE_LINE 00000887 "  perl -MDDP myapp.pl"
NSQ_SOURCE_LINE 00000888 ""
NSQ_SOURCE_LINE 00000889 "This also has the advantage that if you leave one p() call in by accident,"
NSQ_SOURCE_LINE 00000890 "it will trigger a compile-time failure without the -M, making it easier to"
NSQ_SOURCE_LINE 00000891 "spot :)"
NSQ_SOURCE_LINE 00000892 ""
NSQ_SOURCE_LINE 00000893 "If you really want to have p() imported into your loaded modules, use the"
NSQ_SOURCE_LINE 00000894 "next tip instead."
NSQ_SOURCE_LINE 00000895 ""
NSQ_SOURCE_LINE 00000896 "=head2 Adding p() to all your loaded modules"
NSQ_SOURCE_LINE 00000897 ""
NSQ_SOURCE_LINE 00000898 "I<< (contributed by Árpád Szász) >>"
NSQ_SOURCE_LINE 00000899 ""
NSQ_SOURCE_LINE 00000900 "If you wish to automatically add Data::Printer's C<p()> function to"
NSQ_SOURCE_LINE 00000901 "every loaded module in you app, you can do something like this to"
NSQ_SOURCE_LINE 00000902 "your main program:"
NSQ_SOURCE_LINE 00000903 ""
NSQ_SOURCE_LINE 00000904 "    BEGIN {"
NSQ_SOURCE_LINE 00000905 "        {"
NSQ_SOURCE_LINE 00000906 "            no strict 'refs';"
NSQ_SOURCE_LINE 00000907 "            require Data::Printer;"
NSQ_SOURCE_LINE 00000908 "            my $alias = 'p';"
NSQ_SOURCE_LINE 00000909 "            foreach my $package ( keys %main:: ) {"
NSQ_SOURCE_LINE 00000910 "                if ( $package =~ m/::$/ ) {"
NSQ_SOURCE_LINE 00000911 "                    *{ $package . $alias } = \\&Data::Printer::p;"
NSQ_SOURCE_LINE 00000912 "                }"
NSQ_SOURCE_LINE 00000913 "            }"
NSQ_SOURCE_LINE 00000914 "        }"
NSQ_SOURCE_LINE 00000915 "    }"
NSQ_SOURCE_LINE 00000916 ""
NSQ_SOURCE_LINE 00000917 "B<WARNING> This will override all locally defined subroutines/methods that"
NSQ_SOURCE_LINE 00000918 "are named C<p>, if they exist, in every loaded module. If you already"
NSQ_SOURCE_LINE 00000919 "have a subroutine named 'C<p()>', be sure to change C<$alias> to"
NSQ_SOURCE_LINE 00000920 "something custom."
NSQ_SOURCE_LINE 00000921 ""
NSQ_SOURCE_LINE 00000922 "If you rather avoid namespace manipulation altogether, use the previous"
NSQ_SOURCE_LINE 00000923 "tip instead."
NSQ_SOURCE_LINE 00000924 ""
NSQ_SOURCE_LINE 00000925 "=head2 Using Data::Printer from the Perl debugger"
NSQ_SOURCE_LINE 00000926 ""
NSQ_SOURCE_LINE 00000927 "I<< (contributed by Árpád Szász and Marcel Grünauer (hanekomu)) >>"
NSQ_SOURCE_LINE 00000928 ""
NSQ_SOURCE_LINE 00000929 "With L<DB::Pluggable>, you can easily set the perl debugger to use"
NSQ_SOURCE_LINE 00000930 "Data::Printer to print variable information, replacing the debugger's"
NSQ_SOURCE_LINE 00000931 "standard C<p()> function. All you have to do is add these lines to"
NSQ_SOURCE_LINE 00000932 "your C<.perldb> file:"
NSQ_SOURCE_LINE 00000933 ""
NSQ_SOURCE_LINE 00000934 "  use DB::Pluggable;"
NSQ_SOURCE_LINE 00000935 "  DB::Pluggable->run_with_config( \\'[DataPrinter]' );  # note the '\\'"
NSQ_SOURCE_LINE 00000936 ""
NSQ_SOURCE_LINE 00000937 "Then call the perl debugger as you normally would:"
NSQ_SOURCE_LINE 00000938 ""
NSQ_SOURCE_LINE 00000939 "  perl -d myapp.pl"
NSQ_SOURCE_LINE 00000940 ""
NSQ_SOURCE_LINE 00000941 "Now Data::Printer's C<p()> command will be used instead of the debugger's!"
NSQ_SOURCE_LINE 00000942 ""
NSQ_SOURCE_LINE 00000943 "See L<perldebug> for more information on how to use the perl debugger, and"
NSQ_SOURCE_LINE 00000944 "L<DB::Pluggable> for extra functionality and other plugins."
NSQ_SOURCE_LINE 00000945 ""
NSQ_SOURCE_LINE 00000946 "If you can't or don't want to use DB::Pluggable, or simply want to keep"
NSQ_SOURCE_LINE 00000947 "the debugger's C<p()> function and add an extended version using"
NSQ_SOURCE_LINE 00000948 "Data::Printer (let's call it C<px()> for instance), you can add these"
NSQ_SOURCE_LINE 00000949 "lines to your C<.perldb> file instead:"
NSQ_SOURCE_LINE 00000950 ""
NSQ_SOURCE_LINE 00000951 "    $DB::alias{px} = 's/px/DB::px/';"
NSQ_SOURCE_LINE 00000952 "    sub px {"
NSQ_SOURCE_LINE 00000953 "        my $expr = shift;"
NSQ_SOURCE_LINE 00000954 "        require Data::Printer;"
NSQ_SOURCE_LINE 00000955 "        print Data::Printer::p($expr);"
NSQ_SOURCE_LINE 00000956 "    }"
NSQ_SOURCE_LINE 00000957 ""
NSQ_SOURCE_LINE 00000958 "Now, inside the Perl debugger, you can pass as reference to C<px> expressions"
NSQ_SOURCE_LINE 00000959 "to be dumped using Data::Printer."
NSQ_SOURCE_LINE 00000960 ""
NSQ_SOURCE_LINE 00000961 "=head2 Using Data::Printer in a perl shell (REPL)"
NSQ_SOURCE_LINE 00000962 ""
NSQ_SOURCE_LINE 00000963 "Some people really enjoy using a REPL shell to quickly try Perl code. One"
NSQ_SOURCE_LINE 00000964 "of the most popular ones out there are L<Reply> and L<Devel::REPL>. If you"
NSQ_SOURCE_LINE 00000965 "use them, now you can also see its output with Data::Printer!"
NSQ_SOURCE_LINE 00000966 ""
NSQ_SOURCE_LINE 00000967 "=over 4"
NSQ_SOURCE_LINE 00000968 ""
NSQ_SOURCE_LINE 00000969 "=item * B<Reply>"
NSQ_SOURCE_LINE 00000970 ""
NSQ_SOURCE_LINE 00000971 "=back"
NSQ_SOURCE_LINE 00000972 ""
NSQ_SOURCE_LINE 00000973 "Just install L<Reply::Plugin::DataPrinter> and add a line with"
NSQ_SOURCE_LINE 00000974 "C<< [DataPrinter] >> to your C<.replyrc> file. That's it! Next time"
NSQ_SOURCE_LINE 00000975 "you run the 'reply' REPL, Data::Printer will be used to dump variables!"
NSQ_SOURCE_LINE 00000976 ""
NSQ_SOURCE_LINE 00000977 "=over 4"
NSQ_SOURCE_LINE 00000978 ""
NSQ_SOURCE_LINE 00000979 "=item * B<Devel::REPL>"
NSQ_SOURCE_LINE 00000980 ""
NSQ_SOURCE_LINE 00000981 "=back"
NSQ_SOURCE_LINE 00000982 ""
NSQ_SOURCE_LINE 00000983 "Just install L<Devel::REPL::Plugin::DataPrinter> and add the following"
NSQ_SOURCE_LINE 00000984 "line to your re.pl configuration file (usually \".re.pl/repl.rc\" in your"
NSQ_SOURCE_LINE 00000985 "home dir):"
NSQ_SOURCE_LINE 00000986 ""
NSQ_SOURCE_LINE 00000987 "  load_plugin('DataPrinter');"
NSQ_SOURCE_LINE 00000988 ""
NSQ_SOURCE_LINE 00000989 "The next time you run C<re.pl>, it should dump all your REPL using"
NSQ_SOURCE_LINE 00000990 "Data::Printer!"
NSQ_SOURCE_LINE 00000991 ""
NSQ_SOURCE_LINE 00000992 "=head2 Easily rendering Data::Printer's output as HTML"
NSQ_SOURCE_LINE 00000993 ""
NSQ_SOURCE_LINE 00000994 "To turn Data::Printer's output into HTML, you can do something like:"
NSQ_SOURCE_LINE 00000995 ""
NSQ_SOURCE_LINE 00000996 "  use HTML::FromANSI;"
NSQ_SOURCE_LINE 00000997 "  use Data::Printer;"
NSQ_SOURCE_LINE 00000998 ""
NSQ_SOURCE_LINE 00000999 "  my $html_output = ansi2html( np($object, colored => 1) );"
NSQ_SOURCE_LINE 00001000 ""
NSQ_SOURCE_LINE 00001001 "In the example above, the C<$html_output> variable contains the"
NSQ_SOURCE_LINE 00001002 "HTML escaped output of C<p($object)>, so you can print it for"
NSQ_SOURCE_LINE 00001003 "later inspection or render it (if it's a web app)."
NSQ_SOURCE_LINE 00001004 ""
NSQ_SOURCE_LINE 00001005 "=head2 Using Data::Printer with Template Toolkit"
NSQ_SOURCE_LINE 00001006 ""
NSQ_SOURCE_LINE 00001007 "I<< (contributed by Stephen Thirlwall (sdt)) >>"
NSQ_SOURCE_LINE 00001008 ""
NSQ_SOURCE_LINE 00001009 "If you use Template Toolkit and want to dump your variables using Data::Printer,"
NSQ_SOURCE_LINE 00001010 "install the L<Template::Plugin::DataPrinter> module and load it in your template:"
NSQ_SOURCE_LINE 00001011 ""
NSQ_SOURCE_LINE 00001012 "   [% USE DataPrinter %]"
NSQ_SOURCE_LINE 00001013 ""
NSQ_SOURCE_LINE 00001014 "The provided methods match those of C<Template::Plugin::Dumper>:"
NSQ_SOURCE_LINE 00001015 ""
NSQ_SOURCE_LINE 00001016 "   ansi-colored dump of the data structure in \"myvar\":"
NSQ_SOURCE_LINE 00001017 "   [% DataPrinter.dump( myvar ) %]"
NSQ_SOURCE_LINE 00001018 ""
NSQ_SOURCE_LINE 00001019 "   html-formatted, colored dump of the same data structure:"
NSQ_SOURCE_LINE 00001020 "   [% DataPrinter.dump_html( myvar ) %]"
NSQ_SOURCE_LINE 00001021 ""
NSQ_SOURCE_LINE 00001022 "The module allows several customization options, even letting you load it as a"
NSQ_SOURCE_LINE 00001023 "complete drop-in replacement for Template::Plugin::Dumper so you don't even have"
NSQ_SOURCE_LINE 00001024 "to change your previous templates!"
NSQ_SOURCE_LINE 00001025 ""
NSQ_SOURCE_LINE 00001026 "=head2 Migrating from Data::Dumper to Data::Printer"
NSQ_SOURCE_LINE 00001027 ""
NSQ_SOURCE_LINE 00001028 "If you are porting your code to use Data::Printer instead of"
NSQ_SOURCE_LINE 00001029 "Data::Dumper, you could replace:"
NSQ_SOURCE_LINE 00001030 ""
NSQ_SOURCE_LINE 00001031 "  use Data::Dumper;"
NSQ_SOURCE_LINE 00001032 ""
NSQ_SOURCE_LINE 00001033 "with something like:"
NSQ_SOURCE_LINE 00001034 ""
NSQ_SOURCE_LINE 00001035 "  use Data::Printer;"
NSQ_SOURCE_LINE 00001036 "  sub Dumper { np @_, colored => 1 }"
NSQ_SOURCE_LINE 00001037 ""
NSQ_SOURCE_LINE 00001038 "this sub will accept multiple variables just like Data::Dumper."
NSQ_SOURCE_LINE 00001039 ""
NSQ_SOURCE_LINE 00001040 "=head2 Unified interface for Data::Printer and other debug formatters"
NSQ_SOURCE_LINE 00001041 ""
NSQ_SOURCE_LINE 00001042 "I<< (contributed by Kevin McGrath (catlgrep)) >>"
NSQ_SOURCE_LINE 00001043 ""
NSQ_SOURCE_LINE 00001044 "If you want a really unified approach to easily flip between debugging"
NSQ_SOURCE_LINE 00001045 "outputs, use L<Any::Renderer> and its plugins,"
NSQ_SOURCE_LINE 00001046 "like L<Any::Renderer::Data::Printer>."
NSQ_SOURCE_LINE 00001047 ""
NSQ_SOURCE_LINE 00001048 "=head2 Printing stack traces with arguments expanded using Data::Printer"
NSQ_SOURCE_LINE 00001049 ""
NSQ_SOURCE_LINE 00001050 "I<< (contributed by Sergey Aleynikov (randir)) >>"
NSQ_SOURCE_LINE 00001051 ""
NSQ_SOURCE_LINE 00001052 "There are times where viewing the current state of a variable is not"
NSQ_SOURCE_LINE 00001053 "enough, and you want/need to see a full stack trace of a function call."
NSQ_SOURCE_LINE 00001054 ""
NSQ_SOURCE_LINE 00001055 "The L<Devel::PrettyTrace> module uses Data::Printer to provide you just"
NSQ_SOURCE_LINE 00001056 "that. It exports a C<bt()> function that pretty-prints detailed information"
NSQ_SOURCE_LINE 00001057 "on each function in your stack, making it easier to spot any issues!"
NSQ_SOURCE_LINE 00001058 ""
NSQ_SOURCE_LINE 00001059 "=head2 Troubleshooting apps in real time without changing a single line of your code"
NSQ_SOURCE_LINE 00001060 ""
NSQ_SOURCE_LINE 00001061 "I<< (contributed by Marcel Grünauer (hanekomu)) >>"
NSQ_SOURCE_LINE 00001062 ""
NSQ_SOURCE_LINE 00001063 "L<dip> is a dynamic instrumentation framework for troubleshooting Perl"
NSQ_SOURCE_LINE 00001064 "programs, similar to L<DTrace|http://opensolaris.org/os/community/dtrace/>."
NSQ_SOURCE_LINE 00001065 "In a nutshell, C<dip> lets you create probes for certain conditions"
NSQ_SOURCE_LINE 00001066 "in your application that, once met, will perform a specific action. Since"
NSQ_SOURCE_LINE 00001067 "it uses Aspect-oriented programming, it's very lightweight and you only"
NSQ_SOURCE_LINE 00001068 "pay for what you use."
NSQ_SOURCE_LINE 00001069 ""
NSQ_SOURCE_LINE 00001070 "C<dip> can be very useful since it allows you to debug your software"
NSQ_SOURCE_LINE 00001071 "without changing a single line of your original code. And Data::Printer"
NSQ_SOURCE_LINE 00001072 "comes bundled with it, so you can use the C<p()> function to view your"
NSQ_SOURCE_LINE 00001073 "data structures too!"
NSQ_SOURCE_LINE 00001074 ""
NSQ_SOURCE_LINE 00001075 "   # Print a stack trace every time the name is changed,"
NSQ_SOURCE_LINE 00001076 "   # except when reading from the database."
NSQ_SOURCE_LINE 00001077 "   dip -e 'before { print longmess(np $_->{args}[1], colored => 1)"
NSQ_SOURCE_LINE 00001078 "   if $_->{args}[1] } call \"MyObj::name\" & !cflow(\"MyObj::read\")' myapp.pl"
NSQ_SOURCE_LINE 00001079 ""
NSQ_SOURCE_LINE 00001080 "You can check L<dip>'s own documentation for more information and options."
NSQ_SOURCE_LINE 00001081 ""
NSQ_SOURCE_LINE 00001082 "=head2 Sample output for color fine-tuning"
NSQ_SOURCE_LINE 00001083 ""
NSQ_SOURCE_LINE 00001084 "I<< (contributed by Yanick Champoux (yanick)) >>"
NSQ_SOURCE_LINE 00001085 ""
NSQ_SOURCE_LINE 00001086 "The \"examples/try_me.pl\" file included in this distribution has a sample"
NSQ_SOURCE_LINE 00001087 "dump with a complex data structure to let you quickly test color schemes."
NSQ_SOURCE_LINE 00001088 ""
NSQ_SOURCE_LINE 00001089 "=head1 VERSIONING AND UPDATES"
NSQ_SOURCE_LINE 00001090 ""
NSQ_SOURCE_LINE 00001091 "As of 1.0.0 this module complies with C<Major.Minor.Revision> versioning"
NSQ_SOURCE_LINE 00001092 "scheme (SemVer), meaning backwards incompatible changes will trigger a new"
NSQ_SOURCE_LINE 00001093 "major number, new features without any breaking changes trigger a new minor"
NSQ_SOURCE_LINE 00001094 "number, and simple patches trigger a revision number."
NSQ_SOURCE_LINE 00001095 ""
NSQ_SOURCE_LINE 00001096 "=head1 CONTRIBUTORS"
