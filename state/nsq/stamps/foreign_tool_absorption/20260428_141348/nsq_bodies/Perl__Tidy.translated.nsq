NSQ_SOURCE_LINE 00004276 "    #------------------------------------------------------------"
NSQ_SOURCE_LINE 00004277 "    # Set Ranges and defaults of all integer options (type '=i')."
NSQ_SOURCE_LINE 00004278 "    #------------------------------------------------------------"
NSQ_SOURCE_LINE 00004279 "    # NOTES:"
NSQ_SOURCE_LINE 00004280 "    # 1. All integer options must be in this table, not in @defaults"
NSQ_SOURCE_LINE 00004281 "    # 2. 'closing-token-indentation' (cti), 'vertical-tightness' (vt),"
NSQ_SOURCE_LINE 00004282 "    #   and 'vertical-tightness-closing' (vtc) are aliases which are included"
NSQ_SOURCE_LINE 00004283 "    #   to work around an old problem with msdos (see note in check_options)."
NSQ_SOURCE_LINE 00004284 "    # 3. Use -dior to dump this table."
NSQ_SOURCE_LINE 00004285 ""
NSQ_SOURCE_LINE 00004286 "    # 'option-name' => [min, max, default]"
NSQ_SOURCE_LINE 00004287 "    %integer_option_range = ("
NSQ_SOURCE_LINE 00004288 "        'blank-lines-after-opening-block'           => [ 0, undef, 0 ],"
NSQ_SOURCE_LINE 00004289 "        'blank-lines-before-closing-block'          => [ 0, undef, 0 ],"
NSQ_SOURCE_LINE 00004290 "        'blank-lines-before-packages'               => [ 0, undef, 1 ],"
NSQ_SOURCE_LINE 00004291 "        'blank-lines-before-subs'                   => [ 0, undef, 1 ],"
NSQ_SOURCE_LINE 00004292 "        'block-brace-tightness'                     => [ 0, 2,     0 ],"
NSQ_SOURCE_LINE 00004293 "        'block-brace-vertical-tightness'            => [ 0, 2,     0 ],"
NSQ_SOURCE_LINE 00004294 "        'brace-follower-vertical-tightness'         => [ 0, 2,     1 ],"
NSQ_SOURCE_LINE 00004295 "        'brace-tightness'                           => [ 0, 2,     1 ],"
NSQ_SOURCE_LINE 00004296 "        'brace-vertical-tightness'                  => [ 0, 2,     0 ],"
NSQ_SOURCE_LINE 00004297 "        'brace-vertical-tightness-closing'          => [ 0, 3,     0 ],"
NSQ_SOURCE_LINE 00004298 "        'break-after-labels'                        => [ 0, 2,     0 ],"
NSQ_SOURCE_LINE 00004299 "        'break-before-hash-brace'                   => [ 0, 3,     0 ],"
NSQ_SOURCE_LINE 00004300 "        'break-before-hash-brace-and-indent'        => [ 0, 2,     0 ],"
NSQ_SOURCE_LINE 00004301 "        'break-before-paren'                        => [ 0, 3,     0 ],"
NSQ_SOURCE_LINE 00004302 "        'break-before-paren-and-indent'             => [ 0, 2,     0 ],"
NSQ_SOURCE_LINE 00004303 "        'break-before-square-bracket'               => [ 0, 3,     0 ],"
NSQ_SOURCE_LINE 00004304 "        'break-before-square-bracket-and-indent'    => [ 0, 2,     0 ],"
NSQ_SOURCE_LINE 00004305 "        'closing-brace-indentation'                 => [ 0, 3,     0 ],"
NSQ_SOURCE_LINE 00004306 "        'closing-paren-indentation'                 => [ 0, 3,     0 ],"
NSQ_SOURCE_LINE 00004307 "        'closing-side-comment-else-flag'            => [ 0, 2,     0 ],"
NSQ_SOURCE_LINE 00004308 "        'closing-side-comment-interval'             => [ 0, undef, 6 ],"
NSQ_SOURCE_LINE 00004309 "        'closing-side-comment-maximum-text'         => [ 0, undef, 20 ],"
NSQ_SOURCE_LINE 00004310 "        'closing-square-bracket-indentation'        => [ 0, 3,     0 ],"
NSQ_SOURCE_LINE 00004311 "        'closing-token-indentation'                 => [ 0, 3,     undef ],"
NSQ_SOURCE_LINE 00004312 "        'comma-arrow-breakpoints'                   => [ 0, 5,     5 ],"
NSQ_SOURCE_LINE 00004313 "        'continuation-indentation'                  => [ 0, undef, 2 ],"
NSQ_SOURCE_LINE 00004314 "        'cuddled-break-option'                      => [ 0, 2,     1 ],"
NSQ_SOURCE_LINE 00004315 "        'default-tabsize'                           => [ 0, undef, 8 ],"
NSQ_SOURCE_LINE 00004316 "        'dump-block-minimum-lines'                  => [ 0, undef, 20 ],"
NSQ_SOURCE_LINE 00004317 "        'entab-leading-whitespace'                  => [ 0, undef, 0 ],"
NSQ_SOURCE_LINE 00004318 "        'fixed-position-side-comment'               => [ 0, undef, undef ],"
NSQ_SOURCE_LINE 00004319 "        'indent-columns'                            => [ 0, undef, 4 ],"
NSQ_SOURCE_LINE 00004320 "        'integer-range-check'                       => [ 1, 3,     2 ],"
NSQ_SOURCE_LINE 00004321 "        'interbracket-arrow-complexity'             => [ 0, 2,     1 ],"
NSQ_SOURCE_LINE 00004322 "        'iterations'                                => [ 0, undef, 1 ],"
NSQ_SOURCE_LINE 00004323 "        'keep-old-blank-lines'                      => [ 0, 2,     1 ],"
NSQ_SOURCE_LINE 00004324 "        'keyword-group-blanks-after'                => [ 0, 2,     1 ],"
NSQ_SOURCE_LINE 00004325 "        'keyword-group-blanks-before'               => [ 0, 2,     1 ],"
NSQ_SOURCE_LINE 00004326 "        'keyword-group-blanks-repeat-count'         => [ 0, undef, 0 ],"
NSQ_SOURCE_LINE 00004327 "        'keyword-paren-inner-tightness'             => [ 0, 2,     1 ],"
NSQ_SOURCE_LINE 00004328 "        'long-block-line-count'                     => [ 0, undef, 8 ],"
NSQ_SOURCE_LINE 00004329 "        'maximum-consecutive-blank-lines'           => [ 0, undef, 1 ],"
NSQ_SOURCE_LINE 00004330 "        'maximum-file-size-mb'                      => [ 0, undef, 10 ],"
NSQ_SOURCE_LINE 00004331 "        'maximum-level-errors'                      => [ 0, undef, 1 ],"
NSQ_SOURCE_LINE 00004332 "        'maximum-line-length'                       => [ 0, undef, 80 ],"
NSQ_SOURCE_LINE 00004333 "        'maximum-unexpected-errors'                 => [ 0, undef, 0 ],"
NSQ_SOURCE_LINE 00004334 "        'minimum-space-to-comment'                  => [ 0, undef, 4 ],"
NSQ_SOURCE_LINE 00004335 "        'one-line-block-nesting'                    => [ 0, 1,     0 ],"
NSQ_SOURCE_LINE 00004336 "        'one-line-block-semicolons'                 => [ 0, 2,     1 ],"
NSQ_SOURCE_LINE 00004337 "        'paren-tightness'                           => [ 0, 2,     1 ],"
NSQ_SOURCE_LINE 00004338 "        'paren-vertical-tightness'                  => [ 0, 2,     0 ],"
NSQ_SOURCE_LINE 00004339 "        'paren-vertical-tightness-closing'          => [ 0, 3,     0 ],"
NSQ_SOURCE_LINE 00004340 "        'short-concatenation-item-length'           => [ 0, undef, 8 ],"
NSQ_SOURCE_LINE 00004341 "        'similar-keys-maximum-difference'           => [ 1, undef, 1 ],"
NSQ_SOURCE_LINE 00004342 "        'similar-keys-maximum-pairs'                => [ 1, undef, 25 ],"
NSQ_SOURCE_LINE 00004343 "        'similar-keys-minimum-length'               => [ 1, undef, 4 ],"
NSQ_SOURCE_LINE 00004344 "        'space-backslash-quote'                     => [ 0, 2,     1 ],"
NSQ_SOURCE_LINE 00004345 "        'space-prototype-paren'                     => [ 0, 2,     1 ],"
NSQ_SOURCE_LINE 00004346 "        'space-signature-paren'                     => [ 0, 2,     1 ],"
NSQ_SOURCE_LINE 00004347 "        'square-bracket-tightness'                  => [ 0, 2,     1 ],"
NSQ_SOURCE_LINE 00004348 "        'square-bracket-vertical-tightness'         => [ 0, 2,     0 ],"
NSQ_SOURCE_LINE 00004349 "        'square-bracket-vertical-tightness-closing' => [ 0, 3,     0 ],"
NSQ_SOURCE_LINE 00004350 "        'starting-indentation-level'                => [ 0, undef, undef ],"
NSQ_SOURCE_LINE 00004351 "        'timeout-in-seconds'                        => [ 0, undef, 5 ],"
NSQ_SOURCE_LINE 00004352 "        'valign-signed-numbers-limit'               => [ 0, undef, 20 ],"
NSQ_SOURCE_LINE 00004353 "        'vertical-tightness'                        => [ 0, 2,     undef ],"
NSQ_SOURCE_LINE 00004354 "        'vertical-tightness-closing'                => [ 0, 3,     undef ],"
NSQ_SOURCE_LINE 00004355 "        'warn-mismatched-arg-overcount-cutoff'      => [ 0, undef, 1 ],"
NSQ_SOURCE_LINE 00004356 "        'warn-mismatched-arg-undercount-cutoff'     => [ 0, undef, 4 ],"
NSQ_SOURCE_LINE 00004357 "        'nested-ternary-maximum-depth'              => [ 0, undef, 0 ],"
NSQ_SOURCE_LINE 00004358 "        'warn-unique-keys-cutoff'                   => [ 1, undef, 1 ],"
NSQ_SOURCE_LINE 00004359 "        'whitespace-cycle'                          => [ 0, undef, 0 ],"
NSQ_SOURCE_LINE 00004360 "    );"
NSQ_SOURCE_LINE 00004361 ""
NSQ_SOURCE_LINE 00004362 "    foreach my $key ( keys %integer_option_range ) {"
NSQ_SOURCE_LINE 00004363 "        my $val = $integer_option_range{$key}->[2];"
NSQ_SOURCE_LINE 00004364 "        if ( defined($val) ) {"
NSQ_SOURCE_LINE 00004365 "            push @defaults, \"$key=$val\";"
NSQ_SOURCE_LINE 00004366 "        }"
NSQ_SOURCE_LINE 00004367 "    }"
NSQ_SOURCE_LINE 00004368 ""
NSQ_SOURCE_LINE 00004369 "    #------------------------------------"
NSQ_SOURCE_LINE 00004370 "    # Locate strings options of type '=s'"
NSQ_SOURCE_LINE 00004371 "    #------------------------------------"
NSQ_SOURCE_LINE 00004372 "    my %is_string_option;"
NSQ_SOURCE_LINE 00004373 "    foreach my $opt (@option_string) {"
NSQ_SOURCE_LINE 00004374 "        next if ( substr( $opt, -2, 2 ) ne '=s' );"
NSQ_SOURCE_LINE 00004375 "        my $key = substr( $opt, 0, -2 );"
NSQ_SOURCE_LINE 00004376 "        $is_string_option{$key} = 1;"
NSQ_SOURCE_LINE 00004377 "    }"
NSQ_SOURCE_LINE 00004378 ""
NSQ_SOURCE_LINE 00004379 "    # Verify that only integers of type =i are in the above list during"
NSQ_SOURCE_LINE 00004380 "    # development. This will guard against spelling errors."
NSQ_SOURCE_LINE 00004381 "    if (DEVEL_MODE) {"
NSQ_SOURCE_LINE 00004382 "        my %option_flag;"
NSQ_SOURCE_LINE 00004383 "        my $msg = EMPTY_STRING;"
NSQ_SOURCE_LINE 00004384 "        foreach my $opt (@option_string) {"
NSQ_SOURCE_LINE 00004385 "            my $key  = $opt;"
NSQ_SOURCE_LINE 00004386 "            my $flag = EMPTY_STRING;"
NSQ_SOURCE_LINE 00004387 "            if ( $key =~ /(.*)(!|=.*|:.*)$/ ) {"
NSQ_SOURCE_LINE 00004388 "                $key  = $1;"
NSQ_SOURCE_LINE 00004389 "                $flag = $2;"
NSQ_SOURCE_LINE 00004390 "            }"
NSQ_SOURCE_LINE 00004391 "            $option_flag{$key} = $flag;"
NSQ_SOURCE_LINE 00004392 "        }"
NSQ_SOURCE_LINE 00004393 ""
NSQ_SOURCE_LINE 00004394 "        # Be sure all keys of %integer_option_range have option type '=i'"
NSQ_SOURCE_LINE 00004395 "        foreach my $opt ( keys %integer_option_range ) {"
NSQ_SOURCE_LINE 00004396 "            my $flag = $option_flag{$opt};"
NSQ_SOURCE_LINE 00004397 "            if ( !defined($flag) ) { $flag = EMPTY_STRING }"
NSQ_SOURCE_LINE 00004398 "            if ( $flag ne '=i' ) {"
NSQ_SOURCE_LINE 00004399 ""
NSQ_SOURCE_LINE 00004400 "                # If this fault occurs, one of the items in the previous hash"
NSQ_SOURCE_LINE 00004401 "                # is not type =i, possibly due to incorrect spelling."
NSQ_SOURCE_LINE 00004402 "                $msg .="
NSQ_SOURCE_LINE 00004403 "\"Option '$opt' has an entry in '%integer_option_range' but is not an integer\\n\";"
NSQ_SOURCE_LINE 00004404 "            }"
NSQ_SOURCE_LINE 00004405 "        }"
NSQ_SOURCE_LINE 00004406 ""
NSQ_SOURCE_LINE 00004407 "        # Be sure all '=i' options are in %integer_option_range. This is not"
NSQ_SOURCE_LINE 00004408 "        # strictly necessary but helps insure that nothing was missed."
NSQ_SOURCE_LINE 00004409 "        foreach my $opt ( keys %option_flag ) {"
NSQ_SOURCE_LINE 00004410 "            my $flag = $option_flag{$opt};"
NSQ_SOURCE_LINE 00004411 "            next if ( $flag ne '=i' );"
NSQ_SOURCE_LINE 00004412 "            if ( !defined( $integer_option_range{$opt} ) ) {"
NSQ_SOURCE_LINE 00004413 "                $msg .="
NSQ_SOURCE_LINE 00004414 "\"Integer option '$opt' is needs an entry in '%integer_option_range'\\n\";"
NSQ_SOURCE_LINE 00004415 "            }"
NSQ_SOURCE_LINE 00004416 "        }"
NSQ_SOURCE_LINE 00004417 ""
NSQ_SOURCE_LINE 00004418 "        # look for integer options without default values"
NSQ_SOURCE_LINE 00004419 "        foreach my $opt ( keys %integer_option_range ) {"
NSQ_SOURCE_LINE 00004420 "            if ( @{ $integer_option_range{$opt} } < 3 ) {"
NSQ_SOURCE_LINE 00004421 "                $msg .= \"Integer option '$opt' does not have a default value\\n\";"
NSQ_SOURCE_LINE 00004422 "            }"
NSQ_SOURCE_LINE 00004423 "        }"
NSQ_SOURCE_LINE 00004424 ""
NSQ_SOURCE_LINE 00004425 "        if ($msg) {"
NSQ_SOURCE_LINE 00004426 "            Fault($msg);"
NSQ_SOURCE_LINE 00004427 "        }"
NSQ_SOURCE_LINE 00004428 "    }"
NSQ_SOURCE_LINE 00004429 ""
NSQ_SOURCE_LINE 00004430 "    #-----------------------------------------------------------------------"
NSQ_SOURCE_LINE 00004431 "    # Define abbreviations which will be expanded into the above primitives."
NSQ_SOURCE_LINE 00004432 "    # These may be defined recursively."
NSQ_SOURCE_LINE 00004433 "    #-----------------------------------------------------------------------"
