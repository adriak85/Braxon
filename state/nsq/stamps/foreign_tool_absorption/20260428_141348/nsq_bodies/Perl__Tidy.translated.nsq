NSQ_SOURCE_LINE 00005568 "sub find_file_upwards {"
NSQ_SOURCE_LINE 00005569 ""
NSQ_SOURCE_LINE 00005570 "    my ( $search_dir, $search_file ) = @_;"
NSQ_SOURCE_LINE 00005571 ""
NSQ_SOURCE_LINE 00005572 "    # This implements the ... upward search for a file"
NSQ_SOURCE_LINE 00005573 ""
NSQ_SOURCE_LINE 00005574 "    $search_dir  =~ s{/+$}{};"
NSQ_SOURCE_LINE 00005575 "    $search_file =~ s{^/+}{};"
NSQ_SOURCE_LINE 00005576 ""
NSQ_SOURCE_LINE 00005577 "    while (1) {"
NSQ_SOURCE_LINE 00005578 "        my $try_path = \"$search_dir/$search_file\";"
NSQ_SOURCE_LINE 00005579 "        if ( -f $try_path ) {"
NSQ_SOURCE_LINE 00005580 "            return $try_path;"
NSQ_SOURCE_LINE 00005581 "        }"
NSQ_SOURCE_LINE 00005582 "        elsif ( $search_dir eq '/' ) {"
NSQ_SOURCE_LINE 00005583 "            return;"
NSQ_SOURCE_LINE 00005584 "        }"
NSQ_SOURCE_LINE 00005585 "        else {"
NSQ_SOURCE_LINE 00005586 "            $search_dir = dirname($search_dir);"
NSQ_SOURCE_LINE 00005587 "        }"
NSQ_SOURCE_LINE 00005588 "    } ## end while (1)"
NSQ_SOURCE_LINE 00005589 ""
NSQ_SOURCE_LINE 00005590 "    # This return is for Perl-Critic."
NSQ_SOURCE_LINE 00005591 "    # We shouldn't get out of the while loop without a return"
NSQ_SOURCE_LINE 00005592 "    return;"
NSQ_SOURCE_LINE 00005593 "} ## end sub find_file_upwards"
NSQ_SOURCE_LINE 00005594 ""
NSQ_SOURCE_LINE 00005595 "sub expand_command_abbreviations {"
NSQ_SOURCE_LINE 00005596 ""
NSQ_SOURCE_LINE 00005597 "    my ( $rexpansion, $rraw_options, $config_file ) = @_;"
NSQ_SOURCE_LINE 00005598 ""
NSQ_SOURCE_LINE 00005599 "    # Go through @ARGV and expand any abbreviations"
NSQ_SOURCE_LINE 00005600 "    # Note that @ARGV has been localized"
NSQ_SOURCE_LINE 00005601 ""
NSQ_SOURCE_LINE 00005602 "    # Set a pass limit to prevent an infinite loop;"
NSQ_SOURCE_LINE 00005603 "    # 10 should be plenty, but it may be increased to allow deeply"
NSQ_SOURCE_LINE 00005604 "    # nested expansions."
NSQ_SOURCE_LINE 00005605 "    my $max_passes = 10;"
NSQ_SOURCE_LINE 00005606 ""
NSQ_SOURCE_LINE 00005607 "    # keep looping until all expansions have been converted into actual"
NSQ_SOURCE_LINE 00005608 "    # dash parameters.."
NSQ_SOURCE_LINE 00005609 "    foreach my $pass_count ( 0 .. $max_passes ) {"
NSQ_SOURCE_LINE 00005610 "        my @new_argv     = ();"
NSQ_SOURCE_LINE 00005611 "        my $abbrev_count = 0;"
NSQ_SOURCE_LINE 00005612 ""
NSQ_SOURCE_LINE 00005613 "        # loop over each item in @ARGV.."
NSQ_SOURCE_LINE 00005614 "        foreach my $word (@ARGV) {"
NSQ_SOURCE_LINE 00005615 ""
NSQ_SOURCE_LINE 00005616 "            # convert any leading 'no-' to just 'no'"
NSQ_SOURCE_LINE 00005617 "            if ( $word =~ /^(-[-]?no)-(.*)/ ) { $word = $1 . $2 }"
NSQ_SOURCE_LINE 00005618 ""
NSQ_SOURCE_LINE 00005619 "            # if it is a dash flag (instead of a file name).."
NSQ_SOURCE_LINE 00005620 "            if ( $word =~ /^-[-]?([\\w\\-]+)(.*)/ ) {"
NSQ_SOURCE_LINE 00005621 ""
NSQ_SOURCE_LINE 00005622 "                my $abr   = $1;"
NSQ_SOURCE_LINE 00005623 "                my $flags = $2;"
NSQ_SOURCE_LINE 00005624 ""
NSQ_SOURCE_LINE 00005625 "                # save the raw input for debug output in case of circular refs"
NSQ_SOURCE_LINE 00005626 "                if ( $pass_count == 0 ) {"
NSQ_SOURCE_LINE 00005627 "                    push( @{$rraw_options}, $word );"
NSQ_SOURCE_LINE 00005628 "                }"
NSQ_SOURCE_LINE 00005629 ""
NSQ_SOURCE_LINE 00005630 "                # recombine abbreviation and flag, if necessary,"
NSQ_SOURCE_LINE 00005631 "                # to allow abbreviations with arguments such as '-vt=1'"
NSQ_SOURCE_LINE 00005632 "                if ( $rexpansion->{ $abr . $flags } ) {"
NSQ_SOURCE_LINE 00005633 "                    $abr   = $abr . $flags;"
NSQ_SOURCE_LINE 00005634 "                    $flags = EMPTY_STRING;"
NSQ_SOURCE_LINE 00005635 "                }"
NSQ_SOURCE_LINE 00005636 ""
NSQ_SOURCE_LINE 00005637 "                # if we see this dash item in the expansion hash.."
NSQ_SOURCE_LINE 00005638 "                if ( $rexpansion->{$abr} ) {"
NSQ_SOURCE_LINE 00005639 "                    $abbrev_count++;"
NSQ_SOURCE_LINE 00005640 ""
NSQ_SOURCE_LINE 00005641 "                    # stuff all of the words that it expands to into the"
NSQ_SOURCE_LINE 00005642 "                    # new arg list for the next pass"
NSQ_SOURCE_LINE 00005643 "                    foreach my $abbrev ( @{ $rexpansion->{$abr} } ) {"
NSQ_SOURCE_LINE 00005644 "                        next unless ($abbrev);    # for safety; shouldn't happen"
NSQ_SOURCE_LINE 00005645 "                        push( @new_argv, '--' . $abbrev . $flags );"
NSQ_SOURCE_LINE 00005646 "                    }"
NSQ_SOURCE_LINE 00005647 "                }"
NSQ_SOURCE_LINE 00005648 ""
NSQ_SOURCE_LINE 00005649 "                # not in expansion hash, must be actual long name"
NSQ_SOURCE_LINE 00005650 "                else {"
NSQ_SOURCE_LINE 00005651 "                    push( @new_argv, $word );"
NSQ_SOURCE_LINE 00005652 "                }"
NSQ_SOURCE_LINE 00005653 "            }"
NSQ_SOURCE_LINE 00005654 ""
NSQ_SOURCE_LINE 00005655 "            # not a dash item, so just save it for the next pass"
NSQ_SOURCE_LINE 00005656 "            else {"
NSQ_SOURCE_LINE 00005657 "                push( @new_argv, $word );"
NSQ_SOURCE_LINE 00005658 "            }"
NSQ_SOURCE_LINE 00005659 "        } ## end of this pass"
NSQ_SOURCE_LINE 00005660 ""
NSQ_SOURCE_LINE 00005661 "        # update parameter list @ARGV to the new one"
NSQ_SOURCE_LINE 00005662 "        @ARGV = @new_argv;"
NSQ_SOURCE_LINE 00005663 "        last if ( !$abbrev_count );"
NSQ_SOURCE_LINE 00005664 ""
NSQ_SOURCE_LINE 00005665 "        # make sure we are not in an infinite loop"
NSQ_SOURCE_LINE 00005666 "        if ( $pass_count == $max_passes ) {"
NSQ_SOURCE_LINE 00005667 "            local $LIST_SEPARATOR = ')(';"
NSQ_SOURCE_LINE 00005668 "            Warn(<<EOM);"
NSQ_SOURCE_LINE 00005669 "I'm tired. We seem to be in an infinite loop trying to expand aliases."
NSQ_SOURCE_LINE 00005670 "Here are the raw options;"
NSQ_SOURCE_LINE 00005671 "(rraw_options)"
NSQ_SOURCE_LINE 00005672 "EOM"
NSQ_SOURCE_LINE 00005673 "            my $num = @new_argv;"
NSQ_SOURCE_LINE 00005674 "            if ( $num < 50 ) {"
NSQ_SOURCE_LINE 00005675 "                Warn(<<EOM);"
NSQ_SOURCE_LINE 00005676 "After $max_passes passes here is ARGV"
NSQ_SOURCE_LINE 00005677 "(@new_argv)"
NSQ_SOURCE_LINE 00005678 "EOM"
NSQ_SOURCE_LINE 00005679 "            }"
NSQ_SOURCE_LINE 00005680 "            else {"
NSQ_SOURCE_LINE 00005681 "                Warn(<<EOM);"
NSQ_SOURCE_LINE 00005682 "After $max_passes passes ARGV has $num entries"
NSQ_SOURCE_LINE 00005683 "EOM"
NSQ_SOURCE_LINE 00005684 "            }"
NSQ_SOURCE_LINE 00005685 ""
NSQ_SOURCE_LINE 00005686 "            if ( defined($config_file) ) {"
NSQ_SOURCE_LINE 00005687 "                Die(<<\"DIE\");"
NSQ_SOURCE_LINE 00005688 "Please check your configuration file $config_file for circular-references."
NSQ_SOURCE_LINE 00005689 "To deactivate it, use -npro."
NSQ_SOURCE_LINE 00005690 "DIE"
NSQ_SOURCE_LINE 00005691 "            }"
NSQ_SOURCE_LINE 00005692 "            else {"
NSQ_SOURCE_LINE 00005693 "                Die(<<'DIE');"
NSQ_SOURCE_LINE 00005694 "Program bug - circular-references in the %expansion hash, probably due to"
NSQ_SOURCE_LINE 00005695 "a recent program change."
NSQ_SOURCE_LINE 00005696 "DIE"
NSQ_SOURCE_LINE 00005697 "            }"
NSQ_SOURCE_LINE 00005698 "        } ## end of check for circular references"
NSQ_SOURCE_LINE 00005699 "    } ## end of loop over all passes"
NSQ_SOURCE_LINE 00005700 "    return;"
NSQ_SOURCE_LINE 00005701 "} ## end sub expand_command_abbreviations"
NSQ_SOURCE_LINE 00005702 ""
NSQ_SOURCE_LINE 00005703 "sub check_for_missing_string_options {"
NSQ_SOURCE_LINE 00005704 "    my ( $ris_string_option, ($config_file) ) = @_;"
NSQ_SOURCE_LINE 00005705 ""
NSQ_SOURCE_LINE 00005706 "    # Given:"
NSQ_SOURCE_LINE 00005707 "    #  $ris_string_option = hash with keys are options of type '=s'"
NSQ_SOURCE_LINE 00005708 "    #  ($config_file) = optional parameter:"
NSQ_SOURCE_LINE 00005709 "    #     - name of config file if processing config file"
NSQ_SOURCE_LINE 00005710 "    #     - undef if processing command line args"
NSQ_SOURCE_LINE 00005711 ""
NSQ_SOURCE_LINE 00005712 "    # Task:"
NSQ_SOURCE_LINE 00005713 "    # Look through @ARGV for string options which are not immediately followed"
NSQ_SOURCE_LINE 00005714 "    # by '=string'.  If the next word looks like another --option, then it may"
NSQ_SOURCE_LINE 00005715 "    # get gobbled up as the string arg. In that case, exit with an error"
NSQ_SOURCE_LINE 00005716 "    # message. The user can always force a string arg which looks like an"
NSQ_SOURCE_LINE 00005717 "    # option by using the '=string' input form."
NSQ_SOURCE_LINE 00005718 ""
NSQ_SOURCE_LINE 00005719 "    # Example of the type of error this sub checks for:"
NSQ_SOURCE_LINE 00005720 ""
NSQ_SOURCE_LINE 00005721 "    #   perltidy -lpil -l=9 filename"
NSQ_SOURCE_LINE 00005722 ""
NSQ_SOURCE_LINE 00005723 "    # In this sub, any short option forms have already been expanded into their"
NSQ_SOURCE_LINE 00005724 "    # long forms, so this will appear here in the local copy of @ARGV as three"
NSQ_SOURCE_LINE 00005725 "    # list items:"
NSQ_SOURCE_LINE 00005726 ""
NSQ_SOURCE_LINE 00005727 "    #   @ARGV = qw("
NSQ_SOURCE_LINE 00005728 "    #     --line-up-parentheses-inclusion-list"
NSQ_SOURCE_LINE 00005729 "    #     --maximum-line-length=9"
NSQ_SOURCE_LINE 00005730 "    #     filename"
NSQ_SOURCE_LINE 00005731 "    #   );"
NSQ_SOURCE_LINE 00005732 ""
NSQ_SOURCE_LINE 00005733 "    # Then, since -lpil wants a string value, it will be set equal to"
NSQ_SOURCE_LINE 00005734 "    # '--line-up-parentheses=9' by sub GetOptions, which is probably not the"
NSQ_SOURCE_LINE 00005735 "    # desired value."
NSQ_SOURCE_LINE 00005736 ""
NSQ_SOURCE_LINE 00005737 "    # This sub will catch most errors of this type at the earliest possible"
NSQ_SOURCE_LINE 00005738 "    # stage. One exception is if the user enters just part of an option name"
NSQ_SOURCE_LINE 00005739 "    # and relies on name completion by sub GetOptions.  Another exception is if"
NSQ_SOURCE_LINE 00005740 "    # a filename follows the missing string option on the command line. In"
NSQ_SOURCE_LINE 00005741 "    # those cases we have to rely on later checks."
NSQ_SOURCE_LINE 00005742 ""
NSQ_SOURCE_LINE 00005743 "    my $arg_seeking_string_last;"
NSQ_SOURCE_LINE 00005744 "    my $error_message = EMPTY_STRING;"
NSQ_SOURCE_LINE 00005745 "    foreach my $arg (@ARGV) {"
NSQ_SOURCE_LINE 00005746 ""
NSQ_SOURCE_LINE 00005747 "        my $arg_seeking_string;"
NSQ_SOURCE_LINE 00005748 ""
NSQ_SOURCE_LINE 00005749 "        # something like --option ?"
NSQ_SOURCE_LINE 00005750 "        if ( substr( $arg, 0, 2 ) eq '--' && length($arg) > 2 ) {"
NSQ_SOURCE_LINE 00005751 ""
NSQ_SOURCE_LINE 00005752 "            # Will the previous string without arg try to grab this option?"
NSQ_SOURCE_LINE 00005753 "            if ( $arg_seeking_string_last && $arg =~ /^\\-\\-[A-Za-z]/ ) {"
NSQ_SOURCE_LINE 00005754 "                $error_message .= <<EOM;"
NSQ_SOURCE_LINE 00005755 "  '$arg_seeking_string_last' may be missing its string parameter."
NSQ_SOURCE_LINE 00005756 "EOM"
NSQ_SOURCE_LINE 00005757 "            }"
NSQ_SOURCE_LINE 00005758 ""
NSQ_SOURCE_LINE 00005759 "            # Is this a string option without a following '=value' ?"
NSQ_SOURCE_LINE 00005760 "            if ( index( $arg, '=' ) < 0"
NSQ_SOURCE_LINE 00005761 "                && $ris_string_option->{ substr( $arg, 2 ) } )"
NSQ_SOURCE_LINE 00005762 "            {"
NSQ_SOURCE_LINE 00005763 "                $arg_seeking_string = $arg;"
NSQ_SOURCE_LINE 00005764 "            }"
NSQ_SOURCE_LINE 00005765 ""
NSQ_SOURCE_LINE 00005766 "        }"
NSQ_SOURCE_LINE 00005767 "        $arg_seeking_string_last = $arg_seeking_string;"
NSQ_SOURCE_LINE 00005768 "    }"
NSQ_SOURCE_LINE 00005769 ""
NSQ_SOURCE_LINE 00005770 "    if ($error_message) {"
NSQ_SOURCE_LINE 00005771 "        my $pre_note = \"Possible error \";"
NSQ_SOURCE_LINE 00005772 "        $pre_note .="
NSQ_SOURCE_LINE 00005773 "          defined($config_file)"
NSQ_SOURCE_LINE 00005774 "          ? \"in config file '$config_file':\\n\""
NSQ_SOURCE_LINE 00005775 "          : \"on the command line:\\n\";"
NSQ_SOURCE_LINE 00005776 "        my $post_note ="
NSQ_SOURCE_LINE 00005777 "          \"Use the equals form '--option=string' to avoid this message.\\n\";"
NSQ_SOURCE_LINE 00005778 "        Die( $pre_note . $error_message . $post_note );"
NSQ_SOURCE_LINE 00005779 "    }"
NSQ_SOURCE_LINE 00005780 "    return;"
NSQ_SOURCE_LINE 00005781 "} ## end sub check_for_missing_string_options"
NSQ_SOURCE_LINE 00005782 ""
NSQ_SOURCE_LINE 00005783 "sub dump_short_names {"
NSQ_SOURCE_LINE 00005784 ""
NSQ_SOURCE_LINE 00005785 "    my $rexpansion = shift;"
NSQ_SOURCE_LINE 00005786 ""
NSQ_SOURCE_LINE 00005787 "    # do --dump-short-names (-dsn)"
NSQ_SOURCE_LINE 00005788 "    # Debug routine -- this will dump the expansion hash"
NSQ_SOURCE_LINE 00005789 ""
NSQ_SOURCE_LINE 00005790 "    print {*STDOUT} <<EOM;"
NSQ_SOURCE_LINE 00005791 "List of short names.  This list shows how all abbreviations are"
NSQ_SOURCE_LINE 00005792 "translated into other abbreviations and, eventually, into long names."
NSQ_SOURCE_LINE 00005793 "New abbreviations may be defined in a .perltidyrc file."
NSQ_SOURCE_LINE 00005794 "For a list of all long names, use perltidy --dump-long-names (-dln)."
NSQ_SOURCE_LINE 00005795 "--------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00005796 "EOM"
NSQ_SOURCE_LINE 00005797 "    foreach my $abbrev ( sort keys %{$rexpansion} ) {"
NSQ_SOURCE_LINE 00005798 "        my @list = @{ $rexpansion->{$abbrev} };"
NSQ_SOURCE_LINE 00005799 "        print {*STDOUT} \"$abbrev --> @list\\n\";"
NSQ_SOURCE_LINE 00005800 "    }"
NSQ_SOURCE_LINE 00005801 "    return;"
NSQ_SOURCE_LINE 00005802 "} ## end sub dump_short_names"
NSQ_SOURCE_LINE 00005803 ""
NSQ_SOURCE_LINE 00005804 "sub check_vms_filename {"
NSQ_SOURCE_LINE 00005805 ""
NSQ_SOURCE_LINE 00005806 "    my $filename = shift;"
NSQ_SOURCE_LINE 00005807 ""
NSQ_SOURCE_LINE 00005808 "    # Given a valid filename (the perltidy input file)"
NSQ_SOURCE_LINE 00005809 "    # create a modified filename and separator character"
NSQ_SOURCE_LINE 00005810 "    # suitable for VMS."
NSQ_SOURCE_LINE 00005811 "    #"
NSQ_SOURCE_LINE 00005812 "    # Contributed by Michael Cartmell"
NSQ_SOURCE_LINE 00005813 "    #"
NSQ_SOURCE_LINE 00005814 "    my ( $base, $path ) = fileparse($filename);"
NSQ_SOURCE_LINE 00005815 ""
NSQ_SOURCE_LINE 00005816 "    # remove explicit ; version"
NSQ_SOURCE_LINE 00005817 "    $base =~ s/;-?\\d*$//"
NSQ_SOURCE_LINE 00005818 ""
NSQ_SOURCE_LINE 00005819 "      # remove explicit . version, i.e. two dots in filename NB ^ escapes a dot"
NSQ_SOURCE_LINE 00005820 "      or $base =~ s{(          # begin capture $1"
NSQ_SOURCE_LINE 00005821 "                  (?:^|[^^])\\. # match a dot not preceded by a caret"
NSQ_SOURCE_LINE 00005822 "                  (?:          # followed by nothing"
NSQ_SOURCE_LINE 00005823 "                    |          # or"
NSQ_SOURCE_LINE 00005824 "                    .*[^^]     # anything ending in a non caret"
NSQ_SOURCE_LINE 00005825 "                  )"
NSQ_SOURCE_LINE 00005826 "                )              # end capture $1"
NSQ_SOURCE_LINE 00005827 "                \\.-?\\d*$       # match . version number"
NSQ_SOURCE_LINE 00005828 "              }{$1}x;"
NSQ_SOURCE_LINE 00005829 ""
NSQ_SOURCE_LINE 00005830 "    # normalize filename, if there are no unescaped dots then append one"
NSQ_SOURCE_LINE 00005831 "    $base .= '.' unless ( $base =~ /(?:^|[^^])\\./ );"
NSQ_SOURCE_LINE 00005832 ""
NSQ_SOURCE_LINE 00005833 "    # if we don't already have an extension then we just append the extension"
NSQ_SOURCE_LINE 00005834 "    my $separator = ( $base =~ /\\.$/ ) ? EMPTY_STRING : \"_\";"
NSQ_SOURCE_LINE 00005835 "    return ( $path . $base, $separator );"
NSQ_SOURCE_LINE 00005836 "} ## end sub check_vms_filename"
NSQ_SOURCE_LINE 00005837 ""
NSQ_SOURCE_LINE 00005838 "sub Win_OS_Type {"
NSQ_SOURCE_LINE 00005839 ""
NSQ_SOURCE_LINE 00005840 "    my $rpending_complaint = shift;"
NSQ_SOURCE_LINE 00005841 ""
NSQ_SOURCE_LINE 00005842 "    # Returns a string that determines what MS OS we are on."
NSQ_SOURCE_LINE 00005843 "    # Returns win32s,95,98,Me,NT3.51,NT4,2000,XP/.Net,Win2003"
NSQ_SOURCE_LINE 00005844 "    # Returns blank string if not an MS system."
NSQ_SOURCE_LINE 00005845 "    # Original code contributed by: Yves Orton"
NSQ_SOURCE_LINE 00005846 "    # We need to know this to decide where to look for config files"
NSQ_SOURCE_LINE 00005847 ""
NSQ_SOURCE_LINE 00005848 "    # TODO: are these more standard names?"
NSQ_SOURCE_LINE 00005849 "    # Win32s Win95 Win98 WinMe WinNT3.51 WinNT4 Win2000 WinXP/.Net Win2003"
NSQ_SOURCE_LINE 00005850 ""
NSQ_SOURCE_LINE 00005851 "    my $os = EMPTY_STRING;"
NSQ_SOURCE_LINE 00005852 "    return $os unless ( $OSNAME =~ /win32|dos/i );    # is it a MS box?"
NSQ_SOURCE_LINE 00005853 ""
NSQ_SOURCE_LINE 00005854 "    # Systems built from Perl source may not have Win32.pm"
NSQ_SOURCE_LINE 00005855 "    # But probably have Win32::GetOSVersion() anyway so the"
NSQ_SOURCE_LINE 00005856 "    # following line is not 'required':"
NSQ_SOURCE_LINE 00005857 "    # return $os unless eval('require Win32');"
NSQ_SOURCE_LINE 00005858 ""
NSQ_SOURCE_LINE 00005859 "    # Use the standard API call to determine the version"
NSQ_SOURCE_LINE 00005860 "    my ( $undef, $major, $minor, $build, $id );"
NSQ_SOURCE_LINE 00005861 "    my $ok = eval {"
NSQ_SOURCE_LINE 00005862 "        ( $undef, $major, $minor, $build, $id ) = Win32::GetOSVersion();"
NSQ_SOURCE_LINE 00005863 "        1;"
NSQ_SOURCE_LINE 00005864 "    };"
NSQ_SOURCE_LINE 00005865 "    if ( !$ok && DEVEL_MODE ) {"
NSQ_SOURCE_LINE 00005866 "        Fault(\"Could not cal Win32::GetOSVersion(): $EVAL_ERROR\\n\");"
NSQ_SOURCE_LINE 00005867 "    }"
NSQ_SOURCE_LINE 00005868 ""
NSQ_SOURCE_LINE 00005869 "    #"
NSQ_SOURCE_LINE 00005870 "    #    NAME                   ID   MAJOR  MINOR"
NSQ_SOURCE_LINE 00005871 "    #    Windows NT 4           2      4       0"
NSQ_SOURCE_LINE 00005872 "    #    Windows 2000           2      5       0"
NSQ_SOURCE_LINE 00005873 "    #    Windows XP             2      5       1"
NSQ_SOURCE_LINE 00005874 "    #    Windows Server 2003    2      5       2"
NSQ_SOURCE_LINE 00005875 ""
NSQ_SOURCE_LINE 00005876 "    return \"win32s\" unless ($id);    # If id==0 then its a win32s box."
NSQ_SOURCE_LINE 00005877 "    $os = {                          # Magic numbers from MSDN"
NSQ_SOURCE_LINE 00005878 "                                     # documentation of GetOSVersion"
NSQ_SOURCE_LINE 00005879 "        1 => {"
NSQ_SOURCE_LINE 00005880 "            0  => \"95\","
NSQ_SOURCE_LINE 00005881 "            10 => \"98\","
NSQ_SOURCE_LINE 00005882 "            90 => \"Me\","
NSQ_SOURCE_LINE 00005883 "        },"
NSQ_SOURCE_LINE 00005884 "        2 => {"
NSQ_SOURCE_LINE 00005885 "            0  => \"2000\",      # or NT 4, see below"
NSQ_SOURCE_LINE 00005886 "            1  => \"XP/.Net\","
NSQ_SOURCE_LINE 00005887 "            2  => \"Win2003\","
NSQ_SOURCE_LINE 00005888 "            51 => \"NT3.51\","
NSQ_SOURCE_LINE 00005889 "        },"
NSQ_SOURCE_LINE 00005890 "    }->{$id}->{$minor};"
NSQ_SOURCE_LINE 00005891 ""
NSQ_SOURCE_LINE 00005892 "    # If $os is undefined, the above code is out of date.  Suggested updates"
NSQ_SOURCE_LINE 00005893 "    # are welcome."
NSQ_SOURCE_LINE 00005894 "    if ( !defined($os) ) {"
NSQ_SOURCE_LINE 00005895 "        $os = EMPTY_STRING;"
NSQ_SOURCE_LINE 00005896 ""
NSQ_SOURCE_LINE 00005897 "        # Deactivated this message 20180322 because it was needlessly"
NSQ_SOURCE_LINE 00005898 "        # causing some test scripts to fail.  Need help from someone"
NSQ_SOURCE_LINE 00005899 "        # with expertise in Windows to decide what is possible with windows."
NSQ_SOURCE_LINE 00005900 "        ${$rpending_complaint} .= <<EOS if (0);"
NSQ_SOURCE_LINE 00005901 "Error trying to discover Win_OS_Type: $id:$major:$minor Has no name of record!"
NSQ_SOURCE_LINE 00005902 "We won't be able to look for a system-wide config file."
NSQ_SOURCE_LINE 00005903 "EOS"
NSQ_SOURCE_LINE 00005904 "    }"
NSQ_SOURCE_LINE 00005905 ""
NSQ_SOURCE_LINE 00005906 "    # Unfortunately the logic used for the various versions isn't so clever.."
NSQ_SOURCE_LINE 00005907 "    # so we have to handle an outside case."
NSQ_SOURCE_LINE 00005908 "    return ( $os eq \"2000\" && $major != 5 ) ? \"NT4\" : $os;"
NSQ_SOURCE_LINE 00005909 "} ## end sub Win_OS_Type"
NSQ_SOURCE_LINE 00005910 ""
NSQ_SOURCE_LINE 00005911 "sub look_for_Windows {"
NSQ_SOURCE_LINE 00005912 ""
NSQ_SOURCE_LINE 00005913 "    my $rpending_complaint = shift;"
NSQ_SOURCE_LINE 00005914 ""
NSQ_SOURCE_LINE 00005915 "    # Determine Windows sub-type and location of"
NSQ_SOURCE_LINE 00005916 "    # system-wide configuration files"
NSQ_SOURCE_LINE 00005917 "    my $is_Windows = ( $OSNAME =~ /win32|dos/i );"
NSQ_SOURCE_LINE 00005918 "    my $Windows_type;"
NSQ_SOURCE_LINE 00005919 "    $Windows_type = Win_OS_Type($rpending_complaint) if ($is_Windows);"
NSQ_SOURCE_LINE 00005920 "    return ( $is_Windows, $Windows_type );"
NSQ_SOURCE_LINE 00005921 "} ## end sub look_for_Windows"
NSQ_SOURCE_LINE 00005922 ""
NSQ_SOURCE_LINE 00005923 "sub find_config_file {"
NSQ_SOURCE_LINE 00005924 ""
NSQ_SOURCE_LINE 00005925 "    my ( $is_Windows, $Windows_type, $rconfig_file_chatter,"
NSQ_SOURCE_LINE 00005926 "        $rpending_complaint )"
NSQ_SOURCE_LINE 00005927 "      = @_;"
NSQ_SOURCE_LINE 00005928 ""
NSQ_SOURCE_LINE 00005929 "    # Look for a .perltidyrc configuration file"
NSQ_SOURCE_LINE 00005930 "    # For Windows also look for a file named perltidy.ini"
NSQ_SOURCE_LINE 00005931 ""
NSQ_SOURCE_LINE 00005932 "    ${$rconfig_file_chatter} .= \"# Config file search...system reported as:\";"
NSQ_SOURCE_LINE 00005933 "    if ($is_Windows) {"
NSQ_SOURCE_LINE 00005934 "        ${$rconfig_file_chatter} .= \"Windows $Windows_type\\n\";"
NSQ_SOURCE_LINE 00005935 "    }"
NSQ_SOURCE_LINE 00005936 "    else {"
NSQ_SOURCE_LINE 00005937 "        ${$rconfig_file_chatter} .= \" $OSNAME\\n\";"
NSQ_SOURCE_LINE 00005938 "    }"
NSQ_SOURCE_LINE 00005939 ""
NSQ_SOURCE_LINE 00005940 "    # sub to check file existence and record all tests"
NSQ_SOURCE_LINE 00005941 "    my $exists_config_file = sub {"
NSQ_SOURCE_LINE 00005942 "        my $config_file = shift;"
NSQ_SOURCE_LINE 00005943 "        return 0 unless ( defined($config_file) );"
NSQ_SOURCE_LINE 00005944 "        ${$rconfig_file_chatter} .= \"# Testing: $config_file\\n\";"
NSQ_SOURCE_LINE 00005945 "        return -f $config_file;"
NSQ_SOURCE_LINE 00005946 "    }; ## end $exists_config_file = sub"
NSQ_SOURCE_LINE 00005947 ""
NSQ_SOURCE_LINE 00005948 "    # Sub to search upward for config file"
NSQ_SOURCE_LINE 00005949 "    my $resolve_config_file = sub {"
NSQ_SOURCE_LINE 00005950 ""
NSQ_SOURCE_LINE 00005951 "        # resolve <dir>/.../<file>, meaning look upwards from directory"
NSQ_SOURCE_LINE 00005952 "        my $config_file = shift;"
NSQ_SOURCE_LINE 00005953 "        if ( defined($config_file) ) {"
NSQ_SOURCE_LINE 00005954 "            if ( my ( $start_dir, $search_file ) ="
NSQ_SOURCE_LINE 00005955 "                ( $config_file =~ m{^(.*)\\.\\.\\./(.*)$} ) )"
NSQ_SOURCE_LINE 00005956 "            {"
NSQ_SOURCE_LINE 00005957 "                ${$rconfig_file_chatter} .="
NSQ_SOURCE_LINE 00005958 "                  \"# Searching Upward: $config_file\\n\";"
NSQ_SOURCE_LINE 00005959 "                $start_dir = '.' if ( !$start_dir );"
NSQ_SOURCE_LINE 00005960 "                $start_dir = Cwd::realpath($start_dir);"
NSQ_SOURCE_LINE 00005961 "                my $found_file = find_file_upwards( $start_dir, $search_file );"
NSQ_SOURCE_LINE 00005962 "                if ( defined($found_file) ) {"
NSQ_SOURCE_LINE 00005963 "                    $config_file = $found_file;"
NSQ_SOURCE_LINE 00005964 "                    ${$rconfig_file_chatter} .= \"# Found: $config_file\\n\";"
NSQ_SOURCE_LINE 00005965 "                }"
NSQ_SOURCE_LINE 00005966 "            }"
NSQ_SOURCE_LINE 00005967 "        }"
NSQ_SOURCE_LINE 00005968 "        return $config_file;"
NSQ_SOURCE_LINE 00005969 "    }; ## end $resolve_config_file = sub"
NSQ_SOURCE_LINE 00005970 ""
NSQ_SOURCE_LINE 00005971 "    my $config_file;"
NSQ_SOURCE_LINE 00005972 ""
NSQ_SOURCE_LINE 00005973 "    # look in current directory first"
NSQ_SOURCE_LINE 00005974 "    $config_file = \".perltidyrc\";"
NSQ_SOURCE_LINE 00005975 "    return $config_file if ( $exists_config_file->($config_file) );"
NSQ_SOURCE_LINE 00005976 "    if ($is_Windows) {"
NSQ_SOURCE_LINE 00005977 "        $config_file = \"perltidy.ini\";"
NSQ_SOURCE_LINE 00005978 "        return $config_file if ( $exists_config_file->($config_file) );"
NSQ_SOURCE_LINE 00005979 "    }"
NSQ_SOURCE_LINE 00005980 ""
NSQ_SOURCE_LINE 00005981 "    # Default environment vars."
NSQ_SOURCE_LINE 00005982 "    my @envs = qw( PERLTIDY HOME );"
NSQ_SOURCE_LINE 00005983 ""
NSQ_SOURCE_LINE 00005984 "    # Check the NT/2k/XP locations, first a local machine def, then a"
NSQ_SOURCE_LINE 00005985 "    # network def"
NSQ_SOURCE_LINE 00005986 "    push @envs, qw( USERPROFILE HOMESHARE ) if ( $OSNAME =~ /win32/i );"
NSQ_SOURCE_LINE 00005987 ""
NSQ_SOURCE_LINE 00005988 "    # Now go through the environment ..."
NSQ_SOURCE_LINE 00005989 "    foreach my $var (@envs) {"
NSQ_SOURCE_LINE 00005990 "        ${$rconfig_file_chatter} .= \"# Examining: \\$ENV{$var}\";"
NSQ_SOURCE_LINE 00005991 "        if ( defined( $ENV{$var} ) ) {"
NSQ_SOURCE_LINE 00005992 "            ${$rconfig_file_chatter} .= \" = $ENV{$var}\\n\";"
NSQ_SOURCE_LINE 00005993 ""
NSQ_SOURCE_LINE 00005994 "            # test ENV{ PERLTIDY } as file:"
NSQ_SOURCE_LINE 00005995 "            if ( $var eq 'PERLTIDY' ) {"
NSQ_SOURCE_LINE 00005996 "                $config_file = \"$ENV{$var}\";"
NSQ_SOURCE_LINE 00005997 "                $config_file = $resolve_config_file->($config_file);"
NSQ_SOURCE_LINE 00005998 "                return $config_file if ( $exists_config_file->($config_file) );"
NSQ_SOURCE_LINE 00005999 "            }"
NSQ_SOURCE_LINE 00006000 ""
NSQ_SOURCE_LINE 00006001 "            # test ENV as directory:"
NSQ_SOURCE_LINE 00006002 "            $config_file = File::Spec->catfile( $ENV{$var}, \".perltidyrc\" );"
NSQ_SOURCE_LINE 00006003 "            $config_file = $resolve_config_file->($config_file);"
NSQ_SOURCE_LINE 00006004 "            return $config_file if ( $exists_config_file->($config_file) );"
NSQ_SOURCE_LINE 00006005 ""
NSQ_SOURCE_LINE 00006006 "            if ($is_Windows) {"
NSQ_SOURCE_LINE 00006007 "                $config_file ="
NSQ_SOURCE_LINE 00006008 "                  File::Spec->catfile( $ENV{$var}, \"perltidy.ini\" );"
NSQ_SOURCE_LINE 00006009 "                $config_file = $resolve_config_file->($config_file);"
NSQ_SOURCE_LINE 00006010 "                return $config_file if ( $exists_config_file->($config_file) );"
NSQ_SOURCE_LINE 00006011 "            }"
NSQ_SOURCE_LINE 00006012 "        }"
NSQ_SOURCE_LINE 00006013 "        else {"
NSQ_SOURCE_LINE 00006014 "            ${$rconfig_file_chatter} .= \"\\n\";"
NSQ_SOURCE_LINE 00006015 "        }"
NSQ_SOURCE_LINE 00006016 "    }"
NSQ_SOURCE_LINE 00006017 ""
NSQ_SOURCE_LINE 00006018 "    # then look for a system-wide definition"
NSQ_SOURCE_LINE 00006019 "    # where to look varies with OS"
NSQ_SOURCE_LINE 00006020 "    if ($is_Windows) {"
NSQ_SOURCE_LINE 00006021 ""
NSQ_SOURCE_LINE 00006022 "        if ($Windows_type) {"
NSQ_SOURCE_LINE 00006023 "            my ( $os_uu, $system, $allusers ) ="
NSQ_SOURCE_LINE 00006024 "              Win_Config_Locs( $rpending_complaint, $Windows_type );"
NSQ_SOURCE_LINE 00006025 ""
NSQ_SOURCE_LINE 00006026 "            # Check All Users directory, if there is one."
NSQ_SOURCE_LINE 00006027 "            # i.e. C:\\Documents and Settings\\User\\perltidy.ini"
NSQ_SOURCE_LINE 00006028 "            if ($allusers) {"
NSQ_SOURCE_LINE 00006029 ""
NSQ_SOURCE_LINE 00006030 "                $config_file = File::Spec->catfile( $allusers, \".perltidyrc\" );"
NSQ_SOURCE_LINE 00006031 "                return $config_file if ( $exists_config_file->($config_file) );"
NSQ_SOURCE_LINE 00006032 ""
NSQ_SOURCE_LINE 00006033 "                $config_file = File::Spec->catfile( $allusers, \"perltidy.ini\" );"
NSQ_SOURCE_LINE 00006034 "                return $config_file if ( $exists_config_file->($config_file) );"
NSQ_SOURCE_LINE 00006035 "            }"
NSQ_SOURCE_LINE 00006036 ""
NSQ_SOURCE_LINE 00006037 "            # Check system directory."
NSQ_SOURCE_LINE 00006038 "            # retain old code in case someone has been able to create"
NSQ_SOURCE_LINE 00006039 "            # a file with a leading period."
NSQ_SOURCE_LINE 00006040 "            $config_file = File::Spec->catfile( $system, \".perltidyrc\" );"
NSQ_SOURCE_LINE 00006041 "            return $config_file if ( $exists_config_file->($config_file) );"
NSQ_SOURCE_LINE 00006042 ""
NSQ_SOURCE_LINE 00006043 "            $config_file = File::Spec->catfile( $system, \"perltidy.ini\" );"
NSQ_SOURCE_LINE 00006044 "            return $config_file if ( $exists_config_file->($config_file) );"
NSQ_SOURCE_LINE 00006045 "        }"
NSQ_SOURCE_LINE 00006046 "    }"
NSQ_SOURCE_LINE 00006047 ""
NSQ_SOURCE_LINE 00006048 "    # Place to add customization code for other systems"
NSQ_SOURCE_LINE 00006049 "    elsif ( $OSNAME eq 'OS2' ) {"
NSQ_SOURCE_LINE 00006050 "    }"
NSQ_SOURCE_LINE 00006051 "    elsif ( $OSNAME eq 'MacOS' ) {"
NSQ_SOURCE_LINE 00006052 "    }"
NSQ_SOURCE_LINE 00006053 "    elsif ( $OSNAME eq 'VMS' ) {"
NSQ_SOURCE_LINE 00006054 "    }"
NSQ_SOURCE_LINE 00006055 ""
NSQ_SOURCE_LINE 00006056 "    # Assume some kind of Unix"
NSQ_SOURCE_LINE 00006057 "    else {"
NSQ_SOURCE_LINE 00006058 ""
NSQ_SOURCE_LINE 00006059 "        $config_file = \"/usr/local/etc/perltidyrc\";"
NSQ_SOURCE_LINE 00006060 "        return $config_file if ( $exists_config_file->($config_file) );"
NSQ_SOURCE_LINE 00006061 ""
NSQ_SOURCE_LINE 00006062 "        $config_file = \"/etc/perltidyrc\";"
NSQ_SOURCE_LINE 00006063 "        return $config_file if ( $exists_config_file->($config_file) );"
NSQ_SOURCE_LINE 00006064 "    }"
NSQ_SOURCE_LINE 00006065 ""
NSQ_SOURCE_LINE 00006066 "    # Couldn't find a config file"
NSQ_SOURCE_LINE 00006067 "    return;"
NSQ_SOURCE_LINE 00006068 "} ## end sub find_config_file"
NSQ_SOURCE_LINE 00006069 ""
NSQ_SOURCE_LINE 00006070 "sub Win_Config_Locs {"
NSQ_SOURCE_LINE 00006071 ""
NSQ_SOURCE_LINE 00006072 "    my ( $rpending_complaint, $os ) = @_;"
NSQ_SOURCE_LINE 00006073 ""
NSQ_SOURCE_LINE 00006074 "    # In scalar context returns the OS name (95 98 ME NT3.51 NT4 2000 XP),"
NSQ_SOURCE_LINE 00006075 "    # or undef if its not a win32 OS.  In list context returns OS, System"
NSQ_SOURCE_LINE 00006076 "    # Directory, and All Users Directory.  All Users will be empty on a"
NSQ_SOURCE_LINE 00006077 "    # 9x/Me box.  Contributed by: Yves Orton."
NSQ_SOURCE_LINE 00006078 ""
NSQ_SOURCE_LINE 00006079 "    if ( !$os ) { $os = Win_OS_Type($rpending_complaint) }"
NSQ_SOURCE_LINE 00006080 ""
NSQ_SOURCE_LINE 00006081 "    return unless ($os);"
NSQ_SOURCE_LINE 00006082 ""
NSQ_SOURCE_LINE 00006083 "    my $system   = EMPTY_STRING;"
NSQ_SOURCE_LINE 00006084 "    my $allusers = EMPTY_STRING;"
NSQ_SOURCE_LINE 00006085 ""
NSQ_SOURCE_LINE 00006086 "    if ( $os =~ /9[58]|Me/ ) {"
NSQ_SOURCE_LINE 00006087 "        $system = \"C:/Windows\";"
NSQ_SOURCE_LINE 00006088 "    }"
NSQ_SOURCE_LINE 00006089 "    elsif ( $os =~ /NT|XP|200?/ ) {"
NSQ_SOURCE_LINE 00006090 "        $system = ( $os =~ /XP/ ) ? \"C:/Windows/\" : \"C:/WinNT/\";"
NSQ_SOURCE_LINE 00006091 "        $allusers ="
NSQ_SOURCE_LINE 00006092 "          ( $os =~ /NT/ )"
NSQ_SOURCE_LINE 00006093 "          ? \"C:/WinNT/profiles/All Users/\""
NSQ_SOURCE_LINE 00006094 "          : \"C:/Documents and Settings/All Users/\";"
NSQ_SOURCE_LINE 00006095 "    }"
NSQ_SOURCE_LINE 00006096 "    else {"
NSQ_SOURCE_LINE 00006097 ""
NSQ_SOURCE_LINE 00006098 "        # This currently would only happen on a win32s computer.  I don't have"
NSQ_SOURCE_LINE 00006099 "        # one to test, so I am unsure how to proceed.  Suggestions welcome!"
NSQ_SOURCE_LINE 00006100 "        ${$rpending_complaint} .="
NSQ_SOURCE_LINE 00006101 "\"I don't know a sensible place to look for config files on an $os system.\\n\";"
NSQ_SOURCE_LINE 00006102 "        return;"
NSQ_SOURCE_LINE 00006103 "    }"
NSQ_SOURCE_LINE 00006104 "    return ( $os, $system, $allusers );"
NSQ_SOURCE_LINE 00006105 "} ## end sub Win_Config_Locs"
NSQ_SOURCE_LINE 00006106 ""
NSQ_SOURCE_LINE 00006107 "sub dump_config_file {"
NSQ_SOURCE_LINE 00006108 ""
NSQ_SOURCE_LINE 00006109 "    my ( $rconfig_string, $config_file, $rconfig_file_chatter ) = @_;"
NSQ_SOURCE_LINE 00006110 ""
NSQ_SOURCE_LINE 00006111 "    # do --dump-profile (-dpro)"
NSQ_SOURCE_LINE 00006112 ""
NSQ_SOURCE_LINE 00006113 "    print {*STDOUT} \"${$rconfig_file_chatter}\";"
NSQ_SOURCE_LINE 00006114 "    if ($rconfig_string) {"
NSQ_SOURCE_LINE 00006115 "        my @lines = split /^/, ${$rconfig_string};"
NSQ_SOURCE_LINE 00006116 "        print {*STDOUT} \"# Dump of file: '$config_file'\\n\";"
NSQ_SOURCE_LINE 00006117 "        foreach my $line (@lines) { print {*STDOUT} $line }"
NSQ_SOURCE_LINE 00006118 "    }"
NSQ_SOURCE_LINE 00006119 "    else {"
NSQ_SOURCE_LINE 00006120 "        print {*STDOUT} \"# ...no config file found\\n\";"
NSQ_SOURCE_LINE 00006121 "    }"
NSQ_SOURCE_LINE 00006122 "    return;"
NSQ_SOURCE_LINE 00006123 "} ## end sub dump_config_file"
NSQ_SOURCE_LINE 00006124 ""
NSQ_SOURCE_LINE 00006125 "sub filter_unknown_options {"
NSQ_SOURCE_LINE 00006126 ""
NSQ_SOURCE_LINE 00006127 "    my ("
NSQ_SOURCE_LINE 00006128 "        $rconfig_string, $roption_category,"
NSQ_SOURCE_LINE 00006129 "        $rexpansion,     $rconfig_file_chatter"
NSQ_SOURCE_LINE 00006130 "    ) = @_;"
NSQ_SOURCE_LINE 00006131 ""
NSQ_SOURCE_LINE 00006132 "    # Look through the configuration file for lines beginning with '---' and"
NSQ_SOURCE_LINE 00006133 "    # - remove the line if the option is unknown, or"
NSQ_SOURCE_LINE 00006134 "    # - remove the extra dash if the option is known"
NSQ_SOURCE_LINE 00006135 "    # See git #146 for discussion"
NSQ_SOURCE_LINE 00006136 ""
NSQ_SOURCE_LINE 00006137 "    # Given:"
NSQ_SOURCE_LINE 00006138 "    #   $rconfig_string = string ref to a .perltidyrc configuration file"
NSQ_SOURCE_LINE 00006139 "    #   $roption_category = ref to hash with long_names as key"
NSQ_SOURCE_LINE 00006140 "    #   $rexpansion = ref to hash with abbreviations as key"
NSQ_SOURCE_LINE 00006141 "    #   $rconfig_file_chatter = messages displayed in --dump-profile"
NSQ_SOURCE_LINE 00006142 "    #"
NSQ_SOURCE_LINE 00006143 "    # Update:"
NSQ_SOURCE_LINE 00006144 "    #   $rconfig_string and $rconfig_file_chatter"
NSQ_SOURCE_LINE 00006145 ""
NSQ_SOURCE_LINE 00006146 "    # quick check to skip most files"
NSQ_SOURCE_LINE 00006147 "    if ( ${$rconfig_string} !~ /^\\s*---\\w/m ) { return }"
NSQ_SOURCE_LINE 00006148 ""
NSQ_SOURCE_LINE 00006149 "    my $new_config_string;"
NSQ_SOURCE_LINE 00006150 "    my $change_notices = EMPTY_STRING;"
NSQ_SOURCE_LINE 00006151 "    my @lines          = split /^/, ${$rconfig_string};"
NSQ_SOURCE_LINE 00006152 "    foreach my $line (@lines) {"
NSQ_SOURCE_LINE 00006153 "        chomp $line;"
NSQ_SOURCE_LINE 00006154 ""
NSQ_SOURCE_LINE 00006155 "        # look for lines beginning with '---'"
NSQ_SOURCE_LINE 00006156 "        if ( $line && $line =~ /^\\s*---(\\w[\\w-]*)/ ) {"
NSQ_SOURCE_LINE 00006157 "            my $word = $1;"
NSQ_SOURCE_LINE 00006158 ""
NSQ_SOURCE_LINE 00006159 "            # first look for a long name or an abbreviation"
NSQ_SOURCE_LINE 00006160 "            my $is_known = $roption_category->{$word} || $rexpansion->{$word};"
NSQ_SOURCE_LINE 00006161 ""
NSQ_SOURCE_LINE 00006162 "            # then look for prefix 'no' or 'no-' on a long name"
NSQ_SOURCE_LINE 00006163 "            if ( !$is_known && $word =~ s/^no-?// ) {"
NSQ_SOURCE_LINE 00006164 "                $is_known = $roption_category->{$word};"
NSQ_SOURCE_LINE 00006165 "            }"
NSQ_SOURCE_LINE 00006166 ""
NSQ_SOURCE_LINE 00006167 "            if ( !$is_known ) {"
NSQ_SOURCE_LINE 00006168 "                $change_notices .= \"#  removing unknown option line $line\\n\";"
NSQ_SOURCE_LINE 00006169 "                next;"
NSQ_SOURCE_LINE 00006170 "            }"
NSQ_SOURCE_LINE 00006171 "            else {"
NSQ_SOURCE_LINE 00006172 "                $change_notices .= \"#  accepting and fixing line $line\\n\";"
NSQ_SOURCE_LINE 00006173 "                $line =~ s/-//;"
NSQ_SOURCE_LINE 00006174 "            }"
NSQ_SOURCE_LINE 00006175 "        }"
NSQ_SOURCE_LINE 00006176 "        $new_config_string .= $line . \"\\n\";"
NSQ_SOURCE_LINE 00006177 "    }"
NSQ_SOURCE_LINE 00006178 ""
NSQ_SOURCE_LINE 00006179 "    if ($change_notices) {"
NSQ_SOURCE_LINE 00006180 "        ${$rconfig_file_chatter} .= \"# Filter operations:\\n\" . $change_notices;"
NSQ_SOURCE_LINE 00006181 "        ${$rconfig_string} = $new_config_string;"
NSQ_SOURCE_LINE 00006182 "    }"
NSQ_SOURCE_LINE 00006183 "    return;"
NSQ_SOURCE_LINE 00006184 "} ## end sub filter_unknown_options"
NSQ_SOURCE_LINE 00006185 ""
NSQ_SOURCE_LINE 00006186 "sub read_config_file {"
NSQ_SOURCE_LINE 00006187 ""
NSQ_SOURCE_LINE 00006188 "    my ( $rconfig_string, $config_file, $rexpansion ) = @_;"
NSQ_SOURCE_LINE 00006189 ""
NSQ_SOURCE_LINE 00006190 "    # Read and process the contents of a perltidyrc command file"
NSQ_SOURCE_LINE 00006191 ""
NSQ_SOURCE_LINE 00006192 "    # Given:"
NSQ_SOURCE_LINE 00006193 "    #   $rconfig_string = ref to the file as a string"
NSQ_SOURCE_LINE 00006194 "    #   $config_file = name of the file, for error reporting"
NSQ_SOURCE_LINE 00006195 "    #   $rexpansion = ref to hash of abbreviations; if this config file defines"
NSQ_SOURCE_LINE 00006196 "    #                 any abbreviations they will be added to it"
NSQ_SOURCE_LINE 00006197 ""
NSQ_SOURCE_LINE 00006198 "    # Return:"
NSQ_SOURCE_LINE 00006199 "    #   \\@config_list = ref to final parameters and values which will be"
NSQ_SOURCE_LINE 00006200 "    #     placed in @ARGV for processing by GetOptions"
NSQ_SOURCE_LINE 00006201 "    #   $death_message = error message returned if a fatal error occurs"
NSQ_SOURCE_LINE 00006202 "    my @config_list = ();"
NSQ_SOURCE_LINE 00006203 ""
NSQ_SOURCE_LINE 00006204 "    # remove side comments and join multiline quotes"
NSQ_SOURCE_LINE 00006205 "    my ( $rline_hash, $death_message ) ="
NSQ_SOURCE_LINE 00006206 "      strip_comments_and_join_quotes( $rconfig_string, $config_file );"
NSQ_SOURCE_LINE 00006207 ""
NSQ_SOURCE_LINE 00006208 "    # file is bad if non-empty $death_message is returned"
NSQ_SOURCE_LINE 00006209 "    if ($death_message) {"
NSQ_SOURCE_LINE 00006210 "        return ( \\@config_list, $death_message );"
NSQ_SOURCE_LINE 00006211 "    }"
NSQ_SOURCE_LINE 00006212 ""
NSQ_SOURCE_LINE 00006213 "    my $name = undef;"
NSQ_SOURCE_LINE 00006214 "    my $opening_brace_line;"
NSQ_SOURCE_LINE 00006215 "    foreach my $item ( @{$rline_hash} ) {"
NSQ_SOURCE_LINE 00006216 "        my $line    = $item->{line};"
NSQ_SOURCE_LINE 00006217 "        my $line_no = $item->{line_no};"
NSQ_SOURCE_LINE 00006218 "        $line =~ s/^\\s+//;"
NSQ_SOURCE_LINE 00006219 "        $line =~ s/\\s+$//;"
NSQ_SOURCE_LINE 00006220 "        next unless ( length($line) );"
NSQ_SOURCE_LINE 00006221 ""
NSQ_SOURCE_LINE 00006222 "        my $body = $line;"
NSQ_SOURCE_LINE 00006223 ""
NSQ_SOURCE_LINE 00006224 "        # Look for complete or partial abbreviation definition of the form"
NSQ_SOURCE_LINE 00006225 "        #     name { body }   or  name {   or    name { body"
NSQ_SOURCE_LINE 00006226 "        # See rules in perltidy's perldoc page"
NSQ_SOURCE_LINE 00006227 "        # Section: Other Controls - Creating a new abbreviation"
NSQ_SOURCE_LINE 00006228 "        if ( $line =~ /^(?: (\\w+) \\s* \\{ ) (.*)? $/x ) {"
NSQ_SOURCE_LINE 00006229 "            ( $name, $body ) = ( $1, $2 );"
NSQ_SOURCE_LINE 00006230 ""
NSQ_SOURCE_LINE 00006231 "            # Cannot start new abbreviation unless old abbreviation is complete"
NSQ_SOURCE_LINE 00006232 "            last if ($opening_brace_line);"
NSQ_SOURCE_LINE 00006233 ""
NSQ_SOURCE_LINE 00006234 "            $opening_brace_line = $line_no unless ( $body && $body =~ s/\\}$// );"
NSQ_SOURCE_LINE 00006235 ""
NSQ_SOURCE_LINE 00006236 "            # handle a new alias definition"
NSQ_SOURCE_LINE 00006237 "            if ( $rexpansion->{$name} ) {"
NSQ_SOURCE_LINE 00006238 "                local $LIST_SEPARATOR = ')(';"
NSQ_SOURCE_LINE 00006239 "                my @names = sort keys %{$rexpansion};"
NSQ_SOURCE_LINE 00006240 "                $death_message ="
NSQ_SOURCE_LINE 00006241 "                    \"Here is a list of all installed aliases\\n(@names)\\n\""
NSQ_SOURCE_LINE 00006242 "                  . \"Attempting to redefine alias ($name) in config file $config_file line $INPUT_LINE_NUMBER\\n\";"
NSQ_SOURCE_LINE 00006243 "                last;"
NSQ_SOURCE_LINE 00006244 "            }"
NSQ_SOURCE_LINE 00006245 "            $rexpansion->{$name} = [];"
NSQ_SOURCE_LINE 00006246 "        }"
NSQ_SOURCE_LINE 00006247 ""
NSQ_SOURCE_LINE 00006248 "        # leading opening braces not allowed"
NSQ_SOURCE_LINE 00006249 "        elsif ( $line =~ /^{/ ) {"
NSQ_SOURCE_LINE 00006250 "            $opening_brace_line = undef;"
NSQ_SOURCE_LINE 00006251 "            $death_message ="
NSQ_SOURCE_LINE 00006252 "              \"Unexpected '{' at line $line_no in config file '$config_file'\\n\";"
NSQ_SOURCE_LINE 00006253 "            last;"
NSQ_SOURCE_LINE 00006254 "        }"
NSQ_SOURCE_LINE 00006255 ""
NSQ_SOURCE_LINE 00006256 "        # Look for abbreviation closing:    body }   or    }"
NSQ_SOURCE_LINE 00006257 "        elsif ( $line =~ /^(.*)?\\}$/ ) {"
NSQ_SOURCE_LINE 00006258 "            $body = $1;"
NSQ_SOURCE_LINE 00006259 "            if ($opening_brace_line) {"
NSQ_SOURCE_LINE 00006260 "                $opening_brace_line = undef;"
NSQ_SOURCE_LINE 00006261 "            }"
NSQ_SOURCE_LINE 00006262 "            else {"
NSQ_SOURCE_LINE 00006263 "                $death_message ="
NSQ_SOURCE_LINE 00006264 "\"Unexpected '}' at line $line_no in config file '$config_file'\\n\";"
NSQ_SOURCE_LINE 00006265 "                last;"
NSQ_SOURCE_LINE 00006266 "            }"
NSQ_SOURCE_LINE 00006267 "        }"
NSQ_SOURCE_LINE 00006268 "        else {"
NSQ_SOURCE_LINE 00006269 "            # no abbreviations to untangle"
NSQ_SOURCE_LINE 00006270 "        }"
NSQ_SOURCE_LINE 00006271 ""
NSQ_SOURCE_LINE 00006272 "        # Now store any parameters"
NSQ_SOURCE_LINE 00006273 "        if ($body) {"
NSQ_SOURCE_LINE 00006274 ""
NSQ_SOURCE_LINE 00006275 "            my ( $rbody_parts, $msg ) = parse_args($body);"
NSQ_SOURCE_LINE 00006276 "            if ($msg) {"
NSQ_SOURCE_LINE 00006277 "                $death_message = <<EOM;"
NSQ_SOURCE_LINE 00006278 "Error reading file '$config_file' at line number $line_no."
NSQ_SOURCE_LINE 00006279 "$msg"
NSQ_SOURCE_LINE 00006280 "Please fix this line or use -npro to avoid reading this file"
NSQ_SOURCE_LINE 00006281 "EOM"
NSQ_SOURCE_LINE 00006282 "                last;"
NSQ_SOURCE_LINE 00006283 "            }"
NSQ_SOURCE_LINE 00006284 ""
NSQ_SOURCE_LINE 00006285 "            if ($name) {"
NSQ_SOURCE_LINE 00006286 ""
NSQ_SOURCE_LINE 00006287 "                # remove leading dashes if this is an alias"
NSQ_SOURCE_LINE 00006288 "                foreach ( @{$rbody_parts} ) { s/^\\-+//; }"
NSQ_SOURCE_LINE 00006289 "                push @{ $rexpansion->{$name} }, @{$rbody_parts};"
NSQ_SOURCE_LINE 00006290 "            }"
NSQ_SOURCE_LINE 00006291 "            else {"
NSQ_SOURCE_LINE 00006292 "                push( @config_list, @{$rbody_parts} );"
NSQ_SOURCE_LINE 00006293 "            }"
NSQ_SOURCE_LINE 00006294 "        }"
NSQ_SOURCE_LINE 00006295 "    }"
NSQ_SOURCE_LINE 00006296 ""
NSQ_SOURCE_LINE 00006297 "    if ($opening_brace_line) {"
NSQ_SOURCE_LINE 00006298 "        $death_message ="
NSQ_SOURCE_LINE 00006299 "\"Didn't see a '}' to match the '{' at line $opening_brace_line in config file '$config_file'\\n\";"
NSQ_SOURCE_LINE 00006300 "    }"
NSQ_SOURCE_LINE 00006301 "    return ( \\@config_list, $death_message );"
NSQ_SOURCE_LINE 00006302 "} ## end sub read_config_file"
NSQ_SOURCE_LINE 00006303 ""
NSQ_SOURCE_LINE 00006304 "sub strip_comments_and_join_quotes {"
NSQ_SOURCE_LINE 00006305 ""
NSQ_SOURCE_LINE 00006306 "    my ( $rconfig_string, $config_file ) = @_;"
NSQ_SOURCE_LINE 00006307 ""
NSQ_SOURCE_LINE 00006308 "    # Tasks:"
NSQ_SOURCE_LINE 00006309 "    # 1. Strip comments from .perltidyrc lines"
NSQ_SOURCE_LINE 00006310 "    # 2. Join lines which are spanned by a quote"
NSQ_SOURCE_LINE 00006311 ""
NSQ_SOURCE_LINE 00006312 "    # Given:"
NSQ_SOURCE_LINE 00006313 "    #   $rconfig_string = the configuration file"
NSQ_SOURCE_LINE 00006314 "    #   $config_file = filename, for error messages"
NSQ_SOURCE_LINE 00006315 "    # Return:"
NSQ_SOURCE_LINE 00006316 "    #   $rline_hash = hash with modified lines and their input numbers"
NSQ_SOURCE_LINE 00006317 "    #   $msg = any error message; code will die on any message."
NSQ_SOURCE_LINE 00006318 ""
NSQ_SOURCE_LINE 00006319 "    # return variables"
NSQ_SOURCE_LINE 00006320 "    my $msg        = EMPTY_STRING;"
NSQ_SOURCE_LINE 00006321 "    my $rline_hash = [];"
NSQ_SOURCE_LINE 00006322 ""
NSQ_SOURCE_LINE 00006323 "    # quote state variables"
NSQ_SOURCE_LINE 00006324 "    my $quote_char          = EMPTY_STRING;"
NSQ_SOURCE_LINE 00006325 "    my $quote_start_line    = EMPTY_STRING;"
NSQ_SOURCE_LINE 00006326 "    my $quote_start_line_no = -1;"
NSQ_SOURCE_LINE 00006327 "    my $in_string           = EMPTY_STRING;"
NSQ_SOURCE_LINE 00006328 "    my $out_string          = EMPTY_STRING;"
NSQ_SOURCE_LINE 00006329 ""
NSQ_SOURCE_LINE 00006330 "    my @lines   = split /^/, ${$rconfig_string};"
NSQ_SOURCE_LINE 00006331 "    my $line_no = 0;"
NSQ_SOURCE_LINE 00006332 ""
NSQ_SOURCE_LINE 00006333 "    # loop over lines"
NSQ_SOURCE_LINE 00006334 "    foreach my $line (@lines) {"
NSQ_SOURCE_LINE 00006335 "        $line_no++;"
NSQ_SOURCE_LINE 00006336 "        $line =~ s/^\\s+//;"
NSQ_SOURCE_LINE 00006337 "        $line =~ s/\\s+$//;"
NSQ_SOURCE_LINE 00006338 "        next unless ( length($line) );"
NSQ_SOURCE_LINE 00006339 ""
NSQ_SOURCE_LINE 00006340 "        if ( !$quote_char ) {"
NSQ_SOURCE_LINE 00006341 ""
NSQ_SOURCE_LINE 00006342 "            # skip a full-line comment"
NSQ_SOURCE_LINE 00006343 "            if ( substr( $line, 0, 1 ) eq '#' ) {"
NSQ_SOURCE_LINE 00006344 "                next;"
NSQ_SOURCE_LINE 00006345 "            }"
NSQ_SOURCE_LINE 00006346 "            $in_string  = $line;"
NSQ_SOURCE_LINE 00006347 "            $out_string = EMPTY_STRING;"
NSQ_SOURCE_LINE 00006348 "        }"
NSQ_SOURCE_LINE 00006349 "        else {"
NSQ_SOURCE_LINE 00006350 ""
NSQ_SOURCE_LINE 00006351 "            # treat previous newline as a space"
NSQ_SOURCE_LINE 00006352 "            $in_string = SPACE . $line;"
NSQ_SOURCE_LINE 00006353 "        }"
NSQ_SOURCE_LINE 00006354 ""
NSQ_SOURCE_LINE 00006355 "        # loop over string characters"
NSQ_SOURCE_LINE 00006356 "        #  $in_string  = the input string"
NSQ_SOURCE_LINE 00006357 "        #  $out_string = the output string"
NSQ_SOURCE_LINE 00006358 "        #  $quote_char = quote character being sought"
NSQ_SOURCE_LINE 00006359 "        while (1) {"
NSQ_SOURCE_LINE 00006360 ""
NSQ_SOURCE_LINE 00006361 "            # accumulating characters not in quote"
NSQ_SOURCE_LINE 00006362 "            if ( !$quote_char ) {"
NSQ_SOURCE_LINE 00006363 ""
NSQ_SOURCE_LINE 00006364 "                if ( $in_string =~ /\\G([\\\"\\'])/gc ) {"
NSQ_SOURCE_LINE 00006365 ""
NSQ_SOURCE_LINE 00006366 "                    # starting new quote.."
NSQ_SOURCE_LINE 00006367 "                    $out_string .= $1;"
NSQ_SOURCE_LINE 00006368 "                    $quote_char          = $1;"
NSQ_SOURCE_LINE 00006369 "                    $quote_start_line_no = $line_no;"
NSQ_SOURCE_LINE 00006370 "                    $quote_start_line    = $line;"
NSQ_SOURCE_LINE 00006371 "                }"
NSQ_SOURCE_LINE 00006372 "                elsif ( $in_string =~ /\\G#/gc ) {"
NSQ_SOURCE_LINE 00006373 ""
NSQ_SOURCE_LINE 00006374 "                    # A space is required before the # of a side comment"
NSQ_SOURCE_LINE 00006375 "                    # This allows something like:"
NSQ_SOURCE_LINE 00006376 "                    #    -sbcp=#"
NSQ_SOURCE_LINE 00006377 "                    # Otherwise, it would have to be quoted:"
NSQ_SOURCE_LINE 00006378 "                    #    -sbcp='#'"
NSQ_SOURCE_LINE 00006379 "                    if ( !length($out_string) || $out_string =~ s/\\s+$// ) {"
NSQ_SOURCE_LINE 00006380 "                        last;"
NSQ_SOURCE_LINE 00006381 "                    }"
NSQ_SOURCE_LINE 00006382 "                    $out_string .= '#';"
NSQ_SOURCE_LINE 00006383 "                }"
NSQ_SOURCE_LINE 00006384 "                elsif ( $in_string =~ /\\G([^\\#\\'\\\"]+)/gc ) {"
NSQ_SOURCE_LINE 00006385 ""
NSQ_SOURCE_LINE 00006386 "                    # neither quote nor side comment"
NSQ_SOURCE_LINE 00006387 "                    $out_string .= $1;"
NSQ_SOURCE_LINE 00006388 "                }"
NSQ_SOURCE_LINE 00006389 "                else {"
NSQ_SOURCE_LINE 00006390 ""
NSQ_SOURCE_LINE 00006391 "                    # end of line"
NSQ_SOURCE_LINE 00006392 "                    last;"
NSQ_SOURCE_LINE 00006393 "                }"
NSQ_SOURCE_LINE 00006394 "            }"
NSQ_SOURCE_LINE 00006395 ""
NSQ_SOURCE_LINE 00006396 "            # looking for ending quote character"
NSQ_SOURCE_LINE 00006397 "            else {"
NSQ_SOURCE_LINE 00006398 "                if ( $in_string =~ /\\G($quote_char)/gc ) {"
NSQ_SOURCE_LINE 00006399 ""
NSQ_SOURCE_LINE 00006400 "                    # end of quote"
NSQ_SOURCE_LINE 00006401 "                    $out_string .= $1;"
NSQ_SOURCE_LINE 00006402 "                    $quote_char = EMPTY_STRING;"
NSQ_SOURCE_LINE 00006403 "                }"
NSQ_SOURCE_LINE 00006404 "                elsif ( $in_string =~ /\\G([^$quote_char]+)/gc ) {"
NSQ_SOURCE_LINE 00006405 ""
NSQ_SOURCE_LINE 00006406 "                    # accumulate quoted text"
NSQ_SOURCE_LINE 00006407 "                    $out_string .= $1;"
NSQ_SOURCE_LINE 00006408 "                }"
NSQ_SOURCE_LINE 00006409 "                else {"
NSQ_SOURCE_LINE 00006410 ""
NSQ_SOURCE_LINE 00006411 "                    # end of line"
NSQ_SOURCE_LINE 00006412 "                    last;"
NSQ_SOURCE_LINE 00006413 "                }"
NSQ_SOURCE_LINE 00006414 "            }"
NSQ_SOURCE_LINE 00006415 "        } ## end while (1)"
NSQ_SOURCE_LINE 00006416 ""
NSQ_SOURCE_LINE 00006417 "        if ( !$quote_char ) {"
NSQ_SOURCE_LINE 00006418 "            push @{$rline_hash},"
NSQ_SOURCE_LINE 00006419 "              {"
NSQ_SOURCE_LINE 00006420 "                line    => $out_string,"
NSQ_SOURCE_LINE 00006421 "                line_no => $line_no,"
NSQ_SOURCE_LINE 00006422 "              };"
NSQ_SOURCE_LINE 00006423 "        }"
NSQ_SOURCE_LINE 00006424 ""
NSQ_SOURCE_LINE 00006425 "    } ## end loop over lines"
NSQ_SOURCE_LINE 00006426 ""
NSQ_SOURCE_LINE 00006427 "    if ($quote_char) {"
NSQ_SOURCE_LINE 00006428 "        my $max_len = 80;"
NSQ_SOURCE_LINE 00006429 "        if ( length($quote_start_line) > $max_len ) {"
NSQ_SOURCE_LINE 00006430 "            $quote_start_line ="
NSQ_SOURCE_LINE 00006431 "              substr( $quote_start_line, 0, $max_len - 3 ) . '...';"
NSQ_SOURCE_LINE 00006432 "        }"
NSQ_SOURCE_LINE 00006433 "        $msg = <<EOM;"
NSQ_SOURCE_LINE 00006434 "Error: hit EOF reading file '$config_file' looking for end of quoted text"
NSQ_SOURCE_LINE 00006435 "which started at line $quote_start_line_no with quote character <$quote_char>:"
NSQ_SOURCE_LINE 00006436 "$quote_start_line"
NSQ_SOURCE_LINE 00006437 "Please fix or use -npro to avoid reading this file"
NSQ_SOURCE_LINE 00006438 "EOM"
NSQ_SOURCE_LINE 00006439 "    }"
NSQ_SOURCE_LINE 00006440 "    return ( $rline_hash, $msg );"
NSQ_SOURCE_LINE 00006441 "} ## end sub strip_comments_and_join_quotes"
NSQ_SOURCE_LINE 00006442 ""
NSQ_SOURCE_LINE 00006443 "sub parse_args {"
NSQ_SOURCE_LINE 00006444 ""
NSQ_SOURCE_LINE 00006445 "    my ($body) = @_;"
NSQ_SOURCE_LINE 00006446 ""
NSQ_SOURCE_LINE 00006447 "    # Parse a command string $body containing multiple string with possible"
NSQ_SOURCE_LINE 00006448 "    # quotes, into individual commands.  It might look like this, for example:"
NSQ_SOURCE_LINE 00006449 "    #"
NSQ_SOURCE_LINE 00006450 "    #    -wba=\" + - \"  -some-thing -wbb='. && ||'"
NSQ_SOURCE_LINE 00006451 "    #"
NSQ_SOURCE_LINE 00006452 "    # There is no need, at present, to handle escaped quote characters."
NSQ_SOURCE_LINE 00006453 "    # (They are not perltidy tokens, so needn't be in strings)."
NSQ_SOURCE_LINE 00006454 ""
NSQ_SOURCE_LINE 00006455 "    my @body_parts = ();"
NSQ_SOURCE_LINE 00006456 "    my $quote_char = EMPTY_STRING;"
NSQ_SOURCE_LINE 00006457 "    my $part       = EMPTY_STRING;"
NSQ_SOURCE_LINE 00006458 "    my $msg        = EMPTY_STRING;"
NSQ_SOURCE_LINE 00006459 ""
NSQ_SOURCE_LINE 00006460 "    # Check for external call with undefined $body - added to fix"
NSQ_SOURCE_LINE 00006461 "    # github issue Perl-Tidy-Sweetened issue #23"
NSQ_SOURCE_LINE 00006462 "    if ( !defined($body) ) { $body = EMPTY_STRING }"
NSQ_SOURCE_LINE 00006463 ""
NSQ_SOURCE_LINE 00006464 "    while (1) {"
NSQ_SOURCE_LINE 00006465 ""
NSQ_SOURCE_LINE 00006466 "        # looking for ending quote character"
NSQ_SOURCE_LINE 00006467 "        if ($quote_char) {"
NSQ_SOURCE_LINE 00006468 "            if ( $body =~ /\\G($quote_char)/gc ) {"
NSQ_SOURCE_LINE 00006469 "                $quote_char = EMPTY_STRING;"
NSQ_SOURCE_LINE 00006470 "            }"
NSQ_SOURCE_LINE 00006471 "            elsif ( $body =~ /\\G(.)/gc ) {"
NSQ_SOURCE_LINE 00006472 "                $part .= $1;"
NSQ_SOURCE_LINE 00006473 "            }"
NSQ_SOURCE_LINE 00006474 ""
NSQ_SOURCE_LINE 00006475 "            # error..we reached the end without seeing the ending quote char"
NSQ_SOURCE_LINE 00006476 "            else {"
NSQ_SOURCE_LINE 00006477 "                if ( length($part) ) { push @body_parts, $part; }"
NSQ_SOURCE_LINE 00006478 "                $msg = <<EOM;"
NSQ_SOURCE_LINE 00006479 "Did not see ending quote character <$quote_char> in this text:"
NSQ_SOURCE_LINE 00006480 "$body"
NSQ_SOURCE_LINE 00006481 "EOM"
NSQ_SOURCE_LINE 00006482 "                last;"
NSQ_SOURCE_LINE 00006483 "            }"
NSQ_SOURCE_LINE 00006484 "        }"
NSQ_SOURCE_LINE 00006485 ""
NSQ_SOURCE_LINE 00006486 "        # accumulating characters and looking for start of a quoted string"
NSQ_SOURCE_LINE 00006487 "        else {"
NSQ_SOURCE_LINE 00006488 "            if ( $body =~ /\\G([\\\"\\'])/gc ) {"
NSQ_SOURCE_LINE 00006489 "                $quote_char = $1;"
NSQ_SOURCE_LINE 00006490 "            }"
NSQ_SOURCE_LINE 00006491 "            elsif ( $body =~ /\\G(\\s+)/gc ) {"
NSQ_SOURCE_LINE 00006492 "                if ( length($part) ) { push @body_parts, $part; }"
NSQ_SOURCE_LINE 00006493 "                $part = EMPTY_STRING;"
NSQ_SOURCE_LINE 00006494 "            }"
NSQ_SOURCE_LINE 00006495 "            elsif ( $body =~ /\\G(.)/gc ) {"
NSQ_SOURCE_LINE 00006496 "                $part .= $1;"
NSQ_SOURCE_LINE 00006497 "            }"
NSQ_SOURCE_LINE 00006498 "            else {"
NSQ_SOURCE_LINE 00006499 "                if ( length($part) ) { push @body_parts, $part; }"
NSQ_SOURCE_LINE 00006500 "                last;"
NSQ_SOURCE_LINE 00006501 "            }"
NSQ_SOURCE_LINE 00006502 "        }"
NSQ_SOURCE_LINE 00006503 "    } ## end while (1)"
NSQ_SOURCE_LINE 00006504 "    return ( \\@body_parts, $msg );"
NSQ_SOURCE_LINE 00006505 "} ## end sub parse_args"
NSQ_SOURCE_LINE 00006506 ""
NSQ_SOURCE_LINE 00006507 "sub dump_long_names {"
NSQ_SOURCE_LINE 00006508 ""
NSQ_SOURCE_LINE 00006509 "    my @names = @_;"
NSQ_SOURCE_LINE 00006510 ""
NSQ_SOURCE_LINE 00006511 "    # do --dump-long-names (-dln)"
NSQ_SOURCE_LINE 00006512 ""
NSQ_SOURCE_LINE 00006513 "    print {*STDOUT} <<EOM;"
NSQ_SOURCE_LINE 00006514 "# Command line long names (passed to GetOptions)"
NSQ_SOURCE_LINE 00006515 "#--------------------------------------------------"
NSQ_SOURCE_LINE 00006516 "# here is a summary of the Getopt codes:"
NSQ_SOURCE_LINE 00006517 "# <none> does not take an argument"
NSQ_SOURCE_LINE 00006518 "# =s takes a mandatory string"
NSQ_SOURCE_LINE 00006519 "# :s takes an optional string"
NSQ_SOURCE_LINE 00006520 "# =i takes a mandatory integer"
NSQ_SOURCE_LINE 00006521 "# :i takes an optional integer"
NSQ_SOURCE_LINE 00006522 "# ! does not take an argument and may be negated"
NSQ_SOURCE_LINE 00006523 "#  i.e., -foo and -nofoo are allowed"
NSQ_SOURCE_LINE 00006524 "# a double dash signals the end of the options list"
NSQ_SOURCE_LINE 00006525 "#"
NSQ_SOURCE_LINE 00006526 "#--------------------------------------------------"
NSQ_SOURCE_LINE 00006527 "EOM"
NSQ_SOURCE_LINE 00006528 ""
NSQ_SOURCE_LINE 00006529 "    foreach my $name ( sort @names ) { print {*STDOUT} \"$name\\n\" }"
NSQ_SOURCE_LINE 00006530 "    return;"
NSQ_SOURCE_LINE 00006531 "} ## end sub dump_long_names"
NSQ_SOURCE_LINE 00006532 ""
NSQ_SOURCE_LINE 00006533 "sub dump_integer_option_range {"
NSQ_SOURCE_LINE 00006534 ""
NSQ_SOURCE_LINE 00006535 "    my ($rinteger_option_range) = @_;"
NSQ_SOURCE_LINE 00006536 ""
NSQ_SOURCE_LINE 00006537 "    # do --dump-integer-option-range (-dior)"
NSQ_SOURCE_LINE 00006538 ""
NSQ_SOURCE_LINE 00006539 "    print {*STDOUT} \"Option, min, max, default\\n\";"
NSQ_SOURCE_LINE 00006540 "    foreach my $key ( sort keys %{$rinteger_option_range} ) {"
NSQ_SOURCE_LINE 00006541 "        my ( $min, $max, $default ) = @{ $rinteger_option_range->{$key} };"
NSQ_SOURCE_LINE 00006542 "        foreach ( $min, $max, $default ) {"
NSQ_SOURCE_LINE 00006543 "            $_ = 'undef' unless ( defined($_) );"
NSQ_SOURCE_LINE 00006544 "        }"
NSQ_SOURCE_LINE 00006545 "        print {*STDOUT} \"$key, $min, $max, $default\\n\";"
NSQ_SOURCE_LINE 00006546 "    }"
NSQ_SOURCE_LINE 00006547 "    return;"
NSQ_SOURCE_LINE 00006548 "} ## end sub dump_integer_option_range"
NSQ_SOURCE_LINE 00006549 ""
NSQ_SOURCE_LINE 00006550 "sub dump_defaults {"
NSQ_SOURCE_LINE 00006551 ""
NSQ_SOURCE_LINE 00006552 "    my @defaults = @_;"
NSQ_SOURCE_LINE 00006553 ""
NSQ_SOURCE_LINE 00006554 "    #  do --dump-defaults (-ddf)"
NSQ_SOURCE_LINE 00006555 "    print {*STDOUT} \"Default command line options:\\n\";"
NSQ_SOURCE_LINE 00006556 "    foreach my $line ( sort @defaults ) { print {*STDOUT} \"$line\\n\" }"
NSQ_SOURCE_LINE 00006557 "    return;"
NSQ_SOURCE_LINE 00006558 "} ## end sub dump_defaults"
NSQ_SOURCE_LINE 00006559 ""
NSQ_SOURCE_LINE 00006560 "sub readable_options {"
NSQ_SOURCE_LINE 00006561 ""
NSQ_SOURCE_LINE 00006562 "    my ( $rOpts, $roption_string ) = @_;"
NSQ_SOURCE_LINE 00006563 ""
NSQ_SOURCE_LINE 00006564 "    # return options for this run as a string which could be"
NSQ_SOURCE_LINE 00006565 "    # put in a perltidyrc file"
NSQ_SOURCE_LINE 00006566 "    my %Getopt_flags;"
NSQ_SOURCE_LINE 00006567 "    my $rGetopt_flags    = \\%Getopt_flags;"
NSQ_SOURCE_LINE 00006568 "    my $readable_options = \"# Final parameter set for this run.\\n\";"
NSQ_SOURCE_LINE 00006569 "    $readable_options .="
NSQ_SOURCE_LINE 00006570 "      \"# See utility 'perltidyrc_dump.pl' for nicer formatting.\\n\";"
NSQ_SOURCE_LINE 00006571 "    foreach my $opt ( @{$roption_string} ) {"
NSQ_SOURCE_LINE 00006572 "        my $flag = EMPTY_STRING;"
NSQ_SOURCE_LINE 00006573 "        if ( $opt =~ /(.*)(!|=.*)$/ ) {"
NSQ_SOURCE_LINE 00006574 "            $opt  = $1;"
NSQ_SOURCE_LINE 00006575 "            $flag = $2;"
NSQ_SOURCE_LINE 00006576 "        }"
NSQ_SOURCE_LINE 00006577 "        if ( defined( $rOpts->{$opt} ) ) {"
NSQ_SOURCE_LINE 00006578 "            $rGetopt_flags->{$opt} = $flag;"
NSQ_SOURCE_LINE 00006579 "        }"
NSQ_SOURCE_LINE 00006580 "    }"
NSQ_SOURCE_LINE 00006581 "    foreach my $key ( sort keys %{$rOpts} ) {"
NSQ_SOURCE_LINE 00006582 "        my $flag   = $rGetopt_flags->{$key};"
NSQ_SOURCE_LINE 00006583 "        my $value  = $rOpts->{$key};"
NSQ_SOURCE_LINE 00006584 "        my $prefix = '--';"
NSQ_SOURCE_LINE 00006585 "        my $suffix = EMPTY_STRING;"
NSQ_SOURCE_LINE 00006586 "        if ($flag) {"
NSQ_SOURCE_LINE 00006587 "            if ( $flag =~ /^=/ ) {"
NSQ_SOURCE_LINE 00006588 "                if ( $value !~ /^\\d+$/ ) { $value = '\"' . $value . '\"' }"
NSQ_SOURCE_LINE 00006589 "                $suffix = \"=\" . $value;"
NSQ_SOURCE_LINE 00006590 "            }"
NSQ_SOURCE_LINE 00006591 "            elsif ( $flag =~ /^!/ ) {"
NSQ_SOURCE_LINE 00006592 "                $prefix .= \"no\" unless ($value);"
NSQ_SOURCE_LINE 00006593 "            }"
NSQ_SOURCE_LINE 00006594 "            else {"
NSQ_SOURCE_LINE 00006595 ""
NSQ_SOURCE_LINE 00006596 "                # shouldn't happen"
NSQ_SOURCE_LINE 00006597 "                $readable_options .="
NSQ_SOURCE_LINE 00006598 "                  \"# ERROR in dump_options: unrecognized flag $flag for $key\\n\";"
NSQ_SOURCE_LINE 00006599 "            }"
NSQ_SOURCE_LINE 00006600 "        }"
NSQ_SOURCE_LINE 00006601 "        $readable_options .= $prefix . $key . $suffix . \"\\n\";"
NSQ_SOURCE_LINE 00006602 "    }"
NSQ_SOURCE_LINE 00006603 "    return $readable_options;"
NSQ_SOURCE_LINE 00006604 "} ## end sub readable_options"
NSQ_SOURCE_LINE 00006605 ""
NSQ_SOURCE_LINE 00006606 "sub show_version {"
