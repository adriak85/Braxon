NSQ_SOURCE_LINE 00004557 ""
NSQ_SOURCE_LINE 00004558 "        'stack-opening-block-brace'   => [qw(bbvt=2 bbvtl=*)],"
NSQ_SOURCE_LINE 00004559 "        'sobb'                        => [qw(bbvt=2 bbvtl=*)],"
NSQ_SOURCE_LINE 00004560 "        'nostack-opening-block-brace' => [qw(bbvt=0)],"
NSQ_SOURCE_LINE 00004561 "        'nsobb'                       => [qw(bbvt=0)],"
NSQ_SOURCE_LINE 00004562 ""
NSQ_SOURCE_LINE 00004563 "        'converge'   => [qw(it=4)],"
NSQ_SOURCE_LINE 00004564 "        'noconverge' => [qw(it=1)],"
NSQ_SOURCE_LINE 00004565 "        'conv'       => [qw(it=4)],"
NSQ_SOURCE_LINE 00004566 "        'nconv'      => [qw(it=1)],"
NSQ_SOURCE_LINE 00004567 ""
NSQ_SOURCE_LINE 00004568 "        'valign'   => [qw(vc vsc vbc)],"
NSQ_SOURCE_LINE 00004569 "        'novalign' => [qw(nvc nvsc nvbc)],"
NSQ_SOURCE_LINE 00004570 ""
NSQ_SOURCE_LINE 00004571 "        # NOTE: This is a possible future shortcut.  But it will remain"
NSQ_SOURCE_LINE 00004572 "        # deactivated until the -lpxl flag is no longer experimental."
NSQ_SOURCE_LINE 00004573 "        # 'line-up-function-parentheses' => [ qw(lp), q#lpxl=[ { F(2# ],"
NSQ_SOURCE_LINE 00004574 "        # 'lfp'                          => [qw(line-up-function-parentheses)],"
NSQ_SOURCE_LINE 00004575 ""
NSQ_SOURCE_LINE 00004576 "        # 'mangle' originally deleted pod and comments, but to keep it"
NSQ_SOURCE_LINE 00004577 "        # reversible, it no longer does.  But if you really want to"
NSQ_SOURCE_LINE 00004578 "        # delete them, just use:"
NSQ_SOURCE_LINE 00004579 "        #   -mangle -dac"
NSQ_SOURCE_LINE 00004580 ""
NSQ_SOURCE_LINE 00004581 "        # An interesting use for 'mangle' is to do this:"
NSQ_SOURCE_LINE 00004582 "        #    perltidy -mangle myfile.pl -st | perltidy -o myfile.pl.new"
NSQ_SOURCE_LINE 00004583 "        # which will form as many one-line blocks as possible"
NSQ_SOURCE_LINE 00004584 ""
NSQ_SOURCE_LINE 00004585 "        'mangle' => ["
NSQ_SOURCE_LINE 00004586 "            qw("
NSQ_SOURCE_LINE 00004587 "              keep-old-blank-lines=0"
NSQ_SOURCE_LINE 00004588 "              delete-old-newlines"
NSQ_SOURCE_LINE 00004589 "              delete-old-whitespace"
NSQ_SOURCE_LINE 00004590 "              delete-semicolons"
NSQ_SOURCE_LINE 00004591 "              indent-columns=0"
NSQ_SOURCE_LINE 00004592 "              maximum-consecutive-blank-lines=0"
NSQ_SOURCE_LINE 00004593 "              maximum-line-length=100000"
NSQ_SOURCE_LINE 00004594 "              noadd-newlines"
NSQ_SOURCE_LINE 00004595 "              noadd-semicolons"
NSQ_SOURCE_LINE 00004596 "              noadd-whitespace"
NSQ_SOURCE_LINE 00004597 "              noblanks-before-blocks"
NSQ_SOURCE_LINE 00004598 "              blank-lines-before-subs=0"
NSQ_SOURCE_LINE 00004599 "              blank-lines-before-packages=0"
NSQ_SOURCE_LINE 00004600 "              notabs"
NSQ_SOURCE_LINE 00004601 "            )"
NSQ_SOURCE_LINE 00004602 "        ],"
NSQ_SOURCE_LINE 00004603 ""
NSQ_SOURCE_LINE 00004604 "        # 'extrude' originally deleted pod and comments, but to keep it"
NSQ_SOURCE_LINE 00004605 "        # reversible, it no longer does.  But if you really want to"
NSQ_SOURCE_LINE 00004606 "        # delete them, just use"
NSQ_SOURCE_LINE 00004607 "        #   extrude -dac"
NSQ_SOURCE_LINE 00004608 "        #"
NSQ_SOURCE_LINE 00004609 "        # An interesting use for 'extrude' is to do this:"
NSQ_SOURCE_LINE 00004610 "        #    perltidy -extrude myfile.pl -st | perltidy -o myfile.pl.new"
NSQ_SOURCE_LINE 00004611 "        # which will break up all one-line blocks."
NSQ_SOURCE_LINE 00004612 "        'extrude' => ["
NSQ_SOURCE_LINE 00004613 "            qw("
NSQ_SOURCE_LINE 00004614 "              ci=0"
NSQ_SOURCE_LINE 00004615 "              delete-old-newlines"
NSQ_SOURCE_LINE 00004616 "              delete-old-whitespace"
NSQ_SOURCE_LINE 00004617 "              delete-semicolons"
NSQ_SOURCE_LINE 00004618 "              indent-columns=0"
NSQ_SOURCE_LINE 00004619 "              maximum-consecutive-blank-lines=0"
NSQ_SOURCE_LINE 00004620 "              maximum-line-length=1"
NSQ_SOURCE_LINE 00004621 "              noadd-semicolons"
NSQ_SOURCE_LINE 00004622 "              noadd-whitespace"
NSQ_SOURCE_LINE 00004623 "              noblanks-before-blocks"
NSQ_SOURCE_LINE 00004624 "              blank-lines-before-subs=0"
NSQ_SOURCE_LINE 00004625 "              blank-lines-before-packages=0"
NSQ_SOURCE_LINE 00004626 "              nofuzzy-line-length"
NSQ_SOURCE_LINE 00004627 "              notabs"
NSQ_SOURCE_LINE 00004628 "              norecombine"
NSQ_SOURCE_LINE 00004629 "            )"
NSQ_SOURCE_LINE 00004630 "        ],"
NSQ_SOURCE_LINE 00004631 ""
NSQ_SOURCE_LINE 00004632 "        # this style tries to follow the GNU Coding Standards (which do"
NSQ_SOURCE_LINE 00004633 "        # not really apply to perl but which are followed by some perl"
NSQ_SOURCE_LINE 00004634 "        # programmers)."
NSQ_SOURCE_LINE 00004635 "        'gnu-style' => ["
NSQ_SOURCE_LINE 00004636 "            qw("
NSQ_SOURCE_LINE 00004637 "              lp bl noll pt=2 bt=2 sbt=2 cpi=1 csbi=1 cbi=1"
NSQ_SOURCE_LINE 00004638 "            )"
NSQ_SOURCE_LINE 00004639 "        ],"
NSQ_SOURCE_LINE 00004640 ""
NSQ_SOURCE_LINE 00004641 "        # Style suggested in Damian Conway's Perl Best Practices"
NSQ_SOURCE_LINE 00004642 "        'perl-best-practices' => ["
NSQ_SOURCE_LINE 00004643 "            qw(l=78 i=4 ci=4 st se vt=2 cti=0 pt=1 bt=1 sbt=1 bbt=1 nsfs nolq),"
NSQ_SOURCE_LINE 00004644 "q(wbb=% + - * / x != == >= <= =~ !~ < > | & = **= += *= &= <<= &&= -= /= |= >>= ||= //= .= %= ^= x=)"
NSQ_SOURCE_LINE 00004645 "        ],"
NSQ_SOURCE_LINE 00004646 ""
NSQ_SOURCE_LINE 00004647 "        # Additional styles can be added here"
NSQ_SOURCE_LINE 00004648 "    );"
NSQ_SOURCE_LINE 00004649 ""
NSQ_SOURCE_LINE 00004650 "    Perl::Tidy::HtmlWriter->make_abbreviated_names( \\%expansion );"
NSQ_SOURCE_LINE 00004651 ""
NSQ_SOURCE_LINE 00004652 "    # Uncomment next line to dump all expansions for debugging:"
NSQ_SOURCE_LINE 00004653 "    # dump_short_names(\\%expansion);"
NSQ_SOURCE_LINE 00004654 "    return ( \\@option_string, \\@defaults, \\%expansion, \\%option_category,"
NSQ_SOURCE_LINE 00004655 "        \\%integer_option_range, \\%is_string_option );"
NSQ_SOURCE_LINE 00004656 ""
NSQ_SOURCE_LINE 00004657 "} ## end sub generate_options"
NSQ_SOURCE_LINE 00004658 ""
NSQ_SOURCE_LINE 00004659 "{ #<<< closure process_command_line"
NSQ_SOURCE_LINE 00004660 ""
NSQ_SOURCE_LINE 00004661 "# Memoize process_command_line. Given same @ARGV passed in, return same"
NSQ_SOURCE_LINE 00004662 "# values and same @ARGV back."
NSQ_SOURCE_LINE 00004663 "# This patch was supplied by Jonathan Swartz Nov 2012 and significantly speeds"
NSQ_SOURCE_LINE 00004664 "# up masontidy (https://metacpan.org/module/masontidy)"
NSQ_SOURCE_LINE 00004665 ""
NSQ_SOURCE_LINE 00004666 "my %process_command_line_cache;"
NSQ_SOURCE_LINE 00004667 ""
NSQ_SOURCE_LINE 00004668 "sub process_command_line {"
NSQ_SOURCE_LINE 00004669 ""
NSQ_SOURCE_LINE 00004670 "    # Use Getopt::Long to scan the command line for input parameters."
NSQ_SOURCE_LINE 00004671 "    # This is the outer sub which handles memoization"
NSQ_SOURCE_LINE 00004672 ""
NSQ_SOURCE_LINE 00004673 "    my @q = @_;"
NSQ_SOURCE_LINE 00004674 "    my ("
NSQ_SOURCE_LINE 00004675 "        $perltidyrc_stream,     $is_Windows_uu, $Windows_type_uu,"
NSQ_SOURCE_LINE 00004676 "        $rpending_complaint_uu, $dump_options_type"
NSQ_SOURCE_LINE 00004677 "    ) = @q;"
NSQ_SOURCE_LINE 00004678 ""
NSQ_SOURCE_LINE 00004679 "    my $use_cache = !defined($perltidyrc_stream) && !$dump_options_type;"
NSQ_SOURCE_LINE 00004680 "    if ($use_cache) {"
NSQ_SOURCE_LINE 00004681 "        my $cache_key = join( chr(28), @ARGV );"
NSQ_SOURCE_LINE 00004682 "        if ( my $result = $process_command_line_cache{$cache_key} ) {"
NSQ_SOURCE_LINE 00004683 "            my ( $argv, @retvals ) = @{$result};"
NSQ_SOURCE_LINE 00004684 "            @ARGV = @{$argv};"
NSQ_SOURCE_LINE 00004685 "            return @retvals;"
NSQ_SOURCE_LINE 00004686 "        }"
NSQ_SOURCE_LINE 00004687 "        else {"
NSQ_SOURCE_LINE 00004688 "            my @retvals = _process_command_line(@q);"
NSQ_SOURCE_LINE 00004689 "            $process_command_line_cache{$cache_key} = [ \\@ARGV, @retvals ]"
NSQ_SOURCE_LINE 00004690 "              if ( $retvals[0]->{'memoize'} );"
NSQ_SOURCE_LINE 00004691 "            return @retvals;"
NSQ_SOURCE_LINE 00004692 "        }"
NSQ_SOURCE_LINE 00004693 "    }"
NSQ_SOURCE_LINE 00004694 "    else {"
NSQ_SOURCE_LINE 00004695 "        return _process_command_line(@q);"
NSQ_SOURCE_LINE 00004696 "    }"
NSQ_SOURCE_LINE 00004697 "} ## end sub process_command_line"
NSQ_SOURCE_LINE 00004698 "} ## end closure process_command_line"
NSQ_SOURCE_LINE 00004699 ""
NSQ_SOURCE_LINE 00004700 "# (note the underscore here)"
NSQ_SOURCE_LINE 00004701 "sub _process_command_line {"
NSQ_SOURCE_LINE 00004702 ""
NSQ_SOURCE_LINE 00004703 "    my ("
NSQ_SOURCE_LINE 00004704 "        $perltidyrc_stream,  $is_Windows, $Windows_type,"
NSQ_SOURCE_LINE 00004705 "        $rpending_complaint, $dump_options_type"
NSQ_SOURCE_LINE 00004706 "    ) = @_;"
NSQ_SOURCE_LINE 00004707 ""
NSQ_SOURCE_LINE 00004708 "    # Use Getopt::Long to scan the command line for input parameters."
NSQ_SOURCE_LINE 00004709 "    # This is the inner sub which actually processes the command line"
NSQ_SOURCE_LINE 00004710 ""
NSQ_SOURCE_LINE 00004711 "    use Getopt::Long;"
NSQ_SOURCE_LINE 00004712 ""
NSQ_SOURCE_LINE 00004713 "    # Save any current Getopt::Long configuration"
NSQ_SOURCE_LINE 00004714 "    # and set to Getopt::Long defaults.  Use eval to avoid"
NSQ_SOURCE_LINE 00004715 "    # breaking old versions of Perl without these routines."
NSQ_SOURCE_LINE 00004716 "    # Previous configuration is reset at the exit of this routine."
NSQ_SOURCE_LINE 00004717 "    my $glc;"
NSQ_SOURCE_LINE 00004718 "    if ( eval { $glc = Getopt::Long::Configure(); 1 } ) {"
NSQ_SOURCE_LINE 00004719 "        my $ok = eval { Getopt::Long::ConfigDefaults(); 1 };"
NSQ_SOURCE_LINE 00004720 "        if ( !$ok && DEVEL_MODE ) {"
NSQ_SOURCE_LINE 00004721 "            Fault(\"Failed call to Getopt::Long::ConfigDefaults: $EVAL_ERROR\\n\");"
NSQ_SOURCE_LINE 00004722 "        }"
NSQ_SOURCE_LINE 00004723 "    }"
NSQ_SOURCE_LINE 00004724 "    else { $glc = undef }"
NSQ_SOURCE_LINE 00004725 ""
NSQ_SOURCE_LINE 00004726 "    my ( $roption_string, $rdefaults, $rexpansion,"
NSQ_SOURCE_LINE 00004727 "        $roption_category, $rinteger_option_range, $ris_string_option )"
NSQ_SOURCE_LINE 00004728 "      = generate_options();"
NSQ_SOURCE_LINE 00004729 ""
NSQ_SOURCE_LINE 00004730 "    #--------------------------------------------------------------"
NSQ_SOURCE_LINE 00004731 "    # set the defaults by passing the above list through GetOptions"
NSQ_SOURCE_LINE 00004732 "    #--------------------------------------------------------------"
NSQ_SOURCE_LINE 00004733 "    my %Opts = ();"
NSQ_SOURCE_LINE 00004734 "    {"
NSQ_SOURCE_LINE 00004735 "        local @ARGV = ();"
NSQ_SOURCE_LINE 00004736 ""
NSQ_SOURCE_LINE 00004737 "        # do not load the defaults if we are just dumping perltidyrc"
NSQ_SOURCE_LINE 00004738 "        if ( $dump_options_type ne 'perltidyrc' ) {"
NSQ_SOURCE_LINE 00004739 "            for my $i ( @{$rdefaults} ) { push @ARGV, \"--\" . $i }"
NSQ_SOURCE_LINE 00004740 "        }"
NSQ_SOURCE_LINE 00004741 "        if ( !GetOptions( \\%Opts, @{$roption_string} ) ) {"
NSQ_SOURCE_LINE 00004742 "            Die("
NSQ_SOURCE_LINE 00004743 "\"Programming Bug reported by 'GetOptions': error in setting default options\""
NSQ_SOURCE_LINE 00004744 "            );"
NSQ_SOURCE_LINE 00004745 "        }"
NSQ_SOURCE_LINE 00004746 "    }"
NSQ_SOURCE_LINE 00004747 ""
NSQ_SOURCE_LINE 00004748 "    my @raw_options        = ();"
NSQ_SOURCE_LINE 00004749 "    my $saw_ignore_profile = 0;"
NSQ_SOURCE_LINE 00004750 "    my $saw_dump_profile   = 0;"
NSQ_SOURCE_LINE 00004751 "    my $config_file;"
NSQ_SOURCE_LINE 00004752 ""
NSQ_SOURCE_LINE 00004753 "    #--------------------------------------------------------------"
NSQ_SOURCE_LINE 00004754 "    # Take a first look at the command-line parameters.  Do as many"
NSQ_SOURCE_LINE 00004755 "    # immediate dumps as possible, which can avoid confusion if the"
NSQ_SOURCE_LINE 00004756 "    # perltidyrc file has an error."
NSQ_SOURCE_LINE 00004757 "    #--------------------------------------------------------------"
NSQ_SOURCE_LINE 00004758 "    foreach my $i (@ARGV) {"
NSQ_SOURCE_LINE 00004759 ""
NSQ_SOURCE_LINE 00004760 "        $i =~ s/^--/-/;"
NSQ_SOURCE_LINE 00004761 "        if ( $i =~ /^-(npro|noprofile|nopro|no-profile)$/ ) {"
NSQ_SOURCE_LINE 00004762 "            $saw_ignore_profile = 1;"
NSQ_SOURCE_LINE 00004763 "        }"
NSQ_SOURCE_LINE 00004764 ""
NSQ_SOURCE_LINE 00004765 "        # note: this must come before -pro and -profile, below:"
NSQ_SOURCE_LINE 00004766 "        elsif ( $i =~ /^-(dump-profile|dpro)$/ ) {"
NSQ_SOURCE_LINE 00004767 "            $saw_dump_profile = 1;"
NSQ_SOURCE_LINE 00004768 "        }"
NSQ_SOURCE_LINE 00004769 "        elsif ( $i =~ /^-(pro|profile)=(.+)/ ) {"
NSQ_SOURCE_LINE 00004770 "            if ( defined($config_file) ) {"
NSQ_SOURCE_LINE 00004771 "                Warn("
NSQ_SOURCE_LINE 00004772 "\"Only one -pro=filename allowed, using '$2' instead of '$config_file'\\n\""
NSQ_SOURCE_LINE 00004773 "                );"
NSQ_SOURCE_LINE 00004774 "            }"
NSQ_SOURCE_LINE 00004775 "            $config_file = $2;"
NSQ_SOURCE_LINE 00004776 ""
NSQ_SOURCE_LINE 00004777 "            # resolve <dir>/.../<file>, meaning look upwards from directory"
NSQ_SOURCE_LINE 00004778 "            if ( defined($config_file) ) {"
NSQ_SOURCE_LINE 00004779 "                if ( my ( $start_dir, $search_file ) ="
NSQ_SOURCE_LINE 00004780 "                    ( $config_file =~ m{^(.*)\\.\\.\\./(.*)$} ) )"
NSQ_SOURCE_LINE 00004781 "                {"
NSQ_SOURCE_LINE 00004782 "                    $start_dir = '.' if ( !$start_dir );"
NSQ_SOURCE_LINE 00004783 "                    $start_dir = Cwd::realpath($start_dir);"
NSQ_SOURCE_LINE 00004784 "                    my $found_file ="
NSQ_SOURCE_LINE 00004785 "                      find_file_upwards( $start_dir, $search_file );"
NSQ_SOURCE_LINE 00004786 "                    if ( defined($found_file) ) {"
NSQ_SOURCE_LINE 00004787 "                        $config_file = $found_file;"
NSQ_SOURCE_LINE 00004788 "                    }"
NSQ_SOURCE_LINE 00004789 "                }"
NSQ_SOURCE_LINE 00004790 "            }"
NSQ_SOURCE_LINE 00004791 "            if ( !-e $config_file ) {"
NSQ_SOURCE_LINE 00004792 "                Die("
NSQ_SOURCE_LINE 00004793 "                    \"cannot find file given with -pro=$config_file: $OS_ERROR\\n\""
NSQ_SOURCE_LINE 00004794 "                );"
NSQ_SOURCE_LINE 00004795 "            }"
NSQ_SOURCE_LINE 00004796 "        }"
NSQ_SOURCE_LINE 00004797 "        elsif ( $i =~ /^-(pro|profile)=?$/ ) {"
NSQ_SOURCE_LINE 00004798 "            Die(\"usage: -pro=filename or --profile=filename, no spaces\\n\");"
NSQ_SOURCE_LINE 00004799 "        }"
NSQ_SOURCE_LINE 00004800 "        elsif ( $i =~ /^-(?: help | [ h \\? ] )$/xi ) {"
NSQ_SOURCE_LINE 00004801 "            usage();"
NSQ_SOURCE_LINE 00004802 "            Exit(0);"
NSQ_SOURCE_LINE 00004803 "        }"
NSQ_SOURCE_LINE 00004804 "        elsif ( $i =~ /^-(version|v)$/ ) {"
NSQ_SOURCE_LINE 00004805 "            show_version();"
NSQ_SOURCE_LINE 00004806 "            Exit(0);"
NSQ_SOURCE_LINE 00004807 "        }"
NSQ_SOURCE_LINE 00004808 "        elsif ( $i =~ /^-(dump-defaults|ddf)$/ ) {"
NSQ_SOURCE_LINE 00004809 "            dump_defaults( @{$rdefaults} );"
NSQ_SOURCE_LINE 00004810 "            Exit(0);"
NSQ_SOURCE_LINE 00004811 "        }"
NSQ_SOURCE_LINE 00004812 "        elsif ( $i =~ /^-(dump-integer-option-range|dior)$/ ) {"
NSQ_SOURCE_LINE 00004813 "            dump_integer_option_range($rinteger_option_range);"
NSQ_SOURCE_LINE 00004814 "            Exit(0);"
NSQ_SOURCE_LINE 00004815 "        }"
NSQ_SOURCE_LINE 00004816 "        elsif ( $i =~ /^-(dump-long-names|dln)$/ ) {"
NSQ_SOURCE_LINE 00004817 "            dump_long_names( @{$roption_string} );"
NSQ_SOURCE_LINE 00004818 "            Exit(0);"
NSQ_SOURCE_LINE 00004819 "        }"
NSQ_SOURCE_LINE 00004820 "        elsif ( $i =~ /^-(dump-short-names|dsn)$/ ) {"
NSQ_SOURCE_LINE 00004821 "            dump_short_names($rexpansion);"
NSQ_SOURCE_LINE 00004822 "            Exit(0);"
NSQ_SOURCE_LINE 00004823 "        }"
NSQ_SOURCE_LINE 00004824 "        elsif ( $i =~ /^-(dump-token-types|dtt)$/ ) {"
NSQ_SOURCE_LINE 00004825 "            Perl::Tidy::Tokenizer->dump_token_types(*STDOUT);"
NSQ_SOURCE_LINE 00004826 "            Exit(0);"
NSQ_SOURCE_LINE 00004827 "        }"
NSQ_SOURCE_LINE 00004828 "        else {"
NSQ_SOURCE_LINE 00004829 "            ## no more special cases"
NSQ_SOURCE_LINE 00004830 "        }"
NSQ_SOURCE_LINE 00004831 "    }"
NSQ_SOURCE_LINE 00004832 ""
NSQ_SOURCE_LINE 00004833 "    # The above commands processed before disambiguation and then Exited.  So"
NSQ_SOURCE_LINE 00004834 "    # we need to check below to see if the user entered something like"
NSQ_SOURCE_LINE 00004835 "    # '-dump-t' or '-he'. This will slip past here and not get processed."
NSQ_SOURCE_LINE 00004836 "    my %early_exit_commands = ("
NSQ_SOURCE_LINE 00004837 "        'help'                      => 'h',"
NSQ_SOURCE_LINE 00004838 "        'version'                   => 'v',"
NSQ_SOURCE_LINE 00004839 "        'dump-defaults'             => 'ddf',"
NSQ_SOURCE_LINE 00004840 "        'dump-integer-option-range' => 'dior',"
NSQ_SOURCE_LINE 00004841 "        'dump-long-names'           => 'dln',"
NSQ_SOURCE_LINE 00004842 "        'dump-short-names'          => 'dsn',"
NSQ_SOURCE_LINE 00004843 "        'dump-token-types'          => 'dtt',"
NSQ_SOURCE_LINE 00004844 "    );"
NSQ_SOURCE_LINE 00004845 ""
NSQ_SOURCE_LINE 00004846 "    if ( $saw_dump_profile && $saw_ignore_profile ) {"
NSQ_SOURCE_LINE 00004847 "        Warn(\"No profile to dump because of -npro setting\\n\");"
NSQ_SOURCE_LINE 00004848 "        Exit(1);"
NSQ_SOURCE_LINE 00004849 "    }"
NSQ_SOURCE_LINE 00004850 ""
NSQ_SOURCE_LINE 00004851 "    #----------------------------------------"
NSQ_SOURCE_LINE 00004852 "    # read any .perltidyrc configuration file"
NSQ_SOURCE_LINE 00004853 "    #----------------------------------------"
NSQ_SOURCE_LINE 00004854 "    if ( !$saw_ignore_profile ) {"
NSQ_SOURCE_LINE 00004855 ""
NSQ_SOURCE_LINE 00004856 "        # resolve possible conflict between $perltidyrc_stream passed"
NSQ_SOURCE_LINE 00004857 "        # as call parameter to perltidy and -pro=filename on command"
NSQ_SOURCE_LINE 00004858 "        # line."
NSQ_SOURCE_LINE 00004859 "        if ($perltidyrc_stream) {"
NSQ_SOURCE_LINE 00004860 "            if ( defined($config_file) ) {"
NSQ_SOURCE_LINE 00004861 "                Warn(<<EOM);"
NSQ_SOURCE_LINE 00004862 " Conflict: a perltidyrc configuration file was specified both as this"
NSQ_SOURCE_LINE 00004863 " perltidy call parameter: $perltidyrc_stream"
NSQ_SOURCE_LINE 00004864 " and with this -profile=$config_file."
NSQ_SOURCE_LINE 00004865 " Using -profile=$config_file."
NSQ_SOURCE_LINE 00004866 "EOM"
NSQ_SOURCE_LINE 00004867 "            }"
NSQ_SOURCE_LINE 00004868 "            else {"
NSQ_SOURCE_LINE 00004869 "                $config_file = $perltidyrc_stream;"
NSQ_SOURCE_LINE 00004870 "            }"
NSQ_SOURCE_LINE 00004871 "        }"
NSQ_SOURCE_LINE 00004872 ""
NSQ_SOURCE_LINE 00004873 "        # look for a config file if we don't have one yet"
NSQ_SOURCE_LINE 00004874 "        my $rconfig_file_chatter;"
NSQ_SOURCE_LINE 00004875 "        ${$rconfig_file_chatter} = EMPTY_STRING;"
NSQ_SOURCE_LINE 00004876 "        if ( !defined($config_file) ) {"
NSQ_SOURCE_LINE 00004877 "            $config_file ="
NSQ_SOURCE_LINE 00004878 "              find_config_file( $is_Windows, $Windows_type,"
NSQ_SOURCE_LINE 00004879 "                $rconfig_file_chatter, $rpending_complaint );"
NSQ_SOURCE_LINE 00004880 "        }"
NSQ_SOURCE_LINE 00004881 ""
NSQ_SOURCE_LINE 00004882 "        # open any config file"
NSQ_SOURCE_LINE 00004883 "        my $rconfig_string;"
NSQ_SOURCE_LINE 00004884 "        if ( defined($config_file) ) {"
NSQ_SOURCE_LINE 00004885 "            $rconfig_string = stream_slurp($config_file);"
NSQ_SOURCE_LINE 00004886 "            if ( !defined($rconfig_string) ) {"
NSQ_SOURCE_LINE 00004887 "                Die("
NSQ_SOURCE_LINE 00004888 "\"exiting because profile '$config_file' could not be opened\\n\""
NSQ_SOURCE_LINE 00004889 "                );"
NSQ_SOURCE_LINE 00004890 "            }"
NSQ_SOURCE_LINE 00004891 "            filter_unknown_options("
NSQ_SOURCE_LINE 00004892 "                $rconfig_string, $roption_category,"
NSQ_SOURCE_LINE 00004893 "                $rexpansion,     $rconfig_file_chatter"
NSQ_SOURCE_LINE 00004894 "            );"
NSQ_SOURCE_LINE 00004895 "        }"
NSQ_SOURCE_LINE 00004896 "        if ($saw_dump_profile) {"
NSQ_SOURCE_LINE 00004897 "            dump_config_file( $rconfig_string, $config_file,"
NSQ_SOURCE_LINE 00004898 "                $rconfig_file_chatter );"
NSQ_SOURCE_LINE 00004899 "            Exit(0);"
NSQ_SOURCE_LINE 00004900 "        }"
NSQ_SOURCE_LINE 00004901 ""
NSQ_SOURCE_LINE 00004902 "        if ( defined($rconfig_string) ) {"
NSQ_SOURCE_LINE 00004903 ""
NSQ_SOURCE_LINE 00004904 "            my ( $rconfig_list, $death_message ) ="
NSQ_SOURCE_LINE 00004905 "              read_config_file( $rconfig_string, $config_file, $rexpansion );"
NSQ_SOURCE_LINE 00004906 "            Die($death_message) if ($death_message);"
NSQ_SOURCE_LINE 00004907 ""
NSQ_SOURCE_LINE 00004908 "            # process any .perltidyrc parameters right now so we can"
NSQ_SOURCE_LINE 00004909 "            # localize errors"
NSQ_SOURCE_LINE 00004910 "            if ( @{$rconfig_list} ) {"
NSQ_SOURCE_LINE 00004911 "                local @ARGV = @{$rconfig_list};"
NSQ_SOURCE_LINE 00004912 ""
NSQ_SOURCE_LINE 00004913 "                expand_command_abbreviations( $rexpansion, \\@raw_options,"
NSQ_SOURCE_LINE 00004914 "                    $config_file );"
NSQ_SOURCE_LINE 00004915 ""
NSQ_SOURCE_LINE 00004916 "                check_for_missing_string_options( $ris_string_option,"
NSQ_SOURCE_LINE 00004917 "                    $config_file );"
NSQ_SOURCE_LINE 00004918 ""
NSQ_SOURCE_LINE 00004919 "                if ( !GetOptions( \\%Opts, @{$roption_string} ) ) {"
NSQ_SOURCE_LINE 00004920 "                    Die("
NSQ_SOURCE_LINE 00004921 "\"Error in this config file: $config_file  \\nUse -npro to ignore this file, -dpro to dump it, -h for help'\\n\""
NSQ_SOURCE_LINE 00004922 "                    );"
NSQ_SOURCE_LINE 00004923 "                }"
NSQ_SOURCE_LINE 00004924 ""
NSQ_SOURCE_LINE 00004925 "                # Anything left in this local @ARGV is an error and must be"
NSQ_SOURCE_LINE 00004926 "                # invalid bare words from the configuration file.  We cannot"
NSQ_SOURCE_LINE 00004927 "                # check this earlier because bare words may have been valid"
NSQ_SOURCE_LINE 00004928 "                # values for parameters.  We had to wait for GetOptions to have"
NSQ_SOURCE_LINE 00004929 "                # a look at @ARGV."
NSQ_SOURCE_LINE 00004930 "                if (@ARGV) {"
NSQ_SOURCE_LINE 00004931 "                    my $count = @ARGV;"
NSQ_SOURCE_LINE 00004932 "                    my $str   = EMPTY_STRING;"
NSQ_SOURCE_LINE 00004933 "                    foreach my $param (@ARGV) {"
NSQ_SOURCE_LINE 00004934 "                        if ( length($str) < 70 ) {"
NSQ_SOURCE_LINE 00004935 "                            if ($str) { $str .= ', ' }"
NSQ_SOURCE_LINE 00004936 "                            $str .= \"'$param'\";"
NSQ_SOURCE_LINE 00004937 "                        }"
NSQ_SOURCE_LINE 00004938 "                        else {"
NSQ_SOURCE_LINE 00004939 "                            $str .= \", ...\";"
NSQ_SOURCE_LINE 00004940 "                            last;"
NSQ_SOURCE_LINE 00004941 "                        }"
NSQ_SOURCE_LINE 00004942 "                    }"
NSQ_SOURCE_LINE 00004943 "                    Die(<<EOM);"
NSQ_SOURCE_LINE 00004944 "There are $count unrecognized values in the configuration file '$config_file':"
NSQ_SOURCE_LINE 00004945 "$str"
NSQ_SOURCE_LINE 00004946 "Use leading dashes for parameters.  Use -npro to ignore this file."
NSQ_SOURCE_LINE 00004947 "EOM"
NSQ_SOURCE_LINE 00004948 "                }"
NSQ_SOURCE_LINE 00004949 ""
NSQ_SOURCE_LINE 00004950 "                # Undo any options which cause premature exit.  They are not"
NSQ_SOURCE_LINE 00004951 "                # appropriate for a config file, and it could be hard to"
NSQ_SOURCE_LINE 00004952 "                # diagnose the cause of the premature exit."
NSQ_SOURCE_LINE 00004953 ""
NSQ_SOURCE_LINE 00004954 "                # These are options include dump switches of the form"
NSQ_SOURCE_LINE 00004955 "                # '--dump-xxx-xxx!'."
NSQ_SOURCE_LINE 00004956 "                my @dump_commands ="
NSQ_SOURCE_LINE 00004957 "                  grep { /^(dump-.*)!$/ } @{$roption_string};"
NSQ_SOURCE_LINE 00004958 "                foreach (@dump_commands) { s/!$// }"
NSQ_SOURCE_LINE 00004959 ""
NSQ_SOURCE_LINE 00004960 "                # Here is a current list of these @dump_commands:"
NSQ_SOURCE_LINE 00004961 "                #  dump-block-summary"
NSQ_SOURCE_LINE 00004962 "                #  dump-cuddled-block-list"
NSQ_SOURCE_LINE 00004963 "                #  dump-defaults"
NSQ_SOURCE_LINE 00004964 "                #  dump-integer-option-range"
NSQ_SOURCE_LINE 00004965 "                #  dump-long-names"
NSQ_SOURCE_LINE 00004966 "                #  dump-mismatched-args"
NSQ_SOURCE_LINE 00004967 "                #  dump-mismatched-returns"
NSQ_SOURCE_LINE 00004968 "                #  dump-mixed-call-parens"
NSQ_SOURCE_LINE 00004969 "                #  dump-options"
NSQ_SOURCE_LINE 00004970 "                #  dump-profile"
NSQ_SOURCE_LINE 00004971 "                #  dump-short-names"
NSQ_SOURCE_LINE 00004972 "                #  dump-token-types"
NSQ_SOURCE_LINE 00004973 "                #  dump-unusual-variables"
NSQ_SOURCE_LINE 00004974 "                #  dump-want-left-space"
NSQ_SOURCE_LINE 00004975 "                #  dump-want-right-space"
NSQ_SOURCE_LINE 00004976 "                #  dump-keyword-usage"
NSQ_SOURCE_LINE 00004977 ""
NSQ_SOURCE_LINE 00004978 "                # The following dump configuration parameters which"
NSQ_SOURCE_LINE 00004979 "                # take =i or =s would still be allowed:"
NSQ_SOURCE_LINE 00004980 "                #  dump-block-minimum-lines,        'dbl',   '=i' );"
NSQ_SOURCE_LINE 00004981 "                #  dump-block-types,                'dbt',   '=s' );"
NSQ_SOURCE_LINE 00004982 "                #  dump-keyword-usage-list,         'dkul',  '=s' );"
NSQ_SOURCE_LINE 00004983 ""
NSQ_SOURCE_LINE 00004984 "                foreach my $cmd ("
NSQ_SOURCE_LINE 00004985 "                    @dump_commands,"
NSQ_SOURCE_LINE 00004986 "                    qw{"
NSQ_SOURCE_LINE 00004987 "                    help"
NSQ_SOURCE_LINE 00004988 "                    stylesheet"
NSQ_SOURCE_LINE 00004989 "                    version"
NSQ_SOURCE_LINE 00004990 "                    }"
NSQ_SOURCE_LINE 00004991 "                  )"
NSQ_SOURCE_LINE 00004992 "                {"
NSQ_SOURCE_LINE 00004993 "                    if ( defined( $Opts{$cmd} ) ) {"
NSQ_SOURCE_LINE 00004994 "                        delete $Opts{$cmd};"
NSQ_SOURCE_LINE 00004995 "                        Warn(\"ignoring --$cmd in config file: $config_file\\n\");"
NSQ_SOURCE_LINE 00004996 "                    }"
NSQ_SOURCE_LINE 00004997 "                }"
NSQ_SOURCE_LINE 00004998 "            }"
NSQ_SOURCE_LINE 00004999 "        }"
NSQ_SOURCE_LINE 00005000 "    }"
NSQ_SOURCE_LINE 00005001 ""
NSQ_SOURCE_LINE 00005002 "    # Save selected options seen in the profile for use in error checking"
NSQ_SOURCE_LINE 00005003 "    my %Opts_in_profile = ();"
NSQ_SOURCE_LINE 00005004 "    foreach my $opt ("
NSQ_SOURCE_LINE 00005005 "        qw("
NSQ_SOURCE_LINE 00005006 "        backup-and-modify-in-place"
NSQ_SOURCE_LINE 00005007 "        standard-output"
NSQ_SOURCE_LINE 00005008 "        )"
NSQ_SOURCE_LINE 00005009 "      )"
NSQ_SOURCE_LINE 00005010 "    {"
NSQ_SOURCE_LINE 00005011 "        $Opts_in_profile{$opt} = $Opts{$opt};"
NSQ_SOURCE_LINE 00005012 "    }"
NSQ_SOURCE_LINE 00005013 ""
NSQ_SOURCE_LINE 00005014 "    #----------------------------------------"
NSQ_SOURCE_LINE 00005015 "    # now process the command line parameters"
NSQ_SOURCE_LINE 00005016 "    #----------------------------------------"
NSQ_SOURCE_LINE 00005017 "    expand_command_abbreviations( $rexpansion, \\@raw_options, $config_file );"
NSQ_SOURCE_LINE 00005018 ""
NSQ_SOURCE_LINE 00005019 "    check_for_missing_string_options($ris_string_option);"
NSQ_SOURCE_LINE 00005020 ""
NSQ_SOURCE_LINE 00005021 "    local $SIG{'__WARN__'} = sub { Warn( $_[0] ) };"
NSQ_SOURCE_LINE 00005022 "    if ( !GetOptions( \\%Opts, @{$roption_string} ) ) {"
NSQ_SOURCE_LINE 00005023 "        Die(\"Error on command line; for help try 'perltidy -h'\\n\");"
NSQ_SOURCE_LINE 00005024 "    }"
NSQ_SOURCE_LINE 00005025 ""
NSQ_SOURCE_LINE 00005026 "    # Catch ambiguous entries which should have exited above (c333)"
NSQ_SOURCE_LINE 00005027 "    foreach my $long_name ( keys %early_exit_commands ) {"
NSQ_SOURCE_LINE 00005028 "        if ( $Opts{$long_name} ) {"
NSQ_SOURCE_LINE 00005029 "            my $short_name = $early_exit_commands{$long_name};"
NSQ_SOURCE_LINE 00005030 "            Die(<<EOM);"
NSQ_SOURCE_LINE 00005031 "Ambiguous entry; please enter '--$long_name' or '-$short_name'"
NSQ_SOURCE_LINE 00005032 "EOM"
NSQ_SOURCE_LINE 00005033 "        }"
NSQ_SOURCE_LINE 00005034 "    }"
NSQ_SOURCE_LINE 00005035 ""
NSQ_SOURCE_LINE 00005036 "    # reset Getopt::Long configuration back to its previous value"
NSQ_SOURCE_LINE 00005037 "    if ( defined($glc) ) {"
NSQ_SOURCE_LINE 00005038 "        my $ok = eval { Getopt::Long::Configure($glc); 1 };"
NSQ_SOURCE_LINE 00005039 "        if ( !$ok && DEVEL_MODE ) {"
NSQ_SOURCE_LINE 00005040 "            Fault(\"Could not reset Getopt::Long configuration: $EVAL_ERROR\\n\");"
NSQ_SOURCE_LINE 00005041 "        }"
NSQ_SOURCE_LINE 00005042 "    }"
NSQ_SOURCE_LINE 00005043 ""
NSQ_SOURCE_LINE 00005044 "    return ("
NSQ_SOURCE_LINE 00005045 "        \\%Opts,                 $config_file,       \\@raw_options,"
NSQ_SOURCE_LINE 00005046 "        $roption_string,        $rexpansion,        $roption_category,"
NSQ_SOURCE_LINE 00005047 "        $rinteger_option_range, $ris_string_option, \\%Opts_in_profile"
NSQ_SOURCE_LINE 00005048 "    );"
NSQ_SOURCE_LINE 00005049 "} ## end sub _process_command_line"
NSQ_SOURCE_LINE 00005050 ""
NSQ_SOURCE_LINE 00005051 "sub make_grep_alias_string {"
NSQ_SOURCE_LINE 00005052 ""
NSQ_SOURCE_LINE 00005053 "    my ($rOpts) = @_;"
NSQ_SOURCE_LINE 00005054 ""
NSQ_SOURCE_LINE 00005055 "    # pre-process the --grep-alias-list parameter"
NSQ_SOURCE_LINE 00005056 ""
NSQ_SOURCE_LINE 00005057 "    # Defaults: list operators in List::Util"
NSQ_SOURCE_LINE 00005058 "    # Possible future additions:  pairfirst pairgrep pairmap"
NSQ_SOURCE_LINE 00005059 "    my $default_string = join SPACE,"
NSQ_SOURCE_LINE 00005060 "      qw( all any first none notall reduce reductions );"
NSQ_SOURCE_LINE 00005061 ""
NSQ_SOURCE_LINE 00005062 "    # make a hash of any excluded words"
NSQ_SOURCE_LINE 00005063 "    my %is_excluded_word;"
NSQ_SOURCE_LINE 00005064 "    my $opt_name       = 'grep-alias-exclusion-list';"
NSQ_SOURCE_LINE 00005065 "    my $exclude_string = $rOpts->{$opt_name};"
NSQ_SOURCE_LINE 00005066 "    if ($exclude_string) {"
NSQ_SOURCE_LINE 00005067 "        $exclude_string =~ s/,/ /g;    # allow commas"
NSQ_SOURCE_LINE 00005068 "        $exclude_string =~ s/^\\s+//;"
NSQ_SOURCE_LINE 00005069 "        $exclude_string =~ s/\\s+$//;"
NSQ_SOURCE_LINE 00005070 "        my @q = split /\\s+/, $exclude_string;"
NSQ_SOURCE_LINE 00005071 "        $is_excluded_word{$_} = 1 for @q;"
NSQ_SOURCE_LINE 00005072 "        if ( !$is_excluded_word{'*'} ) {"
NSQ_SOURCE_LINE 00005073 "            check_for_valid_words("
NSQ_SOURCE_LINE 00005074 "                {"
NSQ_SOURCE_LINE 00005075 "                    rinput_list => \\@q,"
NSQ_SOURCE_LINE 00005076 "                    option_name => \"--$opt_name\","
NSQ_SOURCE_LINE 00005077 "                    on_error    => 'die',"
NSQ_SOURCE_LINE 00005078 "                }"
NSQ_SOURCE_LINE 00005079 "            );"
NSQ_SOURCE_LINE 00005080 "        }"
NSQ_SOURCE_LINE 00005081 "    }"
NSQ_SOURCE_LINE 00005082 ""
NSQ_SOURCE_LINE 00005083 "    # The special option -gaxl='*' removes all defaults"
NSQ_SOURCE_LINE 00005084 "    if ( $is_excluded_word{'*'} ) { $default_string = EMPTY_STRING }"
NSQ_SOURCE_LINE 00005085 ""
NSQ_SOURCE_LINE 00005086 "    # combine the defaults and any input list"
NSQ_SOURCE_LINE 00005087 "    $opt_name = 'grep-alias-list';"
NSQ_SOURCE_LINE 00005088 "    my $input_string = $rOpts->{$opt_name};"
NSQ_SOURCE_LINE 00005089 "    if ($input_string) { $input_string .= SPACE . $default_string }"
NSQ_SOURCE_LINE 00005090 "    else               { $input_string = $default_string }"
NSQ_SOURCE_LINE 00005091 ""
NSQ_SOURCE_LINE 00005092 "    # Now make the final list of unique grep alias words"
NSQ_SOURCE_LINE 00005093 "    $input_string =~ s/,/ /g;    # allow commas"
NSQ_SOURCE_LINE 00005094 "    $input_string =~ s/^\\s+//;"
NSQ_SOURCE_LINE 00005095 "    $input_string =~ s/\\s+$//;"
NSQ_SOURCE_LINE 00005096 "    my @word_list = split /\\s+/, $input_string;"
NSQ_SOURCE_LINE 00005097 "    my @filtered_word_list;"
NSQ_SOURCE_LINE 00005098 "    my %seen;"
NSQ_SOURCE_LINE 00005099 ""
NSQ_SOURCE_LINE 00005100 "    foreach my $word (@word_list) {"
NSQ_SOURCE_LINE 00005101 "        if ( !$seen{$word} && !$is_excluded_word{$word} ) {"
NSQ_SOURCE_LINE 00005102 "            $seen{$word}++;"
NSQ_SOURCE_LINE 00005103 "            push @filtered_word_list, $word;"
NSQ_SOURCE_LINE 00005104 "        }"
NSQ_SOURCE_LINE 00005105 "    }"
NSQ_SOURCE_LINE 00005106 ""
NSQ_SOURCE_LINE 00005107 "    check_for_valid_words("
NSQ_SOURCE_LINE 00005108 "        {"
NSQ_SOURCE_LINE 00005109 "            rinput_list => \\@filtered_word_list,"
NSQ_SOURCE_LINE 00005110 "            option_name => \"--$opt_name\","
NSQ_SOURCE_LINE 00005111 "            on_error    => 'die',"
NSQ_SOURCE_LINE 00005112 "        }"
NSQ_SOURCE_LINE 00005113 "    );"
NSQ_SOURCE_LINE 00005114 ""
NSQ_SOURCE_LINE 00005115 "    my $joined_words = join SPACE, @filtered_word_list;"
NSQ_SOURCE_LINE 00005116 "    $rOpts->{$opt_name} = $joined_words;"
NSQ_SOURCE_LINE 00005117 ""
NSQ_SOURCE_LINE 00005118 "    return;"
NSQ_SOURCE_LINE 00005119 "} ## end sub make_grep_alias_string"
NSQ_SOURCE_LINE 00005120 ""
NSQ_SOURCE_LINE 00005121 "sub cleanup_word_list {"
NSQ_SOURCE_LINE 00005122 ""
NSQ_SOURCE_LINE 00005123 "    my ( $rOpts, $option_name, $rforced_words ) = @_;"
NSQ_SOURCE_LINE 00005124 ""
NSQ_SOURCE_LINE 00005125 "    # Clean up the list of words in a user option to simplify use by"
NSQ_SOURCE_LINE 00005126 "    # later routines (delete repeats, replace commas with single space,"
NSQ_SOURCE_LINE 00005127 "    # remove non-words)"
NSQ_SOURCE_LINE 00005128 ""
NSQ_SOURCE_LINE 00005129 "    # Given:"
NSQ_SOURCE_LINE 00005130 "    #   $rOpts - the global option hash"
NSQ_SOURCE_LINE 00005131 "    #   $option_name - hash key of this option"
NSQ_SOURCE_LINE 00005132 "    #   $rforced_words - ref to list of any words to be added"
NSQ_SOURCE_LINE 00005133 ""
NSQ_SOURCE_LINE 00005134 "    # Returns:"
NSQ_SOURCE_LINE 00005135 "    #   \\%seen - hash of the final list of words"
NSQ_SOURCE_LINE 00005136 ""
NSQ_SOURCE_LINE 00005137 "    my %seen;"
NSQ_SOURCE_LINE 00005138 "    my @input_list;"
NSQ_SOURCE_LINE 00005139 ""
NSQ_SOURCE_LINE 00005140 "    my $input_string = $rOpts->{$option_name};"
NSQ_SOURCE_LINE 00005141 "    if ( defined($input_string) && length($input_string) ) {"
NSQ_SOURCE_LINE 00005142 "        $input_string =~ s/,/ /g;    # allow commas"
NSQ_SOURCE_LINE 00005143 "        $input_string =~ s/^\\s+//;"
NSQ_SOURCE_LINE 00005144 "        $input_string =~ s/\\s+$//;"
NSQ_SOURCE_LINE 00005145 "        @input_list = split /\\s+/, $input_string;"
NSQ_SOURCE_LINE 00005146 "    }"
NSQ_SOURCE_LINE 00005147 ""
NSQ_SOURCE_LINE 00005148 "    if ($rforced_words) {"
NSQ_SOURCE_LINE 00005149 "        push @input_list, @{$rforced_words};"
NSQ_SOURCE_LINE 00005150 "    }"
NSQ_SOURCE_LINE 00005151 ""
NSQ_SOURCE_LINE 00005152 "    my @filtered_word_list;"
NSQ_SOURCE_LINE 00005153 "    foreach my $word (@input_list) {"
NSQ_SOURCE_LINE 00005154 "        if ( !$seen{$word} ) {"
NSQ_SOURCE_LINE 00005155 "            $seen{$word}++;"
NSQ_SOURCE_LINE 00005156 "            push @filtered_word_list, $word;"
NSQ_SOURCE_LINE 00005157 "        }"
NSQ_SOURCE_LINE 00005158 "    }"
NSQ_SOURCE_LINE 00005159 "    check_for_valid_words("
NSQ_SOURCE_LINE 00005160 "        {"
NSQ_SOURCE_LINE 00005161 "            rinput_list => \\@filtered_word_list,"
NSQ_SOURCE_LINE 00005162 "            option_name => \"--$option_name\","
NSQ_SOURCE_LINE 00005163 "            on_error    => 'die',"
NSQ_SOURCE_LINE 00005164 "        }"
NSQ_SOURCE_LINE 00005165 "    );"
NSQ_SOURCE_LINE 00005166 "    $rOpts->{$option_name} = join SPACE, @filtered_word_list;"
NSQ_SOURCE_LINE 00005167 "    return \\%seen;"
NSQ_SOURCE_LINE 00005168 "} ## end sub cleanup_word_list"
NSQ_SOURCE_LINE 00005169 ""
NSQ_SOURCE_LINE 00005170 "sub check_string_options {"
NSQ_SOURCE_LINE 00005171 "    my ( $self, $ris_string_option ) = @_;"
NSQ_SOURCE_LINE 00005172 ""
NSQ_SOURCE_LINE 00005173 "    # Make some basic checks for invalid characters in user-defined strings."
NSQ_SOURCE_LINE 00005174 "    # More detailed checks are made later in sub check_options."
NSQ_SOURCE_LINE 00005175 ""
NSQ_SOURCE_LINE 00005176 "    my $rOpts   = $self->[_rOpts_];"
NSQ_SOURCE_LINE 00005177 "    my $message = EMPTY_STRING;"
NSQ_SOURCE_LINE 00005178 ""
NSQ_SOURCE_LINE 00005179 "    my @all_string_options = grep { $ris_string_option->{$_} } keys %{$rOpts};"
NSQ_SOURCE_LINE 00005180 "    my @html_color_options = grep { /^html-color-/ } @all_string_options;"
NSQ_SOURCE_LINE 00005181 ""
NSQ_SOURCE_LINE 00005182 "    my @filename_options = qw("
NSQ_SOURCE_LINE 00005183 "      cachedir"
NSQ_SOURCE_LINE 00005184 "      html-linked-style-sheet"
NSQ_SOURCE_LINE 00005185 "      htmlroot"
NSQ_SOURCE_LINE 00005186 "      libpods"
NSQ_SOURCE_LINE 00005187 "      outfile"
NSQ_SOURCE_LINE 00005188 "      output-path"
NSQ_SOURCE_LINE 00005189 "      podpath"
NSQ_SOURCE_LINE 00005190 "      podroot"
NSQ_SOURCE_LINE 00005191 "    );"
NSQ_SOURCE_LINE 00005192 ""
NSQ_SOURCE_LINE 00005193 "    my @file_extension_options = qw("
NSQ_SOURCE_LINE 00005194 "      backup-file-extension"
NSQ_SOURCE_LINE 00005195 "      html-src-extension"
NSQ_SOURCE_LINE 00005196 "      html-toc-extension"
NSQ_SOURCE_LINE 00005197 "      output-file-extension"
NSQ_SOURCE_LINE 00005198 "    );"
NSQ_SOURCE_LINE 00005199 ""
NSQ_SOURCE_LINE 00005200 "    # What to check:"
NSQ_SOURCE_LINE 00005201 "    my %leading_dash_check ="
NSQ_SOURCE_LINE 00005202 "      map { $_ => 1 } ( @filename_options, @html_color_options );"
NSQ_SOURCE_LINE 00005203 "    my %leading_space_check ="
NSQ_SOURCE_LINE 00005204 "      map { $_ => 1 } ( @filename_options, @file_extension_options );"
NSQ_SOURCE_LINE 00005205 "    my %trailing_space_check = %leading_space_check;"
NSQ_SOURCE_LINE 00005206 ""
NSQ_SOURCE_LINE 00005207 "    foreach my $opt_name (@all_string_options) {"
NSQ_SOURCE_LINE 00005208 "        my $test_string = $rOpts->{$opt_name};"
NSQ_SOURCE_LINE 00005209 ""
NSQ_SOURCE_LINE 00005210 "        next if ( !defined($test_string) );"
NSQ_SOURCE_LINE 00005211 ""
NSQ_SOURCE_LINE 00005212 "        # Printable character check for all string options"
NSQ_SOURCE_LINE 00005213 "        if ( $test_string =~ /[^[:print:]]/g ) {"
NSQ_SOURCE_LINE 00005214 "            my $pos = pos($test_string);"
NSQ_SOURCE_LINE 00005215 "            my $ch  = substr( $test_string, $pos - 1, 1 );"
NSQ_SOURCE_LINE 00005216 "            my $ord = ord($ch);"
NSQ_SOURCE_LINE 00005217 "            $message .= <<EOM;"
NSQ_SOURCE_LINE 00005218 "--$opt_name has non-printable character(s) at character number $pos, decimal value=$ord"
NSQ_SOURCE_LINE 00005219 "EOM"
NSQ_SOURCE_LINE 00005220 "        }"
NSQ_SOURCE_LINE 00005221 ""
NSQ_SOURCE_LINE 00005222 "        # Leading dash check"
NSQ_SOURCE_LINE 00005223 "        if ( $leading_dash_check{$opt_name}"
NSQ_SOURCE_LINE 00005224 "            && substr( $test_string, 0, 1 ) eq '-' )"
NSQ_SOURCE_LINE 00005225 "        {"
NSQ_SOURCE_LINE 00005226 "            my $hint = EMPTY_STRING;"
NSQ_SOURCE_LINE 00005227 "            if ( $opt_name eq 'outfile' || $opt_name eq 'output_path' ) {"
NSQ_SOURCE_LINE 00005228 "                $hint .= \"; add leading path (like ./) if necessary\";"
NSQ_SOURCE_LINE 00005229 "            }"
NSQ_SOURCE_LINE 00005230 "            $message .= <<EOM;"
NSQ_SOURCE_LINE 00005231 "--$opt_name string must not begin with a dash$hint"
NSQ_SOURCE_LINE 00005232 "EOM"
NSQ_SOURCE_LINE 00005233 "        }"
NSQ_SOURCE_LINE 00005234 ""
NSQ_SOURCE_LINE 00005235 "        # Leading space checks"
NSQ_SOURCE_LINE 00005236 "        if ( $leading_space_check{$opt_name} && $test_string =~ /^\\s/ ) {"
NSQ_SOURCE_LINE 00005237 "            $message .= \"--$opt_name must not contain leading spaces\\n\";"
NSQ_SOURCE_LINE 00005238 "        }"
NSQ_SOURCE_LINE 00005239 ""
NSQ_SOURCE_LINE 00005240 "        # Trailing space check"
NSQ_SOURCE_LINE 00005241 "        if ( $trailing_space_check{$opt_name} && $test_string =~ /\\s$/ ) {"
NSQ_SOURCE_LINE 00005242 "            $message .= \"--$opt_name must not contain trailing spaces\\n\";"
NSQ_SOURCE_LINE 00005243 "        }"
NSQ_SOURCE_LINE 00005244 "    }"
NSQ_SOURCE_LINE 00005245 ""
NSQ_SOURCE_LINE 00005246 "    if ($message) {"
NSQ_SOURCE_LINE 00005247 "        Die($message);"
NSQ_SOURCE_LINE 00005248 "    }"
NSQ_SOURCE_LINE 00005249 ""
NSQ_SOURCE_LINE 00005250 "    return;"
NSQ_SOURCE_LINE 00005251 "} ## end sub check_string_options"
NSQ_SOURCE_LINE 00005252 ""
NSQ_SOURCE_LINE 00005253 "sub check_options {"
NSQ_SOURCE_LINE 00005254 ""
NSQ_SOURCE_LINE 00005255 "    my ( $self, $num_files, $rinteger_option_range, $ris_string_option ) = @_;"
NSQ_SOURCE_LINE 00005256 ""
NSQ_SOURCE_LINE 00005257 "    # Check options at a high level. Note that other modules have their"
NSQ_SOURCE_LINE 00005258 "    # own sub 'check_options' for lower level checking."
NSQ_SOURCE_LINE 00005259 ""
NSQ_SOURCE_LINE 00005260 "    # Input parameters:"
NSQ_SOURCE_LINE 00005261 "    #  $num_files = the number of files to be processed in this call to"
NSQ_SOURCE_LINE 00005262 "    #     perltidy, needed for error checks."
NSQ_SOURCE_LINE 00005263 "    #  $rinteger_option-range = hash with valid ranges of parameters which"
NSQ_SOURCE_LINE 00005264 "    #     take an integer"
NSQ_SOURCE_LINE 00005265 ""
NSQ_SOURCE_LINE 00005266 "    my $rOpts = $self->[_rOpts_];"
NSQ_SOURCE_LINE 00005267 ""
NSQ_SOURCE_LINE 00005268 "    #------------------------------------------------------------"
NSQ_SOURCE_LINE 00005269 "    # check and handle any interactions among the basic options.."
NSQ_SOURCE_LINE 00005270 "    #------------------------------------------------------------"
NSQ_SOURCE_LINE 00005271 ""
NSQ_SOURCE_LINE 00005272 "    # Since perltidy only encodes in utf8, problems can occur if we let it"
NSQ_SOURCE_LINE 00005273 "    # decode anything else.  See discussions for issue git #83."
NSQ_SOURCE_LINE 00005274 "    my $encoding = $rOpts->{'character-encoding'};"
NSQ_SOURCE_LINE 00005275 "    if ( $encoding !~ /^\\s*(?:guess|none|utf8|utf-8)\\s*$/i ) {"
NSQ_SOURCE_LINE 00005276 "        Die(<<EOM);"
NSQ_SOURCE_LINE 00005277 "--character-encoding = '$encoding' is not allowed; the options are: 'none', 'guess', 'utf8'"
NSQ_SOURCE_LINE 00005278 "EOM"
NSQ_SOURCE_LINE 00005279 "    }"
NSQ_SOURCE_LINE 00005280 ""
NSQ_SOURCE_LINE 00005281 "    # Check for integer values out of bounds as follows:"
NSQ_SOURCE_LINE 00005282 "    #  $integer_range_check="
NSQ_SOURCE_LINE 00005283 "    #    1 => quietly reset bad values to defaults"
NSQ_SOURCE_LINE 00005284 "    #    2 => issue warning and reset bad values to defaults [DEFAULT]"
NSQ_SOURCE_LINE 00005285 "    #    3 => stop if any values are out of bounds"
NSQ_SOURCE_LINE 00005286 "    # Note: Previously a value of 0 meant to skip this check. This provided a"
NSQ_SOURCE_LINE 00005287 "    # workaround in case this logic caused a problem. This is no longer needed."
NSQ_SOURCE_LINE 00005288 "    my $integer_range_check = $rOpts->{'integer-range-check'};"
NSQ_SOURCE_LINE 00005289 "    if (   !defined($integer_range_check)"
NSQ_SOURCE_LINE 00005290 "        || $integer_range_check <= 0"
NSQ_SOURCE_LINE 00005291 "        || $integer_range_check > 3 )"
NSQ_SOURCE_LINE 00005292 "    {"
NSQ_SOURCE_LINE 00005293 "        $integer_range_check = 2;"
NSQ_SOURCE_LINE 00005294 "    }"
NSQ_SOURCE_LINE 00005295 ""
NSQ_SOURCE_LINE 00005296 "    if ($integer_range_check) {"
NSQ_SOURCE_LINE 00005297 "        my $Error_message;"
NSQ_SOURCE_LINE 00005298 "        foreach my $opt ( keys %{$rinteger_option_range} ) {"
NSQ_SOURCE_LINE 00005299 "            my $val = $rOpts->{$opt};"
NSQ_SOURCE_LINE 00005300 "            next unless ( defined($val) );"
NSQ_SOURCE_LINE 00005301 "            my $range = $rinteger_option_range->{$opt};"
NSQ_SOURCE_LINE 00005302 "            next unless ( defined($range) );"
NSQ_SOURCE_LINE 00005303 "            my ( $min, $max, $default ) = @{$range};"
NSQ_SOURCE_LINE 00005304 ""
NSQ_SOURCE_LINE 00005305 "            if ( defined($min) && $val < $min ) {"
NSQ_SOURCE_LINE 00005306 "                $Error_message .= \"--$opt=$val but should be >= $min\";"
NSQ_SOURCE_LINE 00005307 "                if ( $integer_range_check < 3 ) {"
NSQ_SOURCE_LINE 00005308 "                    $rOpts->{$opt} = $default;"
