NSQ_SOURCE_LINE 00001175 "    $rstatus->{'opt_encode_output'} ="
NSQ_SOURCE_LINE 00001176 "      $rOpts->{'encode-output-strings'} ? 'eos' : 'neos';"
NSQ_SOURCE_LINE 00001177 ""
NSQ_SOURCE_LINE 00001178 "    # be sure we have a valid output format"
NSQ_SOURCE_LINE 00001179 "    if ( !exists $default_file_extension{ $rOpts->{'format'} } ) {"
NSQ_SOURCE_LINE 00001180 "        my $formats = join SPACE,"
