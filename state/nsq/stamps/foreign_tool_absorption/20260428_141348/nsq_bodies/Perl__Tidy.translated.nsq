NSQ_SOURCE_LINE 00001164 "    }"
NSQ_SOURCE_LINE 00001165 ""
NSQ_SOURCE_LINE 00001166 "    # there must be one entry here for every possible format"
NSQ_SOURCE_LINE 00001167 "    my %default_file_extension = ("
NSQ_SOURCE_LINE 00001168 "        tidy => 'tdy',"
NSQ_SOURCE_LINE 00001169 "        html => 'html',"
NSQ_SOURCE_LINE 00001170 "        user => EMPTY_STRING,"
NSQ_SOURCE_LINE 00001171 "    );"
NSQ_SOURCE_LINE 00001172 ""
