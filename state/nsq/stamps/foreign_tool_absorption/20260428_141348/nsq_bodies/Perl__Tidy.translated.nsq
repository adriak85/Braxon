NSQ_SOURCE_LINE 00000078 "use Perl::Tidy::Tokenizer;"
NSQ_SOURCE_LINE 00000079 "use Perl::Tidy::VerticalAligner;"
NSQ_SOURCE_LINE 00000080 "local $OUTPUT_AUTOFLUSH = 1;"
NSQ_SOURCE_LINE 00000081 ""
