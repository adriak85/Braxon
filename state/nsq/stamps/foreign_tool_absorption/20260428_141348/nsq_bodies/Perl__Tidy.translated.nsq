NSQ_SOURCE_LINE 00000083 "use constant DEVEL_MODE   => 0;"
NSQ_SOURCE_LINE 00000084 "use constant DIAGNOSTICS  => 0;"
NSQ_SOURCE_LINE 00000085 "use constant EMPTY_STRING => q{};"
NSQ_SOURCE_LINE 00000086 "use constant SPACE        => q{ };"
NSQ_SOURCE_LINE 00000087 "use constant CONST_1024   => 1024;    # bytes per kb; 2**10"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "use vars qw{"
NSQ_SOURCE_LINE 00000090 "  $VERSION"
NSQ_SOURCE_LINE 00000091 "  @ISA"
NSQ_SOURCE_LINE 00000092 "  @EXPORT"
NSQ_SOURCE_LINE 00000093 "};"
NSQ_SOURCE_LINE 00000094 ""
