NSQ_SOURCE_LINE 00001197 ""
NSQ_SOURCE_LINE 00001198 "    my $line_range_clipped = $rOpts->{'line-range-tidy'}"
NSQ_SOURCE_LINE 00001199 "      && ( $self->[_line_tidy_begin_] > 1"
NSQ_SOURCE_LINE 00001200 "        || defined( $self->[_line_tidy_end_] ) );"
NSQ_SOURCE_LINE 00001201 ""
NSQ_SOURCE_LINE 00001202 "    Perl::Tidy::Formatter::check_options( $rOpts, $wvt_in_args, $num_files,"
NSQ_SOURCE_LINE 00001203 "        $line_range_clipped );"
NSQ_SOURCE_LINE 00001204 "    Perl::Tidy::Tokenizer::check_options($rOpts);"
NSQ_SOURCE_LINE 00001205 "    Perl::Tidy::VerticalAligner::check_options($rOpts);"
NSQ_SOURCE_LINE 00001206 "    if ( $rOpts->{'format'} eq 'html' ) {"
NSQ_SOURCE_LINE 00001207 "        Perl::Tidy::HtmlWriter->check_options($rOpts);"
NSQ_SOURCE_LINE 00001208 "    }"
NSQ_SOURCE_LINE 00001209 ""
NSQ_SOURCE_LINE 00001210 "    # Try to catch an unusual missing string parameter error, where the"
NSQ_SOURCE_LINE 00001211 "    # intention is to format infile.pl, like this:"
NSQ_SOURCE_LINE 00001212 "    #    perltidy -title infile.pl"
NSQ_SOURCE_LINE 00001213 "    # The problem is that -title wants a string, so it grabs 'infile.pl'.  Then"
NSQ_SOURCE_LINE 00001214 "    # there is no filename, so input is assumed to be stdin.  This make"
NSQ_SOURCE_LINE 00001215 "    # perltidy unexpectedly wait for input. To the user, it appears that"
NSQ_SOURCE_LINE 00001216 "    # perltidy has gone into an infinite loop.  For most options, but not all,"
NSQ_SOURCE_LINE 00001217 "    # previous checks for bad string input will have already caught the"
NSQ_SOURCE_LINE 00001218 "    # problem.  A timeout will eventually occur as a final backup method for"
NSQ_SOURCE_LINE 00001219 "    # catching this problem.  Issue c312."
NSQ_SOURCE_LINE 00001220 "    if ( !$num_files && @ARGV_saved > 1 ) {"
NSQ_SOURCE_LINE 00001221 "        my $opt_test  = $ARGV_saved[-2];"
NSQ_SOURCE_LINE 00001222 "        my $file_test = $ARGV_saved[-1];"
NSQ_SOURCE_LINE 00001223 "        if (   $opt_test =~ s/^[-]+//"
NSQ_SOURCE_LINE 00001224 "            && $file_test !~ /^[-]/"
NSQ_SOURCE_LINE 00001225 "            && $file_test !~ /^\\d+$/"
NSQ_SOURCE_LINE 00001226 "            && -e $file_test )"
NSQ_SOURCE_LINE 00001227 "        {"
NSQ_SOURCE_LINE 00001228 ""
NSQ_SOURCE_LINE 00001229 "            # These options can take filenames, so we will ignore them here"
NSQ_SOURCE_LINE 00001230 "            my %is_option_with_file_parameter ="
NSQ_SOURCE_LINE 00001231 "              map { $_ => 1 } qw( outfile profile );"
NSQ_SOURCE_LINE 00001232 ""
NSQ_SOURCE_LINE 00001233 "            # Expand an abbreviation into a long name"
NSQ_SOURCE_LINE 00001234 "            my $long_name;"
NSQ_SOURCE_LINE 00001235 "            my $exp = $rexpansion->{$opt_test};"
NSQ_SOURCE_LINE 00001236 "            if    ( !$exp )        { $long_name = $opt_test }"
NSQ_SOURCE_LINE 00001237 "            elsif ( @{$exp} == 1 ) { $long_name = $exp->[0] }"
NSQ_SOURCE_LINE 00001238 "            else                   { }"
NSQ_SOURCE_LINE 00001239 ""
NSQ_SOURCE_LINE 00001240 "            # If this arg grabbed the file, then it must take a string arg"
NSQ_SOURCE_LINE 00001241 "            if (   $long_name"
NSQ_SOURCE_LINE 00001242 "                && defined( $rOpts->{$long_name} )"
NSQ_SOURCE_LINE 00001243 "                && $rOpts->{$long_name} eq $file_test"
NSQ_SOURCE_LINE 00001244 "                && !$is_option_with_file_parameter{$long_name} )"
NSQ_SOURCE_LINE 00001245 "            {"
NSQ_SOURCE_LINE 00001246 "                Die(<<EOM);"
NSQ_SOURCE_LINE 00001247 "Stopping on possible missing string parameter for '-$opt_test':"
NSQ_SOURCE_LINE 00001248 "This parameter takes a string and has been set equal to file '$file_test',"
NSQ_SOURCE_LINE 00001249 "and formatted output will go to standard output. If this is actually correct,"
NSQ_SOURCE_LINE 00001250 "you can skip this message by entering this as '-$opt_test=$file_test'."
NSQ_SOURCE_LINE 00001251 "EOM"
NSQ_SOURCE_LINE 00001252 "            }"
NSQ_SOURCE_LINE 00001253 "        }"
NSQ_SOURCE_LINE 00001254 "    }"
NSQ_SOURCE_LINE 00001255 ""
NSQ_SOURCE_LINE 00001256 "    # make the pattern of file extensions that we shouldn't touch"
NSQ_SOURCE_LINE 00001257 "    my $forbidden_file_extensions = \"(($dot_pattern)(LOG|DEBUG|ERR|TEE)\";"
NSQ_SOURCE_LINE 00001258 "    if ($output_extension) {"
NSQ_SOURCE_LINE 00001259 "        my $ext = quotemeta($output_extension);"
NSQ_SOURCE_LINE 00001260 "        $forbidden_file_extensions .= \"|$ext\";"
NSQ_SOURCE_LINE 00001261 "    }"
NSQ_SOURCE_LINE 00001262 "    if ( $in_place_modify && $backup_extension ) {"
NSQ_SOURCE_LINE 00001263 "        my $ext = quotemeta($backup_extension);"
NSQ_SOURCE_LINE 00001264 "        $forbidden_file_extensions .= \"|$ext\";"
NSQ_SOURCE_LINE 00001265 "    }"
NSQ_SOURCE_LINE 00001266 "    $forbidden_file_extensions .= ')$';"
NSQ_SOURCE_LINE 00001267 ""
NSQ_SOURCE_LINE 00001268 "    # Create a diagnostics object if requested;"
NSQ_SOURCE_LINE 00001269 "    # This is only useful for code development"
NSQ_SOURCE_LINE 00001270 "    my $diagnostics_object = undef;"
NSQ_SOURCE_LINE 00001271 "    if (DIAGNOSTICS) {"
NSQ_SOURCE_LINE 00001272 "        $diagnostics_object = Perl::Tidy::Diagnostics->new();"
NSQ_SOURCE_LINE 00001273 "    }"
NSQ_SOURCE_LINE 00001274 ""
NSQ_SOURCE_LINE 00001275 "    # no filenames should be given if input is from an array"
NSQ_SOURCE_LINE 00001276 "    if ($source_stream) {"
NSQ_SOURCE_LINE 00001277 "        if ( @Arg_files > 0 ) {"
NSQ_SOURCE_LINE 00001278 "            Die("
NSQ_SOURCE_LINE 00001279 "\"You may not specify any filenames when a source array is given\\n\""
NSQ_SOURCE_LINE 00001280 "            );"
NSQ_SOURCE_LINE 00001281 "        }"
NSQ_SOURCE_LINE 00001282 ""
NSQ_SOURCE_LINE 00001283 "        # we'll stuff the source array into Arg_files"
NSQ_SOURCE_LINE 00001284 "        unshift( @Arg_files, $source_stream );"
NSQ_SOURCE_LINE 00001285 ""
NSQ_SOURCE_LINE 00001286 "        # No special treatment for source stream which is a filename."
NSQ_SOURCE_LINE 00001287 "        # This will enable checks for binary files and other bad stuff."
NSQ_SOURCE_LINE 00001288 "        $source_stream = undef unless ( ref($source_stream) );"
NSQ_SOURCE_LINE 00001289 "    }"
NSQ_SOURCE_LINE 00001290 ""
NSQ_SOURCE_LINE 00001291 "    # use stdin by default if no source array and no args"
NSQ_SOURCE_LINE 00001292 "    elsif ( !@Arg_files ) {"
NSQ_SOURCE_LINE 00001293 "        unshift( @Arg_files, '-' );"
NSQ_SOURCE_LINE 00001294 "    }"
NSQ_SOURCE_LINE 00001295 ""
NSQ_SOURCE_LINE 00001296 "    # check file existence and expand any globs"
NSQ_SOURCE_LINE 00001297 "    else {"
NSQ_SOURCE_LINE 00001298 "        my @updated_files;"
NSQ_SOURCE_LINE 00001299 "        foreach my $input_file (@Arg_files) {"
NSQ_SOURCE_LINE 00001300 "            if ( -e $input_file ) {"
NSQ_SOURCE_LINE 00001301 "                push @updated_files, $input_file;"
NSQ_SOURCE_LINE 00001302 "            }"
NSQ_SOURCE_LINE 00001303 "            else {"
NSQ_SOURCE_LINE 00001304 ""
NSQ_SOURCE_LINE 00001305 "                # file doesn't exist - check for a file glob"
NSQ_SOURCE_LINE 00001306 "                if ( $input_file =~ /([\\?\\*\\[\\{])/ ) {"
NSQ_SOURCE_LINE 00001307 ""
NSQ_SOURCE_LINE 00001308 "                    # Windows shell may not remove quotes, so do it"
NSQ_SOURCE_LINE 00001309 "                    my $ifile = $input_file;"
NSQ_SOURCE_LINE 00001310 "                    if ( $ifile =~ /^\\'(.+)\\'$/ ) { $ifile = $1 }"
NSQ_SOURCE_LINE 00001311 "                    if ( $ifile =~ /^\\\"(.+)\\\"$/ ) { $ifile = $1 }"
NSQ_SOURCE_LINE 00001312 "                    my $pattern = fileglob_to_re($ifile);"
NSQ_SOURCE_LINE 00001313 "                    my $dh;"
NSQ_SOURCE_LINE 00001314 "                    if ( opendir( $dh, './' ) ) {"
NSQ_SOURCE_LINE 00001315 "                        my @files ="
NSQ_SOURCE_LINE 00001316 "                          grep { /$pattern/ && !-d } readdir($dh);"
NSQ_SOURCE_LINE 00001317 "                        closedir($dh);"
NSQ_SOURCE_LINE 00001318 "                        next unless (@files);"
NSQ_SOURCE_LINE 00001319 "                        push @updated_files, @files;"
NSQ_SOURCE_LINE 00001320 "                        next;"
NSQ_SOURCE_LINE 00001321 "                    }"
NSQ_SOURCE_LINE 00001322 "                }"
NSQ_SOURCE_LINE 00001323 "                Warn(\"skipping file: '$input_file': no matches found\\n\");"
NSQ_SOURCE_LINE 00001324 "                next;"
NSQ_SOURCE_LINE 00001325 "            }"
NSQ_SOURCE_LINE 00001326 "        } ## end loop over input filenames"
NSQ_SOURCE_LINE 00001327 ""
NSQ_SOURCE_LINE 00001328 "        @Arg_files = @updated_files;"
NSQ_SOURCE_LINE 00001329 "        if ( !@Arg_files ) {"
NSQ_SOURCE_LINE 00001330 "            Die(\"no matching input files found\\n\");"
NSQ_SOURCE_LINE 00001331 "        }"
NSQ_SOURCE_LINE 00001332 "    }"
NSQ_SOURCE_LINE 00001333 ""
NSQ_SOURCE_LINE 00001334 "    # Flag for loading module Unicode::GCString for evaluating text width:"
NSQ_SOURCE_LINE 00001335 "    #   undef = ok to use but not yet loaded"
NSQ_SOURCE_LINE 00001336 "    #       0 = do not use; failed to load or not wanted"
NSQ_SOURCE_LINE 00001337 "    #       1 = successfully loaded and ok to use"
NSQ_SOURCE_LINE 00001338 "    # The module is not actually loaded unless/until it is needed"
NSQ_SOURCE_LINE 00001339 "    if ( !$rOpts->{'use-unicode-gcstring'} ) {"
NSQ_SOURCE_LINE 00001340 "        $loaded_unicode_gcstring = 0;"
NSQ_SOURCE_LINE 00001341 "    }"
NSQ_SOURCE_LINE 00001342 ""
NSQ_SOURCE_LINE 00001343 "    # Remove duplicate filenames.  Otherwise, for example if the user entered"
NSQ_SOURCE_LINE 00001344 "    #     perltidy -b myfile.pl myfile.pl"
NSQ_SOURCE_LINE 00001345 "    # the backup version of the original would be lost."
NSQ_SOURCE_LINE 00001346 "    if ( @Arg_files > 1 ) {"
NSQ_SOURCE_LINE 00001347 "        my %seen = ();"
NSQ_SOURCE_LINE 00001348 "        @Arg_files = grep { !$seen{$_}++ } @Arg_files;"
NSQ_SOURCE_LINE 00001349 "    }"
NSQ_SOURCE_LINE 00001350 ""
NSQ_SOURCE_LINE 00001351 "    # If requested, process in order of increasing file size"
NSQ_SOURCE_LINE 00001352 "    # This can significantly reduce perl's virtual memory usage during testing."
NSQ_SOURCE_LINE 00001353 "    if ( @Arg_files > 1 && $rOpts->{'file-size-order'} ) {"
NSQ_SOURCE_LINE 00001354 "        @Arg_files ="
NSQ_SOURCE_LINE 00001355 "          map  { $_->[0] }"
NSQ_SOURCE_LINE 00001356 "          sort { $a->[1] <=> $b->[1] }"
NSQ_SOURCE_LINE 00001357 "          map  { [ $_, -e $_ ? -s $_ : 0 ] } @Arg_files;"
NSQ_SOURCE_LINE 00001358 "    }"
NSQ_SOURCE_LINE 00001359 ""
NSQ_SOURCE_LINE 00001360 "    my $logfile_header = make_logfile_header( $rOpts, $config_file,"
NSQ_SOURCE_LINE 00001361 "        $rraw_options, $Windows_type, $readable_options );"
NSQ_SOURCE_LINE 00001362 ""
NSQ_SOURCE_LINE 00001363 "    # Store some values needed by lower level routines"
NSQ_SOURCE_LINE 00001364 "    $self->[_diagnostics_object_] = $diagnostics_object;"
NSQ_SOURCE_LINE 00001365 "    $self->[_postfilter_]         = $postfilter;"
NSQ_SOURCE_LINE 00001366 "    $self->[_prefilter_]          = $prefilter;"
NSQ_SOURCE_LINE 00001367 "    $self->[_user_formatter_]     = $user_formatter;"
NSQ_SOURCE_LINE 00001368 ""
NSQ_SOURCE_LINE 00001369 "    #--------------------------"
NSQ_SOURCE_LINE 00001370 "    # loop to process all files"
NSQ_SOURCE_LINE 00001371 "    #--------------------------"
NSQ_SOURCE_LINE 00001372 "    $self->process_all_files("
NSQ_SOURCE_LINE 00001373 "        {"
NSQ_SOURCE_LINE 00001374 "            rinput_hash        => \\%input_hash,"
NSQ_SOURCE_LINE 00001375 "            rfiles             => \\@Arg_files,"
NSQ_SOURCE_LINE 00001376 "            line_range_clipped => $line_range_clipped,"
NSQ_SOURCE_LINE 00001377 ""
NSQ_SOURCE_LINE 00001378 "            # filename stuff..."
NSQ_SOURCE_LINE 00001379 "            source_stream             => $source_stream,"
NSQ_SOURCE_LINE 00001380 "            output_extension          => $output_extension,"
NSQ_SOURCE_LINE 00001381 "            forbidden_file_extensions => $forbidden_file_extensions,"
NSQ_SOURCE_LINE 00001382 "            in_place_modify           => $in_place_modify,"
NSQ_SOURCE_LINE 00001383 "            backup_extension          => $backup_extension,"
NSQ_SOURCE_LINE 00001384 "            delete_backup             => $delete_backup,"
NSQ_SOURCE_LINE 00001385 ""
NSQ_SOURCE_LINE 00001386 "            # logfile stuff..."
NSQ_SOURCE_LINE 00001387 "            logfile_header           => $logfile_header,"
NSQ_SOURCE_LINE 00001388 "            rpending_complaint       => $rpending_complaint,"
NSQ_SOURCE_LINE 00001389 "            rpending_logfile_message => $rpending_logfile_message,"
NSQ_SOURCE_LINE 00001390 "        }"
NSQ_SOURCE_LINE 00001391 "    );"
NSQ_SOURCE_LINE 00001392 ""
NSQ_SOURCE_LINE 00001393 "    #-----"
NSQ_SOURCE_LINE 00001394 "    # Exit"
NSQ_SOURCE_LINE 00001395 "    #-----"
NSQ_SOURCE_LINE 00001396 ""
NSQ_SOURCE_LINE 00001397 "    # Fix for RT #130297: return a true value if anything was written to the"
NSQ_SOURCE_LINE 00001398 "    # standard error output, even non-fatal warning messages, otherwise return"
NSQ_SOURCE_LINE 00001399 "    # false."
NSQ_SOURCE_LINE 00001400 ""
NSQ_SOURCE_LINE 00001401 "    # These exit codes are returned:"
NSQ_SOURCE_LINE 00001402 "    #  0 = perltidy ran to completion with no errors"
NSQ_SOURCE_LINE 00001403 "    #  1 = perltidy could not run to completion due to errors"
NSQ_SOURCE_LINE 00001404 "    #  2 = perltidy ran to completion with error messages"
NSQ_SOURCE_LINE 00001405 ""
NSQ_SOURCE_LINE 00001406 "    # Note that if perltidy is run with multiple files, any single file with"
NSQ_SOURCE_LINE 00001407 "    # errors or warnings will write a line like"
NSQ_SOURCE_LINE 00001408 "    #        '## Please see file testing.t.ERR'"
NSQ_SOURCE_LINE 00001409 "    # to standard output for each file with errors, so the flag will be true,"
NSQ_SOURCE_LINE 00001410 "    # even if only some of the multiple files may have had errors."
NSQ_SOURCE_LINE 00001411 ""
NSQ_SOURCE_LINE 00001412 "  NORMAL_EXIT:"
NSQ_SOURCE_LINE 00001413 "    my $ret = $Warn_count ? 2 : 0;"
NSQ_SOURCE_LINE 00001414 "    return wantarray ? ( $ret, $rstatus ) : $ret;"
NSQ_SOURCE_LINE 00001415 ""
NSQ_SOURCE_LINE 00001416 "  ERROR_EXIT:"
NSQ_SOURCE_LINE 00001417 "    return wantarray ? ( 1, $rstatus ) : 1;"
NSQ_SOURCE_LINE 00001418 ""
NSQ_SOURCE_LINE 00001419 "} ## end sub perltidy"
NSQ_SOURCE_LINE 00001420 ""
NSQ_SOURCE_LINE 00001421 "sub make_file_extension {"
NSQ_SOURCE_LINE 00001422 ""
NSQ_SOURCE_LINE 00001423 "    # Make a file extension, adding any leading '.' if necessary."
NSQ_SOURCE_LINE 00001424 "    # (the '.' may actually be an '_' under VMS)."
NSQ_SOURCE_LINE 00001425 "    my ( $self, $extension, ($default) ) = @_;"
NSQ_SOURCE_LINE 00001426 ""
NSQ_SOURCE_LINE 00001427 "    # Given:"
NSQ_SOURCE_LINE 00001428 "    #  $extension = the first choice (usually a user entry)"
NSQ_SOURCE_LINE 00001429 "    #  $default   = an optional backup extension"
NSQ_SOURCE_LINE 00001430 "    # Return:"
NSQ_SOURCE_LINE 00001431 "    #  $extension = the actual file extension"
NSQ_SOURCE_LINE 00001432 ""
NSQ_SOURCE_LINE 00001433 "    $extension = EMPTY_STRING unless ( defined($extension) );"
NSQ_SOURCE_LINE 00001434 "    $extension =~ s/^\\s+//;"
NSQ_SOURCE_LINE 00001435 "    $extension =~ s/\\s+$//;"
NSQ_SOURCE_LINE 00001436 ""
NSQ_SOURCE_LINE 00001437 "    # Use default extension if nothing remains of the first choice"
NSQ_SOURCE_LINE 00001438 "    if ( length($extension) == 0 ) {"
NSQ_SOURCE_LINE 00001439 "        $extension = $default;"
NSQ_SOURCE_LINE 00001440 "        $extension = EMPTY_STRING unless ( defined($extension) );"
NSQ_SOURCE_LINE 00001441 "        $extension =~ s/^\\s+//;"
NSQ_SOURCE_LINE 00001442 "        $extension =~ s/\\s+$//;"
NSQ_SOURCE_LINE 00001443 "    }"
NSQ_SOURCE_LINE 00001444 ""
NSQ_SOURCE_LINE 00001445 "    # Only extensions with these leading characters get a '.'"
NSQ_SOURCE_LINE 00001446 "    # This rule gives the user some freedom."
NSQ_SOURCE_LINE 00001447 "    if ( $extension =~ /^[a-zA-Z0-9]/ ) {"
NSQ_SOURCE_LINE 00001448 "        my $dot = $self->[_file_extension_separator_];"
NSQ_SOURCE_LINE 00001449 "        $extension = $dot . $extension;"
NSQ_SOURCE_LINE 00001450 "    }"
NSQ_SOURCE_LINE 00001451 "    return $extension;"
NSQ_SOURCE_LINE 00001452 "} ## end sub make_file_extension"
NSQ_SOURCE_LINE 00001453 ""
NSQ_SOURCE_LINE 00001454 "sub check_in_place_modify {"
NSQ_SOURCE_LINE 00001455 ""
NSQ_SOURCE_LINE 00001456 "    my ( $self, $source, $destination_stream ) = @_;"
NSQ_SOURCE_LINE 00001457 ""
NSQ_SOURCE_LINE 00001458 "    # See if --backup-and-modify-in-place (-b) is set, and if so,"
NSQ_SOURCE_LINE 00001459 "    # return its associated parameters"
NSQ_SOURCE_LINE 00001460 "    my $rOpts = $self->[_rOpts_];"
NSQ_SOURCE_LINE 00001461 ""
NSQ_SOURCE_LINE 00001462 "    # check for -b option;"
NSQ_SOURCE_LINE 00001463 "    # silently ignore unless beautify mode"
NSQ_SOURCE_LINE 00001464 "    my $in_place_modify = $rOpts->{'backup-and-modify-in-place'}"
NSQ_SOURCE_LINE 00001465 "      && $rOpts->{'format'} eq 'tidy';"
NSQ_SOURCE_LINE 00001466 ""
NSQ_SOURCE_LINE 00001467 "    my ( $backup_extension, $delete_backup );"
NSQ_SOURCE_LINE 00001468 ""
NSQ_SOURCE_LINE 00001469 "    # Turn off -b with warnings in case of conflicts with other options."
NSQ_SOURCE_LINE 00001470 "    # NOTE: Do this silently, without warnings, if there is a source or"
NSQ_SOURCE_LINE 00001471 "    # destination stream, or standard output is used.  This is because the -b"
NSQ_SOURCE_LINE 00001472 "    # flag may have been in a .perltidyrc file and warnings break"
NSQ_SOURCE_LINE 00001473 "    # Test::NoWarnings.  See email discussion with Merijn Brand 26 Feb 2014."
NSQ_SOURCE_LINE 00001474 "    if ($in_place_modify) {"
NSQ_SOURCE_LINE 00001475 "        if (   $destination_stream"
NSQ_SOURCE_LINE 00001476 "            || !defined($source)"
NSQ_SOURCE_LINE 00001477 "            || ref($source)"
NSQ_SOURCE_LINE 00001478 "            || $source eq '-'"
NSQ_SOURCE_LINE 00001479 "            || $rOpts->{'outfile'}"
NSQ_SOURCE_LINE 00001480 "            || defined( $rOpts->{'output-path'} ) )"
NSQ_SOURCE_LINE 00001481 "        {"
NSQ_SOURCE_LINE 00001482 "            $in_place_modify = 0;"
NSQ_SOURCE_LINE 00001483 "        }"
NSQ_SOURCE_LINE 00001484 ""
NSQ_SOURCE_LINE 00001485 "        # But Warn or Nag for certain conflicts with -st.  This can happen for"
NSQ_SOURCE_LINE 00001486 "        # example if user chooses -pbp and -b because -st is hidden in -pbp."
NSQ_SOURCE_LINE 00001487 "        elsif ( $rOpts->{'standard-output'} ) {"
NSQ_SOURCE_LINE 00001488 "            $in_place_modify = 0;"
NSQ_SOURCE_LINE 00001489 ""
NSQ_SOURCE_LINE 00001490 "            my $rOpts_in_profile = $self->[_rOpts_in_profile_];"
NSQ_SOURCE_LINE 00001491 "            if ( !$rOpts_in_profile->{'backup-and-modify-in-place'} ) {"
NSQ_SOURCE_LINE 00001492 "                Warn("
NSQ_SOURCE_LINE 00001493 "\"## warning: conflict of -st with -b: -st has priority; use -nst to activate -b\\n\""
NSQ_SOURCE_LINE 00001494 "                );"
NSQ_SOURCE_LINE 00001495 "            }"
NSQ_SOURCE_LINE 00001496 "            elsif ( $rOpts_in_profile->{'standard-output'} ) {"
NSQ_SOURCE_LINE 00001497 "                Nag("
NSQ_SOURCE_LINE 00001498 "\"## warning: conflict of -st and -b in profile: -st has priority; use -nst to activate -b\\n\""
NSQ_SOURCE_LINE 00001499 "                );"
NSQ_SOURCE_LINE 00001500 ""
NSQ_SOURCE_LINE 00001501 "            }"
NSQ_SOURCE_LINE 00001502 "            else {"
NSQ_SOURCE_LINE 00001503 "                ## keep quiet"
NSQ_SOURCE_LINE 00001504 "            }"
NSQ_SOURCE_LINE 00001505 "        }"
NSQ_SOURCE_LINE 00001506 "        else {"
NSQ_SOURCE_LINE 00001507 "            ## ok to use -b"
NSQ_SOURCE_LINE 00001508 "        }"
NSQ_SOURCE_LINE 00001509 "    }"
NSQ_SOURCE_LINE 00001510 ""
NSQ_SOURCE_LINE 00001511 "    if ($in_place_modify) {"
NSQ_SOURCE_LINE 00001512 ""
NSQ_SOURCE_LINE 00001513 "        # If the backup extension contains a / character then the backup should"
NSQ_SOURCE_LINE 00001514 "        # be deleted when the -b option is used.   On older versions of"
NSQ_SOURCE_LINE 00001515 "        # perltidy this will generate an error message due to an illegal"
NSQ_SOURCE_LINE 00001516 "        # file name."
NSQ_SOURCE_LINE 00001517 "        #"
NSQ_SOURCE_LINE 00001518 "        # A backup file will still be generated but will be deleted"
NSQ_SOURCE_LINE 00001519 "        # at the end.  If -bext='/' then this extension will be"
NSQ_SOURCE_LINE 00001520 "        # the default 'bak'.  Otherwise it will be whatever characters"
NSQ_SOURCE_LINE 00001521 "        # remains after all '/' characters are removed.  For example:"
NSQ_SOURCE_LINE 00001522 "        # -bext         extension     slashes"
NSQ_SOURCE_LINE 00001523 "        #  '/'          bak           1"
NSQ_SOURCE_LINE 00001524 "        #  '/delete'    delete        1"
NSQ_SOURCE_LINE 00001525 "        #  'delete/'    delete        1"
NSQ_SOURCE_LINE 00001526 "        #  '/dev/null'  devnull       2    (Currently not allowed)"
NSQ_SOURCE_LINE 00001527 "        my $bext = $rOpts->{'backup-file-extension'};"
NSQ_SOURCE_LINE 00001528 "        $delete_backup = ( $rOpts->{'backup-file-extension'} =~ s/\\///g );"
NSQ_SOURCE_LINE 00001529 ""
NSQ_SOURCE_LINE 00001530 "        # At present only one forward slash is allowed.  In the future multiple"
NSQ_SOURCE_LINE 00001531 "        # slashes may be allowed to allow for other options"
NSQ_SOURCE_LINE 00001532 "        if ( $delete_backup > 1 ) {"
NSQ_SOURCE_LINE 00001533 "            Die(\"-bext=$bext contains more than one '/'\\n\");"
NSQ_SOURCE_LINE 00001534 "        }"
NSQ_SOURCE_LINE 00001535 ""
NSQ_SOURCE_LINE 00001536 "        $backup_extension ="
NSQ_SOURCE_LINE 00001537 "          $self->make_file_extension( $rOpts->{'backup-file-extension'},"
NSQ_SOURCE_LINE 00001538 "            'bak' );"
NSQ_SOURCE_LINE 00001539 "    }"
NSQ_SOURCE_LINE 00001540 ""
NSQ_SOURCE_LINE 00001541 "    my $backup_method = $rOpts->{'backup-method'};"
NSQ_SOURCE_LINE 00001542 "    if (   defined($backup_method)"
NSQ_SOURCE_LINE 00001543 "        && $backup_method ne 'copy'"
NSQ_SOURCE_LINE 00001544 "        && $backup_method ne 'move' )"
NSQ_SOURCE_LINE 00001545 "    {"
NSQ_SOURCE_LINE 00001546 "        Die("
NSQ_SOURCE_LINE 00001547 "\"Unexpected --backup-method='$backup_method'; must be one of: 'move', 'copy'\\n\""
NSQ_SOURCE_LINE 00001548 "        );"
NSQ_SOURCE_LINE 00001549 "    }"
NSQ_SOURCE_LINE 00001550 ""
NSQ_SOURCE_LINE 00001551 "    return ( $in_place_modify, $backup_extension, $delete_backup );"
NSQ_SOURCE_LINE 00001552 "} ## end sub check_in_place_modify"
NSQ_SOURCE_LINE 00001553 ""
NSQ_SOURCE_LINE 00001554 "sub backup_method_copy {"
NSQ_SOURCE_LINE 00001555 ""
NSQ_SOURCE_LINE 00001556 "    my ( $self, $input_file, $routput_string, $backup_extension,"
NSQ_SOURCE_LINE 00001557 "        $delete_backup )"
NSQ_SOURCE_LINE 00001558 "      = @_;"
NSQ_SOURCE_LINE 00001559 ""
NSQ_SOURCE_LINE 00001560 "    # Handle the -b (--backup-and-modify-in-place) option with -bm='copy':"
NSQ_SOURCE_LINE 00001561 "    # - First copy $input file to $backup_name."
NSQ_SOURCE_LINE 00001562 "    # - Then open input file and rewrite with contents of $routput_string"
NSQ_SOURCE_LINE 00001563 "    # - Then delete the backup if requested"
NSQ_SOURCE_LINE 00001564 ""
NSQ_SOURCE_LINE 00001565 "    # NOTES:"
NSQ_SOURCE_LINE 00001566 "    # - Die immediately on any error."
NSQ_SOURCE_LINE 00001567 "    # - $routput_string is a SCALAR ref"
NSQ_SOURCE_LINE 00001568 ""
NSQ_SOURCE_LINE 00001569 "    my $backup_file = $input_file . $backup_extension;"
NSQ_SOURCE_LINE 00001570 ""
NSQ_SOURCE_LINE 00001571 "    if ( !-f $input_file ) {"
NSQ_SOURCE_LINE 00001572 ""
NSQ_SOURCE_LINE 00001573 "        # no real file to backup .."
NSQ_SOURCE_LINE 00001574 "        # This shouldn't happen because of numerous preliminary checks"
NSQ_SOURCE_LINE 00001575 "        Die("
NSQ_SOURCE_LINE 00001576 "            \"problem with -b backing up input file '$input_file': not a file\\n\""
NSQ_SOURCE_LINE 00001577 "        );"
NSQ_SOURCE_LINE 00001578 "    }"
NSQ_SOURCE_LINE 00001579 ""
NSQ_SOURCE_LINE 00001580 "    if ( -f $backup_file ) {"
NSQ_SOURCE_LINE 00001581 "        unlink($backup_file)"
NSQ_SOURCE_LINE 00001582 "          or Die("
NSQ_SOURCE_LINE 00001583 "\"unable to remove previous '$backup_file' for -b option; check permissions: $OS_ERROR\\n\""
NSQ_SOURCE_LINE 00001584 "          );"
NSQ_SOURCE_LINE 00001585 "    }"
NSQ_SOURCE_LINE 00001586 ""
NSQ_SOURCE_LINE 00001587 "    # Copy input file to backup"
NSQ_SOURCE_LINE 00001588 "    File::Copy::copy( $input_file, $backup_file )"
NSQ_SOURCE_LINE 00001589 "      or Die(\"File::Copy failed trying to backup source: $OS_ERROR\");"
NSQ_SOURCE_LINE 00001590 ""
NSQ_SOURCE_LINE 00001591 "    # set permissions of the backup file to match the input file"
NSQ_SOURCE_LINE 00001592 "    my @input_file_stat = stat($input_file);"
NSQ_SOURCE_LINE 00001593 "    my $in_place_modify = 1;"
NSQ_SOURCE_LINE 00001594 "    $self->set_output_file_permissions( $backup_file, \\@input_file_stat,"
NSQ_SOURCE_LINE 00001595 "        $in_place_modify );"
NSQ_SOURCE_LINE 00001596 ""
NSQ_SOURCE_LINE 00001597 "    # set the modification time of the copy to the original value (rt#145999)"
NSQ_SOURCE_LINE 00001598 "    my ( $read_time, $write_time ) = @input_file_stat[ _atime_, _mtime_ ];"
NSQ_SOURCE_LINE 00001599 "    if ( defined($write_time) ) {"
NSQ_SOURCE_LINE 00001600 "        utime( $read_time, $write_time, $backup_file )"
NSQ_SOURCE_LINE 00001601 "          || Warn(\"error setting mtime for backup file '$backup_file'\\n\");"
NSQ_SOURCE_LINE 00001602 "    }"
NSQ_SOURCE_LINE 00001603 ""
NSQ_SOURCE_LINE 00001604 "    # Open the original input file for writing ... opening with \">\" will"
NSQ_SOURCE_LINE 00001605 "    # truncate the existing data."
NSQ_SOURCE_LINE 00001606 "    open( my $fout, \">\", $input_file )"
NSQ_SOURCE_LINE 00001607 "      or Die("
NSQ_SOURCE_LINE 00001608 "\"problem re-opening $input_file for write for -b option; check file and directory permissions: $OS_ERROR\\n\""
NSQ_SOURCE_LINE 00001609 "      );"
NSQ_SOURCE_LINE 00001610 ""
NSQ_SOURCE_LINE 00001611 "    if ( $self->[_is_encoded_data_] ) { binmode $fout, \":raw:encoding(UTF-8)\" }"
NSQ_SOURCE_LINE 00001612 "    else                              { binmode $fout }"
NSQ_SOURCE_LINE 00001613 ""
NSQ_SOURCE_LINE 00001614 "    # Now copy the formatted output to it.."
NSQ_SOURCE_LINE 00001615 "    # output must be SCALAR ref.."
NSQ_SOURCE_LINE 00001616 "    if ( ref($routput_string) eq 'SCALAR' ) {"
NSQ_SOURCE_LINE 00001617 "        $fout->print( ${$routput_string} )"
NSQ_SOURCE_LINE 00001618 "          or Die(\"cannot print to '$input_file' with -b option: $OS_ERROR\\n\");"
NSQ_SOURCE_LINE 00001619 "    }"
NSQ_SOURCE_LINE 00001620 ""
NSQ_SOURCE_LINE 00001621 "    # Error if anything else ..."
NSQ_SOURCE_LINE 00001622 "    else {"
NSQ_SOURCE_LINE 00001623 "        my $ref = ref($routput_string);"
NSQ_SOURCE_LINE 00001624 "        Die(<<EOM);"
NSQ_SOURCE_LINE 00001625 "Programming error: unable to print to '$input_file' with -b option:"
NSQ_SOURCE_LINE 00001626 "unexpected ref type '$ref'; expecting 'ARRAY' or 'SCALAR'"
NSQ_SOURCE_LINE 00001627 "EOM"
NSQ_SOURCE_LINE 00001628 "    }"
NSQ_SOURCE_LINE 00001629 ""
NSQ_SOURCE_LINE 00001630 "    $fout->close()"
NSQ_SOURCE_LINE 00001631 "      or Die(\"cannot close '$input_file' with -b option: $OS_ERROR\\n\");"
NSQ_SOURCE_LINE 00001632 ""
NSQ_SOURCE_LINE 00001633 "    # Set permissions of the output file to match the input file. This is"
NSQ_SOURCE_LINE 00001634 "    # necessary even if the inode remains unchanged because suid/sgid bits may"
NSQ_SOURCE_LINE 00001635 "    # have been reset."
NSQ_SOURCE_LINE 00001636 "    $self->set_output_file_permissions( $input_file, \\@input_file_stat,"
NSQ_SOURCE_LINE 00001637 "        $in_place_modify );"
NSQ_SOURCE_LINE 00001638 ""
NSQ_SOURCE_LINE 00001639 "    # Keep original modification time if no change (rt#145999)"
NSQ_SOURCE_LINE 00001640 "    if ( !$self->[_input_output_difference_] && defined($write_time) ) {"
NSQ_SOURCE_LINE 00001641 "        utime( $read_time, $write_time, $input_file )"
NSQ_SOURCE_LINE 00001642 "          || Warn(\"error setting mtime for '$input_file'\\n\");"
NSQ_SOURCE_LINE 00001643 "    }"
NSQ_SOURCE_LINE 00001644 ""
NSQ_SOURCE_LINE 00001645 "    #---------------------------------------------------------"
NSQ_SOURCE_LINE 00001646 "    # remove the original file for in-place modify as follows:"
NSQ_SOURCE_LINE 00001647 "    #   $delete_backup=0 never"
NSQ_SOURCE_LINE 00001648 "    #   $delete_backup=1 only if no errors"
NSQ_SOURCE_LINE 00001649 "    #   $delete_backup>1 always  : NOT ALLOWED, too risky"
NSQ_SOURCE_LINE 00001650 "    #---------------------------------------------------------"
NSQ_SOURCE_LINE 00001651 "    if ( $delete_backup && -f $backup_file ) {"
NSQ_SOURCE_LINE 00001652 ""
NSQ_SOURCE_LINE 00001653 "        # Currently, $delete_backup may only be 1. But if a future update"
NSQ_SOURCE_LINE 00001654 "        # allows a value > 1, then reduce it to 1 if there were warnings."
NSQ_SOURCE_LINE 00001655 "        if (   $delete_backup > 1"
NSQ_SOURCE_LINE 00001656 "            && $self->[_logger_object_]->get_warning_count() )"
NSQ_SOURCE_LINE 00001657 "        {"
NSQ_SOURCE_LINE 00001658 "            $delete_backup = 1;"
NSQ_SOURCE_LINE 00001659 "        }"
NSQ_SOURCE_LINE 00001660 ""
NSQ_SOURCE_LINE 00001661 "        # As an added safety precaution, do not delete the source file"
NSQ_SOURCE_LINE 00001662 "        # if its size has dropped from positive to zero, since this"
NSQ_SOURCE_LINE 00001663 "        # could indicate a disaster of some kind, including a hardware"
NSQ_SOURCE_LINE 00001664 "        # failure.  Actually, this could happen if you had a file of"
NSQ_SOURCE_LINE 00001665 "        # all comments (or pod) and deleted everything with -dac (-dap)"
NSQ_SOURCE_LINE 00001666 "        # for some reason."
NSQ_SOURCE_LINE 00001667 "        if ( !-s $input_file && -s $backup_file && $delete_backup == 1 ) {"
NSQ_SOURCE_LINE 00001668 "            Warn("
NSQ_SOURCE_LINE 00001669 "\"output file '$input_file' missing or zero length; original '$backup_file' not deleted\\n\""
NSQ_SOURCE_LINE 00001670 "            );"
NSQ_SOURCE_LINE 00001671 "        }"
NSQ_SOURCE_LINE 00001672 "        else {"
NSQ_SOURCE_LINE 00001673 "            unlink($backup_file)"
NSQ_SOURCE_LINE 00001674 "              or Die("
NSQ_SOURCE_LINE 00001675 "\"unable to remove backup file '$backup_file' for -b option; check permissions: $OS_ERROR\\n\""
NSQ_SOURCE_LINE 00001676 "              );"
NSQ_SOURCE_LINE 00001677 "        }"
NSQ_SOURCE_LINE 00001678 "    }"
NSQ_SOURCE_LINE 00001679 ""
NSQ_SOURCE_LINE 00001680 "    # Verify that inode is unchanged during development"
NSQ_SOURCE_LINE 00001681 "    if (DEVEL_MODE) {"
NSQ_SOURCE_LINE 00001682 "        my @output_file_stat = stat($input_file);"
NSQ_SOURCE_LINE 00001683 "        my $inode_input      = $input_file_stat[1];"
NSQ_SOURCE_LINE 00001684 "        my $inode_output     = $output_file_stat[1];"
NSQ_SOURCE_LINE 00001685 "        if ( $inode_input != $inode_output ) {"
NSQ_SOURCE_LINE 00001686 "            Fault(<<EOM);"
NSQ_SOURCE_LINE 00001687 "inode changed with -bm=copy for file '$input_file': inode_input=$inode_input inode_output=$inode_output"
NSQ_SOURCE_LINE 00001688 "EOM"
NSQ_SOURCE_LINE 00001689 "        }"
NSQ_SOURCE_LINE 00001690 "    }"
NSQ_SOURCE_LINE 00001691 ""
NSQ_SOURCE_LINE 00001692 "    return;"
NSQ_SOURCE_LINE 00001693 "} ## end sub backup_method_copy"
NSQ_SOURCE_LINE 00001694 ""
NSQ_SOURCE_LINE 00001695 "sub backup_method_move {"
NSQ_SOURCE_LINE 00001696 ""
NSQ_SOURCE_LINE 00001697 "    my ( $self, $input_file, $routput_string, $backup_extension,"
NSQ_SOURCE_LINE 00001698 "        $delete_backup )"
NSQ_SOURCE_LINE 00001699 "      = @_;"
NSQ_SOURCE_LINE 00001700 ""
NSQ_SOURCE_LINE 00001701 "    # Handle the -b (--backup-and-modify-in-place) option with -bm='move':"
NSQ_SOURCE_LINE 00001702 "    # - First move $input file to $backup_name."
NSQ_SOURCE_LINE 00001703 "    # - Then copy $routput_string to $input_file."
NSQ_SOURCE_LINE 00001704 "    # - Then delete the backup if requested"
NSQ_SOURCE_LINE 00001705 ""
NSQ_SOURCE_LINE 00001706 "    # NOTES:"
NSQ_SOURCE_LINE 00001707 "    # - Die immediately on any error."
NSQ_SOURCE_LINE 00001708 "    # - $routput_string is a SCALAR ref"
NSQ_SOURCE_LINE 00001709 "    # - $input_file permissions will be set by sub set_output_file_permissions"
NSQ_SOURCE_LINE 00001710 ""
NSQ_SOURCE_LINE 00001711 "    my $backup_name = $input_file . $backup_extension;"
NSQ_SOURCE_LINE 00001712 ""
NSQ_SOURCE_LINE 00001713 "    if ( !-f $input_file ) {"
NSQ_SOURCE_LINE 00001714 ""
NSQ_SOURCE_LINE 00001715 "        # oh, oh, no real file to backup .."
NSQ_SOURCE_LINE 00001716 "        # shouldn't happen because of numerous preliminary checks"
NSQ_SOURCE_LINE 00001717 "        Die("
NSQ_SOURCE_LINE 00001718 "            \"problem with -b backing up input file '$input_file': not a file\\n\""
NSQ_SOURCE_LINE 00001719 "        );"
NSQ_SOURCE_LINE 00001720 "    }"
NSQ_SOURCE_LINE 00001721 "    if ( -f $backup_name ) {"
NSQ_SOURCE_LINE 00001722 "        unlink($backup_name)"
NSQ_SOURCE_LINE 00001723 "          or Die("
NSQ_SOURCE_LINE 00001724 "\"unable to remove previous '$backup_name' for -b option; check permissions: $OS_ERROR\\n\""
NSQ_SOURCE_LINE 00001725 "          );"
NSQ_SOURCE_LINE 00001726 "    }"
NSQ_SOURCE_LINE 00001727 ""
NSQ_SOURCE_LINE 00001728 "    my @input_file_stat = stat($input_file);"
NSQ_SOURCE_LINE 00001729 ""
NSQ_SOURCE_LINE 00001730 "    # backup the input file"
NSQ_SOURCE_LINE 00001731 "    # we use copy for symlinks, move for regular files"
NSQ_SOURCE_LINE 00001732 "    if ( -l $input_file ) {"
NSQ_SOURCE_LINE 00001733 "        File::Copy::copy( $input_file, $backup_name )"
NSQ_SOURCE_LINE 00001734 "          or Die(\"File::Copy failed trying to backup source: $OS_ERROR\");"
NSQ_SOURCE_LINE 00001735 "    }"
NSQ_SOURCE_LINE 00001736 "    else {"
NSQ_SOURCE_LINE 00001737 "        rename( $input_file, $backup_name )"
NSQ_SOURCE_LINE 00001738 "          or Die("
NSQ_SOURCE_LINE 00001739 "\"problem renaming $input_file to $backup_name for -b option: $OS_ERROR\\n\""
NSQ_SOURCE_LINE 00001740 "          );"
NSQ_SOURCE_LINE 00001741 "    }"
NSQ_SOURCE_LINE 00001742 ""
NSQ_SOURCE_LINE 00001743 "    # Open a file with the original input file name for writing ..."
NSQ_SOURCE_LINE 00001744 "    open( my $fout, \">\", $input_file )"
NSQ_SOURCE_LINE 00001745 "      or Die("
NSQ_SOURCE_LINE 00001746 "\"problem re-opening $input_file for write for -b option; check file and directory permissions: $OS_ERROR\\n\""
NSQ_SOURCE_LINE 00001747 "      );"
NSQ_SOURCE_LINE 00001748 ""
NSQ_SOURCE_LINE 00001749 "    if ( $self->[_is_encoded_data_] ) { binmode $fout, \":raw:encoding(UTF-8)\" }"
NSQ_SOURCE_LINE 00001750 "    else                              { binmode $fout }"
NSQ_SOURCE_LINE 00001751 ""
NSQ_SOURCE_LINE 00001752 "    # Now copy the formatted output to it.."
NSQ_SOURCE_LINE 00001753 "    # output must be SCALAR ref.."
NSQ_SOURCE_LINE 00001754 "    if ( ref($routput_string) eq 'SCALAR' ) {"
NSQ_SOURCE_LINE 00001755 "        $fout->print( ${$routput_string} )"
NSQ_SOURCE_LINE 00001756 "          or Die(\"cannot print to '$input_file' with -b option: $OS_ERROR\\n\");"
NSQ_SOURCE_LINE 00001757 "    }"
NSQ_SOURCE_LINE 00001758 ""
NSQ_SOURCE_LINE 00001759 "    # Error if anything else ..."
NSQ_SOURCE_LINE 00001760 "    else {"
NSQ_SOURCE_LINE 00001761 "        my $ref = ref($routput_string);"
NSQ_SOURCE_LINE 00001762 "        Die(<<EOM);"
NSQ_SOURCE_LINE 00001763 "Programming error: unable to print to '$input_file' with -b option:"
NSQ_SOURCE_LINE 00001764 "unexpected ref type '$ref'; expecting 'ARRAY' or 'SCALAR'"
NSQ_SOURCE_LINE 00001765 "EOM"
NSQ_SOURCE_LINE 00001766 "    }"
NSQ_SOURCE_LINE 00001767 ""
NSQ_SOURCE_LINE 00001768 "    $fout->close()"
NSQ_SOURCE_LINE 00001769 "      or Die(\"cannot close '$input_file' with -b option: $OS_ERROR\\n\");"
NSQ_SOURCE_LINE 00001770 ""
NSQ_SOURCE_LINE 00001771 "    # set permissions of the output file to match the input file"
NSQ_SOURCE_LINE 00001772 "    my $in_place_modify = 1;"
NSQ_SOURCE_LINE 00001773 "    $self->set_output_file_permissions( $input_file, \\@input_file_stat,"
NSQ_SOURCE_LINE 00001774 "        $in_place_modify );"
NSQ_SOURCE_LINE 00001775 ""
NSQ_SOURCE_LINE 00001776 "    # Keep original modification time if no change (rt#145999)"
NSQ_SOURCE_LINE 00001777 "    my ( $read_time, $write_time ) = @input_file_stat[ _atime_, _mtime_ ];"
NSQ_SOURCE_LINE 00001778 "    if ( !$self->[_input_output_difference_] && defined($write_time) ) {"
NSQ_SOURCE_LINE 00001779 "        utime( $read_time, $write_time, $input_file )"
NSQ_SOURCE_LINE 00001780 "          || Warn(\"error setting mtime for '$input_file'\\n\");"
NSQ_SOURCE_LINE 00001781 "    }"
NSQ_SOURCE_LINE 00001782 ""
NSQ_SOURCE_LINE 00001783 "    #---------------------------------------------------------"
NSQ_SOURCE_LINE 00001784 "    # remove the original file for in-place modify as follows:"
NSQ_SOURCE_LINE 00001785 "    #   $delete_backup=0 never"
NSQ_SOURCE_LINE 00001786 "    #   $delete_backup=1 only if no errors"
NSQ_SOURCE_LINE 00001787 "    #   $delete_backup>1 always  : NOT ALLOWED, too risky"
NSQ_SOURCE_LINE 00001788 "    #---------------------------------------------------------"
NSQ_SOURCE_LINE 00001789 "    if ( $delete_backup && -f $backup_name ) {"
NSQ_SOURCE_LINE 00001790 ""
NSQ_SOURCE_LINE 00001791 "        # Currently, $delete_backup may only be 1. But if a future update"
NSQ_SOURCE_LINE 00001792 "        # allows a value > 1, then reduce it to 1 if there were warnings."
NSQ_SOURCE_LINE 00001793 "        if (   $delete_backup > 1"
NSQ_SOURCE_LINE 00001794 "            && $self->[_logger_object_]->get_warning_count() )"
NSQ_SOURCE_LINE 00001795 "        {"
NSQ_SOURCE_LINE 00001796 "            $delete_backup = 1;"
NSQ_SOURCE_LINE 00001797 "        }"
NSQ_SOURCE_LINE 00001798 ""
NSQ_SOURCE_LINE 00001799 "        # As an added safety precaution, do not delete the source file"
NSQ_SOURCE_LINE 00001800 "        # if its size has dropped from positive to zero, since this"
NSQ_SOURCE_LINE 00001801 "        # could indicate a disaster of some kind, including a hardware"
NSQ_SOURCE_LINE 00001802 "        # failure.  Actually, this could happen if you had a file of"
NSQ_SOURCE_LINE 00001803 "        # all comments (or pod) and deleted everything with -dac (-dap)"
NSQ_SOURCE_LINE 00001804 "        # for some reason."
NSQ_SOURCE_LINE 00001805 "        if ( !-s $input_file && -s $backup_name && $delete_backup == 1 ) {"
NSQ_SOURCE_LINE 00001806 "            Warn("
NSQ_SOURCE_LINE 00001807 "\"output file '$input_file' missing or zero length; original '$backup_name' not deleted\\n\""
NSQ_SOURCE_LINE 00001808 "            );"
NSQ_SOURCE_LINE 00001809 "        }"
NSQ_SOURCE_LINE 00001810 "        else {"
NSQ_SOURCE_LINE 00001811 "            unlink($backup_name)"
NSQ_SOURCE_LINE 00001812 "              or Die("
NSQ_SOURCE_LINE 00001813 "\"unable to remove previous '$backup_name' for -b option; check permissions: $OS_ERROR\\n\""
NSQ_SOURCE_LINE 00001814 "              );"
NSQ_SOURCE_LINE 00001815 "        }"
NSQ_SOURCE_LINE 00001816 "    }"
NSQ_SOURCE_LINE 00001817 ""
NSQ_SOURCE_LINE 00001818 "    return;"
NSQ_SOURCE_LINE 00001819 ""
NSQ_SOURCE_LINE 00001820 "} ## end sub backup_method_move"
NSQ_SOURCE_LINE 00001821 ""
NSQ_SOURCE_LINE 00001822 "# masks for file permissions"
NSQ_SOURCE_LINE 00001823 "use constant OCT_777  => oct(777);     # All users (O+G+W) + r/w/x bits"
NSQ_SOURCE_LINE 00001824 "use constant OCT_7777 => oct(7777);    # Same + suid/sgid/sbit"
NSQ_SOURCE_LINE 00001825 "use constant OCT_600  => oct(600);     # Owner RW permission"
NSQ_SOURCE_LINE 00001826 ""
NSQ_SOURCE_LINE 00001827 "sub set_output_file_permissions {"
NSQ_SOURCE_LINE 00001828 ""
NSQ_SOURCE_LINE 00001829 "    my ( $self, $output_file, $rinput_file_stat, $in_place_modify ) = @_;"
NSQ_SOURCE_LINE 00001830 ""
NSQ_SOURCE_LINE 00001831 "    # Set the permissions for the output file"
NSQ_SOURCE_LINE 00001832 ""
NSQ_SOURCE_LINE 00001833 "    # Given:"
NSQ_SOURCE_LINE 00001834 "    #  $output_file      = the file whose permissions we will set"
NSQ_SOURCE_LINE 00001835 "    #  $rinput_file_stat = the result of stat($input_file)"
NSQ_SOURCE_LINE 00001836 "    #  $in_place_modify  = true if --backup-and-modify-in-place is set"
NSQ_SOURCE_LINE 00001837 ""
NSQ_SOURCE_LINE 00001838 "    my ( $mode_i, $uid_i, $gid_i ) ="
NSQ_SOURCE_LINE 00001839 "      @{$rinput_file_stat}[ _mode_, _uid_, _gid_ ];"
NSQ_SOURCE_LINE 00001840 "    my ( $uid_o, $gid_o ) = ( stat($output_file) )[ _uid_, _gid_ ];"
NSQ_SOURCE_LINE 00001841 "    my $input_file_permissions  = $mode_i & OCT_7777;"
NSQ_SOURCE_LINE 00001842 "    my $output_file_permissions = $input_file_permissions;"
NSQ_SOURCE_LINE 00001843 ""
NSQ_SOURCE_LINE 00001844 "    #rt128477: avoid inconsistent owner/group and suid/sgid"
NSQ_SOURCE_LINE 00001845 "    if ( $uid_i != $uid_o || $gid_i != $gid_o ) {"
NSQ_SOURCE_LINE 00001846 ""
NSQ_SOURCE_LINE 00001847 "        # try to change owner and group to match input file if"
NSQ_SOURCE_LINE 00001848 "        # in -b mode.  Note: chown returns number of files"
NSQ_SOURCE_LINE 00001849 "        # successfully changed."
NSQ_SOURCE_LINE 00001850 "        if ( $in_place_modify"
NSQ_SOURCE_LINE 00001851 "            && chown( $uid_i, $gid_i, $output_file ) )"
NSQ_SOURCE_LINE 00001852 "        {"
NSQ_SOURCE_LINE 00001853 "            # owner/group successfully changed"
NSQ_SOURCE_LINE 00001854 "        }"
NSQ_SOURCE_LINE 00001855 "        else {"
NSQ_SOURCE_LINE 00001856 ""
NSQ_SOURCE_LINE 00001857 "            # owner or group differ: do not copy suid and sgid"
NSQ_SOURCE_LINE 00001858 "            $output_file_permissions = $mode_i & OCT_777;"
NSQ_SOURCE_LINE 00001859 "            if ( $input_file_permissions != $output_file_permissions ) {"
NSQ_SOURCE_LINE 00001860 "                Warn("
NSQ_SOURCE_LINE 00001861 "\"Unable to copy setuid and/or setgid bits for output file '$output_file'\\n\""
NSQ_SOURCE_LINE 00001862 "                );"
NSQ_SOURCE_LINE 00001863 "            }"
NSQ_SOURCE_LINE 00001864 "        }"
NSQ_SOURCE_LINE 00001865 "    }"
NSQ_SOURCE_LINE 00001866 ""
NSQ_SOURCE_LINE 00001867 "    # Mark the output file for rw unless we are in -b mode."
NSQ_SOURCE_LINE 00001868 "    # Explanation: perltidy does not unlink existing output"
NSQ_SOURCE_LINE 00001869 "    # files before writing to them, for safety.  If a"
NSQ_SOURCE_LINE 00001870 "    # designated output file exists and is not writable,"
NSQ_SOURCE_LINE 00001871 "    # perltidy will halt.  This can prevent a data loss if a"
NSQ_SOURCE_LINE 00001872 "    # user accidentally enters \"perltidy infile -o"
NSQ_SOURCE_LINE 00001873 "    # important_ro_file\", or \"perltidy infile -st"
NSQ_SOURCE_LINE 00001874 "    # >important_ro_file\". But it also means that perltidy can"
NSQ_SOURCE_LINE 00001875 "    # get locked out of rerunning unless it marks its own"
NSQ_SOURCE_LINE 00001876 "    # output files writable. The alternative, of always"
NSQ_SOURCE_LINE 00001877 "    # unlinking the designated output file, is less safe and"
NSQ_SOURCE_LINE 00001878 "    # not always possible, except in -b mode, where there is an"
NSQ_SOURCE_LINE 00001879 "    # assumption that a previous backup can be unlinked even if"
NSQ_SOURCE_LINE 00001880 "    # not writable."
NSQ_SOURCE_LINE 00001881 "    if ( !$in_place_modify ) {"
NSQ_SOURCE_LINE 00001882 "        $output_file_permissions |= OCT_600;"
NSQ_SOURCE_LINE 00001883 "    }"
NSQ_SOURCE_LINE 00001884 ""
NSQ_SOURCE_LINE 00001885 "    if ( !chmod( $output_file_permissions, $output_file ) ) {"
NSQ_SOURCE_LINE 00001886 ""
NSQ_SOURCE_LINE 00001887 "        # couldn't change file permissions"
NSQ_SOURCE_LINE 00001888 "        my $operm = sprintf( \"%04o\", $output_file_permissions );"
NSQ_SOURCE_LINE 00001889 "        Warn("
NSQ_SOURCE_LINE 00001890 "\"Unable to set permissions for output file '$output_file' to $operm\\n\""
NSQ_SOURCE_LINE 00001891 "        );"
NSQ_SOURCE_LINE 00001892 "    }"
NSQ_SOURCE_LINE 00001893 "    return;"
NSQ_SOURCE_LINE 00001894 "} ## end sub set_output_file_permissions"
NSQ_SOURCE_LINE 00001895 ""
NSQ_SOURCE_LINE 00001896 "sub get_decoded_string_buffer {"
NSQ_SOURCE_LINE 00001897 ""
NSQ_SOURCE_LINE 00001898 "    my ( $self, $input_file, $display_name ) = @_;"
NSQ_SOURCE_LINE 00001899 ""
NSQ_SOURCE_LINE 00001900 "    # Decode the input buffer from utf8 if necessary or requested"
NSQ_SOURCE_LINE 00001901 ""
NSQ_SOURCE_LINE 00001902 "    # Given:"
NSQ_SOURCE_LINE 00001903 "    #   $input_file   = the input file or stream"
NSQ_SOURCE_LINE 00001904 "    #   $display_name = its name to use in error messages"
NSQ_SOURCE_LINE 00001905 ""
NSQ_SOURCE_LINE 00001906 "    # Set $self->[_line_separator_], and"
NSQ_SOURCE_LINE 00001907 ""
NSQ_SOURCE_LINE 00001908 "    # Return:"
NSQ_SOURCE_LINE 00001909 "    #   $rinput_string = ref to input string, decoded from utf8 if necessary"
NSQ_SOURCE_LINE 00001910 "    #   $is_encoded_data  = true if $buf is decoded from utf8"
NSQ_SOURCE_LINE 00001911 "    #   $decoded_input_as = true if perltidy decoded input buf"
NSQ_SOURCE_LINE 00001912 "    #   $encoding_log_message = messages for log file,"
NSQ_SOURCE_LINE 00001913 "    #   $length_function  = function to use for measuring string width"
NSQ_SOURCE_LINE 00001914 ""
NSQ_SOURCE_LINE 00001915 "    # Return nothing on any error; this is a signal to skip this file"
NSQ_SOURCE_LINE 00001916 ""
NSQ_SOURCE_LINE 00001917 "    my $rOpts = $self->[_rOpts_];"
NSQ_SOURCE_LINE 00001918 ""
NSQ_SOURCE_LINE 00001919 "    my $rinput_string ="
NSQ_SOURCE_LINE 00001920 "      stream_slurp( $input_file, $rOpts->{'timeout-in-seconds'} );"
NSQ_SOURCE_LINE 00001921 "    return unless ( defined($rinput_string) );"
NSQ_SOURCE_LINE 00001922 ""
NSQ_SOURCE_LINE 00001923 "    # Note that we could have a zero size input string here if it"
NSQ_SOURCE_LINE 00001924 "    # arrived from standard input or from a string ref. For example"
NSQ_SOURCE_LINE 00001925 "    # 'perltidy <null.pl'.  If we issue a warning and stop, as we would"
NSQ_SOURCE_LINE 00001926 "    # for a zero length file ('perltidy null.pl'), then we could cause"
NSQ_SOURCE_LINE 00001927 "    # a call to the perltidy module to misbehave as a filter. So we will"
NSQ_SOURCE_LINE 00001928 "    # process this as any other file in this case without any warning (c286)."
NSQ_SOURCE_LINE 00001929 "    if ( !length( ${$rinput_string} ) ) {"
NSQ_SOURCE_LINE 00001930 ""
NSQ_SOURCE_LINE 00001931 "        # zero length, but keep going"
NSQ_SOURCE_LINE 00001932 "    }"
NSQ_SOURCE_LINE 00001933 ""
NSQ_SOURCE_LINE 00001934 "    # Check size of strings arriving from the standard input. These"
NSQ_SOURCE_LINE 00001935 "    # could not be checked until now."
NSQ_SOURCE_LINE 00001936 "    if ( $input_file eq '-' ) {"
NSQ_SOURCE_LINE 00001937 "        my $size_in_mb ="
NSQ_SOURCE_LINE 00001938 "          length( ${$rinput_string} ) / ( CONST_1024 * CONST_1024 );"
NSQ_SOURCE_LINE 00001939 "        my $maximum_file_size_mb = $rOpts->{'maximum-file-size-mb'};"
NSQ_SOURCE_LINE 00001940 "        if ( $size_in_mb > $maximum_file_size_mb ) {"
NSQ_SOURCE_LINE 00001941 "            $size_in_mb = sprintf( \"%0.1f\", $size_in_mb );"
NSQ_SOURCE_LINE 00001942 "            Warn("
NSQ_SOURCE_LINE 00001943 "\"skipping file: <stdin>: size $size_in_mb MB exceeds limit $maximum_file_size_mb; use -maxfs=i to change\\n\""
NSQ_SOURCE_LINE 00001944 "            );"
NSQ_SOURCE_LINE 00001945 "            return;"
NSQ_SOURCE_LINE 00001946 "        }"
NSQ_SOURCE_LINE 00001947 "    }"
NSQ_SOURCE_LINE 00001948 ""
NSQ_SOURCE_LINE 00001949 "    $rinput_string = $self->set_line_separator($rinput_string);"
NSQ_SOURCE_LINE 00001950 ""
NSQ_SOURCE_LINE 00001951 "    my $encoding_in              = EMPTY_STRING;"
NSQ_SOURCE_LINE 00001952 "    my $rOpts_character_encoding = $rOpts->{'character-encoding'};"
NSQ_SOURCE_LINE 00001953 "    my $encoding_log_message;"
NSQ_SOURCE_LINE 00001954 "    my $decoded_input_as = EMPTY_STRING;"
NSQ_SOURCE_LINE 00001955 "    $rstatus->{'char_mode_source'} = 0;"
NSQ_SOURCE_LINE 00001956 ""
NSQ_SOURCE_LINE 00001957 "    my $is_pure_ascii_data = !( ${$rinput_string} =~ /[^[:ascii:]]/ );"
NSQ_SOURCE_LINE 00001958 "    $self->[_is_pure_ascii_data_] = $is_pure_ascii_data;"
NSQ_SOURCE_LINE 00001959 ""
NSQ_SOURCE_LINE 00001960 "    # Case 1: If Perl is already in a character-oriented mode for this"
NSQ_SOURCE_LINE 00001961 "    # string rather than a byte-oriented mode.  Normally, this happens if"
NSQ_SOURCE_LINE 00001962 "    # the caller has decoded a utf8 string before calling perltidy.  But it"
NSQ_SOURCE_LINE 00001963 "    # could also happen if the user has done some unusual manipulations of"
NSQ_SOURCE_LINE 00001964 "    # the source.  In any case, we will not attempt to decode it because"
NSQ_SOURCE_LINE 00001965 "    # that could result in an output string in a different mode."
NSQ_SOURCE_LINE 00001966 "    if ( is_char_mode( ${$rinput_string} ) ) {"
NSQ_SOURCE_LINE 00001967 "        $encoding_in = \"utf8\";"
NSQ_SOURCE_LINE 00001968 "        $rstatus->{'char_mode_source'} = 1;"
NSQ_SOURCE_LINE 00001969 "    }"
NSQ_SOURCE_LINE 00001970 ""
NSQ_SOURCE_LINE 00001971 "    # Case 2. No input stream encoding requested.  This is appropriate"
NSQ_SOURCE_LINE 00001972 "    # for single-byte encodings like ascii, latin-1, etc"
NSQ_SOURCE_LINE 00001973 "    elsif ( !$rOpts_character_encoding"
NSQ_SOURCE_LINE 00001974 "        || $rOpts_character_encoding eq 'none' )"
NSQ_SOURCE_LINE 00001975 "    {"
NSQ_SOURCE_LINE 00001976 ""
NSQ_SOURCE_LINE 00001977 "        # nothing to do"
NSQ_SOURCE_LINE 00001978 "    }"
NSQ_SOURCE_LINE 00001979 ""
NSQ_SOURCE_LINE 00001980 "    # Case 3. guess input stream encoding if requested"
NSQ_SOURCE_LINE 00001981 "    elsif ( lc($rOpts_character_encoding) eq 'guess' ) {"
NSQ_SOURCE_LINE 00001982 ""
NSQ_SOURCE_LINE 00001983 "        # The guessing strategy is simple: use Encode::Guess to guess"
NSQ_SOURCE_LINE 00001984 "        # an encoding.  If and only if the guess is utf8, try decoding and"
NSQ_SOURCE_LINE 00001985 "        # use it if successful.  Otherwise, we proceed assuming the"
NSQ_SOURCE_LINE 00001986 "        # characters are encoded as single bytes (same as if 'none' had"
NSQ_SOURCE_LINE 00001987 "        # been specified as the encoding)."
NSQ_SOURCE_LINE 00001988 ""
NSQ_SOURCE_LINE 00001989 "        # In testing I have found that including additional guess 'suspect'"
NSQ_SOURCE_LINE 00001990 "        # encodings sometimes works but can sometimes lead to disaster by"
NSQ_SOURCE_LINE 00001991 "        # using an incorrect decoding."
NSQ_SOURCE_LINE 00001992 ""
NSQ_SOURCE_LINE 00001993 "        my $decoder;"
NSQ_SOURCE_LINE 00001994 "        if ( !$is_pure_ascii_data ) {"
NSQ_SOURCE_LINE 00001995 "            $decoder = guess_encoding( ${$rinput_string}, 'utf8' );"
NSQ_SOURCE_LINE 00001996 "        }"
NSQ_SOURCE_LINE 00001997 "        if ( $decoder && ref($decoder) ) {"
NSQ_SOURCE_LINE 00001998 "            $encoding_in = $decoder->name;"
NSQ_SOURCE_LINE 00001999 "            if ( $encoding_in ne 'UTF-8' && $encoding_in ne 'utf8' ) {"
NSQ_SOURCE_LINE 00002000 "                $encoding_in = EMPTY_STRING;"
NSQ_SOURCE_LINE 00002001 "                $encoding_log_message .= <<EOM;"
NSQ_SOURCE_LINE 00002002 "Guessed encoding '$encoding_in' is not utf8; no encoding will be used"
NSQ_SOURCE_LINE 00002003 "EOM"
NSQ_SOURCE_LINE 00002004 "            }"
NSQ_SOURCE_LINE 00002005 "            else {"
NSQ_SOURCE_LINE 00002006 ""
NSQ_SOURCE_LINE 00002007 "                my $buf;"
NSQ_SOURCE_LINE 00002008 "                if ( !eval { $buf = $decoder->decode( ${$rinput_string} ); 1 } )"
NSQ_SOURCE_LINE 00002009 "                {"
NSQ_SOURCE_LINE 00002010 ""
NSQ_SOURCE_LINE 00002011 "                    $encoding_log_message .= <<EOM;"
NSQ_SOURCE_LINE 00002012 "Guessed encoding '$encoding_in' but decoding was unsuccessful; no encoding is used"
NSQ_SOURCE_LINE 00002013 "EOM"
NSQ_SOURCE_LINE 00002014 ""
NSQ_SOURCE_LINE 00002015 "                    # Note that a guess failed, but keep going"
NSQ_SOURCE_LINE 00002016 "                    # This warning can eventually be removed"
NSQ_SOURCE_LINE 00002017 "                    Warn("
NSQ_SOURCE_LINE 00002018 "\"file: $display_name: bad guess to decode source as $encoding_in\\n\""
NSQ_SOURCE_LINE 00002019 "                    );"
NSQ_SOURCE_LINE 00002020 "                    $encoding_in = EMPTY_STRING;"
NSQ_SOURCE_LINE 00002021 "                }"
NSQ_SOURCE_LINE 00002022 "                else {"
NSQ_SOURCE_LINE 00002023 "                    $encoding_log_message .= <<EOM;"
NSQ_SOURCE_LINE 00002024 "Guessed encoding '$encoding_in' successfully decoded"
NSQ_SOURCE_LINE 00002025 "EOM"
NSQ_SOURCE_LINE 00002026 "                    $decoded_input_as = $encoding_in;"
NSQ_SOURCE_LINE 00002027 "                    $rinput_string    = \\$buf;"
NSQ_SOURCE_LINE 00002028 "                }"
NSQ_SOURCE_LINE 00002029 "            }"
NSQ_SOURCE_LINE 00002030 "        }"
NSQ_SOURCE_LINE 00002031 "        else {"
NSQ_SOURCE_LINE 00002032 "            $encoding_log_message .= <<EOM;"
NSQ_SOURCE_LINE 00002033 "Does not look like utf8 encoded text so processing as raw bytes"
NSQ_SOURCE_LINE 00002034 "EOM"
NSQ_SOURCE_LINE 00002035 "        }"
NSQ_SOURCE_LINE 00002036 "    }"
NSQ_SOURCE_LINE 00002037 ""
NSQ_SOURCE_LINE 00002038 "    # Case 4. Decode with a specific encoding"
NSQ_SOURCE_LINE 00002039 "    else {"
NSQ_SOURCE_LINE 00002040 "        $encoding_in = $rOpts_character_encoding;"
NSQ_SOURCE_LINE 00002041 "        my $buf;"
NSQ_SOURCE_LINE 00002042 "        if ("
NSQ_SOURCE_LINE 00002043 "            !eval {"
NSQ_SOURCE_LINE 00002044 "                $buf = Encode::decode( $encoding_in, ${$rinput_string},"
NSQ_SOURCE_LINE 00002045 "                    Encode::FB_CROAK | Encode::LEAVE_SRC );"
NSQ_SOURCE_LINE 00002046 "                1;"
NSQ_SOURCE_LINE 00002047 "            }"
NSQ_SOURCE_LINE 00002048 "          )"
NSQ_SOURCE_LINE 00002049 "        {"
NSQ_SOURCE_LINE 00002050 ""
NSQ_SOURCE_LINE 00002051 "            # Quit if we cannot decode by the requested encoding;"
NSQ_SOURCE_LINE 00002052 "            # Something is not right."
NSQ_SOURCE_LINE 00002053 "            Warn("
NSQ_SOURCE_LINE 00002054 "\"skipping file: $display_name: Unable to decode source as $encoding_in\\n\""
NSQ_SOURCE_LINE 00002055 "            );"
NSQ_SOURCE_LINE 00002056 ""
NSQ_SOURCE_LINE 00002057 "            # return nothing on error"
NSQ_SOURCE_LINE 00002058 "            return;"
NSQ_SOURCE_LINE 00002059 "        }"
NSQ_SOURCE_LINE 00002060 "        else {"
NSQ_SOURCE_LINE 00002061 "            $encoding_log_message .= <<EOM;"
NSQ_SOURCE_LINE 00002062 "Specified encoding '$encoding_in' successfully decoded"
NSQ_SOURCE_LINE 00002063 "EOM"
NSQ_SOURCE_LINE 00002064 "            $decoded_input_as = $encoding_in;"
NSQ_SOURCE_LINE 00002065 "            $rinput_string    = \\$buf;"
NSQ_SOURCE_LINE 00002066 "        }"
NSQ_SOURCE_LINE 00002067 "    }"
NSQ_SOURCE_LINE 00002068 ""
NSQ_SOURCE_LINE 00002069 "    # Set the encoding to be used for all further i/o: If we have"
NSQ_SOURCE_LINE 00002070 "    # decoded the data with any format, then we must continue to"
NSQ_SOURCE_LINE 00002071 "    # read and write it as encoded data, and we will normalize these"
NSQ_SOURCE_LINE 00002072 "    # operations with utf8.  If we have not decoded the data, then"
NSQ_SOURCE_LINE 00002073 "    # we must not treat it as encoded data."
NSQ_SOURCE_LINE 00002074 "    my $is_encoded_data = $encoding_in ? 'utf8' : EMPTY_STRING;"
NSQ_SOURCE_LINE 00002075 "    $self->[_is_encoded_data_] = $is_encoded_data;"
NSQ_SOURCE_LINE 00002076 ""
NSQ_SOURCE_LINE 00002077 "    # Delete any Byte Order Mark (BOM), which can cause trouble"
NSQ_SOURCE_LINE 00002078 "    if ($is_encoded_data) {"
NSQ_SOURCE_LINE 00002079 "        ${$rinput_string} =~ s/^\\x{FEFF}//;"
NSQ_SOURCE_LINE 00002080 "    }"
NSQ_SOURCE_LINE 00002081 ""
NSQ_SOURCE_LINE 00002082 "    $rstatus->{'input_name'}       = $display_name;"
NSQ_SOURCE_LINE 00002083 "    $rstatus->{'opt_encoding'}     = $rOpts_character_encoding;"
NSQ_SOURCE_LINE 00002084 "    $rstatus->{'char_mode_used'}   = $encoding_in ? 1 : 0;"
NSQ_SOURCE_LINE 00002085 "    $rstatus->{'input_decoded_as'} = $decoded_input_as;"
NSQ_SOURCE_LINE 00002086 ""
NSQ_SOURCE_LINE 00002087 "    # Define the function to determine the display width of character"
NSQ_SOURCE_LINE 00002088 "    # strings"
NSQ_SOURCE_LINE 00002089 "    my $length_function;"
NSQ_SOURCE_LINE 00002090 "    if ($is_encoded_data) {"
NSQ_SOURCE_LINE 00002091 ""
NSQ_SOURCE_LINE 00002092 "        # Try to load Unicode::GCString for defining text display width, if"
NSQ_SOURCE_LINE 00002093 "        # requested, when the first encoded file is encountered"
NSQ_SOURCE_LINE 00002094 "        if ( !defined($loaded_unicode_gcstring) ) {"
NSQ_SOURCE_LINE 00002095 "            if ( eval { require Unicode::GCString; 1 } ) {"
NSQ_SOURCE_LINE 00002096 "                $loaded_unicode_gcstring = 1;"
NSQ_SOURCE_LINE 00002097 "            }"
NSQ_SOURCE_LINE 00002098 "            else {"
NSQ_SOURCE_LINE 00002099 "                $loaded_unicode_gcstring = 0;"
NSQ_SOURCE_LINE 00002100 "                if ( $rOpts->{'use-unicode-gcstring'} ) {"
NSQ_SOURCE_LINE 00002101 "                    Warn(<<EOM);"
NSQ_SOURCE_LINE 00002102 "----------------------"
NSQ_SOURCE_LINE 00002103 "Unable to load Unicode::GCString: $EVAL_ERROR"
NSQ_SOURCE_LINE 00002104 "Processing continues but some vertical alignment may be poor"
NSQ_SOURCE_LINE 00002105 "To prevent this warning message, you can either:"
NSQ_SOURCE_LINE 00002106 "- install module Unicode::GCString, or"
NSQ_SOURCE_LINE 00002107 "- remove '--use-unicode-gcstring' or '-gcs' from your perltidyrc or command line"
NSQ_SOURCE_LINE 00002108 "----------------------"
NSQ_SOURCE_LINE 00002109 "EOM"
NSQ_SOURCE_LINE 00002110 "                }"
NSQ_SOURCE_LINE 00002111 "            }"
NSQ_SOURCE_LINE 00002112 "        }"
NSQ_SOURCE_LINE 00002113 "        if ($loaded_unicode_gcstring) {"
NSQ_SOURCE_LINE 00002114 "            $length_function = sub {"
NSQ_SOURCE_LINE 00002115 "                return Unicode::GCString->new( $_[0] )->columns;"
NSQ_SOURCE_LINE 00002116 "            };"
NSQ_SOURCE_LINE 00002117 "            $encoding_log_message .= <<EOM;"
NSQ_SOURCE_LINE 00002118 "Using 'Unicode::GCString' to measure horizontal character widths"
NSQ_SOURCE_LINE 00002119 "EOM"
NSQ_SOURCE_LINE 00002120 "            $rstatus->{'gcs_used'} = 1;"
NSQ_SOURCE_LINE 00002121 "        }"
NSQ_SOURCE_LINE 00002122 "    }"
NSQ_SOURCE_LINE 00002123 "    return ("
NSQ_SOURCE_LINE 00002124 "        $rinput_string,"
NSQ_SOURCE_LINE 00002125 "        $is_encoded_data,"
NSQ_SOURCE_LINE 00002126 "        $decoded_input_as,"
NSQ_SOURCE_LINE 00002127 "        $encoding_log_message,"
NSQ_SOURCE_LINE 00002128 "        $length_function,"
NSQ_SOURCE_LINE 00002129 ""
NSQ_SOURCE_LINE 00002130 "    );"
NSQ_SOURCE_LINE 00002131 "} ## end sub get_decoded_string_buffer"
NSQ_SOURCE_LINE 00002132 ""
NSQ_SOURCE_LINE 00002133 "{ #<<<"
NSQ_SOURCE_LINE 00002134 ""
NSQ_SOURCE_LINE 00002135 "my $LF;"
NSQ_SOURCE_LINE 00002136 "my $CR;"
NSQ_SOURCE_LINE 00002137 "my $CRLF;"
NSQ_SOURCE_LINE 00002138 ""
NSQ_SOURCE_LINE 00002139 "BEGIN {"
NSQ_SOURCE_LINE 00002140 "    $LF   = chr(10);"
NSQ_SOURCE_LINE 00002141 "    $CR   = chr(13);"
NSQ_SOURCE_LINE 00002142 "    $CRLF = $CR . $LF;"
NSQ_SOURCE_LINE 00002143 "}"
NSQ_SOURCE_LINE 00002144 ""
NSQ_SOURCE_LINE 00002145 "sub get_line_separator_default {"
NSQ_SOURCE_LINE 00002146 ""
NSQ_SOURCE_LINE 00002147 "    my ($rOpts) = @_;"
NSQ_SOURCE_LINE 00002148 ""
NSQ_SOURCE_LINE 00002149 "    # Get the line separator that will apply unless overridden by a"
NSQ_SOURCE_LINE 00002150 "    # --preserve-line-endings flag for a specific file"
NSQ_SOURCE_LINE 00002151 ""
NSQ_SOURCE_LINE 00002152 "    my $line_separator_default = \"\\n\";"
NSQ_SOURCE_LINE 00002153 ""
NSQ_SOURCE_LINE 00002154 "    my $opt_ole = 'output-line-ending';"
NSQ_SOURCE_LINE 00002155 "    my $ole     = $rOpts->{$opt_ole};"
NSQ_SOURCE_LINE 00002156 "    if ($ole) {"
NSQ_SOURCE_LINE 00002157 "        my %endings = ("
NSQ_SOURCE_LINE 00002158 "            dos  => $CRLF,"
NSQ_SOURCE_LINE 00002159 "            win  => $CRLF,"
NSQ_SOURCE_LINE 00002160 "            mac  => $CR,"
NSQ_SOURCE_LINE 00002161 "            unix => $LF,"
NSQ_SOURCE_LINE 00002162 "        );"
NSQ_SOURCE_LINE 00002163 ""
NSQ_SOURCE_LINE 00002164 "        $line_separator_default = $endings{ lc($ole) };"
NSQ_SOURCE_LINE 00002165 ""
NSQ_SOURCE_LINE 00002166 "        if ( !$line_separator_default ) {"
NSQ_SOURCE_LINE 00002167 "            my $str = join SPACE, keys %endings;"
NSQ_SOURCE_LINE 00002168 "            Die(<<EOM);"
NSQ_SOURCE_LINE 00002169 "Unrecognized line ending '$ole'; expecting one of: $str"
NSQ_SOURCE_LINE 00002170 "EOM"
NSQ_SOURCE_LINE 00002171 "        }"
NSQ_SOURCE_LINE 00002172 ""
NSQ_SOURCE_LINE 00002173 "        # Check for conflict with -ple"
NSQ_SOURCE_LINE 00002174 "        my $opt_ple = 'preserve-line-endings';"
NSQ_SOURCE_LINE 00002175 "        if ( $rOpts->{$opt_ple} ) {"
NSQ_SOURCE_LINE 00002176 "            Warn(\"Ignoring '--$opt_ple': conflicts with '--$opt_ole'\\n\");"
NSQ_SOURCE_LINE 00002177 "            $rOpts->{$opt_ple} = undef;"
NSQ_SOURCE_LINE 00002178 "        }"
NSQ_SOURCE_LINE 00002179 "    }"
NSQ_SOURCE_LINE 00002180 ""
NSQ_SOURCE_LINE 00002181 "    return $line_separator_default;"
NSQ_SOURCE_LINE 00002182 ""
NSQ_SOURCE_LINE 00002183 "} ## end sub get_line_separator_default"
NSQ_SOURCE_LINE 00002184 ""
NSQ_SOURCE_LINE 00002185 "sub set_line_separator {"
NSQ_SOURCE_LINE 00002186 ""
NSQ_SOURCE_LINE 00002187 "    my ( $self, $rinput_string ) = @_;"
NSQ_SOURCE_LINE 00002188 ""
NSQ_SOURCE_LINE 00002189 "    # Set the (output) line separator as requested or necessary"
NSQ_SOURCE_LINE 00002190 ""
NSQ_SOURCE_LINE 00002191 "    my $rOpts = $self->[_rOpts_];"
NSQ_SOURCE_LINE 00002192 ""
NSQ_SOURCE_LINE 00002193 "    # Start with the default (output) line separator"
NSQ_SOURCE_LINE 00002194 "    my $line_separator = $self->[_line_separator_default_];"
NSQ_SOURCE_LINE 00002195 ""
NSQ_SOURCE_LINE 00002196 "    # First try to find the line separator of the input stream"
NSQ_SOURCE_LINE 00002197 "    my $input_line_separator;"
NSQ_SOURCE_LINE 00002198 ""
NSQ_SOURCE_LINE 00002199 "    # Limit the search to a reasonable number of characters, in case we"
NSQ_SOURCE_LINE 00002200 "    # have a weird file"
NSQ_SOURCE_LINE 00002201 "    my $str = substr( ${$rinput_string}, 0, CONST_1024 );"
NSQ_SOURCE_LINE 00002202 "    if ($str) {"
NSQ_SOURCE_LINE 00002203 ""
NSQ_SOURCE_LINE 00002204 "        if ( $str =~ m/(($CR|$LF)+)/ ) {"
NSQ_SOURCE_LINE 00002205 ""
NSQ_SOURCE_LINE 00002206 "            my $test = $1;"
NSQ_SOURCE_LINE 00002207 ""
NSQ_SOURCE_LINE 00002208 "            # dos"
NSQ_SOURCE_LINE 00002209 "            if ( $test =~ /^($CRLF)+\\z/ ) {"
NSQ_SOURCE_LINE 00002210 "                $input_line_separator = $CRLF;"
NSQ_SOURCE_LINE 00002211 "            }"
NSQ_SOURCE_LINE 00002212 ""
NSQ_SOURCE_LINE 00002213 "            # mac"
NSQ_SOURCE_LINE 00002214 "            elsif ( $test =~ /^($CR)+\\z/ ) {"
NSQ_SOURCE_LINE 00002215 "                $input_line_separator = $CR;"
NSQ_SOURCE_LINE 00002216 "            }"
NSQ_SOURCE_LINE 00002217 ""
NSQ_SOURCE_LINE 00002218 "            # unix"
NSQ_SOURCE_LINE 00002219 "            elsif ( $test =~ /^($LF)+\\z/ ) {"
NSQ_SOURCE_LINE 00002220 "                $input_line_separator = $LF;"
NSQ_SOURCE_LINE 00002221 "            }"
NSQ_SOURCE_LINE 00002222 ""
NSQ_SOURCE_LINE 00002223 "            # unknown"
NSQ_SOURCE_LINE 00002224 "            else { }"
NSQ_SOURCE_LINE 00002225 "        }"
NSQ_SOURCE_LINE 00002226 ""
NSQ_SOURCE_LINE 00002227 "        # no ending seen"
NSQ_SOURCE_LINE 00002228 "        else { }"
NSQ_SOURCE_LINE 00002229 "    }"
NSQ_SOURCE_LINE 00002230 ""
NSQ_SOURCE_LINE 00002231 "    if ( defined($input_line_separator) ) {"
NSQ_SOURCE_LINE 00002232 ""
NSQ_SOURCE_LINE 00002233 "        # Remember the input line separator if needed"
NSQ_SOURCE_LINE 00002234 "        if ( $rOpts->{'preserve-line-endings'} ) {"
NSQ_SOURCE_LINE 00002235 "            $line_separator = $input_line_separator;"
NSQ_SOURCE_LINE 00002236 "        }"
NSQ_SOURCE_LINE 00002237 ""
NSQ_SOURCE_LINE 00002238 "        # Convert line endings to \"\\n\" for processing if necessary."
NSQ_SOURCE_LINE 00002239 "        if ( $input_line_separator ne \"\\n\" ) {"
NSQ_SOURCE_LINE 00002240 "            my @lines = split /^/, ${$rinput_string};"
NSQ_SOURCE_LINE 00002241 ""
NSQ_SOURCE_LINE 00002242 "            # try to convert CR to \\n"
NSQ_SOURCE_LINE 00002243 "            if ( $input_line_separator eq $CR ) {"
NSQ_SOURCE_LINE 00002244 ""
NSQ_SOURCE_LINE 00002245 "                # if this file is currently a single line .."
NSQ_SOURCE_LINE 00002246 "                if ( @lines == 1 ) {"
NSQ_SOURCE_LINE 00002247 ""
NSQ_SOURCE_LINE 00002248 "                    # and becomes multiple lines with the change .."
NSQ_SOURCE_LINE 00002249 "                    @lines = map { $_ . \"\\n\" } split /$CR/, ${$rinput_string};"
NSQ_SOURCE_LINE 00002250 "                    if ( @lines > 1 ) {"
NSQ_SOURCE_LINE 00002251 ""
NSQ_SOURCE_LINE 00002252 "                        # then make the change"
NSQ_SOURCE_LINE 00002253 "                        my $buf = join EMPTY_STRING, @lines;"
NSQ_SOURCE_LINE 00002254 "                        $rinput_string = \\$buf;"
NSQ_SOURCE_LINE 00002255 "                    }"
NSQ_SOURCE_LINE 00002256 "                }"
NSQ_SOURCE_LINE 00002257 "            }"
NSQ_SOURCE_LINE 00002258 ""
NSQ_SOURCE_LINE 00002259 "            # convert CR-LF to LF"
NSQ_SOURCE_LINE 00002260 "            elsif ( ( $input_line_separator eq $CRLF ) && ( \"\\n\" eq $LF ) ) {"
NSQ_SOURCE_LINE 00002261 "                foreach my $line (@lines) { $line =~ s/$CRLF$/\\n/ }"
NSQ_SOURCE_LINE 00002262 "                my $buf = join EMPTY_STRING, @lines;"
NSQ_SOURCE_LINE 00002263 "                $rinput_string = \\$buf;"
NSQ_SOURCE_LINE 00002264 "            }"
NSQ_SOURCE_LINE 00002265 ""
NSQ_SOURCE_LINE 00002266 "            # unknown line ending scheme - leave it alone and let the tokenizer"
NSQ_SOURCE_LINE 00002267 "            # deal with it"
NSQ_SOURCE_LINE 00002268 "            else {"
NSQ_SOURCE_LINE 00002269 "            }"
NSQ_SOURCE_LINE 00002270 "        }"
NSQ_SOURCE_LINE 00002271 "    }"
NSQ_SOURCE_LINE 00002272 ""
NSQ_SOURCE_LINE 00002273 "    $self->[_line_separator_] = $line_separator;"
NSQ_SOURCE_LINE 00002274 "    return $rinput_string;"
NSQ_SOURCE_LINE 00002275 "} ## end sub set_line_separator"
NSQ_SOURCE_LINE 00002276 "}"
NSQ_SOURCE_LINE 00002277 ""
NSQ_SOURCE_LINE 00002278 "sub process_all_files {"
NSQ_SOURCE_LINE 00002279 ""
NSQ_SOURCE_LINE 00002280 "    my ( $self, $rcall_hash ) = @_;"
NSQ_SOURCE_LINE 00002281 ""
NSQ_SOURCE_LINE 00002282 "    # This routine is the main loop to process all files."
NSQ_SOURCE_LINE 00002283 "    # Total formatting is done with these layers of subroutines:"
NSQ_SOURCE_LINE 00002284 "    #   perltidy                - main routine; checks run parameters"
NSQ_SOURCE_LINE 00002285 "    #  *process_all_files       - main loop to process all files; *THIS LAYER"
NSQ_SOURCE_LINE 00002286 "    #   process_filter_layer    - do any pre and post processing;"
NSQ_SOURCE_LINE 00002287 "    #   process_iteration_layer - handle any iterations on formatting"
NSQ_SOURCE_LINE 00002288 "    #   process_single_case     - solves one formatting problem"
NSQ_SOURCE_LINE 00002289 ""
NSQ_SOURCE_LINE 00002290 "    my $rinput_hash               = $rcall_hash->{rinput_hash};"
NSQ_SOURCE_LINE 00002291 "    my $rfiles                    = $rcall_hash->{rfiles};"
NSQ_SOURCE_LINE 00002292 "    my $line_range_clipped        = $rcall_hash->{line_range_clipped};"
NSQ_SOURCE_LINE 00002293 "    my $source_stream             = $rcall_hash->{source_stream};"
NSQ_SOURCE_LINE 00002294 "    my $output_extension          = $rcall_hash->{output_extension};"
NSQ_SOURCE_LINE 00002295 "    my $forbidden_file_extensions = $rcall_hash->{forbidden_file_extensions};"
NSQ_SOURCE_LINE 00002296 "    my $in_place_modify           = $rcall_hash->{in_place_modify};"
NSQ_SOURCE_LINE 00002297 "    my $backup_extension          = $rcall_hash->{backup_extension};"
NSQ_SOURCE_LINE 00002298 "    my $delete_backup             = $rcall_hash->{delete_backup};"
NSQ_SOURCE_LINE 00002299 "    my $logfile_header            = $rcall_hash->{logfile_header};"
NSQ_SOURCE_LINE 00002300 "    my $rpending_complaint        = $rcall_hash->{rpending_complaint};"
NSQ_SOURCE_LINE 00002301 "    my $rpending_logfile_message  = $rcall_hash->{rpending_logfile_message};"
NSQ_SOURCE_LINE 00002302 ""
NSQ_SOURCE_LINE 00002303 "    my $rOpts              = $self->[_rOpts_];"
NSQ_SOURCE_LINE 00002304 "    my $dot                = $self->[_file_extension_separator_];"
NSQ_SOURCE_LINE 00002305 "    my $diagnostics_object = $self->[_diagnostics_object_];"
NSQ_SOURCE_LINE 00002306 ""
NSQ_SOURCE_LINE 00002307 "    my $destination_stream = $rinput_hash->{'destination'};"
NSQ_SOURCE_LINE 00002308 "    my $errorfile_stream   = $rinput_hash->{'errorfile'};"
NSQ_SOURCE_LINE 00002309 "    my $logfile_stream     = $rinput_hash->{'logfile'};"
NSQ_SOURCE_LINE 00002310 "    my $teefile_stream     = $rinput_hash->{'teefile'};"
NSQ_SOURCE_LINE 00002311 "    my $debugfile_stream   = $rinput_hash->{'debugfile'};"
NSQ_SOURCE_LINE 00002312 ""
NSQ_SOURCE_LINE 00002313 "    my $number_of_files = @{$rfiles};"
NSQ_SOURCE_LINE 00002314 "    foreach my $input_file ( @{$rfiles} ) {"
NSQ_SOURCE_LINE 00002315 "        my $fileroot;"
NSQ_SOURCE_LINE 00002316 "        my @input_file_stat;"
NSQ_SOURCE_LINE 00002317 "        my $display_name;"
NSQ_SOURCE_LINE 00002318 ""
NSQ_SOURCE_LINE 00002319 "        #--------------------------"
NSQ_SOURCE_LINE 00002320 "        # prepare this input stream"
NSQ_SOURCE_LINE 00002321 "        #--------------------------"
NSQ_SOURCE_LINE 00002322 "        if ($source_stream) {"
NSQ_SOURCE_LINE 00002323 "            $fileroot     = \"perltidy\";"
NSQ_SOURCE_LINE 00002324 "            $display_name = \"<source_stream>\";"
NSQ_SOURCE_LINE 00002325 ""
NSQ_SOURCE_LINE 00002326 "            # If the source is from an array or string, then .LOG output"
NSQ_SOURCE_LINE 00002327 "            # is only possible if a logfile stream is specified.  This prevents"
NSQ_SOURCE_LINE 00002328 "            # unexpected perltidy.LOG files.  If the stream is not defined"
NSQ_SOURCE_LINE 00002329 "            # then we will capture it in a string ref but it will not be"
NSQ_SOURCE_LINE 00002330 "            # accessible. Previously by Perl::Tidy::DevNull (fix c255);"
NSQ_SOURCE_LINE 00002331 "            if ( !defined($logfile_stream) ) {"
NSQ_SOURCE_LINE 00002332 "                $logfile_stream = \\my $tmp;"
NSQ_SOURCE_LINE 00002333 ""
NSQ_SOURCE_LINE 00002334 "                # Likewise for .TEE and .DEBUG output"
NSQ_SOURCE_LINE 00002335 "            }"
NSQ_SOURCE_LINE 00002336 "            if ( !defined($teefile_stream) ) {"
NSQ_SOURCE_LINE 00002337 "                $teefile_stream = \\my $tmp;"
NSQ_SOURCE_LINE 00002338 "            }"
NSQ_SOURCE_LINE 00002339 "            if ( !defined($debugfile_stream) ) {"
NSQ_SOURCE_LINE 00002340 "                $debugfile_stream = \\my $tmp;"
NSQ_SOURCE_LINE 00002341 "            }"
NSQ_SOURCE_LINE 00002342 "        }"
NSQ_SOURCE_LINE 00002343 "        elsif ( $input_file eq '-' ) {    # '-' indicates input from STDIN"
NSQ_SOURCE_LINE 00002344 "            $fileroot     = \"perltidy\";   # root name to use for .ERR, .LOG, etc"
NSQ_SOURCE_LINE 00002345 "            $display_name = \"<stdin>\";"
NSQ_SOURCE_LINE 00002346 "            $in_place_modify = 0;"
NSQ_SOURCE_LINE 00002347 "        }"
NSQ_SOURCE_LINE 00002348 "        else {"
NSQ_SOURCE_LINE 00002349 "            $fileroot     = $input_file;"
NSQ_SOURCE_LINE 00002350 "            $display_name = $input_file;"
NSQ_SOURCE_LINE 00002351 "            if ( !-e $input_file ) {"
NSQ_SOURCE_LINE 00002352 "                Warn(\"skipping file: '$input_file': no matches found\\n\");"
NSQ_SOURCE_LINE 00002353 "                next;"
NSQ_SOURCE_LINE 00002354 "            }"
NSQ_SOURCE_LINE 00002355 ""
NSQ_SOURCE_LINE 00002356 "            if ( !-f $input_file ) {"
NSQ_SOURCE_LINE 00002357 "                Warn(\"skipping file: $input_file: not a regular file\\n\");"
NSQ_SOURCE_LINE 00002358 "                next;"
NSQ_SOURCE_LINE 00002359 "            }"
NSQ_SOURCE_LINE 00002360 ""
NSQ_SOURCE_LINE 00002361 "            # As a safety precaution, skip zero length files."
NSQ_SOURCE_LINE 00002362 "            # If for example a source file got clobbered somehow,"
NSQ_SOURCE_LINE 00002363 "            # the old .tdy or .bak files might still exist so we"
NSQ_SOURCE_LINE 00002364 "            # shouldn't overwrite them with zero length files."
NSQ_SOURCE_LINE 00002365 "            if ( !-s $input_file ) {"
NSQ_SOURCE_LINE 00002366 "                Warn(\"skipping file: $input_file: Zero size\\n\");"
NSQ_SOURCE_LINE 00002367 "                next;"
NSQ_SOURCE_LINE 00002368 "            }"
NSQ_SOURCE_LINE 00002369 ""
NSQ_SOURCE_LINE 00002370 "            # And avoid formatting extremely large files. Since perltidy reads"
NSQ_SOURCE_LINE 00002371 "            # files into memory, trying to process an extremely large file"
NSQ_SOURCE_LINE 00002372 "            # could cause system problems."
NSQ_SOURCE_LINE 00002373 "            my $size_in_mb = ( -s $input_file ) / ( CONST_1024 * CONST_1024 );"
NSQ_SOURCE_LINE 00002374 "            my $maximum_file_size_mb = $rOpts->{'maximum-file-size-mb'};"
NSQ_SOURCE_LINE 00002375 "            if ( $size_in_mb > $maximum_file_size_mb ) {"
NSQ_SOURCE_LINE 00002376 "                $size_in_mb = sprintf( \"%0.1f\", $size_in_mb );"
NSQ_SOURCE_LINE 00002377 "                Warn("
NSQ_SOURCE_LINE 00002378 "\"skipping file: $input_file: size $size_in_mb MB exceeds limit $maximum_file_size_mb; use -maxfs=i to change\\n\""
NSQ_SOURCE_LINE 00002379 "                );"
NSQ_SOURCE_LINE 00002380 "                next;"
NSQ_SOURCE_LINE 00002381 "            }"
NSQ_SOURCE_LINE 00002382 ""
NSQ_SOURCE_LINE 00002383 "            if ( !-T $input_file && !$rOpts->{'force-read-binary'} ) {"
NSQ_SOURCE_LINE 00002384 "                Warn(\"skipping file: $input_file: Non-text (override with -f)\\n\""
NSQ_SOURCE_LINE 00002385 "                );"
NSQ_SOURCE_LINE 00002386 "                next;"
NSQ_SOURCE_LINE 00002387 "            }"
NSQ_SOURCE_LINE 00002388 ""
NSQ_SOURCE_LINE 00002389 "            # Input file must be writable for -b -bm='copy'.  We must catch"
NSQ_SOURCE_LINE 00002390 "            # this early to prevent encountering trouble after unlinking the"
NSQ_SOURCE_LINE 00002391 "            # previous backup."
NSQ_SOURCE_LINE 00002392 "            if ( $in_place_modify && !-w $input_file ) {"
NSQ_SOURCE_LINE 00002393 "                my $backup_method = $rOpts->{'backup-method'};"
NSQ_SOURCE_LINE 00002394 "                if ( defined($backup_method) && $backup_method eq 'copy' ) {"
NSQ_SOURCE_LINE 00002395 "                    Warn("
NSQ_SOURCE_LINE 00002396 "\"skipping file '$input_file' for -b option: file reported as non-writable\\n\""
NSQ_SOURCE_LINE 00002397 "                    );"
NSQ_SOURCE_LINE 00002398 "                    next;"
NSQ_SOURCE_LINE 00002399 "                }"
NSQ_SOURCE_LINE 00002400 "            }"
NSQ_SOURCE_LINE 00002401 ""
NSQ_SOURCE_LINE 00002402 "            # we should have a valid filename now"
NSQ_SOURCE_LINE 00002403 "            $fileroot        = $input_file;"
NSQ_SOURCE_LINE 00002404 "            @input_file_stat = stat($input_file);"
NSQ_SOURCE_LINE 00002405 ""
NSQ_SOURCE_LINE 00002406 "            if ( $OSNAME eq 'VMS' ) {"
NSQ_SOURCE_LINE 00002407 "                ( $fileroot, $dot ) = check_vms_filename($fileroot);"
NSQ_SOURCE_LINE 00002408 "                $self->[_file_extension_separator_] = $dot;"
NSQ_SOURCE_LINE 00002409 "            }"
NSQ_SOURCE_LINE 00002410 ""
NSQ_SOURCE_LINE 00002411 "            # add option to change path here"
NSQ_SOURCE_LINE 00002412 "            if ( defined( $rOpts->{'output-path'} ) ) {"
NSQ_SOURCE_LINE 00002413 ""
NSQ_SOURCE_LINE 00002414 "                my ( $base, $old_path_uu ) = fileparse($fileroot);"
NSQ_SOURCE_LINE 00002415 "                my $new_path = $rOpts->{'output-path'};"
NSQ_SOURCE_LINE 00002416 "                if ( !-d $new_path ) {"
NSQ_SOURCE_LINE 00002417 "                    mkdir($new_path)    # Default MODE is 0777"
NSQ_SOURCE_LINE 00002418 "                      or"
NSQ_SOURCE_LINE 00002419 "                      Die(\"unable to create directory $new_path: $OS_ERROR\\n\");"
NSQ_SOURCE_LINE 00002420 "                }"
NSQ_SOURCE_LINE 00002421 "                my $path = $new_path;"
NSQ_SOURCE_LINE 00002422 "                $fileroot = File::Spec->catfile( $path, $base );"
NSQ_SOURCE_LINE 00002423 "                if ( !$fileroot ) {"
NSQ_SOURCE_LINE 00002424 "                    Die(<<EOM);"
NSQ_SOURCE_LINE 00002425 "------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00002426 "Problem combining $new_path and $base to make a filename; check -opath"
NSQ_SOURCE_LINE 00002427 "------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00002428 "EOM"
NSQ_SOURCE_LINE 00002429 "                }"
NSQ_SOURCE_LINE 00002430 "            }"
NSQ_SOURCE_LINE 00002431 "        }"
NSQ_SOURCE_LINE 00002432 ""
NSQ_SOURCE_LINE 00002433 "        # Skip files with same extension as the output files because"
NSQ_SOURCE_LINE 00002434 "        # this can lead to a messy situation with files like"
NSQ_SOURCE_LINE 00002435 "        # script.tdy.tdy.tdy ... or worse problems ...  when you"
NSQ_SOURCE_LINE 00002436 "        # rerun perltidy over and over with wildcard input."
NSQ_SOURCE_LINE 00002437 "        if ("
NSQ_SOURCE_LINE 00002438 "            !$source_stream"
NSQ_SOURCE_LINE 00002439 "            && (   $input_file =~ /$forbidden_file_extensions/"
NSQ_SOURCE_LINE 00002440 "                || $input_file eq 'DIAGNOSTICS' )"
NSQ_SOURCE_LINE 00002441 "          )"
NSQ_SOURCE_LINE 00002442 "        {"
NSQ_SOURCE_LINE 00002443 "            Warn(\"skipping file: $input_file: wrong extension\\n\");"
NSQ_SOURCE_LINE 00002444 "            next;"
NSQ_SOURCE_LINE 00002445 "        }"
NSQ_SOURCE_LINE 00002446 ""
NSQ_SOURCE_LINE 00002447 "        # copy source to a string buffer, decoding from utf8 if necessary"
NSQ_SOURCE_LINE 00002448 "        my ("
NSQ_SOURCE_LINE 00002449 "            $rinput_string,"
NSQ_SOURCE_LINE 00002450 "            $is_encoded_data,"
NSQ_SOURCE_LINE 00002451 "            $decoded_input_as,"
NSQ_SOURCE_LINE 00002452 "            $encoding_log_message,"
NSQ_SOURCE_LINE 00002453 "            $length_function,"
NSQ_SOURCE_LINE 00002454 ""
NSQ_SOURCE_LINE 00002455 "        ) = $self->get_decoded_string_buffer( $input_file, $display_name );"
NSQ_SOURCE_LINE 00002456 ""
NSQ_SOURCE_LINE 00002457 "        # Skip this file on any error"
NSQ_SOURCE_LINE 00002458 "        next if ( !defined($rinput_string) );"
NSQ_SOURCE_LINE 00002459 ""
NSQ_SOURCE_LINE 00002460 "        # If we are formatting a named file, skip if it looks like a markup"
NSQ_SOURCE_LINE 00002461 "        # language.  Do not do this for a non-named file (it could be a glob"
NSQ_SOURCE_LINE 00002462 "        # from an editor)."
NSQ_SOURCE_LINE 00002463 "        # Examples of valid perl starting text: '<<END' '<>' '<<>>'"
NSQ_SOURCE_LINE 00002464 "        if ( ${$rinput_string} =~ /^\\s*<[^<>]/ ) {"
NSQ_SOURCE_LINE 00002465 "            my $is_named_file = $number_of_files > 0 && !$line_range_clipped;"
NSQ_SOURCE_LINE 00002466 "            if ( is_not_perl( $rinput_string, $input_file, $is_named_file ) ) {"
NSQ_SOURCE_LINE 00002467 "                Warn("
NSQ_SOURCE_LINE 00002468 "                    \"skipping file: $input_file: does not look like Perl code\\n\""
NSQ_SOURCE_LINE 00002469 "                );"
NSQ_SOURCE_LINE 00002470 "                next;"
NSQ_SOURCE_LINE 00002471 "            }"
NSQ_SOURCE_LINE 00002472 "        }"
NSQ_SOURCE_LINE 00002473 ""
NSQ_SOURCE_LINE 00002474 "        # Register this file name with the Diagnostics package, if any."
NSQ_SOURCE_LINE 00002475 "        $diagnostics_object->set_input_file($input_file)"
NSQ_SOURCE_LINE 00002476 "          if ($diagnostics_object);"
NSQ_SOURCE_LINE 00002477 ""
NSQ_SOURCE_LINE 00002478 "        # The (possibly decoded) input is now in string ref $rinput_string."
NSQ_SOURCE_LINE 00002479 "        # Now prepare the output stream and error logger."
NSQ_SOURCE_LINE 00002480 ""
NSQ_SOURCE_LINE 00002481 "        #--------------------------"
NSQ_SOURCE_LINE 00002482 "        # prepare the output stream"
NSQ_SOURCE_LINE 00002483 "        #--------------------------"
NSQ_SOURCE_LINE 00002484 "        my $output_file = $rOpts->{'outfile'};"
NSQ_SOURCE_LINE 00002485 "        my $output_name = EMPTY_STRING;"
NSQ_SOURCE_LINE 00002486 "        my $actual_output_extension;"
NSQ_SOURCE_LINE 00002487 ""
NSQ_SOURCE_LINE 00002488 "        if ( defined($output_file) && length($output_file) ) {"
NSQ_SOURCE_LINE 00002489 ""
NSQ_SOURCE_LINE 00002490 "            if ( $number_of_files > 1 ) {"
NSQ_SOURCE_LINE 00002491 "                Die(\"You may not use -o with more than one input file\\n\");"
NSQ_SOURCE_LINE 00002492 "            }"
NSQ_SOURCE_LINE 00002493 ""
NSQ_SOURCE_LINE 00002494 "            if ( $rOpts->{'standard-output'} ) {"
NSQ_SOURCE_LINE 00002495 "                my $saw_pbp = $self->[_saw_pbp_];"
NSQ_SOURCE_LINE 00002496 "                my $msg     = \"You may not use -o and -st together\\n\";"
NSQ_SOURCE_LINE 00002497 "                if ($saw_pbp) {"
NSQ_SOURCE_LINE 00002498 "                    $msg .= <<EOM;"
NSQ_SOURCE_LINE 00002499 "Note: -pbp is set and includes -st (see manual); use -nst to turn it off"
NSQ_SOURCE_LINE 00002500 "EOM"
NSQ_SOURCE_LINE 00002501 "                }"
NSQ_SOURCE_LINE 00002502 "                Die(\"$msg\");"
NSQ_SOURCE_LINE 00002503 "            }"
NSQ_SOURCE_LINE 00002504 ""
NSQ_SOURCE_LINE 00002505 "            if ($destination_stream) {"
NSQ_SOURCE_LINE 00002506 "                Die("
NSQ_SOURCE_LINE 00002507 "                    \"You may not specify a destination array and -o together\\n\""
NSQ_SOURCE_LINE 00002508 "                );"
NSQ_SOURCE_LINE 00002509 "            }"
NSQ_SOURCE_LINE 00002510 ""
NSQ_SOURCE_LINE 00002511 "            if ( defined( $rOpts->{'output-path'} ) ) {"
NSQ_SOURCE_LINE 00002512 "                Die(\"You may not specify -o and -opath together\\n\");"
NSQ_SOURCE_LINE 00002513 "            }"
NSQ_SOURCE_LINE 00002514 ""
NSQ_SOURCE_LINE 00002515 "            if ( defined( $rOpts->{'output-file-extension'} ) ) {"
NSQ_SOURCE_LINE 00002516 "                Die(\"You may not specify -o and -oext together\\n\");"
NSQ_SOURCE_LINE 00002517 "            }"
NSQ_SOURCE_LINE 00002518 ""
NSQ_SOURCE_LINE 00002519 "            $output_name = $output_file;"
NSQ_SOURCE_LINE 00002520 ""
NSQ_SOURCE_LINE 00002521 "            # do not overwrite input file with -o"
NSQ_SOURCE_LINE 00002522 "            if ( @input_file_stat && ( $output_file eq $input_file ) ) {"
NSQ_SOURCE_LINE 00002523 "                Die(\"Use 'perltidy -b $input_file' to modify in-place\\n\");"
NSQ_SOURCE_LINE 00002524 "            }"
NSQ_SOURCE_LINE 00002525 "        }"
NSQ_SOURCE_LINE 00002526 "        elsif ( $rOpts->{'standard-output'} ) {"
NSQ_SOURCE_LINE 00002527 "            if ($destination_stream) {"
NSQ_SOURCE_LINE 00002528 "                my $saw_pbp = $self->[_saw_pbp_];"
NSQ_SOURCE_LINE 00002529 "                my $msg ="
NSQ_SOURCE_LINE 00002530 "                  \"You may not specify a destination array and -st together\\n\";"
NSQ_SOURCE_LINE 00002531 "                $msg .= \" (note: -pbp contains -st; see manual)\" if ($saw_pbp);"
NSQ_SOURCE_LINE 00002532 "                Die(\"$msg\\n\");"
NSQ_SOURCE_LINE 00002533 "            }"
NSQ_SOURCE_LINE 00002534 "            $output_file = '-';"
NSQ_SOURCE_LINE 00002535 "            $output_name = \"<stdout>\";"
NSQ_SOURCE_LINE 00002536 ""
NSQ_SOURCE_LINE 00002537 "            if ( $number_of_files <= 1 ) {"
NSQ_SOURCE_LINE 00002538 "            }"
NSQ_SOURCE_LINE 00002539 "            else {"
NSQ_SOURCE_LINE 00002540 "                Die(\"You may not use -st with more than one input file\\n\");"
NSQ_SOURCE_LINE 00002541 "            }"
NSQ_SOURCE_LINE 00002542 "        }"
NSQ_SOURCE_LINE 00002543 "        elsif ($destination_stream) {"
NSQ_SOURCE_LINE 00002544 ""
NSQ_SOURCE_LINE 00002545 "            $output_file = $destination_stream;"
NSQ_SOURCE_LINE 00002546 "            $output_name = \"<destination_stream>\";"
NSQ_SOURCE_LINE 00002547 "        }"
NSQ_SOURCE_LINE 00002548 "        elsif ($source_stream) {    # source but no destination goes to stdout"
NSQ_SOURCE_LINE 00002549 "            $output_file = '-';"
NSQ_SOURCE_LINE 00002550 "            $output_name = \"<stdout>\";"
NSQ_SOURCE_LINE 00002551 "        }"
NSQ_SOURCE_LINE 00002552 "        elsif ( $input_file eq '-' ) {"
NSQ_SOURCE_LINE 00002553 "            $output_file = '-';"
NSQ_SOURCE_LINE 00002554 "            $output_name = \"<stdout>\";"
NSQ_SOURCE_LINE 00002555 "        }"
NSQ_SOURCE_LINE 00002556 "        else {"
NSQ_SOURCE_LINE 00002557 "            if ($in_place_modify) {"
NSQ_SOURCE_LINE 00002558 "                $output_name = $display_name;"
NSQ_SOURCE_LINE 00002559 "            }"
NSQ_SOURCE_LINE 00002560 "            else {"
NSQ_SOURCE_LINE 00002561 "                $actual_output_extension = $output_extension;"
NSQ_SOURCE_LINE 00002562 "                $output_file             = $fileroot . $output_extension;"
NSQ_SOURCE_LINE 00002563 "                $output_name             = $output_file;"
NSQ_SOURCE_LINE 00002564 "            }"
NSQ_SOURCE_LINE 00002565 "        }"
NSQ_SOURCE_LINE 00002566 ""
NSQ_SOURCE_LINE 00002567 "        # prepare standard output in case of a dump to stdout"
NSQ_SOURCE_LINE 00002568 "        if ( $is_encoded_data && $self->[_dump_to_stdout_] ) {"
NSQ_SOURCE_LINE 00002569 "            binmode *STDOUT, ':encoding(UTF-8)';"
NSQ_SOURCE_LINE 00002570 "        }"
NSQ_SOURCE_LINE 00002571 ""
NSQ_SOURCE_LINE 00002572 "        $rstatus->{'file_count'} += 1;"
NSQ_SOURCE_LINE 00002573 "        $rstatus->{'output_name'}     = $output_name;"
NSQ_SOURCE_LINE 00002574 "        $rstatus->{'iteration_count'} = 0;"
NSQ_SOURCE_LINE 00002575 "        $rstatus->{'converged'}       = 0;"
NSQ_SOURCE_LINE 00002576 ""
NSQ_SOURCE_LINE 00002577 "        #------------------------------------------"
NSQ_SOURCE_LINE 00002578 "        # initialize the error logger for this file"
NSQ_SOURCE_LINE 00002579 "        #------------------------------------------"
NSQ_SOURCE_LINE 00002580 "        my $warning_file = $fileroot . $dot . \"ERR\";"
NSQ_SOURCE_LINE 00002581 "        if ($errorfile_stream) { $warning_file = $errorfile_stream }"
NSQ_SOURCE_LINE 00002582 "        my $log_file = $fileroot . $dot . \"LOG\";"
NSQ_SOURCE_LINE 00002583 "        if ($logfile_stream) { $log_file = $logfile_stream }"
NSQ_SOURCE_LINE 00002584 ""
NSQ_SOURCE_LINE 00002585 "        # The logger object handles warning messages, logfile messages,"
NSQ_SOURCE_LINE 00002586 "        # and can supply basic run information to lower level routines."
NSQ_SOURCE_LINE 00002587 "        my $logger_object = Perl::Tidy::Logger->new("
NSQ_SOURCE_LINE 00002588 "            rOpts           => $rOpts,"
NSQ_SOURCE_LINE 00002589 "            log_file        => $log_file,"
NSQ_SOURCE_LINE 00002590 "            warning_file    => $warning_file,"
NSQ_SOURCE_LINE 00002591 "            fh_stderr       => $fh_stderr,"
NSQ_SOURCE_LINE 00002592 "            display_name    => $display_name,"
NSQ_SOURCE_LINE 00002593 "            is_encoded_data => $is_encoded_data,"
NSQ_SOURCE_LINE 00002594 "        );"
NSQ_SOURCE_LINE 00002595 "        $logger_object->write_logfile_entry($logfile_header);"
NSQ_SOURCE_LINE 00002596 "        $logger_object->write_logfile_entry($encoding_log_message)"
NSQ_SOURCE_LINE 00002597 "          if ($encoding_log_message);"
NSQ_SOURCE_LINE 00002598 ""
NSQ_SOURCE_LINE 00002599 "        # Now we can add any pending messages to the log"
NSQ_SOURCE_LINE 00002600 "        if ( ${$rpending_logfile_message} ) {"
NSQ_SOURCE_LINE 00002601 "            $logger_object->write_logfile_entry( ${$rpending_logfile_message} );"
NSQ_SOURCE_LINE 00002602 "        }"
NSQ_SOURCE_LINE 00002603 "        if ( ${$rpending_complaint} ) {"
NSQ_SOURCE_LINE 00002604 "            $logger_object->complain( ${$rpending_complaint} );"
NSQ_SOURCE_LINE 00002605 "        }"
NSQ_SOURCE_LINE 00002606 ""
NSQ_SOURCE_LINE 00002607 "        # additional parameters needed by lower level routines"
NSQ_SOURCE_LINE 00002608 "        $self->[_actual_output_extension_] = $actual_output_extension;"
NSQ_SOURCE_LINE 00002609 "        $self->[_debugfile_stream_]        = $debugfile_stream;"
NSQ_SOURCE_LINE 00002610 "        $self->[_decoded_input_as_]        = $decoded_input_as;"
NSQ_SOURCE_LINE 00002611 "        $self->[_destination_stream_]      = $destination_stream;"
NSQ_SOURCE_LINE 00002612 "        $self->[_display_name_]            = $display_name;"
NSQ_SOURCE_LINE 00002613 "        $self->[_fileroot_]                = $fileroot;"
NSQ_SOURCE_LINE 00002614 "        $self->[_is_encoded_data_]         = $is_encoded_data;"
NSQ_SOURCE_LINE 00002615 "        $self->[_length_function_]         = $length_function;"
NSQ_SOURCE_LINE 00002616 "        $self->[_logger_object_]           = $logger_object;"
NSQ_SOURCE_LINE 00002617 "        $self->[_output_file_]             = $output_file;"
NSQ_SOURCE_LINE 00002618 "        $self->[_teefile_stream_]          = $teefile_stream;"
NSQ_SOURCE_LINE 00002619 "        $self->[_input_copied_verbatim_]   = 0;"
NSQ_SOURCE_LINE 00002620 "        $self->[_input_output_difference_] = 1;    ## updated later if -b used"
NSQ_SOURCE_LINE 00002621 ""
NSQ_SOURCE_LINE 00002622 "        #--------------------"
NSQ_SOURCE_LINE 00002623 "        # process this buffer"
NSQ_SOURCE_LINE 00002624 "        #--------------------"
NSQ_SOURCE_LINE 00002625 "        my $routput_string = $self->process_filter_layer($rinput_string);"
NSQ_SOURCE_LINE 00002626 ""
NSQ_SOURCE_LINE 00002627 "        #------------------------------------------------"
NSQ_SOURCE_LINE 00002628 "        # send the tidied output to its final destination"
NSQ_SOURCE_LINE 00002629 "        #------------------------------------------------"
NSQ_SOURCE_LINE 00002630 "        if ( $rOpts->{'format'} eq 'tidy' && defined($routput_string) ) {"
NSQ_SOURCE_LINE 00002631 ""
NSQ_SOURCE_LINE 00002632 "            $self->write_tidy_output("
NSQ_SOURCE_LINE 00002633 "                {"
NSQ_SOURCE_LINE 00002634 "                    routput_string   => $routput_string,"
NSQ_SOURCE_LINE 00002635 "                    rinput_file_stat => \\@input_file_stat,"
NSQ_SOURCE_LINE 00002636 "                    in_place_modify  => $in_place_modify,"
NSQ_SOURCE_LINE 00002637 "                    input_file       => $input_file,"
NSQ_SOURCE_LINE 00002638 "                    backup_extension => $backup_extension,"
NSQ_SOURCE_LINE 00002639 "                    delete_backup    => $delete_backup,"
NSQ_SOURCE_LINE 00002640 "                }"
NSQ_SOURCE_LINE 00002641 "            );"
NSQ_SOURCE_LINE 00002642 "        }"
NSQ_SOURCE_LINE 00002643 ""
NSQ_SOURCE_LINE 00002644 "        $logger_object->finish()"
NSQ_SOURCE_LINE 00002645 "          if ($logger_object);"
NSQ_SOURCE_LINE 00002646 "    } ## end loop over files"
NSQ_SOURCE_LINE 00002647 ""
NSQ_SOURCE_LINE 00002648 "    return;"
NSQ_SOURCE_LINE 00002649 "} ## end sub process_all_files"
NSQ_SOURCE_LINE 00002650 ""
NSQ_SOURCE_LINE 00002651 "sub write_tidy_output {"
NSQ_SOURCE_LINE 00002652 ""
NSQ_SOURCE_LINE 00002653 "    my ( $self, $rcall_hash ) = @_;"
NSQ_SOURCE_LINE 00002654 ""
NSQ_SOURCE_LINE 00002655 "    # Write tidied output in '$routput_string' to its final destination"
NSQ_SOURCE_LINE 00002656 ""
NSQ_SOURCE_LINE 00002657 "    my $routput_string   = $rcall_hash->{routput_string};"
NSQ_SOURCE_LINE 00002658 "    my $rinput_file_stat = $rcall_hash->{rinput_file_stat};"
NSQ_SOURCE_LINE 00002659 "    my $in_place_modify  = $rcall_hash->{in_place_modify};"
NSQ_SOURCE_LINE 00002660 "    my $input_file       = $rcall_hash->{input_file};"
NSQ_SOURCE_LINE 00002661 "    my $backup_extension = $rcall_hash->{backup_extension};"
NSQ_SOURCE_LINE 00002662 "    my $delete_backup    = $rcall_hash->{delete_backup};"
NSQ_SOURCE_LINE 00002663 ""
NSQ_SOURCE_LINE 00002664 "    my $rOpts           = $self->[_rOpts_];"
NSQ_SOURCE_LINE 00002665 "    my $is_encoded_data = $self->[_is_encoded_data_];"
NSQ_SOURCE_LINE 00002666 "    my $output_file     = $self->[_output_file_];"
NSQ_SOURCE_LINE 00002667 ""
NSQ_SOURCE_LINE 00002668 "    # There are three main output paths:"
NSQ_SOURCE_LINE 00002669 ""
NSQ_SOURCE_LINE 00002670 "    #-------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00002671 "    # PATH 1: $output_file is not defined: --backup and modify in-place option"
NSQ_SOURCE_LINE 00002672 "    #-------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00002673 "    if ($in_place_modify) {"
NSQ_SOURCE_LINE 00002674 ""
NSQ_SOURCE_LINE 00002675 "        # For -b option, leave the file unchanged if a severe error caused"
NSQ_SOURCE_LINE 00002676 "        # formatting to be skipped. Otherwise we will overwrite any backup."
NSQ_SOURCE_LINE 00002677 "        if ( !$self->[_input_copied_verbatim_] ) {"
NSQ_SOURCE_LINE 00002678 ""
NSQ_SOURCE_LINE 00002679 "            my $backup_method = $rOpts->{'backup-method'};"
NSQ_SOURCE_LINE 00002680 ""
NSQ_SOURCE_LINE 00002681 "            #-------------------------------------------------------------"
NSQ_SOURCE_LINE 00002682 "            # PATH 1a: -bm='copy': uses newer version in which original is"
NSQ_SOURCE_LINE 00002683 "            # copied to the backup and rewritten; see git #103."
NSQ_SOURCE_LINE 00002684 "            #-------------------------------------------------------------"
NSQ_SOURCE_LINE 00002685 "            if ( defined($backup_method) && $backup_method eq 'copy' ) {"
NSQ_SOURCE_LINE 00002686 "                $self->backup_method_copy("
NSQ_SOURCE_LINE 00002687 "                    $input_file,       $routput_string,"
NSQ_SOURCE_LINE 00002688 "                    $backup_extension, $delete_backup"
NSQ_SOURCE_LINE 00002689 "                );"
NSQ_SOURCE_LINE 00002690 "            }"
NSQ_SOURCE_LINE 00002691 ""
NSQ_SOURCE_LINE 00002692 "            #-------------------------------------------------------------"
NSQ_SOURCE_LINE 00002693 "            # PATH 1b: -bm='move': uses older version, where original is"
NSQ_SOURCE_LINE 00002694 "            # moved to the backup and formatted output goes to a new file."
NSQ_SOURCE_LINE 00002695 "            #-------------------------------------------------------------"
NSQ_SOURCE_LINE 00002696 "            else {"
NSQ_SOURCE_LINE 00002697 "                $self->backup_method_move("
NSQ_SOURCE_LINE 00002698 "                    $input_file,       $routput_string,"
NSQ_SOURCE_LINE 00002699 "                    $backup_extension, $delete_backup"
NSQ_SOURCE_LINE 00002700 "                );"
NSQ_SOURCE_LINE 00002701 "            }"
NSQ_SOURCE_LINE 00002702 "        }"
NSQ_SOURCE_LINE 00002703 "    }"
NSQ_SOURCE_LINE 00002704 ""
NSQ_SOURCE_LINE 00002705 "    #--------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00002706 "    # PATH 2: $output_file is a reference (=destination_stream): send output to"
NSQ_SOURCE_LINE 00002707 "    # a destination stream ref received from an external perl program. We use"
NSQ_SOURCE_LINE 00002708 "    # a sub to do this because the encoding rules are a bit tricky."
NSQ_SOURCE_LINE 00002709 "    #--------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00002710 "    elsif ( ref($output_file) ) {"
NSQ_SOURCE_LINE 00002711 "        $self->copy_buffer_to_external_ref( $routput_string, $output_file );"
NSQ_SOURCE_LINE 00002712 "    }"
NSQ_SOURCE_LINE 00002713 ""
NSQ_SOURCE_LINE 00002714 "    #--------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00002715 "    # PATH 3: $output_file is named file or '-'; send output to the file system"
NSQ_SOURCE_LINE 00002716 "    #--------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00002717 "    else {"
NSQ_SOURCE_LINE 00002718 ""
NSQ_SOURCE_LINE 00002719 "        #--------------------------"
NSQ_SOURCE_LINE 00002720 "        # PATH 3a: output to STDOUT"
NSQ_SOURCE_LINE 00002721 "        #--------------------------"
NSQ_SOURCE_LINE 00002722 "        if ( $output_file eq '-' ) {"
NSQ_SOURCE_LINE 00002723 "            my $fh = *STDOUT;"
NSQ_SOURCE_LINE 00002724 "            if ($is_encoded_data) { binmode $fh, \":raw:encoding(UTF-8)\" }"
NSQ_SOURCE_LINE 00002725 "            else                  { binmode $fh }"
NSQ_SOURCE_LINE 00002726 "            $fh->print( ${$routput_string} );"
NSQ_SOURCE_LINE 00002727 "        }"
NSQ_SOURCE_LINE 00002728 ""
NSQ_SOURCE_LINE 00002729 "        #--------------------------------"
NSQ_SOURCE_LINE 00002730 "        # PATH 3b: output to a named file"
NSQ_SOURCE_LINE 00002731 "        #--------------------------------"
NSQ_SOURCE_LINE 00002732 "        else {"
NSQ_SOURCE_LINE 00002733 "            if ( open( my $fh, '>', $output_file ) ) {"
NSQ_SOURCE_LINE 00002734 "                if ($is_encoded_data) { binmode $fh, \":raw:encoding(UTF-8)\" }"
NSQ_SOURCE_LINE 00002735 "                else                  { binmode $fh }"
NSQ_SOURCE_LINE 00002736 "                $fh->print( ${$routput_string} );"
NSQ_SOURCE_LINE 00002737 "                $fh->close() or Die(\"Cannot close '$output_file': $OS_ERROR\\n\");"
NSQ_SOURCE_LINE 00002738 "            }"
NSQ_SOURCE_LINE 00002739 "            else {"
NSQ_SOURCE_LINE 00002740 "                Die(\"Cannot open $output_file to write: $OS_ERROR\\n\");"
NSQ_SOURCE_LINE 00002741 "            }"
NSQ_SOURCE_LINE 00002742 ""
NSQ_SOURCE_LINE 00002743 "            # set output file ownership and permissions if appropriate"
NSQ_SOURCE_LINE 00002744 "            if ( $output_file && -f $output_file && !-l $output_file ) {"
NSQ_SOURCE_LINE 00002745 "                if ( @{$rinput_file_stat} ) {"
NSQ_SOURCE_LINE 00002746 "                    $self->set_output_file_permissions( $output_file,"
NSQ_SOURCE_LINE 00002747 "                        \\@{$rinput_file_stat}, $in_place_modify );"
NSQ_SOURCE_LINE 00002748 "                }"
NSQ_SOURCE_LINE 00002749 "            }"
NSQ_SOURCE_LINE 00002750 "        }"
NSQ_SOURCE_LINE 00002751 ""
NSQ_SOURCE_LINE 00002752 "        # Save diagnostic info"
NSQ_SOURCE_LINE 00002753 "        if ($is_encoded_data) {"
NSQ_SOURCE_LINE 00002754 "            $rstatus->{'output_encoded_as'} = 'UTF-8';"
NSQ_SOURCE_LINE 00002755 "        }"
NSQ_SOURCE_LINE 00002756 "    }"
NSQ_SOURCE_LINE 00002757 ""
NSQ_SOURCE_LINE 00002758 "    return;"
NSQ_SOURCE_LINE 00002759 ""
NSQ_SOURCE_LINE 00002760 "} ## end sub write_tidy_output"
NSQ_SOURCE_LINE 00002761 ""
NSQ_SOURCE_LINE 00002762 "sub process_filter_layer {"
NSQ_SOURCE_LINE 00002763 ""
NSQ_SOURCE_LINE 00002764 "    my ( $self, $rinput_string ) = @_;"
NSQ_SOURCE_LINE 00002765 ""
NSQ_SOURCE_LINE 00002766 "    # This is the filter layer of processing."
NSQ_SOURCE_LINE 00002767 "    # Do all requested formatting on the string ref '$rinput_string', including"
NSQ_SOURCE_LINE 00002768 "    # any pre- and post-processing with filters."
NSQ_SOURCE_LINE 00002769 "    # Returns:"
NSQ_SOURCE_LINE 00002770 "    #   $routput_string = ref to tidied output if in 'tidy' mode"
NSQ_SOURCE_LINE 00002771 "    #   (nothing) if not in 'tidy' mode [these modes handle output separately]"
NSQ_SOURCE_LINE 00002772 ""
NSQ_SOURCE_LINE 00002773 "    # Total formatting is done with these layers of subroutines:"
NSQ_SOURCE_LINE 00002774 "    #   perltidy                - main routine; checks run parameters"
NSQ_SOURCE_LINE 00002775 "    #   process_all_files       - main loop to process all files;"
NSQ_SOURCE_LINE 00002776 "    #  *process_filter_layer    - do any pre and post processing; *THIS LAYER"
NSQ_SOURCE_LINE 00002777 "    #   process_iteration_layer - handle any iterations on formatting"
NSQ_SOURCE_LINE 00002778 "    #   process_single_case     - solves one formatting problem"
NSQ_SOURCE_LINE 00002779 ""
NSQ_SOURCE_LINE 00002780 "    # Data Flow in this layer:"
NSQ_SOURCE_LINE 00002781 "    #  $rinput_string"
NSQ_SOURCE_LINE 00002782 "    #   -> optional prefilter operations"
NSQ_SOURCE_LINE 00002783 "    #     -> [ formatting by sub process_iteration_layer ]"
NSQ_SOURCE_LINE 00002784 "    #       -> return if not in 'tidy' mode"
NSQ_SOURCE_LINE 00002785 "    #         -> optional postfilter operations"
NSQ_SOURCE_LINE 00002786 "    #           -> $routput_string"
NSQ_SOURCE_LINE 00002787 ""
NSQ_SOURCE_LINE 00002788 "    # What is done based on format type:"
NSQ_SOURCE_LINE 00002789 "    #  utf8 decoding is done for all format types"
NSQ_SOURCE_LINE 00002790 "    #  prefiltering is applied to all format types"
NSQ_SOURCE_LINE 00002791 "    #   - because it may be needed to get through the tokenizer"
NSQ_SOURCE_LINE 00002792 "    #  postfiltering is only done for format='tidy'"
NSQ_SOURCE_LINE 00002793 "    #   - not appropriate for html text, which has already been output"
NSQ_SOURCE_LINE 00002794 "    #  encoding of decoded output is only done for format='tidy'"
NSQ_SOURCE_LINE 00002795 "    #   - because html does its own encoding; user formatter does what it wants"
NSQ_SOURCE_LINE 00002796 ""
NSQ_SOURCE_LINE 00002797 "    # Be sure the string we received is defined"
NSQ_SOURCE_LINE 00002798 "    if ( !defined($rinput_string) ) {"
NSQ_SOURCE_LINE 00002799 "        Fault(\"bad call: the source string ref \\$rinput_string is undefined\\n\");"
NSQ_SOURCE_LINE 00002800 "    }"
NSQ_SOURCE_LINE 00002801 "    if ( ref($rinput_string) ne 'SCALAR' ) {"
NSQ_SOURCE_LINE 00002802 "        Fault(\"bad call: the source string ref is not SCALAR\\n\");"
NSQ_SOURCE_LINE 00002803 "    }"
NSQ_SOURCE_LINE 00002804 ""
NSQ_SOURCE_LINE 00002805 "    my $rOpts         = $self->[_rOpts_];"
NSQ_SOURCE_LINE 00002806 "    my $logger_object = $self->[_logger_object_];"
NSQ_SOURCE_LINE 00002807 ""
NSQ_SOURCE_LINE 00002808 "    # vars for --line-range-tidy filter, if needed"
NSQ_SOURCE_LINE 00002809 "    my @input_lines_pre;"
NSQ_SOURCE_LINE 00002810 "    my @input_lines_post;"
NSQ_SOURCE_LINE 00002811 ""
NSQ_SOURCE_LINE 00002812 "    # vars for checking assertions, if needed"
NSQ_SOURCE_LINE 00002813 "    my $digest_input;"
NSQ_SOURCE_LINE 00002814 "    my $saved_input_buf;"
NSQ_SOURCE_LINE 00002815 ""
NSQ_SOURCE_LINE 00002816 "    # var for checking --noadd-terminal-newline"
NSQ_SOURCE_LINE 00002817 "    my $chomp_terminal_newline;"
NSQ_SOURCE_LINE 00002818 ""
NSQ_SOURCE_LINE 00002819 "    # Setup post-filter vars; these apply to 'tidy' mode only"
NSQ_SOURCE_LINE 00002820 "    if ( $rOpts->{'format'} eq 'tidy' ) {"
NSQ_SOURCE_LINE 00002821 ""
NSQ_SOURCE_LINE 00002822 "        #---------------------------------------------------------------------"
NSQ_SOURCE_LINE 00002823 "        # for --line-range-tidy, clip '$rinput_string' to a limited line range"
NSQ_SOURCE_LINE 00002824 "        #---------------------------------------------------------------------"
NSQ_SOURCE_LINE 00002825 "        my $line_tidy_begin = $self->[_line_tidy_begin_];"
NSQ_SOURCE_LINE 00002826 "        if ($line_tidy_begin) {"
NSQ_SOURCE_LINE 00002827 ""
NSQ_SOURCE_LINE 00002828 "            my @input_lines = split /^/, ${$rinput_string};"
NSQ_SOURCE_LINE 00002829 ""
NSQ_SOURCE_LINE 00002830 "            my $num = @input_lines;"
NSQ_SOURCE_LINE 00002831 "            if ( $line_tidy_begin > $num ) {"
NSQ_SOURCE_LINE 00002832 "                Die(<<EOM);"
NSQ_SOURCE_LINE 00002833 "#--line-range-tidy=n1:n2 has n1=$line_tidy_begin which exceeds max line number of $num"
NSQ_SOURCE_LINE 00002834 "EOM"
NSQ_SOURCE_LINE 00002835 "            }"
NSQ_SOURCE_LINE 00002836 "            else {"
NSQ_SOURCE_LINE 00002837 "                my $line_tidy_end = $self->[_line_tidy_end_];"
NSQ_SOURCE_LINE 00002838 "                if ( !defined($line_tidy_end) || $line_tidy_end > $num ) {"
NSQ_SOURCE_LINE 00002839 "                    $line_tidy_end = $num;"
NSQ_SOURCE_LINE 00002840 "                }"
NSQ_SOURCE_LINE 00002841 "                my $input_string = join EMPTY_STRING,"
NSQ_SOURCE_LINE 00002842 "                  @input_lines[ $line_tidy_begin - 1 .. $line_tidy_end - 1 ];"
NSQ_SOURCE_LINE 00002843 "                $rinput_string = \\$input_string;"
NSQ_SOURCE_LINE 00002844 ""
NSQ_SOURCE_LINE 00002845 "                @input_lines_pre  = @input_lines[ 0 .. $line_tidy_begin - 2 ];"
NSQ_SOURCE_LINE 00002846 "                @input_lines_post = @input_lines[ $line_tidy_end .. $num - 1 ];"
NSQ_SOURCE_LINE 00002847 "            }"
NSQ_SOURCE_LINE 00002848 "        }"
NSQ_SOURCE_LINE 00002849 ""
NSQ_SOURCE_LINE 00002850 "        #------------------------------------------"
NSQ_SOURCE_LINE 00002851 "        # evaluate MD5 sum of input file, if needed"
NSQ_SOURCE_LINE 00002852 "        #------------------------------------------"
NSQ_SOURCE_LINE 00002853 "        if (   $rOpts->{'assert-tidy'}"
NSQ_SOURCE_LINE 00002854 "            || $rOpts->{'assert-untidy'}"
NSQ_SOURCE_LINE 00002855 "            || $rOpts->{'backup-and-modify-in-place'} )"
NSQ_SOURCE_LINE 00002856 "        {"
NSQ_SOURCE_LINE 00002857 "            $digest_input    = $md5_hex->( ${$rinput_string} );"
NSQ_SOURCE_LINE 00002858 "            $saved_input_buf = ${$rinput_string};"
NSQ_SOURCE_LINE 00002859 "        }"
NSQ_SOURCE_LINE 00002860 ""
NSQ_SOURCE_LINE 00002861 "        # When -noadd-terminal-newline is set, and the input does not"
NSQ_SOURCE_LINE 00002862 "        # have a newline, then we remove the final newline of the output"
NSQ_SOURCE_LINE 00002863 "        $chomp_terminal_newline = !$rOpts->{'add-terminal-newline'}"
NSQ_SOURCE_LINE 00002864 "          && substr( ${$rinput_string}, -1, 1 ) !~ /\\n/;"
NSQ_SOURCE_LINE 00002865 ""
NSQ_SOURCE_LINE 00002866 "    }"
NSQ_SOURCE_LINE 00002867 ""
NSQ_SOURCE_LINE 00002868 "    #-----------------------------------------------------------------------"
NSQ_SOURCE_LINE 00002869 "    # Apply any prefilter. The prefilter is a code reference that will be"
NSQ_SOURCE_LINE 00002870 "    # applied to the source before tokenizing.  Note that we are doing this"
NSQ_SOURCE_LINE 00002871 "    # for all format types ('tidy', 'html', 'user') because it may be needed"
NSQ_SOURCE_LINE 00002872 "    # to avoid tokenization errors."
NSQ_SOURCE_LINE 00002873 "    #-----------------------------------------------------------------------"
NSQ_SOURCE_LINE 00002874 "    my $prefilter = $self->[_prefilter_];"
NSQ_SOURCE_LINE 00002875 "    if ($prefilter) {"
NSQ_SOURCE_LINE 00002876 "        my $input_string = $prefilter->( ${$rinput_string} );"
NSQ_SOURCE_LINE 00002877 "        $rinput_string = \\$input_string;"
NSQ_SOURCE_LINE 00002878 "    }"
NSQ_SOURCE_LINE 00002879 ""
NSQ_SOURCE_LINE 00002880 "    #-------------------------------------------"
NSQ_SOURCE_LINE 00002881 "    # Format contents of string '$rinput_string'"
NSQ_SOURCE_LINE 00002882 "    #-------------------------------------------"
NSQ_SOURCE_LINE 00002883 "    my $routput_string = $self->process_iteration_layer($rinput_string);"
NSQ_SOURCE_LINE 00002884 ""
NSQ_SOURCE_LINE 00002885 "    #-------------------------------"
NSQ_SOURCE_LINE 00002886 "    # All done if not in 'tidy' mode"
NSQ_SOURCE_LINE 00002887 "    #-------------------------------"
NSQ_SOURCE_LINE 00002888 "    if ( $rOpts->{'format'} ne 'tidy' ) {"
NSQ_SOURCE_LINE 00002889 "        return;"
NSQ_SOURCE_LINE 00002890 "    }"
NSQ_SOURCE_LINE 00002891 ""
NSQ_SOURCE_LINE 00002892 "    #---------------------"
NSQ_SOURCE_LINE 00002893 "    # apply any postfilter"
NSQ_SOURCE_LINE 00002894 "    #---------------------"
NSQ_SOURCE_LINE 00002895 "    my $postfilter = $self->[_postfilter_];"
NSQ_SOURCE_LINE 00002896 "    if ($postfilter) {"
NSQ_SOURCE_LINE 00002897 "        my $output_string = $postfilter->( ${$routput_string} );"
NSQ_SOURCE_LINE 00002898 "        $routput_string = \\$output_string;"
NSQ_SOURCE_LINE 00002899 "    }"
NSQ_SOURCE_LINE 00002900 ""
NSQ_SOURCE_LINE 00002901 "    if ( defined($digest_input) ) {"
NSQ_SOURCE_LINE 00002902 "        my $digest_output = $md5_hex->( ${$routput_string} );"
NSQ_SOURCE_LINE 00002903 "        $self->[_input_output_difference_] = $digest_output ne $digest_input;"
NSQ_SOURCE_LINE 00002904 "    }"
NSQ_SOURCE_LINE 00002905 ""
NSQ_SOURCE_LINE 00002906 "    #-----------------------------------------------------"
NSQ_SOURCE_LINE 00002907 "    # check for changes if requested by 'assert-...' flags"
NSQ_SOURCE_LINE 00002908 "    #-----------------------------------------------------"
NSQ_SOURCE_LINE 00002909 "    if ( $rOpts->{'assert-tidy'} ) {"
NSQ_SOURCE_LINE 00002910 "        if ( $self->[_input_output_difference_] ) {"
NSQ_SOURCE_LINE 00002911 "            my $diff_msg ="
NSQ_SOURCE_LINE 00002912 "              compare_string_buffers( \\$saved_input_buf, $routput_string );"
NSQ_SOURCE_LINE 00002913 "            $logger_object->warning(<<EOM);"
NSQ_SOURCE_LINE 00002914 "assertion failure: '--assert-tidy' is set but output differs from input"
NSQ_SOURCE_LINE 00002915 "EOM"
NSQ_SOURCE_LINE 00002916 "            $logger_object->interrupt_logfile();"
NSQ_SOURCE_LINE 00002917 "            $logger_object->warning( $diff_msg . \"\\n\" );"
NSQ_SOURCE_LINE 00002918 "            $logger_object->resume_logfile();"
NSQ_SOURCE_LINE 00002919 "        }"
NSQ_SOURCE_LINE 00002920 "    }"
NSQ_SOURCE_LINE 00002921 ""
NSQ_SOURCE_LINE 00002922 "    if ( $rOpts->{'assert-untidy'} ) {"
NSQ_SOURCE_LINE 00002923 "        if ( !$self->[_input_output_difference_] ) {"
NSQ_SOURCE_LINE 00002924 "            $logger_object->warning("
NSQ_SOURCE_LINE 00002925 "\"assertion failure: '--assert-untidy' is set but output equals input\\n\""
NSQ_SOURCE_LINE 00002926 "            );"
NSQ_SOURCE_LINE 00002927 "        }"
NSQ_SOURCE_LINE 00002928 "    }"
NSQ_SOURCE_LINE 00002929 ""
NSQ_SOURCE_LINE 00002930 "    #----------------------------------------"
NSQ_SOURCE_LINE 00002931 "    # do --line-range-tidy line recombination"
NSQ_SOURCE_LINE 00002932 "    #----------------------------------------"
NSQ_SOURCE_LINE 00002933 "    if ( @input_lines_pre || @input_lines_post ) {"
NSQ_SOURCE_LINE 00002934 "        my $str_pre       = join EMPTY_STRING, @input_lines_pre;"
NSQ_SOURCE_LINE 00002935 "        my $str_post      = join EMPTY_STRING, @input_lines_post;"
NSQ_SOURCE_LINE 00002936 "        my $output_string = $str_pre . ${$routput_string} . $str_post;"
NSQ_SOURCE_LINE 00002937 "        $routput_string = \\$output_string;"
NSQ_SOURCE_LINE 00002938 "    }"
NSQ_SOURCE_LINE 00002939 ""
NSQ_SOURCE_LINE 00002940 "    #-----------------------------------------"
NSQ_SOURCE_LINE 00002941 "    # handle a '--noadd-terminal-newline' flag"
NSQ_SOURCE_LINE 00002942 "    #-----------------------------------------"
NSQ_SOURCE_LINE 00002943 "    if ($chomp_terminal_newline) {"
NSQ_SOURCE_LINE 00002944 "        chomp ${$routput_string};"
NSQ_SOURCE_LINE 00002945 "    }"
NSQ_SOURCE_LINE 00002946 ""
NSQ_SOURCE_LINE 00002947 "    #-------------------------------------------------------------"
NSQ_SOURCE_LINE 00002948 "    # handle --preserve-line-endings or -output-line-ending flags"
NSQ_SOURCE_LINE 00002949 "    #-------------------------------------------------------------"
NSQ_SOURCE_LINE 00002950 "    # The native line separator has been used in all intermediate"
NSQ_SOURCE_LINE 00002951 "    # iterations and filter operations until here so that string"
NSQ_SOURCE_LINE 00002952 "    # operations work ok."
NSQ_SOURCE_LINE 00002953 "    if ( $self->[_line_separator_] ne \"\\n\" ) {"
NSQ_SOURCE_LINE 00002954 "        my $line_separator = $self->[_line_separator_];"
NSQ_SOURCE_LINE 00002955 "        my @output_lines   = split /^/, ${$routput_string};"
NSQ_SOURCE_LINE 00002956 "        foreach my $line (@output_lines) {"
NSQ_SOURCE_LINE 00002957 ""
NSQ_SOURCE_LINE 00002958 "            # must check chomp because last line might not have a newline"
NSQ_SOURCE_LINE 00002959 "            # if --noadd-terminal-newline is also set (c283)"
NSQ_SOURCE_LINE 00002960 "            if ( chomp $line ) {"
NSQ_SOURCE_LINE 00002961 "                $line .= $line_separator;"
NSQ_SOURCE_LINE 00002962 "            }"
NSQ_SOURCE_LINE 00002963 "        }"
NSQ_SOURCE_LINE 00002964 "        my $output_string = join EMPTY_STRING, @output_lines;"
NSQ_SOURCE_LINE 00002965 "        $routput_string = \\$output_string;"
NSQ_SOURCE_LINE 00002966 "    }"
NSQ_SOURCE_LINE 00002967 ""
NSQ_SOURCE_LINE 00002968 "    return $routput_string;"
NSQ_SOURCE_LINE 00002969 "} ## end sub process_filter_layer"
NSQ_SOURCE_LINE 00002970 ""
NSQ_SOURCE_LINE 00002971 "# For safety, set an upper bound on number of iterations before stopping."
NSQ_SOURCE_LINE 00002972 "# The average number of iterations is 2. No known cases exceed 5."
NSQ_SOURCE_LINE 00002973 "use constant ITERATION_LIMIT => 6;"
NSQ_SOURCE_LINE 00002974 ""
NSQ_SOURCE_LINE 00002975 "sub process_iteration_layer {"
NSQ_SOURCE_LINE 00002976 ""
NSQ_SOURCE_LINE 00002977 "    my ( $self, $rinput_string ) = @_;"
NSQ_SOURCE_LINE 00002978 ""
NSQ_SOURCE_LINE 00002979 "    # This is the iteration layer of processing."
NSQ_SOURCE_LINE 00002980 "    # Do all formatting, iterating if requested, on the source $rinput_string"
NSQ_SOURCE_LINE 00002981 "    # Output depends on format type:"
NSQ_SOURCE_LINE 00002982 "    #   For 'tidy' formatting, output goes to sink object"
NSQ_SOURCE_LINE 00002983 "    #   For 'html' formatting, output goes to the ultimate destination"
NSQ_SOURCE_LINE 00002984 "    #   For 'user' formatting, user formatter handles output"
NSQ_SOURCE_LINE 00002985 ""
NSQ_SOURCE_LINE 00002986 "    # Total formatting is done with these layers of subroutines:"
NSQ_SOURCE_LINE 00002987 "    #   perltidy                - main routine; checks run parameters"
NSQ_SOURCE_LINE 00002988 "    #   process_all_files       - main loop to process all files;"
NSQ_SOURCE_LINE 00002989 "    #   process_filter_layer    - do any pre and post processing"
NSQ_SOURCE_LINE 00002990 "    #  *process_iteration_layer - do any iterations on formatting; *THIS LAYER"
NSQ_SOURCE_LINE 00002991 "    #   process_single_case     - solves one formatting problem"
NSQ_SOURCE_LINE 00002992 ""
NSQ_SOURCE_LINE 00002993 "    # Data Flow in this layer:"
NSQ_SOURCE_LINE 00002994 "    #      $rinput_string -> [ loop over iterations ] -> $routput_string"
NSQ_SOURCE_LINE 00002995 ""
NSQ_SOURCE_LINE 00002996 "    my $diagnostics_object = $self->[_diagnostics_object_];"
NSQ_SOURCE_LINE 00002997 "    my $display_name       = $self->[_display_name_];"
NSQ_SOURCE_LINE 00002998 "    my $fileroot           = $self->[_fileroot_];"
NSQ_SOURCE_LINE 00002999 "    my $is_encoded_data    = $self->[_is_encoded_data_];"
NSQ_SOURCE_LINE 00003000 "    my $is_pure_ascii_data = $self->[_is_pure_ascii_data_];"
NSQ_SOURCE_LINE 00003001 "    my $length_function    = $self->[_length_function_];"
NSQ_SOURCE_LINE 00003002 "    my $logger_object      = $self->[_logger_object_];"
NSQ_SOURCE_LINE 00003003 "    my $rOpts              = $self->[_rOpts_];"
NSQ_SOURCE_LINE 00003004 "    my $user_formatter     = $self->[_user_formatter_];"
NSQ_SOURCE_LINE 00003005 ""
NSQ_SOURCE_LINE 00003006 "    # make a debugger object if requested"
NSQ_SOURCE_LINE 00003007 "    my $debugger_object;"
NSQ_SOURCE_LINE 00003008 "    if ( $rOpts->{DEBUG} ) {"
NSQ_SOURCE_LINE 00003009 "        my $debug_file = $self->[_debugfile_stream_]"
NSQ_SOURCE_LINE 00003010 "          || $fileroot . $self->make_file_extension('DEBUG');"
NSQ_SOURCE_LINE 00003011 "        $debugger_object ="
NSQ_SOURCE_LINE 00003012 "          Perl::Tidy::Debugger->new( $debug_file, $is_encoded_data );"
NSQ_SOURCE_LINE 00003013 "    }"
NSQ_SOURCE_LINE 00003014 ""
NSQ_SOURCE_LINE 00003015 "    # make a tee file handle if requested"
NSQ_SOURCE_LINE 00003016 "    my $fh_tee;"
NSQ_SOURCE_LINE 00003017 "    my $tee_file;"
NSQ_SOURCE_LINE 00003018 "    if (   $rOpts->{'tee-pod'}"
NSQ_SOURCE_LINE 00003019 "        || $rOpts->{'tee-block-comments'}"
NSQ_SOURCE_LINE 00003020 "        || $rOpts->{'tee-side-comments'} )"
NSQ_SOURCE_LINE 00003021 "    {"
NSQ_SOURCE_LINE 00003022 "        $tee_file = $self->[_teefile_stream_]"
NSQ_SOURCE_LINE 00003023 "          || $fileroot . $self->make_file_extension('TEE');"
NSQ_SOURCE_LINE 00003024 "        $fh_tee = Perl::Tidy::streamhandle( $tee_file, 'w', $is_encoded_data );"
NSQ_SOURCE_LINE 00003025 "        if ( !$fh_tee ) {"
NSQ_SOURCE_LINE 00003026 "            Warn(\"couldn't open TEE file $tee_file: $OS_ERROR\\n\");"
NSQ_SOURCE_LINE 00003027 "        }"
NSQ_SOURCE_LINE 00003028 "    }"
NSQ_SOURCE_LINE 00003029 ""
NSQ_SOURCE_LINE 00003030 "    # vars for iterations and convergence test"
NSQ_SOURCE_LINE 00003031 "    my $max_iterations = 1;"
NSQ_SOURCE_LINE 00003032 "    my $convergence_log_message;"
NSQ_SOURCE_LINE 00003033 "    my %saw_md5;"
NSQ_SOURCE_LINE 00003034 ""
NSQ_SOURCE_LINE 00003035 "    # Only 'tidy' formatting can use multiple iterations"
NSQ_SOURCE_LINE 00003036 "    if ( $rOpts->{'format'} eq 'tidy' ) {"
NSQ_SOURCE_LINE 00003037 ""
NSQ_SOURCE_LINE 00003038 "        # check iteration count and quietly fix if necessary:"
NSQ_SOURCE_LINE 00003039 "        # - iterations option only applies to code beautification mode"
NSQ_SOURCE_LINE 00003040 "        # - the convergence check should stop most runs on iteration 2, and"
NSQ_SOURCE_LINE 00003041 "        #   virtually all on iteration 3.  We allow up to ITERATION_LIMIT."
NSQ_SOURCE_LINE 00003042 "        $max_iterations = $rOpts->{'iterations'};"
NSQ_SOURCE_LINE 00003043 "        if ( !defined($max_iterations)"
NSQ_SOURCE_LINE 00003044 "            || $max_iterations <= 0 )"
NSQ_SOURCE_LINE 00003045 "        {"
NSQ_SOURCE_LINE 00003046 "            $max_iterations = 1;"
NSQ_SOURCE_LINE 00003047 "        }"
NSQ_SOURCE_LINE 00003048 ""
NSQ_SOURCE_LINE 00003049 "        if ( $max_iterations > ITERATION_LIMIT ) {"
NSQ_SOURCE_LINE 00003050 "            $max_iterations = ITERATION_LIMIT;"
NSQ_SOURCE_LINE 00003051 "        }"
NSQ_SOURCE_LINE 00003052 ""
NSQ_SOURCE_LINE 00003053 "        # get starting MD5 sum for convergence test"
NSQ_SOURCE_LINE 00003054 "        if ( $max_iterations > 1 ) {"
NSQ_SOURCE_LINE 00003055 "            my $digest = $md5_hex->( ${$rinput_string} );"
NSQ_SOURCE_LINE 00003056 "            $saw_md5{$digest} = 0;"
NSQ_SOURCE_LINE 00003057 "        }"
NSQ_SOURCE_LINE 00003058 "    }"
NSQ_SOURCE_LINE 00003059 ""
NSQ_SOURCE_LINE 00003060 "    # save objects to allow redirecting output during iterations"
NSQ_SOURCE_LINE 00003061 "    my $logger_object_final = $logger_object;"
NSQ_SOURCE_LINE 00003062 "    my $iteration_of_formatter_convergence;"
NSQ_SOURCE_LINE 00003063 "    my $routput_string;"
NSQ_SOURCE_LINE 00003064 ""
NSQ_SOURCE_LINE 00003065 "    #---------------------"
NSQ_SOURCE_LINE 00003066 "    # Loop over iterations"
NSQ_SOURCE_LINE 00003067 "    #---------------------"
NSQ_SOURCE_LINE 00003068 "    foreach my $iter ( 1 .. $max_iterations ) {"
NSQ_SOURCE_LINE 00003069 ""
NSQ_SOURCE_LINE 00003070 "        $rstatus->{'iteration_count'} += 1;"
NSQ_SOURCE_LINE 00003071 ""
NSQ_SOURCE_LINE 00003072 "        # create a string to capture the output"
NSQ_SOURCE_LINE 00003073 "        my $sink_buffer = EMPTY_STRING;"
NSQ_SOURCE_LINE 00003074 "        $routput_string = \\$sink_buffer;"
NSQ_SOURCE_LINE 00003075 ""
NSQ_SOURCE_LINE 00003076 "        # Save logger, debugger and tee output only on pass 1 because:"
NSQ_SOURCE_LINE 00003077 "        # (1) line number references must be to the starting"
NSQ_SOURCE_LINE 00003078 "        # source, not an intermediate result, and"
NSQ_SOURCE_LINE 00003079 "        # (2) we need to know if there are errors so we can stop the"
NSQ_SOURCE_LINE 00003080 "        # iterations early if necessary."
NSQ_SOURCE_LINE 00003081 "        # (3) the tee option only works on first pass if comments are also"
NSQ_SOURCE_LINE 00003082 "        # being deleted."
NSQ_SOURCE_LINE 00003083 "        if ( $iter > 1 ) {"
NSQ_SOURCE_LINE 00003084 ""
NSQ_SOURCE_LINE 00003085 "            $debugger_object->close_debug_file()"
NSQ_SOURCE_LINE 00003086 "              if ($debugger_object);"
NSQ_SOURCE_LINE 00003087 ""
NSQ_SOURCE_LINE 00003088 "            if (   $fh_tee"
NSQ_SOURCE_LINE 00003089 "                && $fh_tee->can('close')"
NSQ_SOURCE_LINE 00003090 "                && !ref($tee_file)"
NSQ_SOURCE_LINE 00003091 "                && $tee_file ne '-' )"
NSQ_SOURCE_LINE 00003092 "            {"
NSQ_SOURCE_LINE 00003093 "                $fh_tee->close()"
NSQ_SOURCE_LINE 00003094 "                  or Warn(\"couldn't close TEE file $tee_file: $OS_ERROR\\n\");"
NSQ_SOURCE_LINE 00003095 "            }"
NSQ_SOURCE_LINE 00003096 ""
NSQ_SOURCE_LINE 00003097 "            $debugger_object = undef;"
NSQ_SOURCE_LINE 00003098 "            $logger_object   = undef;"
NSQ_SOURCE_LINE 00003099 "            $fh_tee          = undef;"
NSQ_SOURCE_LINE 00003100 "        }"
NSQ_SOURCE_LINE 00003101 ""
NSQ_SOURCE_LINE 00003102 "        #---------------------------------"
NSQ_SOURCE_LINE 00003103 "        # create a formatter for this file"
NSQ_SOURCE_LINE 00003104 "        #---------------------------------"
NSQ_SOURCE_LINE 00003105 ""
NSQ_SOURCE_LINE 00003106 "        my $formatter;"
NSQ_SOURCE_LINE 00003107 ""
NSQ_SOURCE_LINE 00003108 "        if ($user_formatter) {"
NSQ_SOURCE_LINE 00003109 "            $formatter = $user_formatter;"
NSQ_SOURCE_LINE 00003110 "        }"
NSQ_SOURCE_LINE 00003111 "        elsif ( $rOpts->{'format'} eq 'html' ) {"
NSQ_SOURCE_LINE 00003112 ""
NSQ_SOURCE_LINE 00003113 "            my $html_toc_extension ="
NSQ_SOURCE_LINE 00003114 "              $self->make_file_extension( $rOpts->{'html-toc-extension'},"
NSQ_SOURCE_LINE 00003115 "                'toc' );"
NSQ_SOURCE_LINE 00003116 ""
NSQ_SOURCE_LINE 00003117 "            my $html_src_extension ="
NSQ_SOURCE_LINE 00003118 "              $self->make_file_extension( $rOpts->{'html-src-extension'},"
NSQ_SOURCE_LINE 00003119 "                'src' );"
NSQ_SOURCE_LINE 00003120 ""
NSQ_SOURCE_LINE 00003121 "            $formatter = Perl::Tidy::HtmlWriter->new("
NSQ_SOURCE_LINE 00003122 "                input_file         => $fileroot,"
NSQ_SOURCE_LINE 00003123 "                html_file          => $self->[_output_file_],"
NSQ_SOURCE_LINE 00003124 "                extension          => $self->[_actual_output_extension_],"
NSQ_SOURCE_LINE 00003125 "                html_toc_extension => $html_toc_extension,"
NSQ_SOURCE_LINE 00003126 "                html_src_extension => $html_src_extension,"
NSQ_SOURCE_LINE 00003127 "                is_encoded_data    => $is_encoded_data,"
NSQ_SOURCE_LINE 00003128 "                is_pure_ascii_data => $is_pure_ascii_data,"
NSQ_SOURCE_LINE 00003129 "                logger_object      => $logger_object,"
NSQ_SOURCE_LINE 00003130 "            );"
NSQ_SOURCE_LINE 00003131 "        }"
NSQ_SOURCE_LINE 00003132 "        elsif ( $rOpts->{'format'} eq 'tidy' ) {"
NSQ_SOURCE_LINE 00003133 "            $formatter = Perl::Tidy::Formatter->new("
NSQ_SOURCE_LINE 00003134 "                logger_object      => $logger_object,"
NSQ_SOURCE_LINE 00003135 "                diagnostics_object => $diagnostics_object,"
NSQ_SOURCE_LINE 00003136 "                sink_object        => $routput_string,"
NSQ_SOURCE_LINE 00003137 "                length_function    => $length_function,"
NSQ_SOURCE_LINE 00003138 "                is_encoded_data    => $is_encoded_data,"
NSQ_SOURCE_LINE 00003139 "                fh_tee             => $fh_tee,"
NSQ_SOURCE_LINE 00003140 "                display_name       => $display_name,"
NSQ_SOURCE_LINE 00003141 "            );"
NSQ_SOURCE_LINE 00003142 "        }"
NSQ_SOURCE_LINE 00003143 "        else {"
NSQ_SOURCE_LINE 00003144 "            Die(\"I don't know how to do -format=$rOpts->{'format'}\\n\");"
NSQ_SOURCE_LINE 00003145 "        }"
NSQ_SOURCE_LINE 00003146 ""
NSQ_SOURCE_LINE 00003147 "        if ( !$formatter ) {"
NSQ_SOURCE_LINE 00003148 "            Die(\"Unable to continue with $rOpts->{'format'} formatting\\n\");"
NSQ_SOURCE_LINE 00003149 "        }"
NSQ_SOURCE_LINE 00003150 ""
NSQ_SOURCE_LINE 00003151 "        #-----------------------------------"
NSQ_SOURCE_LINE 00003152 "        # create the tokenizer for this file"
NSQ_SOURCE_LINE 00003153 "        #-----------------------------------"
NSQ_SOURCE_LINE 00003154 "        my $tokenizer = Perl::Tidy::Tokenizer->new("
NSQ_SOURCE_LINE 00003155 "            source_object      => $rinput_string,"
NSQ_SOURCE_LINE 00003156 "            logger_object      => $logger_object,"
NSQ_SOURCE_LINE 00003157 "            debugger_object    => $debugger_object,"
NSQ_SOURCE_LINE 00003158 "            diagnostics_object => $diagnostics_object,"
NSQ_SOURCE_LINE 00003159 "            rOpts              => $rOpts,"
NSQ_SOURCE_LINE 00003160 "            starting_level     => $rOpts->{'starting-indentation-level'},"
NSQ_SOURCE_LINE 00003161 "        );"
NSQ_SOURCE_LINE 00003162 ""
NSQ_SOURCE_LINE 00003163 "        #---------------------------------"
NSQ_SOURCE_LINE 00003164 "        # do processing for this iteration"
NSQ_SOURCE_LINE 00003165 "        #---------------------------------"
NSQ_SOURCE_LINE 00003166 "        $self->process_single_case( $tokenizer, $formatter );"
NSQ_SOURCE_LINE 00003167 ""
NSQ_SOURCE_LINE 00003168 "        #--------------"
NSQ_SOURCE_LINE 00003169 "        # report errors"
NSQ_SOURCE_LINE 00003170 "        #--------------"
NSQ_SOURCE_LINE 00003171 ""
NSQ_SOURCE_LINE 00003172 "        # see if the formatter is converged"
NSQ_SOURCE_LINE 00003173 "        if (   $max_iterations > 1"
NSQ_SOURCE_LINE 00003174 "            && !defined($iteration_of_formatter_convergence)"
NSQ_SOURCE_LINE 00003175 "            && $formatter->can('get_convergence_check') )"
NSQ_SOURCE_LINE 00003176 "        {"
NSQ_SOURCE_LINE 00003177 "            if ( $formatter->get_convergence_check() ) {"
NSQ_SOURCE_LINE 00003178 "                $iteration_of_formatter_convergence = $iter;"
NSQ_SOURCE_LINE 00003179 "                $rstatus->{'converged'} = 1;"
NSQ_SOURCE_LINE 00003180 "            }"
NSQ_SOURCE_LINE 00003181 "        }"
NSQ_SOURCE_LINE 00003182 ""
NSQ_SOURCE_LINE 00003183 "        # line source for next iteration (if any) comes from the current"
NSQ_SOURCE_LINE 00003184 "        # temporary output buffer"
NSQ_SOURCE_LINE 00003185 "        if ( $iter < $max_iterations ) {"
NSQ_SOURCE_LINE 00003186 ""
NSQ_SOURCE_LINE 00003187 "            $rinput_string = \\$sink_buffer;"
NSQ_SOURCE_LINE 00003188 ""
NSQ_SOURCE_LINE 00003189 "            # stop iterations if errors or converged"
NSQ_SOURCE_LINE 00003190 "            my $stop_now = $self->[_input_copied_verbatim_];"
NSQ_SOURCE_LINE 00003191 "            $stop_now ||= $tokenizer->get_unexpected_error_count();"
NSQ_SOURCE_LINE 00003192 "            my $stopping_on_error = $stop_now;"
NSQ_SOURCE_LINE 00003193 "            if ($stop_now) {"
NSQ_SOURCE_LINE 00003194 "                $convergence_log_message = <<EOM;"
NSQ_SOURCE_LINE 00003195 "Stopping iterations because of severe errors."
NSQ_SOURCE_LINE 00003196 "EOM"
NSQ_SOURCE_LINE 00003197 "            }"
NSQ_SOURCE_LINE 00003198 ""
NSQ_SOURCE_LINE 00003199 "            # or do convergence test"
NSQ_SOURCE_LINE 00003200 "            else {"
NSQ_SOURCE_LINE 00003201 ""
NSQ_SOURCE_LINE 00003202 "                # stop if the formatter has converged"
NSQ_SOURCE_LINE 00003203 "                $stop_now ||= defined($iteration_of_formatter_convergence);"
NSQ_SOURCE_LINE 00003204 ""
NSQ_SOURCE_LINE 00003205 "                my $digest = $md5_hex->($sink_buffer);"
NSQ_SOURCE_LINE 00003206 "                if ( !defined( $saw_md5{$digest} ) ) {"
NSQ_SOURCE_LINE 00003207 "                    $saw_md5{$digest} = $iter;"
NSQ_SOURCE_LINE 00003208 "                }"
NSQ_SOURCE_LINE 00003209 ""
NSQ_SOURCE_LINE 00003210 "                # do a second iteration if all ok and requested by formatter"
NSQ_SOURCE_LINE 00003211 "                # to allow delayed adding/deleting of commas (git156, git143)"
NSQ_SOURCE_LINE 00003212 "                elsif ( $iter == 1"
NSQ_SOURCE_LINE 00003213 "                    && !$stop_now"
NSQ_SOURCE_LINE 00003214 "                    && $formatter->can('want_second_iteration')"
NSQ_SOURCE_LINE 00003215 "                    && $formatter->want_second_iteration() )"
NSQ_SOURCE_LINE 00003216 "                {"
NSQ_SOURCE_LINE 00003217 "                    ## deja vu, but do not set $stop_now"
NSQ_SOURCE_LINE 00003218 "                    $saw_md5{$digest} = $iter;"
NSQ_SOURCE_LINE 00003219 "                }"
NSQ_SOURCE_LINE 00003220 "                else {"
NSQ_SOURCE_LINE 00003221 ""
NSQ_SOURCE_LINE 00003222 "                    # Deja vu, stop iterating"
NSQ_SOURCE_LINE 00003223 ""
NSQ_SOURCE_LINE 00003224 "                    $stop_now = 1;"
NSQ_SOURCE_LINE 00003225 "                    my $iterm = $iter - 1;"
NSQ_SOURCE_LINE 00003226 "                    if ( $saw_md5{$digest} != $iterm ) {"
NSQ_SOURCE_LINE 00003227 ""
NSQ_SOURCE_LINE 00003228 "                        # Blinking (oscillating) between two or more stable"
NSQ_SOURCE_LINE 00003229 "                        # end states.  This is unlikely to occur with normal"
NSQ_SOURCE_LINE 00003230 "                        # parameters, but it can occur in stress testing"
NSQ_SOURCE_LINE 00003231 "                        # with extreme parameter values, such as very short"
NSQ_SOURCE_LINE 00003232 "                        # maximum line lengths.  We want to catch and fix"
NSQ_SOURCE_LINE 00003233 "                        # them when they happen."
NSQ_SOURCE_LINE 00003234 "                        $rstatus->{'blinking'} = 1;"
NSQ_SOURCE_LINE 00003235 "                        $convergence_log_message = <<EOM;"
NSQ_SOURCE_LINE 00003236 "BLINKER. Output for iteration $iter same as for $saw_md5{$digest}."
NSQ_SOURCE_LINE 00003237 "EOM"
NSQ_SOURCE_LINE 00003238 "                        $stopping_on_error ||= $convergence_log_message;"
NSQ_SOURCE_LINE 00003239 "                        DEVEL_MODE"
NSQ_SOURCE_LINE 00003240 "                          && print {*STDERR} $convergence_log_message;"
NSQ_SOURCE_LINE 00003241 "                        $diagnostics_object->write_diagnostics("
NSQ_SOURCE_LINE 00003242 "                            $convergence_log_message)"
NSQ_SOURCE_LINE 00003243 "                          if ($diagnostics_object);"
NSQ_SOURCE_LINE 00003244 ""
NSQ_SOURCE_LINE 00003245 "# Uncomment to search for blinking states:"
NSQ_SOURCE_LINE 00003246 "# Warn( \"$display_name: blinking; iter $iter same as for $saw_md5{$digest}\\n\" );"
NSQ_SOURCE_LINE 00003247 ""
NSQ_SOURCE_LINE 00003248 "                    }"
NSQ_SOURCE_LINE 00003249 "                    else {"
NSQ_SOURCE_LINE 00003250 "                        $convergence_log_message = <<EOM;"
NSQ_SOURCE_LINE 00003251 "Converged.  Output for iteration $iter same as for iter $iterm."
NSQ_SOURCE_LINE 00003252 "EOM"
NSQ_SOURCE_LINE 00003253 "                        $diagnostics_object->write_diagnostics("
NSQ_SOURCE_LINE 00003254 "                            $convergence_log_message)"
NSQ_SOURCE_LINE 00003255 "                          if ( $diagnostics_object && $iterm > 2 );"
NSQ_SOURCE_LINE 00003256 "                        $rstatus->{'converged'} = 1;"
NSQ_SOURCE_LINE 00003257 "                    }"
NSQ_SOURCE_LINE 00003258 "                }"
NSQ_SOURCE_LINE 00003259 "            }"
NSQ_SOURCE_LINE 00003260 ""
NSQ_SOURCE_LINE 00003261 "            if ($stop_now) {"
NSQ_SOURCE_LINE 00003262 ""
NSQ_SOURCE_LINE 00003263 "                if (DEVEL_MODE) {"
NSQ_SOURCE_LINE 00003264 ""
NSQ_SOURCE_LINE 00003265 "                    if ( defined($iteration_of_formatter_convergence) ) {"
NSQ_SOURCE_LINE 00003266 ""
NSQ_SOURCE_LINE 00003267 "                        # This message cannot appear unless the formatter"
NSQ_SOURCE_LINE 00003268 "                        # convergence test above is temporarily skipped for"
NSQ_SOURCE_LINE 00003269 "                        # testing."
NSQ_SOURCE_LINE 00003270 "                        if ( $iteration_of_formatter_convergence < $iter - 1 ) {"
NSQ_SOURCE_LINE 00003271 "                            print {*STDERR}"
NSQ_SOURCE_LINE 00003272 "\"STRANGE Early conv in $display_name: Stopping on it=$iter, converged in formatter on $iteration_of_formatter_convergence\\n\";"
NSQ_SOURCE_LINE 00003273 "                        }"
NSQ_SOURCE_LINE 00003274 "                    }"
NSQ_SOURCE_LINE 00003275 "                    elsif ( !$stopping_on_error ) {"
NSQ_SOURCE_LINE 00003276 ""
NSQ_SOURCE_LINE 00003277 "                        # The md5 sum implies convergence but the convergence"
NSQ_SOURCE_LINE 00003278 "                        # was not detected by the Formatter.  This is not"
NSQ_SOURCE_LINE 00003279 "                        # critical but should be investigated.  It happened"
NSQ_SOURCE_LINE 00003280 "                        # once when a line break was placed before a phantom"
NSQ_SOURCE_LINE 00003281 "                        # comma under -qwaf, and a semicolon under -nasc,"
NSQ_SOURCE_LINE 00003282 "                        # and has been fixed (search for 'STRANGE')."
NSQ_SOURCE_LINE 00003283 "                        print {*STDERR}"
NSQ_SOURCE_LINE 00003284 "\"STRANGE no conv in $display_name: stopping on it=$iter, but not converged in formatter\\n\";"
NSQ_SOURCE_LINE 00003285 "                    }"
NSQ_SOURCE_LINE 00003286 "                    else {"
NSQ_SOURCE_LINE 00003287 "                        ## looks ok"
NSQ_SOURCE_LINE 00003288 "                    }"
NSQ_SOURCE_LINE 00003289 "                }"
NSQ_SOURCE_LINE 00003290 ""
NSQ_SOURCE_LINE 00003291 "                # we are stopping the iterations early;"
NSQ_SOURCE_LINE 00003292 "                last;"
NSQ_SOURCE_LINE 00003293 "            }"
NSQ_SOURCE_LINE 00003294 "        } ## end if ( $iter < $max_iterations)"
NSQ_SOURCE_LINE 00003295 "    } ## end loop over iterations for one source file"
NSQ_SOURCE_LINE 00003296 ""
NSQ_SOURCE_LINE 00003297 "    $debugger_object->close_debug_file()"
NSQ_SOURCE_LINE 00003298 "      if ($debugger_object);"
NSQ_SOURCE_LINE 00003299 ""
NSQ_SOURCE_LINE 00003300 "    if (   $fh_tee"
NSQ_SOURCE_LINE 00003301 "        && $fh_tee->can('close')"
NSQ_SOURCE_LINE 00003302 "        && !ref($tee_file)"
NSQ_SOURCE_LINE 00003303 "        && $tee_file ne '-' )"
NSQ_SOURCE_LINE 00003304 "    {"
NSQ_SOURCE_LINE 00003305 "        $fh_tee->close()"
NSQ_SOURCE_LINE 00003306 "          or Warn(\"couldn't close TEE file $tee_file: $OS_ERROR\\n\");"
NSQ_SOURCE_LINE 00003307 "    }"
NSQ_SOURCE_LINE 00003308 ""
NSQ_SOURCE_LINE 00003309 "    # leave logger object open for additional messages"
NSQ_SOURCE_LINE 00003310 "    $logger_object = $logger_object_final;"
NSQ_SOURCE_LINE 00003311 "    $logger_object->write_logfile_entry($convergence_log_message)"
NSQ_SOURCE_LINE 00003312 "      if ($convergence_log_message);"
NSQ_SOURCE_LINE 00003313 ""
NSQ_SOURCE_LINE 00003314 "    return $routput_string;"
NSQ_SOURCE_LINE 00003315 ""
NSQ_SOURCE_LINE 00003316 "} ## end sub process_iteration_layer"
NSQ_SOURCE_LINE 00003317 ""
NSQ_SOURCE_LINE 00003318 "sub process_single_case {"
NSQ_SOURCE_LINE 00003319 ""
NSQ_SOURCE_LINE 00003320 "    my ( $self, $tokenizer, $formatter ) = @_;"
NSQ_SOURCE_LINE 00003321 ""
NSQ_SOURCE_LINE 00003322 "    # Run the formatter on a single defined case"
NSQ_SOURCE_LINE 00003323 ""
NSQ_SOURCE_LINE 00003324 "    # Total formatting is done with these layers of subroutines:"
NSQ_SOURCE_LINE 00003325 "    #   perltidy                - main routine; checks run parameters"
NSQ_SOURCE_LINE 00003326 "    #   process_all_files       - main loop to process all files;"
NSQ_SOURCE_LINE 00003327 "    #   process_filter_layer    - do any pre and post processing;"
NSQ_SOURCE_LINE 00003328 "    #   process_iteration_layer - do any iterations on formatting"
NSQ_SOURCE_LINE 00003329 "    #  *process_single_case     - solve one formatting problem; *THIS LAYER"
NSQ_SOURCE_LINE 00003330 ""
NSQ_SOURCE_LINE 00003331 "    while ( my $line = $tokenizer->get_line() ) {"
NSQ_SOURCE_LINE 00003332 "        $formatter->write_line($line);"
NSQ_SOURCE_LINE 00003333 "    }"
NSQ_SOURCE_LINE 00003334 ""
NSQ_SOURCE_LINE 00003335 "    # user-defined formatters are possible, and may not have a"
NSQ_SOURCE_LINE 00003336 "    # sub 'finish_formatting', so we have to check"
NSQ_SOURCE_LINE 00003337 "    if ( $formatter->can('finish_formatting') ) {"
NSQ_SOURCE_LINE 00003338 "        my $rtok_report = $tokenizer->report_tokenization_errors();"
NSQ_SOURCE_LINE 00003339 "        my $verbatim    = $formatter->finish_formatting($rtok_report);"
NSQ_SOURCE_LINE 00003340 "        $self->[_input_copied_verbatim_] = $verbatim;"
NSQ_SOURCE_LINE 00003341 "    }"
NSQ_SOURCE_LINE 00003342 ""
NSQ_SOURCE_LINE 00003343 "    return;"
NSQ_SOURCE_LINE 00003344 "} ## end sub process_single_case"
NSQ_SOURCE_LINE 00003345 ""
NSQ_SOURCE_LINE 00003346 "sub copy_buffer_to_external_ref {"
NSQ_SOURCE_LINE 00003347 ""
NSQ_SOURCE_LINE 00003348 "    my ( $self, $routput, $destination_stream ) = @_;"
NSQ_SOURCE_LINE 00003349 ""
NSQ_SOURCE_LINE 00003350 "    # Copy $routput to the final $destination_stream,"
NSQ_SOURCE_LINE 00003351 "    # encoding if the flag $encode_destination_buffer is true."
NSQ_SOURCE_LINE 00003352 ""
NSQ_SOURCE_LINE 00003353 "    # Data Flow:"
NSQ_SOURCE_LINE 00003354 "    #    $destination_buffer -> [ encode? ] -> $destination_stream"
NSQ_SOURCE_LINE 00003355 ""
NSQ_SOURCE_LINE 00003356 "    my $destination_buffer = EMPTY_STRING;"
NSQ_SOURCE_LINE 00003357 "    if ( ref($routput) eq 'ARRAY' ) {"
NSQ_SOURCE_LINE 00003358 "        $destination_buffer = join EMPTY_STRING, @{$routput};"
NSQ_SOURCE_LINE 00003359 "    }"
NSQ_SOURCE_LINE 00003360 "    elsif ( ref($routput) eq 'SCALAR' ) {"
NSQ_SOURCE_LINE 00003361 "        $destination_buffer = ${$routput};"
NSQ_SOURCE_LINE 00003362 "    }"
NSQ_SOURCE_LINE 00003363 "    else {"
NSQ_SOURCE_LINE 00003364 "        Fault("
NSQ_SOURCE_LINE 00003365 "            \"'copy_buffer_to_external_ref' expecting ref to ARRAY or SCALAR\\n\");"
NSQ_SOURCE_LINE 00003366 "    }"
NSQ_SOURCE_LINE 00003367 ""
NSQ_SOURCE_LINE 00003368 "    $rstatus->{'output_encoded_as'} = EMPTY_STRING;"
NSQ_SOURCE_LINE 00003369 "    my $ref_destination_stream = ref($destination_stream);"
NSQ_SOURCE_LINE 00003370 ""
NSQ_SOURCE_LINE 00003371 "    # Encode output? Strings and arrays use special encoding rules; see:"
NSQ_SOURCE_LINE 00003372 "    #   https://github.com/perltidy/perltidy/blob/master/docs/eos_flag.md"
NSQ_SOURCE_LINE 00003373 "    my $encode_destination_buffer;"
NSQ_SOURCE_LINE 00003374 "    if (   $ref_destination_stream eq 'SCALAR'"
NSQ_SOURCE_LINE 00003375 "        || $ref_destination_stream eq 'ARRAY' )"
NSQ_SOURCE_LINE 00003376 "    {"
NSQ_SOURCE_LINE 00003377 "        my $rOpts = $self->[_rOpts_];"
NSQ_SOURCE_LINE 00003378 "        $encode_destination_buffer ="
NSQ_SOURCE_LINE 00003379 "          $rOpts->{'encode-output-strings'} && $self->[_decoded_input_as_];"
NSQ_SOURCE_LINE 00003380 "    }"
NSQ_SOURCE_LINE 00003381 ""
NSQ_SOURCE_LINE 00003382 "    # An object with a print method will use file encoding rules"
NSQ_SOURCE_LINE 00003383 "    elsif ( $ref_destination_stream->can('print') ) {"
NSQ_SOURCE_LINE 00003384 "        $encode_destination_buffer = $self->[_is_encoded_data_];"
NSQ_SOURCE_LINE 00003385 "    }"
NSQ_SOURCE_LINE 00003386 "    else {"
NSQ_SOURCE_LINE 00003387 "        confess <<EOM;"
NSQ_SOURCE_LINE 00003388 "------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00003389 "No 'print' method is defined for object of class '$ref_destination_stream'"
NSQ_SOURCE_LINE 00003390 "Please check your call to Perl::Tidy::perltidy. Trace follows."
NSQ_SOURCE_LINE 00003391 "------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00003392 "EOM"
NSQ_SOURCE_LINE 00003393 "    }"
NSQ_SOURCE_LINE 00003394 ""
NSQ_SOURCE_LINE 00003395 "    if ($encode_destination_buffer) {"
NSQ_SOURCE_LINE 00003396 "        my $encoded_buffer;"
NSQ_SOURCE_LINE 00003397 "        if ("
NSQ_SOURCE_LINE 00003398 "            !eval {"
NSQ_SOURCE_LINE 00003399 "                $encoded_buffer ="
NSQ_SOURCE_LINE 00003400 "                  Encode::encode( \"UTF-8\", $destination_buffer,"
NSQ_SOURCE_LINE 00003401 "                    Encode::FB_CROAK | Encode::LEAVE_SRC );"
NSQ_SOURCE_LINE 00003402 "                1;"
NSQ_SOURCE_LINE 00003403 "            }"
NSQ_SOURCE_LINE 00003404 "          )"
NSQ_SOURCE_LINE 00003405 "        {"
NSQ_SOURCE_LINE 00003406 "            Warn("
NSQ_SOURCE_LINE 00003407 "\"Error attempting to encode output string ref; encoding not done\\n\""
NSQ_SOURCE_LINE 00003408 "            );"
NSQ_SOURCE_LINE 00003409 "        }"
NSQ_SOURCE_LINE 00003410 "        else {"
NSQ_SOURCE_LINE 00003411 "            $destination_buffer = $encoded_buffer;"
NSQ_SOURCE_LINE 00003412 "            $rstatus->{'output_encoded_as'} = 'UTF-8';"
NSQ_SOURCE_LINE 00003413 "        }"
NSQ_SOURCE_LINE 00003414 "    }"
NSQ_SOURCE_LINE 00003415 ""
NSQ_SOURCE_LINE 00003416 "    # Send data for SCALAR, ARRAY & OBJ refs to its final destination"
NSQ_SOURCE_LINE 00003417 "    if ( $ref_destination_stream eq 'SCALAR' ) {"
NSQ_SOURCE_LINE 00003418 "        ${$destination_stream} = $destination_buffer;"
NSQ_SOURCE_LINE 00003419 "    }"
NSQ_SOURCE_LINE 00003420 "    elsif ( defined($destination_buffer) ) {"
NSQ_SOURCE_LINE 00003421 "        my @lines = split /^/, $destination_buffer;"
NSQ_SOURCE_LINE 00003422 "        if ( $ref_destination_stream eq 'ARRAY' ) {"
NSQ_SOURCE_LINE 00003423 "            @{$destination_stream} = @lines;"
NSQ_SOURCE_LINE 00003424 "        }"
NSQ_SOURCE_LINE 00003425 ""
NSQ_SOURCE_LINE 00003426 "        # destination stream must be an object with print method"
NSQ_SOURCE_LINE 00003427 "        else {"
NSQ_SOURCE_LINE 00003428 "            foreach my $line (@lines) {"
NSQ_SOURCE_LINE 00003429 "                $destination_stream->print($line);"
NSQ_SOURCE_LINE 00003430 "            }"
NSQ_SOURCE_LINE 00003431 "            if ( $ref_destination_stream->can('close') ) {"
NSQ_SOURCE_LINE 00003432 "                $destination_stream->close();"
NSQ_SOURCE_LINE 00003433 "            }"
NSQ_SOURCE_LINE 00003434 "        }"
NSQ_SOURCE_LINE 00003435 "    }"
NSQ_SOURCE_LINE 00003436 "    else {"
NSQ_SOURCE_LINE 00003437 ""
NSQ_SOURCE_LINE 00003438 "        # Empty destination buffer not going to a string ... could"
NSQ_SOURCE_LINE 00003439 "        # happen for example if user deleted all pod or comments"
NSQ_SOURCE_LINE 00003440 "    }"
NSQ_SOURCE_LINE 00003441 "    return;"
NSQ_SOURCE_LINE 00003442 "} ## end sub copy_buffer_to_external_ref"
NSQ_SOURCE_LINE 00003443 ""
NSQ_SOURCE_LINE 00003444 "} ## end of closure for sub perltidy"
NSQ_SOURCE_LINE 00003445 ""
NSQ_SOURCE_LINE 00003446 "sub line_diff {"
NSQ_SOURCE_LINE 00003447 ""
NSQ_SOURCE_LINE 00003448 "    my ( $s1, $s2 ) = @_;"
NSQ_SOURCE_LINE 00003449 ""
NSQ_SOURCE_LINE 00003450 "    # Given two strings, Return"
NSQ_SOURCE_LINE 00003451 "    #  $diff_marker = a string with caret (^) symbols indicating differences"
NSQ_SOURCE_LINE 00003452 "    #  $pos1 = character position of first difference; pos1=-1 if no difference"
NSQ_SOURCE_LINE 00003453 ""
NSQ_SOURCE_LINE 00003454 "    # Form exclusive or of the strings, which has null characters where strings"
NSQ_SOURCE_LINE 00003455 "    # have same common characters so non-null characters indicate character"
NSQ_SOURCE_LINE 00003456 "    # differences."
NSQ_SOURCE_LINE 00003457 "    my $diff_marker = EMPTY_STRING;"
NSQ_SOURCE_LINE 00003458 "    my $pos         = -1;"
NSQ_SOURCE_LINE 00003459 "    my $pos1        = -1;"
NSQ_SOURCE_LINE 00003460 "    if ( defined($s1) && defined($s2) ) {"
NSQ_SOURCE_LINE 00003461 "        my $mask = $s1 ^ $s2;"
NSQ_SOURCE_LINE 00003462 ""
NSQ_SOURCE_LINE 00003463 "        while ( $mask =~ /[^\\0]/g ) {"
NSQ_SOURCE_LINE 00003464 "            my $pos_last = $pos;"
NSQ_SOURCE_LINE 00003465 "            $pos = $LAST_MATCH_START[0];"
NSQ_SOURCE_LINE 00003466 "            if ( $pos1 < 0 ) { $pos1 = $pos; }"
NSQ_SOURCE_LINE 00003467 "            $diff_marker .= SPACE x ( $pos - $pos_last - 1 ) . '^';"
NSQ_SOURCE_LINE 00003468 ""
NSQ_SOURCE_LINE 00003469 "            # we could continue to mark all differences, but there is no point"
NSQ_SOURCE_LINE 00003470 "            last;"
NSQ_SOURCE_LINE 00003471 "        } ## end while ( $mask =~ /[^\\0]/g)"
NSQ_SOURCE_LINE 00003472 "    }"
NSQ_SOURCE_LINE 00003473 "    return ( $diff_marker, $pos1 );"
NSQ_SOURCE_LINE 00003474 "} ## end sub line_diff"
NSQ_SOURCE_LINE 00003475 ""
NSQ_SOURCE_LINE 00003476 "sub compare_string_buffers {"
NSQ_SOURCE_LINE 00003477 ""
NSQ_SOURCE_LINE 00003478 "    my ( $string_i, $string_o, ($max_diff_count) ) = @_;"
NSQ_SOURCE_LINE 00003479 ""
NSQ_SOURCE_LINE 00003480 "    # Compare input and output string buffers and return a brief text"
NSQ_SOURCE_LINE 00003481 "    # description of the first difference."
NSQ_SOURCE_LINE 00003482 ""
NSQ_SOURCE_LINE 00003483 "    # Given:"
NSQ_SOURCE_LINE 00003484 "    #   $string_i = input string, or ref to input string"
NSQ_SOURCE_LINE 00003485 "    #   $string_o = output string, or ref to output string"
NSQ_SOURCE_LINE 00003486 "    #   $max_diff_count = optional maximum number of differences to show,"
NSQ_SOURCE_LINE 00003487 "    #       default=1"
NSQ_SOURCE_LINE 00003488 "    # Return:"
NSQ_SOURCE_LINE 00003489 "    #   a string showing differences"
NSQ_SOURCE_LINE 00003490 ""
NSQ_SOURCE_LINE 00003491 "    my $rbufi = ref($string_i) ? $string_i : \\$string_i;"
NSQ_SOURCE_LINE 00003492 "    my $rbufo = ref($string_o) ? $string_o : \\$string_o;"
NSQ_SOURCE_LINE 00003493 ""
NSQ_SOURCE_LINE 00003494 "    if ( !defined($max_diff_count) ) { $max_diff_count = 1 }"
NSQ_SOURCE_LINE 00003495 ""
NSQ_SOURCE_LINE 00003496 "    my ( @aryi, @aryo );"
NSQ_SOURCE_LINE 00003497 "    my ( $leni, $leno ) = ( 0, 0 );"
NSQ_SOURCE_LINE 00003498 "    if ( defined($rbufi) ) {"
NSQ_SOURCE_LINE 00003499 "        $leni = length( ${$rbufi} );"
NSQ_SOURCE_LINE 00003500 "        @aryi = split /^/, ${$rbufi};"
NSQ_SOURCE_LINE 00003501 "    }"
NSQ_SOURCE_LINE 00003502 "    if ( defined($rbufo) ) {"
NSQ_SOURCE_LINE 00003503 "        $leno = length( ${$rbufo} );"
NSQ_SOURCE_LINE 00003504 "        @aryo = split /^/, ${$rbufo};"
NSQ_SOURCE_LINE 00003505 "    }"
NSQ_SOURCE_LINE 00003506 "    my $nlines_i = @aryi;"
NSQ_SOURCE_LINE 00003507 "    my $nlines_o = @aryo;"
NSQ_SOURCE_LINE 00003508 "    my $msg      = <<EOM;"
NSQ_SOURCE_LINE 00003509 "Input   file length has $leni chars in $nlines_i lines"
NSQ_SOURCE_LINE 00003510 "Output  file length has $leno chars in $nlines_o lines"
NSQ_SOURCE_LINE 00003511 "EOM"
NSQ_SOURCE_LINE 00003512 "    return $msg unless ( $leni && $leno );"
NSQ_SOURCE_LINE 00003513 ""
NSQ_SOURCE_LINE 00003514 "    my $truncate = sub {"
NSQ_SOURCE_LINE 00003515 "        my ( $str, $lenmax ) = @_;"
NSQ_SOURCE_LINE 00003516 "        if ( length($str) > $lenmax ) {"
NSQ_SOURCE_LINE 00003517 "            $str = substr( $str, 0, $lenmax ) . \"...\";"
NSQ_SOURCE_LINE 00003518 "        }"
NSQ_SOURCE_LINE 00003519 "        return $str;"
NSQ_SOURCE_LINE 00003520 "    }; ## end $truncate = sub"
NSQ_SOURCE_LINE 00003521 ""
NSQ_SOURCE_LINE 00003522 "    my $last_nonblank_line  = EMPTY_STRING;"
NSQ_SOURCE_LINE 00003523 "    my $last_nonblank_count = 0;"
NSQ_SOURCE_LINE 00003524 ""
NSQ_SOURCE_LINE 00003525 "    # loop over lines until we find a difference"
NSQ_SOURCE_LINE 00003526 "    my $count      = 0;"
NSQ_SOURCE_LINE 00003527 "    my $diff_count = 0;"
NSQ_SOURCE_LINE 00003528 "    while ( @aryi && @aryo ) {"
NSQ_SOURCE_LINE 00003529 "        $count++;"
NSQ_SOURCE_LINE 00003530 "        my $linei = shift @aryi;"
NSQ_SOURCE_LINE 00003531 "        my $lineo = shift @aryo;"
NSQ_SOURCE_LINE 00003532 "        chomp $linei;"
NSQ_SOURCE_LINE 00003533 "        chomp $lineo;"
NSQ_SOURCE_LINE 00003534 "        if ( $linei eq $lineo ) {"
NSQ_SOURCE_LINE 00003535 "            if ( length($linei) ) {"
NSQ_SOURCE_LINE 00003536 "                $last_nonblank_line  = $linei;"
NSQ_SOURCE_LINE 00003537 "                $last_nonblank_count = $count;"
NSQ_SOURCE_LINE 00003538 "            }"
NSQ_SOURCE_LINE 00003539 "            next;"
NSQ_SOURCE_LINE 00003540 "        }"
NSQ_SOURCE_LINE 00003541 ""
NSQ_SOURCE_LINE 00003542 "        #---------------------------"
NSQ_SOURCE_LINE 00003543 "        # lines differ ... finish up"
NSQ_SOURCE_LINE 00003544 "        #---------------------------"
NSQ_SOURCE_LINE 00003545 "        my ( $line_diff, $pos1 ) = line_diff( $linei, $lineo );"
NSQ_SOURCE_LINE 00003546 "        my $ch1    = $pos1 + 1;"
NSQ_SOURCE_LINE 00003547 "        my $reason = \"Files first differ at character $ch1 of line $count\";"
NSQ_SOURCE_LINE 00003548 ""
NSQ_SOURCE_LINE 00003549 "        my ( $leading_ws_i, $leading_ws_o ) = ( EMPTY_STRING, EMPTY_STRING );"
NSQ_SOURCE_LINE 00003550 "        if ( $linei =~ /^(\\s+)/ ) { $leading_ws_i = $1; }"
NSQ_SOURCE_LINE 00003551 "        if ( $lineo =~ /^(\\s+)/ ) { $leading_ws_o = $1; }"
NSQ_SOURCE_LINE 00003552 "        if ( $leading_ws_i ne $leading_ws_o ) {"
NSQ_SOURCE_LINE 00003553 "            $reason .= \"; leading whitespace differs\";"
NSQ_SOURCE_LINE 00003554 "            if ( $leading_ws_i =~ /\\t/ ) {"
NSQ_SOURCE_LINE 00003555 "                $reason .= \"; input has tab char\";"
NSQ_SOURCE_LINE 00003556 "            }"
NSQ_SOURCE_LINE 00003557 "        }"
NSQ_SOURCE_LINE 00003558 "        else {"
NSQ_SOURCE_LINE 00003559 "            my ( $trailing_ws_i, $trailing_ws_o ) ="
NSQ_SOURCE_LINE 00003560 "              ( EMPTY_STRING, EMPTY_STRING );"
NSQ_SOURCE_LINE 00003561 "            if ( $linei =~ /(\\s+)$/ ) { $trailing_ws_i = $1; }"
NSQ_SOURCE_LINE 00003562 "            if ( $lineo =~ /(\\s+)$/ ) { $trailing_ws_o = $1; }"
NSQ_SOURCE_LINE 00003563 "            if ( $trailing_ws_i ne $trailing_ws_o ) {"
NSQ_SOURCE_LINE 00003564 "                $reason .= \"; trailing whitespace differs\";"
NSQ_SOURCE_LINE 00003565 "            }"
NSQ_SOURCE_LINE 00003566 "        }"
NSQ_SOURCE_LINE 00003567 "        $msg .= $reason . \"\\n\";"
NSQ_SOURCE_LINE 00003568 ""
NSQ_SOURCE_LINE 00003569 "        # limit string display length"
NSQ_SOURCE_LINE 00003570 "        if ( $pos1 > 60 ) {"
NSQ_SOURCE_LINE 00003571 "            my $drop = $pos1 - 40;"
NSQ_SOURCE_LINE 00003572 "            $linei     = \"...\" . substr( $linei, $drop );"
NSQ_SOURCE_LINE 00003573 "            $lineo     = \"...\" . substr( $lineo, $drop );"
NSQ_SOURCE_LINE 00003574 "            $line_diff = SPACE x 3 . substr( $line_diff, $drop );"
NSQ_SOURCE_LINE 00003575 "        }"
NSQ_SOURCE_LINE 00003576 "        $linei              = $truncate->( $linei,              72 );"
NSQ_SOURCE_LINE 00003577 "        $lineo              = $truncate->( $lineo,              72 );"
NSQ_SOURCE_LINE 00003578 "        $last_nonblank_line = $truncate->( $last_nonblank_line, 72 );"
NSQ_SOURCE_LINE 00003579 ""
NSQ_SOURCE_LINE 00003580 "        if ($last_nonblank_line) {"
NSQ_SOURCE_LINE 00003581 "            $msg .= <<EOM;"
NSQ_SOURCE_LINE 00003582 " $last_nonblank_count:$last_nonblank_line"
NSQ_SOURCE_LINE 00003583 "EOM"
NSQ_SOURCE_LINE 00003584 "        }"
NSQ_SOURCE_LINE 00003585 "        $line_diff = SPACE x ( 2 + length($count) ) . $line_diff;"
NSQ_SOURCE_LINE 00003586 "        $msg .= <<EOM;"
NSQ_SOURCE_LINE 00003587 "<$count:$linei"
NSQ_SOURCE_LINE 00003588 ">$count:$lineo"
NSQ_SOURCE_LINE 00003589 "$line_diff"
NSQ_SOURCE_LINE 00003590 "EOM"
NSQ_SOURCE_LINE 00003591 "        $diff_count++;"
NSQ_SOURCE_LINE 00003592 "        last if ( $diff_count >= $max_diff_count );"
NSQ_SOURCE_LINE 00003593 "    } ## end while ( @aryi && @aryo )"
NSQ_SOURCE_LINE 00003594 ""
NSQ_SOURCE_LINE 00003595 "    if ($diff_count) { return $msg }"
NSQ_SOURCE_LINE 00003596 ""
NSQ_SOURCE_LINE 00003597 "    #------------------------------------------------------"
NSQ_SOURCE_LINE 00003598 "    # no differences found, see if one file has fewer lines"
NSQ_SOURCE_LINE 00003599 "    #------------------------------------------------------"
NSQ_SOURCE_LINE 00003600 "    if ( $nlines_i > $nlines_o ) {"
NSQ_SOURCE_LINE 00003601 "        $msg .= <<EOM;"
NSQ_SOURCE_LINE 00003602 "Files initially match file but output file has fewer lines"
NSQ_SOURCE_LINE 00003603 "EOM"
NSQ_SOURCE_LINE 00003604 "    }"
NSQ_SOURCE_LINE 00003605 "    elsif ( $nlines_i < $nlines_o ) {"
NSQ_SOURCE_LINE 00003606 "        $msg .= <<EOM;"
NSQ_SOURCE_LINE 00003607 "Files initially match file but input file has fewer lines"
NSQ_SOURCE_LINE 00003608 "EOM"
NSQ_SOURCE_LINE 00003609 "    }"
NSQ_SOURCE_LINE 00003610 "    else {"
NSQ_SOURCE_LINE 00003611 "        $msg .= <<EOM;"
NSQ_SOURCE_LINE 00003612 "Text in lines of file match but checksums differ. Perhaps line endings differ."
NSQ_SOURCE_LINE 00003613 "EOM"
NSQ_SOURCE_LINE 00003614 "    }"
NSQ_SOURCE_LINE 00003615 "    return $msg;"
NSQ_SOURCE_LINE 00003616 "} ## end sub compare_string_buffers"
NSQ_SOURCE_LINE 00003617 ""
NSQ_SOURCE_LINE 00003618 "sub fileglob_to_re {"
NSQ_SOURCE_LINE 00003619 ""
NSQ_SOURCE_LINE 00003620 "    # modified (corrected) from version in find2perl"
NSQ_SOURCE_LINE 00003621 "    my $x = shift;"
NSQ_SOURCE_LINE 00003622 "    $x =~ s/([.\\/^\\$()])/\\\\$1/g;    # escape special characters"
NSQ_SOURCE_LINE 00003623 "    $x =~ s/\\*/.*/g;                # '*' -> '.*'"
NSQ_SOURCE_LINE 00003624 "    $x =~ s/\\?/./g;                 # '?' -> '.'"
NSQ_SOURCE_LINE 00003625 "    return \"^$x\\\\z\";                # match whole word"
NSQ_SOURCE_LINE 00003626 "} ## end sub fileglob_to_re"
NSQ_SOURCE_LINE 00003627 ""
NSQ_SOURCE_LINE 00003628 "sub make_logfile_header {"
NSQ_SOURCE_LINE 00003629 "    my ( $rOpts, $config_file, $rraw_options, $Windows_type, $readable_options )"
NSQ_SOURCE_LINE 00003630 "      = @_;"
NSQ_SOURCE_LINE 00003631 ""
NSQ_SOURCE_LINE 00003632 "    # Note: the punctuation variable '$]' is not in older versions of"
NSQ_SOURCE_LINE 00003633 "    # English.pm so leave it as is to avoid failing installation tests."
NSQ_SOURCE_LINE 00003634 "    my $msg ="
NSQ_SOURCE_LINE 00003635 "\"perltidy version $VERSION log file on a $OSNAME system, OLD_PERL_VERSION=$]\\n\";"
NSQ_SOURCE_LINE 00003636 "    if ($Windows_type) {"
NSQ_SOURCE_LINE 00003637 "        $msg .= \"Windows type is $Windows_type\\n\";"
NSQ_SOURCE_LINE 00003638 "    }"
NSQ_SOURCE_LINE 00003639 "    my $options_string = join( SPACE, @{$rraw_options} );"
NSQ_SOURCE_LINE 00003640 ""
NSQ_SOURCE_LINE 00003641 "    if ( defined($config_file) ) {"
NSQ_SOURCE_LINE 00003642 "        $msg .= \"Found Configuration File >>> $config_file \\n\";"
NSQ_SOURCE_LINE 00003643 "    }"
NSQ_SOURCE_LINE 00003644 "    $msg .= \"Configuration and command line parameters for this run:\\n\";"
NSQ_SOURCE_LINE 00003645 "    $msg .= \"$options_string\\n\";"
NSQ_SOURCE_LINE 00003646 ""
NSQ_SOURCE_LINE 00003647 "    if ( $rOpts->{'show-options'} ) {"
NSQ_SOURCE_LINE 00003648 "        $rOpts->{'logfile'} = 1;    # force logfile to be saved"
NSQ_SOURCE_LINE 00003649 "        $msg .= \"Final parameter set for this run\\n\";"
NSQ_SOURCE_LINE 00003650 "        $msg .= \"------------------------------------\\n\";"
NSQ_SOURCE_LINE 00003651 ""
NSQ_SOURCE_LINE 00003652 "        $msg .= $readable_options;"
NSQ_SOURCE_LINE 00003653 ""
NSQ_SOURCE_LINE 00003654 "        $msg .= \"------------------------------------\\n\";"
NSQ_SOURCE_LINE 00003655 "    }"
NSQ_SOURCE_LINE 00003656 "    $msg .= \"To find error messages search for 'WARNING' with your editor\\n\";"
NSQ_SOURCE_LINE 00003657 "    return $msg;"
NSQ_SOURCE_LINE 00003658 "} ## end sub make_logfile_header"
NSQ_SOURCE_LINE 00003659 ""
NSQ_SOURCE_LINE 00003660 "sub generate_options {"
NSQ_SOURCE_LINE 00003661 ""
NSQ_SOURCE_LINE 00003662 "    ######################################################################"
NSQ_SOURCE_LINE 00003663 "    # Generate and return references to:"
NSQ_SOURCE_LINE 00003664 "    #  @option_string - the list of options to be passed to Getopt::Long"
NSQ_SOURCE_LINE 00003665 "    #  @defaults - the list of default options"
NSQ_SOURCE_LINE 00003666 "    #  %expansion - a hash showing how all abbreviations are expanded"
NSQ_SOURCE_LINE 00003667 "    #  %category - a hash giving the general category of each option"
NSQ_SOURCE_LINE 00003668 "    #  %integer_option_range - valid ranges of certain options"
NSQ_SOURCE_LINE 00003669 ""
NSQ_SOURCE_LINE 00003670 "    # Note: a few options are not documented in the man page and usage"
NSQ_SOURCE_LINE 00003671 "    # message. This is because these are deprecated, experimental or debug"
NSQ_SOURCE_LINE 00003672 "    # options and may or may not be retained in future versions:"
NSQ_SOURCE_LINE 00003673 ""
NSQ_SOURCE_LINE 00003674 "    # These undocumented flags are accepted but not used:"
NSQ_SOURCE_LINE 00003675 "    # --check-syntax"
NSQ_SOURCE_LINE 00003676 "    # --fuzzy-line-length"
NSQ_SOURCE_LINE 00003677 "    #"
NSQ_SOURCE_LINE 00003678 "    # These undocumented flags are for debugging:"
NSQ_SOURCE_LINE 00003679 "    # --recombine                           # used to debug line breaks"
NSQ_SOURCE_LINE 00003680 "    # --short-concatenation-item-length     # used to break a '.' chain"
NSQ_SOURCE_LINE 00003681 "    #"
NSQ_SOURCE_LINE 00003682 "    ######################################################################"
NSQ_SOURCE_LINE 00003683 ""
NSQ_SOURCE_LINE 00003684 "    # here is a summary of the Getopt codes:"
NSQ_SOURCE_LINE 00003685 "    # <none> does not take an argument"
NSQ_SOURCE_LINE 00003686 "    # =s takes a mandatory string"
NSQ_SOURCE_LINE 00003687 "    # :s takes an optional string  (DO NOT USE - filenames will get eaten up)"
NSQ_SOURCE_LINE 00003688 "    # =i takes a mandatory integer"
NSQ_SOURCE_LINE 00003689 "    # :i takes an optional integer (NOT RECOMMENDED - can cause trouble)"
NSQ_SOURCE_LINE 00003690 "    # ! does not take an argument and may be negated"
NSQ_SOURCE_LINE 00003691 "    #  i.e., -foo and -nofoo are allowed"
NSQ_SOURCE_LINE 00003692 "    # a double dash signals the end of the options list"
NSQ_SOURCE_LINE 00003693 "    #"
NSQ_SOURCE_LINE 00003694 "    #-----------------------------------------------"
NSQ_SOURCE_LINE 00003695 "    # Define the option string passed to GetOptions."
NSQ_SOURCE_LINE 00003696 "    #-----------------------------------------------"
NSQ_SOURCE_LINE 00003697 ""
NSQ_SOURCE_LINE 00003698 "    my @option_string   = ();"
NSQ_SOURCE_LINE 00003699 "    my %expansion       = ();"
NSQ_SOURCE_LINE 00003700 "    my %option_category = ();"
NSQ_SOURCE_LINE 00003701 "    my %integer_option_range;"
NSQ_SOURCE_LINE 00003702 ""
NSQ_SOURCE_LINE 00003703 "    # names of categories in manual"
NSQ_SOURCE_LINE 00003704 "    # leading integers will allow sorting"
NSQ_SOURCE_LINE 00003705 "    my @category_name = ("
NSQ_SOURCE_LINE 00003706 "        '0. I/O control',"
NSQ_SOURCE_LINE 00003707 "        '1. Basic formatting options',"
NSQ_SOURCE_LINE 00003708 "        '2. Code indentation control',"
NSQ_SOURCE_LINE 00003709 "        '3. Whitespace control',"
NSQ_SOURCE_LINE 00003710 "        '4. Comment controls',"
NSQ_SOURCE_LINE 00003711 "        '5. Linebreak controls',"
NSQ_SOURCE_LINE 00003712 "        '6. Controlling list formatting',"
NSQ_SOURCE_LINE 00003713 "        '7. Retaining or ignoring existing line breaks',"
NSQ_SOURCE_LINE 00003714 "        '8. Blank line control',"
NSQ_SOURCE_LINE 00003715 "        '9. Other controls',"
NSQ_SOURCE_LINE 00003716 "        '10. HTML options',"
NSQ_SOURCE_LINE 00003717 "        '11. pod2html options',"
NSQ_SOURCE_LINE 00003718 "        '12. Controlling HTML properties',"
NSQ_SOURCE_LINE 00003719 "        '13. Debugging',"
NSQ_SOURCE_LINE 00003720 "    );"
NSQ_SOURCE_LINE 00003721 ""
NSQ_SOURCE_LINE 00003722 "    #  These options are parsed directly by perltidy:"
NSQ_SOURCE_LINE 00003723 "    #    help h"
NSQ_SOURCE_LINE 00003724 "    #    version v"
NSQ_SOURCE_LINE 00003725 "    #  However, they are included in the option set so that they will"
NSQ_SOURCE_LINE 00003726 "    #  be seen in the options dump."
NSQ_SOURCE_LINE 00003727 ""
NSQ_SOURCE_LINE 00003728 "    # These long option names have no abbreviations or are treated specially"
NSQ_SOURCE_LINE 00003729 "    @option_string = qw("
NSQ_SOURCE_LINE 00003730 "      html!"
NSQ_SOURCE_LINE 00003731 "      noprofile"
NSQ_SOURCE_LINE 00003732 "      nopro"
NSQ_SOURCE_LINE 00003733 "      no-profile"
NSQ_SOURCE_LINE 00003734 "      npro"
NSQ_SOURCE_LINE 00003735 "      recombine!"
NSQ_SOURCE_LINE 00003736 "      notidy"
NSQ_SOURCE_LINE 00003737 "    );"
NSQ_SOURCE_LINE 00003738 ""
NSQ_SOURCE_LINE 00003739 "    my $category = 13;    # Debugging"
NSQ_SOURCE_LINE 00003740 "    foreach (@option_string) {"
NSQ_SOURCE_LINE 00003741 "        my $opt = $_;     # must avoid changing the actual flag"
NSQ_SOURCE_LINE 00003742 "        $opt =~ s/!$//;"
NSQ_SOURCE_LINE 00003743 "        $option_category{$opt} = $category_name[$category];"
NSQ_SOURCE_LINE 00003744 "    }"
NSQ_SOURCE_LINE 00003745 ""
NSQ_SOURCE_LINE 00003746 "    $category = 11;                                       # HTML"
NSQ_SOURCE_LINE 00003747 "    $option_category{html} = $category_name[$category];"
NSQ_SOURCE_LINE 00003748 ""
NSQ_SOURCE_LINE 00003749 "    # Routine to install and check options"
NSQ_SOURCE_LINE 00003750 "    my $add_option = sub {"
NSQ_SOURCE_LINE 00003751 ""
NSQ_SOURCE_LINE 00003752 "        my ( $long_name, $short_name, $flag ) = @_;"
NSQ_SOURCE_LINE 00003753 ""
NSQ_SOURCE_LINE 00003754 "        # Given:"
NSQ_SOURCE_LINE 00003755 "        #   $long_name  = the full option name, such as 'backup-method'"
NSQ_SOURCE_LINE 00003756 "        #   $short_name = the abbreviation, such as 'bm'"
NSQ_SOURCE_LINE 00003757 "        #   $flag       = the Getopt code, such as '=s', see above list"
NSQ_SOURCE_LINE 00003758 ""
NSQ_SOURCE_LINE 00003759 "        push @option_string, $long_name . $flag;"
NSQ_SOURCE_LINE 00003760 "        $option_category{$long_name} = $category_name[$category];"
NSQ_SOURCE_LINE 00003761 "        if ($short_name) {"
NSQ_SOURCE_LINE 00003762 "            if ( $expansion{$short_name} ) {"
NSQ_SOURCE_LINE 00003763 "                my $existing_name = $expansion{$short_name}->[0];"
NSQ_SOURCE_LINE 00003764 "                Die("
NSQ_SOURCE_LINE 00003765 "\"redefining abbreviation $short_name for $long_name; already used for $existing_name\\n\""
NSQ_SOURCE_LINE 00003766 "                );"
NSQ_SOURCE_LINE 00003767 "            }"
NSQ_SOURCE_LINE 00003768 "            $expansion{$short_name} = [$long_name];"
NSQ_SOURCE_LINE 00003769 "            if ( $flag eq '!' ) {"
NSQ_SOURCE_LINE 00003770 "                my $nshort_name = 'n' . $short_name;"
NSQ_SOURCE_LINE 00003771 "                my $nolong_name = 'no' . $long_name;"
NSQ_SOURCE_LINE 00003772 "                if ( $expansion{$nshort_name} ) {"
NSQ_SOURCE_LINE 00003773 "                    my $existing_name = $expansion{$nshort_name}->[0];"
NSQ_SOURCE_LINE 00003774 "                    Die("
NSQ_SOURCE_LINE 00003775 "\"attempting to redefine abbreviation $nshort_name for $nolong_name; already used for $existing_name\\n\""
NSQ_SOURCE_LINE 00003776 "                    );"
NSQ_SOURCE_LINE 00003777 "                }"
NSQ_SOURCE_LINE 00003778 "                $expansion{$nshort_name} = [$nolong_name];"
NSQ_SOURCE_LINE 00003779 "            }"
NSQ_SOURCE_LINE 00003780 "        }"
NSQ_SOURCE_LINE 00003781 "        return;"
NSQ_SOURCE_LINE 00003782 "    }; ## end $add_option = sub"
NSQ_SOURCE_LINE 00003783 ""
NSQ_SOURCE_LINE 00003784 "    # Install long option names which have a simple abbreviation."
NSQ_SOURCE_LINE 00003785 "    # Options with code '!' get standard negation ('no' for long names,"
NSQ_SOURCE_LINE 00003786 "    # 'n' for abbreviations).  Categories follow the manual."
NSQ_SOURCE_LINE 00003787 ""
