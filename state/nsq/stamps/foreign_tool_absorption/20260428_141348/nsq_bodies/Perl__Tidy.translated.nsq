NSQ_SOURCE_LINE 00006613 "General Public License, which is included in the distribution files."
NSQ_SOURCE_LINE 00006614 ""
NSQ_SOURCE_LINE 00006615 "Documentation can be found using 'man perltidy'"
NSQ_SOURCE_LINE 00006616 "or at GitHub      https://perltidy.github.io/perltidy/"
NSQ_SOURCE_LINE 00006617 "or at metacpan    https://metacpan.org/pod/distribution/Perl-Tidy/bin/perltidy"
NSQ_SOURCE_LINE 00006618 "or at Sourceforge https://perltidy.sourceforge.net"
NSQ_SOURCE_LINE 00006619 "EOM"
NSQ_SOURCE_LINE 00006620 "    return;"
NSQ_SOURCE_LINE 00006621 "} ## end sub show_version"
NSQ_SOURCE_LINE 00006622 ""
NSQ_SOURCE_LINE 00006623 "sub usage {"
NSQ_SOURCE_LINE 00006624 ""
NSQ_SOURCE_LINE 00006625 "    # Dump brief usage message if arg is -help or -h, or on certain errors"
NSQ_SOURCE_LINE 00006626 ""
NSQ_SOURCE_LINE 00006627 "    print {*STDOUT} <<EOF;"
NSQ_SOURCE_LINE 00006628 "This is perltidy version $VERSION, a perl script indenter.  Usage:"
NSQ_SOURCE_LINE 00006629 ""
NSQ_SOURCE_LINE 00006630 "    perltidy [ options ] file1 file2 file3 ..."
NSQ_SOURCE_LINE 00006631 "            (output goes to file1.tdy, file2.tdy, file3.tdy, ...)"
NSQ_SOURCE_LINE 00006632 "    perltidy [ options ] file1 -o outfile"
NSQ_SOURCE_LINE 00006633 "    perltidy [ options ] file1 -st >outfile"
NSQ_SOURCE_LINE 00006634 "    perltidy [ options ] <infile >outfile"
NSQ_SOURCE_LINE 00006635 ""
NSQ_SOURCE_LINE 00006636 "Options have short and long forms. Short forms are shown; see"
NSQ_SOURCE_LINE 00006637 "man pages for long forms.  Note: '=s' indicates a required string,"
NSQ_SOURCE_LINE 00006638 "and '=n' indicates a required integer."
NSQ_SOURCE_LINE 00006639 ""
NSQ_SOURCE_LINE 00006640 "I/O control"
NSQ_SOURCE_LINE 00006641 " -h      show this help"
NSQ_SOURCE_LINE 00006642 " -o=file name of the output file (only if single input file)"
NSQ_SOURCE_LINE 00006643 " -oext=s change output extension from 'tdy' to s"
NSQ_SOURCE_LINE 00006644 " -opath=path  change path to be 'path' for output files"
NSQ_SOURCE_LINE 00006645 " -b      backup original to .bak and modify file in-place"
NSQ_SOURCE_LINE 00006646 " -bext=s change default backup extension from 'bak' to s"
NSQ_SOURCE_LINE 00006647 " -q      deactivate error messages (for running under editor)"
NSQ_SOURCE_LINE 00006648 " -w      include non-critical warning messages in the .ERR error output"
NSQ_SOURCE_LINE 00006649 " -log    save .LOG file, which has useful diagnostics"
NSQ_SOURCE_LINE 00006650 " -f      force perltidy to read a binary file"
NSQ_SOURCE_LINE 00006651 " -g      like -log but writes more detailed .LOG file, for debugging scripts"
NSQ_SOURCE_LINE 00006652 " -opt    write the set of options actually used to a .LOG file"
NSQ_SOURCE_LINE 00006653 " -npro   ignore .perltidyrc configuration command file"
NSQ_SOURCE_LINE 00006654 " -pro=file   read configuration commands from file instead of .perltidyrc"
NSQ_SOURCE_LINE 00006655 " -st     send output to standard output, STDOUT"
NSQ_SOURCE_LINE 00006656 " -se     send all error output to standard error output, STDERR"
NSQ_SOURCE_LINE 00006657 " -v      display version number to standard output and quit"
NSQ_SOURCE_LINE 00006658 ""
NSQ_SOURCE_LINE 00006659 "Basic Options:"
NSQ_SOURCE_LINE 00006660 " -i=n    use n columns per indentation level (default n=4)"
NSQ_SOURCE_LINE 00006661 " -t      tabs: use one tab character per indentation level, not recommended"
NSQ_SOURCE_LINE 00006662 " -nt     no tabs: use n spaces per indentation level (default)"
NSQ_SOURCE_LINE 00006663 " -et=n   entab leading whitespace n spaces per tab; not recommended"
NSQ_SOURCE_LINE 00006664 " -io     \"indent only\": just do indentation, no other formatting."
NSQ_SOURCE_LINE 00006665 " -sil=n  set starting indentation level to n;  use if auto detection fails"
NSQ_SOURCE_LINE 00006666 " -ole=s  specify output line ending (s=dos or win, mac, unix)"
NSQ_SOURCE_LINE 00006667 " -ple    keep output line endings same as input (input must be filename)"
NSQ_SOURCE_LINE 00006668 ""
NSQ_SOURCE_LINE 00006669 "Whitespace Control"
NSQ_SOURCE_LINE 00006670 " -fws    freeze whitespace; this disables all whitespace changes"
NSQ_SOURCE_LINE 00006671 "           and disables the following switches:"
NSQ_SOURCE_LINE 00006672 " -bt=n   sets brace tightness,  n= (0 = loose, 1=default, 2 = tight)"
NSQ_SOURCE_LINE 00006673 " -bbt    same as -bt but for code block braces; same as -bt if not given"
NSQ_SOURCE_LINE 00006674 " -bbvt   block braces vertically tight; use with -bl or -bli"
NSQ_SOURCE_LINE 00006675 " -bbvtl=s  make -bbvt to apply to selected list of block types"
NSQ_SOURCE_LINE 00006676 " -pt=n   paren tightness (n=0, 1 or 2)"
NSQ_SOURCE_LINE 00006677 " -sbt=n  square bracket tightness (n=0, 1, or 2)"
NSQ_SOURCE_LINE 00006678 " -bvt=n  brace vertical tightness,"
NSQ_SOURCE_LINE 00006679 "         n=(0=open, 1=close unless multiple steps on a line, 2=always close)"
NSQ_SOURCE_LINE 00006680 " -pvt=n  paren vertical tightness (see -bvt for n)"
NSQ_SOURCE_LINE 00006681 " -sbvt=n square bracket vertical tightness (see -bvt for n)"
NSQ_SOURCE_LINE 00006682 " -bvtc=n closing brace vertical tightness:"
NSQ_SOURCE_LINE 00006683 "         n=(0=open, 1=sometimes close, 2=always close)"
NSQ_SOURCE_LINE 00006684 " -pvtc=n closing paren vertical tightness, see -bvtc for n."
NSQ_SOURCE_LINE 00006685 " -sbvtc=n closing square bracket vertical tightness, see -bvtc for n."
NSQ_SOURCE_LINE 00006686 " -ci=n   sets continuation indentation=n,  default is n=2 spaces"
NSQ_SOURCE_LINE 00006687 " -lp     line up parentheses, brackets, and non-BLOCK braces"
NSQ_SOURCE_LINE 00006688 " -sfs    add space before semicolon in for( ; ; )"
NSQ_SOURCE_LINE 00006689 " -aws    allow perltidy to add whitespace (default)"
NSQ_SOURCE_LINE 00006690 " -dws    delete all old non-essential whitespace"
NSQ_SOURCE_LINE 00006691 " -icb    indent closing brace of a code block"
NSQ_SOURCE_LINE 00006692 " -cti=n  closing indentation of paren, square bracket, or non-block brace:"
NSQ_SOURCE_LINE 00006693 "         n=0 none, =1 align with opening, =2 one full indentation level"
NSQ_SOURCE_LINE 00006694 " -icp    equivalent to -cti=2"
NSQ_SOURCE_LINE 00006695 " -wls=s  want space left of tokens in string; i.e. -nwls='+ - * /'"
NSQ_SOURCE_LINE 00006696 " -wrs=s  want space right of tokens in string;"
NSQ_SOURCE_LINE 00006697 " -sts    put space before terminal semicolon of a statement"
NSQ_SOURCE_LINE 00006698 " -sak=s  put space between keywords given in s and '(';"
NSQ_SOURCE_LINE 00006699 " -nsak=s no space between keywords in s and '('; i.e. -nsak='my our local'"
NSQ_SOURCE_LINE 00006700 ""
NSQ_SOURCE_LINE 00006701 "Line Break Control"
NSQ_SOURCE_LINE 00006702 " -fnl    freeze newlines; this disables all line break changes"
NSQ_SOURCE_LINE 00006703 "            and disables the following switches:"
NSQ_SOURCE_LINE 00006704 " -anl    add newlines;  ok to introduce new line breaks"
NSQ_SOURCE_LINE 00006705 " -bbs    add blank line before subs and packages"
NSQ_SOURCE_LINE 00006706 " -bbc    add blank line before block comments"
NSQ_SOURCE_LINE 00006707 " -bbb    add blank line between major blocks"
NSQ_SOURCE_LINE 00006708 " -kbl=n  keep old blank lines? 0=no, 1=some, 2=all"
NSQ_SOURCE_LINE 00006709 " -mbl=n  maximum consecutive blank lines to output (default=1)"
NSQ_SOURCE_LINE 00006710 " -ce     cuddled else; use this style: '} else {'"
NSQ_SOURCE_LINE 00006711 " -cb     cuddled blocks (other than 'if-elsif-else')"
NSQ_SOURCE_LINE 00006712 " -cbl=s  list of blocks to cuddled, default 'try-catch-finally'"
NSQ_SOURCE_LINE 00006713 " -dnl    delete old newlines (default)"
NSQ_SOURCE_LINE 00006714 " -l=n    maximum line length;  default n=80"
NSQ_SOURCE_LINE 00006715 " -bl     opening brace on new line"
NSQ_SOURCE_LINE 00006716 " -sbl    opening sub brace on new line.  value of -bl is used if not given."
NSQ_SOURCE_LINE 00006717 " -bli    opening brace on new line and indented"
NSQ_SOURCE_LINE 00006718 " -bar    opening brace always on right, even for long clauses"
NSQ_SOURCE_LINE 00006719 " -vt=n   vertical tightness (requires -lp); n controls break after opening"
NSQ_SOURCE_LINE 00006720 "         token: 0=never  1=no break if next line balanced   2=no break"
NSQ_SOURCE_LINE 00006721 " -vtc=n  vertical tightness of closing container; n controls if closing"
NSQ_SOURCE_LINE 00006722 "         token starts new line: 0=always  1=not unless list  1=never"
NSQ_SOURCE_LINE 00006723 " -wba=s  want break after tokens in string; i.e. wba=': .'"
NSQ_SOURCE_LINE 00006724 " -wbb=s  want break before tokens in string"
NSQ_SOURCE_LINE 00006725 " -wn     weld nested: combines opening and closing tokens when both are adjacent"
NSQ_SOURCE_LINE 00006726 " -wnxl=s weld nested exclusion list: provides some control over the types of"
NSQ_SOURCE_LINE 00006727 "         containers which can be welded"
NSQ_SOURCE_LINE 00006728 ""
NSQ_SOURCE_LINE 00006729 "Following Old Breakpoints"
NSQ_SOURCE_LINE 00006730 " -kis    keep interior semicolons.  Allows multiple statements per line."
NSQ_SOURCE_LINE 00006731 " -boc    break at old comma breaks: turns off all automatic list formatting"
NSQ_SOURCE_LINE 00006732 " -bol    break at old logical breakpoints: or, and, ||, && (default)"
NSQ_SOURCE_LINE 00006733 " -bom    break at old method call breakpoints: ->"
NSQ_SOURCE_LINE 00006734 " -bok    break at old list keyword breakpoints such as map, sort (default)"
NSQ_SOURCE_LINE 00006735 " -bot    break at old conditional (ternary ?:) operator breakpoints (default)"
NSQ_SOURCE_LINE 00006736 " -boa    break at old attribute breakpoints"
NSQ_SOURCE_LINE 00006737 " -cab=n  break at commas after a comma-arrow (=>):"
NSQ_SOURCE_LINE 00006738 "         n=0 break at all commas after =>"
NSQ_SOURCE_LINE 00006739 "         n=1 stable: break unless this breaks an existing one-line container"
NSQ_SOURCE_LINE 00006740 "         n=2 break only if a one-line container cannot be formed"
NSQ_SOURCE_LINE 00006741 "         n=3 do not treat commas after => specially at all"
NSQ_SOURCE_LINE 00006742 ""
NSQ_SOURCE_LINE 00006743 "Comment controls"
NSQ_SOURCE_LINE 00006744 " -ibc    indent block comments (default)"
NSQ_SOURCE_LINE 00006745 " -isbc   indent spaced block comments; may indent unless no leading space"
NSQ_SOURCE_LINE 00006746 " -msc=n  minimum desired spaces to side comment, default 4"
NSQ_SOURCE_LINE 00006747 " -fpsc=n fix position for side comments; default 0;"
NSQ_SOURCE_LINE 00006748 " -csc    add or update closing side comments after closing BLOCK brace"
NSQ_SOURCE_LINE 00006749 " -dcsc   delete closing side comments created by a -csc command"
NSQ_SOURCE_LINE 00006750 " -cscp=s change closing side comment prefix to be other than '## end'"
NSQ_SOURCE_LINE 00006751 " -cscl=s change closing side comment to apply to selected list of blocks"
NSQ_SOURCE_LINE 00006752 " -csci=n minimum number of lines needed to apply a -csc tag, default n=6"
NSQ_SOURCE_LINE 00006753 " -csct=n maximum number of columns of appended text, default n=20"
NSQ_SOURCE_LINE 00006754 " -cscw   causes warning if old side comment is overwritten with -csc"
NSQ_SOURCE_LINE 00006755 ""
NSQ_SOURCE_LINE 00006756 " -sbc    use 'static block comments' identified by leading '##' (default)"
NSQ_SOURCE_LINE 00006757 " -sbcp=s change static block comment identifier to be other than '##'"
NSQ_SOURCE_LINE 00006758 " -osbc   outdent static block comments"
NSQ_SOURCE_LINE 00006759 ""
NSQ_SOURCE_LINE 00006760 " -ssc    use 'static side comments' identified by leading '##' (default)"
NSQ_SOURCE_LINE 00006761 " -sscp=s change static side comment identifier to be other than '##'"
NSQ_SOURCE_LINE 00006762 ""
NSQ_SOURCE_LINE 00006763 "Delete selected text"
NSQ_SOURCE_LINE 00006764 " -dac    delete all comments AND pod"
NSQ_SOURCE_LINE 00006765 " -dbc    delete block comments"
NSQ_SOURCE_LINE 00006766 " -dsc    delete side comments"
NSQ_SOURCE_LINE 00006767 " -dp     delete pod"
NSQ_SOURCE_LINE 00006768 ""
NSQ_SOURCE_LINE 00006769 "Send selected text to a '.TEE' file"
NSQ_SOURCE_LINE 00006770 " -tac    tee all comments AND pod"
NSQ_SOURCE_LINE 00006771 " -tbc    tee block comments"
NSQ_SOURCE_LINE 00006772 " -tsc    tee side comments"
NSQ_SOURCE_LINE 00006773 " -tp     tee pod"
NSQ_SOURCE_LINE 00006774 ""
NSQ_SOURCE_LINE 00006775 "Outdenting"
NSQ_SOURCE_LINE 00006776 " -olq    outdent long quoted strings (default)"
NSQ_SOURCE_LINE 00006777 " -olc    outdent a long block comment line"
NSQ_SOURCE_LINE 00006778 " -ola    outdent statement labels"
NSQ_SOURCE_LINE 00006779 " -okw    outdent control keywords (redo, next, last, goto, return)"
NSQ_SOURCE_LINE 00006780 " -okwl=s specify alternative keywords for -okw command"
NSQ_SOURCE_LINE 00006781 ""
NSQ_SOURCE_LINE 00006782 "Other controls"
NSQ_SOURCE_LINE 00006783 " -mft=n  maximum fields per table; default n=0 (no limit)"
NSQ_SOURCE_LINE 00006784 " -x      do not format lines before hash-bang line (i.e., for VMS)"
NSQ_SOURCE_LINE 00006785 " -asc    allows perltidy to add a ';' when missing (default)"
NSQ_SOURCE_LINE 00006786 " -dsm    allows perltidy to delete an unnecessary ';'  (default)"
NSQ_SOURCE_LINE 00006787 ""
NSQ_SOURCE_LINE 00006788 "Combinations of other parameters"
NSQ_SOURCE_LINE 00006789 " -gnu     attempt to follow GNU Coding Standards as applied to perl"
NSQ_SOURCE_LINE 00006790 " -mangle  remove as many newlines as possible (but keep comments and pods)"
NSQ_SOURCE_LINE 00006791 " -extrude  insert as many newlines as possible"
NSQ_SOURCE_LINE 00006792 ""
NSQ_SOURCE_LINE 00006793 "Dump and die, debugging"
NSQ_SOURCE_LINE 00006794 " -dop    dump options used in this run to standard output and quit"
NSQ_SOURCE_LINE 00006795 " -ddf    dump default options to standard output and quit"
NSQ_SOURCE_LINE 00006796 " -dsn    dump all option short names to standard output and quit"
NSQ_SOURCE_LINE 00006797 " -dln    dump option long names to standard output and quit"
NSQ_SOURCE_LINE 00006798 " -dpro   dump whatever configuration file is in effect to standard output"
NSQ_SOURCE_LINE 00006799 " -dtt    dump all token types to standard output and quit"
NSQ_SOURCE_LINE 00006800 ""
NSQ_SOURCE_LINE 00006801 "HTML"
NSQ_SOURCE_LINE 00006802 " -html write an html file (see 'man perl2web' for many options)"
NSQ_SOURCE_LINE 00006803 "       Note: when -html is used, no indentation or formatting are done."
NSQ_SOURCE_LINE 00006804 "       Hint: try perltidy -html -css=mystyle.css filename.pl"
NSQ_SOURCE_LINE 00006805 "       and edit mystyle.css to change the appearance of filename.html."
NSQ_SOURCE_LINE 00006806 "       -nnn gives line numbers"
NSQ_SOURCE_LINE 00006807 "       -pre only writes out <pre>..</pre> code section"
NSQ_SOURCE_LINE 00006808 "       -toc places a table of contents to subs at the top (default)"
NSQ_SOURCE_LINE 00006809 "       -pod passes pod text through pod2html (default)"
NSQ_SOURCE_LINE 00006810 "       -frm write html as a frame (3 files)"
NSQ_SOURCE_LINE 00006811 "       -text=s extra extension for table of contents if -frm, default='toc'"
NSQ_SOURCE_LINE 00006812 "       -sext=s extra extension for file content if -frm, default='src'"
NSQ_SOURCE_LINE 00006813 ""
NSQ_SOURCE_LINE 00006814 "A prefix of \"n\" negates short form toggle switches, and a prefix of \"no\""
NSQ_SOURCE_LINE 00006815 "negates the long forms.  For example, -nasc means don't add missing"
NSQ_SOURCE_LINE 00006816 "semicolons."
NSQ_SOURCE_LINE 00006817 ""
NSQ_SOURCE_LINE 00006818 "If you are unable to see this entire text, try \"perltidy -h | more\""
NSQ_SOURCE_LINE 00006819 "For more detailed information, and additional options, try \"man perltidy\","
NSQ_SOURCE_LINE 00006820 "or see https://metacpan.org/pod/distribution/Perl-Tidy/bin/perltidy"
NSQ_SOURCE_LINE 00006821 "EOF"
NSQ_SOURCE_LINE 00006822 ""
NSQ_SOURCE_LINE 00006823 "    return;"
NSQ_SOURCE_LINE 00006824 "} ## end sub usage"
NSQ_SOURCE_LINE 00006825 ""
NSQ_SOURCE_LINE 00006826 "1;"
BODY_END
