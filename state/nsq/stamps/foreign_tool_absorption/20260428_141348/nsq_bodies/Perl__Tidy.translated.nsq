NSQ_SOURCE_LINE 00000096 "@EXPORT = qw( &perltidy );"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "use Cwd;"
NSQ_SOURCE_LINE 00000099 "use Encode ();"
NSQ_SOURCE_LINE 00000100 "use Encode::Guess;"
NSQ_SOURCE_LINE 00000101 "use IO::File;"
NSQ_SOURCE_LINE 00000102 "use File::Basename;"
NSQ_SOURCE_LINE 00000103 "use File::Copy;"
NSQ_SOURCE_LINE 00000104 "use File::Spec ();"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "# perl stat function index names, based on"
NSQ_SOURCE_LINE 00000107 "#    https://perldoc.perl.org/functions/stat"
NSQ_SOURCE_LINE 00000108 "use constant {"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "    _mode_  => 2,    # file mode  (type and permissions)"
NSQ_SOURCE_LINE 00000111 "    _uid_   => 4,    # numeric user ID of file's owner"
NSQ_SOURCE_LINE 00000112 "    _gid_   => 5,    # numeric group ID of file's owner"
NSQ_SOURCE_LINE 00000113 "    _atime_ => 8,    # last access time in seconds since the epoch"
NSQ_SOURCE_LINE 00000114 "    _mtime_ => 9,    # last modify time in seconds since the epoch"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "##  _dev_     => 0,     # device number of filesystem"
NSQ_SOURCE_LINE 00000117 "##  _ino_     => 1,     # inode number"
NSQ_SOURCE_LINE 00000118 "##  _nlink_   => 3,     # number of (hard) links to the file"
NSQ_SOURCE_LINE 00000119 "##  _rdev_    => 6,     # the device identifier (special files only)"
NSQ_SOURCE_LINE 00000120 "##  _size_    => 7,     # total size of file, in bytes"
NSQ_SOURCE_LINE 00000121 "##  _ctime_   => 10,    # inode change time in seconds since the epoch (*)"
NSQ_SOURCE_LINE 00000122 "##  _blksize_ => 11,    # preferred I/O size in bytes for interacting with"
NSQ_SOURCE_LINE 00000123 "##                      # the file (may vary from file to file)"
NSQ_SOURCE_LINE 00000124 "##  _blocks_  => 12,    # actual number of system-specific blocks allocated"
NSQ_SOURCE_LINE 00000125 "##                      # on disk (often, but not always, 512 bytes each)"
NSQ_SOURCE_LINE 00000126 "};"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "BEGIN {"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "    # Release version is the approximate YYYYMMDD of the release."
NSQ_SOURCE_LINE 00000131 "    # Development version is (Last Release).(Development Number)"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "    # To make the number continually increasing, the Development Number is a 2"
NSQ_SOURCE_LINE 00000134 "    # digit number starting at 01 after a release. It is continually bumped"
NSQ_SOURCE_LINE 00000135 "    # along at significant points during development. If it ever reaches 99"
NSQ_SOURCE_LINE 00000136 "    # then the Release version must be bumped, and it is probably past time for"
NSQ_SOURCE_LINE 00000137 "    # a release anyway."
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "    $VERSION = '20260204';"
NSQ_SOURCE_LINE 00000140 "} ## end BEGIN"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "{"
NSQ_SOURCE_LINE 00000143 "    # List of hash keys to prevent -duk from listing them."
NSQ_SOURCE_LINE 00000144 "    my @unique_hash_keys_uu = qw("
NSQ_SOURCE_LINE 00000145 "      *"
NSQ_SOURCE_LINE 00000146 "      html-src-extension"
NSQ_SOURCE_LINE 00000147 "      html-toc-extension"
NSQ_SOURCE_LINE 00000148 "      allow_module_path"
NSQ_SOURCE_LINE 00000149 "    );"
NSQ_SOURCE_LINE 00000150 "}"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "sub DESTROY {"
NSQ_SOURCE_LINE 00000153 "    my $self = shift;"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "    # required to avoid call to AUTOLOAD in some versions of perl"
NSQ_SOURCE_LINE 00000156 "    return;"
NSQ_SOURCE_LINE 00000157 "} ## end sub DESTROY"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "sub AUTOLOAD {"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "    # Catch any undefined sub calls so that we are sure to get"
NSQ_SOURCE_LINE 00000162 "    # some diagnostic information.  This sub should never be called"
NSQ_SOURCE_LINE 00000163 "    # except for a programming error."
NSQ_SOURCE_LINE 00000164 "    our $AUTOLOAD;"
NSQ_SOURCE_LINE 00000165 "    return if ( $AUTOLOAD =~ /\\bDESTROY$/ );"
NSQ_SOURCE_LINE 00000166 "    my ( $pkg, $fname, $lno ) = caller();"
NSQ_SOURCE_LINE 00000167 "    print {*STDERR} <<EOM;"
NSQ_SOURCE_LINE 00000168 "======================================================================"
NSQ_SOURCE_LINE 00000169 "Unexpected call to Autoload looking for sub $AUTOLOAD"
NSQ_SOURCE_LINE 00000170 "Called from package: '$pkg'"
NSQ_SOURCE_LINE 00000171 "Called from File '$fname'  at line '$lno'"
NSQ_SOURCE_LINE 00000172 "This error is probably due to a recent programming change"
NSQ_SOURCE_LINE 00000173 "======================================================================"
NSQ_SOURCE_LINE 00000174 "EOM"
NSQ_SOURCE_LINE 00000175 "    exit 1;"
NSQ_SOURCE_LINE 00000176 "} ## end sub AUTOLOAD"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "sub streamhandle {"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "    my ( $filename, $mode, ($is_encoded_data) ) = @_;"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "    # Given:"
NSQ_SOURCE_LINE 00000183 "    #   $filename"
NSQ_SOURCE_LINE 00000184 "    #   $mode = 'r' or 'w' (only 'w' is used now, see note below)"
NSQ_SOURCE_LINE 00000185 "    #   $is_encoded_data (optional flag)"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "    # Create an object which:"
NSQ_SOURCE_LINE 00000188 "    #   has a 'getline' method if mode='r', and"
NSQ_SOURCE_LINE 00000189 "    #   has a 'print' method if mode='w'."
NSQ_SOURCE_LINE 00000190 "    # The objects also need a 'close' method."
NSQ_SOURCE_LINE 00000191 "    #"
NSQ_SOURCE_LINE 00000192 "    # How the object is made:"
NSQ_SOURCE_LINE 00000193 "    #"
NSQ_SOURCE_LINE 00000194 "    # if $filename is:     Make object using:"
NSQ_SOURCE_LINE 00000195 "    # ----------------     -----------------"
NSQ_SOURCE_LINE 00000196 "    # '-'                  (STDIN if mode = 'r', STDOUT if mode='w')"
NSQ_SOURCE_LINE 00000197 "    # string               IO::File"
NSQ_SOURCE_LINE 00000198 "    # ARRAY  ref           Perl::Tidy::IOScalarArray (formerly IO::ScalarArray)"
NSQ_SOURCE_LINE 00000199 "    # STRING ref           Perl::Tidy::IOScalar      (formerly IO::Scalar)"
NSQ_SOURCE_LINE 00000200 "    # object               object"
NSQ_SOURCE_LINE 00000201 "    #                      (check for 'print' method for 'w' mode)"
NSQ_SOURCE_LINE 00000202 "    #                      (check for 'getline' method for 'r' mode)"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "    # An optional flag '$is_encoded_data' may be given, as follows:"
NSQ_SOURCE_LINE 00000205 "    # - true: encoded data is being transferred,"
NSQ_SOURCE_LINE 00000206 "    #    set encoding to be utf8 for files and for stdin."
NSQ_SOURCE_LINE 00000207 "    # - false: unencoded binary data is being transferred,"
NSQ_SOURCE_LINE 00000208 "    #    set binary mode for files and for stdin."
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "    # NOTE: mode 'r' works but is no longer used."
NSQ_SOURCE_LINE 00000211 "    # Use sub stream_slurp instead for mode 'r', for efficiency."
NSQ_SOURCE_LINE 00000212 "    $mode = lc($mode);"
NSQ_SOURCE_LINE 00000213 "    if ( $mode ne 'w' ) {"
NSQ_SOURCE_LINE 00000214 "        if ( DEVEL_MODE || $mode ne 'r' ) {"
NSQ_SOURCE_LINE 00000215 "            Fault(\"streamhandle called in unexpected mode '$mode'\\n\");"
NSQ_SOURCE_LINE 00000216 "        }"
NSQ_SOURCE_LINE 00000217 "    }"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "    my $ref = ref($filename);"
NSQ_SOURCE_LINE 00000220 "    my $New;"
NSQ_SOURCE_LINE 00000221 "    my $fh;"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "    #-------------------"
NSQ_SOURCE_LINE 00000224 "    # handle a reference"
NSQ_SOURCE_LINE 00000225 "    #-------------------"
NSQ_SOURCE_LINE 00000226 "    if ($ref) {"
NSQ_SOURCE_LINE 00000227 "        if ( $ref eq 'ARRAY' ) {"
NSQ_SOURCE_LINE 00000228 "            $New = sub { Perl::Tidy::IOScalarArray->new( $filename, $mode ) };"
NSQ_SOURCE_LINE 00000229 "        }"
NSQ_SOURCE_LINE 00000230 "        elsif ( $ref eq 'SCALAR' ) {"
NSQ_SOURCE_LINE 00000231 "            $New = sub { Perl::Tidy::IOScalar->new( $filename, $mode ) };"
NSQ_SOURCE_LINE 00000232 "        }"
NSQ_SOURCE_LINE 00000233 "        else {"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "            # Accept an object with a getline method for reading. Note:"
NSQ_SOURCE_LINE 00000236 "            # IO::File is built-in and does not respond to the defined"
NSQ_SOURCE_LINE 00000237 "            # operator.  If this causes trouble, the check can be"
NSQ_SOURCE_LINE 00000238 "            # skipped and we can just let it crash if there is no"
NSQ_SOURCE_LINE 00000239 "            # getline."
NSQ_SOURCE_LINE 00000240 "            if ( $mode eq 'r' ) {"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "                # RT#97159; part 1 of 2: updated to use 'can'"
NSQ_SOURCE_LINE 00000243 "                if ( $ref->can('getline') ) {"
NSQ_SOURCE_LINE 00000244 "                    $New = sub { $filename };"
NSQ_SOURCE_LINE 00000245 "                }"
NSQ_SOURCE_LINE 00000246 "                else {"
NSQ_SOURCE_LINE 00000247 "                    $New = sub { undef };"
NSQ_SOURCE_LINE 00000248 "                    confess <<EOM;"
NSQ_SOURCE_LINE 00000249 "------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000250 "No 'getline' method is defined for object of class '$ref'"
NSQ_SOURCE_LINE 00000251 "Please check your call to Perl::Tidy::perltidy.  Trace follows."
NSQ_SOURCE_LINE 00000252 "------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000253 "EOM"
NSQ_SOURCE_LINE 00000254 "                }"
NSQ_SOURCE_LINE 00000255 "            }"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "            # Accept an object with a print method for writing."
NSQ_SOURCE_LINE 00000258 "            # See note above about IO::File"
NSQ_SOURCE_LINE 00000259 "            if ( $mode eq 'w' ) {"
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "                # RT#97159; part 2 of 2: updated to use 'can'"
NSQ_SOURCE_LINE 00000262 "                if ( $ref->can('print') ) {"
NSQ_SOURCE_LINE 00000263 "                    $New = sub { $filename };"
NSQ_SOURCE_LINE 00000264 "                }"
NSQ_SOURCE_LINE 00000265 "                else {"
NSQ_SOURCE_LINE 00000266 "                    $New = sub { undef };"
NSQ_SOURCE_LINE 00000267 "                    confess <<EOM;"
NSQ_SOURCE_LINE 00000268 "------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000269 "No 'print' method is defined for object of class '$ref'"
NSQ_SOURCE_LINE 00000270 "Please check your call to Perl::Tidy::perltidy. Trace follows."
NSQ_SOURCE_LINE 00000271 "------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000272 "EOM"
NSQ_SOURCE_LINE 00000273 "                }"
NSQ_SOURCE_LINE 00000274 "            }"
NSQ_SOURCE_LINE 00000275 "        }"
NSQ_SOURCE_LINE 00000276 "    }"
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "    #----------------"
NSQ_SOURCE_LINE 00000279 "    # handle a string"
NSQ_SOURCE_LINE 00000280 "    #----------------"
NSQ_SOURCE_LINE 00000281 "    else {"
NSQ_SOURCE_LINE 00000282 "        if ( $filename eq '-' ) {"
NSQ_SOURCE_LINE 00000283 "            $New = sub { $mode eq 'w' ? *STDOUT : *STDIN }"
NSQ_SOURCE_LINE 00000284 "        }"
NSQ_SOURCE_LINE 00000285 "        else {"
NSQ_SOURCE_LINE 00000286 "            $New = sub { IO::File->new( $filename, $mode ) };"
NSQ_SOURCE_LINE 00000287 "        }"
NSQ_SOURCE_LINE 00000288 "    }"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "    #--------------"
NSQ_SOURCE_LINE 00000291 "    # Open the file"
NSQ_SOURCE_LINE 00000292 "    #--------------"
NSQ_SOURCE_LINE 00000293 "    $fh = $New->( $filename, $mode );"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "    if ( !$fh ) {"
NSQ_SOURCE_LINE 00000296 "        Warn(\"Couldn't open file:'$filename' in mode:$mode : $OS_ERROR\\n\");"
NSQ_SOURCE_LINE 00000297 "    }"
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "    #------------"
NSQ_SOURCE_LINE 00000300 "    # Set binmode"
NSQ_SOURCE_LINE 00000301 "    #------------"
NSQ_SOURCE_LINE 00000302 "    else {"
NSQ_SOURCE_LINE 00000303 "        if ( ref($fh) eq 'IO::File' ) {"
NSQ_SOURCE_LINE 00000304 "            ## binmode object call not available in older perl versions"
NSQ_SOURCE_LINE 00000305 "            ## $fh->binmode(\":raw:encoding(UTF-8)\");"
NSQ_SOURCE_LINE 00000306 "            if ($is_encoded_data) { binmode $fh, \":raw:encoding(UTF-8)\"; }"
NSQ_SOURCE_LINE 00000307 "            else                  { binmode $fh }"
NSQ_SOURCE_LINE 00000308 "        }"
NSQ_SOURCE_LINE 00000309 "        elsif ( $filename eq '-' ) {"
NSQ_SOURCE_LINE 00000310 "            if ($is_encoded_data) { binmode STDOUT, \":raw:encoding(UTF-8)\"; }"
NSQ_SOURCE_LINE 00000311 "            else                  { binmode STDOUT }"
NSQ_SOURCE_LINE 00000312 "        }"
NSQ_SOURCE_LINE 00000313 "        else {"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "            # shouldn't get here"
NSQ_SOURCE_LINE 00000316 "            if (DEVEL_MODE) {"
NSQ_SOURCE_LINE 00000317 "                my $ref_fh = ref($fh);"
NSQ_SOURCE_LINE 00000318 "                Fault(<<EOM);"
NSQ_SOURCE_LINE 00000319 "unexpected streamhandle state for file='$filename' mode='$mode' ref(fh)=$ref_fh"
NSQ_SOURCE_LINE 00000320 "EOM"
NSQ_SOURCE_LINE 00000321 "            }"
NSQ_SOURCE_LINE 00000322 "        }"
NSQ_SOURCE_LINE 00000323 "    }"
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "    return $fh;"
NSQ_SOURCE_LINE 00000326 "} ## end sub streamhandle"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "sub stream_slurp {"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "    my ( $filename, ($timeout_in_seconds) ) = @_;"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "    # Given:"
NSQ_SOURCE_LINE 00000333 "    #   $filename"
NSQ_SOURCE_LINE 00000334 "    #   $timeout_in_seconds (optional timeout, in seconds)"
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "    # Read the text in $filename and"
NSQ_SOURCE_LINE 00000337 "    # return:"
NSQ_SOURCE_LINE 00000338 "    #    undef if read error, or"
NSQ_SOURCE_LINE 00000339 "    #    $rinput_string = ref to string of text"
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "    # if $filename is:     Read"
NSQ_SOURCE_LINE 00000342 "    # ----------------     -----------------"
NSQ_SOURCE_LINE 00000343 "    # ARRAY  ref           array ref"
NSQ_SOURCE_LINE 00000344 "    # SCALAR ref           string ref"
NSQ_SOURCE_LINE 00000345 "    # object ref           object with 'getline' method (exit if no 'getline')"
NSQ_SOURCE_LINE 00000346 "    # '-'                  STDIN"
NSQ_SOURCE_LINE 00000347 "    # string               file named $filename"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "    # Note that any decoding from utf8 must be done by the caller"
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "    my $ref = ref($filename);"
NSQ_SOURCE_LINE 00000352 "    my $rinput_string;"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "    # handle a reference"
NSQ_SOURCE_LINE 00000355 "    if ($ref) {"
NSQ_SOURCE_LINE 00000356 "        if ( $ref eq 'ARRAY' ) {"
NSQ_SOURCE_LINE 00000357 "            my $buf = join EMPTY_STRING, @{$filename};"
NSQ_SOURCE_LINE 00000358 "            $rinput_string = \\$buf;"
NSQ_SOURCE_LINE 00000359 "        }"
NSQ_SOURCE_LINE 00000360 "        elsif ( $ref eq 'SCALAR' ) {"
NSQ_SOURCE_LINE 00000361 "            $rinput_string = $filename;"
NSQ_SOURCE_LINE 00000362 "        }"
NSQ_SOURCE_LINE 00000363 "        else {"
NSQ_SOURCE_LINE 00000364 "            if ( $ref->can('getline') ) {"
NSQ_SOURCE_LINE 00000365 "                my $buf = EMPTY_STRING;"
NSQ_SOURCE_LINE 00000366 "                while ( defined( my $line = $filename->getline() ) ) {"
NSQ_SOURCE_LINE 00000367 "                    $buf .= $line;"
NSQ_SOURCE_LINE 00000368 "                }"
NSQ_SOURCE_LINE 00000369 "                $rinput_string = \\$buf;"
NSQ_SOURCE_LINE 00000370 "            }"
NSQ_SOURCE_LINE 00000371 "            else {"
NSQ_SOURCE_LINE 00000372 "                confess <<EOM;"
NSQ_SOURCE_LINE 00000373 "------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000374 "No 'getline' method is defined for object of class '$ref'"
NSQ_SOURCE_LINE 00000375 "Please check your call to Perl::Tidy::perltidy.  Trace follows."
NSQ_SOURCE_LINE 00000376 "------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000377 "EOM"
NSQ_SOURCE_LINE 00000378 "            }"
NSQ_SOURCE_LINE 00000379 "        }"
NSQ_SOURCE_LINE 00000380 "    }"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "    # handle a string"
NSQ_SOURCE_LINE 00000383 "    else {"
NSQ_SOURCE_LINE 00000384 "        if ( $filename eq '-' ) {"
NSQ_SOURCE_LINE 00000385 "            local $INPUT_RECORD_SEPARATOR = undef;"
NSQ_SOURCE_LINE 00000386 "            my $buf;"
NSQ_SOURCE_LINE 00000387 "            if ( $timeout_in_seconds && $timeout_in_seconds > 0 ) {"
NSQ_SOURCE_LINE 00000388 "                eval {"
NSQ_SOURCE_LINE 00000389 "                    local $SIG{ALRM} = sub { die \"alarm\\n\" };"
NSQ_SOURCE_LINE 00000390 "                    alarm($timeout_in_seconds);"
NSQ_SOURCE_LINE 00000391 "                    $buf = <>;"
NSQ_SOURCE_LINE 00000392 "                    alarm(0);"
NSQ_SOURCE_LINE 00000393 "                    1;"
NSQ_SOURCE_LINE 00000394 "                }"
NSQ_SOURCE_LINE 00000395 "                  or Die("
NSQ_SOURCE_LINE 00000396 "\"Timeout reading stdin using -tos=$timeout_in_seconds seconds. Use -tos=0 to skip timeout check.\\n\""
NSQ_SOURCE_LINE 00000397 "                  );"
NSQ_SOURCE_LINE 00000398 "            }"
NSQ_SOURCE_LINE 00000399 "            else {"
NSQ_SOURCE_LINE 00000400 "                $buf = <>;"
NSQ_SOURCE_LINE 00000401 "            }"
NSQ_SOURCE_LINE 00000402 "            $rinput_string = \\$buf;"
NSQ_SOURCE_LINE 00000403 "        }"
NSQ_SOURCE_LINE 00000404 "        else {"
NSQ_SOURCE_LINE 00000405 "            if ( open( my $fh, '<', $filename ) ) {"
NSQ_SOURCE_LINE 00000406 "                local $INPUT_RECORD_SEPARATOR = undef;"
NSQ_SOURCE_LINE 00000407 "                my $buf = <$fh>;"
NSQ_SOURCE_LINE 00000408 "                $fh->close() or Warn(\"Cannot close $filename\\n\");"
NSQ_SOURCE_LINE 00000409 "                $rinput_string = \\$buf;"
NSQ_SOURCE_LINE 00000410 "            }"
NSQ_SOURCE_LINE 00000411 "            else {"
NSQ_SOURCE_LINE 00000412 "                Warn(\"Cannot open $filename: $OS_ERROR\\n\");"
NSQ_SOURCE_LINE 00000413 "                return;"
NSQ_SOURCE_LINE 00000414 "            }"
NSQ_SOURCE_LINE 00000415 "        }"
NSQ_SOURCE_LINE 00000416 "    }"
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 "    return $rinput_string;"
NSQ_SOURCE_LINE 00000419 "} ## end sub stream_slurp"
NSQ_SOURCE_LINE 00000420 ""
NSQ_SOURCE_LINE 00000421 "# Here is a map of the flow of data from the input source to the output"
NSQ_SOURCE_LINE 00000422 "# line sink:"
NSQ_SOURCE_LINE 00000423 "#"
NSQ_SOURCE_LINE 00000424 "#             -->Tokenizer-->Formatter-->VerticalAligner-->FileWriter-->"
NSQ_SOURCE_LINE 00000425 "#       input                         groups                 output"
NSQ_SOURCE_LINE 00000426 "#       lines   tokens      lines       of          lines    lines"
NSQ_SOURCE_LINE 00000427 "#                                      lines"
NSQ_SOURCE_LINE 00000428 "#"
NSQ_SOURCE_LINE 00000429 "# The names correspond to the package names responsible for the unit processes."
NSQ_SOURCE_LINE 00000430 "#"
NSQ_SOURCE_LINE 00000431 "# The overall process is controlled by the \"main\" package."
NSQ_SOURCE_LINE 00000432 "#"
NSQ_SOURCE_LINE 00000433 "# Tokenizer analyzes a line and breaks it into tokens, peeking ahead"
NSQ_SOURCE_LINE 00000434 "# if necessary.  A token is any section of the input line which should be"
NSQ_SOURCE_LINE 00000435 "# manipulated as a single entity during formatting.  For example, a single"
NSQ_SOURCE_LINE 00000436 "# ',' character is a token, and so is an entire side comment.  It handles"
NSQ_SOURCE_LINE 00000437 "# the complexities of Perl syntax, such as distinguishing between '<<' as"
NSQ_SOURCE_LINE 00000438 "# a shift operator and as a here-document, or distinguishing between '/'"
NSQ_SOURCE_LINE 00000439 "# as a divide symbol and as a pattern delimiter."
NSQ_SOURCE_LINE 00000440 "#"
NSQ_SOURCE_LINE 00000441 "# Formatter inserts and deletes whitespace between tokens, and breaks"
NSQ_SOURCE_LINE 00000442 "# sequences of tokens at appropriate points as output lines.  It bases its"
NSQ_SOURCE_LINE 00000443 "# decisions on the default rules as modified by any command-line options."
NSQ_SOURCE_LINE 00000444 "#"
NSQ_SOURCE_LINE 00000445 "# VerticalAligner collects groups of lines together and tries to line up"
NSQ_SOURCE_LINE 00000446 "# certain tokens, such as '=>', '#', and '=' by adding whitespace."
NSQ_SOURCE_LINE 00000447 "#"
NSQ_SOURCE_LINE 00000448 "# FileWriter simply writes lines to the output stream."
NSQ_SOURCE_LINE 00000449 "#"
NSQ_SOURCE_LINE 00000450 "# The Logger package, not shown, records significant events and warning"
NSQ_SOURCE_LINE 00000451 "# messages.  It writes a .LOG file, which may be saved with a"
NSQ_SOURCE_LINE 00000452 "# '-log' or a '-g' flag."
NSQ_SOURCE_LINE 00000453 ""
NSQ_SOURCE_LINE 00000454 "{ #<<<  (this side comment avoids excessive indentation in a closure)"
NSQ_SOURCE_LINE 00000455 ""
NSQ_SOURCE_LINE 00000456 "my $Warn_count;"
NSQ_SOURCE_LINE 00000457 "my $fh_stderr;"
NSQ_SOURCE_LINE 00000458 "my $loaded_unicode_gcstring;"
NSQ_SOURCE_LINE 00000459 "my $rstatus;"
NSQ_SOURCE_LINE 00000460 "my $nag_message;"
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 "sub get_input_stream_name {"
NSQ_SOURCE_LINE 00000463 ""
NSQ_SOURCE_LINE 00000464 "    # Make input stream name available for Fault calls"
NSQ_SOURCE_LINE 00000465 "    my $display_name      = $rstatus->{'input_name'};"
NSQ_SOURCE_LINE 00000466 "    my $input_stream_name = $display_name ? $display_name : \"??\";"
NSQ_SOURCE_LINE 00000467 "    return $input_stream_name;"
NSQ_SOURCE_LINE 00000468 "} ## end sub get_input_stream_name"
NSQ_SOURCE_LINE 00000469 ""
NSQ_SOURCE_LINE 00000470 "# Flush any accumulated nag message(s) if possible"
NSQ_SOURCE_LINE 00000471 "sub nag_flush {"
NSQ_SOURCE_LINE 00000472 "    my ($fh) = @_;"
NSQ_SOURCE_LINE 00000473 "    if ( length($nag_message) && $Warn_count > 0 ) {"
NSQ_SOURCE_LINE 00000474 "        $fh->print($nag_message);"
NSQ_SOURCE_LINE 00000475 "        $nag_message = EMPTY_STRING;"
NSQ_SOURCE_LINE 00000476 "    }"
NSQ_SOURCE_LINE 00000477 "    return;"
NSQ_SOURCE_LINE 00000478 "} ## end sub nag_flush"
NSQ_SOURCE_LINE 00000479 ""
NSQ_SOURCE_LINE 00000480 "# Accept a warning message that will only go out if regular warnings also go"
NSQ_SOURCE_LINE 00000481 "# out.  This is useful when we want to output a non-critical error message, but"
NSQ_SOURCE_LINE 00000482 "# only if another regular error message goes out, so that test runs do not fail"
NSQ_SOURCE_LINE 00000483 "# on unimportant issues, but that the user eventually gets to see the issue."
NSQ_SOURCE_LINE 00000484 "# For example, we might want to inform the user that a certain parameter in his"
NSQ_SOURCE_LINE 00000485 "# perltidyrc will be deprecated, but do not want that to cause a test to fail."
NSQ_SOURCE_LINE 00000486 "sub Nag {"
NSQ_SOURCE_LINE 00000487 "    my $msg = shift;"
NSQ_SOURCE_LINE 00000488 "    $nag_message .= $msg;"
NSQ_SOURCE_LINE 00000489 "    nag_flush($fh_stderr);"
NSQ_SOURCE_LINE 00000490 "    return;"
NSQ_SOURCE_LINE 00000491 "} ## end sub Nag"
NSQ_SOURCE_LINE 00000492 ""
NSQ_SOURCE_LINE 00000493 "# Bump Warn_count only: it is essential to bump the count on all warnings, even"
NSQ_SOURCE_LINE 00000494 "# if no message goes out, so that the correct exit status is set."
NSQ_SOURCE_LINE 00000495 "sub Warn_count_bump { $Warn_count++; return }"
NSQ_SOURCE_LINE 00000496 ""
NSQ_SOURCE_LINE 00000497 "# Output Warn message"
NSQ_SOURCE_LINE 00000498 "sub Warn_msg {"
NSQ_SOURCE_LINE 00000499 "    my $msg = shift;"
NSQ_SOURCE_LINE 00000500 "    $fh_stderr->print($msg);"
NSQ_SOURCE_LINE 00000501 "    nag_flush($fh_stderr);"
NSQ_SOURCE_LINE 00000502 "    return;"
NSQ_SOURCE_LINE 00000503 "} ## end sub Warn_msg"
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "# Bump Warn count and output Warn message"
NSQ_SOURCE_LINE 00000506 "sub Warn { my $msg = shift; $Warn_count++; Warn_msg($msg); return }"
NSQ_SOURCE_LINE 00000507 ""
NSQ_SOURCE_LINE 00000508 "sub Exit {"
NSQ_SOURCE_LINE 00000509 "    my $flag = shift;"
NSQ_SOURCE_LINE 00000510 "    if   ($flag) { goto ERROR_EXIT }"
NSQ_SOURCE_LINE 00000511 "    else         { goto NORMAL_EXIT }"
NSQ_SOURCE_LINE 00000512 "    croak \"unexpected return to sub Exit\";"
NSQ_SOURCE_LINE 00000513 "} ## end sub Exit"
NSQ_SOURCE_LINE 00000514 ""
NSQ_SOURCE_LINE 00000515 "sub Die {"
NSQ_SOURCE_LINE 00000516 "    my $msg = shift;"
NSQ_SOURCE_LINE 00000517 "    Warn($msg);"
NSQ_SOURCE_LINE 00000518 "    Exit(1);"
NSQ_SOURCE_LINE 00000519 "    croak \"unexpected return from sub Exit\";"
NSQ_SOURCE_LINE 00000520 "} ## end sub Die"
NSQ_SOURCE_LINE 00000521 ""
NSQ_SOURCE_LINE 00000522 "sub Fault {"
NSQ_SOURCE_LINE 00000523 "    my ($msg) = @_;"
NSQ_SOURCE_LINE 00000524 ""
NSQ_SOURCE_LINE 00000525 "    # This routine is called for errors that really should not occur"
NSQ_SOURCE_LINE 00000526 "    # except if there has been a bug introduced by a recent program change."
NSQ_SOURCE_LINE 00000527 "    # Please add comments at calls to Fault to explain why the call"
NSQ_SOURCE_LINE 00000528 "    # should not occur, and where to look to fix it."
NSQ_SOURCE_LINE 00000529 "    my ( $package0_uu, $filename0_uu, $line0, $subroutine0_uu ) = caller(0);"
NSQ_SOURCE_LINE 00000530 "    my ( $package1_uu, $filename1, $line1, $subroutine1 )       = caller(1);"
NSQ_SOURCE_LINE 00000531 "    my ( $package2_uu, $filename2_uu, $line2_uu, $subroutine2 ) = caller(2);"
NSQ_SOURCE_LINE 00000532 "    my $pkg               = __PACKAGE__;"
NSQ_SOURCE_LINE 00000533 "    my $input_stream_name = get_input_stream_name();"
NSQ_SOURCE_LINE 00000534 ""
NSQ_SOURCE_LINE 00000535 "    Die(<<EOM);"
NSQ_SOURCE_LINE 00000536 "=============================================================================="
NSQ_SOURCE_LINE 00000537 "While operating on input stream with name: '$input_stream_name'"
NSQ_SOURCE_LINE 00000538 "A fault was detected at line $line0 of sub '$subroutine1'"
NSQ_SOURCE_LINE 00000539 "in file '$filename1'"
NSQ_SOURCE_LINE 00000540 "which was called from line $line1 of sub '$subroutine2'"
NSQ_SOURCE_LINE 00000541 "Message: '$msg'"
NSQ_SOURCE_LINE 00000542 "This is probably an error introduced by a recent programming change."
NSQ_SOURCE_LINE 00000543 "$pkg reports VERSION='$VERSION'."
NSQ_SOURCE_LINE 00000544 "=============================================================================="
NSQ_SOURCE_LINE 00000545 "EOM"
NSQ_SOURCE_LINE 00000546 ""
NSQ_SOURCE_LINE 00000547 "    croak \"unexpected return from sub Die\";"
NSQ_SOURCE_LINE 00000548 "} ## end sub Fault"
NSQ_SOURCE_LINE 00000549 ""
NSQ_SOURCE_LINE 00000550 "sub is_char_mode {"
NSQ_SOURCE_LINE 00000551 ""
NSQ_SOURCE_LINE 00000552 "    my ($string) = @_;"
NSQ_SOURCE_LINE 00000553 ""
NSQ_SOURCE_LINE 00000554 "    # Returns:"
NSQ_SOURCE_LINE 00000555 "    #   true  if $string is in Perl's internal character mode"
NSQ_SOURCE_LINE 00000556 "    #         (also called the 'upgraded form', or UTF8=1)"
NSQ_SOURCE_LINE 00000557 "    #   false if $string is in Perl's internal byte mode"
NSQ_SOURCE_LINE 00000558 ""
NSQ_SOURCE_LINE 00000559 "    # This function isolates the call to Perl's internal function"
NSQ_SOURCE_LINE 00000560 "    # utf8::is_utf8() which is true for strings represented in an 'upgraded"
NSQ_SOURCE_LINE 00000561 "    # form'. It is available AFTER Perl version 5.8."
NSQ_SOURCE_LINE 00000562 "    # See https://perldoc.perl.org/Encode."
NSQ_SOURCE_LINE 00000563 "    # See also comments in Carp.pm and other modules using this function"
NSQ_SOURCE_LINE 00000564 ""
NSQ_SOURCE_LINE 00000565 "    return 1 if ( utf8::is_utf8($string) );"
NSQ_SOURCE_LINE 00000566 "    return;"
NSQ_SOURCE_LINE 00000567 "} ## end sub is_char_mode"
NSQ_SOURCE_LINE 00000568 ""
NSQ_SOURCE_LINE 00000569 "my $md5_hex = sub {"
NSQ_SOURCE_LINE 00000570 "    my ($buf) = @_;"
NSQ_SOURCE_LINE 00000571 ""
NSQ_SOURCE_LINE 00000572 "    # Evaluate the MD5 sum for a string:"
NSQ_SOURCE_LINE 00000573 "    # Given:"
NSQ_SOURCE_LINE 00000574 "    #   $buf = a string"
NSQ_SOURCE_LINE 00000575 "    # Return:"
NSQ_SOURCE_LINE 00000576 "    #   $digest = its MD5 sum"
NSQ_SOURCE_LINE 00000577 "    my $octets = Encode::encode( \"utf8\", $buf );"
NSQ_SOURCE_LINE 00000578 "    my $digest = md5_hex($octets);"
NSQ_SOURCE_LINE 00000579 "    return $digest;"
NSQ_SOURCE_LINE 00000580 "}; ## end $md5_hex = sub"
NSQ_SOURCE_LINE 00000581 ""
NSQ_SOURCE_LINE 00000582 "sub get_iteration_count {"
NSQ_SOURCE_LINE 00000583 "    return $rstatus->{iteration_count};"
NSQ_SOURCE_LINE 00000584 "}"
NSQ_SOURCE_LINE 00000585 ""
NSQ_SOURCE_LINE 00000586 "sub check_for_valid_words {"
NSQ_SOURCE_LINE 00000587 ""
NSQ_SOURCE_LINE 00000588 "    my ($rcall_hash) = @_;"
NSQ_SOURCE_LINE 00000589 ""
NSQ_SOURCE_LINE 00000590 "    # Given hash ref with these keys:"
NSQ_SOURCE_LINE 00000591 "    #   rinput_list = ref to ARRAY of possible words"
NSQ_SOURCE_LINE 00000592 "    #   option_name  =  name of option to use for a warn or die message"
NSQ_SOURCE_LINE 00000593 "    #                   (caller should add leading dash(es))"
NSQ_SOURCE_LINE 00000594 "    #   on_error ="
NSQ_SOURCE_LINE 00000595 "    #               'warn'  ? call Warn and return ref to unknown words"
NSQ_SOURCE_LINE 00000596 "    #             : 'die'   ? call Die"
NSQ_SOURCE_LINE 00000597 "    #             :         return ref to list of unknown words"
NSQ_SOURCE_LINE 00000598 "    #   allow_module_path = true if words can have module paths with '::'"
NSQ_SOURCE_LINE 00000599 "    #   rexceptions   = optional ref to ARRAY or HASH of acceptable non-words"
NSQ_SOURCE_LINE 00000600 "    #   rvalid_words  = optional ref to ARRAY or HASH of acceptable words"
NSQ_SOURCE_LINE 00000601 "    #      - if given, only words in this list, or rexceptions, are valid"
NSQ_SOURCE_LINE 00000602 "    #      - if not given, words must be identifier-like or be in rexceptions"
NSQ_SOURCE_LINE 00000603 ""
NSQ_SOURCE_LINE 00000604 "    # Return (if it does not call Die):"
NSQ_SOURCE_LINE 00000605 "    #   - nothing if no errors, or"
NSQ_SOURCE_LINE 00000606 "    #   - ref to list of unknown words"
NSQ_SOURCE_LINE 00000607 ""
NSQ_SOURCE_LINE 00000608 "    if ( !defined($rcall_hash) ) {"
NSQ_SOURCE_LINE 00000609 "        Fault(\"received undefined arg\\n\");"
NSQ_SOURCE_LINE 00000610 "        return;"
NSQ_SOURCE_LINE 00000611 "    }"
NSQ_SOURCE_LINE 00000612 ""
NSQ_SOURCE_LINE 00000613 "    my $rinput_list       = $rcall_hash->{rinput_list};"
NSQ_SOURCE_LINE 00000614 "    my $option_name       = $rcall_hash->{option_name};"
NSQ_SOURCE_LINE 00000615 "    my $on_error          = $rcall_hash->{on_error};"
NSQ_SOURCE_LINE 00000616 "    my $allow_module_path = $rcall_hash->{allow_module_path};"
NSQ_SOURCE_LINE 00000617 "    my $rexceptions       = $rcall_hash->{rexceptions};"
NSQ_SOURCE_LINE 00000618 "    my $rvalid_words      = $rcall_hash->{rvalid_words};"
NSQ_SOURCE_LINE 00000619 ""
NSQ_SOURCE_LINE 00000620 "    return if ( !defined($rinput_list) );"
NSQ_SOURCE_LINE 00000621 "    my $msg_end = $option_name ? \" with $option_name\" : EMPTY_STRING;"
NSQ_SOURCE_LINE 00000622 ""
NSQ_SOURCE_LINE 00000623 "    my $make_hash_ref = sub {"
NSQ_SOURCE_LINE 00000624 "        my ( $rthing, $key_name ) = @_;"
NSQ_SOURCE_LINE 00000625 ""
NSQ_SOURCE_LINE 00000626 "        # If user supplied an array ref, make a corresponding hash ref"
NSQ_SOURCE_LINE 00000627 ""
NSQ_SOURCE_LINE 00000628 "        if ( defined($rthing) ) {"
NSQ_SOURCE_LINE 00000629 "            my $ref = ref($rthing);"
NSQ_SOURCE_LINE 00000630 "            if ( !$ref ) {"
NSQ_SOURCE_LINE 00000631 "                Fault(\"expecting {$key_name} to be a ref in call '$msg_end'\\n\");"
NSQ_SOURCE_LINE 00000632 "            }"
NSQ_SOURCE_LINE 00000633 "            if ( $ref eq 'ARRAY' ) {"
NSQ_SOURCE_LINE 00000634 "                $rthing = \\map { $_ => 1 } @{$rthing};"
NSQ_SOURCE_LINE 00000635 "            }"
NSQ_SOURCE_LINE 00000636 "            if ( ref($rthing) ne 'HASH' ) {"
NSQ_SOURCE_LINE 00000637 "                Fault("
NSQ_SOURCE_LINE 00000638 "\"expecting {$key_name} to be a HASH or ARRAY ref in call '$msg_end\\n\""
NSQ_SOURCE_LINE 00000639 "                );"
NSQ_SOURCE_LINE 00000640 "            }"
NSQ_SOURCE_LINE 00000641 "        }"
NSQ_SOURCE_LINE 00000642 "        return $rthing;"
NSQ_SOURCE_LINE 00000643 "    }; ## end $make_hash_ref = sub"
NSQ_SOURCE_LINE 00000644 ""
NSQ_SOURCE_LINE 00000645 "    $rexceptions  = $make_hash_ref->( $rexceptions,  'rexceptions' );"
NSQ_SOURCE_LINE 00000646 "    $rvalid_words = $make_hash_ref->( $rvalid_words, 'rvalid_words' );"
NSQ_SOURCE_LINE 00000647 ""
NSQ_SOURCE_LINE 00000648 "    my @non_words;"
NSQ_SOURCE_LINE 00000649 ""
NSQ_SOURCE_LINE 00000650 "    # Must match specific valid words"
NSQ_SOURCE_LINE 00000651 "    if ( defined($rvalid_words) ) {"
NSQ_SOURCE_LINE 00000652 "        foreach my $word ( @{$rinput_list} ) {"
NSQ_SOURCE_LINE 00000653 "            next if ( $rexceptions && $rexceptions->{$word} );"
NSQ_SOURCE_LINE 00000654 "            if ( !$rvalid_words->{$word} ) {"
NSQ_SOURCE_LINE 00000655 ""
NSQ_SOURCE_LINE 00000656 "                # Note: not currently checking for module prefixes in this case"
NSQ_SOURCE_LINE 00000657 "                push @non_words, $word;"
NSQ_SOURCE_LINE 00000658 "            }"
NSQ_SOURCE_LINE 00000659 "        }"
NSQ_SOURCE_LINE 00000660 "    }"
NSQ_SOURCE_LINE 00000661 ""
NSQ_SOURCE_LINE 00000662 "    # Must be identifier-like words, or an exception"
NSQ_SOURCE_LINE 00000663 "    else {"
NSQ_SOURCE_LINE 00000664 "        foreach my $word ( @{$rinput_list} ) {"
NSQ_SOURCE_LINE 00000665 ""
NSQ_SOURCE_LINE 00000666 "            next if ( $rexceptions     && $rexceptions->{$word} );"
NSQ_SOURCE_LINE 00000667 "            next if ( $word =~ /^\\w+$/ && $word !~ /^\\d/ );"
NSQ_SOURCE_LINE 00000668 ""
NSQ_SOURCE_LINE 00000669 "            # Words with a module path, like My::Module::function"
NSQ_SOURCE_LINE 00000670 "            if ( $allow_module_path && index( $word, ':' ) ) {"
NSQ_SOURCE_LINE 00000671 "                my @parts = split /::/, $word;"
NSQ_SOURCE_LINE 00000672 "                my $ok    = 1;"
NSQ_SOURCE_LINE 00000673 "                foreach my $sub_word (@parts) {"
NSQ_SOURCE_LINE 00000674 "                    next if ( !length($sub_word) );"
NSQ_SOURCE_LINE 00000675 "                    next if ( $sub_word =~ /^\\w+$/ && $sub_word !~ /^\\d/ );"
NSQ_SOURCE_LINE 00000676 "                    $ok = 0;"
NSQ_SOURCE_LINE 00000677 "                    last;"
NSQ_SOURCE_LINE 00000678 "                }"
NSQ_SOURCE_LINE 00000679 "                next if ($ok);"
NSQ_SOURCE_LINE 00000680 "            }"
NSQ_SOURCE_LINE 00000681 "            push @non_words, $word;"
NSQ_SOURCE_LINE 00000682 "        }"
NSQ_SOURCE_LINE 00000683 "    }"
NSQ_SOURCE_LINE 00000684 ""
NSQ_SOURCE_LINE 00000685 "    return if ( !@non_words );"
NSQ_SOURCE_LINE 00000686 "    if ($on_error) {"
NSQ_SOURCE_LINE 00000687 "        $on_error = lc($on_error);"
NSQ_SOURCE_LINE 00000688 "        if ( $on_error eq 'warn' || $on_error eq 'die' ) {"
NSQ_SOURCE_LINE 00000689 "            my $num         = @non_words;"
NSQ_SOURCE_LINE 00000690 "            my $str         = join SPACE, @non_words;"
NSQ_SOURCE_LINE 00000691 "            my $max_str_len = 120;"
NSQ_SOURCE_LINE 00000692 "            if ( length($str) > $max_str_len - 1 ) {"
NSQ_SOURCE_LINE 00000693 "                $str = substr( $str, 0, $max_str_len - 4 ) . \"...\";"
NSQ_SOURCE_LINE 00000694 "            }"
NSQ_SOURCE_LINE 00000695 "            my $msg = <<EOM;"
NSQ_SOURCE_LINE 00000696 "$num unrecognized words were input$msg_end :"
NSQ_SOURCE_LINE 00000697 " $str"
NSQ_SOURCE_LINE 00000698 "EOM"
NSQ_SOURCE_LINE 00000699 "            Die($msg) if ( $on_error eq 'die' );"
NSQ_SOURCE_LINE 00000700 "            Warn($msg);"
NSQ_SOURCE_LINE 00000701 "        }"
NSQ_SOURCE_LINE 00000702 "    }"
NSQ_SOURCE_LINE 00000703 "    return \\@non_words;"
NSQ_SOURCE_LINE 00000704 "} ## end sub check_for_valid_words"
NSQ_SOURCE_LINE 00000705 ""
NSQ_SOURCE_LINE 00000706 "my %is_known_markup_word;"
NSQ_SOURCE_LINE 00000707 ""
NSQ_SOURCE_LINE 00000708 "BEGIN {"
NSQ_SOURCE_LINE 00000709 "    my @q = qw( ?xml !doctype !-- html meta );"
NSQ_SOURCE_LINE 00000710 "    $is_known_markup_word{$_} = 1 for @q;"
NSQ_SOURCE_LINE 00000711 "}"
NSQ_SOURCE_LINE 00000712 ""
NSQ_SOURCE_LINE 00000713 "sub is_not_perl {"
NSQ_SOURCE_LINE 00000714 ""
NSQ_SOURCE_LINE 00000715 "    my ( $rinput_string, $input_file, $is_named_file ) = @_;"
NSQ_SOURCE_LINE 00000716 ""
NSQ_SOURCE_LINE 00000717 "    # Given:"
NSQ_SOURCE_LINE 00000718 "    #  $rinput_string = ref to the string of text being processed"
NSQ_SOURCE_LINE 00000719 "    #  $input_file    = the name of the input stream"
NSQ_SOURCE_LINE 00000720 "    #  $is_named_file = true if $input_file is a named file"
NSQ_SOURCE_LINE 00000721 "    # Return:"
NSQ_SOURCE_LINE 00000722 "    #  true if this is clearly not a perl script"
NSQ_SOURCE_LINE 00000723 "    #  false otherwise"
NSQ_SOURCE_LINE 00000724 "    # Note:"
NSQ_SOURCE_LINE 00000725 "    #  This sub is called when the first character of a file is '<' in order"
NSQ_SOURCE_LINE 00000726 "    #  to catch the obvious cases of some kind of markup language."
NSQ_SOURCE_LINE 00000727 "    #  See also some related code in 'find_angle_operator_termination which"
NSQ_SOURCE_LINE 00000728 "    #  will catch some markup syntax which gets past this preliminary check."
NSQ_SOURCE_LINE 00000729 ""
NSQ_SOURCE_LINE 00000730 "    my $text;"
NSQ_SOURCE_LINE 00000731 "    if ( ${$rinput_string} =~ m/\\s*\\<\\s*([\\?\\!]?[\\-\\w]+)/ ) { $text = $1 }"
NSQ_SOURCE_LINE 00000732 "    else                                                    { return }"
NSQ_SOURCE_LINE 00000733 ""
NSQ_SOURCE_LINE 00000734 "    return 1 if ( $is_known_markup_word{ lc($text) } );"
NSQ_SOURCE_LINE 00000735 ""
NSQ_SOURCE_LINE 00000736 "    # require a named file with known extension for other markup words"
NSQ_SOURCE_LINE 00000737 "    return if ( !$is_named_file );"
NSQ_SOURCE_LINE 00000738 ""
NSQ_SOURCE_LINE 00000739 "    # check filename"
NSQ_SOURCE_LINE 00000740 "    return 1 if ( $input_file =~ /html?$/i );"
NSQ_SOURCE_LINE 00000741 ""
NSQ_SOURCE_LINE 00000742 "    return;"
NSQ_SOURCE_LINE 00000743 "} ## end sub is_not_perl"
NSQ_SOURCE_LINE 00000744 ""
NSQ_SOURCE_LINE 00000745 "BEGIN {"
NSQ_SOURCE_LINE 00000746 ""
NSQ_SOURCE_LINE 00000747 "    # Array index names for $self."
NSQ_SOURCE_LINE 00000748 "    # Do not combine with other BEGIN blocks (c101)."
NSQ_SOURCE_LINE 00000749 "    my $i = 0;"
NSQ_SOURCE_LINE 00000750 "    use constant {"
NSQ_SOURCE_LINE 00000751 "        _actual_output_extension_  => $i++,"
NSQ_SOURCE_LINE 00000752 "        _debugfile_stream_         => $i++,"
NSQ_SOURCE_LINE 00000753 "        _decoded_input_as_         => $i++,"
NSQ_SOURCE_LINE 00000754 "        _destination_stream_       => $i++,"
NSQ_SOURCE_LINE 00000755 "        _diagnostics_object_       => $i++,"
NSQ_SOURCE_LINE 00000756 "        _display_name_             => $i++,"
NSQ_SOURCE_LINE 00000757 "        _file_extension_separator_ => $i++,"
NSQ_SOURCE_LINE 00000758 "        _fileroot_                 => $i++,"
NSQ_SOURCE_LINE 00000759 "        _is_pure_ascii_data_       => $i++,"
NSQ_SOURCE_LINE 00000760 "        _is_encoded_data_          => $i++,"
NSQ_SOURCE_LINE 00000761 "        _length_function_          => $i++,"
NSQ_SOURCE_LINE 00000762 "        _line_separator_default_   => $i++,"
NSQ_SOURCE_LINE 00000763 "        _line_separator_           => $i++,"
NSQ_SOURCE_LINE 00000764 "        _line_tidy_begin_          => $i++,"
NSQ_SOURCE_LINE 00000765 "        _line_tidy_end_            => $i++,"
NSQ_SOURCE_LINE 00000766 "        _logger_object_            => $i++,"
NSQ_SOURCE_LINE 00000767 "        _output_file_              => $i++,"
NSQ_SOURCE_LINE 00000768 "        _postfilter_               => $i++,"
NSQ_SOURCE_LINE 00000769 "        _prefilter_                => $i++,"
NSQ_SOURCE_LINE 00000770 "        _rOpts_                    => $i++,"
NSQ_SOURCE_LINE 00000771 "        _rOpts_in_profile_         => $i++,"
NSQ_SOURCE_LINE 00000772 "        _saw_pbp_                  => $i++,"
NSQ_SOURCE_LINE 00000773 "        _teefile_stream_           => $i++,"
NSQ_SOURCE_LINE 00000774 "        _user_formatter_           => $i++,"
NSQ_SOURCE_LINE 00000775 "        _input_copied_verbatim_    => $i++,"
NSQ_SOURCE_LINE 00000776 "        _input_output_difference_  => $i++,"
NSQ_SOURCE_LINE 00000777 "        _dump_to_stdout_           => $i++,"
NSQ_SOURCE_LINE 00000778 "    };"
NSQ_SOURCE_LINE 00000779 "} ## end BEGIN"
NSQ_SOURCE_LINE 00000780 ""
NSQ_SOURCE_LINE 00000781 "sub perltidy {"
NSQ_SOURCE_LINE 00000782 ""
NSQ_SOURCE_LINE 00000783 "    my %input_hash = @_;"
NSQ_SOURCE_LINE 00000784 ""
NSQ_SOURCE_LINE 00000785 "    # This is the main perltidy routine"
NSQ_SOURCE_LINE 00000786 ""
NSQ_SOURCE_LINE 00000787 "    my %defaults = ("
NSQ_SOURCE_LINE 00000788 "        argv                  => undef,"
NSQ_SOURCE_LINE 00000789 "        destination           => undef,"
NSQ_SOURCE_LINE 00000790 "        formatter             => undef,"
NSQ_SOURCE_LINE 00000791 "        logfile               => undef,"
NSQ_SOURCE_LINE 00000792 "        errorfile             => undef,"
NSQ_SOURCE_LINE 00000793 "        teefile               => undef,"
NSQ_SOURCE_LINE 00000794 "        debugfile             => undef,"
NSQ_SOURCE_LINE 00000795 "        perltidyrc            => undef,"
NSQ_SOURCE_LINE 00000796 "        source                => undef,"
NSQ_SOURCE_LINE 00000797 "        stderr                => undef,"
NSQ_SOURCE_LINE 00000798 "        dump_options          => undef,"
NSQ_SOURCE_LINE 00000799 "        dump_options_type     => undef,"
NSQ_SOURCE_LINE 00000800 "        dump_getopt_flags     => undef,"
NSQ_SOURCE_LINE 00000801 "        dump_options_category => undef,"
NSQ_SOURCE_LINE 00000802 "        dump_abbreviations    => undef,"
NSQ_SOURCE_LINE 00000803 "        prefilter             => undef,"
NSQ_SOURCE_LINE 00000804 "        postfilter            => undef,"
NSQ_SOURCE_LINE 00000805 "    );"
NSQ_SOURCE_LINE 00000806 ""
NSQ_SOURCE_LINE 00000807 "    # Status information which can be returned for diagnostic purposes."
NSQ_SOURCE_LINE 00000808 "    # NOTE: This is intended only for testing and subject to change."
NSQ_SOURCE_LINE 00000809 ""
NSQ_SOURCE_LINE 00000810 "    # List of \"key => value\" hash entries:"
NSQ_SOURCE_LINE 00000811 ""
NSQ_SOURCE_LINE 00000812 "    # Some relevant user input parameters for convenience:"
NSQ_SOURCE_LINE 00000813 "    # opt_format         => value of --format: 'tidy', 'html', or 'user'"
NSQ_SOURCE_LINE 00000814 "    # opt_encoding       => value of -enc flag: 'utf8', 'none', or 'guess'"
NSQ_SOURCE_LINE 00000815 "    # opt_encode_output  => value of -eos flag: 'eos' or 'neos'"
NSQ_SOURCE_LINE 00000816 "    # opt_max_iterations => value of --iterations=n"
NSQ_SOURCE_LINE 00000817 ""
NSQ_SOURCE_LINE 00000818 "    # file_count         => number of files processed in this call"
NSQ_SOURCE_LINE 00000819 ""
NSQ_SOURCE_LINE 00000820 "    # If multiple files are processed, then the following values will be for"
NSQ_SOURCE_LINE 00000821 "    # the last file only:"
NSQ_SOURCE_LINE 00000822 ""
NSQ_SOURCE_LINE 00000823 "    # input_name         => name of the input stream"
NSQ_SOURCE_LINE 00000824 "    # output_name        => name of the output stream"
NSQ_SOURCE_LINE 00000825 ""
NSQ_SOURCE_LINE 00000826 "    # The following two variables refer to Perl's two internal string modes,"
NSQ_SOURCE_LINE 00000827 "    # and have the values 0 for 'byte' mode and 1 for 'char' mode:"
NSQ_SOURCE_LINE 00000828 "    # char_mode_source   => true if source is in 'char' mode. Will be false"
NSQ_SOURCE_LINE 00000829 "    #      unless we received a source string ref with utf8::is_utf8() set."
NSQ_SOURCE_LINE 00000830 "    # char_mode_used     => true if text processed by perltidy in 'char' mode."
NSQ_SOURCE_LINE 00000831 "    #      Normally true for text identified as utf8, otherwise false."
NSQ_SOURCE_LINE 00000832 ""
NSQ_SOURCE_LINE 00000833 "    # This tells if Unicode::GCString was used"
NSQ_SOURCE_LINE 00000834 "    # gcs_used           => true if -gcs and Unicode::GCString found & used"
NSQ_SOURCE_LINE 00000835 ""
NSQ_SOURCE_LINE 00000836 "    # These variables tell what utf8 decoding/encoding was done:"
NSQ_SOURCE_LINE 00000837 "    # input_decoded_as   => non-blank if perltidy decoded the source text"
NSQ_SOURCE_LINE 00000838 "    # output_encoded_as  => non-blank if perltidy encoded before return"
NSQ_SOURCE_LINE 00000839 ""
NSQ_SOURCE_LINE 00000840 "    # These variables are related to iterations and convergence testing:"
NSQ_SOURCE_LINE 00000841 "    # iteration_count    => number of iterations done"
NSQ_SOURCE_LINE 00000842 "    #                       ( can be from 1 to opt_max_iterations )"
NSQ_SOURCE_LINE 00000843 "    # converged          => true if stopped on convergence"
NSQ_SOURCE_LINE 00000844 "    #                       ( can only happen if opt_max_iterations > 1 )"
NSQ_SOURCE_LINE 00000845 "    # blinking           => true if stopped on blinking states"
NSQ_SOURCE_LINE 00000846 "    #                       ( i.e., unstable formatting, should not happen )"
NSQ_SOURCE_LINE 00000847 ""
NSQ_SOURCE_LINE 00000848 "    $rstatus = {"
NSQ_SOURCE_LINE 00000849 ""
NSQ_SOURCE_LINE 00000850 "        file_count         => 0,"
NSQ_SOURCE_LINE 00000851 "        opt_format         => EMPTY_STRING,"
NSQ_SOURCE_LINE 00000852 "        opt_encoding       => EMPTY_STRING,"
NSQ_SOURCE_LINE 00000853 "        opt_encode_output  => EMPTY_STRING,"
NSQ_SOURCE_LINE 00000854 "        opt_max_iterations => EMPTY_STRING,"
NSQ_SOURCE_LINE 00000855 ""
NSQ_SOURCE_LINE 00000856 "        input_name        => '(unknown)',"
NSQ_SOURCE_LINE 00000857 "        output_name       => EMPTY_STRING,"
NSQ_SOURCE_LINE 00000858 "        char_mode_source  => 0,"
NSQ_SOURCE_LINE 00000859 "        char_mode_used    => 0,"
NSQ_SOURCE_LINE 00000860 "        input_decoded_as  => EMPTY_STRING,"
NSQ_SOURCE_LINE 00000861 "        output_encoded_as => EMPTY_STRING,"
NSQ_SOURCE_LINE 00000862 "        gcs_used          => 0,"
NSQ_SOURCE_LINE 00000863 "        iteration_count   => 0,"
NSQ_SOURCE_LINE 00000864 "        converged         => 0,"
NSQ_SOURCE_LINE 00000865 "        blinking          => 0,"
NSQ_SOURCE_LINE 00000866 "    };"
NSQ_SOURCE_LINE 00000867 ""
NSQ_SOURCE_LINE 00000868 "    # Fix for issue git #57"
NSQ_SOURCE_LINE 00000869 "    $Warn_count  = 0;"
NSQ_SOURCE_LINE 00000870 "    $nag_message = EMPTY_STRING;"
NSQ_SOURCE_LINE 00000871 ""
NSQ_SOURCE_LINE 00000872 "    # don't overwrite callers ARGV"
NSQ_SOURCE_LINE 00000873 "    # Localization of @ARGV could be avoided by calling GetOptionsFromArray"
NSQ_SOURCE_LINE 00000874 "    # instead of GetOptions, but that is not available before perl 5.10"
NSQ_SOURCE_LINE 00000875 "    local @ARGV   = @ARGV;"
NSQ_SOURCE_LINE 00000876 "    local *STDERR = *STDERR;"
NSQ_SOURCE_LINE 00000877 ""
NSQ_SOURCE_LINE 00000878 "    if ( my @bad_keys = grep { !exists $defaults{$_} } keys %input_hash ) {"
NSQ_SOURCE_LINE 00000879 "        local $LIST_SEPARATOR = ')(';"
NSQ_SOURCE_LINE 00000880 "        my @good_keys = sort keys %defaults;"
NSQ_SOURCE_LINE 00000881 "        @bad_keys = sort @bad_keys;"
NSQ_SOURCE_LINE 00000882 "        confess <<EOM;"
NSQ_SOURCE_LINE 00000883 "------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000884 "Unknown perltidy parameter : (@bad_keys)"
NSQ_SOURCE_LINE 00000885 "perltidy only understands : (@good_keys)"
NSQ_SOURCE_LINE 00000886 "------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000887 ""
NSQ_SOURCE_LINE 00000888 "EOM"
NSQ_SOURCE_LINE 00000889 "    }"
NSQ_SOURCE_LINE 00000890 ""
NSQ_SOURCE_LINE 00000891 "    my $get_hash_ref = sub {"
NSQ_SOURCE_LINE 00000892 ""
NSQ_SOURCE_LINE 00000893 "        my ($key) = @_;"
NSQ_SOURCE_LINE 00000894 ""
NSQ_SOURCE_LINE 00000895 "        # Get and check a parameter from the input hash"
NSQ_SOURCE_LINE 00000896 ""
NSQ_SOURCE_LINE 00000897 "        my $hash_ref = $input_hash{$key};"
NSQ_SOURCE_LINE 00000898 "        if ( defined($hash_ref) ) {"
NSQ_SOURCE_LINE 00000899 "            if ( ref($hash_ref) ne 'HASH' ) {"
NSQ_SOURCE_LINE 00000900 "                my $what = ref($hash_ref);"
NSQ_SOURCE_LINE 00000901 "                my $but_is ="
NSQ_SOURCE_LINE 00000902 "                  $what ? \"but is ref to $what\" : \"but is not a reference\";"
NSQ_SOURCE_LINE 00000903 "                croak <<EOM;"
NSQ_SOURCE_LINE 00000904 "------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000905 "error in call to perltidy:"
NSQ_SOURCE_LINE 00000906 "-$key must be reference to HASH $but_is"
NSQ_SOURCE_LINE 00000907 "------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000908 "EOM"
NSQ_SOURCE_LINE 00000909 "            }"
NSQ_SOURCE_LINE 00000910 "        }"
NSQ_SOURCE_LINE 00000911 "        return $hash_ref;"
NSQ_SOURCE_LINE 00000912 "    }; ## end $get_hash_ref = sub"
NSQ_SOURCE_LINE 00000913 ""
NSQ_SOURCE_LINE 00000914 "    %input_hash = ( %defaults, %input_hash );"
NSQ_SOURCE_LINE 00000915 "    my $argv               = $input_hash{'argv'};"
NSQ_SOURCE_LINE 00000916 "    my $destination_stream = $input_hash{'destination'};"
NSQ_SOURCE_LINE 00000917 "    my $perltidyrc_stream  = $input_hash{'perltidyrc'};"
NSQ_SOURCE_LINE 00000918 "    my $source_stream      = $input_hash{'source'};"
NSQ_SOURCE_LINE 00000919 "    my $stderr_stream      = $input_hash{'stderr'};"
NSQ_SOURCE_LINE 00000920 "    my $user_formatter     = $input_hash{'formatter'};"
NSQ_SOURCE_LINE 00000921 "    my $prefilter          = $input_hash{'prefilter'};"
NSQ_SOURCE_LINE 00000922 "    my $postfilter         = $input_hash{'postfilter'};"
NSQ_SOURCE_LINE 00000923 ""
NSQ_SOURCE_LINE 00000924 "    if ($stderr_stream) {"
NSQ_SOURCE_LINE 00000925 "        $fh_stderr = Perl::Tidy::streamhandle( $stderr_stream, 'w' );"
NSQ_SOURCE_LINE 00000926 "        if ( !$fh_stderr ) {"
NSQ_SOURCE_LINE 00000927 "            croak <<EOM;"
NSQ_SOURCE_LINE 00000928 "------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000929 "Unable to redirect STDERR to $stderr_stream"
NSQ_SOURCE_LINE 00000930 "Please check value of -stderr in call to perltidy"
NSQ_SOURCE_LINE 00000931 "------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000932 "EOM"
NSQ_SOURCE_LINE 00000933 "        }"
NSQ_SOURCE_LINE 00000934 "    }"
NSQ_SOURCE_LINE 00000935 "    else {"
NSQ_SOURCE_LINE 00000936 "        $fh_stderr = *STDERR;"
NSQ_SOURCE_LINE 00000937 "    }"
NSQ_SOURCE_LINE 00000938 ""
NSQ_SOURCE_LINE 00000939 "    my $self = [];"
NSQ_SOURCE_LINE 00000940 "    bless $self, __PACKAGE__;"
NSQ_SOURCE_LINE 00000941 ""
NSQ_SOURCE_LINE 00000942 "    # extract various dump parameters"
NSQ_SOURCE_LINE 00000943 "    my $dump_options_type     = $input_hash{'dump_options_type'};"
NSQ_SOURCE_LINE 00000944 "    my $dump_options          = $get_hash_ref->('dump_options');"
NSQ_SOURCE_LINE 00000945 "    my $dump_getopt_flags     = $get_hash_ref->('dump_getopt_flags');"
NSQ_SOURCE_LINE 00000946 "    my $dump_options_category = $get_hash_ref->('dump_options_category');"
NSQ_SOURCE_LINE 00000947 "    my $dump_abbreviations    = $get_hash_ref->('dump_abbreviations');"
NSQ_SOURCE_LINE 00000948 ""
NSQ_SOURCE_LINE 00000949 "    # validate dump_options_type"
NSQ_SOURCE_LINE 00000950 "    if ( defined($dump_options) ) {"
NSQ_SOURCE_LINE 00000951 "        if ( !defined($dump_options_type) ) {"
NSQ_SOURCE_LINE 00000952 "            $dump_options_type = 'perltidyrc';"
NSQ_SOURCE_LINE 00000953 "        }"
NSQ_SOURCE_LINE 00000954 "        if (   $dump_options_type ne 'perltidyrc'"
NSQ_SOURCE_LINE 00000955 "            && $dump_options_type ne 'full' )"
NSQ_SOURCE_LINE 00000956 "        {"
NSQ_SOURCE_LINE 00000957 "            croak <<EOM;"
NSQ_SOURCE_LINE 00000958 "------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000959 "Please check value of -dump_options_type in call to perltidy;"
NSQ_SOURCE_LINE 00000960 "saw: '$dump_options_type'"
NSQ_SOURCE_LINE 00000961 "expecting: 'perltidyrc' or 'full'"
NSQ_SOURCE_LINE 00000962 "------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000963 "EOM"
NSQ_SOURCE_LINE 00000964 ""
NSQ_SOURCE_LINE 00000965 "        }"
NSQ_SOURCE_LINE 00000966 "    }"
NSQ_SOURCE_LINE 00000967 "    else {"
NSQ_SOURCE_LINE 00000968 "        $dump_options_type = EMPTY_STRING;"
NSQ_SOURCE_LINE 00000969 "    }"
NSQ_SOURCE_LINE 00000970 ""
NSQ_SOURCE_LINE 00000971 "    if ($user_formatter) {"
NSQ_SOURCE_LINE 00000972 ""
NSQ_SOURCE_LINE 00000973 "        # if the user defines a formatter, there is no output stream,"
NSQ_SOURCE_LINE 00000974 "        # but we need a null stream to keep coding simple"
NSQ_SOURCE_LINE 00000975 "        $destination_stream = \\my $tmp;"
NSQ_SOURCE_LINE 00000976 "    }"
NSQ_SOURCE_LINE 00000977 ""
NSQ_SOURCE_LINE 00000978 "    # see if ARGV is overridden"
NSQ_SOURCE_LINE 00000979 "    if ( defined($argv) ) {"
NSQ_SOURCE_LINE 00000980 ""
NSQ_SOURCE_LINE 00000981 "        my $rargv = ref($argv);"
NSQ_SOURCE_LINE 00000982 "        if ( $rargv eq 'SCALAR' ) { $argv = ${$argv}; $rargv = undef }"
NSQ_SOURCE_LINE 00000983 ""
NSQ_SOURCE_LINE 00000984 "        # ref to ARRAY"
NSQ_SOURCE_LINE 00000985 "        if ($rargv) {"
NSQ_SOURCE_LINE 00000986 "            if ( $rargv eq 'ARRAY' ) {"
NSQ_SOURCE_LINE 00000987 "                @ARGV = @{$argv};"
NSQ_SOURCE_LINE 00000988 "            }"
NSQ_SOURCE_LINE 00000989 "            else {"
NSQ_SOURCE_LINE 00000990 "                croak <<EOM;"
NSQ_SOURCE_LINE 00000991 "------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000992 "Please check value of -argv in call to perltidy;"
NSQ_SOURCE_LINE 00000993 "it must be a string or ref to ARRAY but is: $rargv"
NSQ_SOURCE_LINE 00000994 "------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000995 "EOM"
NSQ_SOURCE_LINE 00000996 "            }"
NSQ_SOURCE_LINE 00000997 "        }"
NSQ_SOURCE_LINE 00000998 ""
NSQ_SOURCE_LINE 00000999 "        # string"
NSQ_SOURCE_LINE 00001000 "        else {"
NSQ_SOURCE_LINE 00001001 "            my ( $rargv_str, $msg ) = parse_args($argv);"
NSQ_SOURCE_LINE 00001002 "            if ($msg) {"
NSQ_SOURCE_LINE 00001003 "                Die(<<EOM);"
NSQ_SOURCE_LINE 00001004 "Error parsing this string passed to perltidy with 'argv':"
NSQ_SOURCE_LINE 00001005 "$msg"
NSQ_SOURCE_LINE 00001006 "EOM"
NSQ_SOURCE_LINE 00001007 "            }"
NSQ_SOURCE_LINE 00001008 "            @ARGV = @{$rargv_str};"
NSQ_SOURCE_LINE 00001009 "        }"
NSQ_SOURCE_LINE 00001010 "    }"
NSQ_SOURCE_LINE 00001011 ""
NSQ_SOURCE_LINE 00001012 "    # These string refs will hold any warnings and error messages to be written"
NSQ_SOURCE_LINE 00001013 "    # to the logfile object when it eventually gets created."
NSQ_SOURCE_LINE 00001014 "    my $rpending_complaint;"
NSQ_SOURCE_LINE 00001015 "    ${$rpending_complaint} = EMPTY_STRING;"
NSQ_SOURCE_LINE 00001016 ""
NSQ_SOURCE_LINE 00001017 "    my $rpending_logfile_message;"
NSQ_SOURCE_LINE 00001018 "    ${$rpending_logfile_message} = EMPTY_STRING;"
NSQ_SOURCE_LINE 00001019 ""
NSQ_SOURCE_LINE 00001020 "    my ( $is_Windows, $Windows_type ) = look_for_Windows($rpending_complaint);"
NSQ_SOURCE_LINE 00001021 ""
NSQ_SOURCE_LINE 00001022 "    # VMS file names are restricted to a 40.40 format, so we append _tdy"
NSQ_SOURCE_LINE 00001023 "    # instead of .tdy, etc. (but see also sub check_vms_filename)"
NSQ_SOURCE_LINE 00001024 "    my $dot;"
NSQ_SOURCE_LINE 00001025 "    my $dot_pattern;"
NSQ_SOURCE_LINE 00001026 "    if ( $OSNAME eq 'VMS' ) {"
NSQ_SOURCE_LINE 00001027 "        $dot         = '_';"
NSQ_SOURCE_LINE 00001028 "        $dot_pattern = '_';"
NSQ_SOURCE_LINE 00001029 "    }"
NSQ_SOURCE_LINE 00001030 "    else {"
NSQ_SOURCE_LINE 00001031 "        $dot         = '.';"
NSQ_SOURCE_LINE 00001032 "        $dot_pattern = '\\.';    # must escape for use in regex"
NSQ_SOURCE_LINE 00001033 "    }"
NSQ_SOURCE_LINE 00001034 "    $self->[_file_extension_separator_] = $dot;"
NSQ_SOURCE_LINE 00001035 ""
NSQ_SOURCE_LINE 00001036 "    # save a copy of the last two input args for error checking later"
NSQ_SOURCE_LINE 00001037 "    my @ARGV_saved;"
NSQ_SOURCE_LINE 00001038 "    if ( @ARGV > 1 ) {"
NSQ_SOURCE_LINE 00001039 "        @ARGV_saved = ( $ARGV[-2], $ARGV[-1] );"
NSQ_SOURCE_LINE 00001040 "    }"
NSQ_SOURCE_LINE 00001041 ""
NSQ_SOURCE_LINE 00001042 "    # see if -wvt was entered on the command line before @ARGV is changed"
NSQ_SOURCE_LINE 00001043 "    my $wvt_in_args = grep { /-(wvt|warn-variable-types)=/ } @ARGV;"
NSQ_SOURCE_LINE 00001044 ""
NSQ_SOURCE_LINE 00001045 "    #-------------------------"
NSQ_SOURCE_LINE 00001046 "    # get command line options"
NSQ_SOURCE_LINE 00001047 "    #-------------------------"
NSQ_SOURCE_LINE 00001048 "    my ("
NSQ_SOURCE_LINE 00001049 "        $rOpts,                 $config_file,       $rraw_options,"
NSQ_SOURCE_LINE 00001050 "        $roption_string,        $rexpansion,        $roption_category,"
NSQ_SOURCE_LINE 00001051 "        $rinteger_option_range, $ris_string_option, $rOpts_in_profile"
NSQ_SOURCE_LINE 00001052 "      )"
NSQ_SOURCE_LINE 00001053 "      = process_command_line("
NSQ_SOURCE_LINE 00001054 "        $perltidyrc_stream,  $is_Windows, $Windows_type,"
NSQ_SOURCE_LINE 00001055 "        $rpending_complaint, $dump_options_type,"
NSQ_SOURCE_LINE 00001056 "      );"
NSQ_SOURCE_LINE 00001057 ""
NSQ_SOURCE_LINE 00001058 "    # Only filenames should remain in @ARGV"
NSQ_SOURCE_LINE 00001059 "    my @Arg_files = @ARGV;"
NSQ_SOURCE_LINE 00001060 ""
NSQ_SOURCE_LINE 00001061 "    $self->[_rOpts_]            = $rOpts;"
NSQ_SOURCE_LINE 00001062 "    $self->[_rOpts_in_profile_] = $rOpts_in_profile;"
NSQ_SOURCE_LINE 00001063 ""
NSQ_SOURCE_LINE 00001064 "    my $saw_pbp ="
NSQ_SOURCE_LINE 00001065 "      grep { $_ eq '-pbp' || $_ eq '-perl-best-practices' } @{$rraw_options};"
NSQ_SOURCE_LINE 00001066 "    $self->[_saw_pbp_] = $saw_pbp;"
NSQ_SOURCE_LINE 00001067 ""
NSQ_SOURCE_LINE 00001068 "    #------------------------------------"
NSQ_SOURCE_LINE 00001069 "    # Handle requests to dump information"
NSQ_SOURCE_LINE 00001070 "    #------------------------------------"
NSQ_SOURCE_LINE 00001071 ""
NSQ_SOURCE_LINE 00001072 "    # return or exit immediately after all dumps"
NSQ_SOURCE_LINE 00001073 "    my $quit_now = 0;"
NSQ_SOURCE_LINE 00001074 ""
NSQ_SOURCE_LINE 00001075 "    # Getopt parameters and their flags"
NSQ_SOURCE_LINE 00001076 "    if ( defined($dump_getopt_flags) ) {"
NSQ_SOURCE_LINE 00001077 "        $quit_now = 1;"
NSQ_SOURCE_LINE 00001078 "        foreach my $op ( @{$roption_string} ) {"
NSQ_SOURCE_LINE 00001079 "            my $opt  = $op;"
NSQ_SOURCE_LINE 00001080 "            my $flag = EMPTY_STRING;"
NSQ_SOURCE_LINE 00001081 ""
NSQ_SOURCE_LINE 00001082 "            # Examples:"
NSQ_SOURCE_LINE 00001083 "            #  some-option=s"
NSQ_SOURCE_LINE 00001084 "            #  some-option=i"
NSQ_SOURCE_LINE 00001085 "            #  some-option:i"
NSQ_SOURCE_LINE 00001086 "            #  some-option!"
NSQ_SOURCE_LINE 00001087 "            if ( $opt =~ /(.*)(!|=.*|:.*)$/ ) {"
NSQ_SOURCE_LINE 00001088 "                $opt  = $1;"
NSQ_SOURCE_LINE 00001089 "                $flag = $2;"
NSQ_SOURCE_LINE 00001090 "            }"
NSQ_SOURCE_LINE 00001091 "            $dump_getopt_flags->{$opt} = $flag;"
NSQ_SOURCE_LINE 00001092 "        }"
NSQ_SOURCE_LINE 00001093 "    }"
NSQ_SOURCE_LINE 00001094 ""
NSQ_SOURCE_LINE 00001095 "    if ( defined($dump_options_category) ) {"
NSQ_SOURCE_LINE 00001096 "        $quit_now = 1;"
NSQ_SOURCE_LINE 00001097 "        %{$dump_options_category} = %{$roption_category};"
NSQ_SOURCE_LINE 00001098 "    }"
NSQ_SOURCE_LINE 00001099 ""
NSQ_SOURCE_LINE 00001100 "    if ( defined($dump_abbreviations) ) {"
NSQ_SOURCE_LINE 00001101 "        $quit_now = 1;"
NSQ_SOURCE_LINE 00001102 "        %{$dump_abbreviations} = %{$rexpansion};"
NSQ_SOURCE_LINE 00001103 "    }"
NSQ_SOURCE_LINE 00001104 ""
NSQ_SOURCE_LINE 00001105 "    if ( defined($dump_options) ) {"
NSQ_SOURCE_LINE 00001106 "        $quit_now = 1;"
NSQ_SOURCE_LINE 00001107 "        %{$dump_options} = %{$rOpts};"
NSQ_SOURCE_LINE 00001108 "    }"
NSQ_SOURCE_LINE 00001109 ""
NSQ_SOURCE_LINE 00001110 "    Exit(0) if ($quit_now);"
NSQ_SOURCE_LINE 00001111 ""
NSQ_SOURCE_LINE 00001112 "    # make printable string of options for this run as possible diagnostic"
NSQ_SOURCE_LINE 00001113 "    my $readable_options = readable_options( $rOpts, $roption_string );"
NSQ_SOURCE_LINE 00001114 ""
NSQ_SOURCE_LINE 00001115 "    # dump from command line"
NSQ_SOURCE_LINE 00001116 "    if ( $rOpts->{'dump-options'} ) {"
NSQ_SOURCE_LINE 00001117 "        print {*STDOUT} $readable_options;"
NSQ_SOURCE_LINE 00001118 "        Exit(0);"
NSQ_SOURCE_LINE 00001119 "    }"
NSQ_SOURCE_LINE 00001120 ""
NSQ_SOURCE_LINE 00001121 "    # some dump options require one filename in the arg list.  This is a safety"
NSQ_SOURCE_LINE 00001122 "    # precaution in case a user accidentally adds such an option to the command"
NSQ_SOURCE_LINE 00001123 "    # line parameters and is expecting formatted output to stdout.  Another"
NSQ_SOURCE_LINE 00001124 "    # precaution, added elsewhere, is to ignore these in a .perltidyrc"
NSQ_SOURCE_LINE 00001125 "    my $num_files = @Arg_files;"
NSQ_SOURCE_LINE 00001126 "    foreach my $opt_name ("
NSQ_SOURCE_LINE 00001127 "        qw("
NSQ_SOURCE_LINE 00001128 "        dump-block-summary"
NSQ_SOURCE_LINE 00001129 "        dump-unusual-variables"
NSQ_SOURCE_LINE 00001130 "        dump-mixed-call-parens"
NSQ_SOURCE_LINE 00001131 "        dump-mismatched-args"
NSQ_SOURCE_LINE 00001132 "        dump-mismatched-returns"
NSQ_SOURCE_LINE 00001133 "        dump-unique-keys"
NSQ_SOURCE_LINE 00001134 "        dump-hash-keys"
NSQ_SOURCE_LINE 00001135 "        dump-similar-keys"
NSQ_SOURCE_LINE 00001136 "        dump-keyword-usage"
NSQ_SOURCE_LINE 00001137 "        )"
NSQ_SOURCE_LINE 00001138 "      )"
NSQ_SOURCE_LINE 00001139 "    {"
NSQ_SOURCE_LINE 00001140 ""
NSQ_SOURCE_LINE 00001141 "        if ( $rOpts->{$opt_name} ) {"
NSQ_SOURCE_LINE 00001142 "            $self->[_dump_to_stdout_] = 1;"
NSQ_SOURCE_LINE 00001143 "            if ( $num_files != 1 ) {"
NSQ_SOURCE_LINE 00001144 "                Die(<<EOM);"
NSQ_SOURCE_LINE 00001145 "--$opt_name expects 1 filename in the arg list but saw $num_files filenames"
NSQ_SOURCE_LINE 00001146 "EOM"
NSQ_SOURCE_LINE 00001147 "            }"
NSQ_SOURCE_LINE 00001148 "            if ( $rOpts->{'outfile'} ) {"
NSQ_SOURCE_LINE 00001149 "                Die(<<EOM);"
NSQ_SOURCE_LINE 00001150 "--outfile is not allowed with --$opt_name because dump output goes to STDOUT"
NSQ_SOURCE_LINE 00001151 "EOM"
NSQ_SOURCE_LINE 00001152 "            }"
NSQ_SOURCE_LINE 00001153 "        }"
NSQ_SOURCE_LINE 00001154 "    }"
NSQ_SOURCE_LINE 00001155 ""
NSQ_SOURCE_LINE 00001156 "    #----------------------------------------"
NSQ_SOURCE_LINE 00001157 "    # check parameters and their interactions"
NSQ_SOURCE_LINE 00001158 "    #----------------------------------------"
NSQ_SOURCE_LINE 00001159 "    $self->check_options( $num_files, $rinteger_option_range,"
NSQ_SOURCE_LINE 00001160 "        $ris_string_option );"
NSQ_SOURCE_LINE 00001161 ""
NSQ_SOURCE_LINE 00001162 "    if ($user_formatter) {"
