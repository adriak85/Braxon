NSQ_SOURCE_LINE 00004161 "    #---------------------------------------------------------------------"
NSQ_SOURCE_LINE 00004162 ""
NSQ_SOURCE_LINE 00004163 "    # The Perl::Tidy::HtmlWriter will add its own options to the string"
NSQ_SOURCE_LINE 00004164 "    Perl::Tidy::HtmlWriter->make_getopt_long_names( \\@option_string );"
NSQ_SOURCE_LINE 00004165 ""
NSQ_SOURCE_LINE 00004166 "    ########################################"
NSQ_SOURCE_LINE 00004167 "    # Set categories 10, 11, 12"
NSQ_SOURCE_LINE 00004168 "    ########################################"
NSQ_SOURCE_LINE 00004169 "    # Based on their known order"
NSQ_SOURCE_LINE 00004170 "    $category = 12;    # HTML properties"
NSQ_SOURCE_LINE 00004171 "    $add_option->( 'use-pod-formatter', 'upf', '=s' );"
NSQ_SOURCE_LINE 00004172 "    foreach my $opt (@option_string) {"
NSQ_SOURCE_LINE 00004173 "        my $long_name = $opt;"
NSQ_SOURCE_LINE 00004174 "        $long_name =~ s/(!|=.*|:.*)$//;"
NSQ_SOURCE_LINE 00004175 "        if ( !defined( $option_category{$long_name} ) ) {"
NSQ_SOURCE_LINE 00004176 "            if ( $long_name =~ /^html-linked/ ) {"
NSQ_SOURCE_LINE 00004177 "                $category = 10;    # HTML options"
NSQ_SOURCE_LINE 00004178 "            }"
NSQ_SOURCE_LINE 00004179 "            elsif ( $long_name =~ /^pod2html/ ) {"
NSQ_SOURCE_LINE 00004180 "                $category = 11;    # Pod2html"
NSQ_SOURCE_LINE 00004181 "            }"
NSQ_SOURCE_LINE 00004182 "            else {"
NSQ_SOURCE_LINE 00004183 "                $category = 12;    # HTML properties"
NSQ_SOURCE_LINE 00004184 "            }"
NSQ_SOURCE_LINE 00004185 "            $option_category{$long_name} = $category_name[$category];"
NSQ_SOURCE_LINE 00004186 "        }"
NSQ_SOURCE_LINE 00004187 "    }"
NSQ_SOURCE_LINE 00004188 ""
NSQ_SOURCE_LINE 00004189 "    #----------------------------------------------------------------------"
NSQ_SOURCE_LINE 00004190 "    # NON-INTEGER DEFAULTS: Assign default values to the above options here"
NSQ_SOURCE_LINE 00004191 "    # except for integers, 'outfile' and 'help'"
NSQ_SOURCE_LINE 00004192 "    # NOTES:"
NSQ_SOURCE_LINE 00004193 "    # - Enter integer options in %integer_option_range, NOT HERE"
NSQ_SOURCE_LINE 00004194 "    # - 'keyword-group-blanks-size=5' is ok here: the arg is a string"
NSQ_SOURCE_LINE 00004195 "    # - These settings should approximate the perlstyle(1) suggestions."
NSQ_SOURCE_LINE 00004196 "    #----------------------------------------------------------------------"
