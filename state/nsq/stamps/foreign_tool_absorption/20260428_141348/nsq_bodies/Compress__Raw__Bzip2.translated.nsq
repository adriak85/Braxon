NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "=head1 NAME"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "Compress::Raw::Bzip2 - Low-Level Interface to bzip2 compression library"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "    use Compress::Raw::Bzip2 ;"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "    my ($bz, $status) = new Compress::Raw::Bzip2 [OPTS]"
NSQ_SOURCE_LINE 00000134 "        or die \"Cannot create bzip2 object: $bzerno\\n\";"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "    $status = $bz->bzdeflate($input, $output);"
NSQ_SOURCE_LINE 00000137 "    $status = $bz->bzflush($output);"
NSQ_SOURCE_LINE 00000138 "    $status = $bz->bzclose($output);"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "    my ($bz, $status) = new Compress::Raw::Bunzip2 [OPTS]"
NSQ_SOURCE_LINE 00000141 "        or die \"Cannot create bunzip2 object: $bzerno\\n\";"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "    $status = $bz->bzinflate($input, $output);"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "    my $version = Compress::Raw::Bzip2::bzlibversion();"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "C<Compress::Raw::Bzip2> provides an interface to the in-memory"
NSQ_SOURCE_LINE 00000150 "compression/uncompression functions from the bzip2 compression library."
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "Although the primary purpose for the existence of C<Compress::Raw::Bzip2>"
NSQ_SOURCE_LINE 00000153 "is for use by the  C<IO::Compress::Bzip2> and C<IO::Compress::Bunzip2>"
NSQ_SOURCE_LINE 00000154 "modules, it can be used on its own for simple compression/uncompression"
NSQ_SOURCE_LINE 00000155 "tasks."
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "=head1 Compression"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "=head2 ($z, $status) = new Compress::Raw::Bzip2 $appendOutput, $blockSize100k, $workfactor;"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "Creates a new compression object."
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "If successful, it will return the initialised compression object, C<$z>"
NSQ_SOURCE_LINE 00000164 "and a C<$status> of C<BZ_OK> in a list context. In scalar context it"
NSQ_SOURCE_LINE 00000165 "returns the deflation object, C<$z>, only."
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "If not successful, the returned compression object, C<$z>, will be"
NSQ_SOURCE_LINE 00000168 "I<undef> and C<$status> will hold the a I<bzip2> error code."
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "Below is a list of the valid options:"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "=over 5"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "=item B<$appendOutput>"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "Controls whether the compressed data is appended to the output buffer in"
NSQ_SOURCE_LINE 00000177 "the C<bzdeflate>, C<bzflush> and C<bzclose> methods."
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "Defaults to 1."
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "=item B<$blockSize100k>"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "To quote the bzip2 documentation"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "    blockSize100k specifies the block size to be used for compression. It"
NSQ_SOURCE_LINE 00000186 "    should be a value between 1 and 9 inclusive, and the actual block size"
NSQ_SOURCE_LINE 00000187 "    used is 100000 x this figure. 9 gives the best compression but takes"
NSQ_SOURCE_LINE 00000188 "    most memory."
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "Defaults to 1."
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "=item B<$workfactor>"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "To quote the bzip2 documentation"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "    This parameter controls how the compression phase behaves when"
NSQ_SOURCE_LINE 00000197 "    presented with worst case, highly repetitive, input data. If"
NSQ_SOURCE_LINE 00000198 "    compression runs into difficulties caused by repetitive data, the"
NSQ_SOURCE_LINE 00000199 "    library switches from the standard sorting algorithm to a fallback"
NSQ_SOURCE_LINE 00000200 "    algorithm. The fallback is slower than the standard algorithm by"
NSQ_SOURCE_LINE 00000201 "    perhaps a factor of three, but always behaves reasonably, no matter how"
NSQ_SOURCE_LINE 00000202 "    bad the input."
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "    Lower values of workFactor reduce the amount of effort the standard"
NSQ_SOURCE_LINE 00000205 "    algorithm will expend before resorting to the fallback. You should set"
NSQ_SOURCE_LINE 00000206 "    this parameter carefully; too low, and many inputs will be handled by"
NSQ_SOURCE_LINE 00000207 "    the fallback algorithm and so compress rather slowly, too high, and"
NSQ_SOURCE_LINE 00000208 "    your average-to-worst case compression times can become very large. The"
NSQ_SOURCE_LINE 00000209 "    default value of 30 gives reasonable behaviour over a wide range of"
NSQ_SOURCE_LINE 00000210 "    circumstances."
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "    Allowable values range from 0 to 250 inclusive. 0 is a special case,"
NSQ_SOURCE_LINE 00000213 "    equivalent to using the default value of 30."
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "Defaults to 0."
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "=back"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "=head2 $status = $bz->bzdeflate($input, $output);"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "Reads the contents of C<$input>, compresses it and writes the compressed"
NSQ_SOURCE_LINE 00000222 "data to C<$output>."
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "Returns C<BZ_RUN_OK> on success and a C<bzip2> error code on failure."
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "If C<appendOutput> is enabled in the constructor for the bzip2 object, the"
NSQ_SOURCE_LINE 00000227 "compressed data will be appended to C<$output>. If not enabled, C<$output>"
NSQ_SOURCE_LINE 00000228 "will be truncated before the compressed data is written to it."
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "=head2 $status = $bz->bzflush($output);"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "Flushes any pending compressed data to C<$output>."
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "Returns C<BZ_RUN_OK> on success and a C<bzip2> error code on failure."
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "=head2 $status = $bz->bzclose($output);"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "Terminates the compressed data stream and flushes any pending compressed"
NSQ_SOURCE_LINE 00000239 "data to C<$output>."
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "Returns C<BZ_STREAM_END> on success and a C<bzip2> error code on failure."
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "=head2 Example"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "=head1 Uncompression"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "=head2 ($z, $status) = new Compress::Raw::Bunzip2 $appendOutput, $consumeInput, $small, $verbosity, $limitOutput;"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "If successful, it will return the initialised uncompression object, C<$z>"
NSQ_SOURCE_LINE 00000250 "and a C<$status> of C<BZ_OK> in a list context. In scalar context it"
NSQ_SOURCE_LINE 00000251 "returns the deflation object, C<$z>, only."
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "If not successful, the returned uncompression object, C<$z>, will be"
NSQ_SOURCE_LINE 00000254 "I<undef> and C<$status> will hold the a I<bzip2> error code."
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "Below is a list of the valid options:"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "=over 5"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "=item B<$appendOutput>"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "Controls whether the compressed data is appended to the output buffer in the"
NSQ_SOURCE_LINE 00000263 "C<bzinflate>, C<bzflush> and C<bzclose> methods."
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "Defaults to 1."
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "=item B<$consumeInput>"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "=item B<$small>"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "To quote the bzip2 documentation"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "    If small is nonzero, the library will use an alternative decompression"
NSQ_SOURCE_LINE 00000274 "    algorithm which uses less memory but at the cost of decompressing more"
NSQ_SOURCE_LINE 00000275 "    slowly (roughly speaking, half the speed, but the maximum memory"
NSQ_SOURCE_LINE 00000276 "    requirement drops to around 2300k)."
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "Defaults to 0."
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "=item B<$limitOutput>"
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "The C<LimitOutput> option changes the behavior of the C<< $i->bzinflate >>"
NSQ_SOURCE_LINE 00000283 "method so that the amount of memory used by the output buffer can be"
NSQ_SOURCE_LINE 00000284 "limited."
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "When C<LimitOutput> is used the size of the output buffer used will either"
NSQ_SOURCE_LINE 00000287 "be the 16k or the amount of memory already allocated to C<$output>,"
NSQ_SOURCE_LINE 00000288 "whichever is larger. Predicting the output size available is tricky, so"
NSQ_SOURCE_LINE 00000289 "don't rely on getting an exact output buffer size."
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "When C<LimitOutout> is not specified C<< $i->bzinflate >> will use as much"
NSQ_SOURCE_LINE 00000292 "memory as it takes to write all the uncompressed data it creates by"
NSQ_SOURCE_LINE 00000293 "uncompressing the input buffer."
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "If C<LimitOutput> is enabled, the C<ConsumeInput> option will also be"
NSQ_SOURCE_LINE 00000296 "enabled."
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "This option defaults to false."
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "=item B<$verbosity>"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "This parameter is ignored."
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "Defaults to 0."
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "=back"
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "=head2 $status = $z->bzinflate($input, $output);"
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "Uncompresses C<$input> and writes the uncompressed data to C<$output>."
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "Returns C<BZ_OK> if the uncompression was successful, but the end of the"
NSQ_SOURCE_LINE 00000313 "compressed data stream has not been reached. Returns C<BZ_STREAM_END> on"
NSQ_SOURCE_LINE 00000314 "successful uncompression and the end of the compression stream has been"
NSQ_SOURCE_LINE 00000315 "reached."
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "If C<consumeInput> is enabled in the constructor for the bunzip2 object,"
NSQ_SOURCE_LINE 00000318 "C<$input> will have all compressed data removed from it after"
NSQ_SOURCE_LINE 00000319 "uncompression. On C<BZ_OK> return this will mean that C<$input> will be an"
NSQ_SOURCE_LINE 00000320 "empty string; when C<BZ_STREAM_END> C<$input> will either be an empty"
NSQ_SOURCE_LINE 00000321 "string or will contain whatever data immediately followed the compressed"
NSQ_SOURCE_LINE 00000322 "data stream."
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "If C<appendOutput> is enabled in the constructor for the bunzip2 object,"
NSQ_SOURCE_LINE 00000325 "the uncompressed data will be appended to C<$output>. If not enabled,"
NSQ_SOURCE_LINE 00000326 "C<$output> will be truncated before the uncompressed data is written to it."
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "=head1 Misc"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "=head2 my $version = Compress::Raw::Bzip2::bzlibversion();"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "Returns the version of the underlying bzip2 library."
NSQ_SOURCE_LINE 00000333 ""
