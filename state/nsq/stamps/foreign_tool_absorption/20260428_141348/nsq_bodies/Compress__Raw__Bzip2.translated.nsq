NSQ_SOURCE_LINE 00000044 "sub AUTOLOAD {"
NSQ_SOURCE_LINE 00000045 "    my($constname);"
NSQ_SOURCE_LINE 00000046 "    ($constname = $AUTOLOAD) =~ s/.*:://;"
NSQ_SOURCE_LINE 00000047 "    my ($error, $val) = constant($constname);"
NSQ_SOURCE_LINE 00000048 "    Carp::croak $error if $error;"
NSQ_SOURCE_LINE 00000049 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000050 "    *{$AUTOLOAD} = sub { $val };"
NSQ_SOURCE_LINE 00000051 "    goto &{$AUTOLOAD};"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "}"
NSQ_SOURCE_LINE 00000054 ""
