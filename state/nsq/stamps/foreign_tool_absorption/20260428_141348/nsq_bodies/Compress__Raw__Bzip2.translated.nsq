NSQ_SOURCE_LINE 00000072 "#{"
NSQ_SOURCE_LINE 00000073 "#    my $class = shift ;"
NSQ_SOURCE_LINE 00000074 "#    my ($ptr, $status) = _new(@_);"
NSQ_SOURCE_LINE 00000075 "#    return wantarray ? (undef, $status) : undef"
NSQ_SOURCE_LINE 00000076 "#        unless $ptr ;"
NSQ_SOURCE_LINE 00000077 "#    my $obj = bless [$ptr], $class ;"
