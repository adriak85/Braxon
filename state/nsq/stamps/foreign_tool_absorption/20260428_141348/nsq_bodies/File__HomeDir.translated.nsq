NSQ_SOURCE_LINE 00000147 "}"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "sub my_data"
NSQ_SOURCE_LINE 00000150 "{"
NSQ_SOURCE_LINE 00000151 "    $IMPLEMENTED_BY->can('my_data')"
NSQ_SOURCE_LINE 00000152 "      ? $IMPLEMENTED_BY->my_data"
