NSQ_SOURCE_LINE 00000045 "# Inlined Params::Util functions"
NSQ_SOURCE_LINE 00000046 "sub _CLASS ($)    ## no critic qw(SubroutinePrototypes)"
NSQ_SOURCE_LINE 00000047 "{"
NSQ_SOURCE_LINE 00000048 "    (defined $_[0] and not ref $_[0] and $_[0] =~ m/^[^\\W\\d]\\w*(?:::\\w+)*\\z/s) ? $_[0] : undef;"
NSQ_SOURCE_LINE 00000049 "}"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "sub _DRIVER ($$)    ## no critic qw(SubroutinePrototypes)"
NSQ_SOURCE_LINE 00000052 "{"
NSQ_SOURCE_LINE 00000053 "    (defined _CLASS($_[0]) and eval \"require $_[0]; 1\" and $_[0]->isa($_[1]) and $_[0] ne $_[1]) ? $_[0] : undef;"
NSQ_SOURCE_LINE 00000054 "}"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "# Platform detection"
NSQ_SOURCE_LINE 00000057 "if ($IMPLEMENTED_BY)"
NSQ_SOURCE_LINE 00000058 "{"
NSQ_SOURCE_LINE 00000059 "    # Allow for custom HomeDir classes"
NSQ_SOURCE_LINE 00000060 "    # Leave it as the existing value"
NSQ_SOURCE_LINE 00000061 "}"
NSQ_SOURCE_LINE 00000062 "elsif ($^O eq 'MSWin32')"
NSQ_SOURCE_LINE 00000063 "{"
NSQ_SOURCE_LINE 00000064 "    # All versions of Windows"
NSQ_SOURCE_LINE 00000065 "    $IMPLEMENTED_BY = 'File::HomeDir::Windows';"
NSQ_SOURCE_LINE 00000066 "}"
NSQ_SOURCE_LINE 00000067 "elsif ($^O eq 'darwin')"
NSQ_SOURCE_LINE 00000068 "{"
NSQ_SOURCE_LINE 00000069 "    # 1st: try Mac::SystemDirectory by chansen"
NSQ_SOURCE_LINE 00000070 "    if (eval \"require Mac::SystemDirectory; 1\")"
NSQ_SOURCE_LINE 00000071 "    {"
NSQ_SOURCE_LINE 00000072 "        $IMPLEMENTED_BY = 'File::HomeDir::Darwin::Cocoa';"
NSQ_SOURCE_LINE 00000073 "    }"
NSQ_SOURCE_LINE 00000074 "    elsif (eval \"require Mac::Files; 1\")"
NSQ_SOURCE_LINE 00000075 "    {"
NSQ_SOURCE_LINE 00000076 "        # 2nd try Mac::Files: Carbon - unmaintained since 2006 except some 64bit fixes"
NSQ_SOURCE_LINE 00000077 "        $IMPLEMENTED_BY = 'File::HomeDir::Darwin::Carbon';"
NSQ_SOURCE_LINE 00000078 "    }"
NSQ_SOURCE_LINE 00000079 "    else"
NSQ_SOURCE_LINE 00000080 "    {"
NSQ_SOURCE_LINE 00000081 "        # 3rd: fallback: pure perl"
NSQ_SOURCE_LINE 00000082 "        $IMPLEMENTED_BY = 'File::HomeDir::Darwin';"
NSQ_SOURCE_LINE 00000083 "    }"
NSQ_SOURCE_LINE 00000084 "}"
NSQ_SOURCE_LINE 00000085 "elsif ($^O eq 'MacOS')"
NSQ_SOURCE_LINE 00000086 "{"
NSQ_SOURCE_LINE 00000087 "    # Legacy Mac OS"
NSQ_SOURCE_LINE 00000088 "    $IMPLEMENTED_BY = 'File::HomeDir::MacOS9';"
NSQ_SOURCE_LINE 00000089 "}"
NSQ_SOURCE_LINE 00000090 "elsif (File::Which::which('xdg-user-dir'))"
NSQ_SOURCE_LINE 00000091 "{"
NSQ_SOURCE_LINE 00000092 "    # freedesktop unixes"
NSQ_SOURCE_LINE 00000093 "    $IMPLEMENTED_BY = 'File::HomeDir::FreeDesktop';"
NSQ_SOURCE_LINE 00000094 "}"
NSQ_SOURCE_LINE 00000095 "else"
NSQ_SOURCE_LINE 00000096 "{"
NSQ_SOURCE_LINE 00000097 "    # Default to Unix semantics"
NSQ_SOURCE_LINE 00000098 "    $IMPLEMENTED_BY = 'File::HomeDir::Unix';"
NSQ_SOURCE_LINE 00000099 "}"
