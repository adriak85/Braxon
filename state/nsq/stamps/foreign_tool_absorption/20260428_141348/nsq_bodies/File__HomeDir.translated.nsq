NSQ_SOURCE_LINE 00000154 "}"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "sub my_dist_data"
NSQ_SOURCE_LINE 00000157 "{"
NSQ_SOURCE_LINE 00000158 "    my $params = ref $_[-1] eq 'HASH' ? pop : {};"
NSQ_SOURCE_LINE 00000159 "    my $dist   = pop or Carp::croak(\"The my_dist_data method requires an argument\");"
NSQ_SOURCE_LINE 00000160 "    my $data   = my_data();"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "    # If datadir is not defined, there's nothing we can do: bail out"
NSQ_SOURCE_LINE 00000163 "    # and return nothing..."
NSQ_SOURCE_LINE 00000164 "    return undef unless defined $data;"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "    # On traditional unixes, hide the top-level directory"
NSQ_SOURCE_LINE 00000167 "    my $var ="
NSQ_SOURCE_LINE 00000168 "      $data eq home()"
NSQ_SOURCE_LINE 00000169 "      ? File::Spec->catdir($data, '.perl', 'dist', $dist)"
NSQ_SOURCE_LINE 00000170 "      : File::Spec->catdir($data, 'Perl',  'dist', $dist);"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "    # directory exists: return it"
NSQ_SOURCE_LINE 00000173 "    return $var if -d $var;"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "    # directory doesn't exist: check if we need to create it..."
NSQ_SOURCE_LINE 00000176 "    return undef unless $params->{create};"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "    # user requested directory creation"
NSQ_SOURCE_LINE 00000179 "    require File::Path;"
NSQ_SOURCE_LINE 00000180 "    File::Path::mkpath($var);"
NSQ_SOURCE_LINE 00000181 "    return $var;"
NSQ_SOURCE_LINE 00000182 "}"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "sub my_dist_config"
NSQ_SOURCE_LINE 00000185 "{"
NSQ_SOURCE_LINE 00000186 "    my $params = ref $_[-1] eq 'HASH' ? pop : {};"
NSQ_SOURCE_LINE 00000187 "    my $dist   = pop or Carp::croak(\"The my_dist_config method requires an argument\");"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "    # not all platforms support a specific my_config() method"
NSQ_SOURCE_LINE 00000190 "    my $config ="
NSQ_SOURCE_LINE 00000191 "        $IMPLEMENTED_BY->can('my_config')"
NSQ_SOURCE_LINE 00000192 "      ? $IMPLEMENTED_BY->my_config"
NSQ_SOURCE_LINE 00000193 "      : $IMPLEMENTED_BY->my_documents;"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "    # If neither configdir nor my_documents is defined, there's"
NSQ_SOURCE_LINE 00000196 "    # nothing we can do: bail out and return nothing..."
NSQ_SOURCE_LINE 00000197 "    return undef unless defined $config;"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "    # On traditional unixes, hide the top-level dir"
NSQ_SOURCE_LINE 00000200 "    my $etc ="
NSQ_SOURCE_LINE 00000201 "      $config eq home()"
NSQ_SOURCE_LINE 00000202 "      ? File::Spec->catdir($config, '.perl', $dist)"
NSQ_SOURCE_LINE 00000203 "      : File::Spec->catdir($config, 'Perl',  $dist);"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "    # directory exists: return it"
NSQ_SOURCE_LINE 00000206 "    return $etc if -d $etc;"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "    # directory doesn't exist: check if we need to create it..."
NSQ_SOURCE_LINE 00000209 "    return undef unless $params->{create};"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "    # user requested directory creation"
NSQ_SOURCE_LINE 00000212 "    require File::Path;"
NSQ_SOURCE_LINE 00000213 "    File::Path::mkpath($etc);"
NSQ_SOURCE_LINE 00000214 "    return $etc;"
NSQ_SOURCE_LINE 00000215 "}"
NSQ_SOURCE_LINE 00000216 ""
