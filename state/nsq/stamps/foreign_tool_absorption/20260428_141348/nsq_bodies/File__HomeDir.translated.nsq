NSQ_SOURCE_LINE 00000269 "#####################################################################"
NSQ_SOURCE_LINE 00000270 "# Legacy Methods"
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "# Find the home directory of an arbitrary user"
NSQ_SOURCE_LINE 00000273 "sub home (;$)    ## no critic qw(SubroutinePrototypes)"
NSQ_SOURCE_LINE 00000274 "{"
NSQ_SOURCE_LINE 00000275 "    # Allow to be called as a method"
NSQ_SOURCE_LINE 00000276 "    if ($_[0] and $_[0] eq 'File::HomeDir')"
NSQ_SOURCE_LINE 00000277 "    {"
NSQ_SOURCE_LINE 00000278 "        shift();"
NSQ_SOURCE_LINE 00000279 "    }"
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "    # No params means my home"
NSQ_SOURCE_LINE 00000282 "    return my_home() unless @_;"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "    # Check the param"
NSQ_SOURCE_LINE 00000285 "    my $name = shift;"
NSQ_SOURCE_LINE 00000286 "    if (!defined $name)"
NSQ_SOURCE_LINE 00000287 "    {"
NSQ_SOURCE_LINE 00000288 "        Carp::croak(\"Can't use undef as a username\");"
NSQ_SOURCE_LINE 00000289 "    }"
NSQ_SOURCE_LINE 00000290 "    if (!length $name)"
NSQ_SOURCE_LINE 00000291 "    {"
NSQ_SOURCE_LINE 00000292 "        Carp::croak(\"Can't use empty-string (\\\"\\\") as a username\");"
NSQ_SOURCE_LINE 00000293 "    }"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "    # A dot also means my home"
NSQ_SOURCE_LINE 00000296 "    ### Is this meant to mean File::Spec->curdir?"
NSQ_SOURCE_LINE 00000297 "    if ($name eq '.')"
NSQ_SOURCE_LINE 00000298 "    {"
NSQ_SOURCE_LINE 00000299 "        return my_home();"
NSQ_SOURCE_LINE 00000300 "    }"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "    # Now hand off to the implementor"
NSQ_SOURCE_LINE 00000303 "    $IMPLEMENTED_BY->users_home($name);"
NSQ_SOURCE_LINE 00000304 "}"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "1;"
