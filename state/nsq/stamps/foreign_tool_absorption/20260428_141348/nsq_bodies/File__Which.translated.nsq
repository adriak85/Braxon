BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package File::Which;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 "use base qw( Exporter );"
NSQ_SOURCE_LINE 00000006 "use File::Spec ();"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "# ABSTRACT: Perl implementation of the which utility as an API"
NSQ_SOURCE_LINE 00000009 "our $VERSION = '1.27'; # VERSION"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "our @EXPORT    = 'which';"
NSQ_SOURCE_LINE 00000013 "our @EXPORT_OK = 'where';"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "use constant IS_VMS => ($^O eq 'VMS');"
NSQ_SOURCE_LINE 00000016 "use constant IS_MAC => ($^O eq 'MacOS');"
NSQ_SOURCE_LINE 00000017 "use constant IS_WIN => ($^O eq 'MSWin32' or $^O eq 'dos' or $^O eq 'os2');"
NSQ_SOURCE_LINE 00000018 "use constant IS_DOS => IS_WIN();"
NSQ_SOURCE_LINE 00000019 "use constant IS_CYG => ($^O eq 'cygwin' || $^O eq 'msys');"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "our $IMPLICIT_CURRENT_DIR = IS_WIN || IS_VMS || IS_MAC;"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "# For Win32 systems, stores the extensions used for"
NSQ_SOURCE_LINE 00000024 "# executable files"
NSQ_SOURCE_LINE 00000025 "# For others, the empty string is used"
NSQ_SOURCE_LINE 00000026 "# because 'perl' . '' eq 'perl' => easier"
NSQ_SOURCE_LINE 00000027 "my @PATHEXT = ('');"
NSQ_SOURCE_LINE 00000028 "if ( IS_WIN ) {"
NSQ_SOURCE_LINE 00000029 "  # WinNT. PATHEXT might be set on Cygwin, but not used."
NSQ_SOURCE_LINE 00000030 "  if ( $ENV{PATHEXT} ) {"
NSQ_SOURCE_LINE 00000031 "    push @PATHEXT, split /;/, $ENV{PATHEXT};"
NSQ_SOURCE_LINE 00000032 "  } else {"
NSQ_SOURCE_LINE 00000033 "    # Win9X or other: doesn't have PATHEXT, so needs hardcoded."
NSQ_SOURCE_LINE 00000034 "    push @PATHEXT, qw{.com .exe .bat};"
NSQ_SOURCE_LINE 00000035 "  }"
NSQ_SOURCE_LINE 00000036 "} elsif ( IS_VMS ) {"
NSQ_SOURCE_LINE 00000037 "  push @PATHEXT, qw{.exe .com};"
NSQ_SOURCE_LINE 00000038 "} elsif ( IS_CYG ) {"
NSQ_SOURCE_LINE 00000039 "  # See this for more info"
NSQ_SOURCE_LINE 00000040 "  # http://cygwin.com/cygwin-ug-net/using-specialnames.html#pathnames-exe"
NSQ_SOURCE_LINE 00000041 "  push @PATHEXT, qw{.exe .com};"
NSQ_SOURCE_LINE 00000042 "}"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "sub which {"
NSQ_SOURCE_LINE 00000046 "  my ($exec) = @_;"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "  return undef unless defined $exec;"
NSQ_SOURCE_LINE 00000049 "  return undef if $exec eq '';"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "  my $all = wantarray;  ## no critic (Freenode::Wantarray)"
NSQ_SOURCE_LINE 00000052 "  my @results = ();"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "  # check for aliases first"
NSQ_SOURCE_LINE 00000055 "  if ( IS_VMS ) {"
NSQ_SOURCE_LINE 00000056 "    my $symbol = `SHOW SYMBOL $exec`;"
NSQ_SOURCE_LINE 00000057 "    chomp($symbol);"
NSQ_SOURCE_LINE 00000058 "    unless ( $? ) {"
NSQ_SOURCE_LINE 00000059 "      return $symbol unless $all;"
NSQ_SOURCE_LINE 00000060 "      push @results, $symbol;"
NSQ_SOURCE_LINE 00000061 "    }"
NSQ_SOURCE_LINE 00000062 "  }"
NSQ_SOURCE_LINE 00000063 "  if ( IS_MAC ) {"
NSQ_SOURCE_LINE 00000064 "    my @aliases = split /\\,/, $ENV{Aliases};"
NSQ_SOURCE_LINE 00000065 "    foreach my $alias ( @aliases ) {"
NSQ_SOURCE_LINE 00000066 "      # This has not been tested!!"
NSQ_SOURCE_LINE 00000067 "      # PPT which says MPW-Perl cannot resolve `Alias $alias`,"
NSQ_SOURCE_LINE 00000068 "      # let's just hope it's fixed"
NSQ_SOURCE_LINE 00000069 "      if ( lc($alias) eq lc($exec) ) {"
NSQ_SOURCE_LINE 00000070 "        chomp(my $file = `Alias $alias`);"
NSQ_SOURCE_LINE 00000071 "        last unless $file;  # if it failed, just go on the normal way"
NSQ_SOURCE_LINE 00000072 "        return $file unless $all;"
NSQ_SOURCE_LINE 00000073 "        push @results, $file;"
NSQ_SOURCE_LINE 00000074 "        # we can stop this loop as if it finds more aliases matching,"
NSQ_SOURCE_LINE 00000075 "        # it'll just be the same result anyway"
NSQ_SOURCE_LINE 00000076 "        last;"
NSQ_SOURCE_LINE 00000077 "      }"
NSQ_SOURCE_LINE 00000078 "    }"
NSQ_SOURCE_LINE 00000079 "  }"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "  return $exec  ## no critic (ValuesAndExpressions::ProhibitMixedBooleanOperators)"
NSQ_SOURCE_LINE 00000082 "          if !IS_VMS and !IS_MAC and !IS_WIN and $exec =~ /\\// and -f $exec and -x $exec;"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "  my @path;"
NSQ_SOURCE_LINE 00000085 "  if($^O eq 'MSWin32') {"
NSQ_SOURCE_LINE 00000086 "    # File::Spec (at least recent versions)"
NSQ_SOURCE_LINE 00000087 "    # add the implicit . for you on MSWin32,"
NSQ_SOURCE_LINE 00000088 "    # but we may or may not want to include"
NSQ_SOURCE_LINE 00000089 "    # that."
NSQ_SOURCE_LINE 00000090 "    @path = split /;/, $ENV{PATH};"
NSQ_SOURCE_LINE 00000091 "    s/\"//g for @path;"
NSQ_SOURCE_LINE 00000092 "    @path = grep length, @path;"
NSQ_SOURCE_LINE 00000093 "  } else {"
NSQ_SOURCE_LINE 00000094 "    @path = File::Spec->path;"
NSQ_SOURCE_LINE 00000095 "  }"
NSQ_SOURCE_LINE 00000096 "  if ( $IMPLICIT_CURRENT_DIR ) {"
NSQ_SOURCE_LINE 00000097 "    unshift @path, File::Spec->curdir;"
NSQ_SOURCE_LINE 00000098 "  }"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "  foreach my $base ( map { File::Spec->catfile($_, $exec) } @path ) {"
NSQ_SOURCE_LINE 00000101 "    for my $ext ( @PATHEXT ) {"
NSQ_SOURCE_LINE 00000102 "      my $file = $base.$ext;"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "      # We don't want dirs (as they are -x)"
NSQ_SOURCE_LINE 00000105 "      next if -d $file;"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "      if ("
NSQ_SOURCE_LINE 00000108 "        # Executable, normal case"
NSQ_SOURCE_LINE 00000109 "        -x _"
NSQ_SOURCE_LINE 00000110 "        or ("
NSQ_SOURCE_LINE 00000111 "          # MacOS doesn't mark as executable so we check -e"
NSQ_SOURCE_LINE 00000112 "          IS_MAC  ## no critic (ValuesAndExpressions::ProhibitMixedBooleanOperators)"
NSQ_SOURCE_LINE 00000113 "          ||"
NSQ_SOURCE_LINE 00000114 "          ("
NSQ_SOURCE_LINE 00000115 "            ( IS_WIN or IS_CYG )"
NSQ_SOURCE_LINE 00000116 "            and"
NSQ_SOURCE_LINE 00000117 "            grep {   ## no critic (BuiltinFunctions::ProhibitBooleanGrep)"
NSQ_SOURCE_LINE 00000118 "              $file =~ /$_\\z/i"
NSQ_SOURCE_LINE 00000119 "            } @PATHEXT[1..$#PATHEXT]"
NSQ_SOURCE_LINE 00000120 "          )"
NSQ_SOURCE_LINE 00000121 "          # DOSish systems don't pass -x on"
NSQ_SOURCE_LINE 00000122 "          # non-exe/bat/com files. so we check -e."
NSQ_SOURCE_LINE 00000123 "          # However, we don't want to pass -e on files"
NSQ_SOURCE_LINE 00000124 "          # that aren't in PATHEXT, like README."
NSQ_SOURCE_LINE 00000125 "          and -e _"
NSQ_SOURCE_LINE 00000126 "        )"
NSQ_SOURCE_LINE 00000127 "      ) {"
NSQ_SOURCE_LINE 00000128 "        return $file unless $all;"
NSQ_SOURCE_LINE 00000129 "        push @results, $file;"
NSQ_SOURCE_LINE 00000130 "      }"
NSQ_SOURCE_LINE 00000131 "    }"
NSQ_SOURCE_LINE 00000132 "  }"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "  if ( $all ) {"
NSQ_SOURCE_LINE 00000135 "    return @results;"
NSQ_SOURCE_LINE 00000136 "  } else {"
NSQ_SOURCE_LINE 00000137 "    return undef;"
NSQ_SOURCE_LINE 00000138 "  }"
NSQ_SOURCE_LINE 00000139 "}"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "sub where {"
NSQ_SOURCE_LINE 00000143 "  # force wantarray"
NSQ_SOURCE_LINE 00000144 "  my @res = which($_[0]);"
NSQ_SOURCE_LINE 00000145 "  return @res;"
NSQ_SOURCE_LINE 00000146 "}"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "1;"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "__END__"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "=pod"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "=head1 NAME"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "File::Which - Perl implementation of the which utility as an API"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "=head1 VERSION"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "version 1.27"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 " use File::Which;                  # exports which()"
NSQ_SOURCE_LINE 00000167 " use File::Which qw(which where);  # exports which() and where()"
NSQ_SOURCE_LINE 00000168 " "
NSQ_SOURCE_LINE 00000169 " my $exe_path = which 'perldoc';"
NSQ_SOURCE_LINE 00000170 " "
NSQ_SOURCE_LINE 00000171 " my @paths = where 'perl';"
NSQ_SOURCE_LINE 00000172 " # Or"
NSQ_SOURCE_LINE 00000173 " my @paths = which 'perl'; # an array forces search for all of them"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "L<File::Which> finds the full or relative paths to executable programs on"
NSQ_SOURCE_LINE 00000178 "the system.  This is normally the function of C<which> utility.  C<which> is"
NSQ_SOURCE_LINE 00000179 "typically implemented as either a program or a built in shell command.  On"
NSQ_SOURCE_LINE 00000180 "some platforms, such as Microsoft Windows it is not provided as part of the"
NSQ_SOURCE_LINE 00000181 "core operating system.  This module provides a consistent API to this"
NSQ_SOURCE_LINE 00000182 "functionality regardless of the underlying platform."
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "The focus of this module is correctness and portability.  As a consequence"
NSQ_SOURCE_LINE 00000185 "platforms where the current directory is implicitly part of the search path"
NSQ_SOURCE_LINE 00000186 "such as Microsoft Windows will find executables in the current directory,"
NSQ_SOURCE_LINE 00000187 "whereas on platforms such as UNIX where this is not the case executables"
NSQ_SOURCE_LINE 00000188 "in the current directory will only be found if the current directory is"
NSQ_SOURCE_LINE 00000189 "explicitly added to the path."
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "If you need a portable C<which> on the command line in an environment that"
NSQ_SOURCE_LINE 00000192 "does not provide it, install L<App::pwhich> which provides a command line"
NSQ_SOURCE_LINE 00000193 "interface to this API."
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "=head2 Implementations"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "L<File::Which> searches the directories of the user's C<PATH> (the current"
NSQ_SOURCE_LINE 00000198 "implementation uses L<File::Spec#path> to determine the correct C<PATH>),"
NSQ_SOURCE_LINE 00000199 "looking for executable files having the name specified as a parameter to"
NSQ_SOURCE_LINE 00000200 "L</which>. Under Win32 systems, which do not have a notion of directly"
NSQ_SOURCE_LINE 00000201 "executable files, but uses special extensions such as C<.exe> and C<.bat>"
NSQ_SOURCE_LINE 00000202 "to identify them, C<File::Which> takes extra steps to assure that"
NSQ_SOURCE_LINE 00000203 "you will find the correct file (so for example, you might be searching for"
NSQ_SOURCE_LINE 00000204 "C<perl>, it'll try F<perl.exe>, F<perl.bat>, etc.)"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "=head3 Linux, *BSD and other UNIXes"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "There should not be any surprises here.  The current directory will not be"
NSQ_SOURCE_LINE 00000209 "searched unless it is explicitly added to the path."
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "=head3 Modern Windows (including NT, XP, Vista, 7, 8, 10 etc)"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "Windows NT has a special environment variable called C<PATHEXT>, which is used"
NSQ_SOURCE_LINE 00000214 "by the shell to look for executable files. Usually, it will contain a list in"
NSQ_SOURCE_LINE 00000215 "the form C<.EXE;.BAT;.COM;.JS;.VBS> etc. If C<File::Which> finds such an"
NSQ_SOURCE_LINE 00000216 "environment variable, it parses the list and uses it as the different"
NSQ_SOURCE_LINE 00000217 "extensions."
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "=head3 Cygwin"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "Cygwin provides a Unix-like environment for Microsoft Windows users.  In most"
NSQ_SOURCE_LINE 00000222 "ways it works like other Unix and Unix-like environments, but in a few key"
NSQ_SOURCE_LINE 00000223 "aspects it works like Windows.  As with other Unix environments, the current"
NSQ_SOURCE_LINE 00000224 "directory is not included in the search unless it is explicitly included in"
NSQ_SOURCE_LINE 00000225 "the search path.  Like on Windows, files with C<.EXE> or <.BAT> extensions will"
NSQ_SOURCE_LINE 00000226 "be discovered even if they are not part of the query.  C<.COM> or extensions"
NSQ_SOURCE_LINE 00000227 "specified using the C<PATHEXT> environment variable will NOT be discovered"
NSQ_SOURCE_LINE 00000228 "without the fully qualified name, however."
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "=head3 Windows ME, 98, 95, MS-DOS, OS/2"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "This set of operating systems don't have the C<PATHEXT> variable, and usually"
NSQ_SOURCE_LINE 00000233 "you will find executable files there with the extensions C<.exe>, C<.bat> and"
NSQ_SOURCE_LINE 00000234 "(less likely) C<.com>. C<File::Which> uses this hardcoded list if it's running"
NSQ_SOURCE_LINE 00000235 "under Win32 but does not find a C<PATHEXT> variable."
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "As of 2015 none of these platforms are tested frequently (or perhaps ever),"
NSQ_SOURCE_LINE 00000238 "but the current maintainer is determined not to intentionally remove support"
NSQ_SOURCE_LINE 00000239 "for older operating systems."
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "=head3 VMS"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "Same case as Windows 9x: uses C<.exe> and C<.com> (in that order)."
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "As of 2015 the current maintainer does not test on VMS, and is in fact not"
NSQ_SOURCE_LINE 00000246 "certain it has ever been tested on VMS.  If this platform is important to you"
NSQ_SOURCE_LINE 00000247 "and you can help me verify and or support it on that platform please contact"
NSQ_SOURCE_LINE 00000248 "me."
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "=head2 which"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 " my $path = which $short_exe_name;"
NSQ_SOURCE_LINE 00000255 " my @paths = which $short_exe_name;"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "Exported by default."
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "C<$short_exe_name> is the name used in the shell to call the program (for"
NSQ_SOURCE_LINE 00000260 "example, C<perl>)."
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "If it finds an executable with the name you specified, C<which()> will return"
NSQ_SOURCE_LINE 00000263 "the absolute path leading to this executable (for example, F</usr/bin/perl> or"
NSQ_SOURCE_LINE 00000264 "F<C:\\Perl\\Bin\\perl.exe>)."
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "If it does I<not> find the executable, it returns C<undef>."
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "If C<which()> is called in list context, it will return I<all> the"
NSQ_SOURCE_LINE 00000269 "matches."
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "=head2 where"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 " my @paths = where $short_exe_name;"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "Not exported by default."
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "Same as L</which> in array context.  Similar to the C<where> csh"
NSQ_SOURCE_LINE 00000278 "built-in command or C<which -a> command for platforms that support the"
NSQ_SOURCE_LINE 00000279 "C<-a> option. Will return an array containing all the path names"
NSQ_SOURCE_LINE 00000280 "matching C<$short_exe_name>."
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "=head1 GLOBALS"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "=head2 $IMPLICIT_CURRENT_DIR"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "True if the current directory is included in the search implicitly on"
NSQ_SOURCE_LINE 00000287 "whatever platform you are using.  Normally the default is reasonable,"
NSQ_SOURCE_LINE 00000288 "but on Windows the current directory is included implicitly for older"
NSQ_SOURCE_LINE 00000289 "shells like C<cmd.exe> and C<command.com>, but not for newer shells"
NSQ_SOURCE_LINE 00000290 "like PowerShell.  If you overrule this default, you should ALWAYS"
NSQ_SOURCE_LINE 00000291 "localize the variable to the tightest scope possible, since setting"
NSQ_SOURCE_LINE 00000292 "this variable from a module can affect other modules.  Thus on Windows"
NSQ_SOURCE_LINE 00000293 "you can get the correct result if the user is running either C<cmd.exe>"
NSQ_SOURCE_LINE 00000294 "or PowerShell on Windows you can do this:"
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 " use File::Which qw( which );"
NSQ_SOURCE_LINE 00000297 " use Shell::Guess;"
NSQ_SOURCE_LINE 00000298 " "
NSQ_SOURCE_LINE 00000299 " my $path = do {"
NSQ_SOURCE_LINE 00000300 "   my $is_power = Shell::Guess->running_shell->is_power;"
NSQ_SOURCE_LINE 00000301 "   local $File::Which::IMPLICIT_CURRENT_DIR = !$is_power;"
NSQ_SOURCE_LINE 00000302 "   which 'foo';"
NSQ_SOURCE_LINE 00000303 " };"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "For a variety of reasons it is difficult to accurately compute the"
NSQ_SOURCE_LINE 00000306 "shell that a user is using, but L<Shell::Guess> makes a reasonable"
NSQ_SOURCE_LINE 00000307 "effort."
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "=head1 CAVEATS"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "This module has no non-core requirements for Perl 5.6.2 and better."
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "This module is fully supported back to Perl 5.8.1.  It may work on 5.8.0."
NSQ_SOURCE_LINE 00000314 "It should work on Perl 5.6.x and I may even test on 5.6.2.  I will accept"
NSQ_SOURCE_LINE 00000315 "patches to maintain compatibility for such older Perls, but you may"
NSQ_SOURCE_LINE 00000316 "need to fix it on 5.6.x / 5.8.0 and send me a patch."
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "Not tested on VMS although there is platform specific code"
NSQ_SOURCE_LINE 00000319 "for those. Anyone who haves a second would be very kind to send me a"
NSQ_SOURCE_LINE 00000320 "report of how it went."
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "=head1 SUPPORT"
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "Bugs should be reported via the GitHub issue tracker"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "L<https://github.com/uperl/File-Which/issues>"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "For other issues, contact the maintainer."
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "=over 4"
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "=item L<pwhich>, L<App::pwhich>"
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "Command line interface to this module."
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "=item L<IPC::Cmd>"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "Requires Perl 5.8.3.  Included as part of the Perl core as of 5.9.5."
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "This module provides (among other things) a C<can_run> function, which is"
NSQ_SOURCE_LINE 00000343 "similar to C<which>.  It is a much heavier module since it does a lot more,"
NSQ_SOURCE_LINE 00000344 "and if you use C<can_run> it pulls in L<ExtUtils::MakeMaker>.  This combination"
NSQ_SOURCE_LINE 00000345 "may be overkill for applications which do not need L<IPC::Cmd>'s complicated"
NSQ_SOURCE_LINE 00000346 "interface for running programs, or do not need the memory overhead required"
NSQ_SOURCE_LINE 00000347 "for installing Perl modules."
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "At least some older versions will find executables in the current directory,"
NSQ_SOURCE_LINE 00000350 "even if the current directory is not in the search path (which is the default"
NSQ_SOURCE_LINE 00000351 "on modern Unix)."
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "C<can_run> converts directory path name to the 8.3 version on Windows using"
NSQ_SOURCE_LINE 00000354 "C<Win32::GetShortPathName> in some cases.  This is frequently useful for tools"
NSQ_SOURCE_LINE 00000355 "that just need to run something using C<system> in scalar mode, but may be"
NSQ_SOURCE_LINE 00000356 "inconvenient for tools like L<App::pwhich> where user readability is a premium."
NSQ_SOURCE_LINE 00000357 "Relying on C<Win32::GetShortPathName> to produce filenames without spaces"
NSQ_SOURCE_LINE 00000358 "is problematic, as 8.3 filenames can be turned off with tweaks to the"
NSQ_SOURCE_LINE 00000359 "registry (see L<https://technet.microsoft.com/en-us/library/cc959352.aspx>)."
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "=item L<Devel::CheckBin>"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "Requires Perl 5.8.1."
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "This module purports to \"check that a command is available\", but does not"
NSQ_SOURCE_LINE 00000366 "provide any documentation on how you might use it."
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 "This module also relies on L<ExtUtils::MakeMaker> so has the same overhead"
NSQ_SOURCE_LINE 00000369 "burdens as L<IPC::Cmd>."
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "=back"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "=head1 AUTHORS"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "=over 4"
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "=item *"
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "Per Einar Ellefsen <pereinar@cpan.org>"
NSQ_SOURCE_LINE 00000380 ""
