NSQ_SOURCE_LINE 00001198 "  $self->{default_hook}->{$name} = _instr $self, $name, $instr;"
NSQ_SOURCE_LINE 00001199 "  $self;"
NSQ_SOURCE_LINE 00001200 "}"
NSQ_SOURCE_LINE 00001201 ""
NSQ_SOURCE_LINE 00001202 ""
NSQ_SOURCE_LINE 00001203 "sub around_hook"
NSQ_SOURCE_LINE 00001204 "{"
NSQ_SOURCE_LINE 00001205 "  my($self, $name, $code) = @_;"
NSQ_SOURCE_LINE 00001206 "  if(my $old = $self->{around}->{$name})"
NSQ_SOURCE_LINE 00001207 "  {"
NSQ_SOURCE_LINE 00001208 "    # this is the craziest shit I have ever"
NSQ_SOURCE_LINE 00001209 "    # come up with."
NSQ_SOURCE_LINE 00001210 "    $self->{around}->{$name} = sub {"
NSQ_SOURCE_LINE 00001211 "      my $orig = shift;"
NSQ_SOURCE_LINE 00001212 "      $code->(sub { $old->($orig, @_) }, @_);"
NSQ_SOURCE_LINE 00001213 "    };"
NSQ_SOURCE_LINE 00001214 "  }"
NSQ_SOURCE_LINE 00001215 "  else"
NSQ_SOURCE_LINE 00001216 "  {"
NSQ_SOURCE_LINE 00001217 "    $self->{around}->{$name} = $code;"
NSQ_SOURCE_LINE 00001218 "  }"
NSQ_SOURCE_LINE 00001219 "}"
NSQ_SOURCE_LINE 00001220 ""
NSQ_SOURCE_LINE 00001221 ""
NSQ_SOURCE_LINE 00001222 "sub after_hook"
NSQ_SOURCE_LINE 00001223 "{"
NSQ_SOURCE_LINE 00001224 "  my($self, $name, $code) = @_;"
NSQ_SOURCE_LINE 00001225 "  $self->around_hook("
NSQ_SOURCE_LINE 00001226 "    $name => sub {"
NSQ_SOURCE_LINE 00001227 "      my $orig = shift;"
NSQ_SOURCE_LINE 00001228 "      my $ret = $orig->(@_);"
NSQ_SOURCE_LINE 00001229 "      $code->(@_);"
NSQ_SOURCE_LINE 00001230 "      $ret;"
NSQ_SOURCE_LINE 00001231 "    }"
NSQ_SOURCE_LINE 00001232 "  );"
NSQ_SOURCE_LINE 00001233 "}"
NSQ_SOURCE_LINE 00001234 ""
NSQ_SOURCE_LINE 00001235 ""
NSQ_SOURCE_LINE 00001236 "sub before_hook"
NSQ_SOURCE_LINE 00001237 "{"
NSQ_SOURCE_LINE 00001238 "  my($self, $name, $code) = @_;"
NSQ_SOURCE_LINE 00001239 "  $self->around_hook("
NSQ_SOURCE_LINE 00001240 "    $name => sub {"
NSQ_SOURCE_LINE 00001241 "      my $orig = shift;"
NSQ_SOURCE_LINE 00001242 "      $code->(@_);"
NSQ_SOURCE_LINE 00001243 "      my $ret = $orig->(@_);"
NSQ_SOURCE_LINE 00001244 "      $ret;"
NSQ_SOURCE_LINE 00001245 "    }"
NSQ_SOURCE_LINE 00001246 "  );"
NSQ_SOURCE_LINE 00001247 "}"
NSQ_SOURCE_LINE 00001248 ""
NSQ_SOURCE_LINE 00001249 ""
NSQ_SOURCE_LINE 00001250 "sub call_hook"
NSQ_SOURCE_LINE 00001251 "{"
NSQ_SOURCE_LINE 00001252 "  my $self = shift;"
NSQ_SOURCE_LINE 00001253 "  my %args = ref $_[0] ? %{ shift() } : ();"
NSQ_SOURCE_LINE 00001254 "  my($name, @args) = @_;"
NSQ_SOURCE_LINE 00001255 "  my $error;"
NSQ_SOURCE_LINE 00001256 ""
NSQ_SOURCE_LINE 00001257 "  my @hooks = @{ $self->{hook}->{$name} || []};"
NSQ_SOURCE_LINE 00001258 ""
NSQ_SOURCE_LINE 00001259 "  if(@hooks == 0)"
NSQ_SOURCE_LINE 00001260 "  {"
NSQ_SOURCE_LINE 00001261 "    if(defined $self->{default_hook}->{$name})"
NSQ_SOURCE_LINE 00001262 "    {"
NSQ_SOURCE_LINE 00001263 "      @hooks = ($self->{default_hook}->{$name})"
NSQ_SOURCE_LINE 00001264 "    }"
NSQ_SOURCE_LINE 00001265 "    elsif(!$args{all})"
NSQ_SOURCE_LINE 00001266 "    {"
NSQ_SOURCE_LINE 00001267 "      Carp::croak \"No hooks registered for $name\";"
NSQ_SOURCE_LINE 00001268 "    }"
NSQ_SOURCE_LINE 00001269 "  }"
NSQ_SOURCE_LINE 00001270 ""
NSQ_SOURCE_LINE 00001271 "  my $value;"
NSQ_SOURCE_LINE 00001272 ""
NSQ_SOURCE_LINE 00001273 "  foreach my $hook (@hooks)"
NSQ_SOURCE_LINE 00001274 "  {"
NSQ_SOURCE_LINE 00001275 "    if(eval { $args[0]->isa('Alien::Build') })"
NSQ_SOURCE_LINE 00001276 "    {"
NSQ_SOURCE_LINE 00001277 "      %{ $args[0]->{hook_prop} } = ("
NSQ_SOURCE_LINE 00001278 "        name => $name,"
NSQ_SOURCE_LINE 00001279 "      );"
NSQ_SOURCE_LINE 00001280 "    }"
NSQ_SOURCE_LINE 00001281 ""
NSQ_SOURCE_LINE 00001282 "    my $wrapper = $self->{around}->{$name} || sub { my $code = shift; $code->(@_) };"
NSQ_SOURCE_LINE 00001283 "    my $value;"
NSQ_SOURCE_LINE 00001284 "    $args{before}->() if $args{before};"
NSQ_SOURCE_LINE 00001285 "    if(ref($hook) eq 'CODE')"
NSQ_SOURCE_LINE 00001286 "    {"
NSQ_SOURCE_LINE 00001287 "      $value = eval {"
NSQ_SOURCE_LINE 00001288 "        my $value = $wrapper->(sub { $hook->(@_) }, @args);"
NSQ_SOURCE_LINE 00001289 "        $args{verify}->('code') if $args{verify};"
NSQ_SOURCE_LINE 00001290 "        $value;"
NSQ_SOURCE_LINE 00001291 "      };"
NSQ_SOURCE_LINE 00001292 "    }"
NSQ_SOURCE_LINE 00001293 "    else"
NSQ_SOURCE_LINE 00001294 "    {"
NSQ_SOURCE_LINE 00001295 "      $value = $wrapper->(sub {"
NSQ_SOURCE_LINE 00001296 "        eval {"
NSQ_SOURCE_LINE 00001297 "          $hook->execute(@_);"
NSQ_SOURCE_LINE 00001298 "          $args{verify}->('command') if $args{verify};"
NSQ_SOURCE_LINE 00001299 "        };"
NSQ_SOURCE_LINE 00001300 "        defined $args{ok} ? $args{ok} : 1;"
NSQ_SOURCE_LINE 00001301 "      }, @args);"
NSQ_SOURCE_LINE 00001302 "    }"
NSQ_SOURCE_LINE 00001303 "    $error = $@;"
NSQ_SOURCE_LINE 00001304 "    $args{after}->() if $args{after};"
NSQ_SOURCE_LINE 00001305 "    if($args{all})"
NSQ_SOURCE_LINE 00001306 "    {"
NSQ_SOURCE_LINE 00001307 "      die if $error;"
NSQ_SOURCE_LINE 00001308 "    }"
NSQ_SOURCE_LINE 00001309 "    else"
NSQ_SOURCE_LINE 00001310 "    {"
NSQ_SOURCE_LINE 00001311 "      next if $error;"
NSQ_SOURCE_LINE 00001312 "      next if $args{continue} && $args{continue}->($value);"
NSQ_SOURCE_LINE 00001313 "      return $value;"
NSQ_SOURCE_LINE 00001314 "    }"
NSQ_SOURCE_LINE 00001315 "  }"
NSQ_SOURCE_LINE 00001316 ""
NSQ_SOURCE_LINE 00001317 "  die $error if $error && ! $args{all};"
NSQ_SOURCE_LINE 00001318 ""
NSQ_SOURCE_LINE 00001319 "  $value;"
NSQ_SOURCE_LINE 00001320 "}"
NSQ_SOURCE_LINE 00001321 ""
NSQ_SOURCE_LINE 00001322 ""
NSQ_SOURCE_LINE 00001323 "sub apply_plugin"
NSQ_SOURCE_LINE 00001324 "{"
NSQ_SOURCE_LINE 00001325 "  my($self, $name, @args) = @_;"
NSQ_SOURCE_LINE 00001326 ""
NSQ_SOURCE_LINE 00001327 "  my $class;"
NSQ_SOURCE_LINE 00001328 "  my $pm;"
NSQ_SOURCE_LINE 00001329 "  my $found;"
NSQ_SOURCE_LINE 00001330 ""
NSQ_SOURCE_LINE 00001331 "  if($name =~ /^=(.*)$/)"
NSQ_SOURCE_LINE 00001332 "  {"
NSQ_SOURCE_LINE 00001333 "    $class = $1;"
NSQ_SOURCE_LINE 00001334 "    $pm    = \"$class.pm\";"
NSQ_SOURCE_LINE 00001335 "    $pm    =~ s!::!/!g;"
NSQ_SOURCE_LINE 00001336 "    $found = 1;"
NSQ_SOURCE_LINE 00001337 "  }"
NSQ_SOURCE_LINE 00001338 ""
NSQ_SOURCE_LINE 00001339 "  if($name !~ /::/ && !$found)"
NSQ_SOURCE_LINE 00001340 "  {"
NSQ_SOURCE_LINE 00001341 "    foreach my $inc (@INC)"
NSQ_SOURCE_LINE 00001342 "    {"
NSQ_SOURCE_LINE 00001343 "      # TODO: allow negotiators to work with @INC hooks"
NSQ_SOURCE_LINE 00001344 "      next if ref $inc;"
NSQ_SOURCE_LINE 00001345 "      my $file = Path::Tiny->new(\"$inc/Alien/Build/Plugin/$name/Negotiate.pm\");"
NSQ_SOURCE_LINE 00001346 "      if(-r $file)"
NSQ_SOURCE_LINE 00001347 "      {"
NSQ_SOURCE_LINE 00001348 "        $class = \"Alien::Build::Plugin::${name}::Negotiate\";"
NSQ_SOURCE_LINE 00001349 "        $pm    = \"Alien/Build/Plugin/$name/Negotiate.pm\";"
NSQ_SOURCE_LINE 00001350 "        $found = 1;"
NSQ_SOURCE_LINE 00001351 "        last;"
NSQ_SOURCE_LINE 00001352 "      }"
NSQ_SOURCE_LINE 00001353 "    }"
NSQ_SOURCE_LINE 00001354 "  }"
NSQ_SOURCE_LINE 00001355 ""
NSQ_SOURCE_LINE 00001356 "  unless($found)"
NSQ_SOURCE_LINE 00001357 "  {"
NSQ_SOURCE_LINE 00001358 "    $class = \"Alien::Build::Plugin::$name\";"
NSQ_SOURCE_LINE 00001359 "    $pm    = \"Alien/Build/Plugin/$name.pm\";"
NSQ_SOURCE_LINE 00001360 "    $pm    =~ s{::}{/}g;"
NSQ_SOURCE_LINE 00001361 "  }"
NSQ_SOURCE_LINE 00001362 ""
NSQ_SOURCE_LINE 00001363 "  require $pm unless $class->can('new');"
NSQ_SOURCE_LINE 00001364 "  my $plugin = $class->new(@args);"
NSQ_SOURCE_LINE 00001365 "  $plugin->init($self);"
NSQ_SOURCE_LINE 00001366 "  $self;"
NSQ_SOURCE_LINE 00001367 "}"
NSQ_SOURCE_LINE 00001368 ""
NSQ_SOURCE_LINE 00001369 "package Alien::Build::TempDir;"
NSQ_SOURCE_LINE 00001370 ""
NSQ_SOURCE_LINE 00001371 "# TODO: it's confusing that there is both a AB::TempDir and AB::Temp"
NSQ_SOURCE_LINE 00001372 "# although they do different things.  there could maybe be a better"
NSQ_SOURCE_LINE 00001373 "# name for AB::TempDir (maybe AB::TempBuildDir, though that is a little"
NSQ_SOURCE_LINE 00001374 "# redundant).  Happily both are private classes, and either are able to"
NSQ_SOURCE_LINE 00001375 "# rename, if a good name can be thought of."
NSQ_SOURCE_LINE 00001376 ""
NSQ_SOURCE_LINE 00001377 "use overload '\"\"' => sub { shift->as_string }, bool => sub { 1 }, fallback => 1;"
NSQ_SOURCE_LINE 00001378 "use File::Temp qw( tempdir );"
NSQ_SOURCE_LINE 00001379 ""
NSQ_SOURCE_LINE 00001380 "sub new"
NSQ_SOURCE_LINE 00001381 "{"
NSQ_SOURCE_LINE 00001382 "  my($class, $build, $name) = @_;"
NSQ_SOURCE_LINE 00001383 "  my $root = $build->install_prop->{root};"
NSQ_SOURCE_LINE 00001384 "  Path::Tiny->new($root)->mkpath unless -d $root;"
NSQ_SOURCE_LINE 00001385 "  bless {"
NSQ_SOURCE_LINE 00001386 "    dir => Path::Tiny->new(tempdir( \"${name}_XXXX\", DIR => $root)),"
NSQ_SOURCE_LINE 00001387 "  }, $class;"
NSQ_SOURCE_LINE 00001388 "}"
NSQ_SOURCE_LINE 00001389 ""
NSQ_SOURCE_LINE 00001390 "sub as_string"
NSQ_SOURCE_LINE 00001391 "{"
NSQ_SOURCE_LINE 00001392 "  shift->{dir}->stringify;"
NSQ_SOURCE_LINE 00001393 "}"
NSQ_SOURCE_LINE 00001394 ""
NSQ_SOURCE_LINE 00001395 "sub DESTROY"
NSQ_SOURCE_LINE 00001396 "{"
NSQ_SOURCE_LINE 00001397 "  my($self) = @_;"
NSQ_SOURCE_LINE 00001398 "  if(-d $self->{dir} && $self->{dir}->children == 0)"
NSQ_SOURCE_LINE 00001399 "  {"
NSQ_SOURCE_LINE 00001400 "    rmdir($self->{dir}) || warn \"unable to remove @{[ $self->{dir} ]} $!\";"
NSQ_SOURCE_LINE 00001401 "  }"
NSQ_SOURCE_LINE 00001402 "}"
NSQ_SOURCE_LINE 00001403 ""
NSQ_SOURCE_LINE 00001404 "1;"
NSQ_SOURCE_LINE 00001405 ""
NSQ_SOURCE_LINE 00001406 "__END__"
NSQ_SOURCE_LINE 00001407 ""
NSQ_SOURCE_LINE 00001408 "=pod"
NSQ_SOURCE_LINE 00001409 ""
NSQ_SOURCE_LINE 00001410 "=encoding UTF-8"
NSQ_SOURCE_LINE 00001411 ""
NSQ_SOURCE_LINE 00001412 "=head1 NAME"
NSQ_SOURCE_LINE 00001413 ""
NSQ_SOURCE_LINE 00001414 "Alien::Build - Build external dependencies for use in CPAN"
NSQ_SOURCE_LINE 00001415 ""
NSQ_SOURCE_LINE 00001416 "=head1 VERSION"
NSQ_SOURCE_LINE 00001417 ""
NSQ_SOURCE_LINE 00001418 "version 2.84"
NSQ_SOURCE_LINE 00001419 ""
NSQ_SOURCE_LINE 00001420 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00001421 ""
NSQ_SOURCE_LINE 00001422 " my $build = Alien::Build->load('./alienfile');"
NSQ_SOURCE_LINE 00001423 " $build->load_requires('configure');"
NSQ_SOURCE_LINE 00001424 " $build->set_prefix('/usr/local');"
NSQ_SOURCE_LINE 00001425 " $build->set_stage('/foo/mystage');  # needs to be absolute"
NSQ_SOURCE_LINE 00001426 " $build->load_requires($build->install_type);"
NSQ_SOURCE_LINE 00001427 " $build->download;"
NSQ_SOURCE_LINE 00001428 " $build->build;"
NSQ_SOURCE_LINE 00001429 " # files are now in /foo/mystage, it is your job (or"
NSQ_SOURCE_LINE 00001430 " # ExtUtils::MakeMaker, Module::Build, etc) to copy"
NSQ_SOURCE_LINE 00001431 " # those files into /usr/local"
NSQ_SOURCE_LINE 00001432 ""
NSQ_SOURCE_LINE 00001433 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00001434 ""
NSQ_SOURCE_LINE 00001435 "This module provides tools for building external (non-CPAN) dependencies"
NSQ_SOURCE_LINE 00001436 "for CPAN.  It is mainly designed to be used at install time of a CPAN"
NSQ_SOURCE_LINE 00001437 "client, and work closely with L<Alien::Base> which is used at runtime."
NSQ_SOURCE_LINE 00001438 ""
NSQ_SOURCE_LINE 00001439 "This is the detailed documentation for the L<Alien::Build> class."
NSQ_SOURCE_LINE 00001440 "If you are starting out you probably want to do so from one of these documents:"
NSQ_SOURCE_LINE 00001441 ""
NSQ_SOURCE_LINE 00001442 "=over 4"
NSQ_SOURCE_LINE 00001443 ""
NSQ_SOURCE_LINE 00001444 "=item L<Alien::Build::Manual::Alien>"
NSQ_SOURCE_LINE 00001445 ""
NSQ_SOURCE_LINE 00001446 "A broad overview of C<Alien-Build> and its ecosystem."
NSQ_SOURCE_LINE 00001447 ""
NSQ_SOURCE_LINE 00001448 "=item L<Alien::Build::Manual::AlienUser>"
NSQ_SOURCE_LINE 00001449 ""
NSQ_SOURCE_LINE 00001450 "For users of an C<Alien::libfoo> that is implemented using L<Alien::Base>."
NSQ_SOURCE_LINE 00001451 "(The developer of C<Alien::libfoo> I<should> provide the documentation"
NSQ_SOURCE_LINE 00001452 "necessary, but if not, this is the place to start)."
NSQ_SOURCE_LINE 00001453 ""
NSQ_SOURCE_LINE 00001454 "=item L<Alien::Build::Manual::AlienAuthor>"
NSQ_SOURCE_LINE 00001455 ""
NSQ_SOURCE_LINE 00001456 "If you are writing your own L<Alien> based on L<Alien::Build> and L<Alien::Base>."
NSQ_SOURCE_LINE 00001457 ""
NSQ_SOURCE_LINE 00001458 "=item L<Alien::Build::Manual::FAQ>"
NSQ_SOURCE_LINE 00001459 ""
NSQ_SOURCE_LINE 00001460 "If you have a common question that has already been answered, like"
NSQ_SOURCE_LINE 00001461 "\"How do I use L<alienfile> with some build system\"."
NSQ_SOURCE_LINE 00001462 ""
NSQ_SOURCE_LINE 00001463 "=item L<Alien::Build::Manual::PluginAuthor>"
NSQ_SOURCE_LINE 00001464 ""
NSQ_SOURCE_LINE 00001465 "This is for the brave souls who want to write plugins that will work with"
NSQ_SOURCE_LINE 00001466 "L<Alien::Build> + L<alienfile>."
NSQ_SOURCE_LINE 00001467 ""
NSQ_SOURCE_LINE 00001468 "=item L<Alien::Build::Manual::Security>"
NSQ_SOURCE_LINE 00001469 ""
NSQ_SOURCE_LINE 00001470 "If you are concerned that L<Alien>s might be downloading tarballs off"
NSQ_SOURCE_LINE 00001471 "the internet, then this is the place for you.  This will discuss some"
NSQ_SOURCE_LINE 00001472 "of the risks of downloading (really any) software off the internet"
NSQ_SOURCE_LINE 00001473 "and will give you some tools to remediate these risks."
NSQ_SOURCE_LINE 00001474 ""
NSQ_SOURCE_LINE 00001475 "=back"
NSQ_SOURCE_LINE 00001476 ""
NSQ_SOURCE_LINE 00001477 "Note that you will not usually create a L<Alien::Build> instance"
NSQ_SOURCE_LINE 00001478 "directly, but rather be using a thin installer layer, such as"
NSQ_SOURCE_LINE 00001479 "L<Alien::Build::MM> (for use with L<ExtUtils::MakeMaker>) or"
NSQ_SOURCE_LINE 00001480 "L<Alien::Build::MB> (for use with L<Module::Build>).  One of the"
NSQ_SOURCE_LINE 00001481 "goals of this project is to remain installer agnostic."
NSQ_SOURCE_LINE 00001482 ""
NSQ_SOURCE_LINE 00001483 "=head1 CONSTRUCTORS"
NSQ_SOURCE_LINE 00001484 ""
NSQ_SOURCE_LINE 00001485 "=head2 new"
NSQ_SOURCE_LINE 00001486 ""
NSQ_SOURCE_LINE 00001487 " my $build = Alien::Build->new;"
NSQ_SOURCE_LINE 00001488 ""
NSQ_SOURCE_LINE 00001489 "This creates a new empty instance of L<Alien::Build>.  Normally you will"
NSQ_SOURCE_LINE 00001490 "want to use C<load> below to create an instance of L<Alien::Build> from"
NSQ_SOURCE_LINE 00001491 "an L<alienfile> recipe."
NSQ_SOURCE_LINE 00001492 ""
NSQ_SOURCE_LINE 00001493 "=head2 load"
NSQ_SOURCE_LINE 00001494 ""
NSQ_SOURCE_LINE 00001495 " my $build = Alien::Build->load($alienfile);"
NSQ_SOURCE_LINE 00001496 ""
NSQ_SOURCE_LINE 00001497 "This creates an L<Alien::Build> instance with the given L<alienfile>"
NSQ_SOURCE_LINE 00001498 "recipe."
NSQ_SOURCE_LINE 00001499 ""
NSQ_SOURCE_LINE 00001500 "=head2 resume"
NSQ_SOURCE_LINE 00001501 ""
NSQ_SOURCE_LINE 00001502 " my $build = Alien::Build->resume($alienfile, $root);"
NSQ_SOURCE_LINE 00001503 ""
NSQ_SOURCE_LINE 00001504 "Load a checkpointed L<Alien::Build> instance.  You will need the original"
NSQ_SOURCE_LINE 00001505 "L<alienfile> and the build root (usually C<_alien>), and a build that"
NSQ_SOURCE_LINE 00001506 "had been properly checkpointed using the C<checkpoint> method below."
NSQ_SOURCE_LINE 00001507 ""
NSQ_SOURCE_LINE 00001508 "=head1 PROPERTIES"
NSQ_SOURCE_LINE 00001509 ""
NSQ_SOURCE_LINE 00001510 "There are three main properties for L<Alien::Build>.  There are a number"
NSQ_SOURCE_LINE 00001511 "of properties documented here with a specific usage.  Note that these"
NSQ_SOURCE_LINE 00001512 "properties may need to be serialized into something primitive like JSON"
NSQ_SOURCE_LINE 00001513 "that does not support: regular expressions, code references of blessed"
NSQ_SOURCE_LINE 00001514 "objects."
NSQ_SOURCE_LINE 00001515 ""
NSQ_SOURCE_LINE 00001516 "If you are writing a plugin (L<Alien::Build::Plugin>) you should use a"
NSQ_SOURCE_LINE 00001517 "prefix like \"plugin_I<name>\" (where I<name> is the name of your plugin)"
NSQ_SOURCE_LINE 00001518 "so that it does not interfere with other plugin or future versions of"
NSQ_SOURCE_LINE 00001519 "L<Alien::Build>.  For example, if you were writing"
NSQ_SOURCE_LINE 00001520 "C<Alien::Build::Plugin::Fetch::NewProtocol>, please use the prefix"
NSQ_SOURCE_LINE 00001521 "C<plugin_fetch_newprotocol>:"
NSQ_SOURCE_LINE 00001522 ""
NSQ_SOURCE_LINE 00001523 " sub init"
NSQ_SOURCE_LINE 00001524 " {"
NSQ_SOURCE_LINE 00001525 "   my($self, $meta) = @_;"
NSQ_SOURCE_LINE 00001526 " "
NSQ_SOURCE_LINE 00001527 "   $meta->prop( plugin_fetch_newprotocol_foo => 'some value' );"
NSQ_SOURCE_LINE 00001528 " "
NSQ_SOURCE_LINE 00001529 "   $meta->register_hook("
NSQ_SOURCE_LINE 00001530 "     some_hook => sub {"
NSQ_SOURCE_LINE 00001531 "       my($build) = @_;"
NSQ_SOURCE_LINE 00001532 "       $build->install_prop->{plugin_fetch_newprotocol_bar} = 'some other value';"
NSQ_SOURCE_LINE 00001533 "       $build->runtime_prop->{plugin_fetch_newprotocol_baz} = 'and another value';"
NSQ_SOURCE_LINE 00001534 "     }"
NSQ_SOURCE_LINE 00001535 "   );"
NSQ_SOURCE_LINE 00001536 " }"
NSQ_SOURCE_LINE 00001537 ""
NSQ_SOURCE_LINE 00001538 "If you are writing a L<alienfile> recipe please use the prefix C<my_>:"
NSQ_SOURCE_LINE 00001539 ""
NSQ_SOURCE_LINE 00001540 " use alienfile;"
NSQ_SOURCE_LINE 00001541 " "
NSQ_SOURCE_LINE 00001542 " meta_prop->{my_foo} = 'some value';"
NSQ_SOURCE_LINE 00001543 " "
NSQ_SOURCE_LINE 00001544 " probe sub {"
NSQ_SOURCE_LINE 00001545 "   my($build) = @_;"
NSQ_SOURCE_LINE 00001546 "   $build->install_prop->{my_bar} = 'some other value';"
NSQ_SOURCE_LINE 00001547 "   $build->install_prop->{my_baz} = 'and another value';"
NSQ_SOURCE_LINE 00001548 " };"
NSQ_SOURCE_LINE 00001549 ""
NSQ_SOURCE_LINE 00001550 "Any property may be used from a command:"
NSQ_SOURCE_LINE 00001551 ""
NSQ_SOURCE_LINE 00001552 " probe [ 'some command %{.meta.plugin_fetch_newprotocol_foo}' ];"
NSQ_SOURCE_LINE 00001553 " probe [ 'some command %{.install.plugin_fetch_newprotocol_bar}' ];"
NSQ_SOURCE_LINE 00001554 " probe [ 'some command %{.runtime.plugin_fetch_newprotocol_baz}' ];"
NSQ_SOURCE_LINE 00001555 " probe [ 'some command %{.meta.my_foo}' ];"
NSQ_SOURCE_LINE 00001556 " probe [ 'some command %{.install.my_bar}' ];"
NSQ_SOURCE_LINE 00001557 " probe [ 'some command %{.runtime.my_baz}' ];"
NSQ_SOURCE_LINE 00001558 ""
NSQ_SOURCE_LINE 00001559 "=head2 meta_prop"
NSQ_SOURCE_LINE 00001560 ""
NSQ_SOURCE_LINE 00001561 " my $href = $build->meta_prop;"
NSQ_SOURCE_LINE 00001562 " my $href = Alien::Build->meta_prop;"
NSQ_SOURCE_LINE 00001563 ""
NSQ_SOURCE_LINE 00001564 "Meta properties have to do with the recipe itself, and not any particular"
NSQ_SOURCE_LINE 00001565 "instance that probes or builds that recipe.  Meta properties can be changed"
NSQ_SOURCE_LINE 00001566 "from within an L<alienfile> using the C<meta_prop> directive, or from"
NSQ_SOURCE_LINE 00001567 "a plugin from its C<init> method (though should NOT be modified from any"
NSQ_SOURCE_LINE 00001568 "hooks registered within that C<init> method).  This is not strictly enforced,"
NSQ_SOURCE_LINE 00001569 "but if you do not follow this rule your recipe will likely be broken."
NSQ_SOURCE_LINE 00001570 ""
NSQ_SOURCE_LINE 00001571 "=over"
NSQ_SOURCE_LINE 00001572 ""
NSQ_SOURCE_LINE 00001573 "=item arch"
NSQ_SOURCE_LINE 00001574 ""
NSQ_SOURCE_LINE 00001575 "This is a hint to an installer like L<Alien::Build::MM> or L<Alien::Build::MB>,"
NSQ_SOURCE_LINE 00001576 "that the library or tool contains architecture dependent files and so should"
NSQ_SOURCE_LINE 00001577 "be stored in an architecture dependent location.  If not specified by your"
NSQ_SOURCE_LINE 00001578 "L<alienfile> then it will be set to true."
NSQ_SOURCE_LINE 00001579 ""
NSQ_SOURCE_LINE 00001580 "=item check_digest"
NSQ_SOURCE_LINE 00001581 ""
NSQ_SOURCE_LINE 00001582 "True if cryptographic digest should be checked when files are fetched"
NSQ_SOURCE_LINE 00001583 "or downloaded.  This is set by"
NSQ_SOURCE_LINE 00001584 "L<Digest negotiator plugin|Alien::Build::Plugin::Digest::Negotiate>."
NSQ_SOURCE_LINE 00001585 ""
NSQ_SOURCE_LINE 00001586 "=item destdir"
NSQ_SOURCE_LINE 00001587 ""
NSQ_SOURCE_LINE 00001588 "Some plugins (L<Alien::Build::Plugin::Build::Autoconf> for example) support"
NSQ_SOURCE_LINE 00001589 "installing via C<DESTDIR>.  They will set this property to true if they"
NSQ_SOURCE_LINE 00001590 "plan on doing such an install.  This helps L<Alien::Build> find the staged"
NSQ_SOURCE_LINE 00001591 "install files and how to locate them."
NSQ_SOURCE_LINE 00001592 ""
NSQ_SOURCE_LINE 00001593 "If available, C<DESTDIR> is used to stage install files in a sub directory before"
NSQ_SOURCE_LINE 00001594 "copying the files into C<blib>.  This is generally preferred method"
NSQ_SOURCE_LINE 00001595 "if available."
NSQ_SOURCE_LINE 00001596 ""
NSQ_SOURCE_LINE 00001597 "=item destdir_filter"
NSQ_SOURCE_LINE 00001598 ""
NSQ_SOURCE_LINE 00001599 "Regular expression for the files that should be copied from the C<DESTDIR>"
NSQ_SOURCE_LINE 00001600 "into the stage directory.  If not defined, then all files will be copied."
NSQ_SOURCE_LINE 00001601 ""
NSQ_SOURCE_LINE 00001602 "=item destdir_ffi_filter"
NSQ_SOURCE_LINE 00001603 ""
NSQ_SOURCE_LINE 00001604 "Same as C<destdir_filter> except applies to C<build_ffi> instead of C<build>."
NSQ_SOURCE_LINE 00001605 ""
NSQ_SOURCE_LINE 00001606 "=item digest"
NSQ_SOURCE_LINE 00001607 ""
NSQ_SOURCE_LINE 00001608 "This properties contains the cryptographic digests (if any) that should"
NSQ_SOURCE_LINE 00001609 "be used when verifying any fetched and downloaded files.  It is a hash"
NSQ_SOURCE_LINE 00001610 "reference where the key is the filename and the value is an array"
NSQ_SOURCE_LINE 00001611 "reference containing a pair of values, the first being the algorithm"
NSQ_SOURCE_LINE 00001612 "('SHA256' is recommended) and the second is the actual digest.  The"
NSQ_SOURCE_LINE 00001613 "special filename C<*> may be specified to indicate that any downloaded"
NSQ_SOURCE_LINE 00001614 "file should match that digest.  If there are both real filenames and"
NSQ_SOURCE_LINE 00001615 "the C<*> placeholder, the real filenames will be used for filenames"
NSQ_SOURCE_LINE 00001616 "that match and any other files will use the placeholder.  Example:"
NSQ_SOURCE_LINE 00001617 ""
NSQ_SOURCE_LINE 00001618 " $build->meta_prop->{digest} = {"
NSQ_SOURCE_LINE 00001619 "   'foo-1.00.tar.gz' => [ SHA256 => '9feac593aa49a44eb837de52513a57736457f1ea70078346c60f0bfc5f24f2c1' ],"
NSQ_SOURCE_LINE 00001620 "   'foo-1.01.tar.gz' => [ SHA256 => '6bbde6a7f10ae5924cf74afc26ff5b7bc4b4f9dfd85c6b534c51bd254697b9e7' ],"
NSQ_SOURCE_LINE 00001621 "   '*'               => [ SHA256 => '33a20aae3df6ecfbe812b48082926d55391be4a57d858d35753ab1334b9fddb3' ],"
NSQ_SOURCE_LINE 00001622 " };"
NSQ_SOURCE_LINE 00001623 ""
NSQ_SOURCE_LINE 00001624 "Cryptographic signatures will only be checked"
NSQ_SOURCE_LINE 00001625 "if the L<check_digest meta property|/check_digest> is set and if the"
NSQ_SOURCE_LINE 00001626 "L<Digest negotiator plugin|Alien::Build::Plugin::Digest::Negotiate> is loaded."
NSQ_SOURCE_LINE 00001627 "(The Digest negotiator can be used directly, but is also loaded automatically"
NSQ_SOURCE_LINE 00001628 "if you use the L<digest directive|alienfile/digest> is used by the L<alienfile>)."
NSQ_SOURCE_LINE 00001629 ""
NSQ_SOURCE_LINE 00001630 "=item env"
NSQ_SOURCE_LINE 00001631 ""
NSQ_SOURCE_LINE 00001632 "Environment variables to override during the build stage."
NSQ_SOURCE_LINE 00001633 ""
NSQ_SOURCE_LINE 00001634 "=item env_interpolate"
NSQ_SOURCE_LINE 00001635 ""
NSQ_SOURCE_LINE 00001636 "Environment variable values will be interpolated with helpers.  Example:"
NSQ_SOURCE_LINE 00001637 ""
NSQ_SOURCE_LINE 00001638 " meta->prop->{env_interpolate} = 1;"
NSQ_SOURCE_LINE 00001639 " meta->prop->{env}->{PERL} = '%{perl}';"
NSQ_SOURCE_LINE 00001640 ""
NSQ_SOURCE_LINE 00001641 "=item local_source"
NSQ_SOURCE_LINE 00001642 ""
NSQ_SOURCE_LINE 00001643 "Set to true if source code package is available locally.  (that is not fetched"
NSQ_SOURCE_LINE 00001644 "over the internet).  This is computed by default based on the C<start_url>"
NSQ_SOURCE_LINE 00001645 "property.  Can be set by an L<alienfile> or plugin."
NSQ_SOURCE_LINE 00001646 ""
NSQ_SOURCE_LINE 00001647 "=item platform"
NSQ_SOURCE_LINE 00001648 ""
NSQ_SOURCE_LINE 00001649 "Hash reference.  Contains information about the platform beyond just C<$^O>."
NSQ_SOURCE_LINE 00001650 ""
NSQ_SOURCE_LINE 00001651 "=over 4"
NSQ_SOURCE_LINE 00001652 ""
NSQ_SOURCE_LINE 00001653 "=item platform.compiler_type"
NSQ_SOURCE_LINE 00001654 ""
NSQ_SOURCE_LINE 00001655 "Refers to the type of flags that the compiler accepts.  May be expanded in the"
NSQ_SOURCE_LINE 00001656 "future, but for now, will be one of:"
NSQ_SOURCE_LINE 00001657 ""
NSQ_SOURCE_LINE 00001658 "=over 4"
NSQ_SOURCE_LINE 00001659 ""
NSQ_SOURCE_LINE 00001660 "=item microsoft"
NSQ_SOURCE_LINE 00001661 ""
NSQ_SOURCE_LINE 00001662 "On Windows when using Microsoft Visual C++"
NSQ_SOURCE_LINE 00001663 ""
NSQ_SOURCE_LINE 00001664 "=item unix"
NSQ_SOURCE_LINE 00001665 ""
NSQ_SOURCE_LINE 00001666 "Virtually everything else, including gcc on windows."
NSQ_SOURCE_LINE 00001667 ""
NSQ_SOURCE_LINE 00001668 "=back"
NSQ_SOURCE_LINE 00001669 ""
NSQ_SOURCE_LINE 00001670 "The main difference is that with Visual C++ C<-LIBPATH> should be used instead"
NSQ_SOURCE_LINE 00001671 "of C<-L>, and static libraries should have the C<.LIB> suffix instead of C<.a>."
NSQ_SOURCE_LINE 00001672 ""
NSQ_SOURCE_LINE 00001673 "=item platform.system_type"
NSQ_SOURCE_LINE 00001674 ""
NSQ_SOURCE_LINE 00001675 "C<$^O> is frequently good enough to make platform specific logic in your"
NSQ_SOURCE_LINE 00001676 "L<alienfile>, this handles the case when $^O can cover platforms that provide"
NSQ_SOURCE_LINE 00001677 "multiple environments that Perl might run under.  The main example is windows,"
NSQ_SOURCE_LINE 00001678 "but others may be added in the future."
NSQ_SOURCE_LINE 00001679 ""
NSQ_SOURCE_LINE 00001680 "=over 4"
NSQ_SOURCE_LINE 00001681 ""
NSQ_SOURCE_LINE 00001682 "=item unix"
NSQ_SOURCE_LINE 00001683 ""
NSQ_SOURCE_LINE 00001684 "=item vms"
NSQ_SOURCE_LINE 00001685 ""
NSQ_SOURCE_LINE 00001686 "=item windows-activestate"
NSQ_SOURCE_LINE 00001687 ""
NSQ_SOURCE_LINE 00001688 "=item windows-microsoft"
NSQ_SOURCE_LINE 00001689 ""
NSQ_SOURCE_LINE 00001690 "=item windows-mingw"
NSQ_SOURCE_LINE 00001691 ""
NSQ_SOURCE_LINE 00001692 "=item windows-strawberry"
NSQ_SOURCE_LINE 00001693 ""
NSQ_SOURCE_LINE 00001694 "=item windows-unknown"
NSQ_SOURCE_LINE 00001695 ""
NSQ_SOURCE_LINE 00001696 "=back"
NSQ_SOURCE_LINE 00001697 ""
NSQ_SOURCE_LINE 00001698 "Note that C<cygwin> and C<msys> are considered C<unix> even though they run"
NSQ_SOURCE_LINE 00001699 "on windows!"
NSQ_SOURCE_LINE 00001700 ""
NSQ_SOURCE_LINE 00001701 "=item platform.cpu.count"
NSQ_SOURCE_LINE 00001702 ""
NSQ_SOURCE_LINE 00001703 "Contains a non-negative integer of available (possibly virtual) CPUs on the"
NSQ_SOURCE_LINE 00001704 "system. This can be used by build plugins to build in parallel. The environment"
NSQ_SOURCE_LINE 00001705 "variable C<ALIEN_CPU_COUNT> can be set to override the CPU count."
NSQ_SOURCE_LINE 00001706 ""
NSQ_SOURCE_LINE 00001707 "=item platform.cpu.arch.name"
NSQ_SOURCE_LINE 00001708 ""
NSQ_SOURCE_LINE 00001709 "Contains a normalized name for the architecture of the current Perl. This can"
NSQ_SOURCE_LINE 00001710 "be used by fetch plugins to determine which binary packages to download."
NSQ_SOURCE_LINE 00001711 "The value may be one of the following, but this list will be expanded as"
NSQ_SOURCE_LINE 00001712 "needed."
NSQ_SOURCE_LINE 00001713 ""
NSQ_SOURCE_LINE 00001714 "=over 4"
NSQ_SOURCE_LINE 00001715 ""
NSQ_SOURCE_LINE 00001716 "=item C<armel>"
NSQ_SOURCE_LINE 00001717 ""
NSQ_SOURCE_LINE 00001718 "32-bit ARM soft-float"
NSQ_SOURCE_LINE 00001719 ""
NSQ_SOURCE_LINE 00001720 "=item C<armhf>"
NSQ_SOURCE_LINE 00001721 ""
NSQ_SOURCE_LINE 00001722 "32-bit ARM hard-float"
NSQ_SOURCE_LINE 00001723 ""
NSQ_SOURCE_LINE 00001724 "=item C<aarch64>"
NSQ_SOURCE_LINE 00001725 ""
NSQ_SOURCE_LINE 00001726 "64-bit ARM"
NSQ_SOURCE_LINE 00001727 ""
NSQ_SOURCE_LINE 00001728 "=item C<ppc>"
NSQ_SOURCE_LINE 00001729 ""
NSQ_SOURCE_LINE 00001730 "32-bit PowerPC (big-endian)"
NSQ_SOURCE_LINE 00001731 ""
NSQ_SOURCE_LINE 00001732 "=item C<ppc64>"
NSQ_SOURCE_LINE 00001733 ""
NSQ_SOURCE_LINE 00001734 "64-bit PowerPC (big-endian)"
NSQ_SOURCE_LINE 00001735 ""
NSQ_SOURCE_LINE 00001736 "=item C<x86>"
NSQ_SOURCE_LINE 00001737 ""
NSQ_SOURCE_LINE 00001738 "32-bit Intel (i386, i486, i686)"
NSQ_SOURCE_LINE 00001739 ""
NSQ_SOURCE_LINE 00001740 "=item C<x86_64>"
NSQ_SOURCE_LINE 00001741 ""
NSQ_SOURCE_LINE 00001742 "64-bit Intel (AMD64)"
NSQ_SOURCE_LINE 00001743 ""
NSQ_SOURCE_LINE 00001744 "=item C<unknown>"
NSQ_SOURCE_LINE 00001745 ""
NSQ_SOURCE_LINE 00001746 "Unable to detect architecture. Please report this if needed."
NSQ_SOURCE_LINE 00001747 ""
NSQ_SOURCE_LINE 00001748 "=back"
NSQ_SOURCE_LINE 00001749 ""
NSQ_SOURCE_LINE 00001750 "=back"
NSQ_SOURCE_LINE 00001751 ""
NSQ_SOURCE_LINE 00001752 "=item out_of_source"
NSQ_SOURCE_LINE 00001753 ""
NSQ_SOURCE_LINE 00001754 "Build in a different directory from the where the source code is stored."
NSQ_SOURCE_LINE 00001755 "In autoconf this is referred to as a \"VPATH\" build.  Everyone else calls this"
NSQ_SOURCE_LINE 00001756 "an \"out-of-source\" build.  When this property is true, instead of extracting"
NSQ_SOURCE_LINE 00001757 "to the source build root, the downloaded source will be extracted to an source"
NSQ_SOURCE_LINE 00001758 "extraction directory and the source build root will be empty.  You can use the"
NSQ_SOURCE_LINE 00001759 "C<extract> install property to get the location of the extracted source."
NSQ_SOURCE_LINE 00001760 ""
NSQ_SOURCE_LINE 00001761 "=item network"
NSQ_SOURCE_LINE 00001762 ""
NSQ_SOURCE_LINE 00001763 "True if a network fetch is available.  This should NOT be set by an L<alienfile>"
NSQ_SOURCE_LINE 00001764 "or plugin.  This is computed based on the C<ALIEN_INSTALL_NETWORK> environment"
NSQ_SOURCE_LINE 00001765 "variables."
NSQ_SOURCE_LINE 00001766 ""
NSQ_SOURCE_LINE 00001767 "=item start_url"
NSQ_SOURCE_LINE 00001768 ""
NSQ_SOURCE_LINE 00001769 "The default or start URL used by fetch plugins."
NSQ_SOURCE_LINE 00001770 ""
NSQ_SOURCE_LINE 00001771 "=back"
NSQ_SOURCE_LINE 00001772 ""
NSQ_SOURCE_LINE 00001773 "=head2 install_prop"
NSQ_SOURCE_LINE 00001774 ""
NSQ_SOURCE_LINE 00001775 " my $href = $build->install_prop;"
NSQ_SOURCE_LINE 00001776 ""
NSQ_SOURCE_LINE 00001777 "Install properties are used during the install phase (either"
NSQ_SOURCE_LINE 00001778 "under C<share> or C<system> install).  They are remembered for"
NSQ_SOURCE_LINE 00001779 "the entire install phase, but not kept around during the runtime"
NSQ_SOURCE_LINE 00001780 "phase.  Thus they cannot be accessed from your L<Alien::Base>"
NSQ_SOURCE_LINE 00001781 "based module."
NSQ_SOURCE_LINE 00001782 ""
NSQ_SOURCE_LINE 00001783 "=over"
NSQ_SOURCE_LINE 00001784 ""
NSQ_SOURCE_LINE 00001785 "=item autoconf_prefix"
NSQ_SOURCE_LINE 00001786 ""
NSQ_SOURCE_LINE 00001787 "The prefix as understood by autoconf.  This is only different on Windows"
NSQ_SOURCE_LINE 00001788 "Where MSYS is used and paths like C<C:/foo> are  represented as C</C/foo>"
NSQ_SOURCE_LINE 00001789 "which are understood by the MSYS tools, but not by Perl.  You should"
NSQ_SOURCE_LINE 00001790 "only use this if you are using L<Alien::Build::Plugin::Build::Autoconf> in"
NSQ_SOURCE_LINE 00001791 "your L<alienfile>.  This is set during before the"
NSQ_SOURCE_LINE 00001792 "L<build hook|Alien::Build::Manual::PluginAuthor/\"build hook\"> is run."
NSQ_SOURCE_LINE 00001793 ""
NSQ_SOURCE_LINE 00001794 "=item download"
NSQ_SOURCE_LINE 00001795 ""
NSQ_SOURCE_LINE 00001796 "The location of the downloaded archive (tar.gz, or similar) or directory."
NSQ_SOURCE_LINE 00001797 "This will be undefined until the archive is actually downloaded."
NSQ_SOURCE_LINE 00001798 ""
NSQ_SOURCE_LINE 00001799 "=item download_detail"
NSQ_SOURCE_LINE 00001800 ""
NSQ_SOURCE_LINE 00001801 "This property contains optional details about a downloaded file.  This"
NSQ_SOURCE_LINE 00001802 "property is populated by L<Alien::Build> core.  This property is a"
NSQ_SOURCE_LINE 00001803 "hash reference.  The key is the path to the file that has been downloaded"
NSQ_SOURCE_LINE 00001804 "and the value is a hash reference with additional detail.  All fields"
NSQ_SOURCE_LINE 00001805 "are optional."
NSQ_SOURCE_LINE 00001806 ""
NSQ_SOURCE_LINE 00001807 "=over 4"
NSQ_SOURCE_LINE 00001808 ""
NSQ_SOURCE_LINE 00001809 "=item download_detail.digest"
NSQ_SOURCE_LINE 00001810 ""
NSQ_SOURCE_LINE 00001811 "This, if available, with the cryptographic signature that was successfully"
NSQ_SOURCE_LINE 00001812 "matched against the downloaded file.  It is an array reference with a"
NSQ_SOURCE_LINE 00001813 "pair of values, the algorithm (typically something like C<SHA256>) and"
NSQ_SOURCE_LINE 00001814 "the digest."
NSQ_SOURCE_LINE 00001815 ""
NSQ_SOURCE_LINE 00001816 "=item download_detail.protocol"
NSQ_SOURCE_LINE 00001817 ""
NSQ_SOURCE_LINE 00001818 "This, if available, will be the URL protocol used to fetch the downloaded"
NSQ_SOURCE_LINE 00001819 "file."
NSQ_SOURCE_LINE 00001820 ""
NSQ_SOURCE_LINE 00001821 "=back"
NSQ_SOURCE_LINE 00001822 ""
NSQ_SOURCE_LINE 00001823 "=item env"
NSQ_SOURCE_LINE 00001824 ""
NSQ_SOURCE_LINE 00001825 "Environment variables to override during the build stage.  Plugins are"
NSQ_SOURCE_LINE 00001826 "free to set additional overrides using this hash."
NSQ_SOURCE_LINE 00001827 ""
NSQ_SOURCE_LINE 00001828 "=item extract"
NSQ_SOURCE_LINE 00001829 ""
NSQ_SOURCE_LINE 00001830 "The location of the last source extraction.  For a \"out-of-source\" build"
NSQ_SOURCE_LINE 00001831 "(see the C<out_of_source> meta property above), this will only be set once."
NSQ_SOURCE_LINE 00001832 "For other types of builds, the source code may be extracted multiple times,"
NSQ_SOURCE_LINE 00001833 "and thus this property may change."
NSQ_SOURCE_LINE 00001834 ""
NSQ_SOURCE_LINE 00001835 "=item old"
NSQ_SOURCE_LINE 00001836 ""
NSQ_SOURCE_LINE 00001837 "[deprecated]"
NSQ_SOURCE_LINE 00001838 ""
NSQ_SOURCE_LINE 00001839 "Hash containing information on a previously installed Alien of the same"
NSQ_SOURCE_LINE 00001840 "name, if available.  This may be useful in cases where you want to"
NSQ_SOURCE_LINE 00001841 "reuse the previous install if it is still sufficient."
NSQ_SOURCE_LINE 00001842 ""
NSQ_SOURCE_LINE 00001843 "=over 4"
NSQ_SOURCE_LINE 00001844 ""
NSQ_SOURCE_LINE 00001845 "=item old.prefix"
NSQ_SOURCE_LINE 00001846 ""
NSQ_SOURCE_LINE 00001847 "[deprecated]"
NSQ_SOURCE_LINE 00001848 ""
NSQ_SOURCE_LINE 00001849 "The prefix for the previous install.  Versions prior to 1.42 unfortunately"
NSQ_SOURCE_LINE 00001850 "had this in typo form of C<preifx>."
NSQ_SOURCE_LINE 00001851 ""
NSQ_SOURCE_LINE 00001852 "=item old.runtime"
NSQ_SOURCE_LINE 00001853 ""
NSQ_SOURCE_LINE 00001854 "[deprecated]"
NSQ_SOURCE_LINE 00001855 ""
NSQ_SOURCE_LINE 00001856 "The runtime properties from the previous install."
NSQ_SOURCE_LINE 00001857 ""
NSQ_SOURCE_LINE 00001858 "=back"
NSQ_SOURCE_LINE 00001859 ""
NSQ_SOURCE_LINE 00001860 "=item patch"
NSQ_SOURCE_LINE 00001861 ""
NSQ_SOURCE_LINE 00001862 "Directory with patches, if available.  This will be C<undef> if there"
NSQ_SOURCE_LINE 00001863 "are no patches.  When initially installing an alien this will usually"
NSQ_SOURCE_LINE 00001864 "be a sibling of the C<alienfile>, a directory called C<patch>.  Once"
NSQ_SOURCE_LINE 00001865 "installed this will be in the share directory called C<_alien/patch>."
NSQ_SOURCE_LINE 00001866 "The former is useful for rebuilding an alienized package using"
NSQ_SOURCE_LINE 00001867 "L<af>."
NSQ_SOURCE_LINE 00001868 ""
NSQ_SOURCE_LINE 00001869 "=item prefix"
NSQ_SOURCE_LINE 00001870 ""
NSQ_SOURCE_LINE 00001871 "The install time prefix.  Under a C<destdir> install this is the"
NSQ_SOURCE_LINE 00001872 "same as the runtime or final install location.  Under a non-C<destdir>"
NSQ_SOURCE_LINE 00001873 "install this is the C<stage> directory (usually the appropriate"
NSQ_SOURCE_LINE 00001874 "share directory under C<blib>)."
NSQ_SOURCE_LINE 00001875 ""
NSQ_SOURCE_LINE 00001876 "=item root"
NSQ_SOURCE_LINE 00001877 ""
NSQ_SOURCE_LINE 00001878 "The build root directory.  This will be an absolute path.  It is the"
NSQ_SOURCE_LINE 00001879 "absolute form of C<./_alien> by default."
NSQ_SOURCE_LINE 00001880 ""
NSQ_SOURCE_LINE 00001881 "=item stage"
NSQ_SOURCE_LINE 00001882 ""
NSQ_SOURCE_LINE 00001883 "The stage directory where files will be copied.  This is usually the"
NSQ_SOURCE_LINE 00001884 "root of the blib share directory."
NSQ_SOURCE_LINE 00001885 ""
NSQ_SOURCE_LINE 00001886 "=item system_probe_class"
NSQ_SOURCE_LINE 00001887 ""
NSQ_SOURCE_LINE 00001888 "After the probe step this property may contain the plugin class that"
NSQ_SOURCE_LINE 00001889 "performed the system probe.  It shouldn't be filled in directly by"
NSQ_SOURCE_LINE 00001890 "the plugin (instead if should use the hook property C<probe_class>,"
NSQ_SOURCE_LINE 00001891 "see below).  This is optional, and not all probe plugins will provide"
NSQ_SOURCE_LINE 00001892 "this information."
NSQ_SOURCE_LINE 00001893 ""
NSQ_SOURCE_LINE 00001894 "=item system_probe_instance_id"
NSQ_SOURCE_LINE 00001895 ""
NSQ_SOURCE_LINE 00001896 "After the probe step this property may contain the plugin instance id that"
NSQ_SOURCE_LINE 00001897 "performed the system probe.  It shouldn't be filled in directly by"
NSQ_SOURCE_LINE 00001898 "the plugin (instead if should use the hook property C<probe_instance_id>,"
NSQ_SOURCE_LINE 00001899 "see below).  This is optional, and not all probe plugins will provide"
NSQ_SOURCE_LINE 00001900 "this information."
NSQ_SOURCE_LINE 00001901 ""
NSQ_SOURCE_LINE 00001902 "=back"
NSQ_SOURCE_LINE 00001903 ""
NSQ_SOURCE_LINE 00001904 "=head2 plugin_instance_prop"
NSQ_SOURCE_LINE 00001905 ""
NSQ_SOURCE_LINE 00001906 " my $href = $build->plugin_instance_prop($plugin);"
NSQ_SOURCE_LINE 00001907 ""
NSQ_SOURCE_LINE 00001908 "This returns the private plugin instance properties for a given plugin."
NSQ_SOURCE_LINE 00001909 "This method should usually only be called internally by plugins themselves"
NSQ_SOURCE_LINE 00001910 "to keep track of internal state.  Because the content can be used arbitrarily"
NSQ_SOURCE_LINE 00001911 "by the owning plugin because it is private to the plugin, and thus is not"
NSQ_SOURCE_LINE 00001912 "part of the L<Alien::Build> spec."
NSQ_SOURCE_LINE 00001913 ""
NSQ_SOURCE_LINE 00001914 "=head2 runtime_prop"
NSQ_SOURCE_LINE 00001915 ""
NSQ_SOURCE_LINE 00001916 " my $href = $build->runtime_prop;"
NSQ_SOURCE_LINE 00001917 ""
NSQ_SOURCE_LINE 00001918 "Runtime properties are used during the install and runtime phases"
NSQ_SOURCE_LINE 00001919 "(either under C<share> or C<system> install).  This should include"
NSQ_SOURCE_LINE 00001920 "anything that you will need to know to use the library or tool"
NSQ_SOURCE_LINE 00001921 "during runtime, and shouldn't include anything that is no longer"
NSQ_SOURCE_LINE 00001922 "relevant once the install process is complete."
NSQ_SOURCE_LINE 00001923 ""
NSQ_SOURCE_LINE 00001924 "=over 4"
NSQ_SOURCE_LINE 00001925 ""
NSQ_SOURCE_LINE 00001926 "=item alien_build_version"
NSQ_SOURCE_LINE 00001927 ""
NSQ_SOURCE_LINE 00001928 "The version of L<Alien::Build> used to install the library or tool."
NSQ_SOURCE_LINE 00001929 ""
NSQ_SOURCE_LINE 00001930 "=item alt"
NSQ_SOURCE_LINE 00001931 ""
NSQ_SOURCE_LINE 00001932 "Alternate configurations.  If the alienized package has multiple"
NSQ_SOURCE_LINE 00001933 "libraries this could be used to store the different compiler or"
NSQ_SOURCE_LINE 00001934 "linker flags for each library.  Typically this will be set by a"
NSQ_SOURCE_LINE 00001935 "plugin in the gather stage (for either share or system installs)."
NSQ_SOURCE_LINE 00001936 ""
NSQ_SOURCE_LINE 00001937 "=item cflags"
NSQ_SOURCE_LINE 00001938 ""
NSQ_SOURCE_LINE 00001939 "The compiler flags.  This is typically set by a plugin in the"
NSQ_SOURCE_LINE 00001940 "gather stage (for either share or system installs)."
NSQ_SOURCE_LINE 00001941 ""
NSQ_SOURCE_LINE 00001942 "=item cflags_static"
NSQ_SOURCE_LINE 00001943 ""
NSQ_SOURCE_LINE 00001944 "The static compiler flags.  This is typically set by a plugin in the"
NSQ_SOURCE_LINE 00001945 "gather stage (for either share or system installs)."
NSQ_SOURCE_LINE 00001946 ""
NSQ_SOURCE_LINE 00001947 "=item command"
NSQ_SOURCE_LINE 00001948 ""
NSQ_SOURCE_LINE 00001949 "The command name for tools where the name my differ from platform to"
NSQ_SOURCE_LINE 00001950 "platform.  For example, the GNU version of make is usually C<make> in"
NSQ_SOURCE_LINE 00001951 "Linux and C<gmake> on FreeBSD.  This is typically set by a plugin in the"
NSQ_SOURCE_LINE 00001952 "gather stage (for either share or system installs)."
NSQ_SOURCE_LINE 00001953 ""
NSQ_SOURCE_LINE 00001954 "=item ffi_name"
NSQ_SOURCE_LINE 00001955 ""
NSQ_SOURCE_LINE 00001956 "The name DLL or shared object \"name\" to use when searching for dynamic"
NSQ_SOURCE_LINE 00001957 "libraries at runtime.  This is passed into L<FFI::CheckLib>, so if"
NSQ_SOURCE_LINE 00001958 "your library is something like C<libarchive.so> or C<archive.dll> you"
NSQ_SOURCE_LINE 00001959 "would set this to C<archive>.  This may be a string or an array of"
NSQ_SOURCE_LINE 00001960 "strings.  This is typically set by a plugin in the gather stage"
NSQ_SOURCE_LINE 00001961 "(for either share or system installs)."
NSQ_SOURCE_LINE 00001962 ""
NSQ_SOURCE_LINE 00001963 "=item ffi_checklib"
NSQ_SOURCE_LINE 00001964 ""
NSQ_SOURCE_LINE 00001965 "This property contains two sub properties:"
NSQ_SOURCE_LINE 00001966 ""
NSQ_SOURCE_LINE 00001967 "=over 4"
NSQ_SOURCE_LINE 00001968 ""
NSQ_SOURCE_LINE 00001969 "=item ffi_checklib.share"
NSQ_SOURCE_LINE 00001970 ""
NSQ_SOURCE_LINE 00001971 " $build->runtime_prop->{ffi_checklib}->{share} = [ ... ];"
NSQ_SOURCE_LINE 00001972 ""
NSQ_SOURCE_LINE 00001973 "Array of additional L<FFI::CheckLib> flags to pass in to C<find_lib>"
NSQ_SOURCE_LINE 00001974 "for a C<share> install."
NSQ_SOURCE_LINE 00001975 ""
NSQ_SOURCE_LINE 00001976 "=item ffi_checklib.system"
NSQ_SOURCE_LINE 00001977 ""
NSQ_SOURCE_LINE 00001978 "Array of additional L<FFI::CheckLib> flags to pass in to C<find_lib>"
NSQ_SOURCE_LINE 00001979 "for a C<system> install."
NSQ_SOURCE_LINE 00001980 ""
NSQ_SOURCE_LINE 00001981 "Among other things, useful for specifying the C<try_linker_script>"
NSQ_SOURCE_LINE 00001982 "flag:"
NSQ_SOURCE_LINE 00001983 ""
NSQ_SOURCE_LINE 00001984 " $build->runtime_prop->{ffi_checklib}->{system} = [ try_linker_script => 1 ];"
NSQ_SOURCE_LINE 00001985 ""
NSQ_SOURCE_LINE 00001986 "=back"
NSQ_SOURCE_LINE 00001987 ""
NSQ_SOURCE_LINE 00001988 "This is typically set by a plugin in the gather stage"
NSQ_SOURCE_LINE 00001989 "(for either share or system installs)."
NSQ_SOURCE_LINE 00001990 ""
NSQ_SOURCE_LINE 00001991 "=item inline_auto_include"
NSQ_SOURCE_LINE 00001992 ""
NSQ_SOURCE_LINE 00001993 "[version 2.53]"
NSQ_SOURCE_LINE 00001994 ""
NSQ_SOURCE_LINE 00001995 "This property is an array reference of C code that will be passed into"
NSQ_SOURCE_LINE 00001996 "L<Inline::C> to make sure that appropriate headers are automatically"
NSQ_SOURCE_LINE 00001997 "included.  See L<Inline::C/auto_include> for details."
NSQ_SOURCE_LINE 00001998 ""
NSQ_SOURCE_LINE 00001999 "=item install_type"
NSQ_SOURCE_LINE 00002000 ""
NSQ_SOURCE_LINE 00002001 "The install type.  This is set by AB core after the"
NSQ_SOURCE_LINE 00002002 "L<probe hook|Alien::Build::Manual::PluginAuthor/\"probe hook\"> is"
NSQ_SOURCE_LINE 00002003 "executed.  Is one of:"
NSQ_SOURCE_LINE 00002004 ""
NSQ_SOURCE_LINE 00002005 "=over 4"
NSQ_SOURCE_LINE 00002006 ""
NSQ_SOURCE_LINE 00002007 "=item system"
NSQ_SOURCE_LINE 00002008 ""
NSQ_SOURCE_LINE 00002009 "For when the library or tool is provided by the operating system, can be"
NSQ_SOURCE_LINE 00002010 "detected by L<Alien::Build>, and is considered satisfactory by the"
NSQ_SOURCE_LINE 00002011 "C<alienfile> recipe."
NSQ_SOURCE_LINE 00002012 ""
NSQ_SOURCE_LINE 00002013 "=item share"
NSQ_SOURCE_LINE 00002014 ""
NSQ_SOURCE_LINE 00002015 "For when a system install is not possible, the library source will be"
NSQ_SOURCE_LINE 00002016 "downloaded from the internet or retrieved in another appropriate fashion"
NSQ_SOURCE_LINE 00002017 "and built."
NSQ_SOURCE_LINE 00002018 ""
NSQ_SOURCE_LINE 00002019 "=back"
NSQ_SOURCE_LINE 00002020 ""
NSQ_SOURCE_LINE 00002021 "=item libs"
NSQ_SOURCE_LINE 00002022 ""
NSQ_SOURCE_LINE 00002023 "The library flags.  This is typically set by a plugin in the"
NSQ_SOURCE_LINE 00002024 "gather stage (for either share or system installs)."
NSQ_SOURCE_LINE 00002025 ""
NSQ_SOURCE_LINE 00002026 "=item libs_static"
NSQ_SOURCE_LINE 00002027 ""
NSQ_SOURCE_LINE 00002028 "The static library flags.  This is typically set by a plugin in the"
NSQ_SOURCE_LINE 00002029 "gather stage (for either share or system installs)."
NSQ_SOURCE_LINE 00002030 ""
NSQ_SOURCE_LINE 00002031 "=item perl_module_version"
NSQ_SOURCE_LINE 00002032 ""
NSQ_SOURCE_LINE 00002033 "The version of the Perl module used to install the alien (if available)."
NSQ_SOURCE_LINE 00002034 "For example if L<Alien::curl> is installing C<libcurl> this would be the"
NSQ_SOURCE_LINE 00002035 "version of L<Alien::curl> used during the install step."
NSQ_SOURCE_LINE 00002036 ""
NSQ_SOURCE_LINE 00002037 "=item prefix"
NSQ_SOURCE_LINE 00002038 ""
NSQ_SOURCE_LINE 00002039 "The final install root.  This is usually they share directory."
NSQ_SOURCE_LINE 00002040 ""
NSQ_SOURCE_LINE 00002041 "=item version"
NSQ_SOURCE_LINE 00002042 ""
NSQ_SOURCE_LINE 00002043 "The version of the library or tool.  This is typically set by a plugin in the"
NSQ_SOURCE_LINE 00002044 "gather stage (for either share or system installs)."
NSQ_SOURCE_LINE 00002045 ""
NSQ_SOURCE_LINE 00002046 "=back"
NSQ_SOURCE_LINE 00002047 ""
NSQ_SOURCE_LINE 00002048 "=head2 hook_prop"
NSQ_SOURCE_LINE 00002049 ""
NSQ_SOURCE_LINE 00002050 " my $href = $build->hook_prop;"
NSQ_SOURCE_LINE 00002051 ""
NSQ_SOURCE_LINE 00002052 "Hook properties are for the currently running (if any) hook.  They are"
NSQ_SOURCE_LINE 00002053 "used only during the execution of each hook and are discarded after."
NSQ_SOURCE_LINE 00002054 "If no hook is currently running then C<hook_prop> will return C<undef>."
NSQ_SOURCE_LINE 00002055 ""
NSQ_SOURCE_LINE 00002056 "=over 4"
NSQ_SOURCE_LINE 00002057 ""
NSQ_SOURCE_LINE 00002058 "=item name"
NSQ_SOURCE_LINE 00002059 ""
NSQ_SOURCE_LINE 00002060 "The name of the currently running hook."
NSQ_SOURCE_LINE 00002061 ""
NSQ_SOURCE_LINE 00002062 "=item version (probe)"
NSQ_SOURCE_LINE 00002063 ""
NSQ_SOURCE_LINE 00002064 "Probe and PkgConfig plugins I<may> set this property indicating the"
NSQ_SOURCE_LINE 00002065 "version of the alienized package.  Not all plugins and configurations"
NSQ_SOURCE_LINE 00002066 "may be able to provide this."
NSQ_SOURCE_LINE 00002067 ""
NSQ_SOURCE_LINE 00002068 "=item probe_class (probe)"
NSQ_SOURCE_LINE 00002069 ""
NSQ_SOURCE_LINE 00002070 "Probe and PkgConfig plugins I<may> set this property indicating the"
NSQ_SOURCE_LINE 00002071 "plugin class that made the probe.  If the probe results in a system"
NSQ_SOURCE_LINE 00002072 "install this will be propagated to C<system_probe_class> for later"
NSQ_SOURCE_LINE 00002073 "use."
NSQ_SOURCE_LINE 00002074 ""
NSQ_SOURCE_LINE 00002075 "=item probe_instance_id (probe)"
NSQ_SOURCE_LINE 00002076 ""
NSQ_SOURCE_LINE 00002077 "Probe and PkgConfig plugins I<may> set this property indicating the"
NSQ_SOURCE_LINE 00002078 "plugin instance id that made the probe.  If the probe results in a"
NSQ_SOURCE_LINE 00002079 "system install this will be propagated to C<system_probe_instance_id>"
NSQ_SOURCE_LINE 00002080 "for later use."
NSQ_SOURCE_LINE 00002081 ""
NSQ_SOURCE_LINE 00002082 "=back"
NSQ_SOURCE_LINE 00002083 ""
NSQ_SOURCE_LINE 00002084 "=head1 METHODS"
NSQ_SOURCE_LINE 00002085 ""
NSQ_SOURCE_LINE 00002086 "=head2 checkpoint"
NSQ_SOURCE_LINE 00002087 ""
NSQ_SOURCE_LINE 00002088 " $build->checkpoint;"
NSQ_SOURCE_LINE 00002089 ""
NSQ_SOURCE_LINE 00002090 "Save any install or runtime properties so that they can be reloaded on"
NSQ_SOURCE_LINE 00002091 "a subsequent run in a separate process.  This is useful if your build"
NSQ_SOURCE_LINE 00002092 "needs to be done in multiple stages from a C<Makefile>, such as with"
NSQ_SOURCE_LINE 00002093 "L<ExtUtils::MakeMaker>.  Once checkpointed you can use the C<resume>"
NSQ_SOURCE_LINE 00002094 "constructor (documented above) to resume the probe/build/install]"
NSQ_SOURCE_LINE 00002095 "process."
NSQ_SOURCE_LINE 00002096 ""
NSQ_SOURCE_LINE 00002097 "=head2 root"
NSQ_SOURCE_LINE 00002098 ""
NSQ_SOURCE_LINE 00002099 " my $dir = $build->root;"
NSQ_SOURCE_LINE 00002100 ""
NSQ_SOURCE_LINE 00002101 "This is just a shortcut for:"
NSQ_SOURCE_LINE 00002102 ""
NSQ_SOURCE_LINE 00002103 " my $root = $build->install_prop->{root};"
NSQ_SOURCE_LINE 00002104 ""
NSQ_SOURCE_LINE 00002105 "Except that it will be created if it does not already exist."
NSQ_SOURCE_LINE 00002106 ""
NSQ_SOURCE_LINE 00002107 "=head2 install_type"
NSQ_SOURCE_LINE 00002108 ""
NSQ_SOURCE_LINE 00002109 " my $type = $build->install_type;"
NSQ_SOURCE_LINE 00002110 ""
NSQ_SOURCE_LINE 00002111 "This will return the install type.  (See the like named install property"
NSQ_SOURCE_LINE 00002112 "above for details).  This method will call C<probe> if it has not already"
NSQ_SOURCE_LINE 00002113 "been called."
NSQ_SOURCE_LINE 00002114 ""
NSQ_SOURCE_LINE 00002115 "=head2 is_system_install"
NSQ_SOURCE_LINE 00002116 ""
NSQ_SOURCE_LINE 00002117 " my $boolean = $build->is_system_install;"
NSQ_SOURCE_LINE 00002118 ""
NSQ_SOURCE_LINE 00002119 "Returns true if the alien is a system install type.  "
NSQ_SOURCE_LINE 00002120 ""
NSQ_SOURCE_LINE 00002121 "=head2 is_share_install"
NSQ_SOURCE_LINE 00002122 ""
NSQ_SOURCE_LINE 00002123 " my $boolean = $build->is_share_install;"
NSQ_SOURCE_LINE 00002124 ""
NSQ_SOURCE_LINE 00002125 "Returns true if the alien is a share install type."
NSQ_SOURCE_LINE 00002126 ""
NSQ_SOURCE_LINE 00002127 "=head2 download_rule"
NSQ_SOURCE_LINE 00002128 ""
NSQ_SOURCE_LINE 00002129 " my $rule = $build->download_rule;"
NSQ_SOURCE_LINE 00002130 ""
NSQ_SOURCE_LINE 00002131 "This returns install rule as a string.  This is determined by the environment"
NSQ_SOURCE_LINE 00002132 "and should be one of:"
NSQ_SOURCE_LINE 00002133 ""
NSQ_SOURCE_LINE 00002134 "=over 4"
NSQ_SOURCE_LINE 00002135 ""
NSQ_SOURCE_LINE 00002136 "=item C<warn>"
NSQ_SOURCE_LINE 00002137 ""
NSQ_SOURCE_LINE 00002138 "Warn only if fetching via non secure source (secure sources include C<https>,"
NSQ_SOURCE_LINE 00002139 "and bundled files, may include other encrypted protocols in the future)."
NSQ_SOURCE_LINE 00002140 ""
NSQ_SOURCE_LINE 00002141 "=item C<digest>"
NSQ_SOURCE_LINE 00002142 ""
NSQ_SOURCE_LINE 00002143 "Require that any downloaded source package have a cryptographic signature in"
NSQ_SOURCE_LINE 00002144 "the L<alienfile> and that signature matches what was downloaded."
NSQ_SOURCE_LINE 00002145 ""
NSQ_SOURCE_LINE 00002146 "=item C<encrypt>"
NSQ_SOURCE_LINE 00002147 ""
NSQ_SOURCE_LINE 00002148 "Require that any downloaded source package is fetched via secure source."
NSQ_SOURCE_LINE 00002149 ""
NSQ_SOURCE_LINE 00002150 "=item C<digest_or_encrypt>"
NSQ_SOURCE_LINE 00002151 ""
NSQ_SOURCE_LINE 00002152 "Require that any downloaded source package is B<either> fetched via a secure source"
NSQ_SOURCE_LINE 00002153 "B<or> has a cryptographic signature in the L<alienfile> and that signature matches"
NSQ_SOURCE_LINE 00002154 "what was downloaded."
NSQ_SOURCE_LINE 00002155 ""
NSQ_SOURCE_LINE 00002156 "=item C<digest_and_encrypt>"
NSQ_SOURCE_LINE 00002157 ""
NSQ_SOURCE_LINE 00002158 "Require that any downloaded source package is B<both> fetched via a secure source"
NSQ_SOURCE_LINE 00002159 "B<and> has a cryptographic signature in the L<alienfile> and that signature matches"
NSQ_SOURCE_LINE 00002160 "what was downloaded."
NSQ_SOURCE_LINE 00002161 ""
NSQ_SOURCE_LINE 00002162 "=back"
NSQ_SOURCE_LINE 00002163 ""
NSQ_SOURCE_LINE 00002164 "The current default is C<warn>, but in the near future this will be upgraded to"
NSQ_SOURCE_LINE 00002165 "C<digest_or_encrypt>."
NSQ_SOURCE_LINE 00002166 ""
NSQ_SOURCE_LINE 00002167 "=head2 set_prefix"
NSQ_SOURCE_LINE 00002168 ""
NSQ_SOURCE_LINE 00002169 " $build->set_prefix($prefix);"
NSQ_SOURCE_LINE 00002170 ""
NSQ_SOURCE_LINE 00002171 "Set the final (unstaged) prefix.  This is normally only called by L<Alien::Build::MM>"
NSQ_SOURCE_LINE 00002172 "and similar modules.  It is not intended for use from plugins or from an L<alienfile>."
NSQ_SOURCE_LINE 00002173 ""
NSQ_SOURCE_LINE 00002174 "=head2 set_stage"
NSQ_SOURCE_LINE 00002175 ""
NSQ_SOURCE_LINE 00002176 " $build->set_stage($dir);"
NSQ_SOURCE_LINE 00002177 ""
NSQ_SOURCE_LINE 00002178 "Sets the stage directory.  This is normally only called by L<Alien::Build::MM>"
NSQ_SOURCE_LINE 00002179 "and similar modules.  It is not intended for use from plugins or from an L<alienfile>."
NSQ_SOURCE_LINE 00002180 ""
NSQ_SOURCE_LINE 00002181 "=head2 requires"
NSQ_SOURCE_LINE 00002182 ""
NSQ_SOURCE_LINE 00002183 " my $hash = $build->requires($phase);"
NSQ_SOURCE_LINE 00002184 ""
NSQ_SOURCE_LINE 00002185 "Returns a hash reference of the modules required for the given phase.  Phases"
NSQ_SOURCE_LINE 00002186 "include:"
NSQ_SOURCE_LINE 00002187 ""
NSQ_SOURCE_LINE 00002188 "=over 4"
NSQ_SOURCE_LINE 00002189 ""
NSQ_SOURCE_LINE 00002190 "=item configure"
NSQ_SOURCE_LINE 00002191 ""
NSQ_SOURCE_LINE 00002192 "These modules must already be available when the L<alienfile> is read."
NSQ_SOURCE_LINE 00002193 ""
NSQ_SOURCE_LINE 00002194 "=item any"
NSQ_SOURCE_LINE 00002195 ""
NSQ_SOURCE_LINE 00002196 "These modules are used during either a C<system> or C<share> install."
NSQ_SOURCE_LINE 00002197 ""
NSQ_SOURCE_LINE 00002198 "=item share"
NSQ_SOURCE_LINE 00002199 ""
NSQ_SOURCE_LINE 00002200 "These modules are used during the build phase of a C<share> install."
NSQ_SOURCE_LINE 00002201 ""
NSQ_SOURCE_LINE 00002202 "=item system"
NSQ_SOURCE_LINE 00002203 ""
NSQ_SOURCE_LINE 00002204 "These modules are used during the build phase of a C<system> install."
NSQ_SOURCE_LINE 00002205 ""
NSQ_SOURCE_LINE 00002206 "=back"
NSQ_SOURCE_LINE 00002207 ""
NSQ_SOURCE_LINE 00002208 "=head2 load_requires"
NSQ_SOURCE_LINE 00002209 ""
NSQ_SOURCE_LINE 00002210 " $build->load_requires($phase);"
NSQ_SOURCE_LINE 00002211 ""
NSQ_SOURCE_LINE 00002212 "This loads the appropriate modules for the given phase (see C<requires> above"
NSQ_SOURCE_LINE 00002213 "for a description of the phases)."
NSQ_SOURCE_LINE 00002214 ""
NSQ_SOURCE_LINE 00002215 "=head2 probe"
NSQ_SOURCE_LINE 00002216 ""
NSQ_SOURCE_LINE 00002217 " my $install_type = $build->probe;"
NSQ_SOURCE_LINE 00002218 ""
NSQ_SOURCE_LINE 00002219 "Attempts to determine if the operating system has the library or"
NSQ_SOURCE_LINE 00002220 "tool already installed.  If so, then the string C<system> will"
NSQ_SOURCE_LINE 00002221 "be returned and a system install will be performed.  If not,"
NSQ_SOURCE_LINE 00002222 "then the string C<share> will be installed and the tool or"
NSQ_SOURCE_LINE 00002223 "library will be downloaded and built from source."
NSQ_SOURCE_LINE 00002224 ""
NSQ_SOURCE_LINE 00002225 "If the environment variable C<ALIEN_INSTALL_TYPE> is set, then that"
NSQ_SOURCE_LINE 00002226 "will force a specific type of install.  If the detection logic"
NSQ_SOURCE_LINE 00002227 "cannot accommodate the install type requested then it will fail with"
NSQ_SOURCE_LINE 00002228 "an exception."
NSQ_SOURCE_LINE 00002229 ""
NSQ_SOURCE_LINE 00002230 "=head2 download"
NSQ_SOURCE_LINE 00002231 ""
NSQ_SOURCE_LINE 00002232 " $build->download;"
NSQ_SOURCE_LINE 00002233 ""
NSQ_SOURCE_LINE 00002234 "Download the source, usually as a tarball, usually from the internet."
NSQ_SOURCE_LINE 00002235 ""
NSQ_SOURCE_LINE 00002236 "Under a C<system> install this does not do anything."
NSQ_SOURCE_LINE 00002237 ""
NSQ_SOURCE_LINE 00002238 "=head2 fetch"
NSQ_SOURCE_LINE 00002239 ""
NSQ_SOURCE_LINE 00002240 " my $res = $build->fetch;"
NSQ_SOURCE_LINE 00002241 " my $res = $build->fetch($url, %options);"
NSQ_SOURCE_LINE 00002242 ""
NSQ_SOURCE_LINE 00002243 "Fetch a resource using the fetch hook.  Returns the same hash structure"
NSQ_SOURCE_LINE 00002244 "described below in the"
NSQ_SOURCE_LINE 00002245 "L<fetch hook|Alien::Build::Manual::PluginAuthor/\"fetch hook\"> documentation."
NSQ_SOURCE_LINE 00002246 ""
NSQ_SOURCE_LINE 00002247 "[version 2.39]"
NSQ_SOURCE_LINE 00002248 ""
NSQ_SOURCE_LINE 00002249 "As of L<Alien::Build> 2.39, these options are supported:"
NSQ_SOURCE_LINE 00002250 ""
NSQ_SOURCE_LINE 00002251 "=over 4"
NSQ_SOURCE_LINE 00002252 ""
NSQ_SOURCE_LINE 00002253 "=item http_headers"
NSQ_SOURCE_LINE 00002254 ""
NSQ_SOURCE_LINE 00002255 " my $res = $build->fetch($url, http_headers => [ $key1 => $value1, $key2 => $value 2, ... ]);"
NSQ_SOURCE_LINE 00002256 ""
NSQ_SOURCE_LINE 00002257 "Set the HTTP request headers on all outgoing HTTP requests.  Note that not all"
NSQ_SOURCE_LINE 00002258 "protocols or fetch plugins support setting request headers, but the ones that"
NSQ_SOURCE_LINE 00002259 "do not I<should> issue a warning if you try to set request headers and they"
NSQ_SOURCE_LINE 00002260 "are not supported."
NSQ_SOURCE_LINE 00002261 ""
NSQ_SOURCE_LINE 00002262 "=back"
NSQ_SOURCE_LINE 00002263 ""
NSQ_SOURCE_LINE 00002264 "=head2 check_digest"
NSQ_SOURCE_LINE 00002265 ""
NSQ_SOURCE_LINE 00002266 "[experimental]"
NSQ_SOURCE_LINE 00002267 ""
NSQ_SOURCE_LINE 00002268 " my $bool = $build->check_digest($path);"
NSQ_SOURCE_LINE 00002269 ""
NSQ_SOURCE_LINE 00002270 "Checks any cryptographic signatures for the given file.  The"
NSQ_SOURCE_LINE 00002271 "file is specified by C<$path> which may be one of:"
NSQ_SOURCE_LINE 00002272 ""
NSQ_SOURCE_LINE 00002273 "=over 4"
NSQ_SOURCE_LINE 00002274 ""
NSQ_SOURCE_LINE 00002275 "=item string"
NSQ_SOURCE_LINE 00002276 ""
NSQ_SOURCE_LINE 00002277 "Containing the path to the file to be checked."
NSQ_SOURCE_LINE 00002278 ""
NSQ_SOURCE_LINE 00002279 "=item L<Path::Tiny>"
NSQ_SOURCE_LINE 00002280 ""
NSQ_SOURCE_LINE 00002281 "Containing the path to the file to be checked."
NSQ_SOURCE_LINE 00002282 ""
NSQ_SOURCE_LINE 00002283 "=item C<HASH>"
NSQ_SOURCE_LINE 00002284 ""
NSQ_SOURCE_LINE 00002285 "A Hash reference containing information about a file.  See"
NSQ_SOURCE_LINE 00002286 "the L<fetch hook|Alien::Build::Manual::PluginAuthor/\"fetch hook\"> for details"
NSQ_SOURCE_LINE 00002287 "on the format."
NSQ_SOURCE_LINE 00002288 ""
NSQ_SOURCE_LINE 00002289 "=back"
NSQ_SOURCE_LINE 00002290 ""
NSQ_SOURCE_LINE 00002291 "Returns true if the cryptographic signature matches, false if cryptographic"
NSQ_SOURCE_LINE 00002292 "signatures are disabled.  Will throw an exception if the signature does not"
NSQ_SOURCE_LINE 00002293 "match, or if no plugin provides the correct algorithm for checking the"
NSQ_SOURCE_LINE 00002294 "signature."
NSQ_SOURCE_LINE 00002295 ""
NSQ_SOURCE_LINE 00002296 "=head2 decode"
NSQ_SOURCE_LINE 00002297 ""
NSQ_SOURCE_LINE 00002298 " my $decoded_res = $build->decode($res);"
NSQ_SOURCE_LINE 00002299 ""
NSQ_SOURCE_LINE 00002300 "Decode the HTML or file listing returned by C<fetch>.  Returns the same"
NSQ_SOURCE_LINE 00002301 "hash structure described below in the"
NSQ_SOURCE_LINE 00002302 "L<decode hook|Alien::Build::Manual::PluginAuthor/\"decode hook\"> documentation."
NSQ_SOURCE_LINE 00002303 ""
NSQ_SOURCE_LINE 00002304 "=head2 prefer"
NSQ_SOURCE_LINE 00002305 ""
NSQ_SOURCE_LINE 00002306 " my $sorted_res = $build->prefer($res);"
NSQ_SOURCE_LINE 00002307 ""
NSQ_SOURCE_LINE 00002308 "Filter and sort candidates.  The preferred candidate will be returned first in the list."
NSQ_SOURCE_LINE 00002309 "The worst candidate will be returned last.  Returns the same hash structure described"
NSQ_SOURCE_LINE 00002310 "below in the"
NSQ_SOURCE_LINE 00002311 "L<prefer hook|Alien::Build::Manual::PluginAuthor/\"prefer hook\"> documentation."
NSQ_SOURCE_LINE 00002312 ""
NSQ_SOURCE_LINE 00002313 "=head2 extract"
NSQ_SOURCE_LINE 00002314 ""
NSQ_SOURCE_LINE 00002315 " my $dir = $build->extract;"
NSQ_SOURCE_LINE 00002316 " my $dir = $build->extract($archive);"
NSQ_SOURCE_LINE 00002317 ""
NSQ_SOURCE_LINE 00002318 "Extracts the given archive into a fresh directory.  This is normally called internally"
NSQ_SOURCE_LINE 00002319 "to L<Alien::Build>, and for normal usage is not needed from a plugin or L<alienfile>."
NSQ_SOURCE_LINE 00002320 ""
NSQ_SOURCE_LINE 00002321 "=head2 build"
NSQ_SOURCE_LINE 00002322 ""
NSQ_SOURCE_LINE 00002323 " $build->build;"
NSQ_SOURCE_LINE 00002324 ""
NSQ_SOURCE_LINE 00002325 "Run the build step.  It is expected that C<probe> and C<download>"
NSQ_SOURCE_LINE 00002326 "have already been performed.  What it actually does depends on the"
NSQ_SOURCE_LINE 00002327 "type of install:"
NSQ_SOURCE_LINE 00002328 ""
NSQ_SOURCE_LINE 00002329 "=over 4"
NSQ_SOURCE_LINE 00002330 ""
NSQ_SOURCE_LINE 00002331 "=item share"
NSQ_SOURCE_LINE 00002332 ""
NSQ_SOURCE_LINE 00002333 "The source is extracted, and built as determined by the L<alienfile>"
NSQ_SOURCE_LINE 00002334 "recipe.  If there is a C<gather_share> that will be executed last."
NSQ_SOURCE_LINE 00002335 ""
NSQ_SOURCE_LINE 00002336 "=item system"
NSQ_SOURCE_LINE 00002337 ""
NSQ_SOURCE_LINE 00002338 "The"
NSQ_SOURCE_LINE 00002339 "L<gather_system hook|Alien::Build::Manual::PluginAuthor/\"gather_system hook\">"
NSQ_SOURCE_LINE 00002340 "will be executed."
NSQ_SOURCE_LINE 00002341 ""
NSQ_SOURCE_LINE 00002342 "=back"
NSQ_SOURCE_LINE 00002343 ""
NSQ_SOURCE_LINE 00002344 "=head2 test"
NSQ_SOURCE_LINE 00002345 ""
NSQ_SOURCE_LINE 00002346 " $build->test;"
NSQ_SOURCE_LINE 00002347 ""
NSQ_SOURCE_LINE 00002348 "Run the test phase"
NSQ_SOURCE_LINE 00002349 ""
NSQ_SOURCE_LINE 00002350 "=head2 clean_install"
NSQ_SOURCE_LINE 00002351 ""
NSQ_SOURCE_LINE 00002352 " $build->clean_install"
NSQ_SOURCE_LINE 00002353 ""
NSQ_SOURCE_LINE 00002354 "Clean files from the final install location.  The default implementation removes all"
NSQ_SOURCE_LINE 00002355 "files recursively except for the C<_alien> directory.  This is helpful when you have"
NSQ_SOURCE_LINE 00002356 "an old install with files that may break the new build."
NSQ_SOURCE_LINE 00002357 ""
NSQ_SOURCE_LINE 00002358 "For a non-share install this doesn't do anything."
NSQ_SOURCE_LINE 00002359 ""
NSQ_SOURCE_LINE 00002360 "=head2 system"
NSQ_SOURCE_LINE 00002361 ""
NSQ_SOURCE_LINE 00002362 " $build->system($command);"
NSQ_SOURCE_LINE 00002363 " $build->system($command, @args);"
NSQ_SOURCE_LINE 00002364 ""
NSQ_SOURCE_LINE 00002365 "Interpolates the command and arguments and run the results using"
NSQ_SOURCE_LINE 00002366 "the Perl C<system> command."
NSQ_SOURCE_LINE 00002367 ""
NSQ_SOURCE_LINE 00002368 "=head2 log"
NSQ_SOURCE_LINE 00002369 ""
NSQ_SOURCE_LINE 00002370 " $build->log($message);"
NSQ_SOURCE_LINE 00002371 ""
NSQ_SOURCE_LINE 00002372 "Send a message to the log.  By default this prints to C<STDOUT>."
NSQ_SOURCE_LINE 00002373 ""
NSQ_SOURCE_LINE 00002374 "=head2 meta"
NSQ_SOURCE_LINE 00002375 ""
NSQ_SOURCE_LINE 00002376 " my $meta = Alien::Build->meta;"
NSQ_SOURCE_LINE 00002377 " my $meta = $build->meta;"
NSQ_SOURCE_LINE 00002378 ""
NSQ_SOURCE_LINE 00002379 "Returns the meta object for your L<Alien::Build> class or instance.  The"
NSQ_SOURCE_LINE 00002380 "meta object is a way to manipulate the recipe, and so any changes to the"
NSQ_SOURCE_LINE 00002381 "meta object should be made before the C<probe>, C<download> or C<build> steps."
NSQ_SOURCE_LINE 00002382 ""
NSQ_SOURCE_LINE 00002383 "=head1 META METHODS"
NSQ_SOURCE_LINE 00002384 ""
NSQ_SOURCE_LINE 00002385 "=head2 prop"
NSQ_SOURCE_LINE 00002386 ""
NSQ_SOURCE_LINE 00002387 " my $href = $build->meta->prop;"
NSQ_SOURCE_LINE 00002388 ""
NSQ_SOURCE_LINE 00002389 "Meta properties.  This is the same as calling C<meta_prop> on"
NSQ_SOURCE_LINE 00002390 "the class or L<Alien::Build> instance."
NSQ_SOURCE_LINE 00002391 ""
NSQ_SOURCE_LINE 00002392 "=head2 add_requires"
NSQ_SOURCE_LINE 00002393 ""
NSQ_SOURCE_LINE 00002394 " Alien::Build->meta->add_requires($phase, $module => $version, ...);"
NSQ_SOURCE_LINE 00002395 ""
NSQ_SOURCE_LINE 00002396 "Add the requirement to the given phase.  Phase should be one of:"
NSQ_SOURCE_LINE 00002397 ""
NSQ_SOURCE_LINE 00002398 "=over 4"
NSQ_SOURCE_LINE 00002399 ""
NSQ_SOURCE_LINE 00002400 "=item configure"
NSQ_SOURCE_LINE 00002401 ""
NSQ_SOURCE_LINE 00002402 "=item any"
NSQ_SOURCE_LINE 00002403 ""
NSQ_SOURCE_LINE 00002404 "=item share"
NSQ_SOURCE_LINE 00002405 ""
NSQ_SOURCE_LINE 00002406 "=item system"
NSQ_SOURCE_LINE 00002407 ""
NSQ_SOURCE_LINE 00002408 "=back"
NSQ_SOURCE_LINE 00002409 ""
NSQ_SOURCE_LINE 00002410 "=head2 interpolator"
NSQ_SOURCE_LINE 00002411 ""
NSQ_SOURCE_LINE 00002412 " my $interpolator = $build->meta->interpolator;"
NSQ_SOURCE_LINE 00002413 " my $interpolator = Alien::Build->interpolator;"
NSQ_SOURCE_LINE 00002414 ""
NSQ_SOURCE_LINE 00002415 "Returns the L<Alien::Build::Interpolate> instance for the L<Alien::Build> class."
NSQ_SOURCE_LINE 00002416 ""
NSQ_SOURCE_LINE 00002417 "=head2 has_hook"
NSQ_SOURCE_LINE 00002418 ""
NSQ_SOURCE_LINE 00002419 " my $bool = $build->meta->has_hook($name);"
NSQ_SOURCE_LINE 00002420 " my $bool = Alien::Build->has_hook($name);"
NSQ_SOURCE_LINE 00002421 ""
NSQ_SOURCE_LINE 00002422 "Returns if there is a usable hook registered with the given name."
NSQ_SOURCE_LINE 00002423 ""
NSQ_SOURCE_LINE 00002424 "=head2 register_hook"
NSQ_SOURCE_LINE 00002425 ""
NSQ_SOURCE_LINE 00002426 " $build->meta->register_hook($name, $instructions);"
NSQ_SOURCE_LINE 00002427 " Alien::Build->meta->register_hook($name, $instructions);"
NSQ_SOURCE_LINE 00002428 ""
NSQ_SOURCE_LINE 00002429 "Register a hook with the given name.  C<$instruction> should be either"
NSQ_SOURCE_LINE 00002430 "a code reference, or a command sequence, which is an array reference."
NSQ_SOURCE_LINE 00002431 ""
NSQ_SOURCE_LINE 00002432 "=head2 default_hook"
NSQ_SOURCE_LINE 00002433 ""
NSQ_SOURCE_LINE 00002434 " $build->meta->default_hook($name, $instructions);"
NSQ_SOURCE_LINE 00002435 " Alien::Build->meta->default_hook($name, $instructions);"
NSQ_SOURCE_LINE 00002436 ""
NSQ_SOURCE_LINE 00002437 "Register a default hook, which will be used if the L<alienfile> does not"
NSQ_SOURCE_LINE 00002438 "register its own hook with that name."
NSQ_SOURCE_LINE 00002439 ""
NSQ_SOURCE_LINE 00002440 "=head2 around_hook"
NSQ_SOURCE_LINE 00002441 ""
NSQ_SOURCE_LINE 00002442 " $build->meta->around_hook($hook_name, $code);"
NSQ_SOURCE_LINE 00002443 " Alien::Build->meta->around_hook($hook_name, $code);"
NSQ_SOURCE_LINE 00002444 ""
NSQ_SOURCE_LINE 00002445 "Wrap the given hook with a code reference.  This is similar to a L<Moose>"
NSQ_SOURCE_LINE 00002446 "method modifier, except that it wraps around the given hook instead of"
NSQ_SOURCE_LINE 00002447 "a method.  For example, this will add a probe system requirement:"
NSQ_SOURCE_LINE 00002448 ""
NSQ_SOURCE_LINE 00002449 " $build->meta->around_hook("
NSQ_SOURCE_LINE 00002450 "   probe => sub {"
NSQ_SOURCE_LINE 00002451 "     my $orig = shift;"
NSQ_SOURCE_LINE 00002452 "     my $build = shift;"
NSQ_SOURCE_LINE 00002453 "     my $type = $orig->($build, @_);"
NSQ_SOURCE_LINE 00002454 "     return $type unless $type eq 'system';"
NSQ_SOURCE_LINE 00002455 "     # also require a configuration file"
NSQ_SOURCE_LINE 00002456 "     if(-f '/etc/foo.conf')"
NSQ_SOURCE_LINE 00002457 "     {"
NSQ_SOURCE_LINE 00002458 "       return 'system';"
NSQ_SOURCE_LINE 00002459 "     }"
NSQ_SOURCE_LINE 00002460 "     else"
NSQ_SOURCE_LINE 00002461 "     {"
NSQ_SOURCE_LINE 00002462 "       return 'share';"
NSQ_SOURCE_LINE 00002463 "     }"
NSQ_SOURCE_LINE 00002464 "   },"
NSQ_SOURCE_LINE 00002465 " );"
NSQ_SOURCE_LINE 00002466 ""
NSQ_SOURCE_LINE 00002467 "=head2 after_hook"
NSQ_SOURCE_LINE 00002468 ""
NSQ_SOURCE_LINE 00002469 " $build->meta->after_hook($hook_name, sub {"
NSQ_SOURCE_LINE 00002470 "   my(@args) = @_;"
NSQ_SOURCE_LINE 00002471 "   ..."
NSQ_SOURCE_LINE 00002472 " });"
NSQ_SOURCE_LINE 00002473 ""
NSQ_SOURCE_LINE 00002474 "Execute the given code reference after the hook.  The original"
NSQ_SOURCE_LINE 00002475 "arguments are passed into the code reference."
NSQ_SOURCE_LINE 00002476 ""
NSQ_SOURCE_LINE 00002477 "=head2 before_hook"
NSQ_SOURCE_LINE 00002478 ""
NSQ_SOURCE_LINE 00002479 " $build->meta->before_hook($hook_name, sub {"
NSQ_SOURCE_LINE 00002480 "   my(@args) = @_;"
NSQ_SOURCE_LINE 00002481 "   ..."
NSQ_SOURCE_LINE 00002482 " });"
NSQ_SOURCE_LINE 00002483 ""
NSQ_SOURCE_LINE 00002484 "Execute the given code reference before the hook.  The original"
NSQ_SOURCE_LINE 00002485 "arguments are passed into the code reference."
NSQ_SOURCE_LINE 00002486 ""
NSQ_SOURCE_LINE 00002487 "=head2 apply_plugin"
NSQ_SOURCE_LINE 00002488 ""
NSQ_SOURCE_LINE 00002489 " Alien::Build->meta->apply_plugin($name);"
NSQ_SOURCE_LINE 00002490 " Alien::Build->meta->apply_plugin($name, @args);"
NSQ_SOURCE_LINE 00002491 ""
NSQ_SOURCE_LINE 00002492 "Apply the given plugin with the given arguments."
NSQ_SOURCE_LINE 00002493 ""
NSQ_SOURCE_LINE 00002494 "=head1 ENVIRONMENT"
NSQ_SOURCE_LINE 00002495 ""
NSQ_SOURCE_LINE 00002496 "L<Alien::Build> responds to these environment variables:"
NSQ_SOURCE_LINE 00002497 ""
NSQ_SOURCE_LINE 00002498 "=over 4"
NSQ_SOURCE_LINE 00002499 ""
NSQ_SOURCE_LINE 00002500 "=item ALIEN_BUILD_LOG"
NSQ_SOURCE_LINE 00002501 ""
NSQ_SOURCE_LINE 00002502 "The default log class used.  See L<Alien::Build::Log> and L<Alien::Build::Log::Default>."
NSQ_SOURCE_LINE 00002503 ""
NSQ_SOURCE_LINE 00002504 "=item ALIEN_BUILD_PKG_CONFIG"
NSQ_SOURCE_LINE 00002505 ""
NSQ_SOURCE_LINE 00002506 "Override the logic in L<Alien::Build::Plugin::PkgConfig::Negotiate> which"
NSQ_SOURCE_LINE 00002507 "chooses the best C<pkg-config> plugin."
NSQ_SOURCE_LINE 00002508 ""
NSQ_SOURCE_LINE 00002509 "=item ALIEN_BUILD_POSTLOAD"
NSQ_SOURCE_LINE 00002510 ""
NSQ_SOURCE_LINE 00002511 "semicolon separated list of plugins to automatically load after parsing"
NSQ_SOURCE_LINE 00002512 "your L<alienfile>."
NSQ_SOURCE_LINE 00002513 ""
NSQ_SOURCE_LINE 00002514 "=item ALIEN_BUILD_PRELOAD"
NSQ_SOURCE_LINE 00002515 ""
NSQ_SOURCE_LINE 00002516 "semicolon separated list of plugins to automatically load before parsing"
NSQ_SOURCE_LINE 00002517 "your L<alienfile>."
NSQ_SOURCE_LINE 00002518 ""
NSQ_SOURCE_LINE 00002519 "=item ALIEN_BUILD_RC"
NSQ_SOURCE_LINE 00002520 ""
NSQ_SOURCE_LINE 00002521 "Perl source file which can override some global defaults for L<Alien::Build>,"
NSQ_SOURCE_LINE 00002522 "by, for example, setting preload and postload plugins."
NSQ_SOURCE_LINE 00002523 ""
NSQ_SOURCE_LINE 00002524 "=item ALIEN_DOWNLOAD_RULE"
NSQ_SOURCE_LINE 00002525 ""
NSQ_SOURCE_LINE 00002526 "This value determines the rules by which types of downloads are allowed.  The legal"
NSQ_SOURCE_LINE 00002527 "values listed under L</download_rule>, plus C<default> which will be the default for"
NSQ_SOURCE_LINE 00002528 "the current version of L<Alien::Build>.  For this version that default is C<warn>."
NSQ_SOURCE_LINE 00002529 ""
NSQ_SOURCE_LINE 00002530 "=item ALIEN_INSTALL_NETWORK"
NSQ_SOURCE_LINE 00002531 ""
NSQ_SOURCE_LINE 00002532 "If set to true (the default), then network fetch will be allowed.  If set to"
NSQ_SOURCE_LINE 00002533 "false, then network fetch will not be allowed."
NSQ_SOURCE_LINE 00002534 ""
NSQ_SOURCE_LINE 00002535 "What constitutes a local vs. network fetch is determined based on the C<start_url>"
NSQ_SOURCE_LINE 00002536 "and C<local_source> meta properties.  An L<alienfile> or plugin C<could> override"
NSQ_SOURCE_LINE 00002537 "this detection (possibly inappropriately), so this variable is not a substitute"
NSQ_SOURCE_LINE 00002538 "for properly auditing of Perl modules for environments that require that."
NSQ_SOURCE_LINE 00002539 ""
NSQ_SOURCE_LINE 00002540 "=item ALIEN_INSTALL_TYPE"
NSQ_SOURCE_LINE 00002541 ""
NSQ_SOURCE_LINE 00002542 "If set to C<share> or C<system>, it will override the system detection logic."
NSQ_SOURCE_LINE 00002543 "If set to C<default>, it will use the default setting for the L<alienfile>."
NSQ_SOURCE_LINE 00002544 "The behavior of other values is undefined."
NSQ_SOURCE_LINE 00002545 ""
NSQ_SOURCE_LINE 00002546 "Although the recommended way for a consumer to use an L<Alien::Base> based L<Alien>"
NSQ_SOURCE_LINE 00002547 "is to declare it as a static configure and build-time dependency, some consumers"
NSQ_SOURCE_LINE 00002548 "may prefer to fallback on using an L<Alien> only when the consumer itself cannot"
NSQ_SOURCE_LINE 00002549 "detect the necessary package. In some cases the consumer may want the user to opt-in"
NSQ_SOURCE_LINE 00002550 "to using an L<Alien> before requiring it."
NSQ_SOURCE_LINE 00002551 ""
NSQ_SOURCE_LINE 00002552 "To keep the interface consistent among Aliens, the consumer of the fallback opt-in"
NSQ_SOURCE_LINE 00002553 "L<Alien> may fallback on the L<Alien> if the environment variable C<ALIEN_INSTALL_TYPE>"
NSQ_SOURCE_LINE 00002554 "is set to any value. The rationale is that by setting this environment variable the"
NSQ_SOURCE_LINE 00002555 "user is aware that L<Alien> modules may be installed and have indicated consent."
NSQ_SOURCE_LINE 00002556 "The actual implementation of this, by its nature would have to be in the consuming"
NSQ_SOURCE_LINE 00002557 "CPAN module."
NSQ_SOURCE_LINE 00002558 ""
NSQ_SOURCE_LINE 00002559 "=item DESTDIR"
NSQ_SOURCE_LINE 00002560 ""
NSQ_SOURCE_LINE 00002561 "This environment variable will be manipulated during a destdir install."
NSQ_SOURCE_LINE 00002562 ""
NSQ_SOURCE_LINE 00002563 "=item PKG_CONFIG"
NSQ_SOURCE_LINE 00002564 ""
NSQ_SOURCE_LINE 00002565 "This environment variable can be used to override the program name for C<pkg-config>"
NSQ_SOURCE_LINE 00002566 "when using the command line plugin: L<Alien::Build::Plugin::PkgConfig::CommandLine>."
NSQ_SOURCE_LINE 00002567 ""
NSQ_SOURCE_LINE 00002568 "=item ftp_proxy, all_proxy"
NSQ_SOURCE_LINE 00002569 ""
NSQ_SOURCE_LINE 00002570 "If these environment variables are set, it may influence the Download negotiation"
NSQ_SOURCE_LINE 00002571 "plugin L<Alien::Build::Plugin::Download::Negotiate>.  Other proxy variables may"
NSQ_SOURCE_LINE 00002572 "be used by some Fetch plugins, if they support it."
NSQ_SOURCE_LINE 00002573 ""
NSQ_SOURCE_LINE 00002574 "=back"
NSQ_SOURCE_LINE 00002575 ""
NSQ_SOURCE_LINE 00002576 "=head1 SUPPORT"
NSQ_SOURCE_LINE 00002577 ""
NSQ_SOURCE_LINE 00002578 "The intent of the C<Alien-Build> team is to support the same versions of"
NSQ_SOURCE_LINE 00002579 "Perl that are supported by the Perl toolchain.  As of this writing that"
NSQ_SOURCE_LINE 00002580 "means 5.16 and better."
NSQ_SOURCE_LINE 00002581 ""
NSQ_SOURCE_LINE 00002582 "Please feel encouraged to report issues that you encounter to the"
NSQ_SOURCE_LINE 00002583 "project GitHub Issue tracker:"
NSQ_SOURCE_LINE 00002584 ""
NSQ_SOURCE_LINE 00002585 "=over 4"
NSQ_SOURCE_LINE 00002586 ""
NSQ_SOURCE_LINE 00002587 "=item L<https://github.com/PerlAlien/Alien-Build/issues>"
NSQ_SOURCE_LINE 00002588 ""
NSQ_SOURCE_LINE 00002589 "=back"
NSQ_SOURCE_LINE 00002590 ""
NSQ_SOURCE_LINE 00002591 "Better if you can fix the issue yourself, please feel encouraged to open"
NSQ_SOURCE_LINE 00002592 "pull-request on the project GitHub:"
NSQ_SOURCE_LINE 00002593 ""
NSQ_SOURCE_LINE 00002594 "=over 4"
NSQ_SOURCE_LINE 00002595 ""
NSQ_SOURCE_LINE 00002596 "=item L<https://github.com/PerlAlien/Alien-Build/pulls>"
NSQ_SOURCE_LINE 00002597 ""
NSQ_SOURCE_LINE 00002598 "=back"
NSQ_SOURCE_LINE 00002599 ""
NSQ_SOURCE_LINE 00002600 "If you are confounded and have questions, join us on the C<#native>"
NSQ_SOURCE_LINE 00002601 "channel on irc.perl.org.  The C<Alien-Build> developers frequent this"
NSQ_SOURCE_LINE 00002602 "channel and can probably help point you in the right direction.  If you"
NSQ_SOURCE_LINE 00002603 "don't have an IRC client handy, you can use this web interface:"
NSQ_SOURCE_LINE 00002604 ""
NSQ_SOURCE_LINE 00002605 "=over 4"
NSQ_SOURCE_LINE 00002606 ""
NSQ_SOURCE_LINE 00002607 "=item L<https://chat.mibbit.com/?channel=%23native&server=irc.perl.org>"
NSQ_SOURCE_LINE 00002608 ""
NSQ_SOURCE_LINE 00002609 "=back"
NSQ_SOURCE_LINE 00002610 ""
NSQ_SOURCE_LINE 00002611 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00002612 ""
NSQ_SOURCE_LINE 00002613 "L<Alien::Build::Manual::AlienAuthor>,"
