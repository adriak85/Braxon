NSQ_SOURCE_LINE 00000317 "sub _merge"
NSQ_SOURCE_LINE 00000318 "{"
NSQ_SOURCE_LINE 00000319 "  my %h;"
NSQ_SOURCE_LINE 00000320 "  while(@_)"
NSQ_SOURCE_LINE 00000321 "  {"
NSQ_SOURCE_LINE 00000322 "    my $mod = shift;"
NSQ_SOURCE_LINE 00000323 "    my $ver = shift;"
NSQ_SOURCE_LINE 00000324 "    if((!defined $h{$mod}) || $ver > $h{$mod})"
NSQ_SOURCE_LINE 00000325 "    { $h{$mod} = $ver }"
NSQ_SOURCE_LINE 00000326 "  }"
NSQ_SOURCE_LINE 00000327 "  \\%h;"
NSQ_SOURCE_LINE 00000328 "}"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "sub requires"
NSQ_SOURCE_LINE 00000332 "{"
NSQ_SOURCE_LINE 00000333 "  my($self, $phase) = @_;"
NSQ_SOURCE_LINE 00000334 "  $phase ||= 'any';"
NSQ_SOURCE_LINE 00000335 "  my $meta = $self->meta;"
NSQ_SOURCE_LINE 00000336 "  $phase =~ /^(?:any|configure)$/"
NSQ_SOURCE_LINE 00000337 "  ? $meta->{require}->{$phase} || {}"
NSQ_SOURCE_LINE 00000338 "  : _merge %{ $meta->{require}->{any} }, %{ $meta->{require}->{$phase} };"
NSQ_SOURCE_LINE 00000339 "}"
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "sub load_requires"
NSQ_SOURCE_LINE 00000343 "{"
NSQ_SOURCE_LINE 00000344 "  my($self, $phase, $eval) = @_;"
NSQ_SOURCE_LINE 00000345 "  my $reqs = $self->requires($phase);"
NSQ_SOURCE_LINE 00000346 "  foreach my $mod (keys %$reqs)"
NSQ_SOURCE_LINE 00000347 "  {"
NSQ_SOURCE_LINE 00000348 "    my $ver = $reqs->{$mod};"
NSQ_SOURCE_LINE 00000349 "    my $check = sub {"
NSQ_SOURCE_LINE 00000350 "      my $pm = \"$mod.pm\";"
NSQ_SOURCE_LINE 00000351 "      $pm =~ s{::}{/}g;"
NSQ_SOURCE_LINE 00000352 "      require $pm;"
NSQ_SOURCE_LINE 00000353 "    };"
NSQ_SOURCE_LINE 00000354 "    if($eval)"
NSQ_SOURCE_LINE 00000355 "    {"
NSQ_SOURCE_LINE 00000356 "      eval { $check->() };"
NSQ_SOURCE_LINE 00000357 "      die \"Required $mod @{[ $ver || 'undef' ]}, missing\" if $@;"
NSQ_SOURCE_LINE 00000358 "    }"
NSQ_SOURCE_LINE 00000359 "    else"
NSQ_SOURCE_LINE 00000360 "    {"
NSQ_SOURCE_LINE 00000361 "      $check->();"
NSQ_SOURCE_LINE 00000362 "    }"
NSQ_SOURCE_LINE 00000363 "    # note Test::Alien::Build#alienfile_skip_if_missing_prereqs does a regex"
NSQ_SOURCE_LINE 00000364 "    # on this diagnostic, so if you change it here, change it there too."
NSQ_SOURCE_LINE 00000365 "    die \"Required $mod $ver, have @{[ $mod->VERSION || 0 ]}\" if $ver && ! $mod->VERSION($ver);"
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "    # allow for requires on Alien::Build or Alien::Base"
NSQ_SOURCE_LINE 00000368 "    next if $mod eq 'Alien::Build';"
NSQ_SOURCE_LINE 00000369 "    next if $mod eq 'Alien::Base';"
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "    if($mod->can('bin_dir'))"
NSQ_SOURCE_LINE 00000372 "    {"
NSQ_SOURCE_LINE 00000373 "      push @{ $self->{bin_dir} }, $mod->bin_dir;"
NSQ_SOURCE_LINE 00000374 "    }"
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "    if(($mod->can('runtime_prop') && $mod->runtime_prop)"
NSQ_SOURCE_LINE 00000377 "    || ($mod->isa('Alien::Base')  && $mod->install_type('share')))"
NSQ_SOURCE_LINE 00000378 "    {"
NSQ_SOURCE_LINE 00000379 "      for my $dir (qw(lib share)) {"
NSQ_SOURCE_LINE 00000380 "          my $path = _path($mod->dist_dir)->child(\"$dir/pkgconfig\");"
NSQ_SOURCE_LINE 00000381 "          if(-d $path)"
NSQ_SOURCE_LINE 00000382 "          {"
NSQ_SOURCE_LINE 00000383 "            push @{ $self->{pkg_config_path} }, $path->stringify;"
NSQ_SOURCE_LINE 00000384 "          }"
NSQ_SOURCE_LINE 00000385 "      }"
NSQ_SOURCE_LINE 00000386 "      my $path = _path($mod->dist_dir)->child('share/aclocal');"
NSQ_SOURCE_LINE 00000387 "      if(-d $path)"
NSQ_SOURCE_LINE 00000388 "      {"
NSQ_SOURCE_LINE 00000389 "        $path = \"$path\";"
NSQ_SOURCE_LINE 00000390 "        if($^O eq 'MSWin32')"
NSQ_SOURCE_LINE 00000391 "        {"
NSQ_SOURCE_LINE 00000392 "          # convert to MSYS path"
NSQ_SOURCE_LINE 00000393 "          $path =~ s{^([a-z]):}{/$1/}i;"
NSQ_SOURCE_LINE 00000394 "        }"
NSQ_SOURCE_LINE 00000395 "        push @{ $self->{aclocal_path} }, $path;"
NSQ_SOURCE_LINE 00000396 "      }"
NSQ_SOURCE_LINE 00000397 "    }"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "    # sufficiently new Autotools have a aclocal_dir which will"
NSQ_SOURCE_LINE 00000400 "    # give us the directories we need."
NSQ_SOURCE_LINE 00000401 "    if($mod eq 'Alien::Autotools' && $mod->can('aclocal_dir'))"
NSQ_SOURCE_LINE 00000402 "    {"
NSQ_SOURCE_LINE 00000403 "      push @{ $self->{aclocal_path} }, $mod->aclocal_dir;"
NSQ_SOURCE_LINE 00000404 "    }"
NSQ_SOURCE_LINE 00000405 ""
NSQ_SOURCE_LINE 00000406 "    if($mod->can('alien_helper'))"
NSQ_SOURCE_LINE 00000407 "    {"
NSQ_SOURCE_LINE 00000408 "      my $helpers = $mod->alien_helper;"
NSQ_SOURCE_LINE 00000409 "      foreach my $name (sort keys %$helpers)"
NSQ_SOURCE_LINE 00000410 "      {"
NSQ_SOURCE_LINE 00000411 "        my $code = $helpers->{$name};"
NSQ_SOURCE_LINE 00000412 "        $self->meta->interpolator->replace_helper($name => $code);"
NSQ_SOURCE_LINE 00000413 "      }"
NSQ_SOURCE_LINE 00000414 "    }"
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "  }"
NSQ_SOURCE_LINE 00000417 "  1;"
NSQ_SOURCE_LINE 00000418 "}"
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "sub _call_hook"
NSQ_SOURCE_LINE 00000421 "{"
NSQ_SOURCE_LINE 00000422 "  my $self = shift;"
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "  local $ENV{PATH} = $ENV{PATH};"
NSQ_SOURCE_LINE 00000425 "  unshift @PATH, @{ $self->{bin_dir} };"
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 "  local $ENV{PKG_CONFIG_PATH} = $ENV{PKG_CONFIG_PATH};"
NSQ_SOURCE_LINE 00000428 "  unshift @PKG_CONFIG_PATH, @{ $self->{pkg_config_path} };"
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "  local $ENV{ACLOCAL_PATH} = $ENV{ACLOCAL_PATH};"
NSQ_SOURCE_LINE 00000431 "  # autoconf uses MSYS paths, even for the ACLOCAL_PATH environment variable, so we can't use Env for this."
NSQ_SOURCE_LINE 00000432 "  {"
NSQ_SOURCE_LINE 00000433 "    my @path;"
NSQ_SOURCE_LINE 00000434 "    @path = split /:/, $ENV{ACLOCAL_PATH} if defined $ENV{ACLOCAL_PATH};"
NSQ_SOURCE_LINE 00000435 "    unshift @path, @{ $self->{aclocal_path} };"
NSQ_SOURCE_LINE 00000436 "    $ENV{ACLOCAL_PATH} = join ':', @path;"
NSQ_SOURCE_LINE 00000437 "  }"
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "  my $config = ref($_[0]) eq 'HASH' ? shift : {};"
NSQ_SOURCE_LINE 00000440 "  my($name, @args) = @_;"
NSQ_SOURCE_LINE 00000441 ""
NSQ_SOURCE_LINE 00000442 "  local $self->{hook_prop} = {};"
NSQ_SOURCE_LINE 00000443 ""
NSQ_SOURCE_LINE 00000444 "  $self->meta->call_hook( $config, $name => $self, @args );"
NSQ_SOURCE_LINE 00000445 "}"
NSQ_SOURCE_LINE 00000446 ""
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 "sub probe"
NSQ_SOURCE_LINE 00000449 "{"
NSQ_SOURCE_LINE 00000450 "  my($self) = @_;"
NSQ_SOURCE_LINE 00000451 "  local $CWD = $self->root;"
NSQ_SOURCE_LINE 00000452 "  my $dir;"
NSQ_SOURCE_LINE 00000453 ""
NSQ_SOURCE_LINE 00000454 "  my $env = $self->_call_hook('override');"
NSQ_SOURCE_LINE 00000455 "  my $type;"
NSQ_SOURCE_LINE 00000456 "  my $error;"
NSQ_SOURCE_LINE 00000457 ""
NSQ_SOURCE_LINE 00000458 "  $env = '' if $env eq 'default';"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "  if($env eq 'share')"
NSQ_SOURCE_LINE 00000461 "  {"
NSQ_SOURCE_LINE 00000462 "    $type = 'share';"
NSQ_SOURCE_LINE 00000463 "  }"
NSQ_SOURCE_LINE 00000464 "  else"
NSQ_SOURCE_LINE 00000465 "  {"
NSQ_SOURCE_LINE 00000466 "    $type = eval {"
NSQ_SOURCE_LINE 00000467 "      $self->_call_hook("
NSQ_SOURCE_LINE 00000468 "        {"
NSQ_SOURCE_LINE 00000469 "          before   => sub {"
NSQ_SOURCE_LINE 00000470 "            $dir = Alien::Build::TempDir->new($self, \"probe\");"
NSQ_SOURCE_LINE 00000471 "            $CWD = \"$dir\";"
NSQ_SOURCE_LINE 00000472 "          },"
NSQ_SOURCE_LINE 00000473 "          after    => sub {"
NSQ_SOURCE_LINE 00000474 "            $CWD = $self->root;"
NSQ_SOURCE_LINE 00000475 "          },"
NSQ_SOURCE_LINE 00000476 "          ok       => 'system',"
NSQ_SOURCE_LINE 00000477 "          continue => sub {"
NSQ_SOURCE_LINE 00000478 "            if($_[0] eq 'system')"
NSQ_SOURCE_LINE 00000479 "            {"
NSQ_SOURCE_LINE 00000480 "              foreach my $name (qw( probe_class probe_instance_id ))"
NSQ_SOURCE_LINE 00000481 "              {"
NSQ_SOURCE_LINE 00000482 "                if(exists $self->hook_prop->{$name} && defined $self->hook_prop->{$name})"
NSQ_SOURCE_LINE 00000483 "                {"
NSQ_SOURCE_LINE 00000484 "                  $self->install_prop->{\"system_$name\"} = $self->hook_prop->{$name};"
NSQ_SOURCE_LINE 00000485 "                }"
NSQ_SOURCE_LINE 00000486 "              }"
NSQ_SOURCE_LINE 00000487 "              return undef;"
NSQ_SOURCE_LINE 00000488 "            }"
NSQ_SOURCE_LINE 00000489 "            else"
NSQ_SOURCE_LINE 00000490 "            {"
NSQ_SOURCE_LINE 00000491 "              return 1;"
NSQ_SOURCE_LINE 00000492 "            }"
NSQ_SOURCE_LINE 00000493 "          },"
NSQ_SOURCE_LINE 00000494 "        },"
NSQ_SOURCE_LINE 00000495 "        'probe',"
NSQ_SOURCE_LINE 00000496 "      );"
NSQ_SOURCE_LINE 00000497 "    };"
NSQ_SOURCE_LINE 00000498 "    $error = $@;"
NSQ_SOURCE_LINE 00000499 "    $type = 'share' unless defined $type;"
NSQ_SOURCE_LINE 00000500 "  }"
NSQ_SOURCE_LINE 00000501 ""
NSQ_SOURCE_LINE 00000502 "  if($error)"
NSQ_SOURCE_LINE 00000503 "  {"
NSQ_SOURCE_LINE 00000504 "    if($env eq 'system')"
NSQ_SOURCE_LINE 00000505 "    {"
NSQ_SOURCE_LINE 00000506 "      die $error;"
NSQ_SOURCE_LINE 00000507 "    }"
NSQ_SOURCE_LINE 00000508 "    $self->log(\"error in probe (will do a share install): $@\");"
NSQ_SOURCE_LINE 00000509 "    $self->log(\"Don't panic, we will attempt a share build from source if possible.\");"
NSQ_SOURCE_LINE 00000510 "    $self->log(\"Do not file a bug unless you expected a system install to succeed.\");"
NSQ_SOURCE_LINE 00000511 "    $type = 'share';"
NSQ_SOURCE_LINE 00000512 "  }"
NSQ_SOURCE_LINE 00000513 ""
NSQ_SOURCE_LINE 00000514 "  if($env && $env ne $type)"
NSQ_SOURCE_LINE 00000515 "  {"
NSQ_SOURCE_LINE 00000516 "    die \"requested $env install not available\";"
NSQ_SOURCE_LINE 00000517 "  }"
NSQ_SOURCE_LINE 00000518 ""
NSQ_SOURCE_LINE 00000519 "  if($type !~ /^(system|share)$/)"
NSQ_SOURCE_LINE 00000520 "  {"
NSQ_SOURCE_LINE 00000521 "    Carp::croak \"probe hook returned something other than system or share: $type\";"
NSQ_SOURCE_LINE 00000522 "  }"
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 "  if($type eq 'share' && (!$self->meta_prop->{network}) && (!$self->meta_prop->{local_source}))"
NSQ_SOURCE_LINE 00000525 "  {"
NSQ_SOURCE_LINE 00000526 "    $self->log(\"install type share requested or detected, but network fetch is turned off\");"
NSQ_SOURCE_LINE 00000527 "    $self->log(\"see https://metacpan.org/pod/Alien::Build::Manual::FAQ#Network-fetch-is-turned-off\");"
NSQ_SOURCE_LINE 00000528 "    Carp::croak \"network fetch is turned off\";"
NSQ_SOURCE_LINE 00000529 "  }"
NSQ_SOURCE_LINE 00000530 ""
NSQ_SOURCE_LINE 00000531 "  $self->runtime_prop->{install_type} = $type;"
NSQ_SOURCE_LINE 00000532 ""
NSQ_SOURCE_LINE 00000533 "  $type;"
NSQ_SOURCE_LINE 00000534 "}"
NSQ_SOURCE_LINE 00000535 ""
NSQ_SOURCE_LINE 00000536 ""
NSQ_SOURCE_LINE 00000537 "sub download"
NSQ_SOURCE_LINE 00000538 "{"
NSQ_SOURCE_LINE 00000539 "  my($self) = @_;"
NSQ_SOURCE_LINE 00000540 ""
NSQ_SOURCE_LINE 00000541 "  return $self unless $self->install_type eq 'share';"
NSQ_SOURCE_LINE 00000542 "  return $self if $self->install_prop->{complete}->{download};"
NSQ_SOURCE_LINE 00000543 ""
NSQ_SOURCE_LINE 00000544 "  if($self->meta->has_hook('download'))"
NSQ_SOURCE_LINE 00000545 "  {"
NSQ_SOURCE_LINE 00000546 "    my $tmp;"
NSQ_SOURCE_LINE 00000547 "    local $CWD;"
NSQ_SOURCE_LINE 00000548 "    my $valid = 0;"
NSQ_SOURCE_LINE 00000549 ""
NSQ_SOURCE_LINE 00000550 "    $self->_call_hook("
NSQ_SOURCE_LINE 00000551 "      {"
NSQ_SOURCE_LINE 00000552 "        before => sub {"
NSQ_SOURCE_LINE 00000553 "          $tmp = Alien::Build::TempDir->new($self, \"download\");"
NSQ_SOURCE_LINE 00000554 "          $CWD = \"$tmp\";"
NSQ_SOURCE_LINE 00000555 "        },"
NSQ_SOURCE_LINE 00000556 "        verify => sub {"
NSQ_SOURCE_LINE 00000557 "          my @list = grep { $_->basename !~ /^\\./, } _path('.')->children;"
NSQ_SOURCE_LINE 00000558 ""
NSQ_SOURCE_LINE 00000559 "          my $count = scalar @list;"
NSQ_SOURCE_LINE 00000560 ""
NSQ_SOURCE_LINE 00000561 "          if($count == 0)"
NSQ_SOURCE_LINE 00000562 "          {"
NSQ_SOURCE_LINE 00000563 "            die \"no files downloaded\";"
NSQ_SOURCE_LINE 00000564 "          }"
NSQ_SOURCE_LINE 00000565 "          elsif($count == 1)"
NSQ_SOURCE_LINE 00000566 "          {"
NSQ_SOURCE_LINE 00000567 "            my($archive) = $list[0];"
NSQ_SOURCE_LINE 00000568 "            if(-d $archive)"
NSQ_SOURCE_LINE 00000569 "            {"
NSQ_SOURCE_LINE 00000570 "              # TODO: this is probably a bug that we don't set"
NSQ_SOURCE_LINE 00000571 "              # download or compelte properties?"
NSQ_SOURCE_LINE 00000572 "              $self->log(\"single dir, assuming directory\");"
NSQ_SOURCE_LINE 00000573 "            }"
NSQ_SOURCE_LINE 00000574 "            else"
NSQ_SOURCE_LINE 00000575 "            {"
NSQ_SOURCE_LINE 00000576 "              $self->log(\"single file, assuming archive\");"
NSQ_SOURCE_LINE 00000577 "            }"
NSQ_SOURCE_LINE 00000578 "            $self->install_prop->{download} = $archive->absolute->stringify;"
NSQ_SOURCE_LINE 00000579 "            $self->install_prop->{complete}->{download} = 1;"
NSQ_SOURCE_LINE 00000580 "            $valid = 1;"
NSQ_SOURCE_LINE 00000581 "          }"
NSQ_SOURCE_LINE 00000582 "          else"
NSQ_SOURCE_LINE 00000583 "          {"
NSQ_SOURCE_LINE 00000584 "            $self->log(\"multiple files, assuming directory\");"
NSQ_SOURCE_LINE 00000585 "            $self->install_prop->{complete}->{download} = 1;"
NSQ_SOURCE_LINE 00000586 "            $self->install_prop->{download} = _path('.')->absolute->stringify;"
NSQ_SOURCE_LINE 00000587 "            $valid = 1;"
NSQ_SOURCE_LINE 00000588 "          }"
NSQ_SOURCE_LINE 00000589 "        },"
NSQ_SOURCE_LINE 00000590 "        after  => sub {"
NSQ_SOURCE_LINE 00000591 "          $CWD = $self->root;"
NSQ_SOURCE_LINE 00000592 "        },"
NSQ_SOURCE_LINE 00000593 "      },"
NSQ_SOURCE_LINE 00000594 "      'download',"
NSQ_SOURCE_LINE 00000595 "    );"
NSQ_SOURCE_LINE 00000596 ""
NSQ_SOURCE_LINE 00000597 "    # experimental and undocumented for now"
NSQ_SOURCE_LINE 00000598 "    if($self->meta->has_hook('check_download'))"
NSQ_SOURCE_LINE 00000599 "    {"
NSQ_SOURCE_LINE 00000600 "      $self->meta->call_hook(check_download => $self);"
NSQ_SOURCE_LINE 00000601 "    }"
NSQ_SOURCE_LINE 00000602 ""
NSQ_SOURCE_LINE 00000603 "    return $self if $valid;"
NSQ_SOURCE_LINE 00000604 "  }"
NSQ_SOURCE_LINE 00000605 "  else"
NSQ_SOURCE_LINE 00000606 "  {"
NSQ_SOURCE_LINE 00000607 "    # This will call the default download hook"
NSQ_SOURCE_LINE 00000608 "    # defined in Core::Download since the recipe"
NSQ_SOURCE_LINE 00000609 "    # does not provide a download hook"
NSQ_SOURCE_LINE 00000610 "    my $ret = $self->_call_hook('download');"
NSQ_SOURCE_LINE 00000611 ""
NSQ_SOURCE_LINE 00000612 "    # experimental and undocumented for now"
NSQ_SOURCE_LINE 00000613 "    if($self->meta->has_hook('check_download'))"
NSQ_SOURCE_LINE 00000614 "    {"
NSQ_SOURCE_LINE 00000615 "      $self->meta->call_hook(check_download => $self);"
NSQ_SOURCE_LINE 00000616 "    }"
NSQ_SOURCE_LINE 00000617 ""
NSQ_SOURCE_LINE 00000618 "    return $self;"
NSQ_SOURCE_LINE 00000619 "  }"
NSQ_SOURCE_LINE 00000620 ""
NSQ_SOURCE_LINE 00000621 "  die \"download failed\";"
NSQ_SOURCE_LINE 00000622 "}"
NSQ_SOURCE_LINE 00000623 ""
NSQ_SOURCE_LINE 00000624 ""
NSQ_SOURCE_LINE 00000625 "sub fetch"
NSQ_SOURCE_LINE 00000626 "{"
NSQ_SOURCE_LINE 00000627 "  my $self = shift;"
NSQ_SOURCE_LINE 00000628 "  my $url = $_[0] || $self->meta_prop->{start_url};"
NSQ_SOURCE_LINE 00000629 ""
NSQ_SOURCE_LINE 00000630 "  my $secure = 0;"
NSQ_SOURCE_LINE 00000631 ""
NSQ_SOURCE_LINE 00000632 "  if(defined $url && ($url =~ /^(https|file):/ || $url !~ /:/))"
NSQ_SOURCE_LINE 00000633 "  {"
NSQ_SOURCE_LINE 00000634 "    # considered secure when either https or a local file"
NSQ_SOURCE_LINE 00000635 "    $secure = 1;"
NSQ_SOURCE_LINE 00000636 "  }"
NSQ_SOURCE_LINE 00000637 "  elsif(!defined $url)"
NSQ_SOURCE_LINE 00000638 "  {"
NSQ_SOURCE_LINE 00000639 "    $self->log(\"warning: undefined url in fetch\");"
NSQ_SOURCE_LINE 00000640 "  }"
NSQ_SOURCE_LINE 00000641 "  else"
NSQ_SOURCE_LINE 00000642 "  {"
NSQ_SOURCE_LINE 00000643 "    $self->log(\"warning: attempting to fetch a non-TLS or bundled URL: @{[ $url ]}\");"
NSQ_SOURCE_LINE 00000644 "  }"
NSQ_SOURCE_LINE 00000645 ""
NSQ_SOURCE_LINE 00000646 "  die \"insecure fetch is not allowed\" if $self->download_rule =~ /^(encrypt|digest_and_encrypt)$/ && !$secure;"
NSQ_SOURCE_LINE 00000647 ""
NSQ_SOURCE_LINE 00000648 "  my $file = $self->_call_hook( 'fetch' => @_ );"
NSQ_SOURCE_LINE 00000649 ""
NSQ_SOURCE_LINE 00000650 "  $secure = 0;"
NSQ_SOURCE_LINE 00000651 ""
NSQ_SOURCE_LINE 00000652 "  if(ref($file) ne 'HASH')"
NSQ_SOURCE_LINE 00000653 "  {"
NSQ_SOURCE_LINE 00000654 "    $self->log(\"warning: fetch returned non-hash reference\");"
NSQ_SOURCE_LINE 00000655 "  }"
NSQ_SOURCE_LINE 00000656 "  elsif(!defined $file->{protocol})"
NSQ_SOURCE_LINE 00000657 "  {"
NSQ_SOURCE_LINE 00000658 "    $self->log(\"warning: fetch did not return a protocol\");"
NSQ_SOURCE_LINE 00000659 "  }"
NSQ_SOURCE_LINE 00000660 "  elsif($file->{protocol} !~ /^(https|file)$/)"
NSQ_SOURCE_LINE 00000661 "  {"
NSQ_SOURCE_LINE 00000662 "    $self->log(\"warning: fetch did not use a secure protocol: @{[ $file->{protocol} ]}\");"
NSQ_SOURCE_LINE 00000663 "  }"
NSQ_SOURCE_LINE 00000664 "  else"
NSQ_SOURCE_LINE 00000665 "  {"
NSQ_SOURCE_LINE 00000666 "    $secure = 1;"
NSQ_SOURCE_LINE 00000667 "  }"
NSQ_SOURCE_LINE 00000668 ""
NSQ_SOURCE_LINE 00000669 "  die \"insecure fetch is not allowed\" if $self->download_rule =~ /^(encrypt|digest_and_encrypt)$/ && !$secure;"
NSQ_SOURCE_LINE 00000670 ""
NSQ_SOURCE_LINE 00000671 "  $file;"
NSQ_SOURCE_LINE 00000672 "}"
NSQ_SOURCE_LINE 00000673 ""
NSQ_SOURCE_LINE 00000674 ""
NSQ_SOURCE_LINE 00000675 "sub check_digest"
NSQ_SOURCE_LINE 00000676 "{"
NSQ_SOURCE_LINE 00000677 "  my($self, $file) = @_;"
NSQ_SOURCE_LINE 00000678 ""
NSQ_SOURCE_LINE 00000679 "  return '' unless $self->meta_prop->{check_digest};"
NSQ_SOURCE_LINE 00000680 ""
NSQ_SOURCE_LINE 00000681 "  unless(ref($file) eq 'HASH')"
NSQ_SOURCE_LINE 00000682 "  {"
NSQ_SOURCE_LINE 00000683 "    my $path = Path::Tiny->new($file);"
NSQ_SOURCE_LINE 00000684 "    $file = {"
NSQ_SOURCE_LINE 00000685 "      type     => 'file',"
NSQ_SOURCE_LINE 00000686 "      filename => $path->basename,"
NSQ_SOURCE_LINE 00000687 "      path     => \"$path\","
NSQ_SOURCE_LINE 00000688 "      tmp      => 0,"
NSQ_SOURCE_LINE 00000689 "    };"
NSQ_SOURCE_LINE 00000690 "  }"
NSQ_SOURCE_LINE 00000691 ""
NSQ_SOURCE_LINE 00000692 "  my $path = $file->{path};"
NSQ_SOURCE_LINE 00000693 "  if(defined $path)"
NSQ_SOURCE_LINE 00000694 "  {"
NSQ_SOURCE_LINE 00000695 "    # there is technically a race condition here"
NSQ_SOURCE_LINE 00000696 "    die \"Missing file in digest check: @{[ $file->{filename} ]}\" unless -f $path;"
NSQ_SOURCE_LINE 00000697 "    die \"Unreadable file in digest check: @{[ $file->{filename} ]}\" unless -r $path;"
NSQ_SOURCE_LINE 00000698 "  }"
NSQ_SOURCE_LINE 00000699 "  else"
NSQ_SOURCE_LINE 00000700 "  {"
NSQ_SOURCE_LINE 00000701 "    die \"File is wrong type\" unless defined $file->{type} && $file->{type} eq 'file';"
NSQ_SOURCE_LINE 00000702 "    die \"File has no filename\" unless defined $file->{filename};"
NSQ_SOURCE_LINE 00000703 "    die \"@{[ $file->{filename} ]} has no content\" unless defined $file->{content};"
NSQ_SOURCE_LINE 00000704 "  }"
NSQ_SOURCE_LINE 00000705 ""
NSQ_SOURCE_LINE 00000706 "  my $filename = $file->{filename};"
NSQ_SOURCE_LINE 00000707 "  my $signature = $self->meta_prop->{digest}->{$filename} || $self->meta_prop->{digest}->{'*'};"
NSQ_SOURCE_LINE 00000708 ""
NSQ_SOURCE_LINE 00000709 "  die \"No digest for $filename\" unless defined $signature && ref $signature eq 'ARRAY';"
NSQ_SOURCE_LINE 00000710 ""
NSQ_SOURCE_LINE 00000711 "  my($algo, $expected) = @$signature;"
NSQ_SOURCE_LINE 00000712 ""
NSQ_SOURCE_LINE 00000713 "  if($self->meta->call_hook( check_digest => $self, $file, $algo, $expected ))"
NSQ_SOURCE_LINE 00000714 "  {"
NSQ_SOURCE_LINE 00000715 "    # record the verification here so that we can check in the extract step that the signature"
NSQ_SOURCE_LINE 00000716 "    # was checked."
NSQ_SOURCE_LINE 00000717 "    $self->install_prop->{download_detail}->{$path}->{digest} = [$algo, $expected] if defined $path; return 1;"
NSQ_SOURCE_LINE 00000718 "  }"
NSQ_SOURCE_LINE 00000719 "  else"
NSQ_SOURCE_LINE 00000720 "  {"
NSQ_SOURCE_LINE 00000721 "    die \"No plugin provides digest algorithm for $algo\";"
NSQ_SOURCE_LINE 00000722 "  }"
NSQ_SOURCE_LINE 00000723 "}"
NSQ_SOURCE_LINE 00000724 ""
NSQ_SOURCE_LINE 00000725 ""
NSQ_SOURCE_LINE 00000726 "sub decode"
NSQ_SOURCE_LINE 00000727 "{"
NSQ_SOURCE_LINE 00000728 "  my($self, $res) = @_;"
NSQ_SOURCE_LINE 00000729 "  my $res2 = $self->_call_hook( decode => $res );"
NSQ_SOURCE_LINE 00000730 "  $res2->{protocol} = $res->{protocol}"
NSQ_SOURCE_LINE 00000731 "    if !defined $res2->{protocol}"
NSQ_SOURCE_LINE 00000732 "    &&  defined $res->{protocol};"
NSQ_SOURCE_LINE 00000733 "  return $res2;"
NSQ_SOURCE_LINE 00000734 "}"
NSQ_SOURCE_LINE 00000735 ""
NSQ_SOURCE_LINE 00000736 ""
NSQ_SOURCE_LINE 00000737 "sub prefer"
NSQ_SOURCE_LINE 00000738 "{"
NSQ_SOURCE_LINE 00000739 "  my($self, $res) = @_;"
NSQ_SOURCE_LINE 00000740 "  my $res2 = $self->_call_hook( prefer => $res );"
NSQ_SOURCE_LINE 00000741 "  $res2->{protocol} = $res->{protocol}"
NSQ_SOURCE_LINE 00000742 "    if !defined $res2->{protocol}"
NSQ_SOURCE_LINE 00000743 "    &&  defined $res->{protocol};"
NSQ_SOURCE_LINE 00000744 "  return $res2;"
NSQ_SOURCE_LINE 00000745 "}"
NSQ_SOURCE_LINE 00000746 ""
NSQ_SOURCE_LINE 00000747 ""
NSQ_SOURCE_LINE 00000748 "sub extract"
NSQ_SOURCE_LINE 00000749 "{"
NSQ_SOURCE_LINE 00000750 "  my($self, $archive) = @_;"
NSQ_SOURCE_LINE 00000751 ""
NSQ_SOURCE_LINE 00000752 "  $archive ||= $self->install_prop->{download};"
NSQ_SOURCE_LINE 00000753 ""
NSQ_SOURCE_LINE 00000754 "  unless(defined $archive)"
NSQ_SOURCE_LINE 00000755 "  {"
NSQ_SOURCE_LINE 00000756 "    die \"tried to call extract before download\";"
NSQ_SOURCE_LINE 00000757 "  }"
NSQ_SOURCE_LINE 00000758 ""
NSQ_SOURCE_LINE 00000759 "  {"
NSQ_SOURCE_LINE 00000760 "    my $checked_digest  = 0;"
NSQ_SOURCE_LINE 00000761 "    my $encrypted_fetch = 0;"
NSQ_SOURCE_LINE 00000762 "    my $detail = $self->install_prop->{download_detail}->{$archive};"
NSQ_SOURCE_LINE 00000763 "    if(defined $detail)"
NSQ_SOURCE_LINE 00000764 "    {"
NSQ_SOURCE_LINE 00000765 "      if(defined $detail->{digest})"
NSQ_SOURCE_LINE 00000766 "      {"
NSQ_SOURCE_LINE 00000767 "        my($algo, $expected) = @{ $detail->{digest} };"
NSQ_SOURCE_LINE 00000768 "        my $file = {"
NSQ_SOURCE_LINE 00000769 "          type     => 'file',"
NSQ_SOURCE_LINE 00000770 "          filename => Path::Tiny->new($archive)->basename,"
NSQ_SOURCE_LINE 00000771 "          path     => $archive,"
NSQ_SOURCE_LINE 00000772 "          tmp      => 0,"
NSQ_SOURCE_LINE 00000773 "        };"
NSQ_SOURCE_LINE 00000774 "        $checked_digest = $self->meta->call_hook( check_digest => $self, $file, $algo, $expected )"
NSQ_SOURCE_LINE 00000775 "      }"
NSQ_SOURCE_LINE 00000776 "      if(!defined $detail->{protocol})"
NSQ_SOURCE_LINE 00000777 "      {"
NSQ_SOURCE_LINE 00000778 "        $self->log(\"warning: extract did not receive protocol details for $archive\") unless $checked_digest;"
NSQ_SOURCE_LINE 00000779 "      }"
NSQ_SOURCE_LINE 00000780 "      elsif($detail->{protocol} !~ /^(https|file)$/)"
NSQ_SOURCE_LINE 00000781 "      {"
NSQ_SOURCE_LINE 00000782 "        $self->log(\"warning: extracting from a file that was fetched via insecure protocol @{[ $detail->{protocol} ]}\") unless $checked_digest ;"
NSQ_SOURCE_LINE 00000783 "      }"
NSQ_SOURCE_LINE 00000784 "      else"
NSQ_SOURCE_LINE 00000785 "      {"
NSQ_SOURCE_LINE 00000786 "        $encrypted_fetch = 1;"
NSQ_SOURCE_LINE 00000787 "      }"
NSQ_SOURCE_LINE 00000788 "    }"
NSQ_SOURCE_LINE 00000789 "    else"
NSQ_SOURCE_LINE 00000790 "    {"
NSQ_SOURCE_LINE 00000791 "      $self->log(\"warning: extract received no download details for $archive\");"
NSQ_SOURCE_LINE 00000792 "    }"
NSQ_SOURCE_LINE 00000793 ""
NSQ_SOURCE_LINE 00000794 "    if($self->download_rule eq 'digest')"
NSQ_SOURCE_LINE 00000795 "    {"
NSQ_SOURCE_LINE 00000796 "      die \"required digest missing for $archive\" unless $checked_digest;"
NSQ_SOURCE_LINE 00000797 "    }"
NSQ_SOURCE_LINE 00000798 "    elsif($self->download_rule eq 'encrypt')"
NSQ_SOURCE_LINE 00000799 "    {"
NSQ_SOURCE_LINE 00000800 "      die \"file was fetched insecurely for $archive\" unless $encrypted_fetch;"
NSQ_SOURCE_LINE 00000801 "    }"
NSQ_SOURCE_LINE 00000802 "    elsif($self->download_rule eq 'digest_or_encrypt')"
NSQ_SOURCE_LINE 00000803 "    {"
NSQ_SOURCE_LINE 00000804 "      die \"file was fetched insecurely and required digest missing for $archive\" unless $checked_digest || $encrypted_fetch;"
NSQ_SOURCE_LINE 00000805 "    }"
NSQ_SOURCE_LINE 00000806 "    elsif($self->download_rule eq 'digest_and_encrypt')"
NSQ_SOURCE_LINE 00000807 "    {"
NSQ_SOURCE_LINE 00000808 "      die \"file was fetched insecurely and required digest missing for $archive\" unless $checked_digest || $encrypted_fetch;"
NSQ_SOURCE_LINE 00000809 "      die \"required digest missing for $archive\" unless $checked_digest;"
NSQ_SOURCE_LINE 00000810 "      die \"file was fetched insecurely for $archive\" unless $encrypted_fetch;"
NSQ_SOURCE_LINE 00000811 "    }"
NSQ_SOURCE_LINE 00000812 "    elsif($self->download_rule eq 'warn')"
NSQ_SOURCE_LINE 00000813 "    {"
NSQ_SOURCE_LINE 00000814 "      unless($checked_digest || $encrypted_fetch)"
NSQ_SOURCE_LINE 00000815 "      {"
NSQ_SOURCE_LINE 00000816 "        $self->log(\"!!! NOTICE OF FUTURE CHANGE IN BEHAVIOR !!!\");"
NSQ_SOURCE_LINE 00000817 "        $self->log(\"a future version of Alien::Build will die here by default with this exception: file was fetched insecurely and required digest missing for $archive\");"
NSQ_SOURCE_LINE 00000818 "        $self->log(\"!!! NOTICE OF FUTURE CHANGE IN BEHAVIOR !!!\");"
NSQ_SOURCE_LINE 00000819 "      }"
NSQ_SOURCE_LINE 00000820 "    }"
NSQ_SOURCE_LINE 00000821 "    else"
NSQ_SOURCE_LINE 00000822 "    {"
NSQ_SOURCE_LINE 00000823 "      die \"internal error, unknown download rule: @{[ $self->download_rule ]}\";"
NSQ_SOURCE_LINE 00000824 "    }"
NSQ_SOURCE_LINE 00000825 ""
NSQ_SOURCE_LINE 00000826 "  }"
NSQ_SOURCE_LINE 00000827 ""
NSQ_SOURCE_LINE 00000828 "  my $nick_name = 'build';"
NSQ_SOURCE_LINE 00000829 ""
NSQ_SOURCE_LINE 00000830 "  if($self->meta_prop->{out_of_source})"
NSQ_SOURCE_LINE 00000831 "  {"
NSQ_SOURCE_LINE 00000832 "    $nick_name = 'extract';"
NSQ_SOURCE_LINE 00000833 "    my $extract = $self->install_prop->{extract};"
NSQ_SOURCE_LINE 00000834 "    return $extract if defined $extract && -d $extract;"
NSQ_SOURCE_LINE 00000835 "  }"
NSQ_SOURCE_LINE 00000836 ""
NSQ_SOURCE_LINE 00000837 "  my $tmp;"
NSQ_SOURCE_LINE 00000838 "  local $CWD;"
NSQ_SOURCE_LINE 00000839 "  my $ret;"
NSQ_SOURCE_LINE 00000840 ""
NSQ_SOURCE_LINE 00000841 "  $self->_call_hook({"
NSQ_SOURCE_LINE 00000842 ""
NSQ_SOURCE_LINE 00000843 "    before => sub {"
NSQ_SOURCE_LINE 00000844 "      # called build instead of extract, because this"
NSQ_SOURCE_LINE 00000845 "      # will be used for the build step, and technically"
NSQ_SOURCE_LINE 00000846 "      # extract is a substage of build anyway."
NSQ_SOURCE_LINE 00000847 "      $tmp = Alien::Build::TempDir->new($self, $nick_name);"
NSQ_SOURCE_LINE 00000848 "      $CWD = \"$tmp\";"
NSQ_SOURCE_LINE 00000849 "    },"
NSQ_SOURCE_LINE 00000850 "    verify => sub {"
NSQ_SOURCE_LINE 00000851 ""
NSQ_SOURCE_LINE 00000852 "      my $path = '.';"
NSQ_SOURCE_LINE 00000853 "      if($self->meta_prop->{out_of_source} && $self->install_prop->{extract})"
NSQ_SOURCE_LINE 00000854 "      {"
NSQ_SOURCE_LINE 00000855 "        $path = $self->install_prop->{extract};"
NSQ_SOURCE_LINE 00000856 "      }"
NSQ_SOURCE_LINE 00000857 ""
NSQ_SOURCE_LINE 00000858 "      my @list = grep { $_->basename !~ /^\\./ && $_->basename ne 'pax_global_header' } _path($path)->children;"
NSQ_SOURCE_LINE 00000859 ""
NSQ_SOURCE_LINE 00000860 "      my $count = scalar @list;"
NSQ_SOURCE_LINE 00000861 ""
NSQ_SOURCE_LINE 00000862 "      if($count == 0)"
NSQ_SOURCE_LINE 00000863 "      {"
NSQ_SOURCE_LINE 00000864 "        die \"no files extracted\";"
NSQ_SOURCE_LINE 00000865 "      }"
NSQ_SOURCE_LINE 00000866 "      elsif($count == 1 && -d $list[0])"
NSQ_SOURCE_LINE 00000867 "      {"
NSQ_SOURCE_LINE 00000868 "        $ret = $list[0]->absolute->stringify;"
NSQ_SOURCE_LINE 00000869 "      }"
NSQ_SOURCE_LINE 00000870 "      else"
NSQ_SOURCE_LINE 00000871 "      {"
NSQ_SOURCE_LINE 00000872 "        $ret = \"$tmp\";"
NSQ_SOURCE_LINE 00000873 "      }"
NSQ_SOURCE_LINE 00000874 ""
NSQ_SOURCE_LINE 00000875 "    },"
NSQ_SOURCE_LINE 00000876 "    after => sub {"
NSQ_SOURCE_LINE 00000877 "      $CWD = $self->root;"
NSQ_SOURCE_LINE 00000878 "    },"
NSQ_SOURCE_LINE 00000879 ""
NSQ_SOURCE_LINE 00000880 "  }, 'extract', $archive);"
NSQ_SOURCE_LINE 00000881 ""
NSQ_SOURCE_LINE 00000882 "  $self->install_prop->{extract} ||= $ret;"
NSQ_SOURCE_LINE 00000883 "  $ret ? $ret : ();"
NSQ_SOURCE_LINE 00000884 "}"
NSQ_SOURCE_LINE 00000885 ""
NSQ_SOURCE_LINE 00000886 ""
NSQ_SOURCE_LINE 00000887 "sub build"
NSQ_SOURCE_LINE 00000888 "{"
NSQ_SOURCE_LINE 00000889 "  my($self) = @_;"
NSQ_SOURCE_LINE 00000890 ""
NSQ_SOURCE_LINE 00000891 "  # save the evironment, in case some plugins decide"
NSQ_SOURCE_LINE 00000892 "  # to alter it.  Or us!  See just a few lines below."
NSQ_SOURCE_LINE 00000893 "  local %ENV = %ENV;"
NSQ_SOURCE_LINE 00000894 ""
NSQ_SOURCE_LINE 00000895 "  my $stage = _path($self->install_prop->{stage});"
NSQ_SOURCE_LINE 00000896 "  $stage->mkpath;"
NSQ_SOURCE_LINE 00000897 ""
NSQ_SOURCE_LINE 00000898 "  my $tmp;"
NSQ_SOURCE_LINE 00000899 ""
NSQ_SOURCE_LINE 00000900 "  if($self->install_type eq 'share')"
NSQ_SOURCE_LINE 00000901 "  {"
NSQ_SOURCE_LINE 00000902 "    foreach my $suffix ('', '_ffi')"
NSQ_SOURCE_LINE 00000903 "    {"
NSQ_SOURCE_LINE 00000904 "      local $CWD;"
NSQ_SOURCE_LINE 00000905 "      delete $ENV{DESTDIR} unless $self->meta_prop->{destdir};"
NSQ_SOURCE_LINE 00000906 ""
NSQ_SOURCE_LINE 00000907 "      my %env_meta = %{ $self->meta_prop   ->{env} || {} };"
NSQ_SOURCE_LINE 00000908 "      my %env_inst = %{ $self->install_prop->{env} || {} };"
NSQ_SOURCE_LINE 00000909 ""
NSQ_SOURCE_LINE 00000910 "      if($self->meta_prop->{env_interpolate})"
NSQ_SOURCE_LINE 00000911 "      {"
NSQ_SOURCE_LINE 00000912 "        foreach my $key (keys %env_meta)"
NSQ_SOURCE_LINE 00000913 "        {"
NSQ_SOURCE_LINE 00000914 "          $env_meta{$key} = $self->meta->interpolator->interpolate($env_meta{$key}, $self);"
NSQ_SOURCE_LINE 00000915 "        }"
NSQ_SOURCE_LINE 00000916 "      }"
NSQ_SOURCE_LINE 00000917 ""
NSQ_SOURCE_LINE 00000918 "      %ENV = (%ENV, %env_meta);"
NSQ_SOURCE_LINE 00000919 "      %ENV = (%ENV, %env_inst);"
NSQ_SOURCE_LINE 00000920 ""
NSQ_SOURCE_LINE 00000921 "      my $destdir;"
NSQ_SOURCE_LINE 00000922 ""
NSQ_SOURCE_LINE 00000923 "      $self->_call_hook("
NSQ_SOURCE_LINE 00000924 "      {"
NSQ_SOURCE_LINE 00000925 "        before => sub {"
NSQ_SOURCE_LINE 00000926 "          if($self->meta_prop->{out_of_source})"
NSQ_SOURCE_LINE 00000927 "          {"
NSQ_SOURCE_LINE 00000928 "            $self->extract;"
NSQ_SOURCE_LINE 00000929 "            $CWD = $tmp = Alien::Build::TempDir->new($self, 'build');"
NSQ_SOURCE_LINE 00000930 "          }"
NSQ_SOURCE_LINE 00000931 "          else"
NSQ_SOURCE_LINE 00000932 "          {"
NSQ_SOURCE_LINE 00000933 "            $CWD = $tmp = $self->extract;"
NSQ_SOURCE_LINE 00000934 "          }"
NSQ_SOURCE_LINE 00000935 "          if($self->meta_prop->{destdir})"
NSQ_SOURCE_LINE 00000936 "          {"
NSQ_SOURCE_LINE 00000937 "            $destdir = Alien::Build::TempDir->new($self, 'destdir');"
NSQ_SOURCE_LINE 00000938 "            $ENV{DESTDIR} = \"$destdir\";"
NSQ_SOURCE_LINE 00000939 "          }"
NSQ_SOURCE_LINE 00000940 "          $self->_call_hook({ all => 1 }, \"patch${suffix}\");"
NSQ_SOURCE_LINE 00000941 "        },"
NSQ_SOURCE_LINE 00000942 "        after => sub {"
NSQ_SOURCE_LINE 00000943 "          $destdir = \"$destdir\" if $destdir;"
NSQ_SOURCE_LINE 00000944 "        },"
NSQ_SOURCE_LINE 00000945 "      }, \"build${suffix}\");"
NSQ_SOURCE_LINE 00000946 ""
NSQ_SOURCE_LINE 00000947 "      $self->install_prop->{\"_ab_build@{[ $suffix || '_share' ]}\"} = \"$CWD\";"
NSQ_SOURCE_LINE 00000948 ""
NSQ_SOURCE_LINE 00000949 "      $self->_call_hook(\"gather@{[ $suffix || '_share' ]}\");"
NSQ_SOURCE_LINE 00000950 "    }"
NSQ_SOURCE_LINE 00000951 "  }"
NSQ_SOURCE_LINE 00000952 ""
NSQ_SOURCE_LINE 00000953 "  elsif($self->install_type eq 'system')"
NSQ_SOURCE_LINE 00000954 "  {"
NSQ_SOURCE_LINE 00000955 "    local $CWD = $self->root;"
NSQ_SOURCE_LINE 00000956 "    my $dir;"
NSQ_SOURCE_LINE 00000957 ""
NSQ_SOURCE_LINE 00000958 "    $self->_call_hook("
NSQ_SOURCE_LINE 00000959 "      {"
NSQ_SOURCE_LINE 00000960 "        before => sub {"
NSQ_SOURCE_LINE 00000961 "          $dir = Alien::Build::TempDir->new($self, \"gather\");"
NSQ_SOURCE_LINE 00000962 "          $CWD = \"$dir\";"
NSQ_SOURCE_LINE 00000963 "        },"
NSQ_SOURCE_LINE 00000964 "        after  => sub {"
NSQ_SOURCE_LINE 00000965 "          $CWD = $self->root;"
NSQ_SOURCE_LINE 00000966 "        },"
NSQ_SOURCE_LINE 00000967 "      },"
NSQ_SOURCE_LINE 00000968 "      'gather_system',"
NSQ_SOURCE_LINE 00000969 "    );"
NSQ_SOURCE_LINE 00000970 ""
NSQ_SOURCE_LINE 00000971 "    $self->install_prop->{finished} = 1;"
NSQ_SOURCE_LINE 00000972 "    $self->install_prop->{complete}->{gather_system} = 1;"
NSQ_SOURCE_LINE 00000973 "  }"
NSQ_SOURCE_LINE 00000974 ""
NSQ_SOURCE_LINE 00000975 "  $self;"
NSQ_SOURCE_LINE 00000976 "}"
NSQ_SOURCE_LINE 00000977 ""
NSQ_SOURCE_LINE 00000978 ""
NSQ_SOURCE_LINE 00000979 "sub test"
NSQ_SOURCE_LINE 00000980 "{"
NSQ_SOURCE_LINE 00000981 "  my($self) = @_;"
NSQ_SOURCE_LINE 00000982 ""
NSQ_SOURCE_LINE 00000983 "  if($self->install_type eq 'share')"
