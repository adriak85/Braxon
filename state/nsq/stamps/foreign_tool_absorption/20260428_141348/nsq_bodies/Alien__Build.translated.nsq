NSQ_SOURCE_LINE 00001035 ""
NSQ_SOURCE_LINE 00001036 ""
NSQ_SOURCE_LINE 00001037 "sub log"
NSQ_SOURCE_LINE 00001038 "{"
NSQ_SOURCE_LINE 00001039 "  my(undef, $message) = @_;"
NSQ_SOURCE_LINE 00001040 "  my $caller = [caller];"
NSQ_SOURCE_LINE 00001041 "  chomp $message;"
NSQ_SOURCE_LINE 00001042 "  foreach my $line (split /\\n/, $message)"
NSQ_SOURCE_LINE 00001043 "  {"
NSQ_SOURCE_LINE 00001044 "    Alien::Build::Log->default->log("
NSQ_SOURCE_LINE 00001045 "      caller  => $caller,"
NSQ_SOURCE_LINE 00001046 "      message => $line,"
NSQ_SOURCE_LINE 00001047 "    );"
NSQ_SOURCE_LINE 00001048 "  }"
NSQ_SOURCE_LINE 00001049 "}"
NSQ_SOURCE_LINE 00001050 ""
NSQ_SOURCE_LINE 00001051 ""
NSQ_SOURCE_LINE 00001052 "{"
NSQ_SOURCE_LINE 00001053 "  my %meta;"
NSQ_SOURCE_LINE 00001054 ""
NSQ_SOURCE_LINE 00001055 "  sub meta"
NSQ_SOURCE_LINE 00001056 "  {"
NSQ_SOURCE_LINE 00001057 "    my($class) = @_;"
NSQ_SOURCE_LINE 00001058 "    $class = ref $class if ref $class;"
NSQ_SOURCE_LINE 00001059 "    $meta{$class} ||= Alien::Build::Meta->new( class => $class );"
NSQ_SOURCE_LINE 00001060 "  }"
