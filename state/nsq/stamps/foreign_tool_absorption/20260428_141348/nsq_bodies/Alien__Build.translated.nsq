NSQ_SOURCE_LINE 00001018 ""
NSQ_SOURCE_LINE 00001019 "sub system"
NSQ_SOURCE_LINE 00001020 "{"
NSQ_SOURCE_LINE 00001021 "  my($self, $command, @args) = @_;"
NSQ_SOURCE_LINE 00001022 ""
NSQ_SOURCE_LINE 00001023 "  my $prop = $self->_command_prop;"
NSQ_SOURCE_LINE 00001024 ""
NSQ_SOURCE_LINE 00001025 "  ($command, @args) = map {"
NSQ_SOURCE_LINE 00001026 "    $self->meta->interpolator->interpolate($_, $prop)"
NSQ_SOURCE_LINE 00001027 "  } ($command, @args);"
NSQ_SOURCE_LINE 00001028 ""
NSQ_SOURCE_LINE 00001029 "  $self->log(\"+ $command @args\");"
NSQ_SOURCE_LINE 00001030 ""
NSQ_SOURCE_LINE 00001031 "  scalar @args"
NSQ_SOURCE_LINE 00001032 "    ? system $command, @args"
NSQ_SOURCE_LINE 00001033 "    : system $command;"
