NSQ_SOURCE_LINE 00000021 "sub new"
NSQ_SOURCE_LINE 00000022 "{"
NSQ_SOURCE_LINE 00000023 "  my($class, %args) = @_;"
NSQ_SOURCE_LINE 00000024 "  my $self = bless {"
NSQ_SOURCE_LINE 00000025 "    install_prop => {"
NSQ_SOURCE_LINE 00000026 "      root  => _path($args{root} || \"_alien\")->absolute->stringify,"
NSQ_SOURCE_LINE 00000027 "      patch => (defined $args{patch}) ? _path($args{patch})->absolute->stringify : undef,"
NSQ_SOURCE_LINE 00000028 "    },"
NSQ_SOURCE_LINE 00000029 "    runtime_prop => {"
NSQ_SOURCE_LINE 00000030 "      alien_build_version => $Alien::Build::VERSION || 'dev',"
NSQ_SOURCE_LINE 00000031 "    },"
