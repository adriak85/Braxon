NSQ_SOURCE_LINE 00001062 ""
NSQ_SOURCE_LINE 00001063 "package Alien::Build::Meta;"
NSQ_SOURCE_LINE 00001064 ""
NSQ_SOURCE_LINE 00001065 "our @CARP_NOT = qw( alienfile );"
NSQ_SOURCE_LINE 00001066 ""
NSQ_SOURCE_LINE 00001067 "sub new"
NSQ_SOURCE_LINE 00001068 "{"
NSQ_SOURCE_LINE 00001069 "  my($class, %args) = @_;"
