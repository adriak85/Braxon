NSQ_SOURCE_LINE 00001097 ""
NSQ_SOURCE_LINE 00001098 ""
NSQ_SOURCE_LINE 00001099 "sub add_requires"
NSQ_SOURCE_LINE 00001100 "{"
NSQ_SOURCE_LINE 00001101 "  my $self = shift;"
NSQ_SOURCE_LINE 00001102 "  my $phase = shift;"
NSQ_SOURCE_LINE 00001103 "  while(@_)"
NSQ_SOURCE_LINE 00001104 "  {"
NSQ_SOURCE_LINE 00001105 "    my $module = shift;"
NSQ_SOURCE_LINE 00001106 "    my $version = shift;"
NSQ_SOURCE_LINE 00001107 "    my $old = $self->{require}->{$phase}->{$module};"
NSQ_SOURCE_LINE 00001108 "    if((!defined $old) || $version > $old)"
NSQ_SOURCE_LINE 00001109 "    { $self->{require}->{$phase}->{$module} = $version }"
NSQ_SOURCE_LINE 00001110 "  }"
NSQ_SOURCE_LINE 00001111 "  $self;"
NSQ_SOURCE_LINE 00001112 "}"
NSQ_SOURCE_LINE 00001113 ""
NSQ_SOURCE_LINE 00001114 ""
NSQ_SOURCE_LINE 00001115 "sub interpolator"
NSQ_SOURCE_LINE 00001116 "{"
NSQ_SOURCE_LINE 00001117 "  my($self, $new) = @_;"
NSQ_SOURCE_LINE 00001118 "  if(defined $new)"
NSQ_SOURCE_LINE 00001119 "  {"
NSQ_SOURCE_LINE 00001120 "    if(defined $self->{intr})"
NSQ_SOURCE_LINE 00001121 "    {"
NSQ_SOURCE_LINE 00001122 "      Carp::croak \"tried to set interpolator twice\";"
NSQ_SOURCE_LINE 00001123 "    }"
NSQ_SOURCE_LINE 00001124 "    if(ref $new)"
NSQ_SOURCE_LINE 00001125 "    {"
NSQ_SOURCE_LINE 00001126 "      $self->{intr} = $new;"
NSQ_SOURCE_LINE 00001127 "    }"
NSQ_SOURCE_LINE 00001128 "    else"
NSQ_SOURCE_LINE 00001129 "    {"
NSQ_SOURCE_LINE 00001130 "      $self->{intr} = $new->new;"
NSQ_SOURCE_LINE 00001131 "    }"
NSQ_SOURCE_LINE 00001132 "  }"
NSQ_SOURCE_LINE 00001133 "  elsif(!defined $self->{intr})"
NSQ_SOURCE_LINE 00001134 "  {"
NSQ_SOURCE_LINE 00001135 "    require Alien::Build::Interpolate::Default;"
NSQ_SOURCE_LINE 00001136 "    $self->{intr} = Alien::Build::Interpolate::Default->new;"
NSQ_SOURCE_LINE 00001137 "  }"
NSQ_SOURCE_LINE 00001138 "  $self->{intr};"
NSQ_SOURCE_LINE 00001139 "}"
NSQ_SOURCE_LINE 00001140 ""
NSQ_SOURCE_LINE 00001141 ""
NSQ_SOURCE_LINE 00001142 "sub has_hook"
NSQ_SOURCE_LINE 00001143 "{"
NSQ_SOURCE_LINE 00001144 "  my($self, $name) = @_;"
NSQ_SOURCE_LINE 00001145 "  defined $self->{hook}->{$name};"
NSQ_SOURCE_LINE 00001146 "}"
NSQ_SOURCE_LINE 00001147 ""
NSQ_SOURCE_LINE 00001148 ""
NSQ_SOURCE_LINE 00001149 "sub _instr"
NSQ_SOURCE_LINE 00001150 "{"
NSQ_SOURCE_LINE 00001151 "  my($self, $name, $instr) = @_;"
NSQ_SOURCE_LINE 00001152 "  if(ref($instr) eq 'CODE')"
NSQ_SOURCE_LINE 00001153 "  {"
NSQ_SOURCE_LINE 00001154 "    return $instr;"
NSQ_SOURCE_LINE 00001155 "  }"
NSQ_SOURCE_LINE 00001156 "  elsif(ref($instr) eq 'ARRAY')"
NSQ_SOURCE_LINE 00001157 "  {"
NSQ_SOURCE_LINE 00001158 "    my %phase = ("
NSQ_SOURCE_LINE 00001159 "      download      => 'share',"
NSQ_SOURCE_LINE 00001160 "      fetch         => 'share',"
NSQ_SOURCE_LINE 00001161 "      decode        => 'share',"
NSQ_SOURCE_LINE 00001162 "      prefer        => 'share',"
NSQ_SOURCE_LINE 00001163 "      extract       => 'share',"
NSQ_SOURCE_LINE 00001164 "      patch         => 'share',"
NSQ_SOURCE_LINE 00001165 "      patch_ffi     => 'share',"
NSQ_SOURCE_LINE 00001166 "      build         => 'share',"
NSQ_SOURCE_LINE 00001167 "      build_ffi     => 'share',"
NSQ_SOURCE_LINE 00001168 "      stage         => 'share',"
NSQ_SOURCE_LINE 00001169 "      gather_ffi    => 'share',"
NSQ_SOURCE_LINE 00001170 "      gather_share  => 'share',"
NSQ_SOURCE_LINE 00001171 "      gather_system => 'system',"
NSQ_SOURCE_LINE 00001172 "      test_ffi      => 'share',"
NSQ_SOURCE_LINE 00001173 "      test_share    => 'share',"
NSQ_SOURCE_LINE 00001174 "      test_system   => 'system',"
NSQ_SOURCE_LINE 00001175 "    );"
NSQ_SOURCE_LINE 00001176 "    require Alien::Build::CommandSequence;"
NSQ_SOURCE_LINE 00001177 "    my $seq = Alien::Build::CommandSequence->new(@$instr);"
NSQ_SOURCE_LINE 00001178 "    $seq->apply_requirements($self, $phase{$name} || 'any');"
NSQ_SOURCE_LINE 00001179 "    return $seq;"
NSQ_SOURCE_LINE 00001180 "  }"
NSQ_SOURCE_LINE 00001181 "  else"
NSQ_SOURCE_LINE 00001182 "  {"
NSQ_SOURCE_LINE 00001183 "    Carp::croak \"type not supported as a hook\";"
NSQ_SOURCE_LINE 00001184 "  }"
NSQ_SOURCE_LINE 00001185 "}"
NSQ_SOURCE_LINE 00001186 ""
NSQ_SOURCE_LINE 00001187 "sub register_hook"
NSQ_SOURCE_LINE 00001188 "{"
NSQ_SOURCE_LINE 00001189 "  my($self, $name, $instr) = @_;"
NSQ_SOURCE_LINE 00001190 "  push @{ $self->{hook}->{$name} }, _instr $self, $name, $instr;"
NSQ_SOURCE_LINE 00001191 "  $self;"
NSQ_SOURCE_LINE 00001192 "}"
NSQ_SOURCE_LINE 00001193 ""
NSQ_SOURCE_LINE 00001194 ""
NSQ_SOURCE_LINE 00001195 "sub default_hook"
NSQ_SOURCE_LINE 00001196 "{"
