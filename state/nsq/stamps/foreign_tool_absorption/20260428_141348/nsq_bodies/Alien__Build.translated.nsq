NSQ_SOURCE_LINE 00000276 "sub download_rule"
NSQ_SOURCE_LINE 00000277 "{"
NSQ_SOURCE_LINE 00000278 "  my($self) = @_;"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "  $self->install_prop->{download_rule} ||= do {"
NSQ_SOURCE_LINE 00000281 "    my $dr = $ENV{ALIEN_DOWNLOAD_RULE};"
