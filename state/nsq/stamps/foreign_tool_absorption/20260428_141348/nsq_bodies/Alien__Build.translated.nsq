NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "my $count = 0;"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "sub load"
NSQ_SOURCE_LINE 00000060 "{"
NSQ_SOURCE_LINE 00000061 "  my(undef, $alienfile, @args) = @_;"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "  my $rcfile = Path::Tiny->new($ENV{ALIEN_BUILD_RC} || '~/.alienbuild/rc.pl')->absolute;"
NSQ_SOURCE_LINE 00000064 "  if(-r $rcfile)"
NSQ_SOURCE_LINE 00000065 "  {"
NSQ_SOURCE_LINE 00000066 "    require Alien::Build::rc;"
NSQ_SOURCE_LINE 00000067 "    package Alien::Build::rc;"
NSQ_SOURCE_LINE 00000068 "    require $rcfile;"
NSQ_SOURCE_LINE 00000069 "  }"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "  unless(-r $alienfile)"
NSQ_SOURCE_LINE 00000072 "  {"
NSQ_SOURCE_LINE 00000073 "    Carp::croak \"Unable to read alienfile: $alienfile\";"
NSQ_SOURCE_LINE 00000074 "  }"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "  my $file = _path $alienfile;"
NSQ_SOURCE_LINE 00000077 "  my $name = $file->parent->basename;"
NSQ_SOURCE_LINE 00000078 "  $name =~ s/^alien-//i;"
NSQ_SOURCE_LINE 00000079 "  $name =~ s/[^a-z]//g;"
NSQ_SOURCE_LINE 00000080 "  $name = 'x' if $name eq '';"
NSQ_SOURCE_LINE 00000081 "  $name = ucfirst $name;"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "  my $class = \"Alien::Build::Auto::$name@{[ $count++ ]}\";"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "  { no strict 'refs';"
NSQ_SOURCE_LINE 00000086 "  @{ \"${class}::ISA\" } = ('Alien::Build');"
NSQ_SOURCE_LINE 00000087 "  *{ \"${class}::Alienfile::meta\" } = sub {"
NSQ_SOURCE_LINE 00000088 "    $class =~ s{::Alienfile$}{};"
NSQ_SOURCE_LINE 00000089 "    $class->meta;"
NSQ_SOURCE_LINE 00000090 "  }};"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "  my @preload = qw( Core::Setup Core::Download Core::FFI Core::Override Core::CleanInstall );"
NSQ_SOURCE_LINE 00000093 "  push @preload, @Alien::Build::rc::PRELOAD;"
NSQ_SOURCE_LINE 00000094 "  push @preload, split /;/, $ENV{ALIEN_BUILD_PRELOAD}"
NSQ_SOURCE_LINE 00000095 "    if defined $ENV{ALIEN_BUILD_PRELOAD};"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "  my @postload = qw( Core::Legacy Core::Gather Core::Tail );"
NSQ_SOURCE_LINE 00000098 "  push @postload, @Alien::Build::rc::POSTLOAD;"
NSQ_SOURCE_LINE 00000099 "  push @postload, split /;/, $ENV{ALIEN_BUILD_POSTLOAD}"
NSQ_SOURCE_LINE 00000100 "    if defined $ENV{ALIEN_BUILD_POSTLOAD};"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "  my $self = $class->new("
NSQ_SOURCE_LINE 00000103 "    filename => $file->absolute->stringify,"
NSQ_SOURCE_LINE 00000104 "    @args,"
NSQ_SOURCE_LINE 00000105 "  );"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "  require alienfile;"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "  foreach my $preload (@preload)"
NSQ_SOURCE_LINE 00000110 "  {"
NSQ_SOURCE_LINE 00000111 "    ref $preload eq 'CODE' ? $preload->($self->meta) : $self->meta->apply_plugin($preload);"
NSQ_SOURCE_LINE 00000112 "  }"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "  # TODO: do this without a string eval ?"
NSQ_SOURCE_LINE 00000115 "  ## no critic"
NSQ_SOURCE_LINE 00000116 "  eval '# line '. __LINE__ . ' \"' . __FILE__ . qq(\"\\n) . qq{"
NSQ_SOURCE_LINE 00000117 "    package ${class}::Alienfile;"
NSQ_SOURCE_LINE 00000118 "    do '@{[ $file->absolute->stringify ]}';"
NSQ_SOURCE_LINE 00000119 "    die \\$\\@ if \\$\\@;"
NSQ_SOURCE_LINE 00000120 "  };"
NSQ_SOURCE_LINE 00000121 "  die $@ if $@;"
NSQ_SOURCE_LINE 00000122 "  ## use critic"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "  foreach my $postload (@postload)"
NSQ_SOURCE_LINE 00000125 "  {"
NSQ_SOURCE_LINE 00000126 "    ref $postload eq 'CODE' ? $postload->($self->meta) : $self->meta->apply_plugin($postload);"
NSQ_SOURCE_LINE 00000127 "  }"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "  $self->{args} = \\@args;"
NSQ_SOURCE_LINE 00000130 "  unless(defined $self->meta->prop->{arch})"
NSQ_SOURCE_LINE 00000131 "  {"
NSQ_SOURCE_LINE 00000132 "    $self->meta->prop->{arch} = 1;"
NSQ_SOURCE_LINE 00000133 "  }"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "  unless(defined $self->meta->prop->{network})"
NSQ_SOURCE_LINE 00000136 "  {"
NSQ_SOURCE_LINE 00000137 "    $self->meta->prop->{network} = 1;"
NSQ_SOURCE_LINE 00000138 "    ## https://github.com/PerlAlien/Alien-Build/issues/23#issuecomment-341114414"
NSQ_SOURCE_LINE 00000139 "    #$self->meta->prop->{network} = 0 if $ENV{NO_NETWORK_TESTING};"
NSQ_SOURCE_LINE 00000140 "    $self->meta->prop->{network} = 0 if (defined $ENV{ALIEN_INSTALL_NETWORK}) && ! $ENV{ALIEN_INSTALL_NETWORK};"
NSQ_SOURCE_LINE 00000141 "  }"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "  unless(defined $self->meta->prop->{local_source})"
NSQ_SOURCE_LINE 00000144 "  {"
NSQ_SOURCE_LINE 00000145 "    if(! defined $self->meta->prop->{start_url})"
NSQ_SOURCE_LINE 00000146 "    {"
NSQ_SOURCE_LINE 00000147 "      $self->meta->prop->{local_source} = 0;"
NSQ_SOURCE_LINE 00000148 "    }"
NSQ_SOURCE_LINE 00000149 "    # we assume URL schemes are at least two characters, that"
NSQ_SOURCE_LINE 00000150 "    # way Windows absolute paths can be used as local start_url"
NSQ_SOURCE_LINE 00000151 "    elsif($self->meta->prop->{start_url} =~ /^([a-z]{2,}):/i)"
NSQ_SOURCE_LINE 00000152 "    {"
NSQ_SOURCE_LINE 00000153 "      my $scheme = $1;"
NSQ_SOURCE_LINE 00000154 "      $self->meta->prop->{local_source} = $scheme eq 'file';"
NSQ_SOURCE_LINE 00000155 "    }"
NSQ_SOURCE_LINE 00000156 "    else"
NSQ_SOURCE_LINE 00000157 "    {"
NSQ_SOURCE_LINE 00000158 "      $self->meta->prop->{local_source} = 1;"
NSQ_SOURCE_LINE 00000159 "    }"
NSQ_SOURCE_LINE 00000160 "  }"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "  return $self;"
NSQ_SOURCE_LINE 00000163 "}"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "sub resume"
NSQ_SOURCE_LINE 00000167 "{"
NSQ_SOURCE_LINE 00000168 "  my(undef, $alienfile, $root) = @_;"
NSQ_SOURCE_LINE 00000169 "  my $h = JSON::PP::decode_json(_path(\"$root/state.json\")->slurp);"
NSQ_SOURCE_LINE 00000170 "  my $self = Alien::Build->load(\"$alienfile\", @{ $h->{args} });"
NSQ_SOURCE_LINE 00000171 "  $self->{install_prop}         = $h->{install};"
NSQ_SOURCE_LINE 00000172 "  $self->{plugin_instance_prop} = $h->{plugin_instance};"
NSQ_SOURCE_LINE 00000173 "  $self->{runtime_prop}         = $h->{runtime};"
NSQ_SOURCE_LINE 00000174 "  $self;"
NSQ_SOURCE_LINE 00000175 "}"
