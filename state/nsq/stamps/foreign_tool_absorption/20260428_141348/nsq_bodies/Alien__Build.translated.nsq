NSQ_SOURCE_LINE 00000033 "    bin_dir => [],"
NSQ_SOURCE_LINE 00000034 "    pkg_config_path => [],"
NSQ_SOURCE_LINE 00000035 "    aclocal_path => [],"
NSQ_SOURCE_LINE 00000036 "  }, $class;"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "  # force computing this as soon as possible"
NSQ_SOURCE_LINE 00000039 "  $self->download_rule;"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "  $self->meta->filename("
NSQ_SOURCE_LINE 00000042 "    $args{filename} || do {"
NSQ_SOURCE_LINE 00000043 "      my(undef, $filename) = caller;"
NSQ_SOURCE_LINE 00000044 "      _path($filename)->absolute->stringify;"
NSQ_SOURCE_LINE 00000045 "    }"
NSQ_SOURCE_LINE 00000046 "  );"
NSQ_SOURCE_LINE 00000047 ""
