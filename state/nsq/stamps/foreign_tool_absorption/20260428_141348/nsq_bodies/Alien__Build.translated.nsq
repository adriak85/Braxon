NSQ_SOURCE_LINE 00000990 "        Carp::croak(\"no build directory to run tests\") unless $dir && -d $dir;"
NSQ_SOURCE_LINE 00000991 "        local $CWD = $dir;"
NSQ_SOURCE_LINE 00000992 "        $self->_call_hook(\"test$suffix\");"
NSQ_SOURCE_LINE 00000993 "      }"
