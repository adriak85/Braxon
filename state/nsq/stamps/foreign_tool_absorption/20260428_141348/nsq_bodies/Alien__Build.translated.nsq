NSQ_SOURCE_LINE 00001002 "      $self->_call_hook(\"test_system\");"
NSQ_SOURCE_LINE 00001003 "    }"
NSQ_SOURCE_LINE 00001004 "  }"
NSQ_SOURCE_LINE 00001005 ""
NSQ_SOURCE_LINE 00001006 "}"
NSQ_SOURCE_LINE 00001007 ""
NSQ_SOURCE_LINE 00001008 ""
