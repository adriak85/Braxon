NSQ_SOURCE_LINE 00000049 "  {"
NSQ_SOURCE_LINE 00000050 "    $self->meta->prop->{$_} = $args{meta_prop}->{$_} for keys %{ $args{meta_prop} };"
NSQ_SOURCE_LINE 00000051 "  }"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "  $self;"
NSQ_SOURCE_LINE 00000054 "}"
