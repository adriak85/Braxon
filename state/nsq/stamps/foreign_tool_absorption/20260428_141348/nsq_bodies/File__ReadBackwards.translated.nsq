BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "# File::ReadBackwards.pm"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "# Copyright (C) 2000-2021 by Uri Guttman. All rights reserved."
NSQ_SOURCE_LINE 00000004 "# mail bugs, comments and feedback to uri@stemsystems.com"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "package File::ReadBackwards ;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use strict ;"
NSQ_SOURCE_LINE 00000009 "use Symbol ;"
NSQ_SOURCE_LINE 00000010 "use Fcntl qw( :seek O_RDONLY ) ;"
NSQ_SOURCE_LINE 00000011 "use Carp ;"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "our $VERSION = '1.06' ;"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "my $max_read_size = 1 << 13 ;"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "my $default_rec_sep ;"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "BEGIN {"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "# set the default record separator according to this OS"
NSQ_SOURCE_LINE 00000022 "# this needs testing and expansion."
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "# look for CR/LF types"
NSQ_SOURCE_LINE 00000025 "# then look for CR types"
NSQ_SOURCE_LINE 00000026 "# else it's a LF type"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "\tif ( $^O =~ /win32/i || $^O =~ /vms/i ) {"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "\t\t$default_rec_sep = \"\\015\\012\" ;"
NSQ_SOURCE_LINE 00000031 "\t}"
NSQ_SOURCE_LINE 00000032 "\telsif ( $^O =~ /mac/i ) {"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "\t\t$default_rec_sep = \"\\015\" ;"
NSQ_SOURCE_LINE 00000035 "\t}"
NSQ_SOURCE_LINE 00000036 "\telse {"
NSQ_SOURCE_LINE 00000037 "\t\t$default_rec_sep = \"\\012\" ;"
NSQ_SOURCE_LINE 00000038 "\t}"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "# the tied interface is exactly the same as the object one, so all we"
NSQ_SOURCE_LINE 00000041 "# need to do is to alias the subs with typeglobs"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "\t*TIEHANDLE = \\&new ;"
NSQ_SOURCE_LINE 00000044 "\t*READLINE = \\&readline ;"
NSQ_SOURCE_LINE 00000045 " \t*EOF = \\&eof ;"
NSQ_SOURCE_LINE 00000046 " \t*CLOSE = \\&close ;"
NSQ_SOURCE_LINE 00000047 " \t*TELL = \\&tell ;"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "# added getline alias for compatibility with IO::Handle"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "\t*getline = \\&readline ;"
NSQ_SOURCE_LINE 00000052 "}"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "# constructor for File::ReadBackwards"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "sub new {"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "\tmy( $class, $filename, $rec_sep, $sep_is_regex ) = @_ ;"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "# check that we have a filename"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "\tdefined( $filename ) || return ;"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "# see if this file uses the default of a cr/lf separator"
NSQ_SOURCE_LINE 00000066 "# those files will get cr/lf converted to \\n"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "\t$rec_sep ||= $default_rec_sep ;"
NSQ_SOURCE_LINE 00000069 "\tmy $is_crlf = $rec_sep eq \"\\015\\012\" ;"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "# get a handle and open the file"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "\tmy $handle = gensym ;"
NSQ_SOURCE_LINE 00000074 "\tsysopen( $handle, $filename, O_RDONLY ) || return ;"
NSQ_SOURCE_LINE 00000075 "\tbinmode $handle ;"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "# seek to the end of the file and get its size"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "\tmy $seek_pos = sysseek( $handle, 0, SEEK_END ) or return ;"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "# get the size of the first block to read,"
NSQ_SOURCE_LINE 00000082 "# either a trailing partial one (the % size) or full sized one (max read size)"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "\tmy $read_size = $seek_pos % $max_read_size || $max_read_size ;"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "# create the object"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "\tmy $self = bless {"
NSQ_SOURCE_LINE 00000089 "\t\t\t'file_name'\t=> $filename,"
NSQ_SOURCE_LINE 00000090 "\t\t\t'handle'\t=> $handle,"
NSQ_SOURCE_LINE 00000091 "\t\t\t'read_size'\t=> $read_size,"
NSQ_SOURCE_LINE 00000092 "\t\t\t'seek_pos'\t=> $seek_pos,"
NSQ_SOURCE_LINE 00000093 "\t\t\t'lines'\t\t=> [],"
NSQ_SOURCE_LINE 00000094 "\t\t\t'is_crlf'\t=> $is_crlf,"
NSQ_SOURCE_LINE 00000095 "\t\t\t'rec_sep'\t=> $rec_sep,"
NSQ_SOURCE_LINE 00000096 "\t\t\t'sep_is_regex'\t=> $sep_is_regex,"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "\t\t}, $class ;"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "\treturn( $self ) ;"
NSQ_SOURCE_LINE 00000101 "}"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "# read the previous record from the file"
NSQ_SOURCE_LINE 00000104 "# "
NSQ_SOURCE_LINE 00000105 "sub readline {"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "\tmy( $self, $line_ref ) = @_ ;"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "\tmy $read_buf ;"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "# get the buffer of lines"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "\tmy $lines_ref = $self->{'lines'} ;"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "\treturn unless $lines_ref ;"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "\twhile( 1 ) {"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "# see if there is more than 1 line in the buffer"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "\t\tif ( @{$lines_ref} > 1 ) {"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "# we have a complete line so return it"
NSQ_SOURCE_LINE 00000124 "# and convert those damned cr/lf lines to \\n"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "\t\t\t$lines_ref->[-1] =~ s/\\015\\012/\\n/"
NSQ_SOURCE_LINE 00000127 "\t\t\t\t\tif $self->{'is_crlf'} ;"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "\t\t\treturn( pop @{$lines_ref} ) ;"
NSQ_SOURCE_LINE 00000130 "\t\t}"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "# we don't have a complete, so have to read blocks until we do"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "\t\tmy $seek_pos = $self->{'seek_pos'} ;"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "# see if we are at the beginning of the file"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "\t\tif ( $seek_pos == 0 ) {"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "# the last read never made more lines, so return the last line in the buffer"
NSQ_SOURCE_LINE 00000141 "# if no lines left then undef will be returned"
NSQ_SOURCE_LINE 00000142 "# and convert those damned cr/lf lines to \\n"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "\t\t\t$lines_ref->[-1] =~ s/\\015\\012/\\n/"
NSQ_SOURCE_LINE 00000145 "\t\t\t\t\tif @{$lines_ref} && $self->{'is_crlf'} ;"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "\t\t\treturn( pop @{$lines_ref} ) ;"
NSQ_SOURCE_LINE 00000148 "\t\t}"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "# we have to read more text so get the handle and the current read size"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "\t\tmy $handle = $self->{'handle'} ;"
NSQ_SOURCE_LINE 00000153 "\t\tmy $read_size = $self->{'read_size'} ;"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "# after the first read, always read the maximum size"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "\t\t$self->{'read_size'} = $max_read_size ;"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "# seek to the beginning of this block and save the new seek position"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "\t\t$seek_pos -= $read_size ;"
NSQ_SOURCE_LINE 00000162 "\t\tsysseek( $handle, $seek_pos, SEEK_SET ) ;"
NSQ_SOURCE_LINE 00000163 "\t\t$self->{'seek_pos'} = $seek_pos ;"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "# read in the next (previous) block of text"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "\t\tmy $read_cnt = sysread( $handle, $read_buf, $read_size ) ;"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "# prepend the read buffer to the leftover (possibly partial) line"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "\t\tmy $text = $read_buf ;"
NSQ_SOURCE_LINE 00000172 "\t\t$text .= shift @{$lines_ref} if @{$lines_ref} ;"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "# split the buffer into a list of lines"
NSQ_SOURCE_LINE 00000175 "# this may want to be $/ but reading files backwards assumes plain text and"
NSQ_SOURCE_LINE 00000176 "# newline separators"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "\t\t@{$lines_ref} = ( $self->{'sep_is_regex'} ) ?"
NSQ_SOURCE_LINE 00000179 "\t \t\t$text =~ /(.*?$self->{'rec_sep'}|.+)/gs :"
NSQ_SOURCE_LINE 00000180 "\t\t\t$text =~ /(.*?\\Q$self->{'rec_sep'}\\E|.+)/gs ;"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "#print \"Lines \\n=>\", join( \"<=\\n=>\", @{$lines_ref} ), \"<=\\n\" ;"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "\t}"
NSQ_SOURCE_LINE 00000185 "}"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "sub eof {"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "\tmy ( $self ) = @_ ;"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "\tmy $seek_pos = $self->{'seek_pos'} ;"
NSQ_SOURCE_LINE 00000192 "\tmy $lines_count = @{ $self->{'lines'} } ;"
NSQ_SOURCE_LINE 00000193 "\treturn( $seek_pos == 0 && $lines_count == 0 ) ;"
NSQ_SOURCE_LINE 00000194 "}"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "sub tell {"
NSQ_SOURCE_LINE 00000197 "\tmy ( $self ) = @_ ;"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "\tmy $seek_pos = $self->{'seek_pos'} ;"
NSQ_SOURCE_LINE 00000200 "\t$seek_pos + length(join \"\", @{ $self->{'lines'} });"
NSQ_SOURCE_LINE 00000201 "}"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "sub get_handle {"
NSQ_SOURCE_LINE 00000204 "\tmy ( $self ) = @_ ;"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "\tmy $handle = $self->{handle} ;"
NSQ_SOURCE_LINE 00000207 "\tseek( $handle, $self->tell, SEEK_SET ) ;"
NSQ_SOURCE_LINE 00000208 "\treturn $handle ;"
NSQ_SOURCE_LINE 00000209 "}"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "sub close {"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "\tmy ( $self ) = @_ ;"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "\tmy $handle = delete( $self->{'handle'} ) ;"
NSQ_SOURCE_LINE 00000216 "\tdelete( $self->{'lines'} ) ;"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "\tCORE::close( $handle ) ;"
NSQ_SOURCE_LINE 00000219 "}"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "__END__"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "=head1 NAME"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "File::ReadBackwards.pm -- Read a file backwards by lines."
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "    use File::ReadBackwards ;"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "    # Object interface"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "    $bw = File::ReadBackwards->new( 'log_file' ) or"
NSQ_SOURCE_LINE 00000235 "\t\t\tdie \"can't read 'log_file' $!\" ;"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "    while( defined( $log_line = $bw->readline ) ) {"
NSQ_SOURCE_LINE 00000238 "\t    print $log_line ;"
NSQ_SOURCE_LINE 00000239 "    }"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "    # ... or the alternative way of reading"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "    until ( $bw->eof ) {"
NSQ_SOURCE_LINE 00000244 "\t    print $bw->readline ;"
NSQ_SOURCE_LINE 00000245 "    }"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "    # Tied Handle Interface"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "    tie *BW, 'File::ReadBackwards', 'log_file' or"
NSQ_SOURCE_LINE 00000250 "\t\t\tdie \"can't read 'log_file' $!\" ;"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "    while( <BW> ) {"
NSQ_SOURCE_LINE 00000253 "\t    print ;"
NSQ_SOURCE_LINE 00000254 "    }"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "This module reads a file backwards line by line. It is simple to use,"
NSQ_SOURCE_LINE 00000259 "memory efficient and fast. It supports both an object and a tied handle"
NSQ_SOURCE_LINE 00000260 "interface."
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "It is intended for processing log and other similar text files which"
NSQ_SOURCE_LINE 00000263 "typically have their newest entries appended to them. By default files"
NSQ_SOURCE_LINE 00000264 "are assumed to be plain text and have a line ending appropriate to the"
NSQ_SOURCE_LINE 00000265 "OS. But you can set the input record separator string on a per file"
NSQ_SOURCE_LINE 00000266 "basis."
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "=head1 OBJECT INTERFACE"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "These are the methods in C<File::ReadBackwards>' object interface:"
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "=head2 new( $file, [$rec_sep], [$sep_is_regex] )"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "C<new> takes as arguments a filename, an optional record separator and"
NSQ_SOURCE_LINE 00000275 "an optional flag that marks the record separator as a regular"
NSQ_SOURCE_LINE 00000276 "expression. It either returns the object on a successful open or undef"
NSQ_SOURCE_LINE 00000277 "upon failure. $! is set to the error code if any."
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "=head2 readline"
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "C<readline> takes no arguments and it returns the previous line in the"
NSQ_SOURCE_LINE 00000282 "file or undef when there are no more lines in the file. If the file is"
NSQ_SOURCE_LINE 00000283 "a non-seekable file (e.g. a pipe), then undef is returned."
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "=head2 getline"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "C<getline> is an alias for the readline method. It is here for"
NSQ_SOURCE_LINE 00000288 "compatibility with the IO::* classes which has a getline method."
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "=head2 eof"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "C<eof> takes no arguments and it returns true when readline() has"
NSQ_SOURCE_LINE 00000293 "iterated through the whole file."
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "=head2 close"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "C<close> takes no arguments and it closes the handle"
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "=head2 tell"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "C<tell> takes no arguments and it returns the current filehandle position."
NSQ_SOURCE_LINE 00000302 "This value may be used to seek() back to this position using a normal"
NSQ_SOURCE_LINE 00000303 "file handle."
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "=head2 get_handle"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "C<get_handle> takes no arguments and it returns the internal Perl"
NSQ_SOURCE_LINE 00000308 "filehandle used by the File::ReadBackwards object.  This handle may be"
NSQ_SOURCE_LINE 00000309 "used to read the file forward. Its seek position will be set to the"
NSQ_SOURCE_LINE 00000310 "position that is returned by the tell() method.  Note that"
NSQ_SOURCE_LINE 00000311 "interleaving forward and reverse reads may produce unpredictable"
NSQ_SOURCE_LINE 00000312 "results.  The only use supported at present is to read a file backward"
NSQ_SOURCE_LINE 00000313 "to a certain point, then use 'handle' to extract the handle, and read"
NSQ_SOURCE_LINE 00000314 "forward from that point."
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "=head1 TIED HANDLE INTERFACE"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "=head2 tie( *HANDLE, 'File::ReadBackwards', $file, [$rec_sep], [$sep_is_regex] )"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "The TIEHANDLE, READLINE, EOF, CLOSE and TELL methods are aliased to"
NSQ_SOURCE_LINE 00000321 "the new, readline, eof, close and tell methods respectively so refer"
NSQ_SOURCE_LINE 00000322 "to them for their arguments and API.  Once you have tied a handle to"
NSQ_SOURCE_LINE 00000323 "File::ReadBackwards the only I/O operation permissible is <> which"
NSQ_SOURCE_LINE 00000324 "will read the previous line. You can call eof() and close() on the"
NSQ_SOURCE_LINE 00000325 "tied handle as well. All other tied handle operations will generate an"
NSQ_SOURCE_LINE 00000326 "unknown method error. Do not seek, write or perform any other"
NSQ_SOURCE_LINE 00000327 "unsupported operations on the tied handle."
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "=head1 LINE AND RECORD ENDINGS"
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "Since this module needs to use low level I/O for efficiency, it can't"
NSQ_SOURCE_LINE 00000332 "portably seek and do block I/O without managing line ending conversions."
NSQ_SOURCE_LINE 00000333 "This module supports the default record separators of normal line ending"
NSQ_SOURCE_LINE 00000334 "strings used by the OS. You can also set the separator on a per file"
NSQ_SOURCE_LINE 00000335 "basis."
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "The record separator is a regular expression by default, which differs"
NSQ_SOURCE_LINE 00000338 "from the behavior of $/."
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "Only if the record separator is B<not> specified and it defaults to"
NSQ_SOURCE_LINE 00000341 "CR/LF (e.g, VMS, redmondware) will it will be converted to a single"
NSQ_SOURCE_LINE 00000342 "newline. Unix and MacOS files systems use only a single character for"
NSQ_SOURCE_LINE 00000343 "line endings and the lines are left unchanged.  This means that for"
NSQ_SOURCE_LINE 00000344 "native text files, you should be able to process their lines backwards"
NSQ_SOURCE_LINE 00000345 "without any problems with line endings. If you specify a record"
NSQ_SOURCE_LINE 00000346 "separator, no conversions will be done and you will get the records as"
NSQ_SOURCE_LINE 00000347 "if you read them in binary mode."
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "=head1 DESIGN"
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "It works by reading a large (8kb) block of data from the end of the"
NSQ_SOURCE_LINE 00000352 "file.  It then splits them on the record separator and stores a list of"
NSQ_SOURCE_LINE 00000353 "records in the object. Each call to readline returns the top record of"
NSQ_SOURCE_LINE 00000354 "the list and if the list is empty it refills it by reading the previous"
NSQ_SOURCE_LINE 00000355 "block from the file and splitting it.  When the beginning of the file is"
NSQ_SOURCE_LINE 00000356 "reached and there are no more lines, undef is returned.  All boundary"
NSQ_SOURCE_LINE 00000357 "conditions are handled correctly i.e. if there is a trailing partial"
NSQ_SOURCE_LINE 00000358 "line (no newline) it will be the first line returned and lines larger"
NSQ_SOURCE_LINE 00000359 "than the read buffer size are handled properly."
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "=head1 NOTES"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "There is no support for list context in either the object or tied"
NSQ_SOURCE_LINE 00000364 "interfaces. If you want to slurp all of the lines into an array in"
NSQ_SOURCE_LINE 00000365 "backwards order (and you don't care about memory usage) just do:"
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "\t@back_lines = reverse <FH>."
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "This module is only intended to read one line at a time from the end of"
NSQ_SOURCE_LINE 00000370 "a file to the beginning."
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "Original author: Uri Guttman, C<< uri@stemsystems.com >>"
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "Current maintainer: Graham Ollis C<< plicease@cpan.org >>"
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 "=head1 COPYRIGHT"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "Copyright (C) 2000-2021 by Uri Guttman. All rights reserved.  This program is"
NSQ_SOURCE_LINE 00000381 "free software; you can redistribute it and/or modify it under the same"
NSQ_SOURCE_LINE 00000382 "terms as Perl itself."
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "=cut"
BODY_END
