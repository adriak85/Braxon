NSQ_SOURCE_LINE 00000234 "    my $dirn    = 0;"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "    my $recurs;    #must be my()ed before sub {} since it calls itself"
NSQ_SOURCE_LINE 00000237 "    $recurs = sub {"
NSQ_SOURCE_LINE 00000238 "        my ( $str, $end, $buf ) = @_;"
NSQ_SOURCE_LINE 00000239 "        $filen++ if $end eq $baseend;"
NSQ_SOURCE_LINE 00000240 "        $dirn++  if $end eq $baseend;"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "        $DirPerms = oct($DirPerms) if substr( $DirPerms, 0, 1 ) eq '0';"
NSQ_SOURCE_LINE 00000243 "        mkdir( $end, $DirPerms ) or return if !-d $end;"
NSQ_SOURCE_LINE 00000244 "        if ( $MaxDepth && $MaxDepth =~ m/^\\d+$/ && $level >= $MaxDepth ) {"
NSQ_SOURCE_LINE 00000245 "            chmod scalar( ( stat($str) )[2] ), $end if $KeepMode;"
NSQ_SOURCE_LINE 00000246 "            return ( $filen, $dirn, $level ) if wantarray;"
NSQ_SOURCE_LINE 00000247 "            return $filen;"
NSQ_SOURCE_LINE 00000248 "        }"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "        $level++;"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "        my @files;"
NSQ_SOURCE_LINE 00000253 "        if ( $] < 5.006 ) {"
NSQ_SOURCE_LINE 00000254 "            opendir( STR_DH, $str ) or return;"
NSQ_SOURCE_LINE 00000255 "            @files = grep( $_ ne '.' && $_ ne '..', readdir(STR_DH) );"
NSQ_SOURCE_LINE 00000256 "            closedir STR_DH;"
NSQ_SOURCE_LINE 00000257 "        }"
NSQ_SOURCE_LINE 00000258 "        else {"
NSQ_SOURCE_LINE 00000259 "            opendir( my $str_dh, $str ) or return;"
NSQ_SOURCE_LINE 00000260 "            @files = grep( $_ ne '.' && $_ ne '..', readdir($str_dh) );"
NSQ_SOURCE_LINE 00000261 "            closedir $str_dh;"
NSQ_SOURCE_LINE 00000262 "        }"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "        for my $file (@files) {"
NSQ_SOURCE_LINE 00000265 "            my ($file_ut) = $file =~ m{ (.*) }xms;"
NSQ_SOURCE_LINE 00000266 "            my $org = File::Spec->catfile( $str, $file_ut );"
NSQ_SOURCE_LINE 00000267 "            my $new = File::Spec->catfile( $end, $file_ut );"
NSQ_SOURCE_LINE 00000268 "            if ( -l $org && $CopyLink ) {"
NSQ_SOURCE_LINE 00000269 "                my $target = readlink($org);"
NSQ_SOURCE_LINE 00000270 "                ($target) = $target =~ m/(.*)/;    # mass-untaint is OK since we have to allow what the file system does"
NSQ_SOURCE_LINE 00000271 "                carp \"Copying a symlink ($org) whose target does not exist\""
NSQ_SOURCE_LINE 00000272 "                  if !-e $target && $BdTrgWrn;"
NSQ_SOURCE_LINE 00000273 "                unlink $new if -l $new;"
NSQ_SOURCE_LINE 00000274 "                symlink( $target, $new ) or return;"
NSQ_SOURCE_LINE 00000275 "            }"
NSQ_SOURCE_LINE 00000276 "            elsif ( -d $org ) {"
NSQ_SOURCE_LINE 00000277 "                my $rc;"
NSQ_SOURCE_LINE 00000278 "                if ( !-w $org && $KeepMode ) {"
NSQ_SOURCE_LINE 00000279 "                    local $KeepMode = 0;"
NSQ_SOURCE_LINE 00000280 "                    $rc = $recurs->( $org, $new, $buf ) if defined $buf;"
NSQ_SOURCE_LINE 00000281 "                    $rc = $recurs->( $org, $new ) if !defined $buf;"
NSQ_SOURCE_LINE 00000282 "                    chmod scalar( ( stat($org) )[2] ), $new;"
NSQ_SOURCE_LINE 00000283 "                }"
NSQ_SOURCE_LINE 00000284 "                else {"
NSQ_SOURCE_LINE 00000285 "                    $rc = $recurs->( $org, $new, $buf ) if defined $buf;"
NSQ_SOURCE_LINE 00000286 "                    $rc = $recurs->( $org, $new ) if !defined $buf;"
NSQ_SOURCE_LINE 00000287 "                }"
NSQ_SOURCE_LINE 00000288 "                if ( !$rc ) {"
NSQ_SOURCE_LINE 00000289 "                    if ($SkipFlop) {"
