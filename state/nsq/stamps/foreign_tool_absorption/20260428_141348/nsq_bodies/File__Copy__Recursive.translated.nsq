NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "sub pathempty {"
NSQ_SOURCE_LINE 00000370 "    my $pth = shift;"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "    my ( $orig_dev, $orig_ino ) = ( lstat $pth )[ 0, 1 ];"
NSQ_SOURCE_LINE 00000373 "    return 2 if !-d _ || !defined($orig_dev) || ( $^O ne 'MSWin32' && !$orig_ino );    #stat.inode is 0 on Windows"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "    my $starting_point = Cwd::cwd();"
NSQ_SOURCE_LINE 00000376 "    my ( $starting_dev, $starting_ino ) = ( lstat $starting_point )[ 0, 1 ];"
NSQ_SOURCE_LINE 00000377 "    chdir($pth) or Carp::croak(\"Failed to change directory to “$pth”: $!\");"
NSQ_SOURCE_LINE 00000378 "    $pth = '.';"
NSQ_SOURCE_LINE 00000379 "    _bail_if_changed( $pth, $orig_dev, $orig_ino );"
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "    my @names;"
NSQ_SOURCE_LINE 00000382 "    my $pth_dh;"
NSQ_SOURCE_LINE 00000383 "    if ( $] < 5.006 ) {"
NSQ_SOURCE_LINE 00000384 "        opendir( PTH_DH, $pth ) or return;"
NSQ_SOURCE_LINE 00000385 "        @names = grep !/^\\.\\.?$/, readdir(PTH_DH);"
NSQ_SOURCE_LINE 00000386 "        closedir PTH_DH;"
NSQ_SOURCE_LINE 00000387 "    }"
NSQ_SOURCE_LINE 00000388 "    else {"
NSQ_SOURCE_LINE 00000389 "        opendir( $pth_dh, $pth ) or return;"
NSQ_SOURCE_LINE 00000390 "        @names = grep !/^\\.\\.?$/, readdir($pth_dh);"
NSQ_SOURCE_LINE 00000391 "        closedir $pth_dh;"
NSQ_SOURCE_LINE 00000392 "    }"
NSQ_SOURCE_LINE 00000393 "    _bail_if_changed( $pth, $orig_dev, $orig_ino );"
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "    for my $name (@names) {"
NSQ_SOURCE_LINE 00000396 "        my ($name_ut) = $name =~ m{ (.*) }xms;"
NSQ_SOURCE_LINE 00000397 "        my $flpth = File::Spec->catdir( $pth, $name_ut );"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "        if ( -l $flpth ) {"
NSQ_SOURCE_LINE 00000400 "            _bail_if_changed( $pth, $orig_dev, $orig_ino );"
NSQ_SOURCE_LINE 00000401 "            unlink $flpth or return;"
NSQ_SOURCE_LINE 00000402 "        }"
NSQ_SOURCE_LINE 00000403 "        elsif ( -d $flpth ) {"
NSQ_SOURCE_LINE 00000404 "            _bail_if_changed( $pth, $orig_dev, $orig_ino );"
NSQ_SOURCE_LINE 00000405 "            pathrmdir($flpth) or return;"
NSQ_SOURCE_LINE 00000406 "        }"
NSQ_SOURCE_LINE 00000407 "        else {"
NSQ_SOURCE_LINE 00000408 "            _bail_if_changed( $pth, $orig_dev, $orig_ino );"
NSQ_SOURCE_LINE 00000409 "            unlink $flpth or return;"
NSQ_SOURCE_LINE 00000410 "        }"
NSQ_SOURCE_LINE 00000411 "    }"
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "    chdir($starting_point) or Carp::croak(\"Failed to change directory to “$starting_point”: $!\");"
NSQ_SOURCE_LINE 00000414 "    _bail_if_changed( \".\", $starting_dev, $starting_ino );"
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "    return 1;"
NSQ_SOURCE_LINE 00000417 "}"
NSQ_SOURCE_LINE 00000418 ""
NSQ_SOURCE_LINE 00000419 "sub pathrm {"
NSQ_SOURCE_LINE 00000420 "    my ( $path, $force, $nofail ) = @_;"
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "    my ( $orig_dev, $orig_ino ) = ( lstat $path )[ 0, 1 ];"
NSQ_SOURCE_LINE 00000423 "    return 2 if !-d _ || !defined($orig_dev) || !$orig_ino;"
NSQ_SOURCE_LINE 00000424 ""
NSQ_SOURCE_LINE 00000425 "    # Manual test (I hate this function :/):"
NSQ_SOURCE_LINE 00000426 "    #    sudo mkdir /foo && perl -MFile::Copy::Recursive=pathrm -le 'print pathrm(\"/foo\",1)' && sudo rm -rf /foo"
NSQ_SOURCE_LINE 00000427 "    if ( $force && File::Spec->file_name_is_absolute($path) ) {"
NSQ_SOURCE_LINE 00000428 "        Carp::croak(\"pathrm() w/ force on abspath is not allowed\");"
NSQ_SOURCE_LINE 00000429 "    }"
NSQ_SOURCE_LINE 00000430 ""
NSQ_SOURCE_LINE 00000431 "    my @pth = File::Spec->splitdir($path);"
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "    my %fs_check;"
NSQ_SOURCE_LINE 00000434 "    my $aggregate_path;"
NSQ_SOURCE_LINE 00000435 "    for my $part (@pth) {"
NSQ_SOURCE_LINE 00000436 "        $aggregate_path = defined $aggregate_path ? File::Spec->catdir( $aggregate_path, $part ) : $part;"
NSQ_SOURCE_LINE 00000437 "        $fs_check{$aggregate_path} = [ ( lstat $aggregate_path )[ 0, 1 ] ];"
NSQ_SOURCE_LINE 00000438 "    }"
NSQ_SOURCE_LINE 00000439 ""
NSQ_SOURCE_LINE 00000440 "    while (@pth) {"
NSQ_SOURCE_LINE 00000441 "        my $cur = File::Spec->catdir(@pth);"
NSQ_SOURCE_LINE 00000442 "        last if !$cur;    # necessary ???"
NSQ_SOURCE_LINE 00000443 ""
NSQ_SOURCE_LINE 00000444 "        if ($force) {"
NSQ_SOURCE_LINE 00000445 "            _bail_if_changed( $cur, $fs_check{$cur}->[0], $fs_check{$cur}->[1] );"
NSQ_SOURCE_LINE 00000446 "            if ( !pathempty($cur) ) {"
NSQ_SOURCE_LINE 00000447 "                return unless $nofail;"
NSQ_SOURCE_LINE 00000448 "            }"
NSQ_SOURCE_LINE 00000449 "        }"
NSQ_SOURCE_LINE 00000450 "        _bail_if_changed( $cur, $fs_check{$cur}->[0], $fs_check{$cur}->[1] );"
NSQ_SOURCE_LINE 00000451 "        if ($nofail) {"
NSQ_SOURCE_LINE 00000452 "            rmdir $cur;"
NSQ_SOURCE_LINE 00000453 "        }"
NSQ_SOURCE_LINE 00000454 "        else {"
NSQ_SOURCE_LINE 00000455 "            rmdir $cur or return;"
NSQ_SOURCE_LINE 00000456 "        }"
NSQ_SOURCE_LINE 00000457 "        pop @pth;"
NSQ_SOURCE_LINE 00000458 "    }"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "    return 1;"
NSQ_SOURCE_LINE 00000461 "}"
NSQ_SOURCE_LINE 00000462 ""
NSQ_SOURCE_LINE 00000463 "sub pathrmdir {"
NSQ_SOURCE_LINE 00000464 "    my $dir = shift;"
NSQ_SOURCE_LINE 00000465 "    if ( -e $dir ) {"
NSQ_SOURCE_LINE 00000466 "        return if !-d $dir;"
NSQ_SOURCE_LINE 00000467 "    }"
NSQ_SOURCE_LINE 00000468 "    else {"
NSQ_SOURCE_LINE 00000469 "        return 2;"
NSQ_SOURCE_LINE 00000470 "    }"
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "    my ( $orig_dev, $orig_ino ) = ( lstat $dir )[ 0, 1 ];"
NSQ_SOURCE_LINE 00000473 "    return 2 if !defined($orig_dev) || ( $^O ne 'MSWin32' && !$orig_ino );"
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 "    pathempty($dir) or return;"
NSQ_SOURCE_LINE 00000476 "    _bail_if_changed( $dir, $orig_dev, $orig_ino );"
NSQ_SOURCE_LINE 00000477 "    rmdir $dir or return;"
NSQ_SOURCE_LINE 00000478 ""
NSQ_SOURCE_LINE 00000479 "    return 1;"
NSQ_SOURCE_LINE 00000480 "}"
NSQ_SOURCE_LINE 00000481 ""
NSQ_SOURCE_LINE 00000482 "sub _bail_if_changed {"
NSQ_SOURCE_LINE 00000483 "    my ( $path, $orig_dev, $orig_ino ) = @_;"
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "    my ( $cur_dev, $cur_ino ) = ( lstat $path )[ 0, 1 ];"
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "    if ( !defined $cur_dev || !defined $cur_ino ) {"
NSQ_SOURCE_LINE 00000488 "        $cur_dev ||= \"undef(path went away?)\";"
NSQ_SOURCE_LINE 00000489 "        $cur_ino ||= \"undef(path went away?)\";"
NSQ_SOURCE_LINE 00000490 "    }"
NSQ_SOURCE_LINE 00000491 "    else {"
NSQ_SOURCE_LINE 00000492 "        $path = Cwd::abs_path($path);"
NSQ_SOURCE_LINE 00000493 "    }"
NSQ_SOURCE_LINE 00000494 ""
NSQ_SOURCE_LINE 00000495 "    if ( $orig_dev ne $cur_dev || $orig_ino ne $cur_ino ) {"
NSQ_SOURCE_LINE 00000496 "        local $Carp::CarpLevel += 1;"
NSQ_SOURCE_LINE 00000497 "        Carp::croak(\"directory $path changed: expected dev=$orig_dev ino=$orig_ino, actual dev=$cur_dev ino=$cur_ino, aborting\");"
NSQ_SOURCE_LINE 00000498 "    }"
NSQ_SOURCE_LINE 00000499 "}"
NSQ_SOURCE_LINE 00000500 ""
NSQ_SOURCE_LINE 00000501 "1;"
NSQ_SOURCE_LINE 00000502 ""
NSQ_SOURCE_LINE 00000503 "__END__"
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "=head1 NAME"
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "File::Copy::Recursive - Perl extension for recursively copying files and directories"
NSQ_SOURCE_LINE 00000508 ""
NSQ_SOURCE_LINE 00000509 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000510 ""
NSQ_SOURCE_LINE 00000511 "  use File::Copy::Recursive qw(fcopy rcopy dircopy fmove rmove dirmove);"
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "  fcopy($orig,$new[,$buf]) or die $!;"
NSQ_SOURCE_LINE 00000514 "  rcopy($orig,$new[,$buf]) or die $!;"
NSQ_SOURCE_LINE 00000515 "  dircopy($orig,$new[,$buf]) or die $!;"
NSQ_SOURCE_LINE 00000516 ""
NSQ_SOURCE_LINE 00000517 "  fmove($orig,$new[,$buf]) or die $!;"
NSQ_SOURCE_LINE 00000518 "  rmove($orig,$new[,$buf]) or die $!;"
NSQ_SOURCE_LINE 00000519 "  dirmove($orig,$new[,$buf]) or die $!;"
NSQ_SOURCE_LINE 00000520 "  "
NSQ_SOURCE_LINE 00000521 "  rcopy_glob(\"orig/stuff-*\", $trg [, $buf]) or die $!;"
NSQ_SOURCE_LINE 00000522 "  rmove_glob(\"orig/stuff-*\", $trg [,$buf]) or die $!;"
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000525 ""
NSQ_SOURCE_LINE 00000526 "This module copies and moves directories recursively (or single files, well... singley) to an optional depth and attempts to preserve each file or directory's mode."
NSQ_SOURCE_LINE 00000527 ""
NSQ_SOURCE_LINE 00000528 "=head1 EXPORT"
NSQ_SOURCE_LINE 00000529 ""
NSQ_SOURCE_LINE 00000530 "None by default. But you can export all the functions as in the example above and the path* functions if you wish."
NSQ_SOURCE_LINE 00000531 ""
NSQ_SOURCE_LINE 00000532 "=head2 fcopy()"
NSQ_SOURCE_LINE 00000533 ""
NSQ_SOURCE_LINE 00000534 "This function uses File::Copy's copy() function to copy a file but not a directory. Any directories are recursively created if need be."
NSQ_SOURCE_LINE 00000535 "One difference to File::Copy::copy() is that fcopy attempts to preserve the mode (see Preserving Mode below)"
NSQ_SOURCE_LINE 00000536 "The optional $buf in the synopsis is the same as File::Copy::copy()'s 3rd argument."
NSQ_SOURCE_LINE 00000537 "This function returns the same as File::Copy::copy() in scalar context and 1,0,0 in list context to accomodate rcopy()'s list context on regular files. (See below for more info)"
NSQ_SOURCE_LINE 00000538 ""
NSQ_SOURCE_LINE 00000539 "=head2 dircopy()"
NSQ_SOURCE_LINE 00000540 ""
NSQ_SOURCE_LINE 00000541 "This function recursively traverses the $orig directory's structure and recursively copies it to the $new directory."
NSQ_SOURCE_LINE 00000542 "$new is created if necessary (multiple non existent directories is ok (i.e. foo/bar/baz). The script logically and portably creates all of them if necessary)."
NSQ_SOURCE_LINE 00000543 "It attempts to preserve the mode (see Preserving Mode below) and "
NSQ_SOURCE_LINE 00000544 "by default it copies all the way down into the directory (see Managing Depth, below)."
NSQ_SOURCE_LINE 00000545 "If a directory is not specified it croaks just like fcopy croaks if its not a file that is specified."
NSQ_SOURCE_LINE 00000546 ""
NSQ_SOURCE_LINE 00000547 "This function returns true or false: for true in scalar context it returns the number of files and directories copied,"
NSQ_SOURCE_LINE 00000548 "whereas in list context it returns the number of files and directories, number of directories only, depth level traversed."
NSQ_SOURCE_LINE 00000549 ""
NSQ_SOURCE_LINE 00000550 "  my $num_of_files_and_dirs = dircopy($orig,$new);"
NSQ_SOURCE_LINE 00000551 "  my($num_of_files_and_dirs,$num_of_dirs,$depth_traversed) = dircopy($orig,$new);"
NSQ_SOURCE_LINE 00000552 "  "
NSQ_SOURCE_LINE 00000553 "Normally it stops and returns if a copy fails. To continue on regardless, set $File::Copy::Recursive::SkipFlop to true."
NSQ_SOURCE_LINE 00000554 ""
NSQ_SOURCE_LINE 00000555 "    local $File::Copy::Recursive::SkipFlop = 1;"
NSQ_SOURCE_LINE 00000556 ""
NSQ_SOURCE_LINE 00000557 "That way it will copy everythging it can in a directory and won't stop because of permissions, etc..."
NSQ_SOURCE_LINE 00000558 ""
NSQ_SOURCE_LINE 00000559 "=head2 rcopy()"
NSQ_SOURCE_LINE 00000560 ""
NSQ_SOURCE_LINE 00000561 "This function will allow you to specify a file *or* a directory. It calls fcopy() if you passed file and dircopy() if you passed a directory."
NSQ_SOURCE_LINE 00000562 "If you call rcopy() (or fcopy() for that matter) on a file in list context, the values will be 1,0,0 since no directories and no depth are used. "
NSQ_SOURCE_LINE 00000563 "This is important because if it's a directory in list context and there is only the initial directory the return value is 1,1,1."
NSQ_SOURCE_LINE 00000564 ""
NSQ_SOURCE_LINE 00000565 "=head2 rcopy_glob()"
NSQ_SOURCE_LINE 00000566 ""
NSQ_SOURCE_LINE 00000567 "This function lets you specify a pattern suitable for perl's File::Glob::bsd_glob() as the first argument. Subsequently each path returned by perl's File::Glob::bsd_glob() gets rcopy()ied."
NSQ_SOURCE_LINE 00000568 ""
NSQ_SOURCE_LINE 00000569 "It returns and array whose items are array refs that contain the return value of each rcopy() call."
NSQ_SOURCE_LINE 00000570 ""
NSQ_SOURCE_LINE 00000571 "It forces behavior as if $File::Copy::Recursive::CPRFComp is true."
NSQ_SOURCE_LINE 00000572 ""
NSQ_SOURCE_LINE 00000573 "=head2 fmove()"
NSQ_SOURCE_LINE 00000574 ""
NSQ_SOURCE_LINE 00000575 "Copies the file then removes the original. You can manage the path the original file is in according to $RemvBase."
NSQ_SOURCE_LINE 00000576 ""
NSQ_SOURCE_LINE 00000577 "=head2 dirmove()"
NSQ_SOURCE_LINE 00000578 ""
NSQ_SOURCE_LINE 00000579 "Uses dircopy() to copy the directory then removes the original. You can manage the path the original directory is in according to $RemvBase."
NSQ_SOURCE_LINE 00000580 ""
NSQ_SOURCE_LINE 00000581 "=head2 rmove()"
NSQ_SOURCE_LINE 00000582 ""
NSQ_SOURCE_LINE 00000583 "Like rcopy() but calls fmove() or dirmove() instead."
NSQ_SOURCE_LINE 00000584 ""
NSQ_SOURCE_LINE 00000585 "=head2 rmove_glob()"
NSQ_SOURCE_LINE 00000586 ""
NSQ_SOURCE_LINE 00000587 "Like rcopy_glob() but calls rmove() instead of rcopy()"
NSQ_SOURCE_LINE 00000588 ""
NSQ_SOURCE_LINE 00000589 "=head3 $RemvBase"
NSQ_SOURCE_LINE 00000590 ""
NSQ_SOURCE_LINE 00000591 "Default is false. When set to true the *move() functions will not only attempt to remove the original file or directory but will remove the given path it is in."
NSQ_SOURCE_LINE 00000592 ""
NSQ_SOURCE_LINE 00000593 "So if you:"
NSQ_SOURCE_LINE 00000594 ""
NSQ_SOURCE_LINE 00000595 "   rmove('foo/bar/baz', '/etc/');"
NSQ_SOURCE_LINE 00000596 "   # \"baz\" is removed from foo/bar after it is successfully copied to /etc/"
NSQ_SOURCE_LINE 00000597 "   "
NSQ_SOURCE_LINE 00000598 "   local $File::Copy::Recursive::Remvbase = 1;"
NSQ_SOURCE_LINE 00000599 "   rmove('foo/bar/baz','/etc/');"
NSQ_SOURCE_LINE 00000600 "   # if baz is successfully copied to /etc/ :"
NSQ_SOURCE_LINE 00000601 "   # first \"baz\" is removed from foo/bar"
NSQ_SOURCE_LINE 00000602 "   # then \"foo/bar is removed via pathrm()"
NSQ_SOURCE_LINE 00000603 ""
NSQ_SOURCE_LINE 00000604 "=head4 $ForcePth"
NSQ_SOURCE_LINE 00000605 ""
NSQ_SOURCE_LINE 00000606 "Default is false. When set to true it calls pathempty() before any directories are removed to empty the directory so it can be rmdir()'ed when $RemvBase is in effect."
NSQ_SOURCE_LINE 00000607 ""
NSQ_SOURCE_LINE 00000608 "=head2 Creating and Removing Paths"
NSQ_SOURCE_LINE 00000609 ""
NSQ_SOURCE_LINE 00000610 "=head3 $NoFtlPth"
NSQ_SOURCE_LINE 00000611 ""
NSQ_SOURCE_LINE 00000612 "Default is false. If set to true  rmdir(), mkdir(), and pathempty() calls in pathrm() and pathmk() do not return() on failure."
NSQ_SOURCE_LINE 00000613 ""
NSQ_SOURCE_LINE 00000614 "If its set to true they just silently go about their business regardless. This isn't a good idea but it's there if you want it."
NSQ_SOURCE_LINE 00000615 ""
NSQ_SOURCE_LINE 00000616 "=head3 $DirPerms"
NSQ_SOURCE_LINE 00000617 ""
NSQ_SOURCE_LINE 00000618 "Mode to pass to any mkdir() calls. Defaults to 0777 as per umask()'s POD. Explicitly having this allows older perls to be able to use FCR and might add a bit of flexibility for you."
NSQ_SOURCE_LINE 00000619 ""
NSQ_SOURCE_LINE 00000620 "Any value you set it to should be suitable for oct()."
NSQ_SOURCE_LINE 00000621 ""
NSQ_SOURCE_LINE 00000622 "=head3 Path functions"
NSQ_SOURCE_LINE 00000623 ""
NSQ_SOURCE_LINE 00000624 "These functions exist solely because they were necessary for the move and copy functions to have the features they do and not because they are of themselves the purpose of this module. That being said, here is how they work so you can understand how the copy and move functions work and use them by themselves if you wish."
NSQ_SOURCE_LINE 00000625 ""
NSQ_SOURCE_LINE 00000626 "=head4 pathrm()"
NSQ_SOURCE_LINE 00000627 ""
NSQ_SOURCE_LINE 00000628 "Removes a given path recursively. It removes the *entire* path so be careful!!!"
NSQ_SOURCE_LINE 00000629 ""
NSQ_SOURCE_LINE 00000630 "Returns 2 if the given path is not a directory."
NSQ_SOURCE_LINE 00000631 ""
NSQ_SOURCE_LINE 00000632 "  File::Copy::Recursive::pathrm('foo/bar/baz') or die $!;"
NSQ_SOURCE_LINE 00000633 "  # foo no longer exists"
NSQ_SOURCE_LINE 00000634 ""
NSQ_SOURCE_LINE 00000635 "Same as:"
NSQ_SOURCE_LINE 00000636 ""
NSQ_SOURCE_LINE 00000637 "  rmdir 'foo/bar/baz' or die $!;"
NSQ_SOURCE_LINE 00000638 "  rmdir 'foo/bar' or die $!;"
NSQ_SOURCE_LINE 00000639 "  rmdir 'foo' or die $!;"
NSQ_SOURCE_LINE 00000640 ""
NSQ_SOURCE_LINE 00000641 "An optional second argument makes it call pathempty() before any rmdir()'s when set to true."
NSQ_SOURCE_LINE 00000642 ""
NSQ_SOURCE_LINE 00000643 "  File::Copy::Recursive::pathrm('foo/bar/baz', 1) or die $!;"
NSQ_SOURCE_LINE 00000644 "  # foo no longer exists"
NSQ_SOURCE_LINE 00000645 ""
NSQ_SOURCE_LINE 00000646 "Same as:PFSCheck"
NSQ_SOURCE_LINE 00000647 ""
NSQ_SOURCE_LINE 00000648 "  File::Copy::Recursive::pathempty('foo/bar/baz') or die $!;"
NSQ_SOURCE_LINE 00000649 "  rmdir 'foo/bar/baz' or die $!;"
NSQ_SOURCE_LINE 00000650 "  File::Copy::Recursive::pathempty('foo/bar/') or die $!;"
NSQ_SOURCE_LINE 00000651 "  rmdir 'foo/bar' or die $!;"
NSQ_SOURCE_LINE 00000652 "  File::Copy::Recursive::pathempty('foo/') or die $!;"
NSQ_SOURCE_LINE 00000653 "  rmdir 'foo' or die $!;"
NSQ_SOURCE_LINE 00000654 ""
NSQ_SOURCE_LINE 00000655 "An optional third argument acts like $File::Copy::Recursive::NoFtlPth, again probably not a good idea."
NSQ_SOURCE_LINE 00000656 ""
NSQ_SOURCE_LINE 00000657 "=head4 pathempty()"
NSQ_SOURCE_LINE 00000658 ""
NSQ_SOURCE_LINE 00000659 "Recursively removes the given directory's contents so it is empty. Returns 2 if the given argument is not a directory, 1 on successfully emptying the directory."
NSQ_SOURCE_LINE 00000660 ""
NSQ_SOURCE_LINE 00000661 "   File::Copy::Recursive::pathempty($pth) or die $!;"
NSQ_SOURCE_LINE 00000662 "   # $pth is now an empty directory"
NSQ_SOURCE_LINE 00000663 ""
NSQ_SOURCE_LINE 00000664 "=head4 pathmk()"
NSQ_SOURCE_LINE 00000665 ""
NSQ_SOURCE_LINE 00000666 "Creates a given path recursively. Creates foo/bar/baz even if foo does not exist."
NSQ_SOURCE_LINE 00000667 ""
NSQ_SOURCE_LINE 00000668 "   File::Copy::Recursive::pathmk('foo/bar/baz') or die $!;"
NSQ_SOURCE_LINE 00000669 ""
NSQ_SOURCE_LINE 00000670 "An optional second argument if true acts just like $File::Copy::Recursive::NoFtlPth, which means you'd never get your die() if something went wrong. Again, probably a *bad* idea."
NSQ_SOURCE_LINE 00000671 ""
NSQ_SOURCE_LINE 00000672 "=head4 pathrmdir()"
NSQ_SOURCE_LINE 00000673 ""
NSQ_SOURCE_LINE 00000674 "Same as rmdir() but it calls pathempty() first to recursively empty it first since rmdir can not remove a directory with contents."
NSQ_SOURCE_LINE 00000675 "Just removes the top directory the path given instead of the entire path like pathrm(). Returns 2 if the given argument does not exist (i.e. it's already gone). Returns false if it exists but is not a directory."
NSQ_SOURCE_LINE 00000676 ""
NSQ_SOURCE_LINE 00000677 "=head2 Preserving Mode"
NSQ_SOURCE_LINE 00000678 ""
NSQ_SOURCE_LINE 00000679 "By default a quiet attempt is made to change the new file or directory to the mode of the old one."
NSQ_SOURCE_LINE 00000680 "To turn this behavior off set"
NSQ_SOURCE_LINE 00000681 "  $File::Copy::Recursive::KeepMode"
NSQ_SOURCE_LINE 00000682 "to false;"
NSQ_SOURCE_LINE 00000683 ""
NSQ_SOURCE_LINE 00000684 "=head2 Managing Depth"
NSQ_SOURCE_LINE 00000685 ""
NSQ_SOURCE_LINE 00000686 "You can set the maximum depth a directory structure is recursed by setting:"
NSQ_SOURCE_LINE 00000687 "  $File::Copy::Recursive::MaxDepth "
NSQ_SOURCE_LINE 00000688 "to a whole number greater than 0."
NSQ_SOURCE_LINE 00000689 ""
NSQ_SOURCE_LINE 00000690 "=head2 SymLinks"
NSQ_SOURCE_LINE 00000691 ""
NSQ_SOURCE_LINE 00000692 "If your system supports symlinks then symlinks will be copied as symlinks instead of as the target file."
NSQ_SOURCE_LINE 00000693 "Perl's symlink() is used instead of File::Copy's copy()."
NSQ_SOURCE_LINE 00000694 "You can customize this behavior by setting $File::Copy::Recursive::CopyLink to a true or false value."
NSQ_SOURCE_LINE 00000695 "It is already set to true or false depending on your system's support of symlinks so you can check it with an if statement to see how it will behave:"
NSQ_SOURCE_LINE 00000696 ""
NSQ_SOURCE_LINE 00000697 "    if($File::Copy::Recursive::CopyLink) {"
NSQ_SOURCE_LINE 00000698 "        print \"Symlinks will be preserved\\n\";"
NSQ_SOURCE_LINE 00000699 "    } else {"
NSQ_SOURCE_LINE 00000700 "        print \"Symlinks will not be preserved because your system does not support it\\n\";"
NSQ_SOURCE_LINE 00000701 "    }"
NSQ_SOURCE_LINE 00000702 ""
NSQ_SOURCE_LINE 00000703 "If symlinks are being copied you can set $File::Copy::Recursive::BdTrgWrn to true to make it carp when it copies a link whose target does not exist. It's false by default."
NSQ_SOURCE_LINE 00000704 ""
NSQ_SOURCE_LINE 00000705 "    local $File::Copy::Recursive::BdTrgWrn  = 1;"
NSQ_SOURCE_LINE 00000706 ""
NSQ_SOURCE_LINE 00000707 "=head2 Removing existing target file or directory before copying."
NSQ_SOURCE_LINE 00000708 ""
NSQ_SOURCE_LINE 00000709 "This can be done by setting $File::Copy::Recursive::RMTrgFil or $File::Copy::Recursive::RMTrgDir for file or directory behavior respectively."
NSQ_SOURCE_LINE 00000710 ""
NSQ_SOURCE_LINE 00000711 "0 = off (This is the default)"
NSQ_SOURCE_LINE 00000712 ""
NSQ_SOURCE_LINE 00000713 "1 = carp() $! if removal fails"
NSQ_SOURCE_LINE 00000714 ""
NSQ_SOURCE_LINE 00000715 "2 = return if removal fails"
NSQ_SOURCE_LINE 00000716 ""
NSQ_SOURCE_LINE 00000717 "    local $File::Copy::Recursive::RMTrgFil = 1;"
NSQ_SOURCE_LINE 00000718 "    fcopy($orig, $target) or die $!;"
NSQ_SOURCE_LINE 00000719 "    # if it fails it does warn() and keeps going"
NSQ_SOURCE_LINE 00000720 ""
NSQ_SOURCE_LINE 00000721 "    local $File::Copy::Recursive::RMTrgDir = 2;"
NSQ_SOURCE_LINE 00000722 "    dircopy($orig, $target) or die $!;"
NSQ_SOURCE_LINE 00000723 "    # if it fails it does your \"or die\""
NSQ_SOURCE_LINE 00000724 ""
NSQ_SOURCE_LINE 00000725 "This should be unnecessary most of the time but it's there if you need it :)"
NSQ_SOURCE_LINE 00000726 ""
NSQ_SOURCE_LINE 00000727 "=head2 Turning off stat() check"
NSQ_SOURCE_LINE 00000728 ""
NSQ_SOURCE_LINE 00000729 "By default the files or directories are checked to see if they are the same (i.e. linked, or two paths (absolute/relative or different relative paths) to the same file) by comparing the file's stat() info. "
NSQ_SOURCE_LINE 00000730 "It's a very efficient check that croaks if they are and shouldn't be turned off but if you must for some weird reason just set $File::Copy::Recursive::PFSCheck to a false value. (\"PFS\" stands for \"Physical File System\")"
NSQ_SOURCE_LINE 00000731 ""
NSQ_SOURCE_LINE 00000732 "=head2 Emulating cp -rf dir1/ dir2/"
NSQ_SOURCE_LINE 00000733 ""
NSQ_SOURCE_LINE 00000734 "By default dircopy($dir1,$dir2) will put $dir1's contents right into $dir2 whether $dir2 exists or not."
NSQ_SOURCE_LINE 00000735 ""
NSQ_SOURCE_LINE 00000736 "You can make dircopy() emulate cp -rf by setting $File::Copy::Recursive::CPRFComp to true."
NSQ_SOURCE_LINE 00000737 ""
NSQ_SOURCE_LINE 00000738 "NOTE: This only emulates -f in the sense that it does not prompt. It does not remove the target file or directory if it exists."
NSQ_SOURCE_LINE 00000739 "If you need to do that then use the variables $RMTrgFil and $RMTrgDir described in \"Removing existing target file or directory before copying\" above."
NSQ_SOURCE_LINE 00000740 ""
NSQ_SOURCE_LINE 00000741 "That means that if $dir2 exists it puts the contents into $dir2/$dir1 instead of $dir2 just like cp -rf."
NSQ_SOURCE_LINE 00000742 "If $dir2 does not exist then the contents go into $dir2 like normal (also like cp -rf)."
NSQ_SOURCE_LINE 00000743 ""
NSQ_SOURCE_LINE 00000744 "So assuming 'foo/file':"
NSQ_SOURCE_LINE 00000745 ""
NSQ_SOURCE_LINE 00000746 "    dircopy('foo', 'bar') or die $!;"
NSQ_SOURCE_LINE 00000747 "    # if bar does not exist the result is bar/file"
NSQ_SOURCE_LINE 00000748 "    # if bar does exist the result is bar/file"
NSQ_SOURCE_LINE 00000749 ""
NSQ_SOURCE_LINE 00000750 "    $File::Copy::Recursive::CPRFComp = 1;"
NSQ_SOURCE_LINE 00000751 "    dircopy('foo', 'bar') or die $!;"
NSQ_SOURCE_LINE 00000752 "    # if bar does not exist the result is bar/file"
NSQ_SOURCE_LINE 00000753 "    # if bar does exist the result is bar/foo/file"
NSQ_SOURCE_LINE 00000754 ""
NSQ_SOURCE_LINE 00000755 "You can also specify a star for cp -rf glob type behavior:"
NSQ_SOURCE_LINE 00000756 ""
NSQ_SOURCE_LINE 00000757 "    dircopy('foo/*', 'bar') or die $!;"
NSQ_SOURCE_LINE 00000758 "    # if bar does not exist the result is bar/file"
NSQ_SOURCE_LINE 00000759 "    # if bar does exist the result is bar/file"
NSQ_SOURCE_LINE 00000760 ""
NSQ_SOURCE_LINE 00000761 "    $File::Copy::Recursive::CPRFComp = 1;"
NSQ_SOURCE_LINE 00000762 "    dircopy('foo/*', 'bar') or die $!;"
NSQ_SOURCE_LINE 00000763 "    # if bar does not exist the result is bar/file"
NSQ_SOURCE_LINE 00000764 "    # if bar does exist the result is bar/file"
NSQ_SOURCE_LINE 00000765 ""
NSQ_SOURCE_LINE 00000766 "NOTE: The '*' is only like cp -rf foo/* and *DOES NOT EXPAND PARTIAL DIRECTORY NAMES LIKE YOUR SHELL DOES* (i.e. not like cp -rf fo* to copy foo/*)."
NSQ_SOURCE_LINE 00000767 ""
NSQ_SOURCE_LINE 00000768 "=head2 Allowing Copy Loops"
NSQ_SOURCE_LINE 00000769 ""
NSQ_SOURCE_LINE 00000770 "If you want to allow:"
NSQ_SOURCE_LINE 00000771 ""
NSQ_SOURCE_LINE 00000772 "  cp -rf . foo/"
NSQ_SOURCE_LINE 00000773 ""
NSQ_SOURCE_LINE 00000774 "type behavior set $File::Copy::Recursive::CopyLoop to true."
NSQ_SOURCE_LINE 00000775 ""
NSQ_SOURCE_LINE 00000776 "This is false by default so that a check is done to see if the source directory will contain the target directory and croaks to avoid this problem."
NSQ_SOURCE_LINE 00000777 ""
NSQ_SOURCE_LINE 00000778 "If you ever find a situation where $CopyLoop = 1 is desirable let me know. (i.e. it's a bad bad idea but is there if you want it)"
NSQ_SOURCE_LINE 00000779 ""
NSQ_SOURCE_LINE 00000780 "(Note: On Windows this was necessary since it uses stat() to determine sameness and stat() is essentially useless for this on Windows. "
NSQ_SOURCE_LINE 00000781 "The test is now simply skipped on Windows but I'd rather have an actual reliable check if anyone in Microsoft land would care to share)"
NSQ_SOURCE_LINE 00000782 ""
NSQ_SOURCE_LINE 00000783 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000784 ""
NSQ_SOURCE_LINE 00000785 "L<File::Copy> L<File::Spec>"
NSQ_SOURCE_LINE 00000786 ""
NSQ_SOURCE_LINE 00000787 "=head1 TO DO"
NSQ_SOURCE_LINE 00000788 ""
NSQ_SOURCE_LINE 00000789 "I am currently working on and reviewing some other modules to use in the new interface so we can lose the horrid globals as well as some other undesirable traits and also more easily make available some long standing requests."
NSQ_SOURCE_LINE 00000790 ""
NSQ_SOURCE_LINE 00000791 "Tests will be easier to do with the new interface and hence the testing focus will shift to the new interface and aim to be comprehensive."
NSQ_SOURCE_LINE 00000792 ""
NSQ_SOURCE_LINE 00000793 "The old interface will work, it just won't be brought in until it is used, so it will add no overhead for users of the new interface."
NSQ_SOURCE_LINE 00000794 ""
NSQ_SOURCE_LINE 00000795 "I'll add this after the latest version has been out for a while with no new features or issues found :)"
NSQ_SOURCE_LINE 00000796 ""
