NSQ_SOURCE_LINE 00000024 "@EXPORT_OK = qw(fcopy rcopy dircopy fmove rmove dirmove pathmk pathrm pathempty pathrmdir rcopy_glob rmove_glob);"
NSQ_SOURCE_LINE 00000025 ""
