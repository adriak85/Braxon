NSQ_SOURCE_LINE 00000302 "                        fcopy( $org, $new, $buf ) or next if defined $buf;"
NSQ_SOURCE_LINE 00000303 "                        fcopy( $org, $new ) or next if !defined $buf;"
NSQ_SOURCE_LINE 00000304 "                    }"
NSQ_SOURCE_LINE 00000305 "                    else {"
