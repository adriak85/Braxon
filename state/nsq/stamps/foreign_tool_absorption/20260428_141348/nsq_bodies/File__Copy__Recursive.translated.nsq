NSQ_SOURCE_LINE 00000029 "$KeepMode = 1;"
NSQ_SOURCE_LINE 00000030 "$CPRFComp = 0;"
NSQ_SOURCE_LINE 00000031 "$CopyLink = eval { local $SIG{'__DIE__'}; symlink '', ''; 1 } || 0;"
NSQ_SOURCE_LINE 00000032 "$PFSCheck = 1;"
