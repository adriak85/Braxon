NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "my $samecheck = sub {"
NSQ_SOURCE_LINE 00000045 "    return 1 if $^O eq 'MSWin32';    # need better way to check for this on winders..."
NSQ_SOURCE_LINE 00000046 "    return if @_ != 2 || !defined $_[0] || !defined $_[1];"
NSQ_SOURCE_LINE 00000047 "    return if $_[0] eq $_[1];"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "    my $one = '';"
NSQ_SOURCE_LINE 00000050 "    if ($PFSCheck) {"
NSQ_SOURCE_LINE 00000051 "        $one = join( '-', ( stat $_[0] )[ 0, 1 ] ) || '';"
NSQ_SOURCE_LINE 00000052 "        my $two = join( '-', ( stat $_[1] )[ 0, 1 ] ) || '';"
NSQ_SOURCE_LINE 00000053 "        if ( $one eq $two && $one ) {"
NSQ_SOURCE_LINE 00000054 "            carp \"$_[0] and $_[1] are identical\";"
NSQ_SOURCE_LINE 00000055 "            return;"
NSQ_SOURCE_LINE 00000056 "        }"
NSQ_SOURCE_LINE 00000057 "    }"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "    if ( -d $_[0] && !$CopyLoop ) {"
NSQ_SOURCE_LINE 00000060 "        $one = join( '-', ( stat $_[0] )[ 0, 1 ] ) if !$one;"
NSQ_SOURCE_LINE 00000061 "        my $abs = File::Spec->rel2abs( $_[1] );"
NSQ_SOURCE_LINE 00000062 "        my @pth = File::Spec->splitdir($abs);"
NSQ_SOURCE_LINE 00000063 "        while (@pth) {"
NSQ_SOURCE_LINE 00000064 "            if ( $pth[-1] eq '..' ) {    # cheaper than Cwd::realpath() plus we don't want to resolve symlinks at this point, right?"
NSQ_SOURCE_LINE 00000065 "                pop @pth;"
NSQ_SOURCE_LINE 00000066 "                pop @pth unless -l File::Spec->catdir(@pth);"
NSQ_SOURCE_LINE 00000067 "                next;"
NSQ_SOURCE_LINE 00000068 "            }"
NSQ_SOURCE_LINE 00000069 "            my $cur = File::Spec->catdir(@pth);"
NSQ_SOURCE_LINE 00000070 "            last if !$cur;               # probably not necessary, but nice to have just in case :)"
NSQ_SOURCE_LINE 00000071 "            my $two = join( '-', ( stat $cur )[ 0, 1 ] ) || '';"
NSQ_SOURCE_LINE 00000072 "            if ( $one eq $two && $one ) {"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "                # $! = 62; # Too many levels of symbolic links"
NSQ_SOURCE_LINE 00000075 "                carp \"Caught Deep Recursion Condition: $_[0] contains $_[1]\";"
NSQ_SOURCE_LINE 00000076 "                return;"
NSQ_SOURCE_LINE 00000077 "            }"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "            pop @pth;"
NSQ_SOURCE_LINE 00000080 "        }"
NSQ_SOURCE_LINE 00000081 "    }"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "    return 1;"
NSQ_SOURCE_LINE 00000084 "};"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "my $glob = sub {"
NSQ_SOURCE_LINE 00000087 "    my ( $do, $src_glob, @args ) = @_;"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "    local $CPRFComp = 1;"
NSQ_SOURCE_LINE 00000090 "    require File::Glob;"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "    my @rt;"
NSQ_SOURCE_LINE 00000093 "    for my $path ( File::Glob::bsd_glob($src_glob) ) {"
NSQ_SOURCE_LINE 00000094 "        my @call = [ $do->( $path, @args ) ] or return;"
NSQ_SOURCE_LINE 00000095 "        push @rt, \\@call;"
NSQ_SOURCE_LINE 00000096 "    }"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "    return @rt;"
NSQ_SOURCE_LINE 00000099 "};"
