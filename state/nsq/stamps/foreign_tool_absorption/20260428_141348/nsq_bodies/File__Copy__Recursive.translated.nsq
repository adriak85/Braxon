NSQ_SOURCE_LINE 00000213 "    }"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "    $samecheck->( $_zero, $_[1] ) or return;"
NSQ_SOURCE_LINE 00000216 "    if ( !-d $_zero || ( -e $_[1] && !-d $_[1] ) ) {"
