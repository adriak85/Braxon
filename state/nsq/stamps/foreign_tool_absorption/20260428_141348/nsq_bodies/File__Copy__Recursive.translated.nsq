NSQ_SOURCE_LINE 00000139 "sub fcopy {"
NSQ_SOURCE_LINE 00000140 "    $samecheck->(@_) or return;"
NSQ_SOURCE_LINE 00000141 "    if ( $RMTrgFil && ( -d $_[1] || -e $_[1] ) ) {"
NSQ_SOURCE_LINE 00000142 "        my $trg = $_[1];"
NSQ_SOURCE_LINE 00000143 "        if ( -d $trg ) {"
NSQ_SOURCE_LINE 00000144 "            my @trgx = File::Spec->splitpath( $_[0] );"
NSQ_SOURCE_LINE 00000145 "            $trg = File::Spec->catfile( $_[1], $trgx[$#trgx] );"
NSQ_SOURCE_LINE 00000146 "        }"
NSQ_SOURCE_LINE 00000147 "        $samecheck->( $_[0], $trg ) or return;"
NSQ_SOURCE_LINE 00000148 "        if ( -e $trg ) {"
NSQ_SOURCE_LINE 00000149 "            if ( $RMTrgFil == 1 ) {"
NSQ_SOURCE_LINE 00000150 "                unlink $trg or carp \"\\$RMTrgFil failed: $!\";"
NSQ_SOURCE_LINE 00000151 "            }"
NSQ_SOURCE_LINE 00000152 "            else {"
NSQ_SOURCE_LINE 00000153 "                unlink $trg or return;"
NSQ_SOURCE_LINE 00000154 "            }"
NSQ_SOURCE_LINE 00000155 "        }"
NSQ_SOURCE_LINE 00000156 "    }"
NSQ_SOURCE_LINE 00000157 "    my ( $volm, $path ) = File::Spec->splitpath( $_[1] );"
NSQ_SOURCE_LINE 00000158 "    if ( $path && !-d $path ) {"
NSQ_SOURCE_LINE 00000159 "        pathmk( File::Spec->catpath( $volm, $path, '' ), $NoFtlPth );"
NSQ_SOURCE_LINE 00000160 "    }"
NSQ_SOURCE_LINE 00000161 "    if ( -l $_[0] && $CopyLink ) {"
NSQ_SOURCE_LINE 00000162 "        my $target = readlink( shift() );"
NSQ_SOURCE_LINE 00000163 "        ($target) = $target =~ m/(.*)/;    # mass-untaint is OK since we have to allow what the file system does"
NSQ_SOURCE_LINE 00000164 "        carp \"Copying a symlink ($_[0]) whose target does not exist\""
NSQ_SOURCE_LINE 00000165 "          if !-e $target && $BdTrgWrn;"
NSQ_SOURCE_LINE 00000166 "        my $new = shift();"
NSQ_SOURCE_LINE 00000167 "        unlink $new if -l $new;"
NSQ_SOURCE_LINE 00000168 "        symlink( $target, $new ) or return;"
NSQ_SOURCE_LINE 00000169 "    }"
NSQ_SOURCE_LINE 00000170 "    elsif ( -d $_[0] && -f $_[1] ) {"
NSQ_SOURCE_LINE 00000171 "        return;"
NSQ_SOURCE_LINE 00000172 "    }"
NSQ_SOURCE_LINE 00000173 "    else {"
NSQ_SOURCE_LINE 00000174 "        return if -d $_[0];                # address File::Copy::copy() bug outlined in https://rt.perl.org/Public/Bug/Display.html?id=132866"
NSQ_SOURCE_LINE 00000175 "        copy(@_) or return;"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "        my @base_file = File::Spec->splitpath( $_[0] );"
NSQ_SOURCE_LINE 00000178 "        my $mode_trg = -d $_[1] ? File::Spec->catfile( $_[1], $base_file[$#base_file] ) : $_[1];"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "        chmod scalar( ( stat( $_[0] ) )[2] ), $mode_trg if $KeepMode;"
NSQ_SOURCE_LINE 00000181 "    }"
NSQ_SOURCE_LINE 00000182 "    return wantarray ? ( 1, 0, 0 ) : 1;    # use 0's incase they do math on them and in case rcopy() is called in list context = no uninit val warnings"
NSQ_SOURCE_LINE 00000183 "}"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "sub rcopy {"
NSQ_SOURCE_LINE 00000186 "    if ( -l $_[0] && $CopyLink ) {"
NSQ_SOURCE_LINE 00000187 "        goto &fcopy;"
NSQ_SOURCE_LINE 00000188 "    }"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "    goto &dircopy if -d $_[0] || substr( $_[0], ( 1 * -1 ), 1 ) eq '*';"
NSQ_SOURCE_LINE 00000191 "    goto &fcopy;"
NSQ_SOURCE_LINE 00000192 "}"
