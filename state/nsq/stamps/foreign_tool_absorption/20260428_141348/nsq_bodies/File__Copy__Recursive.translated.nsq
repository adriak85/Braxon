NSQ_SOURCE_LINE 00000307 "                        fcopy( $org, $new ) or return if !defined $buf;"
NSQ_SOURCE_LINE 00000308 "                    }"
NSQ_SOURCE_LINE 00000309 "                    chmod scalar( ( stat($org) )[2] ), $new if $KeepMode;"
