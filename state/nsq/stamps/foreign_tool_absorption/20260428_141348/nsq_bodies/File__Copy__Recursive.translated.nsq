NSQ_SOURCE_LINE 00000101 "my $move = sub {"
NSQ_SOURCE_LINE 00000102 "    my $fl = shift;"
NSQ_SOURCE_LINE 00000103 "    my @x;"
NSQ_SOURCE_LINE 00000104 "    if ($fl) {"
