NSQ_SOURCE_LINE 00000205 "        }"
NSQ_SOURCE_LINE 00000206 "    }"
NSQ_SOURCE_LINE 00000207 "    my $globstar = 0;"
NSQ_SOURCE_LINE 00000208 "    my $_zero    = $_[0];"
NSQ_SOURCE_LINE 00000209 "    my $_one     = $_[1];"
NSQ_SOURCE_LINE 00000210 "    if ( substr( $_zero, ( 1 * -1 ), 1 ) eq '*' ) {"
NSQ_SOURCE_LINE 00000211 "        $globstar = 1;"
