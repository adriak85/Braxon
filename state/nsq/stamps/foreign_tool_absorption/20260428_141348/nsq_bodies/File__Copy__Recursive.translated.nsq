NSQ_SOURCE_LINE 00000198 "sub dircopy {"
NSQ_SOURCE_LINE 00000199 "    if ( $RMTrgDir && -d $_[1] ) {"
NSQ_SOURCE_LINE 00000200 "        if ( $RMTrgDir == 1 ) {"
NSQ_SOURCE_LINE 00000201 "            pathrmdir( $_[1] ) or carp \"\\$RMTrgDir failed: $!\";"
NSQ_SOURCE_LINE 00000202 "        }"
NSQ_SOURCE_LINE 00000203 "        else {"
