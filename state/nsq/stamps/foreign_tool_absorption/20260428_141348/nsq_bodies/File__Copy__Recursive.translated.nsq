NSQ_SOURCE_LINE 00000223 "    }"
NSQ_SOURCE_LINE 00000224 "    else {"
NSQ_SOURCE_LINE 00000225 "        if ( $CPRFComp && !$globstar ) {"
NSQ_SOURCE_LINE 00000226 "            my @parts = File::Spec->splitdir($_zero);"
NSQ_SOURCE_LINE 00000227 "            while ( $parts[$#parts] eq '' ) { pop @parts; }"
NSQ_SOURCE_LINE 00000228 "            $_one = File::Spec->catdir( $_[1], $parts[$#parts] );"
