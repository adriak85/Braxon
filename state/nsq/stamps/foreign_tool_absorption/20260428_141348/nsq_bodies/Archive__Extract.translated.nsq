NSQ_SOURCE_LINE 00001309 "#                 return $self->_error(loc(\"Unable to open '%1': %2\","
NSQ_SOURCE_LINE 00001310 "#                             $self->archive,"
NSQ_SOURCE_LINE 00001311 "#                             $IO::Uncompress::Bunzip2::Bunzip2Error));"
NSQ_SOURCE_LINE 00001312 "#"
NSQ_SOURCE_LINE 00001313 "#     my $fh = FileHandle->new('>'. $self->_gunzip_to) or"
NSQ_SOURCE_LINE 00001314 "#         return $self->_error(loc(\"Could not open '%1' for writing: %2\","
NSQ_SOURCE_LINE 00001315 "#                             $self->_gunzip_to, $! ));"
NSQ_SOURCE_LINE 00001316 "#"
