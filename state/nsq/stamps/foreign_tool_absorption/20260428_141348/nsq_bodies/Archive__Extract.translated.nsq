NSQ_SOURCE_LINE 00001035 ""
NSQ_SOURCE_LINE 00001036 "sub _uncompress_bin {"
NSQ_SOURCE_LINE 00001037 "    my $self = shift;"
NSQ_SOURCE_LINE 00001038 ""
NSQ_SOURCE_LINE 00001039 "    ### check for /bin/gzip -- we need it ###"
NSQ_SOURCE_LINE 00001040 "    unless( $self->bin_uncompress ) {"
NSQ_SOURCE_LINE 00001041 "        $self->_error(loc(\"No '%1' program found\", '/bin/uncompress'));"
NSQ_SOURCE_LINE 00001042 "        return METHOD_NA;"
NSQ_SOURCE_LINE 00001043 "    }"
NSQ_SOURCE_LINE 00001044 ""
NSQ_SOURCE_LINE 00001045 "    my $fh = FileHandle->new('>'. $self->_gunzip_to) or"
NSQ_SOURCE_LINE 00001046 "        return $self->_error(loc(\"Could not open '%1' for writing: %2\","
NSQ_SOURCE_LINE 00001047 "                            $self->_gunzip_to, $! ));"
NSQ_SOURCE_LINE 00001048 ""
NSQ_SOURCE_LINE 00001049 "    my $cmd = [ $self->bin_uncompress, '-c', $self->archive ];"
NSQ_SOURCE_LINE 00001050 ""
NSQ_SOURCE_LINE 00001051 "    my $buffer;"
NSQ_SOURCE_LINE 00001052 "    unless( scalar run( command => $cmd,"
NSQ_SOURCE_LINE 00001053 "                        verbose => $DEBUG,"
NSQ_SOURCE_LINE 00001054 "                        buffer  => \\$buffer )"
NSQ_SOURCE_LINE 00001055 "    ) {"
NSQ_SOURCE_LINE 00001056 "        return $self->_error(loc(\"Unable to uncompress '%1': %2\","
NSQ_SOURCE_LINE 00001057 "                                    $self->archive, $buffer));"
NSQ_SOURCE_LINE 00001058 "    }"
NSQ_SOURCE_LINE 00001059 ""
NSQ_SOURCE_LINE 00001060 "    ### no buffers available?"
NSQ_SOURCE_LINE 00001061 "    if( !IPC::Cmd->can_capture_buffer and !$buffer ) {"
NSQ_SOURCE_LINE 00001062 "        $self->_error( $self->_no_buffer_content( $self->archive ) );"
NSQ_SOURCE_LINE 00001063 "    }"
NSQ_SOURCE_LINE 00001064 ""
NSQ_SOURCE_LINE 00001065 "    $self->_print($fh, $buffer) if defined $buffer;"
NSQ_SOURCE_LINE 00001066 ""
NSQ_SOURCE_LINE 00001067 "    close $fh;"
NSQ_SOURCE_LINE 00001068 ""
NSQ_SOURCE_LINE 00001069 "    ### set what files where extract, and where they went ###"
NSQ_SOURCE_LINE 00001070 "    $self->files( [$self->_gunzip_to] );"
NSQ_SOURCE_LINE 00001071 "    $self->extract_path( File::Spec->rel2abs(cwd()) );"
NSQ_SOURCE_LINE 00001072 ""
NSQ_SOURCE_LINE 00001073 "    return 1;"
NSQ_SOURCE_LINE 00001074 "}"
NSQ_SOURCE_LINE 00001075 ""
NSQ_SOURCE_LINE 00001076 ""
NSQ_SOURCE_LINE 00001077 "#################################"
NSQ_SOURCE_LINE 00001078 "#"
NSQ_SOURCE_LINE 00001079 "# Unzip code"
NSQ_SOURCE_LINE 00001080 "#"
NSQ_SOURCE_LINE 00001081 "#################################"
NSQ_SOURCE_LINE 00001082 ""
NSQ_SOURCE_LINE 00001083 ""
NSQ_SOURCE_LINE 00001084 "sub _unzip_bin {"
NSQ_SOURCE_LINE 00001085 "    my $self = shift;"
NSQ_SOURCE_LINE 00001086 ""
NSQ_SOURCE_LINE 00001087 "    ### check for /bin/gzip if we need it ###"
NSQ_SOURCE_LINE 00001088 "    unless( $self->bin_unzip ) {"
NSQ_SOURCE_LINE 00001089 "        $self->_error(loc(\"No '%1' program found\", '/bin/unzip'));"
NSQ_SOURCE_LINE 00001090 "        return METHOD_NA;"
NSQ_SOURCE_LINE 00001091 "    }"
NSQ_SOURCE_LINE 00001092 ""
NSQ_SOURCE_LINE 00001093 "    ### first, get the files.. it must be 2 different commands with 'unzip' :("
NSQ_SOURCE_LINE 00001094 "    {   ### on VMS, capital letter options have to be quoted. This is"
NSQ_SOURCE_LINE 00001095 "        ### reported by John Malmberg on P5P Tue 21 Aug 2007 05:05:11"
NSQ_SOURCE_LINE 00001096 "        ### Subject: [patch@31735]Archive Extract fix on VMS."
NSQ_SOURCE_LINE 00001097 "        my $opt = ON_VMS ? '\"-Z\"' : '-Z';"
NSQ_SOURCE_LINE 00001098 "        my $cmd = [ $self->bin_unzip, $opt, '-1', $self->archive ];"
NSQ_SOURCE_LINE 00001099 ""
NSQ_SOURCE_LINE 00001100 "        my $buffer = '';"
NSQ_SOURCE_LINE 00001101 "        unless( scalar run( command => $cmd,"
NSQ_SOURCE_LINE 00001102 "                            verbose => $DEBUG,"
NSQ_SOURCE_LINE 00001103 "                            buffer  => \\$buffer )"
NSQ_SOURCE_LINE 00001104 "        ) {"
NSQ_SOURCE_LINE 00001105 "            return $self->_error(loc(\"Unable to unzip '%1': %2\","
NSQ_SOURCE_LINE 00001106 "                                        $self->archive, $buffer));"
NSQ_SOURCE_LINE 00001107 "        }"
NSQ_SOURCE_LINE 00001108 ""
NSQ_SOURCE_LINE 00001109 "        ### no buffers available?"
NSQ_SOURCE_LINE 00001110 "        if( !IPC::Cmd->can_capture_buffer and !$buffer ) {"
NSQ_SOURCE_LINE 00001111 "            $self->_error( $self->_no_buffer_files( $self->archive ) );"
NSQ_SOURCE_LINE 00001112 ""
NSQ_SOURCE_LINE 00001113 "        } else {"
NSQ_SOURCE_LINE 00001114 "            ### Annoyingly, pesky MSWin32 can either have 'native' tools"
NSQ_SOURCE_LINE 00001115 "            ### which have \\r\\n line endings or Cygwin-based tools which"
NSQ_SOURCE_LINE 00001116 "            ### have \\n line endings. Jan Dubois suggested using this fix"
NSQ_SOURCE_LINE 00001117 "            my $split = ON_WIN32 ? qr/\\r?\\n/ : \"\\n\";"
NSQ_SOURCE_LINE 00001118 "            $self->files( [split $split, $buffer] );"
NSQ_SOURCE_LINE 00001119 "        }"
NSQ_SOURCE_LINE 00001120 "    }"
NSQ_SOURCE_LINE 00001121 ""
NSQ_SOURCE_LINE 00001122 "    ### now, extract the archive ###"
NSQ_SOURCE_LINE 00001123 "    {   my $cmd = [ $self->bin_unzip, '-qq', '-o', $self->archive ];"
NSQ_SOURCE_LINE 00001124 ""
NSQ_SOURCE_LINE 00001125 "        my $buffer;"
NSQ_SOURCE_LINE 00001126 "        unless( scalar run( command => $cmd,"
NSQ_SOURCE_LINE 00001127 "                            verbose => $DEBUG,"
NSQ_SOURCE_LINE 00001128 "                            buffer  => \\$buffer )"
NSQ_SOURCE_LINE 00001129 "        ) {"
NSQ_SOURCE_LINE 00001130 "            return $self->_error(loc(\"Unable to unzip '%1': %2\","
NSQ_SOURCE_LINE 00001131 "                                        $self->archive, $buffer));"
NSQ_SOURCE_LINE 00001132 "        }"
NSQ_SOURCE_LINE 00001133 ""
NSQ_SOURCE_LINE 00001134 "        if( scalar @{$self->files} ) {"
NSQ_SOURCE_LINE 00001135 "            my $files   = $self->files;"
NSQ_SOURCE_LINE 00001136 "            my $dir     = $self->__get_extract_dir( $files );"
NSQ_SOURCE_LINE 00001137 ""
NSQ_SOURCE_LINE 00001138 "            $self->extract_path( $dir );"
NSQ_SOURCE_LINE 00001139 "        }"
NSQ_SOURCE_LINE 00001140 "    }"
NSQ_SOURCE_LINE 00001141 ""
NSQ_SOURCE_LINE 00001142 "    return 1;"
NSQ_SOURCE_LINE 00001143 "}"
NSQ_SOURCE_LINE 00001144 ""
NSQ_SOURCE_LINE 00001145 "sub _unzip_az {"
NSQ_SOURCE_LINE 00001146 "    my $self = shift;"
NSQ_SOURCE_LINE 00001147 ""
NSQ_SOURCE_LINE 00001148 "    my $use_list = { 'Archive::Zip' => '0.0' };"
NSQ_SOURCE_LINE 00001149 "    unless( can_load( modules => $use_list ) ) {"
NSQ_SOURCE_LINE 00001150 "        $self->_error(loc(\"You do not have '%1' installed - Please \" ."
NSQ_SOURCE_LINE 00001151 "                      \"install it as soon as possible.\", 'Archive::Zip'));"
NSQ_SOURCE_LINE 00001152 "        return METHOD_NA;"
NSQ_SOURCE_LINE 00001153 "    }"
NSQ_SOURCE_LINE 00001154 ""
NSQ_SOURCE_LINE 00001155 "    my $zip = Archive::Zip->new();"
NSQ_SOURCE_LINE 00001156 ""
NSQ_SOURCE_LINE 00001157 "    unless( $zip->read( $self->archive ) == &Archive::Zip::AZ_OK ) {"
NSQ_SOURCE_LINE 00001158 "        return $self->_error(loc(\"Unable to read '%1'\", $self->archive));"
NSQ_SOURCE_LINE 00001159 "    }"
NSQ_SOURCE_LINE 00001160 ""
NSQ_SOURCE_LINE 00001161 "    my @files;"
NSQ_SOURCE_LINE 00001162 ""
NSQ_SOURCE_LINE 00001163 ""
NSQ_SOURCE_LINE 00001164 "    ### Address: #43278: Explicitly tell Archive::Zip where to put the files:"
NSQ_SOURCE_LINE 00001165 "    ### \"In my BackPAN indexing, Archive::Zip was extracting things"
NSQ_SOURCE_LINE 00001166 "    ### in my script's directory instead of the current working directory."
NSQ_SOURCE_LINE 00001167 "    ### I traced this back through Archive::Zip::_asLocalName which"
NSQ_SOURCE_LINE 00001168 "    ### eventually calls File::Spec::Win32::rel2abs which on Windows might"
NSQ_SOURCE_LINE 00001169 "    ### call Cwd::getdcwd. getdcwd returns the wrong directory in my"
NSQ_SOURCE_LINE 00001170 "    ### case, even though I think I'm on the same drive."
NSQ_SOURCE_LINE 00001171 "    ###"
NSQ_SOURCE_LINE 00001172 "    ### To fix this, I pass the optional second argument to"
NSQ_SOURCE_LINE 00001173 "    ### extractMember using the cwd from Archive::Extract.\" --bdfoy"
NSQ_SOURCE_LINE 00001174 ""
NSQ_SOURCE_LINE 00001175 "    ## store cwd() before looping; calls to cwd() can be expensive, and"
NSQ_SOURCE_LINE 00001176 "    ### it won't change during the loop"
NSQ_SOURCE_LINE 00001177 "    my $extract_dir = cwd();"
NSQ_SOURCE_LINE 00001178 ""
NSQ_SOURCE_LINE 00001179 "    ### have to extract every member individually ###"
NSQ_SOURCE_LINE 00001180 "    for my $member ($zip->members) {"
NSQ_SOURCE_LINE 00001181 "        push @files, $member->{fileName};"
NSQ_SOURCE_LINE 00001182 ""
NSQ_SOURCE_LINE 00001183 "        ### file to extract to, to avoid the above problem"
NSQ_SOURCE_LINE 00001184 "        my $to = File::Spec->catfile( $extract_dir, $member->{fileName} );"
NSQ_SOURCE_LINE 00001185 ""
NSQ_SOURCE_LINE 00001186 "        unless( $zip->extractMember($member, $to) == &Archive::Zip::AZ_OK ) {"
NSQ_SOURCE_LINE 00001187 "            return $self->_error(loc(\"Extraction of '%1' from '%2' failed\","
NSQ_SOURCE_LINE 00001188 "                        $member->{fileName}, $self->archive ));"
NSQ_SOURCE_LINE 00001189 "        }"
NSQ_SOURCE_LINE 00001190 "    }"
NSQ_SOURCE_LINE 00001191 ""
NSQ_SOURCE_LINE 00001192 "    my $dir = $self->__get_extract_dir( \\@files );"
NSQ_SOURCE_LINE 00001193 ""
NSQ_SOURCE_LINE 00001194 "    ### set what files where extract, and where they went ###"
NSQ_SOURCE_LINE 00001195 "    $self->files( \\@files );"
NSQ_SOURCE_LINE 00001196 "    $self->extract_path( File::Spec->rel2abs($dir) );"
NSQ_SOURCE_LINE 00001197 ""
NSQ_SOURCE_LINE 00001198 "    return 1;"
NSQ_SOURCE_LINE 00001199 "}"
NSQ_SOURCE_LINE 00001200 ""
NSQ_SOURCE_LINE 00001201 "sub __get_extract_dir {"
NSQ_SOURCE_LINE 00001202 "    my $self    = shift;"
NSQ_SOURCE_LINE 00001203 "    my $files   = shift || [];"
NSQ_SOURCE_LINE 00001204 ""
NSQ_SOURCE_LINE 00001205 "    return unless scalar @$files;"
NSQ_SOURCE_LINE 00001206 ""
NSQ_SOURCE_LINE 00001207 "    my($dir1, $dir2);"
NSQ_SOURCE_LINE 00001208 "    for my $aref ( [ \\$dir1, 0 ], [ \\$dir2, -1 ] ) {"
NSQ_SOURCE_LINE 00001209 "        my($dir,$pos) = @$aref;"
NSQ_SOURCE_LINE 00001210 ""
NSQ_SOURCE_LINE 00001211 "        ### add a catdir(), so that any trailing slashes get"
NSQ_SOURCE_LINE 00001212 "        ### take care of (removed)"
NSQ_SOURCE_LINE 00001213 "        ### also, a catdir() normalises './dir/foo' to 'dir/foo';"
NSQ_SOURCE_LINE 00001214 "        ### which was the problem in bug #23999"
NSQ_SOURCE_LINE 00001215 "        my $res = -d $files->[$pos]"
NSQ_SOURCE_LINE 00001216 "                    ? File::Spec->catdir( $files->[$pos], '' )"
NSQ_SOURCE_LINE 00001217 "                    : File::Spec->catdir( dirname( $files->[$pos] ) );"
NSQ_SOURCE_LINE 00001218 ""
NSQ_SOURCE_LINE 00001219 "        $$dir = $res;"
NSQ_SOURCE_LINE 00001220 "    }"
NSQ_SOURCE_LINE 00001221 ""
NSQ_SOURCE_LINE 00001222 "    ### if the first and last dir don't match, make sure the"
NSQ_SOURCE_LINE 00001223 "    ### dirname is not set wrongly"
NSQ_SOURCE_LINE 00001224 "    my $dir;"
NSQ_SOURCE_LINE 00001225 ""
NSQ_SOURCE_LINE 00001226 "    ### dirs are the same, so we know for sure what the extract dir is"
NSQ_SOURCE_LINE 00001227 "    if( $dir1 eq $dir2 ) {"
NSQ_SOURCE_LINE 00001228 "        $dir = $dir1;"
NSQ_SOURCE_LINE 00001229 ""
NSQ_SOURCE_LINE 00001230 "    ### dirs are different.. do they share the base dir?"
NSQ_SOURCE_LINE 00001231 "    ### if so, use that, if not, fall back to '.'"
NSQ_SOURCE_LINE 00001232 "    } else {"
NSQ_SOURCE_LINE 00001233 "        my $base1 = [ File::Spec->splitdir( $dir1 ) ]->[0];"
NSQ_SOURCE_LINE 00001234 "        my $base2 = [ File::Spec->splitdir( $dir2 ) ]->[0];"
NSQ_SOURCE_LINE 00001235 ""
NSQ_SOURCE_LINE 00001236 "        $dir = File::Spec->rel2abs( $base1 eq $base2 ? $base1 : '.' );"
NSQ_SOURCE_LINE 00001237 "    }"
NSQ_SOURCE_LINE 00001238 ""
NSQ_SOURCE_LINE 00001239 "    return File::Spec->rel2abs( $dir );"
NSQ_SOURCE_LINE 00001240 "}"
NSQ_SOURCE_LINE 00001241 ""
NSQ_SOURCE_LINE 00001242 "#################################"
NSQ_SOURCE_LINE 00001243 "#"
NSQ_SOURCE_LINE 00001244 "# Bunzip2 code"
NSQ_SOURCE_LINE 00001245 "#"
NSQ_SOURCE_LINE 00001246 "#################################"
NSQ_SOURCE_LINE 00001247 ""
NSQ_SOURCE_LINE 00001248 "sub _bunzip2_bin {"
NSQ_SOURCE_LINE 00001249 "    my $self = shift;"
NSQ_SOURCE_LINE 00001250 ""
NSQ_SOURCE_LINE 00001251 "    ### check for /bin/gzip -- we need it ###"
NSQ_SOURCE_LINE 00001252 "    unless( $self->bin_bunzip2 ) {"
NSQ_SOURCE_LINE 00001253 "        $self->_error(loc(\"No '%1' program found\", '/bin/bunzip2'));"
NSQ_SOURCE_LINE 00001254 "        return METHOD_NA;"
NSQ_SOURCE_LINE 00001255 "    }"
NSQ_SOURCE_LINE 00001256 ""
NSQ_SOURCE_LINE 00001257 "    my $fh = FileHandle->new('>'. $self->_gunzip_to) or"
NSQ_SOURCE_LINE 00001258 "        return $self->_error(loc(\"Could not open '%1' for writing: %2\","
NSQ_SOURCE_LINE 00001259 "                            $self->_gunzip_to, $! ));"
NSQ_SOURCE_LINE 00001260 ""
NSQ_SOURCE_LINE 00001261 "    ### guard against broken bunzip2. See ->have_old_bunzip2()"
NSQ_SOURCE_LINE 00001262 "    ### for details"
NSQ_SOURCE_LINE 00001263 "    if( $self->have_old_bunzip2 and $self->archive !~ /\\.bz2$/i ) {"
NSQ_SOURCE_LINE 00001264 "        return $self->_error(loc(\"Your bunzip2 version is too old and \"."
NSQ_SOURCE_LINE 00001265 "                                 \"can only extract files ending in '%1'\","
NSQ_SOURCE_LINE 00001266 "                                 '.bz2'));"
NSQ_SOURCE_LINE 00001267 "    }"
NSQ_SOURCE_LINE 00001268 ""
NSQ_SOURCE_LINE 00001269 "    my $cmd = [ $self->bin_bunzip2, '-cd', $self->archive ];"
NSQ_SOURCE_LINE 00001270 ""
NSQ_SOURCE_LINE 00001271 "    my $buffer;"
NSQ_SOURCE_LINE 00001272 "    unless( scalar run( command => $cmd,"
NSQ_SOURCE_LINE 00001273 "                        verbose => $DEBUG,"
NSQ_SOURCE_LINE 00001274 "                        buffer  => \\$buffer )"
NSQ_SOURCE_LINE 00001275 "    ) {"
NSQ_SOURCE_LINE 00001276 "        return $self->_error(loc(\"Unable to bunzip2 '%1': %2\","
NSQ_SOURCE_LINE 00001277 "                                    $self->archive, $buffer));"
NSQ_SOURCE_LINE 00001278 "    }"
NSQ_SOURCE_LINE 00001279 ""
NSQ_SOURCE_LINE 00001280 "    ### no buffers available?"
NSQ_SOURCE_LINE 00001281 "    if( !IPC::Cmd->can_capture_buffer and !$buffer ) {"
NSQ_SOURCE_LINE 00001282 "        $self->_error( $self->_no_buffer_content( $self->archive ) );"
NSQ_SOURCE_LINE 00001283 "    }"
NSQ_SOURCE_LINE 00001284 ""
NSQ_SOURCE_LINE 00001285 "    $self->_print($fh, $buffer) if defined $buffer;"
NSQ_SOURCE_LINE 00001286 ""
NSQ_SOURCE_LINE 00001287 "    close $fh;"
NSQ_SOURCE_LINE 00001288 ""
NSQ_SOURCE_LINE 00001289 "    ### set what files where extract, and where they went ###"
NSQ_SOURCE_LINE 00001290 "    $self->files( [$self->_gunzip_to] );"
NSQ_SOURCE_LINE 00001291 "    $self->extract_path( File::Spec->rel2abs(cwd()) );"
NSQ_SOURCE_LINE 00001292 ""
NSQ_SOURCE_LINE 00001293 "    return 1;"
NSQ_SOURCE_LINE 00001294 "}"
NSQ_SOURCE_LINE 00001295 ""
NSQ_SOURCE_LINE 00001296 "### using cz2, the compact versions... this we use mainly in archive::tar"
NSQ_SOURCE_LINE 00001297 "### extractor.."
NSQ_SOURCE_LINE 00001298 "# sub _bunzip2_cz1 {"
NSQ_SOURCE_LINE 00001299 "#     my $self = shift;"
NSQ_SOURCE_LINE 00001300 "#"
NSQ_SOURCE_LINE 00001301 "#     my $use_list = { 'IO::Uncompress::Bunzip2' => '0.0' };"
NSQ_SOURCE_LINE 00001302 "#     unless( can_load( modules => $use_list ) ) {"
NSQ_SOURCE_LINE 00001303 "#         return $self->_error(loc(\"You do not have '%1' installed - Please \" ."
NSQ_SOURCE_LINE 00001304 "#                         \"install it as soon as possible.\","
NSQ_SOURCE_LINE 00001305 "#                         'IO::Uncompress::Bunzip2'));"
NSQ_SOURCE_LINE 00001306 "#     }"
