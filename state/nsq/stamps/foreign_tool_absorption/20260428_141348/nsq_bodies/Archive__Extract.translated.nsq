BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Archive::Extract;"
NSQ_SOURCE_LINE 00000002 "use if $] > 5.017, 'deprecate';"
NSQ_SOURCE_LINE 00000003 ""
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use Cwd                         qw[cwd chdir];"
NSQ_SOURCE_LINE 00000007 "use Carp                        qw[carp];"
NSQ_SOURCE_LINE 00000008 "use IPC::Cmd                    qw[run can_run];"
NSQ_SOURCE_LINE 00000009 "use FileHandle;"
NSQ_SOURCE_LINE 00000010 "use File::Path                  qw[mkpath];"
NSQ_SOURCE_LINE 00000011 "use File::Spec;"
NSQ_SOURCE_LINE 00000012 "use File::Basename              qw[dirname basename];"
NSQ_SOURCE_LINE 00000013 "use Params::Check               qw[check];"
NSQ_SOURCE_LINE 00000014 "use Module::Load::Conditional   qw[can_load check_install];"
NSQ_SOURCE_LINE 00000015 "use Locale::Maketext::Simple    Style => 'gettext';"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "### solaris has silly /bin/tar output ###"
NSQ_SOURCE_LINE 00000018 "use constant ON_SOLARIS     => $^O eq 'solaris' ? 1 : 0;"
NSQ_SOURCE_LINE 00000019 "use constant ON_NETBSD      => $^O =~ m!^(netbsd|minix)$! ? 1 : 0;"
NSQ_SOURCE_LINE 00000020 "use constant ON_OPENBSD     => $^O =~ m!^(openbsd|bitrig)$! ? 1 : 0;"
NSQ_SOURCE_LINE 00000021 "use constant ON_FREEBSD     => $^O =~ m!^(free|midnight|dragonfly)(bsd)?$! ? 1 : 0;"
NSQ_SOURCE_LINE 00000022 "use constant ON_LINUX       => $^O eq 'linux' ? 1 : 0;"
NSQ_SOURCE_LINE 00000023 "use constant FILE_EXISTS    => sub { -e $_[0] ? 1 : 0 };"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "### VMS may require quoting upper case command options"
NSQ_SOURCE_LINE 00000026 "use constant ON_VMS         => $^O eq 'VMS' ? 1 : 0;"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "### Windows needs special treatment of Tar options"
NSQ_SOURCE_LINE 00000029 "use constant ON_WIN32       => $^O eq 'MSWin32' ? 1 : 0;"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "### we can't use this extraction method, because of missing"
NSQ_SOURCE_LINE 00000032 "### modules/binaries:"
NSQ_SOURCE_LINE 00000033 "use constant METHOD_NA      => [];"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "### If these are changed, update @TYPES and the new() POD"
NSQ_SOURCE_LINE 00000036 "use constant TGZ            => 'tgz';"
NSQ_SOURCE_LINE 00000037 "use constant TAR            => 'tar';"
NSQ_SOURCE_LINE 00000038 "use constant GZ             => 'gz';"
NSQ_SOURCE_LINE 00000039 "use constant ZIP            => 'zip';"
NSQ_SOURCE_LINE 00000040 "use constant BZ2            => 'bz2';"
NSQ_SOURCE_LINE 00000041 "use constant TBZ            => 'tbz';"
NSQ_SOURCE_LINE 00000042 "use constant Z              => 'Z';"
NSQ_SOURCE_LINE 00000043 "use constant LZMA           => 'lzma';"
NSQ_SOURCE_LINE 00000044 "use constant XZ             => 'xz';"
NSQ_SOURCE_LINE 00000045 "use constant TXZ            => 'txz';"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "use vars qw[$VERSION $PREFER_BIN $PROGRAMS $WARN $DEBUG"
NSQ_SOURCE_LINE 00000048 "            $_ALLOW_BIN $_ALLOW_PURE_PERL $_ALLOW_TAR_ITER"
NSQ_SOURCE_LINE 00000049 "         ];"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "$VERSION            = '0.88';"
NSQ_SOURCE_LINE 00000052 "$PREFER_BIN         = 0;"
NSQ_SOURCE_LINE 00000053 "$WARN               = 1;"
NSQ_SOURCE_LINE 00000054 "$DEBUG              = 0;"
NSQ_SOURCE_LINE 00000055 "$_ALLOW_PURE_PERL   = 1;    # allow pure perl extractors"
NSQ_SOURCE_LINE 00000056 "$_ALLOW_BIN         = 1;    # allow binary extractors"
NSQ_SOURCE_LINE 00000057 "$_ALLOW_TAR_ITER    = 1;    # try to use Archive::Tar->iter if available"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "# same as all constants"
NSQ_SOURCE_LINE 00000060 "my @Types           = ( TGZ, TAR, GZ, ZIP, BZ2, TBZ, Z, LZMA, XZ, TXZ );"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "local $Params::Check::VERBOSE = $Params::Check::VERBOSE = 1;"
NSQ_SOURCE_LINE 00000063 "local $Module::Load::Conditional::FORCE_SAFE_INC = 1;"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "=pod"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "=head1 NAME"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "Archive::Extract - A generic archive extracting mechanism"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "    use Archive::Extract;"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "    ### build an Archive::Extract object ###"
NSQ_SOURCE_LINE 00000076 "    my $ae = Archive::Extract->new( archive => 'foo.tgz' );"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "    ### extract to cwd() ###"
NSQ_SOURCE_LINE 00000079 "    my $ok = $ae->extract;"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "    ### extract to /tmp ###"
NSQ_SOURCE_LINE 00000082 "    my $ok = $ae->extract( to => '/tmp' );"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "    ### what if something went wrong?"
NSQ_SOURCE_LINE 00000085 "    my $ok = $ae->extract or die $ae->error;"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "    ### files from the archive ###"
NSQ_SOURCE_LINE 00000088 "    my $files   = $ae->files;"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "    ### dir that was extracted to ###"
NSQ_SOURCE_LINE 00000091 "    my $outdir  = $ae->extract_path;"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "    ### quick check methods ###"
NSQ_SOURCE_LINE 00000095 "    $ae->is_tar     # is it a .tar file?"
NSQ_SOURCE_LINE 00000096 "    $ae->is_tgz     # is it a .tar.gz or .tgz file?"
NSQ_SOURCE_LINE 00000097 "    $ae->is_gz;     # is it a .gz file?"
NSQ_SOURCE_LINE 00000098 "    $ae->is_zip;    # is it a .zip file?"
NSQ_SOURCE_LINE 00000099 "    $ae->is_bz2;    # is it a .bz2 file?"
NSQ_SOURCE_LINE 00000100 "    $ae->is_tbz;    # is it a .tar.bz2 or .tbz file?"
NSQ_SOURCE_LINE 00000101 "    $ae->is_lzma;   # is it a .lzma file?"
NSQ_SOURCE_LINE 00000102 "    $ae->is_xz;     # is it a .xz file?"
NSQ_SOURCE_LINE 00000103 "    $ae->is_txz;    # is it a .tar.xz or .txz file?"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "    ### absolute path to the archive you provided ###"
NSQ_SOURCE_LINE 00000106 "    $ae->archive;"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "    ### commandline tools, if found ###"
NSQ_SOURCE_LINE 00000109 "    $ae->bin_tar     # path to /bin/tar, if found"
NSQ_SOURCE_LINE 00000110 "    $ae->bin_gzip    # path to /bin/gzip, if found"
NSQ_SOURCE_LINE 00000111 "    $ae->bin_unzip   # path to /bin/unzip, if found"
NSQ_SOURCE_LINE 00000112 "    $ae->bin_bunzip2 # path to /bin/bunzip2 if found"
NSQ_SOURCE_LINE 00000113 "    $ae->bin_unlzma  # path to /bin/unlzma if found"
NSQ_SOURCE_LINE 00000114 "    $ae->bin_unxz    # path to /bin/unxz if found"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "Archive::Extract is a generic archive extraction mechanism."
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "It allows you to extract any archive file of the type .tar, .tar.gz,"
NSQ_SOURCE_LINE 00000121 ".gz, .Z, tar.bz2, .tbz, .bz2, .zip, .xz,, .txz, .tar.xz or .lzma"
NSQ_SOURCE_LINE 00000122 "without having to worry how it"
NSQ_SOURCE_LINE 00000123 "does so, or use different interfaces for each type by using either"
NSQ_SOURCE_LINE 00000124 "perl modules, or commandline tools on your system."
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "See the C<HOW IT WORKS> section further down for details."
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "=cut"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "### see what /bin/programs are available ###"
NSQ_SOURCE_LINE 00000132 "$PROGRAMS = {};"
NSQ_SOURCE_LINE 00000133 "CMD: for my $pgm (qw[tar unzip gzip bunzip2 uncompress unlzma unxz]) {"
NSQ_SOURCE_LINE 00000134 "    if ( $pgm eq 'unzip' and ON_FREEBSD and my $unzip = can_run('info-unzip') ) {"
NSQ_SOURCE_LINE 00000135 "      $PROGRAMS->{$pgm} = $unzip;"
NSQ_SOURCE_LINE 00000136 "      next CMD;"
NSQ_SOURCE_LINE 00000137 "    }"
NSQ_SOURCE_LINE 00000138 "    if ( $pgm eq 'unzip' and ( ON_FREEBSD || ON_LINUX ) ) {"
NSQ_SOURCE_LINE 00000139 "      local $IPC::Cmd::INSTANCES = 1;"
NSQ_SOURCE_LINE 00000140 "      ($PROGRAMS->{$pgm}) = grep { _is_infozip_esque($_) } can_run($pgm);"
NSQ_SOURCE_LINE 00000141 "      next CMD;"
NSQ_SOURCE_LINE 00000142 "    }"
NSQ_SOURCE_LINE 00000143 "    if ( $pgm eq 'unzip' and ON_NETBSD ) {"
NSQ_SOURCE_LINE 00000144 "      local $IPC::Cmd::INSTANCES = 1;"
NSQ_SOURCE_LINE 00000145 "      ($PROGRAMS->{$pgm}) = grep { m!/usr/pkg/! } can_run($pgm);"
NSQ_SOURCE_LINE 00000146 "      next CMD;"
NSQ_SOURCE_LINE 00000147 "    }"
NSQ_SOURCE_LINE 00000148 "    if ( $pgm eq 'tar' and ( ON_OPENBSD || ON_SOLARIS || ON_NETBSD ) ) {"
NSQ_SOURCE_LINE 00000149 "      # try gtar first"
NSQ_SOURCE_LINE 00000150 "      next CMD if $PROGRAMS->{$pgm} = can_run('gtar');"
NSQ_SOURCE_LINE 00000151 "    }"
NSQ_SOURCE_LINE 00000152 "    $PROGRAMS->{$pgm} = can_run($pgm);"
NSQ_SOURCE_LINE 00000153 "}"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "### mapping from types to extractor methods ###"
NSQ_SOURCE_LINE 00000156 "my $Mapping = {  # binary program           # pure perl module"
NSQ_SOURCE_LINE 00000157 "    is_tgz  => { bin => '_untar_bin',       pp => '_untar_at'   },"
NSQ_SOURCE_LINE 00000158 "    is_tar  => { bin => '_untar_bin',       pp => '_untar_at'   },"
NSQ_SOURCE_LINE 00000159 "    is_gz   => { bin => '_gunzip_bin',      pp => '_gunzip_cz'  },"
NSQ_SOURCE_LINE 00000160 "    is_zip  => { bin => '_unzip_bin',       pp => '_unzip_az'   },"
NSQ_SOURCE_LINE 00000161 "    is_tbz  => { bin => '_untar_bin',       pp => '_untar_at'   },"
NSQ_SOURCE_LINE 00000162 "    is_bz2  => { bin => '_bunzip2_bin',     pp => '_bunzip2_bz2'},"
NSQ_SOURCE_LINE 00000163 "    is_Z    => { bin => '_uncompress_bin',  pp => '_gunzip_cz'  },"
NSQ_SOURCE_LINE 00000164 "    is_lzma => { bin => '_unlzma_bin',      pp => '_unlzma_cz'  },"
NSQ_SOURCE_LINE 00000165 "    is_xz   => { bin => '_unxz_bin',        pp => '_unxz_cz'    },"
NSQ_SOURCE_LINE 00000166 "    is_txz  => { bin => '_untar_bin',       pp => '_untar_at'   },"
NSQ_SOURCE_LINE 00000167 "};"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "{   ### use subs so we re-generate array refs etc for the no-override flags"
NSQ_SOURCE_LINE 00000170 "    ### if we don't, then we reuse the same arrayref, meaning objects store"
NSQ_SOURCE_LINE 00000171 "    ### previous errors"
NSQ_SOURCE_LINE 00000172 "    my $tmpl = {"
NSQ_SOURCE_LINE 00000173 "        archive         => sub { { required => 1, allow => FILE_EXISTS }    },"
NSQ_SOURCE_LINE 00000174 "        type            => sub { { default => '', allow => [ @Types ] }     },"
NSQ_SOURCE_LINE 00000175 "        _error_msg      => sub { { no_override => 1, default => [] }        },"
NSQ_SOURCE_LINE 00000176 "        _error_msg_long => sub { { no_override => 1, default => [] }        },"
NSQ_SOURCE_LINE 00000177 "    };"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "    ### build accessors ###"
NSQ_SOURCE_LINE 00000180 "    for my $method( keys %$tmpl,"
NSQ_SOURCE_LINE 00000181 "                    qw[_extractor _gunzip_to files extract_path],"
NSQ_SOURCE_LINE 00000182 "    ) {"
NSQ_SOURCE_LINE 00000183 "        no strict 'refs';"
NSQ_SOURCE_LINE 00000184 "        *$method = sub {"
NSQ_SOURCE_LINE 00000185 "                        my $self = shift;"
NSQ_SOURCE_LINE 00000186 "                        $self->{$method} = $_[0] if @_;"
NSQ_SOURCE_LINE 00000187 "                        return $self->{$method};"
NSQ_SOURCE_LINE 00000188 "                    }"
NSQ_SOURCE_LINE 00000189 "    }"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "sub type_for {"
NSQ_SOURCE_LINE 00000192 "    local $_ = shift;"
NSQ_SOURCE_LINE 00000193 "    return /.+?\\.(?:tar\\.gz|tgz)$/i         ? TGZ   :"
NSQ_SOURCE_LINE 00000194 "           /.+?\\.gz$/i                      ? GZ    :"
NSQ_SOURCE_LINE 00000195 "           /.+?\\.tar$/i                     ? TAR   :"
NSQ_SOURCE_LINE 00000196 "           /.+?\\.(zip|jar|ear|war|par)$/i   ? ZIP   :"
NSQ_SOURCE_LINE 00000197 "           /.+?\\.(?:tbz2?|tar\\.bz2?)$/i     ? TBZ   :"
NSQ_SOURCE_LINE 00000198 "           /.+?\\.bz2$/i                     ? BZ2   :"
NSQ_SOURCE_LINE 00000199 "           /.+?\\.Z$/                        ? Z     :"
NSQ_SOURCE_LINE 00000200 "           /.+?\\.lzma$/                     ? LZMA  :"
NSQ_SOURCE_LINE 00000201 "           /.+?\\.(?:txz|tar\\.xz)$/i         ? TXZ   :"
NSQ_SOURCE_LINE 00000202 "           /.+?\\.xz$/                       ? XZ    :"
NSQ_SOURCE_LINE 00000203 "           '';"
NSQ_SOURCE_LINE 00000204 "}"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "=head1 METHODS"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "=head2 $ae = Archive::Extract->new(archive => '/path/to/archive',[type => TYPE])"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "Creates a new C<Archive::Extract> object based on the archive file you"
NSQ_SOURCE_LINE 00000211 "passed it. Automatically determines the type of archive based on the"
NSQ_SOURCE_LINE 00000212 "extension, but you can override that by explicitly providing the"
NSQ_SOURCE_LINE 00000213 "C<type> argument, potentially by calling C<type_for()>."
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "Valid values for C<type> are:"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "=over 4"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "=item tar"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "Standard tar files, as produced by, for example, C</bin/tar>."
NSQ_SOURCE_LINE 00000222 "Corresponds to a C<.tar> suffix."
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "=item tgz"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "Gzip compressed tar files, as produced by, for example C</bin/tar -z>."
NSQ_SOURCE_LINE 00000227 "Corresponds to a C<.tgz> or C<.tar.gz> suffix."
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "=item gz"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "Gzip compressed file, as produced by, for example C</bin/gzip>."
NSQ_SOURCE_LINE 00000232 "Corresponds to a C<.gz> suffix."
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "=item Z"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "Lempel-Ziv compressed file, as produced by, for example C</bin/compress>."
NSQ_SOURCE_LINE 00000237 "Corresponds to a C<.Z> suffix."
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "=item zip"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "Zip compressed file, as produced by, for example C</bin/zip>."
NSQ_SOURCE_LINE 00000242 "Corresponds to a C<.zip>, C<.jar> or C<.par> suffix."
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "=item bz2"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "Bzip2 compressed file, as produced by, for example, C</bin/bzip2>."
NSQ_SOURCE_LINE 00000247 "Corresponds to a C<.bz2> suffix."
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "=item tbz"
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "Bzip2 compressed tar file, as produced by, for example C</bin/tar -j>."
NSQ_SOURCE_LINE 00000252 "Corresponds to a C<.tbz> or C<.tar.bz2> suffix."
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "=item lzma"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "Lzma compressed file, as produced by C</bin/lzma>."
NSQ_SOURCE_LINE 00000257 "Corresponds to a C<.lzma> suffix."
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "=item xz"
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "Xz compressed file, as produced by C</bin/xz>."
NSQ_SOURCE_LINE 00000262 "Corresponds to a C<.xz> suffix."
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "=item txz"
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "Xz compressed tar file, as produced by, for example C</bin/tar -J>."
NSQ_SOURCE_LINE 00000267 "Corresponds to a C<.txz> or C<.tar.xz> suffix."
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "=back"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "Returns a C<Archive::Extract> object on success, or false on failure."
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "=cut"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "    ### constructor ###"
NSQ_SOURCE_LINE 00000276 "    sub new {"
NSQ_SOURCE_LINE 00000277 "        my $class   = shift;"
NSQ_SOURCE_LINE 00000278 "        my %hash    = @_;"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "        ### see above why we use subs here and generate the template;"
NSQ_SOURCE_LINE 00000281 "        ### it's basically to not re-use arrayrefs"
NSQ_SOURCE_LINE 00000282 "        my %utmpl   = map { $_ => $tmpl->{$_}->() } keys %$tmpl;"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "        my $parsed = check( \\%utmpl, \\%hash ) or return;"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "        ### make sure we have an absolute path ###"
NSQ_SOURCE_LINE 00000287 "        my $ar = $parsed->{archive} = File::Spec->rel2abs( $parsed->{archive} );"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "        ### figure out the type, if it wasn't already specified ###"
NSQ_SOURCE_LINE 00000290 "        $parsed->{type} ||= type_for $ar;"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "        bless $parsed, $class;"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "        ### don't know what type of file it is"
NSQ_SOURCE_LINE 00000295 "        ### XXX this *has* to be an object call, not a package call"
NSQ_SOURCE_LINE 00000296 "        return $parsed->_error(loc(\"Cannot determine file type for '%1'\","
NSQ_SOURCE_LINE 00000297 "                                $parsed->{archive} )) unless $parsed->{type};"
NSQ_SOURCE_LINE 00000298 "        return $parsed;"
NSQ_SOURCE_LINE 00000299 "    }"
NSQ_SOURCE_LINE 00000300 "}"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "=head2 $ae->extract( [to => '/output/path'] )"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "Extracts the archive represented by the C<Archive::Extract> object to"
NSQ_SOURCE_LINE 00000305 "the path of your choice as specified by the C<to> argument. Defaults to"
NSQ_SOURCE_LINE 00000306 "C<cwd()>."
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "Since C<.gz> files never hold a directory, but only a single file; if"
NSQ_SOURCE_LINE 00000309 "the C<to> argument is an existing directory, the file is extracted"
NSQ_SOURCE_LINE 00000310 "there, with its C<.gz> suffix stripped."
NSQ_SOURCE_LINE 00000311 "If the C<to> argument is not an existing directory, the C<to> argument"
NSQ_SOURCE_LINE 00000312 "is understood to be a filename, if the archive type is C<gz>."
NSQ_SOURCE_LINE 00000313 "In the case that you did not specify a C<to> argument, the output"
NSQ_SOURCE_LINE 00000314 "file will be the name of the archive file, stripped from its C<.gz>"
NSQ_SOURCE_LINE 00000315 "suffix, in the current working directory."
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "C<extract> will try a pure perl solution first, and then fall back to"
NSQ_SOURCE_LINE 00000318 "commandline tools if they are available. See the C<GLOBAL VARIABLES>"
NSQ_SOURCE_LINE 00000319 "section below on how to alter this behaviour."
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "It will return true on success, and false on failure."
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "On success, it will also set the follow attributes in the object:"
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "=over 4"
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "=item $ae->extract_path"
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "This is the directory that the files where extracted to."
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "=item $ae->files"
NSQ_SOURCE_LINE 00000332 ""
NSQ_SOURCE_LINE 00000333 "This is an array ref with the paths of all the files in the archive,"
NSQ_SOURCE_LINE 00000334 "relative to the C<to> argument you specified."
NSQ_SOURCE_LINE 00000335 "To get the full path to an extracted file, you would use:"
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "    File::Spec->catfile( $to, $ae->files->[0] );"
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "Note that all files from a tar archive will be in unix format, as per"
NSQ_SOURCE_LINE 00000340 "the tar specification."
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "=back"
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "=cut"
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "sub extract {"
NSQ_SOURCE_LINE 00000347 "    my $self = shift;"
NSQ_SOURCE_LINE 00000348 "    my %hash = @_;"
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "    ### reset error messages"
NSQ_SOURCE_LINE 00000351 "    $self->_error_msg( [] );"
NSQ_SOURCE_LINE 00000352 "    $self->_error_msg_long( [] );"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "    my $to;"
NSQ_SOURCE_LINE 00000355 "    my $tmpl = {"
NSQ_SOURCE_LINE 00000356 "        to  => { default => '.', store => \\$to }"
NSQ_SOURCE_LINE 00000357 "    };"
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "    check( $tmpl, \\%hash ) or return;"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "    ### so 'to' could be a file or a dir, depending on whether it's a .gz"
NSQ_SOURCE_LINE 00000362 "    ### file, or basically anything else."
NSQ_SOURCE_LINE 00000363 "    ### so, check that, then act accordingly."
NSQ_SOURCE_LINE 00000364 "    ### set an accessor specifically so _gunzip can know what file to extract"
NSQ_SOURCE_LINE 00000365 "    ### to."
NSQ_SOURCE_LINE 00000366 "    my $dir;"
NSQ_SOURCE_LINE 00000367 "    {   ### a foo.gz file"
NSQ_SOURCE_LINE 00000368 "        if( $self->is_gz or $self->is_bz2 or $self->is_Z or $self->is_lzma or $self->is_xz ) {"
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "            my $cp = $self->archive; $cp =~ s/\\.(?:gz|bz2?|Z|lzma|xz)$//i;"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "            ### to is a dir?"
NSQ_SOURCE_LINE 00000373 "            if ( -d $to ) {"
NSQ_SOURCE_LINE 00000374 "                $dir = $to;"
NSQ_SOURCE_LINE 00000375 "                $self->_gunzip_to( basename($cp) );"
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "            ### then it's a filename"
NSQ_SOURCE_LINE 00000378 "            } else {"
NSQ_SOURCE_LINE 00000379 "                $dir = dirname($to);"
NSQ_SOURCE_LINE 00000380 "                $self->_gunzip_to( basename($to) );"
NSQ_SOURCE_LINE 00000381 "            }"
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "        ### not a foo.gz file"
NSQ_SOURCE_LINE 00000384 "        } else {"
NSQ_SOURCE_LINE 00000385 "            $dir = $to;"
NSQ_SOURCE_LINE 00000386 "        }"
NSQ_SOURCE_LINE 00000387 "    }"
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "    ### make the dir if it doesn't exist ###"
NSQ_SOURCE_LINE 00000390 "    unless( -d $dir ) {"
NSQ_SOURCE_LINE 00000391 "        eval { mkpath( $dir ) };"
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "        return $self->_error(loc(\"Could not create path '%1': %2\", $dir, $@))"
NSQ_SOURCE_LINE 00000394 "            if $@;"
NSQ_SOURCE_LINE 00000395 "    }"
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "    ### get the current dir, to restore later ###"
NSQ_SOURCE_LINE 00000398 "    my $cwd = cwd();"
NSQ_SOURCE_LINE 00000399 ""
NSQ_SOURCE_LINE 00000400 "    my $ok = 1;"
NSQ_SOURCE_LINE 00000401 "    EXTRACT: {"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "        ### chdir to the target dir ###"
NSQ_SOURCE_LINE 00000404 "        unless( chdir $dir ) {"
NSQ_SOURCE_LINE 00000405 "            $self->_error(loc(\"Could not chdir to '%1': %2\", $dir, $!));"
NSQ_SOURCE_LINE 00000406 "            $ok = 0; last EXTRACT;"
NSQ_SOURCE_LINE 00000407 "        }"
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "        ### set files to an empty array ref, so there's always an array"
NSQ_SOURCE_LINE 00000410 "        ### ref IN the accessor, to avoid errors like:"
NSQ_SOURCE_LINE 00000411 "        ### Can't use an undefined value as an ARRAY reference at"
NSQ_SOURCE_LINE 00000412 "        ### ../lib/Archive/Extract.pm line 742. (rt #19815)"
NSQ_SOURCE_LINE 00000413 "        $self->files( [] );"
NSQ_SOURCE_LINE 00000414 ""
NSQ_SOURCE_LINE 00000415 "        ### find out the dispatch methods needed for this type of"
NSQ_SOURCE_LINE 00000416 "        ### archive. Do a $self->is_XXX to figure out the type, then"
NSQ_SOURCE_LINE 00000417 "        ### get the hashref with bin + pure perl dispatchers."
NSQ_SOURCE_LINE 00000418 "        my ($map) = map { $Mapping->{$_} } grep { $self->$_ } keys %$Mapping;"
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "        ### add pure perl extractor if allowed & add bin extractor if allowed"
NSQ_SOURCE_LINE 00000421 "        my @methods;"
NSQ_SOURCE_LINE 00000422 "        push @methods, $map->{'pp'}  if $_ALLOW_PURE_PERL;"
NSQ_SOURCE_LINE 00000423 "        push @methods, $map->{'bin'} if $_ALLOW_BIN;"
NSQ_SOURCE_LINE 00000424 ""
NSQ_SOURCE_LINE 00000425 "        ### reverse it if we prefer bin extractors"
NSQ_SOURCE_LINE 00000426 "        @methods = reverse @methods if $PREFER_BIN;"
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "        my($na, $fail);"
NSQ_SOURCE_LINE 00000429 "        for my $method (@methods) {"
NSQ_SOURCE_LINE 00000430 "            $self->debug( \"# Extracting with ->$method\\n\" );"
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 "            my $rv = $self->$method;"
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 "            ### a positive extraction"
NSQ_SOURCE_LINE 00000435 "            if( $rv and $rv ne METHOD_NA ) {"
NSQ_SOURCE_LINE 00000436 "                $self->debug( \"# Extraction succeeded\\n\" );"
NSQ_SOURCE_LINE 00000437 "                $self->_extractor($method);"
NSQ_SOURCE_LINE 00000438 "                last;"
NSQ_SOURCE_LINE 00000439 ""
NSQ_SOURCE_LINE 00000440 "            ### method is not available"
NSQ_SOURCE_LINE 00000441 "            } elsif ( $rv and $rv eq METHOD_NA ) {"
NSQ_SOURCE_LINE 00000442 "                $self->debug( \"# Extraction method not available\\n\" );"
NSQ_SOURCE_LINE 00000443 "                $na++;"
NSQ_SOURCE_LINE 00000444 "            } else {"
NSQ_SOURCE_LINE 00000445 "                $self->debug( \"# Extraction method failed\\n\" );"
NSQ_SOURCE_LINE 00000446 "                $fail++;"
NSQ_SOURCE_LINE 00000447 "            }"
NSQ_SOURCE_LINE 00000448 "        }"
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "        ### warn something went wrong if we didn't get an extractor"
NSQ_SOURCE_LINE 00000451 "        unless( $self->_extractor ) {"
NSQ_SOURCE_LINE 00000452 "            my $diag = $fail ? loc(\"Extract failed due to errors\") :"
NSQ_SOURCE_LINE 00000453 "                       $na   ? loc(\"Extract failed; no extractors available\") :"
NSQ_SOURCE_LINE 00000454 "                       '';"
NSQ_SOURCE_LINE 00000455 ""
NSQ_SOURCE_LINE 00000456 "            $self->_error($diag);"
NSQ_SOURCE_LINE 00000457 "            $ok = 0;"
NSQ_SOURCE_LINE 00000458 "        }"
NSQ_SOURCE_LINE 00000459 "    }"
NSQ_SOURCE_LINE 00000460 ""
NSQ_SOURCE_LINE 00000461 "    ### and chdir back ###"
NSQ_SOURCE_LINE 00000462 "    unless( chdir $cwd ) {"
NSQ_SOURCE_LINE 00000463 "        $self->_error(loc(\"Could not chdir back to start dir '%1': %2'\","
NSQ_SOURCE_LINE 00000464 "                            $cwd, $!));"
NSQ_SOURCE_LINE 00000465 "    }"
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "    return $ok;"
NSQ_SOURCE_LINE 00000468 "}"
NSQ_SOURCE_LINE 00000469 ""
NSQ_SOURCE_LINE 00000470 "=pod"
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "=head1 ACCESSORS"
NSQ_SOURCE_LINE 00000473 ""
NSQ_SOURCE_LINE 00000474 "=head2 $ae->error([BOOL])"
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 "Returns the last encountered error as string."
NSQ_SOURCE_LINE 00000477 "Pass it a true value to get the C<Carp::longmess()> output instead."
NSQ_SOURCE_LINE 00000478 ""
NSQ_SOURCE_LINE 00000479 "=head2 $ae->extract_path"
NSQ_SOURCE_LINE 00000480 ""
NSQ_SOURCE_LINE 00000481 "This is the directory the archive got extracted to."
NSQ_SOURCE_LINE 00000482 "See C<extract()> for details."
NSQ_SOURCE_LINE 00000483 ""
NSQ_SOURCE_LINE 00000484 "=head2 $ae->files"
NSQ_SOURCE_LINE 00000485 ""
NSQ_SOURCE_LINE 00000486 "This is an array ref holding all the paths from the archive."
NSQ_SOURCE_LINE 00000487 "See C<extract()> for details."
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 "=head2 $ae->archive"
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "This is the full path to the archive file represented by this"
NSQ_SOURCE_LINE 00000492 "C<Archive::Extract> object."
NSQ_SOURCE_LINE 00000493 ""
NSQ_SOURCE_LINE 00000494 "=head2 $ae->type"
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "This is the type of archive represented by this C<Archive::Extract>"
NSQ_SOURCE_LINE 00000497 "object. See accessors below for an easier way to use this."
NSQ_SOURCE_LINE 00000498 "See the C<new()> method for details."
NSQ_SOURCE_LINE 00000499 ""
NSQ_SOURCE_LINE 00000500 "=head2 $ae->types"
NSQ_SOURCE_LINE 00000501 ""
NSQ_SOURCE_LINE 00000502 "Returns a list of all known C<types> for C<Archive::Extract>'s"
NSQ_SOURCE_LINE 00000503 "C<new> method."
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "=cut"
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "sub types { return @Types }"
NSQ_SOURCE_LINE 00000508 ""
NSQ_SOURCE_LINE 00000509 "=head2 $ae->is_tgz"
NSQ_SOURCE_LINE 00000510 ""
NSQ_SOURCE_LINE 00000511 "Returns true if the file is of type C<.tar.gz>."
NSQ_SOURCE_LINE 00000512 "See the C<new()> method for details."
NSQ_SOURCE_LINE 00000513 ""
NSQ_SOURCE_LINE 00000514 "=head2 $ae->is_tar"
NSQ_SOURCE_LINE 00000515 ""
NSQ_SOURCE_LINE 00000516 "Returns true if the file is of type C<.tar>."
NSQ_SOURCE_LINE 00000517 "See the C<new()> method for details."
NSQ_SOURCE_LINE 00000518 ""
NSQ_SOURCE_LINE 00000519 "=head2 $ae->is_gz"
NSQ_SOURCE_LINE 00000520 ""
NSQ_SOURCE_LINE 00000521 "Returns true if the file is of type C<.gz>."
NSQ_SOURCE_LINE 00000522 "See the C<new()> method for details."
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 "=head2 $ae->is_Z"
NSQ_SOURCE_LINE 00000525 ""
NSQ_SOURCE_LINE 00000526 "Returns true if the file is of type C<.Z>."
NSQ_SOURCE_LINE 00000527 "See the C<new()> method for details."
NSQ_SOURCE_LINE 00000528 ""
NSQ_SOURCE_LINE 00000529 "=head2 $ae->is_zip"
NSQ_SOURCE_LINE 00000530 ""
NSQ_SOURCE_LINE 00000531 "Returns true if the file is of type C<.zip>."
NSQ_SOURCE_LINE 00000532 "See the C<new()> method for details."
NSQ_SOURCE_LINE 00000533 ""
NSQ_SOURCE_LINE 00000534 "=head2 $ae->is_lzma"
NSQ_SOURCE_LINE 00000535 ""
NSQ_SOURCE_LINE 00000536 "Returns true if the file is of type C<.lzma>."
NSQ_SOURCE_LINE 00000537 "See the C<new()> method for details."
NSQ_SOURCE_LINE 00000538 ""
NSQ_SOURCE_LINE 00000539 "=head2 $ae->is_xz"
NSQ_SOURCE_LINE 00000540 ""
NSQ_SOURCE_LINE 00000541 "Returns true if the file is of type C<.xz>."
NSQ_SOURCE_LINE 00000542 "See the C<new()> method for details."
NSQ_SOURCE_LINE 00000543 ""
NSQ_SOURCE_LINE 00000544 "=cut"
NSQ_SOURCE_LINE 00000545 ""
NSQ_SOURCE_LINE 00000546 "### quick check methods ###"
NSQ_SOURCE_LINE 00000547 "sub is_tgz  { return $_[0]->type eq TGZ }"
NSQ_SOURCE_LINE 00000548 "sub is_tar  { return $_[0]->type eq TAR }"
NSQ_SOURCE_LINE 00000549 "sub is_gz   { return $_[0]->type eq GZ  }"
NSQ_SOURCE_LINE 00000550 "sub is_zip  { return $_[0]->type eq ZIP }"
NSQ_SOURCE_LINE 00000551 "sub is_tbz  { return $_[0]->type eq TBZ }"
NSQ_SOURCE_LINE 00000552 "sub is_bz2  { return $_[0]->type eq BZ2 }"
NSQ_SOURCE_LINE 00000553 "sub is_Z    { return $_[0]->type eq Z   }"
NSQ_SOURCE_LINE 00000554 "sub is_lzma { return $_[0]->type eq LZMA }"
NSQ_SOURCE_LINE 00000555 "sub is_xz   { return $_[0]->type eq XZ   }"
NSQ_SOURCE_LINE 00000556 "sub is_txz  { return $_[0]->type eq TXZ }"
NSQ_SOURCE_LINE 00000557 ""
NSQ_SOURCE_LINE 00000558 "=pod"
NSQ_SOURCE_LINE 00000559 ""
NSQ_SOURCE_LINE 00000560 "=head2 $ae->bin_tar"
NSQ_SOURCE_LINE 00000561 ""
NSQ_SOURCE_LINE 00000562 "Returns the full path to your tar binary, if found."
NSQ_SOURCE_LINE 00000563 ""
NSQ_SOURCE_LINE 00000564 "=head2 $ae->bin_gzip"
NSQ_SOURCE_LINE 00000565 ""
NSQ_SOURCE_LINE 00000566 "Returns the full path to your gzip binary, if found"
NSQ_SOURCE_LINE 00000567 ""
NSQ_SOURCE_LINE 00000568 "=head2 $ae->bin_unzip"
NSQ_SOURCE_LINE 00000569 ""
NSQ_SOURCE_LINE 00000570 "Returns the full path to your unzip binary, if found"
NSQ_SOURCE_LINE 00000571 ""
NSQ_SOURCE_LINE 00000572 "=head2 $ae->bin_unlzma"
NSQ_SOURCE_LINE 00000573 ""
NSQ_SOURCE_LINE 00000574 "Returns the full path to your unlzma binary, if found"
NSQ_SOURCE_LINE 00000575 ""
NSQ_SOURCE_LINE 00000576 "=head2 $ae->bin_unxz"
NSQ_SOURCE_LINE 00000577 ""
NSQ_SOURCE_LINE 00000578 "Returns the full path to your unxz binary, if found"
NSQ_SOURCE_LINE 00000579 ""
NSQ_SOURCE_LINE 00000580 "=cut"
NSQ_SOURCE_LINE 00000581 ""
NSQ_SOURCE_LINE 00000582 "### paths to commandline tools ###"
NSQ_SOURCE_LINE 00000583 "sub bin_gzip        { return $PROGRAMS->{'gzip'}    if $PROGRAMS->{'gzip'}  }"
NSQ_SOURCE_LINE 00000584 "sub bin_unzip       { return $PROGRAMS->{'unzip'}   if $PROGRAMS->{'unzip'} }"
NSQ_SOURCE_LINE 00000585 "sub bin_tar         { return $PROGRAMS->{'tar'}     if $PROGRAMS->{'tar'}   }"
NSQ_SOURCE_LINE 00000586 "sub bin_bunzip2     { return $PROGRAMS->{'bunzip2'} if $PROGRAMS->{'bunzip2'} }"
NSQ_SOURCE_LINE 00000587 "sub bin_uncompress  { return $PROGRAMS->{'uncompress'}"
NSQ_SOURCE_LINE 00000588 "                                                 if $PROGRAMS->{'uncompress'} }"
NSQ_SOURCE_LINE 00000589 "sub bin_unlzma      { return $PROGRAMS->{'unlzma'}  if $PROGRAMS->{'unlzma'} }"
NSQ_SOURCE_LINE 00000590 "sub bin_unxz        { return $PROGRAMS->{'unxz'}    if $PROGRAMS->{'unxz'} }"
NSQ_SOURCE_LINE 00000591 ""
NSQ_SOURCE_LINE 00000592 "=head2 $bool = $ae->have_old_bunzip2"
NSQ_SOURCE_LINE 00000593 ""
NSQ_SOURCE_LINE 00000594 "Older versions of C</bin/bunzip2>, from before the C<bunzip2 1.0> release,"
NSQ_SOURCE_LINE 00000595 "require all archive names to end in C<.bz2> or it will not extract"
NSQ_SOURCE_LINE 00000596 "them. This method checks if you have a recent version of C<bunzip2>"
NSQ_SOURCE_LINE 00000597 "that allows any extension, or an older one that doesn't."
NSQ_SOURCE_LINE 00000598 ""
NSQ_SOURCE_LINE 00000599 "=cut"
NSQ_SOURCE_LINE 00000600 ""
NSQ_SOURCE_LINE 00000601 "sub have_old_bunzip2 {"
NSQ_SOURCE_LINE 00000602 "    my $self = shift;"
NSQ_SOURCE_LINE 00000603 ""
NSQ_SOURCE_LINE 00000604 "    ### no bunzip2? no old bunzip2 either :)"
NSQ_SOURCE_LINE 00000605 "    return unless $self->bin_bunzip2;"
NSQ_SOURCE_LINE 00000606 ""
NSQ_SOURCE_LINE 00000607 "    ### if we can't run this, we can't be sure if it's too old or not"
NSQ_SOURCE_LINE 00000608 "    ### XXX stupid stupid stupid bunzip2 doesn't understand --version"
NSQ_SOURCE_LINE 00000609 "    ### is not a request to extract data:"
NSQ_SOURCE_LINE 00000610 "    ### $ bunzip2 --version"
NSQ_SOURCE_LINE 00000611 "    ### bzip2, a block-sorting file compressor.  Version 1.0.2, 30-Dec-2001."
NSQ_SOURCE_LINE 00000612 "    ### [...]"
NSQ_SOURCE_LINE 00000613 "    ### bunzip2: I won't read compressed data from a terminal."
NSQ_SOURCE_LINE 00000614 "    ### bunzip2: For help, type: `bunzip2 --help'."
NSQ_SOURCE_LINE 00000615 "    ### $ echo $?"
NSQ_SOURCE_LINE 00000616 "    ### 1"
NSQ_SOURCE_LINE 00000617 "    ### HATEFUL!"
NSQ_SOURCE_LINE 00000618 ""
NSQ_SOURCE_LINE 00000619 "    ### double hateful: bunzip2 --version also hangs if input is a pipe"
NSQ_SOURCE_LINE 00000620 "    ### See #32370: Archive::Extract will hang if stdin is a pipe [+PATCH]"
NSQ_SOURCE_LINE 00000621 "    ### So, we have to provide *another* argument which is a fake filename,"
NSQ_SOURCE_LINE 00000622 "    ### just so it wont try to read from stdin to print its version.."
NSQ_SOURCE_LINE 00000623 "    ### *sigh*"
NSQ_SOURCE_LINE 00000624 "    ### Even if the file exists, it won't clobber or change it."
NSQ_SOURCE_LINE 00000625 "    my $buffer;"
NSQ_SOURCE_LINE 00000626 "    scalar run("
NSQ_SOURCE_LINE 00000627 "         command => [$self->bin_bunzip2, '--version', 'NoSuchFile'],"
NSQ_SOURCE_LINE 00000628 "         verbose => 0,"
NSQ_SOURCE_LINE 00000629 "         buffer  => \\$buffer"
NSQ_SOURCE_LINE 00000630 "    );"
NSQ_SOURCE_LINE 00000631 ""
NSQ_SOURCE_LINE 00000632 "    ### no output"
NSQ_SOURCE_LINE 00000633 "    return unless $buffer;"
NSQ_SOURCE_LINE 00000634 ""
NSQ_SOURCE_LINE 00000635 "    my ($version) = $buffer =~ /version \\s+ (\\d+)/ix;"
NSQ_SOURCE_LINE 00000636 ""
NSQ_SOURCE_LINE 00000637 "    return 1 if $version < 1;"
NSQ_SOURCE_LINE 00000638 "    return;"
NSQ_SOURCE_LINE 00000639 "}"
NSQ_SOURCE_LINE 00000640 ""
NSQ_SOURCE_LINE 00000641 "#################################"
NSQ_SOURCE_LINE 00000642 "#"
NSQ_SOURCE_LINE 00000643 "# Untar code"
NSQ_SOURCE_LINE 00000644 "#"
NSQ_SOURCE_LINE 00000645 "#################################"
NSQ_SOURCE_LINE 00000646 ""
NSQ_SOURCE_LINE 00000647 "### annoying issue with (gnu) tar on win32, as illustrated by this"
NSQ_SOURCE_LINE 00000648 "### bug: https://rt.cpan.org/Ticket/Display.html?id=40138"
NSQ_SOURCE_LINE 00000649 "### which shows that (gnu) tar will interpret a file name with a :"
NSQ_SOURCE_LINE 00000650 "### in it as a remote file name, so C:\\tmp\\foo.txt is interpreted"
NSQ_SOURCE_LINE 00000651 "### as a remote shell, and the extract fails."
NSQ_SOURCE_LINE 00000652 "{   my @ExtraTarFlags;"
NSQ_SOURCE_LINE 00000653 "    if( ON_WIN32 and my $cmd = __PACKAGE__->bin_tar ) {"
NSQ_SOURCE_LINE 00000654 "        $cmd = $1 if $cmd =~ m{^(.+)}s; # Tainted perl #"
NSQ_SOURCE_LINE 00000655 "        ### if this is gnu tar we are running, we need to use --force-local"
NSQ_SOURCE_LINE 00000656 "        push @ExtraTarFlags, '--force-local' if `$cmd --version` =~ /gnu tar/i;"
NSQ_SOURCE_LINE 00000657 "    }"
NSQ_SOURCE_LINE 00000658 ""
NSQ_SOURCE_LINE 00000659 ""
NSQ_SOURCE_LINE 00000660 "    ### use /bin/tar to extract ###"
NSQ_SOURCE_LINE 00000661 "    sub _untar_bin {"
NSQ_SOURCE_LINE 00000662 "        my $self = shift;"
NSQ_SOURCE_LINE 00000663 ""
NSQ_SOURCE_LINE 00000664 "        ### check for /bin/tar ###"
NSQ_SOURCE_LINE 00000665 "        ### check for /bin/gzip if we need it ###"
NSQ_SOURCE_LINE 00000666 "        ### if any of the binaries are not available, return NA"
NSQ_SOURCE_LINE 00000667 "        {   my $diag =  !$self->bin_tar ?"
NSQ_SOURCE_LINE 00000668 "                            loc(\"No '%1' program found\", '/bin/tar') :"
NSQ_SOURCE_LINE 00000669 "                        $self->is_tgz && !$self->bin_gzip ?"
NSQ_SOURCE_LINE 00000670 "                            loc(\"No '%1' program found\", '/bin/gzip') :"
NSQ_SOURCE_LINE 00000671 "                        $self->is_tbz && !$self->bin_bunzip2 ?"
NSQ_SOURCE_LINE 00000672 "                            loc(\"No '%1' program found\", '/bin/bunzip2') :"
NSQ_SOURCE_LINE 00000673 "                        $self->is_txz && !$self->bin_unxz ?"
NSQ_SOURCE_LINE 00000674 "                            loc(\"No '%1' program found\", '/bin/unxz') :"
NSQ_SOURCE_LINE 00000675 "                        '';"
NSQ_SOURCE_LINE 00000676 ""
NSQ_SOURCE_LINE 00000677 "            if( $diag ) {"
NSQ_SOURCE_LINE 00000678 "                $self->_error( $diag );"
NSQ_SOURCE_LINE 00000679 "                return METHOD_NA;"
NSQ_SOURCE_LINE 00000680 "            }"
NSQ_SOURCE_LINE 00000681 "        }"
NSQ_SOURCE_LINE 00000682 ""
NSQ_SOURCE_LINE 00000683 "        ### XXX figure out how to make IPC::Run do this in one call --"
NSQ_SOURCE_LINE 00000684 "        ### currently i don't know how to get output of a command after a pipe"
NSQ_SOURCE_LINE 00000685 "        ### trapped in a scalar. Mailed barries about this 5th of june 2004."
NSQ_SOURCE_LINE 00000686 ""
NSQ_SOURCE_LINE 00000687 "        ### see what command we should run, based on whether"
NSQ_SOURCE_LINE 00000688 "        ### it's a .tgz or .tar"
NSQ_SOURCE_LINE 00000689 ""
NSQ_SOURCE_LINE 00000690 "        ### GNU tar can't handled VMS filespecs, but VMSTAR can handle Unix filespecs."
NSQ_SOURCE_LINE 00000691 "        my $archive = $self->archive;"
NSQ_SOURCE_LINE 00000692 "        $archive = VMS::Filespec::unixify($archive) if ON_VMS;"
NSQ_SOURCE_LINE 00000693 ""
NSQ_SOURCE_LINE 00000694 "        ### XXX solaris tar and bsdtar are having different outputs"
NSQ_SOURCE_LINE 00000695 "        ### depending whether you run with -x or -t"
NSQ_SOURCE_LINE 00000696 "        ### compensate for this insanity by running -t first, then -x"
NSQ_SOURCE_LINE 00000697 "        {    my $cmd ="
NSQ_SOURCE_LINE 00000698 "                $self->is_tgz ? [$self->bin_gzip, '-c', '-d', '-f', $archive, '|',"
NSQ_SOURCE_LINE 00000699 "                                 $self->bin_tar, '-tf', '-'] :"
NSQ_SOURCE_LINE 00000700 "                $self->is_tbz ? [$self->bin_bunzip2, '-cd', $archive, '|',"
NSQ_SOURCE_LINE 00000701 "                                 $self->bin_tar, '-tf', '-'] :"
NSQ_SOURCE_LINE 00000702 "                $self->is_txz ? [$self->bin_unxz, '-cd', $archive, '|',"
NSQ_SOURCE_LINE 00000703 "                                 $self->bin_tar, '-tf', '-'] :"
NSQ_SOURCE_LINE 00000704 "                [$self->bin_tar, @ExtraTarFlags, '-tf', $archive];"
NSQ_SOURCE_LINE 00000705 ""
NSQ_SOURCE_LINE 00000706 "            ### run the command"
NSQ_SOURCE_LINE 00000707 "            ### newer versions of 'tar' (1.21 and up) now print record size"
NSQ_SOURCE_LINE 00000708 "            ### to STDERR as well if v OR t is given (used to be both). This"
NSQ_SOURCE_LINE 00000709 "            ### is a 'feature' according to the changelog, so we must now only"
NSQ_SOURCE_LINE 00000710 "            ### inspect STDOUT, otherwise, failures like these occur:"
NSQ_SOURCE_LINE 00000711 "            ### http://www.cpantesters.org/cpan/report/3230366"
NSQ_SOURCE_LINE 00000712 "            my $buffer  = '';"
NSQ_SOURCE_LINE 00000713 "            my @out     = run(  command => $cmd,"
NSQ_SOURCE_LINE 00000714 "                                buffer  => \\$buffer,"
NSQ_SOURCE_LINE 00000715 "                                verbose => $DEBUG );"
NSQ_SOURCE_LINE 00000716 ""
NSQ_SOURCE_LINE 00000717 "            ### command was unsuccessful"
NSQ_SOURCE_LINE 00000718 "            unless( $out[0] ) {"
NSQ_SOURCE_LINE 00000719 "                return $self->_error(loc("
NSQ_SOURCE_LINE 00000720 "                                \"Error listing contents of archive '%1': %2\","
NSQ_SOURCE_LINE 00000721 "                                $archive, $buffer ));"
NSQ_SOURCE_LINE 00000722 "            }"
NSQ_SOURCE_LINE 00000723 ""
NSQ_SOURCE_LINE 00000724 "            ### no buffers available?"
NSQ_SOURCE_LINE 00000725 "            if( !IPC::Cmd->can_capture_buffer and !$buffer ) {"
NSQ_SOURCE_LINE 00000726 "                $self->_error( $self->_no_buffer_files( $archive ) );"
NSQ_SOURCE_LINE 00000727 ""
NSQ_SOURCE_LINE 00000728 "            } else {"
NSQ_SOURCE_LINE 00000729 "                ### if we're on solaris we /might/ be using /bin/tar, which has"
NSQ_SOURCE_LINE 00000730 "                ### a weird output format... we might also be using"
NSQ_SOURCE_LINE 00000731 "                ### /usr/local/bin/tar, which is gnu tar, which is perfectly"
NSQ_SOURCE_LINE 00000732 "                ### fine... so we have to do some guessing here =/"
NSQ_SOURCE_LINE 00000733 "                my @files = map { chomp; s!\\x0D!!g if ON_WIN32;"
NSQ_SOURCE_LINE 00000734 "                              !ON_SOLARIS ? $_"
NSQ_SOURCE_LINE 00000735 "                                          : (m|^ x \\s+  # 'xtract' -- sigh"
NSQ_SOURCE_LINE 00000736 "                                                (.+?),  # the actual file name"
NSQ_SOURCE_LINE 00000737 "                                                \\s+ [\\d,.]+ \\s bytes,"
NSQ_SOURCE_LINE 00000738 "                                                \\s+ [\\d,.]+ \\s tape \\s blocks"
NSQ_SOURCE_LINE 00000739 "                                            |x ? $1 : $_);"
NSQ_SOURCE_LINE 00000740 ""
NSQ_SOURCE_LINE 00000741 "                        ### only STDOUT, see above. Sometimes, extra whitespace"
NSQ_SOURCE_LINE 00000742 "                        ### is present, so make sure we only pick lines with"
NSQ_SOURCE_LINE 00000743 "                        ### a length"
NSQ_SOURCE_LINE 00000744 "                        } grep { length } map { split $/, $_ } join '', @{$out[3]};"
NSQ_SOURCE_LINE 00000745 ""
NSQ_SOURCE_LINE 00000746 "                ### store the files that are in the archive ###"
NSQ_SOURCE_LINE 00000747 "                $self->files(\\@files);"
NSQ_SOURCE_LINE 00000748 "            }"
NSQ_SOURCE_LINE 00000749 "        }"
NSQ_SOURCE_LINE 00000750 ""
NSQ_SOURCE_LINE 00000751 "        ### now actually extract it ###"
NSQ_SOURCE_LINE 00000752 "        {   my $cmd ="
NSQ_SOURCE_LINE 00000753 "                $self->is_tgz ? [$self->bin_gzip, '-c', '-d', '-f', $archive, '|',"
NSQ_SOURCE_LINE 00000754 "                                 $self->bin_tar, '-xf', '-'] :"
NSQ_SOURCE_LINE 00000755 "                $self->is_tbz ? [$self->bin_bunzip2, '-cd', $archive, '|',"
NSQ_SOURCE_LINE 00000756 "                                 $self->bin_tar, '-xf', '-'] :"
NSQ_SOURCE_LINE 00000757 "                $self->is_txz ? [$self->bin_unxz, '-cd', $archive, '|',"
NSQ_SOURCE_LINE 00000758 "                                 $self->bin_tar, '-xf', '-'] :"
NSQ_SOURCE_LINE 00000759 "                [$self->bin_tar, @ExtraTarFlags, '-xf', $archive];"
NSQ_SOURCE_LINE 00000760 ""
NSQ_SOURCE_LINE 00000761 "            my $buffer = '';"
NSQ_SOURCE_LINE 00000762 "            unless( scalar run( command => $cmd,"
NSQ_SOURCE_LINE 00000763 "                                buffer  => \\$buffer,"
NSQ_SOURCE_LINE 00000764 "                                verbose => $DEBUG )"
NSQ_SOURCE_LINE 00000765 "            ) {"
NSQ_SOURCE_LINE 00000766 "                return $self->_error(loc(\"Error extracting archive '%1': %2\","
NSQ_SOURCE_LINE 00000767 "                                $archive, $buffer ));"
NSQ_SOURCE_LINE 00000768 "            }"
NSQ_SOURCE_LINE 00000769 ""
NSQ_SOURCE_LINE 00000770 "            ### we might not have them, due to lack of buffers"
NSQ_SOURCE_LINE 00000771 "            if( $self->files ) {"
NSQ_SOURCE_LINE 00000772 "                ### now that we've extracted, figure out where we extracted to"
NSQ_SOURCE_LINE 00000773 "                my $dir = $self->__get_extract_dir( $self->files );"
NSQ_SOURCE_LINE 00000774 ""
NSQ_SOURCE_LINE 00000775 "                ### store the extraction dir ###"
NSQ_SOURCE_LINE 00000776 "                $self->extract_path( $dir );"
NSQ_SOURCE_LINE 00000777 "            }"
NSQ_SOURCE_LINE 00000778 "        }"
NSQ_SOURCE_LINE 00000779 ""
NSQ_SOURCE_LINE 00000780 "        ### we got here, no error happened"
NSQ_SOURCE_LINE 00000781 "        return 1;"
NSQ_SOURCE_LINE 00000782 "    }"
NSQ_SOURCE_LINE 00000783 "}"
NSQ_SOURCE_LINE 00000784 ""
NSQ_SOURCE_LINE 00000785 ""
NSQ_SOURCE_LINE 00000786 "### use archive::tar to extract ###"
NSQ_SOURCE_LINE 00000787 "sub _untar_at {"
NSQ_SOURCE_LINE 00000788 "    my $self = shift;"
NSQ_SOURCE_LINE 00000789 ""
NSQ_SOURCE_LINE 00000790 "    ### Loading Archive::Tar is going to set it to 1, so make it local"
NSQ_SOURCE_LINE 00000791 "    ### within this block, starting with its initial value. Whatever"
NSQ_SOURCE_LINE 00000792 "    ### Achive::Tar does will be undone when we return."
NSQ_SOURCE_LINE 00000793 "    ###"
NSQ_SOURCE_LINE 00000794 "    ### Also, later, set $Archive::Tar::WARN to $Archive::Extract::WARN"
NSQ_SOURCE_LINE 00000795 "    ### so users don't have to even think about this variable. If they"
NSQ_SOURCE_LINE 00000796 "    ### do, they still get their set value outside of this call."
NSQ_SOURCE_LINE 00000797 "    local $Archive::Tar::WARN = $Archive::Tar::WARN;"
NSQ_SOURCE_LINE 00000798 ""
NSQ_SOURCE_LINE 00000799 "    ### we definitely need Archive::Tar, so load that first"
NSQ_SOURCE_LINE 00000800 "    {   my $use_list = { 'Archive::Tar' => '0.0' };"
NSQ_SOURCE_LINE 00000801 ""
NSQ_SOURCE_LINE 00000802 "        unless( can_load( modules => $use_list ) ) {"
NSQ_SOURCE_LINE 00000803 ""
NSQ_SOURCE_LINE 00000804 "            $self->_error(loc(\"You do not have '%1' installed - \" ."
NSQ_SOURCE_LINE 00000805 "                              \"Please install it as soon as possible.\","
NSQ_SOURCE_LINE 00000806 "                              'Archive::Tar'));"
NSQ_SOURCE_LINE 00000807 ""
NSQ_SOURCE_LINE 00000808 "            return METHOD_NA;"
NSQ_SOURCE_LINE 00000809 "        }"
NSQ_SOURCE_LINE 00000810 "    }"
NSQ_SOURCE_LINE 00000811 ""
NSQ_SOURCE_LINE 00000812 "    ### we might pass it a filehandle if it's a .tbz file.."
NSQ_SOURCE_LINE 00000813 "    my $fh_to_read = $self->archive;"
NSQ_SOURCE_LINE 00000814 ""
NSQ_SOURCE_LINE 00000815 "    ### we will need Compress::Zlib too, if it's a tgz... and IO::Zlib"
NSQ_SOURCE_LINE 00000816 "    ### if A::T's version is 0.99 or higher"
NSQ_SOURCE_LINE 00000817 "    if( $self->is_tgz ) {"
NSQ_SOURCE_LINE 00000818 "        my $use_list = { 'Compress::Zlib' => '0.0' };"
NSQ_SOURCE_LINE 00000819 "        {"
NSQ_SOURCE_LINE 00000820 "           local $@;"
NSQ_SOURCE_LINE 00000821 "           $use_list->{ 'IO::Zlib' } = '0.0'"
NSQ_SOURCE_LINE 00000822 "                if eval { Archive::Tar->VERSION('0.99'); 1 };"
NSQ_SOURCE_LINE 00000823 "        }"
NSQ_SOURCE_LINE 00000824 ""
NSQ_SOURCE_LINE 00000825 "        unless( can_load( modules => $use_list ) ) {"
NSQ_SOURCE_LINE 00000826 "            my $which = join '/', sort keys %$use_list;"
NSQ_SOURCE_LINE 00000827 ""
NSQ_SOURCE_LINE 00000828 "            $self->_error(loc("
NSQ_SOURCE_LINE 00000829 "                \"You do not have '%1' installed - Please \"."
NSQ_SOURCE_LINE 00000830 "                \"install it as soon as possible.\", $which)"
NSQ_SOURCE_LINE 00000831 "            );"
NSQ_SOURCE_LINE 00000832 ""
NSQ_SOURCE_LINE 00000833 "            return METHOD_NA;"
NSQ_SOURCE_LINE 00000834 "        }"
NSQ_SOURCE_LINE 00000835 ""
NSQ_SOURCE_LINE 00000836 "    } elsif ( $self->is_tbz ) {"
NSQ_SOURCE_LINE 00000837 "        my $use_list = { 'IO::Uncompress::Bunzip2' => '0.0' };"
NSQ_SOURCE_LINE 00000838 "        unless( can_load( modules => $use_list ) ) {"
NSQ_SOURCE_LINE 00000839 "            $self->_error(loc("
NSQ_SOURCE_LINE 00000840 "                \"You do not have '%1' installed - Please \" ."
NSQ_SOURCE_LINE 00000841 "                \"install it as soon as possible.\","
NSQ_SOURCE_LINE 00000842 "                'IO::Uncompress::Bunzip2')"
NSQ_SOURCE_LINE 00000843 "            );"
NSQ_SOURCE_LINE 00000844 ""
NSQ_SOURCE_LINE 00000845 "            return METHOD_NA;"
NSQ_SOURCE_LINE 00000846 "        }"
NSQ_SOURCE_LINE 00000847 ""
NSQ_SOURCE_LINE 00000848 "        my $bz = IO::Uncompress::Bunzip2->new( $self->archive ) or"
NSQ_SOURCE_LINE 00000849 "            return $self->_error(loc(\"Unable to open '%1': %2\","
NSQ_SOURCE_LINE 00000850 "                            $self->archive,"
NSQ_SOURCE_LINE 00000851 "                            $IO::Uncompress::Bunzip2::Bunzip2Error));"
NSQ_SOURCE_LINE 00000852 ""
NSQ_SOURCE_LINE 00000853 "        $fh_to_read = $bz;"
NSQ_SOURCE_LINE 00000854 "    } elsif ( $self->is_txz ) {"
NSQ_SOURCE_LINE 00000855 "        my $use_list = { 'IO::Uncompress::UnXz' => '0.0' };"
NSQ_SOURCE_LINE 00000856 "        unless( can_load( modules => $use_list ) ) {"
NSQ_SOURCE_LINE 00000857 "            $self->_error(loc("
NSQ_SOURCE_LINE 00000858 "                \"You do not have '%1' installed - Please \" ."
NSQ_SOURCE_LINE 00000859 "                \"install it as soon as possible.\","
NSQ_SOURCE_LINE 00000860 "                'IO::Uncompress::UnXz')"
NSQ_SOURCE_LINE 00000861 "            );"
NSQ_SOURCE_LINE 00000862 ""
NSQ_SOURCE_LINE 00000863 "            return METHOD_NA;"
NSQ_SOURCE_LINE 00000864 "        }"
NSQ_SOURCE_LINE 00000865 ""
NSQ_SOURCE_LINE 00000866 "        my $xz = IO::Uncompress::UnXz->new( $self->archive ) or"
NSQ_SOURCE_LINE 00000867 "            return $self->_error(loc(\"Unable to open '%1': %2\","
NSQ_SOURCE_LINE 00000868 "                            $self->archive,"
NSQ_SOURCE_LINE 00000869 "                            $IO::Uncompress::UnXz::UnXzError));"
NSQ_SOURCE_LINE 00000870 ""
NSQ_SOURCE_LINE 00000871 "        $fh_to_read = $xz;"
NSQ_SOURCE_LINE 00000872 "    }"
NSQ_SOURCE_LINE 00000873 ""
NSQ_SOURCE_LINE 00000874 "    my @files;"
NSQ_SOURCE_LINE 00000875 "    {"
NSQ_SOURCE_LINE 00000876 "        ### $Archive::Tar::WARN is 1 by default in Archive::Tar, but we've"
NSQ_SOURCE_LINE 00000877 "        ### localized $Archive::Tar::WARN already."
NSQ_SOURCE_LINE 00000878 "        $Archive::Tar::WARN = $Archive::Extract::WARN;"
NSQ_SOURCE_LINE 00000879 ""
NSQ_SOURCE_LINE 00000880 "        ### only tell it it's compressed if it's a .tgz, as we give it a file"
NSQ_SOURCE_LINE 00000881 "        ### handle if it's a .tbz"
NSQ_SOURCE_LINE 00000882 "        my @read = ( $fh_to_read, ( $self->is_tgz ? 1 : 0 ) );"
NSQ_SOURCE_LINE 00000883 ""
NSQ_SOURCE_LINE 00000884 "        ### for version of Archive::Tar > 1.04"
NSQ_SOURCE_LINE 00000885 "        local $Archive::Tar::CHOWN = 0;"
NSQ_SOURCE_LINE 00000886 ""
NSQ_SOURCE_LINE 00000887 "        ### use the iterator if we can. it's a feature of A::T 1.40 and up"
NSQ_SOURCE_LINE 00000888 "        if ( $_ALLOW_TAR_ITER && Archive::Tar->can( 'iter' ) ) {"
NSQ_SOURCE_LINE 00000889 ""
NSQ_SOURCE_LINE 00000890 "            my $next;"
NSQ_SOURCE_LINE 00000891 "            unless ( $next = Archive::Tar->iter( @read ) ) {"
NSQ_SOURCE_LINE 00000892 "                return $self->_error(loc("
NSQ_SOURCE_LINE 00000893 "                            \"Unable to read '%1': %2\", $self->archive,"
NSQ_SOURCE_LINE 00000894 "                            $Archive::Tar::error));"
NSQ_SOURCE_LINE 00000895 "            }"
NSQ_SOURCE_LINE 00000896 ""
NSQ_SOURCE_LINE 00000897 "            while ( my $file = $next->() ) {"
NSQ_SOURCE_LINE 00000898 "                push @files, $file->full_path;"
NSQ_SOURCE_LINE 00000899 ""
NSQ_SOURCE_LINE 00000900 "                $file->extract or return $self->_error(loc("
NSQ_SOURCE_LINE 00000901 "                        \"Unable to read '%1': %2\","
NSQ_SOURCE_LINE 00000902 "                        $self->archive,"
NSQ_SOURCE_LINE 00000903 "                        $Archive::Tar::error));"
NSQ_SOURCE_LINE 00000904 "            }"
NSQ_SOURCE_LINE 00000905 ""
NSQ_SOURCE_LINE 00000906 "        ### older version, read the archive into memory"
NSQ_SOURCE_LINE 00000907 "        } else {"
NSQ_SOURCE_LINE 00000908 ""
NSQ_SOURCE_LINE 00000909 "            my $tar = Archive::Tar->new();"
NSQ_SOURCE_LINE 00000910 ""
NSQ_SOURCE_LINE 00000911 "            unless( $tar->read( @read ) ) {"
NSQ_SOURCE_LINE 00000912 "                return $self->_error(loc(\"Unable to read '%1': %2\","
NSQ_SOURCE_LINE 00000913 "                            $self->archive, $Archive::Tar::error));"
NSQ_SOURCE_LINE 00000914 "            }"
NSQ_SOURCE_LINE 00000915 ""
NSQ_SOURCE_LINE 00000916 "            ### workaround to prevent Archive::Tar from setting uid, which"
NSQ_SOURCE_LINE 00000917 "            ### is a potential security hole. -autrijus"
NSQ_SOURCE_LINE 00000918 "            ### have to do it here, since A::T needs to be /loaded/ first ###"
NSQ_SOURCE_LINE 00000919 "            {   no strict 'refs'; local $^W;"
NSQ_SOURCE_LINE 00000920 ""
NSQ_SOURCE_LINE 00000921 "                ### older versions of archive::tar <= 0.23"
NSQ_SOURCE_LINE 00000922 "                *Archive::Tar::chown = sub {};"
NSQ_SOURCE_LINE 00000923 "            }"
NSQ_SOURCE_LINE 00000924 ""
NSQ_SOURCE_LINE 00000925 "            {   local $^W;  # quell 'splice() offset past end of array' warnings"
NSQ_SOURCE_LINE 00000926 "                            # on older versions of A::T"
NSQ_SOURCE_LINE 00000927 ""
NSQ_SOURCE_LINE 00000928 "                ### older archive::tar always returns $self, return value"
NSQ_SOURCE_LINE 00000929 "                ### slightly fux0r3d because of it."
NSQ_SOURCE_LINE 00000930 "                $tar->extract or return $self->_error(loc("
NSQ_SOURCE_LINE 00000931 "                        \"Unable to extract '%1': %2\","
NSQ_SOURCE_LINE 00000932 "                        $self->archive, $Archive::Tar::error ));"
NSQ_SOURCE_LINE 00000933 "            }"
NSQ_SOURCE_LINE 00000934 ""
NSQ_SOURCE_LINE 00000935 "            @files = $tar->list_files;"
NSQ_SOURCE_LINE 00000936 "        }"
NSQ_SOURCE_LINE 00000937 "    }"
NSQ_SOURCE_LINE 00000938 ""
NSQ_SOURCE_LINE 00000939 "    my $dir = $self->__get_extract_dir( \\@files );"
NSQ_SOURCE_LINE 00000940 ""
NSQ_SOURCE_LINE 00000941 "    ### store the files that are in the archive ###"
NSQ_SOURCE_LINE 00000942 "    $self->files(\\@files);"
NSQ_SOURCE_LINE 00000943 ""
NSQ_SOURCE_LINE 00000944 "    ### store the extraction dir ###"
NSQ_SOURCE_LINE 00000945 "    $self->extract_path( $dir );"
NSQ_SOURCE_LINE 00000946 ""
NSQ_SOURCE_LINE 00000947 "    ### check if the dir actually appeared ###"
NSQ_SOURCE_LINE 00000948 "    return 1 if -d $self->extract_path;"
NSQ_SOURCE_LINE 00000949 ""
NSQ_SOURCE_LINE 00000950 "    ### no dir, we failed ###"
NSQ_SOURCE_LINE 00000951 "    return $self->_error(loc(\"Unable to extract '%1': %2\","
NSQ_SOURCE_LINE 00000952 "                                $self->archive, $Archive::Tar::error ));"
NSQ_SOURCE_LINE 00000953 "}"
NSQ_SOURCE_LINE 00000954 ""
NSQ_SOURCE_LINE 00000955 "#################################"
NSQ_SOURCE_LINE 00000956 "#"
NSQ_SOURCE_LINE 00000957 "# Gunzip code"
NSQ_SOURCE_LINE 00000958 "#"
NSQ_SOURCE_LINE 00000959 "#################################"
NSQ_SOURCE_LINE 00000960 ""
NSQ_SOURCE_LINE 00000961 "sub _gunzip_bin {"
NSQ_SOURCE_LINE 00000962 "    my $self = shift;"
NSQ_SOURCE_LINE 00000963 ""
NSQ_SOURCE_LINE 00000964 "    ### check for /bin/gzip -- we need it ###"
NSQ_SOURCE_LINE 00000965 "    unless( $self->bin_gzip ) {"
NSQ_SOURCE_LINE 00000966 "        $self->_error(loc(\"No '%1' program found\", '/bin/gzip'));"
NSQ_SOURCE_LINE 00000967 "        return METHOD_NA;"
NSQ_SOURCE_LINE 00000968 "    }"
NSQ_SOURCE_LINE 00000969 ""
NSQ_SOURCE_LINE 00000970 "    my $fh = FileHandle->new('>'. $self->_gunzip_to) or"
NSQ_SOURCE_LINE 00000971 "        return $self->_error(loc(\"Could not open '%1' for writing: %2\","
NSQ_SOURCE_LINE 00000972 "                            $self->_gunzip_to, $! ));"
NSQ_SOURCE_LINE 00000973 ""
NSQ_SOURCE_LINE 00000974 "    my $cmd = [ $self->bin_gzip, '-c', '-d', '-f', $self->archive ];"
NSQ_SOURCE_LINE 00000975 ""
NSQ_SOURCE_LINE 00000976 "    my $buffer;"
NSQ_SOURCE_LINE 00000977 "    unless( scalar run( command => $cmd,"
NSQ_SOURCE_LINE 00000978 "                        verbose => $DEBUG,"
NSQ_SOURCE_LINE 00000979 "                        buffer  => \\$buffer )"
NSQ_SOURCE_LINE 00000980 "    ) {"
NSQ_SOURCE_LINE 00000981 "        return $self->_error(loc(\"Unable to gunzip '%1': %2\","
NSQ_SOURCE_LINE 00000982 "                                    $self->archive, $buffer));"
NSQ_SOURCE_LINE 00000983 "    }"
NSQ_SOURCE_LINE 00000984 ""
NSQ_SOURCE_LINE 00000985 "    ### no buffers available?"
NSQ_SOURCE_LINE 00000986 "    if( !IPC::Cmd->can_capture_buffer and !$buffer ) {"
NSQ_SOURCE_LINE 00000987 "        $self->_error( $self->_no_buffer_content( $self->archive ) );"
NSQ_SOURCE_LINE 00000988 "    }"
NSQ_SOURCE_LINE 00000989 ""
NSQ_SOURCE_LINE 00000990 "    $self->_print($fh, $buffer) if defined $buffer;"
NSQ_SOURCE_LINE 00000991 ""
NSQ_SOURCE_LINE 00000992 "    close $fh;"
NSQ_SOURCE_LINE 00000993 ""
NSQ_SOURCE_LINE 00000994 "    ### set what files where extract, and where they went ###"
NSQ_SOURCE_LINE 00000995 "    $self->files( [$self->_gunzip_to] );"
NSQ_SOURCE_LINE 00000996 "    $self->extract_path( File::Spec->rel2abs(cwd()) );"
NSQ_SOURCE_LINE 00000997 ""
NSQ_SOURCE_LINE 00000998 "    return 1;"
NSQ_SOURCE_LINE 00000999 "}"
NSQ_SOURCE_LINE 00001000 ""
NSQ_SOURCE_LINE 00001001 "sub _gunzip_cz {"
NSQ_SOURCE_LINE 00001002 "    my $self = shift;"
NSQ_SOURCE_LINE 00001003 ""
NSQ_SOURCE_LINE 00001004 "    my $use_list = { 'Compress::Zlib' => '0.0' };"
NSQ_SOURCE_LINE 00001005 "    unless( can_load( modules => $use_list ) ) {"
NSQ_SOURCE_LINE 00001006 "        $self->_error(loc(\"You do not have '%1' installed - Please \" ."
NSQ_SOURCE_LINE 00001007 "                    \"install it as soon as possible.\", 'Compress::Zlib'));"
NSQ_SOURCE_LINE 00001008 "        return METHOD_NA;"
NSQ_SOURCE_LINE 00001009 "    }"
NSQ_SOURCE_LINE 00001010 ""
NSQ_SOURCE_LINE 00001011 "    my $gz = Compress::Zlib::gzopen( $self->archive, \"rb\" ) or"
NSQ_SOURCE_LINE 00001012 "                return $self->_error(loc(\"Unable to open '%1': %2\","
NSQ_SOURCE_LINE 00001013 "                            $self->archive, $Compress::Zlib::gzerrno));"
NSQ_SOURCE_LINE 00001014 ""
NSQ_SOURCE_LINE 00001015 "    my $fh = FileHandle->new('>'. $self->_gunzip_to) or"
NSQ_SOURCE_LINE 00001016 "        return $self->_error(loc(\"Could not open '%1' for writing: %2\","
NSQ_SOURCE_LINE 00001017 "                            $self->_gunzip_to, $! ));"
NSQ_SOURCE_LINE 00001018 ""
NSQ_SOURCE_LINE 00001019 "    my $buffer;"
NSQ_SOURCE_LINE 00001020 "    $self->_print($fh, $buffer) while $gz->gzread($buffer) > 0;"
NSQ_SOURCE_LINE 00001021 "    $fh->close;"
NSQ_SOURCE_LINE 00001022 ""
NSQ_SOURCE_LINE 00001023 "    ### set what files where extract, and where they went ###"
NSQ_SOURCE_LINE 00001024 "    $self->files( [$self->_gunzip_to] );"
NSQ_SOURCE_LINE 00001025 "    $self->extract_path( File::Spec->rel2abs(cwd()) );"
NSQ_SOURCE_LINE 00001026 ""
NSQ_SOURCE_LINE 00001027 "    return 1;"
NSQ_SOURCE_LINE 00001028 "}"
NSQ_SOURCE_LINE 00001029 ""
NSQ_SOURCE_LINE 00001030 "#################################"
