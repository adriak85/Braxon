NSQ_SOURCE_LINE 00001322 "#     $self->files( [$self->_gunzip_to] );"
NSQ_SOURCE_LINE 00001323 "#     $self->extract_path( File::Spec->rel2abs(cwd()) );"
NSQ_SOURCE_LINE 00001324 "#"
NSQ_SOURCE_LINE 00001325 "#     return 1;"
NSQ_SOURCE_LINE 00001326 "# }"
