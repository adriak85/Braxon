NSQ_SOURCE_LINE 00001318 "#     $fh->print($buffer) while $bz->read($buffer) > 0;"
NSQ_SOURCE_LINE 00001319 "#     $fh->close;"
NSQ_SOURCE_LINE 00001320 "#"
