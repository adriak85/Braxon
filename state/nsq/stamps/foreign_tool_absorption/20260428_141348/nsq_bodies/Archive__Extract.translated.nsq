NSQ_SOURCE_LINE 00001467 "sub _unlzma_cz {"
NSQ_SOURCE_LINE 00001468 "    my $self = shift;"
NSQ_SOURCE_LINE 00001469 ""
NSQ_SOURCE_LINE 00001470 "    my $use_list1 = { 'IO::Uncompress::UnLzma' => '0.0' };"
NSQ_SOURCE_LINE 00001471 "    my $use_list2 = { 'Compress::unLZMA' => '0.0' };"
NSQ_SOURCE_LINE 00001472 ""
NSQ_SOURCE_LINE 00001473 "    if (can_load( modules => $use_list1 ) ) {"
NSQ_SOURCE_LINE 00001474 "        IO::Uncompress::UnLzma::unlzma($self->archive => $self->_gunzip_to)"
NSQ_SOURCE_LINE 00001475 "            or return $self->_error(loc(\"Unable to uncompress '%1': %2\","
NSQ_SOURCE_LINE 00001476 "                                $self->archive,"
NSQ_SOURCE_LINE 00001477 "                                $IO::Uncompress::UnLzma::UnLzmaError));"
NSQ_SOURCE_LINE 00001478 "    }"
NSQ_SOURCE_LINE 00001479 "    elsif (can_load( modules => $use_list2 ) ) {"
NSQ_SOURCE_LINE 00001480 ""
NSQ_SOURCE_LINE 00001481 "        my $fh = FileHandle->new('>'. $self->_gunzip_to) or"
NSQ_SOURCE_LINE 00001482 "            return $self->_error(loc(\"Could not open '%1' for writing: %2\","
NSQ_SOURCE_LINE 00001483 "                                $self->_gunzip_to, $! ));"
NSQ_SOURCE_LINE 00001484 ""
NSQ_SOURCE_LINE 00001485 "        my $buffer;"
NSQ_SOURCE_LINE 00001486 "        $buffer = Compress::unLZMA::uncompressfile( $self->archive );"
NSQ_SOURCE_LINE 00001487 "        unless ( defined $buffer ) {"
NSQ_SOURCE_LINE 00001488 "            return $self->_error(loc(\"Could not unlzma '%1': %2\","
NSQ_SOURCE_LINE 00001489 "                                        $self->archive, $@));"
NSQ_SOURCE_LINE 00001490 "        }"
NSQ_SOURCE_LINE 00001491 ""
NSQ_SOURCE_LINE 00001492 "        $self->_print($fh, $buffer) if defined $buffer;"
NSQ_SOURCE_LINE 00001493 ""
NSQ_SOURCE_LINE 00001494 "        close $fh;"
NSQ_SOURCE_LINE 00001495 "    }"
NSQ_SOURCE_LINE 00001496 "    else {"
NSQ_SOURCE_LINE 00001497 "        $self->_error(loc(\"You do not have '%1' or '%2' installed - Please \" ."
NSQ_SOURCE_LINE 00001498 "                    \"install it as soon as possible.\", 'Compress::unLZMA', 'IO::Uncompress::UnLzma'));"
NSQ_SOURCE_LINE 00001499 "        return METHOD_NA;"
NSQ_SOURCE_LINE 00001500 "    }"
NSQ_SOURCE_LINE 00001501 ""
NSQ_SOURCE_LINE 00001502 "    ### set what files where extract, and where they went ###"
NSQ_SOURCE_LINE 00001503 "    $self->files( [$self->_gunzip_to] );"
NSQ_SOURCE_LINE 00001504 "    $self->extract_path( File::Spec->rel2abs(cwd()) );"
NSQ_SOURCE_LINE 00001505 ""
NSQ_SOURCE_LINE 00001506 "    return 1;"
NSQ_SOURCE_LINE 00001507 "}"
NSQ_SOURCE_LINE 00001508 ""
NSQ_SOURCE_LINE 00001509 "#####################################"
NSQ_SOURCE_LINE 00001510 "#"
NSQ_SOURCE_LINE 00001511 "# unzip heuristics for FreeBSD-alikes"
NSQ_SOURCE_LINE 00001512 "#"
NSQ_SOURCE_LINE 00001513 "#####################################"
NSQ_SOURCE_LINE 00001514 ""
NSQ_SOURCE_LINE 00001515 "sub _is_infozip_esque {"
NSQ_SOURCE_LINE 00001516 "  my $unzip = shift;"
NSQ_SOURCE_LINE 00001517 ""
NSQ_SOURCE_LINE 00001518 "  my @strings;"
NSQ_SOURCE_LINE 00001519 "  my $buf = '';"
NSQ_SOURCE_LINE 00001520 ""
NSQ_SOURCE_LINE 00001521 "  {"
NSQ_SOURCE_LINE 00001522 "    open my $file, '<', $unzip or die \"$!\\n\";"
NSQ_SOURCE_LINE 00001523 "    binmode $file;"
NSQ_SOURCE_LINE 00001524 "    local $/ = \\1;"
NSQ_SOURCE_LINE 00001525 "    local $_;"
NSQ_SOURCE_LINE 00001526 "    while(<$file>) {"
NSQ_SOURCE_LINE 00001527 "      if ( m![[:print:]]! ) {"
NSQ_SOURCE_LINE 00001528 "        $buf .= $_;"
NSQ_SOURCE_LINE 00001529 "        next;"
NSQ_SOURCE_LINE 00001530 "      }"
NSQ_SOURCE_LINE 00001531 "      if ( $buf and m![^[:print:]]! ) {"
NSQ_SOURCE_LINE 00001532 "        push @strings, $buf if length $buf >= 4;"
NSQ_SOURCE_LINE 00001533 "        $buf = '';"
NSQ_SOURCE_LINE 00001534 "        next;"
NSQ_SOURCE_LINE 00001535 "      }"
NSQ_SOURCE_LINE 00001536 "    }"
NSQ_SOURCE_LINE 00001537 "  }"
NSQ_SOURCE_LINE 00001538 "  push @strings, $buf if $buf;"
NSQ_SOURCE_LINE 00001539 "  foreach my $part ( @strings ) {"
NSQ_SOURCE_LINE 00001540 "    if ( $part =~ m!ZIPINFO! or $part =~ m!usage:.+?Z1! ) {"
NSQ_SOURCE_LINE 00001541 "      return $unzip;"
NSQ_SOURCE_LINE 00001542 "    }"
NSQ_SOURCE_LINE 00001543 "  }"
NSQ_SOURCE_LINE 00001544 "  return;"
NSQ_SOURCE_LINE 00001545 "}"
NSQ_SOURCE_LINE 00001546 ""
NSQ_SOURCE_LINE 00001547 "#################################"
NSQ_SOURCE_LINE 00001548 "#"
NSQ_SOURCE_LINE 00001549 "# Error code"
NSQ_SOURCE_LINE 00001550 "#"
NSQ_SOURCE_LINE 00001551 "#################################"
NSQ_SOURCE_LINE 00001552 ""
NSQ_SOURCE_LINE 00001553 "# For printing binaries that avoids interfering globals"
NSQ_SOURCE_LINE 00001554 "sub _print {"
NSQ_SOURCE_LINE 00001555 "    my $self = shift;"
NSQ_SOURCE_LINE 00001556 "    my $fh = shift;"
NSQ_SOURCE_LINE 00001557 ""
NSQ_SOURCE_LINE 00001558 "    local( $\\, $\", $, ) = ( undef, ' ', '' );"
NSQ_SOURCE_LINE 00001559 "    return print $fh @_;"
NSQ_SOURCE_LINE 00001560 "}"
NSQ_SOURCE_LINE 00001561 ""
NSQ_SOURCE_LINE 00001562 "sub _error {"
NSQ_SOURCE_LINE 00001563 "    my $self    = shift;"
NSQ_SOURCE_LINE 00001564 "    my $error   = shift;"
NSQ_SOURCE_LINE 00001565 "    my $lerror  = Carp::longmess($error);"
NSQ_SOURCE_LINE 00001566 ""
NSQ_SOURCE_LINE 00001567 "    push @{$self->_error_msg},      $error;"
NSQ_SOURCE_LINE 00001568 "    push @{$self->_error_msg_long}, $lerror;"
NSQ_SOURCE_LINE 00001569 ""
NSQ_SOURCE_LINE 00001570 "    ### set $Archive::Extract::WARN to 0 to disable printing"
NSQ_SOURCE_LINE 00001571 "    ### of errors"
NSQ_SOURCE_LINE 00001572 "    if( $WARN ) {"
NSQ_SOURCE_LINE 00001573 "        carp $DEBUG ? $lerror : $error;"
NSQ_SOURCE_LINE 00001574 "    }"
NSQ_SOURCE_LINE 00001575 ""
NSQ_SOURCE_LINE 00001576 "    return;"
NSQ_SOURCE_LINE 00001577 "}"
NSQ_SOURCE_LINE 00001578 ""
NSQ_SOURCE_LINE 00001579 "sub error {"
NSQ_SOURCE_LINE 00001580 "    my $self = shift;"
NSQ_SOURCE_LINE 00001581 ""
NSQ_SOURCE_LINE 00001582 "    ### make sure we have a fallback aref"
NSQ_SOURCE_LINE 00001583 "    my $aref = do {"
NSQ_SOURCE_LINE 00001584 "        shift()"
NSQ_SOURCE_LINE 00001585 "            ? $self->_error_msg_long"
NSQ_SOURCE_LINE 00001586 "            : $self->_error_msg"
NSQ_SOURCE_LINE 00001587 "    } || [];"
NSQ_SOURCE_LINE 00001588 ""
NSQ_SOURCE_LINE 00001589 "    return join $/, @$aref;"
NSQ_SOURCE_LINE 00001590 "}"
NSQ_SOURCE_LINE 00001591 ""
NSQ_SOURCE_LINE 00001592 "=head2 debug( MESSAGE )"
NSQ_SOURCE_LINE 00001593 ""
NSQ_SOURCE_LINE 00001594 "This method outputs MESSAGE to the default filehandle if C<$DEBUG> is"
NSQ_SOURCE_LINE 00001595 "true. It's a small method, but it's here if you'd like to subclass it"
NSQ_SOURCE_LINE 00001596 "so you can so something else with any debugging output."
NSQ_SOURCE_LINE 00001597 ""
NSQ_SOURCE_LINE 00001598 "=cut"
NSQ_SOURCE_LINE 00001599 ""
NSQ_SOURCE_LINE 00001600 "### this is really a stub for subclassing"
NSQ_SOURCE_LINE 00001601 "sub debug {"
NSQ_SOURCE_LINE 00001602 "    return unless $DEBUG;"
NSQ_SOURCE_LINE 00001603 ""
NSQ_SOURCE_LINE 00001604 "    print $_[1];"
NSQ_SOURCE_LINE 00001605 "}"
NSQ_SOURCE_LINE 00001606 ""
NSQ_SOURCE_LINE 00001607 "sub _no_buffer_files {"
NSQ_SOURCE_LINE 00001608 "    my $self = shift;"
NSQ_SOURCE_LINE 00001609 "    my $file = shift or return;"
NSQ_SOURCE_LINE 00001610 "    return loc(\"No buffer captured, unable to tell \"."
NSQ_SOURCE_LINE 00001611 "               \"extracted files or extraction dir for '%1'\", $file);"
NSQ_SOURCE_LINE 00001612 "}"
NSQ_SOURCE_LINE 00001613 ""
NSQ_SOURCE_LINE 00001614 "sub _no_buffer_content {"
NSQ_SOURCE_LINE 00001615 "    my $self = shift;"
NSQ_SOURCE_LINE 00001616 "    my $file = shift or return;"
NSQ_SOURCE_LINE 00001617 "    return loc(\"No buffer captured, unable to get content for '%1'\", $file);"
NSQ_SOURCE_LINE 00001618 "}"
NSQ_SOURCE_LINE 00001619 "1;"
NSQ_SOURCE_LINE 00001620 ""
NSQ_SOURCE_LINE 00001621 "=pod"
NSQ_SOURCE_LINE 00001622 ""
NSQ_SOURCE_LINE 00001623 "=head1 UTILITY FUNCTION"
NSQ_SOURCE_LINE 00001624 ""
NSQ_SOURCE_LINE 00001625 "=head2 type_for($archive)"
NSQ_SOURCE_LINE 00001626 ""
NSQ_SOURCE_LINE 00001627 "Given an archive file name, it determins the type by parsing the file"
NSQ_SOURCE_LINE 00001628 "name extension. Used by C<new()> when the C<type> parameter is not passed."
NSQ_SOURCE_LINE 00001629 "Also useful when the archive file does not include a suffix but the file"
NSQ_SOURCE_LINE 00001630 "name is otherwise known, such as when a file is uploaded to a web server"
NSQ_SOURCE_LINE 00001631 "and stored with a temporary name that differs from the original name, and"
NSQ_SOURCE_LINE 00001632 "you want to use the same detection pattern as Archive::Extract. Example:"
NSQ_SOURCE_LINE 00001633 ""
NSQ_SOURCE_LINE 00001634 "  my $ae = Archive::Extract->new("
NSQ_SOURCE_LINE 00001635 "      archive => '/tmp/02af6s',"
NSQ_SOURCE_LINE 00001636 "      type    => Archive::Extract::type_for('archive.zip'),"
NSQ_SOURCE_LINE 00001637 "  );"
NSQ_SOURCE_LINE 00001638 ""
NSQ_SOURCE_LINE 00001639 "=head1 HOW IT WORKS"
NSQ_SOURCE_LINE 00001640 ""
NSQ_SOURCE_LINE 00001641 "C<Archive::Extract> tries first to determine what type of archive you"
NSQ_SOURCE_LINE 00001642 "are passing it, by inspecting its suffix. It does not do this by using"
NSQ_SOURCE_LINE 00001643 "Mime magic, or something related. See C<CAVEATS> below."
NSQ_SOURCE_LINE 00001644 ""
NSQ_SOURCE_LINE 00001645 "Once it has determined the file type, it knows which extraction methods"
NSQ_SOURCE_LINE 00001646 "it can use on the archive. It will try a perl solution first, then fall"
NSQ_SOURCE_LINE 00001647 "back to a commandline tool if that fails. If that also fails, it will"
NSQ_SOURCE_LINE 00001648 "return false, indicating it was unable to extract the archive."
NSQ_SOURCE_LINE 00001649 "See the section on C<GLOBAL VARIABLES> to see how to alter this order."
NSQ_SOURCE_LINE 00001650 ""
NSQ_SOURCE_LINE 00001651 "=head1 CAVEATS"
NSQ_SOURCE_LINE 00001652 ""
NSQ_SOURCE_LINE 00001653 "=head2 File Extensions"
NSQ_SOURCE_LINE 00001654 ""
NSQ_SOURCE_LINE 00001655 "C<Archive::Extract> trusts on the extension of the archive to determine"
NSQ_SOURCE_LINE 00001656 "what type it is, and what extractor methods therefore can be used. If"
NSQ_SOURCE_LINE 00001657 "your archives do not have any of the extensions as described in the"
NSQ_SOURCE_LINE 00001658 "C<new()> method, you will have to specify the type explicitly, or"
NSQ_SOURCE_LINE 00001659 "C<Archive::Extract> will not be able to extract the archive for you."
NSQ_SOURCE_LINE 00001660 ""
NSQ_SOURCE_LINE 00001661 "=head2 Supporting Very Large Files"
NSQ_SOURCE_LINE 00001662 ""
NSQ_SOURCE_LINE 00001663 "C<Archive::Extract> can use either pure perl modules or command line"
NSQ_SOURCE_LINE 00001664 "programs under the hood. Some of the pure perl modules (like"
NSQ_SOURCE_LINE 00001665 "C<Archive::Tar> and Compress::unLZMA) take the entire contents of the archive into memory,"
NSQ_SOURCE_LINE 00001666 "which may not be feasible on your system. Consider setting the global"
NSQ_SOURCE_LINE 00001667 "variable C<$Archive::Extract::PREFER_BIN> to C<1>, which will prefer"
NSQ_SOURCE_LINE 00001668 "the use of command line programs and won't consume so much memory."
NSQ_SOURCE_LINE 00001669 ""
NSQ_SOURCE_LINE 00001670 "See the C<GLOBAL VARIABLES> section below for details."
NSQ_SOURCE_LINE 00001671 ""
NSQ_SOURCE_LINE 00001672 "=head2 Bunzip2 support of arbitrary extensions."
NSQ_SOURCE_LINE 00001673 ""
NSQ_SOURCE_LINE 00001674 "Older versions of C</bin/bunzip2> do not support arbitrary file"
NSQ_SOURCE_LINE 00001675 "extensions and insist on a C<.bz2> suffix. Although we do our best"
NSQ_SOURCE_LINE 00001676 "to guard against this, if you experience a bunzip2 error, it may"
NSQ_SOURCE_LINE 00001677 "be related to this. For details, please see the C<have_old_bunzip2>"
NSQ_SOURCE_LINE 00001678 "method."
NSQ_SOURCE_LINE 00001679 ""
NSQ_SOURCE_LINE 00001680 "=head1 GLOBAL VARIABLES"
NSQ_SOURCE_LINE 00001681 ""
NSQ_SOURCE_LINE 00001682 "=head2 $Archive::Extract::DEBUG"
NSQ_SOURCE_LINE 00001683 ""
NSQ_SOURCE_LINE 00001684 "Set this variable to C<true> to have all calls to command line tools"
NSQ_SOURCE_LINE 00001685 "be printed out, including all their output."
NSQ_SOURCE_LINE 00001686 "This also enables C<Carp::longmess> errors, instead of the regular"
NSQ_SOURCE_LINE 00001687 "C<carp> errors."
NSQ_SOURCE_LINE 00001688 ""
NSQ_SOURCE_LINE 00001689 "Good for tracking down why things don't work with your particular"
NSQ_SOURCE_LINE 00001690 "setup."
NSQ_SOURCE_LINE 00001691 ""
NSQ_SOURCE_LINE 00001692 "Defaults to C<false>."
NSQ_SOURCE_LINE 00001693 ""
NSQ_SOURCE_LINE 00001694 "=head2 $Archive::Extract::WARN"
NSQ_SOURCE_LINE 00001695 ""
NSQ_SOURCE_LINE 00001696 "This variable controls whether errors encountered internally by"
NSQ_SOURCE_LINE 00001697 "C<Archive::Extract> should be C<carp>'d or not."
NSQ_SOURCE_LINE 00001698 ""
NSQ_SOURCE_LINE 00001699 "Set to false to silence warnings. Inspect the output of the C<error()>"
NSQ_SOURCE_LINE 00001700 "method manually to see what went wrong."
NSQ_SOURCE_LINE 00001701 ""
NSQ_SOURCE_LINE 00001702 "Defaults to C<true>."
NSQ_SOURCE_LINE 00001703 ""
NSQ_SOURCE_LINE 00001704 "=head2 $Archive::Extract::PREFER_BIN"
NSQ_SOURCE_LINE 00001705 ""
NSQ_SOURCE_LINE 00001706 "This variables controls whether C<Archive::Extract> should prefer the"
NSQ_SOURCE_LINE 00001707 "use of perl modules, or commandline tools to extract archives."
NSQ_SOURCE_LINE 00001708 ""
NSQ_SOURCE_LINE 00001709 "Set to C<true> to have C<Archive::Extract> prefer commandline tools."
NSQ_SOURCE_LINE 00001710 ""
NSQ_SOURCE_LINE 00001711 "Defaults to C<false>."
NSQ_SOURCE_LINE 00001712 ""
NSQ_SOURCE_LINE 00001713 "=head1 TODO / CAVEATS"
NSQ_SOURCE_LINE 00001714 ""
NSQ_SOURCE_LINE 00001715 "=over 4"
NSQ_SOURCE_LINE 00001716 ""
NSQ_SOURCE_LINE 00001717 "=item Mime magic support"
NSQ_SOURCE_LINE 00001718 ""
NSQ_SOURCE_LINE 00001719 "Maybe this module should use something like C<File::Type> to determine"
NSQ_SOURCE_LINE 00001720 "the type, rather than blindly trust the suffix."
NSQ_SOURCE_LINE 00001721 ""
NSQ_SOURCE_LINE 00001722 "=item Thread safety"
NSQ_SOURCE_LINE 00001723 ""
NSQ_SOURCE_LINE 00001724 "Currently, C<Archive::Extract> does a C<chdir> to the extraction dir before"
NSQ_SOURCE_LINE 00001725 "extraction, and a C<chdir> back again after. This is not necessarily"
NSQ_SOURCE_LINE 00001726 "thread safe. See C<rt.cpan.org> bug C<#45671> for details."
NSQ_SOURCE_LINE 00001727 ""
NSQ_SOURCE_LINE 00001728 "=back"
NSQ_SOURCE_LINE 00001729 ""
NSQ_SOURCE_LINE 00001730 "=head1 BUG REPORTS"
NSQ_SOURCE_LINE 00001731 ""
NSQ_SOURCE_LINE 00001732 "Please report bugs or other issues to E<lt>bug-archive-extract@rt.cpan.orgE<gt>."
NSQ_SOURCE_LINE 00001733 ""
