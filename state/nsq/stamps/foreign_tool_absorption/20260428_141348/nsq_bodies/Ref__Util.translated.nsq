NSQ_SOURCE_LINE 00000001 "package Ref::Util;"
NSQ_SOURCE_LINE 00000002 "# ABSTRACT: Utility functions for checking references"
NSQ_SOURCE_LINE 00000003 "$Ref::Util::VERSION = '0.204';"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "use Exporter 5.57 'import';"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "{"
NSQ_SOURCE_LINE 00000010 "    my $impl = $ENV{PERL_REF_UTIL_IMPLEMENTATION}"
NSQ_SOURCE_LINE 00000011 "        || our $IMPLEMENTATION"
NSQ_SOURCE_LINE 00000012 "        || 'XS';"
NSQ_SOURCE_LINE 00000013 "    if ($impl ne 'PP' && eval { require Ref::Util::XS; 1 }) {"
NSQ_SOURCE_LINE 00000014 "        _install_aliases('Ref::Util::XS');"
NSQ_SOURCE_LINE 00000015 "    }"
NSQ_SOURCE_LINE 00000016 "    else {"
NSQ_SOURCE_LINE 00000017 "        require Ref::Util::PP;"
NSQ_SOURCE_LINE 00000018 "        _install_aliases('Ref::Util::PP');"
NSQ_SOURCE_LINE 00000019 "    }"
NSQ_SOURCE_LINE 00000020 "}"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "sub _install_aliases {"
NSQ_SOURCE_LINE 00000023 "    my ($package) = @_;"
NSQ_SOURCE_LINE 00000024 "    no warnings 'once';"
NSQ_SOURCE_LINE 00000025 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000026 "    our %EXPORT_TAGS = %{\"${package}::EXPORT_TAGS\"};"
NSQ_SOURCE_LINE 00000027 "    our @EXPORT_OK   = @{\"${package}::EXPORT_OK\"};"
NSQ_SOURCE_LINE 00000028 "    *$_ = \\&{\"${package}::$_\"} for '_using_custom_ops', @EXPORT_OK;"
NSQ_SOURCE_LINE 00000029 "}"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "1;"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "__END__"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "=pod"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "=head1 NAME"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "Ref::Util - Utility functions for checking references"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "=head1 VERSION"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "version 0.204"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "    use Ref::Util qw( is_plain_arrayref is_plain_hashref );"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "    if ( is_plain_arrayref( $something ) ) {"
NSQ_SOURCE_LINE 00000052 "        print for @{ $something };"
NSQ_SOURCE_LINE 00000053 "    } elsif ( is_plain_hashref( $something ) ) {"
NSQ_SOURCE_LINE 00000054 "        print for sort values %{ $something };"
NSQ_SOURCE_LINE 00000055 "    }"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "Ref::Util introduces several functions to help identify references in a"
NSQ_SOURCE_LINE 00000060 "B<smarter> (and usually faster) way. In short:"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "    # conventional approach             # with Ref::Util"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "    ref( $foo ) eq 'ARRAY'              is_plain_arrayref( $foo )"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "    use Scalar::Util qw( reftype );"
NSQ_SOURCE_LINE 00000067 "    reftype( $foo ) eq 'ARRAY'          is_arrayref( $foo )"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "The difference:"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "=over 4"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "=item * No comparison against a string constant"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "When you call C<ref>, you stringify the reference and then compare it"
NSQ_SOURCE_LINE 00000076 "to some string constant (like C<ARRAY> or C<HASH>). Not just awkward,"
NSQ_SOURCE_LINE 00000077 "it's brittle since you can mispell the string."
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "If you use L<Scalar::Util>'s C<reftype>, you still compare it as a"
NSQ_SOURCE_LINE 00000080 "string:"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "    if ( reftype($foo) eq 'ARRAY' ) { ... }"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "=item * Supports blessed variables"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "B<Note:> In future versions, the idea is to make the default functions"
NSQ_SOURCE_LINE 00000087 "use the B<plain> variation, which means explicitly non-blessed references."
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "If you want to explicitly check for B<blessed> references, you should use"
NSQ_SOURCE_LINE 00000090 "the C<is_blessed_*> functions. There will be an C<is_any_*> variation"
NSQ_SOURCE_LINE 00000091 "which will act like the current main functions - not caring whether it's"
NSQ_SOURCE_LINE 00000092 "blessed or not."
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "When calling C<ref>, you receive either the reference type (B<SCALAR>,"
NSQ_SOURCE_LINE 00000095 "B<ARRAY>, B<HASH>, etc.) or the package it's blessed into."
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "When calling C<is_arrayref> (et. al.), you check the variable flags,"
NSQ_SOURCE_LINE 00000098 "so even if it's blessed, you know what type of variable is blessed."
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "    my $foo = bless {}, 'PKG';"
NSQ_SOURCE_LINE 00000101 "    ref($foo) eq 'HASH'; # fails"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "    use Ref::Util 'is_hashref';"
NSQ_SOURCE_LINE 00000104 "    my $foo = bless {}, 'PKG';"
NSQ_SOURCE_LINE 00000105 "    is_hashref($foo); # works"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "On the other hand, in some situations it might be better to specifically"
NSQ_SOURCE_LINE 00000108 "exclude blessed references. The rationale for that might be that merely"
NSQ_SOURCE_LINE 00000109 "because some object happens to be implemented using a hash doesn't mean it's"
NSQ_SOURCE_LINE 00000110 "necessarily correct to treat it as a hash. For these situations, you can use"
NSQ_SOURCE_LINE 00000111 "C<is_plain_hashref> and friends, which have the same performance benefits as"
NSQ_SOURCE_LINE 00000112 "C<is_hashref>."
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "There is also a family of functions with names like C<is_blessed_hashref>;"
NSQ_SOURCE_LINE 00000115 "these return true for blessed object instances that are implemented using"
NSQ_SOURCE_LINE 00000116 "the relevant underlying type."
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "=item * Supports tied variables and magic"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "Tied variables (used in L<Readonly>, for example) are supported."
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "    use Ref::Util qw<is_plain_hashref>;"
NSQ_SOURCE_LINE 00000123 "    use Readonly;"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "    Readonly::Scalar my $rh2 => { a => { b => 2 } };"
NSQ_SOURCE_LINE 00000126 "    is_plain_hashref($rh2); # success"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "L<Ref::Util> added support for this in 0.100. Prior to this version"
NSQ_SOURCE_LINE 00000129 "the test would fail."
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "=item * Ignores overloading"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "These functions ignore overloaded operators and simply check the"
NSQ_SOURCE_LINE 00000134 "variable type. Overloading will likely not ever be supported, since I"
NSQ_SOURCE_LINE 00000135 "deem it problematic and confusing."
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "Overloading makes your variables opaque containers and hides away"
NSQ_SOURCE_LINE 00000138 "B<what> they are and instead require you to figure out B<how> to use"
NSQ_SOURCE_LINE 00000139 "them. This leads to code that has to test different abilities (in"
NSQ_SOURCE_LINE 00000140 "C<eval>, so it doesn't crash) and to interfaces that get around what"
NSQ_SOURCE_LINE 00000141 "a person thought you would do with a variable. This would have been"
NSQ_SOURCE_LINE 00000142 "alright, except there is no clear way of introspecting it."
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "=item * Ignores subtle types:"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "The following types, provided by L<Scalar::Util>'s C<reftype>, are"
NSQ_SOURCE_LINE 00000147 "not supported:"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "=over 4"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "=item * C<VSTRING>"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "This is a C<PVMG> (\"normal\" variable) with a flag set for VSTRINGs."
NSQ_SOURCE_LINE 00000154 "Since this is not a reference, it is not supported."
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "=item * C<LVALUE>"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "A variable that delegates to another scalar. Since this is not a"
NSQ_SOURCE_LINE 00000159 "reference, it is not supported."
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "=item * C<INVLIST>"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "I couldn't find documentation for this type."
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "=back"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "Support might be added, if a good reason arises."
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "=item * Usually fast"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "When possible, Ref::Util uses L<Ref::Util::XS> as its implementation. (If"
NSQ_SOURCE_LINE 00000172 "you don't have a C compiler available, it uses a pure Perl fallback that has"
NSQ_SOURCE_LINE 00000173 "all the other advantages of Ref::Util, but isn't as fast.)"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "In fact, Ref::Util::XS has two alternative implementations available"
NSQ_SOURCE_LINE 00000176 "internally, depending on the features supported by the version of Perl"
NSQ_SOURCE_LINE 00000177 "you're using. For Perls that supports custom OPs, we actually add an OP"
NSQ_SOURCE_LINE 00000178 "(which is faster); for other Perls, the implementation that simply calls an"
NSQ_SOURCE_LINE 00000179 "XS function (which is still faster than the pure-Perl equivalent)."
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "See below for L<benchmark results|/\"BENCHMARKS\">."
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "=back"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "=head1 EXPORT"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "Nothing is exported by default. You can ask for specific subroutines"
NSQ_SOURCE_LINE 00000188 "(described below) or ask for all subroutines at once:"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "    use Ref::Util qw<is_scalarref is_arrayref is_hashref ...>;"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "    # or"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "    use Ref::Util ':all';"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "=head1 SUBROUTINES"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "=head2 is_ref($ref)"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "Check for a reference to anything."
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "    is_ref([]);"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "=head2 is_scalarref($ref)"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "Check for a scalar reference."
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "    is_scalarref(\\\"hello\");"
NSQ_SOURCE_LINE 00000209 "    is_scalarref(\\30);"
NSQ_SOURCE_LINE 00000210 "    is_scalarref(\\$value);"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "Note that, even though a reference is itself a type of scalar value, a"
NSQ_SOURCE_LINE 00000213 "reference to another reference is not treated as a scalar reference:"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "    !is_scalarref(\\\\1);"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "The rationale for this is two-fold. First, callers that want to decide how"
NSQ_SOURCE_LINE 00000218 "to handle inputs based on their reference type will usually want to treat a"
NSQ_SOURCE_LINE 00000219 "ref-ref and a scalar-ref differently. Secondly, this more closely matches"
NSQ_SOURCE_LINE 00000220 "the behavior of the C<ref> built-in and of L<Scalar::Util/reftype>, which"
NSQ_SOURCE_LINE 00000221 "report a ref-ref as C<REF> rather than C<SCALAR>."
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "=head2 is_arrayref($ref)"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "Check for an array reference."
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "    is_arrayref([]);"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "=head2 is_hashref($ref)"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "Check for a hash reference."
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "    is_hashref({});"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "=head2 is_coderef($ref)"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "Check for a code reference."
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "    is_coderef( sub {} );"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "=head2 is_regexpref($ref)"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "Check for a regular expression (regex, regexp) reference."
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "    is_regexpref( qr// );"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "=head2 is_globref($ref)"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "Check for a glob reference."
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "    is_globref( \\*STDIN );"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "=head2 is_formatref($ref)"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "Check for a format reference."
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "    # set up format in STDOUT"
NSQ_SOURCE_LINE 00000258 "    format STDOUT ="
NSQ_SOURCE_LINE 00000259 "    ."
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "    # now we can test it"
NSQ_SOURCE_LINE 00000262 "    is_formatref( *main::STDOUT{'FORMAT'} );"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "This function is not available in Perl 5.6 and will trigger a"
NSQ_SOURCE_LINE 00000265 "C<croak()>."
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "=head2 is_ioref($ref)"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "Check for an IO reference."
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "    is_ioref( *STDOUT{IO} );"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "=head2 is_refref($ref)"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "Check for a reference to a reference."
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "    is_refref( \\[] ); # reference to array reference"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "=head2 is_plain_scalarref($ref)"
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "Check for an unblessed scalar reference."
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "    is_plain_scalarref(\\\"hello\");"
NSQ_SOURCE_LINE 00000284 "    is_plain_scalarref(\\30);"
NSQ_SOURCE_LINE 00000285 "    is_plain_scalarref(\\$value);"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "=head2 is_plain_ref($ref)"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "Check for an unblessed reference to anything."
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "    is_plain_ref([]);"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "=head2 is_plain_arrayref($ref)"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "Check for an unblessed array reference."
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "    is_plain_arrayref([]);"
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "=head2 is_plain_hashref($ref)"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "Check for an unblessed hash reference."
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "    is_plain_hashref({});"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "=head2 is_plain_coderef($ref)"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "Check for an unblessed code reference."
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "    is_plain_coderef( sub {} );"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "=head2 is_plain_globref($ref)"
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "Check for an unblessed glob reference."
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "    is_plain_globref( \\*STDIN );"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "=head2 is_plain_formatref($ref)"
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "Check for an unblessed format reference."
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "    # set up format in STDOUT"
NSQ_SOURCE_LINE 00000322 "    format STDOUT ="
NSQ_SOURCE_LINE 00000323 "    ."
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "    # now we can test it"
NSQ_SOURCE_LINE 00000326 "    is_plain_formatref(bless *main::STDOUT{'FORMAT'} );"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "=head2 is_plain_refref($ref)"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "Check for an unblessed reference to a reference."
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "    is_plain_refref( \\[] ); # reference to array reference"
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "=head2 is_blessed_scalarref($ref)"
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "Check for a blessed scalar reference."
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "    is_blessed_scalarref(bless \\$value);"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "=head2 is_blessed_ref($ref)"
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "Check for a blessed reference to anything."
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "    is_blessed_ref(bless [], $class);"
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "=head2 is_blessed_arrayref($ref)"
NSQ_SOURCE_LINE 00000347 ""
NSQ_SOURCE_LINE 00000348 "Check for a blessed array reference."
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "    is_blessed_arrayref(bless [], $class);"
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "=head2 is_blessed_hashref($ref)"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "Check for a blessed hash reference."
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "    is_blessed_hashref(bless {}, $class);"
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 "=head2 is_blessed_coderef($ref)"
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 "Check for a blessed code reference."
NSQ_SOURCE_LINE 00000361 ""
NSQ_SOURCE_LINE 00000362 "    is_blessed_coderef( bless sub {}, $class );"
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "=head2 is_blessed_globref($ref)"
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "Check for a blessed glob reference."
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 "    is_blessed_globref( bless \\*STDIN, $class );"
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "=head2 is_blessed_formatref($ref)"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "Check for a blessed format reference."
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "    # set up format for FH"
NSQ_SOURCE_LINE 00000375 "    format FH ="
NSQ_SOURCE_LINE 00000376 "    ."
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 "    # now we can test it"
NSQ_SOURCE_LINE 00000379 "    is_blessed_formatref(bless *FH{'FORMAT'}, $class );"
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "=head2 is_blessed_refref($ref)"
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "Check for a blessed reference to a reference."
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "    is_blessed_refref( bless \\[], $class ); # reference to array reference"
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "=head1 BENCHMARKS"
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "Here is a benchmark comparing similar checks."
NSQ_SOURCE_LINE 00000390 ""
NSQ_SOURCE_LINE 00000391 "    my $bench = Dumbbench->new("
NSQ_SOURCE_LINE 00000392 "        target_rel_precision => 0.005,"
NSQ_SOURCE_LINE 00000393 "        initial_runs         => 20,"
NSQ_SOURCE_LINE 00000394 "    );"
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "    my $amount = 1e7;"
NSQ_SOURCE_LINE 00000397 "    my $ref    = [];"
NSQ_SOURCE_LINE 00000398 "    $bench->add_instances("
NSQ_SOURCE_LINE 00000399 "        Dumbbench::Instance::PerlSub->new("
NSQ_SOURCE_LINE 00000400 "            name => 'Ref::Util::is_plain_arrayref (CustomOP)',"
NSQ_SOURCE_LINE 00000401 "            code => sub {"
NSQ_SOURCE_LINE 00000402 "                Ref::Util::is_plain_arrayref($ref) for ( 1 .. $amount )"
NSQ_SOURCE_LINE 00000403 "            },"
NSQ_SOURCE_LINE 00000404 "        ),"
NSQ_SOURCE_LINE 00000405 ""
NSQ_SOURCE_LINE 00000406 "        Dumbbench::Instance::PerlSub->new("
NSQ_SOURCE_LINE 00000407 "            name => 'ref(), reftype(), !blessed()',"
NSQ_SOURCE_LINE 00000408 "            code => sub {"
NSQ_SOURCE_LINE 00000409 "                ref $ref"
NSQ_SOURCE_LINE 00000410 "                    && Scalar::Util::reftype($ref) eq 'ARRAY'"
NSQ_SOURCE_LINE 00000411 "                    && !Scalar::Util::blessed($ref)"
NSQ_SOURCE_LINE 00000412 "                    for ( 1 .. $amount );"
NSQ_SOURCE_LINE 00000413 "            },"
NSQ_SOURCE_LINE 00000414 "        ),"
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "        Dumbbench::Instance::PerlSub->new("
NSQ_SOURCE_LINE 00000417 "            name => 'ref()',"
NSQ_SOURCE_LINE 00000418 "            code => sub { ref($ref) eq 'ARRAY' for ( 1 .. $amount ) },"
NSQ_SOURCE_LINE 00000419 "        ),"
NSQ_SOURCE_LINE 00000420 ""
NSQ_SOURCE_LINE 00000421 "        Dumbbench::Instance::PerlSub->new("
NSQ_SOURCE_LINE 00000422 "            name => 'Data::Util::is_array_ref',"
NSQ_SOURCE_LINE 00000423 "            code => sub { is_array_ref($ref) for ( 1 .. $amount ) },"
NSQ_SOURCE_LINE 00000424 "        ),"
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 "    );"
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "The results:"
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "    ref():                                   5.335e+00 +/- 1.8e-02 (0.3%)"
NSQ_SOURCE_LINE 00000431 "    ref(), reftype(), !blessed():            1.5545e+01 +/- 3.1e-02 (0.2%)"
NSQ_SOURCE_LINE 00000432 "    Ref::Util::is_plain_arrayref (CustomOP): 2.7951e+00 +/- 6.2e-03 (0.2%)"
NSQ_SOURCE_LINE 00000433 "    Data::Util::is_array_ref:                5.9074e+00 +/- 7.5e-03 (0.1%)"
NSQ_SOURCE_LINE 00000434 ""
NSQ_SOURCE_LINE 00000435 "(Rounded run time per iteration)"
NSQ_SOURCE_LINE 00000436 ""
