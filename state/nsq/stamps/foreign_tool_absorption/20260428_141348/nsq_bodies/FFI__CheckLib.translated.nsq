NSQ_SOURCE_LINE 00000001 "package FFI::CheckLib;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 "use File::Spec;"
NSQ_SOURCE_LINE 00000006 "use List::Util 1.33 qw( any );"
NSQ_SOURCE_LINE 00000007 "use Carp qw( croak carp );"
NSQ_SOURCE_LINE 00000008 "use Env qw( @FFI_CHECKLIB_PATH );"
NSQ_SOURCE_LINE 00000009 "use base qw( Exporter );"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "our @EXPORT = qw("
NSQ_SOURCE_LINE 00000012 "  find_lib"
NSQ_SOURCE_LINE 00000013 "  assert_lib"
NSQ_SOURCE_LINE 00000014 "  check_lib"
NSQ_SOURCE_LINE 00000015 "  check_lib_or_exit"
NSQ_SOURCE_LINE 00000016 "  find_lib_or_exit"
NSQ_SOURCE_LINE 00000017 "  find_lib_or_die"
