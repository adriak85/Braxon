NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "# ABSTRACT: Check that a library is available for FFI"
NSQ_SOURCE_LINE 00000027 "our $VERSION = '0.31'; # VERSION"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "our $system_path = [];"
NSQ_SOURCE_LINE 00000031 "our $os ||= $^O;"
NSQ_SOURCE_LINE 00000032 "my $try_ld_on_text = 0;"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "sub _homebrew_lib_path {"
NSQ_SOURCE_LINE 00000035 "  require File::Which;"
NSQ_SOURCE_LINE 00000036 "  return undef unless File::Which::which('brew');"
NSQ_SOURCE_LINE 00000037 "  chomp(my $brew_path = (qx`brew --prefix`)[0]);"
NSQ_SOURCE_LINE 00000038 "  return \"$brew_path/lib\";"
NSQ_SOURCE_LINE 00000039 "}"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "sub _macports_lib_path {"
NSQ_SOURCE_LINE 00000042 "  require File::Which;"
NSQ_SOURCE_LINE 00000043 "  my $port_path = File::Which::which('port');"
NSQ_SOURCE_LINE 00000044 "  return undef unless $port_path;"
NSQ_SOURCE_LINE 00000045 "  $port_path =~ s|bin/port|lib|;"
NSQ_SOURCE_LINE 00000046 "  return $port_path;"
NSQ_SOURCE_LINE 00000047 "}"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "sub _darwin_extra_paths {"
NSQ_SOURCE_LINE 00000050 "  my $pkg_managers = lc( $ENV{FFI_CHECKLIB_PACKAGE} || 'homebrew,macports' );"
NSQ_SOURCE_LINE 00000051 "  return () if $pkg_managers eq 'none';"
NSQ_SOURCE_LINE 00000052 "  my $supported_managers = {"
NSQ_SOURCE_LINE 00000053 "      homebrew => \\&_homebrew_lib_path,"
NSQ_SOURCE_LINE 00000054 "      macports => \\&_macports_lib_path"
NSQ_SOURCE_LINE 00000055 "  };"
NSQ_SOURCE_LINE 00000056 "  my @extra_paths = ();"
NSQ_SOURCE_LINE 00000057 "  foreach my $pkg_manager (split( /,/, $pkg_managers )) {"
NSQ_SOURCE_LINE 00000058 "    if (my $lib_path = $supported_managers->{$pkg_manager}()) {"
NSQ_SOURCE_LINE 00000059 "      push @extra_paths, $lib_path;"
NSQ_SOURCE_LINE 00000060 "    }"
NSQ_SOURCE_LINE 00000061 "  }"
NSQ_SOURCE_LINE 00000062 "  return @extra_paths;"
NSQ_SOURCE_LINE 00000063 "}"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "my @extra_paths = ();"
NSQ_SOURCE_LINE 00000066 "if($os eq 'MSWin32' || $os eq 'msys')"
NSQ_SOURCE_LINE 00000067 "{"
NSQ_SOURCE_LINE 00000068 "  $system_path = eval {"
NSQ_SOURCE_LINE 00000069 "    require Env;"
NSQ_SOURCE_LINE 00000070 "    Env->import('@PATH');"
NSQ_SOURCE_LINE 00000071 "    \\our @PATH;"
NSQ_SOURCE_LINE 00000072 "  };"
NSQ_SOURCE_LINE 00000073 "  die $@ if $@;"
NSQ_SOURCE_LINE 00000074 "}"
NSQ_SOURCE_LINE 00000075 "else"
NSQ_SOURCE_LINE 00000076 "{"
NSQ_SOURCE_LINE 00000077 "  $system_path = eval {"
NSQ_SOURCE_LINE 00000078 "    require DynaLoader;"
NSQ_SOURCE_LINE 00000079 "    no warnings 'once';"
NSQ_SOURCE_LINE 00000080 "    \\@DynaLoader::dl_library_path;"
NSQ_SOURCE_LINE 00000081 "  };"
NSQ_SOURCE_LINE 00000082 "  die $@ if $@;"
NSQ_SOURCE_LINE 00000083 "  @extra_paths = _darwin_extra_paths() if $os eq 'darwin';"
NSQ_SOURCE_LINE 00000084 "}"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "our $pattern = [ qr{^lib(.*?)\\.so(?:\\.([0-9]+(?:\\.[0-9]+)*))?$} ];"
NSQ_SOURCE_LINE 00000087 "our $version_split = qr/\\./;"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "if($os eq 'cygwin')"
NSQ_SOURCE_LINE 00000090 "{"
NSQ_SOURCE_LINE 00000091 "  push @$pattern, qr{^cyg(.*?)(?:-([0-9])+)?\\.dll$};"
NSQ_SOURCE_LINE 00000092 "}"
NSQ_SOURCE_LINE 00000093 "elsif($os eq 'msys')"
NSQ_SOURCE_LINE 00000094 "{"
NSQ_SOURCE_LINE 00000095 "  # doesn't seem as though msys uses psudo libfoo.so files"
NSQ_SOURCE_LINE 00000096 "  # in the way that cygwin sometimes does.  we can revisit"
NSQ_SOURCE_LINE 00000097 "  # this if we find otherwise."
NSQ_SOURCE_LINE 00000098 "  $pattern = [ qr{^msys-(.*?)(?:-([0-9])+)?\\.dll$} ];"
NSQ_SOURCE_LINE 00000099 "}"
NSQ_SOURCE_LINE 00000100 "elsif($os eq 'MSWin32')"
NSQ_SOURCE_LINE 00000101 "{"
NSQ_SOURCE_LINE 00000102 "  #  handle cases like libgeos-3-7-0___.dll, libproj_9_1.dll and libgtk-2.0-0.dll"
NSQ_SOURCE_LINE 00000103 "  $pattern = [ qr{^(?:lib)?(\\w+?)(?:[_-]([0-9\\-\\._]+))?_*\\.dll$}i ];"
NSQ_SOURCE_LINE 00000104 "  $version_split = qr/[_\\-]/;"
NSQ_SOURCE_LINE 00000105 "}"
NSQ_SOURCE_LINE 00000106 "elsif($os eq 'darwin')"
NSQ_SOURCE_LINE 00000107 "{"
NSQ_SOURCE_LINE 00000108 "  push @$pattern, qr{^lib(.*?)(?:\\.([0-9]+(?:\\.[0-9]+)*))?\\.(?:dylib|bundle)$};"
NSQ_SOURCE_LINE 00000109 "}"
NSQ_SOURCE_LINE 00000110 "elsif($os eq 'linux')"
NSQ_SOURCE_LINE 00000111 "{"
NSQ_SOURCE_LINE 00000112 "  if(-e '/etc/redhat-release' && -x '/usr/bin/ld')"
NSQ_SOURCE_LINE 00000113 "  {"
NSQ_SOURCE_LINE 00000114 "    $try_ld_on_text = 1;"
NSQ_SOURCE_LINE 00000115 "  }"
NSQ_SOURCE_LINE 00000116 "}"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "sub _matches"
NSQ_SOURCE_LINE 00000119 "{"
NSQ_SOURCE_LINE 00000120 "  my($filename, $path) = @_;"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "  foreach my $regex (@$pattern)"
NSQ_SOURCE_LINE 00000123 "  {"
NSQ_SOURCE_LINE 00000124 "    return ["
NSQ_SOURCE_LINE 00000125 "      $1,                                            # 0    capture group 1 library name"
NSQ_SOURCE_LINE 00000126 "      File::Spec->catfile($path, $filename),         # 1    full path to library"
NSQ_SOURCE_LINE 00000127 "      defined $2 ? (split $version_split, $2) : (),  # 2... capture group 2 library version"
NSQ_SOURCE_LINE 00000128 "    ] if $filename =~ $regex;"
NSQ_SOURCE_LINE 00000129 "  }"
NSQ_SOURCE_LINE 00000130 "  return ();"
NSQ_SOURCE_LINE 00000131 "}"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "sub _cmp"
NSQ_SOURCE_LINE 00000134 "{"
NSQ_SOURCE_LINE 00000135 "  my($A,$B) = @_;"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "  return $A->[0] cmp $B->[0] if $A->[0] ne $B->[0];"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "  my $i=2;"
NSQ_SOURCE_LINE 00000140 "  while(1)"
NSQ_SOURCE_LINE 00000141 "  {"
NSQ_SOURCE_LINE 00000142 "    return 0  if !defined($A->[$i]) && !defined($B->[$i]);"
NSQ_SOURCE_LINE 00000143 "    return -1 if !defined $A->[$i];"
NSQ_SOURCE_LINE 00000144 "    return 1  if !defined $B->[$i];"
NSQ_SOURCE_LINE 00000145 "    return $B->[$i] <=> $A->[$i] if $A->[$i] != $B->[$i];"
NSQ_SOURCE_LINE 00000146 "    $i++;"
NSQ_SOURCE_LINE 00000147 "  }"
NSQ_SOURCE_LINE 00000148 "}"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "my $diagnostic;"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "sub _is_binary"
NSQ_SOURCE_LINE 00000154 "{"
NSQ_SOURCE_LINE 00000155 "  -B $_[0]"
NSQ_SOURCE_LINE 00000156 "}"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "sub find_lib"
NSQ_SOURCE_LINE 00000159 "{"
NSQ_SOURCE_LINE 00000160 "  my(%args) = @_;"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "  undef $diagnostic;"
NSQ_SOURCE_LINE 00000163 "  croak \"find_lib requires lib argument\" unless defined $args{lib};"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "  my $recursive = $args{_r} || $args{recursive} || 0;"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "  # make arguments be lists."
NSQ_SOURCE_LINE 00000168 "  foreach my $arg (qw( lib libpath symbol verify alien ))"
NSQ_SOURCE_LINE 00000169 "  {"
NSQ_SOURCE_LINE 00000170 "    next if ref $args{$arg} eq 'ARRAY';"
NSQ_SOURCE_LINE 00000171 "    if(defined $args{$arg})"
NSQ_SOURCE_LINE 00000172 "    {"
NSQ_SOURCE_LINE 00000173 "      $args{$arg} = [ $args{$arg} ];"
NSQ_SOURCE_LINE 00000174 "    }"
NSQ_SOURCE_LINE 00000175 "    else"
NSQ_SOURCE_LINE 00000176 "    {"
NSQ_SOURCE_LINE 00000177 "      $args{$arg} = [];"
NSQ_SOURCE_LINE 00000178 "    }"
NSQ_SOURCE_LINE 00000179 "  }"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "  if(defined $args{systempath} && !ref($args{systempath}))"
NSQ_SOURCE_LINE 00000182 "  {"
NSQ_SOURCE_LINE 00000183 "    $args{systempath} = [ $args{systempath} ];"
NSQ_SOURCE_LINE 00000184 "  }"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "  my @path = @{ $args{libpath} };"
NSQ_SOURCE_LINE 00000187 "  @path = map { _recurse($_) } @path if $recursive;"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "  if(defined $args{systempath})"
NSQ_SOURCE_LINE 00000190 "  {"
NSQ_SOURCE_LINE 00000191 "    push @path, grep { defined } @{ $args{systempath} }"
NSQ_SOURCE_LINE 00000192 "  }"
NSQ_SOURCE_LINE 00000193 "  else"
NSQ_SOURCE_LINE 00000194 "  {"
NSQ_SOURCE_LINE 00000195 "    # This is a little convaluted, but:"
NSQ_SOURCE_LINE 00000196 "    # 1. These are modifications of what we consider the \"system\" path"
NSQ_SOURCE_LINE 00000197 "    #    if systempath isn't explicitly passed in as systempath"
NSQ_SOURCE_LINE 00000198 "    # 2. FFI_CHECKLIB_PATH is considered an authortative modification"
NSQ_SOURCE_LINE 00000199 "    #    so it goes first and overrides FFI_CHECKLIB_PACKAGE"
NSQ_SOURCE_LINE 00000200 "    # 3. otherwise FFI_CHECKLIB_PACKAGE does its thing and goes on"
NSQ_SOURCE_LINE 00000201 "    #    the end because homebrew does a good job of not replacing"
NSQ_SOURCE_LINE 00000202 "    #    anything in the system by default."
NSQ_SOURCE_LINE 00000203 "    # 4. We finally add what we consider the \"system\" path to the end of"
NSQ_SOURCE_LINE 00000204 "    #    the search path so that libpath will be searched first."
NSQ_SOURCE_LINE 00000205 "    my @system_path = @$system_path;"
NSQ_SOURCE_LINE 00000206 "    if($ENV{FFI_CHECKLIB_PATH})"
NSQ_SOURCE_LINE 00000207 "    {"
NSQ_SOURCE_LINE 00000208 "      @system_path = (@FFI_CHECKLIB_PATH, @system_path);"
NSQ_SOURCE_LINE 00000209 "    }"
NSQ_SOURCE_LINE 00000210 "    else"
NSQ_SOURCE_LINE 00000211 "    {"
NSQ_SOURCE_LINE 00000212 "      foreach my $extra_path (@extra_paths)"
NSQ_SOURCE_LINE 00000213 "      {"
NSQ_SOURCE_LINE 00000214 "        push @path, $extra_path unless any { $_ eq $extra_path } @path;"
NSQ_SOURCE_LINE 00000215 "      }"
NSQ_SOURCE_LINE 00000216 "    }"
NSQ_SOURCE_LINE 00000217 "    push @path, @system_path;"
NSQ_SOURCE_LINE 00000218 "  }"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "  my $any = any { $_ eq '*' } @{ $args{lib} };"
NSQ_SOURCE_LINE 00000221 "  my %missing = map { $_ => 1 } @{ $args{lib} };"
NSQ_SOURCE_LINE 00000222 "  my %symbols = map { $_ => 1 } @{ $args{symbol} };"
NSQ_SOURCE_LINE 00000223 "  my @found;"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "  delete $missing{'*'};"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "  alien: foreach my $alien (reverse @{ $args{alien} })"
NSQ_SOURCE_LINE 00000228 "  {"
NSQ_SOURCE_LINE 00000229 "    unless($alien =~ /^([A-Za-z_][A-Za-z_0-9]*)(::[A-Za-z_][A-Za-z_0-9]*)*$/)"
NSQ_SOURCE_LINE 00000230 "    {"
NSQ_SOURCE_LINE 00000231 "      croak \"Doesn't appear to be a valid Alien name $alien\";"
NSQ_SOURCE_LINE 00000232 "    }"
NSQ_SOURCE_LINE 00000233 "    unless(eval { $alien->can('dynamic_libs') })"
NSQ_SOURCE_LINE 00000234 "    {"
NSQ_SOURCE_LINE 00000235 "      {"
NSQ_SOURCE_LINE 00000236 "        my $pm = \"$alien.pm\";"
NSQ_SOURCE_LINE 00000237 "        $pm =~ s/::/\\//g;"
NSQ_SOURCE_LINE 00000238 "        local $@ = '';"
NSQ_SOURCE_LINE 00000239 "        eval { require $pm };"
NSQ_SOURCE_LINE 00000240 "        next alien if $@;"
NSQ_SOURCE_LINE 00000241 "      }"
NSQ_SOURCE_LINE 00000242 "      unless(eval { $alien->can('dynamic_libs') })"
NSQ_SOURCE_LINE 00000243 "      {"
NSQ_SOURCE_LINE 00000244 "        croak \"Alien $alien doesn't provide a dynamic_libs method\";"
NSQ_SOURCE_LINE 00000245 "      }"
NSQ_SOURCE_LINE 00000246 "    }"
NSQ_SOURCE_LINE 00000247 "    unshift @path, [$alien->dynamic_libs];"
NSQ_SOURCE_LINE 00000248 "  }"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "  foreach my $path (@path)"
NSQ_SOURCE_LINE 00000251 "  {"
NSQ_SOURCE_LINE 00000252 "    next if ref $path ne 'ARRAY' && ! -d $path;"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "    my @maybe ="
NSQ_SOURCE_LINE 00000255 "      # make determinist based on names and versions"
NSQ_SOURCE_LINE 00000256 "      sort { _cmp($a,$b) }"
NSQ_SOURCE_LINE 00000257 "      # Filter out the items that do not match the name that we are looking for"
NSQ_SOURCE_LINE 00000258 "      # Filter out any broken symbolic links"
NSQ_SOURCE_LINE 00000259 "      grep { ($any || $missing{$_->[0]} ) && (-e $_->[1]) }"
NSQ_SOURCE_LINE 00000260 "      ref $path eq 'ARRAY'"
NSQ_SOURCE_LINE 00000261 "        ? do {"
NSQ_SOURCE_LINE 00000262 "          map {"
NSQ_SOURCE_LINE 00000263 "            my($v, $d, $f) = File::Spec->splitpath($_);"
NSQ_SOURCE_LINE 00000264 "            _matches($f, File::Spec->catpath($v,$d,''));"
NSQ_SOURCE_LINE 00000265 "          } @$path;"
NSQ_SOURCE_LINE 00000266 "        }"
NSQ_SOURCE_LINE 00000267 "        : do {"
NSQ_SOURCE_LINE 00000268 "          my $dh;"
NSQ_SOURCE_LINE 00000269 "          opendir $dh, $path;"
NSQ_SOURCE_LINE 00000270 "          # get [ name, full_path ] mapping,"
NSQ_SOURCE_LINE 00000271 "          # each entry is a 2 element list ref"
NSQ_SOURCE_LINE 00000272 "          map { _matches($_,$path) } readdir $dh;"
NSQ_SOURCE_LINE 00000273 "        };"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "    if($try_ld_on_text && $args{try_linker_script})"
NSQ_SOURCE_LINE 00000276 "    {"
NSQ_SOURCE_LINE 00000277 "      # This is tested in t/ci.t only"
NSQ_SOURCE_LINE 00000278 "      @maybe = map {"
NSQ_SOURCE_LINE 00000279 "        -B $_->[1] ? $_ : do {"
NSQ_SOURCE_LINE 00000280 "          my($name, $so) = @$_;"
NSQ_SOURCE_LINE 00000281 "          my $output = `/usr/bin/ld -t $so -o /dev/null -shared`;"
NSQ_SOURCE_LINE 00000282 "          $output =~ /\\((.*?lib.*\\.so.*?)\\)/"
NSQ_SOURCE_LINE 00000283 "            ? [$name, $1]"
NSQ_SOURCE_LINE 00000284 "            : die \"unable to parse ld output\";"
NSQ_SOURCE_LINE 00000285 "        }"
NSQ_SOURCE_LINE 00000286 "      } @maybe;"
NSQ_SOURCE_LINE 00000287 "    }"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "    midloop:"
NSQ_SOURCE_LINE 00000290 "    foreach my $lib (@maybe)"
NSQ_SOURCE_LINE 00000291 "    {"
NSQ_SOURCE_LINE 00000292 "      next unless $any || $missing{$lib->[0]};"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "      foreach my $verify (@{ $args{verify} })"
NSQ_SOURCE_LINE 00000295 "      {"
NSQ_SOURCE_LINE 00000296 "        next midloop unless $verify->(@$lib);"
NSQ_SOURCE_LINE 00000297 "      }"
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "      delete $missing{$lib->[0]};"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "      if(%symbols)"
NSQ_SOURCE_LINE 00000302 "      {"
NSQ_SOURCE_LINE 00000303 "        require DynaLoader;"
NSQ_SOURCE_LINE 00000304 "        my $dll = DynaLoader::dl_load_file($lib->[1],0);"
NSQ_SOURCE_LINE 00000305 "        foreach my $symbol (keys %symbols)"
NSQ_SOURCE_LINE 00000306 "        {"
NSQ_SOURCE_LINE 00000307 "          if(DynaLoader::dl_find_symbol($dll, $symbol) ? 1 : 0)"
NSQ_SOURCE_LINE 00000308 "          {"
NSQ_SOURCE_LINE 00000309 "            delete $symbols{$symbol}"
NSQ_SOURCE_LINE 00000310 "          }"
NSQ_SOURCE_LINE 00000311 "        }"
NSQ_SOURCE_LINE 00000312 "        DynaLoader::dl_unload_file($dll);"
NSQ_SOURCE_LINE 00000313 "      }"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "      my $found = $lib->[1];"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "      unless($any)"
NSQ_SOURCE_LINE 00000318 "      {"
NSQ_SOURCE_LINE 00000319 "        while(-l $found)"
NSQ_SOURCE_LINE 00000320 "        {"
NSQ_SOURCE_LINE 00000321 "          require File::Basename;"
NSQ_SOURCE_LINE 00000322 "          my $dir = File::Basename::dirname($found);"
NSQ_SOURCE_LINE 00000323 "          $found = File::Spec->rel2abs( readlink($found), $dir );"
NSQ_SOURCE_LINE 00000324 "        }"
NSQ_SOURCE_LINE 00000325 "      }"
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "      push @found, $found;"
NSQ_SOURCE_LINE 00000328 "    }"
NSQ_SOURCE_LINE 00000329 "  }"
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "  if(%missing)"
NSQ_SOURCE_LINE 00000332 "  {"
NSQ_SOURCE_LINE 00000333 "    my @missing = sort keys %missing;"
NSQ_SOURCE_LINE 00000334 "    if(@missing > 1)"
NSQ_SOURCE_LINE 00000335 "    { $diagnostic = \"libraries not found: @missing\" }"
NSQ_SOURCE_LINE 00000336 "    else"
NSQ_SOURCE_LINE 00000337 "    { $diagnostic = \"library not found: @missing\" }"
NSQ_SOURCE_LINE 00000338 "  }"
NSQ_SOURCE_LINE 00000339 "  elsif(%symbols)"
NSQ_SOURCE_LINE 00000340 "  {"
NSQ_SOURCE_LINE 00000341 "    my @missing = sort keys %symbols;"
NSQ_SOURCE_LINE 00000342 "    if(@missing > 1)"
NSQ_SOURCE_LINE 00000343 "    { $diagnostic = \"symbols not found: @missing\" }"
NSQ_SOURCE_LINE 00000344 "    else"
NSQ_SOURCE_LINE 00000345 "    { $diagnostic = \"symbol not found: @missing\" }"
NSQ_SOURCE_LINE 00000346 "  }"
NSQ_SOURCE_LINE 00000347 ""
NSQ_SOURCE_LINE 00000348 "  return if %symbols;"
NSQ_SOURCE_LINE 00000349 "  return $found[0] unless wantarray;"
NSQ_SOURCE_LINE 00000350 "  return @found;"
NSQ_SOURCE_LINE 00000351 "}"
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "sub _recurse"
NSQ_SOURCE_LINE 00000354 "{"
NSQ_SOURCE_LINE 00000355 "  my($dir) = @_;"
NSQ_SOURCE_LINE 00000356 "  return unless -d $dir;"
NSQ_SOURCE_LINE 00000357 "  my $dh;"
NSQ_SOURCE_LINE 00000358 "  opendir $dh, $dir;"
NSQ_SOURCE_LINE 00000359 "  my @list = grep { -d $_ } map { File::Spec->catdir($dir, $_) } grep !/^\\.\\.?$/, readdir $dh;"
NSQ_SOURCE_LINE 00000360 "  closedir $dh;"
NSQ_SOURCE_LINE 00000361 "  ($dir, map { _recurse($_) } @list);"
NSQ_SOURCE_LINE 00000362 "}"
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "sub assert_lib"
NSQ_SOURCE_LINE 00000366 "{"
NSQ_SOURCE_LINE 00000367 "  croak $diagnostic || 'library not found' unless check_lib(@_);"
NSQ_SOURCE_LINE 00000368 "}"
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "sub check_lib_or_exit"
NSQ_SOURCE_LINE 00000372 "{"
NSQ_SOURCE_LINE 00000373 "  unless(check_lib(@_))"
NSQ_SOURCE_LINE 00000374 "  {"
NSQ_SOURCE_LINE 00000375 "    carp $diagnostic || 'library not found';"
NSQ_SOURCE_LINE 00000376 "    exit;"
NSQ_SOURCE_LINE 00000377 "  }"
NSQ_SOURCE_LINE 00000378 "}"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "sub find_lib_or_exit"
NSQ_SOURCE_LINE 00000382 "{"
NSQ_SOURCE_LINE 00000383 "  my(@libs) = find_lib(@_);"
NSQ_SOURCE_LINE 00000384 "  unless(@libs)"
NSQ_SOURCE_LINE 00000385 "  {"
NSQ_SOURCE_LINE 00000386 "    carp $diagnostic || 'library not found';"
NSQ_SOURCE_LINE 00000387 "    exit;"
NSQ_SOURCE_LINE 00000388 "  }"
NSQ_SOURCE_LINE 00000389 "  return unless @libs;"
NSQ_SOURCE_LINE 00000390 "  wantarray ? @libs : $libs[0];"
NSQ_SOURCE_LINE 00000391 "}"
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 ""
NSQ_SOURCE_LINE 00000394 "sub find_lib_or_die"
NSQ_SOURCE_LINE 00000395 "{"
NSQ_SOURCE_LINE 00000396 "  my(@libs) = find_lib(@_);"
NSQ_SOURCE_LINE 00000397 "  unless(@libs)"
NSQ_SOURCE_LINE 00000398 "  {"
NSQ_SOURCE_LINE 00000399 "    croak $diagnostic || 'library not found';"
NSQ_SOURCE_LINE 00000400 "  }"
NSQ_SOURCE_LINE 00000401 "  return unless @libs;"
NSQ_SOURCE_LINE 00000402 "  wantarray ? @libs : $libs[0];"
NSQ_SOURCE_LINE 00000403 "}"
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 ""
NSQ_SOURCE_LINE 00000406 "sub check_lib"
NSQ_SOURCE_LINE 00000407 "{"
NSQ_SOURCE_LINE 00000408 "  find_lib(@_) ? 1 : 0;"
NSQ_SOURCE_LINE 00000409 "}"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 ""
NSQ_SOURCE_LINE 00000412 "sub which"
NSQ_SOURCE_LINE 00000413 "{"
NSQ_SOURCE_LINE 00000414 "  my($name) = @_;"
NSQ_SOURCE_LINE 00000415 "  croak(\"cannot which *\") if $name eq '*';"
NSQ_SOURCE_LINE 00000416 "  scalar find_lib( lib => $name );"
NSQ_SOURCE_LINE 00000417 "}"
NSQ_SOURCE_LINE 00000418 ""
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "sub where"
NSQ_SOURCE_LINE 00000421 "{"
NSQ_SOURCE_LINE 00000422 "  my($name) = @_;"
NSQ_SOURCE_LINE 00000423 "  $name eq '*'"
NSQ_SOURCE_LINE 00000424 "    ? find_lib(lib => '*')"
NSQ_SOURCE_LINE 00000425 "    : find_lib(lib => '*', verify => sub { $_[0] eq $name });"
NSQ_SOURCE_LINE 00000426 "}"
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 "sub has_symbols"
NSQ_SOURCE_LINE 00000430 "{"
NSQ_SOURCE_LINE 00000431 "  my($path, @symbols) = @_;"
NSQ_SOURCE_LINE 00000432 "  require DynaLoader;"
NSQ_SOURCE_LINE 00000433 "  my $dll = DynaLoader::dl_load_file($path, 0);"
NSQ_SOURCE_LINE 00000434 ""
NSQ_SOURCE_LINE 00000435 "  my $ok = 1;"
NSQ_SOURCE_LINE 00000436 ""
NSQ_SOURCE_LINE 00000437 "  foreach my $symbol (@symbols)"
NSQ_SOURCE_LINE 00000438 "  {"
NSQ_SOURCE_LINE 00000439 "    unless(DynaLoader::dl_find_symbol($dll, $symbol))"
NSQ_SOURCE_LINE 00000440 "    {"
NSQ_SOURCE_LINE 00000441 "      $ok = 0;"
NSQ_SOURCE_LINE 00000442 "      last;"
NSQ_SOURCE_LINE 00000443 "    }"
NSQ_SOURCE_LINE 00000444 "  }"
NSQ_SOURCE_LINE 00000445 ""
NSQ_SOURCE_LINE 00000446 "  DynaLoader::dl_unload_file($dll);"
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 "  $ok;"
NSQ_SOURCE_LINE 00000449 "}"
NSQ_SOURCE_LINE 00000450 ""
NSQ_SOURCE_LINE 00000451 ""
NSQ_SOURCE_LINE 00000452 "sub system_path"
NSQ_SOURCE_LINE 00000453 "{"
NSQ_SOURCE_LINE 00000454 "  $system_path;"
NSQ_SOURCE_LINE 00000455 "}"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "1;"
NSQ_SOURCE_LINE 00000458 ""
NSQ_SOURCE_LINE 00000459 "__END__"
NSQ_SOURCE_LINE 00000460 ""
NSQ_SOURCE_LINE 00000461 "=pod"
NSQ_SOURCE_LINE 00000462 ""
NSQ_SOURCE_LINE 00000463 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000464 ""
NSQ_SOURCE_LINE 00000465 "=head1 NAME"
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "FFI::CheckLib - Check that a library is available for FFI"
NSQ_SOURCE_LINE 00000468 ""
NSQ_SOURCE_LINE 00000469 "=head1 VERSION"
NSQ_SOURCE_LINE 00000470 ""
NSQ_SOURCE_LINE 00000471 "version 0.31"
NSQ_SOURCE_LINE 00000472 ""
NSQ_SOURCE_LINE 00000473 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 " use FFI::CheckLib;"
NSQ_SOURCE_LINE 00000476 " "
NSQ_SOURCE_LINE 00000477 " check_lib_or_exit( lib => 'jpeg', symbol => 'jinit_memory_mgr' );"
NSQ_SOURCE_LINE 00000478 " check_lib_or_exit( lib => [ 'iconv', 'jpeg' ] );"
NSQ_SOURCE_LINE 00000479 " "
NSQ_SOURCE_LINE 00000480 " # or prompt for path to library and then:"
NSQ_SOURCE_LINE 00000481 " print \"where to find jpeg library: \";"
NSQ_SOURCE_LINE 00000482 " my $path = <STDIN>;"
NSQ_SOURCE_LINE 00000483 " check_lib_or_exit( lib => 'jpeg', libpath => $path );"
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "This module checks whether a particular dynamic library is available for"
NSQ_SOURCE_LINE 00000488 "FFI to use. It is modeled heavily on L<Devel::CheckLib>, but will find"
NSQ_SOURCE_LINE 00000489 "dynamic libraries even when development packages are not installed.  It"
NSQ_SOURCE_LINE 00000490 "also provides a L<find_lib|FFI::CheckLib#find_lib> function that will"
NSQ_SOURCE_LINE 00000491 "return the full path to the found dynamic library, which can be feed"
NSQ_SOURCE_LINE 00000492 "directly into L<FFI::Platypus> or another FFI system."
NSQ_SOURCE_LINE 00000493 ""
NSQ_SOURCE_LINE 00000494 "Although intended mainly for FFI modules via L<FFI::Platypus> and"
NSQ_SOURCE_LINE 00000495 "similar, this module does not actually use any FFI to do its detection"
NSQ_SOURCE_LINE 00000496 "and probing.  This module does not have any non-core runtime dependencies."
NSQ_SOURCE_LINE 00000497 "The test suite does depend on L<Test2::Suite>."
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000500 ""
NSQ_SOURCE_LINE 00000501 "All of these take the same named parameters and are exported by default."
NSQ_SOURCE_LINE 00000502 ""
NSQ_SOURCE_LINE 00000503 "=head2 find_lib"
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 " my(@libs) = find_lib(%args);"
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "This will return a list of dynamic libraries, or empty list if none were"
NSQ_SOURCE_LINE 00000508 "found."
NSQ_SOURCE_LINE 00000509 ""
NSQ_SOURCE_LINE 00000510 "[version 0.05]"
NSQ_SOURCE_LINE 00000511 ""
NSQ_SOURCE_LINE 00000512 "If called in scalar context it will return the first library found."
NSQ_SOURCE_LINE 00000513 ""
NSQ_SOURCE_LINE 00000514 "Arguments are key value pairs with these keys:"
NSQ_SOURCE_LINE 00000515 ""
NSQ_SOURCE_LINE 00000516 "=over 4"
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "=item lib"
NSQ_SOURCE_LINE 00000519 ""
NSQ_SOURCE_LINE 00000520 "Must be either a string with the name of a single library or a reference"
NSQ_SOURCE_LINE 00000521 "to an array of strings of library names.  Depending on your platform,"
NSQ_SOURCE_LINE 00000522 "C<CheckLib> will prepend C<lib> or append C<.dll> or C<.so> when"
NSQ_SOURCE_LINE 00000523 "searching."
NSQ_SOURCE_LINE 00000524 ""
NSQ_SOURCE_LINE 00000525 "[version 0.11]"
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 "As a special case, if C<*> is specified then any libs found will match."
NSQ_SOURCE_LINE 00000528 ""
NSQ_SOURCE_LINE 00000529 "=item libpath"
NSQ_SOURCE_LINE 00000530 ""
NSQ_SOURCE_LINE 00000531 "A string or array of additional paths to search for libraries."
NSQ_SOURCE_LINE 00000532 ""
NSQ_SOURCE_LINE 00000533 "=item systempath"
NSQ_SOURCE_LINE 00000534 ""
NSQ_SOURCE_LINE 00000535 "[version 0.11]"
NSQ_SOURCE_LINE 00000536 ""
NSQ_SOURCE_LINE 00000537 "A string or array of system paths to search for instead of letting"
NSQ_SOURCE_LINE 00000538 "L<FFI::CheckLib> determine the system path.  You can set this to C<[]>"
NSQ_SOURCE_LINE 00000539 "in order to not search I<any> system paths."
NSQ_SOURCE_LINE 00000540 ""
NSQ_SOURCE_LINE 00000541 "=item symbol"
NSQ_SOURCE_LINE 00000542 ""
NSQ_SOURCE_LINE 00000543 "A string or a list of symbol names that must be found."
NSQ_SOURCE_LINE 00000544 ""
NSQ_SOURCE_LINE 00000545 "=item verify"
NSQ_SOURCE_LINE 00000546 ""
NSQ_SOURCE_LINE 00000547 "A code reference used to verify a library really is the one that you"
NSQ_SOURCE_LINE 00000548 "want.  It should take two arguments, which is the name of the library"
NSQ_SOURCE_LINE 00000549 "and the full path to the library pathname.  It should return true if it"
NSQ_SOURCE_LINE 00000550 "is acceptable, and false otherwise.  You can use this in conjunction"
NSQ_SOURCE_LINE 00000551 "with L<FFI::Platypus> to determine if it is going to meet your needs."
NSQ_SOURCE_LINE 00000552 "Example:"
NSQ_SOURCE_LINE 00000553 ""
NSQ_SOURCE_LINE 00000554 " use FFI::CheckLib;"
NSQ_SOURCE_LINE 00000555 " use FFI::Platypus;"
NSQ_SOURCE_LINE 00000556 " "
NSQ_SOURCE_LINE 00000557 " my($lib) = find_lib("
NSQ_SOURCE_LINE 00000558 "   lib => 'foo',"
NSQ_SOURCE_LINE 00000559 "   verify => sub {"
NSQ_SOURCE_LINE 00000560 "     my($name, $libpath) = @_;"
NSQ_SOURCE_LINE 00000561 " "
NSQ_SOURCE_LINE 00000562 "     my $ffi = FFI::Platypus->new;"
NSQ_SOURCE_LINE 00000563 "     $ffi->lib($libpath);"
NSQ_SOURCE_LINE 00000564 " "
NSQ_SOURCE_LINE 00000565 "     my $f = $ffi->function('foo_version', [] => 'int');"
NSQ_SOURCE_LINE 00000566 " "
NSQ_SOURCE_LINE 00000567 "     return $f->call() >= 500; # we accept version 500 or better"
NSQ_SOURCE_LINE 00000568 "   },"
NSQ_SOURCE_LINE 00000569 " );"
NSQ_SOURCE_LINE 00000570 ""
NSQ_SOURCE_LINE 00000571 "=item recursive"
NSQ_SOURCE_LINE 00000572 ""
NSQ_SOURCE_LINE 00000573 "[version 0.11]"
NSQ_SOURCE_LINE 00000574 ""
NSQ_SOURCE_LINE 00000575 "Recursively search for libraries in any non-system paths (those provided"
NSQ_SOURCE_LINE 00000576 "via C<libpath> above)."
NSQ_SOURCE_LINE 00000577 ""
NSQ_SOURCE_LINE 00000578 "=item try_linker_script"
NSQ_SOURCE_LINE 00000579 ""
NSQ_SOURCE_LINE 00000580 "[version 0.24]"
NSQ_SOURCE_LINE 00000581 ""
NSQ_SOURCE_LINE 00000582 "Some vendors provide C<.so> files that are linker scripts that point to"
NSQ_SOURCE_LINE 00000583 "the real binary shared library.  These linker scripts can be used by gcc"
NSQ_SOURCE_LINE 00000584 "or clang, but are not directly usable by L<FFI::Platypus> and friends."
NSQ_SOURCE_LINE 00000585 "On select platforms, this options will use the linker command (C<ld>)"
NSQ_SOURCE_LINE 00000586 "to attempt to resolve the real C<.so> for non-binary files.  Since there"
NSQ_SOURCE_LINE 00000587 "is extra overhead this is off by default."
NSQ_SOURCE_LINE 00000588 ""
NSQ_SOURCE_LINE 00000589 "An example is libyaml on Red Hat based Linux distributions.  On Debian"
NSQ_SOURCE_LINE 00000590 "these are handled with symlinks and no trickery is required."
NSQ_SOURCE_LINE 00000591 ""
NSQ_SOURCE_LINE 00000592 "=item alien"
NSQ_SOURCE_LINE 00000593 ""
NSQ_SOURCE_LINE 00000594 "[version 0.25]"
NSQ_SOURCE_LINE 00000595 ""
NSQ_SOURCE_LINE 00000596 "If no libraries can be found, try the given aliens instead.  The Alien"
NSQ_SOURCE_LINE 00000597 "classes specified must provide the L<Alien::Base> interface for dynamic"
NSQ_SOURCE_LINE 00000598 "libraries, which is to say they should provide a method called"
NSQ_SOURCE_LINE 00000599 "C<dynamic_libs> that returns a list of dynamic libraries."
NSQ_SOURCE_LINE 00000600 ""
NSQ_SOURCE_LINE 00000601 "[version 0.28]"
NSQ_SOURCE_LINE 00000602 ""
NSQ_SOURCE_LINE 00000603 "In 0.28 and later, if the L<Alien> is not installed then it will be"
NSQ_SOURCE_LINE 00000604 "ignored and this module will search in system or specified directories"
NSQ_SOURCE_LINE 00000605 "only.  This module I<will> still throw an exception, if the L<Alien>"
NSQ_SOURCE_LINE 00000606 "doesn't look like a module name or if it does not provide a C<dynamic_libs>"
NSQ_SOURCE_LINE 00000607 "method (which is implemented by all L<Alien::Base> subclasses)."
NSQ_SOURCE_LINE 00000608 ""
NSQ_SOURCE_LINE 00000609 "[version 0.30]"
NSQ_SOURCE_LINE 00000610 "[breaking change]"
NSQ_SOURCE_LINE 00000611 ""
NSQ_SOURCE_LINE 00000612 "Starting with version 0.30, libraries provided by L<Alien>s is preferred"
NSQ_SOURCE_LINE 00000613 "over the system libraries.  The original thinking was that you want to"
NSQ_SOURCE_LINE 00000614 "prefer the system libraries because they are more likely to get patched"
NSQ_SOURCE_LINE 00000615 "with regular system updates.  Unfortunately, the reason a module needs to"
NSQ_SOURCE_LINE 00000616 "install an Alien is likely because the system library is not new enough,"
NSQ_SOURCE_LINE 00000617 "so we now prefer the L<Alien>s instead."
NSQ_SOURCE_LINE 00000618 ""
NSQ_SOURCE_LINE 00000619 "=back"
NSQ_SOURCE_LINE 00000620 ""
NSQ_SOURCE_LINE 00000621 "=head2 assert_lib"
NSQ_SOURCE_LINE 00000622 ""
NSQ_SOURCE_LINE 00000623 " assert_lib(%args);"
NSQ_SOURCE_LINE 00000624 ""
NSQ_SOURCE_LINE 00000625 "This behaves exactly the same as L<find_lib|FFI::CheckLib#find_lib>,"
NSQ_SOURCE_LINE 00000626 "except that instead of returning empty list of failure it throws an"
NSQ_SOURCE_LINE 00000627 "exception."
NSQ_SOURCE_LINE 00000628 ""
NSQ_SOURCE_LINE 00000629 "=head2 check_lib_or_exit"
NSQ_SOURCE_LINE 00000630 ""
NSQ_SOURCE_LINE 00000631 " check_lib_or_exit(%args);"
NSQ_SOURCE_LINE 00000632 ""
NSQ_SOURCE_LINE 00000633 "This behaves exactly the same as L<assert_lib|FFI::CheckLib#assert_lib>,"
NSQ_SOURCE_LINE 00000634 "except that instead of dying, it warns (with exactly the same error"
NSQ_SOURCE_LINE 00000635 "message) and exists.  This is intended for use in C<Makefile.PL> or"
NSQ_SOURCE_LINE 00000636 "C<Build.PL>"
NSQ_SOURCE_LINE 00000637 ""
NSQ_SOURCE_LINE 00000638 "=head2 find_lib_or_exit"
NSQ_SOURCE_LINE 00000639 ""
NSQ_SOURCE_LINE 00000640 "[version 0.05]"
NSQ_SOURCE_LINE 00000641 ""
NSQ_SOURCE_LINE 00000642 " my(@libs) = find_lib_or_exit(%args);"
NSQ_SOURCE_LINE 00000643 ""
NSQ_SOURCE_LINE 00000644 "This behaves exactly the same as L<find_lib|FFI::CheckLib#find_lib>,"
NSQ_SOURCE_LINE 00000645 "except that if the library is not found, it will call exit with an"
NSQ_SOURCE_LINE 00000646 "appropriate diagnostic."
NSQ_SOURCE_LINE 00000647 ""
NSQ_SOURCE_LINE 00000648 "=head2 find_lib_or_die"
NSQ_SOURCE_LINE 00000649 ""
NSQ_SOURCE_LINE 00000650 "[version 0.06]"
NSQ_SOURCE_LINE 00000651 ""
NSQ_SOURCE_LINE 00000652 " my(@libs) = find_lib_or_die(%args);"
NSQ_SOURCE_LINE 00000653 ""
NSQ_SOURCE_LINE 00000654 "This behaves exactly the same as L<find_lib|FFI::CheckLib#find_lib>,"
NSQ_SOURCE_LINE 00000655 "except that if the library is not found, it will die with an appropriate"
NSQ_SOURCE_LINE 00000656 "diagnostic."
NSQ_SOURCE_LINE 00000657 ""
NSQ_SOURCE_LINE 00000658 "=head2 check_lib"
NSQ_SOURCE_LINE 00000659 ""
NSQ_SOURCE_LINE 00000660 " my $bool = check_lib(%args);"
NSQ_SOURCE_LINE 00000661 ""
NSQ_SOURCE_LINE 00000662 "This behaves exactly the same as L<find_lib|FFI::CheckLib#find_lib>,"
NSQ_SOURCE_LINE 00000663 "except that it returns true (1) on finding the appropriate libraries or"
NSQ_SOURCE_LINE 00000664 "false (0) otherwise."
NSQ_SOURCE_LINE 00000665 ""
NSQ_SOURCE_LINE 00000666 "=head2 which"
NSQ_SOURCE_LINE 00000667 ""
NSQ_SOURCE_LINE 00000668 "[version 0.17]"
NSQ_SOURCE_LINE 00000669 ""
NSQ_SOURCE_LINE 00000670 " my $path = which($name);"
NSQ_SOURCE_LINE 00000671 ""
NSQ_SOURCE_LINE 00000672 "Return the path to the first library that matches the given name."
NSQ_SOURCE_LINE 00000673 ""
NSQ_SOURCE_LINE 00000674 "Not exported by default."
NSQ_SOURCE_LINE 00000675 ""
NSQ_SOURCE_LINE 00000676 "=head2 where"
NSQ_SOURCE_LINE 00000677 ""
NSQ_SOURCE_LINE 00000678 "[version 0.17]"
NSQ_SOURCE_LINE 00000679 ""
NSQ_SOURCE_LINE 00000680 " my @paths = where($name);"
NSQ_SOURCE_LINE 00000681 ""
NSQ_SOURCE_LINE 00000682 "Return the paths to all the libraries that match the given name."
NSQ_SOURCE_LINE 00000683 ""
NSQ_SOURCE_LINE 00000684 "Not exported by default."
NSQ_SOURCE_LINE 00000685 ""
NSQ_SOURCE_LINE 00000686 "=head2 has_symbols"
NSQ_SOURCE_LINE 00000687 ""
NSQ_SOURCE_LINE 00000688 "[version 0.17]"
NSQ_SOURCE_LINE 00000689 ""
NSQ_SOURCE_LINE 00000690 " my $bool = has_symbols($path, @symbol_names);"
NSQ_SOURCE_LINE 00000691 ""
NSQ_SOURCE_LINE 00000692 "Returns true if I<all> of the symbols can be found in the dynamic library located"
NSQ_SOURCE_LINE 00000693 "at the given path.  Can be useful in conjunction with C<verify> with C<find_lib>"
NSQ_SOURCE_LINE 00000694 "above."
NSQ_SOURCE_LINE 00000695 ""
NSQ_SOURCE_LINE 00000696 "Not exported by default."
NSQ_SOURCE_LINE 00000697 ""
NSQ_SOURCE_LINE 00000698 "=head2 system_path"
NSQ_SOURCE_LINE 00000699 ""
NSQ_SOURCE_LINE 00000700 "[version 0.20]"
NSQ_SOURCE_LINE 00000701 ""
NSQ_SOURCE_LINE 00000702 " my $path = FFI::CheckLib::system_path;"
NSQ_SOURCE_LINE 00000703 ""
NSQ_SOURCE_LINE 00000704 "Returns the system path as a list reference.  On some systems, this is C<PATH>"
NSQ_SOURCE_LINE 00000705 "on others it might be C<LD_LIBRARY_PATH> on still others it could be something"
NSQ_SOURCE_LINE 00000706 "completely different.  So although you I<may> add items to this list, you should"
NSQ_SOURCE_LINE 00000707 "probably do some careful consideration before you do so."
NSQ_SOURCE_LINE 00000708 ""
NSQ_SOURCE_LINE 00000709 "This function is not exportable, even on request."
NSQ_SOURCE_LINE 00000710 ""
NSQ_SOURCE_LINE 00000711 "=head1 ENVIRONMENT"
NSQ_SOURCE_LINE 00000712 ""
NSQ_SOURCE_LINE 00000713 "L<FFI::CheckLib> responds to these environment variables:"
NSQ_SOURCE_LINE 00000714 ""
NSQ_SOURCE_LINE 00000715 "=over 4"
NSQ_SOURCE_LINE 00000716 ""
NSQ_SOURCE_LINE 00000717 "=item FFI_CHECKLIB_PACKAGE"
NSQ_SOURCE_LINE 00000718 ""
NSQ_SOURCE_LINE 00000719 "On macOS platforms with L<Homebrew|http://brew.sh> and/or L<MacPorts|https://www.macports.org>"
NSQ_SOURCE_LINE 00000720 "installed, their corresponding lib paths will be automatically appended to C<$system_path>."
NSQ_SOURCE_LINE 00000721 "In case of having both managers installed, Homebrew will appear before."
NSQ_SOURCE_LINE 00000722 ""
NSQ_SOURCE_LINE 00000723 "This behaviour can be overridden using the environment variable C<FFI_CHECKLIB_PACKAGE>."
NSQ_SOURCE_LINE 00000724 ""
NSQ_SOURCE_LINE 00000725 "Allowed values are:"
NSQ_SOURCE_LINE 00000726 ""
NSQ_SOURCE_LINE 00000727 "- C<none>: Won't use either Homebrew's path nor MacPorts"
NSQ_SOURCE_LINE 00000728 "- C<homebrew>: Will append C<$(brew --prefix)/lib> to the system paths"
NSQ_SOURCE_LINE 00000729 "- C<macports>: Will append C<port>'s default lib path"
NSQ_SOURCE_LINE 00000730 ""
NSQ_SOURCE_LINE 00000731 "A comma separated list is also valid:"
NSQ_SOURCE_LINE 00000732 ""
NSQ_SOURCE_LINE 00000733 " export FFI_CHECKLIB_PACKAGE=macports,homebrew"
NSQ_SOURCE_LINE 00000734 ""
NSQ_SOURCE_LINE 00000735 "Order matters. So in this example, MacPorts' lib path appears before Homebrew's path."
NSQ_SOURCE_LINE 00000736 ""
NSQ_SOURCE_LINE 00000737 "=item FFI_CHECKLIB_PATH"
NSQ_SOURCE_LINE 00000738 ""
NSQ_SOURCE_LINE 00000739 "List of directories that will be considered by L<FFI::CheckLib> as additional \"system"
NSQ_SOURCE_LINE 00000740 "directories\".  They will be searched before other system directories but after C<libpath>."
NSQ_SOURCE_LINE 00000741 "The variable is colon separated on Unix and semicolon separated on Windows.  If you"
NSQ_SOURCE_LINE 00000742 "use this variable, C<FFI_CHECKLIB_PACKAGE> will be ignored."
NSQ_SOURCE_LINE 00000743 ""
NSQ_SOURCE_LINE 00000744 "=item PATH"
NSQ_SOURCE_LINE 00000745 ""
NSQ_SOURCE_LINE 00000746 "On Windows the C<PATH> environment variable will be used as a search path for"
NSQ_SOURCE_LINE 00000747 "libraries."
NSQ_SOURCE_LINE 00000748 ""
NSQ_SOURCE_LINE 00000749 "=back"
NSQ_SOURCE_LINE 00000750 ""
NSQ_SOURCE_LINE 00000751 "On some operating systems C<LD_LIBRARY_PATH>, C<DYLD_LIBRARY_PATH>,"
NSQ_SOURCE_LINE 00000752 "C<DYLD_FALLBACK_LIBRARY_PATH> or others I<may> be used as part of the search"
NSQ_SOURCE_LINE 00000753 "for dynamic libraries and I<may> be used (indirectly) by L<FFI::CheckLib>"
NSQ_SOURCE_LINE 00000754 "as well."
NSQ_SOURCE_LINE 00000755 ""
NSQ_SOURCE_LINE 00000756 "=head1 FAQ"
NSQ_SOURCE_LINE 00000757 ""
NSQ_SOURCE_LINE 00000758 "=over 4"
NSQ_SOURCE_LINE 00000759 ""
NSQ_SOURCE_LINE 00000760 "=item Why not just use C<dlopen>?"
NSQ_SOURCE_LINE 00000761 ""
NSQ_SOURCE_LINE 00000762 "Calling C<dlopen> on a library name and then C<dlclose> immediately can tell"
NSQ_SOURCE_LINE 00000763 "you if you have the exact name of a library available on a system.  It does"
NSQ_SOURCE_LINE 00000764 "have a number of drawbacks as well."
NSQ_SOURCE_LINE 00000765 ""
NSQ_SOURCE_LINE 00000766 "=over 4"
NSQ_SOURCE_LINE 00000767 ""
NSQ_SOURCE_LINE 00000768 "=item No absolute or relative path"
NSQ_SOURCE_LINE 00000769 ""
NSQ_SOURCE_LINE 00000770 "It only tells you that the library is I<somewhere> on the system, not having"
NSQ_SOURCE_LINE 00000771 "the absolute or relative path makes it harder to generate useful diagnostics."
NSQ_SOURCE_LINE 00000772 ""
NSQ_SOURCE_LINE 00000773 "=item POSIX only"
NSQ_SOURCE_LINE 00000774 ""
NSQ_SOURCE_LINE 00000775 "This doesn't work on non-POSIX systems like Microsoft Windows. If you are"
NSQ_SOURCE_LINE 00000776 "using a POSIX emulation layer on Windows that provides C<dlopen>, like"
NSQ_SOURCE_LINE 00000777 "Cygwin, there are a number of gotchas there as well.  Having a layer written"
NSQ_SOURCE_LINE 00000778 "in Perl handles this means that developers on Unix can develop FFI that will"
NSQ_SOURCE_LINE 00000779 "more likely work on these platforms without special casing them."
NSQ_SOURCE_LINE 00000780 ""
NSQ_SOURCE_LINE 00000781 "=item inconsistent implementations"
NSQ_SOURCE_LINE 00000782 ""
NSQ_SOURCE_LINE 00000783 "Even on POSIX systems you have inconsistent implementations.  OpenBSD for"
NSQ_SOURCE_LINE 00000784 "example don't usually include symlinks for C<.so> files meaning you need"
NSQ_SOURCE_LINE 00000785 "to know the exact C<.so> version."
NSQ_SOURCE_LINE 00000786 ""
NSQ_SOURCE_LINE 00000787 "=item non-system directories"
NSQ_SOURCE_LINE 00000788 ""
NSQ_SOURCE_LINE 00000789 "By default C<dlopen> only works for libraries in the system paths.  Most"
NSQ_SOURCE_LINE 00000790 "platforms have a way of configuring the search for different non-system"
NSQ_SOURCE_LINE 00000791 "paths, but none of them are portable, and are usually discouraged anyway."
NSQ_SOURCE_LINE 00000792 "L<Alien> and friends need to do searches for dynamic libraries in"
NSQ_SOURCE_LINE 00000793 "non-system directories for C<share> installs."
NSQ_SOURCE_LINE 00000794 ""
NSQ_SOURCE_LINE 00000795 "=back"
NSQ_SOURCE_LINE 00000796 ""
NSQ_SOURCE_LINE 00000797 "=item My 64-bit Perl is misconfigured and has 32-bit libraries in its search path.  Is that a bug in L<FFI::CheckLib>?"
NSQ_SOURCE_LINE 00000798 ""
NSQ_SOURCE_LINE 00000799 "Nope."
NSQ_SOURCE_LINE 00000800 ""
NSQ_SOURCE_LINE 00000801 "=item The way L<FFI::CheckLib> is implemented it won't work on AIX, HP-UX, OpenVMS or Plan 9."
NSQ_SOURCE_LINE 00000802 ""
NSQ_SOURCE_LINE 00000803 "I know for a fact that it doesn't work on AIX I<as currently implemented>"
NSQ_SOURCE_LINE 00000804 "because I used to develop on AIX in the early 2000s, and I am aware of some"
NSQ_SOURCE_LINE 00000805 "of the technical challenges.  There are probably other systems that it won't"
NSQ_SOURCE_LINE 00000806 "work on.  I would love to add support for these platforms.  Realistically"
NSQ_SOURCE_LINE 00000807 "these platforms have a tiny market share, and absent patches from users or"
NSQ_SOURCE_LINE 00000808 "the companies that own these operating systems (patches welcome), or hardware"
NSQ_SOURCE_LINE 00000809 "/ CPU time donations, these platforms are unsupportable anyway."
NSQ_SOURCE_LINE 00000810 ""
NSQ_SOURCE_LINE 00000811 "=back"
NSQ_SOURCE_LINE 00000812 ""
NSQ_SOURCE_LINE 00000813 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000814 ""
NSQ_SOURCE_LINE 00000815 "=over 4"
NSQ_SOURCE_LINE 00000816 ""
NSQ_SOURCE_LINE 00000817 "=item L<FFI::Platypus>"
NSQ_SOURCE_LINE 00000818 ""
NSQ_SOURCE_LINE 00000819 "Call library functions dynamically without a compiler."
