BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "#!/usr/bin/perl"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "=head1 NAME"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "SQLib - A simple module to manage and store SQL queries in separate files."
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "=head1 VERSION"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "Version 0.05"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "Mateusz Szczyrzyca, mateusz at szczyrzyca.pl"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "The module allows to store SQL queries in separate files and provides easy "
NSQ_SOURCE_LINE 00000018 "access to them. This functionality is helpful if you want to separate a Perl "
NSQ_SOURCE_LINE 00000019 "code from a SQL code."
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "A file with list of queries has the following syntax:"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 " [NAME_OF_QUERY1]"
NSQ_SOURCE_LINE 00000024 " -- A SQL query with {vars} to replace "
NSQ_SOURCE_LINE 00000025 " [/NAME_OF_QUERY1]"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 " [NAME_OF_QUERY2]"
NSQ_SOURCE_LINE 00000028 " -- A SQL query with {vars} to replace"
NSQ_SOURCE_LINE 00000029 " [/NAME_OF_QUERY2]"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 " ..."
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 " [NAME_OF_QUERY_N]"
NSQ_SOURCE_LINE 00000034 " -- A SQL query with {vars} to replace"
NSQ_SOURCE_LINE 00000035 " [/NAME_OF_QUERY_N]"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 " [     QUERIES_WITH_SPACES_IN_NAME_ARE_POSSIBLE  ]"
NSQ_SOURCE_LINE 00000038 "                -- A SQL query with spaces"
NSQ_SOURCE_LINE 00000039 " [     /   QUERIES_WITH_SPACES_IN_NAME_ARE_POSSIBLE       ]"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "First parenthesis \"[\" always starts from a new line (don't use whitespaces)."
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "Empty lines between queries are ignored. If there are two or more SQL queries "
NSQ_SOURCE_LINE 00000044 "with same [NAME], then only one (first) will be used. "
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "If a query with a specified name doesn't exist then undef is returned as soon "
NSQ_SOURCE_LINE 00000047 "as if a file or query has an invalid syntax."
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "[QUERY_NAME]A sql code[/QUERY_NAME] isn't a valid syntax as well."
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "Simple example (file_with_queries.sql):"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 " [CHECK_PASSWORD]"
NSQ_SOURCE_LINE 00000055 " -- Comments for SQL debug"
NSQ_SOURCE_LINE 00000056 " -- Some::Program @ CHECK_PASSWORD"
NSQ_SOURCE_LINE 00000057 " -- Check a user password"
NSQ_SOURCE_LINE 00000058 " SELECT"
NSQ_SOURCE_LINE 00000059 "  login,password"
NSQ_SOURCE_LINE 00000060 " FROM"
NSQ_SOURCE_LINE 00000061 "  {table}"
NSQ_SOURCE_LINE 00000062 " WHERE"
NSQ_SOURCE_LINE 00000063 " ("
NSQ_SOURCE_LINE 00000064 "   login = '{login}',"
NSQ_SOURCE_LINE 00000065 "  AND"
NSQ_SOURCE_LINE 00000066 "   password = '{password}'"
NSQ_SOURCE_LINE 00000067 " );"
NSQ_SOURCE_LINE 00000068 " [/CHECK_PASSWORD]"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "And how to use it in a perl code:"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 " use SQLib;"
NSQ_SOURCE_LINE 00000073 " my $SQLib = SQLib->new( './file_with_queries.sql' );"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 " my %sql_params ="
NSQ_SOURCE_LINE 00000076 " ("
NSQ_SOURCE_LINE 00000077 "  table    => 'cms_users',"
NSQ_SOURCE_LINE 00000078 "  login    => 'someuser',"
NSQ_SOURCE_LINE 00000079 "  password => 'somepass'"
NSQ_SOURCE_LINE 00000080 " );"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 " my $check_auth_query = $SQLib->get_query( 'CHECK_PASSWORD', \\%sql_params );"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "In the above example $check_auth_query contains:"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 " -- Comments for SQL debug"
NSQ_SOURCE_LINE 00000087 " -- Some::Program @ CHECK_PASSWORD"
NSQ_SOURCE_LINE 00000088 " -- Check a user password"
NSQ_SOURCE_LINE 00000089 " SELECT"
NSQ_SOURCE_LINE 00000090 "  login,password"
NSQ_SOURCE_LINE 00000091 " FROM"
NSQ_SOURCE_LINE 00000092 "  cms_users"
NSQ_SOURCE_LINE 00000093 " WHERE"
NSQ_SOURCE_LINE 00000094 " ("
NSQ_SOURCE_LINE 00000095 "   login = 'someuser',"
NSQ_SOURCE_LINE 00000096 "  AND"
NSQ_SOURCE_LINE 00000097 "   password = 'somepass'"
NSQ_SOURCE_LINE 00000098 " );"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "=cut"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "#####################################################################"
NSQ_SOURCE_LINE 00000103 "#####################################################################"
NSQ_SOURCE_LINE 00000104 "#####################################################################"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "package SQLib;"
NSQ_SOURCE_LINE 00000107 "use utf8;"
NSQ_SOURCE_LINE 00000108 "use strict;"
NSQ_SOURCE_LINE 00000109 "use Tie::File;"
NSQ_SOURCE_LINE 00000110 "our $VERSION = '0.05';"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "sub new"
NSQ_SOURCE_LINE 00000113 "{"
NSQ_SOURCE_LINE 00000114 " my $class = shift;"
NSQ_SOURCE_LINE 00000115 " my $self = { file => $_[ 0 ] };"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 " die 'ERROR: Cannot find: ' . $self->{'file'} if ( ! -e $self->{'file'} );"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 " tie my @queries, 'Tie::File', $self->{'file'}"
NSQ_SOURCE_LINE 00000120 "  or die 'SQLib: I cannot open the file with queries: ' . $self->{'file'};"
NSQ_SOURCE_LINE 00000121 " $self->{'queries'} = \\@queries;"
NSQ_SOURCE_LINE 00000122 " bless $self, $class;"
NSQ_SOURCE_LINE 00000123 "};"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "sub get_query"
NSQ_SOURCE_LINE 00000126 "{"
NSQ_SOURCE_LINE 00000127 " my $self = shift;"
NSQ_SOURCE_LINE 00000128 " my $name = shift;"
NSQ_SOURCE_LINE 00000129 " my $params = shift;"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 " my @queries = @{ $self->{'queries'} };"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 " my $sql = \"\\n\";"
NSQ_SOURCE_LINE 00000134 " my $reading;"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 " for my $i ( 0 .. $#queries )"
NSQ_SOURCE_LINE 00000137 " {"
NSQ_SOURCE_LINE 00000138 "  last if ( $queries[ $i ] =~ m/^\\[\\s*\\/\\s*$name\\s*\\]$/ );"
NSQ_SOURCE_LINE 00000139 "  next if ( $queries[ $i ] =~ m/^\\s*$/ && !$reading );"
NSQ_SOURCE_LINE 00000140 "  return undef if $reading && $queries[ $i ] =~ m/^\\[/;"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "  if ( $reading )"
NSQ_SOURCE_LINE 00000143 "  {"
NSQ_SOURCE_LINE 00000144 "   $sql .= $queries[ $i ] . \"\\n\";"
NSQ_SOURCE_LINE 00000145 "   next;"
NSQ_SOURCE_LINE 00000146 "  }"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "  if ( $queries[ $i ] =~ m/^\\[\\s*$name\\s*\\]\\s*/ )"
NSQ_SOURCE_LINE 00000149 "  {"
NSQ_SOURCE_LINE 00000150 "   $reading = 1;"
NSQ_SOURCE_LINE 00000151 "   next;"
NSQ_SOURCE_LINE 00000152 "  }"
NSQ_SOURCE_LINE 00000153 " }"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 " ### The requested query doesn't exist"
NSQ_SOURCE_LINE 00000156 " return undef if !$reading;"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 " my %hash = %{ $params };"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 " foreach my $key ( sort ( keys ( %hash )  )  )"
NSQ_SOURCE_LINE 00000161 " {"
NSQ_SOURCE_LINE 00000162 "  my $tmp = $hash{ $key };"
NSQ_SOURCE_LINE 00000163 "  $sql =~ s/\\{$key\\}/$tmp/g;"
NSQ_SOURCE_LINE 00000164 " }"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 " return $sql;"
NSQ_SOURCE_LINE 00000167 "};"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "1;"
BODY_END
