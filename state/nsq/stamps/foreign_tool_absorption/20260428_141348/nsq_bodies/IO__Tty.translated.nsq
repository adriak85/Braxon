BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "# Documentation at the __END__"
NSQ_SOURCE_LINE 00000002 "# -*-cperl-*-"
NSQ_SOURCE_LINE 00000003 ""
NSQ_SOURCE_LINE 00000004 "package IO::Tty;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use 5.008008;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use strict;"
NSQ_SOURCE_LINE 00000009 "use warnings;"
NSQ_SOURCE_LINE 00000010 "use IO::Handle;"
NSQ_SOURCE_LINE 00000011 "use IO::File;"
NSQ_SOURCE_LINE 00000012 "use IO::Tty::Constant;"
NSQ_SOURCE_LINE 00000013 "use Carp;"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "require POSIX;"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "our @ISA        = qw(IO::Handle);"
NSQ_SOURCE_LINE 00000018 "our $VERSION = '1.29';"
NSQ_SOURCE_LINE 00000019 "our ( $CONFIG, $DEBUG );"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "eval { local $^W = 0; local $SIG{__DIE__}; require IO::Stty };"
NSQ_SOURCE_LINE 00000022 "push @ISA, \"IO::Stty\" if ( not $@ );    # if IO::Stty is installed"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "use XSLoader;"
NSQ_SOURCE_LINE 00000025 "XSLoader::load(__PACKAGE__, $VERSION);"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "sub import {"
NSQ_SOURCE_LINE 00000028 "    IO::Tty::Constant->export_to_level( 1, @_ );"
NSQ_SOURCE_LINE 00000029 "}"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "sub open {"
NSQ_SOURCE_LINE 00000032 "    my ( $tty, $dev, $mode ) = @_;"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "    IO::File::open( $tty, $dev, $mode )"
NSQ_SOURCE_LINE 00000035 "      or return undef;"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "    $tty->autoflush;"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "    1;"
NSQ_SOURCE_LINE 00000040 "}"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "sub clone_winsize_from {"
NSQ_SOURCE_LINE 00000043 "    my ( $self, $fh ) = @_;"
NSQ_SOURCE_LINE 00000044 "    croak \"Given filehandle is not a tty in clone_winsize_from, called\""
NSQ_SOURCE_LINE 00000045 "      if not POSIX::isatty($fh);"
NSQ_SOURCE_LINE 00000046 "    return 1 if not POSIX::isatty($self);    # ignored for master ptys"
NSQ_SOURCE_LINE 00000047 "    my $winsize = IO::Tty::pack_winsize( 0, 0, 0, 0 );"
NSQ_SOURCE_LINE 00000048 "    ioctl( $fh, &IO::Tty::Constant::TIOCGWINSZ, $winsize )"
NSQ_SOURCE_LINE 00000049 "      and ioctl( $self, &IO::Tty::Constant::TIOCSWINSZ, $winsize )"
NSQ_SOURCE_LINE 00000050 "      and return 1;"
NSQ_SOURCE_LINE 00000051 "    carp \"clone_winsize_from: error: $!\";"
NSQ_SOURCE_LINE 00000052 "    return undef;"
NSQ_SOURCE_LINE 00000053 "}"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "# ioctl() may pad the buffer beyond sizeof(struct winsize),"
NSQ_SOURCE_LINE 00000056 "# so trim it before passing to unpack_winsize."
NSQ_SOURCE_LINE 00000057 "my $SIZEOF_WINSIZE = length IO::Tty::pack_winsize( 0, 0, 0, 0 );"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "sub get_winsize {"
NSQ_SOURCE_LINE 00000060 "    my $self = shift;"
NSQ_SOURCE_LINE 00000061 "    my $winsize = IO::Tty::pack_winsize( 0, 0, 0, 0 );"
NSQ_SOURCE_LINE 00000062 "    ioctl( $self, IO::Tty::Constant::TIOCGWINSZ(), $winsize )"
NSQ_SOURCE_LINE 00000063 "      or croak \"Cannot TIOCGWINSZ - $!\";"
NSQ_SOURCE_LINE 00000064 "    substr( $winsize, $SIZEOF_WINSIZE ) = \"\";"
NSQ_SOURCE_LINE 00000065 "    return IO::Tty::unpack_winsize($winsize);"
NSQ_SOURCE_LINE 00000066 "}"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "sub set_winsize {"
NSQ_SOURCE_LINE 00000069 "    my $self    = shift;"
NSQ_SOURCE_LINE 00000070 "    my $winsize = IO::Tty::pack_winsize(@_);"
NSQ_SOURCE_LINE 00000071 "    ioctl( $self, IO::Tty::Constant::TIOCSWINSZ(), $winsize )"
NSQ_SOURCE_LINE 00000072 "      or croak \"Cannot TIOCSWINSZ - $!\";"
NSQ_SOURCE_LINE 00000073 "}"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "sub set_raw($) {"
NSQ_SOURCE_LINE 00000076 "    require POSIX;"
NSQ_SOURCE_LINE 00000077 "    my $self = shift;"
NSQ_SOURCE_LINE 00000078 "    return 1 if not POSIX::isatty($self);"
NSQ_SOURCE_LINE 00000079 "    my $ttyno   = fileno($self);"
NSQ_SOURCE_LINE 00000080 "    my $termios = POSIX::Termios->new;"
NSQ_SOURCE_LINE 00000081 "    unless ($termios) {"
NSQ_SOURCE_LINE 00000082 "        warn \"set_raw: new POSIX::Termios failed: $!\";"
NSQ_SOURCE_LINE 00000083 "        return undef;"
NSQ_SOURCE_LINE 00000084 "    }"
NSQ_SOURCE_LINE 00000085 "    unless ( $termios->getattr($ttyno) ) {"
NSQ_SOURCE_LINE 00000086 "        warn \"set_raw: getattr($ttyno) failed: $!\";"
NSQ_SOURCE_LINE 00000087 "        return undef;"
NSQ_SOURCE_LINE 00000088 "    }"
NSQ_SOURCE_LINE 00000089 "    $termios->setiflag(0);"
NSQ_SOURCE_LINE 00000090 "    $termios->setoflag(0);"
NSQ_SOURCE_LINE 00000091 "    $termios->setlflag(0);"
NSQ_SOURCE_LINE 00000092 "    $termios->setcflag("
NSQ_SOURCE_LINE 00000093 "        ( $termios->getcflag() & ~( &POSIX::CSIZE | &POSIX::PARENB ) )"
NSQ_SOURCE_LINE 00000094 "        | &POSIX::CS8"
NSQ_SOURCE_LINE 00000095 "    );"
NSQ_SOURCE_LINE 00000096 "    $termios->setcc( &POSIX::VMIN,  1 );"
NSQ_SOURCE_LINE 00000097 "    $termios->setcc( &POSIX::VTIME, 0 );"
NSQ_SOURCE_LINE 00000098 "    unless ( $termios->setattr( $ttyno, &POSIX::TCSANOW ) ) {"
NSQ_SOURCE_LINE 00000099 "        warn \"set_raw: setattr($ttyno) failed: $!\";"
NSQ_SOURCE_LINE 00000100 "        return undef;"
NSQ_SOURCE_LINE 00000101 "    }"
NSQ_SOURCE_LINE 00000102 "    return 1;"
NSQ_SOURCE_LINE 00000103 "}"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "1;"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "__END__"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "=for markdown [![testsuite](https://github.com/cpan-authors/IO-Tty/actions/workflows/testsuite.yml/badge.svg)](https://github.com/cpan-authors/IO-Tty/actions/workflows/testsuite.yml)"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "=head1 NAME"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "IO::Tty - Low-level allocate a pseudo-Tty, import constants."
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "=head1 VERSION"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "1.29"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "    use IO::Tty qw(TIOCNOTTY);"
NSQ_SOURCE_LINE 00000122 "    ..."
NSQ_SOURCE_LINE 00000123 "    # use only to import constants, see IO::Pty to create ptys."
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "C<IO::Tty> is used internally by L<IO::Pty> to create a pseudo-tty."
NSQ_SOURCE_LINE 00000128 "You wouldn't want to use it directly except to import constants, use"
NSQ_SOURCE_LINE 00000129 "L<IO::Pty>.  For a list of importable constants, see"
NSQ_SOURCE_LINE 00000130 "L<IO::Tty::Constant>."
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "Windows is now supported under the Cygwin environment, see"
NSQ_SOURCE_LINE 00000133 "L<http://cygwin.com/>."
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "Please note that pty creation is very system-dependent.  Any modern"
NSQ_SOURCE_LINE 00000136 "POSIX system should be fine.  The test suite is run via GitHub Actions"
NSQ_SOURCE_LINE 00000137 "CI on Linux, macOS, FreeBSD, OpenBSD, and NetBSD."
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "If you have problems on your system and it is listed below, you"
NSQ_SOURCE_LINE 00000140 "probably have a non-standard setup, e.g. you compiled your"
NSQ_SOURCE_LINE 00000141 "Linux-kernel yourself and disabled ptys (bummer!).  Please ask your"
NSQ_SOURCE_LINE 00000142 "friendly sysadmin for help."
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "If your system is not listed, unpack the latest version of C<IO::Tty>,"
NSQ_SOURCE_LINE 00000145 "do a C<'perl Makefile.PL; make; make test; uname -a'> and report"
NSQ_SOURCE_LINE 00000146 "issues at L<https://github.com/cpan-authors/IO-Tty/issues>."
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "=head1 PLATFORMS AND KNOWN ISSUES"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "C<IO::Tty> is tested via CI on Linux, macOS, FreeBSD, OpenBSD, and"
NSQ_SOURCE_LINE 00000152 "NetBSD across multiple Perl versions.  It is also known to work on"
NSQ_SOURCE_LINE 00000153 "AIX, Solaris/illumos, HP-UX, IRIX, z/OS, and Windows (under Cygwin)."
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "Known platform-specific behaviors:"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "=over 4"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "=item * Linux, AIX"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "Returns EIO instead of EOF when the slave is closed.  Benign."
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "=item * FreeBSD, OpenBSD, HP-UX, Solaris"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "EOF on the slave tty is not reported back to the master."
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "=item * OpenBSD"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "The ioctl TIOCSCTTY sometimes fails.  This is also known in"
NSQ_SOURCE_LINE 00000170 "Tcl/Expect."
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "=item * Solaris"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "Has the \"feature\" of returning EOF just once."
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "=item * Cygwin"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "When you send (print) a too long line (>160 chars) to a non-raw pty,"
NSQ_SOURCE_LINE 00000179 "the call just hangs forever and even alarm() cannot get you out."
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "=back"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "Please report issues at"
NSQ_SOURCE_LINE 00000184 "L<https://github.com/cpan-authors/IO-Tty/issues>."
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000188 ""
