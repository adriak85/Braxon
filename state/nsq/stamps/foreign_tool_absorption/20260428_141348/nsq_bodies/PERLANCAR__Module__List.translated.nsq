BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package PERLANCAR::Module::List;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2019-09-12'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.004005'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "#IFUNBUILT"
NSQ_SOURCE_LINE 00000007 "# # use strict 'subs', 'vars';"
NSQ_SOURCE_LINE 00000008 "# # use warnings;"
NSQ_SOURCE_LINE 00000009 "#END IFUNBUILT"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "my $has_globstar;"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "# do our own exporting to start faster"
NSQ_SOURCE_LINE 00000014 "sub import {"
NSQ_SOURCE_LINE 00000015 "    my $pkg = shift;"
NSQ_SOURCE_LINE 00000016 "    my $caller = caller;"
NSQ_SOURCE_LINE 00000017 "    for my $sym (@_) {"
NSQ_SOURCE_LINE 00000018 "        if ($sym eq 'list_modules') { *{\"$caller\\::$sym\"} = \\&{$sym} }"
NSQ_SOURCE_LINE 00000019 "        else { die \"$sym is not exported!\" }"
NSQ_SOURCE_LINE 00000020 "    }"
NSQ_SOURCE_LINE 00000021 "}"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "sub list_modules($$) {"
NSQ_SOURCE_LINE 00000024 "    my($prefix, $options) = @_;"
NSQ_SOURCE_LINE 00000025 "    my $trivial_syntax = $options->{trivial_syntax};"
NSQ_SOURCE_LINE 00000026 "    my($root_leaf_rx, $root_notleaf_rx);"
NSQ_SOURCE_LINE 00000027 "    my($notroot_leaf_rx, $notroot_notleaf_rx);"
NSQ_SOURCE_LINE 00000028 "    if($trivial_syntax) {"
NSQ_SOURCE_LINE 00000029 "        $root_leaf_rx = $notroot_leaf_rx = qr#:?(?:[^/:]+:)*[^/:]+:?#;"
NSQ_SOURCE_LINE 00000030 "        $root_notleaf_rx = $notroot_notleaf_rx ="
NSQ_SOURCE_LINE 00000031 "            qr#:?(?:[^/:]+:)*[^/:]+#;"
NSQ_SOURCE_LINE 00000032 "    } else {"
NSQ_SOURCE_LINE 00000033 "        $root_leaf_rx = $root_notleaf_rx = qr/[a-zA-Z_][0-9a-zA-Z_]*/;"
NSQ_SOURCE_LINE 00000034 "        $notroot_leaf_rx = $notroot_notleaf_rx = qr/[0-9a-zA-Z_]+/;"
NSQ_SOURCE_LINE 00000035 "    }"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "    my $recurse = $options->{recurse};"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "    # filter by wildcard. we cannot do this sooner because wildcard can be put"
NSQ_SOURCE_LINE 00000040 "    # at the end or at the beginning (e.g. '*::Path') so we still need"
NSQ_SOURCE_LINE 00000041 "    my $re_wildcard;"
NSQ_SOURCE_LINE 00000042 "    if ($options->{wildcard}) {"
NSQ_SOURCE_LINE 00000043 "        require String::Wildcard::Bash;"
NSQ_SOURCE_LINE 00000044 "        my $orig_prefix = $prefix;"
NSQ_SOURCE_LINE 00000045 "        my @prefix_parts = split /::/, $prefix;"
NSQ_SOURCE_LINE 00000046 "        $prefix = \"\";"
NSQ_SOURCE_LINE 00000047 "        my $has_wildcard;"
NSQ_SOURCE_LINE 00000048 "        while (defined(my $part = shift @prefix_parts)) {"
NSQ_SOURCE_LINE 00000049 "            if (String::Wildcard::Bash::contains_wildcard($part)) {"
NSQ_SOURCE_LINE 00000050 "                $has_wildcard++;"
NSQ_SOURCE_LINE 00000051 "                # XXX limit recurse level to scalar(@prefix_parts), or -1 if has_globstar"
NSQ_SOURCE_LINE 00000052 "                $recurse = 1 if @prefix_parts;"
NSQ_SOURCE_LINE 00000053 "                last;"
NSQ_SOURCE_LINE 00000054 "            } else {"
NSQ_SOURCE_LINE 00000055 "                $prefix .= \"$part\\::\";"
NSQ_SOURCE_LINE 00000056 "            }"
NSQ_SOURCE_LINE 00000057 "        }"
NSQ_SOURCE_LINE 00000058 "        if ($has_wildcard) {"
NSQ_SOURCE_LINE 00000059 "            $re_wildcard = convert_wildcard_to_re($orig_prefix);"
NSQ_SOURCE_LINE 00000060 "        }"
NSQ_SOURCE_LINE 00000061 "        $recurse = 1 if $has_globstar;"
NSQ_SOURCE_LINE 00000062 "    }"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "    die \"bad module name prefix `$prefix'\""
NSQ_SOURCE_LINE 00000065 "        unless $prefix =~ /\\A(?:${root_notleaf_rx}::"
NSQ_SOURCE_LINE 00000066 "                               (?:${notroot_notleaf_rx}::)*)?\\z/x &&"
NSQ_SOURCE_LINE 00000067 "                                   $prefix !~ /(?:\\A|[^:]::)\\.\\.?::/;"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "    my $list_modules = $options->{list_modules};"
NSQ_SOURCE_LINE 00000070 "    my $list_prefixes = $options->{list_prefixes};"
NSQ_SOURCE_LINE 00000071 "    my $list_pod = $options->{list_pod};"
NSQ_SOURCE_LINE 00000072 "    my $use_pod_dir = $options->{use_pod_dir};"
NSQ_SOURCE_LINE 00000073 "    return {} unless $list_modules || $list_prefixes || $list_pod;"
NSQ_SOURCE_LINE 00000074 "    my $return_path = $options->{return_path};"
NSQ_SOURCE_LINE 00000075 "    my $all = $options->{all};"
NSQ_SOURCE_LINE 00000076 "    my @prefixes = ($prefix);"
NSQ_SOURCE_LINE 00000077 "    my %seen_prefixes;"
NSQ_SOURCE_LINE 00000078 "    my %results;"
NSQ_SOURCE_LINE 00000079 "    while(@prefixes) {"
NSQ_SOURCE_LINE 00000080 "        my $prefix = pop(@prefixes);"
NSQ_SOURCE_LINE 00000081 "        my @dir_suffix = split(/::/, $prefix);"
NSQ_SOURCE_LINE 00000082 "        my $module_rx ="
NSQ_SOURCE_LINE 00000083 "            $prefix eq \"\" ? $root_leaf_rx : $notroot_leaf_rx;"
NSQ_SOURCE_LINE 00000084 "        my $pm_rx = qr/\\A($module_rx)\\.pmc?\\z/;"
NSQ_SOURCE_LINE 00000085 "        my $pod_rx = qr/\\A($module_rx)\\.pod\\z/;"
NSQ_SOURCE_LINE 00000086 "        my $dir_rx ="
NSQ_SOURCE_LINE 00000087 "            $prefix eq \"\" ? $root_notleaf_rx : $notroot_notleaf_rx;"
NSQ_SOURCE_LINE 00000088 "        $dir_rx = qr/\\A$dir_rx\\z/;"
NSQ_SOURCE_LINE 00000089 "        foreach my $incdir (@INC) {"
NSQ_SOURCE_LINE 00000090 "            my $dir = join(\"/\", $incdir, @dir_suffix);"
NSQ_SOURCE_LINE 00000091 "            opendir(my $dh, $dir) or next;"
NSQ_SOURCE_LINE 00000092 "            while(defined(my $entry = readdir($dh))) {"
NSQ_SOURCE_LINE 00000093 "                if(($list_modules && $entry =~ $pm_rx) ||"
NSQ_SOURCE_LINE 00000094 "                       ($list_pod &&"
NSQ_SOURCE_LINE 00000095 "                        $entry =~ $pod_rx)) {"
NSQ_SOURCE_LINE 00000096 "                    my $key = $prefix.$1;"
NSQ_SOURCE_LINE 00000097 "                    next if $re_wildcard && $key !~ $re_wildcard;"
NSQ_SOURCE_LINE 00000098 "                    $results{$key} = $return_path ? ($all ? [@{ $results{$key} || [] }, \"$dir/$entry\"] : \"$dir/$entry\") : undef"
NSQ_SOURCE_LINE 00000099 "                        if $all && $return_path || !exists($results{$key});"
NSQ_SOURCE_LINE 00000100 "                } elsif(($list_prefixes || $recurse) &&"
NSQ_SOURCE_LINE 00000101 "                            ($entry ne '.' && $entry ne '..') &&"
NSQ_SOURCE_LINE 00000102 "                            $entry =~ $dir_rx &&"
NSQ_SOURCE_LINE 00000103 "                            -d join(\"/\", $dir,"
NSQ_SOURCE_LINE 00000104 "                                    $entry)) {"
NSQ_SOURCE_LINE 00000105 "                    my $newmod = $prefix.$entry;"
NSQ_SOURCE_LINE 00000106 "                    my $newpfx = $newmod.\"::\";"
NSQ_SOURCE_LINE 00000107 "                    next if exists $seen_prefixes{$newpfx};"
NSQ_SOURCE_LINE 00000108 "                    $results{$newpfx} = $return_path ? ($all ? [@{ $results{$newpfx} || [] }, \"$dir/$entry/\"] : \"$dir/$entry/\") : undef"
NSQ_SOURCE_LINE 00000109 "                        if ($all && $return_path || !exists($results{$newpfx})) && $list_prefixes;"
NSQ_SOURCE_LINE 00000110 "                    push @prefixes, $newpfx if $recurse;"
NSQ_SOURCE_LINE 00000111 "                }"
NSQ_SOURCE_LINE 00000112 "            }"
NSQ_SOURCE_LINE 00000113 "            next unless $list_pod && $use_pod_dir;"
NSQ_SOURCE_LINE 00000114 "            $dir = join(\"/\", $dir, \"pod\");"
NSQ_SOURCE_LINE 00000115 "            opendir($dh, $dir) or next;"
NSQ_SOURCE_LINE 00000116 "            while(defined(my $entry = readdir($dh))) {"
NSQ_SOURCE_LINE 00000117 "                if($entry =~ $pod_rx) {"
NSQ_SOURCE_LINE 00000118 "                    my $key = $prefix.$1;"
NSQ_SOURCE_LINE 00000119 "                    next if $re_wildcard && $key !~ $re_wildcard;"
NSQ_SOURCE_LINE 00000120 "                    $results{$key} = $return_path ? ($all ? [@{ $results{$key} || [] }, \"$dir/$entry\"] : \"$dir/$entry\") : undef;"
NSQ_SOURCE_LINE 00000121 "                }"
NSQ_SOURCE_LINE 00000122 "            }"
NSQ_SOURCE_LINE 00000123 "        }"
NSQ_SOURCE_LINE 00000124 "    }"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "    # we cannot filter prefixes early with wildcard because we need to dig down"
NSQ_SOURCE_LINE 00000127 "    # first and that would've been prevented if we had a wildcard like *::Foo."
NSQ_SOURCE_LINE 00000128 "    if ($list_prefixes && $re_wildcard) {"
NSQ_SOURCE_LINE 00000129 "        for my $k (keys %results) {"
NSQ_SOURCE_LINE 00000130 "            next unless $k =~ /::\\z/;"
NSQ_SOURCE_LINE 00000131 "            (my $k_nocolon = $k) =~ s/::\\z//;"
NSQ_SOURCE_LINE 00000132 "            delete $results{$k} unless $k =~ $re_wildcard || $k_nocolon =~ $re_wildcard;"
NSQ_SOURCE_LINE 00000133 "        }"
NSQ_SOURCE_LINE 00000134 "    }"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "    return \\%results;"
NSQ_SOURCE_LINE 00000137 "}"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "sub convert_wildcard_to_re {"
NSQ_SOURCE_LINE 00000140 "    $has_globstar = 0;"
NSQ_SOURCE_LINE 00000141 "    my $re = _convert_wildcard_to_re(@_);"
NSQ_SOURCE_LINE 00000142 "    $re = qr/\\A$re\\z/;"
NSQ_SOURCE_LINE 00000143 "    #print \"DEBUG: has_globstar=<$has_globstar>, re=$re\\n\";"
NSQ_SOURCE_LINE 00000144 "    $re;"
NSQ_SOURCE_LINE 00000145 "}"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "# modified from String::Wildcard::Bash 0.040's convert_wildcard_to_re"
NSQ_SOURCE_LINE 00000148 "sub _convert_wildcard_to_re {"
NSQ_SOURCE_LINE 00000149 "    my $opts = ref $_[0] eq 'HASH' ? shift : {};"
NSQ_SOURCE_LINE 00000150 "    my $str = shift;"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "    my $opt_brace   = $opts->{brace} // 1;"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "    my @res;"
NSQ_SOURCE_LINE 00000155 "    my $p;"
NSQ_SOURCE_LINE 00000156 "    while ($str =~ /$String::Wildcard::Bash::RE_WILDCARD_BASH/g) {"
NSQ_SOURCE_LINE 00000157 "        my %m = %+;"
NSQ_SOURCE_LINE 00000158 "        if (defined($p = $m{bash_brace_content})) {"
NSQ_SOURCE_LINE 00000159 "            push @res, quotemeta($m{slashes_before_bash_brace}) if"
NSQ_SOURCE_LINE 00000160 "                $m{slashes_before_bash_brace};"
NSQ_SOURCE_LINE 00000161 "            if ($opt_brace) {"
NSQ_SOURCE_LINE 00000162 "                my @elems;"
NSQ_SOURCE_LINE 00000163 "                while ($p =~ /($String::Wildcard::Bash::re_bash_brace_element)(,|\\z)/g) {"
NSQ_SOURCE_LINE 00000164 "                    push @elems, $1;"
NSQ_SOURCE_LINE 00000165 "                    last unless $2;"
NSQ_SOURCE_LINE 00000166 "                }"
NSQ_SOURCE_LINE 00000167 "                #use DD; dd \\@elems;"
NSQ_SOURCE_LINE 00000168 "                push @res, \"(?:\", join(\"|\", map {"
NSQ_SOURCE_LINE 00000169 "                    convert_wildcard_to_re({"
NSQ_SOURCE_LINE 00000170 "                        bash_brace => 0,"
NSQ_SOURCE_LINE 00000171 "                    }, $_)} @elems), \")\";"
NSQ_SOURCE_LINE 00000172 "            } else {"
NSQ_SOURCE_LINE 00000173 "                push @res, quotemeta($m{bash_brace});"
NSQ_SOURCE_LINE 00000174 "            }"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "        } elsif (defined($p = $m{bash_joker})) {"
NSQ_SOURCE_LINE 00000177 "            if ($p eq '?') {"
NSQ_SOURCE_LINE 00000178 "                push @res, '[^:]';"
NSQ_SOURCE_LINE 00000179 "            } elsif ($p eq '*') {"
NSQ_SOURCE_LINE 00000180 "                push @res, '[^:]*';"
NSQ_SOURCE_LINE 00000181 "            } elsif ($p eq '**') {"
NSQ_SOURCE_LINE 00000182 "                $has_globstar++;"
NSQ_SOURCE_LINE 00000183 "                push @res, '.*';"
NSQ_SOURCE_LINE 00000184 "            }"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "        } elsif (defined($p = $m{literal_brace_single_element})) {"
NSQ_SOURCE_LINE 00000187 "            push @res, quotemeta($p);"
NSQ_SOURCE_LINE 00000188 "        } elsif (defined($p = $m{bash_class})) {"
NSQ_SOURCE_LINE 00000189 "            # XXX no need to escape some characters?"
NSQ_SOURCE_LINE 00000190 "            push @res, $p;"
NSQ_SOURCE_LINE 00000191 "        } elsif (defined($p = $m{sql_joker})) {"
NSQ_SOURCE_LINE 00000192 "            push @res, quotemeta($p);"
NSQ_SOURCE_LINE 00000193 "        } elsif (defined($p = $m{literal})) {"
NSQ_SOURCE_LINE 00000194 "            push @res, quotemeta($p);"
NSQ_SOURCE_LINE 00000195 "        }"
NSQ_SOURCE_LINE 00000196 "    }"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "    join \"\", @res;"
NSQ_SOURCE_LINE 00000199 "}"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "1;"
NSQ_SOURCE_LINE 00000202 "# ABSTRACT: A fork of Module::List"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "__END__"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "=pod"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "=head1 NAME"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "PERLANCAR::Module::List - A fork of Module::List"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "=head1 VERSION"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "This document describes version 0.004005 of PERLANCAR::Module::List (from Perl distribution PERLANCAR-Module-List), released on 2019-09-12."
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "Use like you would L<Module::List>, e.g.:"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 " use PERLANCAR::Module::List qw(list_modules);"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 " $id_modules = list_modules(\"Data::ID::\", { list_modules => 1});"
NSQ_SOURCE_LINE 00000225 " $prefixes = list_modules(\"\", { list_prefixes => 1, recurse => 1 });"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "This module is my personal experimental fork of L<Module::List>; the experiment"
NSQ_SOURCE_LINE 00000230 "has also produced other forks like L<Module::List::Tiny>,"
NSQ_SOURCE_LINE 00000231 "L<Module::List::Wildcard>. It's like Module::List, except for the following"
NSQ_SOURCE_LINE 00000232 "differences:"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "=over"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "=item * lower startup overhead (with some caveats)"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "It avoids using L<Exporter> and implements its own import(). It avoids"
NSQ_SOURCE_LINE 00000239 "L<IO::Dir>, L<Carp>, L<File::Spec>, with the goal of saving a few milliseconds"
NSQ_SOURCE_LINE 00000240 "(a casual test on my PC results in 11ms vs 39ms)."
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "Path separator is hard-coded as C</>."
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "=item * Recognize C<all> option"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "If set to true and C<return_path> is also set to true, will return all found"
NSQ_SOURCE_LINE 00000247 "paths for each module instead of just the first found one. The values of result"
NSQ_SOURCE_LINE 00000248 "will be an arrayref containing all found paths."
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "=item * Recognize C<wildcard> option"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "This boolean option can be set to true to recognize wildcard pattern in prefix."
NSQ_SOURCE_LINE 00000253 "Wildcard patterns such as jokers (C<?>, C<*>, C<**>), classes (C<[a-z]>), as"
NSQ_SOURCE_LINE 00000254 "well as braces (C<{One,Two}>) are supported. C<**> implies recursive listing."
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "Examples:"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 " list_modules(\"Module::P*\", {wildcard=>1, list_modules=>1});"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "results in something like:"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 " {"
NSQ_SOURCE_LINE 00000263 "     \"Module::Patch\"             => undef,"
NSQ_SOURCE_LINE 00000264 "     \"Module::Path\"              => undef,"
NSQ_SOURCE_LINE 00000265 "     \"Module::Pluggable\"         => undef,"
NSQ_SOURCE_LINE 00000266 " }"
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "while:"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 " list_modules(\"Module::P**\", {wildcard=>1, list_modules=>1});"
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "results in something like:"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 " {"
NSQ_SOURCE_LINE 00000275 "     \"Module::Patch\"             => undef,"
NSQ_SOURCE_LINE 00000276 "     \"Module::Path\"              => undef,"
NSQ_SOURCE_LINE 00000277 "     \"Module::Path::More\"        => undef,"
NSQ_SOURCE_LINE 00000278 "     \"Module::Pluggable\"         => undef,"
NSQ_SOURCE_LINE 00000279 "     \"Module::Pluggable::Object\" => undef,"
NSQ_SOURCE_LINE 00000280 " }"
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "while:"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 " list_modules(\"Module::**le\", {wildcard=>1, list_modules=>1});"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "results in something like:"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 " {"
NSQ_SOURCE_LINE 00000289 "     \"Module::Depakable\"                => undef,"
NSQ_SOURCE_LINE 00000290 "     \"Module::Install::Admin::Bundle\"   => undef,"
NSQ_SOURCE_LINE 00000291 "     \"Module::Install::Admin::Makefile\" => undef,"
NSQ_SOURCE_LINE 00000292 "     \"Module::Install::Bundle\"          => undef,"
NSQ_SOURCE_LINE 00000293 "     \"Module::Install::Makefile\"        => undef,"
NSQ_SOURCE_LINE 00000294 "     \"Module::Pluggable\"                => undef,"
NSQ_SOURCE_LINE 00000295 " }"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "=back"
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "=for Pod::Coverage .+"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "Please visit the project's homepage at L<https://metacpan.org/release/PERLANCAR-Module-List>."
NSQ_SOURCE_LINE 00000304 ""
