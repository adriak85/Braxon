NSQ_SOURCE_LINE 00000001 "package HTTP::Thin;"
NSQ_SOURCE_LINE 00000002 "$HTTP::Thin::VERSION = '0.006';"
NSQ_SOURCE_LINE 00000003 "use warnings;"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "#ABSTRACT: A Thin Wrapper around HTTP::Tiny to play nice with HTTP::Message"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "use parent qw(HTTP::Tiny);"
NSQ_SOURCE_LINE 00000008 "use Safe::Isa;"
NSQ_SOURCE_LINE 00000009 "use Class::Method::Modifiers;"
NSQ_SOURCE_LINE 00000010 "use HTTP::Response;"
NSQ_SOURCE_LINE 00000011 "use Hash::MultiValue;"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "around request => sub {"
NSQ_SOURCE_LINE 00000016 "        my ($next, $self, @args) = @_;"
NSQ_SOURCE_LINE 00000017 "        if (@args == 1 && $args[0]->$_isa('HTTP::Request')) {"
NSQ_SOURCE_LINE 00000018 "                my $req = shift @args;"
NSQ_SOURCE_LINE 00000019 "                my @headers;"
NSQ_SOURCE_LINE 00000020 "                $req->headers->scan(sub { push @headers, @_ });"
NSQ_SOURCE_LINE 00000021 "                        "
NSQ_SOURCE_LINE 00000022 "                my $options = {};"
NSQ_SOURCE_LINE 00000023 "                $options->{headers} = Hash::MultiValue->new(@headers)->mixed if @headers;"
NSQ_SOURCE_LINE 00000024 "                $options->{content} = $req->content if length($req->content);"
NSQ_SOURCE_LINE 00000025 "                @args = ( "
NSQ_SOURCE_LINE 00000026 "                        $req->method,"
NSQ_SOURCE_LINE 00000027 "                        $req->uri,"
NSQ_SOURCE_LINE 00000028 "                        ( keys %$options ? $options : () ),"
NSQ_SOURCE_LINE 00000029 "                );"
NSQ_SOURCE_LINE 00000030 "        }"
NSQ_SOURCE_LINE 00000031 "        my $res =  $self->$next(@args);"
NSQ_SOURCE_LINE 00000032 "        return HTTP::Response->new("
NSQ_SOURCE_LINE 00000033 "                $res->{status},"
NSQ_SOURCE_LINE 00000034 "                $res->{reason},"
NSQ_SOURCE_LINE 00000035 "                [ Hash::MultiValue->from_mixed($res->{headers})->flatten ],"
NSQ_SOURCE_LINE 00000036 "                $res->{content},"
NSQ_SOURCE_LINE 00000037 "        );"
NSQ_SOURCE_LINE 00000038 "};"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "1;"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "__END__"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "=pod"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "=head1 NAME"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "HTTP::Thin - A Thin Wrapper around HTTP::Tiny to play nice with HTTP::Message"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "=head1 VERSION"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "version 0.006"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "    use 5.12.1;"
NSQ_SOURCE_LINE 00000059 "    use HTTP::Request::Common;"
NSQ_SOURCE_LINE 00000060 "    use HTTP::Thin;"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "    say HTTP::Thin->new()->request(GET 'http://example.com')->as_string;"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "WARNING: This module is untested beyond the very basics. The implementation is simple enough that it shouldn't do evil things but, yeah it's still not approved for use by small children."
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "C<HTTP::Thin> is a thin wrapper around L<HTTP::Tiny> adding the ability to pass in L<HTTP::Request> objects and get back L<HTTP::Response> objects. The maintainers of L<HTTP::Tiny>, justifiably, don't want to have to maintain compatibility but many other projects already consume the L<HTTP::Message> objects. This is just glue code doing what it does best."
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "=head1 METHODS"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "=head2 request"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "In addition to the parameters documented in L<HTTP::Tiny>, C<HTTP::Thin> takes L<HTTP::Request> objects as well. "
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "The return value is an L<HTTP::Response> object."
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "=head1 WHY?"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "A conversation on IRC lead to C<mst>, C<ether>, and I agreeing that this would be a useful module but probably not worth the effort. I wrote it anyway to get it out of my head. "
NSQ_SOURCE_LINE 00000081 ""
