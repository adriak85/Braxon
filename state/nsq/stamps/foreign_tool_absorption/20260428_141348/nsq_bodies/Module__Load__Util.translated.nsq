NSQ_SOURCE_LINE 00000001 "package Module::Load::Util;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict 'subs', 'vars';"
NSQ_SOURCE_LINE 00000004 "use Regexp::Pattern::Perl::Module ();"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000007 "our $DATE = '2024-05-13'; # DATE"
NSQ_SOURCE_LINE 00000008 "our $DIST = 'Module-Load-Util'; # DIST"
NSQ_SOURCE_LINE 00000009 "our $VERSION = '0.012'; # VERSION"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "use Exporter 'import';"
NSQ_SOURCE_LINE 00000012 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000013 "                       load_module_with_optional_args"
NSQ_SOURCE_LINE 00000014 "                       instantiate_class_with_optional_args"
NSQ_SOURCE_LINE 00000015 "                       call_module_function_with_optional_args"
NSQ_SOURCE_LINE 00000016 "                       call_module_method_with_optional_args"
NSQ_SOURCE_LINE 00000017 "               );"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "sub _normalize_module_with_optional_args {"
NSQ_SOURCE_LINE 00000020 "    my $module_with_optional_args = shift;"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "    my ($module, $args);"
NSQ_SOURCE_LINE 00000023 "    if (ref $module_with_optional_args eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000024 "        die \"array form or module/class name must have 1 or 2 elements\""
NSQ_SOURCE_LINE 00000025 "            unless @$module_with_optional_args == 1 || @$module_with_optional_args == 2;"
NSQ_SOURCE_LINE 00000026 "        $module = $module_with_optional_args->[0];"
NSQ_SOURCE_LINE 00000027 "        $args = $module_with_optional_args->[1] || [];"
NSQ_SOURCE_LINE 00000028 "        $args = [%$args] if ref $args eq 'HASH';"
NSQ_SOURCE_LINE 00000029 "        die \"In array form of module/class name, the 2nd element must be \"."
NSQ_SOURCE_LINE 00000030 "            \"arrayref or hashref\" unless ref $args eq 'ARRAY';"
NSQ_SOURCE_LINE 00000031 "    } elsif (ref $module_with_optional_args) {"
NSQ_SOURCE_LINE 00000032 "        die \"module/class name must be string or 2-element array, not \"."
NSQ_SOURCE_LINE 00000033 "            $module_with_optional_args;"
NSQ_SOURCE_LINE 00000034 "    } elsif ($module_with_optional_args =~ /(.+?)[=,](.*)/) {"
NSQ_SOURCE_LINE 00000035 "        $module = $1;"
NSQ_SOURCE_LINE 00000036 "        $args = [split /,/, $2];"
NSQ_SOURCE_LINE 00000037 "    } else {"
NSQ_SOURCE_LINE 00000038 "        $module = $module_with_optional_args;"
NSQ_SOURCE_LINE 00000039 "        $args = [];"
NSQ_SOURCE_LINE 00000040 "    }"
NSQ_SOURCE_LINE 00000041 "    ($module, $args);"
NSQ_SOURCE_LINE 00000042 "}"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "sub _load_module {"
NSQ_SOURCE_LINE 00000045 "    my $opts = ref $_[0] eq 'HASH' ? shift : {};"
NSQ_SOURCE_LINE 00000046 "    my $module = shift;"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "    my $do_load = defined $opts->{load} ? $opts->{load} : 1;"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "    unless ($do_load) {"
NSQ_SOURCE_LINE 00000051 "        if ($opts->{ns_prefix}) {"
NSQ_SOURCE_LINE 00000052 "            $module = $opts->{ns_prefix} . ($opts->{ns_prefix} =~ /::\\z/ ? '' : '::') . $module;"
NSQ_SOURCE_LINE 00000053 "        } elsif ($opts->{ns_prefixes} && @{ $opts->{ns_prefixes} }) {"
NSQ_SOURCE_LINE 00000054 "            $module = $opts->{ns_prefixes}[0] . ($opts->{ns_prefixes}[0] =~ /::\\z/ ? '' : '::') . $module;"
NSQ_SOURCE_LINE 00000055 "        }"
NSQ_SOURCE_LINE 00000056 "        return $module;"
NSQ_SOURCE_LINE 00000057 "    }"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "    my @ns_prefixes = $opts->{ns_prefixes} ? @{$opts->{ns_prefixes}} :"
NSQ_SOURCE_LINE 00000060 "        defined($opts->{ns_prefix}) ? ($opts->{ns_prefix}) : ('');"
NSQ_SOURCE_LINE 00000061 "    my $try_all = $opts->{ns_prefixes} ? 1:0;"
NSQ_SOURCE_LINE 00000062 "    my $module_with_prefix;"
NSQ_SOURCE_LINE 00000063 "    for my $i (0 .. $#ns_prefixes) {"
NSQ_SOURCE_LINE 00000064 "        my $ns_prefix = $ns_prefixes[$i];"
NSQ_SOURCE_LINE 00000065 "        if (length $ns_prefix) {"
NSQ_SOURCE_LINE 00000066 "            $module_with_prefix ="
NSQ_SOURCE_LINE 00000067 "                $ns_prefix . ($ns_prefix =~ /::\\z/ ? '':'::') . $module;"
NSQ_SOURCE_LINE 00000068 "        } else {"
NSQ_SOURCE_LINE 00000069 "            $module_with_prefix = $module;"
NSQ_SOURCE_LINE 00000070 "        }"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "        (my $module_with_prefix_pm = \"$module_with_prefix.pm\") =~ s!::!/!g;"
NSQ_SOURCE_LINE 00000073 "        if ($try_all) {"
NSQ_SOURCE_LINE 00000074 "            eval { require $module_with_prefix_pm }; last unless $@;"
NSQ_SOURCE_LINE 00000075 "            warn $@ if $@ !~ /\\ACan't locate/;"
NSQ_SOURCE_LINE 00000076 "        } else {"
NSQ_SOURCE_LINE 00000077 "            require $module_with_prefix_pm;"
NSQ_SOURCE_LINE 00000078 "        }"
NSQ_SOURCE_LINE 00000079 "    }"
NSQ_SOURCE_LINE 00000080 "    if ($@) {"
NSQ_SOURCE_LINE 00000081 "        die \"load_module_with_optional_args(): Failed to load module '$module' (all prefixes tried: \".join(\", \", @ns_prefixes).\")\";"
NSQ_SOURCE_LINE 00000082 "    }"
NSQ_SOURCE_LINE 00000083 "    $module_with_prefix;"
NSQ_SOURCE_LINE 00000084 "}"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "sub load_module_with_optional_args {"
NSQ_SOURCE_LINE 00000087 "    my $opts = ref($_[0]) eq 'HASH' ? shift : {};"
NSQ_SOURCE_LINE 00000088 "    my $module_with_optional_args = shift;"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "    my $target_package ="
NSQ_SOURCE_LINE 00000091 "        defined $opts->{target_package} ? $opts->{target_package} :"
NSQ_SOURCE_LINE 00000092 "        defined $opts->{caller} ? $opts->{caller} :"
NSQ_SOURCE_LINE 00000093 "        caller(0);"
NSQ_SOURCE_LINE 00000094 "    # check because we will use eval \"\""
NSQ_SOURCE_LINE 00000095 "    $target_package =~ $Regexp::Pattern::Perl::Module::RE{perl_modname}{pat}"
NSQ_SOURCE_LINE 00000096 "        or die \"Invalid syntax in target package '$target_package'\";"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "    my ($module, $args) = _normalize_module_with_optional_args("
NSQ_SOURCE_LINE 00000099 "        $module_with_optional_args);"
NSQ_SOURCE_LINE 00000100 "    $module = _load_module($opts, $module);"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "    my $do_import = defined $opts->{import} ? $opts->{import} : 1;"
NSQ_SOURCE_LINE 00000103 "    if ($do_import) {"
NSQ_SOURCE_LINE 00000104 "        eval \"package $target_package; $module->import(\\@{\\$args});\"; ## no critic: BuiltinFunctions::ProhibitStringyEval"
NSQ_SOURCE_LINE 00000105 "        die if $@;"
NSQ_SOURCE_LINE 00000106 "    }"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "    {module=>$module, args=>$args};"
NSQ_SOURCE_LINE 00000109 "}"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "sub instantiate_class_with_optional_args {"
NSQ_SOURCE_LINE 00000112 "    my $opts = ref($_[0]) eq 'HASH' ? {%{shift()}} : {}; # shallow copy"
NSQ_SOURCE_LINE 00000113 "    my $class_with_optional_args = shift;"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "    $opts->{import} = 0;"
NSQ_SOURCE_LINE 00000116 "    $opts->{target_package} = caller(0);"
NSQ_SOURCE_LINE 00000117 "    my $res = load_module_with_optional_args($opts, $class_with_optional_args);"
NSQ_SOURCE_LINE 00000118 "    #use DD; print \"Options: \"; dd $opts; print \"Result: \"; dd $res;"
NSQ_SOURCE_LINE 00000119 "    my $class = $res->{module};"
NSQ_SOURCE_LINE 00000120 "    my $args  = $res->{args};"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "    my $do_construct = defined $opts->{construct} ? $opts->{construct} : 1;"
NSQ_SOURCE_LINE 00000123 "    if ($do_construct) {"
NSQ_SOURCE_LINE 00000124 "        my $constructor = defined $opts->{constructor} ?"
NSQ_SOURCE_LINE 00000125 "            $opts->{constructor} : 'new';"
NSQ_SOURCE_LINE 00000126 "        my $obj = $class->$constructor(@$args);"
NSQ_SOURCE_LINE 00000127 "        return $obj;"
NSQ_SOURCE_LINE 00000128 "    } else {"
NSQ_SOURCE_LINE 00000129 "        return +{class=>$class, args=>$args};"
NSQ_SOURCE_LINE 00000130 "    }"
NSQ_SOURCE_LINE 00000131 "}"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "sub call_module_function_with_optional_args {"
NSQ_SOURCE_LINE 00000134 "    my $opts = ref($_[0]) eq 'HASH' ? shift : {};"
NSQ_SOURCE_LINE 00000135 "    my $module_with_optional_args = shift;"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "    my ($module, $args) = _normalize_module_with_optional_args("
NSQ_SOURCE_LINE 00000138 "        $module_with_optional_args);"
NSQ_SOURCE_LINE 00000139 "    my $function;"
NSQ_SOURCE_LINE 00000140 "    if (defined $opts->{function}) {"
NSQ_SOURCE_LINE 00000141 "        $function = $opts->{function};"
NSQ_SOURCE_LINE 00000142 "    } else {"
NSQ_SOURCE_LINE 00000143 "        $module =~ s/\\A(.+)::(\\w+)\\z/$1/ or die \"Please specify MODULE::FUNCTION, not just module name '$module'\";"
NSQ_SOURCE_LINE 00000144 "        $function = $2;"
NSQ_SOURCE_LINE 00000145 "    }"
NSQ_SOURCE_LINE 00000146 "    $module = _load_module($opts, $module);"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "    &{\"$module\\::$function\"}(@$args);"
NSQ_SOURCE_LINE 00000149 "}"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "sub call_module_method_with_optional_args {"
NSQ_SOURCE_LINE 00000152 "    my $opts = ref($_[0]) eq 'HASH' ? shift : {};"
NSQ_SOURCE_LINE 00000153 "    my $module_with_optional_args = shift;"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "    my ($module, $args) = _normalize_module_with_optional_args("
NSQ_SOURCE_LINE 00000156 "        $module_with_optional_args);"
NSQ_SOURCE_LINE 00000157 "    my $method;"
NSQ_SOURCE_LINE 00000158 "    if (defined $opts->{method}) {"
NSQ_SOURCE_LINE 00000159 "        $method = $opts->{method};"
NSQ_SOURCE_LINE 00000160 "    } else {"
NSQ_SOURCE_LINE 00000161 "        $module =~ s/\\A(.+)::(\\w+)\\z/$1/ or die \"Please specify MODULE::FUNCTION, not just module name '$module'\";"
NSQ_SOURCE_LINE 00000162 "        $method = $2;"
NSQ_SOURCE_LINE 00000163 "    }"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "    $module = _load_module($opts, $module);"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "    $module->$method(@$args);"
NSQ_SOURCE_LINE 00000168 "}"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "1;"
NSQ_SOURCE_LINE 00000171 "# ABSTRACT: Some utility routines related to module loading"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "__END__"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "=pod"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "=head1 NAME"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "Module::Load::Util - Some utility routines related to module loading"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "=head1 VERSION"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "This document describes version 0.012 of Module::Load::Util (from Perl distribution Module-Load-Util), released on 2024-05-13."
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 " use Module::Load::Util qw("
NSQ_SOURCE_LINE 00000190 "     load_module_with_optional_args"
NSQ_SOURCE_LINE 00000191 "     instantiate_class_with_optional_args"
NSQ_SOURCE_LINE 00000192 "     call_module_function_with_optional_args"
NSQ_SOURCE_LINE 00000193 "     call_module_method_with_optional_args"
NSQ_SOURCE_LINE 00000194 " );"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 " load_module_with_optional_args(\"Foo::Bar=import-arg1,import-arg2\");"
NSQ_SOURCE_LINE 00000197 " load_module_with_optional_args([\"Foo::Bar\", [\"import-arg1\", \"import-arg2\"]]);"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 " my $obj = instantiate_class_with_optional_args(\"Some::Class=opt1,val1,opt2,val2\");"
NSQ_SOURCE_LINE 00000200 " my $obj = instantiate_class_with_optional_args([\"Some::Class\", {opt1=>\"val1\",opt2=>\"val2\"}]);"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "See more examples in each function's documentation in the L</FUNCTIONS> section."
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "This module provides some utility routines related to module loading. Currently"
NSQ_SOURCE_LINE 00000207 "what it offers now are the two functions L</load_module_with_optional_args> and"
NSQ_SOURCE_LINE 00000208 "L</instantiate_class_with_optional_args>. These functions are designed for use"
NSQ_SOURCE_LINE 00000209 "with command-line and/or plugin-based applications, because you can specify"
NSQ_SOURCE_LINE 00000210 "module/class/plugin to load in a flexible format, as a string or 2-element"
NSQ_SOURCE_LINE 00000211 "array. See L<wordlist> (from L<App::wordlist>), L<tabledata> (from"
NSQ_SOURCE_LINE 00000212 "L<App::tabledata>), or L<ColorTheme> for some of the applications that use this"
NSQ_SOURCE_LINE 00000213 "module."
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "Please see the functions' documentation for more details."
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "=head2 load_module_with_optional_args"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "Usage:"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 " load_module_with_optional_args( [ \\%opts , ] $module_with_optional_args );"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "Examples:"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 " load_module_with_optional_args(\"Color::RGB::Util\");                # default imports, equivalent to runtime version of 'use Color::RGB::Util'"
NSQ_SOURCE_LINE 00000228 " load_module_with_optional_args([\"Color::RGB::Util\", []]);          # ditto"
NSQ_SOURCE_LINE 00000229 " load_module_with_optional_args([\"Color::RGB::Util\", {}]);          # ditto"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 " load_module_with_optional_args(\"Color::RGB::Util=rgb2hsv\");        # imports rgb2hsv. equivalent to runtime version of 'use Color::RGB::Util qw(rgb2hsv)'"
NSQ_SOURCE_LINE 00000232 " load_module_with_optional_args([\"Color::RGB::Util\", [\"rgb2hsv\"]]); # ditto"
NSQ_SOURCE_LINE 00000233 " load_module_with_optional_args([\"Foo::Bar\", {arg1=>1, arg2=>2}]);  # equivalent to runtime version of 'use Foo::Bar qw(arg1 1 arg2 2)'. hashref will be list-ified"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 " load_module_with_optional_args({import=>0}, \"Color::RGB::Util\");   # do not import,   equivalent to runtime version of 'use Color::RGB::Util ()'"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 " load_module_with_optional_args({ns_prefix=>\"Color\"}, \"RGB::Util=rgb2hsv\");        # equivalent to runtime version of 'use Color::RGB::Util qw(rgb2hsv)'"
NSQ_SOURCE_LINE 00000238 " load_module_with_optional_args({ns_prefix=>\"Color\"}, [\"RGB::Util\", [\"rgb2hsv\"]]); # ditto"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "Load a module with C<require()> followed by calling the module's C<import()>"
NSQ_SOURCE_LINE 00000241 "(unless instructed to skip importing). Main feature of this function is the"
NSQ_SOURCE_LINE 00000242 "flexibility in the C<$module_with_optional_args> argument, as well as some"
NSQ_SOURCE_LINE 00000243 "options like namespace prefix. Suitable to be used to load plugins for your"
NSQ_SOURCE_LINE 00000244 "application, for example, where you can specify the plugin to load as simply a"
NSQ_SOURCE_LINE 00000245 "string or a 2-element array."
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "C<$module_with_optional_args> can be a string containing module name (e.g."
NSQ_SOURCE_LINE 00000248 "C<\"Foo::Bar\">), or a string containing module name string followed by C<=>,"
NSQ_SOURCE_LINE 00000249 "followed by comma-separated list of imports, a la perl's C<-M> (e.g."
NSQ_SOURCE_LINE 00000250 "C<\"Foo::Bar=arg1,arg2\">), or a 2-element array where the first element is the"
NSQ_SOURCE_LINE 00000251 "module name and the second element is an arrayref or hashref containing import"
NSQ_SOURCE_LINE 00000252 "arguments (e.g. C<< [\"Foo::Bar\", [\"arg1\",\"arg2\"]] >> or C<< [\"Foo::Bar\","
NSQ_SOURCE_LINE 00000253 "{arg1=>\"val\",arg2=>\"val\"]] >>). Hashref list of arguments will still be passed"
NSQ_SOURCE_LINE 00000254 "as a list to C<import()>."
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "Will die on require() or import() failure."
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "Will return a hashref containing module name and arguments, e.g. C<<"
NSQ_SOURCE_LINE 00000259 "{module=>\"Foo\", args=>[\"arg1\",1,\"arg2\",2]} >>."
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "Known options:"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "=over"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "=item * import"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "Bool. Defaults to true. Can be set to false to avoid import()-ing."
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "=item * ns_prefix"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "Str. Namespace to use. For example, if you set this to C<WordList> then with"
NSQ_SOURCE_LINE 00000272 "C<$module_with_optional_args> set to C<ID::KBBI>, the module"
NSQ_SOURCE_LINE 00000273 "L<WordList::ID::KBBI> will be loaded."
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "=item * ns_prefixes"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "Array of str. Like L</ns_prefix> but will attempt all prefixes and will fail if"
NSQ_SOURCE_LINE 00000278 "all prefixes fail."
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "=item * target_package"
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "Str. Target package to import() to. Default is caller(0)."
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "=back"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "=head2 instantiate_class_with_optional_args"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "Usage:"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 " instantiate_class_with_optional_args( [ \\%opts , ] $class_with_optional_args );"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "Examples:"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 " my $obj = instantiate_class_with_optional_args(\"WordList::Color::Any\");                           # equivalent to: require WordList::Color::Any; WordList::Color::Any->new;"
NSQ_SOURCE_LINE 00000295 " my $obj = instantiate_class_with_optional_args([\"WordList::Color::Any\"], []]);                    # ditto"
NSQ_SOURCE_LINE 00000296 " my $obj = instantiate_class_with_optional_args([\"WordList::Color::Any\"], {}]);                    # ditto"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 " my $obj = instantiate_class_with_optional_args(\"WordList::Color::Any=theme,Foo\");                 # equivalent to: require WordList::Color::Any; WordList::Color::Any->new(theme=>\"Foo\");"
NSQ_SOURCE_LINE 00000299 " my $obj = instantiate_class_with_optional_args([\"WordList::Color::Any\",{theme=>\"Foo\"});           # ditto"
NSQ_SOURCE_LINE 00000300 " my $obj = instantiate_class_with_optional_args([\"WordList::Color::Any\",[theme=>\"Foo\"]);           # ditto"
NSQ_SOURCE_LINE 00000301 " my $obj = instantiate_class_with_optional_args([\"Foo::Bar\",[{arg1=>1, arg2=>2}]);                 # equivalent to: require Foo::Bar; Foo::Bar->new({arg1=>1, arg2=>2});"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 " my $obj = instantiate_class_with_optional_args({ns_prefix=>\"WordList\"}, \"Color::Any=theme,Foo\");  # equivalent to: require WordList::Color::Any; WordList::Color::Any->new(theme=>\"Foo\");"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "This is like L</load_module_with_optional_args> but the constructor arguments"
NSQ_SOURCE_LINE 00000306 "specified after C<=> will be passed to the class constructor instead of used as"
NSQ_SOURCE_LINE 00000307 "import arguments."
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "When you use the 2-element array form of C<$class_with_optional_args>, the"
NSQ_SOURCE_LINE 00000310 "hashref and arrayref constructor arguments will be converted to a list."
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "Known options:"
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "=over"
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "=item * construct"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "Bool. Default to true. If set to false, constructor will not be called and the"
NSQ_SOURCE_LINE 00000319 "function will just return the hashref containing class name and arguments, e.g."
NSQ_SOURCE_LINE 00000320 "C<< {class=>\"Foo\", args=>[\"arg1\",1,\"args2\",2]} >>."
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "=item * constructor"
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "Str. Select constructor name. Defaults to C<new>."
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "=item * ns_prefix"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "Str. Like in L</load_module_with_optional_args>."
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "=item * ns_prefixes"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "Array of str. Like in L</load_module_with_optional_args>."
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "=item * load"
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "Boolean. Default true. Whether to C<require> the class module. Sometimes you do"
NSQ_SOURCE_LINE 00000337 "not want to C<require()>, e.g. when the class is already defined somewhere else."
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "=back"
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "=head2 call_module_function_with_optional_args"
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "Usage:"
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 " call_module_function_with_optional_args( [ \\%opts , ] $function_with_optional_args );"
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "Examples:"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 " # function name will be stripped from module name"
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "call_module_function_with_optional_args(\"App::ChromeUtils::chrome_is_running\");"
NSQ_SOURCE_LINE 00000352 " call_module_function_with_optional_args(\"App::ChromeUtils::start_chrome=quiet,1\");"
NSQ_SOURCE_LINE 00000353 " call_module_function_with_optional_args(\"Color::RGB::Util::int2rgb=100500\");"
NSQ_SOURCE_LINE 00000354 " call_module_function_with_optional_args([\"App::ChromeUtils::start_chrome\" => {quiet=>1}]);"
NSQ_SOURCE_LINE 00000355 " call_module_function_with_optional_args([\"Color::RGB::Util::int2rgb\" => [100500]]);"
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 " call_module_function_with_optional_args({load=>0}, [\"Color::RGB::Util::int2rgb\" => [100500]]);"
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 " # if 'function' option is specified,"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 " call_module_function_with_optional_args({function=>\"chrome_is_running\"}, \"App::ChromeUtils\");"
NSQ_SOURCE_LINE 00000362 " call_module_function_with_optional_args({function=>\"start_chrome\"}, \"App::ChromeUtils=quiet,1\");"
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "Load module then call module's function with optional arguments."
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "Known options:"
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 "=over"
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "=item * load"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "=item * ns_prefix"
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "=item * ns_prefixes"
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "=item * function"
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 "=back"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "=head2 call_module_method_with_optional_args"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "Just like L</call_module_function_with_optional_args> except the subroutine call"
NSQ_SOURCE_LINE 00000383 "is replaced with a method call instead."
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "Known options:"
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "=over"
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "=item * load"
NSQ_SOURCE_LINE 00000390 ""
NSQ_SOURCE_LINE 00000391 "=item * ns_prefix"
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "=item * ns_prefixes"
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "=item * method"
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "=back"
NSQ_SOURCE_LINE 00000398 ""
