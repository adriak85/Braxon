NSQ_SOURCE_LINE 00000001 "package Mozilla::CA;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use warnings;"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "our $VERSION = '20250602';"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "use File::Spec ();"
NSQ_SOURCE_LINE 00000008 "use File::Basename qw(dirname);"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "sub SSL_ca_file {"
NSQ_SOURCE_LINE 00000011 "    my $file = File::Spec->catfile(dirname(__FILE__), \"CA\", \"cacert.pem\");"
NSQ_SOURCE_LINE 00000012 "    return File::Spec->rel2abs($file);"
NSQ_SOURCE_LINE 00000013 "}"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "1;"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "__END__"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "=head1 NAME"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "Mozilla::CA - Mozilla's CA cert bundle in PEM format"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "    use IO::Socket::SSL;"
NSQ_SOURCE_LINE 00000026 "    use Mozilla::CA;"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "    my $host = \"www.paypal.com\";"
NSQ_SOURCE_LINE 00000029 "    my $client = IO::Socket::SSL->new("
NSQ_SOURCE_LINE 00000030 "        PeerHost => \"$host:443\","
NSQ_SOURCE_LINE 00000031 "        SSL_verify_mode => 0x02,"
NSQ_SOURCE_LINE 00000032 "        SSL_ca_file => Mozilla::CA::SSL_ca_file(),"
NSQ_SOURCE_LINE 00000033 "    )"
NSQ_SOURCE_LINE 00000034 "        || die \"Can't connect: $@\";"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "    $client->verify_hostname($host, \"http\")"
NSQ_SOURCE_LINE 00000037 "        || die \"hostname verification failure\";"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "Mozilla::CA provides a copy of Mozilla's bundle of Certificate Authority"
NSQ_SOURCE_LINE 00000042 "certificates in a form that can be consumed by modules and libraries"
NSQ_SOURCE_LINE 00000043 "based on OpenSSL."
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "The module provide a single function:"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "=over"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "=item SSL_ca_file()"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "Returns the absolute path to the Mozilla's CA cert bundle PEM file."
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "=back"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "L<http://curl.haxx.se/docs/caextract.html>"
NSQ_SOURCE_LINE 00000058 ""
