NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "package ExtUtils::PkgConfig;"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "use strict;"
NSQ_SOURCE_LINE 00000022 "use Carp;"
NSQ_SOURCE_LINE 00000023 "use English qw(-no_match_vars); # avoid regex performance penalty"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "use vars qw/ $VERSION $AUTOLOAD/;"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "$VERSION = '1.16';"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "sub import {"
NSQ_SOURCE_LINE 00000030 "\tmy $class = shift;"
NSQ_SOURCE_LINE 00000031 "\treturn unless @_;"
NSQ_SOURCE_LINE 00000032 "        die \"$class version $_[0] is required--this is only version $VERSION\""
NSQ_SOURCE_LINE 00000033 "\t\tif $VERSION < $_[0];"
NSQ_SOURCE_LINE 00000034 "}"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "sub AUTOLOAD"
NSQ_SOURCE_LINE 00000037 "{"
NSQ_SOURCE_LINE 00000038 "\tmy $class = shift;"
NSQ_SOURCE_LINE 00000039 "\tmy $modulename = shift;"
NSQ_SOURCE_LINE 00000040 "\tmy $function = $AUTOLOAD;"
NSQ_SOURCE_LINE 00000041 "\t$function =~ s/.*://;"
NSQ_SOURCE_LINE 00000042 "\t$function =~ s/_/-/g;"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "\tmy $ans = undef;"
NSQ_SOURCE_LINE 00000045 "\tmy $arg = shift;"
NSQ_SOURCE_LINE 00000046 "\tif (grep {$_ eq $function} qw/libs"
NSQ_SOURCE_LINE 00000047 "\t                              modversion"
NSQ_SOURCE_LINE 00000048 "\t                              cflags"
NSQ_SOURCE_LINE 00000049 "\t                              cflags-only-I"
NSQ_SOURCE_LINE 00000050 "\t                              cflags-only-other"
NSQ_SOURCE_LINE 00000051 "\t                              libs-only-L"
NSQ_SOURCE_LINE 00000052 "\t                              libs-only-l"
NSQ_SOURCE_LINE 00000053 "\t                              libs-only-other/)"
NSQ_SOURCE_LINE 00000054 "\t{"
NSQ_SOURCE_LINE 00000055 "\t\t# simple"
NSQ_SOURCE_LINE 00000056 "\t\t$ans = `pkg-config --$function \\\"$modulename\\\"`;"
NSQ_SOURCE_LINE 00000057 "\t}"
NSQ_SOURCE_LINE 00000058 "\telsif ('static-libs' eq $function)"
NSQ_SOURCE_LINE 00000059 "\t{"
NSQ_SOURCE_LINE 00000060 "\t\t$ans = `pkg-config --libs --static \\\"$modulename\\\"`;"
NSQ_SOURCE_LINE 00000061 "\t}"
NSQ_SOURCE_LINE 00000062 "\telsif ('variable' eq $function)"
NSQ_SOURCE_LINE 00000063 "\t{"
NSQ_SOURCE_LINE 00000064 "\t\t# variable"
NSQ_SOURCE_LINE 00000065 "\t\t$ans = `pkg-config --${function}=$arg \\\"$modulename\\\"`;"
NSQ_SOURCE_LINE 00000066 "\t}"
NSQ_SOURCE_LINE 00000067 "\telsif (grep {$_ eq $function} qw/atleast-version"
NSQ_SOURCE_LINE 00000068 "\t                                 exact-version"
NSQ_SOURCE_LINE 00000069 "\t                                 max-version/)"
NSQ_SOURCE_LINE 00000070 "\t{"
NSQ_SOURCE_LINE 00000071 "\t\t# boolean"
NSQ_SOURCE_LINE 00000072 "\t\t$ans = not system ("
NSQ_SOURCE_LINE 00000073 "\t\t\t\"pkg-config --${function}=$arg \\\"$modulename\\\"\");"
NSQ_SOURCE_LINE 00000074 "\t}"
NSQ_SOURCE_LINE 00000075 "\telse"
NSQ_SOURCE_LINE 00000076 "\t{"
NSQ_SOURCE_LINE 00000077 "\t\tcroak \"method '$function' not implemented\";"
NSQ_SOURCE_LINE 00000078 "\t\t$ans = '';"
NSQ_SOURCE_LINE 00000079 "\t}"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "\tchomp($ans);"
NSQ_SOURCE_LINE 00000082 "\t$ans = undef if $ans eq '';"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "\treturn $ans;"
NSQ_SOURCE_LINE 00000085 "}"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "sub exists {"
NSQ_SOURCE_LINE 00000088 "\tmy ($class, @pkg_candidates) = @_;"
NSQ_SOURCE_LINE 00000089 "\t"
NSQ_SOURCE_LINE 00000090 "\tforeach my $candidate (@pkg_candidates)"
NSQ_SOURCE_LINE 00000091 "\t{"
NSQ_SOURCE_LINE 00000092 "\t\tmy $output = qx/pkg-config --exists \"$candidate\" 2>&1/;"
NSQ_SOURCE_LINE 00000093 "\t\tif (0 == $CHILD_ERROR) {"
NSQ_SOURCE_LINE 00000094 "\t\t\treturn 1;"
NSQ_SOURCE_LINE 00000095 "\t\t}"
NSQ_SOURCE_LINE 00000096 "\t}"
NSQ_SOURCE_LINE 00000097 "\t"
NSQ_SOURCE_LINE 00000098 "\treturn '';"
NSQ_SOURCE_LINE 00000099 "}"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "sub find {"
NSQ_SOURCE_LINE 00000102 "\tmy ($class, @pkg_candidates) = @_;"
NSQ_SOURCE_LINE 00000103 "\tmy (@pkgs_found, @error_messages);"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "\t# try all package candidates and save all those that pkg-config"
NSQ_SOURCE_LINE 00000106 "\t# recognizes"
NSQ_SOURCE_LINE 00000107 "\tforeach my $candidate (@pkg_candidates)"
NSQ_SOURCE_LINE 00000108 "\t{"
NSQ_SOURCE_LINE 00000109 "\t\tmy $output = qx/pkg-config --exists --print-errors \"$candidate\" 2>&1/;"
NSQ_SOURCE_LINE 00000110 "\t\tif (0 == $CHILD_ERROR) {"
NSQ_SOURCE_LINE 00000111 "\t\t\tpush @pkgs_found, $candidate;"
NSQ_SOURCE_LINE 00000112 "\t\t}"
NSQ_SOURCE_LINE 00000113 "\t\telse"
NSQ_SOURCE_LINE 00000114 "\t\t{"
NSQ_SOURCE_LINE 00000115 "\t\t\tpush @error_messages, $output;"
NSQ_SOURCE_LINE 00000116 "\t\t}"
NSQ_SOURCE_LINE 00000117 "\t}"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "\tif (0 == scalar @pkgs_found)"
NSQ_SOURCE_LINE 00000120 "\t{"
NSQ_SOURCE_LINE 00000121 "\t\tforeach my $message (@error_messages) {"
NSQ_SOURCE_LINE 00000122 "\t\t\tcarp $message;"
NSQ_SOURCE_LINE 00000123 "\t\t}"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "\t\tif (@pkg_candidates > 1)"
NSQ_SOURCE_LINE 00000126 "\t\t{"
NSQ_SOURCE_LINE 00000127 "\t\t\tmy $list = join ', ', @pkg_candidates;"
NSQ_SOURCE_LINE 00000128 "\t\t\tcroak \"*** can not find package for any of ($list)\\n\""
NSQ_SOURCE_LINE 00000129 "\t\t\t    . \"*** check that one of them is properly installed and available in PKG_CONFIG_PATH\\n\";"
NSQ_SOURCE_LINE 00000130 "\t\t}"
NSQ_SOURCE_LINE 00000131 "\t\telse"
NSQ_SOURCE_LINE 00000132 "\t\t{"
NSQ_SOURCE_LINE 00000133 "\t\t\tcroak \"*** can not find package $pkg_candidates[0]\\n\""
NSQ_SOURCE_LINE 00000134 "\t\t\t    . \"*** check that it is properly installed and available in PKG_CONFIG_PATH\\n\";"
NSQ_SOURCE_LINE 00000135 "\t\t}"
NSQ_SOURCE_LINE 00000136 "\t}"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "\t# return the data of the package that was found first"
NSQ_SOURCE_LINE 00000139 "\tmy %data = ();"
NSQ_SOURCE_LINE 00000140 "\t$data{pkg} = $pkgs_found[0];"
NSQ_SOURCE_LINE 00000141 "\tforeach my $what (qw/modversion cflags libs/) {"
NSQ_SOURCE_LINE 00000142 "\t\t$data{$what} = `pkg-config --$what \\\"$data{pkg}\\\"`;"
NSQ_SOURCE_LINE 00000143 "                $data{$what} =~ s/[\\015\\012]+$//;"
NSQ_SOURCE_LINE 00000144 "\t\tcroak \"*** can't find $what for \\\"$data{pkg}\\\"\\n\""
NSQ_SOURCE_LINE 00000145 "\t\t    . \"*** is it properly installed and available in PKG_CONFIG_PATH?\\n\""
NSQ_SOURCE_LINE 00000146 "\t\t\tunless defined $data{$what};"
NSQ_SOURCE_LINE 00000147 "\t}"
NSQ_SOURCE_LINE 00000148 "\treturn %data;"
NSQ_SOURCE_LINE 00000149 "}"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "sub create_version_macros {"
NSQ_SOURCE_LINE 00000152 "\tmy ($class, $pkg, $stem) = @_;"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "\tif( $pkg && $stem ) {"
NSQ_SOURCE_LINE 00000155 "\t\tmy %data = ExtUtils::PkgConfig->find ($pkg);"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "\t\tif( %data ) {"
NSQ_SOURCE_LINE 00000158 "\t\t\tmy @modversion = split /\\./, $data{modversion};"
NSQ_SOURCE_LINE 00000159 "\t\t\t$modversion[1] = 0 unless defined $modversion[1];"
NSQ_SOURCE_LINE 00000160 "\t\t\t$modversion[2] = 0 unless defined $modversion[2];"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "\t\t\t# If a version part contains non-numeric characters,"
NSQ_SOURCE_LINE 00000163 "\t\t\t# see if it at least starts with numbers and use those."
NSQ_SOURCE_LINE 00000164 "\t\t\t# This is needed for versions like '2.0b2'."
NSQ_SOURCE_LINE 00000165 "\t\t\t# foreach ( @modversion ) {"
NSQ_SOURCE_LINE 00000166 "\t\t\t# \tif (/\\D/ && /^(\\d+)/) {"
NSQ_SOURCE_LINE 00000167 "\t\t\t# \t\t$_ = $1;"
NSQ_SOURCE_LINE 00000168 "\t\t\t# \t}"
NSQ_SOURCE_LINE 00000169 "\t\t\t# }"
NSQ_SOURCE_LINE 00000170 "\t\t\t@modversion ="
NSQ_SOURCE_LINE 00000171 "\t\t\t\tmap { /\\D/ && /^(\\d+)/ ? $1 : $_ } @modversion;"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "\t\t\treturn <<__EOD__;"
NSQ_SOURCE_LINE 00000174 "#define $stem\\_MAJOR_VERSION ($modversion[0])"
NSQ_SOURCE_LINE 00000175 "#define $stem\\_MINOR_VERSION ($modversion[1])"
NSQ_SOURCE_LINE 00000176 "#define $stem\\_MICRO_VERSION ($modversion[2])"
NSQ_SOURCE_LINE 00000177 "#define $stem\\_CHECK_VERSION(major,minor,micro) \\\\"
NSQ_SOURCE_LINE 00000178 "\t($stem\\_MAJOR_VERSION > (major) || \\\\"
NSQ_SOURCE_LINE 00000179 "\t ($stem\\_MAJOR_VERSION == (major) && $stem\\_MINOR_VERSION > (minor)) || \\\\"
NSQ_SOURCE_LINE 00000180 "\t ($stem\\_MAJOR_VERSION == (major) && $stem\\_MINOR_VERSION == (minor) && $stem\\_MICRO_VERSION >= (micro)))"
NSQ_SOURCE_LINE 00000181 "__EOD__"
NSQ_SOURCE_LINE 00000182 "\t\t}"
NSQ_SOURCE_LINE 00000183 "\t}"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "\treturn undef;"
NSQ_SOURCE_LINE 00000186 "}"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "sub write_version_macros {"
NSQ_SOURCE_LINE 00000189 "\tmy ($class, $file, @pkgs) = @_;"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "\topen FILE, \">$file\" or croak \"*** can not open file $file for writing\\n\";"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "\tfor (my $i = 0; $i < @pkgs; $i += 2) {"
NSQ_SOURCE_LINE 00000194 "\t\tmy $macros = ExtUtils::PkgConfig->create_version_macros ($pkgs[$i], $pkgs[$i+1]);"
NSQ_SOURCE_LINE 00000195 "\t\tif( defined $macros ) {"
NSQ_SOURCE_LINE 00000196 "\t\t\tprint FILE $macros;"
NSQ_SOURCE_LINE 00000197 "\t\t}"
NSQ_SOURCE_LINE 00000198 "\t}"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "\tclose FILE or croak \"*** can not close file $file\\n\";"
NSQ_SOURCE_LINE 00000201 "}"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "1;"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "=head1 NAME"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "ExtUtils::PkgConfig - simplistic interface to pkg-config"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 " use ExtUtils::PkgConfig;"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 " $package = 'gtk+-2.0';"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 " %pkg_info = ExtUtils::PkgConfig->find ($package);"
NSQ_SOURCE_LINE 00000216 " print \"modversion:  $pkg_info{modversion}\\n\";"
NSQ_SOURCE_LINE 00000217 " print \"cflags:      $pkg_info{cflags}\\n\";"
NSQ_SOURCE_LINE 00000218 " print \"libs:        $pkg_info{libs}\\n\";"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 " $exists = ExtUtils::PkgConfig->exists($package);"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 " $modversion = ExtUtils::PkgConfig->modversion($package);"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 " $libs = ExtUtils::PkgConfig->libs($package);"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 " $cflags = ExtUtils::PkgConfig->cflags($package);"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 " $cflags_only_I = ExtUtils::PkgConfig->cflags_only_I($package);"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 " $cflags_only_other = ExtUtils::PkgConfig->cflags_only_other($package);"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 " $libs_only_L = ExtUtils::PkgConfig->libs_only_L($package);"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 " $libs_only_l = ExtUtils::PkgConfig->libs_only_l($package);"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 " $libs_only_other = ExtUtils::PkgConfig->libs_only_other($package);"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 " $static_libs = ExtUtils::PkgConfig->static_libs($package);"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 " $var_value = ExtUtils::PkgConfig->variable($package, $var);"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 " if (ExtUtils::PkgConfig->atleast_version($package,$version)) {"
NSQ_SOURCE_LINE 00000243 "    ..."
NSQ_SOURCE_LINE 00000244 " }"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 " if (ExtUtils::PkgConfig->exact_version($package,$version)) {"
NSQ_SOURCE_LINE 00000247 "    ..."
NSQ_SOURCE_LINE 00000248 " }"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 " if (ExtUtils::PkgConfig->max_version($package,$version)) {"
NSQ_SOURCE_LINE 00000251 "    ..."
NSQ_SOURCE_LINE 00000252 " }"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "The pkg-config program retrieves information about installed libraries,"
NSQ_SOURCE_LINE 00000257 "usually for the purposes of compiling against and linking to them."
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "ExtUtils::PkgConfig is a very simplistic interface to this utility, intended"
NSQ_SOURCE_LINE 00000260 "for use in the Makefile.PL of perl extensions which bind libraries that"
NSQ_SOURCE_LINE 00000261 "pkg-config knows.  It is really just boilerplate code that you would've"
NSQ_SOURCE_LINE 00000262 "written yourself."
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "=head2 USAGE"
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "=over"
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "=item HASH = ExtUtils::PkgConfig->find (STRING, [STRING, ...])"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "Call pkg-config on the library specified by I<STRING> (you'll have to know what"
NSQ_SOURCE_LINE 00000271 "to use here).  The returned I<HASH> contains the modversion, cflags, and libs"
NSQ_SOURCE_LINE 00000272 "values under keys with those names. If multiple STRINGS are passed they are"
NSQ_SOURCE_LINE 00000273 "attempted in the order they are given till a working package is found."
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "If pkg-config fails to find a working I<STRING>, this function croaks with a"
NSQ_SOURCE_LINE 00000276 "message intended to be helpful to whomever is attempting to compile your"
NSQ_SOURCE_LINE 00000277 "package."
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "For example:"
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "  *** can not find package bad1"
NSQ_SOURCE_LINE 00000282 "  *** check that it is properly installed and available"
NSQ_SOURCE_LINE 00000283 "  *** in PKG_CONFIG_PATH"
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "or"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "  *** can't find cflags for gtk+-2.0"
NSQ_SOURCE_LINE 00000288 "  *** is it properly installed and available in PKG_CONFIG_PATH?"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "=item STRING = ExtUtils::PkgConfig->create_version_macros (PACKAGE, STEM)"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "Create a set of version macros with the prefix I<STEM> for the library"
NSQ_SOURCE_LINE 00000293 "specified by I<PACKAGE>.  The result is returned."
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "Example input would be \"gtk+-2.0\" for I<PACKAGE> and \"GTK\" for I<STEM>."
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "=item ExtUtils::PkgConfig->write_version_macros (FILE, PACKAGE, STEM, [PACKAGE, STEM, ...])"
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "Create one or more sets of version macros for the libraries and prefixes"
NSQ_SOURCE_LINE 00000300 "specified by the I<PACKAGE> and I<STEM> pairs and write them to the file"
NSQ_SOURCE_LINE 00000301 "I<FILE>.  If it doesn't exist, I<FILE> will be created.  If it does exist, it"
NSQ_SOURCE_LINE 00000302 "will be overwritten."
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "=back"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "ExtUtils::PkgConfig was designed to work with ExtUtils::Depends for compiling"
NSQ_SOURCE_LINE 00000309 "the various modules of the gtk2-perl project."
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "  L<ExtUtils::Depends>"
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "  L<http://gtk2-perl.sourceforge.net/>"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "This module is really just an interface to the pkg-config utility program."
NSQ_SOURCE_LINE 00000316 "http://www.freedesktop.org/Software/pkgconfig"
