BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "use strict;"
NSQ_SOURCE_LINE 00000002 "use warnings;"
NSQ_SOURCE_LINE 00000003 ""
NSQ_SOURCE_LINE 00000004 "package File::pushd;"
NSQ_SOURCE_LINE 00000005 "# ABSTRACT: change directory temporarily for a limited scope"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "our $VERSION = '1.016';"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "our @EXPORT = qw( pushd tempd );"
NSQ_SOURCE_LINE 00000010 "our @ISA    = qw( Exporter );"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "use Exporter;"
NSQ_SOURCE_LINE 00000013 "use Carp;"
NSQ_SOURCE_LINE 00000014 "use Cwd qw( getcwd abs_path );"
NSQ_SOURCE_LINE 00000015 "use File::Path qw( rmtree );"
NSQ_SOURCE_LINE 00000016 "use File::Temp qw();"
NSQ_SOURCE_LINE 00000017 "use File::Spec;"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "use overload"
NSQ_SOURCE_LINE 00000020 "  q{\"\"}    => sub { File::Spec->canonpath( $_[0]->{_pushd} ) },"
NSQ_SOURCE_LINE 00000021 "  fallback => 1;"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000024 "# pushd()"
NSQ_SOURCE_LINE 00000025 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "sub pushd {"
NSQ_SOURCE_LINE 00000028 "    # Called in void context?"
NSQ_SOURCE_LINE 00000029 "    unless (defined wantarray) {"
NSQ_SOURCE_LINE 00000030 "        warnings::warnif(void => 'Useless use of File::pushd::pushd in void context');"
NSQ_SOURCE_LINE 00000031 "        return"
NSQ_SOURCE_LINE 00000032 "    }"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "    my ( $target_dir, $options ) = @_;"
NSQ_SOURCE_LINE 00000035 "    $options->{untaint_pattern} ||= qr{^([-+@\\w./]+)$};"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "    $target_dir = \".\" unless defined $target_dir;"
NSQ_SOURCE_LINE 00000038 "    croak \"Can't locate directory $target_dir\" unless -d $target_dir;"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "    my $tainted_orig = getcwd;"
NSQ_SOURCE_LINE 00000041 "    my $orig;"
NSQ_SOURCE_LINE 00000042 "    if ( $tainted_orig =~ $options->{untaint_pattern} ) {"
NSQ_SOURCE_LINE 00000043 "        $orig = $1;"
NSQ_SOURCE_LINE 00000044 "    }"
NSQ_SOURCE_LINE 00000045 "    else {"
NSQ_SOURCE_LINE 00000046 "        $orig = $tainted_orig;"
NSQ_SOURCE_LINE 00000047 "    }"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "    my $tainted_dest;"
NSQ_SOURCE_LINE 00000050 "    eval { $tainted_dest = $target_dir ? abs_path($target_dir) : $orig };"
NSQ_SOURCE_LINE 00000051 "    croak \"Can't locate absolute path for $target_dir: $@\" if $@;"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "    my $dest;"
NSQ_SOURCE_LINE 00000054 "    if ( $tainted_dest =~ $options->{untaint_pattern} ) {"
NSQ_SOURCE_LINE 00000055 "        $dest = $1;"
NSQ_SOURCE_LINE 00000056 "    }"
NSQ_SOURCE_LINE 00000057 "    else {"
NSQ_SOURCE_LINE 00000058 "        $dest = $tainted_dest;"
NSQ_SOURCE_LINE 00000059 "    }"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "    if ( $dest ne $orig ) {"
NSQ_SOURCE_LINE 00000062 "        chdir $dest or croak \"Can't chdir to $dest\\: $!\";"
NSQ_SOURCE_LINE 00000063 "    }"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "    my $self = bless {"
NSQ_SOURCE_LINE 00000066 "        _pushd    => $dest,"
NSQ_SOURCE_LINE 00000067 "        _original => $orig"
NSQ_SOURCE_LINE 00000068 "      },"
NSQ_SOURCE_LINE 00000069 "      __PACKAGE__;"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "    return $self;"
NSQ_SOURCE_LINE 00000072 "}"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000075 "# tempd()"
NSQ_SOURCE_LINE 00000076 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "sub tempd {"
NSQ_SOURCE_LINE 00000079 "    # Called in void context?"
NSQ_SOURCE_LINE 00000080 "    unless (defined wantarray) {"
NSQ_SOURCE_LINE 00000081 "        warnings::warnif(void => 'Useless use of File::pushd::tempd in void context');"
NSQ_SOURCE_LINE 00000082 "        return"
NSQ_SOURCE_LINE 00000083 "    }"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "    my ($options) = @_;"
NSQ_SOURCE_LINE 00000086 "    my $dir;"
NSQ_SOURCE_LINE 00000087 "    eval { $dir = pushd( File::Temp::tempdir( CLEANUP => 0 ), $options ) };"
NSQ_SOURCE_LINE 00000088 "    croak $@ if $@;"
NSQ_SOURCE_LINE 00000089 "    $dir->{_tempd} = 1;"
NSQ_SOURCE_LINE 00000090 "    $dir->{_owner} = $$;"
NSQ_SOURCE_LINE 00000091 "    return $dir;"
NSQ_SOURCE_LINE 00000092 "}"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000095 "# preserve()"
NSQ_SOURCE_LINE 00000096 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "sub preserve {"
NSQ_SOURCE_LINE 00000099 "    my $self = shift;"
NSQ_SOURCE_LINE 00000100 "    return 1 if !$self->{\"_tempd\"};"
NSQ_SOURCE_LINE 00000101 "    if ( @_ == 0 ) {"
NSQ_SOURCE_LINE 00000102 "        return $self->{_preserve} = 1;"
NSQ_SOURCE_LINE 00000103 "    }"
NSQ_SOURCE_LINE 00000104 "    else {"
NSQ_SOURCE_LINE 00000105 "        return $self->{_preserve} = $_[0] ? 1 : 0;"
NSQ_SOURCE_LINE 00000106 "    }"
NSQ_SOURCE_LINE 00000107 "}"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000110 "# DESTROY()"
NSQ_SOURCE_LINE 00000111 "# Revert to original directory as object is destroyed and cleanup"
NSQ_SOURCE_LINE 00000112 "# if necessary"
NSQ_SOURCE_LINE 00000113 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "sub DESTROY {"
NSQ_SOURCE_LINE 00000116 "    my ($self) = @_;"
NSQ_SOURCE_LINE 00000117 "    my $orig = $self->{_original};"
NSQ_SOURCE_LINE 00000118 "    chdir $orig if $orig; # should always be so, but just in case..."
NSQ_SOURCE_LINE 00000119 "    if ( $self->{_tempd}"
NSQ_SOURCE_LINE 00000120 "        && $self->{_owner} == $$"
NSQ_SOURCE_LINE 00000121 "        && !$self->{_preserve} )"
NSQ_SOURCE_LINE 00000122 "    {"
NSQ_SOURCE_LINE 00000123 "        # don't destroy existing $@ if there is no error."
NSQ_SOURCE_LINE 00000124 "        my $err = do {"
NSQ_SOURCE_LINE 00000125 "            local $@;"
NSQ_SOURCE_LINE 00000126 "            eval { rmtree( $self->{_pushd} ) };"
NSQ_SOURCE_LINE 00000127 "            $@;"
NSQ_SOURCE_LINE 00000128 "        };"
NSQ_SOURCE_LINE 00000129 "        carp $err if $err;"
NSQ_SOURCE_LINE 00000130 "    }"
NSQ_SOURCE_LINE 00000131 "}"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "1;"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "=pod"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "=head1 NAME"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "File::pushd - change directory temporarily for a limited scope"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "=head1 VERSION"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "version 1.016"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 " use File::pushd;"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 " chdir $ENV{HOME};"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 " # change directory again for a limited scope"
NSQ_SOURCE_LINE 00000154 " {"
NSQ_SOURCE_LINE 00000155 "     my $dir = pushd( '/tmp' );"
NSQ_SOURCE_LINE 00000156 "     # working directory changed to /tmp"
NSQ_SOURCE_LINE 00000157 " }"
NSQ_SOURCE_LINE 00000158 " # working directory has reverted to $ENV{HOME}"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 " # tempd() is equivalent to pushd( File::Temp::tempdir )"
NSQ_SOURCE_LINE 00000161 " {"
NSQ_SOURCE_LINE 00000162 "     my $dir = tempd();"
NSQ_SOURCE_LINE 00000163 " }"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 " # object stringifies naturally as an absolute path"
NSQ_SOURCE_LINE 00000166 " {"
NSQ_SOURCE_LINE 00000167 "    my $dir = pushd( '/tmp' );"
NSQ_SOURCE_LINE 00000168 "    my $filename = File::Spec->catfile( $dir, \"somefile.txt\" );"
NSQ_SOURCE_LINE 00000169 "    # gives /tmp/somefile.txt"
NSQ_SOURCE_LINE 00000170 " }"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "File::pushd does a temporary C<chdir> that is easily and automatically"
NSQ_SOURCE_LINE 00000175 "reverted, similar to C<pushd> in some Unix command shells.  It works by"
NSQ_SOURCE_LINE 00000176 "creating an object that caches the original working directory.  When the object"
NSQ_SOURCE_LINE 00000177 "is destroyed, the destructor calls C<chdir> to revert to the original working"
NSQ_SOURCE_LINE 00000178 "directory.  By storing the object in a lexical variable with a limited scope,"
NSQ_SOURCE_LINE 00000179 "this happens automatically at the end of the scope."
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "This is very handy when working with temporary directories for tasks like"
NSQ_SOURCE_LINE 00000182 "testing; a function is provided to streamline getting a temporary"
NSQ_SOURCE_LINE 00000183 "directory from L<File::Temp>."
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "For convenience, the object stringifies as the canonical form of the absolute"
NSQ_SOURCE_LINE 00000186 "pathname of the directory entered."
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "B<Warning>: if you create multiple C<pushd> objects in the same lexical scope,"
NSQ_SOURCE_LINE 00000189 "their destruction order is not guaranteed and you might not wind up in the"
NSQ_SOURCE_LINE 00000190 "directory you expect."
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "=head1 USAGE"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 " use File::pushd;"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "Using File::pushd automatically imports the C<pushd> and C<tempd> functions."
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "=head2 pushd"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 " {"
NSQ_SOURCE_LINE 00000201 "     my $dir = pushd( $target_directory );"
NSQ_SOURCE_LINE 00000202 " }"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "Caches the current working directory, calls C<chdir> to change to the target"
NSQ_SOURCE_LINE 00000205 "directory, and returns a File::pushd object.  When the object is"
NSQ_SOURCE_LINE 00000206 "destroyed, the working directory reverts to the original directory."
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "The provided target directory can be a relative or absolute path. If"
NSQ_SOURCE_LINE 00000209 "called with no arguments, it uses the current directory as its target and"
NSQ_SOURCE_LINE 00000210 "returns to the current directory when the object is destroyed."
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "If the target directory does not exist or if the directory change fails"
NSQ_SOURCE_LINE 00000213 "for some reason, C<pushd> will die with an error message."
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "Can be given a hashref as an optional second argument.  The only supported"
NSQ_SOURCE_LINE 00000216 "option is C<untaint_pattern>, which is used to untaint file paths involved."
NSQ_SOURCE_LINE 00000217 "It defaults to {qr{^(L<-+@\\w./>+)$}}, which is reasonably restrictive (e.g."
NSQ_SOURCE_LINE 00000218 "it does not even allow spaces in the path).  Change this to suit your"
NSQ_SOURCE_LINE 00000219 "circumstances and security needs if running under taint mode. *Note*: you"
NSQ_SOURCE_LINE 00000220 "must include the parentheses in the pattern to capture the untainted"
NSQ_SOURCE_LINE 00000221 "portion of the path."
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "=head2 tempd"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 " {"
NSQ_SOURCE_LINE 00000226 "     my $dir = tempd();"
NSQ_SOURCE_LINE 00000227 " }"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "This function is like C<pushd> but automatically creates and calls C<chdir> to"
NSQ_SOURCE_LINE 00000230 "a temporary directory created by L<File::Temp>. Unlike normal L<File::Temp>"
NSQ_SOURCE_LINE 00000231 "cleanup which happens at the end of the program, this temporary directory is"
NSQ_SOURCE_LINE 00000232 "removed when the object is destroyed. (But also see C<preserve>.)  A warning"
NSQ_SOURCE_LINE 00000233 "will be issued if the directory cannot be removed."
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "As with C<pushd>, C<tempd> will die if C<chdir> fails."
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "It may be given a single options hash that will be passed internally"
NSQ_SOURCE_LINE 00000238 "to C<pushd>."
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "=head2 preserve"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 " {"
NSQ_SOURCE_LINE 00000243 "     my $dir = tempd();"
NSQ_SOURCE_LINE 00000244 "     $dir->preserve;      # mark to preserve at end of scope"
NSQ_SOURCE_LINE 00000245 "     $dir->preserve(0);   # mark to delete at end of scope"
NSQ_SOURCE_LINE 00000246 " }"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "Controls whether a temporary directory will be cleaned up when the object is"
NSQ_SOURCE_LINE 00000249 "destroyed.  With no arguments, C<preserve> sets the directory to be preserved."
NSQ_SOURCE_LINE 00000250 "With an argument, the directory will be preserved if the argument is true, or"
NSQ_SOURCE_LINE 00000251 "marked for cleanup if the argument is false.  Only C<tempd> objects may be"
NSQ_SOURCE_LINE 00000252 "marked for cleanup.  (Target directories to C<pushd> are always preserved.)"
NSQ_SOURCE_LINE 00000253 "C<preserve> returns true if the directory will be preserved, and false"
NSQ_SOURCE_LINE 00000254 "otherwise."
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "=head1 DIAGNOSTICS"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "C<pushd> and C<tempd> warn with message"
NSQ_SOURCE_LINE 00000259 "C<\"Useless use of File::pushd::I<%s> in void context\"> if called in"
NSQ_SOURCE_LINE 00000260 "void context and the warnings category C<void> is enabled."
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "  {"
NSQ_SOURCE_LINE 00000263 "    use warnings 'void';"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "    pushd();"
NSQ_SOURCE_LINE 00000266 "  }"
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000269 ""
