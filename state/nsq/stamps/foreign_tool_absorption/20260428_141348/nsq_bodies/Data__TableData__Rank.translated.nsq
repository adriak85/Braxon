NSQ_SOURCE_LINE 00000001 "package Data::TableData::Rank;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.010001;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000008 "our $DATE = '2022-03-27'; # DATE"
NSQ_SOURCE_LINE 00000009 "our $DIST = 'Data-TableData-Rank'; # DIST"
NSQ_SOURCE_LINE 00000010 "our $VERSION = '0.002'; # VERSION"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "use Exporter qw(import);"
NSQ_SOURCE_LINE 00000013 "our @EXPORT_OK = qw(add_rank_column_to_table);"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "our %SPEC;"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "$SPEC{add_rank_column_to_table} = {"
NSQ_SOURCE_LINE 00000018 "    v => 1.1,"
NSQ_SOURCE_LINE 00000019 "    summary => 'Add a rank column to a table',"
NSQ_SOURCE_LINE 00000020 "    description => <<'_',"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "Will modify the table by adding a rank column. An example, with this table:"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "    | name       | gold | silver | bronze |"
NSQ_SOURCE_LINE 00000025 "    |------------+------+--------+--------|"
NSQ_SOURCE_LINE 00000026 "    | E          |  2   |  5     |  7     |"
NSQ_SOURCE_LINE 00000027 "    | A          | 10   | 20     | 15     |"
NSQ_SOURCE_LINE 00000028 "    | H          |  0   |  0     |  1     |"
NSQ_SOURCE_LINE 00000029 "    | B          |  8   | 23     | 17     |"
NSQ_SOURCE_LINE 00000030 "    | G          |  0   |  0     |  1     |"
NSQ_SOURCE_LINE 00000031 "    | J          |  0   |  0     |  0     |"
NSQ_SOURCE_LINE 00000032 "    | C          |  4   | 10     |  8     |"
NSQ_SOURCE_LINE 00000033 "    | D          |  4   |  9     | 13     |"
NSQ_SOURCE_LINE 00000034 "    | I          |  0   |  0     |  1     |"
NSQ_SOURCE_LINE 00000035 "    | F          |  2   |  5     |  1     |"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "the result of ranking the table with data columns of C<<"
NSQ_SOURCE_LINE 00000038 "[\"gold\",\"silver\",\"bronze\"] >> will be:"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "    | name       | gold | silver | bronze | rank |"
NSQ_SOURCE_LINE 00000041 "    |------------+------+--------+--------+------|"
NSQ_SOURCE_LINE 00000042 "    | A          | 10   | 20     | 15     |  1   |"
NSQ_SOURCE_LINE 00000043 "    | B          |  8   | 23     | 17     |  2   |"
NSQ_SOURCE_LINE 00000044 "    | C          |  4   | 10     |  8     |  3   |"
NSQ_SOURCE_LINE 00000045 "    | D          |  4   |  9     | 13     |  4   |"
NSQ_SOURCE_LINE 00000046 "    | E          |  2   |  5     |  7     |  5   |"
NSQ_SOURCE_LINE 00000047 "    | F          |  2   |  5     |  1     |  6   |"
NSQ_SOURCE_LINE 00000048 "    | G          |  0   |  0     |  1     | =7   |"
NSQ_SOURCE_LINE 00000049 "    | H          |  0   |  0     |  1     | =7   |"
NSQ_SOURCE_LINE 00000050 "    | I          |  0   |  0     |  1     | =7   |"
NSQ_SOURCE_LINE 00000051 "    | J          |  0   |  0     |  0     | 10   |"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "_"
NSQ_SOURCE_LINE 00000054 "    args => {"
NSQ_SOURCE_LINE 00000055 "        table => {"
NSQ_SOURCE_LINE 00000056 "            summary => 'A table data (either aoaos, aohos, or its Data::TableData::Object wrapper)',"
NSQ_SOURCE_LINE 00000057 "            schema => 'any*',"
NSQ_SOURCE_LINE 00000058 "            req => 1,"
NSQ_SOURCE_LINE 00000059 "        },"
NSQ_SOURCE_LINE 00000060 "        data_columns => {"
NSQ_SOURCE_LINE 00000061 "            summary => 'Array of names (or indices) of columns which contain the data to be compared, which must all be numeric',"
NSQ_SOURCE_LINE 00000062 "            schema => [array => {of => 'str*', min_len=>1}],"
NSQ_SOURCE_LINE 00000063 "            req => 1,"
NSQ_SOURCE_LINE 00000064 "        },"
NSQ_SOURCE_LINE 00000065 "        smaller_wins => {"
NSQ_SOURCE_LINE 00000066 "            summary => 'Whether a smaller number in the data wins; normally a bigger name means a higher rank',"
NSQ_SOURCE_LINE 00000067 "            schema => 'bool*',"
NSQ_SOURCE_LINE 00000068 "            default => 0,"
NSQ_SOURCE_LINE 00000069 "        },"
NSQ_SOURCE_LINE 00000070 "        rank_column_name => {"
NSQ_SOURCE_LINE 00000071 "            schema => 'str*',"
NSQ_SOURCE_LINE 00000072 "            default => 'rank',"
NSQ_SOURCE_LINE 00000073 "        },"
NSQ_SOURCE_LINE 00000074 "        add_equal_prefix => {"
NSQ_SOURCE_LINE 00000075 "            schema => 'bool*',"
NSQ_SOURCE_LINE 00000076 "            default => 1,"
NSQ_SOURCE_LINE 00000077 "        },"
NSQ_SOURCE_LINE 00000078 "        rank_column_idx => {"
NSQ_SOURCE_LINE 00000079 "            schema => 'int*',"
NSQ_SOURCE_LINE 00000080 "        },"
NSQ_SOURCE_LINE 00000081 "    },"
NSQ_SOURCE_LINE 00000082 "};"
NSQ_SOURCE_LINE 00000083 "sub add_rank_column_to_table {"
NSQ_SOURCE_LINE 00000084 "    require Data::TableData::Object;"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "    my %args = @_;"
NSQ_SOURCE_LINE 00000087 "    my $data_columns = $args{data_columns};"
NSQ_SOURCE_LINE 00000088 "    my $smaller_wins = $args{smaller_wins} // 0;"
NSQ_SOURCE_LINE 00000089 "    my $add_equal_prefix = $args{add_equal_prefix} // 1;"
NSQ_SOURCE_LINE 00000090 "    my $rank_column_name = $args{rank_column_name} // 'rank';"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "    my $td = Data::TableData::Object->new($args{table});"
NSQ_SOURCE_LINE 00000093 "    my @colidxs = map { $td->col_idx($_) } @$data_columns;"
NSQ_SOURCE_LINE 00000094 "    #use DD; print \"D:colidxs \"; dd \\@colidxs;"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "    my $aoaos = $td->rows_as_aoaos;"
NSQ_SOURCE_LINE 00000097 "    my $cmp_row = sub {"
NSQ_SOURCE_LINE 00000098 "        my ($row1, $row2) = @_;"
NSQ_SOURCE_LINE 00000099 "        #use DD; print \"D:comparing: \"; dd {a=>$row1, b=>$row2};"
NSQ_SOURCE_LINE 00000100 "        my $res = 0;"
NSQ_SOURCE_LINE 00000101 "        for (@colidxs) {"
NSQ_SOURCE_LINE 00000102 "            no warnings 'uninitialized';"
NSQ_SOURCE_LINE 00000103 "            my $cmp = $row1->[$_] <=> $row2->[$_];"
NSQ_SOURCE_LINE 00000104 "            $cmp = -$cmp unless $smaller_wins;"
NSQ_SOURCE_LINE 00000105 "            if ($cmp) { $res = $cmp; last }"
NSQ_SOURCE_LINE 00000106 "        }"
NSQ_SOURCE_LINE 00000107 "        #print \"D:comparison result: $res\\n\";"
NSQ_SOURCE_LINE 00000108 "        $res;"
NSQ_SOURCE_LINE 00000109 "    };"
NSQ_SOURCE_LINE 00000110 "    my @sorted_indices = sort { $cmp_row->($aoaos->[$a], $aoaos->[$b]) } 0 .. $#{$aoaos};"
NSQ_SOURCE_LINE 00000111 "    #use DD; print \"D:sorted_indices: \"; dd \\@sorted_indices;"
NSQ_SOURCE_LINE 00000112 "    #use DD; print \"D:sorted table: \"; dd [map {$aoaos->[$_]} @sorted_indices];"
NSQ_SOURCE_LINE 00000113 "    my @sorted_aoaos   = map { $aoaos->[$_] } @sorted_indices;"
NSQ_SOURCE_LINE 00000114 "    my @ranks;"
NSQ_SOURCE_LINE 00000115 "    my %num_has_rank; # key=rank, val=num of rows"
NSQ_SOURCE_LINE 00000116 "    for my $rownum (0 .. $#sorted_aoaos) {"
NSQ_SOURCE_LINE 00000117 "        if ($rownum) {"
NSQ_SOURCE_LINE 00000118 "            if ($cmp_row->($sorted_aoaos[$rownum-1], $sorted_aoaos[$rownum])) {"
NSQ_SOURCE_LINE 00000119 "                my $rank = @ranks + 1;"
NSQ_SOURCE_LINE 00000120 "                push @ranks, $rank;"
NSQ_SOURCE_LINE 00000121 "                $num_has_rank{$rank}++;"
NSQ_SOURCE_LINE 00000122 "            } else {"
NSQ_SOURCE_LINE 00000123 "                push @ranks, $ranks[-1];"
NSQ_SOURCE_LINE 00000124 "                $num_has_rank{ $ranks[-1] }++;"
NSQ_SOURCE_LINE 00000125 "            }"
NSQ_SOURCE_LINE 00000126 "        } else {"
NSQ_SOURCE_LINE 00000127 "            push @ranks, 1;"
NSQ_SOURCE_LINE 00000128 "            $num_has_rank{1}++;"
NSQ_SOURCE_LINE 00000129 "        }"
NSQ_SOURCE_LINE 00000130 "    }"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "    if ($add_equal_prefix) {"
NSQ_SOURCE_LINE 00000133 "        for my $i (0..$#ranks) {"
NSQ_SOURCE_LINE 00000134 "            if ($num_has_rank{ $ranks[$i] } > 1) { $ranks[$i] = \"=$ranks[$i]\" }"
NSQ_SOURCE_LINE 00000135 "        }"
NSQ_SOURCE_LINE 00000136 "    }"
NSQ_SOURCE_LINE 00000137 "    #use DD; print \"D:ranks: \"; dd \\@ranks;"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "    # assign the ranks to the original, unsorted rows"
NSQ_SOURCE_LINE 00000140 "    my @ranks_orig = map { undef } @ranks;"
NSQ_SOURCE_LINE 00000141 "    for my $i (0 .. $#sorted_indices) {"
NSQ_SOURCE_LINE 00000142 "        $ranks_orig[ $sorted_indices[$i] ] = $ranks[ $i ];"
NSQ_SOURCE_LINE 00000143 "        #use DD; dd \\@ranks_orig;"
NSQ_SOURCE_LINE 00000144 "    }"
NSQ_SOURCE_LINE 00000145 "    #use DD; print \"D:ranks_orig: \"; dd \\@ranks_orig;"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "    $td->add_col($rank_column_name, $args{rank_column_idx}, {}, \\@ranks_orig);"
NSQ_SOURCE_LINE 00000148 "    $td;"
NSQ_SOURCE_LINE 00000149 "}"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "1;"
NSQ_SOURCE_LINE 00000152 "# ABSTRACT: Add a rank column to a table"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "__END__"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "=pod"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "=head1 NAME"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "Data::TableData::Rank - Add a rank column to a table"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "=head1 VERSION"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "This document describes version 0.002 of Data::TableData::Rank (from Perl distribution Data-TableData-Rank), released on 2022-03-27."
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "=head2 add_rank_column_to_table"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "Usage:"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 " add_rank_column_to_table(%args) -> [$status_code, $reason, $payload, \\%result_meta]"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "Add a rank column to a table."
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "Will modify the table by adding a rank column. An example, with this table:"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 " | name       | gold | silver | bronze |"
NSQ_SOURCE_LINE 00000182 " |------------+------+--------+--------|"
NSQ_SOURCE_LINE 00000183 " | E          |  2   |  5     |  7     |"
NSQ_SOURCE_LINE 00000184 " | A          | 10   | 20     | 15     |"
NSQ_SOURCE_LINE 00000185 " | H          |  0   |  0     |  1     |"
NSQ_SOURCE_LINE 00000186 " | B          |  8   | 23     | 17     |"
NSQ_SOURCE_LINE 00000187 " | G          |  0   |  0     |  1     |"
NSQ_SOURCE_LINE 00000188 " | J          |  0   |  0     |  0     |"
NSQ_SOURCE_LINE 00000189 " | C          |  4   | 10     |  8     |"
NSQ_SOURCE_LINE 00000190 " | D          |  4   |  9     | 13     |"
NSQ_SOURCE_LINE 00000191 " | I          |  0   |  0     |  1     |"
NSQ_SOURCE_LINE 00000192 " | F          |  2   |  5     |  1     |"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "the result of ranking the table with data columns of C<<"
NSQ_SOURCE_LINE 00000195 "[\"gold\",\"silver\",\"bronze\"] >> will be:"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 " | name       | gold | silver | bronze | rank |"
NSQ_SOURCE_LINE 00000198 " |------------+------+--------+--------+------|"
NSQ_SOURCE_LINE 00000199 " | A          | 10   | 20     | 15     |  1   |"
NSQ_SOURCE_LINE 00000200 " | B          |  8   | 23     | 17     |  2   |"
NSQ_SOURCE_LINE 00000201 " | C          |  4   | 10     |  8     |  3   |"
NSQ_SOURCE_LINE 00000202 " | D          |  4   |  9     | 13     |  4   |"
NSQ_SOURCE_LINE 00000203 " | E          |  2   |  5     |  7     |  5   |"
NSQ_SOURCE_LINE 00000204 " | F          |  2   |  5     |  1     |  6   |"
NSQ_SOURCE_LINE 00000205 " | G          |  0   |  0     |  1     | =7   |"
NSQ_SOURCE_LINE 00000206 " | H          |  0   |  0     |  1     | =7   |"
NSQ_SOURCE_LINE 00000207 " | I          |  0   |  0     |  1     | =7   |"
NSQ_SOURCE_LINE 00000208 " | J          |  0   |  0     |  0     | 10   |"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "=over 4"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "=item * B<add_equal_prefix> => I<bool> (default: 1)"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "=item * B<data_columns>* => I<array[str]>"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "Array of names (or indices) of columns which contain the data to be compared, which must all be numeric."
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "=item * B<rank_column_idx> => I<int>"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "=item * B<rank_column_name> => I<str> (default: \"rank\")"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "=item * B<smaller_wins> => I<bool> (default: 0)"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "Whether a smaller number in the data wins; normally a bigger name means a higher rank."
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "=item * B<table>* => I<any>"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "A table data (either aoaos, aohos, or its Data::TableData::Object wrapper)."
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "=back"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "Returns an enveloped result (an array)."
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "First element ($status_code) is an integer containing HTTP-like status code"
NSQ_SOURCE_LINE 00000240 "(200 means OK, 4xx caller error, 5xx function error). Second element"
NSQ_SOURCE_LINE 00000241 "($reason) is a string containing error message, or something like \"OK\" if status is"
NSQ_SOURCE_LINE 00000242 "200. Third element ($payload) is the actual result, but usually not present when enveloped result is an error response ($status_code is not 2xx). Fourth"
NSQ_SOURCE_LINE 00000243 "element (%result_meta) is called result metadata and is optional, a hash"
NSQ_SOURCE_LINE 00000244 "that contains extra information, much like how HTTP response headers provide additional metadata."
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "Return value:  (any)"
NSQ_SOURCE_LINE 00000247 ""
