BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Data::Sah::Resolve;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000004 "our $DATE = '2021-07-29'; # DATE"
NSQ_SOURCE_LINE 00000005 "our $DIST = 'Data-Sah-Resolve'; # DIST"
NSQ_SOURCE_LINE 00000006 "our $VERSION = '0.011'; # VERSION"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use 5.010001;"
NSQ_SOURCE_LINE 00000009 "use strict;"
NSQ_SOURCE_LINE 00000010 "use warnings;"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "use Exporter qw(import);"
NSQ_SOURCE_LINE 00000013 "our @EXPORT_OK = qw(resolve_schema);"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "sub _clset_has_merge {"
NSQ_SOURCE_LINE 00000016 "    my $clset = shift;"
NSQ_SOURCE_LINE 00000017 "    for (keys %$clset) {"
NSQ_SOURCE_LINE 00000018 "        return 1 if /\\Amerge\\./;"
NSQ_SOURCE_LINE 00000019 "    }"
NSQ_SOURCE_LINE 00000020 "    0;"
NSQ_SOURCE_LINE 00000021 "}"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "sub _resolve {"
NSQ_SOURCE_LINE 00000024 "    my ($opts, $res) = @_;"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "    my $type = $res->{type};"
NSQ_SOURCE_LINE 00000027 "    die \"Cannot resolve Sah schema: circular schema definition: \"."
NSQ_SOURCE_LINE 00000028 "        join(\" -> \", @{$res->{resolve_path}}, $type)"
NSQ_SOURCE_LINE 00000029 "        if grep { $type eq $_ } @{$res->{resolve_path}};"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "    unshift @{$res->{resolve_path}}, $type;"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "    # check whether $type is a built-in Sah type"
NSQ_SOURCE_LINE 00000034 "    (my $typemod_pm = \"Data/Sah/Type/$type.pm\") =~ s!::!/!g;"
NSQ_SOURCE_LINE 00000035 "    eval { require $typemod_pm; 1 };"
NSQ_SOURCE_LINE 00000036 "    my $err = $@;"
NSQ_SOURCE_LINE 00000037 "    unless ($err) {"
NSQ_SOURCE_LINE 00000038 "        # already a builtin-type, so we stop here"
NSQ_SOURCE_LINE 00000039 "        return;"
NSQ_SOURCE_LINE 00000040 "    }"
NSQ_SOURCE_LINE 00000041 "    die \"Cannot resolve Sah schema: can't check whether $type is a builtin Sah type: $err\""
NSQ_SOURCE_LINE 00000042 "        unless $err =~ /\\ACan't locate/;"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "    # not a type, try a schema under Sah::Schema"
NSQ_SOURCE_LINE 00000045 "    my $schmod = \"Sah::Schema::$type\";"
NSQ_SOURCE_LINE 00000046 "    (my $schmod_pm = \"$schmod.pm\") =~ s!::!/!g;"
NSQ_SOURCE_LINE 00000047 "    eval { require $schmod_pm; 1 };"
NSQ_SOURCE_LINE 00000048 "    die \"Cannot resolve Sah schema: not a known built-in Sah type '$type' (can't locate \"."
NSQ_SOURCE_LINE 00000049 "        \"Data::Sah::Type::$type) and not a known schema name '$type' ($@)\""
NSQ_SOURCE_LINE 00000050 "            if $@;"
NSQ_SOURCE_LINE 00000051 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000052 "    my $sch2 = ${\"$schmod\\::schema\"};"
NSQ_SOURCE_LINE 00000053 "    die \"Cannot resolve Sah schema: BUG: Schema module $schmod doesn't contain \\$schema\""
NSQ_SOURCE_LINE 00000054 "        unless $sch2;"
NSQ_SOURCE_LINE 00000055 "    $res->{type} = $sch2->[0];"
NSQ_SOURCE_LINE 00000056 "    unshift @{ $res->{clsets_after_type} }, $sch2->[1];"
NSQ_SOURCE_LINE 00000057 "    _resolve($opts, $res);"
NSQ_SOURCE_LINE 00000058 "}"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "sub resolve_schema {"
NSQ_SOURCE_LINE 00000061 "    my $opts = ref($_[0]) eq 'HASH' ? shift : {};"
NSQ_SOURCE_LINE 00000062 "    my $sch = shift;"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "    # normalize"
NSQ_SOURCE_LINE 00000065 "    unless ($opts->{schema_is_normalized}) {"
NSQ_SOURCE_LINE 00000066 "        require Data::Sah::Normalize;"
NSQ_SOURCE_LINE 00000067 "        $sch =  Data::Sah::Normalize::normalize_schema($sch);"
NSQ_SOURCE_LINE 00000068 "    }"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "    my $res = {"
NSQ_SOURCE_LINE 00000071 "        v => 2,"
NSQ_SOURCE_LINE 00000072 "        type => $sch->[0],"
NSQ_SOURCE_LINE 00000073 "        clsets_after_type => [$sch->[1]],"
NSQ_SOURCE_LINE 00000074 "        resolve_path => [],"
NSQ_SOURCE_LINE 00000075 "    };"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "    # resolve"
NSQ_SOURCE_LINE 00000078 "    _resolve($opts, $res);"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "    # determine the \"base restrictions\" base"
NSQ_SOURCE_LINE 00000081 "    my @clsets_have_merge;"
NSQ_SOURCE_LINE 00000082 "    my $has_merge_prefixes; # whether any of the clsets have merge prefixes"
NSQ_SOURCE_LINE 00000083 "    for (@{ $res->{clsets_after_type} }) {"
NSQ_SOURCE_LINE 00000084 "        push @clsets_have_merge, _clset_has_merge($_);"
NSQ_SOURCE_LINE 00000085 "        $has_merge_prefixes++ if $clsets_have_merge[-1];"
NSQ_SOURCE_LINE 00000086 "    }"
NSQ_SOURCE_LINE 00000087 "    # TODO: sanity check: the innermost base schema should not have merge prefixes"
NSQ_SOURCE_LINE 00000088 "    my $idx = $#clsets_have_merge;"
NSQ_SOURCE_LINE 00000089 "    while ($idx >= 0) {"
NSQ_SOURCE_LINE 00000090 "        if ($opts->{allow_base_with_no_additional_clauses}) {"
NSQ_SOURCE_LINE 00000091 "            last if !$clsets_have_merge[$idx];"
NSQ_SOURCE_LINE 00000092 "        } else {"
NSQ_SOURCE_LINE 00000093 "            last if keys(%{$res->{clsets_after_type}[$idx]}) > 0 && !$clsets_have_merge[$idx];"
NSQ_SOURCE_LINE 00000094 "        }"
NSQ_SOURCE_LINE 00000095 "        $idx--;"
NSQ_SOURCE_LINE 00000096 "    }"
NSQ_SOURCE_LINE 00000097 "    #use DD; dd $res->{clsets_after_type}; dd \\@clsets_have_merge;"
NSQ_SOURCE_LINE 00000098 "    $res->{base} = $res->{resolve_path}[$idx];"
NSQ_SOURCE_LINE 00000099 "    $res->{clsets_after_base} = [grep {keys(%$_) > 0} @{ $res->{clsets_after_type} }[$idx .. $#clsets_have_merge]];"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "    # merge"
NSQ_SOURCE_LINE 00000102 "    my @merged_clsets;"
NSQ_SOURCE_LINE 00000103 "  MERGE: {"
NSQ_SOURCE_LINE 00000104 "        unless ($has_merge_prefixes) {"
NSQ_SOURCE_LINE 00000105 "            @merged_clsets = grep { keys(%$_)>0 } @{ $res->{clsets_after_type} };"
NSQ_SOURCE_LINE 00000106 "            last;"
NSQ_SOURCE_LINE 00000107 "        }"
NSQ_SOURCE_LINE 00000108 "        @merged_clsets = ($res->{clsets_after_type}[0]);"
NSQ_SOURCE_LINE 00000109 "        for my $i (1 .. $#clsets_have_merge) {"
NSQ_SOURCE_LINE 00000110 "            my $clset = $res->{clsets_after_type}[$i];"
NSQ_SOURCE_LINE 00000111 "            next unless keys(%$clset) > 0;"
NSQ_SOURCE_LINE 00000112 "            if ($clsets_have_merge[$i]) {"
NSQ_SOURCE_LINE 00000113 "                state $merger = do {"
NSQ_SOURCE_LINE 00000114 "                    require Data::ModeMerge;"
NSQ_SOURCE_LINE 00000115 "                    my $mm = Data::ModeMerge->new(config => {"
NSQ_SOURCE_LINE 00000116 "                        recurse_array => 1,"
NSQ_SOURCE_LINE 00000117 "                    });"
NSQ_SOURCE_LINE 00000118 "                    $mm->modes->{NORMAL}  ->prefix   ('merge.normal.');"
NSQ_SOURCE_LINE 00000119 "                    $mm->modes->{NORMAL}  ->prefix_re(qr/\\Amerge\\.normal\\./);"
NSQ_SOURCE_LINE 00000120 "                    $mm->modes->{ADD}     ->prefix   ('merge.add.');"
NSQ_SOURCE_LINE 00000121 "                    $mm->modes->{ADD}     ->prefix_re(qr/\\Amerge\\.add\\./);"
NSQ_SOURCE_LINE 00000122 "                    $mm->modes->{CONCAT}  ->prefix   ('merge.concat.');"
NSQ_SOURCE_LINE 00000123 "                    $mm->modes->{CONCAT}  ->prefix_re(qr/\\Amerge\\.concat\\./);"
NSQ_SOURCE_LINE 00000124 "                    $mm->modes->{SUBTRACT}->prefix   ('merge.subtract.');"
NSQ_SOURCE_LINE 00000125 "                    $mm->modes->{SUBTRACT}->prefix_re(qr/\\Amerge\\.subtract\\./);"
NSQ_SOURCE_LINE 00000126 "                    $mm->modes->{DELETE}  ->prefix   ('merge.delete.');"
NSQ_SOURCE_LINE 00000127 "                    $mm->modes->{DELETE}  ->prefix_re(qr/\\Amerge\\.delete\\./);"
NSQ_SOURCE_LINE 00000128 "                    $mm->modes->{KEEP}    ->prefix   ('merge.keep.');"
NSQ_SOURCE_LINE 00000129 "                    $mm->modes->{KEEP}    ->prefix_re(qr/\\Amerge\\.keep\\./);"
NSQ_SOURCE_LINE 00000130 "                    $mm;"
NSQ_SOURCE_LINE 00000131 "                };"
NSQ_SOURCE_LINE 00000132 "                my $merge_res = $merger->merge($merged_clsets[-1], $clset);"
NSQ_SOURCE_LINE 00000133 "                unless ($merge_res->{success}) {"
NSQ_SOURCE_LINE 00000134 "                    die \"Can't resolve schema: Can't merge clause set: $merge_res->{error}\";"
NSQ_SOURCE_LINE 00000135 "                }"
NSQ_SOURCE_LINE 00000136 "                $merged_clsets[-1] = $merge_res->{result};"
NSQ_SOURCE_LINE 00000137 "            } else {"
NSQ_SOURCE_LINE 00000138 "                push @merged_clsets, $clset;"
NSQ_SOURCE_LINE 00000139 "            }"
NSQ_SOURCE_LINE 00000140 "        } # for clause set"
NSQ_SOURCE_LINE 00000141 "    } # MERGE"
NSQ_SOURCE_LINE 00000142 "    pop @merged_clsets if @merged_clsets && keys(%{$merged_clsets[-1]}) == 0;"
NSQ_SOURCE_LINE 00000143 "    $res->{'clsets_after_type.alt.merge.merged'} = \\@merged_clsets;"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "    $res;"
NSQ_SOURCE_LINE 00000146 "}"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "1;"
NSQ_SOURCE_LINE 00000149 "# ABSTRACT: Resolve Sah schema"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "__END__"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "=pod"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "=head1 NAME"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "Data::Sah::Resolve - Resolve Sah schema"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "=head1 VERSION"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "This document describes version 0.011 of Data::Sah::Resolve (from Perl distribution Data-Sah-Resolve), released on 2021-07-29."
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 " use Data::Sah::Resolve qw(resolve_schema);"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 " my $sch = resolve_schema(\"int\");"
NSQ_SOURCE_LINE 00000170 " # => {"
NSQ_SOURCE_LINE 00000171 " #      v => 2,"
NSQ_SOURCE_LINE 00000172 " #      type=>\"int\","
NSQ_SOURCE_LINE 00000173 " #      clsets_after_type => [],"
NSQ_SOURCE_LINE 00000174 " #      \"clsets_after_type.alt.merge.merged\" => [],"
NSQ_SOURCE_LINE 00000175 " #      base=>\"int\","
NSQ_SOURCE_LINE 00000176 " #      clsets_after_base => [],"
NSQ_SOURCE_LINE 00000177 " #      resolve_path => [\"int\"],"
NSQ_SOURCE_LINE 00000178 " #    }"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 " my $sch = resolve_schema(\"posint*\");"
NSQ_SOURCE_LINE 00000181 " # => {"
NSQ_SOURCE_LINE 00000182 " #      v => 2,"
NSQ_SOURCE_LINE 00000183 " #      type=>\"int\","
NSQ_SOURCE_LINE 00000184 " #      clsets_after_type => [{min=>1}, {req=>1}],"
NSQ_SOURCE_LINE 00000185 " #      \"clsets_after_type.alt.merge.merged\" => [{min=>1}, {req=>1}],"
NSQ_SOURCE_LINE 00000186 " #      base => \"posint\","
NSQ_SOURCE_LINE 00000187 " #      clsets_after_base => [{req=>1}],"
NSQ_SOURCE_LINE 00000188 " #      resolve_path => [\"int\",\"posint\"],"
NSQ_SOURCE_LINE 00000189 " #    }"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 " my $sch = resolve_schema([posint => div_by => 3]);"
NSQ_SOURCE_LINE 00000192 " # => {"
NSQ_SOURCE_LINE 00000193 " #      v => 2,"
NSQ_SOURCE_LINE 00000194 " #      type=>\"int\","
NSQ_SOURCE_LINE 00000195 " #      clsets_after_type => [{min=>1}, {div_by=>3}],"
NSQ_SOURCE_LINE 00000196 " #      \"clsets_after_type.alt.merge.merged\" => [{min=>1}, {div_by=>3}],"
NSQ_SOURCE_LINE 00000197 " #      base => \"posint\","
NSQ_SOURCE_LINE 00000198 " #      clsets_after_base => [{div_by=>3}],"
NSQ_SOURCE_LINE 00000199 " #      resolve_path => [\"int\",\"posint\"],"
NSQ_SOURCE_LINE 00000200 " #    }"
NSQ_SOURCE_LINE 00000201 " # => [\"int\", {min=>1}, {div_by=>3}]"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 " my $sch = resolve_schema([\"posint\", \"merge.delete.min\"=>undef, div_by => 3]);"
NSQ_SOURCE_LINE 00000204 " # basically becomes: [\"int\", div_by=>3]"
NSQ_SOURCE_LINE 00000205 " # => {"
NSQ_SOURCE_LINE 00000206 " #      v => 2,"
NSQ_SOURCE_LINE 00000207 " #      type=>\"int\","
NSQ_SOURCE_LINE 00000208 " #      clsets_after_type => [{min=>1}, {\"merge.delete.min\"=>undef, div_by=>3}],"
NSQ_SOURCE_LINE 00000209 " #      \"clsets_after_type.alt.merge.merged\" => [{div_by=>3}],"
NSQ_SOURCE_LINE 00000210 " #      base => undef,"
NSQ_SOURCE_LINE 00000211 " #      clsets_after_base => [{div_by=>3}],"
NSQ_SOURCE_LINE 00000212 " #      resolve_path => [\"int\",\"posint\"],"
NSQ_SOURCE_LINE 00000213 " #    }"
NSQ_SOURCE_LINE 00000214 " # => [\"int\", {min=>1}, {div_by=>3}]"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "This module provides L</resolve_schema>."
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "=head2 resolve_schema"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "Usage:"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 " my $res = resolve_schema([ \\%opts, ] $sch); # => hash"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "Sah schemas can be defined in terms of other schemas as base. The resolving"
NSQ_SOURCE_LINE 00000229 "process follows the (outermost) base schema until it finds a builtin type as the"
NSQ_SOURCE_LINE 00000230 "(innermost) base. It then returns a hash result (a L<DefHash> with C<v>=2)"
NSQ_SOURCE_LINE 00000231 "containing the type as well other information like the collected clause sets and"
NSQ_SOURCE_LINE 00000232 "others."
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "This routine performs the following steps:"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "=over"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "=item 1. Normalize the schema"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "Unless C<schema_is_normalized> option is true, in which case schema is assumed"
NSQ_SOURCE_LINE 00000241 "to be normalized already."
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "=item 2. Check if the schema's type is a builtin type"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "Currently this is done by checking if the module of the name C<<"
NSQ_SOURCE_LINE 00000246 "Data::Sah::Type::<type> >> is loadable. If it is a builtin type then we are"
NSQ_SOURCE_LINE 00000247 "done."
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "=item 3. Check if the schema's type is the name of another schema"
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "This is done by checking if C<< Sah::Schema::<name> >> module exists and is"
NSQ_SOURCE_LINE 00000252 "loadable. If this is the case then we retrieve the base schema from the"
NSQ_SOURCE_LINE 00000253 "C<$schema> variable in the C<< Sah::Schema::<name> >> package and repeat the"
NSQ_SOURCE_LINE 00000254 "process while accumulating and/or merging the clause sets."
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "=item 4. If schema's type is neither, we die."
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "=back"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "Will also die on circularity or when there is other failures like failing to get"
NSQ_SOURCE_LINE 00000261 "schema from the schema module."
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "Example 1: C<int>."
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "First we normalize to C<< [\"int\",{}] >>. The type is C<int> and it is a builtin"
NSQ_SOURCE_LINE 00000266 "type (L<Data::Sah::Type::int> exists). The final result is:"
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 " {"
NSQ_SOURCE_LINE 00000269 "   v => 2,"
NSQ_SOURCE_LINE 00000270 "   type=>\"int\","
NSQ_SOURCE_LINE 00000271 "   clsets_after_type => [],"
NSQ_SOURCE_LINE 00000272 "   \"clsets_after_type.alt.merge.unmerged\" => [],"
NSQ_SOURCE_LINE 00000273 "   base=>undef,"
NSQ_SOURCE_LINE 00000274 "   clsets_after_base => [],"
NSQ_SOURCE_LINE 00000275 "   resolve_path => [\"int\"],"
NSQ_SOURCE_LINE 00000276 " }"
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "Example 2: C<posint*>."
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "First we normalize to C<< [\"posint\",{req=>1}] >>. The type part of this schema"
NSQ_SOURCE_LINE 00000281 "is C<posint> and it is actually the name of another schema because"
NSQ_SOURCE_LINE 00000282 "C<Data::Sah::Type::posint> is not found and we find schema module"
NSQ_SOURCE_LINE 00000283 "L<Sah::Schema::posint>) instead. We then retrieve the C<posint> schema from the"
NSQ_SOURCE_LINE 00000284 "schema module's C<$schema> and we get C<< [\"int\", {min=>1}] >> (additional"
NSQ_SOURCE_LINE 00000285 "informative clauses omitted for brevity). We now try to resolve C<int> and find"
NSQ_SOURCE_LINE 00000286 "that it's a builtin type. So the final result is:"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 " {"
NSQ_SOURCE_LINE 00000289 "   v => 2,"
NSQ_SOURCE_LINE 00000290 "   type=>\"int\","
NSQ_SOURCE_LINE 00000291 "   clsets_after_type => [{min=>1}, {req=>1}],"
NSQ_SOURCE_LINE 00000292 "   \"clsets_after_type.alt.merge.unmerged\" => [{min=>1}, {req=>1}],"
NSQ_SOURCE_LINE 00000293 "   base => \"posint\","
NSQ_SOURCE_LINE 00000294 "   clsets_after_base => [{req=>1}],"
NSQ_SOURCE_LINE 00000295 "   resolve_path => [\"int\",\"posint\"],"
NSQ_SOURCE_LINE 00000296 " }"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "Known options:"
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "=over"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "=item * schema_is_normalized"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "Bool, default false. When set to true, function will skip normalizing schema and"
NSQ_SOURCE_LINE 00000305 "assume input schema is normalized."
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "=item * allow_base_with_no_additional_clauses"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "Bool, default false. Normally, a schema like C<< \"posint\" >> or C<<"
NSQ_SOURCE_LINE 00000310 "[\"posint\",{}] >> will result in C<\"int\"> as the base (because the schema does"
NSQ_SOURCE_LINE 00000311 "not add any additional clauses to the \"posint\" schema) while C<<"
NSQ_SOURCE_LINE 00000312 "[\"posint\",{div_by=>2}] >> will result in C<\"posint\"> as the base. But if this"
NSQ_SOURCE_LINE 00000313 "setting is set to true, then all the previous examples will result in"
NSQ_SOURCE_LINE 00000314 "C<\"posint\"> as the base."
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "=back"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "As mentioned, result is a hash conforming to the L<DefHash> restriction. The"
NSQ_SOURCE_LINE 00000319 "following keys will be returned:"
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "=over"
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "=item * v"
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "Integer, has the value of 2. A non-compatible change of result will bump this"
NSQ_SOURCE_LINE 00000326 "version number."
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "=item * type"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "Str, the Sah builtin type name."
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "=item * clsets_after_type"
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "All the collected clause sets, from the deepest base schema to the outermost,"
NSQ_SOURCE_LINE 00000335 "and to the clause set of the original unresolved schema."
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "=item * clsets_after_type.alt.merge.merged"
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "Like L</clsets_after_type>, but the clause sets are merged according to the"
NSQ_SOURCE_LINE 00000340 "L<Sah> merging specification."
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "=item * base"
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "Str. Might be undef. The outermost base schema (or type) that can be used as"
NSQ_SOURCE_LINE 00000345 "\"base restriction\", meaning its restrictions (clause sets) must all be"
NSQ_SOURCE_LINE 00000346 "fulfilled. After this base's clause sets, the next additional clause sets will"
NSQ_SOURCE_LINE 00000347 "not contain any merge prefixes. Because if additional clause sets contained"
NSQ_SOURCE_LINE 00000348 "merge prefixes, they could modify or remove restrictions set by the base instead"
NSQ_SOURCE_LINE 00000349 "of just adding more restrictions (which is the whole point of merging)."
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "=item * clsets_after_base"
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "Clause sets after the \"base restriction\" base. This is additional restrictions"
NSQ_SOURCE_LINE 00000354 "that are imposed to the restrictions of the base schema. They do not contain"
NSQ_SOURCE_LINE 00000355 "merge prefixes."
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "=item * resolve_path"
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "Array. This is a list of schema type names or builtin type names, from the"
NSQ_SOURCE_LINE 00000360 "deepest to the shallowest. The first element of this arrayref is the builtin Sah"
NSQ_SOURCE_LINE 00000361 "type and the last element is the original unresolved schema's type."
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "=back"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "=head1 HOMEPAGE"
