BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Progress::Any;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.010001;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "use Time::Duration qw();"
NSQ_SOURCE_LINE 00000008 "use Time::HiRes qw(time);"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000011 "our $DATE = '2022-10-18'; # DATE"
NSQ_SOURCE_LINE 00000012 "our $DIST = 'Progress-Any'; # DIST"
NSQ_SOURCE_LINE 00000013 "our $VERSION = '0.220'; # VERSION"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "sub import {"
NSQ_SOURCE_LINE 00000016 "    my ($self, @args) = @_;"
NSQ_SOURCE_LINE 00000017 "    my $caller = caller();"
NSQ_SOURCE_LINE 00000018 "    for (@args) {"
NSQ_SOURCE_LINE 00000019 "        if ($_ eq '$progress') {"
NSQ_SOURCE_LINE 00000020 "            my $progress = $self->get_indicator(task => '');"
NSQ_SOURCE_LINE 00000021 "            {"
NSQ_SOURCE_LINE 00000022 "                no strict 'refs'; ## no critic: TestingAndDebugging::ProhibitNoStrict"
NSQ_SOURCE_LINE 00000023 "                my $v = \"$caller\\::progress\";"
NSQ_SOURCE_LINE 00000024 "                *$v = \\$progress;"
NSQ_SOURCE_LINE 00000025 "            }"
NSQ_SOURCE_LINE 00000026 "        } else {"
NSQ_SOURCE_LINE 00000027 "            die \"Unknown import argument: $_\";"
NSQ_SOURCE_LINE 00000028 "        }"
NSQ_SOURCE_LINE 00000029 "    }"
NSQ_SOURCE_LINE 00000030 "}"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "# store Progress::Any objects for each task"
NSQ_SOURCE_LINE 00000033 "our %indicators;  # key = task name"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "# store output objects"
NSQ_SOURCE_LINE 00000036 "our %outputs;     # key = task name, value = [$outputobj, ...]"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "# internal attributes:"
NSQ_SOURCE_LINE 00000039 "# - _elapsed (float*) = accumulated elapsed time so far"
NSQ_SOURCE_LINE 00000040 "# - _start_time (float) = when is the last time the indicator state is changed"
NSQ_SOURCE_LINE 00000041 "#     from 'stopped' to 'started'. when indicator is changed from 'started' to"
NSQ_SOURCE_LINE 00000042 "#     'stopped', this will be set to undef."
NSQ_SOURCE_LINE 00000043 "# - _remaining = used to store user's estimation of remaining time. will be"
NSQ_SOURCE_LINE 00000044 "#     unset after each update()."
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "# return 1 if created, 0 if already created/initialized"
NSQ_SOURCE_LINE 00000047 "sub _init_indicator {"
NSQ_SOURCE_LINE 00000048 "    my ($class, $task, $default_target) = @_;"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "    #say \"D: _init_indicator($task)\";"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "    # prevent double initialization"
NSQ_SOURCE_LINE 00000053 "    return $indicators{$task} if $indicators{$task};"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "    my $progress = bless({"
NSQ_SOURCE_LINE 00000056 "        task        => $task,"
NSQ_SOURCE_LINE 00000057 "        title       => $task,"
NSQ_SOURCE_LINE 00000058 "        target      => $default_target,"
NSQ_SOURCE_LINE 00000059 "        pos         => 0,"
NSQ_SOURCE_LINE 00000060 "        state       => 'stopped',"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "        _remaining          => undef,"
NSQ_SOURCE_LINE 00000063 "        _set_remaining_time => undef,"
NSQ_SOURCE_LINE 00000064 "        _elapsed            => 0,"
NSQ_SOURCE_LINE 00000065 "        _start_time         => 0,"
NSQ_SOURCE_LINE 00000066 "    }, $class);"
NSQ_SOURCE_LINE 00000067 "    $indicators{$task} = $progress;"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "    # if we create an indicator named a.b.c, we must also create a.b, a, and ''."
NSQ_SOURCE_LINE 00000070 "    if ($task =~ s/\\.?\\w+\\z//) {"
NSQ_SOURCE_LINE 00000071 "        $class->_init_indicator($task, 0);"
NSQ_SOURCE_LINE 00000072 "    }"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "    $progress;"
NSQ_SOURCE_LINE 00000075 "}"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "sub get_indicator {"
NSQ_SOURCE_LINE 00000078 "    my ($class, %args) = @_;"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "    my %oargs = %args;"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "    my $task   = delete($args{task});"
NSQ_SOURCE_LINE 00000083 "    if (!defined($task)) {"
NSQ_SOURCE_LINE 00000084 "        my @caller = caller(0);"
NSQ_SOURCE_LINE 00000085 "        #say \"D:caller=\".join(\",\",map{$_//\"\"} @caller);"
NSQ_SOURCE_LINE 00000086 "        $task = $caller[0] eq '(eval)' ? 'main' : $caller[0];"
NSQ_SOURCE_LINE 00000087 "        $task =~ s/::/./g;"
NSQ_SOURCE_LINE 00000088 "        $task =~ s/[^.\\w]+/_/g;"
NSQ_SOURCE_LINE 00000089 "    }"
NSQ_SOURCE_LINE 00000090 "    die \"Invalid task syntax '$task', please only use dotted words\""
NSQ_SOURCE_LINE 00000091 "        unless $task =~ /\\A(?:\\w+(\\.\\w+)*)?\\z/;"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "    my %uargs;"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "    my $p = $class->_init_indicator($task);"
NSQ_SOURCE_LINE 00000096 "    for my $an (qw/title target pos remaining state/) {"
NSQ_SOURCE_LINE 00000097 "        if (exists $args{$an}) {"
NSQ_SOURCE_LINE 00000098 "            $uargs{$an} = delete($args{$an});"
NSQ_SOURCE_LINE 00000099 "        }"
NSQ_SOURCE_LINE 00000100 "    }"
NSQ_SOURCE_LINE 00000101 "    die \"Unknown argument(s) to get_indicator(): \".join(\", \", keys(%args))"
NSQ_SOURCE_LINE 00000102 "        if keys(%args);"
NSQ_SOURCE_LINE 00000103 "    $p->_update(%uargs) if keys %uargs;"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "    $p;"
NSQ_SOURCE_LINE 00000106 "}"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "my %attrs = ("
NSQ_SOURCE_LINE 00000109 "    title     => {is => 'rw'},"
NSQ_SOURCE_LINE 00000110 "    target    => {is => 'rw'},"
NSQ_SOURCE_LINE 00000111 "    pos       => {is => 'rw'},"
NSQ_SOURCE_LINE 00000112 "    state     => {is => 'rw'},"
NSQ_SOURCE_LINE 00000113 ");"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "# create attribute methods"
NSQ_SOURCE_LINE 00000116 "for my $an (keys %attrs) {"
NSQ_SOURCE_LINE 00000117 "    next if $attrs{$an}{manual};"
NSQ_SOURCE_LINE 00000118 "    my $code;"
NSQ_SOURCE_LINE 00000119 "    if ($attrs{$an}{is} eq 'rw') {"
NSQ_SOURCE_LINE 00000120 "        $code = sub {"
NSQ_SOURCE_LINE 00000121 "            my $self = shift;"
NSQ_SOURCE_LINE 00000122 "            if (@_) {"
NSQ_SOURCE_LINE 00000123 "                $self->_update($an => shift);"
NSQ_SOURCE_LINE 00000124 "            }"
NSQ_SOURCE_LINE 00000125 "            $self->{$an};"
NSQ_SOURCE_LINE 00000126 "        };"
NSQ_SOURCE_LINE 00000127 "    } else {"
NSQ_SOURCE_LINE 00000128 "        $code = sub {"
NSQ_SOURCE_LINE 00000129 "            my $self = shift;"
NSQ_SOURCE_LINE 00000130 "            die \"Can't set value, $an is an ro attribute\" if @_;"
NSQ_SOURCE_LINE 00000131 "            $self->{$an};"
NSQ_SOURCE_LINE 00000132 "        };"
NSQ_SOURCE_LINE 00000133 "    }"
NSQ_SOURCE_LINE 00000134 "    no strict 'refs'; ## no critic: TestingAndDebugging::ProhibitNoStrict"
NSQ_SOURCE_LINE 00000135 "    *{$an} = $code;"
NSQ_SOURCE_LINE 00000136 "}"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "sub elapsed {"
NSQ_SOURCE_LINE 00000139 "    my $self = shift;"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "    if ($self->{state} eq 'started') {"
NSQ_SOURCE_LINE 00000142 "        return $self->{_elapsed} + (time()-$self->{_start_time});"
NSQ_SOURCE_LINE 00000143 "    } else {"
NSQ_SOURCE_LINE 00000144 "        return $self->{_elapsed};"
NSQ_SOURCE_LINE 00000145 "    }"
NSQ_SOURCE_LINE 00000146 "}"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "sub total_pos {"
NSQ_SOURCE_LINE 00000149 "    my $self = shift;"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "    my $t = $self->{task};"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "    my $res = $self->{pos};"
NSQ_SOURCE_LINE 00000154 "    for (keys %indicators) {"
NSQ_SOURCE_LINE 00000155 "        if ($t eq '') {"
NSQ_SOURCE_LINE 00000156 "            next if $_ eq '';"
NSQ_SOURCE_LINE 00000157 "        } else {"
NSQ_SOURCE_LINE 00000158 "            next unless index($_, \"$t.\") == 0;"
NSQ_SOURCE_LINE 00000159 "        }"
NSQ_SOURCE_LINE 00000160 "        $res += $indicators{$_}{pos};"
NSQ_SOURCE_LINE 00000161 "    }"
NSQ_SOURCE_LINE 00000162 "    $res;"
NSQ_SOURCE_LINE 00000163 "}"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "sub total_target {"
NSQ_SOURCE_LINE 00000166 "    my $self = shift;"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "    my $t = $self->{task};"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "    my $res = $self->{target};"
NSQ_SOURCE_LINE 00000171 "    return unless defined($res);"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "    for (keys %indicators) {"
NSQ_SOURCE_LINE 00000174 "        if ($t eq '') {"
NSQ_SOURCE_LINE 00000175 "            next if $_ eq '';"
NSQ_SOURCE_LINE 00000176 "        } else {"
NSQ_SOURCE_LINE 00000177 "            next unless index($_, \"$t.\") == 0;"
NSQ_SOURCE_LINE 00000178 "        }"
NSQ_SOURCE_LINE 00000179 "        return unless defined $indicators{$_}{target};"
NSQ_SOURCE_LINE 00000180 "        $res += $indicators{$_}{target};"
NSQ_SOURCE_LINE 00000181 "    }"
NSQ_SOURCE_LINE 00000182 "    $res;"
NSQ_SOURCE_LINE 00000183 "}"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "sub percent_complete {"
NSQ_SOURCE_LINE 00000186 "    my $self = shift;"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "    my $total_pos    = $self->total_pos;"
NSQ_SOURCE_LINE 00000189 "    my $total_target = $self->total_target;"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "    return unless defined($total_target);"
NSQ_SOURCE_LINE 00000192 "    if ($total_target == 0) {"
NSQ_SOURCE_LINE 00000193 "        if ($self->{state} eq 'finished') {"
NSQ_SOURCE_LINE 00000194 "            return 100;"
NSQ_SOURCE_LINE 00000195 "        } else {"
NSQ_SOURCE_LINE 00000196 "            return 0;"
NSQ_SOURCE_LINE 00000197 "        }"
NSQ_SOURCE_LINE 00000198 "    } else {"
NSQ_SOURCE_LINE 00000199 "        return $total_pos / $total_target * 100;"
NSQ_SOURCE_LINE 00000200 "    }"
NSQ_SOURCE_LINE 00000201 "}"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "sub remaining {"
NSQ_SOURCE_LINE 00000204 "    my $self = shift;"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "    if (defined $self->{_remaining}) {"
NSQ_SOURCE_LINE 00000207 "        if ($self->{state} eq 'started') {"
NSQ_SOURCE_LINE 00000208 "            my $r = $self->{_remaining}-(time()-$self->{_set_remaining_time});"
NSQ_SOURCE_LINE 00000209 "            return $r > 0 ? $r : 0;"
NSQ_SOURCE_LINE 00000210 "        } else {"
NSQ_SOURCE_LINE 00000211 "            return $self->{_remaining};"
NSQ_SOURCE_LINE 00000212 "        }"
NSQ_SOURCE_LINE 00000213 "    } else {"
NSQ_SOURCE_LINE 00000214 "        if (defined $self->{target}) {"
NSQ_SOURCE_LINE 00000215 "            if ($self->{pos} == 0) {"
NSQ_SOURCE_LINE 00000216 "                return 0;"
NSQ_SOURCE_LINE 00000217 "            } else {"
NSQ_SOURCE_LINE 00000218 "                return ($self->{target} - $self->{pos})/$self->{pos} *"
NSQ_SOURCE_LINE 00000219 "                    $self->elapsed;"
NSQ_SOURCE_LINE 00000220 "            }"
NSQ_SOURCE_LINE 00000221 "        } else {"
NSQ_SOURCE_LINE 00000222 "            return;"
NSQ_SOURCE_LINE 00000223 "        }"
NSQ_SOURCE_LINE 00000224 "    }"
NSQ_SOURCE_LINE 00000225 "}"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "sub total_remaining {"
NSQ_SOURCE_LINE 00000228 "    my $self = shift;"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "    my $t = $self->{task};"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "    my $res = $self->remaining;"
NSQ_SOURCE_LINE 00000233 "    return unless defined $res;"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "    for (keys %indicators) {"
NSQ_SOURCE_LINE 00000236 "        if ($t eq '') {"
NSQ_SOURCE_LINE 00000237 "            next if $_ eq '';"
NSQ_SOURCE_LINE 00000238 "        } else {"
NSQ_SOURCE_LINE 00000239 "            next unless index($_, \"$t.\") == 0;"
NSQ_SOURCE_LINE 00000240 "        }"
NSQ_SOURCE_LINE 00000241 "        my $res2 = $indicators{$_}->remaining;"
NSQ_SOURCE_LINE 00000242 "        return unless defined $res2;"
NSQ_SOURCE_LINE 00000243 "        $res += $res2;"
NSQ_SOURCE_LINE 00000244 "    }"
NSQ_SOURCE_LINE 00000245 "    $res;"
NSQ_SOURCE_LINE 00000246 "}"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "# the routine to use to update rw attributes, does validation and checks to make"
NSQ_SOURCE_LINE 00000249 "# sure things are consistent."
NSQ_SOURCE_LINE 00000250 "sub _update {"
NSQ_SOURCE_LINE 00000251 "    my ($self, %args) = @_;"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "    # no need to check for unknown arg in %args, it's an internal method anyway"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "    my $now = time();"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "    my $task = $self->{task};"
NSQ_SOURCE_LINE 00000258 "    #use Data::Dump; print \"D: _update($task) \"; dd \\%args;"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "  SET_TITLE:"
NSQ_SOURCE_LINE 00000261 "    {"
NSQ_SOURCE_LINE 00000262 "        last unless exists $args{title};"
NSQ_SOURCE_LINE 00000263 "        my $val = $args{title};"
NSQ_SOURCE_LINE 00000264 "        die \"Invalid value for title, must be defined\""
NSQ_SOURCE_LINE 00000265 "            unless defined($val);"
NSQ_SOURCE_LINE 00000266 "        $self->{title} = $val;"
NSQ_SOURCE_LINE 00000267 "    }"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "  SET_TARGET:"
NSQ_SOURCE_LINE 00000270 "    {"
NSQ_SOURCE_LINE 00000271 "        last unless exists $args{target};"
NSQ_SOURCE_LINE 00000272 "        my $val = $args{target};"
NSQ_SOURCE_LINE 00000273 "        die \"Invalid value for target, must be a positive number or undef\""
NSQ_SOURCE_LINE 00000274 "            unless !defined($val) || $val >= 0;"
NSQ_SOURCE_LINE 00000275 "        # ensure that pos does not exceed target"
NSQ_SOURCE_LINE 00000276 "        if (defined($val) && $self->{pos} > $val) {"
NSQ_SOURCE_LINE 00000277 "            $self->{pos} = $val;"
NSQ_SOURCE_LINE 00000278 "        }"
NSQ_SOURCE_LINE 00000279 "        $self->{target} = $val;"
NSQ_SOURCE_LINE 00000280 "        undef $self->{_remaining};"
NSQ_SOURCE_LINE 00000281 "    }"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "  SET_POS:"
NSQ_SOURCE_LINE 00000284 "    {"
NSQ_SOURCE_LINE 00000285 "        last unless exists $args{pos};"
NSQ_SOURCE_LINE 00000286 "        my $val = $args{pos};"
NSQ_SOURCE_LINE 00000287 "        die \"Invalid value for pos, must be a positive number\""
NSQ_SOURCE_LINE 00000288 "            unless defined($val) && $val >= 0;"
NSQ_SOURCE_LINE 00000289 "        # ensure that pos does not exceed target"
NSQ_SOURCE_LINE 00000290 "        if (defined($self->{target}) && $val > $self->{target}) {"
NSQ_SOURCE_LINE 00000291 "            $val = $self->{target};"
NSQ_SOURCE_LINE 00000292 "        }"
NSQ_SOURCE_LINE 00000293 "        $self->{pos} = $val;"
NSQ_SOURCE_LINE 00000294 "        undef $self->{_remaining};"
NSQ_SOURCE_LINE 00000295 "    }"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "  SET_REMAINING:"
NSQ_SOURCE_LINE 00000298 "    {"
NSQ_SOURCE_LINE 00000299 "        last unless exists $args{remaining};"
NSQ_SOURCE_LINE 00000300 "        my $val = $args{remaining};"
NSQ_SOURCE_LINE 00000301 "        die \"Invalid value for remaining, must be a positive number\""
NSQ_SOURCE_LINE 00000302 "            unless defined($val) && $val >= 0;"
NSQ_SOURCE_LINE 00000303 "        $self->{_remaining} = $val;"
NSQ_SOURCE_LINE 00000304 "        $self->{_set_remaining_time} = $now;"
NSQ_SOURCE_LINE 00000305 "    }"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "  SET_STATE:"
NSQ_SOURCE_LINE 00000308 "    {"
NSQ_SOURCE_LINE 00000309 "        last unless exists $args{state};"
NSQ_SOURCE_LINE 00000310 "        my $old = $self->{state};"
NSQ_SOURCE_LINE 00000311 "        my $val = $args{state} // 'started';"
NSQ_SOURCE_LINE 00000312 "        die \"Invalid value for state, must be stopped/started/finished\""
NSQ_SOURCE_LINE 00000313 "            unless $val =~ /\\A(?:stopped|started|finished)\\z/;"
NSQ_SOURCE_LINE 00000314 "        last if $old eq $val;"
NSQ_SOURCE_LINE 00000315 "        if ($val eq 'started') {"
NSQ_SOURCE_LINE 00000316 "            $self->{_start_time} = $now;"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "            # automatically start parents"
NSQ_SOURCE_LINE 00000319 "            my @parents;"
NSQ_SOURCE_LINE 00000320 "            {"
NSQ_SOURCE_LINE 00000321 "                my $t = $task;"
NSQ_SOURCE_LINE 00000322 "                while (1) {"
NSQ_SOURCE_LINE 00000323 "                    last unless $t =~ s/\\.\\w+\\z//;"
NSQ_SOURCE_LINE 00000324 "                    push @parents, $t;"
NSQ_SOURCE_LINE 00000325 "                }"
NSQ_SOURCE_LINE 00000326 "                push @parents, '';"
NSQ_SOURCE_LINE 00000327 "            }"
NSQ_SOURCE_LINE 00000328 "            for my $t (@parents) {"
NSQ_SOURCE_LINE 00000329 "                my $p = $indicators{$t};"
NSQ_SOURCE_LINE 00000330 "                if ($p->{state} ne 'started') {"
NSQ_SOURCE_LINE 00000331 "                    $p->{state}       = 'started';"
NSQ_SOURCE_LINE 00000332 "                    $p->{_start_time} = $now;"
NSQ_SOURCE_LINE 00000333 "                }"
NSQ_SOURCE_LINE 00000334 "            }"
NSQ_SOURCE_LINE 00000335 "        } else {"
NSQ_SOURCE_LINE 00000336 "            $self->{_elapsed} += $now - $self->{_start_time};"
NSQ_SOURCE_LINE 00000337 "            if ($val eq 'finished') {"
NSQ_SOURCE_LINE 00000338 "                die \"BUG: Can't finish task '$task', pos is still < target\""
NSQ_SOURCE_LINE 00000339 "                    if defined($self->{target}) &&"
NSQ_SOURCE_LINE 00000340 "                        $self->{pos} < $self->{target};"
NSQ_SOURCE_LINE 00000341 "                $self->{_remaining} = 0;"
NSQ_SOURCE_LINE 00000342 "                $self->{_set_remaining_time} = $now;"
NSQ_SOURCE_LINE 00000343 "            }"
NSQ_SOURCE_LINE 00000344 "        }"
NSQ_SOURCE_LINE 00000345 "        $self->{state} = $val;"
NSQ_SOURCE_LINE 00000346 "    }"
NSQ_SOURCE_LINE 00000347 ""
NSQ_SOURCE_LINE 00000348 "  DONE:"
NSQ_SOURCE_LINE 00000349 "    #use Data::Dump; print \"after update: \"; dd $self;"
NSQ_SOURCE_LINE 00000350 "    return;"
NSQ_SOURCE_LINE 00000351 "}"
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "sub _should_update_output {"
NSQ_SOURCE_LINE 00000354 "    my ($self, $output, $now, $priority) = @_;"
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "    my $key = \"$output\";"
NSQ_SOURCE_LINE 00000357 "    if (!defined($output->{_mtime})) {"
NSQ_SOURCE_LINE 00000358 "        # output has never been updated, update"
NSQ_SOURCE_LINE 00000359 "        return 1;"
NSQ_SOURCE_LINE 00000360 "    } elsif ($self->{state} eq 'finished') {"
NSQ_SOURCE_LINE 00000361 "        # finishing, update the output to show finished state"
NSQ_SOURCE_LINE 00000362 "        return 1;"
NSQ_SOURCE_LINE 00000363 "    } elsif ($output->{force_update}) {"
NSQ_SOURCE_LINE 00000364 "        # this is an undocumented force update for now, the output itself or"
NSQ_SOURCE_LINE 00000365 "        # something else can set this to force an update. but this will only be"
NSQ_SOURCE_LINE 00000366 "        # done once because we delete the key; if another update wants to be"
NSQ_SOURCE_LINE 00000367 "        # forced, they need to set this again."
NSQ_SOURCE_LINE 00000368 "        delete $output->{force_update};"
NSQ_SOURCE_LINE 00000369 "        return 1;"
NSQ_SOURCE_LINE 00000370 "    } elsif ($priority eq 'high') {"
NSQ_SOURCE_LINE 00000371 "        # high priority, send to output module"
NSQ_SOURCE_LINE 00000372 "        return 1;"
NSQ_SOURCE_LINE 00000373 "    } else {"
NSQ_SOURCE_LINE 00000374 "        # normal-/low-priority update, update if not too frequent"
NSQ_SOURCE_LINE 00000375 "        if (!defined($output->{freq})) {"
NSQ_SOURCE_LINE 00000376 "            # negative number means seconds, positive means pos delta. only"
NSQ_SOURCE_LINE 00000377 "            # update if that number of seconds, or that difference in pos has"
NSQ_SOURCE_LINE 00000378 "            # been passed."
NSQ_SOURCE_LINE 00000379 "            $output->{freq} = -0.5;"
NSQ_SOURCE_LINE 00000380 "        }"
NSQ_SOURCE_LINE 00000381 "        if ($output->{freq} == 0) {"
NSQ_SOURCE_LINE 00000382 "            return 1;"
NSQ_SOURCE_LINE 00000383 "        } if ($output->{freq} < 0) {"
NSQ_SOURCE_LINE 00000384 "            return 1 if $now >= $output->{_mtime} - $output->{freq};"
NSQ_SOURCE_LINE 00000385 "        } else {"
NSQ_SOURCE_LINE 00000386 "            return 1 if abs($self->{pos} - $output->{_pos}) >= $output->{freq};"
NSQ_SOURCE_LINE 00000387 "        }"
NSQ_SOURCE_LINE 00000388 "        return 0;"
NSQ_SOURCE_LINE 00000389 "    }"
NSQ_SOURCE_LINE 00000390 "}"
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "sub update {"
NSQ_SOURCE_LINE 00000393 "    my ($self, %args) = @_;"
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "    my $pos   = delete($args{pos}) // $self->{pos} + 1;"
NSQ_SOURCE_LINE 00000396 "    my $state = delete($args{state}) // 'started';"
NSQ_SOURCE_LINE 00000397 "    $self->_update(pos => $pos, state => $state);"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "    my $message  = delete($args{message});"
NSQ_SOURCE_LINE 00000400 "    my $priority = delete($args{priority}) // 'normal';"
NSQ_SOURCE_LINE 00000401 "    my $force_update = delete($args{force_update});"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "    my %other_args_for_output;"
NSQ_SOURCE_LINE 00000404 "    for (keys %args) {"
NSQ_SOURCE_LINE 00000405 "        if (/\\Amessage\\.alt\\./) {"
NSQ_SOURCE_LINE 00000406 "            $other_args_for_output{$_} = delete $args{$_};"
NSQ_SOURCE_LINE 00000407 "        }"
NSQ_SOURCE_LINE 00000408 "    }"
NSQ_SOURCE_LINE 00000409 ""
NSQ_SOURCE_LINE 00000410 "    die \"Unknown argument(s) to update(): \".join(\", \", keys(%args))"
NSQ_SOURCE_LINE 00000411 "        if keys(%args);"
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "    my $now = time();"
NSQ_SOURCE_LINE 00000414 ""
NSQ_SOURCE_LINE 00000415 "    # find output(s) and call it"
NSQ_SOURCE_LINE 00000416 "    {"
NSQ_SOURCE_LINE 00000417 "        last unless $ENV{PROGRESS} // 1;"
NSQ_SOURCE_LINE 00000418 "        my $task = $self->{task};"
NSQ_SOURCE_LINE 00000419 "        while (1) {"
NSQ_SOURCE_LINE 00000420 "            if ($outputs{$task}) {"
NSQ_SOURCE_LINE 00000421 "                for my $output (@{ $outputs{$task} }) {"
NSQ_SOURCE_LINE 00000422 "                    next unless $force_update ||"
NSQ_SOURCE_LINE 00000423 "                        $self->_should_update_output($output, $now, $priority);"
NSQ_SOURCE_LINE 00000424 "                    if (ref($message) eq 'CODE') {"
NSQ_SOURCE_LINE 00000425 "                        $message = $message->();"
NSQ_SOURCE_LINE 00000426 "                    }"
NSQ_SOURCE_LINE 00000427 "                    $output->update("
NSQ_SOURCE_LINE 00000428 "                        indicator => $indicators{$task},"
NSQ_SOURCE_LINE 00000429 "                        message   => $message,"
NSQ_SOURCE_LINE 00000430 "                        priority  => $priority,"
NSQ_SOURCE_LINE 00000431 "                        time      => $now,"
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "                        # temporary, internal API. to let an output module know"
NSQ_SOURCE_LINE 00000434 "                        # the same update() when there are multiple instances of"
NSQ_SOURCE_LINE 00000435 "                        # it"
NSQ_SOURCE_LINE 00000436 "                        _update_id => $now,"
NSQ_SOURCE_LINE 00000437 "                        %other_args_for_output,"
NSQ_SOURCE_LINE 00000438 "                    );"
NSQ_SOURCE_LINE 00000439 "                    $output->{_mtime} = $now;"
NSQ_SOURCE_LINE 00000440 "                    $output->{_pos}   = $pos;"
NSQ_SOURCE_LINE 00000441 "                }"
NSQ_SOURCE_LINE 00000442 "            }"
NSQ_SOURCE_LINE 00000443 "            last unless $task =~ s/\\.?\\w+\\z//;"
NSQ_SOURCE_LINE 00000444 "        }"
NSQ_SOURCE_LINE 00000445 "    }"
NSQ_SOURCE_LINE 00000446 "}"
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 "sub start {"
NSQ_SOURCE_LINE 00000449 "    my $self = shift;"
NSQ_SOURCE_LINE 00000450 "    $self->_update(state => 'started');"
NSQ_SOURCE_LINE 00000451 "}"
NSQ_SOURCE_LINE 00000452 ""
NSQ_SOURCE_LINE 00000453 "sub stop {"
NSQ_SOURCE_LINE 00000454 "    my $self = shift;"
NSQ_SOURCE_LINE 00000455 "    $self->_update(state => 'stopped');"
NSQ_SOURCE_LINE 00000456 "}"
NSQ_SOURCE_LINE 00000457 ""
NSQ_SOURCE_LINE 00000458 "sub finish {"
NSQ_SOURCE_LINE 00000459 "    my ($self, %args) = @_;"
NSQ_SOURCE_LINE 00000460 "    $self->update(pos=>$self->{target}, state=>'finished', %args);"
NSQ_SOURCE_LINE 00000461 "}"
NSQ_SOURCE_LINE 00000462 ""
NSQ_SOURCE_LINE 00000463 "sub reset {"
NSQ_SOURCE_LINE 00000464 "    my ($self, %args) = @_;"
NSQ_SOURCE_LINE 00000465 "    $self->update(pos=>0, state=>'started', %args);"
NSQ_SOURCE_LINE 00000466 "}"
NSQ_SOURCE_LINE 00000467 ""
NSQ_SOURCE_LINE 00000468 "our $template_regex = qr{( # all=1"
NSQ_SOURCE_LINE 00000469 "                             %"
NSQ_SOURCE_LINE 00000470 "                             ( #width=2"
NSQ_SOURCE_LINE 00000471 "                                 -?\\d+ )?"
NSQ_SOURCE_LINE 00000472 "                             ( #dot=3"
NSQ_SOURCE_LINE 00000473 "                                 \\.?)"
NSQ_SOURCE_LINE 00000474 "                             ( #prec=4"
NSQ_SOURCE_LINE 00000475 "                                 \\d+)?"
NSQ_SOURCE_LINE 00000476 "                             ( #conv=5"
NSQ_SOURCE_LINE 00000477 "                                 [A-Za-z%])"
NSQ_SOURCE_LINE 00000478 "                         )}x;"
NSQ_SOURCE_LINE 00000479 ""
NSQ_SOURCE_LINE 00000480 "sub fill_template {"
NSQ_SOURCE_LINE 00000481 "    my ($self, $template0, %args) = @_;"
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 "    # TODO: some caching so \"%e%e\" produces two identical numbers"
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "    my ($template, $opts);"
NSQ_SOURCE_LINE 00000486 "    if (ref $template0 eq 'HASH') {"
NSQ_SOURCE_LINE 00000487 "        $opts = $template0;"
NSQ_SOURCE_LINE 00000488 "        $template = $opts->{template};"
NSQ_SOURCE_LINE 00000489 "    } else {"
NSQ_SOURCE_LINE 00000490 "        $template = $template0;"
NSQ_SOURCE_LINE 00000491 "        $opts = {};"
NSQ_SOURCE_LINE 00000492 "    }"
NSQ_SOURCE_LINE 00000493 ""
NSQ_SOURCE_LINE 00000494 "    state $sub = sub {"
NSQ_SOURCE_LINE 00000495 "        my %args = @_;"
NSQ_SOURCE_LINE 00000496 ""
NSQ_SOURCE_LINE 00000497 "        my ($all, $width, $dot, $prec, $conv) = ($1, $2, $3, $4, $5);"
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "        my $p = $args{indicator};"
NSQ_SOURCE_LINE 00000500 ""
NSQ_SOURCE_LINE 00000501 "        my ($fmt, $sconv, $data);"
NSQ_SOURCE_LINE 00000502 "        if ($conv eq 'n') {"
NSQ_SOURCE_LINE 00000503 "            $data = $p->{task};"
NSQ_SOURCE_LINE 00000504 "        } elsif ($conv eq 't') {"
NSQ_SOURCE_LINE 00000505 "            $data = $p->{title};"
NSQ_SOURCE_LINE 00000506 "        } elsif ($conv eq '%') {"
NSQ_SOURCE_LINE 00000507 "            $data = '%';"
NSQ_SOURCE_LINE 00000508 "        } elsif ($conv eq 'm') {"
NSQ_SOURCE_LINE 00000509 "            $data = $args{message} // '';"
NSQ_SOURCE_LINE 00000510 "        } elsif ($conv eq 'p') {"
NSQ_SOURCE_LINE 00000511 "            my $val = $p->percent_complete;"
NSQ_SOURCE_LINE 00000512 "            $width //= 3;"
NSQ_SOURCE_LINE 00000513 "            if (defined $val) {"
NSQ_SOURCE_LINE 00000514 "                $data = $val;"
NSQ_SOURCE_LINE 00000515 "                $prec //= 0;"
NSQ_SOURCE_LINE 00000516 "                $sconv = \"f\";"
NSQ_SOURCE_LINE 00000517 "            } else {"
NSQ_SOURCE_LINE 00000518 "                $data = '?';"
NSQ_SOURCE_LINE 00000519 "            }"
NSQ_SOURCE_LINE 00000520 "        } elsif ($conv eq 'P') {"
NSQ_SOURCE_LINE 00000521 "            $data = $p->total_pos;"
NSQ_SOURCE_LINE 00000522 "            $prec //= 0;"
NSQ_SOURCE_LINE 00000523 "            $sconv = \"f\";"
NSQ_SOURCE_LINE 00000524 "        } elsif ($conv eq 'T') {"
NSQ_SOURCE_LINE 00000525 "            my $val = $p->total_target;"
NSQ_SOURCE_LINE 00000526 "            if (defined $val) {"
NSQ_SOURCE_LINE 00000527 "                $data = $val;"
NSQ_SOURCE_LINE 00000528 "                $prec //= 0;"
NSQ_SOURCE_LINE 00000529 "                $sconv = \"f\";"
NSQ_SOURCE_LINE 00000530 "            } else {"
NSQ_SOURCE_LINE 00000531 "                $data = '?';"
NSQ_SOURCE_LINE 00000532 "            }"
NSQ_SOURCE_LINE 00000533 "        } elsif ($conv eq 'e') {"
NSQ_SOURCE_LINE 00000534 "            my $val = $p->elapsed;"
NSQ_SOURCE_LINE 00000535 "            $val = 1 if $val < 1; # TMP, prevent duration() return \"just now\""
NSQ_SOURCE_LINE 00000536 "            $data = Time::Duration::concise(Time::Duration::duration($val));"
NSQ_SOURCE_LINE 00000537 "            $width //= -8;"
NSQ_SOURCE_LINE 00000538 "        } elsif ($conv eq 'r') {"
NSQ_SOURCE_LINE 00000539 "            my $val = $p->total_remaining;"
NSQ_SOURCE_LINE 00000540 "            if (defined $val) {"
NSQ_SOURCE_LINE 00000541 "                $val = 1 if $val < 1; # TMP, prevent duration() return \"just now"
NSQ_SOURCE_LINE 00000542 "                $data = Time::Duration::concise(Time::Duration::duration($val));"
NSQ_SOURCE_LINE 00000543 "            } else {"
NSQ_SOURCE_LINE 00000544 "                $data = '?';"
NSQ_SOURCE_LINE 00000545 "            }"
NSQ_SOURCE_LINE 00000546 "            $width //= -8;"
NSQ_SOURCE_LINE 00000547 "        } elsif ($conv eq 'R') {"
NSQ_SOURCE_LINE 00000548 "            my $val = $p->total_remaining;"
NSQ_SOURCE_LINE 00000549 "            if (defined $val) {"
NSQ_SOURCE_LINE 00000550 "                $val = 1 if $val < 1; # TMP, prevent duration() return \"just now"
NSQ_SOURCE_LINE 00000551 "                $data = Time::Duration::concise(Time::Duration::duration($val))."
NSQ_SOURCE_LINE 00000552 "                    \" left\"; # XXX i18n"
NSQ_SOURCE_LINE 00000553 "            } else {"
NSQ_SOURCE_LINE 00000554 "                $val = $p->elapsed;"
NSQ_SOURCE_LINE 00000555 "                $val = 1 if $val < 1; # TMP, prevent duration() return \"just now"
NSQ_SOURCE_LINE 00000556 "                $data = Time::Duration::concise(Time::Duration::duration($val))."
NSQ_SOURCE_LINE 00000557 "                    \" elapsed\"; # XXX i18n"
NSQ_SOURCE_LINE 00000558 "            }"
NSQ_SOURCE_LINE 00000559 "            $width //= -(8 + 1 + 7);"
NSQ_SOURCE_LINE 00000560 "        } else {"
NSQ_SOURCE_LINE 00000561 "            if ($opts->{handle_unknown_conversion}) {"
NSQ_SOURCE_LINE 00000562 "                my @res = $opts->{handle_unknown_conversion}->("
NSQ_SOURCE_LINE 00000563 "                    indicator => $p,"
NSQ_SOURCE_LINE 00000564 "                    args  => \\%args,"
NSQ_SOURCE_LINE 00000565 ""
NSQ_SOURCE_LINE 00000566 "                    all   => $all,"
NSQ_SOURCE_LINE 00000567 "                    width => $width,"
NSQ_SOURCE_LINE 00000568 "                    dot   => $dot,"
NSQ_SOURCE_LINE 00000569 "                    conv  => $conv,"
NSQ_SOURCE_LINE 00000570 "                    prec  => $prec,"
NSQ_SOURCE_LINE 00000571 "                );"
NSQ_SOURCE_LINE 00000572 "                if (@res) {"
NSQ_SOURCE_LINE 00000573 "                    ($fmt, $data) = @res;"
NSQ_SOURCE_LINE 00000574 "                } else {"
NSQ_SOURCE_LINE 00000575 "                # return as-is"
NSQ_SOURCE_LINE 00000576 "                    $fmt = '%s';"
NSQ_SOURCE_LINE 00000577 "                    $data = $all;"
NSQ_SOURCE_LINE 00000578 "                }"
NSQ_SOURCE_LINE 00000579 "            } else {"
NSQ_SOURCE_LINE 00000580 "                # return as-is"
NSQ_SOURCE_LINE 00000581 "                $fmt = '%s';"
NSQ_SOURCE_LINE 00000582 "                $data = $all;"
NSQ_SOURCE_LINE 00000583 "            }"
NSQ_SOURCE_LINE 00000584 "        }"
NSQ_SOURCE_LINE 00000585 ""
NSQ_SOURCE_LINE 00000586 "        # sprintf format"
NSQ_SOURCE_LINE 00000587 "        $sconv //= 's';"
NSQ_SOURCE_LINE 00000588 "        $dot = \".\" if $sconv eq 'f';"
NSQ_SOURCE_LINE 00000589 "        $fmt //= join(\"\", grep {defined} (\"%\", $width, $dot, $prec, $sconv));"
NSQ_SOURCE_LINE 00000590 ""
NSQ_SOURCE_LINE 00000591 "        #say \"D:fmt=$fmt\";"
NSQ_SOURCE_LINE 00000592 "        sprintf $fmt, $data;"
NSQ_SOURCE_LINE 00000593 "    };"
NSQ_SOURCE_LINE 00000594 "    $template =~ s{$template_regex}{$sub->(%args, indicator=>$self)}egox;"
NSQ_SOURCE_LINE 00000595 ""
NSQ_SOURCE_LINE 00000596 "    $template;"
NSQ_SOURCE_LINE 00000597 "}"
NSQ_SOURCE_LINE 00000598 ""
NSQ_SOURCE_LINE 00000599 "1;"
NSQ_SOURCE_LINE 00000600 "# ABSTRACT: Record progress to any output"
NSQ_SOURCE_LINE 00000601 ""
NSQ_SOURCE_LINE 00000602 "__END__"
NSQ_SOURCE_LINE 00000603 ""
NSQ_SOURCE_LINE 00000604 "=pod"
NSQ_SOURCE_LINE 00000605 ""
NSQ_SOURCE_LINE 00000606 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000607 ""
NSQ_SOURCE_LINE 00000608 "=head1 NAME"
NSQ_SOURCE_LINE 00000609 ""
NSQ_SOURCE_LINE 00000610 "Progress::Any - Record progress to any output"
NSQ_SOURCE_LINE 00000611 ""
NSQ_SOURCE_LINE 00000612 "=head1 VERSION"
NSQ_SOURCE_LINE 00000613 ""
NSQ_SOURCE_LINE 00000614 "This document describes version 0.220 of Progress::Any (from Perl distribution Progress-Any), released on 2022-10-18."
NSQ_SOURCE_LINE 00000615 ""
NSQ_SOURCE_LINE 00000616 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000617 ""
NSQ_SOURCE_LINE 00000618 "Example of using in a script with terminal progress bar as output (progress bar"
NSQ_SOURCE_LINE 00000619 "will be cleared on C<finish()>) (you'll need to install"
NSQ_SOURCE_LINE 00000620 "L<Progress::Any::Output::TermProgressBarColor> as well):"
NSQ_SOURCE_LINE 00000621 ""
NSQ_SOURCE_LINE 00000622 " use Progress::Any '$progress';"
NSQ_SOURCE_LINE 00000623 " use Progress::Any::Output 'TermProgressBarColor';"
NSQ_SOURCE_LINE 00000624 ""
NSQ_SOURCE_LINE 00000625 " $progress->target(10);"
NSQ_SOURCE_LINE 00000626 " for (1..10) {"
NSQ_SOURCE_LINE 00000627 "     $progress->update(message => \"Doing item $_\");"
NSQ_SOURCE_LINE 00000628 "     sleep 1;"
NSQ_SOURCE_LINE 00000629 " }"
NSQ_SOURCE_LINE 00000630 " $progress->finish();"
NSQ_SOURCE_LINE 00000631 ""
NSQ_SOURCE_LINE 00000632 "Sample output:"
NSQ_SOURCE_LINE 00000633 ""
NSQ_SOURCE_LINE 00000634 " % ./script.pl"
NSQ_SOURCE_LINE 00000635 "  60% [Doing item 6====           ]3s left"
NSQ_SOURCE_LINE 00000636 ""
NSQ_SOURCE_LINE 00000637 "Another example, this time with terminal message as output:"
NSQ_SOURCE_LINE 00000638 ""
NSQ_SOURCE_LINE 00000639 " use Progress::Any '$progress';"
NSQ_SOURCE_LINE 00000640 " use Progress::Any::Output 'TermMessage', template => '[%n] %P/%T (%6.2p%%) %m';"
NSQ_SOURCE_LINE 00000641 ""
NSQ_SOURCE_LINE 00000642 " $progress->target(10);"
NSQ_SOURCE_LINE 00000643 " for (1..10) {"
NSQ_SOURCE_LINE 00000644 "     $progress->update(message => \"Item $_/10\");"
NSQ_SOURCE_LINE 00000645 "     sleep 1;"
NSQ_SOURCE_LINE 00000646 " }"
NSQ_SOURCE_LINE 00000647 " sleep 1;"
NSQ_SOURCE_LINE 00000648 " $progress->finish(message => \"Finished!\");"
NSQ_SOURCE_LINE 00000649 ""
NSQ_SOURCE_LINE 00000650 "Sample output:"
NSQ_SOURCE_LINE 00000651 ""
NSQ_SOURCE_LINE 00000652 " % ./script.pl"
NSQ_SOURCE_LINE 00000653 " [] 1/10 ( 10.00%) Item 1/10"
NSQ_SOURCE_LINE 00000654 " [] 2/10 ( 20.00%) Item 2/10"
NSQ_SOURCE_LINE 00000655 " ..."
NSQ_SOURCE_LINE 00000656 " [] 10/10 (100.00%) Item 10/10"
NSQ_SOURCE_LINE 00000657 " [] 10/10 (100.00%) Finished!"
NSQ_SOURCE_LINE 00000658 ""
NSQ_SOURCE_LINE 00000659 "Example of using in a module as well as script:"
NSQ_SOURCE_LINE 00000660 ""
NSQ_SOURCE_LINE 00000661 " # in lib/MyApp.pm"
NSQ_SOURCE_LINE 00000662 " package MyApp;"
NSQ_SOURCE_LINE 00000663 " use Progress::Any;"
NSQ_SOURCE_LINE 00000664 ""
NSQ_SOURCE_LINE 00000665 " sub download {"
NSQ_SOURCE_LINE 00000666 "     my @urls = @_;"
NSQ_SOURCE_LINE 00000667 "     return unless @urls;"
NSQ_SOURCE_LINE 00000668 "     my $progress = Progress::Any->get_indicator("
NSQ_SOURCE_LINE 00000669 "         task => \"download\", pos=>0, target=>scalar @urls);"
NSQ_SOURCE_LINE 00000670 "     for my $url (@urls) {"
NSQ_SOURCE_LINE 00000671 "         # download the $url ..."
NSQ_SOURCE_LINE 00000672 "         $progress->update(message => \"Downloaded $url\");"
NSQ_SOURCE_LINE 00000673 "     }"
NSQ_SOURCE_LINE 00000674 "     $progress->finish;"
NSQ_SOURCE_LINE 00000675 " }"
NSQ_SOURCE_LINE 00000676 ""
NSQ_SOURCE_LINE 00000677 " # in script.pl"
NSQ_SOURCE_LINE 00000678 " use MyApp;"
NSQ_SOURCE_LINE 00000679 " use Progress::Any::Output;"
NSQ_SOURCE_LINE 00000680 " Progress::Any::Output->set('TermProgressBarColor');"
NSQ_SOURCE_LINE 00000681 ""
NSQ_SOURCE_LINE 00000682 " MyApp::download(\"url1\", \"url2\", \"url3\", \"url4\", \"url5\");"
NSQ_SOURCE_LINE 00000683 ""
NSQ_SOURCE_LINE 00000684 "Sample output:"
NSQ_SOURCE_LINE 00000685 ""
NSQ_SOURCE_LINE 00000686 " % ./script.pl"
NSQ_SOURCE_LINE 00000687 "  20% [====== Downloaded url1           ]0m00s Left"
NSQ_SOURCE_LINE 00000688 ""
NSQ_SOURCE_LINE 00000689 "Example that demonstrates multiple indicator objects:"
NSQ_SOURCE_LINE 00000690 ""
NSQ_SOURCE_LINE 00000691 " use Progress::Any;"
NSQ_SOURCE_LINE 00000692 " use Progress::Any::Output;"
NSQ_SOURCE_LINE 00000693 ""
NSQ_SOURCE_LINE 00000694 " my $pdl = Progress::Any->get_indicator(task => 'download');"
NSQ_SOURCE_LINE 00000695 " Progress::Any::Output->set({task=>'download'}, 'TermMessage', template => '[%-8t] [%P/%2T] %m');"
NSQ_SOURCE_LINE 00000696 " my $pcp = Progress::Any->get_indicator(task => 'copy');"
NSQ_SOURCE_LINE 00000697 " Progress::Any::Output->set({task=>'copy'    }, 'TermMessage', template => '[%-8t] [%P/%2T] %m');"
NSQ_SOURCE_LINE 00000698 ""
NSQ_SOURCE_LINE 00000699 " $pdl->target(10);"
NSQ_SOURCE_LINE 00000700 " $pdl->update(message => \"downloading A\");"
NSQ_SOURCE_LINE 00000701 " $pcp->update(message => \"copying A\");"
NSQ_SOURCE_LINE 00000702 " sleep 1;"
NSQ_SOURCE_LINE 00000703 " $pdl->update(message => \"downloading B\");"
NSQ_SOURCE_LINE 00000704 " $pcp->update(message => \"copying B\");"
NSQ_SOURCE_LINE 00000705 ""
NSQ_SOURCE_LINE 00000706 "will show something like:"
NSQ_SOURCE_LINE 00000707 ""
NSQ_SOURCE_LINE 00000708 " [download] [1/10] downloading A"
NSQ_SOURCE_LINE 00000709 " [copy    ] [1/ ?] copying A"
NSQ_SOURCE_LINE 00000710 " [download] [2/10] downloading B"
NSQ_SOURCE_LINE 00000711 " [copy    ] [2/ ?] copying B"
NSQ_SOURCE_LINE 00000712 ""
NSQ_SOURCE_LINE 00000713 "=head2 Example of using with Perinci::CmdLine"
NSQ_SOURCE_LINE 00000714 ""
NSQ_SOURCE_LINE 00000715 "If you use L<Perinci::CmdLine>, you can mark your function as expecting a"
NSQ_SOURCE_LINE 00000716 "Progress::Any object and it will be supplied to you in a special argument"
NSQ_SOURCE_LINE 00000717 "C<-progress>:"
NSQ_SOURCE_LINE 00000718 ""
NSQ_SOURCE_LINE 00000719 " use File::chdir;"
NSQ_SOURCE_LINE 00000720 " use Perinci::CmdLine;"
NSQ_SOURCE_LINE 00000721 " $SPEC{check_dir} = {"
NSQ_SOURCE_LINE 00000722 "     v => 1.1,"
NSQ_SOURCE_LINE 00000723 "     args => {"
NSQ_SOURCE_LINE 00000724 "         dir => {summary=>\"Path to check\", schema=>\"str*\", req=>1, pos=>0},"
NSQ_SOURCE_LINE 00000725 "     },"
NSQ_SOURCE_LINE 00000726 "     features => {progress=>1},"
NSQ_SOURCE_LINE 00000727 " };"
NSQ_SOURCE_LINE 00000728 " sub check_dir {"
NSQ_SOURCE_LINE 00000729 "     my %args = @_;"
NSQ_SOURCE_LINE 00000730 "     my $progress = $args{-progress};"
NSQ_SOURCE_LINE 00000731 "     my $dir = $args{dir};"
NSQ_SOURCE_LINE 00000732 "     (-d $dir) or return [412, \"No such dir: $dir\"];"
NSQ_SOURCE_LINE 00000733 "     local $CWD = $dir;"
NSQ_SOURCE_LINE 00000734 "     opendir my($dh), $dir;"
NSQ_SOURCE_LINE 00000735 "     my @ent = readdir($dh);"
NSQ_SOURCE_LINE 00000736 "     $progress->pos(0);"
NSQ_SOURCE_LINE 00000737 "     $progress->target(scalar @ent);"
NSQ_SOURCE_LINE 00000738 "     for (@ent) {"
NSQ_SOURCE_LINE 00000739 "         # do the check ..."
NSQ_SOURCE_LINE 00000740 "         $progress->update(message => $_);"
NSQ_SOURCE_LINE 00000741 "         sleep 1;"
NSQ_SOURCE_LINE 00000742 "     }"
NSQ_SOURCE_LINE 00000743 "     $progress->finish;"
NSQ_SOURCE_LINE 00000744 "     [200];"
NSQ_SOURCE_LINE 00000745 " }"
NSQ_SOURCE_LINE 00000746 " Perinci::CmdLine->new(url => '/main/check_dir')->run;"
NSQ_SOURCE_LINE 00000747 ""
NSQ_SOURCE_LINE 00000748 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000749 ""
NSQ_SOURCE_LINE 00000750 "C<Progress::Any> is an interface for applications that want to display progress"
NSQ_SOURCE_LINE 00000751 "to users. It decouples progress updating and output, rather similar to how"
NSQ_SOURCE_LINE 00000752 "L<Log::Any> decouples log producers and consumers (output). The API is also"
NSQ_SOURCE_LINE 00000753 "rather similar to Log::Any, except I<Adapter> is called I<Output> and"
NSQ_SOURCE_LINE 00000754 "I<category> is called I<task>."
NSQ_SOURCE_LINE 00000755 ""
NSQ_SOURCE_LINE 00000756 "Progress::Any records position/target and calculates elapsed time, estimated"
NSQ_SOURCE_LINE 00000757 "remaining time, and percentage of completion. One or more output modules"
NSQ_SOURCE_LINE 00000758 "(Progress::Any::Output::*) display this information."
NSQ_SOURCE_LINE 00000759 ""
NSQ_SOURCE_LINE 00000760 "In your modules, you typically only need to use Progress::Any, get one or more"
NSQ_SOURCE_LINE 00000761 "indicators, set target and update it during work. In your application, you use"
NSQ_SOURCE_LINE 00000762 "L<Progress::Any::Output> and set/add one or more outputs to display the progress"
NSQ_SOURCE_LINE 00000763 "(you'll need to install one of the output modules as they are not included in"
NSQ_SOURCE_LINE 00000764 "this minimal distribution). By setting output only in the application and not in"
NSQ_SOURCE_LINE 00000765 "modules, you separate the formatting/display concern from the logic."
NSQ_SOURCE_LINE 00000766 ""
NSQ_SOURCE_LINE 00000767 "Screenshots:"
NSQ_SOURCE_LINE 00000768 ""
NSQ_SOURCE_LINE 00000769 "=head1 STATUS"
NSQ_SOURCE_LINE 00000770 ""
NSQ_SOURCE_LINE 00000771 "API might still change, will be stabilized in 1.0."
NSQ_SOURCE_LINE 00000772 ""
NSQ_SOURCE_LINE 00000773 "=begin HTML"
NSQ_SOURCE_LINE 00000774 ""
NSQ_SOURCE_LINE 00000775 "<p><img src=\"http://blogs.perl.org/users/perlancar/progany-tpc-sample.jpg\" /><br />Using TermProgressBarColor output"
NSQ_SOURCE_LINE 00000776 ""
NSQ_SOURCE_LINE 00000777 "<p><img src=\"http://blogs.perl.org/users/perlancar/progany-dn-sample.jpg\" /><br />Using DesktopNotify output"
NSQ_SOURCE_LINE 00000778 ""
NSQ_SOURCE_LINE 00000779 "=end HTML"
NSQ_SOURCE_LINE 00000780 ""
NSQ_SOURCE_LINE 00000781 "The list of features:"
NSQ_SOURCE_LINE 00000782 ""
NSQ_SOURCE_LINE 00000783 "=over"
NSQ_SOURCE_LINE 00000784 ""
NSQ_SOURCE_LINE 00000785 "=item * multiple progress indicators"
NSQ_SOURCE_LINE 00000786 ""
NSQ_SOURCE_LINE 00000787 "You can use different indicator for each task/subtask."
NSQ_SOURCE_LINE 00000788 ""
NSQ_SOURCE_LINE 00000789 "=item * customizable output"
NSQ_SOURCE_LINE 00000790 ""
NSQ_SOURCE_LINE 00000791 "Output is handled by one of C<Progress::Any::Output::*> modules. Currently"
NSQ_SOURCE_LINE 00000792 "available outputs: C<Null> (no output), C<TermMessage> (display as simple"
NSQ_SOURCE_LINE 00000793 "message on terminal), C<TermProgressBarColor> (display as color progress bar on"
NSQ_SOURCE_LINE 00000794 "terminal), C<LogAny> (log using L<Log::Any>), C<Callback> (call a subroutine)."
NSQ_SOURCE_LINE 00000795 "Other possible output ideas: IM/Twitter/SMS, GUI, web/AJAX, remote/RPC (over"
NSQ_SOURCE_LINE 00000796 "L<Riap> for example, so that L<Perinci::CmdLine>-based command-line clients can"
NSQ_SOURCE_LINE 00000797 "display progress update from remote functions)."
NSQ_SOURCE_LINE 00000798 ""
NSQ_SOURCE_LINE 00000799 "=item * multiple outputs"
NSQ_SOURCE_LINE 00000800 ""
NSQ_SOURCE_LINE 00000801 "One or more outputs can be used to display one or more indicators."
NSQ_SOURCE_LINE 00000802 ""
NSQ_SOURCE_LINE 00000803 "=item * hierarchical progress"
NSQ_SOURCE_LINE 00000804 ""
NSQ_SOURCE_LINE 00000805 "A task can be divided into subtasks. If a subtask is updated, its parent task"
NSQ_SOURCE_LINE 00000806 "(and its parent, and so on) are also updated proportionally."
NSQ_SOURCE_LINE 00000807 ""
NSQ_SOURCE_LINE 00000808 "=item * message"
NSQ_SOURCE_LINE 00000809 ""
NSQ_SOURCE_LINE 00000810 "Aside from setting a number/percentage, allow including a message when updating"
NSQ_SOURCE_LINE 00000811 "indicator."
NSQ_SOURCE_LINE 00000812 ""
NSQ_SOURCE_LINE 00000813 "=item * undefined target"
NSQ_SOURCE_LINE 00000814 ""
NSQ_SOURCE_LINE 00000815 "Target can be undefined, so a bar output might not show any bar (or show them,"
NSQ_SOURCE_LINE 00000816 "but without percentage indicator), but can still show messages."
NSQ_SOURCE_LINE 00000817 ""
NSQ_SOURCE_LINE 00000818 "=item * retargetting"
NSQ_SOURCE_LINE 00000819 ""
NSQ_SOURCE_LINE 00000820 "Target can be changed in the middle of things."
NSQ_SOURCE_LINE 00000821 ""
NSQ_SOURCE_LINE 00000822 "=back"
NSQ_SOURCE_LINE 00000823 ""
NSQ_SOURCE_LINE 00000824 "=head1 EXPORTS"
NSQ_SOURCE_LINE 00000825 ""
NSQ_SOURCE_LINE 00000826 "=head2 $progress => OBJ"
NSQ_SOURCE_LINE 00000827 ""
NSQ_SOURCE_LINE 00000828 "The root indicator. Equivalent to:"
NSQ_SOURCE_LINE 00000829 ""
NSQ_SOURCE_LINE 00000830 " Progress::Any->get_indicator(task => '')"
NSQ_SOURCE_LINE 00000831 ""
NSQ_SOURCE_LINE 00000832 "=head1 ATTRIBUTES"
NSQ_SOURCE_LINE 00000833 ""
NSQ_SOURCE_LINE 00000834 "Below are the attributes of an indicator/task:"
NSQ_SOURCE_LINE 00000835 ""
NSQ_SOURCE_LINE 00000836 "=head2 task"
NSQ_SOURCE_LINE 00000837 ""
NSQ_SOURCE_LINE 00000838 "String. Default: from caller's package, or C<main>."
NSQ_SOURCE_LINE 00000839 ""
NSQ_SOURCE_LINE 00000840 "Task name. If not specified will be set to caller's package (C<::> will be"
NSQ_SOURCE_LINE 00000841 "replaced with C<.>), e.g. if you are calling this method from"
NSQ_SOURCE_LINE 00000842 "C<Foo::Bar::baz()>, then task will be set to C<Foo.Bar>. If caller is code"
NSQ_SOURCE_LINE 00000843 "inside eval, C<main> will be used instead."
NSQ_SOURCE_LINE 00000844 ""
NSQ_SOURCE_LINE 00000845 "=head2 title"
NSQ_SOURCE_LINE 00000846 ""
NSQ_SOURCE_LINE 00000847 "String. Default: task name."
NSQ_SOURCE_LINE 00000848 ""
NSQ_SOURCE_LINE 00000849 "Specify task title. Task title is a longer description for a task and can"
NSQ_SOURCE_LINE 00000850 "contain spaces and other characters. It is displayed in some outputs, as well as"
NSQ_SOURCE_LINE 00000851 "using C<%t> in C<fill_template()>. For example, for a task called C<copy>, its"
NSQ_SOURCE_LINE 00000852 "title might be C<Copying files to remote server>."
NSQ_SOURCE_LINE 00000853 ""
NSQ_SOURCE_LINE 00000854 "=head2 target"
NSQ_SOURCE_LINE 00000855 ""
NSQ_SOURCE_LINE 00000856 "Non-negative number. Default: 0."
NSQ_SOURCE_LINE 00000857 ""
NSQ_SOURCE_LINE 00000858 "The total number of items to finish. Can be set to undef to mean that we don't"
NSQ_SOURCE_LINE 00000859 "know (yet) how many items there are to finish (in which case, we cannot estimate"
NSQ_SOURCE_LINE 00000860 "percent of completion and remaining time)."
NSQ_SOURCE_LINE 00000861 ""
NSQ_SOURCE_LINE 00000862 "=head2 pos"
NSQ_SOURCE_LINE 00000863 ""
NSQ_SOURCE_LINE 00000864 "Non-negative number. Default: 0."
NSQ_SOURCE_LINE 00000865 ""
NSQ_SOURCE_LINE 00000866 "The number of items that are already done. It cannot be larger than C<target>,"
NSQ_SOURCE_LINE 00000867 "if C<target> is defined. If C<target> is set to a value smaller than C<pos> or"
NSQ_SOURCE_LINE 00000868 "C<pos> is set to a value larger than C<target>, C<pos> will be changed to be"
NSQ_SOURCE_LINE 00000869 "C<target>."
NSQ_SOURCE_LINE 00000870 ""
NSQ_SOURCE_LINE 00000871 "=head2 state"
NSQ_SOURCE_LINE 00000872 ""
NSQ_SOURCE_LINE 00000873 "String. Default: C<stopped>."
NSQ_SOURCE_LINE 00000874 ""
NSQ_SOURCE_LINE 00000875 "State of task/indicator. Either: C<stopped>, C<started>, or C<finished>."
NSQ_SOURCE_LINE 00000876 "Initially it will be set to C<stopped>, which means elapsed time won't be"
NSQ_SOURCE_LINE 00000877 "running and will stay at 0. C<update()> will set the state to C<started> to get"
NSQ_SOURCE_LINE 00000878 "elapsed time to run. At the end of task, you can call C<finish()> (or"
NSQ_SOURCE_LINE 00000879 "alternatively set C<state> to C<finished>) to stop the elapsed time again."
NSQ_SOURCE_LINE 00000880 ""
NSQ_SOURCE_LINE 00000881 "The difference between C<stopped> and C<finished> is: when C<target> and C<pos>"
NSQ_SOURCE_LINE 00000882 "are both at 0, percent completed is assumed to be 0% when state is C<stopped>,"
NSQ_SOURCE_LINE 00000883 "but 100% when state is C<finished>."
NSQ_SOURCE_LINE 00000884 ""
NSQ_SOURCE_LINE 00000885 "=head1 METHODS"
NSQ_SOURCE_LINE 00000886 ""
NSQ_SOURCE_LINE 00000887 "=head2 get_indicator"
NSQ_SOURCE_LINE 00000888 ""
NSQ_SOURCE_LINE 00000889 "Usage:"
NSQ_SOURCE_LINE 00000890 ""
NSQ_SOURCE_LINE 00000891 " Progress::Any->get_indicator(%args) => obj"
NSQ_SOURCE_LINE 00000892 ""
NSQ_SOURCE_LINE 00000893 "Get a progress indicator for a certain task. C<%args> contain attribute values,"
NSQ_SOURCE_LINE 00000894 "at least C<task> must be specified."
NSQ_SOURCE_LINE 00000895 ""
NSQ_SOURCE_LINE 00000896 "Note that this module maintains a list of indicator singleton objects for each"
NSQ_SOURCE_LINE 00000897 "task (in C<%indicators> package variable), so subsequent C<get_indicator()> for"
NSQ_SOURCE_LINE 00000898 "the same task will return the same object."
NSQ_SOURCE_LINE 00000899 ""
NSQ_SOURCE_LINE 00000900 "=head2 update"
NSQ_SOURCE_LINE 00000901 ""
NSQ_SOURCE_LINE 00000902 "Usage:"
NSQ_SOURCE_LINE 00000903 ""
NSQ_SOURCE_LINE 00000904 " $progress->update(%args)"
NSQ_SOURCE_LINE 00000905 ""
NSQ_SOURCE_LINE 00000906 "Update indicator. Will also, usually, update associated output(s) if necessary."
NSQ_SOURCE_LINE 00000907 ""
NSQ_SOURCE_LINE 00000908 "Arguments:"
NSQ_SOURCE_LINE 00000909 ""
NSQ_SOURCE_LINE 00000910 "=over"
NSQ_SOURCE_LINE 00000911 ""
NSQ_SOURCE_LINE 00000912 "=item * pos => NUM"
NSQ_SOURCE_LINE 00000913 ""
NSQ_SOURCE_LINE 00000914 "Set the new position. If unspecified, defaults to current position + 1. If pos"
NSQ_SOURCE_LINE 00000915 "is larger than target, outputs will generally still show 100%. Note that"
NSQ_SOURCE_LINE 00000916 "fractions are allowed."
NSQ_SOURCE_LINE 00000917 ""
NSQ_SOURCE_LINE 00000918 "=item * message => str|code"
NSQ_SOURCE_LINE 00000919 ""
NSQ_SOURCE_LINE 00000920 "Set a message to be displayed when updating indicator."
NSQ_SOURCE_LINE 00000921 ""
NSQ_SOURCE_LINE 00000922 "Aside from a string, you can also pass a coderef here. It can be used to delay"
NSQ_SOURCE_LINE 00000923 "costly calculation. The message will only be calculated when actually sent to"
NSQ_SOURCE_LINE 00000924 "output."
NSQ_SOURCE_LINE 00000925 ""
NSQ_SOURCE_LINE 00000926 "=item * priority => str (\"normal\"|\"low\"|\"high\", default: \"normal\")"
NSQ_SOURCE_LINE 00000927 ""
NSQ_SOURCE_LINE 00000928 "Set importance level of this update. Default is C<normal>. Output can choose to"
NSQ_SOURCE_LINE 00000929 "ignore updates lower than a certain level."
NSQ_SOURCE_LINE 00000930 ""
NSQ_SOURCE_LINE 00000931 "=item * state => STR"
NSQ_SOURCE_LINE 00000932 ""
NSQ_SOURCE_LINE 00000933 "Can be set to C<finished> to finish a task."
NSQ_SOURCE_LINE 00000934 ""
NSQ_SOURCE_LINE 00000935 "=item * force_update => BOOL"
NSQ_SOURCE_LINE 00000936 ""
NSQ_SOURCE_LINE 00000937 "Default false. Some outputs choose only to update themselves after a certain"
NSQ_SOURCE_LINE 00000938 "amount of time or number of updates have passed; this forces their update."
NSQ_SOURCE_LINE 00000939 ""
NSQ_SOURCE_LINE 00000940 "=back"
NSQ_SOURCE_LINE 00000941 ""
NSQ_SOURCE_LINE 00000942 "=head2 finish"
NSQ_SOURCE_LINE 00000943 ""
NSQ_SOURCE_LINE 00000944 "Usage:"
NSQ_SOURCE_LINE 00000945 ""
NSQ_SOURCE_LINE 00000946 " $progress->finish(%args)"
NSQ_SOURCE_LINE 00000947 ""
NSQ_SOURCE_LINE 00000948 "Equivalent to:"
NSQ_SOURCE_LINE 00000949 ""
NSQ_SOURCE_LINE 00000950 " $progress->update("
NSQ_SOURCE_LINE 00000951 "     ( pos => $progress->target ) x !!defined($progress->target),"
NSQ_SOURCE_LINE 00000952 "     state => 'finished',"
NSQ_SOURCE_LINE 00000953 "     %args,"
NSQ_SOURCE_LINE 00000954 " );"
NSQ_SOURCE_LINE 00000955 ""
NSQ_SOURCE_LINE 00000956 "=head2 reset"
NSQ_SOURCE_LINE 00000957 ""
NSQ_SOURCE_LINE 00000958 "Usage:"
NSQ_SOURCE_LINE 00000959 ""
NSQ_SOURCE_LINE 00000960 " $progress->reset(%args)"
NSQ_SOURCE_LINE 00000961 ""
NSQ_SOURCE_LINE 00000962 "Equivalent to:"
NSQ_SOURCE_LINE 00000963 ""
NSQ_SOURCE_LINE 00000964 " $progress->update("
NSQ_SOURCE_LINE 00000965 "     pos => 0,"
NSQ_SOURCE_LINE 00000966 "     state => 'started',"
NSQ_SOURCE_LINE 00000967 "     %args,"
NSQ_SOURCE_LINE 00000968 " );"
NSQ_SOURCE_LINE 00000969 ""
NSQ_SOURCE_LINE 00000970 "=head2 start"
NSQ_SOURCE_LINE 00000971 ""
NSQ_SOURCE_LINE 00000972 "Usage:"
NSQ_SOURCE_LINE 00000973 ""
NSQ_SOURCE_LINE 00000974 " $progress->start()"
NSQ_SOURCE_LINE 00000975 ""
NSQ_SOURCE_LINE 00000976 "Set state to C<started>."
NSQ_SOURCE_LINE 00000977 ""
NSQ_SOURCE_LINE 00000978 "=head2 stop"
NSQ_SOURCE_LINE 00000979 ""
NSQ_SOURCE_LINE 00000980 "Usage:"
NSQ_SOURCE_LINE 00000981 ""
NSQ_SOURCE_LINE 00000982 " $progress->stop()"
NSQ_SOURCE_LINE 00000983 ""
NSQ_SOURCE_LINE 00000984 "Set state to C<stopped>."
NSQ_SOURCE_LINE 00000985 ""
NSQ_SOURCE_LINE 00000986 "=head2 elapsed"
NSQ_SOURCE_LINE 00000987 ""
NSQ_SOURCE_LINE 00000988 "Usage:"
NSQ_SOURCE_LINE 00000989 ""
NSQ_SOURCE_LINE 00000990 " $progress->elapsed() => float"
NSQ_SOURCE_LINE 00000991 ""
NSQ_SOURCE_LINE 00000992 "Get elapsed time. Just like a stop-watch, when state is C<started> elapsed time"
NSQ_SOURCE_LINE 00000993 "will run and when state is C<stopped>, it will freeze."
NSQ_SOURCE_LINE 00000994 ""
NSQ_SOURCE_LINE 00000995 "=head2 remaining"
NSQ_SOURCE_LINE 00000996 ""
NSQ_SOURCE_LINE 00000997 "Usage:"
NSQ_SOURCE_LINE 00000998 ""
NSQ_SOURCE_LINE 00000999 " $progress->remaining() => undef|float"
NSQ_SOURCE_LINE 00001000 ""
NSQ_SOURCE_LINE 00001001 "Give estimated remaining time until task is finished, which will depend on how"
NSQ_SOURCE_LINE 00001002 "fast the C<update()> is called, i.e. how fast C<pos> is approaching C<target>."
NSQ_SOURCE_LINE 00001003 "Will be undef if C<target> is undef."
NSQ_SOURCE_LINE 00001004 ""
NSQ_SOURCE_LINE 00001005 "=head2 total_remaining"
NSQ_SOURCE_LINE 00001006 ""
NSQ_SOURCE_LINE 00001007 "Usage:"
NSQ_SOURCE_LINE 00001008 ""
NSQ_SOURCE_LINE 00001009 " $progress->total_remaining() => undef|FLOAT"
NSQ_SOURCE_LINE 00001010 ""
NSQ_SOURCE_LINE 00001011 "Give estimated remaining time added by all its subtasks' remaining. Return undef"
NSQ_SOURCE_LINE 00001012 "if any one of those time is undef."
NSQ_SOURCE_LINE 00001013 ""
NSQ_SOURCE_LINE 00001014 "=head2 total_pos"
NSQ_SOURCE_LINE 00001015 ""
NSQ_SOURCE_LINE 00001016 "Usage:"
NSQ_SOURCE_LINE 00001017 ""
NSQ_SOURCE_LINE 00001018 " $progress->total_pos() => float"
NSQ_SOURCE_LINE 00001019 ""
NSQ_SOURCE_LINE 00001020 "Total of indicator's pos and all of its subtasks'."
NSQ_SOURCE_LINE 00001021 ""
NSQ_SOURCE_LINE 00001022 "=head2 total_target"
NSQ_SOURCE_LINE 00001023 ""
NSQ_SOURCE_LINE 00001024 "Usage:"
NSQ_SOURCE_LINE 00001025 ""
NSQ_SOURCE_LINE 00001026 " $progress->total_target() => undef|float"
NSQ_SOURCE_LINE 00001027 ""
NSQ_SOURCE_LINE 00001028 "Total of indicator's target and all of its subtasks'. Return undef if any one of"
NSQ_SOURCE_LINE 00001029 "those is undef."
NSQ_SOURCE_LINE 00001030 ""
NSQ_SOURCE_LINE 00001031 "=head2 percent_complete"
NSQ_SOURCE_LINE 00001032 ""
NSQ_SOURCE_LINE 00001033 "Usage:"
NSQ_SOURCE_LINE 00001034 ""
NSQ_SOURCE_LINE 00001035 " $progress->percent_complete() => undef|float"
NSQ_SOURCE_LINE 00001036 ""
NSQ_SOURCE_LINE 00001037 "Give percentage of completion, calculated using C<< total_pos / total_target *"
NSQ_SOURCE_LINE 00001038 "100 >>. Undef if total_target is undef."
NSQ_SOURCE_LINE 00001039 ""
NSQ_SOURCE_LINE 00001040 "=head2 fill_template"
NSQ_SOURCE_LINE 00001041 ""
NSQ_SOURCE_LINE 00001042 "Usage:"
NSQ_SOURCE_LINE 00001043 ""
NSQ_SOURCE_LINE 00001044 " $progress->fill_template($template) => str"
NSQ_SOURCE_LINE 00001045 ""
NSQ_SOURCE_LINE 00001046 "Fill template with values, like in C<sprintf()>. Usually used by output modules."
NSQ_SOURCE_LINE 00001047 "Available templates:"
NSQ_SOURCE_LINE 00001048 ""
NSQ_SOURCE_LINE 00001049 "=over"
NSQ_SOURCE_LINE 00001050 ""
NSQ_SOURCE_LINE 00001051 "=item * C<%(width)n>"
NSQ_SOURCE_LINE 00001052 ""
NSQ_SOURCE_LINE 00001053 "Task name (the value of the C<task> attribute). C<width> is optional, an"
NSQ_SOURCE_LINE 00001054 "integer, like in C<sprintf()>, can be negative to mean left-justify instead of"
NSQ_SOURCE_LINE 00001055 "right."
NSQ_SOURCE_LINE 00001056 ""
NSQ_SOURCE_LINE 00001057 "=item * C<%(width)t>"
NSQ_SOURCE_LINE 00001058 ""
NSQ_SOURCE_LINE 00001059 "Task title (the value of the C<title> attribute)."
NSQ_SOURCE_LINE 00001060 ""
NSQ_SOURCE_LINE 00001061 "=item * C<%(width)e>"
NSQ_SOURCE_LINE 00001062 ""
NSQ_SOURCE_LINE 00001063 "Elapsed time (the result from the C<elapsed()> method). Currently using"
NSQ_SOURCE_LINE 00001064 "L<Time::Duration> concise format, e.g. 10s, 1m40s, 16m40s, 1d4h, and so on."
NSQ_SOURCE_LINE 00001065 "Format might be configurable and localizable in the future. Default width is -8."
NSQ_SOURCE_LINE 00001066 "Examples:"
NSQ_SOURCE_LINE 00001067 ""
NSQ_SOURCE_LINE 00001068 " 2m30s"
NSQ_SOURCE_LINE 00001069 " 10s"
NSQ_SOURCE_LINE 00001070 ""
NSQ_SOURCE_LINE 00001071 "=item * C<%(width)r>"
NSQ_SOURCE_LINE 00001072 ""
NSQ_SOURCE_LINE 00001073 "Estimated remaining time (the result of the C<total_remaining()> method)."
NSQ_SOURCE_LINE 00001074 "Currently using L<Time::Duration> concise format, e.g. 10s, 1m40s, 16m40s, 1d4h,"
NSQ_SOURCE_LINE 00001075 "and so on. Will show C<?> if unknown. Format might be configurable and"
NSQ_SOURCE_LINE 00001076 "localizable in the future. Default width is -8. Examples:"
NSQ_SOURCE_LINE 00001077 ""
NSQ_SOURCE_LINE 00001078 " 1m40s"
NSQ_SOURCE_LINE 00001079 " 5s"
NSQ_SOURCE_LINE 00001080 ""
NSQ_SOURCE_LINE 00001081 "=item * C<%(width)R>"
NSQ_SOURCE_LINE 00001082 ""
NSQ_SOURCE_LINE 00001083 "Estimated remaining time I<or> elapsed time, if estimated remaining time is not"
NSQ_SOURCE_LINE 00001084 "calculatable (e.g. when target is undefined). Format might be configurable and"
NSQ_SOURCE_LINE 00001085 "localizable in the future. Default width is -(8+1+7). Examples:"
NSQ_SOURCE_LINE 00001086 ""
NSQ_SOURCE_LINE 00001087 " 30s left"
NSQ_SOURCE_LINE 00001088 " 1m40s elapsed"
NSQ_SOURCE_LINE 00001089 ""
NSQ_SOURCE_LINE 00001090 "=item * C<%(width).(prec)p>"
NSQ_SOURCE_LINE 00001091 ""
NSQ_SOURCE_LINE 00001092 "Percentage of completion (the result of the C<percent_complete()> method)."
NSQ_SOURCE_LINE 00001093 "C<width> and C<precision> are optional, like C<%f> in Perl's C<sprintf()>,"
NSQ_SOURCE_LINE 00001094 "default is C<%3.0p>. If percentage is unknown (due to target being undef), will"
NSQ_SOURCE_LINE 00001095 "show C<?>."
NSQ_SOURCE_LINE 00001096 ""
NSQ_SOURCE_LINE 00001097 "=item * C<%(width)P>"
NSQ_SOURCE_LINE 00001098 ""
NSQ_SOURCE_LINE 00001099 "Current position (the result of the C<total_pos()> method)."
NSQ_SOURCE_LINE 00001100 ""
NSQ_SOURCE_LINE 00001101 "=item * C<%(width)T>"
NSQ_SOURCE_LINE 00001102 ""
NSQ_SOURCE_LINE 00001103 "Target (the result of the C<total_target()> method). If undefined, will show"
NSQ_SOURCE_LINE 00001104 "C<?>."
NSQ_SOURCE_LINE 00001105 ""
NSQ_SOURCE_LINE 00001106 "=item * C<%m>"
NSQ_SOURCE_LINE 00001107 ""
NSQ_SOURCE_LINE 00001108 "Message (the C<update()> parameter). If message is unspecified, will show empty"
NSQ_SOURCE_LINE 00001109 "string."
NSQ_SOURCE_LINE 00001110 ""
NSQ_SOURCE_LINE 00001111 "=item * C<%%>"
NSQ_SOURCE_LINE 00001112 ""
NSQ_SOURCE_LINE 00001113 "A literal C<%> sign."
NSQ_SOURCE_LINE 00001114 ""
NSQ_SOURCE_LINE 00001115 "=back"
NSQ_SOURCE_LINE 00001116 ""
NSQ_SOURCE_LINE 00001117 "=head1 FAQ"
NSQ_SOURCE_LINE 00001118 ""
NSQ_SOURCE_LINE 00001119 "=head1 ENVIRONMENT"
NSQ_SOURCE_LINE 00001120 ""
NSQ_SOURCE_LINE 00001121 "=head2 PROGRESS"
NSQ_SOURCE_LINE 00001122 ""
NSQ_SOURCE_LINE 00001123 "Boolean. Default 1. Can be set to 0 to supress display progress output."
NSQ_SOURCE_LINE 00001124 ""
NSQ_SOURCE_LINE 00001125 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00001126 ""
NSQ_SOURCE_LINE 00001127 "Please visit the project's homepage at L<https://metacpan.org/release/Progress-Any>."
NSQ_SOURCE_LINE 00001128 ""
NSQ_SOURCE_LINE 00001129 "=head1 SOURCE"
NSQ_SOURCE_LINE 00001130 ""
NSQ_SOURCE_LINE 00001131 "Source repository is at L<https://github.com/perlancar/perl-Progress-Any>."
NSQ_SOURCE_LINE 00001132 ""
NSQ_SOURCE_LINE 00001133 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00001134 ""
NSQ_SOURCE_LINE 00001135 "L<Progress::Any::Examples> distribution contains example scripts."
NSQ_SOURCE_LINE 00001136 ""
NSQ_SOURCE_LINE 00001137 "Other progress modules on CPAN: L<Term::ProgressBar>,"
NSQ_SOURCE_LINE 00001138 "L<Term::ProgressBar::Simple>, L<Time::Progress>, among others."
NSQ_SOURCE_LINE 00001139 ""
NSQ_SOURCE_LINE 00001140 "Output modules: C<Progress::Any::Output::*>. You need to install at least one"
NSQ_SOURCE_LINE 00001141 "module to actually see progress being outputted/displayed somewhere, e.g. <> to"
NSQ_SOURCE_LINE 00001142 "L<Progress::Any::Output::TermProgressBarColor>."
NSQ_SOURCE_LINE 00001143 ""
NSQ_SOURCE_LINE 00001144 "See examples on how Progress::Any is used by other modules: L<Perinci::CmdLine>"
NSQ_SOURCE_LINE 00001145 "(supplying progress object to functions), L<Git::Bunch> (using progress object)."
NSQ_SOURCE_LINE 00001146 ""
NSQ_SOURCE_LINE 00001147 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00001148 ""
NSQ_SOURCE_LINE 00001149 "perlancar <perlancar@cpan.org>"
NSQ_SOURCE_LINE 00001150 ""
NSQ_SOURCE_LINE 00001151 "=head1 CONTRIBUTOR"
NSQ_SOURCE_LINE 00001152 ""
NSQ_SOURCE_LINE 00001153 "=for stopwords Steven Haryanto"
NSQ_SOURCE_LINE 00001154 ""
NSQ_SOURCE_LINE 00001155 "Steven Haryanto <stevenharyanto@gmail.com>"
NSQ_SOURCE_LINE 00001156 ""
NSQ_SOURCE_LINE 00001157 "=head1 CONTRIBUTING"
NSQ_SOURCE_LINE 00001158 ""
NSQ_SOURCE_LINE 00001159 ""
NSQ_SOURCE_LINE 00001160 "To contribute, you can send patches by email/via RT, or send pull requests on"
NSQ_SOURCE_LINE 00001161 "GitHub."
NSQ_SOURCE_LINE 00001162 ""
NSQ_SOURCE_LINE 00001163 "Most of the time, you don't need to build the distribution yourself. You can"
NSQ_SOURCE_LINE 00001164 "simply modify the code, then test via:"
NSQ_SOURCE_LINE 00001165 ""
NSQ_SOURCE_LINE 00001166 " % prove -l"
NSQ_SOURCE_LINE 00001167 ""
NSQ_SOURCE_LINE 00001168 "If you want to build the distribution (e.g. to try to install it locally on your"
NSQ_SOURCE_LINE 00001169 "system), you can install L<Dist::Zilla>,"
NSQ_SOURCE_LINE 00001170 "L<Dist::Zilla::PluginBundle::Author::PERLANCAR>,"
NSQ_SOURCE_LINE 00001171 "L<Pod::Weaver::PluginBundle::Author::PERLANCAR>, and sometimes one or two other"
NSQ_SOURCE_LINE 00001172 "Dist::Zilla- and/or Pod::Weaver plugins. Any additional steps required beyond"
NSQ_SOURCE_LINE 00001173 "that are considered a bug and can be reported to me."
NSQ_SOURCE_LINE 00001174 ""
NSQ_SOURCE_LINE 00001175 "=head1 COPYRIGHT AND LICENSE"
NSQ_SOURCE_LINE 00001176 ""
NSQ_SOURCE_LINE 00001177 "This software is copyright (c) 2022, 2020, 2018, 2015, 2014, 2013, 2012 by perlancar <perlancar@cpan.org>."
NSQ_SOURCE_LINE 00001178 ""
