NSQ_SOURCE_LINE 00000001 "package Digest::SHA1;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use vars qw($VERSION @ISA @EXPORT_OK);"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "$VERSION = '2.13';"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "require Exporter;"
NSQ_SOURCE_LINE 00000009 "*import = \\&Exporter::import;"
NSQ_SOURCE_LINE 00000010 "@EXPORT_OK = qw(sha1 sha1_hex sha1_base64 sha1_transform);"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "require DynaLoader;"
NSQ_SOURCE_LINE 00000013 "@ISA=qw(DynaLoader);"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "eval {"
NSQ_SOURCE_LINE 00000016 "    require Digest::base;"
NSQ_SOURCE_LINE 00000017 "    push(@ISA, 'Digest::base');"
NSQ_SOURCE_LINE 00000018 "};"
NSQ_SOURCE_LINE 00000019 "if ($@) {"
NSQ_SOURCE_LINE 00000020 "    my $err = $@;"
NSQ_SOURCE_LINE 00000021 "    *add_bits = sub { die $err };"
NSQ_SOURCE_LINE 00000022 "}"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "Digest::SHA1->bootstrap($VERSION);"
NSQ_SOURCE_LINE 00000025 ""
