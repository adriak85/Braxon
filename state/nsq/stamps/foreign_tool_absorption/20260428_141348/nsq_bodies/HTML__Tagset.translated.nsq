BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package HTML::Tagset;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "=head1 NAME"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "HTML::Tagset - data tables useful in parsing HTML"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "=head1 VERSION"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "Version 3.24"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "=cut"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "our $VERSION = '3.24';"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "  use HTML::Tagset;"
NSQ_SOURCE_LINE 00000020 "  # Then use any of the items in the HTML::Tagset package"
NSQ_SOURCE_LINE 00000021 "  #  as need arises"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "This module contains several data tables useful in various kinds of"
NSQ_SOURCE_LINE 00000026 "HTML parsing operations."
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "Note that all tag names used are lowercase."
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "In the following documentation, a \"hashset\" is a hash being used as a"
NSQ_SOURCE_LINE 00000031 "set -- the hash conveys that its keys are there, and the actual values"
NSQ_SOURCE_LINE 00000032 "associated with the keys are not significant.  (But what values are"
NSQ_SOURCE_LINE 00000033 "there, are always true.)"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "=head1 VARIABLES"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "Note that none of these variables are exported."
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "=head2 hashset %HTML::Tagset::emptyElement"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "This hashset has as values the tag-names (GIs) of elements that cannot"
NSQ_SOURCE_LINE 00000042 "have content.  (For example, \"base\", \"br\", \"hr\".)  So"
NSQ_SOURCE_LINE 00000043 "C<$HTML::Tagset::emptyElement{'hr'}> exists and is true."
NSQ_SOURCE_LINE 00000044 "C<$HTML::Tagset::emptyElement{'dl'}> does not exist, and so is not true."
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "=cut"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "our %emptyElement   = map { $_ => 1 } qw("
NSQ_SOURCE_LINE 00000049 "                                     base link meta isindex"
NSQ_SOURCE_LINE 00000050 "                                     img br hr wbr"
NSQ_SOURCE_LINE 00000051 "                                     input area param"
NSQ_SOURCE_LINE 00000052 "                                     embed bgsound spacer"
NSQ_SOURCE_LINE 00000053 "                                     basefont col frame"
NSQ_SOURCE_LINE 00000054 "                                     ~comment ~literal"
NSQ_SOURCE_LINE 00000055 "                                     ~declaration ~pi"
NSQ_SOURCE_LINE 00000056 "                                    );"
NSQ_SOURCE_LINE 00000057 "# The \"~\"-initial names are for pseudo-elements used by HTML::Entities"
NSQ_SOURCE_LINE 00000058 "#  and TreeBuilder"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "=head2 hashset %HTML::Tagset::optionalEndTag"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "This hashset lists tag-names for elements that can have content, but whose"
NSQ_SOURCE_LINE 00000063 "end-tags are generally, \"safely\", omissible.  Example:"
NSQ_SOURCE_LINE 00000064 "C<$HTML::Tagset::emptyElement{'li'}> exists and is true."
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "=cut"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "our %optionalEndTag = map { $_ => 1 } qw("
NSQ_SOURCE_LINE 00000069 "    p li dt dd"
NSQ_SOURCE_LINE 00000070 "); # option th tr td);"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "=head2 hash %HTML::Tagset::linkElements"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "Values in this hash are tagnames for elements that might contain"
NSQ_SOURCE_LINE 00000075 "links, and the value for each is a reference to an array of the names"
NSQ_SOURCE_LINE 00000076 "of attributes whose values can be links."
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "=cut"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "our %linkElements ="
NSQ_SOURCE_LINE 00000081 "("
NSQ_SOURCE_LINE 00000082 " 'a'       => ['href'],"
NSQ_SOURCE_LINE 00000083 " 'applet'  => ['archive', 'codebase', 'code'],"
NSQ_SOURCE_LINE 00000084 " 'area'    => ['href'],"
NSQ_SOURCE_LINE 00000085 " 'base'    => ['href'],"
NSQ_SOURCE_LINE 00000086 " 'bgsound' => ['src'],"
NSQ_SOURCE_LINE 00000087 " 'blockquote' => ['cite'],"
NSQ_SOURCE_LINE 00000088 " 'body'    => ['background'],"
NSQ_SOURCE_LINE 00000089 " 'del'     => ['cite'],"
NSQ_SOURCE_LINE 00000090 " 'embed'   => ['pluginspage', 'src'],"
NSQ_SOURCE_LINE 00000091 " 'form'    => ['action'],"
NSQ_SOURCE_LINE 00000092 " 'frame'   => ['src', 'longdesc'],"
NSQ_SOURCE_LINE 00000093 " 'iframe'  => ['src', 'longdesc'],"
NSQ_SOURCE_LINE 00000094 " 'ilayer'  => ['background'],"
NSQ_SOURCE_LINE 00000095 " 'img'     => ['src', 'lowsrc', 'longdesc', 'usemap'],"
NSQ_SOURCE_LINE 00000096 " 'input'   => ['src', 'usemap'],"
NSQ_SOURCE_LINE 00000097 " 'ins'     => ['cite'],"
NSQ_SOURCE_LINE 00000098 " 'isindex' => ['action'],"
NSQ_SOURCE_LINE 00000099 " 'head'    => ['profile'],"
NSQ_SOURCE_LINE 00000100 " 'layer'   => ['background', 'src'],"
NSQ_SOURCE_LINE 00000101 " 'link'    => ['href'],"
NSQ_SOURCE_LINE 00000102 " 'object'  => ['classid', 'codebase', 'data', 'archive', 'usemap'],"
NSQ_SOURCE_LINE 00000103 " 'q'       => ['cite'],"
NSQ_SOURCE_LINE 00000104 " 'script'  => ['src', 'for'],"
NSQ_SOURCE_LINE 00000105 " 'table'   => ['background'],"
NSQ_SOURCE_LINE 00000106 " 'td'      => ['background'],"
NSQ_SOURCE_LINE 00000107 " 'th'      => ['background'],"
NSQ_SOURCE_LINE 00000108 " 'tr'      => ['background'],"
NSQ_SOURCE_LINE 00000109 " 'xmp'     => ['href'],"
NSQ_SOURCE_LINE 00000110 ");"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "=head2 hash %HTML::Tagset::boolean_attr"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "This hash (not hashset) lists what attributes of what elements can be"
NSQ_SOURCE_LINE 00000115 "printed without showing the value (for example, the \"noshade\" attribute"
NSQ_SOURCE_LINE 00000116 "of \"hr\" elements).  For elements with only one such attribute, its value"
NSQ_SOURCE_LINE 00000117 "is simply that attribute name.  For elements with many such attributes,"
NSQ_SOURCE_LINE 00000118 "the value is a reference to a hashset containing all such attributes."
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "=cut"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "our %boolean_attr = ("
NSQ_SOURCE_LINE 00000123 "# TODO: make these all hashes"
NSQ_SOURCE_LINE 00000124 "  'area'   => 'nohref',"
NSQ_SOURCE_LINE 00000125 "  'dir'    => 'compact',"
NSQ_SOURCE_LINE 00000126 "  'dl'     => 'compact',"
NSQ_SOURCE_LINE 00000127 "  'hr'     => 'noshade',"
NSQ_SOURCE_LINE 00000128 "  'img'    => 'ismap',"
NSQ_SOURCE_LINE 00000129 "  'input'  => { 'checked' => 1, 'readonly' => 1, 'disabled' => 1 },"
NSQ_SOURCE_LINE 00000130 "  'menu'   => 'compact',"
NSQ_SOURCE_LINE 00000131 "  'ol'     => 'compact',"
NSQ_SOURCE_LINE 00000132 "  'option' => 'selected',"
NSQ_SOURCE_LINE 00000133 "  'select' => 'multiple',"
NSQ_SOURCE_LINE 00000134 "  'td'     => 'nowrap',"
NSQ_SOURCE_LINE 00000135 "  'th'     => 'nowrap',"
NSQ_SOURCE_LINE 00000136 "  'ul'     => 'compact',"
NSQ_SOURCE_LINE 00000137 ");"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "#=========================================================================="
NSQ_SOURCE_LINE 00000140 "# List of all elements from Extensible HTML version 1.0 Transitional DTD:"
NSQ_SOURCE_LINE 00000141 "#"
NSQ_SOURCE_LINE 00000142 "#   a abbr acronym address applet area b base basefont bdo big"
NSQ_SOURCE_LINE 00000143 "#   blockquote body br button caption center cite code col colgroup"
NSQ_SOURCE_LINE 00000144 "#   dd del dfn dir div dl dt em fieldset font form h1 h2 h3 h4 h5 h6"
NSQ_SOURCE_LINE 00000145 "#   head hr html i iframe img input ins isindex kbd label legend li"
NSQ_SOURCE_LINE 00000146 "#   link map menu meta noframes noscript object ol optgroup option p"
NSQ_SOURCE_LINE 00000147 "#   param pre q s samp script select small span strike strong style"
NSQ_SOURCE_LINE 00000148 "#   sub sup table tbody td textarea tfoot th thead title tr tt u ul"
NSQ_SOURCE_LINE 00000149 "#   var"
NSQ_SOURCE_LINE 00000150 "#"
NSQ_SOURCE_LINE 00000151 "# Varia from Mozilla source internal table of tags:"
NSQ_SOURCE_LINE 00000152 "#   Implemented:"
NSQ_SOURCE_LINE 00000153 "#     xmp listing wbr nobr frame frameset noframes ilayer"
NSQ_SOURCE_LINE 00000154 "#     layer nolayer spacer embed multicol"
NSQ_SOURCE_LINE 00000155 "#   But these are unimplemented:"
NSQ_SOURCE_LINE 00000156 "#     sound??  keygen??  server??"
NSQ_SOURCE_LINE 00000157 "# Also seen here and there:"
NSQ_SOURCE_LINE 00000158 "#     marquee??  app??  (both unimplemented)"
NSQ_SOURCE_LINE 00000159 "#=========================================================================="
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "=head2 hashset %HTML::Tagset::isPhraseMarkup"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "This hashset contains all phrasal-level elements."
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "=cut"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "our %isPhraseMarkup = map { $_ => 1 } qw("
NSQ_SOURCE_LINE 00000168 "  span abbr acronym q sub sup"
NSQ_SOURCE_LINE 00000169 "  cite code em kbd samp strong var dfn strike"
NSQ_SOURCE_LINE 00000170 "  b i u s tt small big"
NSQ_SOURCE_LINE 00000171 "  ins del"
NSQ_SOURCE_LINE 00000172 "  a img br"
NSQ_SOURCE_LINE 00000173 "  wbr nobr blink"
NSQ_SOURCE_LINE 00000174 "  font basefont bdo"
NSQ_SOURCE_LINE 00000175 "  spacer embed noembed"
NSQ_SOURCE_LINE 00000176 ");  # had: center, hr, table"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "=head2 hashset %HTML::Tagset::is_Possible_Strict_P_Content"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "This hashset contains all phrasal-level elements that be content of a"
NSQ_SOURCE_LINE 00000182 "P element, for a strict model of HTML."
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "=cut"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "our %isFormElement; # Forward declaration"
NSQ_SOURCE_LINE 00000187 "our %is_Possible_Strict_P_Content = ("
NSQ_SOURCE_LINE 00000188 " %isPhraseMarkup,"
NSQ_SOURCE_LINE 00000189 " %isFormElement,"
NSQ_SOURCE_LINE 00000190 " map {; $_ => 1} qw( object script map )"
NSQ_SOURCE_LINE 00000191 "  # I've no idea why there's these latter exceptions."
NSQ_SOURCE_LINE 00000192 "  # I'm just following the HTML4.01 DTD."
NSQ_SOURCE_LINE 00000193 ");"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "#from html4 strict:"
NSQ_SOURCE_LINE 00000196 "#<!ENTITY % fontstyle \"TT | I | B | BIG | SMALL\">"
NSQ_SOURCE_LINE 00000197 "#"
NSQ_SOURCE_LINE 00000198 "#<!ENTITY % phrase \"EM | STRONG | DFN | CODE |"
NSQ_SOURCE_LINE 00000199 "#                   SAMP | KBD | VAR | CITE | ABBR | ACRONYM\" >"
NSQ_SOURCE_LINE 00000200 "#"
NSQ_SOURCE_LINE 00000201 "#<!ENTITY % special"
NSQ_SOURCE_LINE 00000202 "#   \"A | IMG | OBJECT | BR | SCRIPT | MAP | Q | SUB | SUP | SPAN | BDO\">"
NSQ_SOURCE_LINE 00000203 "#"
NSQ_SOURCE_LINE 00000204 "#<!ENTITY % formctrl \"INPUT | SELECT | TEXTAREA | LABEL | BUTTON\">"
NSQ_SOURCE_LINE 00000205 "#"
NSQ_SOURCE_LINE 00000206 "#<!-- %inline; covers inline or \"text-level\" elements -->"
NSQ_SOURCE_LINE 00000207 "#<!ENTITY % inline \"#PCDATA | %fontstyle; | %phrase; | %special; | %formctrl;\">"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "=head2 hashset %HTML::Tagset::isHeadElement"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "This hashset contains all elements that elements that should be"
NSQ_SOURCE_LINE 00000212 "present only in the 'head' element of an HTML document."
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "=cut"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "our %isHeadElement = map { $_ => 1 }"
NSQ_SOURCE_LINE 00000217 " qw(title base link meta isindex script style object bgsound);"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "=head2 hashset %HTML::Tagset::isList"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "This hashset contains all elements that can contain \"li\" elements."
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "=cut"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "our %isList = map { $_ => 1 } qw("
NSQ_SOURCE_LINE 00000226 "    ul ol dir menu"
NSQ_SOURCE_LINE 00000227 ");"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "=head2 hashset %HTML::Tagset::isTableElement"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "This hashset contains all elements that are to be found only in/under"
NSQ_SOURCE_LINE 00000232 "a \"table\" element."
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "=cut"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "our %isTableElement = map { $_ => 1 }"
NSQ_SOURCE_LINE 00000237 " qw(tr td th thead tbody tfoot caption col colgroup);"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "=head2 hashset %HTML::Tagset::isFormElement"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "This hashset contains all elements that are to be found only in/under"
NSQ_SOURCE_LINE 00000242 "a \"form\" element."
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "=cut"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "# Declared earlier in the file"
NSQ_SOURCE_LINE 00000247 "%isFormElement = map { $_ => 1 }"
NSQ_SOURCE_LINE 00000248 " qw(input select option optgroup textarea button label);"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "=head2 hashset %HTML::Tagset::isBodyElement"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "This hashset contains all elements that are to be found only in/under"
NSQ_SOURCE_LINE 00000253 "the \"body\" element of an HTML document."
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "=cut"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "our %isBodyElement = map { $_ => 1 } qw("
NSQ_SOURCE_LINE 00000258 "  h1 h2 h3 h4 h5 h6"
NSQ_SOURCE_LINE 00000259 "  p div pre plaintext address blockquote"
NSQ_SOURCE_LINE 00000260 "  xmp listing"
NSQ_SOURCE_LINE 00000261 "  center"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "  multicol"
NSQ_SOURCE_LINE 00000264 "  iframe ilayer nolayer"
NSQ_SOURCE_LINE 00000265 "  bgsound"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "  hr"
NSQ_SOURCE_LINE 00000268 "  ol ul dir menu li"
NSQ_SOURCE_LINE 00000269 "  dl dt dd"
NSQ_SOURCE_LINE 00000270 "  ins del"
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "  fieldset legend"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "  map area"
NSQ_SOURCE_LINE 00000275 "  applet param object"
NSQ_SOURCE_LINE 00000276 "  isindex script noscript"
NSQ_SOURCE_LINE 00000277 "  table"
NSQ_SOURCE_LINE 00000278 "  center"
NSQ_SOURCE_LINE 00000279 "  form"
NSQ_SOURCE_LINE 00000280 " ),"
NSQ_SOURCE_LINE 00000281 " keys %isFormElement,"
NSQ_SOURCE_LINE 00000282 " keys %isPhraseMarkup,   # And everything phrasal"
NSQ_SOURCE_LINE 00000283 " keys %isTableElement,"
NSQ_SOURCE_LINE 00000284 ";"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "=head2 hashset %HTML::Tagset::isHeadOrBodyElement"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "This hashset includes all elements that I notice can fall either in"
NSQ_SOURCE_LINE 00000290 "the head or in the body."
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "=cut"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "our %isHeadOrBodyElement = map { $_ => 1 }"
NSQ_SOURCE_LINE 00000295 "  qw(script isindex style object map area param noscript bgsound);"
NSQ_SOURCE_LINE 00000296 "  # i.e., if we find 'script' in the 'body' or the 'head', don't freak out."
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "=head2 hashset %HTML::Tagset::isKnown"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "This hashset lists all known HTML elements."
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "=cut"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "our %isKnown = (%isHeadElement, %isBodyElement,"
NSQ_SOURCE_LINE 00000306 "  map{ $_ => 1 }"
NSQ_SOURCE_LINE 00000307 "   qw( head body html"
NSQ_SOURCE_LINE 00000308 "       frame frameset noframes"
NSQ_SOURCE_LINE 00000309 "       ~comment ~pi ~directive ~literal"
NSQ_SOURCE_LINE 00000310 "));"
NSQ_SOURCE_LINE 00000311 " # that should be all known tags ever ever"
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "=head2 hashset %HTML::Tagset::canTighten"
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "This hashset lists elements that might have ignorable whitespace as"
NSQ_SOURCE_LINE 00000317 "children or siblings."
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "=cut"
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "our %canTighten = %isKnown;"
NSQ_SOURCE_LINE 00000322 "delete @canTighten{"
NSQ_SOURCE_LINE 00000323 "  keys(%isPhraseMarkup), 'input', 'select',"
NSQ_SOURCE_LINE 00000324 "  'xmp', 'listing', 'plaintext', 'pre',"
NSQ_SOURCE_LINE 00000325 "};"
NSQ_SOURCE_LINE 00000326 "  # xmp, listing, plaintext, and pre  are untightenable, and"
NSQ_SOURCE_LINE 00000327 "  #   in a really special way."
NSQ_SOURCE_LINE 00000328 "@canTighten{'hr','br'} = (1,1);"
NSQ_SOURCE_LINE 00000329 " # exceptional 'phrasal' things that ARE subject to tightening."
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "# The one case where I can think of my tightening rules failing is:"
NSQ_SOURCE_LINE 00000332 "#  <p>foo bar<center> <em>baz quux</em> ..."
NSQ_SOURCE_LINE 00000333 "#                    ^-- that would get deleted."
NSQ_SOURCE_LINE 00000334 "# But that's pretty gruesome code anyhow.  You gets what you pays for."
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "#=========================================================================="
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "=head2 array @HTML::Tagset::p_closure_barriers"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "This array has a meaning that I have only seen a need for in"
NSQ_SOURCE_LINE 00000341 "C<HTML::TreeBuilder>, but I include it here on the off chance that someone"
NSQ_SOURCE_LINE 00000342 "might find it of use:"
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "When we see a \"E<lt>pE<gt>\" token, we go lookup up the lineage for a p"
NSQ_SOURCE_LINE 00000345 "element we might have to minimize.  At first sight, we might say that"
NSQ_SOURCE_LINE 00000346 "if there's a p anywhere in the lineage of this new p, it should be"
NSQ_SOURCE_LINE 00000347 "closed.  But that's wrong.  Consider this document:"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "  <html>"
NSQ_SOURCE_LINE 00000350 "    <head>"
NSQ_SOURCE_LINE 00000351 "      <title>foo</title>"
NSQ_SOURCE_LINE 00000352 "    </head>"
NSQ_SOURCE_LINE 00000353 "    <body>"
NSQ_SOURCE_LINE 00000354 "      <p>foo"
NSQ_SOURCE_LINE 00000355 "        <table>"
NSQ_SOURCE_LINE 00000356 "          <tr>"
NSQ_SOURCE_LINE 00000357 "            <td>"
NSQ_SOURCE_LINE 00000358 "               foo"
NSQ_SOURCE_LINE 00000359 "               <p>bar"
NSQ_SOURCE_LINE 00000360 "            </td>"
NSQ_SOURCE_LINE 00000361 "          </tr>"
NSQ_SOURCE_LINE 00000362 "        </table>"
NSQ_SOURCE_LINE 00000363 "      </p>"
NSQ_SOURCE_LINE 00000364 "    </body>"
NSQ_SOURCE_LINE 00000365 "  </html>"
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "The second p is quite legally inside a much higher p."
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "My formalization of the reason why this is legal, but this:"
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "  <p>foo<p>bar</p></p>"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "isn't, is that something about the table constitutes a \"barrier\" to"
NSQ_SOURCE_LINE 00000374 "the application of the rule about what p must minimize."
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "So C<@HTML::Tagset::p_closure_barriers> is the list of all such"
NSQ_SOURCE_LINE 00000377 "barrier-tags."
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "=cut"
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "our @p_closure_barriers = qw("
NSQ_SOURCE_LINE 00000382 "  li blockquote"
NSQ_SOURCE_LINE 00000383 "  ul ol menu dir"
NSQ_SOURCE_LINE 00000384 "  dl dt dd"
NSQ_SOURCE_LINE 00000385 "  td th tr table caption"
NSQ_SOURCE_LINE 00000386 "  div"
NSQ_SOURCE_LINE 00000387 " );"
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "# In an ideal world (i.e., XHTML) we wouldn't have to bother with any of this"
NSQ_SOURCE_LINE 00000390 "# monkey business of barriers to minimization!"
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "=head2 hashset %isCDATA_Parent"
NSQ_SOURCE_LINE 00000393 ""
NSQ_SOURCE_LINE 00000394 "This hashset includes all elements whose content is CDATA."
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "=cut"
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "our %isCDATA_Parent = map { $_ => 1 }"
NSQ_SOURCE_LINE 00000399 "  qw(script style  xmp listing plaintext);"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "# TODO: there's nothing else that takes CDATA children, right?"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "# As the HTML3 DTD (Raggett 1995-04-24) noted:"
NSQ_SOURCE_LINE 00000404 "#   The XMP, LISTING and PLAINTEXT tags are incompatible with SGML"
NSQ_SOURCE_LINE 00000405 "#   and derive from very early versions of HTML. They require non-"
NSQ_SOURCE_LINE 00000406 "#   standard parsers and will cause problems for processing"
NSQ_SOURCE_LINE 00000407 "#   documents with standard SGML tools."
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 ""
NSQ_SOURCE_LINE 00000410 "=head1 CAVEATS"
NSQ_SOURCE_LINE 00000411 ""
NSQ_SOURCE_LINE 00000412 "You may find it useful to alter the behavior of modules (like"
NSQ_SOURCE_LINE 00000413 "C<HTML::Element> or C<HTML::TreeBuilder>) that use C<HTML::Tagset>'s"
NSQ_SOURCE_LINE 00000414 "data tables by altering the data tables themselves.  You are welcome"
NSQ_SOURCE_LINE 00000415 "to try, but be careful; and be aware that different modules may or may"
NSQ_SOURCE_LINE 00000416 "react differently to the data tables being changed."
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 "Note that it may be inappropriate to use these tables for I<producing>"
NSQ_SOURCE_LINE 00000419 "HTML -- for example, C<%isHeadOrBodyElement> lists the tagnames"
NSQ_SOURCE_LINE 00000420 "for all elements that can appear either in the head or in the body,"
NSQ_SOURCE_LINE 00000421 "such as \"script\".  That doesn't mean that I am saying your code that"
NSQ_SOURCE_LINE 00000422 "produces HTML should feel free to put script elements in either place!"
NSQ_SOURCE_LINE 00000423 "If you are producing programs that spit out HTML, you should be"
NSQ_SOURCE_LINE 00000424 "I<intimately> familiar with the DTDs for HTML or XHTML (available at"
NSQ_SOURCE_LINE 00000425 "C<http://www.w3.org/>), and you should slavishly obey them, not"
NSQ_SOURCE_LINE 00000426 "the data tables in this document."
NSQ_SOURCE_LINE 00000427 ""
