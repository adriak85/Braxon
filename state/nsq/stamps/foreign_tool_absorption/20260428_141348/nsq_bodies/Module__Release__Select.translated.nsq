NSQ_SOURCE_LINE 00000168 "sub parse_releases_expr {"
NSQ_SOURCE_LINE 00000169 "    state $re = qr{\\A\\s*$RE\\s*\\z};"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "    local $_ = shift;"
NSQ_SOURCE_LINE 00000172 "    local $^R;"
NSQ_SOURCE_LINE 00000173 "    eval { $_ =~ $re } and return $_;"
NSQ_SOURCE_LINE 00000174 "    die $@ if $@;"
NSQ_SOURCE_LINE 00000175 "    return undef; ## no critic: Subroutines::ProhibitExplicitReturnUndef"
NSQ_SOURCE_LINE 00000176 "}"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "sub _get_verobj {"
NSQ_SOURCE_LINE 00000179 "    my ($pver, $rels) = @_;"
NSQ_SOURCE_LINE 00000180 "    my ($ver0, $verobj0, $index0);"
NSQ_SOURCE_LINE 00000181 "    if ($pver->{literal} eq 'latest') {"
NSQ_SOURCE_LINE 00000182 "        $index0 = 0;"
NSQ_SOURCE_LINE 00000183 "        $ver0 = $rels->[0]{version};"
NSQ_SOURCE_LINE 00000184 "        $verobj0 = version->parse($ver0);"
NSQ_SOURCE_LINE 00000185 "    } elsif ($pver->{literal} eq 'oldest') {"
NSQ_SOURCE_LINE 00000186 "        $index0 = $#{$rels};"
NSQ_SOURCE_LINE 00000187 "        $ver0 = $rels->[-1]{version};"
NSQ_SOURCE_LINE 00000188 "        $verobj0 = version->parse($ver0);"
NSQ_SOURCE_LINE 00000189 "    } else {"
NSQ_SOURCE_LINE 00000190 "        eval { $verobj0 = version->parse($pver->{literal}) };"
NSQ_SOURCE_LINE 00000191 "        die \"Invalid version literal '$pver->{literal}': $@\" if $@;"
NSQ_SOURCE_LINE 00000192 "        for my $i (0 .. $#{$rels}) {"
NSQ_SOURCE_LINE 00000193 "            my $verobj2 = version->parse($rels->[$i]{version});"
NSQ_SOURCE_LINE 00000194 "            if ($verobj2 == $verobj0) {"
NSQ_SOURCE_LINE 00000195 "                $index0 = $i;"
NSQ_SOURCE_LINE 00000196 "                $ver0 = $rels->[$i]{version};"
NSQ_SOURCE_LINE 00000197 "                last;"
NSQ_SOURCE_LINE 00000198 "            }"
NSQ_SOURCE_LINE 00000199 "        }"
NSQ_SOURCE_LINE 00000200 "    }"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "    return ($ver0, $verobj0) unless $pver->{offset};"
NSQ_SOURCE_LINE 00000203 "    die \"Can't compute version $pver->{literal} \"."
NSQ_SOURCE_LINE 00000204 "        ($pver->{offset} > 0 ? \"+ $pver->{offset}\" : \"- \".abs($pver->{offset}))."
NSQ_SOURCE_LINE 00000205 "        \" because that version is not found in releases\""
NSQ_SOURCE_LINE 00000206 "        unless defined $index0;"
NSQ_SOURCE_LINE 00000207 "    my $index = $index0 - $pver->{offset};"
NSQ_SOURCE_LINE 00000208 "    if ($index < 0) {"
NSQ_SOURCE_LINE 00000209 "        warn \"There are no releases newer than (\"."
NSQ_SOURCE_LINE 00000210 "            abs($pver->{offset}).\" release(s) \".($pver->{offset} > 0 ? \"after\" : \"before\").\" $pver->{literal}\"."
NSQ_SOURCE_LINE 00000211 "            \"), will be using the newest release ($rels->[0]{version})\";"
NSQ_SOURCE_LINE 00000212 "        $index = 0;"
NSQ_SOURCE_LINE 00000213 "    } elsif ($index > $#{$rels}) {"
NSQ_SOURCE_LINE 00000214 "        warn \"There are no releases older than (\"."
NSQ_SOURCE_LINE 00000215 "            abs($pver->{offset}).\" release(s) \".($pver->{offset} > 0 ? \"before\" : \"after\").\" $pver->{literal}\"."
NSQ_SOURCE_LINE 00000216 "            \"), will be using the oldest release ($rels->[-1]{version})\";"
NSQ_SOURCE_LINE 00000217 "        $index = $#{$rels};"
NSQ_SOURCE_LINE 00000218 "    }"
NSQ_SOURCE_LINE 00000219 "    ($rels->[$index]{version}, version->parse($rels->[$index]{version}));"
NSQ_SOURCE_LINE 00000220 "}"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "sub select_releases {"
NSQ_SOURCE_LINE 00000223 "    my $opts = ref $_[0] eq 'HASH' ? {%{shift @_}} : {};"
NSQ_SOURCE_LINE 00000224 "    my $expr = shift;"
NSQ_SOURCE_LINE 00000225 "    my $rels = [ map {ref $_ eq 'HASH' ? $_ : {version=>$_}} @{ shift @_ }];"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "  CHECK_RELEASES:"
NSQ_SOURCE_LINE 00000228 "    {"
NSQ_SOURCE_LINE 00000229 "        my $last_verobj;"
NSQ_SOURCE_LINE 00000230 "        for my $i (0..$#{$rels}) {"
NSQ_SOURCE_LINE 00000231 "            my $rel = $rels->[$i];"
NSQ_SOURCE_LINE 00000232 "            if (!defined($rel->{version})) {"
NSQ_SOURCE_LINE 00000233 "                die \"releases[$i]: No version defined\";"
NSQ_SOURCE_LINE 00000234 "            }"
NSQ_SOURCE_LINE 00000235 "            my $verobj;"
NSQ_SOURCE_LINE 00000236 "            eval { $verobj = version->parse($rel->{version}) };"
NSQ_SOURCE_LINE 00000237 "            if ($@) {"
NSQ_SOURCE_LINE 00000238 "                die \"releases[$i]: Invalid version '$rel->{version}': $@\";"
NSQ_SOURCE_LINE 00000239 "            }"
NSQ_SOURCE_LINE 00000240 "            if (defined $last_verobj) {"
NSQ_SOURCE_LINE 00000241 "                unless ($verobj < $last_verobj) {"
NSQ_SOURCE_LINE 00000242 "                    die \"releases[$i]: Not older than previous record; releases must contain release in descending order\";"
NSQ_SOURCE_LINE 00000243 "                }"
NSQ_SOURCE_LINE 00000244 "            }"
NSQ_SOURCE_LINE 00000245 "            $last_verobj = $verobj;"
NSQ_SOURCE_LINE 00000246 "        }"
NSQ_SOURCE_LINE 00000247 "    }"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "    my $pexpr = parse_releases_expr($expr); # \"p\" = parsed"
NSQ_SOURCE_LINE 00000250 "    die \"Can't parse releases expr '$expr'\" unless defined $pexpr;"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "    return unless @$rels;"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "    my @selected_and_rels;"
NSQ_SOURCE_LINE 00000255 "    for my $and_pexpr (@$pexpr) {"
NSQ_SOURCE_LINE 00000256 "        my @selected_comp_rels = @$rels;"
NSQ_SOURCE_LINE 00000257 "        for my $comp_pexpr (@$and_pexpr) {"
NSQ_SOURCE_LINE 00000258 "            my $type = $comp_pexpr->{type};"
NSQ_SOURCE_LINE 00000259 "            my $op   = $comp_pexpr->{op};"
NSQ_SOURCE_LINE 00000260 "            my $code;"
NSQ_SOURCE_LINE 00000261 "            if ($type eq 'version') {"
NSQ_SOURCE_LINE 00000262 "                if ($op eq '=') {"
NSQ_SOURCE_LINE 00000263 "                    die \"Version literal expected after '='\" unless defined $comp_pexpr->{val}{literal};"
NSQ_SOURCE_LINE 00000264 "                    my ($ver, $verobj) = _get_verobj($comp_pexpr->{val}, $rels);"
NSQ_SOURCE_LINE 00000265 "                    $code = sub { version->parse($_[0]{version}) == $verobj };"
NSQ_SOURCE_LINE 00000266 "                } elsif ($op eq '!=') {"
NSQ_SOURCE_LINE 00000267 "                    die \"Version literal expected after '!='\" unless defined $comp_pexpr->{val}{literal};"
NSQ_SOURCE_LINE 00000268 "                    my ($ver, $verobj) = _get_verobj($comp_pexpr->{val}, $rels);"
NSQ_SOURCE_LINE 00000269 "                    $code = sub { version->parse($_[0]{version}) != $verobj };"
NSQ_SOURCE_LINE 00000270 "                } elsif ($op eq '>') {"
NSQ_SOURCE_LINE 00000271 "                    die \"Version literal expected after '='\" unless defined $comp_pexpr->{val}{literal};"
NSQ_SOURCE_LINE 00000272 "                    my ($ver, $verobj) = _get_verobj($comp_pexpr->{val}, $rels);"
NSQ_SOURCE_LINE 00000273 "                    $code = sub { version->parse($_[0]{version}) > $verobj };"
NSQ_SOURCE_LINE 00000274 "                } elsif ($op eq '>=') {"
NSQ_SOURCE_LINE 00000275 "                    die \"Version literal expected after '='\" unless defined $comp_pexpr->{val}{literal};"
NSQ_SOURCE_LINE 00000276 "                    my ($ver, $verobj) = _get_verobj($comp_pexpr->{val}, $rels);"
NSQ_SOURCE_LINE 00000277 "                    $code = sub { version->parse($_[0]{version}) >= $verobj };"
NSQ_SOURCE_LINE 00000278 "                } elsif ($op eq '<') {"
NSQ_SOURCE_LINE 00000279 "                    die \"Version literal expected after '='\" unless defined $comp_pexpr->{val}{literal};"
NSQ_SOURCE_LINE 00000280 "                    my ($ver, $verobj) = _get_verobj($comp_pexpr->{val}, $rels);"
NSQ_SOURCE_LINE 00000281 "                    $code = sub { version->parse($_[0]{version}) < $verobj };"
NSQ_SOURCE_LINE 00000282 "                } elsif ($op eq '<=') {"
NSQ_SOURCE_LINE 00000283 "                    die \"Version literal expected after '='\" unless defined $comp_pexpr->{val}{literal};"
NSQ_SOURCE_LINE 00000284 "                    my ($ver, $verobj) = _get_verobj($comp_pexpr->{val}, $rels);"
NSQ_SOURCE_LINE 00000285 "                    $code = sub { version->parse($_[0]{version}) <= $verobj };"
NSQ_SOURCE_LINE 00000286 "                } elsif ($op eq '=~') {"
NSQ_SOURCE_LINE 00000287 "                    die \"Regexp expected after '=~'\" unless defined $comp_pexpr->{val}{regexp};"
NSQ_SOURCE_LINE 00000288 "                    $code = sub { $_[0]{version} =~ $comp_pexpr->{val}{regexp} };"
NSQ_SOURCE_LINE 00000289 "                } elsif ($op eq '!~') {"
NSQ_SOURCE_LINE 00000290 "                    die \"Regexp expected after '=~'\" unless defined $comp_pexpr->{val}{regexp};"
NSQ_SOURCE_LINE 00000291 "                    $code = sub { $_[0]{version} =~ $comp_pexpr->{val}{regexp} };"
NSQ_SOURCE_LINE 00000292 "                } else {"
NSQ_SOURCE_LINE 00000293 "                    die \"BUG: Unknown operator '$op'\";"
NSQ_SOURCE_LINE 00000294 "                }"
NSQ_SOURCE_LINE 00000295 "            } elsif ($type eq 'author') {"
NSQ_SOURCE_LINE 00000296 "                if ($op eq '=') {"
NSQ_SOURCE_LINE 00000297 "                    die \"String literal expected after '='\" unless defined $comp_pexpr->{val}{literal};"
NSQ_SOURCE_LINE 00000298 "                    $code = sub { die \"Release $_[0]{version} does not have author\" unless defined $_[0]{author}; lc($_[0]{author}) eq lc($comp_pexpr->{val}{literal}) };"
NSQ_SOURCE_LINE 00000299 "                } elsif ($op eq '!=') {"
NSQ_SOURCE_LINE 00000300 "                    die \"String literal expected after '!='\" unless defined $comp_pexpr->{val}{literal};"
NSQ_SOURCE_LINE 00000301 "                    $code = sub { die \"Release $_[0]{version} does not have author\" unless defined $_[0]{author}; lc($_[0]{author}) ne lc($comp_pexpr->{val}{literal}) };"
NSQ_SOURCE_LINE 00000302 "                } elsif ($op eq '>') {"
NSQ_SOURCE_LINE 00000303 "                    die \"String literal expected after '>'\" unless defined $comp_pexpr->{val}{literal};"
NSQ_SOURCE_LINE 00000304 "                    $code = sub { die \"Release $_[0]{version} does not have author\" unless defined $_[0]{author}; lc($_[0]{author}) gt lc($comp_pexpr->{val}{literal}) };"
NSQ_SOURCE_LINE 00000305 "                } elsif ($op eq '>=') {"
NSQ_SOURCE_LINE 00000306 "                    die \"String literal expected after '>='\" unless defined $comp_pexpr->{val}{literal};"
NSQ_SOURCE_LINE 00000307 "                    $code = sub { die \"Release $_[0]{version} does not have author\" unless defined $_[0]{author}; lc($_[0]{author}) ge lc($comp_pexpr->{val}{literal}) };"
NSQ_SOURCE_LINE 00000308 "                } elsif ($op eq '<') {"
NSQ_SOURCE_LINE 00000309 "                    die \"String literal expected after '<'\" unless defined $comp_pexpr->{val}{literal};"
NSQ_SOURCE_LINE 00000310 "                    $code = sub { die \"Release $_[0]{version} does not have author\" unless defined $_[0]{author}; lc($_[0]{author}) lt lc($comp_pexpr->{val}{literal}) };"
NSQ_SOURCE_LINE 00000311 "                } elsif ($op eq '<=') {"
NSQ_SOURCE_LINE 00000312 "                    die \"String literal expected after '<='\" unless defined $comp_pexpr->{val}{literal};"
NSQ_SOURCE_LINE 00000313 "                    $code = sub { die \"Release $_[0]{version} does not have author\" unless defined $_[0]{author}; lc($_[0]{author}) le lc($comp_pexpr->{val}{literal}) };"
NSQ_SOURCE_LINE 00000314 "                } elsif ($op eq '=~') {"
NSQ_SOURCE_LINE 00000315 "                    die \"Regexp expected after '=~'\" unless defined $comp_pexpr->{val}{regexp};"
NSQ_SOURCE_LINE 00000316 "                    $code = sub { die \"Release $_[0]{version} does not have author\" unless defined $_[0]{author}; $_[0]{author} =~ $comp_pexpr->{val}{regexp} };"
NSQ_SOURCE_LINE 00000317 "                } elsif ($op eq '!~') {"
NSQ_SOURCE_LINE 00000318 "                    die \"Regexp expected after '=~'\" unless defined $comp_pexpr->{val}{regexp};"
NSQ_SOURCE_LINE 00000319 "                    $code = sub { die \"Release $_[0]{version} does not have author\" unless defined $_[0]{author}; $_[0]{author} !~ $comp_pexpr->{val}{regexp} };"
NSQ_SOURCE_LINE 00000320 "                } else {"
NSQ_SOURCE_LINE 00000321 "                    die \"BUG: Unknown operator '$op'\";"
NSQ_SOURCE_LINE 00000322 "                }"
NSQ_SOURCE_LINE 00000323 "            } elsif ($type eq 'date') {"
NSQ_SOURCE_LINE 00000324 "                require DateTime;"
NSQ_SOURCE_LINE 00000325 "                require DateTime::Format::Natural;"
NSQ_SOURCE_LINE 00000326 "                if ($op eq '=') {"
NSQ_SOURCE_LINE 00000327 "                    die \"Date literal expected after '='\" unless defined $comp_pexpr->{val}{datetime};"
NSQ_SOURCE_LINE 00000328 "                    $code = sub { my $dt0 = $_[0]{date}; die \"Release $_[0]{version} does not have date\" unless defined $dt0; my $dt = DateTime::Format::Natural->new->parse_datetime($dt0) or die \"Can't parse date literal '$dt0'\"; DateTime->compare($dt, $comp_pexpr->{val}{datetime}) == 0 };"
NSQ_SOURCE_LINE 00000329 "                } elsif ($op eq '!=') {"
NSQ_SOURCE_LINE 00000330 "                    die \"Date literal expected after '='\" unless defined $comp_pexpr->{val}{datetime};"
NSQ_SOURCE_LINE 00000331 "                    $code = sub { my $dt0 = $_[0]{date}; die \"Release $_[0]{version} does not have date\" unless defined $dt0; my $dt = DateTime::Format::Natural->new->parse_datetime($dt0) or die \"Can't parse date literal '$dt0'\"; DateTime->compare($dt, $comp_pexpr->{val}{datetime}) != 0 };"
NSQ_SOURCE_LINE 00000332 "                } elsif ($op eq '>') {"
NSQ_SOURCE_LINE 00000333 "                    die \"Date literal expected after '='\" unless defined $comp_pexpr->{val}{datetime};"
NSQ_SOURCE_LINE 00000334 "                    $code = sub { my $dt0 = $_[0]{date}; die \"Release $_[0]{version} does not have date\" unless defined $dt0; my $dt = DateTime::Format::Natural->new->parse_datetime($dt0) or die \"Can't parse date literal '$dt0'\"; DateTime->compare($dt, $comp_pexpr->{val}{datetime}) > 0 };"
NSQ_SOURCE_LINE 00000335 "                } elsif ($op eq '>=') {"
NSQ_SOURCE_LINE 00000336 "                    die \"Date literal expected after '='\" unless defined $comp_pexpr->{val}{datetime};"
NSQ_SOURCE_LINE 00000337 "                    $code = sub { my $dt0 = $_[0]{date}; die \"Release $_[0]{version} does not have date\" unless defined $dt0; my $dt = DateTime::Format::Natural->new->parse_datetime($dt0) or die \"Can't parse date literal '$dt0'\"; DateTime->compare($dt, $comp_pexpr->{val}{datetime}) >= 0 };"
NSQ_SOURCE_LINE 00000338 "                } elsif ($op eq '<') {"
NSQ_SOURCE_LINE 00000339 "                    die \"Date literal expected after '='\" unless defined $comp_pexpr->{val}{datetime};"
NSQ_SOURCE_LINE 00000340 "                    $code = sub { my $dt0 = $_[0]{date}; die \"Release $_[0]{version} does not have date\" unless defined $dt0; my $dt = DateTime::Format::Natural->new->parse_datetime($dt0) or die \"Can't parse date literal '$dt0'\"; DateTime->compare($dt, $comp_pexpr->{val}{datetime}) < 0 };"
NSQ_SOURCE_LINE 00000341 "                } elsif ($op eq '<=') {"
NSQ_SOURCE_LINE 00000342 "                    die \"Date literal expected after '='\" unless defined $comp_pexpr->{val}{datetime};"
NSQ_SOURCE_LINE 00000343 "                    $code = sub { my $dt0 = $_[0]{date}; die \"Release $_[0]{version} does not have date\" unless defined $dt0; my $dt = DateTime::Format::Natural->new->parse_datetime($dt0) or die \"Can't parse date literal '$dt0'\"; DateTime->compare($dt, $comp_pexpr->{val}{datetime}) <= 0 };"
NSQ_SOURCE_LINE 00000344 "                } elsif ($op eq '=~') {"
NSQ_SOURCE_LINE 00000345 "                    die \"Regexp expected after '=~'\" unless defined $comp_pexpr->{val}{regexp};"
NSQ_SOURCE_LINE 00000346 "                    $code = sub { die \"Release $_[0]{version} does not have date\" unless defined $_[0]{date}; $_[0]{date} =~ $comp_pexpr->{val}{regexp} };"
NSQ_SOURCE_LINE 00000347 "                } elsif ($op eq '!~') {"
NSQ_SOURCE_LINE 00000348 "                    die \"Regexp expected after '=~'\" unless defined $comp_pexpr->{val}{regexp};"
NSQ_SOURCE_LINE 00000349 "                    $code = sub { die \"Release $_[0]{version} does not have date\" unless defined $_[0]{date}; $_[0]{date} !~ $comp_pexpr->{val}{regexp} };"
NSQ_SOURCE_LINE 00000350 "                } else {"
NSQ_SOURCE_LINE 00000351 "                    die \"BUG: Unknown operator '$op'\";"
NSQ_SOURCE_LINE 00000352 "                }"
NSQ_SOURCE_LINE 00000353 "            } else {"
NSQ_SOURCE_LINE 00000354 "                die \"BUG: Unknown comparison type '$type'\";"
NSQ_SOURCE_LINE 00000355 "            }"
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "            @selected_comp_rels = grep { $code->($_) } @selected_comp_rels;"
NSQ_SOURCE_LINE 00000358 "            #use Data::Dmp (); use DD; print \"result of selecting \".Data::Dmp::dmp($comp_pexpr).\": \"; dd \\@selected_comp_rels;"
NSQ_SOURCE_LINE 00000359 "        } # for comp_pexpr"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "      L1:"
NSQ_SOURCE_LINE 00000362 "        for my $rel (@selected_comp_rels) {"
NSQ_SOURCE_LINE 00000363 "            # do not add if already added"
NSQ_SOURCE_LINE 00000364 "            for (@selected_and_rels) { last L1 if \"$_\" eq \"$rel\" }"
NSQ_SOURCE_LINE 00000365 "            push @selected_and_rels, $rel;"
NSQ_SOURCE_LINE 00000366 "        }"
NSQ_SOURCE_LINE 00000367 "    } # for and_expr"
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "    # sort"
NSQ_SOURCE_LINE 00000370 "    @selected_and_rels = sort { version->parse($b->{version}) <=> version->parse($a->{version}) } @selected_and_rels;"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "    if ($opts->{single}) {"
NSQ_SOURCE_LINE 00000373 "        if ($opts->{oldest}) {"
NSQ_SOURCE_LINE 00000374 "            @selected_and_rels = @selected_and_rels ? ($selected_and_rels[-1]) : ();"
NSQ_SOURCE_LINE 00000375 "        } else {"
NSQ_SOURCE_LINE 00000376 "            @selected_and_rels = @selected_and_rels ? ($selected_and_rels[0]) : ();"
NSQ_SOURCE_LINE 00000377 "        }"
NSQ_SOURCE_LINE 00000378 "    }"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "    if ($opts->{detail}) {"
NSQ_SOURCE_LINE 00000381 "        @selected_and_rels;"
NSQ_SOURCE_LINE 00000382 "    } else {"
NSQ_SOURCE_LINE 00000383 "        map {$_->{version}} @selected_and_rels;"
NSQ_SOURCE_LINE 00000384 "    }"
NSQ_SOURCE_LINE 00000385 "}"
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "sub select_release {"
NSQ_SOURCE_LINE 00000388 "    my $opts = ref $_[0] eq 'HASH' ? {%{shift @_}} : {};"
NSQ_SOURCE_LINE 00000389 "    my $expr = shift;"
NSQ_SOURCE_LINE 00000390 "    my $rels = shift;"
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "    $opts->{single} = 1;"
NSQ_SOURCE_LINE 00000393 "    my @rels = select_releases($opts, $expr, $rels);"
NSQ_SOURCE_LINE 00000394 "    return undef unless @rels; ## no critic: Subroutines::ProhibitExplicitReturnUndef"
NSQ_SOURCE_LINE 00000395 "    $rels[0];"
NSQ_SOURCE_LINE 00000396 "}"
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "1;"
NSQ_SOURCE_LINE 00000399 "# ABSTRACT: Notation to select release(s)"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "__END__"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "=pod"
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "=head1 NAME"
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "Module::Release::Select - Notation to select release(s)"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "=head1 VERSION"
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "This document describes version 0.002 of Module::Release::Select (from Perl distribution Module-Release-Select), released on 2023-01-15."
NSQ_SOURCE_LINE 00000414 ""
NSQ_SOURCE_LINE 00000415 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000416 ""
NSQ_SOURCE_LINE 00000417 " use Module::Release::Select qw(select_release select_releases);"
NSQ_SOURCE_LINE 00000418 ""
NSQ_SOURCE_LINE 00000419 " my @releases = (0.005, 0.004, 0.003, 0.002, 0.001);"
NSQ_SOURCE_LINE 00000420 ""
NSQ_SOURCE_LINE 00000421 " my $rel = select_release('0.002', \\@releases);       # => 0.002"
NSQ_SOURCE_LINE 00000422 " my $rel = select_release('0.002 + 1', \\@releases);   # => 0.003"
NSQ_SOURCE_LINE 00000423 " my $rel = select_release('> 0.002', \\@releases);     # => 0.005"
NSQ_SOURCE_LINE 00000424 " my $rel = select_release('latest', \\@releases);      # => 0.005"
NSQ_SOURCE_LINE 00000425 " my $rel = select_release('latest-1', \\@releases);    # => 0.004"
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 " my @rels = select_releases('> oldest', \\@releases);  # => (0.005, 0.004, 0.003, 0.002)"
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000430 ""
NSQ_SOURCE_LINE 00000431 "This module lets you select one or more releases via an expression. Some example"
NSQ_SOURCE_LINE 00000432 "expressions:"
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 " # exact version number ('=')"
NSQ_SOURCE_LINE 00000435 " 0.002"
NSQ_SOURCE_LINE 00000436 " =0.002     # ditto"
NSQ_SOURCE_LINE 00000437 ""
NSQ_SOURCE_LINE 00000438 " # version number range with '>', '>=', '<', '<=', '!='. use '&' to join"
NSQ_SOURCE_LINE 00000439 " # multiple conditions with \"and\" logic, use '|' or ',' to join with \"or\" logic."
NSQ_SOURCE_LINE 00000440 " >0.002"
NSQ_SOURCE_LINE 00000441 " >=0.002"
NSQ_SOURCE_LINE 00000442 " >=0.002 & <=0.015"
NSQ_SOURCE_LINE 00000443 " <0.002 | >0.015"
NSQ_SOURCE_LINE 00000444 " 0.001, 0.002, 0.003"
NSQ_SOURCE_LINE 00000445 ""
NSQ_SOURCE_LINE 00000446 " # \"latest\" and \"oldest\" can replace version number"
NSQ_SOURCE_LINE 00000447 " latest"
NSQ_SOURCE_LINE 00000448 " =latest"
NSQ_SOURCE_LINE 00000449 " <latest           # all releases except the latest"
NSQ_SOURCE_LINE 00000450 " != latest         # ditto"
NSQ_SOURCE_LINE 00000451 " >oldest           # all releases except the oldest"
NSQ_SOURCE_LINE 00000452 ""
NSQ_SOURCE_LINE 00000453 " # +n and -m to refer to n releases after and n releases before"
NSQ_SOURCE_LINE 00000454 " latest-1       # the release before the latest"
NSQ_SOURCE_LINE 00000455 " 0.002 + 1      # the release after 0.002"
NSQ_SOURCE_LINE 00000456 " > (oldest+1)   # all releases except the oldest and one after that (oldest+1)"
NSQ_SOURCE_LINE 00000457 ""
NSQ_SOURCE_LINE 00000458 " # select by date, any date supported by DateTime::Format::Natural is supported"
NSQ_SOURCE_LINE 00000459 " date < {yesterday}      # all releases released 2 days ago"
NSQ_SOURCE_LINE 00000460 " date > {2 months ago}   # all releases after 2 months ago"
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 " # select by author"
NSQ_SOURCE_LINE 00000463 " author=\"PERLANCAR\"             # all releases released by PERLANCAR"
NSQ_SOURCE_LINE 00000464 " author != \"PERLANCAR\"          # all releases not released by PERLANCAR"
NSQ_SOURCE_LINE 00000465 " author=\"PERLANCAR\" & > 0.005   # all releases after 0.005 that are released by PERLANCAR"
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "To actually select releases, you provide a list of releases in the form of"
NSQ_SOURCE_LINE 00000468 "version numbers in descending order. If you want to select by date or author,"
NSQ_SOURCE_LINE 00000469 "each release will need to be a hashref containing C<date> and C<author> keys."
NSQ_SOURCE_LINE 00000470 "Below is an example of a list of releases for L<App::orgadb> distribution. This"
NSQ_SOURCE_LINE 00000471 "structure is returned by L<App::MetaCPANUtils>' C<list_metacpan_release>:"
NSQ_SOURCE_LINE 00000472 ""
NSQ_SOURCE_LINE 00000473 " my @releases = ("
NSQ_SOURCE_LINE 00000474 "    {"
NSQ_SOURCE_LINE 00000475 "      abstract     => \"An opinionated Org addressbook toolset\","
NSQ_SOURCE_LINE 00000476 "      author       => \"PERLANCAR\","
NSQ_SOURCE_LINE 00000477 "      date         => \"2022-11-04T12:57:07\","
NSQ_SOURCE_LINE 00000478 "      distribution => \"App-orgadb\","
NSQ_SOURCE_LINE 00000479 "      first        => \"\","
NSQ_SOURCE_LINE 00000480 "      maturity     => \"released\","
NSQ_SOURCE_LINE 00000481 "      release      => \"App-orgadb-0.015\","
NSQ_SOURCE_LINE 00000482 "      status       => \"latest\","
NSQ_SOURCE_LINE 00000483 "      version      => 0.015,"
NSQ_SOURCE_LINE 00000484 "    },"
NSQ_SOURCE_LINE 00000485 "    ..."
NSQ_SOURCE_LINE 00000486 "    {"
NSQ_SOURCE_LINE 00000487 "      abstract     => \"An opinionated Org addressbook tool\","
NSQ_SOURCE_LINE 00000488 "      author       => \"PERLANCAR\","
NSQ_SOURCE_LINE 00000489 "      date         => \"2022-06-23T23:21:58\","
NSQ_SOURCE_LINE 00000490 "      distribution => \"App-orgadb\","
NSQ_SOURCE_LINE 00000491 "      first        => \"\","
NSQ_SOURCE_LINE 00000492 "      maturity     => \"released\","
NSQ_SOURCE_LINE 00000493 "      release      => \"App-orgadb-0.002\","
NSQ_SOURCE_LINE 00000494 "      status       => \"backpan\","
NSQ_SOURCE_LINE 00000495 "      version      => 0.002,"
NSQ_SOURCE_LINE 00000496 "    },"
NSQ_SOURCE_LINE 00000497 "    {"
NSQ_SOURCE_LINE 00000498 "      abstract     => \"An opinionated Org addressbook tool\","
NSQ_SOURCE_LINE 00000499 "      author       => \"PERLANCAR\","
NSQ_SOURCE_LINE 00000500 "      date         => \"2022-06-13T00:15:18\","
NSQ_SOURCE_LINE 00000501 "      distribution => \"App-orgadb\","
NSQ_SOURCE_LINE 00000502 "      first        => 1,"
NSQ_SOURCE_LINE 00000503 "      maturity     => \"released\","
NSQ_SOURCE_LINE 00000504 "      release      => \"App-orgadb-0.001\","
NSQ_SOURCE_LINE 00000505 "      status       => \"backpan\","
NSQ_SOURCE_LINE 00000506 "      version      => 0.001,"
NSQ_SOURCE_LINE 00000507 "    },"
NSQ_SOURCE_LINE 00000508 " );"
NSQ_SOURCE_LINE 00000509 ""
NSQ_SOURCE_LINE 00000510 "Some examples on selecting release(s):"
NSQ_SOURCE_LINE 00000511 ""
NSQ_SOURCE_LINE 00000512 " # select a single release, if notation selects multiple releases, the latest"
NSQ_SOURCE_LINE 00000513 " # one will be picked. returns undef when no releases are selected."
NSQ_SOURCE_LINE 00000514 " my $rel = select_release('0.002', \\@releases);       # => 0.002"
NSQ_SOURCE_LINE 00000515 " my $rel = select_release('0.002 + 1', \\@releases);   # => 0.003"
NSQ_SOURCE_LINE 00000516 " my $rel = select_release('> 0.002', \\@releases);     # => 0.015"
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 " # instead of returning the latest one when multiple releases are selected,"
NSQ_SOURCE_LINE 00000519 " # select the oldest instead."
NSQ_SOURCE_LINE 00000520 " my $rel = select_release({oldest=>1}, '> 0.002', \\@releases);     # => 0.003"
NSQ_SOURCE_LINE 00000521 ""
NSQ_SOURCE_LINE 00000522 " # return detailed record instead of just version"
NSQ_SOURCE_LINE 00000523 " my $rel = select_release({detail=>1}, '0.002', \\@releases); # => {version=>0.002, date=>'2022-06-23T23:21:58', ...}"
NSQ_SOURCE_LINE 00000524 ""
NSQ_SOURCE_LINE 00000525 " # select releases, returns empty list when no releases are selected"
NSQ_SOURCE_LINE 00000526 " my $rel = select_releases('>= latest-2 & <= latest', \\@releases);   # => 0.015, 0.014, 0.013"
NSQ_SOURCE_LINE 00000527 ""
NSQ_SOURCE_LINE 00000528 "=head2 Expression grammar"
NSQ_SOURCE_LINE 00000529 ""
NSQ_SOURCE_LINE 00000530 " EXPR ::= AND_EXPR ( (\",\" | \"|\") AND_EXPR )*"
NSQ_SOURCE_LINE 00000531 ""
NSQ_SOURCE_LINE 00000532 " AND_EXPR ::= SIMPLE_EXPR ( \"&\" SIMPLE_EXPR )*"
NSQ_SOURCE_LINE 00000533 ""
NSQ_SOURCE_LINE 00000534 " SIMPLE_EXPR ::= COMP"
NSQ_SOURCE_LINE 00000535 ""
NSQ_SOURCE_LINE 00000536 " COMP ::= VER_COMP"
NSQ_SOURCE_LINE 00000537 "        | DATE_COMP"
NSQ_SOURCE_LINE 00000538 "        | AUTHOR_COMP"
NSQ_SOURCE_LINE 00000539 ""
NSQ_SOURCE_LINE 00000540 " VER_COMP ::= \"version\" OP VER_VALUE"
NSQ_SOURCE_LINE 00000541 "            | OP VER_VALUE"
NSQ_SOURCE_LINE 00000542 "            | VER_VALUE              ; for when OP ='='"
NSQ_SOURCE_LINE 00000543 ""
NSQ_SOURCE_LINE 00000544 " DATE_COMP ::= \"date\" OP DATE_VAL"
NSQ_SOURCE_LINE 00000545 ""
NSQ_SOURCE_LINE 00000546 " AUTHOR_COMP ::= \"author\" OP STR_VAL"
NSQ_SOURCE_LINE 00000547 ""
NSQ_SOURCE_LINE 00000548 " OP ::= \"=\" | \"!=\" | \">\" | \">=\" | \"<\" | \"<=\" | \"=~\" | \"!~\""
NSQ_SOURCE_LINE 00000549 ""
NSQ_SOURCE_LINE 00000550 " VER_VALUE ::= VER_LITERAL"
NSQ_SOURCE_LINE 00000551 "             | VER_OFFSET"
NSQ_SOURCE_LINE 00000552 ""
NSQ_SOURCE_LINE 00000553 " VER_OFFSET ::= VER_LITERAL (\"+\" | \"-\") [0-9]+"
NSQ_SOURCE_LINE 00000554 ""
NSQ_SOURCE_LINE 00000555 " STR_VAL ::= STR_LITERAL"
NSQ_SOURCE_LINE 00000556 ""
NSQ_SOURCE_LINE 00000557 " STR_LITERAL ::= '\"' ( [^\"\\] | \"\\\\\" | \"\\\" '\"' )* '\"'"
NSQ_SOURCE_LINE 00000558 ""
NSQ_SOURCE_LINE 00000559 " DATE_VAL ::= DATE_LITERAL"
NSQ_SOURCE_LINE 00000560 ""
NSQ_SOURCE_LINE 00000561 " DATE_LITERAL ::= \"{\" [^{]+ \"}\""
NSQ_SOURCE_LINE 00000562 ""
NSQ_SOURCE_LINE 00000563 " VER_LITERAL ::= (\"v\")? [0-9]+ ( \".\" [0-9]+ )*"
NSQ_SOURCE_LINE 00000564 "               | (\"v\")? [0-9]+ ( \".\" [0-9]+ )+ ( \"_\" [0-9]+ )?"
NSQ_SOURCE_LINE 00000565 "               | \"latest\""
NSQ_SOURCE_LINE 00000566 "               | \"oldest\""
NSQ_SOURCE_LINE 00000567 ""
NSQ_SOURCE_LINE 00000568 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000569 ""
NSQ_SOURCE_LINE 00000570 "=head2 parse_releases_expr"
NSQ_SOURCE_LINE 00000571 ""
NSQ_SOURCE_LINE 00000572 " my $parsed = parse_releases_expr($expr_str);"
NSQ_SOURCE_LINE 00000573 ""
NSQ_SOURCE_LINE 00000574 "Parse an expression string and return parsed structure. Mostly for internal use"
NSQ_SOURCE_LINE 00000575 "only."
NSQ_SOURCE_LINE 00000576 ""
NSQ_SOURCE_LINE 00000577 "=head2 select_releases"
NSQ_SOURCE_LINE 00000578 ""
NSQ_SOURCE_LINE 00000579 " my @rels = select_release( [ \\%opts , ] $expr, \\@releases );"
NSQ_SOURCE_LINE 00000580 ""
NSQ_SOURCE_LINE 00000581 "Select releases from C<@releases> using expression C<$expr>. Will die on invalid"
NSQ_SOURCE_LINE 00000582 "syntax in expression or on invalid entry in C<@releases>."
NSQ_SOURCE_LINE 00000583 ""
NSQ_SOURCE_LINE 00000584 "Known options:"
NSQ_SOURCE_LINE 00000585 ""
NSQ_SOURCE_LINE 00000586 "=over"
NSQ_SOURCE_LINE 00000587 ""
NSQ_SOURCE_LINE 00000588 "=item * detail"
NSQ_SOURCE_LINE 00000589 ""
NSQ_SOURCE_LINE 00000590 "Bool. If true, will return detailed release records instead of just version"
NSQ_SOURCE_LINE 00000591 "numbers."
NSQ_SOURCE_LINE 00000592 ""
NSQ_SOURCE_LINE 00000593 "=item * single"
NSQ_SOURCE_LINE 00000594 ""
NSQ_SOURCE_LINE 00000595 "Bool. If true, will return only a single release instead of multiple."
NSQ_SOURCE_LINE 00000596 ""
NSQ_SOURCE_LINE 00000597 "=item * oldest"
NSQ_SOURCE_LINE 00000598 ""
NSQ_SOURCE_LINE 00000599 "Bool. By default, when expression selects multiple releases and only one is"
NSQ_SOURCE_LINE 00000600 "requested, the newest is returned. If this option is set to true, then the"
NSQ_SOURCE_LINE 00000601 "oldest will be returned instead."
NSQ_SOURCE_LINE 00000602 ""
NSQ_SOURCE_LINE 00000603 "=back"
NSQ_SOURCE_LINE 00000604 ""
NSQ_SOURCE_LINE 00000605 "=head2 select_release"
NSQ_SOURCE_LINE 00000606 ""
NSQ_SOURCE_LINE 00000607 "Usage:"
NSQ_SOURCE_LINE 00000608 ""
NSQ_SOURCE_LINE 00000609 " my $rel = select_release( [ \\%opts , ] $expr, \\@releases );"
NSQ_SOURCE_LINE 00000610 ""
NSQ_SOURCE_LINE 00000611 "Equivalent to C<< select_releases({%opts, single=>1}, $expr, \\@releases) >>. See"
NSQ_SOURCE_LINE 00000612 "L</select_releases> for more details on list of known options."
NSQ_SOURCE_LINE 00000613 ""
NSQ_SOURCE_LINE 00000614 "=head1 TODO"
NSQ_SOURCE_LINE 00000615 ""
NSQ_SOURCE_LINE 00000616 "These notations are not yet supported but might be supported in the future:"
NSQ_SOURCE_LINE 00000617 ""
NSQ_SOURCE_LINE 00000618 " # \"latest\" & \"oldest\" can take argument"
NSQ_SOURCE_LINE 00000619 " latest(author=\"PERLANCAR\")       # the latest release by PERLANCAR"
NSQ_SOURCE_LINE 00000620 " latest(author=\"PERLANCAR\") + 1   # the release after the latest release by PERLANCAR"
NSQ_SOURCE_LINE 00000621 " oldest(date > {2022-10-01})      # the oldest release after 2022-10-01"
NSQ_SOURCE_LINE 00000622 ""
NSQ_SOURCE_LINE 00000623 " # functions"
NSQ_SOURCE_LINE 00000624 ""
NSQ_SOURCE_LINE 00000625 " # abstract =~ /foo/              # all releases with abstract matching a regex"
NSQ_SOURCE_LINE 00000626 ""
NSQ_SOURCE_LINE 00000627 " # distribution ne \"App-orgadb\"   # all releases with distribution not equal to \"App-orgadb\""
NSQ_SOURCE_LINE 00000628 ""
NSQ_SOURCE_LINE 00000629 " # first is true                  # all releases with \"first\" key being true"
NSQ_SOURCE_LINE 00000630 ""
NSQ_SOURCE_LINE 00000631 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000632 ""
NSQ_SOURCE_LINE 00000633 "Please visit the project's homepage at L<https://metacpan.org/release/Module-Release-Select>."
NSQ_SOURCE_LINE 00000634 ""
NSQ_SOURCE_LINE 00000635 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000636 ""
NSQ_SOURCE_LINE 00000637 "Source repository is at L<https://github.com/perlancar/perl-Module-Release-Select>."
NSQ_SOURCE_LINE 00000638 ""
NSQ_SOURCE_LINE 00000639 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000640 ""
NSQ_SOURCE_LINE 00000641 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000642 ""
NSQ_SOURCE_LINE 00000643 "perlancar <perlancar@cpan.org>"
NSQ_SOURCE_LINE 00000644 ""
NSQ_SOURCE_LINE 00000645 "=head1 CONTRIBUTING"
NSQ_SOURCE_LINE 00000646 ""
NSQ_SOURCE_LINE 00000647 ""
NSQ_SOURCE_LINE 00000648 "To contribute, you can send patches by email/via RT, or send pull requests on"
NSQ_SOURCE_LINE 00000649 "GitHub."
NSQ_SOURCE_LINE 00000650 ""
NSQ_SOURCE_LINE 00000651 "Most of the time, you don't need to build the distribution yourself. You can"
NSQ_SOURCE_LINE 00000652 "simply modify the code, then test via:"
NSQ_SOURCE_LINE 00000653 ""
NSQ_SOURCE_LINE 00000654 " % prove -l"
NSQ_SOURCE_LINE 00000655 ""
NSQ_SOURCE_LINE 00000656 "If you want to build the distribution (e.g. to try to install it locally on your"
NSQ_SOURCE_LINE 00000657 "system), you can install L<Dist::Zilla>,"
NSQ_SOURCE_LINE 00000658 "L<Dist::Zilla::PluginBundle::Author::PERLANCAR>,"
NSQ_SOURCE_LINE 00000659 "L<Pod::Weaver::PluginBundle::Author::PERLANCAR>, and sometimes one or two other"
NSQ_SOURCE_LINE 00000660 "Dist::Zilla- and/or Pod::Weaver plugins. Any additional steps required beyond"
NSQ_SOURCE_LINE 00000661 "that are considered a bug and can be reported to me."
NSQ_SOURCE_LINE 00000662 ""
