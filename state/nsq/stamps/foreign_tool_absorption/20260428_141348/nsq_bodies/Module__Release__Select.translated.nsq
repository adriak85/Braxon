NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "our $RE ="
NSQ_SOURCE_LINE 00000051 "    qr{"
NSQ_SOURCE_LINE 00000052 "          (?&EXPR) (?{ $_ = $^R->[1] })"
NSQ_SOURCE_LINE 00000053 "          #(?&SIMPLE_EXPR) (?{ $_ = $^R->[1] })"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "          (?(DEFINE)"
NSQ_SOURCE_LINE 00000056 "              (?<EXPR>"
NSQ_SOURCE_LINE 00000057 "                  (?{ [$^R, []] })"
NSQ_SOURCE_LINE 00000058 "                  (?&AND_EXPR)"
NSQ_SOURCE_LINE 00000059 "                  (?{ [$^R->[0][0], [$^R->[1]]] })"
NSQ_SOURCE_LINE 00000060 "                  (?:"
NSQ_SOURCE_LINE 00000061 "                      \\s*[,|]\\s*"
NSQ_SOURCE_LINE 00000062 "                      (?&AND_EXPR)"
NSQ_SOURCE_LINE 00000063 "                      (?{"
NSQ_SOURCE_LINE 00000064 "                          push @{$^R->[0][1]}, $^R->[1];"
NSQ_SOURCE_LINE 00000065 "                          $^R->[0];"
NSQ_SOURCE_LINE 00000066 "                      })"
NSQ_SOURCE_LINE 00000067 "                  )*"
NSQ_SOURCE_LINE 00000068 "                  \\s*"
NSQ_SOURCE_LINE 00000069 "              ) # EXPR"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "              (?<AND_EXPR>"
NSQ_SOURCE_LINE 00000072 "                  (?{ [$^R, []] })"
NSQ_SOURCE_LINE 00000073 "                  (?&SIMPLE_EXPR)"
NSQ_SOURCE_LINE 00000074 "                  (?{ [$^R->[0][0], [$^R->[1]]] })"
NSQ_SOURCE_LINE 00000075 "                  (?:"
NSQ_SOURCE_LINE 00000076 "                      \\s*[&]\\s*"
NSQ_SOURCE_LINE 00000077 "                      (?&SIMPLE_EXPR)"
NSQ_SOURCE_LINE 00000078 "                      (?{"
NSQ_SOURCE_LINE 00000079 "                          push @{$^R->[0][1]}, $^R->[1];"
NSQ_SOURCE_LINE 00000080 "                          $^R->[0];"
NSQ_SOURCE_LINE 00000081 "                      })"
NSQ_SOURCE_LINE 00000082 "                  )*"
NSQ_SOURCE_LINE 00000083 "                  \\s*"
NSQ_SOURCE_LINE 00000084 "              ) # AND_EXPR"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "              (?<SIMPLE_EXPR>"
NSQ_SOURCE_LINE 00000087 "                  (?:"
NSQ_SOURCE_LINE 00000088 "                      (?:"
NSQ_SOURCE_LINE 00000089 "                          # ver_comp"
NSQ_SOURCE_LINE 00000090 "                          (?: version \\s*)?"
NSQ_SOURCE_LINE 00000091 "                          ((?&OP))? \\s*"
NSQ_SOURCE_LINE 00000092 "                          (?{ [$^R, {type=>\"version\", op=> $^N // \"=\" }] })"
NSQ_SOURCE_LINE 00000093 "                          (?:"
NSQ_SOURCE_LINE 00000094 "                              ((?&VER_VALUE))"
NSQ_SOURCE_LINE 00000095 "                              (?{ $^R->[0][1]{val} = $^R->[1]; $^R->[0] })"
NSQ_SOURCE_LINE 00000096 "                          |"
NSQ_SOURCE_LINE 00000097 "                              ((?&REGEX))"
NSQ_SOURCE_LINE 00000098 "                              (?{ $^R->[0][1]{val} = $^R->[1]; $^R->[0] })"
NSQ_SOURCE_LINE 00000099 "                          )"
NSQ_SOURCE_LINE 00000100 "                      )"
NSQ_SOURCE_LINE 00000101 "                  |"
NSQ_SOURCE_LINE 00000102 "                      (?:"
NSQ_SOURCE_LINE 00000103 "                          # date_comp"
NSQ_SOURCE_LINE 00000104 "                          date \\s*"
NSQ_SOURCE_LINE 00000105 "                          ((?&OP)) \\s*"
NSQ_SOURCE_LINE 00000106 "                          (?{ [$^R, {type=>\"date\", op=> $^N }] })"
NSQ_SOURCE_LINE 00000107 "                          (?:"
NSQ_SOURCE_LINE 00000108 "                              # DATE_VALUE"
NSQ_SOURCE_LINE 00000109 "                              \\{ ([^\\{]+) \\}"
NSQ_SOURCE_LINE 00000110 "                              (?{ $^R->[1]{val} = {datetime=>_parse_date($^N)}; $^R })"
NSQ_SOURCE_LINE 00000111 "                          |"
NSQ_SOURCE_LINE 00000112 "                              ((?&REGEX))"
NSQ_SOURCE_LINE 00000113 "                              (?{ $^R->[0][1]{val} = $^R->[1]; $^R->[0] })"
NSQ_SOURCE_LINE 00000114 "                          )"
NSQ_SOURCE_LINE 00000115 "                      )"
NSQ_SOURCE_LINE 00000116 "                  |"
NSQ_SOURCE_LINE 00000117 "                      (?:"
NSQ_SOURCE_LINE 00000118 "                          # author_comp"
NSQ_SOURCE_LINE 00000119 "                          author \\s*"
NSQ_SOURCE_LINE 00000120 "                          ((?&OP)) \\s*"
NSQ_SOURCE_LINE 00000121 "                          (?{ [$^R, {type=>\"author\", op=> $^N }] })"
NSQ_SOURCE_LINE 00000122 "                          (?:"
NSQ_SOURCE_LINE 00000123 "                              # STR_VALUE"
NSQ_SOURCE_LINE 00000124 "                              (\\\" (?:[^\"]+|\\\\\\\\|\\\\\")* \\\")"
NSQ_SOURCE_LINE 00000125 "                              (?{ $^R->[1]{val} = _parse_string($^N); $^R })"
NSQ_SOURCE_LINE 00000126 "                          |"
NSQ_SOURCE_LINE 00000127 "                              ((?&REGEX))"
NSQ_SOURCE_LINE 00000128 "                              (?{ $^R->[0][1]{val} = $^R->[1]; $^R->[0] })"
NSQ_SOURCE_LINE 00000129 "                          )"
NSQ_SOURCE_LINE 00000130 "                      )"
NSQ_SOURCE_LINE 00000131 "                  )"
NSQ_SOURCE_LINE 00000132 "              ) # SIMPLE_EXPR"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "              (?<OP>"
NSQ_SOURCE_LINE 00000135 "                  =|!=|<|>|<=|>=|=~|!~"
NSQ_SOURCE_LINE 00000136 "              )"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "              (?<VER_VALUE>"
NSQ_SOURCE_LINE 00000139 "                  ((?&VER_LITERAL)) \\s*"
NSQ_SOURCE_LINE 00000140 "                  (?{ [$^R, {literal=>$^N, offset=>0}] })"
NSQ_SOURCE_LINE 00000141 "                  (?:"
NSQ_SOURCE_LINE 00000142 "                      \\s* ([+-] \\s* [0-9]+) \\s*"
NSQ_SOURCE_LINE 00000143 "                      (?{ $^R->[1]{offset} = _remove_space($^N); $^R })"
NSQ_SOURCE_LINE 00000144 "                  )?"
NSQ_SOURCE_LINE 00000145 "              )"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "              (?<REGEX>"
NSQ_SOURCE_LINE 00000148 "                  (/(?:[^/]+|\\\\/)*/)"
NSQ_SOURCE_LINE 00000149 "                  (?{ [$^R, {regexp=>_parse_regexp($^N)}] })"
NSQ_SOURCE_LINE 00000150 "              )"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "              (?<VER_LITERAL>"
NSQ_SOURCE_LINE 00000153 "                  ("
NSQ_SOURCE_LINE 00000154 "                      v?"
NSQ_SOURCE_LINE 00000155 "                      ("
NSQ_SOURCE_LINE 00000156 "                          [0-9]+(?:\\.[0-9]+)+(?:_[0-9]+)"
NSQ_SOURCE_LINE 00000157 "                      |"
NSQ_SOURCE_LINE 00000158 "                          [0-9]+(?:\\.[0-9]+)*"
NSQ_SOURCE_LINE 00000159 "                      )"
NSQ_SOURCE_LINE 00000160 "                  )"
NSQ_SOURCE_LINE 00000161 "              |   latest"
NSQ_SOURCE_LINE 00000162 "              |   oldest"
NSQ_SOURCE_LINE 00000163 "              ) # VER_LITERAL"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "          ) # DEFINE"
NSQ_SOURCE_LINE 00000166 "  }x;"
