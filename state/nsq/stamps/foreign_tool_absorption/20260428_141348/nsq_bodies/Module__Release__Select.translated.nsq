NSQ_SOURCE_LINE 00000037 "sub _parse_date {"
NSQ_SOURCE_LINE 00000038 "    require DateTime::Format::Natural;"
NSQ_SOURCE_LINE 00000039 "    my $str = shift;"
NSQ_SOURCE_LINE 00000040 "    my $dt = DateTime::Format::Natural->new->parse_datetime($str);"
NSQ_SOURCE_LINE 00000041 "    die \"Unknown datetime expression $str\" unless defined $dt;"
NSQ_SOURCE_LINE 00000042 "    $dt;"
NSQ_SOURCE_LINE 00000043 "}"
