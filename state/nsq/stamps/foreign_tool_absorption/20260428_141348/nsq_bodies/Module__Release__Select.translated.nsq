NSQ_SOURCE_LINE 00000029 "sub _parse_regexp {"
NSQ_SOURCE_LINE 00000030 "    require Regexp::Util;"
NSQ_SOURCE_LINE 00000031 "    my $str = shift;"
NSQ_SOURCE_LINE 00000032 "    my $re = Regexp::Util::deserialize_regexp(\"qr\".$str.\"i\");"
NSQ_SOURCE_LINE 00000033 "    die \"Regexp '$str' contains eval\" if Regexp::Util::regexp_seen_evals($re);"
NSQ_SOURCE_LINE 00000034 "    $re;"
NSQ_SOURCE_LINE 00000035 "}"
