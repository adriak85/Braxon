NSQ_SOURCE_LINE 00000023 "sub _remove_space {"
NSQ_SOURCE_LINE 00000024 "    my $str = shift;"
NSQ_SOURCE_LINE 00000025 "    $str =~ s/\\s+//g;"
NSQ_SOURCE_LINE 00000026 "    $str;"
