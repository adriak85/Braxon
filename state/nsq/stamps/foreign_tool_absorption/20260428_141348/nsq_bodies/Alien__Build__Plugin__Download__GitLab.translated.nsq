NSQ_SOURCE_LINE 00000001 "package Alien::Build::Plugin::Download::GitLab;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 "use 5.008004;"
NSQ_SOURCE_LINE 00000006 "use Carp qw( croak );"
NSQ_SOURCE_LINE 00000007 "use URI;"
NSQ_SOURCE_LINE 00000008 "use JSON::PP qw( decode_json );"
NSQ_SOURCE_LINE 00000009 "use URI::Escape qw( uri_escape );"
NSQ_SOURCE_LINE 00000010 "use Alien::Build::Plugin;"
NSQ_SOURCE_LINE 00000011 "use File::Basename qw( basename );"
NSQ_SOURCE_LINE 00000012 "use Path::Tiny qw( path );"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "# ABSTRACT: Alien::Build plugin to download from GitLab"
NSQ_SOURCE_LINE 00000015 "our $VERSION = '0.01'; # VERSION"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "has gitlab_host    => 'https://gitlab.com';"
NSQ_SOURCE_LINE 00000019 "has gitlab_user    => undef;"
NSQ_SOURCE_LINE 00000020 "has gitlab_project => undef;"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "has type => 'source';  # source or link"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "has format => 'tar.gz';"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "has version_from    => 'tag_name'; # tag_name or name"
NSQ_SOURCE_LINE 00000030 "has convert_version => undef;"
NSQ_SOURCE_LINE 00000031 "has link_name       => undef;"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "sub init"
NSQ_SOURCE_LINE 00000034 "{"
NSQ_SOURCE_LINE 00000035 "  my($self, $meta) = @_;"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "  croak(\"No gitlab_user provided\") unless defined $self->gitlab_user;"
NSQ_SOURCE_LINE 00000038 "  croak(\"No gitlab_project provided\") unless defined $self->gitlab_project;"
NSQ_SOURCE_LINE 00000039 "  croak(\"Don't set set a start_url with the Download::GitLab plugin\") if defined $meta->prop->{start_url};"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "  $meta->add_requires('configure' => 'Alien::Build::Plugin::Download::GitLab' => 0 );"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "  my $url = URI->new($self->gitlab_host);"
NSQ_SOURCE_LINE 00000044 "  $url->path(\"/api/v4/projects/@{[ uri_escape(join '/', $self->gitlab_user, $self->gitlab_project) ]}/releases\");"
NSQ_SOURCE_LINE 00000045 "  $meta->prop->{start_url} ||= \"$url\";"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "  $meta->apply_plugin('Download');"
NSQ_SOURCE_LINE 00000048 "  $meta->apply_plugin('Extract', format => $self->format );"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "  # we assume that GitLab returns the releases in reverse"
NSQ_SOURCE_LINE 00000051 "  # chronological order."
NSQ_SOURCE_LINE 00000052 "  $meta->register_hook("
NSQ_SOURCE_LINE 00000053 "    prefer => sub {"
NSQ_SOURCE_LINE 00000054 "      my($build, $res) = @_;"
NSQ_SOURCE_LINE 00000055 "      return $res;"
NSQ_SOURCE_LINE 00000056 "    },"
NSQ_SOURCE_LINE 00000057 "  );"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "  croak \"type must be one of source or link\" if $self->type !~ /^(source|link)$/;"
NSQ_SOURCE_LINE 00000060 "  croak \"version_from must be one of tag_name or name\" if $self->version_from !~ /^(tag_name|name)$/;"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "  ## TODO insert tokens as header if possible"
NSQ_SOURCE_LINE 00000063 "  ## This may help with rate limiting (or if not then don't bother)"
NSQ_SOURCE_LINE 00000064 "  # curl --header \"PRIVATE-TOKEN: <your_access_token>\" \"https://gitlab.example.com/api/v4/projects/24/releases\""
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "  $meta->around_hook("
NSQ_SOURCE_LINE 00000067 "    fetch => sub {"
NSQ_SOURCE_LINE 00000068 "      my $orig = shift;"
NSQ_SOURCE_LINE 00000069 "      my($build, $url, @the_rest) = @_;"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "      # only modify the response if we are using the GitLab API"
NSQ_SOURCE_LINE 00000072 "      # to get the release list"
NSQ_SOURCE_LINE 00000073 "      return $orig->($build, $url, @the_rest)"
NSQ_SOURCE_LINE 00000074 "        if defined $url && $url ne $meta->prop->{start_url};"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "      my $res = $orig->($build, $url, @the_rest);"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "      my $res2 = {"
NSQ_SOURCE_LINE 00000079 "        type => 'list',"
NSQ_SOURCE_LINE 00000080 "        list => [],"
NSQ_SOURCE_LINE 00000081 "      };"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "      $res2->{protocol} = $res->{protocol} if exists $res->{protocol};"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "      my $rel;"
NSQ_SOURCE_LINE 00000086 "      if($res->{content})"
NSQ_SOURCE_LINE 00000087 "      {"
NSQ_SOURCE_LINE 00000088 "        $rel = decode_json $res->{content};"
NSQ_SOURCE_LINE 00000089 "      }"
NSQ_SOURCE_LINE 00000090 "      elsif($res->{path})"
NSQ_SOURCE_LINE 00000091 "      {"
NSQ_SOURCE_LINE 00000092 "        $rel = decode_json path($res->{path})->slurp_raw;"
NSQ_SOURCE_LINE 00000093 "      }"
NSQ_SOURCE_LINE 00000094 "      else"
NSQ_SOURCE_LINE 00000095 "      {"
NSQ_SOURCE_LINE 00000096 "        croak(\"malformed response object: no content or path\");"
NSQ_SOURCE_LINE 00000097 "      }"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "      foreach my $release (@$rel)"
NSQ_SOURCE_LINE 00000100 "      {"
NSQ_SOURCE_LINE 00000101 "        my $version = $self->version_from eq 'name' ? $release->{name} : $release->{tag_name};"
NSQ_SOURCE_LINE 00000102 "        $version = $self->convert_version->($version) if $self->convert_version;"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "        if($self->type eq 'source')"
NSQ_SOURCE_LINE 00000105 "        {"
NSQ_SOURCE_LINE 00000106 "          foreach my $source (@{ $release->{assets}->{sources} })"
NSQ_SOURCE_LINE 00000107 "          {"
NSQ_SOURCE_LINE 00000108 "            next unless $source->{format} eq $self->format;"
NSQ_SOURCE_LINE 00000109 "            my $url = URI->new($source->{url});"
NSQ_SOURCE_LINE 00000110 "            my $filename = basename $url->path;"
NSQ_SOURCE_LINE 00000111 "            push @{ $res2->{list} }, {"
NSQ_SOURCE_LINE 00000112 "              filename => $filename,"
NSQ_SOURCE_LINE 00000113 "              url      => $source->{url},"
NSQ_SOURCE_LINE 00000114 "              version  => $version,"
NSQ_SOURCE_LINE 00000115 "            };"
NSQ_SOURCE_LINE 00000116 "          }"
NSQ_SOURCE_LINE 00000117 "        }"
NSQ_SOURCE_LINE 00000118 "        else # link"
NSQ_SOURCE_LINE 00000119 "        {"
NSQ_SOURCE_LINE 00000120 "          foreach my $link (@{ $release->{assets}->{links} })"
NSQ_SOURCE_LINE 00000121 "          {"
NSQ_SOURCE_LINE 00000122 "            my $url = URI->new($link->{url});"
NSQ_SOURCE_LINE 00000123 "            my $filename => basename $url->path;"
NSQ_SOURCE_LINE 00000124 "            if($self->link_name)"
NSQ_SOURCE_LINE 00000125 "            {"
NSQ_SOURCE_LINE 00000126 "              next unless $filename =~ $self->link_name;"
NSQ_SOURCE_LINE 00000127 "            }"
NSQ_SOURCE_LINE 00000128 "            push @{ $res2->{list} }, {"
NSQ_SOURCE_LINE 00000129 "              filename => $filename,"
NSQ_SOURCE_LINE 00000130 "              url      => $link->{url},"
NSQ_SOURCE_LINE 00000131 "              version  => $version,"
NSQ_SOURCE_LINE 00000132 "            };"
NSQ_SOURCE_LINE 00000133 "          }"
NSQ_SOURCE_LINE 00000134 "        }"
NSQ_SOURCE_LINE 00000135 "      }"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "      return $res2;"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "    },"
NSQ_SOURCE_LINE 00000140 "  );"
NSQ_SOURCE_LINE 00000141 "}"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "1;"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "__END__"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "=pod"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "=head1 NAME"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "Alien::Build::Plugin::Download::GitLab - Alien::Build plugin to download from GitLab"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "=head1 VERSION"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "version 0.01"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 " use alienfile;"
NSQ_SOURCE_LINE 00000162 " "
NSQ_SOURCE_LINE 00000163 " plugin 'Download::GitLab' => ("
NSQ_SOURCE_LINE 00000164 "   gitlab_user    => 'plicease',"
NSQ_SOURCE_LINE 00000165 "   gitlab_project => 'dontpanic',"
NSQ_SOURCE_LINE 00000166 " );"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "This plugin is designed for downloading assets from a GitLab instance."
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "=head1 PROPERTIES"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "=head2 gitlab_host"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "The host to fetch from L<https://gitlab.com> by default."
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "=head2 gitlab_user"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "The user to fetch from."
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "=head2 gitlab_project"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "The project to fetch from."
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "=head2 type"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "The asset type to fetch.  This must be one of C<source> or C<link>."
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "=head2 format"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "The expected format of the asset.  This should be one that"
NSQ_SOURCE_LINE 00000193 "L<Alien::Build::Plugin::Extract::Negotiate> understands.  The"
NSQ_SOURCE_LINE 00000194 "default is C<tar.gz>."
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "=head2 version_from"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "Where to compute the version from.  This should be one of"
NSQ_SOURCE_LINE 00000199 "C<tag_name> or C<name>.  The default is C<tag_name>."
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "=head2 convert_version"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "This is an optional code reference, which can be used to modify"
NSQ_SOURCE_LINE 00000204 "the version.  For example, if tags have a C<v> prefix you could"
NSQ_SOURCE_LINE 00000205 "remove it like so:"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 " plugin 'Download::GitLab' => ("
NSQ_SOURCE_LINE 00000208 "   gitlab_user     => 'plicease',"
NSQ_SOURCE_LINE 00000209 "   gitlab_project  => 'dontpanic',"
NSQ_SOURCE_LINE 00000210 "   convert_version => sub {"
NSQ_SOURCE_LINE 00000211 "     my $version = shift;"
NSQ_SOURCE_LINE 00000212 "     $version =~ s/^v//;"
NSQ_SOURCE_LINE 00000213 "     return $version;"
NSQ_SOURCE_LINE 00000214 "   },"
NSQ_SOURCE_LINE 00000215 " );"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "=head2 link_name"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "For C<link> types, this is a regular expression that filters the"
NSQ_SOURCE_LINE 00000220 "asset filenames.  For example, if there are multiple archive"
NSQ_SOURCE_LINE 00000221 "formats provided, you can get just the gzip'd tarball by setting"
NSQ_SOURCE_LINE 00000222 "this to C<qr/\\.tar\\.gz$/>."
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "=over 4"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "=item L<Alien>"
NSQ_SOURCE_LINE 00000229 ""
