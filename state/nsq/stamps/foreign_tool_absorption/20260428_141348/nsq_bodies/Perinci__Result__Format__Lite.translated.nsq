NSQ_SOURCE_LINE 00000001 "## no critic: Subroutines::ProhibitSubroutinePrototypes"
NSQ_SOURCE_LINE 00000002 "package Perinci::Result::Format::Lite;"
NSQ_SOURCE_LINE 00000003 ""
NSQ_SOURCE_LINE 00000004 "use 5.010001;"
NSQ_SOURCE_LINE 00000005 "use strict;"
NSQ_SOURCE_LINE 00000006 "#IFUNBUILT"
NSQ_SOURCE_LINE 00000007 "# use warnings;"
NSQ_SOURCE_LINE 00000008 "#END IFUNBUILT"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use Exporter qw(import);"
NSQ_SOURCE_LINE 00000011 "use List::Util qw(first max);"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000014 "our $DATE = '2023-07-29'; # DATE"
NSQ_SOURCE_LINE 00000015 "our $DIST = 'Perinci-Result-Format-Lite'; # DIST"
NSQ_SOURCE_LINE 00000016 "our $VERSION = '0.288'; # VERSION"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "our @EXPORT_OK = qw(format);"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "# copy-pasted from List::MoreUtils::PP"
NSQ_SOURCE_LINE 00000021 "sub firstidx (&@) {"
NSQ_SOURCE_LINE 00000022 "    my $f = shift;"
NSQ_SOURCE_LINE 00000023 "    foreach my $i ( 0 .. $#_ )"
NSQ_SOURCE_LINE 00000024 "        {"
NSQ_SOURCE_LINE 00000025 "            local *_ = \\$_[$i];"
NSQ_SOURCE_LINE 00000026 "            return $i if $f->();"
NSQ_SOURCE_LINE 00000027 "        }"
NSQ_SOURCE_LINE 00000028 "    return -1;"
NSQ_SOURCE_LINE 00000029 "}"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "sub _json {"
NSQ_SOURCE_LINE 00000032 "    state $json = do {"
NSQ_SOURCE_LINE 00000033 "        if    (eval { require Cpanel::JSON::XS; 1 })   { Cpanel::JSON::XS->new->canonical(1)->convert_blessed->allow_nonref }"
NSQ_SOURCE_LINE 00000034 "        elsif (eval { require JSON::Tiny::Subclassable; 1 }) { JSON::Tiny::Subclassable->new }"
NSQ_SOURCE_LINE 00000035 "        elsif (eval { require JSON::PP; 1 })   { JSON::PP->new->canonical(1)->convert_blessed->allow_nonref }"
NSQ_SOURCE_LINE 00000036 "        else { die \"Can't find any JSON module\" }"
NSQ_SOURCE_LINE 00000037 "    };"
NSQ_SOURCE_LINE 00000038 "    $json;"
NSQ_SOURCE_LINE 00000039 "};"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "sub __cleanse {"
NSQ_SOURCE_LINE 00000042 "    state $cleanser = do {"
NSQ_SOURCE_LINE 00000043 "        eval { require Data::Clean::JSON; 1 };"
NSQ_SOURCE_LINE 00000044 "        if ($@) {"
NSQ_SOURCE_LINE 00000045 "            undef;"
NSQ_SOURCE_LINE 00000046 "        } else {"
NSQ_SOURCE_LINE 00000047 "            Data::Clean::JSON->get_cleanser;"
NSQ_SOURCE_LINE 00000048 "        }"
NSQ_SOURCE_LINE 00000049 "    };"
NSQ_SOURCE_LINE 00000050 "    if ($cleanser) {"
NSQ_SOURCE_LINE 00000051 "        $cleanser->clean_in_place($_[0]);"
NSQ_SOURCE_LINE 00000052 "    } else {"
NSQ_SOURCE_LINE 00000053 "        $_[0];"
NSQ_SOURCE_LINE 00000054 "    }"
NSQ_SOURCE_LINE 00000055 "}"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "sub __gen_table {"
NSQ_SOURCE_LINE 00000058 "    my ($data, $header_row, $resmeta, $format) = @_;"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "    $resmeta //= {};"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "    # column names"
NSQ_SOURCE_LINE 00000063 "    my @columns;"
NSQ_SOURCE_LINE 00000064 "    if ($header_row) {"
NSQ_SOURCE_LINE 00000065 "        @columns = @{$data->[0]};"
NSQ_SOURCE_LINE 00000066 "    } else {"
NSQ_SOURCE_LINE 00000067 "        @columns = map {\"col$_\"} 0..@{$data->[0]}-1;"
NSQ_SOURCE_LINE 00000068 "    }"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "    my $column_orders; # e.g. [col2, col1, col3, ...]"
NSQ_SOURCE_LINE 00000071 "  SET_COLUMN_ORDERS: {"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "        # find column orders from 'table_column_orders' in result metadata (or"
NSQ_SOURCE_LINE 00000074 "        # from env)"
NSQ_SOURCE_LINE 00000075 "        my $tcos;"
NSQ_SOURCE_LINE 00000076 "        if ($ENV{FORMAT_PRETTY_TABLE_COLUMN_ORDERS}) {"
NSQ_SOURCE_LINE 00000077 "            $tcos = _json->encode($ENV{FORMAT_PRETTY_TABLE_COLUMN_ORDERS});"
NSQ_SOURCE_LINE 00000078 "        } elsif (my $rfos = ($resmeta->{'cmdline.format_options'} //"
NSQ_SOURCE_LINE 00000079 "                                 $resmeta->{format_options})) {"
NSQ_SOURCE_LINE 00000080 "            my $rfo = $rfos->{'text-pretty'} // $rfos->{text} // $rfos->{any};"
NSQ_SOURCE_LINE 00000081 "            if ($rfo) {"
NSQ_SOURCE_LINE 00000082 "                $tcos = $rfo->{table_column_orders};"
NSQ_SOURCE_LINE 00000083 "            }"
NSQ_SOURCE_LINE 00000084 "        }"
NSQ_SOURCE_LINE 00000085 "        if ($tcos) {"
NSQ_SOURCE_LINE 00000086 "            # find an entry in tcos that @columns contains all the columns of"
NSQ_SOURCE_LINE 00000087 "          COLS:"
NSQ_SOURCE_LINE 00000088 "            for my $cols (@$tcos) {"
NSQ_SOURCE_LINE 00000089 "                for my $col (@$cols) {"
NSQ_SOURCE_LINE 00000090 "                    next COLS unless first {$_ eq $col} @columns;"
NSQ_SOURCE_LINE 00000091 "                }"
NSQ_SOURCE_LINE 00000092 "                $column_orders = $cols;"
NSQ_SOURCE_LINE 00000093 "                last SET_COLUMN_ORDERS;"
NSQ_SOURCE_LINE 00000094 "            }"
NSQ_SOURCE_LINE 00000095 "        }"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "        if ($resmeta->{'table.field_orders'}) {"
NSQ_SOURCE_LINE 00000098 "            $column_orders = $resmeta->{'table.field_orders'};"
NSQ_SOURCE_LINE 00000099 "            last SET_COLUMN_ORDERS;"
NSQ_SOURCE_LINE 00000100 "        }"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "        # find column orders from table spec"
NSQ_SOURCE_LINE 00000103 "        $column_orders = $resmeta->{'table.fields'};"
NSQ_SOURCE_LINE 00000104 "    }"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "    # reorder each row according to requested column order"
NSQ_SOURCE_LINE 00000107 "    if ($column_orders) {"
NSQ_SOURCE_LINE 00000108 "        require Sort::BySpec;"
NSQ_SOURCE_LINE 00000109 "        my $cmp = Sort::BySpec::cmp_by_spec(spec => $column_orders);"
NSQ_SOURCE_LINE 00000110 "        # 0->2, 1->0, ... (map column position from unordered to ordered)"
NSQ_SOURCE_LINE 00000111 "        my @map0 = sort { $cmp->($a->[1], $b->[1]) }"
NSQ_SOURCE_LINE 00000112 "            map {[$_, $columns[$_]]} 0..$#columns;"
NSQ_SOURCE_LINE 00000113 "        #use DD; dd \\@map0;"
NSQ_SOURCE_LINE 00000114 "        my @map;"
NSQ_SOURCE_LINE 00000115 "        for (0..$#map0) {"
NSQ_SOURCE_LINE 00000116 "            $map[$_] = $map0[$_][0];"
NSQ_SOURCE_LINE 00000117 "        }"
NSQ_SOURCE_LINE 00000118 "        #use DD; dd \\@map;"
NSQ_SOURCE_LINE 00000119 "        my $newdata = [];"
NSQ_SOURCE_LINE 00000120 "        for my $row (@$data) {"
NSQ_SOURCE_LINE 00000121 "            my @newrow;"
NSQ_SOURCE_LINE 00000122 "            for (0..$#map) { $newrow[$_] = $row->[$map[$_]] }"
NSQ_SOURCE_LINE 00000123 "            push @$newdata, \\@newrow;"
NSQ_SOURCE_LINE 00000124 "        }"
NSQ_SOURCE_LINE 00000125 "        $data = $newdata;"
NSQ_SOURCE_LINE 00000126 "        my @newcolumns;"
NSQ_SOURCE_LINE 00000127 "        for (@map) { push @newcolumns, $columns[$_] }"
NSQ_SOURCE_LINE 00000128 "        @columns = @newcolumns;"
NSQ_SOURCE_LINE 00000129 "    }"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "    my @field_idxs; # map column to index in table.fields"
NSQ_SOURCE_LINE 00000132 "    {"
NSQ_SOURCE_LINE 00000133 "        my $tff = $resmeta->{'table.fields'} or last;"
NSQ_SOURCE_LINE 00000134 "        for my $i (0..$#columns) {"
NSQ_SOURCE_LINE 00000135 "            $field_idxs[$i] = firstidx { $_ eq $columns[$i] } @$tff;"
NSQ_SOURCE_LINE 00000136 "        }"
NSQ_SOURCE_LINE 00000137 "    }"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "    # determine field labels"
NSQ_SOURCE_LINE 00000140 "    {"
NSQ_SOURCE_LINE 00000141 "        last unless $header_row && @$data;"
NSQ_SOURCE_LINE 00000142 "        my $tff = $resmeta->{'table.fields'} or last;"
NSQ_SOURCE_LINE 00000143 "        my $tfl = $resmeta->{'table.field_labels'};"
NSQ_SOURCE_LINE 00000144 "        my $tfu = $resmeta->{'table.field_units'};"
NSQ_SOURCE_LINE 00000145 "        for my $i (0..$#columns) {"
NSQ_SOURCE_LINE 00000146 "            my $field_idx = $field_idxs[$i];"
NSQ_SOURCE_LINE 00000147 "            next unless $field_idx >= 0;"
NSQ_SOURCE_LINE 00000148 "            if ($tfl && defined $tfl->[$field_idx]) {"
NSQ_SOURCE_LINE 00000149 "                $data->[0][$i] = $tfl->[$field_idx];"
NSQ_SOURCE_LINE 00000150 "            } elsif ($tfu && defined $tfu->[$field_idx]) {"
NSQ_SOURCE_LINE 00000151 "                # add field units as label suffix to header (\" (UNIT)\")"
NSQ_SOURCE_LINE 00000152 "                $data->[0][$i] .= \" ($tfu->[$field_idx])\";"
NSQ_SOURCE_LINE 00000153 "            }"
NSQ_SOURCE_LINE 00000154 "        }"
NSQ_SOURCE_LINE 00000155 "    }"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "  FORMAT_CELLS:"
NSQ_SOURCE_LINE 00000158 "    {"
NSQ_SOURCE_LINE 00000159 "        my $tffmt         = $resmeta->{'table.field_formats'};"
NSQ_SOURCE_LINE 00000160 "        my $tffmt_code    = $resmeta->{'table.field_format_code'};"
NSQ_SOURCE_LINE 00000161 "        my $tffmt_default = $resmeta->{'table.default_field_format'};"
NSQ_SOURCE_LINE 00000162 "        last unless $tffmt || $tffmt_code || $tffmt_default;"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "        my (@fmt_names, @fmt_opts); # key: column index"
NSQ_SOURCE_LINE 00000165 "        for my $i (0..$#columns) {"
NSQ_SOURCE_LINE 00000166 "            my $field_idx = $field_idxs[$i];"
NSQ_SOURCE_LINE 00000167 "            my $fmt = $tffmt_code ? $tffmt_code->($columns[$i]) : undef;"
NSQ_SOURCE_LINE 00000168 "            $fmt //= $tffmt->[$field_idx] if $field_idx >= 0;"
NSQ_SOURCE_LINE 00000169 "            $fmt //= $tffmt_default;"
NSQ_SOURCE_LINE 00000170 "            if (ref $fmt eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000171 "                $fmt_names[$i] = $fmt->[0];"
NSQ_SOURCE_LINE 00000172 "                $fmt_opts [$i] = $fmt->[1] // {};"
NSQ_SOURCE_LINE 00000173 "            } else {"
NSQ_SOURCE_LINE 00000174 "                $fmt_names[$i] = $fmt;"
NSQ_SOURCE_LINE 00000175 "                $fmt_opts [$i] = {};"
NSQ_SOURCE_LINE 00000176 "            }"
NSQ_SOURCE_LINE 00000177 "        }"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "        my $nf;"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "        for my $i (0..$#{$data}) {"
NSQ_SOURCE_LINE 00000182 "            next if $i==0 && $header_row;"
NSQ_SOURCE_LINE 00000183 "            my $row = $data->[$i];"
NSQ_SOURCE_LINE 00000184 "            for my $j (0..$#columns) {"
NSQ_SOURCE_LINE 00000185 "                next unless defined $row->[$j];"
NSQ_SOURCE_LINE 00000186 "                my $fmt_name = $fmt_names[$j];"
NSQ_SOURCE_LINE 00000187 "                #say \"D:j=$j fmt_name=$fmt_name\";"
NSQ_SOURCE_LINE 00000188 "                next unless $fmt_name;"
NSQ_SOURCE_LINE 00000189 "                my $fmt_opts = $fmt_opts [$j];"
NSQ_SOURCE_LINE 00000190 "                if ($fmt_name eq 'iso8601_datetime' || $fmt_name eq 'iso8601_date' || $fmt_name eq 'datetime' || $fmt_name eq 'date') {"
NSQ_SOURCE_LINE 00000191 "                    if ($row->[$j] =~ /\\A[0-9]+(\\.[0-9]*)?\\z/) {"
NSQ_SOURCE_LINE 00000192 "                        my $frac = $1 ? \"0$1\"+0 : 0;"
NSQ_SOURCE_LINE 00000193 "                        my @t = gmtime($row->[$j]);"
NSQ_SOURCE_LINE 00000194 "                        if ($fmt_name eq 'iso8601_datetime' || $fmt_name eq 'datetime') {"
NSQ_SOURCE_LINE 00000195 "                            $row->[$j] = sprintf("
NSQ_SOURCE_LINE 00000196 "                                \"%04d-%02d-%02dT%02d:%02d:\".($frac ? \"%06.3f\" : \"%02d\").\"Z\","
NSQ_SOURCE_LINE 00000197 "                                $t[5]+1900, $t[4]+1, $t[3], $t[2], $t[1], $t[0]+$frac);"
NSQ_SOURCE_LINE 00000198 "                        } else {"
NSQ_SOURCE_LINE 00000199 "                            $row->[$j] = sprintf("
NSQ_SOURCE_LINE 00000200 "                                \"%04d-%02d-%02d\","
NSQ_SOURCE_LINE 00000201 "                                $t[5]+1900, $t[4]+1, $t[3]);"
NSQ_SOURCE_LINE 00000202 "                        }"
NSQ_SOURCE_LINE 00000203 "                    }"
NSQ_SOURCE_LINE 00000204 "                } elsif ($fmt_name eq 'boolstr') {"
NSQ_SOURCE_LINE 00000205 "                    $row->[$j] = $row->[$j] ? \"yes\" : \"no\";"
NSQ_SOURCE_LINE 00000206 "                } elsif ($fmt_name eq 'filesize') {"
NSQ_SOURCE_LINE 00000207 "                    require Format::Human::Bytes;"
NSQ_SOURCE_LINE 00000208 "                    $row->[$j] = Format::Human::Bytes::base2($row->[$j], 0);"
NSQ_SOURCE_LINE 00000209 "                } elsif ($fmt_name eq 'sci2dec') {"
NSQ_SOURCE_LINE 00000210 "                    if ($row->[$j] =~ /\\A(?:[+-]?)(?:\\d+\\.|\\d*\\.(\\d+))[eE]([+-]?\\d+)\\z/) {"
NSQ_SOURCE_LINE 00000211 "                        my $n = length($1 || \"\") - $2; $n = 0 if $n < 0;"
NSQ_SOURCE_LINE 00000212 "                        $row->[$j] = sprintf(\"%.${n}f\", $row->[$j]);"
NSQ_SOURCE_LINE 00000213 "                    }"
NSQ_SOURCE_LINE 00000214 "                } elsif ($fmt_name eq 'percent') {"
NSQ_SOURCE_LINE 00000215 "                    my $fmt = $fmt_opts->{sprintf} // '%.2f%%';"
NSQ_SOURCE_LINE 00000216 "                    $row->[$j] = sprintf($fmt, $row->[$j] * 100);"
NSQ_SOURCE_LINE 00000217 "                } elsif ($fmt_name eq 'number') {"
NSQ_SOURCE_LINE 00000218 "                    require Number::Format::BigFloat;"
NSQ_SOURCE_LINE 00000219 "                    $row->[$j] = Number::Format::BigFloat::format_number("
NSQ_SOURCE_LINE 00000220 "                        $row->[$j], {"
NSQ_SOURCE_LINE 00000221 "                            thousands_sep  => $fmt_opts->{thousands_sep} // ',',"
NSQ_SOURCE_LINE 00000222 "                            decimal_point  => $fmt_opts->{decimal_point} // '.',"
NSQ_SOURCE_LINE 00000223 "                            decimal_digits => $fmt_opts->{precision} // 0,"
NSQ_SOURCE_LINE 00000224 "                            # XXX decimal_fill"
NSQ_SOURCE_LINE 00000225 "                        });"
NSQ_SOURCE_LINE 00000226 "                }"
NSQ_SOURCE_LINE 00000227 "            }"
NSQ_SOURCE_LINE 00000228 "        }"
NSQ_SOURCE_LINE 00000229 "    }"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "    if ($format eq 'text-pretty') {"
NSQ_SOURCE_LINE 00000232 "      ALIGN_COLUMNS:"
NSQ_SOURCE_LINE 00000233 "        {"
NSQ_SOURCE_LINE 00000234 "            last unless @$data;"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "            # note: the logic of this block of code now also put in Number::Pad"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "            # XXX we just want to turn off 'uninitialized' and 'negative repeat"
NSQ_SOURCE_LINE 00000239 "            # count does nothing' from the operator x"
NSQ_SOURCE_LINE 00000240 "            no warnings;"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "            my $tfa         = $resmeta->{'table.field_aligns'};"
NSQ_SOURCE_LINE 00000243 "            my $tfa_code    = $resmeta->{'table.field_align_code'};"
NSQ_SOURCE_LINE 00000244 "            my $tfa_default = $resmeta->{'table.default_field_align'};"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "            # align numbers by default, with 'right' currently as 'number' is too slow"
NSQ_SOURCE_LINE 00000247 "            unless ($tfa || $tfa_code || $tfa_default) {"
NSQ_SOURCE_LINE 00000248 "                $tfa = [map { undef } 0 .. $#columns];"
NSQ_SOURCE_LINE 00000249 "              COLUMN:"
NSQ_SOURCE_LINE 00000250 "                for my $colidx (0 .. $#columns) {"
NSQ_SOURCE_LINE 00000251 "                    for my $i (0 .. $#{$data}) {"
NSQ_SOURCE_LINE 00000252 "                        next if $header_row && $i == 0;"
NSQ_SOURCE_LINE 00000253 "                        my $cell = $data->[$i][$colidx];"
NSQ_SOURCE_LINE 00000254 "                        next unless defined $cell;"
NSQ_SOURCE_LINE 00000255 "                        next COLUMN unless $cell =~ /\\A[+-]?[0-9]+(?:\\.[0-9]*)?(?:[Ee][+-]?[0-9]+)?(?:%)?\\z/;"
NSQ_SOURCE_LINE 00000256 "                    }"
NSQ_SOURCE_LINE 00000257 "                    $tfa->[$colidx] = 'right';"
NSQ_SOURCE_LINE 00000258 "                }"
NSQ_SOURCE_LINE 00000259 "            }"
NSQ_SOURCE_LINE 00000260 "            #use DD; dd $tfa;"
NSQ_SOURCE_LINE 00000261 "            #say \"D1\";"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "            for my $colidx (0..$#columns) {"
NSQ_SOURCE_LINE 00000264 "                my $field_idx = $field_idxs[$colidx];"
NSQ_SOURCE_LINE 00000265 "                my $align = $tfa_code ? $tfa_code->($columns[$colidx]) : undef;"
NSQ_SOURCE_LINE 00000266 "                $align //= $tfa->[$field_idx] if $field_idx >= 0;"
NSQ_SOURCE_LINE 00000267 "                $align //= $tfa_default;"
NSQ_SOURCE_LINE 00000268 "                next unless $align;"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "                # determine max widths"
NSQ_SOURCE_LINE 00000271 "                my $maxw;"
NSQ_SOURCE_LINE 00000272 "                my ($maxw_bd, $maxw_d, $maxw_ad); # before digit, digit, after d"
NSQ_SOURCE_LINE 00000273 "                if ($align eq 'number') {"
NSQ_SOURCE_LINE 00000274 "                    my (@w_bd, @w_d, @w_ad);"
NSQ_SOURCE_LINE 00000275 "                    for my $i (0..$#{$data}) {"
NSQ_SOURCE_LINE 00000276 "                        my $row = $data->[$i];"
NSQ_SOURCE_LINE 00000277 "                        if (@$row > $colidx) {"
NSQ_SOURCE_LINE 00000278 "                            my $cell = $row->[$colidx];"
NSQ_SOURCE_LINE 00000279 "                            if ($header_row && $i == 0) {"
NSQ_SOURCE_LINE 00000280 "                                my $w = length($cell);"
NSQ_SOURCE_LINE 00000281 "                                push @w_bd, 0;"
NSQ_SOURCE_LINE 00000282 "                                push @w_bd, 0;"
NSQ_SOURCE_LINE 00000283 "                                push @w_ad, 0;"
NSQ_SOURCE_LINE 00000284 "                            } elsif ($cell =~ /\\A([+-]?\\d+)(\\.?)(\\d*)[%]?\\z/) {"
NSQ_SOURCE_LINE 00000285 "                                # decimal notation number (with optional percent sign). TODO: allow arbitraty units after number, e.g. ml, mcg, etc? but should we align the unit too?"
NSQ_SOURCE_LINE 00000286 "                                push @w_bd, length($1);"
NSQ_SOURCE_LINE 00000287 "                                push @w_d , length($2);"
NSQ_SOURCE_LINE 00000288 "                                push @w_ad, length($3);"
NSQ_SOURCE_LINE 00000289 "                            } elsif ($cell =~ /\\A([+-]?\\d+\\.?\\d*)([eE])([+-]?\\d+)\\z/) {"
NSQ_SOURCE_LINE 00000290 "                                # scientific notation number"
NSQ_SOURCE_LINE 00000291 "                                push @w_bd, length($1);"
NSQ_SOURCE_LINE 00000292 "                                push @w_d , length($2);"
NSQ_SOURCE_LINE 00000293 "                                push @w_ad, length($3);"
NSQ_SOURCE_LINE 00000294 "                            } else {"
NSQ_SOURCE_LINE 00000295 "                                # not a number"
NSQ_SOURCE_LINE 00000296 "                                push @w_bd, length($cell);"
NSQ_SOURCE_LINE 00000297 "                                push @w_bd, 0;"
NSQ_SOURCE_LINE 00000298 "                                push @w_ad, 0;"
NSQ_SOURCE_LINE 00000299 "                            }"
NSQ_SOURCE_LINE 00000300 "                        } else {"
NSQ_SOURCE_LINE 00000301 "                            push @w_bd, 0;"
NSQ_SOURCE_LINE 00000302 "                            push @w_d , 0;"
NSQ_SOURCE_LINE 00000303 "                            push @w_ad, 0;"
NSQ_SOURCE_LINE 00000304 "                        }"
NSQ_SOURCE_LINE 00000305 "                    }"
NSQ_SOURCE_LINE 00000306 "                    $maxw_bd = max(@w_bd);"
NSQ_SOURCE_LINE 00000307 "                    $maxw_d  = max(@w_d);"
NSQ_SOURCE_LINE 00000308 "                    $maxw_ad = max(@w_ad);"
NSQ_SOURCE_LINE 00000309 "                    if ($header_row) {"
NSQ_SOURCE_LINE 00000310 "                        my $w = length($data->[0][$colidx]);"
NSQ_SOURCE_LINE 00000311 "                        if ($maxw_d == 0 && $maxw_ad == 0) {"
NSQ_SOURCE_LINE 00000312 "                            $maxw_bd = $w;"
NSQ_SOURCE_LINE 00000313 "                        }"
NSQ_SOURCE_LINE 00000314 "                    }"
NSQ_SOURCE_LINE 00000315 "                }"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "                $maxw = max(map {"
NSQ_SOURCE_LINE 00000318 "                    @$_ > $colidx ? length($_->[$colidx]) : 0"
NSQ_SOURCE_LINE 00000319 "                } @$data);"
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "                # do the alignment"
NSQ_SOURCE_LINE 00000322 "                for my $i (0..$#{$data}) {"
NSQ_SOURCE_LINE 00000323 "                    my $row = $data->[$i];"
NSQ_SOURCE_LINE 00000324 "                    for my $i (0..$#{$data}) {"
NSQ_SOURCE_LINE 00000325 "                        my $row = $data->[$i];"
NSQ_SOURCE_LINE 00000326 "                        next unless @$row > $colidx;"
NSQ_SOURCE_LINE 00000327 "                        my $cell = $row->[$colidx];"
NSQ_SOURCE_LINE 00000328 "                        next unless defined($cell);"
NSQ_SOURCE_LINE 00000329 "                        if ($align eq 'number') {"
NSQ_SOURCE_LINE 00000330 "                            my ($bd, $d, $ad);"
NSQ_SOURCE_LINE 00000331 "                            if ($header_row && $i == 0) {"
NSQ_SOURCE_LINE 00000332 "                            } elsif (($bd, $d, $ad) = $cell =~ /\\A([+-]?\\d+)(\\.?)(\\d*)\\z/) {"
NSQ_SOURCE_LINE 00000333 "                                $cell = join("
NSQ_SOURCE_LINE 00000334 "                                    '',"
NSQ_SOURCE_LINE 00000335 "                                    (' ' x ($maxw_bd - length($bd))), $bd,"
NSQ_SOURCE_LINE 00000336 "                                    $d , (' ' x ($maxw_d  - length($d ))),"
NSQ_SOURCE_LINE 00000337 "                                    $ad, (' ' x ($maxw_ad - length($ad))),"
NSQ_SOURCE_LINE 00000338 "                                );"
NSQ_SOURCE_LINE 00000339 "                            } elsif (($bd, $d, $ad) = $cell =~ /\\A([+-]?\\d+\\.?\\d*)([eE])([+-]?\\d+)\\z/) {"
NSQ_SOURCE_LINE 00000340 "                                $cell = join("
NSQ_SOURCE_LINE 00000341 "                                    '',"
NSQ_SOURCE_LINE 00000342 "                                    (' ' x ($maxw_bd - length($bd))), $bd,"
NSQ_SOURCE_LINE 00000343 "                                    $d , (' ' x ($maxw_d  - length($d ))),"
NSQ_SOURCE_LINE 00000344 "                                    $ad, (' ' x ($maxw_ad - length($ad))),"
NSQ_SOURCE_LINE 00000345 "                                );"
NSQ_SOURCE_LINE 00000346 "                            }"
NSQ_SOURCE_LINE 00000347 "                            my $w = length($cell);"
NSQ_SOURCE_LINE 00000348 "                            $cell = (' ' x ($maxw - $w)) . $cell"
NSQ_SOURCE_LINE 00000349 "                                if $maxw > $w;"
NSQ_SOURCE_LINE 00000350 "                        } elsif ($align eq 'right') {"
NSQ_SOURCE_LINE 00000351 "                            $cell = (' ' x ($maxw - length($cell))) . $cell;"
NSQ_SOURCE_LINE 00000352 "                        } elsif ($align eq 'middle' || $align eq 'center') {"
NSQ_SOURCE_LINE 00000353 "                            my $w = length($cell);"
NSQ_SOURCE_LINE 00000354 "                            my $n = int(($maxw-$w)/2);"
NSQ_SOURCE_LINE 00000355 "                            $cell = (' ' x $n) . $cell . (' ' x ($maxw-$w-$n));"
NSQ_SOURCE_LINE 00000356 "                        } else {"
NSQ_SOURCE_LINE 00000357 "                            # assumed left"
NSQ_SOURCE_LINE 00000358 "                            $cell .= (' ' x ($maxw - length($cell)));"
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 "                        }"
NSQ_SOURCE_LINE 00000361 "                        $row->[$colidx] = $cell;"
NSQ_SOURCE_LINE 00000362 "                    }"
NSQ_SOURCE_LINE 00000363 "                }"
NSQ_SOURCE_LINE 00000364 "            } # for $colidx"
NSQ_SOURCE_LINE 00000365 "        } # END align columns"
NSQ_SOURCE_LINE 00000366 "        #say \"D2\";"
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 "        my $fres;"
NSQ_SOURCE_LINE 00000369 "        my $backend = $ENV{FORMAT_PRETTY_TABLE_BACKEND};"
NSQ_SOURCE_LINE 00000370 "        $backend //= \"Text::Table::Org\" if $ENV{INSIDE_EMACS};"
NSQ_SOURCE_LINE 00000371 "        my $backend_opts = $ENV{FORMAT_PRETTY_TABLE_BACKEND_OPTS};"
NSQ_SOURCE_LINE 00000372 "        if (defined $backend_opts) {"
NSQ_SOURCE_LINE 00000373 "            $backend_opts = eval { _json->decode($backend_opts) };"
NSQ_SOURCE_LINE 00000374 "            die \"Invalid JSON in FORMAT_PRETTY_TABLE_BACKEND_OPTS: $@\" if $@;"
NSQ_SOURCE_LINE 00000375 "        } else {"
NSQ_SOURCE_LINE 00000376 "            $backend_opts = {};"
NSQ_SOURCE_LINE 00000377 "        }"
NSQ_SOURCE_LINE 00000378 "        if ($backend) {"
NSQ_SOURCE_LINE 00000379 "            require Text::Table::Any;"
NSQ_SOURCE_LINE 00000380 "            $fres = Text::Table::Any::table("
NSQ_SOURCE_LINE 00000381 "                rows => $data,"
NSQ_SOURCE_LINE 00000382 "                header_row => $header_row,"
NSQ_SOURCE_LINE 00000383 "                backend => $backend,"
NSQ_SOURCE_LINE 00000384 "                backend_opts => $backend_opts,"
NSQ_SOURCE_LINE 00000385 "                (caption => $resmeta->{caption}) x !!defined($resmeta->{caption}),"
NSQ_SOURCE_LINE 00000386 "            );"
NSQ_SOURCE_LINE 00000387 "        } else {"
NSQ_SOURCE_LINE 00000388 "            require Text::Table::Sprintf;"
NSQ_SOURCE_LINE 00000389 "            $fres = Text::Table::Sprintf::table(rows=>$data, header_row=>$header_row);"
NSQ_SOURCE_LINE 00000390 "        }"
NSQ_SOURCE_LINE 00000391 "        $fres .= \"\\n\" unless $fres =~ /\\R\\z/ || !length($fres);"
NSQ_SOURCE_LINE 00000392 "        $fres;"
NSQ_SOURCE_LINE 00000393 "    } elsif ($format eq 'csv') {"
NSQ_SOURCE_LINE 00000394 "        no warnings 'uninitialized';"
NSQ_SOURCE_LINE 00000395 "        join("
NSQ_SOURCE_LINE 00000396 "            \"\","
NSQ_SOURCE_LINE 00000397 "            map {"
NSQ_SOURCE_LINE 00000398 "                my $row = $_;"
NSQ_SOURCE_LINE 00000399 "                join("
NSQ_SOURCE_LINE 00000400 "                    \",\","
NSQ_SOURCE_LINE 00000401 "                    map {"
NSQ_SOURCE_LINE 00000402 "                        my $cell = $_;"
NSQ_SOURCE_LINE 00000403 "                        $cell =~ s/\"/\"\"/g;"
NSQ_SOURCE_LINE 00000404 "                        qq(\"$cell\");"
NSQ_SOURCE_LINE 00000405 "                    } @$row).\"\\n\";"
NSQ_SOURCE_LINE 00000406 "            } @$data"
NSQ_SOURCE_LINE 00000407 "        );"
NSQ_SOURCE_LINE 00000408 "    } elsif ($format eq 'tsv') {"
NSQ_SOURCE_LINE 00000409 "        no warnings 'uninitialized';"
NSQ_SOURCE_LINE 00000410 "        join(\"\", map { my $row = $_; join(\"\\t\", @$row).\"\\n\" } @$data);"
NSQ_SOURCE_LINE 00000411 "    } elsif ($format eq 'ltsv') {"
NSQ_SOURCE_LINE 00000412 "        no warnings 'uninitialized';"
NSQ_SOURCE_LINE 00000413 "        join(\"\", map { my $row = $_; join(\"\\t\", map { \"$columns[$_]:$row->[$_]\" } 0 .. $#{$row}).\"\\n\" } @$data);"
NSQ_SOURCE_LINE 00000414 "    } elsif ($format eq 'html') {"
NSQ_SOURCE_LINE 00000415 "        no warnings 'uninitialized';"
NSQ_SOURCE_LINE 00000416 "        require HTML::Entities;"
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 "        my $tfa = $resmeta->{'table.field_aligns'};"
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "        my @res;"
NSQ_SOURCE_LINE 00000421 "        push @res, \"<table\".($resmeta->{'table.html_class'} ?"
NSQ_SOURCE_LINE 00000422 "                                 \" class=\\\"\".HTML::Entities::encode_entities("
NSQ_SOURCE_LINE 00000423 "                                     $resmeta->{'table.html_class'}).\"\\\"\" : \"\")."
NSQ_SOURCE_LINE 00000424 "                                         \">\\n\";"
NSQ_SOURCE_LINE 00000425 "        for my $i (0..$#{$data}) {"
NSQ_SOURCE_LINE 00000426 "            my $data_elem = $i == 0 ? \"th\" : \"td\";"
NSQ_SOURCE_LINE 00000427 "            push @res, \"<thead>\\n\" if $i == 0;"
NSQ_SOURCE_LINE 00000428 "            push @res, \"<tbody>\\n\" if $i == 1;"
NSQ_SOURCE_LINE 00000429 "            push @res, \" <tr>\\n\";"
NSQ_SOURCE_LINE 00000430 "            my $row = $data->[$i];"
NSQ_SOURCE_LINE 00000431 "            for my $j (0..$#{$row}) {"
NSQ_SOURCE_LINE 00000432 "                my $field_idx = $field_idxs[$j];"
NSQ_SOURCE_LINE 00000433 "                my $align;"
NSQ_SOURCE_LINE 00000434 "                if ($field_idx >= 0 && $tfa->[$field_idx]) {"
NSQ_SOURCE_LINE 00000435 "                    $align = $tfa->[$field_idx];"
NSQ_SOURCE_LINE 00000436 "                    $align = \"right\" if $align eq 'number';"
NSQ_SOURCE_LINE 00000437 "                    $align = \"middle\" if $align eq 'center';"
NSQ_SOURCE_LINE 00000438 "                }"
NSQ_SOURCE_LINE 00000439 "                push @res, \"  <$data_elem\","
NSQ_SOURCE_LINE 00000440 "                    ($align ? \" align=\\\"$align\\\"\" : \"\"),"
NSQ_SOURCE_LINE 00000441 "                    \">\", HTML::Entities::encode_entities($row->[$j]),"
NSQ_SOURCE_LINE 00000442 "                    \"</$data_elem>\\n\";"
NSQ_SOURCE_LINE 00000443 "            }"
NSQ_SOURCE_LINE 00000444 "            push @res, \" </tr>\\n\";"
NSQ_SOURCE_LINE 00000445 "            push @res, \"</thead>\\n\" if $i == 0;"
NSQ_SOURCE_LINE 00000446 "        }"
NSQ_SOURCE_LINE 00000447 "        push @res, \"</tbody>\\n\";"
NSQ_SOURCE_LINE 00000448 "        push @res, \"</table>\\n\";"
NSQ_SOURCE_LINE 00000449 "        join '', @res;"
NSQ_SOURCE_LINE 00000450 "    } else {"
NSQ_SOURCE_LINE 00000451 "        no warnings 'uninitialized';"
NSQ_SOURCE_LINE 00000452 "        shift @$data if $header_row;"
NSQ_SOURCE_LINE 00000453 "        join(\"\", map {join(\"\\t\", @$_).\"\\n\"} @$data);"
NSQ_SOURCE_LINE 00000454 "    }"
NSQ_SOURCE_LINE 00000455 "}"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "sub format {"
NSQ_SOURCE_LINE 00000458 "    my ($res, $format, $is_naked, $cleanse) = @_;"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "    if ($format =~ /\\A(text|text-simple|text-pretty|csv|tsv|ltsv|html)\\z/) {"
NSQ_SOURCE_LINE 00000461 "        $format = $format eq 'text' ?"
NSQ_SOURCE_LINE 00000462 "            ((-t STDOUT) ? 'text-pretty' : 'text-simple') : $format;"
NSQ_SOURCE_LINE 00000463 "        no warnings 'uninitialized';"
NSQ_SOURCE_LINE 00000464 "        if ($res->[0] !~ /^(2|304)/) {"
NSQ_SOURCE_LINE 00000465 "            my $fres = \"ERROR $res->[0]: $res->[1]\";"
NSQ_SOURCE_LINE 00000466 "            if (my $prev = $res->[3]{prev}) {"
NSQ_SOURCE_LINE 00000467 "                $fres .= \" ($prev->[0]: $prev->[1])\";"
NSQ_SOURCE_LINE 00000468 "            }"
NSQ_SOURCE_LINE 00000469 "            return \"$fres\\n\";"
NSQ_SOURCE_LINE 00000470 "        } elsif ($res->[3] && $res->[3]{\"x.hint.result_binary\"}) {"
NSQ_SOURCE_LINE 00000471 "            return $res->[2];"
NSQ_SOURCE_LINE 00000472 "        } else {"
NSQ_SOURCE_LINE 00000473 "            require Data::Check::Structure;"
NSQ_SOURCE_LINE 00000474 "            my $data = $res->[2];"
NSQ_SOURCE_LINE 00000475 "            my $max = 1000;"
NSQ_SOURCE_LINE 00000476 "            if (!ref($data)) {"
NSQ_SOURCE_LINE 00000477 "                $data //= \"\";"
NSQ_SOURCE_LINE 00000478 "                $data .= \"\\n\" unless !length($data) || $data =~ /\\n\\z/;"
NSQ_SOURCE_LINE 00000479 "                return $data;"
NSQ_SOURCE_LINE 00000480 "            } elsif (ref($data) eq 'ARRAY' && !@$data) {"
NSQ_SOURCE_LINE 00000481 "                return \"\";"
NSQ_SOURCE_LINE 00000482 "            } elsif (Data::Check::Structure::is_aos($data, {max=>$max})) {"
NSQ_SOURCE_LINE 00000483 "                return join(\"\", map {\"$_\\n\"} @$data);"
NSQ_SOURCE_LINE 00000484 "            } elsif (Data::Check::Structure::is_aoaos($data, {max=>$max})) {"
NSQ_SOURCE_LINE 00000485 "                my $header_row = 0;"
NSQ_SOURCE_LINE 00000486 "                my $data = $data;"
NSQ_SOURCE_LINE 00000487 "                if ($res->[3]{'table.fields'}) {"
NSQ_SOURCE_LINE 00000488 "                    $data = [$res->[3]{'table.fields'}, @$data];"
NSQ_SOURCE_LINE 00000489 "                    $header_row = 1;"
NSQ_SOURCE_LINE 00000490 "                }"
NSQ_SOURCE_LINE 00000491 "                return __gen_table($data, $header_row, $res->[3], $format);"
NSQ_SOURCE_LINE 00000492 "            } elsif (Data::Check::Structure::is_hos($data, {max=>$max})) {"
NSQ_SOURCE_LINE 00000493 "                $data = [map {[$_, $data->{$_}]} sort keys %$data];"
NSQ_SOURCE_LINE 00000494 "                unshift @$data, [\"key\", \"value\"];"
NSQ_SOURCE_LINE 00000495 "                return __gen_table($data, 1, $res->[3], $format);"
NSQ_SOURCE_LINE 00000496 "            } elsif (Data::Check::Structure::is_aohos($data, {max=>$max})) {"
NSQ_SOURCE_LINE 00000497 "                # collect all mentioned fields"
NSQ_SOURCE_LINE 00000498 "                my @fieldnames;"
NSQ_SOURCE_LINE 00000499 "                if ($res->[3] && $res->[3]{'table.fields'} &&"
NSQ_SOURCE_LINE 00000500 "                        $res->[3]{'table.hide_unknown_fields'}) {"
NSQ_SOURCE_LINE 00000501 "                    @fieldnames = @{ $res->[3]{'table.fields'} };"
NSQ_SOURCE_LINE 00000502 "                } else {"
NSQ_SOURCE_LINE 00000503 "                    my %fieldnames;"
NSQ_SOURCE_LINE 00000504 "                    for my $row (@$data) {"
NSQ_SOURCE_LINE 00000505 "                        $fieldnames{$_}++ for keys %$row;"
NSQ_SOURCE_LINE 00000506 "                    }"
NSQ_SOURCE_LINE 00000507 "                    @fieldnames = sort keys %fieldnames;"
NSQ_SOURCE_LINE 00000508 "                }"
NSQ_SOURCE_LINE 00000509 "                my $newdata = [];"
NSQ_SOURCE_LINE 00000510 "                for my $row (@$data) {"
NSQ_SOURCE_LINE 00000511 "                    push @$newdata, [map {$row->{$_}} @fieldnames];"
NSQ_SOURCE_LINE 00000512 "                }"
NSQ_SOURCE_LINE 00000513 "                unshift @$newdata, \\@fieldnames;"
NSQ_SOURCE_LINE 00000514 "                return __gen_table($newdata, 1, $res->[3], $format);"
NSQ_SOURCE_LINE 00000515 "            } else {"
NSQ_SOURCE_LINE 00000516 "                $format = 'json-pretty';"
NSQ_SOURCE_LINE 00000517 "            }"
NSQ_SOURCE_LINE 00000518 "        }"
NSQ_SOURCE_LINE 00000519 "    }"
NSQ_SOURCE_LINE 00000520 ""
NSQ_SOURCE_LINE 00000521 "    my $tff = $res->[3]{'table.fields'};"
NSQ_SOURCE_LINE 00000522 "    $res = $res->[2] if $is_naked;"
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 "    if ($format eq 'perl') {"
NSQ_SOURCE_LINE 00000525 "        my $use_color = $ENV{COLOR} // (-t STDOUT);"
NSQ_SOURCE_LINE 00000526 "        if ($use_color && eval { require Data::Dump::Color; 1 }) {"
NSQ_SOURCE_LINE 00000527 "            return Data::Dump::Color::dump($res);"
NSQ_SOURCE_LINE 00000528 "        } elsif (eval { require Data::Dump; 1 }) {"
NSQ_SOURCE_LINE 00000529 "            return Data::Dump::dump($res);"
NSQ_SOURCE_LINE 00000530 "        } else {"
NSQ_SOURCE_LINE 00000531 "            no warnings 'once';"
NSQ_SOURCE_LINE 00000532 "            require Data::Dumper;"
NSQ_SOURCE_LINE 00000533 "            local $Data::Dumper::Terse = 1;"
NSQ_SOURCE_LINE 00000534 "            local $Data::Dumper::Indent = 1;"
NSQ_SOURCE_LINE 00000535 "            local $Data::Dumper::Useqq = 1;"
NSQ_SOURCE_LINE 00000536 "            local $Data::Dumper::Deparse = 1;"
NSQ_SOURCE_LINE 00000537 "            local $Data::Dumper::Quotekeys = 0;"
NSQ_SOURCE_LINE 00000538 "            local $Data::Dumper::Sortkeys = 1;"
NSQ_SOURCE_LINE 00000539 "            local $Data::Dumper::Trailingcomma = 1;"
NSQ_SOURCE_LINE 00000540 "            return Data::Dumper::Dumper($res);"
NSQ_SOURCE_LINE 00000541 "        }"
NSQ_SOURCE_LINE 00000542 "    }"
NSQ_SOURCE_LINE 00000543 ""
NSQ_SOURCE_LINE 00000544 "    unless ($format =~ /\\Ajson(-pretty)?\\z/) {"
NSQ_SOURCE_LINE 00000545 "        warn \"Unknown format '$format', fallback to json-pretty\";"
NSQ_SOURCE_LINE 00000546 "        $format = 'json-pretty';"
NSQ_SOURCE_LINE 00000547 "    }"
NSQ_SOURCE_LINE 00000548 "    __cleanse($res) if ($cleanse//1);"
NSQ_SOURCE_LINE 00000549 "    if ($format =~ /json/) {"
NSQ_SOURCE_LINE 00000550 "        if ($tff && _json->can(\"sort_by\") &&"
NSQ_SOURCE_LINE 00000551 "                eval { require Sort::ByExample; 1}) {"
NSQ_SOURCE_LINE 00000552 "            my $cmp = Sort::ByExample->cmp($tff);"
NSQ_SOURCE_LINE 00000553 "            _json->sort_by(sub { $cmp->($JSON::PP::a, $JSON::PP::b) });"
NSQ_SOURCE_LINE 00000554 "        }"
NSQ_SOURCE_LINE 00000555 ""
NSQ_SOURCE_LINE 00000556 "        if ($format eq 'json') {"
NSQ_SOURCE_LINE 00000557 "            return _json->encode($res) . \"\\n\";"
NSQ_SOURCE_LINE 00000558 "        } else {"
NSQ_SOURCE_LINE 00000559 "            _json->pretty(1);"
NSQ_SOURCE_LINE 00000560 "            return _json->encode($res);"
NSQ_SOURCE_LINE 00000561 "        }"
NSQ_SOURCE_LINE 00000562 "    }"
NSQ_SOURCE_LINE 00000563 "}"
NSQ_SOURCE_LINE 00000564 ""
NSQ_SOURCE_LINE 00000565 "1;"
NSQ_SOURCE_LINE 00000566 "# ABSTRACT: Format enveloped result"
NSQ_SOURCE_LINE 00000567 ""
NSQ_SOURCE_LINE 00000568 "__END__"
NSQ_SOURCE_LINE 00000569 ""
NSQ_SOURCE_LINE 00000570 "=pod"
NSQ_SOURCE_LINE 00000571 ""
NSQ_SOURCE_LINE 00000572 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000573 ""
NSQ_SOURCE_LINE 00000574 "=head1 NAME"
NSQ_SOURCE_LINE 00000575 ""
NSQ_SOURCE_LINE 00000576 "Perinci::Result::Format::Lite - Format enveloped result"
NSQ_SOURCE_LINE 00000577 ""
NSQ_SOURCE_LINE 00000578 "=head1 VERSION"
NSQ_SOURCE_LINE 00000579 ""
NSQ_SOURCE_LINE 00000580 "This document describes version 0.288 of Perinci::Result::Format::Lite (from Perl distribution Perinci-Result-Format-Lite), released on 2023-07-29."
NSQ_SOURCE_LINE 00000581 ""
NSQ_SOURCE_LINE 00000582 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000583 ""
NSQ_SOURCE_LINE 00000584 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000585 ""
NSQ_SOURCE_LINE 00000586 "This module formats L<enveloped result structure|Rinci::function/\"Enveloped"
NSQ_SOURCE_LINE 00000587 "result\"> to \"pretty text\" if it can do so, e.g. the structure can be represented"
NSQ_SOURCE_LINE 00000588 "as a 2-dimensional table. Otherwise, it falls back to JSON or Perl. The table"
NSQ_SOURCE_LINE 00000589 "formats supported include CSV, TSV, LTSV, or HTML. More table formats (e.g. Org,"
NSQ_SOURCE_LINE 00000590 "Markdown) are supported via L<Text::Table::Any> when you set"
NSQ_SOURCE_LINE 00000591 "L</\"FORMAT_PRETTY_TABLE_BACKEND\">."
NSQ_SOURCE_LINE 00000592 ""
NSQ_SOURCE_LINE 00000593 "This module is a more lightweight version of L<Perinci::Result::Format> but the"
NSQ_SOURCE_LINE 00000594 "long-term goal is to reunite the two formatting modules back to a"
NSQ_SOURCE_LINE 00000595 "modular/pluggable module."
NSQ_SOURCE_LINE 00000596 ""
NSQ_SOURCE_LINE 00000597 "=for Pod::Coverage ^(firstidx)$"
NSQ_SOURCE_LINE 00000598 ""
NSQ_SOURCE_LINE 00000599 "=head1 SUPPORTED RESULT METADATA PROPERTIES/ATTRIBUTES"
NSQ_SOURCE_LINE 00000600 ""
NSQ_SOURCE_LINE 00000601 "The L<enveloped result specification|Rinci::function/\"Enveloped result\">"
NSQ_SOURCE_LINE 00000602 "specifies various properties/attributes that can be used as formatting hints."
NSQ_SOURCE_LINE 00000603 "Below are the list of properties/attributes supported by this module, including"
NSQ_SOURCE_LINE 00000604 "those that are not in the specification:"
NSQ_SOURCE_LINE 00000605 ""
NSQ_SOURCE_LINE 00000606 "=over"
NSQ_SOURCE_LINE 00000607 ""
NSQ_SOURCE_LINE 00000608 "=item * table.html_class"
NSQ_SOURCE_LINE 00000609 ""
NSQ_SOURCE_LINE 00000610 "Str. Used when formatting result as HTML table."
NSQ_SOURCE_LINE 00000611 ""
NSQ_SOURCE_LINE 00000612 "=item * table.fields"
NSQ_SOURCE_LINE 00000613 ""
NSQ_SOURCE_LINE 00000614 "Array of str. Define fields in order. Used when formatting result as text table."
NSQ_SOURCE_LINE 00000615 "Fields that are not defined in this array will be displayed after the defined"
NSQ_SOURCE_LINE 00000616 "fields (or hidden, if you set C<table.hide_unknown_fields>)."
NSQ_SOURCE_LINE 00000617 ""
NSQ_SOURCE_LINE 00000618 "=item * table.hide_unknown_fields"
NSQ_SOURCE_LINE 00000619 ""
NSQ_SOURCE_LINE 00000620 "Bool. If set to true, then unknown fields (those not defined in C<table.fields>)"
NSQ_SOURCE_LINE 00000621 "will not be shown. Used when formatting result as text table."
NSQ_SOURCE_LINE 00000622 ""
NSQ_SOURCE_LINE 00000623 "=item * table.field_orders"
NSQ_SOURCE_LINE 00000624 ""
NSQ_SOURCE_LINE 00000625 "Array of str. Like C<table.fields>, but with higher precedence."
NSQ_SOURCE_LINE 00000626 ""
NSQ_SOURCE_LINE 00000627 "=item * table.field_labels"
NSQ_SOURCE_LINE 00000628 ""
NSQ_SOURCE_LINE 00000629 "Array of str. Define labels for each field (each element correspond to the field"
NSQ_SOURCE_LINE 00000630 "of the same element as defined in C<table.fields>). Used when formatting result"
NSQ_SOURCE_LINE 00000631 "as text table. Will show this in header for fields instead the actual field"
NSQ_SOURCE_LINE 00000632 "name."
NSQ_SOURCE_LINE 00000633 ""
NSQ_SOURCE_LINE 00000634 "=item * table.field_units"
NSQ_SOURCE_LINE 00000635 ""
NSQ_SOURCE_LINE 00000636 "Array of str. Define units for each field (each element correspond to the field"
NSQ_SOURCE_LINE 00000637 "of the same element as defined in C<table.fields>). Used when formatting result"
NSQ_SOURCE_LINE 00000638 "as text table. Will show this along with field name/label. For example if a"
NSQ_SOURCE_LINE 00000639 "field's unit is defined as `cm` and field name is `length`, then the field"
NSQ_SOURCE_LINE 00000640 "header will show as `length (cm)`."
NSQ_SOURCE_LINE 00000641 ""
NSQ_SOURCE_LINE 00000642 "=item * table.field_formats"
NSQ_SOURCE_LINE 00000643 ""
NSQ_SOURCE_LINE 00000644 "Array of str. Define format for each field (each element correspond to the field"
NSQ_SOURCE_LINE 00000645 "of the same element as defined in C<table.fields>). Used when formatting result"
NSQ_SOURCE_LINE 00000646 "as text table. Known formats: `iso8601_datetime`, `iso8601_date`, `datetime`,"
NSQ_SOURCE_LINE 00000647 "`date`, `boolstr`, `filesize`, `sci2dec`, `percent`, `number`."
NSQ_SOURCE_LINE 00000648 ""
NSQ_SOURCE_LINE 00000649 "=item * table.field_format_code"
NSQ_SOURCE_LINE 00000650 ""
NSQ_SOURCE_LINE 00000651 "Coderef. Will be called with argument of field name. Expected to return format"
NSQ_SOURCE_LINE 00000652 "name (see C<table.field_formats>). Used when formatting result as text table."
NSQ_SOURCE_LINE 00000653 "This option can be used when you want to dynamically determine a suitable format"
NSQ_SOURCE_LINE 00000654 "based on field name."
NSQ_SOURCE_LINE 00000655 ""
NSQ_SOURCE_LINE 00000656 "=item * table.default_field_format"
NSQ_SOURCE_LINE 00000657 ""
NSQ_SOURCE_LINE 00000658 "Str. Instead of defining format for each field using `table.field_formats`, you"
NSQ_SOURCE_LINE 00000659 "can also specify default format for all fields."
NSQ_SOURCE_LINE 00000660 ""
NSQ_SOURCE_LINE 00000661 "=item * table.field_aligns"
NSQ_SOURCE_LINE 00000662 ""
NSQ_SOURCE_LINE 00000663 "Array of str. Define alignment for each field (each element correspond to the"
NSQ_SOURCE_LINE 00000664 "field of the same element as defined in C<table.fields>). Used when formatting"
NSQ_SOURCE_LINE 00000665 "result as text table. Known alignment value for each field: `number` (special"
NSQ_SOURCE_LINE 00000666 "rule to align on decimal point or `E`), `right`, `middle`|`center`, `right`."
NSQ_SOURCE_LINE 00000667 ""
NSQ_SOURCE_LINE 00000668 "=item * table.field_align_code"
NSQ_SOURCE_LINE 00000669 ""
NSQ_SOURCE_LINE 00000670 "Coderef. Will be called with argument of field name. Expected to return"
NSQ_SOURCE_LINE 00000671 "alignment name (see C<table.field_aligns>). Used when formatting result as text"
NSQ_SOURCE_LINE 00000672 "table. This option can be used when you want to dynamically determine a suitable"
NSQ_SOURCE_LINE 00000673 "alignment based on field name."
NSQ_SOURCE_LINE 00000674 ""
NSQ_SOURCE_LINE 00000675 "=item * table.default_field_align"
NSQ_SOURCE_LINE 00000676 ""
NSQ_SOURCE_LINE 00000677 "Str. Instead of defining alignment for each field using `table.field_aligns`,"
NSQ_SOURCE_LINE 00000678 "you can also specify default alignment for all fields."
NSQ_SOURCE_LINE 00000679 ""
NSQ_SOURCE_LINE 00000680 "=back"
NSQ_SOURCE_LINE 00000681 ""
NSQ_SOURCE_LINE 00000682 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000683 ""
NSQ_SOURCE_LINE 00000684 "=head2 format($res, $format[ , $is_naked=0, $cleanse=1 ]) => str"
NSQ_SOURCE_LINE 00000685 ""
NSQ_SOURCE_LINE 00000686 "=head1 ENVIRONMENT"
NSQ_SOURCE_LINE 00000687 ""
NSQ_SOURCE_LINE 00000688 "=head2 FORMAT_PRETTY_TABLE_BACKEND"
NSQ_SOURCE_LINE 00000689 ""
NSQ_SOURCE_LINE 00000690 "Str, optional. If this is set, will render text table using L<Text::Table::Any>"
NSQ_SOURCE_LINE 00000691 "(with C<backend> set to the value of this environment variable) instead of the"
NSQ_SOURCE_LINE 00000692 "default L<Text::Table::Sprintf>. This is useful if you want to output text table"
NSQ_SOURCE_LINE 00000693 "in a different format, for example to generate Org tables (make sure"
NSQ_SOURCE_LINE 00000694 "L<Text::Table::Org> backend is already installed):"
NSQ_SOURCE_LINE 00000695 ""
NSQ_SOURCE_LINE 00000696 " % FORMAT_PRETTY_TABLE_BACKEND=Text::Table::Org lcpan rdeps Getopt::Lucid"
NSQ_SOURCE_LINE 00000697 ""
NSQ_SOURCE_LINE 00000698 "For convenience, a default is chosen for you under certain condition. When"
NSQ_SOURCE_LINE 00000699 "inside Emacs (environment C<INSIDE_EMACS> is set), C<Text::Table::Org> is used"
NSQ_SOURCE_LINE 00000700 "as default."
NSQ_SOURCE_LINE 00000701 ""
NSQ_SOURCE_LINE 00000702 "=head2 FORMAT_PRETTY_TABLE_BACKEND_OPTS"
NSQ_SOURCE_LINE 00000703 ""
NSQ_SOURCE_LINE 00000704 "Str, JSON-encoding expected. This setting is to accompany"
NSQ_SOURCE_LINE 00000705 "L</FORMAT_PRETTY_TABLE_BACKEND>, to be passed to"
NSQ_SOURCE_LINE 00000706 "L<Text::Table::Any>C<::table()>'s C<backend_opts> argument. It should be a hash"
NSQ_SOURCE_LINE 00000707 "encoded in JSON, e.g.:"
NSQ_SOURCE_LINE 00000708 ""
NSQ_SOURCE_LINE 00000709 " # keep table aligned in the presence of wide Unicode characters"
NSQ_SOURCE_LINE 00000710 " % FORMAT_PRETTY_TABLE_BACKEND=Text::Table::More FORMAT_PRETTY_TABLE_BACKEND_OPTS='{\"wide_char\":1}' tabledata locale::JP::City::MIC --page"
NSQ_SOURCE_LINE 00000711 ""
NSQ_SOURCE_LINE 00000712 "=head2 FORMAT_PRETTY_TABLE_COLUMN_ORDERS => array (json)"
NSQ_SOURCE_LINE 00000713 ""
NSQ_SOURCE_LINE 00000714 "Set the default of C<table_column_orders> in C<format_options> in result"
NSQ_SOURCE_LINE 00000715 "metadata, similar to what's implemented in L<Perinci::Result::Format> and"
NSQ_SOURCE_LINE 00000716 "L<Data::Format::Pretty::Console>."
NSQ_SOURCE_LINE 00000717 ""
NSQ_SOURCE_LINE 00000718 "=head2 COLOR => bool"
NSQ_SOURCE_LINE 00000719 ""
