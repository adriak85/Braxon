NSQ_SOURCE_LINE 00000036 "# >>>>> Here are some globals that you might want to adjust <<<<<<"
NSQ_SOURCE_LINE 00000037 "sub initialize_globals {"
NSQ_SOURCE_LINE 00000038 "    # Set this to 1 to generate XTML-compatible output"
NSQ_SOURCE_LINE 00000039 "    $XHTML = 1;"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "    # Change this to the preferred DTD to print in start_html()"
NSQ_SOURCE_LINE 00000042 "    # or use default_dtd('text of DTD to use');"
NSQ_SOURCE_LINE 00000043 "    $DEFAULT_DTD = [ '-//W3C//DTD HTML 4.01 Transitional//EN',"
NSQ_SOURCE_LINE 00000044 "\t\t     'http://www.w3.org/TR/html4/loose.dtd' ] ;"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "    # Set this to 1 to enable NOSTICKY scripts"
NSQ_SOURCE_LINE 00000047 "    # or: "
NSQ_SOURCE_LINE 00000048 "    #    1) use CGI '-nosticky';"
NSQ_SOURCE_LINE 00000049 "    #    2) $CGI::NOSTICKY = 1;"
NSQ_SOURCE_LINE 00000050 "    $NOSTICKY = 0;"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "    # Set this to 1 to enable NPH scripts"
NSQ_SOURCE_LINE 00000053 "    # or: "
NSQ_SOURCE_LINE 00000054 "    #    1) use CGI qw(-nph)"
NSQ_SOURCE_LINE 00000055 "    #    2) CGI::nph(1)"
NSQ_SOURCE_LINE 00000056 "    #    3) print header(-nph=>1)"
NSQ_SOURCE_LINE 00000057 "    $NPH = 0;"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "    # Set this to 1 to enable debugging from @ARGV"
NSQ_SOURCE_LINE 00000060 "    # Set to 2 to enable debugging from STDIN"
NSQ_SOURCE_LINE 00000061 "    $DEBUG = 1;"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "    # Set this to 1 to generate automatic tab indexes"
NSQ_SOURCE_LINE 00000064 "    $TABINDEX = 0;"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "    # Set this to 1 to cause files uploaded in multipart documents"
NSQ_SOURCE_LINE 00000067 "    # to be closed, instead of caching the file handle"
NSQ_SOURCE_LINE 00000068 "    # or:"
NSQ_SOURCE_LINE 00000069 "    #    1) use CGI qw(:close_upload_files)"
NSQ_SOURCE_LINE 00000070 "    #    2) $CGI::close_upload_files(1);"
NSQ_SOURCE_LINE 00000071 "    # Uploads with many files run out of file handles."
NSQ_SOURCE_LINE 00000072 "    # Also, for performance, since the file is already on disk,"
NSQ_SOURCE_LINE 00000073 "    # it can just be renamed, instead of read and written."
NSQ_SOURCE_LINE 00000074 "    $CLOSE_UPLOAD_FILES = 0;"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "    # Automatically determined -- don't change"
NSQ_SOURCE_LINE 00000077 "    $EBCDIC = 0;"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "    # Change this to 1 to suppress redundant HTTP headers"
NSQ_SOURCE_LINE 00000080 "    $HEADERS_ONCE = 0;"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "    # separate the name=value pairs by semicolons rather than ampersands"
NSQ_SOURCE_LINE 00000083 "    $USE_PARAM_SEMICOLONS = 1;"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "    # Do not include undefined params parsed from query string"
NSQ_SOURCE_LINE 00000086 "    # use CGI qw(-no_undef_params);"
NSQ_SOURCE_LINE 00000087 "    $NO_UNDEF_PARAMS = 0;"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "    # return everything as utf-8"
NSQ_SOURCE_LINE 00000090 "    $PARAM_UTF8      = 0;"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "    # make param('PUTDATA') act like file upload"
NSQ_SOURCE_LINE 00000093 "    $PUTDATA_UPLOAD = 0;"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "    # Add QUERY_STRING to POST request"
NSQ_SOURCE_LINE 00000096 "    $APPEND_QUERY_STRING = 0;"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "    # Other globals that you shouldn't worry about."
NSQ_SOURCE_LINE 00000099 "    undef $Q;"
NSQ_SOURCE_LINE 00000100 "    $BEEN_THERE = 0;"
NSQ_SOURCE_LINE 00000101 "    $DTD_PUBLIC_IDENTIFIER = \"\";"
NSQ_SOURCE_LINE 00000102 "    undef @QUERY_PARAM;"
NSQ_SOURCE_LINE 00000103 "    undef %QUERY_PARAM;"
NSQ_SOURCE_LINE 00000104 "    undef %EXPORT;"
NSQ_SOURCE_LINE 00000105 "    undef $QUERY_CHARSET;"
NSQ_SOURCE_LINE 00000106 "    undef %QUERY_FIELDNAMES;"
NSQ_SOURCE_LINE 00000107 "    undef %QUERY_TMPFILES;"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "    # prevent complaints by mod_perl"
NSQ_SOURCE_LINE 00000110 "    1;"
NSQ_SOURCE_LINE 00000111 "}"
