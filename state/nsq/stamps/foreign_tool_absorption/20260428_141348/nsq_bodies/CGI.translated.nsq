NSQ_SOURCE_LINE 00000892 "sub _tag_func {"
NSQ_SOURCE_LINE 00000893 "    my $tagname = shift;"
NSQ_SOURCE_LINE 00000894 "\tmy ($q,$a,@rest) = self_or_default(@_);"
NSQ_SOURCE_LINE 00000895 ""
NSQ_SOURCE_LINE 00000896 "\tmy($attr) = '';"
NSQ_SOURCE_LINE 00000897 ""
NSQ_SOURCE_LINE 00000898 "\tif (ref($a) && ref($a) eq 'HASH') {"
NSQ_SOURCE_LINE 00000899 "\t\tmy(@attr) = make_attributes($a,$q->{'escape'});"
NSQ_SOURCE_LINE 00000900 "\t\t$attr = \" @attr\" if @attr;"
