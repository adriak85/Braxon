NSQ_SOURCE_LINE 00001310 "\tpush(@{$self->{param}{$name}},@values);"
NSQ_SOURCE_LINE 00001311 "    }"
NSQ_SOURCE_LINE 00001312 "    return $self->param($name);"
NSQ_SOURCE_LINE 00001313 "}"
