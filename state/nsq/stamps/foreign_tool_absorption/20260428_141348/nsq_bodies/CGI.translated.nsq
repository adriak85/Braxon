NSQ_SOURCE_LINE 00001350 ""
NSQ_SOURCE_LINE 00001351 "#### Method: url_param"
NSQ_SOURCE_LINE 00001352 "# Return a parameter in the QUERY_STRING, regardless of"
NSQ_SOURCE_LINE 00001353 "# whether this was a POST or a GET"
NSQ_SOURCE_LINE 00001354 "####"
NSQ_SOURCE_LINE 00001355 "sub url_param {"
NSQ_SOURCE_LINE 00001356 "    my ($self,@p) = self_or_default(@_);"
NSQ_SOURCE_LINE 00001357 "    my $name = shift(@p);"
NSQ_SOURCE_LINE 00001358 "    return undef unless exists($ENV{QUERY_STRING});"
NSQ_SOURCE_LINE 00001359 "    unless (exists($self->{'.url_param'})) {"
NSQ_SOURCE_LINE 00001360 "\t$self->{'.url_param'}={}; # empty hash"
NSQ_SOURCE_LINE 00001361 "\tif ($ENV{QUERY_STRING} =~ /=/) {"
NSQ_SOURCE_LINE 00001362 "\t    my(@pairs) = split(/[&;]/,$ENV{QUERY_STRING});"
NSQ_SOURCE_LINE 00001363 "\t    my($param,$value);"
NSQ_SOURCE_LINE 00001364 "\t    for (@pairs) {"
NSQ_SOURCE_LINE 00001365 "\t\t($param,$value) = split('=',$_,2);"
NSQ_SOURCE_LINE 00001366 "\t\tnext if ! defined($param);"
NSQ_SOURCE_LINE 00001367 "\t\t$param = unescape($param);"
NSQ_SOURCE_LINE 00001368 "\t\t$value = unescape($value);"
NSQ_SOURCE_LINE 00001369 "\t\tpush(@{$self->{'.url_param'}->{$param}},$value);"
NSQ_SOURCE_LINE 00001370 "\t    }"
NSQ_SOURCE_LINE 00001371 "\t} else {"
NSQ_SOURCE_LINE 00001372 "        my @keywords = $self->parse_keywordlist($ENV{QUERY_STRING});"
NSQ_SOURCE_LINE 00001373 "\t    $self->{'.url_param'}{'keywords'} = \\@keywords if @keywords;"
NSQ_SOURCE_LINE 00001374 "\t}"
NSQ_SOURCE_LINE 00001375 "    }"
NSQ_SOURCE_LINE 00001376 "    return keys %{$self->{'.url_param'}} unless defined($name);"
NSQ_SOURCE_LINE 00001377 "    return () unless $self->{'.url_param'}->{$name};"
NSQ_SOURCE_LINE 00001378 "    return wantarray ? @{$self->{'.url_param'}->{$name}}"
NSQ_SOURCE_LINE 00001379 "                     : $self->{'.url_param'}->{$name}->[0];"
NSQ_SOURCE_LINE 00001380 "}"
NSQ_SOURCE_LINE 00001381 ""
NSQ_SOURCE_LINE 00001382 "#### Method: Dump"
NSQ_SOURCE_LINE 00001383 "# Returns a string in which all the known parameter/value "
NSQ_SOURCE_LINE 00001384 "# pairs are represented as nested lists, mainly for the purposes "
NSQ_SOURCE_LINE 00001385 "# of debugging."
NSQ_SOURCE_LINE 00001386 "####"
NSQ_SOURCE_LINE 00001387 "sub Dump {"
NSQ_SOURCE_LINE 00001388 "    my($self) = self_or_default(@_);"
NSQ_SOURCE_LINE 00001389 "    my($param,$value,@result);"
NSQ_SOURCE_LINE 00001390 "    return '<ul></ul>' unless $self->param;"
NSQ_SOURCE_LINE 00001391 "    push(@result,\"<ul>\");"
NSQ_SOURCE_LINE 00001392 "    for $param ($self->param) {"
NSQ_SOURCE_LINE 00001393 "\tmy($name)=$self->_maybe_escapeHTML($param);"
NSQ_SOURCE_LINE 00001394 "\tpush(@result,\"<li><strong>$name</strong></li>\");"
NSQ_SOURCE_LINE 00001395 "\tpush(@result,\"<ul>\");"
NSQ_SOURCE_LINE 00001396 "\tfor $value ($self->param($param)) {"
NSQ_SOURCE_LINE 00001397 "\t    $value = $self->_maybe_escapeHTML($value);"
NSQ_SOURCE_LINE 00001398 "            $value =~ s/\\n/<br \\/>\\n/g;"
NSQ_SOURCE_LINE 00001399 "\t    push(@result,\"<li>$value</li>\");"
NSQ_SOURCE_LINE 00001400 "\t}"
NSQ_SOURCE_LINE 00001401 "\tpush(@result,\"</ul>\");"
NSQ_SOURCE_LINE 00001402 "    }"
NSQ_SOURCE_LINE 00001403 "    push(@result,\"</ul>\");"
NSQ_SOURCE_LINE 00001404 "    return join(\"\\n\",@result);"
NSQ_SOURCE_LINE 00001405 "}"
NSQ_SOURCE_LINE 00001406 ""
NSQ_SOURCE_LINE 00001407 "#### Method as_string"
NSQ_SOURCE_LINE 00001408 "#"
NSQ_SOURCE_LINE 00001409 "# synonym for \"dump\""
NSQ_SOURCE_LINE 00001410 "####"
NSQ_SOURCE_LINE 00001411 "sub as_string {"
NSQ_SOURCE_LINE 00001412 "    &Dump(@_);"
NSQ_SOURCE_LINE 00001413 "}"
NSQ_SOURCE_LINE 00001414 ""
NSQ_SOURCE_LINE 00001415 "#### Method: save"
NSQ_SOURCE_LINE 00001416 "# Write values out to a filehandle in such a way that they can"
NSQ_SOURCE_LINE 00001417 "# be reinitialized by the filehandle form of the new() method"
NSQ_SOURCE_LINE 00001418 "####"
NSQ_SOURCE_LINE 00001419 "sub save {"
NSQ_SOURCE_LINE 00001420 "    my($self,$filehandle) = self_or_default(@_);"
NSQ_SOURCE_LINE 00001421 "    $filehandle = to_filehandle($filehandle);"
NSQ_SOURCE_LINE 00001422 "    my($param);"
NSQ_SOURCE_LINE 00001423 "    local($,) = '';  # set print field separator back to a sane value"
NSQ_SOURCE_LINE 00001424 "    local($\\) = '';  # set output line separator to a sane value"
NSQ_SOURCE_LINE 00001425 "    for $param ($self->param) {"
NSQ_SOURCE_LINE 00001426 "\tmy($escaped_param) = escape($param);"
NSQ_SOURCE_LINE 00001427 "\tmy($value);"
NSQ_SOURCE_LINE 00001428 "\tfor $value ($self->param($param)) {"
NSQ_SOURCE_LINE 00001429 "\t    print $filehandle \"$escaped_param=\",escape(\"$value\"),\"\\n\""
NSQ_SOURCE_LINE 00001430 "\t        if length($escaped_param) or length($value);"
NSQ_SOURCE_LINE 00001431 "\t}"
NSQ_SOURCE_LINE 00001432 "    }"
NSQ_SOURCE_LINE 00001433 "    for (sort keys %{$self->{'.fieldnames'}}) {"
NSQ_SOURCE_LINE 00001434 "          print $filehandle \".cgifields=\",escape(\"$_\"),\"\\n\";"
NSQ_SOURCE_LINE 00001435 "    }"
NSQ_SOURCE_LINE 00001436 "    print $filehandle \"=\\n\";    # end of record"
NSQ_SOURCE_LINE 00001437 "}"
NSQ_SOURCE_LINE 00001438 ""
NSQ_SOURCE_LINE 00001439 "#### Method: save_parameters"
NSQ_SOURCE_LINE 00001440 "# An alias for save() that is a better name for exportation."
NSQ_SOURCE_LINE 00001441 "# Only intended to be used with the function (non-OO) interface."
NSQ_SOURCE_LINE 00001442 "####"
NSQ_SOURCE_LINE 00001443 "sub save_parameters {"
NSQ_SOURCE_LINE 00001444 "    my $fh = shift;"
NSQ_SOURCE_LINE 00001445 "    return save(to_filehandle($fh));"
NSQ_SOURCE_LINE 00001446 "}"
NSQ_SOURCE_LINE 00001447 ""
NSQ_SOURCE_LINE 00001448 "#### Method: restore_parameters"
NSQ_SOURCE_LINE 00001449 "# A way to restore CGI parameters from an initializer."
NSQ_SOURCE_LINE 00001450 "# Only intended to be used with the function (non-OO) interface."
NSQ_SOURCE_LINE 00001451 "####"
NSQ_SOURCE_LINE 00001452 "sub restore_parameters {"
NSQ_SOURCE_LINE 00001453 "    $Q = $CGI::DefaultClass->new(@_);"
NSQ_SOURCE_LINE 00001454 "}"
NSQ_SOURCE_LINE 00001455 ""
NSQ_SOURCE_LINE 00001456 "#### Method: multipart_init"
NSQ_SOURCE_LINE 00001457 "# Return a Content-Type: style header for server-push"
NSQ_SOURCE_LINE 00001458 "# This has to be NPH on most web servers, and it is advisable to set $| = 1"
NSQ_SOURCE_LINE 00001459 "#"
NSQ_SOURCE_LINE 00001460 "# Many thanks to Ed Jordan <ed@fidalgo.net> for this"
NSQ_SOURCE_LINE 00001461 "# contribution, updated by Andrew Benham (adsb@bigfoot.com)"
NSQ_SOURCE_LINE 00001462 "####"
NSQ_SOURCE_LINE 00001463 "sub multipart_init {"
NSQ_SOURCE_LINE 00001464 "    my($self,@p) = self_or_default(@_);"
NSQ_SOURCE_LINE 00001465 "    my($boundary,$charset,@other) = rearrange_header([BOUNDARY,CHARSET],@p);"
NSQ_SOURCE_LINE 00001466 "    if (!$boundary) {"
NSQ_SOURCE_LINE 00001467 "        $boundary = '------- =_';"
NSQ_SOURCE_LINE 00001468 "        my @chrs = ('0'..'9', 'A'..'Z', 'a'..'z');"
NSQ_SOURCE_LINE 00001469 "        for (1..17) {"
NSQ_SOURCE_LINE 00001470 "            $boundary .= $chrs[rand(scalar @chrs)];"
NSQ_SOURCE_LINE 00001471 "        }"
NSQ_SOURCE_LINE 00001472 "    }"
NSQ_SOURCE_LINE 00001473 ""
NSQ_SOURCE_LINE 00001474 "    $self->{'separator'} = \"$CRLF--$boundary$CRLF\";"
NSQ_SOURCE_LINE 00001475 "    $self->{'final_separator'} = \"$CRLF--$boundary--$CRLF\";"
NSQ_SOURCE_LINE 00001476 "    $type = SERVER_PUSH($boundary);"
NSQ_SOURCE_LINE 00001477 "    return $self->header("
NSQ_SOURCE_LINE 00001478 "\t-nph => 0,"
NSQ_SOURCE_LINE 00001479 "\t-type => $type,"
NSQ_SOURCE_LINE 00001480 "    -charset => $charset,"
NSQ_SOURCE_LINE 00001481 "\t(map { split \"=\", $_, 2 } @other),"
NSQ_SOURCE_LINE 00001482 "    ) . \"WARNING: YOUR BROWSER DOESN'T SUPPORT THIS SERVER-PUSH TECHNOLOGY.\" . $self->multipart_end;"
NSQ_SOURCE_LINE 00001483 "}"
NSQ_SOURCE_LINE 00001484 ""
NSQ_SOURCE_LINE 00001485 "#### Method: multipart_start"
NSQ_SOURCE_LINE 00001486 "# Return a Content-Type: style header for server-push, start of section"
NSQ_SOURCE_LINE 00001487 "#"
NSQ_SOURCE_LINE 00001488 "# Many thanks to Ed Jordan <ed@fidalgo.net> for this"
NSQ_SOURCE_LINE 00001489 "# contribution, updated by Andrew Benham (adsb@bigfoot.com)"
NSQ_SOURCE_LINE 00001490 "####"
NSQ_SOURCE_LINE 00001491 "sub multipart_start {"
NSQ_SOURCE_LINE 00001492 "    my(@header);"
NSQ_SOURCE_LINE 00001493 "    my($self,@p) = self_or_default(@_);"
NSQ_SOURCE_LINE 00001494 "    my($type,$charset,@other) = rearrange([TYPE,CHARSET],@p);"
NSQ_SOURCE_LINE 00001495 "    $type = $type || 'text/html';"
NSQ_SOURCE_LINE 00001496 "    if ($charset) {"
NSQ_SOURCE_LINE 00001497 "        push(@header,\"Content-Type: $type; charset=$charset\");"
NSQ_SOURCE_LINE 00001498 "    } else {"
NSQ_SOURCE_LINE 00001499 "        push(@header,\"Content-Type: $type\");"
NSQ_SOURCE_LINE 00001500 "    }"
NSQ_SOURCE_LINE 00001501 ""
NSQ_SOURCE_LINE 00001502 "    # rearrange() was designed for the HTML portion, so we"
NSQ_SOURCE_LINE 00001503 "    # need to fix it up a little."
NSQ_SOURCE_LINE 00001504 "    for (@other) {"
NSQ_SOURCE_LINE 00001505 "        # Don't use \\s because of perl bug 21951"
NSQ_SOURCE_LINE 00001506 "        next unless my($header,$value) = /([^ \\r\\n\\t=]+)=\\\"?(.+?)\\\"?$/;"
NSQ_SOURCE_LINE 00001507 "        ($_ = $header) =~ s/^(\\w)(.*)/$1 . lc ($2) . ': '.$self->unescapeHTML($value)/e;"
NSQ_SOURCE_LINE 00001508 "    }"
NSQ_SOURCE_LINE 00001509 "    push(@header,@other);"
NSQ_SOURCE_LINE 00001510 "    my $header = join($CRLF,@header).\"${CRLF}${CRLF}\";"
NSQ_SOURCE_LINE 00001511 "    return $header;"
NSQ_SOURCE_LINE 00001512 "}"
NSQ_SOURCE_LINE 00001513 ""
NSQ_SOURCE_LINE 00001514 "#### Method: multipart_end"
NSQ_SOURCE_LINE 00001515 "# Return a MIME boundary separator for server-push, end of section"
NSQ_SOURCE_LINE 00001516 "#"
NSQ_SOURCE_LINE 00001517 "# Many thanks to Ed Jordan <ed@fidalgo.net> for this"
NSQ_SOURCE_LINE 00001518 "# contribution"
NSQ_SOURCE_LINE 00001519 "####"
NSQ_SOURCE_LINE 00001520 "sub multipart_end {"
NSQ_SOURCE_LINE 00001521 "    my($self,@p) = self_or_default(@_);"
NSQ_SOURCE_LINE 00001522 "    return $self->{'separator'};"
NSQ_SOURCE_LINE 00001523 "}"
NSQ_SOURCE_LINE 00001524 ""
NSQ_SOURCE_LINE 00001525 "#### Method: multipart_final"
NSQ_SOURCE_LINE 00001526 "# Return a MIME boundary separator for server-push, end of all sections"
NSQ_SOURCE_LINE 00001527 "#"
NSQ_SOURCE_LINE 00001528 "# Contributed by Andrew Benham (adsb@bigfoot.com)"
NSQ_SOURCE_LINE 00001529 "####"
NSQ_SOURCE_LINE 00001530 "sub multipart_final {"
NSQ_SOURCE_LINE 00001531 "    my($self,@p) = self_or_default(@_);"
NSQ_SOURCE_LINE 00001532 "    return $self->{'final_separator'} . \"WARNING: YOUR BROWSER DOESN'T SUPPORT THIS SERVER-PUSH TECHNOLOGY.\" . $CRLF;"
NSQ_SOURCE_LINE 00001533 "}"
NSQ_SOURCE_LINE 00001534 ""
NSQ_SOURCE_LINE 00001535 "#### Method: header"
NSQ_SOURCE_LINE 00001536 "# Return a Content-Type: style header"
NSQ_SOURCE_LINE 00001537 "#"
NSQ_SOURCE_LINE 00001538 "####"
NSQ_SOURCE_LINE 00001539 "sub header {"
NSQ_SOURCE_LINE 00001540 "    my($self,@p) = self_or_default(@_);"
NSQ_SOURCE_LINE 00001541 "    my(@header);"
NSQ_SOURCE_LINE 00001542 ""
NSQ_SOURCE_LINE 00001543 "    return \"\" if $self->{'.header_printed'}++ and $HEADERS_ONCE;"
NSQ_SOURCE_LINE 00001544 ""
NSQ_SOURCE_LINE 00001545 "    my($type,$status,$cookie,$target,$expires,$nph,$charset,$attachment,$p3p,@other) = "
NSQ_SOURCE_LINE 00001546 "\trearrange([['TYPE','CONTENT_TYPE','CONTENT-TYPE'],"
NSQ_SOURCE_LINE 00001547 "\t\t\t    'STATUS',['COOKIE','COOKIES','SET-COOKIE'],'TARGET',"
NSQ_SOURCE_LINE 00001548 "                            'EXPIRES','NPH','CHARSET',"
NSQ_SOURCE_LINE 00001549 "                            'ATTACHMENT','P3P'],@p);"
NSQ_SOURCE_LINE 00001550 ""
NSQ_SOURCE_LINE 00001551 "    # Since $cookie and $p3p may be array references,"
NSQ_SOURCE_LINE 00001552 "    # we must stringify them before CR escaping is done."
NSQ_SOURCE_LINE 00001553 "    my @cookie;"
NSQ_SOURCE_LINE 00001554 "    for (ref($cookie) eq 'ARRAY' ? @{$cookie} : $cookie) {"
NSQ_SOURCE_LINE 00001555 "        my $cs = UNIVERSAL::isa($_,'CGI::Cookie') ? $_->as_string : $_;"
NSQ_SOURCE_LINE 00001556 "        push(@cookie,$cs) if defined $cs and $cs ne '';"
NSQ_SOURCE_LINE 00001557 "    }"
NSQ_SOURCE_LINE 00001558 "    $p3p = join ' ',@$p3p if ref($p3p) eq 'ARRAY';"
NSQ_SOURCE_LINE 00001559 ""
NSQ_SOURCE_LINE 00001560 "    # CR escaping for values, per RFC 822"
NSQ_SOURCE_LINE 00001561 "    for my $header ($type,$status,@cookie,$target,$expires,$nph,$charset,$attachment,$p3p,@other) {"
NSQ_SOURCE_LINE 00001562 "        if (defined $header) {"
NSQ_SOURCE_LINE 00001563 "            # From RFC 822:"
NSQ_SOURCE_LINE 00001564 "            # Unfolding  is  accomplished  by regarding   CRLF   immediately"
NSQ_SOURCE_LINE 00001565 "            # followed  by  a  LWSP-char  as equivalent to the LWSP-char."
NSQ_SOURCE_LINE 00001566 "            $header =~ s/$CRLF(\\s)/$1/g;"
NSQ_SOURCE_LINE 00001567 ""
NSQ_SOURCE_LINE 00001568 "            # All other uses of newlines are invalid input. "
NSQ_SOURCE_LINE 00001569 "            if ($header =~ m/$CRLF|\\015|\\012/) {"
NSQ_SOURCE_LINE 00001570 "                # shorten very long values in the diagnostic"
NSQ_SOURCE_LINE 00001571 "                $header = substr($header,0,72).'...' if (length $header > 72);"
NSQ_SOURCE_LINE 00001572 "                die \"Invalid header value contains a newline not followed by whitespace: $header\";"
NSQ_SOURCE_LINE 00001573 "            }"
NSQ_SOURCE_LINE 00001574 "        } "
NSQ_SOURCE_LINE 00001575 "   }"
NSQ_SOURCE_LINE 00001576 ""
NSQ_SOURCE_LINE 00001577 "    $nph     ||= $NPH;"
NSQ_SOURCE_LINE 00001578 ""
NSQ_SOURCE_LINE 00001579 "    $type ||= 'text/html' unless defined($type);"
NSQ_SOURCE_LINE 00001580 ""
NSQ_SOURCE_LINE 00001581 "    # sets if $charset is given, gets if not"
NSQ_SOURCE_LINE 00001582 "    $charset = $self->charset( $charset );"
NSQ_SOURCE_LINE 00001583 ""
NSQ_SOURCE_LINE 00001584 "    # rearrange() was designed for the HTML portion, so we"
NSQ_SOURCE_LINE 00001585 "    # need to fix it up a little."
NSQ_SOURCE_LINE 00001586 "    for (@other) {"
NSQ_SOURCE_LINE 00001587 "        # Don't use \\s because of perl bug 21951"
NSQ_SOURCE_LINE 00001588 "        next unless my($header,$value) = /([^ \\r\\n\\t=]+)=\\\"?(.+?)\\\"?$/s;"
NSQ_SOURCE_LINE 00001589 "        ($_ = $header) =~ s/^(\\w)(.*)/\"\\u$1\\L$2\" . ': '.$self->unescapeHTML($value)/e;"
NSQ_SOURCE_LINE 00001590 "    }"
NSQ_SOURCE_LINE 00001591 ""
NSQ_SOURCE_LINE 00001592 "    $type .= \"; charset=$charset\""
NSQ_SOURCE_LINE 00001593 "      if     $type ne ''"
NSQ_SOURCE_LINE 00001594 "         and $type !~ /\\bcharset\\b/"
NSQ_SOURCE_LINE 00001595 "         and defined $charset"
NSQ_SOURCE_LINE 00001596 "         and $charset ne '';"
NSQ_SOURCE_LINE 00001597 ""
NSQ_SOURCE_LINE 00001598 "    # Maybe future compatibility.  Maybe not."
NSQ_SOURCE_LINE 00001599 "    my $protocol = $ENV{SERVER_PROTOCOL} || 'HTTP/1.0';"
NSQ_SOURCE_LINE 00001600 "    push(@header,$protocol . ' ' . ($status || '200 OK')) if $nph;"
NSQ_SOURCE_LINE 00001601 "    push(@header,\"Server: \" . &server_software()) if $nph;"
NSQ_SOURCE_LINE 00001602 ""
NSQ_SOURCE_LINE 00001603 "    push(@header,\"Status: $status\") if $status;"
NSQ_SOURCE_LINE 00001604 "    push(@header,\"Window-Target: $target\") if $target;"
NSQ_SOURCE_LINE 00001605 "    push(@header,\"P3P: policyref=\\\"/w3c/p3p.xml\\\", CP=\\\"$p3p\\\"\") if $p3p;"
NSQ_SOURCE_LINE 00001606 "    # push all the cookies -- there may be several"
NSQ_SOURCE_LINE 00001607 "    push(@header,map {\"Set-Cookie: $_\"} @cookie);"
NSQ_SOURCE_LINE 00001608 "    # if the user indicates an expiration time, then we need"
NSQ_SOURCE_LINE 00001609 "    # both an Expires and a Date header (so that the browser is"
NSQ_SOURCE_LINE 00001610 "    # uses OUR clock)"
NSQ_SOURCE_LINE 00001611 "    push(@header,\"Expires: \" . expires($expires))"
NSQ_SOURCE_LINE 00001612 "\tif $expires;"
NSQ_SOURCE_LINE 00001613 "    push(@header,\"Date: \" . expires(0)) if $expires || $cookie || $nph;"
NSQ_SOURCE_LINE 00001614 "    push(@header,\"Pragma: no-cache\") if $self->cache();"
NSQ_SOURCE_LINE 00001615 "    push(@header,\"Content-Disposition: attachment; filename=\\\"$attachment\\\"\") if $attachment;"
NSQ_SOURCE_LINE 00001616 "    push(@header,map {ucfirst $_} @other);"
NSQ_SOURCE_LINE 00001617 "    push(@header,\"Content-Type: $type\") if $type ne '';"
NSQ_SOURCE_LINE 00001618 "    my $header = join($CRLF,@header).\"${CRLF}${CRLF}\";"
NSQ_SOURCE_LINE 00001619 "    if (($MOD_PERL >= 1) && !$nph) {"
NSQ_SOURCE_LINE 00001620 "        $self->r->send_cgi_header($header);"
NSQ_SOURCE_LINE 00001621 "        return '';"
NSQ_SOURCE_LINE 00001622 "    }"
NSQ_SOURCE_LINE 00001623 "    return $header;"
NSQ_SOURCE_LINE 00001624 "}"
NSQ_SOURCE_LINE 00001625 ""
NSQ_SOURCE_LINE 00001626 "#### Method: cache"
NSQ_SOURCE_LINE 00001627 "# Control whether header() will produce the no-cache"
NSQ_SOURCE_LINE 00001628 "# Pragma directive."
NSQ_SOURCE_LINE 00001629 "####"
NSQ_SOURCE_LINE 00001630 "sub cache {"
NSQ_SOURCE_LINE 00001631 "    my($self,$new_value) = self_or_default(@_);"
NSQ_SOURCE_LINE 00001632 "    $new_value = '' unless $new_value;"
NSQ_SOURCE_LINE 00001633 "    if ($new_value ne '') {"
NSQ_SOURCE_LINE 00001634 "\t$self->{'cache'} = $new_value;"
NSQ_SOURCE_LINE 00001635 "    }"
NSQ_SOURCE_LINE 00001636 "    return $self->{'cache'};"
NSQ_SOURCE_LINE 00001637 "}"
NSQ_SOURCE_LINE 00001638 ""
NSQ_SOURCE_LINE 00001639 "#### Method: redirect"
NSQ_SOURCE_LINE 00001640 "# Return a Location: style header"
NSQ_SOURCE_LINE 00001641 "#"
NSQ_SOURCE_LINE 00001642 "####"
NSQ_SOURCE_LINE 00001643 "sub redirect {"
NSQ_SOURCE_LINE 00001644 "    my($self,@p) = self_or_default(@_);"
NSQ_SOURCE_LINE 00001645 "    my($url,$target,$status,$cookie,$nph,@other) = "
NSQ_SOURCE_LINE 00001646 "         rearrange([[LOCATION,URI,URL],TARGET,STATUS,['COOKIE','COOKIES','SET-COOKIE'],NPH],@p);"
NSQ_SOURCE_LINE 00001647 "    $status = '302 Found' unless defined $status;"
NSQ_SOURCE_LINE 00001648 "    $url ||= $self->self_url;"
NSQ_SOURCE_LINE 00001649 "    my(@o);"
NSQ_SOURCE_LINE 00001650 "    for (@other) { tr/\\\"//d; push(@o,split(\"=\",$_,2)); }"
NSQ_SOURCE_LINE 00001651 "    unshift(@o,"
NSQ_SOURCE_LINE 00001652 "\t '-Status'  => $status,"
NSQ_SOURCE_LINE 00001653 "\t '-Location'=> $url,"
NSQ_SOURCE_LINE 00001654 "\t '-nph'     => $nph);"
NSQ_SOURCE_LINE 00001655 "    unshift(@o,'-Target'=>$target) if $target;"
NSQ_SOURCE_LINE 00001656 "    unshift(@o,'-Type'=>'');"
NSQ_SOURCE_LINE 00001657 "    my @unescaped;"
NSQ_SOURCE_LINE 00001658 "    unshift(@unescaped,'-Cookie'=>$cookie) if $cookie;"
NSQ_SOURCE_LINE 00001659 "    return $self->header((map {$self->unescapeHTML($_)} @o),@unescaped);"
NSQ_SOURCE_LINE 00001660 "}"
NSQ_SOURCE_LINE 00001661 ""
NSQ_SOURCE_LINE 00001662 "#### Method: start_html"
NSQ_SOURCE_LINE 00001663 "# Canned HTML header"
NSQ_SOURCE_LINE 00001664 "#"
NSQ_SOURCE_LINE 00001665 "# Parameters:"
NSQ_SOURCE_LINE 00001666 "# $title -> (optional) The title for this HTML document (-title)"
NSQ_SOURCE_LINE 00001667 "# $author -> (optional) e-mail address of the author (-author)"
NSQ_SOURCE_LINE 00001668 "# $base -> (optional) if set to true, will enter the BASE address of this document"
NSQ_SOURCE_LINE 00001669 "#          for resolving relative references (-base) "
NSQ_SOURCE_LINE 00001670 "# $xbase -> (optional) alternative base at some remote location (-xbase)"
NSQ_SOURCE_LINE 00001671 "# $target -> (optional) target window to load all links into (-target)"
NSQ_SOURCE_LINE 00001672 "# $script -> (option) Javascript code (-script)"
NSQ_SOURCE_LINE 00001673 "# $no_script -> (option) Javascript <noscript> tag (-noscript)"
NSQ_SOURCE_LINE 00001674 "# $meta -> (optional) Meta information tags"
NSQ_SOURCE_LINE 00001675 "# $head -> (optional) any other elements you'd like to incorporate into the <head> tag"
NSQ_SOURCE_LINE 00001676 "#           (a scalar or array ref)"
NSQ_SOURCE_LINE 00001677 "# $style -> (optional) reference to an external style sheet"
NSQ_SOURCE_LINE 00001678 "# @other -> (optional) any other named parameters you'd like to incorporate into"
NSQ_SOURCE_LINE 00001679 "#           the <body> tag."
NSQ_SOURCE_LINE 00001680 "####"
NSQ_SOURCE_LINE 00001681 "sub start_html {"
NSQ_SOURCE_LINE 00001682 "    my($self,@p) = &self_or_default(@_);"
NSQ_SOURCE_LINE 00001683 "    my($title,$author,$base,$xbase,$script,$noscript,"
NSQ_SOURCE_LINE 00001684 "        $target,$meta,$head,$style,$dtd,$lang,$encoding,$declare_xml,@other) = "
NSQ_SOURCE_LINE 00001685 "\trearrange([TITLE,AUTHOR,BASE,XBASE,SCRIPT,NOSCRIPT,TARGET,"
NSQ_SOURCE_LINE 00001686 "                   META,HEAD,STYLE,DTD,LANG,ENCODING,DECLARE_XML],@p);"
NSQ_SOURCE_LINE 00001687 ""
NSQ_SOURCE_LINE 00001688 "    $self->element_id(0);"
NSQ_SOURCE_LINE 00001689 "    $self->element_tab(0);"
NSQ_SOURCE_LINE 00001690 ""
NSQ_SOURCE_LINE 00001691 "    $encoding = lc($self->charset) unless defined $encoding;"
NSQ_SOURCE_LINE 00001692 ""
NSQ_SOURCE_LINE 00001693 "    # Need to sort out the DTD before it's okay to call escapeHTML()."
NSQ_SOURCE_LINE 00001694 "    my(@result,$xml_dtd);"
NSQ_SOURCE_LINE 00001695 "    if ($dtd) {"
NSQ_SOURCE_LINE 00001696 "        if (defined(ref($dtd)) and (ref($dtd) eq 'ARRAY')) {"
NSQ_SOURCE_LINE 00001697 "            $dtd = $DEFAULT_DTD unless $dtd->[0] =~ m|^-//|;"
NSQ_SOURCE_LINE 00001698 "        } else {"
NSQ_SOURCE_LINE 00001699 "            $dtd = $DEFAULT_DTD unless $dtd =~ m|^-//|;"
NSQ_SOURCE_LINE 00001700 "        }"
NSQ_SOURCE_LINE 00001701 "    } else {"
NSQ_SOURCE_LINE 00001702 "        $dtd = $XHTML ? $_XHTML_DTD : $DEFAULT_DTD;"
NSQ_SOURCE_LINE 00001703 "    }"
NSQ_SOURCE_LINE 00001704 ""
NSQ_SOURCE_LINE 00001705 "    $xml_dtd++ if ref($dtd) eq 'ARRAY' && $dtd->[0] =~ /\\bXHTML\\b/i;"
NSQ_SOURCE_LINE 00001706 "    $xml_dtd++ if ref($dtd) eq '' && $dtd =~ /\\bXHTML\\b/i;"
NSQ_SOURCE_LINE 00001707 "    push @result,qq(<?xml version=\"1.0\" encoding=\"$encoding\"?>) if $xml_dtd && $declare_xml;"
NSQ_SOURCE_LINE 00001708 ""
NSQ_SOURCE_LINE 00001709 "    if (ref($dtd) && ref($dtd) eq 'ARRAY') {"
NSQ_SOURCE_LINE 00001710 "        push(@result,qq(<!DOCTYPE html\\n\\tPUBLIC \"$dtd->[0]\"\\n\\t \"$dtd->[1]\">));"
NSQ_SOURCE_LINE 00001711 "\t$DTD_PUBLIC_IDENTIFIER = $dtd->[0];"
NSQ_SOURCE_LINE 00001712 "    } else {"
NSQ_SOURCE_LINE 00001713 "        push(@result,qq(<!DOCTYPE html\\n\\tPUBLIC \"$dtd\">));"
NSQ_SOURCE_LINE 00001714 "\t$DTD_PUBLIC_IDENTIFIER = $dtd;"
NSQ_SOURCE_LINE 00001715 "    }"
NSQ_SOURCE_LINE 00001716 ""
NSQ_SOURCE_LINE 00001717 "    # Now that we know whether we're using the HTML 3.2 DTD or not, it's okay to"
NSQ_SOURCE_LINE 00001718 "    # call escapeHTML().  Strangely enough, the title needs to be escaped as"
NSQ_SOURCE_LINE 00001719 "    # HTML while the author needs to be escaped as a URL."
NSQ_SOURCE_LINE 00001720 "    $title = $self->_maybe_escapeHTML($title || 'Untitled Document');"
NSQ_SOURCE_LINE 00001721 "    $author = $self->escape($author);"
NSQ_SOURCE_LINE 00001722 ""
NSQ_SOURCE_LINE 00001723 "    if ($DTD_PUBLIC_IDENTIFIER =~ /[^X]HTML (2\\.0|3\\.2|4\\.01?)/i) {"
NSQ_SOURCE_LINE 00001724 "\t$lang = \"\" unless defined $lang;"
NSQ_SOURCE_LINE 00001725 "\t$XHTML = 0;"
NSQ_SOURCE_LINE 00001726 "    }"
NSQ_SOURCE_LINE 00001727 "    else {"
NSQ_SOURCE_LINE 00001728 "\t$lang = 'en-US' unless defined $lang;"
NSQ_SOURCE_LINE 00001729 "    }"
NSQ_SOURCE_LINE 00001730 ""
NSQ_SOURCE_LINE 00001731 "    my $lang_bits = $lang ne '' ? qq( lang=\"$lang\" xml:lang=\"$lang\") : '';"
NSQ_SOURCE_LINE 00001732 "    my $meta_bits = qq(<meta http-equiv=\"Content-Type\" content=\"text/html; charset=$encoding\" />) "
NSQ_SOURCE_LINE 00001733 "                    if $XHTML && $encoding && !$declare_xml;"
NSQ_SOURCE_LINE 00001734 ""
NSQ_SOURCE_LINE 00001735 "    push(@result,$XHTML ? qq(<html xmlns=\"http://www.w3.org/1999/xhtml\"$lang_bits>\\n<head>\\n<title>$title</title>)"
NSQ_SOURCE_LINE 00001736 "                        : ($lang ? qq(<html lang=\"$lang\">) : \"<html>\")"
NSQ_SOURCE_LINE 00001737 "\t                  . \"<head><title>$title</title>\");"
NSQ_SOURCE_LINE 00001738 "\tif (defined $author) {"
NSQ_SOURCE_LINE 00001739 "    push(@result,$XHTML ? \"<link rev=\\\"made\\\" href=\\\"mailto:$author\\\" />\""
NSQ_SOURCE_LINE 00001740 "\t\t\t: \"<link rev=\\\"made\\\" href=\\\"mailto:$author\\\">\");"
NSQ_SOURCE_LINE 00001741 "\t}"
NSQ_SOURCE_LINE 00001742 ""
NSQ_SOURCE_LINE 00001743 "    if ($base || $xbase || $target) {"
NSQ_SOURCE_LINE 00001744 "\tmy $href = $xbase || $self->url('-path'=>1);"
NSQ_SOURCE_LINE 00001745 "\tmy $t = $target ? qq/ target=\"$target\"/ : '';"
NSQ_SOURCE_LINE 00001746 "\tpush(@result,$XHTML ? qq(<base href=\"$href\"$t />) : qq(<base href=\"$href\"$t>));"
NSQ_SOURCE_LINE 00001747 "    }"
NSQ_SOURCE_LINE 00001748 ""
NSQ_SOURCE_LINE 00001749 "    if ($meta && ref($meta) && (ref($meta) eq 'HASH')) {"
NSQ_SOURCE_LINE 00001750 "\tfor (sort keys %$meta) { push(@result,$XHTML ? qq(<meta name=\"$_\" content=\"$meta->{$_}\" />) "
NSQ_SOURCE_LINE 00001751 "\t\t\t: qq(<meta name=\"$_\" content=\"$meta->{$_}\">)); }"
NSQ_SOURCE_LINE 00001752 "    }"
NSQ_SOURCE_LINE 00001753 ""
NSQ_SOURCE_LINE 00001754 "    my $meta_bits_set = 0;"
NSQ_SOURCE_LINE 00001755 "    if( $head ) {"
NSQ_SOURCE_LINE 00001756 "        if( ref $head ) {"
NSQ_SOURCE_LINE 00001757 "            push @result, @$head;"
NSQ_SOURCE_LINE 00001758 "            $meta_bits_set = 1 if grep { /http-equiv=[\"']Content-Type/i }@$head;"
NSQ_SOURCE_LINE 00001759 "        }"
NSQ_SOURCE_LINE 00001760 "        else {"
NSQ_SOURCE_LINE 00001761 "            push @result, $head;"
NSQ_SOURCE_LINE 00001762 "            $meta_bits_set = 1 if $head =~ /http-equiv=[\"']Content-Type/i;"
NSQ_SOURCE_LINE 00001763 "        }"
NSQ_SOURCE_LINE 00001764 "    }"
NSQ_SOURCE_LINE 00001765 ""
NSQ_SOURCE_LINE 00001766 "    # handle the infrequently-used -style and -script parameters"
NSQ_SOURCE_LINE 00001767 "    push(@result,$self->_style($style))   if defined $style;"
NSQ_SOURCE_LINE 00001768 "    push(@result,$self->_script($script)) if defined $script;"
NSQ_SOURCE_LINE 00001769 "    push(@result,$meta_bits)              if defined $meta_bits and !$meta_bits_set;"
NSQ_SOURCE_LINE 00001770 ""
NSQ_SOURCE_LINE 00001771 "    # handle -noscript parameter"
NSQ_SOURCE_LINE 00001772 "    push(@result,<<END) if $noscript;"
NSQ_SOURCE_LINE 00001773 "<noscript>"
NSQ_SOURCE_LINE 00001774 "$noscript"
NSQ_SOURCE_LINE 00001775 "</noscript>"
NSQ_SOURCE_LINE 00001776 "END"
NSQ_SOURCE_LINE 00001777 "    ;"
NSQ_SOURCE_LINE 00001778 "    my($other) = @other ? \" @other\" : '';"
NSQ_SOURCE_LINE 00001779 "    push(@result,\"</head>\\n<body$other>\\n\");"
NSQ_SOURCE_LINE 00001780 "    return join(\"\\n\",@result);"
NSQ_SOURCE_LINE 00001781 "}"
NSQ_SOURCE_LINE 00001782 ""
NSQ_SOURCE_LINE 00001783 "### Method: _style"
NSQ_SOURCE_LINE 00001784 "# internal method for generating a CSS style section"
NSQ_SOURCE_LINE 00001785 "####"
NSQ_SOURCE_LINE 00001786 "sub _style {"
NSQ_SOURCE_LINE 00001787 "    my ($self,$style) = @_;"
NSQ_SOURCE_LINE 00001788 "    my (@result);"
NSQ_SOURCE_LINE 00001789 ""
NSQ_SOURCE_LINE 00001790 "    my $type = 'text/css';"
NSQ_SOURCE_LINE 00001791 "    my $rel  = 'stylesheet';"
NSQ_SOURCE_LINE 00001792 ""
NSQ_SOURCE_LINE 00001793 ""
NSQ_SOURCE_LINE 00001794 "    my $cdata_start = $XHTML ? \"\\n<!--/* <![CDATA[ */\" : \"\\n<!-- \";"
NSQ_SOURCE_LINE 00001795 "    my $cdata_end   = $XHTML ? \"\\n/* ]]> */-->\\n\" : \" -->\\n\";"
NSQ_SOURCE_LINE 00001796 ""
NSQ_SOURCE_LINE 00001797 "    my @s = ref($style) eq 'ARRAY' ? @$style : $style;"
NSQ_SOURCE_LINE 00001798 "    my $other = '';"
NSQ_SOURCE_LINE 00001799 ""
NSQ_SOURCE_LINE 00001800 "    for my $s (@s) {"
NSQ_SOURCE_LINE 00001801 "      if (ref($s)) {"
NSQ_SOURCE_LINE 00001802 "       my($src,$code,$verbatim,$stype,$alternate,$foo,@other) ="
NSQ_SOURCE_LINE 00001803 "           rearrange([qw(SRC CODE VERBATIM TYPE ALTERNATE FOO)],"
NSQ_SOURCE_LINE 00001804 "                      ('-foo'=>'bar',"
NSQ_SOURCE_LINE 00001805 "                       ref($s) eq 'ARRAY' ? @$s : %$s));"
NSQ_SOURCE_LINE 00001806 "       my $type = defined $stype ? $stype : 'text/css';"
NSQ_SOURCE_LINE 00001807 "       my $rel  = $alternate ? 'alternate stylesheet' : 'stylesheet';"
NSQ_SOURCE_LINE 00001808 "       $other = \"@other\" if @other;"
NSQ_SOURCE_LINE 00001809 ""
NSQ_SOURCE_LINE 00001810 "       if (ref($src) eq \"ARRAY\") # Check to see if the $src variable is an array reference"
NSQ_SOURCE_LINE 00001811 "       { # If it is, push a LINK tag for each one"
NSQ_SOURCE_LINE 00001812 "           for $src (@$src)"
NSQ_SOURCE_LINE 00001813 "         {"
NSQ_SOURCE_LINE 00001814 "           push(@result,$XHTML ? qq(<link rel=\"$rel\" type=\"$type\" href=\"$src\" $other/>)"
NSQ_SOURCE_LINE 00001815 "                             : qq(<link rel=\"$rel\" type=\"$type\" href=\"$src\"$other>)) if $src;"
NSQ_SOURCE_LINE 00001816 "         }"
NSQ_SOURCE_LINE 00001817 "       }"
NSQ_SOURCE_LINE 00001818 "       else"
NSQ_SOURCE_LINE 00001819 "       { # Otherwise, push the single -src, if it exists."
NSQ_SOURCE_LINE 00001820 "         push(@result,$XHTML ? qq(<link rel=\"$rel\" type=\"$type\" href=\"$src\" $other/>)"
NSQ_SOURCE_LINE 00001821 "                             : qq(<link rel=\"$rel\" type=\"$type\" href=\"$src\"$other>)"
NSQ_SOURCE_LINE 00001822 "              ) if $src;"
NSQ_SOURCE_LINE 00001823 "        }"
NSQ_SOURCE_LINE 00001824 "     if ($verbatim) {"
NSQ_SOURCE_LINE 00001825 "           my @v = ref($verbatim) eq 'ARRAY' ? @$verbatim : $verbatim;"
NSQ_SOURCE_LINE 00001826 "           push(@result, \"<style type=\\\"text/css\\\">\\n$_\\n</style>\") for @v;"
NSQ_SOURCE_LINE 00001827 "      }"
NSQ_SOURCE_LINE 00001828 "       if ($code) {"
NSQ_SOURCE_LINE 00001829 "         my @c = ref($code) eq 'ARRAY' ? @$code : $code;"
NSQ_SOURCE_LINE 00001830 "         push(@result,style({'type'=>$type},\"$cdata_start\\n$_\\n$cdata_end\")) for @c;"
NSQ_SOURCE_LINE 00001831 "       }"
NSQ_SOURCE_LINE 00001832 ""
NSQ_SOURCE_LINE 00001833 "      } else {"
NSQ_SOURCE_LINE 00001834 "           my $src = $s;"
NSQ_SOURCE_LINE 00001835 "           push(@result,$XHTML ? qq(<link rel=\"$rel\" type=\"$type\" href=\"$src\" $other/>)"
NSQ_SOURCE_LINE 00001836 "                               : qq(<link rel=\"$rel\" type=\"$type\" href=\"$src\"$other>));"
NSQ_SOURCE_LINE 00001837 "      }"
NSQ_SOURCE_LINE 00001838 "    }"
NSQ_SOURCE_LINE 00001839 "    @result;"
NSQ_SOURCE_LINE 00001840 "}"
NSQ_SOURCE_LINE 00001841 ""
NSQ_SOURCE_LINE 00001842 "sub _script {"
NSQ_SOURCE_LINE 00001843 "    my ($self,$script) = @_;"
NSQ_SOURCE_LINE 00001844 "    my (@result);"
NSQ_SOURCE_LINE 00001845 ""
NSQ_SOURCE_LINE 00001846 "    my (@scripts) = ref($script) eq 'ARRAY' ? @$script : ($script);"
NSQ_SOURCE_LINE 00001847 "    for $script (@scripts) {"
NSQ_SOURCE_LINE 00001848 "    my($src,$code,$language,$charset);"
NSQ_SOURCE_LINE 00001849 "    if (ref($script)) { # script is a hash"
NSQ_SOURCE_LINE 00001850 "        ($src,$code,$type,$charset) ="
NSQ_SOURCE_LINE 00001851 "        rearrange(['SRC','CODE',['LANGUAGE','TYPE'],'CHARSET'],"
NSQ_SOURCE_LINE 00001852 "                 '-foo'=>'bar', # a trick to allow the '-' to be omitted"
NSQ_SOURCE_LINE 00001853 "                 ref($script) eq 'ARRAY' ? @$script : %$script);"
NSQ_SOURCE_LINE 00001854 "            $type ||= 'text/javascript';"
NSQ_SOURCE_LINE 00001855 "            unless ($type =~ m!\\w+/\\w+!) {"
NSQ_SOURCE_LINE 00001856 "                $type =~ s/[\\d.]+$//;"
NSQ_SOURCE_LINE 00001857 "                $type = \"text/$type\";"
NSQ_SOURCE_LINE 00001858 "            }"
NSQ_SOURCE_LINE 00001859 "    } else {"
NSQ_SOURCE_LINE 00001860 "        ($src,$code,$type,$charset) = ('',$script, 'text/javascript', '');"
NSQ_SOURCE_LINE 00001861 "    }"
NSQ_SOURCE_LINE 00001862 ""
NSQ_SOURCE_LINE 00001863 "    my $comment = '//';  # javascript by default"
NSQ_SOURCE_LINE 00001864 "    $comment = '#' if $type=~/perl|tcl/i;"
NSQ_SOURCE_LINE 00001865 "    $comment = \"'\" if $type=~/vbscript/i;"
NSQ_SOURCE_LINE 00001866 ""
NSQ_SOURCE_LINE 00001867 "    my ($cdata_start,$cdata_end);"
NSQ_SOURCE_LINE 00001868 "    if ($XHTML) {"
NSQ_SOURCE_LINE 00001869 "       $cdata_start    = \"$comment<![CDATA[\\n\";"
NSQ_SOURCE_LINE 00001870 "       $cdata_end     .= \"\\n$comment]]>\";"
NSQ_SOURCE_LINE 00001871 "    } else {"
NSQ_SOURCE_LINE 00001872 "       $cdata_start  =  \"\\n<!-- Hide script\\n\";"
NSQ_SOURCE_LINE 00001873 "       $cdata_end    = $comment;"
NSQ_SOURCE_LINE 00001874 "       $cdata_end   .= \" End script hiding -->\\n\";"
NSQ_SOURCE_LINE 00001875 "   }"
NSQ_SOURCE_LINE 00001876 "     my(@satts);"
NSQ_SOURCE_LINE 00001877 "     push(@satts,'src'=>$src) if $src;"
NSQ_SOURCE_LINE 00001878 "     push(@satts,'type'=>$type);"
NSQ_SOURCE_LINE 00001879 "     push(@satts,'charset'=>$charset) if ($src && $charset);"
NSQ_SOURCE_LINE 00001880 "     $code = $cdata_start . $code . $cdata_end if defined $code;"
NSQ_SOURCE_LINE 00001881 "     push(@result,$self->script({@satts},$code || ''));"
NSQ_SOURCE_LINE 00001882 "    }"
NSQ_SOURCE_LINE 00001883 "    @result;"
NSQ_SOURCE_LINE 00001884 "}"
NSQ_SOURCE_LINE 00001885 ""
NSQ_SOURCE_LINE 00001886 "#### Method: end_html"
NSQ_SOURCE_LINE 00001887 "# End an HTML document."
NSQ_SOURCE_LINE 00001888 "# Trivial method for completeness.  Just returns \"</body>\""
NSQ_SOURCE_LINE 00001889 "####"
NSQ_SOURCE_LINE 00001890 "sub end_html {"
NSQ_SOURCE_LINE 00001891 "    return \"\\n</body>\\n</html>\";"
NSQ_SOURCE_LINE 00001892 "}"
NSQ_SOURCE_LINE 00001893 ""
NSQ_SOURCE_LINE 00001894 "################################"
NSQ_SOURCE_LINE 00001895 "# METHODS USED IN BUILDING FORMS"
NSQ_SOURCE_LINE 00001896 "################################"
NSQ_SOURCE_LINE 00001897 ""
NSQ_SOURCE_LINE 00001898 "#### Method: isindex"
NSQ_SOURCE_LINE 00001899 "# Just prints out the isindex tag."
NSQ_SOURCE_LINE 00001900 "# Parameters:"
NSQ_SOURCE_LINE 00001901 "#  $action -> optional URL of script to run"
NSQ_SOURCE_LINE 00001902 "# Returns:"
NSQ_SOURCE_LINE 00001903 "#   A string containing a <isindex> tag"
NSQ_SOURCE_LINE 00001904 "sub isindex {"
NSQ_SOURCE_LINE 00001905 "    my($self,@p) = self_or_default(@_);"
NSQ_SOURCE_LINE 00001906 "    my($action,@other) = rearrange([ACTION],@p);"
NSQ_SOURCE_LINE 00001907 "    $action = qq/ action=\"$action\"/ if $action;"
NSQ_SOURCE_LINE 00001908 "    my($other) = @other ? \" @other\" : '';"
NSQ_SOURCE_LINE 00001909 "    return $XHTML ? \"<isindex$action$other />\" : \"<isindex$action$other>\";"
NSQ_SOURCE_LINE 00001910 "}"
NSQ_SOURCE_LINE 00001911 ""
NSQ_SOURCE_LINE 00001912 "#### Method: start_form"
NSQ_SOURCE_LINE 00001913 "# Start a form"
NSQ_SOURCE_LINE 00001914 "# Parameters:"
NSQ_SOURCE_LINE 00001915 "#   $method -> optional submission method to use (GET or POST)"
NSQ_SOURCE_LINE 00001916 "#   $action -> optional URL of script to run"
NSQ_SOURCE_LINE 00001917 "#   $enctype ->encoding to use (URL_ENCODED or MULTIPART)"
NSQ_SOURCE_LINE 00001918 "sub start_form {"
NSQ_SOURCE_LINE 00001919 "    my($self,@p) = self_or_default(@_);"
NSQ_SOURCE_LINE 00001920 ""
NSQ_SOURCE_LINE 00001921 "    my($method,$action,$enctype,@other) = "
NSQ_SOURCE_LINE 00001922 "\trearrange([METHOD,ACTION,ENCTYPE],@p);"
NSQ_SOURCE_LINE 00001923 ""
NSQ_SOURCE_LINE 00001924 "    $method  = $self->_maybe_escapeHTML(lc($method || 'post'));"
NSQ_SOURCE_LINE 00001925 ""
NSQ_SOURCE_LINE 00001926 "    if( $XHTML ){"
NSQ_SOURCE_LINE 00001927 "        $enctype = $self->_maybe_escapeHTML($enctype || &MULTIPART);"
NSQ_SOURCE_LINE 00001928 "    }else{"
NSQ_SOURCE_LINE 00001929 "        $enctype = $self->_maybe_escapeHTML($enctype || &URL_ENCODED);"
NSQ_SOURCE_LINE 00001930 "    }"
NSQ_SOURCE_LINE 00001931 ""
NSQ_SOURCE_LINE 00001932 "    if (defined $action) {"
NSQ_SOURCE_LINE 00001933 "       $action = $self->_maybe_escapeHTML($action);"
NSQ_SOURCE_LINE 00001934 "    }"
NSQ_SOURCE_LINE 00001935 "    else {"
NSQ_SOURCE_LINE 00001936 "       $action = $self->_maybe_escapeHTML($self->request_uri || $self->self_url);"
NSQ_SOURCE_LINE 00001937 "    }"
NSQ_SOURCE_LINE 00001938 "    $action = qq(action=\"$action\");"
NSQ_SOURCE_LINE 00001939 "    my($other) = @other ? \" @other\" : '';"
NSQ_SOURCE_LINE 00001940 "    $self->{'.parametersToAdd'}={};"
NSQ_SOURCE_LINE 00001941 "    return qq/<form method=\"$method\" $action enctype=\"$enctype\"$other>/;"
NSQ_SOURCE_LINE 00001942 "}"
NSQ_SOURCE_LINE 00001943 ""
NSQ_SOURCE_LINE 00001944 "#### Method: start_multipart_form"
NSQ_SOURCE_LINE 00001945 "sub start_multipart_form {"
NSQ_SOURCE_LINE 00001946 "    my($self,@p) = self_or_default(@_);"
NSQ_SOURCE_LINE 00001947 "    if (defined($p[0]) && substr($p[0],0,1) eq '-') {"
NSQ_SOURCE_LINE 00001948 "      return $self->start_form(-enctype=>&MULTIPART,@p);"
NSQ_SOURCE_LINE 00001949 "    } else {"
NSQ_SOURCE_LINE 00001950 "\tmy($method,$action,@other) = "
NSQ_SOURCE_LINE 00001951 "\t    rearrange([METHOD,ACTION],@p);"
NSQ_SOURCE_LINE 00001952 "\treturn $self->start_form($method,$action,&MULTIPART,@other);"
NSQ_SOURCE_LINE 00001953 "    }"
NSQ_SOURCE_LINE 00001954 "}"
NSQ_SOURCE_LINE 00001955 ""
NSQ_SOURCE_LINE 00001956 "#### Method: end_form"
NSQ_SOURCE_LINE 00001957 "# End a form"
NSQ_SOURCE_LINE 00001958 "# Note: This repeated below under the older name."
NSQ_SOURCE_LINE 00001959 "sub end_form {"
NSQ_SOURCE_LINE 00001960 "    my($self,@p) = self_or_default(@_);"
NSQ_SOURCE_LINE 00001961 "    if ( $NOSTICKY ) {"
NSQ_SOURCE_LINE 00001962 "        return wantarray ? (\"</form>\") : \"\\n</form>\";"
NSQ_SOURCE_LINE 00001963 "    } else {"
NSQ_SOURCE_LINE 00001964 "        if (my @fields = $self->get_fields) {"
NSQ_SOURCE_LINE 00001965 "            return wantarray ? (\"<div>\",@fields,\"</div>\",\"</form>\")"
NSQ_SOURCE_LINE 00001966 "                             : \"<div>\".(join '',@fields).\"</div>\\n</form>\";"
NSQ_SOURCE_LINE 00001967 "        } else {"
NSQ_SOURCE_LINE 00001968 "            return \"</form>\";"
NSQ_SOURCE_LINE 00001969 "        }"
NSQ_SOURCE_LINE 00001970 "    }"
NSQ_SOURCE_LINE 00001971 "}"
NSQ_SOURCE_LINE 00001972 ""
NSQ_SOURCE_LINE 00001973 "#### Method: end_multipart_form"
NSQ_SOURCE_LINE 00001974 "# end a multipart form"
NSQ_SOURCE_LINE 00001975 "sub end_multipart_form {"
NSQ_SOURCE_LINE 00001976 "    &end_form;"
NSQ_SOURCE_LINE 00001977 "}"
NSQ_SOURCE_LINE 00001978 ""
NSQ_SOURCE_LINE 00001979 "sub _textfield {"
NSQ_SOURCE_LINE 00001980 "    my($self,$tag,@p) = self_or_default(@_);"
NSQ_SOURCE_LINE 00001981 "    my($name,$default,$size,$maxlength,$override,$tabindex,@other) = "
NSQ_SOURCE_LINE 00001982 "\trearrange([NAME,[DEFAULT,VALUE,VALUES],SIZE,MAXLENGTH,[OVERRIDE,FORCE],TABINDEX],@p);"
NSQ_SOURCE_LINE 00001983 ""
NSQ_SOURCE_LINE 00001984 "    my $current = $override ? $default : "
NSQ_SOURCE_LINE 00001985 "\t(defined($self->param($name)) ? $self->param($name) : $default);"
NSQ_SOURCE_LINE 00001986 ""
NSQ_SOURCE_LINE 00001987 "    $current = defined($current) ? $self->_maybe_escapeHTML($current,1) : '';"
NSQ_SOURCE_LINE 00001988 "    $name = defined($name) ? $self->_maybe_escapeHTML($name) : '';"
NSQ_SOURCE_LINE 00001989 "    my($s) = defined($size) ? qq/ size=\"$size\"/ : '';"
NSQ_SOURCE_LINE 00001990 "    my($m) = defined($maxlength) ? qq/ maxlength=\"$maxlength\"/ : '';"
NSQ_SOURCE_LINE 00001991 "    my($other) = @other ? \" @other\" : '';"
NSQ_SOURCE_LINE 00001992 "    # this entered at cristy's request to fix problems with file upload fields"
NSQ_SOURCE_LINE 00001993 "    # and WebTV -- not sure it won't break stuff"
NSQ_SOURCE_LINE 00001994 "    my($value) = $current ne '' ? qq(value=\"$current\") : '';"
NSQ_SOURCE_LINE 00001995 "    $tabindex = $self->element_tab($tabindex);"
NSQ_SOURCE_LINE 00001996 "    return $XHTML ? qq(<input type=\"$tag\" name=\"$name\" $tabindex$value$s$m$other />) "
NSQ_SOURCE_LINE 00001997 "                  : qq(<input type=\"$tag\" name=\"$name\" $value$s$m$other>);"
NSQ_SOURCE_LINE 00001998 "}"
NSQ_SOURCE_LINE 00001999 ""
NSQ_SOURCE_LINE 00002000 "#### Method: textfield"
NSQ_SOURCE_LINE 00002001 "# Parameters:"
NSQ_SOURCE_LINE 00002002 "#   $name -> Name of the text field"
NSQ_SOURCE_LINE 00002003 "#   $default -> Optional default value of the field if not"
NSQ_SOURCE_LINE 00002004 "#                already defined."
NSQ_SOURCE_LINE 00002005 "#   $size ->  Optional width of field in characaters."
NSQ_SOURCE_LINE 00002006 "#   $maxlength -> Optional maximum number of characters."
NSQ_SOURCE_LINE 00002007 "# Returns:"
NSQ_SOURCE_LINE 00002008 "#   A string containing a <input type=\"text\"> field"
NSQ_SOURCE_LINE 00002009 "#"
NSQ_SOURCE_LINE 00002010 "sub textfield {"
NSQ_SOURCE_LINE 00002011 "    my($self,@p) = self_or_default(@_);"
NSQ_SOURCE_LINE 00002012 "    $self->_textfield('text',@p);"
NSQ_SOURCE_LINE 00002013 "}"
NSQ_SOURCE_LINE 00002014 ""
NSQ_SOURCE_LINE 00002015 "#### Method: filefield"
NSQ_SOURCE_LINE 00002016 "# Parameters:"
NSQ_SOURCE_LINE 00002017 "#   $name -> Name of the file upload field"
NSQ_SOURCE_LINE 00002018 "#   $size ->  Optional width of field in characaters."
NSQ_SOURCE_LINE 00002019 "#   $maxlength -> Optional maximum number of characters."
NSQ_SOURCE_LINE 00002020 "# Returns:"
NSQ_SOURCE_LINE 00002021 "#   A string containing a <input type=\"file\"> field"
NSQ_SOURCE_LINE 00002022 "#"
NSQ_SOURCE_LINE 00002023 "sub filefield {"
NSQ_SOURCE_LINE 00002024 "    my($self,@p) = self_or_default(@_);"
NSQ_SOURCE_LINE 00002025 "    $self->_textfield('file',@p);"
NSQ_SOURCE_LINE 00002026 "}"
NSQ_SOURCE_LINE 00002027 ""
NSQ_SOURCE_LINE 00002028 "#### Method: password"
NSQ_SOURCE_LINE 00002029 "# Create a \"secret password\" entry field"
NSQ_SOURCE_LINE 00002030 "# Parameters:"
NSQ_SOURCE_LINE 00002031 "#   $name -> Name of the field"
NSQ_SOURCE_LINE 00002032 "#   $default -> Optional default value of the field if not"
NSQ_SOURCE_LINE 00002033 "#                already defined."
NSQ_SOURCE_LINE 00002034 "#   $size ->  Optional width of field in characters."
NSQ_SOURCE_LINE 00002035 "#   $maxlength -> Optional maximum characters that can be entered."
NSQ_SOURCE_LINE 00002036 "# Returns:"
NSQ_SOURCE_LINE 00002037 "#   A string containing a <input type=\"password\"> field"
NSQ_SOURCE_LINE 00002038 "#"
NSQ_SOURCE_LINE 00002039 "sub password_field {"
NSQ_SOURCE_LINE 00002040 "    my ($self,@p) = self_or_default(@_);"
NSQ_SOURCE_LINE 00002041 "    $self->_textfield('password',@p);"
NSQ_SOURCE_LINE 00002042 "}"
NSQ_SOURCE_LINE 00002043 ""
NSQ_SOURCE_LINE 00002044 "#### Method: textarea"
NSQ_SOURCE_LINE 00002045 "# Parameters:"
NSQ_SOURCE_LINE 00002046 "#   $name -> Name of the text field"
NSQ_SOURCE_LINE 00002047 "#   $default -> Optional default value of the field if not"
NSQ_SOURCE_LINE 00002048 "#                already defined."
NSQ_SOURCE_LINE 00002049 "#   $rows ->  Optional number of rows in text area"
NSQ_SOURCE_LINE 00002050 "#   $columns -> Optional number of columns in text area"
NSQ_SOURCE_LINE 00002051 "# Returns:"
NSQ_SOURCE_LINE 00002052 "#   A string containing a <textarea></textarea> tag"
NSQ_SOURCE_LINE 00002053 "#"
NSQ_SOURCE_LINE 00002054 "sub textarea {"
NSQ_SOURCE_LINE 00002055 "    my($self,@p) = self_or_default(@_);"
NSQ_SOURCE_LINE 00002056 "    my($name,$default,$rows,$cols,$override,$tabindex,@other) ="
NSQ_SOURCE_LINE 00002057 "\trearrange([NAME,[DEFAULT,VALUE],ROWS,[COLS,COLUMNS],[OVERRIDE,FORCE],TABINDEX],@p);"
NSQ_SOURCE_LINE 00002058 ""
NSQ_SOURCE_LINE 00002059 "    my($current)= $override ? $default :"
NSQ_SOURCE_LINE 00002060 "\t(defined($self->param($name)) ? $self->param($name) : $default);"
NSQ_SOURCE_LINE 00002061 ""
NSQ_SOURCE_LINE 00002062 "    $name = defined($name) ? $self->_maybe_escapeHTML($name) : '';"
NSQ_SOURCE_LINE 00002063 "    $current = defined($current) ? $self->_maybe_escapeHTML($current) : '';"
NSQ_SOURCE_LINE 00002064 "    my($r) = $rows ? qq/ rows=\"$rows\"/ : '';"
NSQ_SOURCE_LINE 00002065 "    my($c) = $cols ? qq/ cols=\"$cols\"/ : '';"
NSQ_SOURCE_LINE 00002066 "    my($other) = @other ? \" @other\" : '';"
NSQ_SOURCE_LINE 00002067 "    $tabindex = $self->element_tab($tabindex);"
NSQ_SOURCE_LINE 00002068 "    return qq{<textarea name=\"$name\" $tabindex$r$c$other>$current</textarea>};"
NSQ_SOURCE_LINE 00002069 "}"
NSQ_SOURCE_LINE 00002070 ""
NSQ_SOURCE_LINE 00002071 "#### Method: button"
NSQ_SOURCE_LINE 00002072 "# Create a javascript button."
NSQ_SOURCE_LINE 00002073 "# Parameters:"
NSQ_SOURCE_LINE 00002074 "#   $name ->  (optional) Name for the button. (-name)"
NSQ_SOURCE_LINE 00002075 "#   $value -> (optional) Value of the button when selected (and visible name) (-value)"
NSQ_SOURCE_LINE 00002076 "#   $onclick -> (optional) Text of the JavaScript to run when the button is"
NSQ_SOURCE_LINE 00002077 "#                clicked."
NSQ_SOURCE_LINE 00002078 "# Returns:"
NSQ_SOURCE_LINE 00002079 "#   A string containing a <input type=\"button\"> tag"
NSQ_SOURCE_LINE 00002080 "####"
NSQ_SOURCE_LINE 00002081 "sub button {"
NSQ_SOURCE_LINE 00002082 "    my($self,@p) = self_or_default(@_);"
NSQ_SOURCE_LINE 00002083 ""
NSQ_SOURCE_LINE 00002084 "    my($label,$value,$script,$tabindex,@other) = rearrange([NAME,[VALUE,LABEL],"
NSQ_SOURCE_LINE 00002085 "\t\t\t\t\t\t            [ONCLICK,SCRIPT],TABINDEX],@p);"
NSQ_SOURCE_LINE 00002086 ""
NSQ_SOURCE_LINE 00002087 "    $label=$self->_maybe_escapeHTML($label);"
NSQ_SOURCE_LINE 00002088 "    $value=$self->_maybe_escapeHTML($value,1);"
NSQ_SOURCE_LINE 00002089 "    $script=$self->_maybe_escapeHTML($script);"
NSQ_SOURCE_LINE 00002090 ""
NSQ_SOURCE_LINE 00002091 "    $script ||= '';"
NSQ_SOURCE_LINE 00002092 ""
NSQ_SOURCE_LINE 00002093 "    my($name) = '';"
NSQ_SOURCE_LINE 00002094 "    $name = qq/ name=\"$label\"/ if $label;"
NSQ_SOURCE_LINE 00002095 "    $value = $value || $label;"
NSQ_SOURCE_LINE 00002096 "    my($val) = '';"
NSQ_SOURCE_LINE 00002097 "    $val = qq/ value=\"$value\"/ if $value;"
NSQ_SOURCE_LINE 00002098 "    $script = qq/ onclick=\"$script\"/ if $script;"
NSQ_SOURCE_LINE 00002099 "    my($other) = @other ? \" @other\" : '';"
NSQ_SOURCE_LINE 00002100 "    $tabindex = $self->element_tab($tabindex);"
NSQ_SOURCE_LINE 00002101 "    return $XHTML ? qq(<input type=\"button\" $tabindex$name$val$script$other />)"
NSQ_SOURCE_LINE 00002102 "                  : qq(<input type=\"button\"$name$val$script$other>);"
NSQ_SOURCE_LINE 00002103 "}"
NSQ_SOURCE_LINE 00002104 ""
NSQ_SOURCE_LINE 00002105 "#### Method: submit"
NSQ_SOURCE_LINE 00002106 "# Create a \"submit query\" button."
NSQ_SOURCE_LINE 00002107 "# Parameters:"
NSQ_SOURCE_LINE 00002108 "#   $name ->  (optional) Name for the button."
NSQ_SOURCE_LINE 00002109 "#   $value -> (optional) Value of the button when selected (also doubles as label)."
NSQ_SOURCE_LINE 00002110 "#   $label -> (optional) Label printed on the button(also doubles as the value)."
NSQ_SOURCE_LINE 00002111 "# Returns:"
NSQ_SOURCE_LINE 00002112 "#   A string containing a <input type=\"submit\"> tag"
NSQ_SOURCE_LINE 00002113 "####"
NSQ_SOURCE_LINE 00002114 "sub submit {"
NSQ_SOURCE_LINE 00002115 "    my($self,@p) = self_or_default(@_);"
NSQ_SOURCE_LINE 00002116 ""
NSQ_SOURCE_LINE 00002117 "    my($label,$value,$tabindex,@other) = rearrange([NAME,[VALUE,LABEL],TABINDEX],@p);"
NSQ_SOURCE_LINE 00002118 ""
NSQ_SOURCE_LINE 00002119 "    $label=$self->_maybe_escapeHTML($label);"
NSQ_SOURCE_LINE 00002120 "    $value=$self->_maybe_escapeHTML($value,1);"
NSQ_SOURCE_LINE 00002121 ""
NSQ_SOURCE_LINE 00002122 "    my $name = $NOSTICKY ? '' : 'name=\".submit\" ';"
NSQ_SOURCE_LINE 00002123 "    $name = qq/name=\"$label\" / if defined($label);"
NSQ_SOURCE_LINE 00002124 "    $value = defined($value) ? $value : $label;"
NSQ_SOURCE_LINE 00002125 "    my $val = '';"
NSQ_SOURCE_LINE 00002126 "    $val = qq/value=\"$value\" / if defined($value);"
NSQ_SOURCE_LINE 00002127 "    $tabindex = $self->element_tab($tabindex);"
NSQ_SOURCE_LINE 00002128 "    my($other) = @other ? \"@other \" : '';"
NSQ_SOURCE_LINE 00002129 "    return $XHTML ? qq(<input type=\"submit\" $tabindex$name$val$other/>)"
NSQ_SOURCE_LINE 00002130 "                  : qq(<input type=\"submit\" $name$val$other>);"
NSQ_SOURCE_LINE 00002131 "}"
NSQ_SOURCE_LINE 00002132 ""
NSQ_SOURCE_LINE 00002133 "#### Method: reset"
NSQ_SOURCE_LINE 00002134 "# Create a \"reset\" button."
NSQ_SOURCE_LINE 00002135 "# Parameters:"
NSQ_SOURCE_LINE 00002136 "#   $name -> (optional) Name for the button."
NSQ_SOURCE_LINE 00002137 "# Returns:"
NSQ_SOURCE_LINE 00002138 "#   A string containing a <input type=\"reset\"> tag"
NSQ_SOURCE_LINE 00002139 "####"
NSQ_SOURCE_LINE 00002140 "sub reset {"
NSQ_SOURCE_LINE 00002141 "    my($self,@p) = self_or_default(@_);"
NSQ_SOURCE_LINE 00002142 "    my($label,$value,$tabindex,@other) = rearrange(['NAME',['VALUE','LABEL'],TABINDEX],@p);"
NSQ_SOURCE_LINE 00002143 "    $label=$self->_maybe_escapeHTML($label);"
NSQ_SOURCE_LINE 00002144 "    $value=$self->_maybe_escapeHTML($value,1);"
NSQ_SOURCE_LINE 00002145 "    my ($name) = ' name=\".reset\"';"
NSQ_SOURCE_LINE 00002146 "    $name = qq/ name=\"$label\"/ if defined($label);"
NSQ_SOURCE_LINE 00002147 "    $value = defined($value) ? $value : $label;"
NSQ_SOURCE_LINE 00002148 "    my($val) = '';"
NSQ_SOURCE_LINE 00002149 "    $val = qq/ value=\"$value\"/ if defined($value);"
NSQ_SOURCE_LINE 00002150 "    my($other) = @other ? \" @other\" : '';"
NSQ_SOURCE_LINE 00002151 "    $tabindex = $self->element_tab($tabindex);"
NSQ_SOURCE_LINE 00002152 "    return $XHTML ? qq(<input type=\"reset\" $tabindex$name$val$other />)"
NSQ_SOURCE_LINE 00002153 "                  : qq(<input type=\"reset\"$name$val$other>);"
NSQ_SOURCE_LINE 00002154 "}"
NSQ_SOURCE_LINE 00002155 ""
NSQ_SOURCE_LINE 00002156 "#### Method: defaults"
NSQ_SOURCE_LINE 00002157 "# Create a \"defaults\" button."
NSQ_SOURCE_LINE 00002158 "# Parameters:"
NSQ_SOURCE_LINE 00002159 "#   $name -> (optional) Name for the button."
NSQ_SOURCE_LINE 00002160 "# Returns:"
NSQ_SOURCE_LINE 00002161 "#   A string containing a <input type=\"submit\" name=\".defaults\"> tag"
NSQ_SOURCE_LINE 00002162 "#"
NSQ_SOURCE_LINE 00002163 "# Note: this button has a special meaning to the initialization script,"
NSQ_SOURCE_LINE 00002164 "# and tells it to ERASE the current query string so that your defaults"
NSQ_SOURCE_LINE 00002165 "# are used again!"
NSQ_SOURCE_LINE 00002166 "####"
NSQ_SOURCE_LINE 00002167 "sub defaults {"
NSQ_SOURCE_LINE 00002168 "    my($self,@p) = self_or_default(@_);"
NSQ_SOURCE_LINE 00002169 ""
NSQ_SOURCE_LINE 00002170 "    my($label,$tabindex,@other) = rearrange([[NAME,VALUE],TABINDEX],@p);"
NSQ_SOURCE_LINE 00002171 ""
NSQ_SOURCE_LINE 00002172 "    $label=$self->_maybe_escapeHTML($label,1);"
NSQ_SOURCE_LINE 00002173 "    $label = $label || \"Defaults\";"
NSQ_SOURCE_LINE 00002174 "    my($value) = qq/ value=\"$label\"/;"
NSQ_SOURCE_LINE 00002175 "    my($other) = @other ? \" @other\" : '';"
NSQ_SOURCE_LINE 00002176 "    $tabindex = $self->element_tab($tabindex);"
NSQ_SOURCE_LINE 00002177 "    return $XHTML ? qq(<input type=\"submit\" name=\".defaults\" $tabindex$value$other />)"
NSQ_SOURCE_LINE 00002178 "                  : qq/<input type=\"submit\" NAME=\".defaults\"$value$other>/;"
NSQ_SOURCE_LINE 00002179 "}"
NSQ_SOURCE_LINE 00002180 ""
NSQ_SOURCE_LINE 00002181 "#### Method: comment"
NSQ_SOURCE_LINE 00002182 "# Create an HTML <!-- comment -->"
NSQ_SOURCE_LINE 00002183 "# Parameters: a string"
NSQ_SOURCE_LINE 00002184 "sub comment {"
NSQ_SOURCE_LINE 00002185 "    my($self,@p) = self_or_CGI(@_);"
NSQ_SOURCE_LINE 00002186 "    return \"<!-- @p -->\";"
NSQ_SOURCE_LINE 00002187 "}"
NSQ_SOURCE_LINE 00002188 ""
NSQ_SOURCE_LINE 00002189 "#### Method: checkbox"
NSQ_SOURCE_LINE 00002190 "# Create a checkbox that is not logically linked to any others."
NSQ_SOURCE_LINE 00002191 "# The field value is \"on\" when the button is checked."
NSQ_SOURCE_LINE 00002192 "# Parameters:"
NSQ_SOURCE_LINE 00002193 "#   $name -> Name of the checkbox"
NSQ_SOURCE_LINE 00002194 "#   $checked -> (optional) turned on by default if true"
NSQ_SOURCE_LINE 00002195 "#   $value -> (optional) value of the checkbox, 'on' by default"
NSQ_SOURCE_LINE 00002196 "#   $label -> (optional) a user-readable label printed next to the box."
NSQ_SOURCE_LINE 00002197 "#             Otherwise the checkbox name is used."
NSQ_SOURCE_LINE 00002198 "# Returns:"
NSQ_SOURCE_LINE 00002199 "#   A string containing a <input type=\"checkbox\"> field"
NSQ_SOURCE_LINE 00002200 "####"
NSQ_SOURCE_LINE 00002201 "sub checkbox {"
NSQ_SOURCE_LINE 00002202 "    my($self,@p) = self_or_default(@_);"
NSQ_SOURCE_LINE 00002203 ""
NSQ_SOURCE_LINE 00002204 "    my($name,$checked,$value,$label,$labelattributes,$override,$tabindex,@other) ="
NSQ_SOURCE_LINE 00002205 "       rearrange([NAME,[CHECKED,SELECTED,ON],VALUE,LABEL,LABELATTRIBUTES,"
NSQ_SOURCE_LINE 00002206 "                   [OVERRIDE,FORCE],TABINDEX],@p);"
NSQ_SOURCE_LINE 00002207 ""
NSQ_SOURCE_LINE 00002208 "    $value = defined $value ? $value : 'on';"
NSQ_SOURCE_LINE 00002209 ""
NSQ_SOURCE_LINE 00002210 "    if (!$override && ($self->{'.fieldnames'}->{$name} || "
NSQ_SOURCE_LINE 00002211 "\t\t       defined $self->param($name))) {"
NSQ_SOURCE_LINE 00002212 "\t$checked = grep($_ eq $value,$self->param($name)) ? $self->_checked(1) : '';"
NSQ_SOURCE_LINE 00002213 "    } else {"
NSQ_SOURCE_LINE 00002214 "\t$checked = $self->_checked($checked);"
NSQ_SOURCE_LINE 00002215 "    }"
NSQ_SOURCE_LINE 00002216 "    my($the_label) = defined $label ? $label : $name;"
NSQ_SOURCE_LINE 00002217 "    $name = $self->_maybe_escapeHTML($name);"
NSQ_SOURCE_LINE 00002218 "    $value = $self->_maybe_escapeHTML($value,1);"
NSQ_SOURCE_LINE 00002219 "    $the_label = $self->_maybe_escapeHTML($the_label);"
NSQ_SOURCE_LINE 00002220 "    my($other) = @other ? \"@other \" : '';"
NSQ_SOURCE_LINE 00002221 "    $tabindex = $self->element_tab($tabindex);"
NSQ_SOURCE_LINE 00002222 "    $self->register_parameter($name);"
NSQ_SOURCE_LINE 00002223 "    return $XHTML ? CGI::label($labelattributes,"
NSQ_SOURCE_LINE 00002224 "                    qq{<input type=\"checkbox\" name=\"$name\" value=\"$value\" $tabindex$checked$other/>$the_label})"
NSQ_SOURCE_LINE 00002225 "                  : qq{<input type=\"checkbox\" name=\"$name\" value=\"$value\"$checked$other>$the_label};"
NSQ_SOURCE_LINE 00002226 "}"
NSQ_SOURCE_LINE 00002227 ""
NSQ_SOURCE_LINE 00002228 "# Escape HTML"
NSQ_SOURCE_LINE 00002229 "sub escapeHTML {"
NSQ_SOURCE_LINE 00002230 "     require HTML::Entities;"
NSQ_SOURCE_LINE 00002231 "     # hack to work around  earlier hacks"
NSQ_SOURCE_LINE 00002232 "     push @_,$_[0] if @_==1 && $_[0] eq 'CGI';"
NSQ_SOURCE_LINE 00002233 "     my ($self,$toencode,$newlinestoo) = CGI::self_or_default(@_);"
NSQ_SOURCE_LINE 00002234 "     return undef unless defined($toencode);"
NSQ_SOURCE_LINE 00002235 "\t my $encode_entities = $ENCODE_ENTITIES;"
NSQ_SOURCE_LINE 00002236 "\t $encode_entities .= \"\\012\\015\" if ( $encode_entities && $newlinestoo );"
NSQ_SOURCE_LINE 00002237 "\t return HTML::Entities::encode_entities($toencode,$encode_entities);"
NSQ_SOURCE_LINE 00002238 "}"
NSQ_SOURCE_LINE 00002239 ""
NSQ_SOURCE_LINE 00002240 "# unescape HTML -- used internally"
NSQ_SOURCE_LINE 00002241 "sub unescapeHTML {"
NSQ_SOURCE_LINE 00002242 "    require HTML::Entities;"
NSQ_SOURCE_LINE 00002243 "    # hack to work around  earlier hacks"
NSQ_SOURCE_LINE 00002244 "    push @_,$_[0] if @_==1 && $_[0] eq 'CGI';"
NSQ_SOURCE_LINE 00002245 "    my ($self,$string) = CGI::self_or_default(@_);"
NSQ_SOURCE_LINE 00002246 "    return undef unless defined($string);"
NSQ_SOURCE_LINE 00002247 "\treturn HTML::Entities::decode_entities($string);"
NSQ_SOURCE_LINE 00002248 "}"
NSQ_SOURCE_LINE 00002249 ""
NSQ_SOURCE_LINE 00002250 "# Internal procedure - don't use"
NSQ_SOURCE_LINE 00002251 "sub _tableize {"
NSQ_SOURCE_LINE 00002252 "    my($rows,$columns,$rowheaders,$colheaders,@elements) = @_;"
NSQ_SOURCE_LINE 00002253 "    my @rowheaders = $rowheaders ? @$rowheaders : ();"
NSQ_SOURCE_LINE 00002254 "    my @colheaders = $colheaders ? @$colheaders : ();"
NSQ_SOURCE_LINE 00002255 "    my($result);"
NSQ_SOURCE_LINE 00002256 ""
NSQ_SOURCE_LINE 00002257 "    if (defined($columns)) {"
NSQ_SOURCE_LINE 00002258 "\t$rows = int(0.99 + @elements/$columns) unless defined($rows);"
NSQ_SOURCE_LINE 00002259 "    }"
NSQ_SOURCE_LINE 00002260 "    if (defined($rows)) {"
NSQ_SOURCE_LINE 00002261 "\t$columns = int(0.99 + @elements/$rows) unless defined($columns);"
NSQ_SOURCE_LINE 00002262 "    }"
NSQ_SOURCE_LINE 00002263 ""
NSQ_SOURCE_LINE 00002264 "    # rearrange into a pretty table"
NSQ_SOURCE_LINE 00002265 "    $result = \"<table>\";"
NSQ_SOURCE_LINE 00002266 "    my($row,$column);"
NSQ_SOURCE_LINE 00002267 "    unshift(@colheaders,'') if @colheaders && @rowheaders;"
NSQ_SOURCE_LINE 00002268 "    $result .= \"<tr>\" if @colheaders;"
NSQ_SOURCE_LINE 00002269 "    for (@colheaders) {"
NSQ_SOURCE_LINE 00002270 "\t$result .= \"<th>$_</th>\";"
NSQ_SOURCE_LINE 00002271 "    }"
NSQ_SOURCE_LINE 00002272 "    for ($row=0;$row<$rows;$row++) {"
NSQ_SOURCE_LINE 00002273 "\t$result .= \"<tr>\";"
NSQ_SOURCE_LINE 00002274 "\t$result .= \"<th>$rowheaders[$row]</th>\" if @rowheaders;"
NSQ_SOURCE_LINE 00002275 "\tfor ($column=0;$column<$columns;$column++) {"
NSQ_SOURCE_LINE 00002276 "\t    $result .= \"<td>\" . $elements[$column*$rows + $row] . \"</td>\""
NSQ_SOURCE_LINE 00002277 "\t\tif defined($elements[$column*$rows + $row]);"
NSQ_SOURCE_LINE 00002278 "\t}"
NSQ_SOURCE_LINE 00002279 "\t$result .= \"</tr>\";"
NSQ_SOURCE_LINE 00002280 "    }"
NSQ_SOURCE_LINE 00002281 "    $result .= \"</table>\";"
NSQ_SOURCE_LINE 00002282 "    return $result;"
NSQ_SOURCE_LINE 00002283 "}"
NSQ_SOURCE_LINE 00002284 ""
NSQ_SOURCE_LINE 00002285 "#### Method: radio_group"
NSQ_SOURCE_LINE 00002286 "# Create a list of logically-linked radio buttons."
NSQ_SOURCE_LINE 00002287 "# Parameters:"
NSQ_SOURCE_LINE 00002288 "#   $name -> Common name for all the buttons."
NSQ_SOURCE_LINE 00002289 "#   $values -> A pointer to a regular array containing the"
NSQ_SOURCE_LINE 00002290 "#             values for each button in the group."
NSQ_SOURCE_LINE 00002291 "#   $default -> (optional) Value of the button to turn on by default.  Pass '-'"
NSQ_SOURCE_LINE 00002292 "#               to turn _nothing_ on."
NSQ_SOURCE_LINE 00002293 "#   $linebreak -> (optional) Set to true to place linebreaks"
NSQ_SOURCE_LINE 00002294 "#             between the buttons."
NSQ_SOURCE_LINE 00002295 "#   $labels -> (optional)"
NSQ_SOURCE_LINE 00002296 "#             A pointer to a hash of labels to print next to each checkbox"
NSQ_SOURCE_LINE 00002297 "#             in the form $label{'value'}=\"Long explanatory label\"."
NSQ_SOURCE_LINE 00002298 "#             Otherwise the provided values are used as the labels."
NSQ_SOURCE_LINE 00002299 "# Returns:"
NSQ_SOURCE_LINE 00002300 "#   An ARRAY containing a series of <input type=\"radio\"> fields"
NSQ_SOURCE_LINE 00002301 "####"
NSQ_SOURCE_LINE 00002302 "sub radio_group {"
NSQ_SOURCE_LINE 00002303 "    my($self,@p) = self_or_default(@_);"
NSQ_SOURCE_LINE 00002304 "   $self->_box_group('radio',@p);"
NSQ_SOURCE_LINE 00002305 "}"
NSQ_SOURCE_LINE 00002306 ""
NSQ_SOURCE_LINE 00002307 "#### Method: checkbox_group"
NSQ_SOURCE_LINE 00002308 "# Create a list of logically-linked checkboxes."
NSQ_SOURCE_LINE 00002309 "# Parameters:"
NSQ_SOURCE_LINE 00002310 "#   $name -> Common name for all the check boxes"
NSQ_SOURCE_LINE 00002311 "#   $values -> A pointer to a regular array containing the"
NSQ_SOURCE_LINE 00002312 "#             values for each checkbox in the group."
NSQ_SOURCE_LINE 00002313 "#   $defaults -> (optional)"
NSQ_SOURCE_LINE 00002314 "#             1. If a pointer to a regular array of checkbox values,"
NSQ_SOURCE_LINE 00002315 "#             then this will be used to decide which"
NSQ_SOURCE_LINE 00002316 "#             checkboxes to turn on by default."
NSQ_SOURCE_LINE 00002317 "#             2. If a scalar, will be assumed to hold the"
NSQ_SOURCE_LINE 00002318 "#             value of a single checkbox in the group to turn on. "
NSQ_SOURCE_LINE 00002319 "#   $linebreak -> (optional) Set to true to place linebreaks"
NSQ_SOURCE_LINE 00002320 "#             between the buttons."
NSQ_SOURCE_LINE 00002321 "#   $labels -> (optional)"
NSQ_SOURCE_LINE 00002322 "#             A pointer to a hash of labels to print next to each checkbox"
NSQ_SOURCE_LINE 00002323 "#             in the form $label{'value'}=\"Long explanatory label\"."
NSQ_SOURCE_LINE 00002324 "#             Otherwise the provided values are used as the labels."
NSQ_SOURCE_LINE 00002325 "# Returns:"
NSQ_SOURCE_LINE 00002326 "#   An ARRAY containing a series of <input type=\"checkbox\"> fields"
NSQ_SOURCE_LINE 00002327 "####"
NSQ_SOURCE_LINE 00002328 ""
NSQ_SOURCE_LINE 00002329 "sub checkbox_group {"
NSQ_SOURCE_LINE 00002330 "    my($self,@p) = self_or_default(@_);"
NSQ_SOURCE_LINE 00002331 "   $self->_box_group('checkbox',@p);"
NSQ_SOURCE_LINE 00002332 "}"
NSQ_SOURCE_LINE 00002333 ""
NSQ_SOURCE_LINE 00002334 "sub _box_group {"
NSQ_SOURCE_LINE 00002335 "    my $self     = shift;"
NSQ_SOURCE_LINE 00002336 "    my $box_type = shift;"
NSQ_SOURCE_LINE 00002337 ""
NSQ_SOURCE_LINE 00002338 "    my($name,$values,$defaults,$linebreak,$labels,$labelattributes,"
NSQ_SOURCE_LINE 00002339 "       $attributes,$rows,$columns,$rowheaders,$colheaders,"
NSQ_SOURCE_LINE 00002340 "       $override,$nolabels,$tabindex,$disabled,@other) ="
NSQ_SOURCE_LINE 00002341 "        rearrange([NAME,[VALUES,VALUE],[DEFAULT,DEFAULTS],LINEBREAK,LABELS,LABELATTRIBUTES,"
NSQ_SOURCE_LINE 00002342 "                       ATTRIBUTES,ROWS,[COLUMNS,COLS],[ROWHEADERS,ROWHEADER],[COLHEADERS,COLHEADER],"
NSQ_SOURCE_LINE 00002343 "                       [OVERRIDE,FORCE],NOLABELS,TABINDEX,DISABLED"
NSQ_SOURCE_LINE 00002344 "                  ],@_);"
NSQ_SOURCE_LINE 00002345 ""
NSQ_SOURCE_LINE 00002346 ""
NSQ_SOURCE_LINE 00002347 "    my($result,$checked,@elements,@values);"
NSQ_SOURCE_LINE 00002348 ""
NSQ_SOURCE_LINE 00002349 "    @values = $self->_set_values_and_labels($values,\\$labels,$name);"
NSQ_SOURCE_LINE 00002350 "    my %checked = $self->previous_or_default($name,$defaults,$override);"
NSQ_SOURCE_LINE 00002351 ""
NSQ_SOURCE_LINE 00002352 "    # If no check array is specified, check the first by default"
NSQ_SOURCE_LINE 00002353 "    $checked{$values[0]}++ if $box_type eq 'radio' && !%checked;"
NSQ_SOURCE_LINE 00002354 ""
NSQ_SOURCE_LINE 00002355 "    $name=$self->_maybe_escapeHTML($name);"
NSQ_SOURCE_LINE 00002356 ""
NSQ_SOURCE_LINE 00002357 "    my %tabs = ();"
NSQ_SOURCE_LINE 00002358 "    if ($TABINDEX && $tabindex) {"
NSQ_SOURCE_LINE 00002359 "      if (!ref $tabindex) {"
NSQ_SOURCE_LINE 00002360 "          $self->element_tab($tabindex);"
NSQ_SOURCE_LINE 00002361 "      } elsif (ref $tabindex eq 'ARRAY') {"
NSQ_SOURCE_LINE 00002362 "          %tabs = map {$_=>$self->element_tab} @$tabindex;"
NSQ_SOURCE_LINE 00002363 "      } elsif (ref $tabindex eq 'HASH') {"
NSQ_SOURCE_LINE 00002364 "          %tabs = %$tabindex;"
NSQ_SOURCE_LINE 00002365 "      }"
NSQ_SOURCE_LINE 00002366 "    }"
NSQ_SOURCE_LINE 00002367 "    %tabs = map {$_=>$self->element_tab} @values unless %tabs;"
NSQ_SOURCE_LINE 00002368 "    my $other = @other ? \"@other \" : '';"
NSQ_SOURCE_LINE 00002369 "    my $radio_checked;"
NSQ_SOURCE_LINE 00002370 ""
NSQ_SOURCE_LINE 00002371 "    # for disabling groups of radio/checkbox buttons"
NSQ_SOURCE_LINE 00002372 "    my %disabled;"
NSQ_SOURCE_LINE 00002373 "    for (@{$disabled}) {"
NSQ_SOURCE_LINE 00002374 "   \t$disabled{$_}=1;"
NSQ_SOURCE_LINE 00002375 "    }"
NSQ_SOURCE_LINE 00002376 ""
NSQ_SOURCE_LINE 00002377 "    for (@values) {"
NSQ_SOURCE_LINE 00002378 "    \t my $disable=\"\";"
NSQ_SOURCE_LINE 00002379 "\t if ($disabled{$_}) {"
NSQ_SOURCE_LINE 00002380 "\t\t$disable=\"disabled='1'\";"
NSQ_SOURCE_LINE 00002381 "\t }"
NSQ_SOURCE_LINE 00002382 ""
NSQ_SOURCE_LINE 00002383 "        my $checkit = $self->_checked($box_type eq 'radio' ? ($checked{$_} && !$radio_checked++)"
NSQ_SOURCE_LINE 00002384 "                                                           : $checked{$_});"
NSQ_SOURCE_LINE 00002385 "\tmy($break);"
NSQ_SOURCE_LINE 00002386 "\tif ($linebreak) {"
NSQ_SOURCE_LINE 00002387 "          $break = $XHTML ? \"<br />\" : \"<br>\";"
NSQ_SOURCE_LINE 00002388 "\t}"
NSQ_SOURCE_LINE 00002389 "\telse {"
NSQ_SOURCE_LINE 00002390 "\t  $break = '';"
NSQ_SOURCE_LINE 00002391 "\t}"
NSQ_SOURCE_LINE 00002392 "\tmy($label)='';"
NSQ_SOURCE_LINE 00002393 "\tunless (defined($nolabels) && $nolabels) {"
NSQ_SOURCE_LINE 00002394 "\t    $label = $_;"
NSQ_SOURCE_LINE 00002395 "\t    $label = $labels->{$_} if defined($labels) && defined($labels->{$_});"
NSQ_SOURCE_LINE 00002396 "\t    $label = $self->_maybe_escapeHTML($label,1);"
NSQ_SOURCE_LINE 00002397 "            $label = \"<span style=\\\"color:gray\\\">$label</span>\" if $disabled{$_};"
NSQ_SOURCE_LINE 00002398 "\t}"
NSQ_SOURCE_LINE 00002399 "        my $attribs = $self->_set_attributes($_, $attributes);"
NSQ_SOURCE_LINE 00002400 "        my $tab     = $tabs{$_};"
NSQ_SOURCE_LINE 00002401 "\t$_=$self->_maybe_escapeHTML($_);"
NSQ_SOURCE_LINE 00002402 ""
NSQ_SOURCE_LINE 00002403 "        if ($XHTML) {"
NSQ_SOURCE_LINE 00002404 "           push @elements,"
NSQ_SOURCE_LINE 00002405 "              CGI::label($labelattributes,"
NSQ_SOURCE_LINE 00002406 "                   qq(<input type=\"$box_type\" name=\"$name\" value=\"$_\" $checkit$other$tab$attribs$disable/>$label)).${break};"
NSQ_SOURCE_LINE 00002407 "        } else {"
NSQ_SOURCE_LINE 00002408 "            push(@elements,qq/<input type=\"$box_type\" name=\"$name\" value=\"$_\" $checkit$other$tab$attribs$disable>${label}${break}/);"
NSQ_SOURCE_LINE 00002409 "        }"
NSQ_SOURCE_LINE 00002410 "    }"
NSQ_SOURCE_LINE 00002411 "    $self->register_parameter($name);"
NSQ_SOURCE_LINE 00002412 "    return wantarray ? @elements : \"@elements\""
NSQ_SOURCE_LINE 00002413 "           unless defined($columns) || defined($rows);"
NSQ_SOURCE_LINE 00002414 "    return _tableize($rows,$columns,$rowheaders,$colheaders,@elements);"
NSQ_SOURCE_LINE 00002415 "}"
NSQ_SOURCE_LINE 00002416 ""
NSQ_SOURCE_LINE 00002417 "#### Method: popup_menu"
NSQ_SOURCE_LINE 00002418 "# Create a popup menu."
NSQ_SOURCE_LINE 00002419 "# Parameters:"
NSQ_SOURCE_LINE 00002420 "#   $name -> Name for all the menu"
NSQ_SOURCE_LINE 00002421 "#   $values -> A pointer to a regular array containing the"
NSQ_SOURCE_LINE 00002422 "#             text of each menu item."
NSQ_SOURCE_LINE 00002423 "#   $default -> (optional) Default item to display"
NSQ_SOURCE_LINE 00002424 "#   $labels -> (optional)"
NSQ_SOURCE_LINE 00002425 "#             A pointer to a hash of labels to print next to each checkbox"
NSQ_SOURCE_LINE 00002426 "#             in the form $label{'value'}=\"Long explanatory label\"."
NSQ_SOURCE_LINE 00002427 "#             Otherwise the provided values are used as the labels."
NSQ_SOURCE_LINE 00002428 "# Returns:"
NSQ_SOURCE_LINE 00002429 "#   A string containing the definition of a popup menu."
NSQ_SOURCE_LINE 00002430 "####"
NSQ_SOURCE_LINE 00002431 "sub popup_menu {"
NSQ_SOURCE_LINE 00002432 "    my($self,@p) = self_or_default(@_);"
NSQ_SOURCE_LINE 00002433 ""
NSQ_SOURCE_LINE 00002434 "    my($name,$values,$default,$labels,$attributes,$override,$tabindex,@other) ="
NSQ_SOURCE_LINE 00002435 "       rearrange([NAME,[VALUES,VALUE],[DEFAULT,DEFAULTS],LABELS,"
NSQ_SOURCE_LINE 00002436 "       ATTRIBUTES,[OVERRIDE,FORCE],TABINDEX],@p);"
NSQ_SOURCE_LINE 00002437 "    my($result,%selected);"
NSQ_SOURCE_LINE 00002438 ""
NSQ_SOURCE_LINE 00002439 "    if (!$override && defined($self->param($name))) {"
NSQ_SOURCE_LINE 00002440 "\t$selected{$self->param($name)}++;"
NSQ_SOURCE_LINE 00002441 "    } elsif (defined $default) {"
NSQ_SOURCE_LINE 00002442 "\t%selected = map {$_=>1} ref($default) eq 'ARRAY' "
NSQ_SOURCE_LINE 00002443 "                                ? @$default "
NSQ_SOURCE_LINE 00002444 "                                : $default;"
NSQ_SOURCE_LINE 00002445 "    }"
NSQ_SOURCE_LINE 00002446 "    $name=$self->_maybe_escapeHTML($name);"
NSQ_SOURCE_LINE 00002447 "    # RT #30057 - ignore -multiple, if you need this"
NSQ_SOURCE_LINE 00002448 "    # then use scrolling_list"
NSQ_SOURCE_LINE 00002449 "    @other = grep { $_ !~ /^multiple=/i } @other;"
NSQ_SOURCE_LINE 00002450 "    my($other) = @other ? \" @other\" : '';"
NSQ_SOURCE_LINE 00002451 ""
NSQ_SOURCE_LINE 00002452 "    my(@values);"
NSQ_SOURCE_LINE 00002453 "    @values = $self->_set_values_and_labels($values,\\$labels,$name);"
NSQ_SOURCE_LINE 00002454 "    $tabindex = $self->element_tab($tabindex);"
NSQ_SOURCE_LINE 00002455 "    $name = q{} if ! defined $name;"
NSQ_SOURCE_LINE 00002456 "    $result = qq/<select name=\"$name\" $tabindex$other>\\n/;"
NSQ_SOURCE_LINE 00002457 "    for (@values) {"
NSQ_SOURCE_LINE 00002458 "        if (/<optgroup/) {"
NSQ_SOURCE_LINE 00002459 "            for my $v (split(/\\n/)) {"
NSQ_SOURCE_LINE 00002460 "                my $selectit = $XHTML ? 'selected=\"selected\"' : 'selected';"
NSQ_SOURCE_LINE 00002461 "\t\tfor my $selected (sort keys %selected) {"
NSQ_SOURCE_LINE 00002462 "\t\t    $v =~ s/(value=\"\\Q$selected\\E\")/$selectit $1/;"
NSQ_SOURCE_LINE 00002463 "\t\t}"
NSQ_SOURCE_LINE 00002464 "                $result .= \"$v\\n\";"
NSQ_SOURCE_LINE 00002465 "            }"
NSQ_SOURCE_LINE 00002466 "        }"
NSQ_SOURCE_LINE 00002467 "        else {"
NSQ_SOURCE_LINE 00002468 "          my $attribs   = $self->_set_attributes($_, $attributes);"
NSQ_SOURCE_LINE 00002469 "\t  my($selectit) = $self->_selected($selected{$_});"
NSQ_SOURCE_LINE 00002470 "\t  my($label)    = $_;"
NSQ_SOURCE_LINE 00002471 "\t  $label        = $labels->{$_} if defined($labels) && defined($labels->{$_});"
NSQ_SOURCE_LINE 00002472 "\t  my($value)    = $self->_maybe_escapeHTML($_);"
NSQ_SOURCE_LINE 00002473 "\t  $label        = $self->_maybe_escapeHTML($label,1);"
NSQ_SOURCE_LINE 00002474 "          $result      .= \"<option${attribs} ${selectit}value=\\\"$value\\\">$label</option>\\n\";"
NSQ_SOURCE_LINE 00002475 "        }"
NSQ_SOURCE_LINE 00002476 "    }"
NSQ_SOURCE_LINE 00002477 ""
NSQ_SOURCE_LINE 00002478 "    $result .= \"</select>\";"
NSQ_SOURCE_LINE 00002479 "    return $result;"
NSQ_SOURCE_LINE 00002480 "}"
NSQ_SOURCE_LINE 00002481 ""
NSQ_SOURCE_LINE 00002482 "#### Method: optgroup"
NSQ_SOURCE_LINE 00002483 "# Create a optgroup."
NSQ_SOURCE_LINE 00002484 "# Parameters:"
NSQ_SOURCE_LINE 00002485 "#   $name -> Label for the group"
NSQ_SOURCE_LINE 00002486 "#   $values -> A pointer to a regular array containing the"
NSQ_SOURCE_LINE 00002487 "#              values for each option line in the group."
NSQ_SOURCE_LINE 00002488 "#   $labels -> (optional)"
NSQ_SOURCE_LINE 00002489 "#              A pointer to a hash of labels to print next to each item"
NSQ_SOURCE_LINE 00002490 "#              in the form $label{'value'}=\"Long explanatory label\"."
NSQ_SOURCE_LINE 00002491 "#              Otherwise the provided values are used as the labels."
NSQ_SOURCE_LINE 00002492 "#   $labeled -> (optional)"
NSQ_SOURCE_LINE 00002493 "#               A true value indicates the value should be used as the label attribute"
NSQ_SOURCE_LINE 00002494 "#               in the option elements."
NSQ_SOURCE_LINE 00002495 "#               The label attribute specifies the option label presented to the user."
NSQ_SOURCE_LINE 00002496 "#               This defaults to the content of the <option> element, but the label"
NSQ_SOURCE_LINE 00002497 "#               attribute allows authors to more easily use optgroup without sacrificing"
NSQ_SOURCE_LINE 00002498 "#               compatibility with browsers that do not support option groups."
NSQ_SOURCE_LINE 00002499 "#   $novals -> (optional)"
NSQ_SOURCE_LINE 00002500 "#              A true value indicates to suppress the val attribute in the option elements"
NSQ_SOURCE_LINE 00002501 "# Returns:"
NSQ_SOURCE_LINE 00002502 "#   A string containing the definition of an option group."
NSQ_SOURCE_LINE 00002503 "####"
NSQ_SOURCE_LINE 00002504 "sub optgroup {"
NSQ_SOURCE_LINE 00002505 "    my($self,@p) = self_or_default(@_);"
NSQ_SOURCE_LINE 00002506 "    my($name,$values,$attributes,$labeled,$noval,$labels,@other)"
NSQ_SOURCE_LINE 00002507 "        = rearrange([NAME,[VALUES,VALUE],ATTRIBUTES,LABELED,NOVALS,LABELS],@p);"
NSQ_SOURCE_LINE 00002508 ""
NSQ_SOURCE_LINE 00002509 "    my($result,@values);"
NSQ_SOURCE_LINE 00002510 "    @values = $self->_set_values_and_labels($values,\\$labels,$name,$labeled,$novals);"
NSQ_SOURCE_LINE 00002511 "    my($other) = @other ? \" @other\" : '';"
NSQ_SOURCE_LINE 00002512 ""
NSQ_SOURCE_LINE 00002513 "    $name = $self->_maybe_escapeHTML($name) || q{};"
NSQ_SOURCE_LINE 00002514 "    $result = qq/<optgroup label=\"$name\"$other>\\n/;"
NSQ_SOURCE_LINE 00002515 "    for (@values) {"
NSQ_SOURCE_LINE 00002516 "        if (/<optgroup/) {"
NSQ_SOURCE_LINE 00002517 "            for (split(/\\n/)) {"
NSQ_SOURCE_LINE 00002518 "                my $selectit = $XHTML ? 'selected=\"selected\"' : 'selected';"
NSQ_SOURCE_LINE 00002519 "                s/(value=\"$selected\")/$selectit $1/ if defined $selected;"
NSQ_SOURCE_LINE 00002520 "                $result .= \"$_\\n\";"
NSQ_SOURCE_LINE 00002521 "            }"
NSQ_SOURCE_LINE 00002522 "        }"
NSQ_SOURCE_LINE 00002523 "        else {"
NSQ_SOURCE_LINE 00002524 "            my $attribs = $self->_set_attributes($_, $attributes);"
NSQ_SOURCE_LINE 00002525 "            my($label) = $_;"
NSQ_SOURCE_LINE 00002526 "            $label = $labels->{$_} if defined($labels) && defined($labels->{$_});"
NSQ_SOURCE_LINE 00002527 "            $label=$self->_maybe_escapeHTML($label);"
NSQ_SOURCE_LINE 00002528 "            my($value)=$self->_maybe_escapeHTML($_,1);"
NSQ_SOURCE_LINE 00002529 "            $result .= $labeled ? $novals ? \"<option$attribs label=\\\"$value\\\">$label</option>\\n\""
NSQ_SOURCE_LINE 00002530 "                                          : \"<option$attribs label=\\\"$value\\\" value=\\\"$value\\\">$label</option>\\n\""
NSQ_SOURCE_LINE 00002531 "                                : $novals ? \"<option$attribs>$label</option>\\n\""
NSQ_SOURCE_LINE 00002532 "                                          : \"<option$attribs value=\\\"$value\\\">$label</option>\\n\";"
NSQ_SOURCE_LINE 00002533 "        }"
NSQ_SOURCE_LINE 00002534 "    }"
NSQ_SOURCE_LINE 00002535 "    $result .= \"</optgroup>\";"
NSQ_SOURCE_LINE 00002536 "    return $result;"
NSQ_SOURCE_LINE 00002537 "}"
NSQ_SOURCE_LINE 00002538 ""
NSQ_SOURCE_LINE 00002539 "#### Method: scrolling_list"
NSQ_SOURCE_LINE 00002540 "# Create a scrolling list."
NSQ_SOURCE_LINE 00002541 "# Parameters:"
NSQ_SOURCE_LINE 00002542 "#   $name -> name for the list"
NSQ_SOURCE_LINE 00002543 "#   $values -> A pointer to a regular array containing the"
NSQ_SOURCE_LINE 00002544 "#             values for each option line in the list."
NSQ_SOURCE_LINE 00002545 "#   $defaults -> (optional)"
NSQ_SOURCE_LINE 00002546 "#             1. If a pointer to a regular array of options,"
NSQ_SOURCE_LINE 00002547 "#             then this will be used to decide which"
NSQ_SOURCE_LINE 00002548 "#             lines to turn on by default."
NSQ_SOURCE_LINE 00002549 "#             2. Otherwise holds the value of the single line to turn on."
NSQ_SOURCE_LINE 00002550 "#   $size -> (optional) Size of the list."
NSQ_SOURCE_LINE 00002551 "#   $multiple -> (optional) If set, allow multiple selections."
NSQ_SOURCE_LINE 00002552 "#   $labels -> (optional)"
NSQ_SOURCE_LINE 00002553 "#             A pointer to a hash of labels to print next to each checkbox"
NSQ_SOURCE_LINE 00002554 "#             in the form $label{'value'}=\"Long explanatory label\"."
NSQ_SOURCE_LINE 00002555 "#             Otherwise the provided values are used as the labels."
NSQ_SOURCE_LINE 00002556 "# Returns:"
NSQ_SOURCE_LINE 00002557 "#   A string containing the definition of a scrolling list."
NSQ_SOURCE_LINE 00002558 "####"
NSQ_SOURCE_LINE 00002559 "sub scrolling_list {"
NSQ_SOURCE_LINE 00002560 "    my($self,@p) = self_or_default(@_);"
NSQ_SOURCE_LINE 00002561 "    my($name,$values,$defaults,$size,$multiple,$labels,$attributes,$override,$tabindex,@other)"
NSQ_SOURCE_LINE 00002562 "\t= rearrange([NAME,[VALUES,VALUE],[DEFAULTS,DEFAULT],"
NSQ_SOURCE_LINE 00002563 "          SIZE,MULTIPLE,LABELS,ATTRIBUTES,[OVERRIDE,FORCE],TABINDEX],@p);"
NSQ_SOURCE_LINE 00002564 ""
NSQ_SOURCE_LINE 00002565 "    my($result,@values);"
NSQ_SOURCE_LINE 00002566 "    @values = $self->_set_values_and_labels($values,\\$labels,$name);"
NSQ_SOURCE_LINE 00002567 ""
NSQ_SOURCE_LINE 00002568 "    $size = $size || scalar(@values);"
NSQ_SOURCE_LINE 00002569 ""
NSQ_SOURCE_LINE 00002570 "    my(%selected) = $self->previous_or_default($name,$defaults,$override);"
NSQ_SOURCE_LINE 00002571 ""
NSQ_SOURCE_LINE 00002572 "    my($is_multiple) = $multiple ? qq/ multiple=\"multiple\"/ : '';"
NSQ_SOURCE_LINE 00002573 "    my($has_size) = $size ? qq/ size=\"$size\"/: '';"
NSQ_SOURCE_LINE 00002574 "    my($other) = @other ? \" @other\" : '';"
NSQ_SOURCE_LINE 00002575 ""
NSQ_SOURCE_LINE 00002576 "    $name=$self->_maybe_escapeHTML($name);"
NSQ_SOURCE_LINE 00002577 "    $tabindex = $self->element_tab($tabindex);"
NSQ_SOURCE_LINE 00002578 "    $result = qq/<select name=\"$name\" $tabindex$has_size$is_multiple$other>\\n/;"
NSQ_SOURCE_LINE 00002579 "    for (@values) {"
NSQ_SOURCE_LINE 00002580 "        if (/<optgroup/) {"
NSQ_SOURCE_LINE 00002581 "            for my $v (split(/\\n/)) {"
NSQ_SOURCE_LINE 00002582 "                my $selectit = $XHTML ? 'selected=\"selected\"' : 'selected';"
NSQ_SOURCE_LINE 00002583 "\t\tfor my $selected (sort keys %selected) {"
NSQ_SOURCE_LINE 00002584 "\t\t    $v =~ s/(value=\"$selected\")/$selectit $1/;"
NSQ_SOURCE_LINE 00002585 "\t\t}"
NSQ_SOURCE_LINE 00002586 "                $result .= \"$v\\n\";"
NSQ_SOURCE_LINE 00002587 "            }"
NSQ_SOURCE_LINE 00002588 "        }"
NSQ_SOURCE_LINE 00002589 "        else {"
NSQ_SOURCE_LINE 00002590 "          my $attribs   = $self->_set_attributes($_, $attributes);"
NSQ_SOURCE_LINE 00002591 "\t  my($selectit) = $self->_selected($selected{$_});"
NSQ_SOURCE_LINE 00002592 "\t  my($label)    = $_;"
NSQ_SOURCE_LINE 00002593 "\t  $label        = $labels->{$_} if defined($labels) && defined($labels->{$_});"
NSQ_SOURCE_LINE 00002594 "\t  my($value)    = $self->_maybe_escapeHTML($_);"
NSQ_SOURCE_LINE 00002595 "\t  $label        = $self->_maybe_escapeHTML($label,1);"
NSQ_SOURCE_LINE 00002596 "          $result      .= \"<option${attribs} ${selectit}value=\\\"$value\\\">$label</option>\\n\";"
NSQ_SOURCE_LINE 00002597 "        }"
NSQ_SOURCE_LINE 00002598 "    }"
NSQ_SOURCE_LINE 00002599 ""
NSQ_SOURCE_LINE 00002600 "    $result .= \"</select>\";"
NSQ_SOURCE_LINE 00002601 "    $self->register_parameter($name);"
NSQ_SOURCE_LINE 00002602 "    return $result;"
NSQ_SOURCE_LINE 00002603 "}"
NSQ_SOURCE_LINE 00002604 ""
NSQ_SOURCE_LINE 00002605 "#### Method: hidden"
NSQ_SOURCE_LINE 00002606 "# Parameters:"
NSQ_SOURCE_LINE 00002607 "#   $name -> Name of the hidden field"
NSQ_SOURCE_LINE 00002608 "#   @default -> (optional) Initial values of field (may be an array)"
NSQ_SOURCE_LINE 00002609 "#      or"
NSQ_SOURCE_LINE 00002610 "#   $default->[initial values of field]"
NSQ_SOURCE_LINE 00002611 "# Returns:"
NSQ_SOURCE_LINE 00002612 "#   A string containing a <input type=\"hidden\" name=\"name\" value=\"value\">"
NSQ_SOURCE_LINE 00002613 "####"
NSQ_SOURCE_LINE 00002614 "sub hidden {"
NSQ_SOURCE_LINE 00002615 "    my($self,@p) = self_or_default(@_);"
NSQ_SOURCE_LINE 00002616 ""
NSQ_SOURCE_LINE 00002617 "    # this is the one place where we departed from our standard"
NSQ_SOURCE_LINE 00002618 "    # calling scheme, so we have to special-case (darn)"
NSQ_SOURCE_LINE 00002619 "    my(@result,@value);"
NSQ_SOURCE_LINE 00002620 "    my($name,$default,$override,@other) = "
NSQ_SOURCE_LINE 00002621 "\trearrange([NAME,[DEFAULT,VALUE,VALUES],[OVERRIDE,FORCE]],@p);"
NSQ_SOURCE_LINE 00002622 ""
NSQ_SOURCE_LINE 00002623 "    my $do_override = 0;"
NSQ_SOURCE_LINE 00002624 "    if ( ref($p[0]) || substr($p[0],0,1) eq '-') {"
NSQ_SOURCE_LINE 00002625 "\t@value = ref($default) ? @{$default} : $default;"
NSQ_SOURCE_LINE 00002626 "\t$do_override = $override;"
NSQ_SOURCE_LINE 00002627 "    } else {"
NSQ_SOURCE_LINE 00002628 "\tfor ($default,$override,@other) {"
NSQ_SOURCE_LINE 00002629 "\t    push(@value,$_) if defined($_);"
NSQ_SOURCE_LINE 00002630 "\t}"
NSQ_SOURCE_LINE 00002631 "        undef @other;"
NSQ_SOURCE_LINE 00002632 "    }"
NSQ_SOURCE_LINE 00002633 ""
NSQ_SOURCE_LINE 00002634 "    # use previous values if override is not set"
NSQ_SOURCE_LINE 00002635 "    my @prev = $self->param($name);"
NSQ_SOURCE_LINE 00002636 "    @value = @prev if !$do_override && @prev;"
NSQ_SOURCE_LINE 00002637 ""
NSQ_SOURCE_LINE 00002638 "    $name=$self->_maybe_escapeHTML($name);"
NSQ_SOURCE_LINE 00002639 "    for (@value) {"
NSQ_SOURCE_LINE 00002640 "\t$_ = defined($_) ? $self->_maybe_escapeHTML($_,1) : '';"
NSQ_SOURCE_LINE 00002641 "\tpush @result,$XHTML ? qq(<input type=\"hidden\" name=\"$name\" value=\"$_\" @other />)"
NSQ_SOURCE_LINE 00002642 "                            : qq(<input type=\"hidden\" name=\"$name\" value=\"$_\" @other>);"
NSQ_SOURCE_LINE 00002643 "    }"
NSQ_SOURCE_LINE 00002644 "    return wantarray ? @result : join('',@result);"
NSQ_SOURCE_LINE 00002645 "}"
NSQ_SOURCE_LINE 00002646 ""
NSQ_SOURCE_LINE 00002647 "#### Method: image_button"
NSQ_SOURCE_LINE 00002648 "# Parameters:"
NSQ_SOURCE_LINE 00002649 "#   $name -> Name of the button"
NSQ_SOURCE_LINE 00002650 "#   $src ->  URL of the image source"
NSQ_SOURCE_LINE 00002651 "#   $align -> Alignment style (TOP, BOTTOM or MIDDLE)"
NSQ_SOURCE_LINE 00002652 "# Returns:"
NSQ_SOURCE_LINE 00002653 "#   A string containing a <input type=\"image\" name=\"name\" src=\"url\" align=\"alignment\">"
NSQ_SOURCE_LINE 00002654 "####"
NSQ_SOURCE_LINE 00002655 "sub image_button {"
NSQ_SOURCE_LINE 00002656 "    my($self,@p) = self_or_default(@_);"
NSQ_SOURCE_LINE 00002657 ""
NSQ_SOURCE_LINE 00002658 "    my($name,$src,$alignment,@other) ="
NSQ_SOURCE_LINE 00002659 "\trearrange([NAME,SRC,ALIGN],@p);"
NSQ_SOURCE_LINE 00002660 ""
NSQ_SOURCE_LINE 00002661 "    my($align) = $alignment ? \" align=\\L\\\"$alignment\\\"\" : '';"
NSQ_SOURCE_LINE 00002662 "    my($other) = @other ? \" @other\" : '';"
NSQ_SOURCE_LINE 00002663 "    $name=$self->_maybe_escapeHTML($name);"
NSQ_SOURCE_LINE 00002664 "    return $XHTML ? qq(<input type=\"image\" name=\"$name\" src=\"$src\"$align$other />)"
NSQ_SOURCE_LINE 00002665 "                  : qq/<input type=\"image\" name=\"$name\" src=\"$src\"$align$other>/;"
NSQ_SOURCE_LINE 00002666 "}"
NSQ_SOURCE_LINE 00002667 ""
NSQ_SOURCE_LINE 00002668 "#### Method: self_url"
NSQ_SOURCE_LINE 00002669 "# Returns a URL containing the current script and all its"
NSQ_SOURCE_LINE 00002670 "# param/value pairs arranged as a query.  You can use this"
NSQ_SOURCE_LINE 00002671 "# to create a link that, when selected, will reinvoke the"
NSQ_SOURCE_LINE 00002672 "# script with all its state information preserved."
NSQ_SOURCE_LINE 00002673 "####"
NSQ_SOURCE_LINE 00002674 "sub self_url {"
NSQ_SOURCE_LINE 00002675 "    my($self,@p) = self_or_default(@_);"
NSQ_SOURCE_LINE 00002676 "    return $self->url('-path_info'=>1,'-query'=>1,'-full'=>1,@p);"
NSQ_SOURCE_LINE 00002677 "}"
NSQ_SOURCE_LINE 00002678 ""
NSQ_SOURCE_LINE 00002679 "# This is provided as a synonym to self_url() for people unfortunate"
NSQ_SOURCE_LINE 00002680 "# enough to have incorporated it into their programs already!"
NSQ_SOURCE_LINE 00002681 "sub state {"
NSQ_SOURCE_LINE 00002682 "    &self_url;"
NSQ_SOURCE_LINE 00002683 "}"
NSQ_SOURCE_LINE 00002684 ""
NSQ_SOURCE_LINE 00002685 "#### Method: url"
NSQ_SOURCE_LINE 00002686 "# Like self_url, but doesn't return the query string part of"
NSQ_SOURCE_LINE 00002687 "# the URL."
NSQ_SOURCE_LINE 00002688 "####"
NSQ_SOURCE_LINE 00002689 "sub url {"
NSQ_SOURCE_LINE 00002690 "    my($self,@p) = self_or_default(@_);"
NSQ_SOURCE_LINE 00002691 "    my ($relative,$absolute,$full,$path_info,$query,$base,$rewrite) = "
NSQ_SOURCE_LINE 00002692 "\trearrange(['RELATIVE','ABSOLUTE','FULL',['PATH','PATH_INFO'],['QUERY','QUERY_STRING'],'BASE','REWRITE'],@p);"
NSQ_SOURCE_LINE 00002693 "    my $url  = '';"
NSQ_SOURCE_LINE 00002694 "    $full++      if $base || !($relative || $absolute);"
NSQ_SOURCE_LINE 00002695 "    $rewrite++   unless defined $rewrite;"
NSQ_SOURCE_LINE 00002696 ""
NSQ_SOURCE_LINE 00002697 "    my $path        =  $self->path_info;"
NSQ_SOURCE_LINE 00002698 "    my $script_name =  $self->script_name;"
NSQ_SOURCE_LINE 00002699 "    my $request_uri =  $self->request_uri || '';"
NSQ_SOURCE_LINE 00002700 "    my $query_str   =  $query ? $self->query_string : '';"
NSQ_SOURCE_LINE 00002701 ""
NSQ_SOURCE_LINE 00002702 "    $script_name    =~ s/\\?.*$//s; # remove query string"
NSQ_SOURCE_LINE 00002703 "    $request_uri    =~ s/\\?.*$//s; # remove query string"
NSQ_SOURCE_LINE 00002704 "    $request_uri    =  unescape($request_uri);"
NSQ_SOURCE_LINE 00002705 ""
NSQ_SOURCE_LINE 00002706 "    my $uri         =  $rewrite && $request_uri ? $request_uri : $script_name;"
NSQ_SOURCE_LINE 00002707 ""
NSQ_SOURCE_LINE 00002708 "\tif ( defined( $ENV{PATH_INFO} ) ) {"
NSQ_SOURCE_LINE 00002709 "\t\t# IIS sometimes sets PATH_INFO to the same value as SCRIPT_NAME so only sub it out"
NSQ_SOURCE_LINE 00002710 "\t\t# if SCRIPT_NAME isn't defined or isn't the same value as PATH_INFO"
NSQ_SOURCE_LINE 00002711 "\t\t$uri =~ s/\\Q$ENV{PATH_INFO}\\E$//"
NSQ_SOURCE_LINE 00002712 "\t\t\tif ( ! defined( $ENV{SCRIPT_NAME} ) or $ENV{PATH_INFO} ne $ENV{SCRIPT_NAME} );"
NSQ_SOURCE_LINE 00002713 ""
NSQ_SOURCE_LINE 00002714 "\t\t# if we're not IIS then keep to spec, the relevant info is here:"
NSQ_SOURCE_LINE 00002715 "\t\t# https://tools.ietf.org/html/rfc3875#section-4.1.13, namely"
NSQ_SOURCE_LINE 00002716 "\t\t# \"No PATH_INFO segment (see section 4.1.5) is included in the"
NSQ_SOURCE_LINE 00002717 "\t\t# SCRIPT_NAME value.\" (see GH #126, GH #152, GH #176)"
NSQ_SOURCE_LINE 00002718 "\t\tif ( ! $IIS ) {"
NSQ_SOURCE_LINE 00002719 "\t\t\t$uri =~ s/\\Q$ENV{PATH_INFO}\\E$//;"
NSQ_SOURCE_LINE 00002720 "\t\t}"
NSQ_SOURCE_LINE 00002721 "\t}"
NSQ_SOURCE_LINE 00002722 ""
NSQ_SOURCE_LINE 00002723 "    if ($full) {"
NSQ_SOURCE_LINE 00002724 "        my $protocol = $self->protocol();"
NSQ_SOURCE_LINE 00002725 "        $url = \"$protocol://\";"
NSQ_SOURCE_LINE 00002726 "        my $vh = http('x_forwarded_host') || http('host') || '';"
NSQ_SOURCE_LINE 00002727 "\t\t\t$vh =~ s/^.*,\\s*//; # x_forwarded_host may be a comma-separated list (e.g. when the request has"
NSQ_SOURCE_LINE 00002728 "                                # passed through multiple reverse proxies. Take the last one."
NSQ_SOURCE_LINE 00002729 "            $vh =~ s/\\:\\d+$//;  # some clients add the port number (incorrectly). Get rid of it."
NSQ_SOURCE_LINE 00002730 ""
NSQ_SOURCE_LINE 00002731 "        $url .= $vh || server_name();"
NSQ_SOURCE_LINE 00002732 ""
NSQ_SOURCE_LINE 00002733 "        my $port = $self->virtual_port;"
NSQ_SOURCE_LINE 00002734 ""
NSQ_SOURCE_LINE 00002735 "        # add the port to the url unless it's the protocol's default port"
NSQ_SOURCE_LINE 00002736 "        $url .= ':' . $port unless (lc($protocol) eq 'http'  && $port == 80)"
NSQ_SOURCE_LINE 00002737 "                                or (lc($protocol) eq 'https' && $port == 443);"
NSQ_SOURCE_LINE 00002738 ""
NSQ_SOURCE_LINE 00002739 "        return $url if $base;"
NSQ_SOURCE_LINE 00002740 ""
NSQ_SOURCE_LINE 00002741 "        $url .= $uri;"
NSQ_SOURCE_LINE 00002742 "    } elsif ($relative) {"
NSQ_SOURCE_LINE 00002743 "\t($url) = $uri =~ m!([^/]+)$!;"
NSQ_SOURCE_LINE 00002744 "    } elsif ($absolute) {"
NSQ_SOURCE_LINE 00002745 "\t$url = $uri;"
NSQ_SOURCE_LINE 00002746 "    }"
NSQ_SOURCE_LINE 00002747 ""
NSQ_SOURCE_LINE 00002748 "    $url .= $path         if $path_info and defined $path;"
NSQ_SOURCE_LINE 00002749 "    $url .= \"?$query_str\" if $query     and $query_str ne '';"
NSQ_SOURCE_LINE 00002750 "    $url ||= '';"
NSQ_SOURCE_LINE 00002751 ""
NSQ_SOURCE_LINE 00002752 "\t$url = URI->new( $url )->canonical->as_string;"
NSQ_SOURCE_LINE 00002753 "\treturn $url"
NSQ_SOURCE_LINE 00002754 "}"
NSQ_SOURCE_LINE 00002755 ""
NSQ_SOURCE_LINE 00002756 "#### Method: cookie"
NSQ_SOURCE_LINE 00002757 "# Set or read a cookie from the specified name."
NSQ_SOURCE_LINE 00002758 "# Cookie can then be passed to header()."
NSQ_SOURCE_LINE 00002759 "# Usual rules apply to the stickiness of -value."
NSQ_SOURCE_LINE 00002760 "#  Parameters:"
NSQ_SOURCE_LINE 00002761 "#   -name -> name for this cookie (optional)"
NSQ_SOURCE_LINE 00002762 "#   -value -> value of this cookie (scalar, array or hash) "
NSQ_SOURCE_LINE 00002763 "#   -path -> paths for which this cookie is valid (optional)"
NSQ_SOURCE_LINE 00002764 "#   -domain -> internet domain in which this cookie is valid (optional)"
NSQ_SOURCE_LINE 00002765 "#   -secure -> if true, cookie only passed through secure channel (optional)"
NSQ_SOURCE_LINE 00002766 "#   -expires -> expiry date in format Wdy, DD Mon YYYY HH:MM:SS GMT (optional)"
NSQ_SOURCE_LINE 00002767 "####"
NSQ_SOURCE_LINE 00002768 "sub cookie {"
NSQ_SOURCE_LINE 00002769 "    my($self,@p) = self_or_default(@_);"
NSQ_SOURCE_LINE 00002770 "    my($name,$value,$path,$domain,$secure,$expires,$httponly,$max_age,$samesite,$priority) ="
NSQ_SOURCE_LINE 00002771 "\trearrange([NAME,[VALUE,VALUES],PATH,DOMAIN,SECURE,EXPIRES,HTTPONLY,'MAX-AGE',SAMESITE,PRIORITY],@p);"
NSQ_SOURCE_LINE 00002772 ""
NSQ_SOURCE_LINE 00002773 "    require CGI::Cookie;"
NSQ_SOURCE_LINE 00002774 ""
NSQ_SOURCE_LINE 00002775 "    # if no value is supplied, then we retrieve the"
NSQ_SOURCE_LINE 00002776 "    # value of the cookie, if any.  For efficiency, we cache the parsed"
NSQ_SOURCE_LINE 00002777 "    # cookies in our state variables."
NSQ_SOURCE_LINE 00002778 "    unless ( defined($value) ) {"
NSQ_SOURCE_LINE 00002779 "\t$self->{'.cookies'} = CGI::Cookie->fetch unless $COOKIE_CACHE && exists $self->{'.cookies'};"
NSQ_SOURCE_LINE 00002780 "\t"
NSQ_SOURCE_LINE 00002781 "\t# If no name is supplied, then retrieve the names of all our cookies."
NSQ_SOURCE_LINE 00002782 "\treturn () unless $self->{'.cookies'};"
NSQ_SOURCE_LINE 00002783 "\treturn keys %{$self->{'.cookies'}} unless $name;"
NSQ_SOURCE_LINE 00002784 "\treturn () unless $self->{'.cookies'}->{$name};"
NSQ_SOURCE_LINE 00002785 "\treturn $self->{'.cookies'}->{$name}->value if defined($name) && $name ne '';"
NSQ_SOURCE_LINE 00002786 "    }"
NSQ_SOURCE_LINE 00002787 ""
NSQ_SOURCE_LINE 00002788 "    # If we get here, we're creating a new cookie"
NSQ_SOURCE_LINE 00002789 "    return undef unless defined($name) && $name ne '';\t# this is an error"
NSQ_SOURCE_LINE 00002790 ""
NSQ_SOURCE_LINE 00002791 "    my @param;"
NSQ_SOURCE_LINE 00002792 "    push(@param,'-name'=>$name);"
NSQ_SOURCE_LINE 00002793 "    push(@param,'-value'=>$value);"
NSQ_SOURCE_LINE 00002794 "    push(@param,'-domain'=>$domain) if $domain;"
NSQ_SOURCE_LINE 00002795 "    push(@param,'-path'=>$path) if $path;"
NSQ_SOURCE_LINE 00002796 "    push(@param,'-expires'=>$expires) if $expires;"
NSQ_SOURCE_LINE 00002797 "    push(@param,'-secure'=>$secure) if $secure;"
NSQ_SOURCE_LINE 00002798 "    push(@param,'-httponly'=>$httponly) if $httponly;"
NSQ_SOURCE_LINE 00002799 "    push(@param,'-max-age'=>$max_age) if $max_age;"
NSQ_SOURCE_LINE 00002800 "    push(@param,'-samesite'=>$samesite) if $samesite;"
NSQ_SOURCE_LINE 00002801 "    push(@param,'-priority'=>$priority) if $priority;"
NSQ_SOURCE_LINE 00002802 ""
NSQ_SOURCE_LINE 00002803 "    return CGI::Cookie->new(@param);"
NSQ_SOURCE_LINE 00002804 "}"
NSQ_SOURCE_LINE 00002805 ""
NSQ_SOURCE_LINE 00002806 "sub parse_keywordlist {"
NSQ_SOURCE_LINE 00002807 "    my($self,$tosplit) = @_;"
NSQ_SOURCE_LINE 00002808 "    $tosplit = unescape($tosplit); # unescape the keywords"
NSQ_SOURCE_LINE 00002809 "    $tosplit=~tr/+/ /;          # pluses to spaces"
NSQ_SOURCE_LINE 00002810 "    my(@keywords) = split(/\\s+/,$tosplit);"
NSQ_SOURCE_LINE 00002811 "    return @keywords;"
NSQ_SOURCE_LINE 00002812 "}"
NSQ_SOURCE_LINE 00002813 ""
NSQ_SOURCE_LINE 00002814 "sub param_fetch {"
NSQ_SOURCE_LINE 00002815 "    my($self,@p) = self_or_default(@_);"
NSQ_SOURCE_LINE 00002816 "    my($name) = rearrange([NAME],@p);"
NSQ_SOURCE_LINE 00002817 "    return [] unless defined $name;"
NSQ_SOURCE_LINE 00002818 ""
NSQ_SOURCE_LINE 00002819 "    unless (exists($self->{param}{$name})) {"
NSQ_SOURCE_LINE 00002820 "\t$self->add_parameter($name);"
NSQ_SOURCE_LINE 00002821 "\t$self->{param}{$name} = [];"
NSQ_SOURCE_LINE 00002822 "    }"
NSQ_SOURCE_LINE 00002823 "    "
NSQ_SOURCE_LINE 00002824 "    return $self->{param}{$name};"
NSQ_SOURCE_LINE 00002825 "}"
NSQ_SOURCE_LINE 00002826 ""
NSQ_SOURCE_LINE 00002827 "###############################################"
NSQ_SOURCE_LINE 00002828 "# OTHER INFORMATION PROVIDED BY THE ENVIRONMENT"
NSQ_SOURCE_LINE 00002829 "###############################################"
NSQ_SOURCE_LINE 00002830 ""
NSQ_SOURCE_LINE 00002831 "#### Method: path_info"
NSQ_SOURCE_LINE 00002832 "# Return the extra virtual path information provided"
NSQ_SOURCE_LINE 00002833 "# after the URL (if any)"
NSQ_SOURCE_LINE 00002834 "####"
NSQ_SOURCE_LINE 00002835 "sub path_info {"
NSQ_SOURCE_LINE 00002836 "    my ($self,$info) = self_or_default(@_);"
NSQ_SOURCE_LINE 00002837 "    if (defined($info)) {"
NSQ_SOURCE_LINE 00002838 "\t$info = \"/$info\" if $info ne '' &&  substr($info,0,1) ne '/';"
NSQ_SOURCE_LINE 00002839 "\t$self->{'.path_info'} = $info;"
NSQ_SOURCE_LINE 00002840 "    } elsif (! defined($self->{'.path_info'}) ) {"
NSQ_SOURCE_LINE 00002841 "        my (undef,$path_info) = $self->_name_and_path_from_env;"
NSQ_SOURCE_LINE 00002842 "\t$self->{'.path_info'} = $path_info || '';"
NSQ_SOURCE_LINE 00002843 "    }"
NSQ_SOURCE_LINE 00002844 "    return $self->{'.path_info'};"
NSQ_SOURCE_LINE 00002845 "}"
NSQ_SOURCE_LINE 00002846 ""
NSQ_SOURCE_LINE 00002847 "# This function returns a potentially modified version of SCRIPT_NAME"
NSQ_SOURCE_LINE 00002848 "# and PATH_INFO. Some HTTP servers do sanitise the paths in those"
NSQ_SOURCE_LINE 00002849 "# variables. It is the case of at least Apache 2. If for instance the"
NSQ_SOURCE_LINE 00002850 "# user requests: /path/./to/script.cgi/x//y/z/../x?y, Apache will set:"
NSQ_SOURCE_LINE 00002851 "# REQUEST_URI=/path/./to/script.cgi/x//y/z/../x?y"
NSQ_SOURCE_LINE 00002852 "# SCRIPT_NAME=/path/to/env.cgi"
NSQ_SOURCE_LINE 00002853 "# PATH_INFO=/x/y/x"
NSQ_SOURCE_LINE 00002854 "#"
NSQ_SOURCE_LINE 00002855 "# This is all fine except that some bogus CGI scripts expect"
NSQ_SOURCE_LINE 00002856 "# PATH_INFO=/http://foo when the user requests"
NSQ_SOURCE_LINE 00002857 "# http://xxx/script.cgi/http://foo"
NSQ_SOURCE_LINE 00002858 "#"
NSQ_SOURCE_LINE 00002859 "# Old versions of this module used to accomodate with those scripts, so"
NSQ_SOURCE_LINE 00002860 "# this is why we do this here to keep those scripts backward compatible."
NSQ_SOURCE_LINE 00002861 "# Basically, we accomodate with those scripts but within limits, that is"
NSQ_SOURCE_LINE 00002862 "# we only try to preserve the number of / that were provided by the user"
NSQ_SOURCE_LINE 00002863 "# if $REQUEST_URI and \"$SCRIPT_NAME$PATH_INFO\" only differ by the number"
NSQ_SOURCE_LINE 00002864 "# of consecutive /."
NSQ_SOURCE_LINE 00002865 "#"
NSQ_SOURCE_LINE 00002866 "# So for instance, in: http://foo/x//y/script.cgi/a//b, we'll return a"
NSQ_SOURCE_LINE 00002867 "# script_name of /x//y/script.cgi and a path_info of /a//b, but in:"
NSQ_SOURCE_LINE 00002868 "# http://foo/./x//z/script.cgi/a/../b//c, we'll return the versions"
NSQ_SOURCE_LINE 00002869 "# possibly sanitised by the HTTP server, so in the case of Apache 2:"
NSQ_SOURCE_LINE 00002870 "# script_name == /foo/x/z/script.cgi and path_info == /b/c."
NSQ_SOURCE_LINE 00002871 "#"
NSQ_SOURCE_LINE 00002872 "# Future versions of this module may no longer do that, so one should"
NSQ_SOURCE_LINE 00002873 "# avoid relying on the browser, proxy, server, and CGI.pm preserving the"
NSQ_SOURCE_LINE 00002874 "# number of consecutive slashes as no guarantee can be made there."
NSQ_SOURCE_LINE 00002875 "sub _name_and_path_from_env {"
NSQ_SOURCE_LINE 00002876 "    my $self = shift;"
NSQ_SOURCE_LINE 00002877 "    my $script_name = $ENV{SCRIPT_NAME}  || '';"
NSQ_SOURCE_LINE 00002878 "    my $path_info   = $ENV{PATH_INFO}    || '';"
NSQ_SOURCE_LINE 00002879 "    my $uri         = $self->request_uri || '';"
NSQ_SOURCE_LINE 00002880 ""
NSQ_SOURCE_LINE 00002881 "    $uri =~ s/\\?.*//s;"
NSQ_SOURCE_LINE 00002882 "    $uri = unescape($uri);"
NSQ_SOURCE_LINE 00002883 ""
NSQ_SOURCE_LINE 00002884 "    if ( $IIS ) {"
NSQ_SOURCE_LINE 00002885 "      # IIS doesn't set $ENV{PATH_INFO} correctly. It sets it to"
NSQ_SOURCE_LINE 00002886 "      # $ENV{SCRIPT_NAME}path_info "
NSQ_SOURCE_LINE 00002887 "      # IIS also doesn't set $ENV{REQUEST_URI} so we don't want to do"
NSQ_SOURCE_LINE 00002888 "      # the test below, hence this comes first"
NSQ_SOURCE_LINE 00002889 "      $path_info =~ s/^\\Q$script_name\\E(.*)/$1/;"
NSQ_SOURCE_LINE 00002890 "    } elsif ($uri ne \"$script_name$path_info\") {"
NSQ_SOURCE_LINE 00002891 "        my $script_name_pattern = quotemeta($script_name);"
NSQ_SOURCE_LINE 00002892 "        my $path_info_pattern = quotemeta($path_info);"
NSQ_SOURCE_LINE 00002893 "        $script_name_pattern =~ s{(?:\\\\/)+}{/+}g;"
NSQ_SOURCE_LINE 00002894 "        $path_info_pattern =~ s{(?:\\\\/)+}{/+}g;"
NSQ_SOURCE_LINE 00002895 ""
NSQ_SOURCE_LINE 00002896 "        if ($uri =~ /^($script_name_pattern)($path_info_pattern)$/s) {"
NSQ_SOURCE_LINE 00002897 "            # REQUEST_URI and SCRIPT_NAME . PATH_INFO only differ by the"
NSQ_SOURCE_LINE 00002898 "            # numer of consecutive slashes, so we can extract the info from"
NSQ_SOURCE_LINE 00002899 "            # REQUEST_URI:"
NSQ_SOURCE_LINE 00002900 "            ($script_name, $path_info) = ($1, $2);"
NSQ_SOURCE_LINE 00002901 "        }"
NSQ_SOURCE_LINE 00002902 "    }"
NSQ_SOURCE_LINE 00002903 "    return ($script_name,$path_info);"
NSQ_SOURCE_LINE 00002904 "}"
NSQ_SOURCE_LINE 00002905 ""
NSQ_SOURCE_LINE 00002906 "#### Method: request_method"
NSQ_SOURCE_LINE 00002907 "# Returns 'POST', 'GET', 'PUT', 'PATCH' or 'HEAD'"
NSQ_SOURCE_LINE 00002908 "####"
NSQ_SOURCE_LINE 00002909 "sub request_method {"
NSQ_SOURCE_LINE 00002910 "    return (defined $ENV{'REQUEST_METHOD'}) ? $ENV{'REQUEST_METHOD'} : undef;"
NSQ_SOURCE_LINE 00002911 "}"
NSQ_SOURCE_LINE 00002912 ""
NSQ_SOURCE_LINE 00002913 "#### Method: content_type"
NSQ_SOURCE_LINE 00002914 "# Returns the content_type string"
NSQ_SOURCE_LINE 00002915 "####"
NSQ_SOURCE_LINE 00002916 "sub content_type {"
NSQ_SOURCE_LINE 00002917 "    return (defined $ENV{'CONTENT_TYPE'}) ? $ENV{'CONTENT_TYPE'} : undef;"
NSQ_SOURCE_LINE 00002918 "}"
NSQ_SOURCE_LINE 00002919 ""
NSQ_SOURCE_LINE 00002920 "#### Method: path_translated"
NSQ_SOURCE_LINE 00002921 "# Return the physical path information provided"
NSQ_SOURCE_LINE 00002922 "# by the URL (if any)"
NSQ_SOURCE_LINE 00002923 "####"
NSQ_SOURCE_LINE 00002924 "sub path_translated {"
NSQ_SOURCE_LINE 00002925 "    return (defined $ENV{'PATH_TRANSLATED'}) ? $ENV{'PATH_TRANSLATED'} : undef;"
NSQ_SOURCE_LINE 00002926 "}"
NSQ_SOURCE_LINE 00002927 ""
NSQ_SOURCE_LINE 00002928 "#### Method: request_uri"
NSQ_SOURCE_LINE 00002929 "# Return the literal request URI"
NSQ_SOURCE_LINE 00002930 "####"
NSQ_SOURCE_LINE 00002931 "sub request_uri {"
NSQ_SOURCE_LINE 00002932 "    return (defined $ENV{'REQUEST_URI'}) ? $ENV{'REQUEST_URI'} : undef;"
NSQ_SOURCE_LINE 00002933 "}"
NSQ_SOURCE_LINE 00002934 ""
NSQ_SOURCE_LINE 00002935 "#### Method: query_string"
NSQ_SOURCE_LINE 00002936 "# Synthesize a query string from our current"
NSQ_SOURCE_LINE 00002937 "# parameters"
NSQ_SOURCE_LINE 00002938 "####"
NSQ_SOURCE_LINE 00002939 "sub query_string {"
NSQ_SOURCE_LINE 00002940 "    my($self) = self_or_default(@_);"
NSQ_SOURCE_LINE 00002941 "    my($param,$value,@pairs);"
NSQ_SOURCE_LINE 00002942 "    for $param ($self->param) {"
NSQ_SOURCE_LINE 00002943 "       my($eparam) = escape($param);"
NSQ_SOURCE_LINE 00002944 "       for $value ($self->param($param)) {"
NSQ_SOURCE_LINE 00002945 "           $value = escape($value);"
NSQ_SOURCE_LINE 00002946 "            next unless defined $value;"
NSQ_SOURCE_LINE 00002947 "           push(@pairs,\"$eparam=$value\");"
NSQ_SOURCE_LINE 00002948 "       }"
NSQ_SOURCE_LINE 00002949 "    }"
NSQ_SOURCE_LINE 00002950 "    for (sort keys %{$self->{'.fieldnames'}}) {"
NSQ_SOURCE_LINE 00002951 "      push(@pairs,\".cgifields=\".escape(\"$_\"));"
NSQ_SOURCE_LINE 00002952 "    }"
NSQ_SOURCE_LINE 00002953 "    return join($USE_PARAM_SEMICOLONS ? ';' : '&',@pairs);"
NSQ_SOURCE_LINE 00002954 "}"
NSQ_SOURCE_LINE 00002955 ""
NSQ_SOURCE_LINE 00002956 "sub env_query_string {"
NSQ_SOURCE_LINE 00002957 "    return (defined $ENV{'QUERY_STRING'}) ? $ENV{'QUERY_STRING'} : undef;"
NSQ_SOURCE_LINE 00002958 "}"
NSQ_SOURCE_LINE 00002959 ""
NSQ_SOURCE_LINE 00002960 "#### Method: accept"
NSQ_SOURCE_LINE 00002961 "# Without parameters, returns an array of the"
NSQ_SOURCE_LINE 00002962 "# MIME types the browser accepts."
NSQ_SOURCE_LINE 00002963 "# With a single parameter equal to a MIME"
NSQ_SOURCE_LINE 00002964 "# type, will return undef if the browser won't"
NSQ_SOURCE_LINE 00002965 "# accept it, 1 if the browser accepts it but"
NSQ_SOURCE_LINE 00002966 "# doesn't give a preference, or a floating point"
NSQ_SOURCE_LINE 00002967 "# value between 0.0 and 1.0 if the browser"
NSQ_SOURCE_LINE 00002968 "# declares a quantitative score for it."
NSQ_SOURCE_LINE 00002969 "# This handles MIME type globs correctly."
NSQ_SOURCE_LINE 00002970 "####"
NSQ_SOURCE_LINE 00002971 "sub Accept {"
NSQ_SOURCE_LINE 00002972 "    my($self,$search) = self_or_CGI(@_);"
NSQ_SOURCE_LINE 00002973 "    my(%prefs,$type,$pref,$pat);"
NSQ_SOURCE_LINE 00002974 "    "
NSQ_SOURCE_LINE 00002975 "    my(@accept) = defined $self->http('accept') "
NSQ_SOURCE_LINE 00002976 "                ? split(',',$self->http('accept'))"
NSQ_SOURCE_LINE 00002977 "                : ();"
NSQ_SOURCE_LINE 00002978 ""
NSQ_SOURCE_LINE 00002979 "    for (@accept) {"
NSQ_SOURCE_LINE 00002980 "\t($pref) = /q=(\\d\\.\\d+|\\d+)/;"
NSQ_SOURCE_LINE 00002981 "\t($type) = m#(\\S+/[^;]+)#;"
NSQ_SOURCE_LINE 00002982 "\tnext unless $type;"
NSQ_SOURCE_LINE 00002983 "\t$prefs{$type}=$pref || 1;"
NSQ_SOURCE_LINE 00002984 "    }"
NSQ_SOURCE_LINE 00002985 ""
NSQ_SOURCE_LINE 00002986 "    return keys %prefs unless $search;"
NSQ_SOURCE_LINE 00002987 "    "
NSQ_SOURCE_LINE 00002988 "    # if a search type is provided, we may need to"
NSQ_SOURCE_LINE 00002989 "    # perform a pattern matching operation."
NSQ_SOURCE_LINE 00002990 "    # The MIME types use a glob mechanism, which"
NSQ_SOURCE_LINE 00002991 "    # is easily translated into a perl pattern match"
NSQ_SOURCE_LINE 00002992 ""
NSQ_SOURCE_LINE 00002993 "    # First return the preference for directly supported"
NSQ_SOURCE_LINE 00002994 "    # types:"
NSQ_SOURCE_LINE 00002995 "    return $prefs{$search} if $prefs{$search};"
NSQ_SOURCE_LINE 00002996 ""
NSQ_SOURCE_LINE 00002997 "    # Didn't get it, so try pattern matching."
NSQ_SOURCE_LINE 00002998 "    for (sort keys %prefs) {"
NSQ_SOURCE_LINE 00002999 "\tnext unless /\\*/;       # not a pattern match"
NSQ_SOURCE_LINE 00003000 "\t($pat = $_) =~ s/([^\\w*])/\\\\$1/g; # escape meta characters"
NSQ_SOURCE_LINE 00003001 "\t$pat =~ s/\\*/.*/g; # turn it into a pattern"
NSQ_SOURCE_LINE 00003002 "\treturn $prefs{$_} if $search=~/$pat/;"
NSQ_SOURCE_LINE 00003003 "    }"
NSQ_SOURCE_LINE 00003004 "}"
NSQ_SOURCE_LINE 00003005 ""
NSQ_SOURCE_LINE 00003006 "#### Method: user_agent"
NSQ_SOURCE_LINE 00003007 "# If called with no parameters, returns the user agent."
NSQ_SOURCE_LINE 00003008 "# If called with one parameter, does a pattern match (case"
NSQ_SOURCE_LINE 00003009 "# insensitive) on the user agent."
NSQ_SOURCE_LINE 00003010 "####"
NSQ_SOURCE_LINE 00003011 "sub user_agent {"
NSQ_SOURCE_LINE 00003012 "    my($self,$match)=self_or_CGI(@_);"
NSQ_SOURCE_LINE 00003013 "    my $user_agent = $self->http('user_agent');"
NSQ_SOURCE_LINE 00003014 "    return $user_agent unless defined $match && $match && $user_agent;"
NSQ_SOURCE_LINE 00003015 "    return $user_agent =~ /$match/i;"
NSQ_SOURCE_LINE 00003016 "}"
NSQ_SOURCE_LINE 00003017 ""
NSQ_SOURCE_LINE 00003018 "#### Method: raw_cookie"
NSQ_SOURCE_LINE 00003019 "# Returns the magic cookies for the session."
NSQ_SOURCE_LINE 00003020 "# The cookies are not parsed or altered in any way, i.e."
NSQ_SOURCE_LINE 00003021 "# cookies are returned exactly as given in the HTTP"
NSQ_SOURCE_LINE 00003022 "# headers.  If a cookie name is given, only that cookie's"
NSQ_SOURCE_LINE 00003023 "# value is returned, otherwise the entire raw cookie"
NSQ_SOURCE_LINE 00003024 "# is returned."
NSQ_SOURCE_LINE 00003025 "####"
NSQ_SOURCE_LINE 00003026 "sub raw_cookie {"
NSQ_SOURCE_LINE 00003027 "    my($self,$key) = self_or_CGI(@_);"
NSQ_SOURCE_LINE 00003028 ""
NSQ_SOURCE_LINE 00003029 "    require CGI::Cookie;"
NSQ_SOURCE_LINE 00003030 ""
NSQ_SOURCE_LINE 00003031 "    if (defined($key)) {"
NSQ_SOURCE_LINE 00003032 "\t$self->{'.raw_cookies'} = CGI::Cookie->raw_fetch"
NSQ_SOURCE_LINE 00003033 "\t    unless $self->{'.raw_cookies'};"
NSQ_SOURCE_LINE 00003034 ""
NSQ_SOURCE_LINE 00003035 "\treturn () unless $self->{'.raw_cookies'};"
NSQ_SOURCE_LINE 00003036 "\treturn () unless $self->{'.raw_cookies'}->{$key};"
NSQ_SOURCE_LINE 00003037 "\treturn $self->{'.raw_cookies'}->{$key};"
NSQ_SOURCE_LINE 00003038 "    }"
NSQ_SOURCE_LINE 00003039 "    return $self->http('cookie') || $ENV{'COOKIE'} || '';"
NSQ_SOURCE_LINE 00003040 "}"
NSQ_SOURCE_LINE 00003041 ""
NSQ_SOURCE_LINE 00003042 "#### Method: virtual_host"
NSQ_SOURCE_LINE 00003043 "# Return the name of the virtual_host, which"
NSQ_SOURCE_LINE 00003044 "# is not always the same as the server"
NSQ_SOURCE_LINE 00003045 "######"
NSQ_SOURCE_LINE 00003046 "sub virtual_host {"
NSQ_SOURCE_LINE 00003047 "    my $vh = http('x_forwarded_host') || http('host') || server_name();"
NSQ_SOURCE_LINE 00003048 "    $vh =~ s/:\\d+$//;\t\t# get rid of port number"
NSQ_SOURCE_LINE 00003049 "    return $vh;"
NSQ_SOURCE_LINE 00003050 "}"
NSQ_SOURCE_LINE 00003051 ""
NSQ_SOURCE_LINE 00003052 "#### Method: remote_host"
NSQ_SOURCE_LINE 00003053 "# Return the name of the remote host, or its IP"
NSQ_SOURCE_LINE 00003054 "# address if unavailable.  If this variable isn't"
NSQ_SOURCE_LINE 00003055 "# defined, it returns \"localhost\" for debugging"
NSQ_SOURCE_LINE 00003056 "# purposes."
NSQ_SOURCE_LINE 00003057 "####"
NSQ_SOURCE_LINE 00003058 "sub remote_host {"
NSQ_SOURCE_LINE 00003059 "    return $ENV{'REMOTE_HOST'} || $ENV{'REMOTE_ADDR'} "
NSQ_SOURCE_LINE 00003060 "    || 'localhost';"
NSQ_SOURCE_LINE 00003061 "}"
NSQ_SOURCE_LINE 00003062 ""
NSQ_SOURCE_LINE 00003063 "#### Method: remote_addr"
NSQ_SOURCE_LINE 00003064 "# Return the IP addr of the remote host."
NSQ_SOURCE_LINE 00003065 "####"
NSQ_SOURCE_LINE 00003066 "sub remote_addr {"
NSQ_SOURCE_LINE 00003067 "    return $ENV{'REMOTE_ADDR'} || '127.0.0.1';"
NSQ_SOURCE_LINE 00003068 "}"
NSQ_SOURCE_LINE 00003069 ""
NSQ_SOURCE_LINE 00003070 "#### Method: script_name"
NSQ_SOURCE_LINE 00003071 "# Return the partial URL to this script for"
NSQ_SOURCE_LINE 00003072 "# self-referencing scripts.  Also see"
NSQ_SOURCE_LINE 00003073 "# self_url(), which returns a URL with all state information"
NSQ_SOURCE_LINE 00003074 "# preserved."
NSQ_SOURCE_LINE 00003075 "####"
NSQ_SOURCE_LINE 00003076 "sub script_name {"
NSQ_SOURCE_LINE 00003077 "    my ($self,@p) = self_or_default(@_);"
NSQ_SOURCE_LINE 00003078 "    if (@p) {"
NSQ_SOURCE_LINE 00003079 "        $self->{'.script_name'} = shift @p;"
NSQ_SOURCE_LINE 00003080 "    } elsif (!exists $self->{'.script_name'}) {"
NSQ_SOURCE_LINE 00003081 "        my ($script_name,$path_info) = $self->_name_and_path_from_env();"
NSQ_SOURCE_LINE 00003082 "        $self->{'.script_name'} = $script_name;"
NSQ_SOURCE_LINE 00003083 "    }"
NSQ_SOURCE_LINE 00003084 "    return $self->{'.script_name'};"
NSQ_SOURCE_LINE 00003085 "}"
NSQ_SOURCE_LINE 00003086 ""
NSQ_SOURCE_LINE 00003087 "#### Method: referer"
NSQ_SOURCE_LINE 00003088 "# Return the HTTP_REFERER: useful for generating"
NSQ_SOURCE_LINE 00003089 "# a GO BACK button."
NSQ_SOURCE_LINE 00003090 "####"
NSQ_SOURCE_LINE 00003091 "sub referer {"
NSQ_SOURCE_LINE 00003092 "    my($self) = self_or_CGI(@_);"
NSQ_SOURCE_LINE 00003093 "    return $self->http('referer');"
NSQ_SOURCE_LINE 00003094 "}"
NSQ_SOURCE_LINE 00003095 ""
NSQ_SOURCE_LINE 00003096 "#### Method: server_name"
NSQ_SOURCE_LINE 00003097 "# Return the name of the server"
NSQ_SOURCE_LINE 00003098 "####"
NSQ_SOURCE_LINE 00003099 "sub server_name {"
NSQ_SOURCE_LINE 00003100 "    return $ENV{'SERVER_NAME'} || 'localhost';"
NSQ_SOURCE_LINE 00003101 "}"
NSQ_SOURCE_LINE 00003102 ""
NSQ_SOURCE_LINE 00003103 "#### Method: server_software"
NSQ_SOURCE_LINE 00003104 "# Return the name of the server software"
NSQ_SOURCE_LINE 00003105 "####"
NSQ_SOURCE_LINE 00003106 "sub server_software {"
NSQ_SOURCE_LINE 00003107 "    return $ENV{'SERVER_SOFTWARE'} || 'cmdline';"
NSQ_SOURCE_LINE 00003108 "}"
NSQ_SOURCE_LINE 00003109 ""
NSQ_SOURCE_LINE 00003110 "#### Method: virtual_port"
NSQ_SOURCE_LINE 00003111 "# Return the server port, taking virtual hosts into account"
NSQ_SOURCE_LINE 00003112 "####"
NSQ_SOURCE_LINE 00003113 "sub virtual_port {"
NSQ_SOURCE_LINE 00003114 "    my($self) = self_or_default(@_);"
NSQ_SOURCE_LINE 00003115 "    my $vh = $self->http('x_forwarded_host') || $self->http('host');"
NSQ_SOURCE_LINE 00003116 "    my $protocol = $self->protocol;"
NSQ_SOURCE_LINE 00003117 "    if ($vh) {"
NSQ_SOURCE_LINE 00003118 "        return ($vh =~ /:(\\d+)$/)[0] || ($protocol eq 'https' ? 443 : 80);"
NSQ_SOURCE_LINE 00003119 "    } else {"
NSQ_SOURCE_LINE 00003120 "        return $self->server_port();"
NSQ_SOURCE_LINE 00003121 "    }"
NSQ_SOURCE_LINE 00003122 "}"
NSQ_SOURCE_LINE 00003123 ""
NSQ_SOURCE_LINE 00003124 "#### Method: server_port"
NSQ_SOURCE_LINE 00003125 "# Return the tcp/ip port the server is running on"
NSQ_SOURCE_LINE 00003126 "####"
NSQ_SOURCE_LINE 00003127 "sub server_port {"
NSQ_SOURCE_LINE 00003128 "    return $ENV{'SERVER_PORT'} || 80; # for debugging"
NSQ_SOURCE_LINE 00003129 "}"
NSQ_SOURCE_LINE 00003130 ""
NSQ_SOURCE_LINE 00003131 "#### Method: server_protocol"
NSQ_SOURCE_LINE 00003132 "# Return the protocol (usually HTTP/1.0)"
NSQ_SOURCE_LINE 00003133 "####"
NSQ_SOURCE_LINE 00003134 "sub server_protocol {"
NSQ_SOURCE_LINE 00003135 "    return $ENV{'SERVER_PROTOCOL'} || 'HTTP/1.0'; # for debugging"
NSQ_SOURCE_LINE 00003136 "}"
NSQ_SOURCE_LINE 00003137 ""
NSQ_SOURCE_LINE 00003138 "#### Method: http"
NSQ_SOURCE_LINE 00003139 "# Return the value of an HTTP variable, or"
NSQ_SOURCE_LINE 00003140 "# the list of variables if none provided"
NSQ_SOURCE_LINE 00003141 "####"
NSQ_SOURCE_LINE 00003142 "sub http {"
NSQ_SOURCE_LINE 00003143 "    my ($self,$parameter) = self_or_CGI(@_);"
NSQ_SOURCE_LINE 00003144 "    if ( defined($parameter) ) {"
NSQ_SOURCE_LINE 00003145 "        $parameter =~ tr/-a-z/_A-Z/;"
NSQ_SOURCE_LINE 00003146 "        if ( $parameter =~ /^HTTP(?:_|$)/ ) {"
NSQ_SOURCE_LINE 00003147 "            return $ENV{$parameter};"
NSQ_SOURCE_LINE 00003148 "        }"
NSQ_SOURCE_LINE 00003149 "        return $ENV{\"HTTP_$parameter\"};"
NSQ_SOURCE_LINE 00003150 "    }"
NSQ_SOURCE_LINE 00003151 "    return grep { /^HTTP(?:_|$)/ } sort keys %ENV;"
NSQ_SOURCE_LINE 00003152 "}"
NSQ_SOURCE_LINE 00003153 ""
NSQ_SOURCE_LINE 00003154 "#### Method: https"
NSQ_SOURCE_LINE 00003155 "# Return the value of HTTPS, or"
NSQ_SOURCE_LINE 00003156 "# the value of an HTTPS variable, or"
NSQ_SOURCE_LINE 00003157 "# the list of variables"
NSQ_SOURCE_LINE 00003158 "####"
NSQ_SOURCE_LINE 00003159 "sub https {"
NSQ_SOURCE_LINE 00003160 "    my ($self,$parameter) = self_or_CGI(@_);"
NSQ_SOURCE_LINE 00003161 "    if ( defined($parameter) ) {"
NSQ_SOURCE_LINE 00003162 "        $parameter =~ tr/-a-z/_A-Z/;"
NSQ_SOURCE_LINE 00003163 "        if ( $parameter =~ /^HTTPS(?:_|$)/ ) {"
NSQ_SOURCE_LINE 00003164 "            return $ENV{$parameter};"
NSQ_SOURCE_LINE 00003165 "        }"
NSQ_SOURCE_LINE 00003166 "        return $ENV{\"HTTPS_$parameter\"};"
NSQ_SOURCE_LINE 00003167 "    }"
NSQ_SOURCE_LINE 00003168 "    return wantarray"
NSQ_SOURCE_LINE 00003169 "        ? grep { /^HTTPS(?:_|$)/ } sort keys %ENV"
NSQ_SOURCE_LINE 00003170 "        : $ENV{'HTTPS'};"
NSQ_SOURCE_LINE 00003171 "}"
NSQ_SOURCE_LINE 00003172 ""
NSQ_SOURCE_LINE 00003173 "#### Method: protocol"
NSQ_SOURCE_LINE 00003174 "# Return the protocol (http or https currently)"
NSQ_SOURCE_LINE 00003175 "####"
NSQ_SOURCE_LINE 00003176 "sub protocol {"
NSQ_SOURCE_LINE 00003177 "    local($^W)=0;"
NSQ_SOURCE_LINE 00003178 "    my $self = shift;"
NSQ_SOURCE_LINE 00003179 "    return 'https' if uc($self->https()) eq 'ON'; "
NSQ_SOURCE_LINE 00003180 "    return 'https' if $self->server_port == 443;"
NSQ_SOURCE_LINE 00003181 "    my $prot = $self->server_protocol;"
NSQ_SOURCE_LINE 00003182 "    my($protocol,$version) = split('/',$prot);"
NSQ_SOURCE_LINE 00003183 "    return \"\\L$protocol\\E\";"
NSQ_SOURCE_LINE 00003184 "}"
NSQ_SOURCE_LINE 00003185 ""
NSQ_SOURCE_LINE 00003186 "#### Method: remote_ident"
NSQ_SOURCE_LINE 00003187 "# Return the identity of the remote user"
NSQ_SOURCE_LINE 00003188 "# (but only if his host is running identd)"
NSQ_SOURCE_LINE 00003189 "####"
NSQ_SOURCE_LINE 00003190 "sub remote_ident {"
NSQ_SOURCE_LINE 00003191 "    return (defined $ENV{'REMOTE_IDENT'}) ? $ENV{'REMOTE_IDENT'} : undef;"
NSQ_SOURCE_LINE 00003192 "}"
NSQ_SOURCE_LINE 00003193 ""
NSQ_SOURCE_LINE 00003194 "#### Method: auth_type"
NSQ_SOURCE_LINE 00003195 "# Return the type of use verification/authorization in use, if any."
NSQ_SOURCE_LINE 00003196 "####"
NSQ_SOURCE_LINE 00003197 "sub auth_type {"
NSQ_SOURCE_LINE 00003198 "    return (defined $ENV{'AUTH_TYPE'}) ? $ENV{'AUTH_TYPE'} : undef;"
NSQ_SOURCE_LINE 00003199 "}"
NSQ_SOURCE_LINE 00003200 ""
NSQ_SOURCE_LINE 00003201 "#### Method: remote_user"
NSQ_SOURCE_LINE 00003202 "# Return the authorization name used for user"
NSQ_SOURCE_LINE 00003203 "# verification."
NSQ_SOURCE_LINE 00003204 "####"
NSQ_SOURCE_LINE 00003205 "sub remote_user {"
NSQ_SOURCE_LINE 00003206 "    return (defined $ENV{'REMOTE_USER'}) ? $ENV{'REMOTE_USER'} : undef;"
NSQ_SOURCE_LINE 00003207 "}"
NSQ_SOURCE_LINE 00003208 ""
NSQ_SOURCE_LINE 00003209 "#### Method: user_name"
NSQ_SOURCE_LINE 00003210 "# Try to return the remote user's name by hook or by"
NSQ_SOURCE_LINE 00003211 "# crook"
NSQ_SOURCE_LINE 00003212 "####"
NSQ_SOURCE_LINE 00003213 "sub user_name {"
NSQ_SOURCE_LINE 00003214 "    my ($self) = self_or_CGI(@_);"
NSQ_SOURCE_LINE 00003215 "    return $self->http('from') || $ENV{'REMOTE_IDENT'} || $ENV{'REMOTE_USER'};"
NSQ_SOURCE_LINE 00003216 "}"
NSQ_SOURCE_LINE 00003217 ""
NSQ_SOURCE_LINE 00003218 "#### Method: nosticky"
NSQ_SOURCE_LINE 00003219 "# Set or return the NOSTICKY global flag"
NSQ_SOURCE_LINE 00003220 "####"
NSQ_SOURCE_LINE 00003221 "sub nosticky {"
NSQ_SOURCE_LINE 00003222 "    my ($self,$param) = self_or_CGI(@_);"
NSQ_SOURCE_LINE 00003223 "    $CGI::NOSTICKY = $param if defined($param);"
NSQ_SOURCE_LINE 00003224 "    return $CGI::NOSTICKY;"
NSQ_SOURCE_LINE 00003225 "}"
NSQ_SOURCE_LINE 00003226 ""
NSQ_SOURCE_LINE 00003227 "#### Method: nph"
NSQ_SOURCE_LINE 00003228 "# Set or return the NPH global flag"
NSQ_SOURCE_LINE 00003229 "####"
NSQ_SOURCE_LINE 00003230 "sub nph {"
NSQ_SOURCE_LINE 00003231 "    my ($self,$param) = self_or_CGI(@_);"
NSQ_SOURCE_LINE 00003232 "    $CGI::NPH = $param if defined($param);"
NSQ_SOURCE_LINE 00003233 "    return $CGI::NPH;"
NSQ_SOURCE_LINE 00003234 "}"
NSQ_SOURCE_LINE 00003235 ""
NSQ_SOURCE_LINE 00003236 "#### Method: private_tempfiles"
NSQ_SOURCE_LINE 00003237 "# Set or return the private_tempfiles global flag"
NSQ_SOURCE_LINE 00003238 "####"
NSQ_SOURCE_LINE 00003239 "sub private_tempfiles {"
NSQ_SOURCE_LINE 00003240 "\twarn \"private_tempfiles has been deprecated\";"
NSQ_SOURCE_LINE 00003241 "    return 0;"
NSQ_SOURCE_LINE 00003242 "}"
NSQ_SOURCE_LINE 00003243 "#### Method: close_upload_files"
NSQ_SOURCE_LINE 00003244 "# Set or return the close_upload_files global flag"
NSQ_SOURCE_LINE 00003245 "####"
NSQ_SOURCE_LINE 00003246 "sub close_upload_files {"
NSQ_SOURCE_LINE 00003247 "    my ($self,$param) = self_or_CGI(@_);"
NSQ_SOURCE_LINE 00003248 "    $CGI::CLOSE_UPLOAD_FILES = $param if defined($param);"
NSQ_SOURCE_LINE 00003249 "    return $CGI::CLOSE_UPLOAD_FILES;"
NSQ_SOURCE_LINE 00003250 "}"
NSQ_SOURCE_LINE 00003251 ""
NSQ_SOURCE_LINE 00003252 "#### Method: default_dtd"
NSQ_SOURCE_LINE 00003253 "# Set or return the default_dtd global"
NSQ_SOURCE_LINE 00003254 "####"
NSQ_SOURCE_LINE 00003255 "sub default_dtd {"
NSQ_SOURCE_LINE 00003256 "    my ($self,$param,$param2) = self_or_CGI(@_);"
NSQ_SOURCE_LINE 00003257 "    if (defined $param2 && defined $param) {"
NSQ_SOURCE_LINE 00003258 "        $CGI::DEFAULT_DTD = [ $param, $param2 ];"
NSQ_SOURCE_LINE 00003259 "    } elsif (defined $param) {"
NSQ_SOURCE_LINE 00003260 "        $CGI::DEFAULT_DTD = $param;"
NSQ_SOURCE_LINE 00003261 "    }"
NSQ_SOURCE_LINE 00003262 "    return $CGI::DEFAULT_DTD;"
NSQ_SOURCE_LINE 00003263 "}"
NSQ_SOURCE_LINE 00003264 ""
NSQ_SOURCE_LINE 00003265 "# -------------- really private subroutines -----------------"
NSQ_SOURCE_LINE 00003266 "sub _maybe_escapeHTML {"
NSQ_SOURCE_LINE 00003267 "    # hack to work around  earlier hacks"
NSQ_SOURCE_LINE 00003268 "    push @_,$_[0] if @_==1 && $_[0] eq 'CGI';"
NSQ_SOURCE_LINE 00003269 "    my ($self,$toencode,$newlinestoo) = CGI::self_or_default(@_);"
NSQ_SOURCE_LINE 00003270 "    return undef unless defined($toencode);"
NSQ_SOURCE_LINE 00003271 "    return $toencode if ref($self) && !$self->{'escape'};"
NSQ_SOURCE_LINE 00003272 "    return $self->escapeHTML($toencode, $newlinestoo);"
NSQ_SOURCE_LINE 00003273 "}"
NSQ_SOURCE_LINE 00003274 ""
NSQ_SOURCE_LINE 00003275 "sub previous_or_default {"
NSQ_SOURCE_LINE 00003276 "    my($self,$name,$defaults,$override) = @_;"
NSQ_SOURCE_LINE 00003277 "    my(%selected);"
NSQ_SOURCE_LINE 00003278 ""
NSQ_SOURCE_LINE 00003279 "    if (!$override && ($self->{'.fieldnames'}->{$name} || "
NSQ_SOURCE_LINE 00003280 "\t\t       defined($self->param($name)) ) ) {"
NSQ_SOURCE_LINE 00003281 "\t$selected{$_}++ for $self->param($name);"
NSQ_SOURCE_LINE 00003282 "    } elsif (defined($defaults) && ref($defaults) && "
NSQ_SOURCE_LINE 00003283 "\t     (ref($defaults) eq 'ARRAY')) {"
NSQ_SOURCE_LINE 00003284 "\t$selected{$_}++ for @{$defaults};"
NSQ_SOURCE_LINE 00003285 "    } else {"
NSQ_SOURCE_LINE 00003286 "\t$selected{$defaults}++ if defined($defaults);"
NSQ_SOURCE_LINE 00003287 "    }"
NSQ_SOURCE_LINE 00003288 ""
NSQ_SOURCE_LINE 00003289 "    return %selected;"
NSQ_SOURCE_LINE 00003290 "}"
NSQ_SOURCE_LINE 00003291 ""
NSQ_SOURCE_LINE 00003292 "sub register_parameter {"
NSQ_SOURCE_LINE 00003293 "    my($self,$param) = @_;"
NSQ_SOURCE_LINE 00003294 "    $self->{'.parametersToAdd'}->{$param}++;"
