NSQ_SOURCE_LINE 00000800 "sub save_request {"
NSQ_SOURCE_LINE 00000801 "    my($self) = @_;"
NSQ_SOURCE_LINE 00000802 "    # We're going to play with the package globals now so that if we get called"
NSQ_SOURCE_LINE 00000803 "    # again, we initialize ourselves in exactly the same way.  This allows"
NSQ_SOURCE_LINE 00000804 "    # us to have several of these objects."
NSQ_SOURCE_LINE 00000805 "    @QUERY_PARAM = $self->param; # save list of parameters"
NSQ_SOURCE_LINE 00000806 "    for (@QUERY_PARAM) {"
NSQ_SOURCE_LINE 00000807 "      next unless defined $_;"
NSQ_SOURCE_LINE 00000808 "      $QUERY_PARAM{$_}=$self->{param}{$_};"
NSQ_SOURCE_LINE 00000809 "    }"
NSQ_SOURCE_LINE 00000810 "    $QUERY_CHARSET = $self->charset;"
NSQ_SOURCE_LINE 00000811 "    %QUERY_FIELDNAMES = %{$self->{'.fieldnames'}};"
NSQ_SOURCE_LINE 00000812 "    %QUERY_TMPFILES   = %{ $self->{'.tmpfiles'} || {} };"
NSQ_SOURCE_LINE 00000813 "}"
NSQ_SOURCE_LINE 00000814 ""
NSQ_SOURCE_LINE 00000815 "sub parse_params {"
NSQ_SOURCE_LINE 00000816 "    my($self,$tosplit) = @_;"
NSQ_SOURCE_LINE 00000817 "    my(@pairs) = split(/[&;]/,$tosplit);"
NSQ_SOURCE_LINE 00000818 "    my($param,$value);"
NSQ_SOURCE_LINE 00000819 "    for (@pairs) {"
NSQ_SOURCE_LINE 00000820 "\t($param,$value) = split('=',$_,2);"
NSQ_SOURCE_LINE 00000821 "\tnext unless defined $param;"
NSQ_SOURCE_LINE 00000822 "\tnext if $NO_UNDEF_PARAMS and not defined $value;"
NSQ_SOURCE_LINE 00000823 "\t$value = '' unless defined $value;"
NSQ_SOURCE_LINE 00000824 "\t$param = unescape($param);"
NSQ_SOURCE_LINE 00000825 "\t$value = unescape($value);"
NSQ_SOURCE_LINE 00000826 "\t$self->add_parameter($param);"
NSQ_SOURCE_LINE 00000827 "\tpush (@{$self->{param}{$param}},$value);"
NSQ_SOURCE_LINE 00000828 "    }"
NSQ_SOURCE_LINE 00000829 "}"
NSQ_SOURCE_LINE 00000830 ""
NSQ_SOURCE_LINE 00000831 "sub add_parameter {"
NSQ_SOURCE_LINE 00000832 "    my($self,$param)=@_;"
NSQ_SOURCE_LINE 00000833 "    return unless defined $param;"
NSQ_SOURCE_LINE 00000834 "    push (@{$self->{'.parameters'}},$param) "
NSQ_SOURCE_LINE 00000835 "\tunless defined($self->{param}{$param});"
NSQ_SOURCE_LINE 00000836 "}"
NSQ_SOURCE_LINE 00000837 ""
NSQ_SOURCE_LINE 00000838 "sub all_parameters {"
NSQ_SOURCE_LINE 00000839 "    my $self = shift;"
NSQ_SOURCE_LINE 00000840 "    return () unless defined($self) && $self->{'.parameters'};"
NSQ_SOURCE_LINE 00000841 "    return () unless @{$self->{'.parameters'}};"
NSQ_SOURCE_LINE 00000842 "    return @{$self->{'.parameters'}};"
NSQ_SOURCE_LINE 00000843 "}"
NSQ_SOURCE_LINE 00000844 ""
