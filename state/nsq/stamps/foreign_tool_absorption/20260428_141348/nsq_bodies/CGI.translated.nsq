NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "$CGI::VERSION='4.71';"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "use CGI::Util qw(rearrange rearrange_header make_attributes unescape escape expires ebcdic2ascii ascii2ebcdic);"
NSQ_SOURCE_LINE 00000014 ""
