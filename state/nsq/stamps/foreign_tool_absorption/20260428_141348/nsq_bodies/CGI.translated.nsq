NSQ_SOURCE_LINE 00000846 "sub binmode {"
NSQ_SOURCE_LINE 00000847 "    return unless defined($_[1]) && ref ($_[1]) && defined fileno($_[1]);"
NSQ_SOURCE_LINE 00000848 "    CORE::binmode($_[1]);"
NSQ_SOURCE_LINE 00000849 "}"
