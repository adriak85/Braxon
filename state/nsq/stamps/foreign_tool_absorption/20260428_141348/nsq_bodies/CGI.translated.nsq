NSQ_SOURCE_LINE 00000909 "    } elsif ($tagname=~/end_(\\w+)/i) {"
NSQ_SOURCE_LINE 00000910 "\t\treturn \"</$1>\";"
NSQ_SOURCE_LINE 00000911 "    } else {"
NSQ_SOURCE_LINE 00000912 "\t    return $XHTML ? \"<$tagname$attr />\" : \"<$tagname$attr>\" unless @rest;"
NSQ_SOURCE_LINE 00000913 "\t    my($tag,$untag) = (\"<$tagname$attr>\",\"</$tagname>\");"
NSQ_SOURCE_LINE 00000914 "\t    my @result = map { \"$tag$_$untag\" } "
NSQ_SOURCE_LINE 00000915 "                              (ref($rest[0]) eq 'ARRAY') ? @{$rest[0]} : \"@rest\";"
NSQ_SOURCE_LINE 00000916 "\t    return \"@result\";"
NSQ_SOURCE_LINE 00000917 "    }"
