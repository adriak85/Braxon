NSQ_SOURCE_LINE 00001262 "sub STORE {"
NSQ_SOURCE_LINE 00001263 "    my $self = shift;"
NSQ_SOURCE_LINE 00001264 "    my $tag  = shift;"
NSQ_SOURCE_LINE 00001265 "    my $vals = shift;"
NSQ_SOURCE_LINE 00001266 "    my @vals = defined($vals) && index($vals,\"\\0\")!=-1 ? split(\"\\0\",$vals) : $vals;"
NSQ_SOURCE_LINE 00001267 "    $self->param(-name=>$tag,-value=>\\@vals);"
NSQ_SOURCE_LINE 00001268 "}"
