NSQ_SOURCE_LINE 00000113 "# ------------------ START OF THE LIBRARY ------------"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "# make mod_perlhappy"
NSQ_SOURCE_LINE 00000116 "initialize_globals();"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "# FIGURE OUT THE OS WE'RE RUNNING UNDER"
NSQ_SOURCE_LINE 00000119 "# Some systems support the $^O variable.  If not"
NSQ_SOURCE_LINE 00000120 "# available then require() the Config library"
NSQ_SOURCE_LINE 00000121 "unless ($OS) {"
NSQ_SOURCE_LINE 00000122 "    unless ($OS = $^O) {"
NSQ_SOURCE_LINE 00000123 "\trequire Config;"
NSQ_SOURCE_LINE 00000124 "\t$OS = $Config::Config{'osname'};"
NSQ_SOURCE_LINE 00000125 "    }"
NSQ_SOURCE_LINE 00000126 "}"
NSQ_SOURCE_LINE 00000127 "if ($OS =~ /^MSWin/i) {"
NSQ_SOURCE_LINE 00000128 "  $OS = 'WINDOWS';"
NSQ_SOURCE_LINE 00000129 "} elsif ($OS =~ /^VMS/i) {"
NSQ_SOURCE_LINE 00000130 "  $OS = 'VMS';"
NSQ_SOURCE_LINE 00000131 "} elsif ($OS =~ /^dos/i) {"
NSQ_SOURCE_LINE 00000132 "  $OS = 'DOS';"
NSQ_SOURCE_LINE 00000133 "} elsif ($OS =~ /^MacOS/i) {"
NSQ_SOURCE_LINE 00000134 "    $OS = 'MACINTOSH';"
NSQ_SOURCE_LINE 00000135 "} elsif ($OS =~ /^os2/i) {"
NSQ_SOURCE_LINE 00000136 "    $OS = 'OS2';"
NSQ_SOURCE_LINE 00000137 "} elsif ($OS =~ /^epoc/i) {"
NSQ_SOURCE_LINE 00000138 "    $OS = 'EPOC';"
NSQ_SOURCE_LINE 00000139 "} elsif ($OS =~ /^cygwin/i) {"
NSQ_SOURCE_LINE 00000140 "    $OS = 'CYGWIN';"
NSQ_SOURCE_LINE 00000141 "} elsif ($OS =~ /^NetWare/i) {"
NSQ_SOURCE_LINE 00000142 "    $OS = 'NETWARE';"
NSQ_SOURCE_LINE 00000143 "} else {"
NSQ_SOURCE_LINE 00000144 "    $OS = 'UNIX';"
NSQ_SOURCE_LINE 00000145 "}"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "# Some OS logic.  Binary mode enabled on DOS, NT and VMS"
NSQ_SOURCE_LINE 00000148 "$needs_binmode = $OS=~/^(WINDOWS|DOS|OS2|MSWin|CYGWIN|NETWARE)/;"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "# This is the default class for the CGI object to use when all else fails."
NSQ_SOURCE_LINE 00000151 "$DefaultClass = 'CGI' unless defined $CGI::DefaultClass;"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "# The path separator is a slash, backslash or semicolon, depending"
NSQ_SOURCE_LINE 00000154 "# on the platform."
NSQ_SOURCE_LINE 00000155 "$SL = {"
NSQ_SOURCE_LINE 00000156 "     UNIX    => '/',  OS2 => '\\\\', EPOC      => '/', CYGWIN => '/', NETWARE => '/',"
NSQ_SOURCE_LINE 00000157 "     WINDOWS => '\\\\', DOS => '\\\\', MACINTOSH => ':', VMS    => '/'"
NSQ_SOURCE_LINE 00000158 "    }->{$OS};"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "# This no longer seems to be necessary"
NSQ_SOURCE_LINE 00000161 "# Turn on NPH scripts by default when running under IIS server!"
NSQ_SOURCE_LINE 00000162 "# $NPH++ if defined($ENV{'SERVER_SOFTWARE'}) && $ENV{'SERVER_SOFTWARE'}=~/IIS/;"
NSQ_SOURCE_LINE 00000163 "$IIS++ if defined($ENV{'SERVER_SOFTWARE'}) && $ENV{'SERVER_SOFTWARE'}=~/IIS/;"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "# Turn on special checking for ActiveState's PerlEx"
NSQ_SOURCE_LINE 00000166 "$PERLEX++ if defined($ENV{'GATEWAY_INTERFACE'}) && $ENV{'GATEWAY_INTERFACE'} =~ /^CGI-PerlEx/;"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "# Turn on special checking for Doug MacEachern's modperl"
NSQ_SOURCE_LINE 00000169 "# PerlEx::DBI tries to fool DBI by setting MOD_PERL"
NSQ_SOURCE_LINE 00000170 "if (exists $ENV{MOD_PERL} && ! $PERLEX) {"
NSQ_SOURCE_LINE 00000171 "  # mod_perl handlers may run system() on scripts using CGI.pm;"
NSQ_SOURCE_LINE 00000172 "  # Make sure so we don't get fooled by inherited $ENV{MOD_PERL}"
NSQ_SOURCE_LINE 00000173 "  if (exists $ENV{MOD_PERL_API_VERSION} && $ENV{MOD_PERL_API_VERSION} == 2) {"
NSQ_SOURCE_LINE 00000174 "    $MOD_PERL = 2;"
NSQ_SOURCE_LINE 00000175 "    require Apache2::Response;"
NSQ_SOURCE_LINE 00000176 "    require Apache2::RequestRec;"
NSQ_SOURCE_LINE 00000177 "    require Apache2::RequestUtil;"
NSQ_SOURCE_LINE 00000178 "    require Apache2::RequestIO;"
NSQ_SOURCE_LINE 00000179 "    require APR::Pool;"
NSQ_SOURCE_LINE 00000180 "  } else {"
NSQ_SOURCE_LINE 00000181 "    $MOD_PERL = 1;"
NSQ_SOURCE_LINE 00000182 "    require Apache;"
NSQ_SOURCE_LINE 00000183 "  }"
NSQ_SOURCE_LINE 00000184 "}"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "# Define the CRLF sequence.  I can't use a simple \"\\r\\n\" because the meaning"
NSQ_SOURCE_LINE 00000187 "# of \"\\n\" is different on different OS's (sometimes it generates CRLF, sometimes LF"
NSQ_SOURCE_LINE 00000188 "# and sometimes CR).  The most popular VMS web server"
NSQ_SOURCE_LINE 00000189 "# doesn't accept CRLF -- instead it wants a LR.  EBCDIC machines don't"
NSQ_SOURCE_LINE 00000190 "# use ASCII, so \\015\\012 means something different.  I find this all "
NSQ_SOURCE_LINE 00000191 "# really annoying."
NSQ_SOURCE_LINE 00000192 "$EBCDIC = \"\\t\" ne \"\\011\";"
NSQ_SOURCE_LINE 00000193 "if ($OS eq 'VMS') {"
NSQ_SOURCE_LINE 00000194 "  $CRLF = \"\\n\";"
NSQ_SOURCE_LINE 00000195 "} elsif ($EBCDIC) {"
NSQ_SOURCE_LINE 00000196 "  $CRLF= \"\\r\\n\";"
NSQ_SOURCE_LINE 00000197 "} else {"
NSQ_SOURCE_LINE 00000198 "  $CRLF = \"\\015\\012\";"
NSQ_SOURCE_LINE 00000199 "}"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "_set_binmode() if ($needs_binmode);"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "sub _set_binmode {"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "\t# rt #57524 - don't set binmode on filehandles if there are"
NSQ_SOURCE_LINE 00000206 "\t# already none default layers set on them"
NSQ_SOURCE_LINE 00000207 "\tmy %default_layers = ("
NSQ_SOURCE_LINE 00000208 "\t\tunix   => 1,"
NSQ_SOURCE_LINE 00000209 "\t\tperlio => 1,"
NSQ_SOURCE_LINE 00000210 "\t\tstdio  => 1,"
NSQ_SOURCE_LINE 00000211 "\t\tcrlf   => 1,"
NSQ_SOURCE_LINE 00000212 "\t);"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "\tforeach my $fh ("
NSQ_SOURCE_LINE 00000215 "\t\t\\*main::STDOUT,"
NSQ_SOURCE_LINE 00000216 "\t\t\\*main::STDIN,"
NSQ_SOURCE_LINE 00000217 "\t\t\\*main::STDERR,"
NSQ_SOURCE_LINE 00000218 "\t) {"
NSQ_SOURCE_LINE 00000219 "\t\tmy @modes = grep { ! $default_layers{$_} }"
NSQ_SOURCE_LINE 00000220 "\t\t\tPerlIO::get_layers( $fh );"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "\t\tif ( ! @modes ) {"
NSQ_SOURCE_LINE 00000223 "\t\t\t$CGI::DefaultClass->binmode( $fh );"
NSQ_SOURCE_LINE 00000224 "\t\t}"
NSQ_SOURCE_LINE 00000225 "\t}"
NSQ_SOURCE_LINE 00000226 "}"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "%EXPORT_TAGS = ("
NSQ_SOURCE_LINE 00000229 "\t':html2' => [ 'h1' .. 'h6', qw/"
NSQ_SOURCE_LINE 00000230 "\t\tp br hr ol ul li dl dt dd menu code var strong em"
NSQ_SOURCE_LINE 00000231 "\t\ttt u i b blockquote pre img a address cite samp dfn html head"
NSQ_SOURCE_LINE 00000232 "\t\tbase body Link nextid title meta kbd start_html end_html"
NSQ_SOURCE_LINE 00000233 "\t\tinput Select option comment charset escapeHTML"
NSQ_SOURCE_LINE 00000234 "\t/ ],"
NSQ_SOURCE_LINE 00000235 "\t':html3' => [ qw/"
NSQ_SOURCE_LINE 00000236 "\t\tdiv table caption th td TR Tr sup Sub strike applet Param nobr"
NSQ_SOURCE_LINE 00000237 "\t\tembed basefont style span layer ilayer font frameset frame script small big Area Map"
NSQ_SOURCE_LINE 00000238 "\t/ ],"
NSQ_SOURCE_LINE 00000239 "\t':html4' => [ qw/"
NSQ_SOURCE_LINE 00000240 "\t\tabbr acronym bdo col colgroup del fieldset iframe"
NSQ_SOURCE_LINE 00000241 "\t\tins label legend noframes noscript object optgroup Q"
NSQ_SOURCE_LINE 00000242 "\t\tthead tbody tfoot"
NSQ_SOURCE_LINE 00000243 "\t/ ],"
NSQ_SOURCE_LINE 00000244 "\t':form'     => [ qw/"
NSQ_SOURCE_LINE 00000245 "\t\ttextfield textarea filefield password_field hidden checkbox checkbox_group"
NSQ_SOURCE_LINE 00000246 "\t\tsubmit reset defaults radio_group popup_menu button autoEscape"
NSQ_SOURCE_LINE 00000247 "\t\tscrolling_list image_button start_form end_form"
NSQ_SOURCE_LINE 00000248 "\t\tstart_multipart_form end_multipart_form isindex tmpFileName uploadInfo URL_ENCODED MULTIPART"
NSQ_SOURCE_LINE 00000249 "\t/ ],"
NSQ_SOURCE_LINE 00000250 "\t':cgi' => [ qw/"
NSQ_SOURCE_LINE 00000251 "\t\tparam multi_param upload path_info path_translated request_uri url self_url script_name"
NSQ_SOURCE_LINE 00000252 "\t\tcookie Dump raw_cookie request_method query_string Accept user_agent remote_host content_type"
NSQ_SOURCE_LINE 00000253 "\t\tremote_addr referer server_name server_software server_port server_protocol virtual_port"
NSQ_SOURCE_LINE 00000254 "\t\tvirtual_host remote_ident auth_type http append save_parameters restore_parameters param_fetch"
NSQ_SOURCE_LINE 00000255 "\t\tremote_user user_name header redirect import_names put Delete Delete_all url_param cgi_error env_query_string"
NSQ_SOURCE_LINE 00000256 "\t/ ],"
NSQ_SOURCE_LINE 00000257 "\t':netscape' => [qw/blink fontsize center/],"
NSQ_SOURCE_LINE 00000258 "\t':ssl'      => [qw/https/],"
NSQ_SOURCE_LINE 00000259 "\t':cgi-lib'  => [qw/ReadParse PrintHeader HtmlTop HtmlBot SplitParam Vars/],"
NSQ_SOURCE_LINE 00000260 "\t':push'     => [qw/multipart_init multipart_start multipart_end multipart_final/],"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "\t# bulk export/import"
NSQ_SOURCE_LINE 00000263 "\t':html'     => [qw/:html2 :html3 :html4 :netscape/],"
NSQ_SOURCE_LINE 00000264 "\t':standard' => [qw/:html2 :html3 :html4 :form :cgi :ssl/],"
NSQ_SOURCE_LINE 00000265 "\t':all'      => [qw/:html2 :html3 :html4 :netscape :form :cgi :ssl :push/]"
NSQ_SOURCE_LINE 00000266 ");"
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "# to import symbols into caller"
NSQ_SOURCE_LINE 00000269 "sub import {"
NSQ_SOURCE_LINE 00000270 "    my $self = shift;"
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "    # This causes modules to clash."
NSQ_SOURCE_LINE 00000273 "    undef %EXPORT_OK;"
NSQ_SOURCE_LINE 00000274 "    undef %EXPORT;"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "    $self->_setup_symbols(@_);"
NSQ_SOURCE_LINE 00000277 "    my ($callpack, $callfile, $callline) = caller;"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "\tif ( $callpack eq 'CGI::Fast' ) {"
NSQ_SOURCE_LINE 00000280 "\t\t# fixes GH #11 (and GH #12 in CGI::Fast since"
NSQ_SOURCE_LINE 00000281 "\t\t# sub import was added to CGI::Fast in 9537f90"
NSQ_SOURCE_LINE 00000282 "\t\t# so we need to move up a level to export the"
NSQ_SOURCE_LINE 00000283 "\t\t# routines to the namespace of whatever is using"
NSQ_SOURCE_LINE 00000284 "\t\t# CGI::Fast"
NSQ_SOURCE_LINE 00000285 "\t\t($callpack, $callfile, $callline) = caller(1);"
NSQ_SOURCE_LINE 00000286 "\t}"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "    # To allow overriding, search through the packages"
NSQ_SOURCE_LINE 00000289 "    # Till we find one in which the correct subroutine is defined."
NSQ_SOURCE_LINE 00000290 "    my @packages = ($self,@{\"$self\\:\\:ISA\"});"
NSQ_SOURCE_LINE 00000291 "    for $sym (sort keys %EXPORT) {"
NSQ_SOURCE_LINE 00000292 "\tmy $pck;"
NSQ_SOURCE_LINE 00000293 "\tmy $def = $DefaultClass;"
NSQ_SOURCE_LINE 00000294 "\tfor $pck (@packages) {"
NSQ_SOURCE_LINE 00000295 "\t    if (defined(&{\"$pck\\:\\:$sym\"})) {"
NSQ_SOURCE_LINE 00000296 "\t\t$def = $pck;"
NSQ_SOURCE_LINE 00000297 "\t\tlast;"
NSQ_SOURCE_LINE 00000298 "\t    }"
NSQ_SOURCE_LINE 00000299 "\t}"
NSQ_SOURCE_LINE 00000300 "\t*{\"${callpack}::$sym\"} = \\&{\"$def\\:\\:$sym\"};"
NSQ_SOURCE_LINE 00000301 "    }"
NSQ_SOURCE_LINE 00000302 "}"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "sub expand_tags {"
NSQ_SOURCE_LINE 00000305 "    my($tag) = @_;"
NSQ_SOURCE_LINE 00000306 "    return (\"start_$1\",\"end_$1\") if $tag=~/^(?:\\*|start_|end_)(.+)/;"
NSQ_SOURCE_LINE 00000307 "    my(@r);"
NSQ_SOURCE_LINE 00000308 "    return ($tag) unless $EXPORT_TAGS{$tag};"
NSQ_SOURCE_LINE 00000309 "    for (@{$EXPORT_TAGS{$tag}}) {"
NSQ_SOURCE_LINE 00000310 "\tpush(@r,&expand_tags($_));"
NSQ_SOURCE_LINE 00000311 "    }"
NSQ_SOURCE_LINE 00000312 "    return @r;"
NSQ_SOURCE_LINE 00000313 "}"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "#### Method: new"
NSQ_SOURCE_LINE 00000316 "# The new routine.  This will check the current environment"
NSQ_SOURCE_LINE 00000317 "# for an existing query string, and initialize itself, if so."
NSQ_SOURCE_LINE 00000318 "####"
NSQ_SOURCE_LINE 00000319 "sub new {"
NSQ_SOURCE_LINE 00000320 "  my($class,@initializer) = @_;"
NSQ_SOURCE_LINE 00000321 "  my $self = {};"
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "  bless $self,ref $class || $class || $DefaultClass;"
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "  # always use a tempfile"
NSQ_SOURCE_LINE 00000326 "  $self->{'use_tempfile'} = 1;"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "  if (ref($initializer[0])"
NSQ_SOURCE_LINE 00000329 "      && (UNIVERSAL::isa($initializer[0],'Apache')"
NSQ_SOURCE_LINE 00000330 "\t  ||"
NSQ_SOURCE_LINE 00000331 "\t  UNIVERSAL::isa($initializer[0],'Apache2::RequestRec')"
NSQ_SOURCE_LINE 00000332 "\t )) {"
NSQ_SOURCE_LINE 00000333 "    $self->r(shift @initializer);"
NSQ_SOURCE_LINE 00000334 "  }"
NSQ_SOURCE_LINE 00000335 " if (ref($initializer[0]) "
NSQ_SOURCE_LINE 00000336 "     && (UNIVERSAL::isa($initializer[0],'CODE'))) {"
NSQ_SOURCE_LINE 00000337 "    $self->upload_hook(shift @initializer, shift @initializer);"
NSQ_SOURCE_LINE 00000338 "    $self->{'use_tempfile'} = shift @initializer if (@initializer > 0);"
NSQ_SOURCE_LINE 00000339 "  }"
NSQ_SOURCE_LINE 00000340 "  if ($MOD_PERL) {"
NSQ_SOURCE_LINE 00000341 "    if ($MOD_PERL == 1) {"
NSQ_SOURCE_LINE 00000342 "      $self->r(Apache->request) unless $self->r;"
NSQ_SOURCE_LINE 00000343 "      my $r = $self->r;"
NSQ_SOURCE_LINE 00000344 "      $r->register_cleanup(\\&CGI::_reset_globals);"
NSQ_SOURCE_LINE 00000345 "      $self->_setup_symbols(@SAVED_SYMBOLS) if @SAVED_SYMBOLS;"
NSQ_SOURCE_LINE 00000346 "    }"
NSQ_SOURCE_LINE 00000347 "    else {"
NSQ_SOURCE_LINE 00000348 "      # XXX: once we have the new API"
NSQ_SOURCE_LINE 00000349 "      # will do a real PerlOptions -SetupEnv check"
NSQ_SOURCE_LINE 00000350 "      $self->r(Apache2::RequestUtil->request) unless $self->r;"
NSQ_SOURCE_LINE 00000351 "      my $r = $self->r;"
NSQ_SOURCE_LINE 00000352 "      $r->subprocess_env unless exists $ENV{REQUEST_METHOD};"
NSQ_SOURCE_LINE 00000353 "      $r->pool->cleanup_register(\\&CGI::_reset_globals);"
NSQ_SOURCE_LINE 00000354 "      $self->_setup_symbols(@SAVED_SYMBOLS) if @SAVED_SYMBOLS;"
NSQ_SOURCE_LINE 00000355 "    }"
NSQ_SOURCE_LINE 00000356 "    undef $NPH;"
NSQ_SOURCE_LINE 00000357 "  }"
NSQ_SOURCE_LINE 00000358 "  $self->_reset_globals if $PERLEX;"
NSQ_SOURCE_LINE 00000359 "  $self->init(@initializer);"
NSQ_SOURCE_LINE 00000360 "  return $self;"
NSQ_SOURCE_LINE 00000361 "}"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "sub r {"
NSQ_SOURCE_LINE 00000364 "  my $self = shift;"
NSQ_SOURCE_LINE 00000365 "  my $r = $self->{'.r'};"
NSQ_SOURCE_LINE 00000366 "  $self->{'.r'} = shift if @_;"
NSQ_SOURCE_LINE 00000367 "  $r;"
NSQ_SOURCE_LINE 00000368 "}"
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "sub upload_hook {"
NSQ_SOURCE_LINE 00000371 "  my $self;"
NSQ_SOURCE_LINE 00000372 "  if (ref $_[0] eq 'CODE') {"
NSQ_SOURCE_LINE 00000373 "    $CGI::Q = $self = $CGI::DefaultClass->new(@_);"
NSQ_SOURCE_LINE 00000374 "  } else {"
NSQ_SOURCE_LINE 00000375 "    $self = shift;"
NSQ_SOURCE_LINE 00000376 "  }"
NSQ_SOURCE_LINE 00000377 "  my ($hook,$data,$use_tempfile) = @_;"
NSQ_SOURCE_LINE 00000378 "  $self->{'.upload_hook'} = $hook;"
NSQ_SOURCE_LINE 00000379 "  $self->{'.upload_data'} = $data;"
NSQ_SOURCE_LINE 00000380 "  $self->{'use_tempfile'} = $use_tempfile if defined $use_tempfile;"
NSQ_SOURCE_LINE 00000381 "}"
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "#### Method: param / multi_param"
NSQ_SOURCE_LINE 00000384 "# Returns the value(s)of a named parameter."
NSQ_SOURCE_LINE 00000385 "# If invoked in a list context, returns the"
NSQ_SOURCE_LINE 00000386 "# entire list.  Otherwise returns the first"
NSQ_SOURCE_LINE 00000387 "# member of the list."
NSQ_SOURCE_LINE 00000388 "# If name is not provided, return a list of all"
NSQ_SOURCE_LINE 00000389 "# the known parameters names available."
NSQ_SOURCE_LINE 00000390 "# If more than one argument is provided, the"
NSQ_SOURCE_LINE 00000391 "# second and subsequent arguments are used to"
NSQ_SOURCE_LINE 00000392 "# set the value of the parameter."
NSQ_SOURCE_LINE 00000393 "#"
NSQ_SOURCE_LINE 00000394 "# note that calling param() in list context"
NSQ_SOURCE_LINE 00000395 "# will raise a warning about potential bad"
NSQ_SOURCE_LINE 00000396 "# things, hence the multi_param method"
NSQ_SOURCE_LINE 00000397 "####"
NSQ_SOURCE_LINE 00000398 "sub multi_param {"
NSQ_SOURCE_LINE 00000399 "\t# we don't need to set $LIST_CONTEXT_WARN to 0 here"
NSQ_SOURCE_LINE 00000400 "\t# because param() will check the caller before warning"
NSQ_SOURCE_LINE 00000401 "\tmy @list_of_params = param( @_ );"
NSQ_SOURCE_LINE 00000402 "\treturn @list_of_params;"
NSQ_SOURCE_LINE 00000403 "}"
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "sub param {"
NSQ_SOURCE_LINE 00000406 "    my($self,@p) = self_or_default(@_);"
NSQ_SOURCE_LINE 00000407 ""
NSQ_SOURCE_LINE 00000408 "    return $self->all_parameters unless @p;"
NSQ_SOURCE_LINE 00000409 ""
NSQ_SOURCE_LINE 00000410 "\t# list context can be dangerous so warn:"
NSQ_SOURCE_LINE 00000411 "\t# http://blog.gerv.net/2014.10/new-class-of-vulnerability-in-perl-web-applications"
NSQ_SOURCE_LINE 00000412 "\tif ( wantarray && $LIST_CONTEXT_WARN == 1 ) {"
NSQ_SOURCE_LINE 00000413 "\t\tmy ( $package, $filename, $line ) = caller;"
NSQ_SOURCE_LINE 00000414 "\t\tif ( $package ne 'CGI' ) {"
NSQ_SOURCE_LINE 00000415 "\t\t\t$LIST_CONTEXT_WARN++; # only warn once"
NSQ_SOURCE_LINE 00000416 "\t\t\twarn \"CGI::param called in list context from $filename line $line, this can lead to vulnerabilities. \""
NSQ_SOURCE_LINE 00000417 "\t\t\t\t. 'See the warning in \"Fetching the value or values of a single named parameter\"';"
NSQ_SOURCE_LINE 00000418 "\t\t}"
NSQ_SOURCE_LINE 00000419 "\t}"
NSQ_SOURCE_LINE 00000420 ""
NSQ_SOURCE_LINE 00000421 "    my($name,$value,@other);"
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "    # For compatibility between old calling style and use_named_parameters() style, "
NSQ_SOURCE_LINE 00000424 "    # we have to special case for a single parameter present."
NSQ_SOURCE_LINE 00000425 "    if (@p > 1) {"
NSQ_SOURCE_LINE 00000426 "\t($name,$value,@other) = rearrange([NAME,[DEFAULT,VALUE,VALUES]],@p);"
NSQ_SOURCE_LINE 00000427 "\tmy(@values);"
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 "\tif (substr($p[0],0,1) eq '-') {"
NSQ_SOURCE_LINE 00000430 "\t    @values = defined($value) ? (ref($value) && ref($value) eq 'ARRAY' ? @{$value} : $value) : ();"
NSQ_SOURCE_LINE 00000431 "\t} else {"
NSQ_SOURCE_LINE 00000432 "\t    for ($value,@other) {"
NSQ_SOURCE_LINE 00000433 "\t\tpush(@values,$_) if defined($_);"
NSQ_SOURCE_LINE 00000434 "\t    }"
NSQ_SOURCE_LINE 00000435 "\t}"
NSQ_SOURCE_LINE 00000436 "\t# If values is provided, then we set it."
NSQ_SOURCE_LINE 00000437 "\tif (@values or defined $value) {"
NSQ_SOURCE_LINE 00000438 "\t    $self->add_parameter($name);"
NSQ_SOURCE_LINE 00000439 "\t    $self->{param}{$name}=[@values];"
NSQ_SOURCE_LINE 00000440 "\t}"
NSQ_SOURCE_LINE 00000441 "    } else {"
NSQ_SOURCE_LINE 00000442 "\t$name = $p[0];"
NSQ_SOURCE_LINE 00000443 "    }"
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "    return unless defined($name) && $self->{param}{$name};"
NSQ_SOURCE_LINE 00000446 ""
NSQ_SOURCE_LINE 00000447 "    my @result = @{$self->{param}{$name}};"
NSQ_SOURCE_LINE 00000448 ""
NSQ_SOURCE_LINE 00000449 "    if ($PARAM_UTF8 && $name ne 'PUTDATA' && $name ne 'POSTDATA' && $name ne 'PATCHDATA') {"
NSQ_SOURCE_LINE 00000450 "      eval \"require Encode; 1;\" unless Encode->can('decode'); # bring in these functions"
NSQ_SOURCE_LINE 00000451 "      @result = map {ref $_ ? $_ : $self->_decode_utf8($_) } @result;"
NSQ_SOURCE_LINE 00000452 "    }"
NSQ_SOURCE_LINE 00000453 ""
NSQ_SOURCE_LINE 00000454 "    return wantarray ?  @result : $result[0];"
NSQ_SOURCE_LINE 00000455 "}"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "sub _decode_utf8 {"
NSQ_SOURCE_LINE 00000458 "    my ($self, $val) = @_;"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "    if (Encode::is_utf8($val)) {"
NSQ_SOURCE_LINE 00000461 "        return $val;"
NSQ_SOURCE_LINE 00000462 "    }"
NSQ_SOURCE_LINE 00000463 "    else {"
NSQ_SOURCE_LINE 00000464 "        return Encode::decode(utf8 => $val);"
NSQ_SOURCE_LINE 00000465 "    }"
NSQ_SOURCE_LINE 00000466 "}"
NSQ_SOURCE_LINE 00000467 ""
NSQ_SOURCE_LINE 00000468 "sub self_or_default {"
NSQ_SOURCE_LINE 00000469 "    return @_ if defined($_[0]) && (!ref($_[0])) &&($_[0] eq 'CGI');"
NSQ_SOURCE_LINE 00000470 "    unless (defined($_[0]) && "
NSQ_SOURCE_LINE 00000471 "\t    (ref($_[0]) eq 'CGI' || UNIVERSAL::isa($_[0],'CGI')) # slightly optimized for common case"
NSQ_SOURCE_LINE 00000472 "\t    ) {"
NSQ_SOURCE_LINE 00000473 "\t$Q = $CGI::DefaultClass->new unless defined($Q);"
NSQ_SOURCE_LINE 00000474 "\tunshift(@_,$Q);"
NSQ_SOURCE_LINE 00000475 "    }"
NSQ_SOURCE_LINE 00000476 "    return wantarray ? @_ : $Q;"
NSQ_SOURCE_LINE 00000477 "}"
NSQ_SOURCE_LINE 00000478 ""
NSQ_SOURCE_LINE 00000479 "sub self_or_CGI {"
NSQ_SOURCE_LINE 00000480 "    local $^W=0;                # prevent a warning"
NSQ_SOURCE_LINE 00000481 "    if (defined($_[0]) &&"
NSQ_SOURCE_LINE 00000482 "\t(substr(ref($_[0]),0,3) eq 'CGI' "
NSQ_SOURCE_LINE 00000483 "\t || UNIVERSAL::isa($_[0],'CGI'))) {"
NSQ_SOURCE_LINE 00000484 "\treturn @_;"
NSQ_SOURCE_LINE 00000485 "    } else {"
NSQ_SOURCE_LINE 00000486 "\treturn ($DefaultClass,@_);"
NSQ_SOURCE_LINE 00000487 "    }"
NSQ_SOURCE_LINE 00000488 "}"
NSQ_SOURCE_LINE 00000489 ""
NSQ_SOURCE_LINE 00000490 "########################################"
NSQ_SOURCE_LINE 00000491 "# THESE METHODS ARE MORE OR LESS PRIVATE"
NSQ_SOURCE_LINE 00000492 "# GO TO THE __DATA__ SECTION TO SEE MORE"
NSQ_SOURCE_LINE 00000493 "# PUBLIC METHODS"
NSQ_SOURCE_LINE 00000494 "########################################"
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "# Initialize the query object from the environment."
NSQ_SOURCE_LINE 00000497 "# If a parameter list is found, this object will be set"
NSQ_SOURCE_LINE 00000498 "# to a hash in which parameter names are keys"
NSQ_SOURCE_LINE 00000499 "# and the values are stored as lists"
NSQ_SOURCE_LINE 00000500 "# If a keyword list is found, this method creates a bogus"
NSQ_SOURCE_LINE 00000501 "# parameter list with the single parameter 'keywords'."
NSQ_SOURCE_LINE 00000502 ""
NSQ_SOURCE_LINE 00000503 "sub init {"
NSQ_SOURCE_LINE 00000504 "  my $self = shift;"
NSQ_SOURCE_LINE 00000505 "  my($query_string,$meth,$content_length,$fh,@lines) = ('','','','');"
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "  my $is_xforms;"
NSQ_SOURCE_LINE 00000508 ""
NSQ_SOURCE_LINE 00000509 "  my $initializer = shift;  # for backward compatibility"
NSQ_SOURCE_LINE 00000510 "  local($/) = \"\\n\";"
NSQ_SOURCE_LINE 00000511 ""
NSQ_SOURCE_LINE 00000512 "    # set autoescaping on by default"
NSQ_SOURCE_LINE 00000513 "    $self->{'escape'} = 1;"
NSQ_SOURCE_LINE 00000514 ""
NSQ_SOURCE_LINE 00000515 "    # if we get called more than once, we want to initialize"
NSQ_SOURCE_LINE 00000516 "    # ourselves from the original query (which may be gone"
NSQ_SOURCE_LINE 00000517 "    # if it was read from STDIN originally.)"
NSQ_SOURCE_LINE 00000518 "    if (@QUERY_PARAM && !defined($initializer)) {"
NSQ_SOURCE_LINE 00000519 "        for my $name (@QUERY_PARAM) {"
NSQ_SOURCE_LINE 00000520 "            my $val = $QUERY_PARAM{$name}; # always an arrayref;"
NSQ_SOURCE_LINE 00000521 "            $self->param('-name'=>$name,'-value'=> $val);"
NSQ_SOURCE_LINE 00000522 "            if (defined $val and ref $val eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000523 "                for my $fh (grep {defined($_) && ref($_) && defined(fileno($_))} @$val) {"
NSQ_SOURCE_LINE 00000524 "                   seek($fh,0,0); # reset the filehandle.  "
NSQ_SOURCE_LINE 00000525 "                }"
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 "            }"
NSQ_SOURCE_LINE 00000528 "        }"
NSQ_SOURCE_LINE 00000529 "        $self->charset($QUERY_CHARSET);"
NSQ_SOURCE_LINE 00000530 "        $self->{'.fieldnames'} = {%QUERY_FIELDNAMES};"
NSQ_SOURCE_LINE 00000531 "        $self->{'.tmpfiles'}   = {%QUERY_TMPFILES};"
NSQ_SOURCE_LINE 00000532 "        return;"
NSQ_SOURCE_LINE 00000533 "    }"
NSQ_SOURCE_LINE 00000534 ""
NSQ_SOURCE_LINE 00000535 "    $meth=$ENV{'REQUEST_METHOD'} if defined($ENV{'REQUEST_METHOD'});"
NSQ_SOURCE_LINE 00000536 "    $content_length = defined($ENV{'CONTENT_LENGTH'}) ? $ENV{'CONTENT_LENGTH'} : 0;"
NSQ_SOURCE_LINE 00000537 ""
NSQ_SOURCE_LINE 00000538 "    $fh = to_filehandle($initializer) if $initializer;"
NSQ_SOURCE_LINE 00000539 ""
NSQ_SOURCE_LINE 00000540 "    # set charset to the safe ISO-8859-1"
NSQ_SOURCE_LINE 00000541 "    $self->charset('ISO-8859-1');"
NSQ_SOURCE_LINE 00000542 ""
NSQ_SOURCE_LINE 00000543 "  METHOD: {"
NSQ_SOURCE_LINE 00000544 ""
NSQ_SOURCE_LINE 00000545 "      # avoid unreasonably large postings"
NSQ_SOURCE_LINE 00000546 "      if (($POST_MAX > 0) && ($content_length > $POST_MAX)) {"
NSQ_SOURCE_LINE 00000547 "\t#discard the post, unread"
NSQ_SOURCE_LINE 00000548 "\t$self->cgi_error(\"413 Request entity too large\");"
NSQ_SOURCE_LINE 00000549 "\tlast METHOD;"
NSQ_SOURCE_LINE 00000550 "      }"
NSQ_SOURCE_LINE 00000551 ""
NSQ_SOURCE_LINE 00000552 "      # Process multipart postings, but only if the initializer is"
NSQ_SOURCE_LINE 00000553 "      # not defined."
NSQ_SOURCE_LINE 00000554 "      if ($meth eq 'POST'"
NSQ_SOURCE_LINE 00000555 "\t  && defined($ENV{'CONTENT_TYPE'})"
NSQ_SOURCE_LINE 00000556 "\t  && $ENV{'CONTENT_TYPE'}=~m|^multipart/form-data|"
NSQ_SOURCE_LINE 00000557 "\t  && !defined($initializer)"
NSQ_SOURCE_LINE 00000558 "\t  ) {"
NSQ_SOURCE_LINE 00000559 "\t  my($boundary) = $ENV{'CONTENT_TYPE'} =~ /boundary=\\\"?([^\\\";,]+)\\\"?/;"
NSQ_SOURCE_LINE 00000560 "\t  $self->read_multipart($boundary,$content_length);"
NSQ_SOURCE_LINE 00000561 "\t  if ($APPEND_QUERY_STRING) {"
NSQ_SOURCE_LINE 00000562 "\t    # Some people want to have their cake and eat it too!"
NSQ_SOURCE_LINE 00000563 "\t    # Set $APPEND_QUERY_STRING = 1 to have the contents of the query string"
NSQ_SOURCE_LINE 00000564 "\t    # APPENDED to the POST data."
NSQ_SOURCE_LINE 00000565 "\t    $query_string .= (length($query_string) ? '&' : '') . $ENV{'QUERY_STRING'} if defined $ENV{'QUERY_STRING'};"
NSQ_SOURCE_LINE 00000566 "\t  }"
NSQ_SOURCE_LINE 00000567 "\t  last METHOD;"
NSQ_SOURCE_LINE 00000568 "      } "
NSQ_SOURCE_LINE 00000569 ""
NSQ_SOURCE_LINE 00000570 "      # Process XForms postings. We know that we have XForms in the"
NSQ_SOURCE_LINE 00000571 "      # following cases:"
NSQ_SOURCE_LINE 00000572 "      # method eq 'POST' && content-type eq 'application/xml'"
NSQ_SOURCE_LINE 00000573 "      # method eq 'POST' && content-type =~ /multipart\\/related.+start=/"
NSQ_SOURCE_LINE 00000574 "      # There are more cases, actually, but for now, we don't support other"
NSQ_SOURCE_LINE 00000575 "      # methods for XForm posts."
NSQ_SOURCE_LINE 00000576 "      # In a XForm POST, the QUERY_STRING is parsed normally."
NSQ_SOURCE_LINE 00000577 "      # If the content-type is 'application/xml', we just set the param"
NSQ_SOURCE_LINE 00000578 "      # XForms:Model (referring to the xml syntax) param containing the"
NSQ_SOURCE_LINE 00000579 "      # unparsed XML data."
NSQ_SOURCE_LINE 00000580 "      # In the case of multipart/related we set XForms:Model as above, but"
NSQ_SOURCE_LINE 00000581 "      # the other parts are available as uploads with the Content-ID as the"
NSQ_SOURCE_LINE 00000582 "      # the key."
NSQ_SOURCE_LINE 00000583 "      # See the URL below for XForms specs on this issue."
NSQ_SOURCE_LINE 00000584 "      # http://www.w3.org/TR/2006/REC-xforms-20060314/slice11.html#submit-options"
NSQ_SOURCE_LINE 00000585 "      if ($meth eq 'POST' && defined($ENV{'CONTENT_TYPE'})) {"
NSQ_SOURCE_LINE 00000586 "              if ($ENV{'CONTENT_TYPE'} eq 'application/xml') {"
NSQ_SOURCE_LINE 00000587 "                      my($param) = 'XForms:Model';"
NSQ_SOURCE_LINE 00000588 "                      my($value) = '';"
NSQ_SOURCE_LINE 00000589 "                      $self->add_parameter($param);"
NSQ_SOURCE_LINE 00000590 "                      $self->read_from_client(\\$value,$content_length,0)"
NSQ_SOURCE_LINE 00000591 "                        if $content_length > 0;"
NSQ_SOURCE_LINE 00000592 "                      push (@{$self->{param}{$param}},$value);"
NSQ_SOURCE_LINE 00000593 "                      $is_xforms = 1;"
NSQ_SOURCE_LINE 00000594 "              } elsif ($ENV{'CONTENT_TYPE'} =~ /multipart\\/related.+boundary=\\\"?([^\\\";,]+)\\\"?.+start=\\\"?\\<?([^\\\"\\>]+)\\>?\\\"?/) {"
NSQ_SOURCE_LINE 00000595 "                      my($boundary,$start) = ($1,$2);"
NSQ_SOURCE_LINE 00000596 "                      my($param) = 'XForms:Model';"
NSQ_SOURCE_LINE 00000597 "                      $self->add_parameter($param);"
NSQ_SOURCE_LINE 00000598 "                      my($value) = $self->read_multipart_related($start,$boundary,$content_length,0);"
NSQ_SOURCE_LINE 00000599 "                      push (@{$self->{param}{$param}},$value);"
NSQ_SOURCE_LINE 00000600 "\t\t\t\t\t  $query_string = $self->_get_query_string_from_env;"
NSQ_SOURCE_LINE 00000601 "                      $is_xforms = 1;"
NSQ_SOURCE_LINE 00000602 "              }"
NSQ_SOURCE_LINE 00000603 "      }"
NSQ_SOURCE_LINE 00000604 ""
NSQ_SOURCE_LINE 00000605 ""
NSQ_SOURCE_LINE 00000606 "      # If initializer is defined, then read parameters"
NSQ_SOURCE_LINE 00000607 "      # from it."
NSQ_SOURCE_LINE 00000608 "      if (!$is_xforms && defined($initializer)) {"
NSQ_SOURCE_LINE 00000609 "\t  if (UNIVERSAL::isa($initializer,'CGI')) {"
NSQ_SOURCE_LINE 00000610 "\t      $query_string = $initializer->query_string;"
NSQ_SOURCE_LINE 00000611 "\t      last METHOD;"
NSQ_SOURCE_LINE 00000612 "\t  }"
NSQ_SOURCE_LINE 00000613 "\t  if (ref($initializer) && ref($initializer) eq 'HASH') {"
NSQ_SOURCE_LINE 00000614 "\t      for (sort keys %$initializer) {"
NSQ_SOURCE_LINE 00000615 "\t\t  $self->param('-name'=>$_,'-value'=>$initializer->{$_});"
NSQ_SOURCE_LINE 00000616 "\t      }"
NSQ_SOURCE_LINE 00000617 "\t      last METHOD;"
NSQ_SOURCE_LINE 00000618 "\t  }"
NSQ_SOURCE_LINE 00000619 ""
NSQ_SOURCE_LINE 00000620 "          if (defined($fh) && ($fh ne '')) {"
NSQ_SOURCE_LINE 00000621 "              while (my $line = <$fh>) {"
NSQ_SOURCE_LINE 00000622 "                  chomp $line;"
NSQ_SOURCE_LINE 00000623 "                  last if $line =~ /^=$/;"
NSQ_SOURCE_LINE 00000624 "                  push(@lines,$line);"
NSQ_SOURCE_LINE 00000625 "              }"
NSQ_SOURCE_LINE 00000626 "              # massage back into standard format"
NSQ_SOURCE_LINE 00000627 "              if (\"@lines\" =~ /=/) {"
NSQ_SOURCE_LINE 00000628 "                  $query_string=join(\"&\",@lines);"
NSQ_SOURCE_LINE 00000629 "              } else {"
NSQ_SOURCE_LINE 00000630 "                  $query_string=join(\"+\",@lines);"
NSQ_SOURCE_LINE 00000631 "              }"
NSQ_SOURCE_LINE 00000632 "              last METHOD;"
NSQ_SOURCE_LINE 00000633 "          }"
NSQ_SOURCE_LINE 00000634 ""
NSQ_SOURCE_LINE 00000635 "\t  # last chance -- treat it as a string"
NSQ_SOURCE_LINE 00000636 "\t  $initializer = $$initializer if ref($initializer) eq 'SCALAR';"
NSQ_SOURCE_LINE 00000637 "\t  $query_string = $initializer;"
NSQ_SOURCE_LINE 00000638 ""
NSQ_SOURCE_LINE 00000639 "\t  last METHOD;"
NSQ_SOURCE_LINE 00000640 "      }"
NSQ_SOURCE_LINE 00000641 ""
NSQ_SOURCE_LINE 00000642 "      # If method is GET, HEAD or DELETE, fetch the query from"
NSQ_SOURCE_LINE 00000643 "      # the environment."
NSQ_SOURCE_LINE 00000644 "      if ($is_xforms || $meth=~/^(GET|HEAD|DELETE)$/) {"
NSQ_SOURCE_LINE 00000645 "          $query_string = $self->_get_query_string_from_env;"
NSQ_SOURCE_LINE 00000646 "         $self->param($meth . 'DATA', $self->param('XForms:Model'))"
NSQ_SOURCE_LINE 00000647 "             if $is_xforms;"
NSQ_SOURCE_LINE 00000648 "\t      last METHOD;"
NSQ_SOURCE_LINE 00000649 "      }"
NSQ_SOURCE_LINE 00000650 ""
NSQ_SOURCE_LINE 00000651 "      if ($meth eq 'POST' || $meth eq 'PUT' || $meth eq 'PATCH') {"
NSQ_SOURCE_LINE 00000652 "\t  if ( $content_length > 0 ) {"
NSQ_SOURCE_LINE 00000653 "        if ( ( $PUTDATA_UPLOAD || $self->{'.upload_hook'} ) && !$is_xforms && ($meth eq 'POST' || $meth eq 'PUT' || $meth eq 'PATCH')"
NSQ_SOURCE_LINE 00000654 "            && defined($ENV{'CONTENT_TYPE'})"
NSQ_SOURCE_LINE 00000655 "            && $ENV{'CONTENT_TYPE'} !~ m|^application/x-www-form-urlencoded|"
NSQ_SOURCE_LINE 00000656 "        && $ENV{'CONTENT_TYPE'} !~ m|^multipart/form-data| ){"
NSQ_SOURCE_LINE 00000657 "            my $postOrPut = $meth . 'DATA' ; # POSTDATA/PUTDATA"
NSQ_SOURCE_LINE 00000658 "            $self->read_postdata_putdata( $postOrPut, $content_length, $ENV{'CONTENT_TYPE'}  );"
NSQ_SOURCE_LINE 00000659 "            $meth = ''; # to skip xform testing"
NSQ_SOURCE_LINE 00000660 "            undef $query_string ;"
NSQ_SOURCE_LINE 00000661 "        } else {"
NSQ_SOURCE_LINE 00000662 "            $self->read_from_client(\\$query_string,$content_length,0);"
NSQ_SOURCE_LINE 00000663 "        }"
NSQ_SOURCE_LINE 00000664 "\t  }"
NSQ_SOURCE_LINE 00000665 "\t  if ($APPEND_QUERY_STRING) {"
NSQ_SOURCE_LINE 00000666 "\t    # Some people want to have their cake and eat it too!"
NSQ_SOURCE_LINE 00000667 "\t    # Set $APPEND_QUERY_STRING = 1 to have the contents of the query string"
NSQ_SOURCE_LINE 00000668 "\t    # APPENDED to the POST data."
NSQ_SOURCE_LINE 00000669 "\t    $query_string .= (length($query_string) ? '&' : '') . $ENV{'QUERY_STRING'} if defined $ENV{'QUERY_STRING'};"
NSQ_SOURCE_LINE 00000670 "\t  }"
NSQ_SOURCE_LINE 00000671 "\t  last METHOD;"
NSQ_SOURCE_LINE 00000672 "      }"
NSQ_SOURCE_LINE 00000673 ""
NSQ_SOURCE_LINE 00000674 "      # If $meth is not of GET, POST, PUT or HEAD, assume we're"
NSQ_SOURCE_LINE 00000675 "      #   being debugged offline."
NSQ_SOURCE_LINE 00000676 "      # Check the command line and then the standard input for data."
NSQ_SOURCE_LINE 00000677 "      # We use the shellwords package in order to behave the way that"
NSQ_SOURCE_LINE 00000678 "      # UN*X programmers expect."
NSQ_SOURCE_LINE 00000679 "      if ($DEBUG)"
NSQ_SOURCE_LINE 00000680 "      {"
NSQ_SOURCE_LINE 00000681 "          my $cmdline_ret = read_from_cmdline();"
NSQ_SOURCE_LINE 00000682 "          $query_string = $cmdline_ret->{'query_string'};"
NSQ_SOURCE_LINE 00000683 "          if (defined($cmdline_ret->{'subpath'}))"
NSQ_SOURCE_LINE 00000684 "          {"
NSQ_SOURCE_LINE 00000685 "              $self->path_info($cmdline_ret->{'subpath'});"
NSQ_SOURCE_LINE 00000686 "          }"
NSQ_SOURCE_LINE 00000687 "      }"
NSQ_SOURCE_LINE 00000688 "  }"
NSQ_SOURCE_LINE 00000689 ""
NSQ_SOURCE_LINE 00000690 "# YL: Begin Change for XML handler 10/19/2001"
NSQ_SOURCE_LINE 00000691 "    if (!$is_xforms && ($meth eq 'POST' || $meth eq 'PUT' || $meth eq 'PATCH')"
NSQ_SOURCE_LINE 00000692 "        && defined($ENV{'CONTENT_TYPE'})"
NSQ_SOURCE_LINE 00000693 "        && $ENV{'CONTENT_TYPE'} !~ m|^application/x-www-form-urlencoded|"
NSQ_SOURCE_LINE 00000694 "\t&& $ENV{'CONTENT_TYPE'} !~ m|^multipart/form-data| ) {"
NSQ_SOURCE_LINE 00000695 "\t    my($param) = $meth . 'DATA' ;"
NSQ_SOURCE_LINE 00000696 "\t    $self->add_parameter($param) ;"
NSQ_SOURCE_LINE 00000697 "\t    push (@{$self->{param}{$param}},$query_string);"
NSQ_SOURCE_LINE 00000698 "\t    undef $query_string ;"
NSQ_SOURCE_LINE 00000699 "    }"
NSQ_SOURCE_LINE 00000700 "# YL: End Change for XML handler 10/19/2001"
NSQ_SOURCE_LINE 00000701 ""
NSQ_SOURCE_LINE 00000702 "    # We now have the query string in hand.  We do slightly"
NSQ_SOURCE_LINE 00000703 "    # different things for keyword lists and parameter lists."
NSQ_SOURCE_LINE 00000704 "    if (defined $query_string && length $query_string) {"
NSQ_SOURCE_LINE 00000705 "\tif ($query_string =~ /[&=;]/) {"
NSQ_SOURCE_LINE 00000706 "\t    $self->parse_params($query_string);"
NSQ_SOURCE_LINE 00000707 "\t} else {"
NSQ_SOURCE_LINE 00000708 "\t    $self->add_parameter('keywords');"
NSQ_SOURCE_LINE 00000709 "\t    $self->{param}{'keywords'} = [$self->parse_keywordlist($query_string)];"
NSQ_SOURCE_LINE 00000710 "\t}"
NSQ_SOURCE_LINE 00000711 "    }"
NSQ_SOURCE_LINE 00000712 ""
NSQ_SOURCE_LINE 00000713 "    # Special case.  Erase everything if there is a field named"
NSQ_SOURCE_LINE 00000714 "    # .defaults."
NSQ_SOURCE_LINE 00000715 "    if ($self->param('.defaults')) {"
NSQ_SOURCE_LINE 00000716 "      $self->delete_all();"
NSQ_SOURCE_LINE 00000717 "    }"
NSQ_SOURCE_LINE 00000718 ""
NSQ_SOURCE_LINE 00000719 "    # hash containing our defined fieldnames"
NSQ_SOURCE_LINE 00000720 "    $self->{'.fieldnames'} = {};"
NSQ_SOURCE_LINE 00000721 "    for ($self->param('.cgifields')) {"
NSQ_SOURCE_LINE 00000722 "\t$self->{'.fieldnames'}->{$_}++;"
NSQ_SOURCE_LINE 00000723 "    }"
NSQ_SOURCE_LINE 00000724 "    "
NSQ_SOURCE_LINE 00000725 "    # Clear out our default submission button flag if present"
NSQ_SOURCE_LINE 00000726 "    $self->delete('.submit');"
NSQ_SOURCE_LINE 00000727 "    $self->delete('.cgifields');"
NSQ_SOURCE_LINE 00000728 ""
NSQ_SOURCE_LINE 00000729 "    $self->save_request unless defined $initializer;"
NSQ_SOURCE_LINE 00000730 "}"
