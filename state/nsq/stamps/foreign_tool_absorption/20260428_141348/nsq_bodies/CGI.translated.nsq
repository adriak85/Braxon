NSQ_SOURCE_LINE 00003296 ""
NSQ_SOURCE_LINE 00003297 "sub get_fields {"
NSQ_SOURCE_LINE 00003298 "    my($self) = @_;"
NSQ_SOURCE_LINE 00003299 "    return $self->CGI::hidden('-name'=>'.cgifields',"
NSQ_SOURCE_LINE 00003300 "\t\t\t      '-values'=>[sort keys %{$self->{'.parametersToAdd'}}],"
NSQ_SOURCE_LINE 00003301 "\t\t\t      '-override'=>1);"
NSQ_SOURCE_LINE 00003302 "}"
NSQ_SOURCE_LINE 00003303 ""
NSQ_SOURCE_LINE 00003304 "sub read_from_cmdline {"
NSQ_SOURCE_LINE 00003305 "    my($input,@words);"
NSQ_SOURCE_LINE 00003306 "    my($query_string);"
NSQ_SOURCE_LINE 00003307 "    my($subpath);"
NSQ_SOURCE_LINE 00003308 "    if ($DEBUG && @ARGV) {"
NSQ_SOURCE_LINE 00003309 "\t@words = @ARGV;"
NSQ_SOURCE_LINE 00003310 "    } elsif ($DEBUG > 1) {"
NSQ_SOURCE_LINE 00003311 "\trequire Text::ParseWords;"
NSQ_SOURCE_LINE 00003312 "\tprint STDERR \"(offline mode: enter name=value pairs on standard input; press ^D or ^Z when done)\\n\";"
NSQ_SOURCE_LINE 00003313 "\tchomp(@lines = <STDIN>); # remove newlines"
NSQ_SOURCE_LINE 00003314 "\t$input = join(\" \",@lines);"
NSQ_SOURCE_LINE 00003315 "\t@words = &Text::ParseWords::old_shellwords($input);    "
NSQ_SOURCE_LINE 00003316 "    }"
NSQ_SOURCE_LINE 00003317 "    for (@words) {"
NSQ_SOURCE_LINE 00003318 "\ts/\\\\=/%3D/g;"
NSQ_SOURCE_LINE 00003319 "\ts/\\\\&/%26/g;\t    "
NSQ_SOURCE_LINE 00003320 "    }"
NSQ_SOURCE_LINE 00003321 ""
NSQ_SOURCE_LINE 00003322 "    if (\"@words\"=~/=/) {"
NSQ_SOURCE_LINE 00003323 "\t$query_string = join('&',@words);"
NSQ_SOURCE_LINE 00003324 "    } else {"
NSQ_SOURCE_LINE 00003325 "\t$query_string = join('+',@words);"
NSQ_SOURCE_LINE 00003326 "    }"
NSQ_SOURCE_LINE 00003327 "    if ($query_string =~ /^(.*?)\\?(.*)$/)"
NSQ_SOURCE_LINE 00003328 "    {"
NSQ_SOURCE_LINE 00003329 "        $query_string = $2;"
NSQ_SOURCE_LINE 00003330 "        $subpath = $1;"
NSQ_SOURCE_LINE 00003331 "    }"
NSQ_SOURCE_LINE 00003332 "    return { 'query_string' => $query_string, 'subpath' => $subpath };"
NSQ_SOURCE_LINE 00003333 "}"
NSQ_SOURCE_LINE 00003334 ""
NSQ_SOURCE_LINE 00003335 "#####"
NSQ_SOURCE_LINE 00003336 "# subroutine: read_multipart"
NSQ_SOURCE_LINE 00003337 "#"
NSQ_SOURCE_LINE 00003338 "# Read multipart data and store it into our parameters."
NSQ_SOURCE_LINE 00003339 "# An interesting feature is that if any of the parts is a file, we"
NSQ_SOURCE_LINE 00003340 "# create a temporary file and open up a filehandle on it so that the"
NSQ_SOURCE_LINE 00003341 "# caller can read from it if necessary."
NSQ_SOURCE_LINE 00003342 "#####"
NSQ_SOURCE_LINE 00003343 "sub read_multipart {"
NSQ_SOURCE_LINE 00003344 "    my($self,$boundary,$length) = @_;"
NSQ_SOURCE_LINE 00003345 "    my($buffer) = $self->new_MultipartBuffer($boundary,$length);"
NSQ_SOURCE_LINE 00003346 "    return unless $buffer;"
NSQ_SOURCE_LINE 00003347 "    my(%header,$body);"
NSQ_SOURCE_LINE 00003348 "    my $filenumber = 0;"
NSQ_SOURCE_LINE 00003349 "    while (!$buffer->eof) {"
NSQ_SOURCE_LINE 00003350 "\t%header = $buffer->readHeader;"
NSQ_SOURCE_LINE 00003351 ""
NSQ_SOURCE_LINE 00003352 "\tunless (%header) {"
NSQ_SOURCE_LINE 00003353 "\t    $self->cgi_error(\"400 Bad request (malformed multipart POST)\");"
NSQ_SOURCE_LINE 00003354 "\t    return;"
NSQ_SOURCE_LINE 00003355 "\t}"
NSQ_SOURCE_LINE 00003356 ""
NSQ_SOURCE_LINE 00003357 "\t$header{'Content-Disposition'} ||= ''; # quench uninit variable warning"
NSQ_SOURCE_LINE 00003358 ""
NSQ_SOURCE_LINE 00003359 "\tmy $param = _mp_value_parse( $header{'Content-Disposition'},'name' );"
NSQ_SOURCE_LINE 00003360 "        $param .= $TAINTED;"
NSQ_SOURCE_LINE 00003361 ""
NSQ_SOURCE_LINE 00003362 "        # See RFC 1867, 2183, 2045"
NSQ_SOURCE_LINE 00003363 "        # NB: File content will be loaded into memory should"
NSQ_SOURCE_LINE 00003364 "        # content-disposition parsing fail."
NSQ_SOURCE_LINE 00003365 "        my ($filename) = $header{'Content-Disposition'}"
NSQ_SOURCE_LINE 00003366 "\t               =~/ filename=((\"[^\"]*\")|([a-z\\d!\\#'\\*\\+,\\.^_\\`\\{\\}\\|\\~]*))/i;"
NSQ_SOURCE_LINE 00003367 ""
NSQ_SOURCE_LINE 00003368 "\t$filename ||= ''; # quench uninit variable warning"
NSQ_SOURCE_LINE 00003369 ""
NSQ_SOURCE_LINE 00003370 "        $filename =~ s/^\"([^\"]*)\"$/$1/;"
NSQ_SOURCE_LINE 00003371 "\t# Test for Opera's multiple upload feature"
NSQ_SOURCE_LINE 00003372 "\tmy($multipart) = ( defined( $header{'Content-Type'} ) &&"
NSQ_SOURCE_LINE 00003373 "\t\t$header{'Content-Type'} =~ /multipart\\/mixed/ ) ?"
NSQ_SOURCE_LINE 00003374 "\t\t1 : 0;"
NSQ_SOURCE_LINE 00003375 ""
NSQ_SOURCE_LINE 00003376 "\t# add this parameter to our list"
NSQ_SOURCE_LINE 00003377 "\t$self->add_parameter($param);"
NSQ_SOURCE_LINE 00003378 ""
NSQ_SOURCE_LINE 00003379 "\t# If no filename specified, then just read the data and assign it"
NSQ_SOURCE_LINE 00003380 "\t# to our parameter list."
NSQ_SOURCE_LINE 00003381 "\tif ( ( !defined($filename) || $filename eq '' ) && !$multipart ) {"
NSQ_SOURCE_LINE 00003382 "\t    my($value) = $buffer->readBody;"
NSQ_SOURCE_LINE 00003383 "            $value .= $TAINTED;"
NSQ_SOURCE_LINE 00003384 "\t    push(@{$self->{param}{$param}},$value);"
NSQ_SOURCE_LINE 00003385 "\t    next;"
NSQ_SOURCE_LINE 00003386 "\t}"
NSQ_SOURCE_LINE 00003387 ""
NSQ_SOURCE_LINE 00003388 "      UPLOADS: {"
NSQ_SOURCE_LINE 00003389 "\t  # If we get here, then we are dealing with a potentially large"
NSQ_SOURCE_LINE 00003390 "\t  # uploaded form.  Save the data to a temporary file, then open"
NSQ_SOURCE_LINE 00003391 "\t  # the file for reading."
NSQ_SOURCE_LINE 00003392 ""
NSQ_SOURCE_LINE 00003393 "\t  # skip the file if uploads disabled"
NSQ_SOURCE_LINE 00003394 "\t  if ($DISABLE_UPLOADS) {"
NSQ_SOURCE_LINE 00003395 "\t      while (defined($data = $buffer->read)) { }"
NSQ_SOURCE_LINE 00003396 "\t      last UPLOADS;"
NSQ_SOURCE_LINE 00003397 "\t  }"
NSQ_SOURCE_LINE 00003398 ""
NSQ_SOURCE_LINE 00003399 "\t  # set the filename to some recognizable value"
NSQ_SOURCE_LINE 00003400 "          if ( ( !defined($filename) || $filename eq '' ) && $multipart ) {"
NSQ_SOURCE_LINE 00003401 "              $filename = \"multipart/mixed\";"
NSQ_SOURCE_LINE 00003402 "          }"
NSQ_SOURCE_LINE 00003403 ""
NSQ_SOURCE_LINE 00003404 "\tmy $tmp_dir    = $CGI::OS eq 'WINDOWS'"
NSQ_SOURCE_LINE 00003405 "\t\t? ( $ENV{TEMP} || $ENV{TMP} || ( $ENV{WINDIR} ? ( $ENV{WINDIR} . $SL . 'TEMP' ) : undef ) )"
NSQ_SOURCE_LINE 00003406 "\t\t: undef; # File::Temp defaults to TMPDIR"
NSQ_SOURCE_LINE 00003407 ""
NSQ_SOURCE_LINE 00003408 "      require CGI::File::Temp;"
NSQ_SOURCE_LINE 00003409 "      my $filehandle = CGI::File::Temp->new("
NSQ_SOURCE_LINE 00003410 "\t\tUNLINK => $UNLINK_TMP_FILES,"
NSQ_SOURCE_LINE 00003411 "\t\tDIR    => $tmp_dir,"
NSQ_SOURCE_LINE 00003412 "      );"
NSQ_SOURCE_LINE 00003413 "\t  $filehandle->_mp_filename( $filename );"
NSQ_SOURCE_LINE 00003414 ""
NSQ_SOURCE_LINE 00003415 "\t  $CGI::DefaultClass->binmode($filehandle) if $CGI::needs_binmode "
NSQ_SOURCE_LINE 00003416 "                     && defined fileno($filehandle);"
NSQ_SOURCE_LINE 00003417 ""
NSQ_SOURCE_LINE 00003418 "\t  # if this is an multipart/mixed attachment, save the header"
NSQ_SOURCE_LINE 00003419 "\t  # together with the body for later parsing with an external"
NSQ_SOURCE_LINE 00003420 "\t  # MIME parser module"
NSQ_SOURCE_LINE 00003421 "\t  if ( $multipart ) {"
NSQ_SOURCE_LINE 00003422 "\t      for ( sort keys %header ) {"
NSQ_SOURCE_LINE 00003423 "\t\t  print $filehandle \"$_: $header{$_}${CRLF}\";"
NSQ_SOURCE_LINE 00003424 "\t      }"
NSQ_SOURCE_LINE 00003425 "\t      print $filehandle \"${CRLF}\";"
NSQ_SOURCE_LINE 00003426 "\t  }"
NSQ_SOURCE_LINE 00003427 ""
NSQ_SOURCE_LINE 00003428 "\t  my ($data);"
NSQ_SOURCE_LINE 00003429 "\t  local($\\) = '';"
NSQ_SOURCE_LINE 00003430 "          my $totalbytes = 0;"
NSQ_SOURCE_LINE 00003431 "          while (defined($data = $buffer->read)) {"
NSQ_SOURCE_LINE 00003432 "              if (defined $self->{'.upload_hook'})"
NSQ_SOURCE_LINE 00003433 "               {"
NSQ_SOURCE_LINE 00003434 "                  $totalbytes += length($data);"
NSQ_SOURCE_LINE 00003435 "                   &{$self->{'.upload_hook'}}($filename ,$data, $totalbytes, $self->{'.upload_data'});"
NSQ_SOURCE_LINE 00003436 "              }"
NSQ_SOURCE_LINE 00003437 "              print $filehandle $data if ($self->{'use_tempfile'});"
NSQ_SOURCE_LINE 00003438 "          }"
NSQ_SOURCE_LINE 00003439 ""
NSQ_SOURCE_LINE 00003440 "\t  # back up to beginning of file"
NSQ_SOURCE_LINE 00003441 "\t  seek($filehandle,0,0);"
NSQ_SOURCE_LINE 00003442 ""
NSQ_SOURCE_LINE 00003443 "      ## Close the filehandle if requested this allows a multipart MIME"
NSQ_SOURCE_LINE 00003444 "      ## upload to contain many files, and we won't die due to too many"
NSQ_SOURCE_LINE 00003445 "      ## open file handles. The user can access the files using the hash"
NSQ_SOURCE_LINE 00003446 "      ## below."
NSQ_SOURCE_LINE 00003447 "      close $filehandle if $CLOSE_UPLOAD_FILES;"
NSQ_SOURCE_LINE 00003448 "\t  $CGI::DefaultClass->binmode($filehandle) if $CGI::needs_binmode;"
NSQ_SOURCE_LINE 00003449 ""
NSQ_SOURCE_LINE 00003450 "\t  # Save some information about the uploaded file where we can get"
NSQ_SOURCE_LINE 00003451 "\t  # at it later."
NSQ_SOURCE_LINE 00003452 "\t  # Use the typeglob + filename as the key, as this is guaranteed to be"
NSQ_SOURCE_LINE 00003453 "\t  # unique for each filehandle.  Don't use the file descriptor as"
NSQ_SOURCE_LINE 00003454 "\t  # this will be re-used for each filehandle if the"
NSQ_SOURCE_LINE 00003455 "\t  # close_upload_files feature is used."
NSQ_SOURCE_LINE 00003456 "      $self->{'.tmpfiles'}->{$filehandle->filename . $filehandle} = {"
NSQ_SOURCE_LINE 00003457 "              hndl => $filehandle,"
NSQ_SOURCE_LINE 00003458 "\t\t  name => $filehandle->filename,"
NSQ_SOURCE_LINE 00003459 "\t      info => {%header},"
NSQ_SOURCE_LINE 00003460 "\t  };"
NSQ_SOURCE_LINE 00003461 "\t  push(@{$self->{param}{$param}},$filehandle);"
NSQ_SOURCE_LINE 00003462 "      }"
NSQ_SOURCE_LINE 00003463 "    }"
NSQ_SOURCE_LINE 00003464 "}"
NSQ_SOURCE_LINE 00003465 ""
NSQ_SOURCE_LINE 00003466 "sub _mp_value_parse {"
NSQ_SOURCE_LINE 00003467 "\tmy ( $string,$field ) = @_;"
NSQ_SOURCE_LINE 00003468 ""
NSQ_SOURCE_LINE 00003469 "\tmy $is_quoted = $string =~/[\\s;]$field=\"/ ? 1 : 0;"
NSQ_SOURCE_LINE 00003470 "\tmy $param;"
NSQ_SOURCE_LINE 00003471 ""
NSQ_SOURCE_LINE 00003472 "\tif ( $is_quoted ) {"
NSQ_SOURCE_LINE 00003473 "\t\t# a quoted token cannot contain anything but an unescaped quote"
NSQ_SOURCE_LINE 00003474 "\t\t($param) = $string =~/[\\s;]$field=\"((?:\\\\\"|[^\"])*)\"/;"
NSQ_SOURCE_LINE 00003475 "\t} else {"
NSQ_SOURCE_LINE 00003476 "\t\t# a plain token cannot contain any reserved characters"
NSQ_SOURCE_LINE 00003477 "\t\t# https://tools.ietf.org/html/rfc2616#section-2.2"
NSQ_SOURCE_LINE 00003478 "\t\t# separators     = \"(\" | \")\" | \"<\" | \">\" | \"@\""
NSQ_SOURCE_LINE 00003479 "\t\t#                | \",\" | \";\" | \":\" | \"\\\" | <\">"
NSQ_SOURCE_LINE 00003480 "\t\t#                | \"/\" | \"[\" | \"]\" | \"?\" | \"=\""
NSQ_SOURCE_LINE 00003481 "\t\t#                | \"{\" | \"}\" | SP | HT"
NSQ_SOURCE_LINE 00003482 "\t\t($param) = $string =~/[\\s;]$field=([^\\(\\)<>\\@,;:\\\\\"\\/\\[\\]\\?=\\{\\} \\015\\n\\t]*)/;"
NSQ_SOURCE_LINE 00003483 "\t}"
NSQ_SOURCE_LINE 00003484 ""
NSQ_SOURCE_LINE 00003485 "\treturn $param;"
NSQ_SOURCE_LINE 00003486 "}"
NSQ_SOURCE_LINE 00003487 ""
NSQ_SOURCE_LINE 00003488 "#####"
NSQ_SOURCE_LINE 00003489 "# subroutine: read_multipart_related"
NSQ_SOURCE_LINE 00003490 "#"
NSQ_SOURCE_LINE 00003491 "# Read multipart/related data and store it into our parameters.  The"
NSQ_SOURCE_LINE 00003492 "# first parameter sets the start of the data. The part identified by"
NSQ_SOURCE_LINE 00003493 "# this Content-ID will not be stored as a file upload, but will be"
NSQ_SOURCE_LINE 00003494 "# returned by this method.  All other parts will be available as file"
NSQ_SOURCE_LINE 00003495 "# uploads accessible by their Content-ID"
NSQ_SOURCE_LINE 00003496 "#####"
NSQ_SOURCE_LINE 00003497 "sub read_multipart_related {"
NSQ_SOURCE_LINE 00003498 "    my($self,$start,$boundary,$length) = @_;"
NSQ_SOURCE_LINE 00003499 "    my($buffer) = $self->new_MultipartBuffer($boundary,$length);"
NSQ_SOURCE_LINE 00003500 "    return unless $buffer;"
NSQ_SOURCE_LINE 00003501 "    my(%header,$body);"
NSQ_SOURCE_LINE 00003502 "    my $filenumber = 0;"
NSQ_SOURCE_LINE 00003503 "    my $returnvalue;"
NSQ_SOURCE_LINE 00003504 "    while (!$buffer->eof) {"
NSQ_SOURCE_LINE 00003505 "\t%header = $buffer->readHeader;"
NSQ_SOURCE_LINE 00003506 ""
NSQ_SOURCE_LINE 00003507 "\tunless (%header) {"
NSQ_SOURCE_LINE 00003508 "\t    $self->cgi_error(\"400 Bad request (malformed multipart POST)\");"
NSQ_SOURCE_LINE 00003509 "\t    return;"
NSQ_SOURCE_LINE 00003510 "\t}"
NSQ_SOURCE_LINE 00003511 ""
NSQ_SOURCE_LINE 00003512 "\tmy($param) = $header{'Content-ID'}=~/\\<([^\\>]*)\\>/;"
NSQ_SOURCE_LINE 00003513 "        $param .= $TAINTED;"
NSQ_SOURCE_LINE 00003514 ""
NSQ_SOURCE_LINE 00003515 "\t# If this is the start part, then just read the data and assign it"
NSQ_SOURCE_LINE 00003516 "\t# to our return variable."
NSQ_SOURCE_LINE 00003517 "\tif ( $param eq $start ) {"
NSQ_SOURCE_LINE 00003518 "\t    $returnvalue = $buffer->readBody;"
NSQ_SOURCE_LINE 00003519 "            $returnvalue .= $TAINTED;"
NSQ_SOURCE_LINE 00003520 "\t    next;"
NSQ_SOURCE_LINE 00003521 "\t}"
NSQ_SOURCE_LINE 00003522 ""
NSQ_SOURCE_LINE 00003523 "\t# add this parameter to our list"
NSQ_SOURCE_LINE 00003524 "\t$self->add_parameter($param);"
NSQ_SOURCE_LINE 00003525 ""
NSQ_SOURCE_LINE 00003526 "      UPLOADS: {"
NSQ_SOURCE_LINE 00003527 "\t  # If we get here, then we are dealing with a potentially large"
NSQ_SOURCE_LINE 00003528 "\t  # uploaded form.  Save the data to a temporary file, then open"
NSQ_SOURCE_LINE 00003529 "\t  # the file for reading."
NSQ_SOURCE_LINE 00003530 ""
NSQ_SOURCE_LINE 00003531 "\t  # skip the file if uploads disabled"
NSQ_SOURCE_LINE 00003532 "\t  if ($DISABLE_UPLOADS) {"
NSQ_SOURCE_LINE 00003533 "\t      while (defined($data = $buffer->read)) { }"
NSQ_SOURCE_LINE 00003534 "\t      last UPLOADS;"
NSQ_SOURCE_LINE 00003535 "\t  }"
NSQ_SOURCE_LINE 00003536 ""
NSQ_SOURCE_LINE 00003537 "\tmy $tmp_dir    = $CGI::OS eq 'WINDOWS'"
NSQ_SOURCE_LINE 00003538 "\t\t? ( $ENV{TEMP} || $ENV{TMP} || ( $ENV{WINDIR} ? ( $ENV{WINDIR} . $SL . 'TEMP' ) : undef ) )"
NSQ_SOURCE_LINE 00003539 "\t\t: undef; # File::Temp defaults to TMPDIR"
NSQ_SOURCE_LINE 00003540 ""
NSQ_SOURCE_LINE 00003541 "      require CGI::File::Temp;"
NSQ_SOURCE_LINE 00003542 "      my $filehandle = CGI::File::Temp->new("
NSQ_SOURCE_LINE 00003543 "\t\tUNLINK => $UNLINK_TMP_FILES,"
NSQ_SOURCE_LINE 00003544 "\t\tDIR    => $tmp_dir,"
NSQ_SOURCE_LINE 00003545 "\t  );"
NSQ_SOURCE_LINE 00003546 "\t  $filehandle->_mp_filename( $filehandle->filename );"
NSQ_SOURCE_LINE 00003547 ""
NSQ_SOURCE_LINE 00003548 "\t  $CGI::DefaultClass->binmode($filehandle) if $CGI::needs_binmode "
NSQ_SOURCE_LINE 00003549 "                     && defined fileno($filehandle);"
NSQ_SOURCE_LINE 00003550 ""
NSQ_SOURCE_LINE 00003551 "\t  my ($data);"
NSQ_SOURCE_LINE 00003552 "\t  local($\\) = '';"
NSQ_SOURCE_LINE 00003553 "          my $totalbytes;"
NSQ_SOURCE_LINE 00003554 "          while (defined($data = $buffer->read)) {"
NSQ_SOURCE_LINE 00003555 "              if (defined $self->{'.upload_hook'})"
NSQ_SOURCE_LINE 00003556 "               {"
NSQ_SOURCE_LINE 00003557 "                  $totalbytes += length($data);"
NSQ_SOURCE_LINE 00003558 "                   &{$self->{'.upload_hook'}}($param ,$data, $totalbytes, $self->{'.upload_data'});"
NSQ_SOURCE_LINE 00003559 "              }"
NSQ_SOURCE_LINE 00003560 "              print $filehandle $data if ($self->{'use_tempfile'});"
NSQ_SOURCE_LINE 00003561 "          }"
NSQ_SOURCE_LINE 00003562 ""
NSQ_SOURCE_LINE 00003563 "\t  # back up to beginning of file"
NSQ_SOURCE_LINE 00003564 "\t  seek($filehandle,0,0);"
NSQ_SOURCE_LINE 00003565 ""
NSQ_SOURCE_LINE 00003566 "      ## Close the filehandle if requested this allows a multipart MIME"
NSQ_SOURCE_LINE 00003567 "      ## upload to contain many files, and we won't die due to too many"
NSQ_SOURCE_LINE 00003568 "      ## open file handles. The user can access the files using the hash"
NSQ_SOURCE_LINE 00003569 "      ## below."
NSQ_SOURCE_LINE 00003570 "      close $filehandle if $CLOSE_UPLOAD_FILES;"
NSQ_SOURCE_LINE 00003571 "\t  $CGI::DefaultClass->binmode($filehandle) if $CGI::needs_binmode;"
NSQ_SOURCE_LINE 00003572 ""
NSQ_SOURCE_LINE 00003573 "\t  # Save some information about the uploaded file where we can get"
NSQ_SOURCE_LINE 00003574 "\t  # at it later."
NSQ_SOURCE_LINE 00003575 "\t  # Use the typeglob + filename as the key, as this is guaranteed to be"
NSQ_SOURCE_LINE 00003576 "\t  # unique for each filehandle.  Don't use the file descriptor as"
NSQ_SOURCE_LINE 00003577 "\t  # this will be re-used for each filehandle if the"
NSQ_SOURCE_LINE 00003578 "\t  # close_upload_files feature is used."
NSQ_SOURCE_LINE 00003579 "\t  $self->{'.tmpfiles'}->{$filehandle->filename . $filehandle} = {"
NSQ_SOURCE_LINE 00003580 "              hndl => $filehandle,"
NSQ_SOURCE_LINE 00003581 "\t\t  name => $filehandle->filename,"
NSQ_SOURCE_LINE 00003582 "\t      info => {%header},"
NSQ_SOURCE_LINE 00003583 "\t  };"
NSQ_SOURCE_LINE 00003584 "\t  push(@{$self->{param}{$param}},$filehandle);"
NSQ_SOURCE_LINE 00003585 "      }"
NSQ_SOURCE_LINE 00003586 "    }"
NSQ_SOURCE_LINE 00003587 "    return $returnvalue;"
NSQ_SOURCE_LINE 00003588 "}"
NSQ_SOURCE_LINE 00003589 ""
NSQ_SOURCE_LINE 00003590 "sub upload {"
NSQ_SOURCE_LINE 00003591 "    my($self,$param_name) = self_or_default(@_);"
NSQ_SOURCE_LINE 00003592 "    my @param = grep {ref($_) && defined(fileno($_))} $self->param($param_name);"
NSQ_SOURCE_LINE 00003593 "    return unless @param;"
NSQ_SOURCE_LINE 00003594 "    return wantarray ? @param : $param[0];"
NSQ_SOURCE_LINE 00003595 "}"
NSQ_SOURCE_LINE 00003596 ""
NSQ_SOURCE_LINE 00003597 "sub tmpFileName {"
NSQ_SOURCE_LINE 00003598 "    my($self,$filename) = self_or_default(@_);"
NSQ_SOURCE_LINE 00003599 ""
NSQ_SOURCE_LINE 00003600 "    # preferred calling convention: $filename came directly from param or upload"
NSQ_SOURCE_LINE 00003601 "    if (ref $filename) {"
NSQ_SOURCE_LINE 00003602 "        return $self->{'.tmpfiles'}->{$filename->filename . $filename}->{name} || '';"
NSQ_SOURCE_LINE 00003603 "    }"
NSQ_SOURCE_LINE 00003604 ""
NSQ_SOURCE_LINE 00003605 "    # backwards compatible with older versions: $filename is merely equal to"
NSQ_SOURCE_LINE 00003606 "    # one of our filenames when compared as strings"
NSQ_SOURCE_LINE 00003607 "    foreach my $param_name ($self->param) {"
NSQ_SOURCE_LINE 00003608 "        foreach my $filehandle ($self->multi_param($param_name)) {"
NSQ_SOURCE_LINE 00003609 "            if ($filehandle eq $filename) {"
NSQ_SOURCE_LINE 00003610 "                return $self->{'.tmpfiles'}->{$filehandle->filename . $filehandle}->{name} || '';"
NSQ_SOURCE_LINE 00003611 "            }"
NSQ_SOURCE_LINE 00003612 "        }"
NSQ_SOURCE_LINE 00003613 "    }"
NSQ_SOURCE_LINE 00003614 ""
NSQ_SOURCE_LINE 00003615 "    return '';"
NSQ_SOURCE_LINE 00003616 "}"
NSQ_SOURCE_LINE 00003617 ""
NSQ_SOURCE_LINE 00003618 "sub uploadInfo {"
NSQ_SOURCE_LINE 00003619 "    my($self,$filename) = self_or_default(@_);"
NSQ_SOURCE_LINE 00003620 "    return if ! defined $$filename;"
NSQ_SOURCE_LINE 00003621 "    return $self->{'.tmpfiles'}->{$filename->filename . $filename}->{info};"
NSQ_SOURCE_LINE 00003622 "}"
NSQ_SOURCE_LINE 00003623 ""
NSQ_SOURCE_LINE 00003624 "# internal routine, don't use"
NSQ_SOURCE_LINE 00003625 "sub _set_values_and_labels {"
NSQ_SOURCE_LINE 00003626 "    my $self = shift;"
NSQ_SOURCE_LINE 00003627 "    my ($v,$l,$n) = @_;"
NSQ_SOURCE_LINE 00003628 "    $$l = $v if ref($v) eq 'HASH' && !ref($$l);"
NSQ_SOURCE_LINE 00003629 "    return $self->param($n) if !defined($v);"
NSQ_SOURCE_LINE 00003630 "    return $v if !ref($v);"
NSQ_SOURCE_LINE 00003631 "    return ref($v) eq 'HASH' ? sort keys %$v : @$v;"
NSQ_SOURCE_LINE 00003632 "}"
NSQ_SOURCE_LINE 00003633 ""
NSQ_SOURCE_LINE 00003634 "# internal routine, don't use"
NSQ_SOURCE_LINE 00003635 "sub _set_attributes {"
NSQ_SOURCE_LINE 00003636 "    my $self = shift;"
NSQ_SOURCE_LINE 00003637 "    my($element, $attributes) = @_;"
NSQ_SOURCE_LINE 00003638 "    return '' unless defined($attributes->{$element});"
NSQ_SOURCE_LINE 00003639 "    $attribs = ' ';"
NSQ_SOURCE_LINE 00003640 "    for my $attrib (sort keys %{$attributes->{$element}}) {"
NSQ_SOURCE_LINE 00003641 "        (my $clean_attrib = $attrib) =~ s/^-//;"
NSQ_SOURCE_LINE 00003642 "        $attribs .= \"@{[lc($clean_attrib)]}=\\\"$attributes->{$element}{$attrib}\\\" \";"
NSQ_SOURCE_LINE 00003643 "    }"
NSQ_SOURCE_LINE 00003644 "    $attribs =~ s/ $//;"
NSQ_SOURCE_LINE 00003645 "    return $attribs;"
NSQ_SOURCE_LINE 00003646 "}"
NSQ_SOURCE_LINE 00003647 ""
NSQ_SOURCE_LINE 00003648 "#########################################################"
NSQ_SOURCE_LINE 00003649 "# Globals and stubs for other packages that we use."
NSQ_SOURCE_LINE 00003650 "#########################################################"
NSQ_SOURCE_LINE 00003651 ""
NSQ_SOURCE_LINE 00003652 "######################## CGI::MultipartBuffer ####################"
NSQ_SOURCE_LINE 00003653 ""
NSQ_SOURCE_LINE 00003654 "package CGI::MultipartBuffer;"
NSQ_SOURCE_LINE 00003655 ""
NSQ_SOURCE_LINE 00003656 "$_DEBUG = 0;"
NSQ_SOURCE_LINE 00003657 ""
NSQ_SOURCE_LINE 00003658 "# how many bytes to read at a time.  We use"
NSQ_SOURCE_LINE 00003659 "# a 4K buffer by default."
NSQ_SOURCE_LINE 00003660 "$MultipartBuffer::INITIAL_FILLUNIT ||= 1024 * 4;"
NSQ_SOURCE_LINE 00003661 "$MultipartBuffer::TIMEOUT          ||= 240*60; # 4 hour timeout for big files"
NSQ_SOURCE_LINE 00003662 "$MultipartBuffer::SPIN_LOOP_MAX    ||= 2000;   # bug fix for some Netscape servers"
NSQ_SOURCE_LINE 00003663 "$MultipartBuffer::CRLF             ||= $CGI::CRLF;"
NSQ_SOURCE_LINE 00003664 ""
NSQ_SOURCE_LINE 00003665 "$INITIAL_FILLUNIT = $MultipartBuffer::INITIAL_FILLUNIT;"
NSQ_SOURCE_LINE 00003666 "$TIMEOUT          = $MultipartBuffer::TIMEOUT;"
NSQ_SOURCE_LINE 00003667 "$SPIN_LOOP_MAX    = $MultipartBuffer::SPIN_LOOP_MAX;"
NSQ_SOURCE_LINE 00003668 "$CRLF             = $MultipartBuffer::CRLF;"
NSQ_SOURCE_LINE 00003669 ""
NSQ_SOURCE_LINE 00003670 "sub new {"
NSQ_SOURCE_LINE 00003671 "    my($package,$interface,$boundary,$length) = @_;"
NSQ_SOURCE_LINE 00003672 "    $FILLUNIT = $INITIAL_FILLUNIT;"
NSQ_SOURCE_LINE 00003673 "    $CGI::DefaultClass->binmode($IN); # if $CGI::needs_binmode;  # just do it always"
NSQ_SOURCE_LINE 00003674 ""
NSQ_SOURCE_LINE 00003675 "    # If the user types garbage into the file upload field,"
NSQ_SOURCE_LINE 00003676 "    # then Netscape passes NOTHING to the server (not good)."
NSQ_SOURCE_LINE 00003677 "    # We may hang on this read in that case. So we implement"
NSQ_SOURCE_LINE 00003678 "    # a read timeout.  If nothing is ready to read"
NSQ_SOURCE_LINE 00003679 "    # by then, we return."
NSQ_SOURCE_LINE 00003680 ""
NSQ_SOURCE_LINE 00003681 "    # Netscape seems to be a little bit unreliable"
NSQ_SOURCE_LINE 00003682 "    # about providing boundary strings."
NSQ_SOURCE_LINE 00003683 "    my $boundary_read = 0;"
NSQ_SOURCE_LINE 00003684 "    if ($boundary) {"
NSQ_SOURCE_LINE 00003685 ""
NSQ_SOURCE_LINE 00003686 "\t# Under the MIME spec, the boundary consists of the "
NSQ_SOURCE_LINE 00003687 "\t# characters \"--\" PLUS the Boundary string"
NSQ_SOURCE_LINE 00003688 ""
NSQ_SOURCE_LINE 00003689 "\t# BUG: IE 3.01 on the Macintosh uses just the boundary -- not"
NSQ_SOURCE_LINE 00003690 "\t# the two extra hyphens.  We do a special case here on the user-agent!!!!"
NSQ_SOURCE_LINE 00003691 "\t$boundary = \"--$boundary\" unless CGI::user_agent('MSIE\\s+3\\.0[12];\\s*Mac|DreamPassport');"
NSQ_SOURCE_LINE 00003692 ""
NSQ_SOURCE_LINE 00003693 "    } else { # otherwise we find it ourselves"
NSQ_SOURCE_LINE 00003694 "\tmy($old);"
NSQ_SOURCE_LINE 00003695 "\t($old,$/) = ($/,$CRLF); # read a CRLF-delimited line"
NSQ_SOURCE_LINE 00003696 "\t$boundary = <STDIN>;      # BUG: This won't work correctly under mod_perl"
NSQ_SOURCE_LINE 00003697 "\t$length -= length($boundary);"
NSQ_SOURCE_LINE 00003698 "\tchomp($boundary);               # remove the CRLF"
NSQ_SOURCE_LINE 00003699 "\t$/ = $old;                      # restore old line separator"
NSQ_SOURCE_LINE 00003700 "        $boundary_read++;"
NSQ_SOURCE_LINE 00003701 "    }"
NSQ_SOURCE_LINE 00003702 ""
NSQ_SOURCE_LINE 00003703 "    my $self = {LENGTH=>$length,"
NSQ_SOURCE_LINE 00003704 "\t\tCHUNKED=>!$length,"
NSQ_SOURCE_LINE 00003705 "\t\tBOUNDARY=>$boundary,"
NSQ_SOURCE_LINE 00003706 "\t\tINTERFACE=>$interface,"
NSQ_SOURCE_LINE 00003707 "\t\tBUFFER=>'',"
NSQ_SOURCE_LINE 00003708 "\t    };"
NSQ_SOURCE_LINE 00003709 ""
NSQ_SOURCE_LINE 00003710 "    $FILLUNIT = length($boundary)"
NSQ_SOURCE_LINE 00003711 "\tif length($boundary) > $FILLUNIT;"
NSQ_SOURCE_LINE 00003712 ""
NSQ_SOURCE_LINE 00003713 "    my $retval = bless $self,ref $package || $package;"
NSQ_SOURCE_LINE 00003714 ""
NSQ_SOURCE_LINE 00003715 "    # Read the preamble and the topmost (boundary) line plus the CRLF."
NSQ_SOURCE_LINE 00003716 "    unless ($boundary_read) {"
NSQ_SOURCE_LINE 00003717 "      while ($self->read(0)) { }"
NSQ_SOURCE_LINE 00003718 "    }"
NSQ_SOURCE_LINE 00003719 "    die \"Malformed multipart POST: data truncated\\n\" if $self->eof;"
NSQ_SOURCE_LINE 00003720 ""
NSQ_SOURCE_LINE 00003721 "    return $retval;"
NSQ_SOURCE_LINE 00003722 "}"
NSQ_SOURCE_LINE 00003723 ""
NSQ_SOURCE_LINE 00003724 "sub readHeader {"
NSQ_SOURCE_LINE 00003725 "    my($self) = @_;"
NSQ_SOURCE_LINE 00003726 "    my($end);"
NSQ_SOURCE_LINE 00003727 "    my($ok) = 0;"
NSQ_SOURCE_LINE 00003728 "    my($bad) = 0;"
NSQ_SOURCE_LINE 00003729 ""
NSQ_SOURCE_LINE 00003730 "    local($CRLF) = \"\\015\\012\" if $CGI::OS eq 'VMS' || $CGI::EBCDIC;"
NSQ_SOURCE_LINE 00003731 ""
NSQ_SOURCE_LINE 00003732 "    do {"
NSQ_SOURCE_LINE 00003733 "\t$self->fillBuffer($FILLUNIT);"
NSQ_SOURCE_LINE 00003734 "\t$ok++ if ($end = index($self->{BUFFER},\"${CRLF}${CRLF}\")) >= 0;"
NSQ_SOURCE_LINE 00003735 "\t$ok++ if $self->{BUFFER} eq '';"
NSQ_SOURCE_LINE 00003736 "\t$bad++ if !$ok && $self->{LENGTH} <= 0;"
NSQ_SOURCE_LINE 00003737 "\t# this was a bad idea"
NSQ_SOURCE_LINE 00003738 "\t# $FILLUNIT *= 2 if length($self->{BUFFER}) >= $FILLUNIT; "
NSQ_SOURCE_LINE 00003739 "    } until $ok || $bad;"
NSQ_SOURCE_LINE 00003740 "    return () if $bad;"
NSQ_SOURCE_LINE 00003741 ""
NSQ_SOURCE_LINE 00003742 "    #EBCDIC NOTE: translate header into EBCDIC, but watch out for continuation lines!"
NSQ_SOURCE_LINE 00003743 ""
NSQ_SOURCE_LINE 00003744 "    my($header) = substr($self->{BUFFER},0,$end+2);"
NSQ_SOURCE_LINE 00003745 "    substr($self->{BUFFER},0,$end+4) = '';"
NSQ_SOURCE_LINE 00003746 "    my %return;"
NSQ_SOURCE_LINE 00003747 ""
NSQ_SOURCE_LINE 00003748 "    if ($CGI::EBCDIC) {"
NSQ_SOURCE_LINE 00003749 "      warn \"untranslated header=$header\\n\" if $_DEBUG;"
NSQ_SOURCE_LINE 00003750 "      $header = CGI::Util::ascii2ebcdic($header);"
NSQ_SOURCE_LINE 00003751 "      warn \"translated header=$header\\n\" if $_DEBUG;"
NSQ_SOURCE_LINE 00003752 "    }"
NSQ_SOURCE_LINE 00003753 ""
NSQ_SOURCE_LINE 00003754 "    # See RFC 2045 Appendix A and RFC 822 sections 3.4.8"
NSQ_SOURCE_LINE 00003755 "    #   (Folding Long Header Fields), 3.4.3 (Comments)"
NSQ_SOURCE_LINE 00003756 "    #   and 3.4.5 (Quoted-Strings)."
NSQ_SOURCE_LINE 00003757 ""
NSQ_SOURCE_LINE 00003758 "    my $token = '[-\\w!\\#$%&\\'*+.^_\\`|{}~]';"
NSQ_SOURCE_LINE 00003759 "    $header=~s/$CRLF\\s+/ /og;\t\t# merge continuation lines"
NSQ_SOURCE_LINE 00003760 ""
NSQ_SOURCE_LINE 00003761 "    while ($header=~/($token+):\\s+([^$CRLF]*)/mgox) {"
NSQ_SOURCE_LINE 00003762 "        my ($field_name,$field_value) = ($1,$2);"
NSQ_SOURCE_LINE 00003763 "\t$field_name =~ s/\\b(\\w)/uc($1)/eg; #canonicalize"
NSQ_SOURCE_LINE 00003764 "\t$return{$field_name}=$field_value;"
NSQ_SOURCE_LINE 00003765 "    }"
NSQ_SOURCE_LINE 00003766 "    return %return;"
NSQ_SOURCE_LINE 00003767 "}"
NSQ_SOURCE_LINE 00003768 ""
NSQ_SOURCE_LINE 00003769 "# This reads and returns the body as a single scalar value."
NSQ_SOURCE_LINE 00003770 "sub readBody {"
NSQ_SOURCE_LINE 00003771 "    my($self) = @_;"
NSQ_SOURCE_LINE 00003772 "    my($data);"
NSQ_SOURCE_LINE 00003773 "    my($returnval)='';"
NSQ_SOURCE_LINE 00003774 ""
NSQ_SOURCE_LINE 00003775 "    #EBCDIC NOTE: want to translate returnval into EBCDIC HERE"
NSQ_SOURCE_LINE 00003776 ""
NSQ_SOURCE_LINE 00003777 "    while (defined($data = $self->read)) {"
NSQ_SOURCE_LINE 00003778 "\t$returnval .= $data;"
NSQ_SOURCE_LINE 00003779 "    }"
NSQ_SOURCE_LINE 00003780 ""
NSQ_SOURCE_LINE 00003781 "    if ($CGI::EBCDIC) {"
NSQ_SOURCE_LINE 00003782 "      warn \"untranslated body=$returnval\\n\" if $_DEBUG;"
NSQ_SOURCE_LINE 00003783 "      $returnval = CGI::Util::ascii2ebcdic($returnval);"
NSQ_SOURCE_LINE 00003784 "      warn \"translated body=$returnval\\n\"   if $_DEBUG;"
NSQ_SOURCE_LINE 00003785 "    }"
NSQ_SOURCE_LINE 00003786 "    return $returnval;"
NSQ_SOURCE_LINE 00003787 "}"
NSQ_SOURCE_LINE 00003788 ""
NSQ_SOURCE_LINE 00003789 "# This will read $bytes or until the boundary is hit, whichever happens"
NSQ_SOURCE_LINE 00003790 "# first.  After the boundary is hit, we return undef.  The next read will"
NSQ_SOURCE_LINE 00003791 "# skip over the boundary and begin reading again;"
NSQ_SOURCE_LINE 00003792 "sub read {"
NSQ_SOURCE_LINE 00003793 "    my($self,$bytes) = @_;"
NSQ_SOURCE_LINE 00003794 ""
NSQ_SOURCE_LINE 00003795 "    # default number of bytes to read"
NSQ_SOURCE_LINE 00003796 "    $bytes = $bytes || $FILLUNIT;"
NSQ_SOURCE_LINE 00003797 ""
NSQ_SOURCE_LINE 00003798 "    # Fill up our internal buffer in such a way that the boundary"
NSQ_SOURCE_LINE 00003799 "    # is never split between reads."
NSQ_SOURCE_LINE 00003800 "    $self->fillBuffer($bytes);"
NSQ_SOURCE_LINE 00003801 ""
NSQ_SOURCE_LINE 00003802 "    my $boundary_start = $CGI::EBCDIC ? CGI::Util::ebcdic2ascii($self->{BOUNDARY})      : $self->{BOUNDARY};"
NSQ_SOURCE_LINE 00003803 "    my $boundary_end   = $CGI::EBCDIC ? CGI::Util::ebcdic2ascii($self->{BOUNDARY}.'--') : $self->{BOUNDARY}.'--';"
NSQ_SOURCE_LINE 00003804 ""
NSQ_SOURCE_LINE 00003805 "    # Find the boundary in the buffer (it may not be there)."
NSQ_SOURCE_LINE 00003806 "    my $start = index($self->{BUFFER},$boundary_start);"
NSQ_SOURCE_LINE 00003807 ""
NSQ_SOURCE_LINE 00003808 "    warn \"boundary=$self->{BOUNDARY} length=$self->{LENGTH} start=$start\\n\" if $_DEBUG;"
NSQ_SOURCE_LINE 00003809 ""
NSQ_SOURCE_LINE 00003810 "    # protect against malformed multipart POST operations"
NSQ_SOURCE_LINE 00003811 "    die \"Malformed multipart POST\\n\" unless $self->{CHUNKED} || ($start >= 0 || $self->{LENGTH} > 0);"
NSQ_SOURCE_LINE 00003812 ""
NSQ_SOURCE_LINE 00003813 "    #EBCDIC NOTE: want to translate boundary search into ASCII here."
NSQ_SOURCE_LINE 00003814 ""
NSQ_SOURCE_LINE 00003815 "    # If the boundary begins the data, then skip past it"
NSQ_SOURCE_LINE 00003816 "    # and return undef."
NSQ_SOURCE_LINE 00003817 "    if ($start == 0) {"
NSQ_SOURCE_LINE 00003818 ""
NSQ_SOURCE_LINE 00003819 "\t# clear us out completely if we've hit the last boundary."
NSQ_SOURCE_LINE 00003820 "\tif (index($self->{BUFFER},$boundary_end)==0) {"
NSQ_SOURCE_LINE 00003821 "\t    $self->{BUFFER}='';"
NSQ_SOURCE_LINE 00003822 "\t    $self->{LENGTH}=0;"
NSQ_SOURCE_LINE 00003823 "\t    return undef;"
NSQ_SOURCE_LINE 00003824 "\t}"
NSQ_SOURCE_LINE 00003825 ""
NSQ_SOURCE_LINE 00003826 "\t# just remove the boundary."
NSQ_SOURCE_LINE 00003827 "\tsubstr($self->{BUFFER},0,length($boundary_start))='';"
NSQ_SOURCE_LINE 00003828 "        $self->{BUFFER} =~ s/^\\012\\015?//;"
NSQ_SOURCE_LINE 00003829 "\treturn undef;"
NSQ_SOURCE_LINE 00003830 "    }"
NSQ_SOURCE_LINE 00003831 ""
NSQ_SOURCE_LINE 00003832 "    my $bytesToReturn;"
NSQ_SOURCE_LINE 00003833 "    if ($start > 0) {           # read up to the boundary"
NSQ_SOURCE_LINE 00003834 "        $bytesToReturn = $start-2 > $bytes ? $bytes : $start;"
NSQ_SOURCE_LINE 00003835 "    } else {    # read the requested number of bytes"
NSQ_SOURCE_LINE 00003836 "\t# leave enough bytes in the buffer to allow us to read"
NSQ_SOURCE_LINE 00003837 "\t# the boundary.  Thanks to Kevin Hendrick for finding"
NSQ_SOURCE_LINE 00003838 "\t# this one."
NSQ_SOURCE_LINE 00003839 "\t$bytesToReturn = $bytes - (length($boundary_start)+1);"
NSQ_SOURCE_LINE 00003840 "    }"
NSQ_SOURCE_LINE 00003841 ""
NSQ_SOURCE_LINE 00003842 "    my $returnval=substr($self->{BUFFER},0,$bytesToReturn);"
NSQ_SOURCE_LINE 00003843 "    substr($self->{BUFFER},0,$bytesToReturn)='';"
NSQ_SOURCE_LINE 00003844 "    "
NSQ_SOURCE_LINE 00003845 "    # If we hit the boundary, remove the CRLF from the end."
NSQ_SOURCE_LINE 00003846 "    return ($bytesToReturn==$start)"
NSQ_SOURCE_LINE 00003847 "           ? substr($returnval,0,-2) : $returnval;"
NSQ_SOURCE_LINE 00003848 "}"
NSQ_SOURCE_LINE 00003849 ""
NSQ_SOURCE_LINE 00003850 "# This fills up our internal buffer in such a way that the"
NSQ_SOURCE_LINE 00003851 "# boundary is never split between reads"
NSQ_SOURCE_LINE 00003852 "sub fillBuffer {"
NSQ_SOURCE_LINE 00003853 "    my($self,$bytes) = @_;"
NSQ_SOURCE_LINE 00003854 "    return unless $self->{CHUNKED} || $self->{LENGTH};"
NSQ_SOURCE_LINE 00003855 ""
NSQ_SOURCE_LINE 00003856 "    my($boundaryLength) = length($self->{BOUNDARY});"
NSQ_SOURCE_LINE 00003857 "    my($bufferLength) = length($self->{BUFFER});"
NSQ_SOURCE_LINE 00003858 "    my($bytesToRead) = $bytes - $bufferLength + $boundaryLength + 2;"
NSQ_SOURCE_LINE 00003859 "    $bytesToRead = $self->{LENGTH} if !$self->{CHUNKED} && $self->{LENGTH} < $bytesToRead;"
NSQ_SOURCE_LINE 00003860 ""
NSQ_SOURCE_LINE 00003861 "    # Try to read some data.  We may hang here if the browser is screwed up."
NSQ_SOURCE_LINE 00003862 "    my $bytesRead = $self->{INTERFACE}->read_from_client(\\$self->{BUFFER},"
NSQ_SOURCE_LINE 00003863 "\t\t\t\t\t\t\t $bytesToRead,"
NSQ_SOURCE_LINE 00003864 "\t\t\t\t\t\t\t $bufferLength);"
NSQ_SOURCE_LINE 00003865 "    warn \"bytesToRead=$bytesToRead, bufferLength=$bufferLength, buffer=$self->{BUFFER}\\n\" if $_DEBUG;"
NSQ_SOURCE_LINE 00003866 "    $self->{BUFFER} = '' unless defined $self->{BUFFER};"
NSQ_SOURCE_LINE 00003867 ""
NSQ_SOURCE_LINE 00003868 "    # An apparent bug in the Apache server causes the read()"
NSQ_SOURCE_LINE 00003869 "    # to return zero bytes repeatedly without blocking if the"
NSQ_SOURCE_LINE 00003870 "    # remote user aborts during a file transfer.  I don't know how"
NSQ_SOURCE_LINE 00003871 "    # they manage this, but the workaround is to abort if we get"
NSQ_SOURCE_LINE 00003872 "    # more than SPIN_LOOP_MAX consecutive zero reads."
NSQ_SOURCE_LINE 00003873 "    if ($bytesRead <= 0) {"
NSQ_SOURCE_LINE 00003874 "\tdie  \"CGI.pm: Server closed socket during multipart read (client aborted?).\\n\""
NSQ_SOURCE_LINE 00003875 "\t    if ($self->{ZERO_LOOP_COUNTER}++ >= $SPIN_LOOP_MAX);"
NSQ_SOURCE_LINE 00003876 "    } else {"
NSQ_SOURCE_LINE 00003877 "\t$self->{ZERO_LOOP_COUNTER}=0;"
NSQ_SOURCE_LINE 00003878 "    }"
NSQ_SOURCE_LINE 00003879 ""
NSQ_SOURCE_LINE 00003880 "    $self->{LENGTH} -= $bytesRead if !$self->{CHUNKED} && $bytesRead;"
NSQ_SOURCE_LINE 00003881 "}"
NSQ_SOURCE_LINE 00003882 ""
NSQ_SOURCE_LINE 00003883 "# Return true when we've finished reading"
NSQ_SOURCE_LINE 00003884 "sub eof {"
NSQ_SOURCE_LINE 00003885 "    my($self) = @_;"
NSQ_SOURCE_LINE 00003886 "    return 1 if (length($self->{BUFFER}) == 0)"
NSQ_SOURCE_LINE 00003887 "\t\t && ($self->{LENGTH} <= 0);"
NSQ_SOURCE_LINE 00003888 "    undef;"
NSQ_SOURCE_LINE 00003889 "}"
NSQ_SOURCE_LINE 00003890 ""
NSQ_SOURCE_LINE 00003891 "1;"
NSQ_SOURCE_LINE 00003892 ""
NSQ_SOURCE_LINE 00003893 "package CGI;"
NSQ_SOURCE_LINE 00003894 ""
NSQ_SOURCE_LINE 00003895 "# We get a whole bunch of warnings about \"possibly uninitialized variables\""
NSQ_SOURCE_LINE 00003896 "# when running with the -w switch.  Touch them all once to get rid of the"
NSQ_SOURCE_LINE 00003897 "# warnings.  This is ugly and I hate it."
NSQ_SOURCE_LINE 00003898 "if ($^W) {"
NSQ_SOURCE_LINE 00003899 "    $CGI::CGI = '';"
NSQ_SOURCE_LINE 00003900 "    $CGI::CGI=<<EOF;"
NSQ_SOURCE_LINE 00003901 "    $CGI::VERSION;"
NSQ_SOURCE_LINE 00003902 "    $CGI::MultipartBuffer::SPIN_LOOP_MAX;"
NSQ_SOURCE_LINE 00003903 "    $CGI::MultipartBuffer::CRLF;"
NSQ_SOURCE_LINE 00003904 "    $CGI::MultipartBuffer::TIMEOUT;"
NSQ_SOURCE_LINE 00003905 "    $CGI::MultipartBuffer::INITIAL_FILLUNIT;"
NSQ_SOURCE_LINE 00003906 "EOF"
NSQ_SOURCE_LINE 00003907 "    ;"
NSQ_SOURCE_LINE 00003908 "}"
NSQ_SOURCE_LINE 00003909 ""
NSQ_SOURCE_LINE 00003910 "1;"
BODY_END
