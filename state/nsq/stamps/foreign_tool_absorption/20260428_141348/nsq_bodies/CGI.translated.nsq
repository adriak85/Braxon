NSQ_SOURCE_LINE 00001253 "sub TIEHASH {"
NSQ_SOURCE_LINE 00001254 "    my $class = shift;"
NSQ_SOURCE_LINE 00001255 "    my $arg   = $_[0];"
NSQ_SOURCE_LINE 00001256 "    if (ref($arg) && UNIVERSAL::isa($arg,'CGI')) {"
NSQ_SOURCE_LINE 00001257 "       return $arg;"
