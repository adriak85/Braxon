NSQ_SOURCE_LINE 00001132 "#### Method: delete"
NSQ_SOURCE_LINE 00001133 "# Deletes the named parameter entirely."
NSQ_SOURCE_LINE 00001134 "####"
NSQ_SOURCE_LINE 00001135 "sub delete {"
NSQ_SOURCE_LINE 00001136 "    my($self,@p) = self_or_default(@_);"
NSQ_SOURCE_LINE 00001137 "    my(@names) = rearrange([NAME],@p);"
NSQ_SOURCE_LINE 00001138 "    my @to_delete = ref($names[0]) eq 'ARRAY' ? @$names[0] : @names;"
NSQ_SOURCE_LINE 00001139 "    my %to_delete;"
NSQ_SOURCE_LINE 00001140 "    for my $name (@to_delete)"
NSQ_SOURCE_LINE 00001141 "    {"
NSQ_SOURCE_LINE 00001142 "        CORE::delete $self->{param}{$name};"
NSQ_SOURCE_LINE 00001143 "        CORE::delete $self->{'.fieldnames'}->{$name};"
NSQ_SOURCE_LINE 00001144 "        $to_delete{$name}++;"
NSQ_SOURCE_LINE 00001145 "    }"
NSQ_SOURCE_LINE 00001146 "    @{$self->{'.parameters'}}=grep { !exists($to_delete{$_}) } $self->param();"
NSQ_SOURCE_LINE 00001147 "    return;"
NSQ_SOURCE_LINE 00001148 "}"
NSQ_SOURCE_LINE 00001149 ""
NSQ_SOURCE_LINE 00001150 "#### Method: import_names"
NSQ_SOURCE_LINE 00001151 "# Import all parameters into the given namespace."
NSQ_SOURCE_LINE 00001152 "# Assumes namespace 'Q' if not specified"
NSQ_SOURCE_LINE 00001153 "####"
NSQ_SOURCE_LINE 00001154 "sub import_names {"
NSQ_SOURCE_LINE 00001155 "    my($self,$namespace,$delete) = self_or_default(@_);"
NSQ_SOURCE_LINE 00001156 "    $namespace = 'Q' unless defined($namespace);"
NSQ_SOURCE_LINE 00001157 "    die \"Can't import names into \\\"main\\\"\\n\" if \\%{\"${namespace}::\"} == \\%::;"
NSQ_SOURCE_LINE 00001158 "    if ($delete || $MOD_PERL || exists $ENV{'FCGI_ROLE'}) {"
NSQ_SOURCE_LINE 00001159 "\t# can anyone find an easier way to do this?"
NSQ_SOURCE_LINE 00001160 "\tfor (sort keys %{\"${namespace}::\"}) {"
NSQ_SOURCE_LINE 00001161 "\t    local *symbol = \"${namespace}::${_}\";"
NSQ_SOURCE_LINE 00001162 "\t    undef $symbol;"
NSQ_SOURCE_LINE 00001163 "\t    undef @symbol;"
NSQ_SOURCE_LINE 00001164 "\t    undef %symbol;"
NSQ_SOURCE_LINE 00001165 "\t}"
NSQ_SOURCE_LINE 00001166 "    }"
NSQ_SOURCE_LINE 00001167 "    my($param,@value,$var);"
NSQ_SOURCE_LINE 00001168 "    for $param ($self->param) {"
NSQ_SOURCE_LINE 00001169 "\t# protect against silly names"
NSQ_SOURCE_LINE 00001170 "\t($var = $param)=~tr/a-zA-Z0-9_/_/c;"
NSQ_SOURCE_LINE 00001171 "\t$var =~ s/^(?=\\d)/_/;"
NSQ_SOURCE_LINE 00001172 "\tlocal *symbol = \"${namespace}::$var\";"
NSQ_SOURCE_LINE 00001173 "\t@value = $self->param($param);"
NSQ_SOURCE_LINE 00001174 "\t@symbol = @value;"
NSQ_SOURCE_LINE 00001175 "\t$symbol = $value[0];"
NSQ_SOURCE_LINE 00001176 "    }"
NSQ_SOURCE_LINE 00001177 "}"
NSQ_SOURCE_LINE 00001178 ""
NSQ_SOURCE_LINE 00001179 "#### Method: keywords"
NSQ_SOURCE_LINE 00001180 "# Keywords acts a bit differently.  Calling it in a list context"
NSQ_SOURCE_LINE 00001181 "# returns the list of keywords.  "
NSQ_SOURCE_LINE 00001182 "# Calling it in a scalar context gives you the size of the list."
NSQ_SOURCE_LINE 00001183 "####"
NSQ_SOURCE_LINE 00001184 "sub keywords {"
NSQ_SOURCE_LINE 00001185 "    my($self,@values) = self_or_default(@_);"
NSQ_SOURCE_LINE 00001186 "    # If values is provided, then we set it."
NSQ_SOURCE_LINE 00001187 "    $self->{param}{'keywords'}=[@values] if @values;"
NSQ_SOURCE_LINE 00001188 "    my(@result) = defined($self->{param}{'keywords'}) ? @{$self->{param}{'keywords'}} : ();"
NSQ_SOURCE_LINE 00001189 "    @result;"
NSQ_SOURCE_LINE 00001190 "}"
NSQ_SOURCE_LINE 00001191 ""
