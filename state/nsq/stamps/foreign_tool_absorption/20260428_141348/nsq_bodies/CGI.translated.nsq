NSQ_SOURCE_LINE 00001304 "sub append {"
NSQ_SOURCE_LINE 00001305 "    my($self,@p) = self_or_default(@_);"
NSQ_SOURCE_LINE 00001306 "    my($name,$value) = rearrange([NAME,[VALUE,VALUES]],@p);"
