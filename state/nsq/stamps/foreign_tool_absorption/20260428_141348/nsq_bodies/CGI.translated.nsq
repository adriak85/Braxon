NSQ_SOURCE_LINE 00000732 "sub _get_query_string_from_env {"
NSQ_SOURCE_LINE 00000733 "    my $self = shift;"
NSQ_SOURCE_LINE 00000734 "    my $query_string = '';"
NSQ_SOURCE_LINE 00000735 ""
NSQ_SOURCE_LINE 00000736 "    if ( $MOD_PERL ) {"
NSQ_SOURCE_LINE 00000737 "        $query_string = $self->r->args;"
NSQ_SOURCE_LINE 00000738 "        if ( ! $query_string && $MOD_PERL == 2 ) {"
NSQ_SOURCE_LINE 00000739 "            # possibly a redirect, inspect prev request"
NSQ_SOURCE_LINE 00000740 "            # (->prev only supported under mod_perl2)"
NSQ_SOURCE_LINE 00000741 "            if ( my $prev = $self->r->prev ) {"
NSQ_SOURCE_LINE 00000742 "                $query_string = $prev->args;"
NSQ_SOURCE_LINE 00000743 "            }"
NSQ_SOURCE_LINE 00000744 "        }"
NSQ_SOURCE_LINE 00000745 "    }"
NSQ_SOURCE_LINE 00000746 ""
NSQ_SOURCE_LINE 00000747 "    $query_string ||= $ENV{'QUERY_STRING'}"
NSQ_SOURCE_LINE 00000748 "        if defined $ENV{'QUERY_STRING'};"
NSQ_SOURCE_LINE 00000749 ""
NSQ_SOURCE_LINE 00000750 "    if ( ! $query_string ) {"
NSQ_SOURCE_LINE 00000751 "        # try to get from REDIRECT_ env variables, support"
NSQ_SOURCE_LINE 00000752 "        # 5 levels of redirect and no more (RT #36312)"
NSQ_SOURCE_LINE 00000753 "        REDIRECT: foreach my $r ( 1 .. 5 ) {"
NSQ_SOURCE_LINE 00000754 "            my $key = join( '',( 'REDIRECT_' x $r ) );"
NSQ_SOURCE_LINE 00000755 "            $query_string ||= $ENV{\"${key}QUERY_STRING\"}"
NSQ_SOURCE_LINE 00000756 "                if defined $ENV{\"${key}QUERY_STRING\"};"
NSQ_SOURCE_LINE 00000757 "            last REDIRECT if $query_string;"
NSQ_SOURCE_LINE 00000758 "        }"
NSQ_SOURCE_LINE 00000759 "    }"
NSQ_SOURCE_LINE 00000760 ""
NSQ_SOURCE_LINE 00000761 "    return $query_string;"
NSQ_SOURCE_LINE 00000762 "}"
NSQ_SOURCE_LINE 00000763 ""
NSQ_SOURCE_LINE 00000764 "# FUNCTIONS TO OVERRIDE:"
NSQ_SOURCE_LINE 00000765 "# Turn a string into a filehandle"
NSQ_SOURCE_LINE 00000766 "sub to_filehandle {"
NSQ_SOURCE_LINE 00000767 "    my $thingy = shift;"
NSQ_SOURCE_LINE 00000768 "    return undef unless $thingy;"
NSQ_SOURCE_LINE 00000769 "    return $thingy if UNIVERSAL::isa($thingy,'GLOB');"
NSQ_SOURCE_LINE 00000770 "    return $thingy if UNIVERSAL::isa($thingy,'FileHandle');"
NSQ_SOURCE_LINE 00000771 "    if (!ref($thingy)) {"
NSQ_SOURCE_LINE 00000772 "\tmy $caller = 1;"
NSQ_SOURCE_LINE 00000773 "\twhile (my $package = caller($caller++)) {"
NSQ_SOURCE_LINE 00000774 "\t    my($tmp) = $thingy=~/[\\':]/ ? $thingy : \"$package\\:\\:$thingy\"; "
NSQ_SOURCE_LINE 00000775 "\t    return $tmp if defined(fileno($tmp));"
NSQ_SOURCE_LINE 00000776 "\t}"
NSQ_SOURCE_LINE 00000777 "    }"
NSQ_SOURCE_LINE 00000778 "    return undef;"
NSQ_SOURCE_LINE 00000779 "}"
