NSQ_SOURCE_LINE 00000993 ""
NSQ_SOURCE_LINE 00000994 "#####"
NSQ_SOURCE_LINE 00000995 "# subroutine: read_postdata_putdata"
NSQ_SOURCE_LINE 00000996 "# "
NSQ_SOURCE_LINE 00000997 "# Unless file uploads are disabled"
NSQ_SOURCE_LINE 00000998 "# Reads BODY of POST/PUT request and stuffs it into tempfile"
NSQ_SOURCE_LINE 00000999 "# accessible as param POSTDATA/PUTDATA"
NSQ_SOURCE_LINE 00001000 "# "
NSQ_SOURCE_LINE 00001001 "# Also respects      upload_hook"
NSQ_SOURCE_LINE 00001002 "# "
NSQ_SOURCE_LINE 00001003 "# based on subroutine read_multipart_related"
NSQ_SOURCE_LINE 00001004 "#####"
NSQ_SOURCE_LINE 00001005 "sub read_postdata_putdata {"
NSQ_SOURCE_LINE 00001006 "    my ( $self, $postOrPut, $content_length, $content_type ) = @_;"
NSQ_SOURCE_LINE 00001007 "    my %header = ("
NSQ_SOURCE_LINE 00001008 "        \"Content-Type\" =>  $content_type,"
NSQ_SOURCE_LINE 00001009 "    );"
NSQ_SOURCE_LINE 00001010 "    my $param = $postOrPut;"
NSQ_SOURCE_LINE 00001011 "    # add this parameter to our list"
NSQ_SOURCE_LINE 00001012 "    $self->add_parameter($param);"
NSQ_SOURCE_LINE 00001013 "    "
NSQ_SOURCE_LINE 00001014 "    "
NSQ_SOURCE_LINE 00001015 "  UPLOADS: {"
NSQ_SOURCE_LINE 00001016 ""
NSQ_SOURCE_LINE 00001017 "        # If we get here, then we are dealing with a potentially large"
NSQ_SOURCE_LINE 00001018 "        # uploaded form.  Save the data to a temporary file, then open"
NSQ_SOURCE_LINE 00001019 "        # the file for reading."
NSQ_SOURCE_LINE 00001020 ""
NSQ_SOURCE_LINE 00001021 "        # skip the file if uploads disabled"
NSQ_SOURCE_LINE 00001022 "        if ($DISABLE_UPLOADS) {"
NSQ_SOURCE_LINE 00001023 "            "
NSQ_SOURCE_LINE 00001024 "            my $buf;"
NSQ_SOURCE_LINE 00001025 "            my $unit = $CGI::MultipartBuffer::INITIAL_FILLUNIT;"
NSQ_SOURCE_LINE 00001026 "            my $len  = $content_length;"
NSQ_SOURCE_LINE 00001027 "            while ( $len > 0 ) {"
NSQ_SOURCE_LINE 00001028 "                my $read = $self->read_from_client( \\$buf, $unit, 0 );"
NSQ_SOURCE_LINE 00001029 "                $len -= $read;"
NSQ_SOURCE_LINE 00001030 "            }"
NSQ_SOURCE_LINE 00001031 "            last UPLOADS;"
NSQ_SOURCE_LINE 00001032 "        }"
NSQ_SOURCE_LINE 00001033 ""
NSQ_SOURCE_LINE 00001034 "        # SHOULD PROBABLY SKIP THIS IF NOT $self->{'use_tempfile'}"
NSQ_SOURCE_LINE 00001035 "        # BUT THE REST OF CGI.PM DOESN'T, SO WHATEVER"
NSQ_SOURCE_LINE 00001036 "\t\tmy $tmp_dir    = $CGI::OS eq 'WINDOWS'"
NSQ_SOURCE_LINE 00001037 "\t\t\t? ( $ENV{TEMP} || $ENV{TMP} || ( $ENV{WINDIR} ? ( $ENV{WINDIR} . $SL . 'TEMP' ) : undef ) )"
NSQ_SOURCE_LINE 00001038 "\t\t\t: undef; # File::Temp defaults to TMPDIR"
NSQ_SOURCE_LINE 00001039 ""
NSQ_SOURCE_LINE 00001040 "\t\trequire CGI::File::Temp;"
NSQ_SOURCE_LINE 00001041 "        my $filehandle = CGI::File::Temp->new("
NSQ_SOURCE_LINE 00001042 "\t\t\tUNLINK => $UNLINK_TMP_FILES,"
NSQ_SOURCE_LINE 00001043 "\t\t\tDIR    => $tmp_dir,"
NSQ_SOURCE_LINE 00001044 "\t\t);"
NSQ_SOURCE_LINE 00001045 "\t\t$filehandle->_mp_filename( $postOrPut );"
NSQ_SOURCE_LINE 00001046 ""
NSQ_SOURCE_LINE 00001047 "        $CGI::DefaultClass->binmode($filehandle)"
NSQ_SOURCE_LINE 00001048 "          if $CGI::needs_binmode"
NSQ_SOURCE_LINE 00001049 "              && defined fileno($filehandle);"
NSQ_SOURCE_LINE 00001050 ""
NSQ_SOURCE_LINE 00001051 "        my ($data);"
NSQ_SOURCE_LINE 00001052 "        local ($\\) = '';"
NSQ_SOURCE_LINE 00001053 "        my $totalbytes;"
NSQ_SOURCE_LINE 00001054 "        my $unit = $CGI::MultipartBuffer::INITIAL_FILLUNIT;"
NSQ_SOURCE_LINE 00001055 "        my $len  = $content_length;"
NSQ_SOURCE_LINE 00001056 "        $unit = $len;"
NSQ_SOURCE_LINE 00001057 "        my $ZERO_LOOP_COUNTER =0;"
NSQ_SOURCE_LINE 00001058 ""
NSQ_SOURCE_LINE 00001059 "        while( $len > 0 )"
NSQ_SOURCE_LINE 00001060 "        {"
NSQ_SOURCE_LINE 00001061 "            "
NSQ_SOURCE_LINE 00001062 "            my $bytesRead = $self->read_from_client( \\$data, $unit, 0 );"
NSQ_SOURCE_LINE 00001063 "            $len -= $bytesRead ;"
NSQ_SOURCE_LINE 00001064 ""
NSQ_SOURCE_LINE 00001065 "            # An apparent bug in the Apache server causes the read()"
NSQ_SOURCE_LINE 00001066 "            # to return zero bytes repeatedly without blocking if the"
NSQ_SOURCE_LINE 00001067 "            # remote user aborts during a file transfer.  I don't know how"
NSQ_SOURCE_LINE 00001068 "            # they manage this, but the workaround is to abort if we get"
NSQ_SOURCE_LINE 00001069 "            # more than SPIN_LOOP_MAX consecutive zero reads."
NSQ_SOURCE_LINE 00001070 "            if ($bytesRead <= 0) {"
NSQ_SOURCE_LINE 00001071 "                die  \"CGI.pm: Server closed socket during read_postdata_putdata (client aborted?).\\n\" if $ZERO_LOOP_COUNTER++ >= $SPIN_LOOP_MAX;"
NSQ_SOURCE_LINE 00001072 "            } else {"
NSQ_SOURCE_LINE 00001073 "                $ZERO_LOOP_COUNTER = 0;"
NSQ_SOURCE_LINE 00001074 "            }"
NSQ_SOURCE_LINE 00001075 "            "
NSQ_SOURCE_LINE 00001076 "            if ( defined $self->{'.upload_hook'} ) {"
NSQ_SOURCE_LINE 00001077 "                $totalbytes += length($data);"
NSQ_SOURCE_LINE 00001078 "                &{ $self->{'.upload_hook'} }( $param, $data, $totalbytes,"
NSQ_SOURCE_LINE 00001079 "                    $self->{'.upload_data'} );"
NSQ_SOURCE_LINE 00001080 "            }"
NSQ_SOURCE_LINE 00001081 "            print $filehandle $data if ( $self->{'use_tempfile'} );"
NSQ_SOURCE_LINE 00001082 "            undef $data;"
NSQ_SOURCE_LINE 00001083 "        }"
NSQ_SOURCE_LINE 00001084 ""
NSQ_SOURCE_LINE 00001085 "        # back up to beginning of file"
NSQ_SOURCE_LINE 00001086 "        seek( $filehandle, 0, 0 );"
NSQ_SOURCE_LINE 00001087 ""
NSQ_SOURCE_LINE 00001088 "        ## Close the filehandle if requested this allows a multipart MIME"
NSQ_SOURCE_LINE 00001089 "        ## upload to contain many files, and we won't die due to too many"
NSQ_SOURCE_LINE 00001090 "        ## open file handles. The user can access the files using the hash"
NSQ_SOURCE_LINE 00001091 "        ## below."
NSQ_SOURCE_LINE 00001092 "        close $filehandle if $CLOSE_UPLOAD_FILES;"
NSQ_SOURCE_LINE 00001093 "        $CGI::DefaultClass->binmode($filehandle) if $CGI::needs_binmode;"
NSQ_SOURCE_LINE 00001094 ""
NSQ_SOURCE_LINE 00001095 "        # Save some information about the uploaded file where we can get"
NSQ_SOURCE_LINE 00001096 "        # at it later."
NSQ_SOURCE_LINE 00001097 "        # Use the typeglob + filename as the key, as this is guaranteed to be"
NSQ_SOURCE_LINE 00001098 "        # unique for each filehandle.  Don't use the file descriptor as"
NSQ_SOURCE_LINE 00001099 "        # this will be re-used for each filehandle if the"
NSQ_SOURCE_LINE 00001100 "        # close_upload_files feature is used."
NSQ_SOURCE_LINE 00001101 "        $self->{'.tmpfiles'}->{$filehandle->filename . $filehandle} = {"
NSQ_SOURCE_LINE 00001102 "            hndl => $filehandle,"
NSQ_SOURCE_LINE 00001103 "\t\t\tname => $filehandle->filename,"
NSQ_SOURCE_LINE 00001104 "            info => {%header},"
NSQ_SOURCE_LINE 00001105 "        };"
NSQ_SOURCE_LINE 00001106 "        push( @{ $self->{param}{$param} }, $filehandle );"
NSQ_SOURCE_LINE 00001107 "    }"
NSQ_SOURCE_LINE 00001108 "    return;"
NSQ_SOURCE_LINE 00001109 "}"
