NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "package Date::Calc;"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "use strict;"
NSQ_SOURCE_LINE 00000015 "use vars qw($XS_OK $XS_DISABLE @ISA @EXPORT @EXPORT_OK %EXPORT_TAGS $VERSION);"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "BEGIN # Re-export imports from Date::Calc::XS or Date::Calc::PP:"
NSQ_SOURCE_LINE 00000018 "{"
NSQ_SOURCE_LINE 00000019 "    require Exporter;"
NSQ_SOURCE_LINE 00000020 "    @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000021 "    $XS_OK = 0;"
NSQ_SOURCE_LINE 00000022 "    unless ($XS_DISABLE and $XS_DISABLE) # prevent warning \"used only once\""
NSQ_SOURCE_LINE 00000023 "    {"
NSQ_SOURCE_LINE 00000024 "        eval"
NSQ_SOURCE_LINE 00000025 "        {"
NSQ_SOURCE_LINE 00000026 "            require Date::Calc::XS;"
NSQ_SOURCE_LINE 00000027 "            @EXPORT      = (@Date::Calc::XS::EXPORT);"
NSQ_SOURCE_LINE 00000028 "            @EXPORT_OK   = (@Date::Calc::XS::EXPORT_OK);"
NSQ_SOURCE_LINE 00000029 "            %EXPORT_TAGS = (all => [@EXPORT_OK]);"
NSQ_SOURCE_LINE 00000030 "            Date::Calc::XS->import(@EXPORT,@EXPORT_OK);"
NSQ_SOURCE_LINE 00000031 "        };"
NSQ_SOURCE_LINE 00000032 "        if ($@) { die $@ unless ($@ =~ /^Can't locate .*? at /); }"
NSQ_SOURCE_LINE 00000033 "        else    { $XS_OK = 1; }"
NSQ_SOURCE_LINE 00000034 "    }"
NSQ_SOURCE_LINE 00000035 "    unless ($XS_OK)"
NSQ_SOURCE_LINE 00000036 "    {"
NSQ_SOURCE_LINE 00000037 "        require Date::Calc::PP;"
NSQ_SOURCE_LINE 00000038 "        @EXPORT      = (@Date::Calc::PP::EXPORT);"
NSQ_SOURCE_LINE 00000039 "        @EXPORT_OK   = (@Date::Calc::PP::EXPORT_OK);"
NSQ_SOURCE_LINE 00000040 "        %EXPORT_TAGS = (all => [@EXPORT_OK]);"
NSQ_SOURCE_LINE 00000041 "        Date::Calc::PP->import(@EXPORT,@EXPORT_OK);"
NSQ_SOURCE_LINE 00000042 "    }"
NSQ_SOURCE_LINE 00000043 "}"
NSQ_SOURCE_LINE 00000044 ""
