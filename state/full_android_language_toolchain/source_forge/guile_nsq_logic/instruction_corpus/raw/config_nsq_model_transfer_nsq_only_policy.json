{
  "schema": "Braxon.nsq.model_transfer_policy.v3",
  "authority": "NSQ_COURT",
  "architecture_root": true,
  "active_transfer_method": "citadel699_source_edge_wire_translation",
  "normal_command": "request",
  "forbidden_normal_command": "fetch",
  "citadel699_request_required": true,
  "source_edge_payload_transfer_allowed": true,
  "source_edge_payload_transfer_scope": "build_and_translate_for_this_system_once",
  "source_edge_raw_material_allowed": true,
  "source_edge_raw_payload_contact_allowed": true,
  "raw_weight_download_allowed": false,
  "raw_payload_transfer_allowed": false,
  "raw_payload_direct_to_hardware_allowed": false,
  "raw_payload_direct_to_hypervisor_allowed": false,
  "raw_payload_home_wire_allowed": false,
  "normal_runtime_network_dependency_allowed": false,
  "post_materialization_online_dependency_allowed": false,
  "first_translation_online_source_contact_allowed": true,
  "repeat_online_materialization_allowed": false,
  "raw_huggingface_payload_fetch_allowed": false,
  "raw_gguf_direct_hardware_load_allowed": false,
  "raw_safetensors_direct_hardware_load_allowed": false,
  "git_lfs_pointer_allowed": false,
  "pointer_setup_allowed": false,
  "wire_form": "nsq_language_wire",
  "returned_bundle_required": true,
  "returned_bundle_form": "tar.gz_with_manifest_plus_nsq_content_addressed_fragments_or_streamed_translated_nsq_sections",
  "max_return_bundle_bytes": 1073741824,
  "local_rebuild_required_after_return": true,
  "whole_model_runtime_verification_required": true,
  "target_size_class": "mb_scale",
  "tiny_seed_reconstruction_required": true,
  "nurabit_citadel_groups": 21,
  "nurabit_group_width_nsq_bit_units": 33,
  "nurabit_groups_communicate": true,
  "cathedral_flow": "citadel_travels_to_source_edge_receives_raw_there_translates_to_nsq_and_streams_translated_sections",
  "open_weight_required": true,
  "censor_free_required": true,
  "huihui_preferred_source": true,
  "citadel699_is_llm": false,
  "citadel699_is_model": false,
  "citadel699_form": "daemonized_nuband_instruction_set",
  "citadel699_daemon": true,
  "citadel699_intelligence_source": "nsq_bit_level_language_semantics",
  "source_edge_citadel_route": {
    "citadel_travels_along_wire_to_source": true,
    "citadel_waits_just_outside_source": true,
    "raw_payload_received_at_source_edge": true,
    "raw_payload_converted_to_nsq_at_source_edge": true,
    "raw_payload_sent_home_as_raw": false,
    "raw_payload_sent_to_hypervisor_as_raw": false
  },
  "pattern_streaming": {
    "repeatable_pattern_detection_required": true,
    "begin_pattern_marker": "BEGIN_PATTERN",
    "begin_pattern_records_sent_home_directly": true,
    "translated_non_pattern_sections_sent_to_hypervisor": true,
    "hypervisor_may_begin_loading_while_translation_continues": true,
    "section_continuation_rule": "continue current section while exceptions are enough to guarantee clean rebuild",
    "new_section_rule": "begin another section when exceptions are no longer enough to guarantee clean rebuild",
    "wire_noise_reduction_required": true,
    "bit_waste_reduction_required": true
  },
  "hypervisor_boundary": {
    "hardware_receives_raw_payload": false,
    "hypervisor_receives_raw_payload": false,
    "hypervisor_receives_pointer_stubs": false,
    "hypervisor_receives_translated_nsq_sections": true,
    "hypervisor_receives_begin_pattern_records": true,
    "hypervisor_loads_translated_sections_during_stream": true
  },
  "offline_runtime_boundary": {
    "final_system_must_work_completely_offline": true,
    "runtime_must_not_require_github": true,
    "runtime_must_not_require_huggingface": true,
    "runtime_must_not_require_cpan": true,
    "runtime_must_not_require_pip": true,
    "runtime_must_not_require_npm": true,
    "runtime_must_not_require_cargo_network": true,
    "runtime_must_not_require_curl_wget_or_git_fetch": true,
    "remote_contact_allowed_only_for_source_edge_first_translation": true,
    "after_translation_hypervisor_load_is_local": true
  },
  "truth_boundary": {
    "payload_transfer_is_allowed_to_source_edge": true,
    "payload_transfer_is_not_direct_hardware_load": true,
    "raw_source_may_enter_citadel_source_side": true,
    "wire_home_material_must_be_nsq_language": true,
    "hypervisor_material_must_be_translated_nsq": true,
    "fetch_word_is_disallowed_for_normal_model_transfer": true,
    "download_check_must_not_be_treated_as_success": true,
    "citadel_request_is_not_whole_model_runtime": true,
    "returned_nsq_bundle_is_not_whole_model_runtime_until_rebuilt_and_verified": true,
    "whole_core_runtime_verification_required": true,
    "placeholders_are_not_runtime_material": true,
    "pointer_stubs_are_not_runtime_material": true,
    "incomplete_models_are_not_acceptable": true,
    "exact_target_missing_requires_best_fit_intent_review": true,
    "citadel699_is_daemonized_nuband_instruction_set": true,
    "intelligence_is_nsq_bit_level_language_semantics": true
  }
}
