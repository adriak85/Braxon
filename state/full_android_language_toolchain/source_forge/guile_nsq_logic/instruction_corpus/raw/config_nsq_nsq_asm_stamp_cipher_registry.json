      "template": "ordering barrier"
    },
    "SYS": {
      "meaning": "system call or platform call",
      "asm_family": "all",
      "template": "system call"
    },
    "VEC": {
      "meaning": "vector/SIMD operation",
      "asm_family": "all",
      "template": "vector operation"
    },
    "HASH": {
