  "stamp_fields": [
    "stamp_id",
    "name",
    "language_surface",
    "dialect",
    "family",
    "cipher",
    "canonical_meaning",
    "source_path",
    "expanded_path",
    "source_sha256",
    "source_blake3",
    "blake_null_sha256",
    "byte_count",
    "created_at",
    "reusable",
    "court_route",
    "dependencies",
    "notes"
  ]
}
