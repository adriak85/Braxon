#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

ARTIFACT_PATH="${1:-}"

if [ -z "$ARTIFACT_PATH" ]; then
  printf 'verify=false\nreason=missing_artifact_argument\n'
  exit 1
fi

if [ ! -f "$ARTIFACT_PATH" ]; then
  printf 'verify=false\nreason=missing_artifact\n'
  exit 1
fi

if [ ! -s "$ARTIFACT_PATH" ]; then
  printf 'verify=false\nreason=empty_artifact\n'
  exit 1
fi

if grep -q '^artifact_kind: nsq_source_ingest_envelope$' "$ARTIFACT_PATH" 2>/dev/null; then
  printf 'verify=false\nreason=envelope_masquerade\n'
  exit 1
fi

# A real semantic verifier does not exist yet. This guard intentionally fails so
# readiness cannot be inferred from filenames, manifests, or envelopes alone.
printf 'verify=false\nreason=semantic_recode_verifier_not_implemented\n'
exit 1
