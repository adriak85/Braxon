      "proof": ["Android_executable_memory_policy", "AArch64_jitlink_probe", "W_X_memory_safety", "target_execution", "artifact_watermark"]
    },
    {
      "id": "bolt_post_link_optimization",
      "disposition": "built_by_llvm-aarch64-source-build_target_profile_and_platform_proof_pending",
      "components": ["BOLT", "llvm-bolt", "perf2bolt", "AArch64_ELF", "DWARF"],
      "proof": ["contained_BOLT_source_or_project_proof", "unstripped_symbol_table", "emitted_relocations", "representative_profile", "DWARF_preservation", "post_BOLT_target_execution", "artifact_watermark"]
    },
    {
      "id": "thin_lto",
      "disposition": "TARGET_STABILITY_PROOF_PENDING",
      "components": ["ThinLTO", "ld.lld"],
      "proof": ["bounded_memory_profile", "deterministic_link_output", "ELF_DWARF_inspection", "target_execution", "artifact_watermark"]
    },
    {
      "id": "profile_guided_optimization",
      "disposition": "TARGET_WORKLOAD_PROOF_PENDING",
      "components": ["instrumentation_profile", "llvm-profdata", "profile_use"],
      "proof": ["representative_workload", "profile_integrity", "benchmark_delta", "target_execution", "artifact_watermark"]
    }
  ],
  "semantic_boundary": {
    "llvm_authority": "compiler_toolchain_and_aarch64_code_generation",
    "javascript_and_java_runtime_semantics": "remain_upstream_implementation_semantics_until_their_pinned_source_build_and_target_proof_complete",
    "jni": "narrow_java_native_abi_bridge_only",
