{
  "schema": "braxon.nsq.semantic_build_dialect_contract.v1",
  "authority": "NSQ_KINETIC_SEMANTIC_REFLEXOR",
  "capability": "feature:toolchain.semantic_build_dialect",
  "target_environment": "aarch64-linux-android",
  "nsq_dialect": "control",
  "semantic_subdialect": "kinetic_build",
  "execution_model": "semantic_intent_to_tokenizer_to_parameter_citadel_to_virtual_shared_cells_to_kinetic_reflexor_to_functional_watermark_to_allowlisted_physical_executor_to_artifact_proof",
  "watermark_is_functional": true,
  "resident_runtime": false,
  "hidden_download_allowed": false,
  "reflexor_job_bound": false,
  "storage_chain_policy": {
    "storage_root": "state/full_android_language_toolchain/ksr_semantic_chain",
    "persist_declared_transition_state": true,
    "chain_reaction_mode": "watermark_governed_declared_dependency_propagation",
    "auto_execute_physical_compiler": false,
    "cycle_policy": "reject_contract_cycles_and_reject_stale_or_conflicting_predecessor_watermarks",
    "propagation_requires": ["committed_ksr_state_watermark", "declared_scope_dependency", "declared_output_or_preparation_state"],
    "downstream_effect": "persist_queued_semantic_preparation_only_until_a_separate_explicit_execute_action",
    "automatic_tool_state_population": "persist_verified_repository_built_tool_state_from_declared_output_hashes_only",
    "automatic_runtime_activation": false,
    "undo_available_for_every_declared_scope": true,
    "undo_mode": "atomically_restore_prior_verified_storage_materialization_and_record_new_reversal_watermark",
    "undo_may_execute_physical_compiler": false,
    "undo_may_delete_or_rewrite_artifacts": false
  },
  "shared_cell_policy": {
    "address_namespace": "council/0/build",
    "piston_lifecycle": ["acquire", "hold", "commit", "release"],
    "same_address_concurrent_write": "queued",
    "source_mutation": "forbidden_except_declared_repository_source_materialization",
    "artifact_mutation": "allowed_only_through_declared_executor"
  },
  "executor_policy": {
    "dispatcher": "scripts/braxon_reconstruct.sh",
    "allowlisted_modes": ["source-edge", "source-build", "edge-nightly-build"],
    "requires_explicit_execute": true,
    "requires_aarch64_android_target": true,
    "preserved_environment": ["HOME", "PATH", "PREFIX", "SHELL", "TMPDIR", "TERM", "LANG", "LC_ALL"],
    "physical_default_jobs": 1,
    "controlled_environment": {"JOBS": "1"},
    "allows_arbitrary_arguments": false,
    "allows_hidden_download": false,
    "failure_mode": "fail_closed_with_exact_target_or_materialization_guidance"
  },
  "automatic_tool_population": [
    {
      "scope": "llvm-aarch64-source-build",
      "output_root": "state/full_android_language_toolchain/install/llvm/bin",
      "tool_names": ["clang", "clang++", "ld.lld", "llvm-ar", "llvm-readelf", "llvm-dwarfdump", "llvm-jitlink", "llvm-mc", "llvm-bolt", "perf2bolt"],
      "state": "verified_repository_built_pending_target_proof_completion"
    },
    {
      "scope": "rust-edge-nightly",
      "output_root": "state/full_android_language_toolchain/install/rust-edge/bin",
      "tool_names": ["rustc", "cargo"],
      "state": "verified_repository_built_pending_target_proof_completion"
    }
  ],
  "chain_reactions": [
    {
      "upstream_scope": "llvm-source-edge",
      "downstream_scope": "llvm-aarch64-source-build",
      "condition": "prepared_or_executed",
      "effect": "queue_prepare"
    },
    {
      "upstream_scope": "llvm-aarch64-source-build",
      "downstream_scope": "rust-edge-nightly",
      "condition": "executed_with_declared_outputs_watermarked",
      "effect": "queue_prepare"
    },
    {
      "upstream_scope": "llvm-aarch64-source-build",
      "downstream_scope": "optimization-proof",
      "condition": "executed_with_declared_outputs_watermarked",
      "effect": "queue_prepare"
    },
    {
      "upstream_scope": "rust-edge-nightly",
      "downstream_scope": "optimization-proof",
      "condition": "executed_with_declared_outputs_watermarked",
      "effect": "queue_prepare"
    }
  ],
  "llvm_native_features": [
    {
      "id": "aarch64_aot_clang_lld",
      "disposition": "selected_by_llvm-aarch64-source-build",
      "components": ["clang", "clang++", "ld.lld", "llvm-ar", "llvm-readelf"],
