#!/data/data/com.termux/files/usr/bin/bash
# Native Termux front door for the Braxon NSQ Kinetic Semantic Reflexor.
# This script intentionally starts no resident runtime. Every capability is
# discovered and executed only when explicitly requested.
set -euo pipefail

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
PROFILE="${BRAXON_DEVICE_PROFILE:-samsung_galaxy_a17_termux_aarch64}"
export BRAXON_ROOT="$ROOT"
export CARGO_TERMUX_BUILD_JOBS="${CARGO_TERMUX_BUILD_JOBS:-1}"

usage() {
  cat <<'EOF'
Usage:
  bin/braxon-reflex bootstrap [--profile PROFILE]
  bin/braxon-reflex discover
  bin/braxon-reflex verify
  bin/braxon-reflex capture
  bin/braxon-reflex operate CAPABILITY [--execute]

The front door is intentionally lightweight. It inventories and validates NSQ
Reflex contracts, then starts an executable crate only when --execute is given.
EOF
}

subcommand="${1:-bootstrap}"
shift || true
case "$subcommand" in
  bootstrap)
    if [ "${1:-}" = "--profile" ]; then
      PROFILE="${2:?missing profile value}"
      shift 2
    fi
    [ "$#" -eq 0 ] || { usage >&2; exit 2; }
    exec cargo run --quiet --manifest-path "$ROOT/Cargo.toml" -- reflex bootstrap --profile "$PROFILE"
    ;;
  discover|verify|capture)
    [ "$#" -eq 0 ] || { usage >&2; exit 2; }
    exec cargo run --quiet --manifest-path "$ROOT/Cargo.toml" -- reflex "$subcommand"
    ;;
  operate)
    capability="${1:?missing capability identifier}"
    shift
    if [ "${1:-}" = "--execute" ]; then
      shift
      [ "$#" -eq 0 ] || { usage >&2; exit 2; }
      exec cargo run --quiet --manifest-path "$ROOT/Cargo.toml" -- reflex operate "$capability" --execute
    fi
    [ "$#" -eq 0 ] || { usage >&2; exit 2; }
    exec cargo run --quiet --manifest-path "$ROOT/Cargo.toml" -- reflex operate "$capability"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
