id: nsq.runtime.native.Braxon.feature.attach.v1
type: stamp
version: 1
authority: Braxon
role: BRAXON_feature_attachment_forms

meaning:
  reusable forms for attaching native BRAXON representation to Braxon status, agent, runtime model, and runtime infer surfaces

forms:
  - attach model presence to root status
  - attach model presence to agent execution
  - attach model presence to runtime model inspection
  - attach model presence to runtime inference and session surfaces

wake_key: da
